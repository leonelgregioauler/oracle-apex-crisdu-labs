authorization acesso-acertos (
    name: Acesso Acertos
    type: existsSqlQuery
    settings {
        sqlQuery: select 1 from acessos b where b.idaplicacao = 2048 and b.usuario = :APP_USER
    }
    error {
        errorMessage: Você não tem acesso à tela de Acertos.
    }
    comments {
        comments: Paginas 74 e 75. Mesmo direito do item de menu "Acertos" (ACESSOS.IDAPLICACAO = 2048).
    }
)

authorization acesso-fechamentos (
    name: Acesso Fechamentos
    type: existsSqlQuery
    settings {
        sqlQuery: select 1 from acessos b where b.idaplicacao = 2050 and b.usuario = :APP_USER
    }
    error {
        errorMessage: Você não tem acesso à tela de Fechamento Semanal.
    }
    comments {
        comments: Paginas 91 e 92. Mesmo direito do item de menu "Fechamentos" (ACESSOS.IDAPLICACAO = 2050).
    }
)

authorization atendimento (
    name: ATENDIMENTO
    type: existsSqlQuery
    settings {
        sqlQuery:
            ```sql
            select 1
            from dual 
            where upper(v('APP_USER')) IN ( 'EVERTON','MATEUS','GUILHERME','FERNANDO','CRISTIAN','EQUIPAMENTO','MAURICIO','LUCASRAMOS','LUIZV','EDIMILSON') 
            ```
    }
    error {
        errorMessage: Você não tem acesso a este item!
    }
)

authorization controle-de-autenticação (
    name: Controle de autenticação
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            begin
              --
               if pck_romance.fnc_retornaparametro(parametro => 'CONTROLE_AUTENTICACAO',pidfilial => 340) = 'N' then 
                  --
                  return true;
                  --
               end if;
              --
              return
              --
              pck_auditoriaromance.fnc_bloqueiaacesso(pusuario => v('APP_USER'));
              --
            end;
            ```
    }
    error {
        errorMessage:
            ```
            Voce precisa redefinir a sua senha!
            Verifique seu email. 
            ```
    }
)

authorization desenvolvedores (
    name: Desenvolvedores
    type: existsSqlQuery
    settings {
        sqlQuery:
            ```sql
            select 1 
            from dual 
            where V('APP_USER') in('MAX','GUILHERME','EVERTON','EMPRESATESTE','DIGITACAO')
            ```
    }
    error {
        errorMessage: Você não tem permissão para acessar este item!
    }
)

authorization horário-de-acesso (
    name: Horário de acesso
    type: existsSqlQuery
    settings {
        sqlQuery:
            ```sql
            select 1
            from usuarios u
               , catal.horariosacesso h
            where U.idusuario = h.idusuario
              and sysdate between to_date(to_char(sysdate,'DD/MM/RRRR')||' '||h.horainicio,'DD/MM/RRRR HH24:MI:SS') 
                              and to_date(to_char(sysdate,'DD/MM/RRRR')||' '||h.horafim,'DD/MM/RRRR HH24:MI:SS')
              and trim(to_char(sysdate,'DAY')) = h.dia
              and idsistema = 2001
              and U.usuario = upper(v('APP_USER'))
            union
            select 1
            from dual
            where  v('APP_PAGE_ID')= 160
            union
            select 1
            from dual
            where  v('APP_PAGE_ID')= 9999
            ```
    }
    error {
        errorMessage: Você não tem permissão de acesso neste horário.
    }
)

