appComputation p0-idfilial (
    itemName: P0_IDFILIAL
    execution {
        sequence: 10
        point: afterAuthentication
    }
    computation {
        type: functionBody
        plsqlFunctionBody:
            ```plsql
            declare
              vidfilial number;
            begin
              vidfilial := pck_romance.fnc_filialusuario(:APP_USER);
              --
              if vidfilial = 1135 and :APP_USER != 'RAFAELK' then
                return null;
              end if;
              --
              return vidfilial;
            end;
            ```
    }
)

