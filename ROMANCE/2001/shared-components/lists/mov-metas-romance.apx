list mov-metas-romance (
    name: Mov.Metas Romance
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 1 "LEVEL" 
                 , descricao        label
                 , 'f?p=&APP_ID.:'||PAGINA||':&SESSION.::NO:::'          target
                 , paginascorrentes  is_current_list_entry
                 , imagem image
              from ( select a.idaplicacao
                          , a.descricao
                          , a.hierarquia
                          , a.pagina
                          , a.imagem
                          , a.paginascorrentes
                     from aplicacoes a 
                       -- , aplicacoestraduzidas aa
                     where a.idsistema = 2001
                       --and a.idaplicacao  = aa.idaplicacao (+)
                       --and aa.idioma = nvl(APEX_UTIL.GET_SESSION_LANG,'pt-br')
                       and a.hierarquia = 2780
                       and a.aparecer = 'S'
                       and exists ( select 1 
                                    from acessos b 
                                    where b.idaplicacao = a.idaplicacao 
                                      and b.usuario = v('APP_USER'))
                     order by 1)
            ```
    }
)

