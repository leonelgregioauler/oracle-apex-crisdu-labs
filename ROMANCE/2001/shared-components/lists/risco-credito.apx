list risco-credito (
    name: Risco_Credito
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 1 "LEVEL" 
                 , descricao        label
                 , 'f?p=&APP_ID.:'||PAGINA||':&SESSION.::NO:::'          target
                 , paginascorrentes  is_current_list_entry
                 , imagem image
              from ( select a.idaplicacao
                          , a.descricao
                          , a.hierarquia
                          , a.pagina
                          , a.imagem
                          , a.paginascorrentes
                          , a.ordem
                     from aplicacoes a 
                     where a.idsistema = 2001
                       and a.hierarquia = 3400
                       and a.aparecer = 'S'
                       and exists ( select 1 
                                    from acessos b 
                                    where b.idaplicacao = a.idaplicacao 
                                      and b.usuario = v('APP_USER')) )
            order by ordem
            ```
    }
)

