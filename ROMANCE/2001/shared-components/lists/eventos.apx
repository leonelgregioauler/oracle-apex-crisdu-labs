list eventos (
    name: Eventos
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT NULL
                 , c.idchamado || ' - ' || c.titulo label
                 , APEX_UTIL.PREPARE_URL(  p_url => 'f?p=&APP_ID.:111:'|| v('APP_SESSION')||'::NO::P111_IDCHAMADO:'||c.idchamado, p_checksum_type => 'SESSION') target
                 , 'YES' is_current
                 , NULL image
                 , '' image_attrib
                 , c.descricao text
                 , c.descricao a01
                 , h.descricao a02
                 , c.idchamado a03
            FROM (
                SELECT c.idchamado
                     , c.titulo
                     , c.descricao
                     , MAX(h.idhistoricochamado) AS idhistoricochamado
                FROM chamados c
                   , historicochamados h
                WHERE h.idchamado(+) = c.idchamado
                  AND c.usuario = v('APP_USER')
                  AND c.idrepresentante IS NULL
                  AND NVL(c.idsituacao, 0) = :P88_SITUACAO
                GROUP BY c.idchamado, c.titulo, c.descricao
            
                UNION
            
                SELECT c.idchamado
                     , c.titulo
                     , c.descricao
                     , MAX(h.idhistoricochamado) AS idhistoricochamado
                FROM chamados c
                   , usuarioschamados u
                   , historicochamados h
                WHERE u.idchamado = c.idchamado
                  AND h.idchamado(+) = c.idchamado
                  AND u.usuario = v('APP_USER')
                  AND c.idrepresentante IS NULL
                  AND NVL(c.idsituacao, 0) = :P88_SITUACAO
                GROUP BY c.idchamado, c.titulo, c.descricao
            
                ORDER BY idchamado DESC
            ) c
            , historicochamados h
            WHERE h.idhistoricochamado(+) = c.idhistoricochamado
              AND ROWNUM < 20;
            
            ```
    }
)

