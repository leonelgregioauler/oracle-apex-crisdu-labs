lov produtosestoquefilial (
    name: PRODUTOSESTOQUEFILIAL
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select pck_romance.fnc_nomeproduto(e.idproduto) display_value
                 , e.idestoquefilial
            from estoquefilial e
            where idfilial = :P0_IDFILIAL
            order by 1
            ```
    }
)

