lov filiais-3 (
    name: FILIAIS
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select initcap(nvl(p.apelido, p.nomepessoa)) display_value
                 , f.idfilial
            from pessoas p
               , filiais f
            where p.idpessoa = f.idpessoa
              and f.tipofilial = 'D' /*distribuidora*/
              and f.idfilial = ( select idfilial
                                 from gerentes g
                                     , usuarios u
                                 where u.idgerente = g.idgerente
                                   and u.usuario = v('APP_USER'))
            order by 1
            ```
    }
)

