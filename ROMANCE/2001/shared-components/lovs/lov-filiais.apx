lov lov-filiais (
    name: LOV_FILIAIS
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select initcap(nvl(p.apelido, p.nomepessoa)) display_value
                 , f.idfilial
            from pessoas p
               , filiais f
            where p.idpessoa = f.idpessoa
              and f.tipofilial = 'D' /*distribuidora*/
              and f.ativo = 'S'
            order by 1
            ```
    }
)

