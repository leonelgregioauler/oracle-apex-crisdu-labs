lov postoavançado (
    name: POSTOAVANÇADO
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select pck_romance.fnc_nomepostoavancado(pidpostoavancado => p.idpostoavancado) display_value
                 , p.idpostoavancado return_value
            from postoavancado p
            where p.idfilial = :P0_IDFILIAL
            ```
    }
)

