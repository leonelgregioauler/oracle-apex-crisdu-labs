)

componentSetting (
    type: item
    name: colorPicker
)

componentSetting (
    type: item
    name: datePicker
    settings {
        appearanceBehavior: [
            monthPicker
            yearPicker
            showTodayButton
        ]
    }
)

componentSetting (
    type: item
    name: geocodedAddress
    settings {
        mapPreview: [
            resultsPopup
            item
        ]
    }
)

componentSetting (
    type: item
    name: selectMany
)

componentSetting (
    type: item
    name: checkbox
    settings {
        uncheckedValue: N
    }
)

componentSetting (
    type: item
    name: starRating
    settings {
        tooltip: #VALUE#
    }
)

componentSetting (
    type: item
    name: switch
    settings {
        displayStyle: selectList
        onValue: Y
    }
)

componentSetting (
    type: item
    name: plugin/select
    settings {
        noResultsFoundMessage: Nenhum resultado encontrado
        searchingMessage: procurando....
    }
)

componentSetting (
    type: item
    name: plugin/flexField
    settings {
        flexRegistryTable: EBA_CUST_FLEX_REGISTRY
    }
)

componentSetting (
    type: item
    name: plugin/tagEntry
)

componentSetting (
    type: process
    name: serverSideGeocoding
)

componentSetting (
    type: region
    name: regionDisplaySelector
    settings {
        includeSlider: false
    }
)

componentSetting (
    type: region
    name: interactiveReport
    settings {
        actionsMenuStructure: legacy
        autoResetButton: false
    }
)

componentSetting (
    type: region
    name: map
)

componentSetting (
    type: region
    name: plugin/d3BarChart
)

componentSetting (
