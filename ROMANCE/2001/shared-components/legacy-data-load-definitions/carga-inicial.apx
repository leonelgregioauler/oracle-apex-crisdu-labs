legacyDataLoadDefinition carga-inicial (
    name: Carga Inicial
    target {
        tableOwner: #OWNER#
        tableName: TEMP_CARGAESTOQUE
    }
    uniqueKeys {
        uniqueColumn1: CODPRODUTO
    }

    transformationRule limpa-espaços (
        name: Limpa espaços
        execution {
            sequence: 10
        }
        transformation {
            columnNames: [
                CODPRODUTO
                QTDPP
                QTDP
                QTDM
                QTDG
                QTDGG
                QTDEGG
                QTDEXGG
                QTDU
            ]
            type: trim
        }
    )

)

