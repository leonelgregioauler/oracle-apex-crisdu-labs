legacyDataLoadDefinition disparo-sms (
    name: Disparo SMS
    target {
        tableOwner: #OWNER#
        tableName: DISPAROSSMS
    }
    uniqueKeys {
        uniqueColumn1: IDMENSAGEM
    }

    tableLookup IDMENSAGEM (
        source {
            tableOwner: #OWNER#
            tableName: MENSAGENSDISPAROS
        }
        compareUploadWith {
            column: IDMENSAGEMDISPARO
            column2: MENSAGEM
            column3: DATADISPARO
        }
        lookup {
            returnColumn: IDMENSAGEMDISPARO
        }
    )

)

