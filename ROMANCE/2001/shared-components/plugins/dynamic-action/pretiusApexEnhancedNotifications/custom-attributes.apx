customAttribute attribute_01 (
    apexlangName: useUniversalThemeTemplates
    attribute: 1
    name: Use "Universal Theme" templates
    scope: app
    type: yesNo
    appearance {
        sequence: 10
    }
    help {
        helpText:
            ```
            <b>When "Yes" is selected</b>
            <p>
            the plugin fetch success and notification message from APEX tables.
            </p>
            <b>When "No" is selected</b>
            <p>
            the plugin uses success and notification message templates defined as plugin application attributes.
            </p>
            ```
    }
)

customAttribute attribute_01 (
    apexlangName: type
    attribute: 1
    name: Type
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value: SUCCESS
    }
    help {
        helpText: Selected option defines the notification appearance.
    }

    entry error (
        sequence: 30
        display: Error
        return: DANGER
        help {
            helpText: Notification is styled as APEX error message.
        }
        advanced {
            quickPick: true
        }
    )

    entry success (
        sequence: 10
        display: Success
        return: SUCCESS
        help {
            helpText: Notification is styled as APEX success message.
        }
        advanced {
            quickPick: true
        }
    )

    entry warning (
        sequence: 20
        display: Warning
        return: WARNING
        help {
            helpText: Notification is styled as APEX warning message.
        }
        advanced {
            quickPick: true
        }
    )

)

customAttribute attribute_02 (
    apexlangName: successMessageTemplate
    attribute: 2
    name: Success message template
    scope: app
    type: textarea
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    default {
        value:
            ```
            <div class="t-Body-alert">
              <div class="t-Alert t-Alert--defaultIcons t-Alert--success t-Alert--horizontal t-Alert--page t-Alert--colorBG" id="t_Alert_Success" role="alert">
                <div class="t-Alert-wrap">
                  <div class="t-Alert-icon">
                    <span class="t-Icon"></span>
                  </div>
                  <div class="t-Alert-content">
                    <div class="t-Alert-header">
                      <h2 class="t-Alert-title">#SUCCESS_MESSAGE#</h2>
                    </div>
                  </div>
                  <div class="t-Alert-buttons">
                    <button class="t-Button t-Button--noUI t-Button--icon t-Button--closeAlert" type="button" title="#CLOSE_NOTIFICATION#"><span class="t-Icon icon-close"></span></button>
                  </div>
                </div>
              </div>
            </div>
            ```
    }
    dependingOn {
        attribute: @attribute_01/app
        conditionType: =
        value: N
    }
    help {
        helpText:
            ```
            <p>
            Plugin success message template. Default value is copy of Universal Theme template.
            </p>
            ```
    }
)

customAttribute attribute_02 (
    apexlangName: displayAs
    attribute: 2
    name: Display as
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    default {
        value: NOTIFICATION
    }
    help {
        helpText: Selected option defines the notification type.
    }

    entry floating (
        sequence: 10
        display: Floating
        return: NOTIFICATION
        help {
            helpText: Light notification floating in the corner of the window.
        }
        advanced {
            quickPick: true
        }
    )

    entry inline (
        sequence: 20
        display: Inline
        return: EMBEDED
        help {
            helpText: Horizontal embeded notification.
        }
        advanced {
            quickPick: true
        }
    )

)

customAttribute attribute_03 (
    apexlangName: messageTemplate
    attribute: 3
    name: Message template
    scope: app
    type: textarea
    validation {
        required: true
    }
    appearance {
        sequence: 30
    }
    default {
        value:
            ```
            <div class="t-Body-alert">
              <div class="t-Alert t-Alert--defaultIcons t-Alert--warning t-Alert--horizontal t-Alert--page t-Alert--colorBG" id="t_Alert_Notification" role="alert">
                <div class="t-Alert-wrap">
                  <div class="t-Alert-icon">
                    <span class="t-Icon"></span>
                  </div>
                  <div class="t-Alert-content">
                    <div class="t-Alert-body">
                      #MESSAGE#
                    </div>
                  </div>
                  <div class="t-Alert-buttons">
                    <button class="t-Button t-Button--noUI t-Button--icon t-Button--closeAlert" type="button" title="#CLOSE_NOTIFICATION#"><span class="t-Icon icon-close"></span></button>
                  </div>
                </div>
              </div>
            </div>
            ```
    }
    dependingOn {
        attribute: @attribute_01/app
        conditionType: =
        value: N
    }
    help {
        helpText:
            ```
            <p>
            Plugin warning/error message template. Default value is copy of Universal Theme template.
            </p>
            ```
    }
)

customAttribute attribute_03 (
    apexlangName: insertInto
    attribute: 3
    name: Insert into
    validation {
        required: true
    }
    appearance {
        sequence: 1
    }
    builder {
        translatable: true
    }
    default {
        value: .t-Body-main
    }
    help {
        helpText:
            ```
            <p>
            jQuery selector that points to notifications container. This attribute can be used to append Inline notification into APEX page region (see examples).
            </p>
            <p>
            <i>
            If you are not sure how to use this attribute leave it with default value ".t-Body-main". Notification are appended to default "Universal Theme" notification container.
            </i>
            </p>
            ```
    }
    examples {
        examples:
            ```
            <p>
            To show Inline notification within APEX region, the proper jQuery selector must be provided.
            </p>
            <p>
            For APEX region defined as:
            </p>
            <ul>
            <li>Identification > Type = "Static Content"</li>
            <li>Appearance > Template = "Standard"</li>
            <li>Advanced > Static id = "embededNotification"</li>
            </ul>
            <p>
            the proper jQuery selector is defined as "#embededNotification .t-Region-body".
            </p>
            ```
    }
)

customAttribute attribute_04 (
    apexlangName: displayDuration
    attribute: 4
    name: Display duration
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 40
    }
    builder {
        unit: ms
    }
    default {
        value: 0
    }
    help {
        helpText: Defines amount of time when notification is displayed to the user.
    }
    examples {
        examples:
            ```
            <dl>
              <dt>When equal 0</dt>
              <dd>Notification is displayed without time limit. To hide the notification, user has to click on close (X) button.</dd>
              <dt>When more than 0</dt>
              <dd>Notification is displayed for specified number of miliseconds. Time indicator presents amount of time before closing the notification.</dd>
            </dl>
            ```
    }
)

customAttribute attribute_05 (
    apexlangName: showNew
    attribute: 5
    name: Show new
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 23
    }
    default {
        value: TOP
    }
    help {
        helpText: Defines whether notification is added on top or bottom of notifications list
    }

    entry onBottom (
        sequence: 20
        display: On bottom
        return: BOTTOM
        help {
            helpText: New notification is added on bottom of notification list
        }
        advanced {
            quickPick: true
        }
    )

    entry onTop (
        sequence: 10
        display: On top
        return: TOP
        help {
            helpText: New notification is added on top of notification list
        }
        advanced {
            quickPick: true
        }
    )

)

customAttribute attribute_06 (
    apexlangName: messageType
    attribute: 6
    name: Message type
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 60
    }
    default {
        value: STATIC
    }
    help {
        helpText: This attribute defines the source of the notification message. Using values other then <b>Static text</b> and <b>Dialog close event</b> allows to use dynamic message for the notification.
    }

    entry dialogCloseEvent (
        sequence: 15
        display: Dialog close event
        return: DIALOG
        help {
            helpText: Modal page success message is displayed as notification message. Plugin must be bound to <b>dialog close</b> event.
        }
        advanced {
            quickPick: true
        }
    )

    entry functionReturningJson (
        sequence: 20
        display: Function returning JSON
        return: JSJSON
        help {
            helpText: Function body defined as <b>JavaScript function body</b> attribute must return valid JSON object. JSON object is used to build notification with list. Read more in help text for <b>JavaScript function body</b> attribute.
        }
    )

    entry functionReturningString (
        sequence: 17
        display: Function returning String
        return: JSSTRING
        help {
            helpText: Function body defined as <b>JavaScript function body</b> attribute must return String or Number. Read more in help text for <b>JavaScript function body</b> attribute.
        }
        advanced {
            quickPick: true
        }
    )

    entry functionReturningStringOrJson (
        sequence: 50
        display: Function returning String or JSON
        return: JSMIXED
        help {
            helpText:
                ```
                Function body defined as <b>JavaScript function body</b> attribute must return valid JSON object or String/Number. This option is handy when you are not sure if custom event provides String/Number or JSON object.
                
                Read more in help text for <b>JavaScript function body</b> attribute.
                ```
        }
        advanced {
            quickPick: true
        }
    )

    entry staticText (
        sequence: 10
        display: Static text
        return: STATIC
        help {
            helpText: Provided text in <b>Static text</b> attribute is displayed as notification message.
        }
        advanced {
            quickPick: true
        }
    )

)

customAttribute attribute_07 (
    apexlangName: staticText
    attribute: 7
    name: Static text
    type: javaScriptCode
    validation {
        required: true
    }
    appearance {
        sequence: 70
    }
    dependingOn {
        attribute: @attribute_06/component
        conditionType: =
        value: STATIC
    }
    help {
        helpText: Provided text is used as notification message.
    }
)

customAttribute attribute_08 (
    apexlangName: removingMethod
    attribute: 8
    name: Removing method
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 55
    }
    default {
        value: REMOVE
    }
    help {
        helpText: Defines how notification is removed.
    }

    entry fadeOut (
        sequence: 30
        display: Fade out
        return: fadeOut
        help {
            helpText: Notification is removed using "Fade out" jQuery animation.
        }
        advanced {
            quickPick: true
        }
    )

    entry remove (
        sequence: 10
        display: Remove
        return: REMOVE
        help {
            helpText: Notification is removed without animation.
        }
        advanced {
            quickPick: true
        }
    )

    entry slideUp (
        sequence: 20
        display: Slide up
        return: slideUp
        help {
            helpText: Notification is removed using "Slide up" jQuery animation.
        }
        advanced {
            quickPick: true
        }
    )

)

customAttribute attribute_09 (
    apexlangName: javascriptFunctionBody
    attribute: 9
    name: JavaScript function body
    type: javaScriptCode
    validation {
        required: true
    }
    appearance {
        sequence: 90
    }
    dependingOn {
        attribute: @attribute_06/component
        conditionType: inList
        list: [
            JSJSON
            JSSTRING
            JSMIXED
        ]
    }
    help {
        helpText:
            ```
            <p>
            Provide JavaScript function body returning String / Number / JSON depending on selected value in <b>Message type</b> attribute. 
            The result is used to build notification content. 
            Maximum length for function body is 4000 characters.
            </p>
            ```
    }
    examples {
        examples:
            ```
            <p>
            This code has access to the following dynamic action related attributes::
            </p>
            <dl>
              <dt>this.data</dt>
              <dd>Optional additional data that can be passed from the event handler.</dd>
            </dl>
            
            <b>Valid JSON object</b>
            <p>
            Valid object must has two attributes: 
            </p>
            <ul>
            <li>msg [Object String]</li>
            <li>List [Object Array]</li>
            </ul>
            Example:
            <pre>
            {
              msg: "Title of notification",
              list: [
                "Detailed message #1",
                "Detailed message #2",
                "..."
              ]
            }
            </pre>
            
            <b>Example of JavaScript function body returning String</b>
            <pre>
            var location = window.location.href;
            return location;
            </pre>
            
            <b>Example of JavaScript function body returning JSON</b>
            <pre>
            return {
              msg: "Notification with details",
              list: ["detailed message #1", "detailed message #2"]
            }
            </pre>
            
            <b>Alternative for Dialog Close event</b>
            <p>
            To capture modal page message (and returned APEX items) you can use "Message type" = "Function returning JSON". Dynamic action event should be set to "Dialog close event" and <b>JavaScript function body</b> should work on <b>dialog close</b> event <b>data</b>:
            </p>
            <pre>
            return {
              msg: this.data.successMessage.text,
              list: [ this.data.PX_ITEM_NAME, this.data.PX_ITEM_NAME_2 ]
            };
            </pre>
            
            <p>
            Where X is page number and ITEM_NAME_1, ITEM_NAME_2 are APEX item names.
            </p>
            
            <b>Custom event</b>
            <p>
            To bind the plugin with custom event <b>customEvent</b>, dynamic action:
            </p>
            <ul>
            <li>must be bound to custom event <b>customEvent</b></li>
            <li>should be triggered by <b>apex.event</b>. </li>
            </ul>
            <p>
            Example trigger for dynamic action might look like:
            </p>
            <pre>
            var pSelector = document, 
                pEvent = 'customEvent', 
                pData = {msg: "Custom event", list: ["line 1", "line 2", "..."]};
            
            apex.event.trigger(pSelector,pEvent,pData);
            </pre>
            <p>
            <b>pData</b> is referenced by <b>this.data</b> in <b>JavaScript function body</b>:
            </p>
            <pre>
            return this.data;
            </pre>
            ```
    }
)

customAttribute attribute_10 (
    apexlangName: position
    attribute: 10
    name: Position
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 22
    }
    default {
        value: TOPRIGHT
    }
    dependingOn {
        attribute: @attribute_02/component
        conditionType: =
        value: NOTIFICATION
    }
    help {
        helpText: Selected option defines notification position.
    }

    entry bottomLeft (
        sequence: 40
        display: Bottom left
        return: BOTTOMLEFT
        help {
            helpText: The notification is displayed in bottom left corner of the browser window.
        }
        advanced {
            quickPick: true
        }
    )

    entry bottomRight (
        sequence: 30
        display: Bottom right
        return: BOTTOMRIGHT
        help {
            helpText: The notification is displayed in bottom right corner of the browser window.
        }
        advanced {
            quickPick: true
        }
    )

    entry topLeft (
        sequence: 20
        display: Top left
        return: TOPLEFT
        help {
            helpText: The notification is displayed in top left corner of the browser window.
        }
        advanced {
            quickPick: true
        }
    )

    entry topRight (
        sequence: 10
        display: Top right
        return: TOPRIGHT
        help {
            helpText:
                ```
                <p>
                The notification is displayed in top right corner of the browser window.
                </p>
                <p>
                <i>
                This position is default position for APEX native success message.
                </i>
                </p>
                ```
        }
        advanced {
            quickPick: true
        }
    )

)

customAttribute attribute_11 (
    apexlangName: inlineSettings
    attribute: 11
    name: Inline settings
    type: checkboxes
    appearance {
        sequence: 21
    }
    dependingOn {
        attribute: @attribute_02/component
        conditionType: =
        value: EMBEDED
    }
    help {
        helpText: With this attribute notification behaviour can be changed.
    }

    entry fixedPosition (
        sequence: 30
        display: Fixed position
        return: FIXED
        help {
            helpText: When this option selected, notification is pinned to the browser window.
        }
    )

    entry merge (
        sequence: 10
        display: Merge
        return: MERGE
        help {
            helpText: When this option selected, new notifications of the same type are merged to one notification.
        }
    )

    entry removeExisting (
        sequence: 40
        display: Remove existing
        return: REMOVEOTHER
        help {
            helpText:
                ```
                When this option selected, all* existing inline notifications are removed before adding this notification.<br/><br/>
                
                *When <b>Merge</b> option is selected, only different types of notification are removed.
                ```
        }
    )

    entry scrollTo (
        sequence: 20
        display: Scroll to
        return: SCROLLTO
        help {
            helpText: When this option selected, browser window is scrolled to the new notification.
        }
    )

    entry showBulletsInList (
        sequence: 50
        display: Show bullets in list
        return: SHOWBULLETS
        help {
            helpText: When this option selected, list elements are preceded with list bullet.
        }
    )

)

customAttribute attribute_12 (
    apexlangName: affectedByFixedPosition
    attribute: 12
    name: Affected by fixed position
    validation {
        required: true
    }
    appearance {
        sequence: 22
    }
    default {
        value: .t-Body-contentInner
    }
    dependingOn {
        attribute: @attribute_11/component
        conditionType: inList
        list: FIXED
    }
    help {
        helpText:
            ```
            <p>
            jQuery selector that points to APEX page body container. 
            When <b>Fixed position</b> in <b>Inline settings</b> is checked, this selectors margin-top css property is recalculated. When fixed notification is removed the margin-top value is restored to previous value.
            </p>
            <p>
            <i>If you are not sure how to use this attribute leave it with default value ".t-Body-contentInner"</i>
            </p>
            ```
    }
    examples {
        examples: asd
    }
)

