customAttribute attribute_01 (
    apexlangName: title
    attribute: 1
    name: Title
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    builder {
        translatable: true
        displayWidth: 60
    }
    help {
        helpText:
            ```
            <p>
            	The heading of the notification.</p>
            <p>
            	The following placeholder syntax is available:</p>
            <ul>
            	<li>
            		Server Side Substitution syntax: Replaces a placeholder during rendering of the page. Example: &amp;P6_CATEGORY.</li>
            	<li>
            		Client Side Substitution syntax: Replaces a placeholder with the current value of the browser. Example: #P6_CATEGORY#</li>
            </ul>
            
            ```
    }
)

customAttribute attribute_02 (
    apexlangName: text
    attribute: 2
    name: Text
    type: textarea
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    builder {
        translatable: true
        displayWidth: 60
    }
    help {
        helpText:
            ```
            <p>
            	The text inside the notification.</p>
            <p>
            	The following placeholder syntax's are available:</p>
            <ul>
            	<li>
            		Server Side Substitution syntax: Replaces a placeholder during rendering of the page. Example: &amp;P6_CATEGORY.</li>
            	<li>
            		Client Side Substitution syntax: Replaces a placeholder with the current value of the browser. Example: #P6_CATEGORY#</li>
            </ul>
            
            ```
    }
)

customAttribute attribute_03 (
    apexlangName: imageUrl
    attribute: 3
    name: Image URL
    appearance {
        sequence: 30
    }
    builder {
        displayWidth: 60
    }
    help {
        helpText:
            ```
            <p>
            	The image URL used to display an image on the left.</p>
            
            ```
    }
)

customAttribute attribute_04 (
    apexlangName: sticky
    attribute: 4
    name: Sticky
    type: yesNo
    appearance {
        sequence: 40
    }
    help {
        helpText:
            ```
            <p>If you want it to fade out on its own or just sit there sticky.</p>
            
            ```
    }
)

customAttribute attribute_05 (
    apexlangName: hideAfterXSeconds
    attribute: 5
    name: Hide After x Seconds
    type: integer
    appearance {
        sequence: 50
    }
    builder {
        displayWidth: 4
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: N
    }
    help {
        helpText:
            ```
            <p>Specifies the number of seconds the message should be displayed before it should fade out.</p>
            
            ```
    }
)

