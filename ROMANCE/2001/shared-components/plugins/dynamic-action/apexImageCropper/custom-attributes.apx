customAttribute attribute_01 (
    apexlangName: showspinner
    attribute: 1
    name: showSpinner
    scope: app
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value: true
    }

    entry false (
        sequence: 20
        display: False
        return: false
    )

    entry true (
        sequence: 10
        display: True
        return: true
    )

)

customAttribute attribute_01 (
    apexlangName: viewmode
    attribute: 1
    name: viewMode
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value: 0
    }
    help {
        helpText: Define the view mode of the cropper.
    }

    entry theCanvasShouldNotBeWithinTheContai (
        sequence: 30
        display: the canvas should not be within the container
        return: 2
    )

    entry theContainerShouldBeWithinTheCanvas (
        sequence: 40
        display: the container should be within the canvas
        return: 3
    )

    entry theCropBoxIsJustWithinTheContainer (
        sequence: 10
        display: the crop box is just within the container
        return: 0
    )

    entry theCropBoxShouldBeWithinTheCanvas (
        sequence: 20
        display: the crop box should be within the canvas
        return: 1
    )

)

customAttribute attribute_02 (
    apexlangName: dragmode
    attribute: 2
    name: dragMode
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    default {
        value: crop
    }
    help {
        helpText: Define the dragging mode of the cropper.
    }

    entry createANewCropBox (
        sequence: 10
        display: create a new crop box
        return: crop
    )

    entry doNothing (
        sequence: 30
        display: do nothing
        return: none
    )

    entry moveTheCanvas (
        sequence: 20
        display: move the canvas
        return: move
    )

)

customAttribute attribute_03 (
    apexlangName: aspectratio
    attribute: 3
    name: aspectRatio
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 30
    }
    default {
        value: NaN
    }
    help {
        helpText: Set the aspect ratio of the crop box. By default, the crop box is free ratio.
    }

    entry attributeValue (
        sequence: 10
        display: 16:9
        return: 16 / 9
    )

    entry attributeValue2 (
        sequence: 20
        display: 4:3
        return: 4 / 3
    )

    entry attributeValue3 (
        sequence: 30
        display: 1:1
        return: 1 / 1
    )

    entry attributeValue4 (
        sequence: 40
        display: 2:3
        return: 2 / 3
    )

    entry free (
        sequence: 50
        display: Free
        return: NaN
    )

)

customAttribute attribute_04 (
    apexlangName: previewSelector
    attribute: 4
    name: preview Selector
    validation {
        maxLength: 500
    }
    appearance {
        sequence: 40
    }
    builder {
        displayWidth: 50
    }
    help {
        helpText:
            ```
            jQuery selector used to add extra elements (containers) for previewing.
            <br>
            <br><b>Notes:</b>
            <ul>
            <li>The maximum width is the initial width of preview container.</li>
            <li>The maximum height is the initial height of preview container.</li>
            <li>If you set an aspectRatio option, be sure to set the preview container with the same aspect ratio.</li>
            <li>If preview is not getting properly displayed, set overflow:hidden to the preview container.</li>
            </ul>
            ```
    }
)

