customAttribute attribute_04 (
    apexlangName: dataInterval
    attribute: 4
    name: Data Interval
    type: selectList
    appearance {
        sequence: 40
    }

    entry 10Seconds (
        sequence: 50
        display: 10 Seconds
        return: 10000
        advanced {
            quickPick: true
        }
    )

    entry 15Seconds (
        sequence: 60
        display: 15 Seconds
        return: 15000
    )

    entry 1Second (
        sequence: 10
        display: 1 Second
        return: 1000
        advanced {
            quickPick: true
        }
    )

    entry 2Seconds (
        sequence: 20
        display: 2 Seconds
        return: 2000
        advanced {
            quickPick: true
        }
    )

    entry 30Seconds (
        sequence: 70
        display: 30 Seconds
        return: 30000
    )

    entry 3Seconds (
        sequence: 30
        display: 3 Seconds
        return: 3000
        advanced {
            quickPick: true
        }
    )

    entry 5Seconds (
        sequence: 40
        display: 5 Seconds
        return: 5000
        advanced {
            quickPick: true
        }
    )

)

customAttribute attribute_05 (
    apexlangName: pauseOnHover
    attribute: 5
    name: Pause On Hover
    type: yesNo
    appearance {
        sequence: 50
    }
)

