customAttribute attribute_01 (
    apexlangName: type
    attribute: 1
    name: Type
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value: 1
    }
    supports {
        components: pageItems
    }
    help {
        helpText: Define the type of source used for the value shown on the gauge. Options include "From Input" and "From Query".
    }

    entry fromInput (
        sequence: 10
        display: From Input
        return: 1
        help {
            helpText: When chosen you will be provided with an input field which accepts an integer to show on the gauge.
        }
        advanced {
            quickPick: true
        }
    )

    entry fromQuery (
        sequence: 20
        display: From Query
        return: 2
        help {
            helpText: When chosen you will be provided with a text field which accepts a SQL query that must return a single column.
        }
        advanced {
            quickPick: true
        }
    )

)

customAttribute attribute_02 (
    apexlangName: percentInput
    attribute: 2
    name: Percent (Input)
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    default {
        value: 45
    }
    supports {
        components: pageItems
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: =
        value: 1
    }
    help {
        helpText: Enter a number to be shown on the gauge.
    }
)

customAttribute attribute_03 (
    apexlangName: percentSqlQuery
    attribute: 3
    name: Percent (SQL Query)
    type: sqlQuery
    validation {
        required: true
    }
    appearance {
        sequence: 30
    }
    default {
        value:
            ```
            SELECT 10
            FROM DUAL
            ```
    }
    supports {
        components: pageItems
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: =
        value: 2
    }
    help {
        helpText: Enter a SQL query that returns a single value.
    }
)

customAttribute attribute_04 (
    apexlangName: height
    attribute: 4
    name: Height
    type: integer
    appearance {
        sequence: 40
    }
    builder {
        unit: pixels
    }
    default {
        value: 250
    }
    supports {
        components: pageItems
    }
    help {
        helpText: Set the height of the gauge. The value is based on pixels, therefore an integer will suffice.
    }
)

customAttribute attribute_05 (
    apexlangName: theme
    attribute: 5
    name: Theme
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 50
    }
    default {
        value: 1
    }
    supports {
        components: pageItems
    }
    help {
        helpText: Choose from 3 preset themes. Theme 3 is the default theme. Setting the colours will override any colours in the themes.
    }

    entry theme (
        sequence: 10
        display: Theme 1
        return: 1
        advanced {
            quickPick: true
        }
    )

    entry theme2 (
        sequence: 20
        display: Theme 2
        return: 2
        advanced {
            quickPick: true
        }
    )

    entry theme3 (
        sequence: 30
        display: Theme 3
        return: 3
        advanced {
            quickPick: true
        }
    )

    entry theme4 (
        sequence: 40
        display: Theme 4
        return: 4
        advanced {
            quickPick: true
        }
    )

    entry theme5 (
        sequence: 50
        display: Theme 5
        return: 5
        advanced {
            quickPick: true
        }
    )

)

customAttribute attribute_06 (
    apexlangName: circleColour
    attribute: 6
    name: Circle Colour
    type: color
    appearance {
        sequence: 60
    }
    supports {
        components: pageItems
    }
    help {
        helpText: Set the colour of the circle. Using the color picker simplifies the process of choosing a colour.
    }
)

