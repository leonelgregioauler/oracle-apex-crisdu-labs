customAttribute attribute_03 (
    apexlangName: showControls
    attribute: 3
    name: Show controls
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 30
    }
    default {
        value: true
    }
    help {
        helpText: Whether or not the player has controls that the user can interact with. Without controls the only way to start the video playing is with the autoplay attribute
    }

    entry false (
        sequence: 20
        display: False
        return: false
    )

    entry true (
        sequence: 10
        display: True
        return: true
    )

)

customAttribute attribute_04 (
    apexlangName: autoplay
    attribute: 4
    name: Autoplay
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 40
    }
    default {
        value: false
    }
    help {
        helpText: If autoplay is true, the video will start playing as soon as page is loaded (without any interaction from the user). NOT SUPPORTED BY APPLE iOS DEVICES!
    }

    entry false (
        sequence: 20
        display: False
        return: false
    )

    entry true (
        sequence: 10
        display: True
        return: true
    )

)

customAttribute attribute_05 (
    apexlangName: loop
    attribute: 5
    name: Loop
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 50
    }
    default {
        value: false
    }
    help {
        helpText: The loop attribute causes the video to start over as soon as it ends.
    }

    entry false (
        sequence: 20
        display: False
        return: false
    )

    entry true (
        sequence: 10
        display: True
        return: true
    )

)

customAttribute attribute_06 (
    apexlangName: preload
    attribute: 6
    name: Preload
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 60
    }
    default {
        value: auto
    }
    help {
        helpText:
            ```
            The preload attribute informs the browser whether or not the video data should begin downloading as soon as the video tag is loaded.<br>
            The options are auto, metadata, and none.
            ```
    }
    examples {
        examples:
            ```
            'auto': Start loading the video immediately (if the browser agrees). Some mobile devices like iPhones and iPads will not preload the video in order to protect their users' bandwidth.<br>
            'metadata': Load only the meta data of the video, which includes information like the duration and dimensions of the video.<br>
            'none': Don't preload any of the video data. This will wait until the user clicks play to begin downloading.<br>
            ```
    }

    entry auto (
        sequence: 10
        display: Auto
        return: auto
    )

    entry metadata (
        sequence: 20
        display: Metadata
        return: metadata
    )

    entry none (
        sequence: 30
        display: None
        return: none
    )

)

customAttribute attribute_07 (
    apexlangName: style
    attribute: 7
    name: Style
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 70
    }
    default {
        value: DEFAULT
    }
    help {
        helpText: Default style of the video player.
    }
    examples {
        examples:
            ```
            - Default<br>
            - Big Play Button centered
            ```
    }

    entry bigPlayButtonCentered (
        sequence: 30
        display: Big Play Button centered
        return: BIGPLAYBUTTONCENTER
    )

    entry default (
        sequence: 10
        display: Default
        return: DEFAULT
    )

)

customAttribute attribute_08 (
    apexlangName: noJavascriptMessage
    attribute: 8
    name: No Javascript message
    appearance {
        sequence: 80
    }
    default {
        value: To view this video please enable JavaScript, and consider upgrading to a web browser that supports
    }
    help {
        helpText:
            ```
            Message that should be displayed if the browser doesn´t support javascript videos.<br>
            After the message a link with Text "HTML video" will be displayed.
            ```
    }
)

