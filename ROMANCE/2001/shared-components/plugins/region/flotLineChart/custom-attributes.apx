customAttribute attribute_17 (
    apexlangName: xValuesType
    attribute: 17
    name: X Values Type
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value: TIMESTAMP
    }
    help {
        helpText: Select the data type of the X values in your query.
    }

    entry date (
        sequence: 20
        display: DATE
        return: DATE
    )

    entry number (
        sequence: 30
        display: NUMBER
        return: NUMBER
    )

    entry timestamp (
        sequence: 10
        display: TIMESTAMP
        return: TIMESTAMP
    )

)

customAttribute attribute_18 (
    apexlangName: minimumHeight
    attribute: 18
    name: Minimum Height
    type: integer
    validation {
        maxLength: 5
    }
    appearance {
        sequence: 230
    }
    builder {
        unit: px
        displayWidth: 5
    }
    help {
        helpText: Enter the minimum height, in pixels, of the chart. Chart width will adapt to the size of the region.
    }
)

customAttribute attribute_19 (
    apexlangName: maximumHeight
    attribute: 19
    name: Maximum Height
    type: integer
    validation {
        maxLength: 5
    }
    appearance {
        sequence: 240
    }
    builder {
        unit: px
        displayWidth: 5
    }
    help {
        helpText: The maximum height, in pixels, of the chart. Chart width will adapt to the size of the region.
    }
)

customAttribute attribute_20 (
    apexlangName: linkTarget
    attribute: 20
    name: Link Target
    type: linkToTargetPageUrl
    appearance {
        sequence: 60
    }
    help {
        helpText: <p>Enter a target page to be called when the user clicks a chart entry.</p>
    }
    examples {
        examples:
            ```
            <p>Example 1: URL to navigate to page 10 and set P10_EMPNO to the EMPNO value of the clicked entry.
            <pre>f?p=&amp;APP_ID.:10:&amp;APP_SESSION.::&amp;DEBUG.:RP,10:P10_EMPNO:&amp;EMPNO.</pre>
            </p>
            <p>Example 2: Display the EMPNO value of the clicked entry in a JavaScript alert
            <pre>javascript:alert('current empno: &amp;EMPNO.');</pre>
            </p>
            ```
    }
)

customAttribute attribute_21 (
    apexlangName: lineInterpolation
    attribute: 21
    name: Line Interpolation
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 220
    }
    default {
        value: LINE
    }
    help {
        helpText: Select how the curvature of the line is fitted for the chart.
    }
    comments {
        comments: Whether the connection between consecutive data points should be shown as straight lines or as steps.
    }

    entry lines (
        sequence: 10
        display: Lines
        return: LINE
    )

    entry steps (
        sequence: 20
        display: Steps
        return: STEP
    )

)

customAttribute attribute_22 (
    apexlangName: fillArea
    attribute: 22
    name: Fill Area
    type: checkboxes
    appearance {
        sequence: 140
    }
    help {
        helpText: Select whether the area under the chart line should be filled.
    }
    comments {
        comments: Whether to color the area below each series.
    }

    entry attributeValue (
        sequence: 10
        display: " "
        return: Y
    )

)

customAttribute attribute_23 (
    apexlangName: colorSqlQuery
    attribute: 23
    name: Color SQL Query
    type: sqlQuery
    validation {
        required: true
        minColumns: 2
        maxColumns: 2
    }
    appearance {
        sequence: 210
    }
    dependingOn {
        attribute: @attribute_13/component
        conditionType: =
        value: COLUMN
    }
    help {
        helpText:
            ```
            Enter a SQL Query that maps a series name to an RGB color. The first column must contain the series names (and those values must match the ones returned from the region SQL) and the second column must have the RGB or RGBA color notation for the series. 
            Both columns must be VARCHAR2.
            ```
    }
    examples {
        examples:
            ```
            <pre>select 'SALES', rgb(0,255,0)
            from dual
            UNION
            select 'RESEARCH', rgba(0,25,47,0.5)
            from dual;</pre>
            ```
    }
)

customAttribute attribute_24 (
    apexlangName: valueFormatMask
    attribute: 24
    name: Value Format Mask
    appearance {
        sequence: 150
    }
    help {
        helpText: Enter the format mask used to display the values.
    }
)

