customAttribute attribute_01 (
    apexlangName: maximumAspectRatio
    attribute: 1
    name: Maximum Aspect Ratio
    scope: app
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 520
    }
    builder {
        displayWidth: 5
    }
    default {
        value: 3
    }
    help {
        helpText: The maximum aspect ratio that Flot line charts use to recommend a height. A max aspect ratio of 3 means that the chart's width should be no greater than 3 times its height. It can be overridden by the 'Max Height' setting on each region.
    }
)

customAttribute attribute_01 (
    apexlangName: xValuesColumn
    attribute: 1
    name: X Values Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    supports {
        dataTypes: timestamp
    }
    dependingOn {
        attribute: @attribute_17/component
        conditionType: =
        value: TIMESTAMP
    }
    help {
        helpText: Select the timestamp column from the region SQL Query that holds the X-axis values for the chart.
    }
)

customAttribute attribute_02 (
    apexlangName: minimumAspectRatio
    attribute: 2
    name: Minimum Aspect Ratio
    scope: app
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 510
    }
    builder {
        displayWidth: 5
    }
    default {
        value: 1.333
    }
    help {
        helpText: The minimum aspect ratio that Flot line charts use to recommend a height. A min aspect ratio of 1.333 means that the chart's width should be no less than 1.333 times its height. It can be overridden by the 'Min Height' setting on each region.
    }
)

customAttribute attribute_02 (
    apexlangName: yValuesColumn
    attribute: 2
    name: Y Values Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 50
    }
    supports {
        dataTypes: number
    }
    help {
        helpText: Select the column from the region SQL Query that holds the Y-axis values for the chart.
    }
)

customAttribute attribute_03 (
    apexlangName: multipleSeries
    attribute: 3
    name: Multiple Series
    type: checkboxes
    appearance {
        sequence: 70
    }
    help {
        helpText: Select whether to enable multi-series functionality on the chart.
    }

    entry attributeValue (
        sequence: 10
        display: " "
        return: Y
    )

)

customAttribute attribute_04 (
    apexlangName: multipleSeriesColumn
    attribute: 4
    name: Multiple Series Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 80
    }
    default {
        value: SERIES
    }
    dependingOn {
        attribute: @attribute_03/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Select the column from the region SQL Query that defines the multiple series for the chart. The values from this column will become the labels for the series.
    }
)

customAttribute attribute_05 (
    apexlangName: singleSeriesName
    attribute: 5
    name: Single Series Name
    validation {
        required: true
    }
    appearance {
        sequence: 90
    }
    builder {
        translatable: true
    }
    dependingOn {
        attribute: @attribute_03/component
        conditionType: isNull
    }
    help {
        helpText: Enter the name of the single data series which is shown on the legend.
    }
)

customAttribute attribute_06 (
    apexlangName: dataPoints
    attribute: 6
    name: Data Points
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 130
    }
    default {
        value: NONE
    }
    dependingOn {
        attribute: @attribute_21/component
        conditionType: !=
        value: STEP
    }
    help {
        helpText: Select the symbols used to mark the chart's data points. Use "Don't show" to disable markers.
    }

    entry circle (
        sequence: 20
        display: Circle
        return: CIRCLE
    )

    entry cross (
        sequence: 50
        display: Cross
        return: CROSS
    )

    entry diamond (
        sequence: 40
        display: Diamond
        return: DIAMOND
    )

    entry donTShow (
        sequence: 10
        display: Don't show
        return: NONE
    )

    entry square (
        sequence: 30
        display: Square
        return: SQUARE
    )

    entry triangle (
        sequence: 60
        display: Triangle
        return: TRIANGLE
    )

)

customAttribute attribute_07 (
    apexlangName: axisTitles
    attribute: 7
    name: Axis Titles
    type: checkboxes
    appearance {
        sequence: 100
    }
    help {
        helpText: Select whether to include labels on the X-axis and/or the Y-axis. Leave both unselected to hide them.
    }

    entry x (
        sequence: 10
        display: X
        return: X
    )

    entry y (
        sequence: 20
        display: Y
        return: Y
    )

)

customAttribute attribute_08 (
    apexlangName: xAxisTitle
    attribute: 8
    name: X-Axis Title
    validation {
        required: true
    }
    appearance {
        sequence: 110
    }
    builder {
        translatable: true
        displayWidth: 20
    }
    dependingOn {
        attribute: @attribute_07/component
        conditionType: inList
        list: [
            X:Y
            X
        ]
    }
    help {
        helpText: The label for the X-axis.
    }
)

customAttribute attribute_09 (
    apexlangName: yAxisTitle
    attribute: 9
    name: Y-Axis Title
    validation {
        required: true
    }
    appearance {
        sequence: 120
    }
    builder {
        translatable: true
        displayWidth: 20
    }
    dependingOn {
        attribute: @attribute_07/component
        conditionType: inList
        list: [
            X:Y
            Y
        ]
    }
    help {
        helpText: The label for the Y-axis.
    }
)

customAttribute attribute_10 (
    apexlangName: tooltips
    attribute: 10
    name: Tooltips
    type: checkboxes
    appearance {
        sequence: 160
    }
    help {
        helpText:
            ```
            <p>Check which attributes are shown on the tooltip for each data point. The 'Custom column' option allows you to specify text for each individual data point as an additional column in the region SQL Query.</p>
            <p>Note: Leave all options unchecked to disable the tooltip.</p>
            ```
    }

    entry customColumn (
        sequence: 30
        display: Custom column
        return: CUSTOM
    )

    entry showSeriesName (
        sequence: 0
        display: Show series name
        return: SERIES
    )

    entry showXValue (
        sequence: 10
        display: Show X value
        return: X
    )

    entry showYValue (
        sequence: 20
        display: Show Y value
        return: Y
    )

)

customAttribute attribute_11 (
    apexlangName: tooltipColumn
    attribute: 11
    name: Tooltip Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 170
    }
    dependingOn {
        attribute: @attribute_10/component
        conditionType: inList
        list: [
            SERIES:X:Y:CUSTOM
            SERIES:X:CUSTOM
            SERIES:Y:CUSTOM
            X:Y:CUSTOM
            SERIES:CUSTOM
            X:CUSTOM
            Y:CUSTOM
            CUSTOM
        ]
    }
    help {
        helpText: Enter the column from the region SQL Query that holds the custom tooltip values.
    }
)

customAttribute attribute_12 (
    apexlangName: legend
    attribute: 12
    name: Legend
    type: checkboxes
    appearance {
        sequence: 180
    }
    help {
        helpText: Select whether to display a legend on the chart. The legend will display the names and colors of all the data series.
    }

    entry attributeValue (
        sequence: 10
        display: " "
        return: Y
    )

)

customAttribute attribute_13 (
    apexlangName: colorScheme
    attribute: 13
    name: Color Scheme
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 190
    }
    default {
        value: MODERN
    }
    help {
        helpText: <p>Select the color scheme used to render the chart.</p>
    }

    entry custom (
        sequence: 60
        display: Custom
        return: CUSTOM
    )

    entry metro (
        sequence: 40
        display: Metro
        return: METRO
    )

    entry modern (
        sequence: 10
        display: Modern
        return: MODERN
    )

    entry modern2 (
        sequence: 20
        display: Modern 2
        return: MODERN2
    )

    entry solar (
        sequence: 30
        display: Solar
        return: SOLAR
    )

    entry sqlQuery (
        sequence: 50
        display: SQL Query
        return: COLUMN
    )

)

customAttribute attribute_14 (
    apexlangName: colors
    attribute: 14
    name: Colors
    validation {
        required: true
    }
    appearance {
        sequence: 200
    }
    dependingOn {
        attribute: @attribute_13/component
        conditionType: =
        value: CUSTOM
    }
    help {
        helpText: Enter a comma-separated list of RGB color strings to use as a color scheme for the chart.
    }
    examples {
        examples:
            ```
            <dl>
              <dt>RGB color notation  (red,green,blue)</dt><dd><pre>rgba(0,25,47,0.5)</pre>; or </dd>
              <dt>RGBA color notation (red,green,blue,alpha)</dt><dd><pre>rgba(0,25,47,0.5)</pre>; or </dd>
            </dl>
            ```
    }
)

