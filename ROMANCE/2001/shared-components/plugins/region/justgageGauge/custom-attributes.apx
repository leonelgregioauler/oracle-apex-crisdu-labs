customAttribute attribute_01 (
    apexlangName: valueColumn
    attribute: 1
    name: Value Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    supports {
        dataTypes: number
    }
    help {
        helpText: Select the column from the region SQL Query that holds the value for the guage.
    }
)

customAttribute attribute_02 (
    apexlangName: minValueColumn
    attribute: 2
    name: Min Value Column
    type: regionSqlQueryColumn
    appearance {
        sequence: 20
    }
    supports {
        dataTypes: number
    }
    help {
        helpText:
            ```
            <p>Select the column from the region SQL Query that holds the  minimum value represented by the gauge. When the value is equal or lesser than the minimum, the gauge will be shown as completely empty.</p>
            <p>Note: If left empty, the minimum value defaults to 0.</p>
            ```
    }
)

customAttribute attribute_03 (
    apexlangName: maxValueColumn
    attribute: 3
    name: Max Value Column
    type: regionSqlQueryColumn
    appearance {
        sequence: 30
    }
    supports {
        dataTypes: number
    }
    help {
        helpText:
            ```
            <p>Select the column from the region SQL Query that holds the  maximum value represented by the gauge. When the value is equal or greater than the maximum, the gauge will be shown as completely full.</p>
            <p>Note: If left blank, the maximum value defaults to the lesser power of 10 greater than the value.</p>
            ```
    }
)

customAttribute attribute_04 (
    apexlangName: showLabels
    attribute: 4
    name: Show Labels
    type: yesNo
    appearance {
        sequence: 50
    }
    default {
        value: true
    }
    help {
        helpText: Select whether labels are displayed.
    }
)

customAttribute attribute_05 (
    apexlangName: title
    attribute: 5
    name: Title
    appearance {
        sequence: 60
    }
    builder {
        translatable: true
        displayWidth: 20
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Enter the text for the label above the gauge.
    }
)

customAttribute attribute_06 (
    apexlangName: units
    attribute: 6
    name: Units
    appearance {
        sequence: 70
    }
    builder {
        translatable: true
        displayWidth: 20
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Enter the text for the label immediately below the gauge value.
    }
)

customAttribute attribute_07 (
    apexlangName: valuePrefix
    attribute: 7
    name: Value Prefix
    appearance {
        sequence: 80
    }
    builder {
        translatable: true
        displayWidth: 2
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Enter the text that prefixes the value label.
    }
)

customAttribute attribute_08 (
    apexlangName: valueSuffix
    attribute: 8
    name: Value Suffix
    appearance {
        sequence: 90
    }
    builder {
        translatable: true
        displayWidth: 2
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Enter the text that is appended to the value label.
    }
)

customAttribute attribute_09 (
    apexlangName: showMinAndMaxValues
    attribute: 9
    name: Show Min and Max Values
    type: checkboxes
    appearance {
        sequence: 100
    }
    dependingOn {
        attribute: @attribute_17/component
        conditionType: =
        value: GAUGE
    }
    help {
        helpText: Select whether the actual minimum and maximum values are displayed on the gauge.
    }

    entry attributeValue (
        sequence: 10
        display: " "
        return: Y
    )

)

customAttribute attribute_10 (
    apexlangName: showShadow
    attribute: 10
    name: Show Shadow
    type: checkboxes
    appearance {
        sequence: 220
    }
    help {
        helpText: Select whether to render a shadow gradient on the gauge.
    }

    entry attributeValue (
        sequence: 10
        display: " "
        return: Y
    )

)

customAttribute attribute_11 (
    apexlangName: shadowOpacity
    attribute: 11
    name: Shadow Opacity
    type: number
    validation {
        required: true
        maxLength: 5
    }
    appearance {
        sequence: 230
    }
    builder {
        displayWidth: 5
    }
    default {
        value: 0.5
    }
    dependingOn {
        attribute: @attribute_10/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Enter the opacity of the shadow, measured between 0 and 1.
    }
)

customAttribute attribute_12 (
    apexlangName: shadowOffset
    attribute: 12
    name: Shadow Offset
    type: integer
    validation {
        required: true
        maxLength: 5
    }
    appearance {
        sequence: 240
    }
    builder {
        unit: px
        displayWidth: 5
    }
    default {
        value: 0
    }
    dependingOn {
        attribute: @attribute_10/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Enter the vertical offset of the shadow, in pixels.
    }
)

customAttribute attribute_13 (
    apexlangName: gaugeWidthScale
    attribute: 13
    name: Gauge Width Scale
    type: number
    validation {
        required: true
        maxLength: 5
    }
    appearance {
        sequence: 160
    }
    builder {
        displayWidth: 5
    }
    default {
        value: 1
    }
    help {
        helpText: Enter the scale of the gauge's width.
    }
)

customAttribute attribute_14 (
    apexlangName: colorScheme
    attribute: 14
    name: Color Scheme
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 190
    }
    default {
        value: GTR
    }
    help {
        helpText: Select the color scheme for the gauge.
    }

    entry customColorS (
        sequence: 30
        display: Custom Color(s)
        return: CUSTOM
    )

    entry dynamicGreenToRed (
        sequence: 10
        display: Dynamic Green-to-Red
        return: GTR
    )

    entry dynamicRedToGreen (
        sequence: 20
        display: Dynamic Red-to-Green
        return: RTG
    )

)

customAttribute attribute_15 (
    apexlangName: gaugeColorS
    attribute: 15
    name: Gauge Color(s)
    validation {
        required: true
    }
    appearance {
        sequence: 200
    }
    default {
        value: #144485
    }
    dependingOn {
        attribute: @attribute_14/component
        conditionType: =
        value: CUSTOM
    }
    help {
        helpText: Enter a comma-separated list of RGB colors to be used on the gauge. The first color will be used when the value is near the minimum and the last color will be used when the value is near the maximum. Enter only one color for a solid fill.
    }
)

customAttribute attribute_16 (
    apexlangName: emptyColor
    attribute: 16
    name: Empty Color
    type: color
    validation {
        required: true
    }
    appearance {
        sequence: 210
    }
    default {
        value: #d9d9d9
    }
    help {
        helpText: Enter the color to be used on the 'empty' sector of the gauge.
    }
)

customAttribute attribute_17 (
    apexlangName: gaugeMode
    attribute: 17
    name: Gauge Mode
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 40
    }
    default {
        value: GAUGE
    }
    help {
        helpText: Select whether to render the gauge as a half circle or as a full circle.
    }

    entry donut (
        sequence: 20
        display: Donut
        return: DONUT
    )

    entry normal (
        sequence: 10
        display: Normal
        return: GAUGE
    )

)

customAttribute attribute_18 (
    apexlangName: width
    attribute: 18
    name: Width
    type: integer
    validation {
        maxLength: 5
    }
    appearance {
        sequence: 170
    }
    builder {
        unit: px
        displayWidth: 5
    }
    help {
        helpText:
            ```
            <p>Enter the fixed width of the gauge, in pixels.</p>
            <p>Note: Leave this attribute blank for automatic/responsive.</p>
            ```
    }
)

customAttribute attribute_19 (
    apexlangName: height
    attribute: 19
    name: Height
    type: integer
    validation {
        maxLength: 5
    }
    appearance {
        sequence: 180
    }
    builder {
        unit: px
        displayWidth: 5
    }
    help {
        helpText:
            ```
            <p>Enter the fixed height of the gauge, in pixels.</p>
            <p>Note: Leave blank for automatic/responsive.</p>
            ```
    }
)

customAttribute attribute_20 (
    apexlangName: description
    attribute: 20
    name: Description
    appearance {
        sequence: 110
    }
    builder {
        translatable: true
    }
    help {
        helpText:
            ```
            Enter the description to be shown under the Gauge. You may use the following text replacements:
            <ul>
            <li>:MIN:</li>
            <li>:MAX:</li>
            <li>:VALUE:</li>
            </ul>
            ```
    }
    examples {
        examples: The actual value is :VALUE: (out of :MAX:)
    }
)

customAttribute attribute_21 (
    apexlangName: heading
    attribute: 21
    name: Heading
    validation {
        maxLength: 200
    }
    appearance {
        sequence: 130
    }
    builder {
        translatable: true
        displayWidth: 20
    }
    help {
        helpText: Enter the heading displayed directly above the description. This is commonly set to the label for the chart.
    }
)

customAttribute attribute_22 (
    apexlangName: headingLinkTarget
    attribute: 22
    name: Heading Link Target
    type: linkToTargetPageUrl
    appearance {
        sequence: 140
    }
    builder {
        includeColumnsInItemsPicker: true
    }
    help {
        helpText: <p>Enter a target page to be called when the user clicks the heading.</p>
    }
    examples {
        examples:
            ```
            <p>Example 1: URL to navigate to page 10 and set P10_EMPNO to the EMPNO value of the clicked entry.
            <pre>f?p=&amp;APP_ID.:10:&amp;APP_SESSION.::&amp;DEBUG.:RP,10:P10_EMPNO:&amp;EMPNO.</pre>
            </p>
            <p>Example 2: Display the EMPNO value of the clicked entry in a JavaScript alert
            <pre>javascript:alert('current empno: &amp;EMPNO.');</pre>
            </p>
            ```
    }
)

customAttribute attribute_23 (
    apexlangName: descriptionLinkTarget
    attribute: 23
    name: Description Link Target
    type: linkToTargetPageUrl
    appearance {
        sequence: 120
    }
    builder {
        includeColumnsInItemsPicker: true
    }
    help {
        helpText: <p>Enter a target page to be called when the user clicks the description.</p>
    }
    examples {
        examples:
            ```
            <p>Example 1: URL to navigate to page 10 and set P10_EMPNO to the EMPNO value of the clicked entry.
            <pre>f?p=&amp;APP_ID.:10:&amp;APP_SESSION.::&amp;DEBUG.:RP,10:P10_EMPNO:&amp;EMPNO.</pre>
            </p>
            <p>Example 2: Display the EMPNO value of the clicked entry in a JavaScript alert
            <pre>javascript:alert('current empno: &amp;EMPNO.');</pre>
            </p>
            ```
    }
)

customAttribute attribute_24 (
    apexlangName: decimalPlaces
    attribute: 24
    name: Decimal Places
    type: integer
    appearance {
        sequence: 150
    }
    builder {
        displayWidth: 5
    }
    help {
        helpText: Enter the number of decimal places to display. The default value is "0".
    }
)

