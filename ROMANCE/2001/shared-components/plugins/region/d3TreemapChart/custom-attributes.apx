customAttribute attribute_01 (
    apexlangName: minimumAspectRatio
    attribute: 1
    name: Minimum Aspect Ratio
    scope: app
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 510
    }
    builder {
        common: false
        showInWizard: false
        displayWidth: 5
    }
    default {
        value: 1.33
    }
    help {
        helpText:
            ```
            <p>Enter the minimum aspect ratio that charts use to recommend a height. A minimum aspect ratio of 1.333 means that the chart's width should be no less than 1.333 times its height. </p>
            <p>Note: This setting can be overridden by the 'Min Height' setting on the region.</p>
            ```
    }
)

customAttribute attribute_02 (
    apexlangName: maximumAspectRatio
    attribute: 2
    name: Maximum Aspect Ratio
    scope: app
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 520
    }
    builder {
        common: false
        showInWizard: false
    }
    default {
        value: 3
    }
    help {
        helpText:
            ```
            <p>Enter the maximum aspect ratio that charts use to recommend a height. A maximum aspect ratio of 3 means that the chart's width should be no greater than 3 times its height. </p>
            <p>Note: This setting can be overridden by the 'Maximum Height' setting on the region.</p>
            ```
    }
)

customAttribute attribute_02 (
    apexlangName: colorScheme
    attribute: 2
    name: Color Scheme
    type: selectList
    componentLov {
        nullText: Theme Default
    }
    appearance {
        sequence: 100
    }
    help {
        helpText: <p>Select the color scheme used to render the chart.</p>
    }

    entry metro (
        sequence: 90
        display: Metro
        return: METRO
    )

    entry modern (
        sequence: 60
        display: Modern
        return: MODERN
    )

    entry modern2 (
        sequence: 70
        display: Modern 2
        return: MODERN2
    )

    entry solar (
        sequence: 80
        display: Solar
        return: SOLAR
    )

)

customAttribute attribute_12 (
    apexlangName: labelColumn
    attribute: 12
    name: Label Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    help {
        helpText: Select the column from the region SQL Query that holds the labels for the chart.
    }
)

customAttribute attribute_13 (
    apexlangName: valueColumn
    attribute: 13
    name: Value Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    supports {
        dataTypes: number
    }
    help {
        helpText: Select the column from the region SQL Query that holds the labels for the chart.
    }
)

customAttribute attribute_14 (
    apexlangName: primaryKeyColumn
    attribute: 14
    name: Primary Key Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 40
    }
    help {
        helpText: Select the column from the region SQL Query that holds the primary key values for the chart. The primary key and parent key columns are used to define the hierarchy for the chart.
    }
)

customAttribute attribute_15 (
    apexlangName: parentKeyColumn
    attribute: 15
    name: Parent Key Column
    type: regionSqlQueryColumn
    appearance {
        sequence: 50
    }
    help {
        helpText: Select the column from the region SQL Query that holds the parent key values for the chart. The primary key and parent key columns are used to define the hierarchy for the chart.
    }
)

customAttribute attribute_16 (
    apexlangName: colorGroupColumn
    attribute: 16
    name: Color Group Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 60
    }
    help {
        helpText: Select the column from the region SQL Query that holds the color group values for the chart.
    }
)

customAttribute attribute_19 (
    apexlangName: tooltips
    attribute: 19
    name: Tooltips
    type: checkboxes
    appearance {
        sequence: 70
    }
    builder {
        common: false
        showInWizard: false
    }
    help {
        helpText:
            ```
            <p>Check which attributes are shown on the tooltip for each data point. The 'Custom column' option allows you to specify text for each individual data point as an additional column in the region SQL Query.</p>
            <p>Note: Leave all options unchecked to disable the tooltip.</p>
            ```
    }

    entry customColumn (
        sequence: 20
        display: Custom column
        return: CUSTOM
    )

    entry showSeriesName (
        sequence: 10
        display: Show series name
        return: SERIES
    )

    entry showValue (
        sequence: 30
        display: Show Value
        return: VALUE
    )

)

customAttribute attribute_20 (
    apexlangName: tooltipColumn
    attribute: 20
    name: Tooltip Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 80
    }
    builder {
        common: false
        showInWizard: false
    }
    dependingOn {
        attribute: @attribute_19/component
        conditionType: inList
        list: [
            SERIES:CUSTOM:VALUE
            SERIES:CUSTOM
            CUSTOM:VALUE
            CUSTOM
        ]
    }
    help {
        helpText: Select the column from the region SQL Query that holds the tooltip values for the chart.
    }
)

customAttribute attribute_21 (
    apexlangName: minimumHeight
    attribute: 21
    name: Minimum Height
    type: integer
    validation {
        maxLength: 5
    }
    appearance {
        sequence: 110
    }
    builder {
        common: false
        showInWizard: false
        unit: px
        displayWidth: 5
    }
    help {
        helpText: Enter the minimum height, in pixels, of the chart. Chart width will adapt to the size of the region.
    }
)

customAttribute attribute_22 (
    apexlangName: maximumHeight
    attribute: 22
    name: Maximum Height
    type: integer
    validation {
        maxLength: 5
    }
    appearance {
        sequence: 120
    }
    builder {
        common: false
        showInWizard: false
        unit: px
        displayWidth: 5
    }
    help {
        helpText: Enter the maximum height, in pixels, of the chart. Chart width will adapt to the size of the region.
    }
)

customAttribute attribute_23 (
    apexlangName: legend
    attribute: 23
    name: Legend
    type: selectList
    componentLov {
        nullText: No Legend
    }
    appearance {
        sequence: 90
    }
    help {
        helpText: Select where the legend is displayed on the chart.
    }

    entry aboveChart (
        sequence: 10
        display: Above Chart
        return: TOP
    )

    entry belowChart (
        sequence: 20
        display: Below Chart
        return: BOTTOM
    )

)

customAttribute attribute_24 (
    apexlangName: linkTarget
    attribute: 24
    name: Link Target
    type: linkToTargetPageUrl
    appearance {
        sequence: 30
    }
    help {
        helpText: <p>Enter a target page to be called when the user clicks a chart entry.</p>
    }
    examples {
        examples:
            ```
            <p>Example 1: URL to navigate to page 10 and set P10_EMPNO to the EMPNO value of the clicked entry.
            <pre>f?p=&amp;APP_ID.:10:&amp;APP_SESSION.::&amp;DEBUG.:RP,10:P10_EMPNO:&amp;EMPNO.</pre>
            </p>
            <p>Example 2: Display the EMPNO value of the clicked entry in a JavaScript alert
            <pre>javascript:alert('current empno: &amp;EMPNO.');</pre>
            </p>
            ```
    }
)

customAttribute attribute_25 (
    apexlangName: configurationJson
    attribute: 25
    name: Configuration JSON
    type: textarea
    validation {
        required: true
    }
    appearance {
        sequence: 130
    }
    default {
        value:
            ```
            {
            "trdur":                       500,
            "opacity_normal":              "0.8",
            "opacity_highlight":           "1.0"
            }
            ```
    }
    help {
        helpText:
            ```
            This JSON contains some custom attributes for the chart plugin:
            -"trdur": Is the transition duration of the effects of the chart in milliseconds. 
            -"opacity_normal": The regular opacity of the nodes.
            -"opacity_highlight": The opacity when the node is hovered.
            ```
    }
)

