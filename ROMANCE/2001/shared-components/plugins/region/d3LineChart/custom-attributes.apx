customAttribute attribute_01 (
    apexlangName: maximumAspectRatio
    attribute: 1
    name: Maximum Aspect Ratio
    scope: app
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 520
    }
    builder {
        common: false
        showInWizard: false
        displayWidth: 5
    }
    default {
        value: 3
    }
    help {
        helpText:
            ```
            <p>Enter the maximum aspect ratio that charts use to recommend a height. A maximum aspect ratio of 3 means that the chart's width should be no greater than 3 times its height. </p>
            <p>Note: This setting can be overridden by the 'Maximum Height' setting on the region.</p>
            ```
    }
)

customAttribute attribute_01 (
    apexlangName: xValuesColumn
    attribute: 1
    name: X Values Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    supports {
        dataTypes: [
            number
            date
            timestamp
        ]
    }
    help {
        helpText: Select the column from the region SQL Query that holds the X-axis values for the chart.
    }
)

customAttribute attribute_02 (
    apexlangName: minimumAspectRatio
    attribute: 2
    name: Minimum Aspect Ratio
    scope: app
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 510
    }
    builder {
        common: false
        showInWizard: false
        displayWidth: 5
    }
    default {
        value: 1.333
    }
    help {
        helpText:
            ```
            <p>Enter the minimum aspect ratio that charts use to recommend a height. A minimum aspect ratio of 1.333 means that the chart's width should be no less than 1.333 times its height. </p>
            <p>Note: This setting can be overridden by the 'Minimum Height' setting on the region.</p>
            ```
    }
)

customAttribute attribute_02 (
    apexlangName: yValuesColumn
