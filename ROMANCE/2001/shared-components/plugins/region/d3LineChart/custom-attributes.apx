customAttribute attribute_06 (
    apexlangName: xAxisValueFormatMask
    attribute: 6
    name: X-Axis Value Format Mask
    type: selectList
    componentLov {
        nullText: Custom
    }
    appearance {
        sequence: 110
    }
    builder {
        common: false
        showInWizard: false
    }
    help {
        helpText: Select the data format mask for the X-axis.
    }

    entry 12Jan (
        sequence: 160
        display: 12 Jan 2000
        return: %e %b %Y
    )

    entry 144k (
        sequence: 71
        display: 14.4k
        return: .3s
        help {
            helpText: Precision 3, SI suffixes
        }
    )

    entry 144k2 (
        sequence: 120
        display: $14.4k
        return: $.3s
        help {
            helpText: Currency, precison 3, SI suffixes
        }
    )

    entry attributeValue (
        sequence: 30
        display: 14,435
        return: ,.0f
        help {
            helpText: Comma-separated thousands, integers
        }
    )

    entry attributeValue10 (
        sequence: 140
        display: 12/24/2000
        return: %x
    )

    entry attributeValue2 (
        sequence: 40
        display: 14435
        return: .0f
        help {
            helpText: Integer
        }
    )

    entry attributeValue3 (
        sequence: 60
        display: 14,435.49
        return: ,.2f
        help {
            helpText: Comma-separated thousands, 2 decimals
        }
    )

    entry attributeValue4 (
        sequence: 70
        display: 14435.49
        return: .2f
        help {
            helpText: 2 decimals
        }
    )

    entry attributeValue5 (
        sequence: 80
        display: $14,435
        return: $,.0f
        help {
            helpText: Currency, comma-separated thousands, integer
        }
    )

    entry attributeValue6 (
        sequence: 90
        display: $14435
        return: $.0f
        help {
            helpText: Currency, integer
        }
    )

    entry attributeValue7 (
        sequence: 99
        display: $14,435.49
        return: $,.2f
        help {
            helpText: Currency, comma-separated thousands, 2 decimals
        }
    )

    entry attributeValue8 (
        sequence: 100
        display: $14435.49
        return: $.2f
        help {
            helpText: Currency, 2 decimals
        }
    )

    entry attributeValue9 (
        sequence: 130
        display: 23:45:12
        return: %X
    )

    entry day (
        sequence: 170
        display: Day
        return: %A
        help {
            helpText: Full weekday name
        }
    )

    entry monJan (
        sequence: 150
        display: Mon Jan 5 23:45:12 2000
        return: %c
    )

    entry month (
        sequence: 180
        display: Month
        return: %B
        help {
            helpText: Full month name
        }
    )

    entry year (
        sequence: 190
        display: Year
        return: %Y
        help {
            helpText: Full year
        }
    )

)

customAttribute attribute_07 (
    apexlangName: xAxisCustomValueFormatMask
    attribute: 7
    name: X-Axis Custom Value Format Mask
    validation {
        required: true
    }
    appearance {
        sequence: 120
    }
    builder {
        common: false
        showInWizard: false
    }
    default {
        value: FRIENDLY
    }
    dependingOn {
        attribute: @attribute_06/component
        conditionType: isNull
    }
    help {
        helpText: Enter the D3 format string used to format the X-axis values on axes, tooltips and legends. Use <pre>FRIENDLY</pre> to utilize sensible formatting defaults for your data.
    }
    examples {
        examples:
            ```
            <ul>
            <li><b>,d</b> = 14,435</li>
            <li><b>d</b> = 14435</li>
            <li><b>,.2f</b> = 14,435.49</li>
            <li><b>.2f</b> = 14435.49</li>
            <li><b>.3s</b> = 14.4k</li>
            <li><b>$,d</b> = $14,435</li>
            <li><b>$d</b> = $14435</li>
            <li><b>$,.2f</b> = $14,435.49</li>
            <li><b>$.2f</b> = $14435.49</li>
            <li><b>$.3s</b> = $14.4k</li>
            <li><b>n" ft."</b> = 14435.49 ft. **</li>
            <li><b>"[["$.3s"]]"</b> = [[$14.4k]] **</li>
            <li>Refer to https://github.com/mbostock/d3/wiki/Formatting#d3_format for the full syntax specification</li>
            </ul>
            <br/>
            ** You may use leading and trailing double-quoted literals, but this feature is not part of the standard D3 specification
            ```
    }
)

