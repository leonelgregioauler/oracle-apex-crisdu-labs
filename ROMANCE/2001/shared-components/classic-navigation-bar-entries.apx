    }
    serverSideCondition {
        type: expression
        plsqlExpression: v('APP_USER') not in ('PAMELAMORAES','KARENBENEDETTI', 'ROMARIOSCHMITT', 'TIELEMULLER', 'ESTEFANISILVA', 'TAISGOMES', 'TATIANEHACK', 'JENIFERGELINGER', 'CRISTIANEWILHELMS','ALEXLEANDRO')
    }
)

