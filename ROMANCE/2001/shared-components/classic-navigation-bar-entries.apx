classicNavigationBarEntry consulta-cep (
    label: Consulta CEP
    layout {
        sequence: 7
    }
    link {
        target: {
            page: 473
            clearCache: 473
            action: resetPagination
        }
    }
    serverSideCondition {
        type: rowsReturned
        sqlQuery:
            ```sql
            select 1
            from dual
            where pck_util.fnc_verificaacesso(2001,v('APP_USER')) = 'S'
              and exists ( select 1
                           from usuarios u
                           where usuario = v('APP_USER')
                             and idgerente in (80,143) )
            
            ```
    }
)

classicNavigationBarEntry consulta-doc (
    label: Consulta Doc.
    layout {
        sequence: 8
    }
