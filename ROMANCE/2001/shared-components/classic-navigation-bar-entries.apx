classicNavigationBarEntry procurar-evento (
    label: Procurar Evento
    layout {
        sequence: 5
    }
    link {
        target: {
            page: 555
            action: resetPagination
        }
    }
    serverSideCondition {
        type: expression
        language: sql
        sqlExpression:
            ```sql
            (exists ( select 1
                        from usuariosgruposatendimento ug
                       where ug.idgrupoatendimento = 0
                         and ug.usuario            = v('APP_USER')))
            or ( favorita.pck_util_fav.fnc_verificaacesso(330, pidusuario => favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S')
            ```
    }
)

