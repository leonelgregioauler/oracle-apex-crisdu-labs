app F100020002000 (
    name: xGerenciador Filial
    version: release 1.0
    logo {
        type: image
        imageUrl: #APP_FILES#logo_optimus.png
    }
    navigation {
        homeUrl: {
            page: 1
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-addActions
            js-defaultCollapsed
            js-navCollapsed--default
            t-TreeNav--styleA
        ]
        list: @menu-de-navegação
    }
    navigationBar {
        implementation: classic
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
    }
    javaScript {
        fileUrls: [
            #WORKSPACE_FILES#funcoes_anexos.js
            #APP_FILES#assistente-ia#MIN#.js
        ]
        includeLegacyJavascript: [
            pre18
            18
        ]
        includeJqueryMigrate: true
    }
    css {
        fileUrls: [
            #IMAGE_PREFIX#pkgapp_ui/css/5.0#MIN#.css
            #APP_FILES#assistente-ia#MIN#.css
            #APP_FILES#global#MIN#.css
        ]
    }
    authentication {
        scheme: @database-account
        publicUser: APEX_PUBLIC_USER
    }
    authorization {
        scheme: @horário-de-acesso
        runOnPublicPages: true
        sourceForRoleOrGroupSchemes: authenticationScheme
    }
    security {
        embedInFrames: allowSameOrigin
        referrerPolicy: strictOriginWhenCrossOrigin
        allowBotAccess: true
        runtimeApiUsage: [
            modifyThisApp
            modifyOtherApps
            modifyWorkspaceRepository
        ]
    }
    sessionStateProtection {
        bookmarkHashFunction: sha1
        acceptPre202UrlChecksums: false
    }
    sessionManagement {
        rejoinSessions: publicSessions
        sessionStateCommits: immediate
    }
    globalization {
        primaryLanguage: pt-br
        documentDirection: leftToRight
    }
    progressiveWebApp {
        enable: false
    }
    rowSearch {
        tokenize: false
    }
    reportPrinting {
        type: useInstanceSettings
    }
    runtime {
        friendlyUrls: false
        allowFeedback: true
        compatibilityMode: 21.2
        accessibleReadOnlyItems: false
    }
    advanced {
        passEcid: false
        modernizeApp: true
    }
)

