page 713 (
    name: Relatorio Categorias Estrelas Romance
    title: Relatorio Categorias Estrelas Romance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region novo-cadastro (
        name: Novo Cadastro
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDCATEGORIACLUBE, 
                       NOMECATEGORIA
                from CATEGORIASCLUBES
                 order by 2
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 714
                items: {
                    P714_IDCATEGORIACLUBE: #IDCATEGORIACLUBE##IDCLUBEDESUCESSO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 3010639764518457212
        }

        column IDCATEGORIACLUBE (
            type: hidden
            heading {
                heading: Idcategoriaclube
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMECATEGORIA (
            type: plainText
            heading {
                heading: Nome Categoria
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 15053994 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IDCATEGORIACLUBE (
                sequence: 1
            )

            displayColumn NOMECATEGORIA (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Cadastro
        layout {
            sequence: 30
            region: @novo-cadastro
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 714
                clearCache: 714
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

