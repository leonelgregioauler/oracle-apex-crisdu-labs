page 732 (
    name: Relatório de Metas Romance
    title: Relatório de Metas Romance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cicloromance, 
                       --decode(ciclocongelado, 'S', 'Sim','Não') ciclocongelado,
                       --to_char(max(datacongelado),'dd/mm/rrrr hh24:mi:ss') datacongelado, 
                       --usuariocongelamento, 
                       --to_char(max(datacriacao),'dd/mm/rrrr hh24:mi:ss') datacriacao, 
                       --usuariocriacao, 
                       count(*) qtdefiliais,
                       sum(desafiocalculadoanterior) desafioanterior,
                       sum(desafiocalculadoatual)    desafioatual,
                       sum(desafiocalcant_conv)      desafiocalcant_conv,
                       sum(desafiocalcatual_conv)    desafiocalcatual_conv
                  from (select mr.cicloromance,
                               mr.ciclocongelado,
                               mr.datacongelado,
                               mr.usuariocongelamento,
                               mr.datacriacao,
                               mr.usuariocriacao,
                               mr.desafiocalculadoanterior /* *
                               (select fatorconversao
                                  from catal.filiais
                                 where idfilial = mr.idfilial )*/  desafiocalculadoanterior,
                               --
                               mr.desafiocalculadoatual /* *
                               (select fatorconversao
                                  from catal.filiais
                                 where idfilial = mr.idfilial ) */ desafiocalculadoatual,
                               mr.desafiocalculadoanterior  *
                               (select fatorconversao
                                  from catal.filiais
                                 where idfilial = mr.idfilial )  desafiocalcant_conv,
                               --
                               mr.desafiocalculadoatual  *
                               (select fatorconversao
                                  from catal.filiais
                                 where idfilial = mr.idfilial )  desafiocalcatual_conv
                           from metasdesafioromance mr ) m
                 group by cicloromance/*, 
                       ciclocongelado, 
                       usuariocongelamento, 
                       usuariocriacao*/
                       
                 order by to_number(substr(cicloromance,4,4)) desc,
                          to_number(substr(cicloromance,1,2)) desc
                ```
            pageItemsToSubmit: P0_IDFILIAL
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2434579546581779621
        }

