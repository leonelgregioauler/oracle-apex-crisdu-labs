    process atualizarciclo (
        name: AtualizarCiclo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_metasromance.prc_gerametasdesafioromance(:P732_CICLOROMANCE,
                                                               V('APP_USER'),
                                                               'N',
                                                               'T');
                  commit;
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        successMessage {
            successMessage: Ciclo atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 2432186620220650447
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZARCICLO
        }
    )

