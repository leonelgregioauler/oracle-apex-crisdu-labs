page 622 (
    name: Textos Traduzidos
    title: Textos Traduzidos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 50%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region textos-traduzidos (
        name: Textos Traduzidos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select rowid
                     , idtextotraduzido
                     , ididioma
                     , textotraduzido
                from textostraduzidos
                where  idtextotraduzido = :P622_IDTEXTOTRADUZIDO
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CHECK$01 (
            reportColumnQueryId: 5
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
        )

        column IDIDIOMA (
            reportColumnQueryId: 3
            derivedColumn: N
            type: selectList
            heading {
                heading: Idioma
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select i.nome||' ('||i.codigo||')' display_value
                         , i.idpais return_value
                    from favorita.idiomas i
                    order by 1
                    ```
            }
            layout {
                sequence: 4
            }
            advanced {
                customAttributes: readonly
            }
        )

        column IDTEXTOTRADUZIDO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column TEXTOTRADUZIDO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textArea
            heading {
                heading: Texto Traduzido
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 110
                height: 3
            }
        )

    )

    pageItem P622_IDTEXTOTRADUZIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @textos-traduzidos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Atualizar
        layout {
            sequence: 10
            region: @textos-traduzidos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process applymru (
        name: "ApplyMRU "
        type: tabformUpdate
        editableRegion: @textos-traduzidos
        target {
            tableName: TEXTOSTRADUZIDOS
            pkColumn: ROWID
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# registro(s) atualizado(s), #MRI_COUNT# registros(s) inserido(s).
        }
        advanced {
            executionMappingIdentifier: 116807536240408783
        }
    )

)

