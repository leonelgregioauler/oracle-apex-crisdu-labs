page 476 (
    name: Notificações Judiciais
    title: Notificações Judiciais
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region notificações-judiciais (
        name: Notificações Judiciais
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.idnotificacaojudicial
                     , n.idfilial
                     , n.nomefilial
                     , n.idrepresentante
                     , n.nomerepresentante
                     , n.idvendedora
                     , n.nomevendedora
                     , n.documento
                     , n.datainclusao
                     , n.dataentrega
                     , n.resultado
                     , n.valordivida
                     , n.usuario
                from vw_notificacoesjudiciais n
                where ( :P476_FILTRODATA is null
                     or ( :P476_FILTRODATA = 'I' and trunc(n.datainclusao) between to_date(:P476_DATAINICIO) and to_date(:P476_DATAFIM) )
                     or ( :P476_FILTRODATA = 'E' and trunc(n.dataentrega) between to_date(:P476_DATAINICIO) and to_date(:P476_DATAFIM) ) )
                  and ( :P476_IDFILIAL is null or n.idfilial = :P476_IDFILIAL )
                  and ( :P476_IDREPRESENTANTE is null or n.idrepresentante = :P476_IDREPRESENTANTE )
                  and ( :P476_IDVENDEDORA is null or n.idvendedora = :P476_IDVENDEDORA )
                order by 1 desc
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
        }
        advanced {
            savedReportMappingIdentifier: 1534784857629038049
        }

