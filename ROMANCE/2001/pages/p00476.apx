    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 476
                items: {
                    P476_FILTRODATA: &P476_FILTRODATA.
                    P476_IDFILIAL: &P476_IDFILIAL.
                    P476_IDREPRESENTANTE: &P476_IDREPRESENTANTE.
                    P476_IDVENDEDORA: &P476_IDVENDEDORA.
                    P476_DATAFIM: &P476_DATAFIM.
                    P476_DATAINICIO: &P476_DATAINICIO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

