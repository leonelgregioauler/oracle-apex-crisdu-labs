        lov {
            type: staticValues
            staticValues: STATIC2: Inclusão;I, Entrega; E
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @ações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P476_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(u.idfilial) display_value
                     , u.idfilial return_value
                from usuariosfiliais u
                where u.usuario = v('APP_USER')
                order by 1
                ```
            nullDisplayValue: - Selecione a Empresa -
        }
        layout {
            sequence: 50
            region: @ações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P476_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' ('||decode(ativo,'S','Ativo','N','Inativo')||')' display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P476_IDFILIAL )
                order by 1  
                ```
            nullDisplayValue: - Selecione o Distribuidor -
        }
        cascadingLov {
            parentItems: P476_IDFILIAL
        }
        layout {
            sequence: 60
            region: @ações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P476_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' - '||nvl(documentoestrangeiro,cpf) display_value
                     , idvendedora return_value
                from pessoas p
                   , vendedoras v
                where v.idpessoa = p.idpessoa
                  and ( :P476_IDFILIAL is null or v.idfilial = :P476_IDFILIAL )
                  and ( :P476_IDREPRESENTANTE is null or v.idrepresentante = :P476_IDREPRESENTANTE )
                order by 1
                ```
            nullDisplayValue: - Selecione a Consultora -
        }
        cascadingLov {
            parentItems: [
                P476_IDREPRESENTANTE
                P476_IDFILIAL
            ]
        }
        layout {
            sequence: 70
            region: @ações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

