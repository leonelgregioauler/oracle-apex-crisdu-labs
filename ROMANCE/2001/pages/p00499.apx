page 499 (
    name: Anexos Negociações Balanço
    title: Anexos Negociações Balanço
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-700x
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 70%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P328_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos (
        name: Anexos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region anexos-balanços (
        name: Anexos Balanços
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @anexos
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            footerText: <font color="green"> Você pode anexar mais de um arquivo.</font>
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     --, '<a href="javascript: fnc_verimg('''||iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' 
                     , idnegociacaobalanco||idanexobalanco||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     , '<a href="javascript: fnc_removeanexo('||idanexobalanco||','''||t.nomearquivo||''');">Remover</a>' remover
                from ANEXOSBALANCOS t
                where idnegociacaobalanco = :P499_IDNEGOCIACAOBALANCO
                order by t.data
                ```
        }
        layout {
            sequence: 30
            parentRegion: @anexos
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from ANEXOSBALANCOS a
                where a.idnegociacaobalanco = :P499_IDNEGOCIACAOBALANCO
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column LINK (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Link
                alignment: center
            }
            layout {
                sequence: 2
            }
            link {
                target: {
                    page: 383
                    items: {
                        P383_ARQUIVO: #LINK#
                    }
                    action: resetPagination
                }
                linkText: Ver Anexo
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column REMOVER (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Usuario
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P499_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            filenameColumn: NOMEARQUIVO
            fileTypes: image/png,image/jpeg,application/pdf
        }
        layout {
            sequence: 20
            region: @anexos-balanços
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P499_DATA (
        type: hidden
        layout {
            sequence: 60
            region: @anexos-balanços
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P499_IDANEXOBALANCO (
        type: hidden
        layout {
            sequence: 10
            region: @anexos-balanços
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXOBALANCO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P499_IDANEXODELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @anexos-balanços
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P499_IDNEGOCIACAOBALANCO (
        type: hidden
        layout {
            sequence: 10
            region: @anexos-balanços
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDNEGOCIACAOBALANCO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P499_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @anexos-balanços
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                begin
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  return vidusuario;
                  --
                end;
                  
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P499_NOMEARQUIVO (
        type: hidden
        layout {
            sequence: 30
            region: @anexos-balanços
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P499_PAGINA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @anexos-balanços
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 40
            region: @anexos-balanços
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @anexos-balanços
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P499_IDANEXOBALANCO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar para Negociação
        layout {
            sequence: 20
            region: @anexos-balanços
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 498
                items: {
                    P498_IDNEGOCIACAOBALANCO: &P499_IDNEGOCIACAOBALANCO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar-2 (
        buttonName: VOLTAR_498
        label: Voltar
        layout {
            sequence: 10
            region: @anexos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 498
                items: {
                    P498_IDNEGOCIACAOBALANCO: &P499_IDNEGOCIACAOBALANCO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P499_PAGINA
            value: 498
        }
    )

    validation informar-arquivo (
        name: Informar arquivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P499_ARQUIVOTEMP
        }
        error {
            errorMessage: Selecione o arquivo!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_balancos(pidnegociacaobalanco => :P499_IDNEGOCIACAOBALANCO);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1564533606968578380
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P499_IDANEXOBALANCO := null;
                  pck_anexos.prc_apagaanexo_balancos(pidanexobalanco => :P499_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 1564535294943578382
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexosdespesas (
        name: Fetch Row from ANEXOSDESPESAS
        type: autoRowFetch
        source {
            tableName: ANEXOSDESPESAS
            pkColumn: IDANEXODESPESA
            pkItem: P499_IDANEXOBALANCO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1564534004540578380
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P499_IDANEXOBALANCO is null then
                        select "#OWNER#"."SEQ_IDANEXOBALANCO".nextval
                          into :P499_IDANEXOBALANCO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1564534458271578380
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexosbalancos (
        name: Process Row of ANEXOSBALANCOS
        type: autoRowProcessing
        target {
            tableName: ANEXOSBALANCOS
            pkColumn: IDANEXOBALANCO
            pkItem: P499_IDANEXOBALANCO
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Arquivo Anexado
        }
        advanced {
            executionMappingIdentifier: 1564534832246578380
        }
    )

    branch (
        name: Go To Page 499
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 499
                items: {
                    P499_IDANEXOBALANCO:
                    P499_IDNEGOCIACAOBALANCO: &P499_IDNEGOCIACAOBALANCO.
                }
                action: resetPagination
            }
        }
    )

)

