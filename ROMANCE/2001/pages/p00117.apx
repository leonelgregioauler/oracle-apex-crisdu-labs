page 117 (
    name: Detalhamento de Pedidos
    title: Detalhamento de Pedidos
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region page_plug (
        name: " "
        type: staticContent
        layout {
            sequence: 1
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region pedidos-pagos (
        name: Pedidos Pagos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido
                     , p.nrpedido "Nr Pedido"
                     , pck_romance.fnc_nomevendedora(pidvendedora => p.idvendedora) "Vendedora"
                     , pck_romance.fnc_retornatelefones(p.idvendedora) Telefones
                     , p.databaixa "Data Baixa"
                     , p.datavencimento "Data Vencimento"
                     , p.valorcobrado "Valor Total"
                     , ( select decode(ativo,'S','Ativa','N','Inativa')
                         from vendedoras v
                         where v.idvendedora = p.idvendedora ) situacaocliente
                from vw_comissoes_pagar p
                where idrepresentante = :P117_IDREPRESENTANTE
                union
                select pp.idpedido
                     , pp.numeropedido
                     , pp.vendedora
                     , pck_romance.fnc_retornatelefones(pp.idvendedora) Telefones
                     , pp.databaixa
                     , pp.datavencimentomenor
                     , pp.valorapagar*nvl(cp.totalconversao,1) valorapagar
                     , ( select decode(ativo,'S','Ativa','N','Inativa')
                         from vendedoras v
                         where v.idvendedora = pp.idvendedora ) situacaocliente
                from favorita.vw_comissoes_pagar_fav pp
                   , favorita.conversoespedidos cp
                where idrepresentante = :P117_IDREPRESENTANTE
                  and pp.idpedido     = cp.idpedido(+)
                order by 5 desc
                ```
        }
        layout {
            sequence: 30
            parentRegion: @page_plug
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: Não há pedidos pagos.
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
            linkText: Clique aqui para fazer o Download!
            filename: pedidos_pagos
        }

