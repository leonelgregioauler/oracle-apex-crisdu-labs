    region pedidos-vencidos (
        name: Pedidos Vencidos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pf.idpedido
                     , pf.numeropedido
                     , pf.vendedora
                     , pck_romance.fnc_retornatelefones(pf.idvendedora) telefones
                     , pf.dataemissao
                     , pf.dataentrega
                     , pf.datavencimentomenor
                     , pf.valorapagar*nvl(cp.totalconversao,1) valorapagar
                     , ( select decode(ativo,'S','Ativa','N','Inativa')
                         from vendedoras v
                         where v.idvendedora = pf.idvendedora ) situacaocliente
                from favorita.vw_pedidos_fav pf
                   , favorita.conversoespedidos cp
                where pf.idrepresentante = :P117_IDREPRESENTANTE
                  and pf.idpedido        = cp.idpedido(+)
                  and pf.ididioma        = 1
                  and exists ( select 1
                               from favorita.vencimentospedidos v
                               where v.situacaovencimento    = 'V'
                                 and v.idpedido              = pf.idpedido
                                 and trunc(v.datavencimento) < trunc(sysdate)
                                 and nvl(v.valorpago,0)      < nvl(v.valorpagar,0) )
                  and not exists ( select 1
                                   from favorita.classificacoespedidos c
                                   where c.idcaracteristicapedido = 25
                                     and c.idpedido               = pf.idpedido )
                union
                select /*FIRST_ROWS(15)*/ b.idboleto
                     , numero 
                     , consultora 
                     , Telefones 
                     , b.dataemissao 
                     , b.dataentrega 
                     , b.datavencimento 
                     , valortotal 
                     , decode(b.ClienteAtiva,'S','Ativa','N','Inativa')
                from vw_debitosvendedfavorita b
                where b.idrepresentante  = :P117_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 20
            parentRegion: @page_plug
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
