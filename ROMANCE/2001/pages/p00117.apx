    region pedidos-à-vencer (
        name: Pedidos à Vencer
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido
                     , nvl(p.pedidotag,pp.nrpedido) "Nr Pedido"
                     , pck_romance.fnc_nomevendedora(pidvendedora => p.idvendedora) "Vendedora"
                     , pck_romance.fnc_retornatelefones(p.idvendedora) Telefones
                     , pp.dtemissao  "Data Emissão"
                     , pp.dataentrega "Data Entrega"
                     , p.datavencimento "Data Vencimento"
                     , p.valorcobrado "Valor Total"
                     , ( select decode(ativo,'S','Ativa','N','Inativa')
                         from vendedoras v
                         where v.idvendedora = pp.idvendedora ) situacaocliente
                from boletos        p
                   , pedidos        pp
                where p.idpedido        = pp.idpedido(+)
                  /*and nvl(p.pedidorepresentante,'N') = 'N'*/
                  and trunc(p.datavencimento)  >= trunc(sysdate)
                  and p.databaixa is null
                  and p.idrepresentante = :P117_IDREPRESENTANTE
                union
                select pf.idpedido
                     , pf.numeropedido
                     , pf.vendedora
                     , pck_romance.fnc_retornatelefones(pf.idvendedora)
                     , pf.dataemissao
                     , pf.dataentrega
                     , pf.datavencimentomenor
                     , pf.valorapagar*nvl(cp.totalconversao,1) valorapagar
                     , ( select decode(ativo,'S','Ativa','N','Inativa')
                         from vendedoras v
                         where v.idvendedora = pf.idvendedora ) situacaocliente
                from favorita.vw_pedidos_fav pf
                   , favorita.conversoespedidos cp
                where pf.idrepresentante = :P117_IDREPRESENTANTE
                  and pf.idpedido        = cp.idpedido(+)
                  and pf.ididioma        = 1
                  and exists ( select 1
                               from favorita.vencimentospedidos v
                               where v.situacaovencimento    = 'V'
                                 and v.idpedido              = pf.idpedido
                                 and trunc(v.datavencimento) >= trunc(sysdate)
                                 and nvl(v.valorpago,0)      < nvl(v.valorpagar,0) )
                  and not exists ( select 1
                                   from favorita.classificacoespedidos c
                                   where c.idcaracteristicapedido = 25
                                     and c.idpedido               = pf.idpedido )
                ```
        }
        layout {
            sequence: 40
            parentRegion: @page_plug
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Não há pedidos à vencer.
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
            linkText: Clique aqui para fazer o Download!
            filename: pedidos_a_vencer
        }

