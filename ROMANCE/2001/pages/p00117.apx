    pageItem P117_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) Nome
                     , r.idrepresentante
                from pessoas p
                   , representantes r
                where r.idpessoa  = p.idpessoa  
                  and r.idrepresentante = :P117_IDREPRESENTANTE
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @page_plug
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
