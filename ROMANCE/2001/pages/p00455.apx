page 455 (
    name: Adicionar Documentos
    title: Adicionar Documentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region adicionar-documentos (
        name: Adicionar Documentos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "DOCUMENTO",
                "USUARIO",
                "PAGINA"
                from "#OWNER#"."FILTROSDOCUMENTOS"
                
                ```
        }
        layout {
            sequence: 15
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum documento adicionado.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column DOCUMENTO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: textField
            heading {
                heading: Documento
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                width: 16
            }
        )

        column PAGINA (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 5
            }
            default {
                type: item
                item: P455_PAGINA
            }
        )

        column ROWID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
            default {
                type: plsqlExpression
                plsqlExpression: v('APP_USER')
            }
        )

    )

    pageItem P455_PAGINA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @adicionar-documentos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar
        layout {
            sequence: 40
            region: @adicionar-documentos
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @adicionar-documentos
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Gravar Documentos
        layout {
            sequence: 30
            region: @adicionar-documentos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation pagina-must-be-numeric (
        name: PAGINA must be numeric
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @adicionar-documentos
            type: columnIsNumeric
            column: PAGINA
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: PAGINA
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @adicionar-documentos
        target {
            tableName: FILTROSDOCUMENTOS
            pkColumn: ROWID
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# linha(s) deletada.
        }
        advanced {
            executionMappingIdentifier: 1517252897871193504
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @adicionar-documentos
        target {
            tableName: FILTROSDOCUMENTOS
            pkColumn: ROWID
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# linha(s) atualizada, #MRI_COUNT# linha(s) incluida.
        }
        advanced {
            executionMappingIdentifier: 1517252478633193502
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Go To Page 455
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 455
            }
        }
    )

)

