page 206 (
    name: Depósitos
    title: Depósitos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region depósitos (
        name: Depósitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iddepositodiarios
                     , data
                     , pck_romance.fnc_nomerepresentante(idrepresentante) Representante
                     , ( select initcap(cb.beneficiario)||'('||b.nomebanco||' - '||cb.agencia ||', '||cb.conta||')' 
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco         = b.idbanco
                           and cb.idcontabanc = d.idcontabanc ) "Conta Bancária"
                     , idpgtoforn
                     , valordeposito 
                     , decode(comprovado,'S','Sem Comprovante'
                                       ,'C','Cópia'
                                       ,'M','Em Mãos'
                                       ,'G', 'Com Gerente') comprovado
                     , nrocomprovante
                     , nroenvelope
                     , observacao
                     , decode(tipo,'DD','Dinheiro'
                                     ,'CC','Cheque'
                                     ,'AB','Abatimento'
                                     ,'CD','Cheque Pré Depósito'
                                     ,'CR','Cheque Pré Resgate'
                                     ,'M','Em Mãos') tipo
                     , referentea
                     , valororiginal
                     , destinosaldo "Destino do saldo"
                from DEPOSITOSDIARIOS_orig d
                where d.idfechamentorepres in ( select idfechamentorepres
                                                from fechamentorepresentantes
                                                where idfechamento = :P206_IDFECHAMENTO)
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 6039159306326238
        }

