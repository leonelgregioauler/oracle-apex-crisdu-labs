page 672 (
    name: Inserir Opção Perda Favorita
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region inserir-opção-baixa-perda-favorita (
        name: Inserir Opção Baixa Perda Favorita
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    pageItem P672_IDOPCAOBAIXAPERDA (
        type: hidden
        layout {
            sequence: 10
            region: @inserir-opção-baixa-perda-favorita
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDOPCAOBAIXAPERDA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P672_NOMEOPCAOBAIXAPERDA (
        type: textField
        label {
            label: Nome Opção:
            alignment: left
        }
        layout {
            sequence: 20
            region: @inserir-opção-baixa-perda-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                margin-right-none
            ]
            width: 30
        }
        validation {
            maxLength: 1000
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEOPCAOBAIXAPERDA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P672_OBSERVACAO (
        type: textarea
        label {
            label: Observação:
            alignment: left
        }
        layout {
            sequence: 30
            region: @inserir-opção-baixa-perda-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                margin-left-none
            ]
            width: 30
            height: 5
        }
        validation {
            maxLength: 10000
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 10
            region: @inserir-opção-baixa-perda-favorita
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    process fetch-row-from-opcao-baixa (
        name: Fetch Row from OPCAO BAIXA
        type: autoRowFetch
        source {
            tableName: OPCAOBAIXAPORPERDA
            pkColumn: IDOPCAOBAIXAPERDA
            pkItem: P672_IDOPCAOBAIXAPERDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 561165126342090501
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDOPCAOBAIXAPERDA.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P672_IDOPCAOBAIXAPERDA := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 561165856342090508
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-opção-baixa (
        name: Process Row of OPÇÃO BAIXA
        type: autoRowProcessing
        target {
            tableName: OPCAOBAIXAPORPERDA
            pkColumn: IDOPCAOBAIXAPERDA
            pkItem: P672_IDOPCAOBAIXAPERDA
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: "Inserido com Sucesso! "
        }
        advanced {
            executionMappingIdentifier: 561165716665090507
        }
    )

)

