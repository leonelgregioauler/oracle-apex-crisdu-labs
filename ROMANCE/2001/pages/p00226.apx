        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-busca (
        name: Tipo Busca
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P226_TIPO_BUSCA
        }
        clientSideCondition {
            type: item=value
            item: P226_TIPO_BUSCA
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P226_IDREGIAOVENDA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P226_IDCIDADE
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P226_IDREGIAOVENDA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P226_IDCIDADE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

