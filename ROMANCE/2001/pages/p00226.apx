            }
        )

        column QTDNOTAS (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Qtd Notas
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
        )

        column REPRESENTANTE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column TELEFONE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Telefone
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column VALORPAGO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 7
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                defaultSequence: 1
                direction: desc
            }
        )

        column VENDEDORA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P226_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 14
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P226_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 14
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P226_FILTROREPRES (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @representantes
            nullDisplayValue: - Todos -
            nullReturnValue: -1
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P226_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomecidade)||'/'||e.sigla display_value
                     , c.idcidade return_value
                from cidades c
                   , estados e
                   , filiaisregioesvenda f
                where f.idfilial = :P0_IDFILIAL
                  and c.idestado = f.idestado 
                  and e.idestado = c.idestado
                order by 1
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P226_IDREGIAOVENDA (
        type: selectList
        label {
            label: Região de Venda
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(r.idregiaovenda) d
                     , r.idregiaovenda r
                from regioesrepresentantes r
                where r.idrepresentante = :P226_FILTROREPRES
                order by r.idsemana 
                ```
            nullDisplayValue: - Selecione a Região -
        }
        cascadingLov {
            parentItems: P226_FILTROREPRES
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P226_IDSEMANA (
        type: selectList
        label {
            label: "Semana "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano semana
                     , idsemana 
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-2 and to_char(sysdate,'RRRR')
                order by idsemana desc
                
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P226_IDSEMANAFIM (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano semana
                     , idsemana 
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-2 and to_char(sysdate,'RRRR')
                order by idsemana desc
                
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

