        column TELEFONE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Telefone
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column VALORPAGO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 7
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

    )

    region ranking-de-consultoras-romance (
        name: Ranking de Consultoras Romance
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(vd.idvendedora) vendedora
                  , pck_romance.fnc_cpfvendedora(vd.idvendedora) cpf
                  , pck_romance.fnc_retornatelefones(vd.idvendedora) telefone
                  , pck_romance.fnc_nomecidade(p.idcidade) cidade
                  , pck_romance.fnc_nomerepresentante(nv.idrepresentante) representante 
                  , count(distinct nv.idnotavenda) qtdnotas
                  , sum(nv.valorpago) valorpago
                from vendedoras vd
                   , notasvendas nv
                   , pessoas p
                where vd.idvendedora = nv.idvendedora
                  and vd.idpessoa = p.idpessoa
                  and nv.idsituacaonotavenda = 4
                  and nv.valortotalvenda > 0
                  and vd.ativo = 'S'
                  and :P0_IDFILIAL <> 1135 -- COMERCIAL ROMANCE
                  and :P0_IDFILIAL not in (1, 2, 3, 4) -- Regional
                  and nv.idfilial = :P0_IDFILIAL
                  and ( :P226_TIPO_BUSCA = 'T'
                     or ( :P226_TIPO_BUSCA = 'R' and vd.idregiaovenda = :P226_IDREGIAOVENDA )
                     or ( :P226_TIPO_BUSCA = 'C' and p.idcidade       = :P226_IDCIDADE ) )
                  and ( :P226_FILTROREPRES = -1 or nv.idrepresentante = :P226_FILTROREPRES )
                  and ( :P226_TIPO_PESQUISA = 'G' 
                     or ( :P226_TIPO_PESQUISA = 'S' and nv.idsemanacobranca = :P226_IDSEMANA )
                     or ( :P226_TIPO_PESQUISA = 'P' and nv.idsemanacobranca between :P226_IDSEMANAINI and :P226_IDSEMANAFIM )
                     or ( :P226_TIPO_PESQUISA = 'A' and nv.dataacerto between to_date(:P226_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS' ) and to_date(:P226_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) ) 
                group by vd.idvendedora
                    , nv.idrepresentante
                    , p.idcidade
                --
                union
                -- Comercial Romance
                select pck_romance.fnc_nomevendedora(vd.idvendedora) vendedora
                  , pck_romance.fnc_cpfvendedora(vd.idvendedora) cpf
                  , pck_romance.fnc_retornatelefones(vd.idvendedora) telefone
                  , pck_romance.fnc_nomecidade(p.idcidade) cidade
                  , pck_romance.fnc_nomerepresentante(nv.idrepresentante) representante 
                  , count(distinct nv.idnotavenda) qtdnotas
                  , sum(nv.valorpago) valorpago
                from vendedoras vd
                   , notasvendas nv
                   , pessoas p
                where vd.idvendedora = nv.idvendedora
                  and vd.idpessoa = p.idpessoa
                  and nv.idsituacaonotavenda = 4
                  and nv.valortotalvenda > 0
                  and vd.ativo = 'S'
                  and :P0_IDFILIAL = 1135 -- COMERCIAL ROMANCE
                  and ( :P226_TIPO_BUSCA = 'T'
                     or ( :P226_TIPO_BUSCA = 'R' and vd.idregiaovenda = :P226_IDREGIAOVENDA )
                     or ( :P226_TIPO_BUSCA = 'C' and p.idcidade       = :P226_IDCIDADE ) )
                  and ( :P226_FILTROREPRES = -1 or nv.idrepresentante = :P226_FILTROREPRES )
                  and ( :P226_TIPO_PESQUISA = 'G' 
                     or ( :P226_TIPO_PESQUISA = 'S' and nv.idsemanacobranca = :P226_IDSEMANA )
                     or ( :P226_TIPO_PESQUISA = 'P' and nv.idsemanacobranca between :P226_IDSEMANAINI and :P226_IDSEMANAFIM )
                     or ( :P226_TIPO_PESQUISA = 'A' and nv.dataacerto between to_date(:P226_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS' ) and to_date(:P226_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) ) 
                  and nv.idfilial in (select f.idfilial
                                        from catal.filiais f
                                       where f.pertencecomercialromance = 'S'
                                         and f.ativo = 'S')
                group by vd.idvendedora
                    , nv.idrepresentante
                    , p.idcidade
                --
                union
                -- Regional
                select pck_romance.fnc_nomevendedora(vd.idvendedora) vendedora
                  , pck_romance.fnc_cpfvendedora(vd.idvendedora) cpf
                  , pck_romance.fnc_retornatelefones(vd.idvendedora) telefone
                  , pck_romance.fnc_nomecidade(p.idcidade) cidade
                  , pck_romance.fnc_nomerepresentante(nv.idrepresentante) representante 
                  , count(distinct nv.idnotavenda) qtdnotas
                  , sum(nv.valorpago) valorpago
                from vendedoras vd
                   , notasvendas nv
                   , pessoas p
                   , catal.filiais f
                where vd.idvendedora = nv.idvendedora
                  and vd.idpessoa = p.idpessoa
                  and nv.idfilial = f.idfilial
                  and nv.idsituacaonotavenda = 4
                  and nv.valortotalvenda > 0
                  and vd.ativo = 'S'
                  and :P0_IDFILIAL in (1, 2, 3, 4) -- Regional
                  and ( :P226_TIPO_BUSCA = 'T'
                     or ( :P226_TIPO_BUSCA = 'R' and vd.idregiaovenda = :P226_IDREGIAOVENDA )
                     or ( :P226_TIPO_BUSCA = 'C' and p.idcidade       = :P226_IDCIDADE ) )
                  and ( :P226_FILTROREPRES = -1 or nv.idrepresentante = :P226_FILTROREPRES )
                  and ( :P226_TIPO_PESQUISA = 'G' 
                     or ( :P226_TIPO_PESQUISA = 'S' and nv.idsemanacobranca = :P226_IDSEMANA )
                     or ( :P226_TIPO_PESQUISA = 'P' and nv.idsemanacobranca between :P226_IDSEMANAINI and :P226_IDSEMANAFIM )
                     or ( :P226_TIPO_PESQUISA = 'A' and nv.dataacerto between to_date(:P226_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS' ) and to_date(:P226_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) ) 
                  and nv.idfilial in (select f.idfilial
                                        from catal.filiais f
                                       where f.regional = :P0_IDFILIAL
                                         and f.ativo = 'S')
                group by vd.idvendedora
                    , nv.idrepresentante
                    , p.idcidade
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P226_TIPO_RANKING
            value: D
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        download {
            csvExportEnabled: true
            linkText: CLIQUE AQUI PARA FAZER O DOWNLOAD
        }

        column CIDADE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Cidade
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column CPF (
            reportColumnQueryId: 2
