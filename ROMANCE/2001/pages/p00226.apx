    region ranking-de-consultoras-favorita (
        name: Ranking de Consultoras Favorita
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomepessoa
                     , p.cpf
                     , roman.pck_romance.fnc_retornatelefones(vd.idvendedora) telefone
                     , roman.pck_romance.fnc_nomecidade(p.idcidade) cidade
                     , roman.pck_romance.fnc_nomerepresentante(vd.idrepresentante) representante 
                     , count(pp.idpedido) qtdpedidos
                     , sum(pp.valorpago) valorpago
                from catal.vendedoras vd
                   , favorita.vw_pedidos_fav pp
                   , catal.pessoas p
                where vd.idvendedora = pp.idvendedora
                  and vd.idpessoa = p.idpessoa
                  and pp.valorpago != 0
                  and pp.ididioma = 1
                  and pp.datacancelamento is null
                  and pp.idfilialromance = :P0_IDFILIAL
                  and pp.tipopedido in ('P', 'V')
                  and pp.idsituacaoentrega >= 20000
                  and vd.ativo = 'S'
                  and not exists (select 1
                                  from catal.representantes r
                                  where r.idpessoa = vd.idpessoa)
                  and not exists ( select 1
                                          from favorita.classificacoespedidos c
                                          where c.idcaracteristicapedido = 8
                                            and c.idvalorcaracteristica  = 16
                                            and c.idpedido               = pp.idpedido )
                  and ( :P226_TIPO_BUSCA = 'T'
                     or ( :P226_TIPO_BUSCA = 'R' and vd.idregiaovenda = :P226_IDREGIAOVENDA )
                     or ( :P226_TIPO_BUSCA = 'C' and p.idcidade       = :P226_IDCIDADE ) )
                  and ( :P226_FILTROREPRES = -1 or pp.idrepresentante = :P226_FILTROREPRES )
                  and ( :P226_TIPO_PESQUISA = 'G' 
                     or ( :P226_TIPO_PESQUISA = 'S' and pp.idsemanaemissao = :P226_IDSEMANA )
                     or ( :P226_TIPO_PESQUISA = 'P' and pp.idsemanaemissao between :P226_IDSEMANAINI and :P226_IDSEMANAFIM )
                     or ( :P226_TIPO_PESQUISA = 'A' and pp.dataemissao between to_date(:P226_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS' ) and to_date(:P226_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) ) 
                  and :P0_IDFILIAL not in (1, 2, 3, 4) -- Regional
                  and :P0_IDFILIAL <> 1135 -- comercial romance
                group by vd.idvendedora
                       , p.idcidade
                       , p.nomepessoa
                       , p.cpf
                       , vd.idrepresentante
                --
                union
                -- Comercial Romance
                select p.nomepessoa
                     , p.cpf
                     , roman.pck_romance.fnc_retornatelefones(vd.idvendedora) telefone
                     , roman.pck_romance.fnc_nomecidade(p.idcidade) cidade
                     , roman.pck_romance.fnc_nomerepresentante(vd.idrepresentante) representante 
                     , count(pp.idpedido) qtdpedidos
                     , sum(pp.valorpago) valorpago
                from catal.vendedoras vd
                   , favorita.vw_pedidos_fav pp
                   , catal.pessoas p
                where vd.idvendedora = pp.idvendedora
                  and vd.idpessoa = p.idpessoa
                  and pp.valorpago != 0
                  and pp.ididioma = 1
                  and pp.datacancelamento is null
                  --and pp.idfilialromance = :P0_IDFILIAL
                  and pp.tipopedido in ('P', 'V')
                  and pp.idsituacaoentrega >= 20000
                  and vd.ativo = 'S'
                  and not exists (select 1
                                  from catal.representantes r
                                  where r.idpessoa = vd.idpessoa)
                  and not exists ( select 1
                                          from favorita.classificacoespedidos c
                                          where c.idcaracteristicapedido = 8
                                            and c.idvalorcaracteristica  = 16
                                            and c.idpedido               = pp.idpedido )
                  and ( :P226_TIPO_BUSCA = 'T'
                     or ( :P226_TIPO_BUSCA = 'R' and vd.idregiaovenda = :P226_IDREGIAOVENDA )
                     or ( :P226_TIPO_BUSCA = 'C' and p.idcidade       = :P226_IDCIDADE ) )
                  and ( :P226_FILTROREPRES = -1 or pp.idrepresentante = :P226_FILTROREPRES )
                  and ( :P226_TIPO_PESQUISA = 'G' 
                     or ( :P226_TIPO_PESQUISA = 'S' and pp.idsemanaemissao = :P226_IDSEMANA )
                     or ( :P226_TIPO_PESQUISA = 'P' and pp.idsemanaemissao between :P226_IDSEMANAINI and :P226_IDSEMANAFIM )
                     or ( :P226_TIPO_PESQUISA = 'A' and pp.dataemissao between to_date(:P226_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS' ) and to_date(:P226_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) ) 
                  and :P0_IDFILIAL = 1135 -- comercial romance
                  and pp.idfilialromance in ( select f.idfilial
                                                from catal.filiais f
                                               where f.pertencecomercialromance = 'S'
                                                 and f.ativo = 'S')
                  
                group by vd.idvendedora
                       , p.idcidade
                       , p.nomepessoa
                       , p.cpf
                       , vd.idrepresentante
                --
                union
                -- Regionais
                select p.nomepessoa
                     , p.cpf
                     , roman.pck_romance.fnc_retornatelefones(vd.idvendedora) telefone
                     , roman.pck_romance.fnc_nomecidade(p.idcidade) cidade
                     , roman.pck_romance.fnc_nomerepresentante(vd.idrepresentante) representante 
                     , count(pp.idpedido) qtdpedidos
                     , sum(pp.valorpago) valorpago
                from catal.vendedoras vd
                   , favorita.vw_pedidos_fav pp
                   , catal.pessoas p
                   , catal.filiais f
                where vd.idvendedora = pp.idvendedora
                  and vd.idpessoa = p.idpessoa
                  and pp.idfilialromance = f.idfilial
                  and pp.valorpago != 0
                  and pp.ididioma = 1
                  and pp.datacancelamento is null
                  --and pp.idfilialromance = :P0_IDFILIAL
                  and pp.tipopedido in ('P', 'V')
                  and pp.idsituacaoentrega >= 20000
                  and vd.ativo = 'S'
                  and not exists (select 1
                                  from catal.representantes r
                                  where r.idpessoa = vd.idpessoa)
                  and not exists ( select 1
                                          from favorita.classificacoespedidos c
                                          where c.idcaracteristicapedido = 8
                                            and c.idvalorcaracteristica  = 16
                                            and c.idpedido               = pp.idpedido )
                  and ( :P226_TIPO_BUSCA = 'T'
                     or ( :P226_TIPO_BUSCA = 'R' and vd.idregiaovenda = :P226_IDREGIAOVENDA )
                     or ( :P226_TIPO_BUSCA = 'C' and p.idcidade       = :P226_IDCIDADE ) )
                  and ( :P226_FILTROREPRES = -1 or pp.idrepresentante = :P226_FILTROREPRES )
                  and ( :P226_TIPO_PESQUISA = 'G' 
                     or ( :P226_TIPO_PESQUISA = 'S' and pp.idsemanaemissao = :P226_IDSEMANA )
                     or ( :P226_TIPO_PESQUISA = 'P' and pp.idsemanaemissao between :P226_IDSEMANAINI and :P226_IDSEMANAFIM )
                     or ( :P226_TIPO_PESQUISA = 'A' and pp.dataemissao between to_date(:P226_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS' ) and to_date(:P226_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) ) 
                  and :P0_IDFILIAL in (1, 2, 3, 4) -- Regional
                  and pp.idfilialromance in (select f.idfilial
                                               from catal.filiais f
                                              where f.regional = :P0_IDFILIAL
                                                and f.ativo = 'S')
                group by vd.idvendedora
                       , p.idcidade
                       , p.nomepessoa
                       , p.cpf
                       , vd.idrepresentante
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P226_TIPO_RANKING
            value: F
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        download {
            csvExportEnabled: true
            linkText: CLIQUE AQUI PARA FAZER O DOWNLOAD
        }

        column CIDADE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Cidade
                alignment: center
