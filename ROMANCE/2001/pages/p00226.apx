    branch (
        name: FILTRO
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 226
                items: {
                    P226_FILTROREPRES: &P226_FILTROREPRES.
                    P226_TIPO_PESQUISA: &P226_TIPO_PESQUISA.
                    P226_IDSEMANA: &P226_IDSEMANA.
                    P226_IDSEMANAINI: &P226_IDSEMANAINI.
                    P226_IDSEMANAFIM: &P226_IDSEMANAFIM.
                    P226_DATAINICIO: &P226_DATAINICIO.
                    P226_DATAFIM: &P226_DATAFIM.
                    P226_IDREGIAOVENDA: &P226_IDREGIAOVENDA.
                    P226_TIPO_BUSCA: &P226_TIPO_BUSCA.
                    P226_IDCIDADE: &P226_IDCIDADE.
                }
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

