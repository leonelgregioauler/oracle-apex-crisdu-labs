    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P541_IDFECHAMENTO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @alterações-de-despesas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

