    pageItem P541_IDFECHAMENTO (
        type: numberField
        label {
            label: ID Fechamento
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Informe o ID Fechamento
        }
        security {
            encryptSessionState: false
