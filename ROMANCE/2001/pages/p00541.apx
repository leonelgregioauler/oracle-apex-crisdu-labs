page 541 (
    name: Log Despesas
    title: Log Despesas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region alterações-de-despesas (
        name: Alterações de Despesas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.idfechamento
                     , d.usuarioalteracao
                     , d.dataalteracao
                     , decode(d.tipoalteracao,'INSERT','Inclusão','UPDATE','Atualização','DELETE','Exclusão') tipoalteracao
                     , d.iddespesa
                     , pck_romance.fnc_nomerepresentante(d.idrepresentante) representante
                     , d.idfechamentorepres
                     , ( select c.nomeconta
                         from contasfinanceiras c
                         where c.idcontafinan = d.idcontacontabil ) conta
                     , ( select nomeconta
                         from subcontasfinanceiras s
                         where s.idsubcontafinan = d.idsubcontacontabil ) subconta
                     , d.observacao
                     , d.semana
                     , d.ano
                     , d.valor
                     , pck_romance.fnc_nomefilial(idfilial) idfilial
                     , d.datavencimento
                     , d.pago
                from logroman.log_despesas d
                where d.idfechamento = :P541_IDFECHAMENTO
                order by d.dataalteracao desc;
                ```
            pageItemsToSubmit: P541_IDFECHAMENTO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum dado localizado!
        }
        advanced {
            savedReportMappingIdentifier: 43915148489672880
        }

