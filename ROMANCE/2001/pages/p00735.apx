    dynamicAction atualiza-regiao (
        name: Atualiza_Regiao
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P735_CICLOROMANCE
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction atualizacampos (
        name: AtualizaCampos
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P735_CICLOROMANCE
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
