page 735 (
    name: Cadastro de Metas RMC Distribuidor
    title: Cadastro de Metas Distribuidor
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region botoes (
        name: Botoes
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @filtros
            slot: subRegions
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report 1
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select tipo
                      , idmetadesafiodistribuidor
                      , idrepresentante 
                      , case when idrepresentante is null
                             then 'TOTAIS DOS DISTRIBUIDORES'
                             else
                               pck_romance.fnc_nomerepresentante(idrepresentante) || ' - '||idrepresentante
                        end nomerepresentante
                      , desafiocalculadoromance
                      , desafioperccrescimento
                      , desafiocalculadoatual
                      , case when desafiocalculadoatual > desafiocalculadoromance 
                             then 'VERDE'
                             when desafiocalculadoatual < desafiocalculadoromance 
                             then 'VERMELHO'
                             else
                               null
                        end cor
                      , case when tipo = 1 then
                               (select sum(nvl(M.MEDIASEMANAL,0))
                                  from METASDESAFIODISTRIBUIDORES M
                                 where m.cicloromance = :P735_CICLOROMANCE
                                   and m.idfilial     = :P0_IDFILIAL )
                             else
                               mediasemanal
                        end mediasemanal 
                      , saldoMeta saldoMetaFranquia
                      , percdistrib
                --      , percatual
                   from (
                     select 0 tipo
                          , 1 IDMETADESAFIODISTRIBUIDOR 
                          , NULL IDFILIAL 
                          , null idrepresentante 
                          , SUM(M.DESAFIOCALCULADOROMANCE) DESAFIOCALCULADOROMANCE
                          , 0  DESAFIOPERCCRESCIMENTO 
                          , SUM(nvl(M.DESAFIOCALCULADOATUAL,0)) DESAFIOCALCULADOATUAL
                          , NULL MEDIASEMANAL --nvl(M.MEDIASEMANAL,0) MEDIASEMANAL,
                          , 0 percdistrib
                --          , 0 percatual
                          , (select desafiocalculadoatual
                               from metasdesafioromance
                              where idfilial = :P0_IDFILIAL 
                                and cicloromance = :P735_CICLOROMANCE ) desafiofranquia
                          , SUM(nvl(M.DESAFIOCALCULADOATUAL,0)) - 
                            (select desafiocalculadoatual
                               from metasdesafioromance
                              where idfilial = :P0_IDFILIAL 
                                and cicloromance = :P735_CICLOROMANCE )  saldoMeta
                       from METASDESAFIODISTRIBUIDORES M
                          , REPRESENTANTES R
                      where m.cicloromance = :P735_CICLOROMANCE
                        and m.idfilial     = :P0_IDFILIAL
                        and r.idrepresentante = m.idrepresentante
                        and r.ativo = 'S'
                        and r.idpessoa not in (select idpessoa
                                                 from gerentes 
                                                where idfilial = m.idfilial
                                                  and idpessoa not in (36372, 86481) ) -- 12895299
                        group by m.idfilial 
                ---
                UNION
                ---
                 select 2 tipo
                      , M.IDMETADESAFIODISTRIBUIDOR
                      , M.IDFILIAL
                      , M.IDREPRESENTANTE
                      , M.DESAFIOCALCULADOROMANCE
                      , M.DESAFIOPERCCRESCIMENTO
                      , nvl(M.DESAFIOCALCULADOATUAL,0) DESAFIOCALCULADOATUAL
                      , nvl(M.MEDIASEMANAL,0) MEDIASEMANAL
                      , round(pck_romance.FNC_DIVISOR_ZERO( M.DESAFIOCALCULADOROMANCE, sum(M.DESAFIOCALCULADOROMANCE) over (partition by m.idfilial )) * 100,2) percdistrib
                      , 0 desafiofranquia
                      , null saldoMeta
                   from METASDESAFIODISTRIBUIDORES M
                      , REPRESENTANTES R
                  where m.cicloromance = :P735_CICLOROMANCE
                    and r.idrepresentante = m.idrepresentante
                    and r.ativo = 'S'
                    and r.idpessoa not in (select idpessoa
                                             from gerentes 
                                            where idfilial = m.idfilial
                                              and idpessoa not in (36372, 86481) ) -- 12895299
                    and m.idfilial     = :P0_IDFILIAL )
                ```
            pageItemsToSubmit: P735_CICLOROMANCE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
