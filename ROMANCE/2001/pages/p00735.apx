    process report-1-save-interactive-grid-data (
        name: Report 1 - Save Interactive Grid Data
        type: executeCode
        editableRegion: @report
        source {
            plsqlCode:
                ```plsql
                DECLARE
                 VPERC NUMBER;
                 VDESAFIO NUMBER;
                 VCALCULADO number;
                
                BEGIN
                  --
                  VPERC      := replace(:DESAFIOPERCCRESCIMENTO,'.',''); --TO_NUMBER(:DESAFIOPERCCRESCIMENTO,'999G999G999G999D000');
                  VDESAFIO   := replace(:DESAFIOCALCULADOROMANCE,'.',''); --TO_NUMBER(:DESAFIOCALCULADOROMANCE,'999G999G999G999D000');
                  VCALCULADO := replace(:DESAFIOCALCULADOATUAL,'.',''); --TO_NUMBER(:DESAFIOCALCULADOATUAL,'999G999G999G999D000');
                  --
                  UPDATE METASDESAFIODISTRIBUIDORES
                     SET DESAFIOCALCULADOROMANCE = VDESAFIO
                --       , DESAFIOPERCCRESCIMENTO  = VPERC
                       , DESAFIOPERCCRESCIMENTO  = case when vdesafio > 0 
                                                        then (VCALCULADO * 100 / VDESAFIO ) - 100
                                                        else 0
                                                   end
                       , DESAFIOCALCULADOATUAL   = VCALCULADO
                       , MEDIASEMANAL            = VCALCULADO / 6
                   WHERE IDMETADESAFIODISTRIBUIDOR = :IDMETADESAFIODISTRIBUIDOR 
                     AND IDMETADESAFIODISTRIBUIDOR > 1 ;
                  --
                  COMMIT;
                  --
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2434728113974861626
        }
    )

