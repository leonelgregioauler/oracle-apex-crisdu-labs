    button atualizarciclo (
        buttonName: AtualizarCiclo
        label: Atualizar Ciclo
        layout {
            sequence: 30
            region: @botoes
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from metasdesafiodistribuidores
                 where cicloromance   = :P735_CICLOROMANCE
                   and idfilial       = :P0_IDFILIAL
                   and rownum         = 1
                   and ciclocongelado = 'N'
                   AND 1=2
                ```
        }
        comments {
            comments: Somente ciclos ABERTOS podem ser atualizados
        }
    )

