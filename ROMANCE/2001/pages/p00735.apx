    process atualizarciclo (
        name: AtualizarCiclo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 verro varchar2(1);
                begin
                  begin
                    select case 
                             when sum(DESAFIOCALCULADOROMANCE) > sum(DESAFIOCALCULADOATUAL) then
                               'S'
                             else
                               'N'
                           end 
                      into verro 
                      from METASDESAFIODISTRIBUIDORES M
                     where cicloromance = :P735_CICLOROMANCE
                       and idfilial     = :P0_IDFILIAL;
                    
                  end;
                  if verro = 'N' then
                    pck_metasromance.prc_gerametasdesafiodistrib(:P0_IDFILIAL,
                                                                 :P735_CICLOROMANCE,
                                                                 V('APP_USER'),
                                                                 'N');
                    commit;
                  else
                    raise_application_error(-20001,'Valor do desafio atual deve ser maior que desafio romance!');
                  end if;
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        successMessage {
            successMessage: Ciclo atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 2434729338839861625
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZARCICLO
        }
    )

    process congelarciclo (
        name: CongelarCiclo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                vtotaldesafio number;
                vtotalfranquia number;
                begin
                
                  vtotalfranquia := TO_NUMBER(REPLACE(:P735_DESAFIOFRANQUIA, '.', ''), '99999999999999999d99')  ;
                  if nvl(vtotalfranquia,0) = 0 then
                    select desafiocalculadoatual
                      into vtotalfranquia
                      from metasdesafioromance
                     where idfilial = :P0_IDFILIAL
                       and cicloromance = :P735_CICLOROMANCE;
                  end if;
                  --
                  select SUM(nvl(M.DESAFIOCALCULADOATUAL,0))
                  --     , SUM(nvl(M.DESAFIOCALCULADOROMANCE,0))
                    into vtotaldesafio
                  --     , vtotalfranquia
                    from METASDESAFIODISTRIBUIDORES M
                   where m.cicloromance = :P735_CICLOROMANCE
                     and m.idfilial     = :P0_IDFILIAL;
                        
                  --raise_application_error(-20001,'vtotaldesafio=' || vtotaldesafio || '  vtotalfranquia='|| vtotalfranquia);
                  if vtotaldesafio < vtotalfranquia then
                    --raise_application_error(-20001,'vtotaldesafio=' ||trunc(vtotaldesafio) || '  vtotalfranquia='|| trunc(vtotalfranquia) );
                  
                    apex_error.add_error( p_message => '<p class="custom-success-message">A Soma do desafio dos distribuidores deve ser igual ou maior que o desafio da franquia </p>'
                                        , p_display_location => apex_error.c_inline_in_notification);
                  else
                
                    pck_metasromance.prc_gerametasdesafiodistrib(:P0_IDFILIAL,
                                                                 :P735_CICLOROMANCE,
                                                                 V('APP_USER'),
                                                                 'S');
                    commit;
                  end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        successMessage {
            successMessage: Ciclo CONGELADO com sucesso!
        }
        advanced {
            executionMappingIdentifier: 2434729736636861625
        }
        serverSideCondition {
            type: request=Value
            value: CONGELARCICLO
        }
    )

