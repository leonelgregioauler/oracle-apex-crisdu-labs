    pageItem P735_CICLOROMANCE (
        type: selectList
        label {
            label: <b>Informe o Ciclo</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DIS D, RET R
                  FROM ( 
                        SELECT CASE WHEN SD.CICLOROMANCE IS NOT NULL THEN
                                   CICLOROMANCE || ' - Semana  ' ||
                                   (select semanacompleta semanaini
                                      from semana_dias 
                                     where idsemana = (select min(idsemana)
                                                         from semana_dias
                                                        where cicloromance = sd.cicloromance)) 
                                   || ' Até ' ||
                                   (select semanacompleta semanaini
                                      from semana_dias 
                                     where idsemana = (select max(idsemana)
                                                         from semana_dias
                                                        where cicloromance = sd.cicloromance))  
                                ELSE NULL
                                END  DIS
                             --
                             , CICLOROMANCE RET
                          FROM (
                                 SELECT distinct s.cicloromance 
                                   FROM semana_dias s
                                      , metasdesafioromance m
                                  WHERE s.cicloromance is not null
                                    AND s.cicloromance = m.cicloromance
                                    AND m.datacongelado is not null
                                    AND m.idfilial = :P0_IDFILIAL
                                    --AND m.ano = substr(:P735_CICLOROMANCE,4,4)
                                    AND not exists (select 1
                                                      from metasdesafiodistribuidores x
                                                     where x.idfilial     = m.idfilial
                                                       and x.cicloromance = m.cicloromance)
                                    AND m.idmetadesafioromance = (select MIN(idmetadesafioromance)
                                                                    from metasdesafioromance mr
                                                                   where idfilial = :P0_IDFILIAL
                                                                     and datacongelado is not null
                                                                     and not exists (select 1
                                                                                       from metasdesafiodistribuidores x
                                                                                      where x.idfilial     = mr.idfilial
                                                                                        and x.cicloromance = mr.cicloromance))
                                 /*UNION
                                 --
                                 select cicloromance
                                   from semana_dias
                                  where sysdate between dt_ini and dt_fim
                                    and not exists (select 1
                                                      from metasdesafioromance m
                                                     where m.idfilial = :P0_IDFILIAL
                                                       and m.datacongelado is not null) */
                                  ) SD
                
                          --
                          ORDER BY to_number(substr(cicloromance,4,4)), 
                                   to_number(substr(cicloromance,1,2)) )
                  WHERE RET IS NOT NULL
                ```
        }
