page 839 (
    name: Parâmetros Conquistou Levou
    alias: PARÂMETROS-CONQUISTOU-LEVOU
    title: Parâmetros Conquistou Levou
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region parâmetros-conquistou-levou (
        name: Parâmetros Conquistou Levou
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: PARAMETROSCONQUISTOULEVOU
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 35911471375440317
        }

        savedReport 359119 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDPARAMETROCONQUISTOULEVOU
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDPAIS
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @NOMEPARAMETRO
                layout {
                    width: 404.625
                    sequence: 4
                }
            )

            displayColumn (
                column: @VALOR
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @DATACRIACAO
                layout {
                    width: 140.625
                    sequence: 8
                }
            )

            displayColumn (
                column: @IDUSUARIO
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @ATIVO
                layout {
                    width: 80.625
                    sequence: 7
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 54.625
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ATIVO (
            type: selectList
            heading {
                heading: Ativo
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 80
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ATIVO
                dataType: varchar2
            }
            default {
                type: static
                staticValue: S
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column DATACRIACAO (
            type: datePicker
            heading {
                heading: Data Criação
            }
            layout {
                sequence: 90
            }
            appearance {
                formatMask: dd/mm/yyyy hh24:mi:ss
            }
            source {
                databaseColumn: DATACRIACAO
                dataType: date
            }
            default {
                type: sqlQuerySingleValue
                sqlQuerySingleValue: select to_date(sysdate,'dd/mm/yyyy hh24:mi:ss') from dual
            }
            readOnly {
                type: always
            }
        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
            }
            layout {
                sequence: 70
            }
            validation {
                valueRequired: true
                maxLength: 500
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDPAIS (
            type: selectList
            heading {
                heading: País
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pa.nome    d
                         , pa.idpais  r
                      from catal.paises pa
                     order by pa.nome
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDPAIS
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column IDPARAMETROCONQUISTOULEVOU (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDPARAMETROCONQUISTOULEVOU
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: ROMAN.SEQ_IDPARAMETROCONQUISTOULEVOU
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDUSUARIO (
            type: selectList
            heading {
                heading: Usuário
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select u.usuario d
                         , u.idusuario r
                      from catal.usuarios u
                     where u.idusuario = :P0_IDUSUARIO
                    ```
            }
            layout {
                sequence: 110
            }
            source {
                databaseColumn: IDUSUARIO
                dataType: number
            }
            default {
                type: sqlQuerySingleValue
                sqlQuerySingleValue: select :P0_IDUSUARIO from dual
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            readOnly {
                type: always
            }
        )

        column NOMEPARAMETRO (
            type: textField
            heading {
                heading: Nome  Parâmetro
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
                maxLength: 50
            }
            source {
                databaseColumn: NOMEPARAMETRO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column VALOR (
            type: textField
            heading {
                heading: Valor
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
                maxLength: 200
            }
            source {
                databaseColumn: VALOR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    process parâmetros-conquistou-levou-save-interactive-grid-data (
        name: Parâmetros Conquistou Levou - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @parâmetros-conquistou-levou
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 35857127278110920
        }
    )

)

