page 288 (
    name: Consultoras que não continuaram
    title: Consultoras que não continuaram
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region consultoras-que-não-continuaram (
        name: Consultoras que não continuaram
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(n.idvendedora) Cliente
                     , pck_romance.fnc_retornatelefones(n.idvendedora) Telefones
                from notasvendas n
                   , ( select nn.idnotavenda
                            , nn.idvendedora
                       from notasvendas nn
                       where nn.idrepresentante = :P288_IDREPRESENTANTE
                         and nn.semanacobranca = :P288_SEMANA
                         and nn.idnotavenda = ( select max(idnotavenda)
                                                from notasvendas ni
                                                where ni.idvendedora = nn.idvendedora ) ) ultima
                where n.idrepresentante = :P288_IDREPRESENTANTE
                  and n.semanacobranca = :P288_SEMANA
                  and n.idnotavenda >= ultima.idnotavenda
                  and n.idvendedora = ultima.idvendedora
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: setPaginationSelectList
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }

        column CLIENTE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                defaultSequence: 1
            }
        )

        column TELEFONES (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Telefones
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

    )

    pageItem P288_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @consultoras-que-não-continuaram
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P288_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @consultoras-que-não-continuaram
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

