page 263 (
    name: Log Telefones
    title: Log Telefones
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region log-de-telefones (
        name: Log de Telefones
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region log-telefones (
        name: Log Telefones
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select lp.usuarioalteracao "Usuario Alterou"
                     , decode(lp.tipoalteracao,'U','Alteração','I','Inclusão','D','Exclusão') "Tipo Alteração"
                     , lp.dataalteracao "Data Alteração"
                     , lp.idtelefonepessoa
                     , ( select o.nome
                         from operadorastelefonia o
                         where o.idoperadoratel = lp.idoperadoratel ) "Operadora"
                     , lp.telefone "Telefone"
                from logcatal.log_telefonespessoas lp
                where lp.idpessoa = :P263_IDPESSOA
                order by 1 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Não há informações.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 67373772236158935
        }

        column "Data Alteração" (
            type: plainText
            heading {
                heading: Data Alteração
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDTELEFONEPESSOA (
            type: plainText
            heading {
                heading: Idtelefonepessoa
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column Operadora (
            type: plainText
            heading {
                heading: Operadora
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column Telefone (
            type: plainText
            heading {
                heading: Telefone
                alignment: center
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column "Tipo Alteração" (
            type: plainText
            heading {
                heading: Tipo Alteração
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column "Usuario Alterou" (
            type: plainText
            heading {
                heading: Usuario Alterou
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 673795 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Data Alteração" (
                sequence: 3
            )

            displayColumn IDTELEFONEPESSOA (
                sequence: 4
            )

            displayColumn "Operadora" (
                sequence: 5
            )

            displayColumn "Telefone" (
                sequence: 6
            )

            displayColumn "Tipo Alteração" (
                sequence: 2
            )

            displayColumn "Usuario Alterou" (
                sequence: 1
            )

        )

    )

    pageItem P263_IDPESSOA (
        type: popupLov
        label {
            label: Pessoa
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||p.cpf||') ['||/*Translate(To_Char(*/cpf/*/100 ,'000,000,000.00') ,',.' ,'.-')*/||']' display_value
                     , p.idpessoa return_value
                from pessoas p
                    , vendedoras v
                where p.ativo = 'S'
                  and p.idpessoa = v.idpessoa
                  and v.idrepresentante in (select idrepresentante
                                            from representantes 
                                            where idgerente = (select idgerente
                                                               from gerentes
                                                               where idfilial = :P0_IDFILIAL))
                
                ```
        }
        layout {
            sequence: 10
            region: @log-de-telefones
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 10
            region: @log-de-telefones
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
            point: processing
        }
        behavior {
            target: {
                page: 263
                items: {
                    P263_IDPESSOA: &P263_IDPESSOA.
                }
                action: resetPagination
            }
        }
    )

)

