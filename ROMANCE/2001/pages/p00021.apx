    region relatório-de-carga (
        name: Relatório de Carga
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
    )

    pageItem P21_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap( p.nomepessoa ) display_value
                     , r.idrepresentante                     return_value
                from pessoas p
                   , representantes r
                where p.idpessoa  = r.idpessoa
                  and r.ativo = 'S'
                  and r.idgerente = ( select idgerente
                                      from GERENTES u
                                      where idfilial = :P0_IDFILIAL  )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o Representante -
        }
        layout {
            sequence: 20
            region: @relatório-de-carga
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P21_SEMANA (
