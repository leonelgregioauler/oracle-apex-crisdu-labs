    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatar_mascara(src,mascara,evt){
            var tecla;  
            if(evt.which){tecla = evt.which}
            else if(evt.keyCode){ tecla = evt.keyCode;}  
             if( tecla != 8 ){
             var campo = src.value.length;
             var saida = mascara.substring(0,1);
             var texto = mascara.substring(campo);
             if(texto.substring(0,1) != saida) {
             src.value+=texto.substring(0,1);}}
            }
            
            
            function fnc_popup_carga()
            {
              vidfilial = document.getElementById('P0_IDFILIAL').value;
              vidrepresentante = document.getElementById('P21_IDREPRESENTANTE').value;
              vsemana = document.getElementById('P21_SEMANA').value;
              pjan = window.open('f?p=&APP_ID.:20:&SESSION.::NO::P20_IDFILIAL,P20_IDREPRESENTANTE,P20_SEMANA:'+vidfilial+','+vidrepresentante+','+vsemana,'CARGA', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=800,height=700,left=250,top=100','_blank'); void(0);
              pjan.focus();
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region carga-detalhada (
        name: Carga Detalhada
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.semana
                     , pck_romance.fnc_nomerepresentante(c.idrepresentante) representante
                     , p.codigosisdist||' - '||initcap(p.nomeproduto) produto
                     , it.valorvenda
                     , decode(it.comissao,'S','Sim','N','Não') comissao
                     , decode(it.cargaamais,'S','Sim','N','Não') cargamais
                     , nvl(it.qtd_dist_pp,0) qtd_pp
                     , nvl(it.qtd_dist_p,0) qtd_p
                     , nvl(it.qtd_dist_m,0) qtd_m
                     , nvl(it.qtd_dist_g,0) qtd_g
                     , nvl(it.qtd_dist_gg,0) qtd_gg
                     , nvl(it.qtd_dist_egg,0) qtd_egg
                     , nvl(it.qtd_dist_exgg,0) qtd_exgg
                     , nvl(it.qtd_dist_u,0) qtd_u
                     , ( nvl(it.qtd_dist_pp,0)
                       + nvl(it.qtd_dist_p,0) 
                       + nvl(it.qtd_dist_m,0) 
                       + nvl(it.qtd_dist_g,0) 
                       + nvl(it.qtd_dist_gg,0)
                       + nvl(it.qtd_dist_egg,0) 
                       + nvl(it.qtd_dist_exgg,0)
                       + nvl(it.qtd_dist_u,0) ) qtdtotal
                from itenscargarepresentante it
                   , produtos p
                   , cargasrepresentantes c
                where it.idcargarepresentante = c.idcargarepresentante
                  and it.idproduto            = p.idproduto
                  and c.idrepresentante       = :P21_IDREPRESENTANTE
                  and c.semana                = :P21_SEMANA
                order by nomeproduto
                ```
        }
