        }
    )

    process fetch-row-from-defeitosfornecedores (
        name: Fetch Row from DEFEITOSFORNECEDORES
        type: autoRowFetch
        source {
            tableName: DEFEITOSFORNECEDORES
            pkColumn: IDDEFEITOFORNECEDOR
            pkItem: P249_IDDEFEITOFORNECEDOR
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 598508486021370463
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P249_IDDEFEITOFORNECEDOR is null then
                        select "SEQ_IDDEFEITOSFORNECEDORES".nextval
                          into :P249_IDDEFEITOFORNECEDOR
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 598508657930370464
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-defeitosfornecedores (
        name: Process Row of DEFEITOSFORNECEDORES
        type: autoRowProcessing
        target {
            tableName: DEFEITOSFORNECEDORES
            pkColumn: IDDEFEITOFORNECEDOR
            pkItem: P249_IDDEFEITOFORNECEDOR
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Processo realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 598508858678370465
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 598509084255370465
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 249
                items: {
                    P249_IDITEMNF: &P249_IDITEMNF.
                    P249_IDDEFEITOFORNECEDOR: &P249_IDDEFEITOFORNECEDOR.
                    P249_IDPRODUTO: &P249_IDPRODUTO.
                    P249_IDNOTAFISCAL: &P249_IDNOTAFISCAL.
                }
            }
        }
    )

)

