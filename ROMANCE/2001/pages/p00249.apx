    pageItem P249_IDPRODUTO (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist||'-'||p.nomeproduto
                     , p.idproduto
                from produtos p
                where p.idproduto = :P249_IDPRODUTO
                ```
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @defeitos-fornecedores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
