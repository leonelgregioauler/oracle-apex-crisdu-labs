page 249 (
    name: Defeitos Fornecedores
    title: Defeitos Fornecedores
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 50%
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
        executeWhenPageLoads:
            ```javascript-browser
            window.opener.location.reload(); 
            
            if (document.getElementById('P249_IDNOTAFISCAL').value == "") {
              window.close();
            }
            ```
    }
    headerAndFooter {
        footerText:
            ```html
            <script javascript>
             window.resizeTo(screen.width*.46,screen.height*.46);  
                window.moveTo(screen.width*.26, screen.height*.20);  
            </script>
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

