    pageItem P249_IDDEFEITO (
        type: popupLov
        label {
            label: Defeito
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(d.descricao) display_value
                     , d.iddefeito return_value
                from defeitos d
                order by 1;
                ```
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @defeitos-fornecedores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: IDDEFEITO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

