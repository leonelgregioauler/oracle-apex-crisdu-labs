    region notas-retiradas (
        name: Notas Retiradas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , nv.numeronota
                     , pck_romance.fnc_nomevendedora(nv.idvendedora) consultora
                     , pck_romance.fnc_cpfvendedora(nv.idvendedora) cpf
                     , pck_romance.fnc_nomefilial(nv.idfilial) empresa
                     , pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor
                     , nv.datanota
                     , nv.valortotalvendalqd
                     , nv.valorpago
                     , nv.saldo
                     , ( select pck_romance.fnc_nomepessoa(u.idpessoa)
                         from usuarios u
                         where u.idusuario = cn.idusuario ) retiradopor
                     , cn.dataclassificado 
                     , ( select sum(pn.valorpago)
                         from roman.pagamentosnotasvendas pn
                         where pn.idnotavenda = nv.idnotavenda
                         and pn.datapagamento > cn.dataclassificado) Apos
                     , ( select m.motivo
                         from  motivosliberacoes m
                         where m.idmotivoliberacao = cn.idvalorcaracteristica) Motivo
                     , ( select c.descricao
                         from roman.vw_classificacoesnotasvendas c
                         where c.idnotavenda = nv.idnotavenda
                           and c.idcaracteristicanotavenda = 30 ) Descricao
                from notasvendas nv
                   , classificacoesnotasvendas cn
                where ( :P525_DATAINICIO is null or cn.dataclassificado between to_date(:P525_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P525_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                  and ( :P525_IDFILIAL is null or nv.idfilial = :P525_IDFILIAL)
                  and ( :P525_IDREPRESENTANTE = -1 or nv.idrepresentante = :P525_IDREPRESENTANTE )
                  and cn.idcaracteristicanotavenda in (31,45)
                  and cn.idnotavenda               = nv.idnotavenda
                  and ( :P525_DATAINICIO is not null or :P525_IDFILIAL is not null)
                order by 3
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
