    pageItem P525_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P525_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P525_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and f.idgrupo != 5
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P525_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' ('||decode(ativo,'S','Ativo','N','Inativo')||')' d
                     , r.idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where idfilial = :P525_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: - Todos Distribuidores  -
            nullReturnValue: -1
        }
        cascadingLov {
            parentItems: P525_IDFILIAL
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P525_ORIGEM (
        type: radioGroup
        label {
            label: Origem
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Romance;R,Favorita;F,Boletos;B
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 525
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 525
                items: {
                    P525_IDFILIAL: &P525_IDFILIAL.
                    P525_IDREPRESENTANTE: &P525_IDREPRESENTANTE.
                    P525_DATAINICIO: &P525_DATAINICIO.
                    P525_DATAFIM: &P525_DATAFIM.
                    P525_ORIGEM: &P525_ORIGEM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

