    region pedidos-retirados (
        name: Pedidos Retirados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pf.idpedido idpedido
                     , pf.idpedido nrpedido
                     , pf.vendedora consultora
                     , pf.cpf cpf
                     , pf.filialromance empresa
                     , pf.representante distribuidor
                     , pf.dataemissao data
                     , pf.valorapagar valorapagar
                     , pf.valorpago valorpago
                     , pf.saldodevedor saldo
                     , ( select pck_romance.fnc_nomepessoa(u.idpessoa)
                         from usuarios u
                         where u.idusuario = cp.idusuario ) retiradopor
                     , cp.dataclassificado 
                     , ( select sum(pp.valorpago)
                         from favorita.pagamentospedidos pp
                            , favorita.vencimentospedidos v
                         where v.idpedido = pf.idpedido
                           and pp.idvencimentopedido = v.idvencimentopedido
                           and v.situacaovencimento  = 'V'
                           and pp.idsituacao = 20
                           and pp.databaixa > cp.dataclassificado ) Apos
                     , ( select m.motivo
                         from  motivosliberacoes m
                         where m.idmotivoliberacao = cp.idvalorcaracteristica) Motivo
                     , ( select distinct (c.descricao)
                         from favorita.vw_classificacoespedidos_fav c
                         where c.idpedido = pf.idpedido
                           and c.idcaracteristicapedido = 77) Descricao
                from favorita.vw_pedidos_fav pf
                   , favorita.classificacoespedidos cp
                where ( :P525_DATAINICIO is null or cp.dataclassificado between to_date(:P525_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P525_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                  and ( :P525_IDFILIAL is null or pf.idfilialromance = :P525_IDFILIAL)
                  and ( :P525_IDREPRESENTANTE = -1 or pf.idrepresentante = :P525_IDREPRESENTANTE )
                  and cp.idcaracteristicapedido = 88
                  and cp.idpedido               = pf.idpedido
                  and ( :P525_DATAINICIO is not null or :P525_IDFILIAL is not null)
                order by 3
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P525_ORIGEM
            value: F
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma nota retirada!
        }
        advanced {
