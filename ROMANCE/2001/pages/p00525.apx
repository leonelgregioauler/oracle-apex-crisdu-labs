page 525 (
    name: Notas Retiradas da Cobrança Terceirizada
    title: Notas Retiradas da Cobrança Terceirizada
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region boletos-retirados (
        name: Boletos Retirados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.idboleto
                     , b.numero numero
                     , pck_romance.fnc_nomevendedora(b.idvendedora) consultora
                     , pck_romance.fnc_cpfvendedora(b.idvendedora) cpf
                     , pck_romance.fnc_nomefilial(b.idfilial) empresa
                     , pck_romance.fnc_nomerepresentante(b.idrepresentante) distribuidor
                     , b.dataemissao
                     , b.valororiginal
                     , b.valorpagonegociacao valorpago
                     , (nvl(b.valornegociado,b.valororiginal) - nvl(b.valorpagonegociacao,0)) saldo
                     , ( select pck_romance.fnc_nomepessoa(u.idpessoa)
                         from usuarios u
                            , catal.historicos_boletos h
                         where u.usuario = h.usuario  
                           and h.idboleto = b.idboleto
                           and h.observacao = 'Boleto desfeito envio para a cobrança terceirizada!' ) retiradopor
                     , b.datadesfeitoterceirizada data
                     , ( select sum(pb.valorapagar)
                         from catal.parcelamentosboletos pb
                         where pb.idboleto = b.idboleto
                           and pb.situacao = 'Q'
                           and pb.databaixa > b.datadesfeitoterceirizada ) Apos
                     , ( select m.motivo
                         from  motivosliberacoes m
                         where m.idmotivoliberacao = b.idmotivoliberacao ) Motivo
                from boletos b 
                where ( :P525_DATAINICIO is null or b.datadesfeitoterceirizada between to_date(:P525_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P525_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                  and ( :P525_IDFILIAL is null or b.idfilial = :P525_IDFILIAL)
                  and ( :P525_IDREPRESENTANTE = -1 or b.idrepresentante = :P525_IDREPRESENTANTE )
                  and ( :P525_DATAINICIO is not null or :P525_IDFILIAL is not null)
                  and b.datadesfeitoterceirizada is not null
                order by 3
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P525_ORIGEM
            value: B
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma nota retirada!
        }
        advanced {
            savedReportMappingIdentifier: 5822585177922771430
        }

