            sqlExpression:
                ```sql
                ( :P598_IDUSUARIORESPONSAVEL = ( select idusuario from usuarios where usuario = v('APP_USER') ) or ( pck_util.fnc_verificaacesso(2577,v('APP_USER')) = 'S') )
                and not exists ( select 1
                                 from pagamentosnegociacoesparceiros pp
                                 where pp.idnegociacaoparceiro = :P598_IDNEGOCIACAOPARCEIRO
                                   and pp.situacao             = 'Q' )
                ```
        }
