page 598 (
    name: Pagamentos do Acordo
    title: Pagamentos do Acordo
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 70%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            
            function fnc_quitar(pid)
            {
              document.getElementById("P598_IDEDITAR").value = pid;
              apex.submit('QUITAR');
            }
            
            function fnc_emespera(pid)
            {
              document.getElementById("P598_IDEDITAR").value = pid;
              apex.submit('EMESPERA');
            }
            
            function fnc_vencido(pid)
            {
              document.getElementById("P598_IDEDITAR").value = pid;
              apex.submit('VENCIDO');
            }
            
            function imprimeboleto(vidpagamento,vidvendedora)
            {
              vurl = 'https://boleto.romancemoda.com.br/bb/boleto_qrcode.php?cod1='+vidpagamento+'&cod2='+vidvendedora;
              pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            
            
            function fnc_removedocumento(piddocumento)
            {
                apex.confirm("Deseja realmente remover o documento sinalizado?", {
              request:"DELETAR_DOCUMENTO",
              set:{"P591_IDDELETAR":piddocumento}
              });
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region aviso (
        name: Aviso
        type: staticContent
        layout {
            sequence: 40
            slot: dialogHeader
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from pagamentosnegociacoesparceiros pp
                where pp.datavencimento = trunc(sysdate)
                  and pp.situacao       = 'A'
                  and exists ( select 1
                               from negociacoesparceiros np
                               where np.idnegociacaoparceiro = :P598_IDNEGOCIACAOPARCEIRO
                                 and np.idnegociacaoparceiro = pp.idnegociacaoparceiro
                                 and np.formapagamento       = 'B'
                                 and trunc(np.datanegociacao) = trunc(sysdate) )
                ```
        }
    )

    region documentos-sinalizados (
        name: Documentos Sinalizados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.cpf
                     , case
                         when d.idnotavenda is not null then
                           'Sacola Romance'
                         when d.idpedido is not null then
                           'Pedido Favorita'
                         when d.idboleto is not null then
                           'Pedido Catalogo'
                         when d.idpepinorepres is not null then
                           'Pepino Antigo'
                       end origem
                     , d.documento
                     , (d.valor-valordesconto) valor
                     , d.valororiginal 
                     , d.valoratualizado
                     , d.valordesconto
                     , (d.valoratualizado - valororiginal) juros
                     , case
                         when exists ( select 1
                                       from roman.documentosnegociacao dn
                                          , favorita.vencimentospedidos v
                                       where dn.idpedido = v.idpedido
                                         and dn.idnegociacaoparceiro = d.idnegociacaoparceiro
                                         and dn.documento            = d.documento
                                         and v.datavencimento <= trunc (sysdate) - 31
                                         and v.situacaovencimento = 'V'
                                         and ( dn.idpedido is not null 
                                           or dn.idboleto is not null ) ) then
                           'Cobrança'     
                         when exists ( select 1
                                       from roman.documentosnegociacao dn
                                       where dn.idnegociacaoparceiro = d.idnegociacaoparceiro
                                         and dn.documento            = d.documento
                                         and ( dn.idnotavenda is not null 
                                           or dn.idpepinorepres is not null ) ) then
                           'Cobrança'
                         when exists ( select 1
                                       from roman.documentosnegociacao dn
                                          , favorita.vencimentospedidos v
                                       where dn.idpedido = v.idpedido
                                         and dn.idnegociacaoparceiro = d.idnegociacaoparceiro
                                         and dn.documento            = d.documento
                                         and v.datavencimento > trunc (sysdate) - 31
                                         and v.situacaovencimento = 'V'
                                         and dn.idpedido is not null ) then  
                              'Crédito'
                        end carteira
                from documentosnegociacao d
                where d.idnegociacaoparceiro = :P598_IDNEGOCIACAOPARCEIRO
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
