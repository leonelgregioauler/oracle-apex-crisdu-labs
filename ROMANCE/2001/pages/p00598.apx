    region observações (
        name: Observações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT LISTAGG(base.idnotavenda, '; ') WITHIN GROUP (ORDER BY base.idnotavenda)      AS idnotavenda
                     , LISTAGG(base.idpedido, '; ')    WITHIN GROUP (ORDER BY base.idpedido)         AS idpedido
                     , LISTAGG(base.idpepinorepres, '; ') WITHIN GROUP (ORDER BY base.idpepinorepres) AS idpepinorepres
                     , LISTAGG(base.idboleto, '; ')    WITHIN GROUP (ORDER BY base.idboleto)         AS idboleto
                     , LISTAGG(base.obs_notasvendas, '; ')      WITHIN GROUP (ORDER BY base.idnotavenda)     AS obs_notasvendas
                     , LISTAGG(base.obs_historicospedidos, '; ') WITHIN GROUP (ORDER BY base.idpedido)       AS obs_historicospedidos
                     , LISTAGG(base.obs_pepinosrepres, '; ')     WITHIN GROUP (ORDER BY base.idpepinorepres) AS obs_pepinosrepres
                     , LISTAGG(base.obs_historicos_boletos, '; ') WITHIN GROUP (ORDER BY base.idboleto)      AS obs_historicos_boletos
                  FROM (
                        SELECT /*+ CURSOR_SHARING_EXACT */
                               dn.idnotavenda
                             , dn.idpedido
                             , dn.idpepinorepres
                             , dn.idboleto
                             , (SELECT LISTAGG(onv.observacao, '; ' ON OVERFLOW TRUNCATE '...' WITH COUNT)
                                       WITHIN GROUP (ORDER BY onv.idnotavenda)
                                  FROM roman.observacoesnotasvendas onv
                                 WHERE onv.idnotavenda = dn.idnotavenda) AS obs_notasvendas
                
                             , (SELECT LISTAGG(hp.descricao, '; ' ON OVERFLOW TRUNCATE '...' WITH COUNT)
                                       WITHIN GROUP (ORDER BY hp.idpedido)
                                  FROM favorita.historicospedidos hp
                                 WHERE hp.idpedido = dn.idpedido) AS obs_historicospedidos
                
                             , (SELECT LISTAGG(pr.observacao, '; ' ON OVERFLOW TRUNCATE '...' WITH COUNT)
                                       WITHIN GROUP (ORDER BY pr.idpepinorepresentante)
                                  FROM roman.observacoespepinosrepres pr
                                 WHERE pr.idpepinorepresentante = dn.idpepinorepres) AS obs_pepinosrepres
                
                             , (SELECT LISTAGG(hb.observacao, '; ' ON OVERFLOW TRUNCATE '...' WITH COUNT)
                                       WITHIN GROUP (ORDER BY hb.idboleto)
                                  FROM catal.historicos_boletos hb
                                 WHERE hb.idboleto = dn.idboleto) AS obs_historicos_boletos
                
                          FROM documentosnegociacao dn
                         WHERE dn.idnegociacaoparceiro = :P598_IDNEGOCIACAOPARCEIRO
                       ) base
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
