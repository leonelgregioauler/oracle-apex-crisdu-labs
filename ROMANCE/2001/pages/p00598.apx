    region observações-do-acordo (
        name: Observações do Acordo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.idobservacaonegociacao
                     , ( select u.usuario
                         from usuarios u
                         where u.idusuario = o.idusuario ) usuario
                     , o.data
                     , o.observacao
                from observacoesnegociacoes o
                where o.idnegociacaoparceiro = :P598_IDNEGOCIACAOPARCEIRO
                order by 1 desc
                ```
        }
        layout {
