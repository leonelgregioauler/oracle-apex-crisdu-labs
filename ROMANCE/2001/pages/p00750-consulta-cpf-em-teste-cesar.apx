            sqlQuery:
                ```sql
                select 1 
                from dual
                where :P750_CPF is not null
                   or :P750_DOCUMENTOESTRANGEIRO is not null
                   or :P750_IDPEDIDO is not null
                ```
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: showAll
        }
        messages {
            whenNoDataFound: Nenhum Débito encontrado!
        }

