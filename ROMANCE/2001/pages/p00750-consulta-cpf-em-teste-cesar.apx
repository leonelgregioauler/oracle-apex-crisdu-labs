                      --
                      hexkey := md5(vcpf);
                      --
                      select lower(hexkey) md5
                      into vmd5
                      from dual;
                      --
                    select sys.utl_http.request('http://192.168.201.59:15084/'||vcpf||'/'||vmd5||'/'||:P0_IDFILIAL||'/'||v('APP_USER')||'/?prod=true')
                      into vretorno
                      from dual
                     where :P453_CPF is not null;
                    end;*/
                    -- Nao tem suporte para homolog
