                    P371_TIPODOCUMENTO: &P750_TIPO.
                    P371_IDHISTORICOCONSULTADOC:
                    P371_DATACONSULTA:
                    P371_IDREPRESENTANTE:
                    P371_IDSEMANA:
                    P371_LIBERADO:
                    P371_NROCONSULTASPC:
                    P371_USUARIO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P750_TIPO = 'D'
                  and :P750_DOCUMENTOESTRANGEIRO is not null
                  and ( v('APP_USER') in  ('GUILHERME','BRUNOB','EDUARDAZOTTI') or pck_util.fnc_verificaacesso(2409,v('APP_USER')) = 'N' ) -- 2409 Supervisores
                  and pck_util.fnc_verificaacesso(3540,v('APP_USER')) = 'N' -- Liberações Cobrança
                  and v('APP_USER') not in ('ALEXANDRAOLIVEIRA', 'JOAOFABRICIO', 'JUAND', 'MARIBELM')
                union
                select 1
                  from dual
                 where v('APP_USER') in ('MATHEUSMACHADO','KAINABRAGA','CAROLINASANTOS','RITHELYRIBEIRO','GABRIELEROLIM', 'ALICEVARGAS','LARISSASCHEFFER','JOANASOUZA','LARISSAARNOLD','DANIELAREIS', 'KAYLANEPEREIRA', 'NATHACHAALVES','LARISSACASTRO')
                   and :P750_TIPO = 'D'
                 -- MATHEUSMACHADO T10035995
                 -- KAINABRAGA T11122184
                 -- KAYLANEPEREIRA T11243853
                 -- NATHACHAALVES T11240626
                ```
        }
