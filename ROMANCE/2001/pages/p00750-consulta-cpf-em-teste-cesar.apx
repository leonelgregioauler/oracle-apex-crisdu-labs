    region pedidos-favorita (
        name: Pedidos Favorita
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nrpedido
                     , p.emissão
                     , p.entrega
                     , pck_util.fnc_semanaid(pck_util.fnc_idsemanadata(entrega)) semanaentrega
                     , p.situacaoentrega situacao
                     , p.situacaocobranca
                     , p.valortotal
                     , p.valorapagar
                     , p.distribuidor
                     , p.cancelamento
                     , p.motivo
                     , '<a href=javascript:verpedido('||p.idpedido||');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' infopedido
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':324:'||v('APP_SESSION')||'::NO::P324_IDPEDIDO:'||p.idpedido ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' urlpedido
                     , idpedidowidecommerce nrecommerce
                     , origempedido
                     , distribuidorfez
                     , ( select nv.numeronota
                         from roman.notasvendas nv
                         where nv.idnotavenda = p.idnotavenda ) Nota
                from vw_pedidos_rmc p
                where p.idsituacaoentrega > 10000
                  and p.idvendedora = :P750_IDVENDEDORA
                  and :P750_IDPESSOA is not null
                union
                select po.numeropedido
                     , po.dataemissao
                     , po.dataentrega
                     , pck_util.fnc_semanaid(pck_util.fnc_idsemanadata(po.dataentrega))
                     , po.situacao
                     , null
                     , po.valortotal
                     , po.valorapagar
                     , po.representante
                     , null
                     , null
                     , null
                     , null
                     , null
                     , null
                     , null
                     , null
                from favorita.vw_pedidos_old po
                where po.idvendedora = :P750_IDVENDEDORA
                  and :P750_IDPESSOA is not null
                ```
        }
        layout {
            sequence: 120
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P750_CPF is not null
                  or :P750_DOCUMENTOESTRANGEIRO is not null
                  or :P750_IDPEDIDO is not null
                ```
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

