                    -- Para banco Produção usar: sys.utl_http.request('http://192.168.201.59:15084/'||:P453_CPF||'/'||:P453_CPF_MD5||'/'||:P0_IDFILIAL||'/'||v('APP_USER')||'/?dev=true')
                    
                    --javascript: ConsultarSPC(document.getElementById('P750_CPF').value ,document.getElementById('P750_CPF_MD5').value ,document.getElementById('P750_IDFILIAL').value ,document.getElementById('P0_USUARIO').value ,function(dados){window.location.reload()});
                    declare
                    --
                      vretorno varchar2(2000) := null;
                      vcpf     varchar2(11)   := replace(replace(:P750_CPF,'.',''),'-',''); -- informe aqui o cpf
                      vhash    varchar2(100)  := null;
                      --
                    begin
                      --
                      SELECT md5(vcpf)
                      into vhash
                      FROM dual;
                      --
                      select sys.utl_http.request('http://192.168.201.59:15084/'||vcpf||'/'||vhash||'/1217/GUILHERME/?prod=true')
                        into vretorno
                        from dual;
                      --
                      --dbms_output.put_line(vretorno);
                      --
                    end;
                    
                    ```
