    region históricos-de-consulta-de-documento (
        name: Históricos de Consulta de Documento
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select h.idhistoricoconsultadoc
                     , h.dataconsulta
                     , h.documento
                     , h.descliberado
                     , h.codigoliberacao
                     , h.nroconsultaspc
                     , h.idrepresentante||' - '||h.nomerepresentante para
                     , h.semana
                     , h.usuario
                     , h.observacao
                     , telefones
                from vw_historicosconsultasdoc h
                where h.documento = replace(replace(NVL(:P750_DOCUMENTOESTRANGEIRO,:P750_CPF),'.',''),'-','') ~';
                ```
        }
        layout {
            sequence: 20
            parentRegion: @infos-de-consultas-e-históricos
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from historicosconsultasdoc h
                               where ( replace(replace(h.documento,'.',''),'-','') = replace(replace(:P750_CPF,'.',''),'-','') 
                                     or replace(replace(h.documento,'.',''),'-','') = replace(replace(:P750_DOCUMENTOESTRANGEIRO,'.',''),'-','') ) )
                ```
        }
