page 750 (
    name: Consulta CPF - Em Teste (Cesar)
    alias: CONSULTA-CPF-EM-TESTE-CESAR
    title: Consulta CPF - Em Teste (Cesar)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: [
            https://websocket.romancemoda.com.br/romance_equifax.js
            https://websocket.romancemoda.com.br/romance_equifax_py.js
        ]
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function validadocumento() {
            
              var get = new htmldb_Get(null, '&APP_ID.', 'APPLICATION_PROCESS=validacpfcnpj', 0);
            
              var pValue = 'F';
              var pVCPF  = html_GetElement('P750_CPF').value;
            
              get.add('F10008TIPO', pValue);
              get.add('F10008CPF', pVCPF);
            
              var gReturn = get.get();
            
              if (gReturn == 'V') {
                html_GetElement('P750_VALIDO').value = 'S';
              } else {
            
                if (pValue == 'F') {
                  alert('CPF é inválido!');
                }
            
                html_GetElement('P750_VALIDO').value = 'N';
              }
            
              get = null;
            }
            
            
            //--------------------------------------------
            
            function imprimeboleto(vidpedido, vidvendedora) {
            
              var vurl = 'https://boleto.romancemoda.com.br/boleto_bb_favorita_novo.php?cod1=' + vidpedido + '&cod2=' + vidvendedora;
            
              var pjan = window.open(
                vurl,
                'boleto',
                'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10'
              );
            
              pjan.focus();
            }
            
            
            //--------------------------------------------
            
            function vertarefas() {
            
              var pidpessoa = document.getElementById('P750_IDPESSOA').value;
            
              var pjanela = window.open(
                'f?p=&APP_ID.:392:&SESSION.::NO:392:P392_IDPESSOA:' + pidpessoa,
                'TAREFAS DA CLIENTE',
                'toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=1200,height=800,screenX=50,screenY=100'
              );
            
              pjanela.focus();
            }
            
            
            //--------------------------------------------
            
            function listasac() {
            
              var vurl = document.getElementById("P750_SESSION_SAC").value;
            
              var pjan = window.open(
                vurl,
                'popup',
                'toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=1200,height=400,screenX=50,screenY=100'
              );
            
              pjan.focus();
            }
            
            
            //--------------------------------------------
            
            function verfotos() {
            
              var pidpessoa = $v("P750_IDPESSOA");
            
              var pjanela = window.open(
                'f?p=&APP_ID.:373:&SESSION.::NO:373:P373_IDPESSOA:' + pidpessoa,
                'FOTOS DA CLIENTE',
                'toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=1200,height=800,screenX=50,screenY=100'
              );
            
              pjanela.focus();
            }
            
            
            //--------------------------------------------
            
            function verpedido(vidpedido) {
            
              var pjanela = window.open(
                'f?p=&APP_ID.:537:&SESSION.::NO:537:P537_IDPEDIDO:' + vidpedido,
                'Infos do Pedido',
                'toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=800,height=600,screenX=50,screenY=100'
              );
            
              pjanela.focus();
            }
            
            
            //--------------------------------------------
            
            function abrewhatsapp() {
            
              var ptelefone = document.getElementById('P750_TELEFONEWHATSAPP').value;
            
              var pjanela = window.open(
                'https://api.whatsapp.com/send?phone=55' + ptelefone,
                'whatsapp',
                'toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=1200,height=800,screenX=50,screenY=100'
              );
            
              pjanela.focus();
            }
            
            
            //--------------------------------------------
            
            function carregarScriptEquifax() {
            
              var idPais = apex.item('P750_IDPAIS').getValue();
            
            //alert (idPais);
            
              // define qual função usar
              var nomeFuncao = (idPais === '6') ? 'ConsultarEquifax' : 'ConsultarEquifaxPY';
            
              function executarConsulta() {
            
                if (typeof window[nomeFuncao] !== 'function') {
                  alert('Erro: função ' + nomeFuncao + ' não carregada');
                  return;
                }
            
                window[nomeFuncao](
                  document.getElementById('P750_DOCUMENTOESTRANGEIRO').value,
                  document.getElementById('P750_RUT_MD5').value,
                  document.getElementById('P750_IDFILIAL').value,
                  document.getElementById('P0_USUARIO').value,
                  function (dados) {
                    //window.location.reload();
                    console.log(dados)
                  }
                );
              }
            
              // se já existe a função correta, executa direto
              if (typeof window[nomeFuncao] === 'function') {
                executarConsulta();
                return;
              }
            
              var script = document.createElement('script');
              script.type = 'text/javascript';
            
              if (idPais === '4') {
                script.src = 'https://websocket.romancemoda.com.br/romance_equifax_py.js';
              } else {
                script.src = 'https://websocket.romancemoda.com.br/romance_equifax.js';
              }
            
              script.onload = executarConsulta;
            
              script.onerror = function () {
                alert('Erro ao carregar script Equifax');
              };
            
              document.head.appendChild(script);
            }
            
            
            //--------------------------------------------
            // ON LOAD
            
            if (html_GetElement('P750_CPF').value !== '') {
              validadocumento();
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            if (html_GetElement('P750_CPF').value != '')
            {
            validadocumento();
            }
            
            ```
    }
