    button consulta-spc (
        buttonName: CONSULTA_SPC
        label: Consulta ao SPC
        layout {
            sequence: 50
            region: @consulta-documento
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript: ConsultarSPC(document.getElementById('P750_CPF').value ,document.getElementById('P750_CPF_MD5').value ,document.getElementById('P750_IDFILIAL').value ,document.getElementById('P0_USUARIO').value ,function(dados){window.location.reload()});"
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P750_CPF is not null
                  and exists ( select 1
                               from usuarios u
                               where usuario = v('APP_USER')
                                 and u.ididioma = 1 )
                  and not exists ( select 1
                                   from vw_consultaspc_rmc c
                                   where c.cpf = replace(replace(:P750_CPF,'.',''),'-','') )
                  and exists ( select 1
                               from usuariosgruposatendimento ug
                               where ug.idgrupoatendimento in (0,3,4,9,21,22,23)
                                 and ug.usuario = v('APP_USER') )
                union
                select 1
                  from dual
                 where v('APP_USER') = 'DIEGOPIECHO'
                ```
        }
    )

