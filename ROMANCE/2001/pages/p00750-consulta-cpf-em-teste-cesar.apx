    process cadastro-com-débito (
        name: Cadastro com Débito
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidhistoricoconsulta number := null;
                  vdataconsulta        date := sysdate;
                  vdocumento           varchar2(15);
                  vliberado            varchar2(1) := 'N';
                  vusado               varchar2(1) := 'N';
                  vcodigoliberacao     number := null;
                  vnroconsultaspc      number := null;
                  vidrepresentante     number := null;
                  vidsemana            number := null;
                  vusuario             varchar2(30) := v('APP_USER');
                  vidpais              number := null;
                  vidfilial            number := :P750_IDIFLIAL;
                  vobservacao          varchar2(4000);
                  vtipodebito          varchar2(1) := 'C';
                  vmd5                 varchar2(1000);
                  --
                begin
                  --
                  vdocumento := replace(replace(:P750_CPF,'.',''),'-','');
                  --
                  --vobservacao := 'Não aprovada, deve para as marcas de Romance+Favorita. (Pode verificar nesse fone 0800 643 1251 Departamento de cobrança) ';
                  --vobservacao := 'Não aprovada, deve para as marcas de Romance+Favorita. (Pode verificar nos fones 51 99583-7733 Central De Negociação ou 11 98792-4771 Innovare  ) ';
                  vobservacao := 'CPF possui débito na Empresa. Click no link esse Canal exclusivo para Empreendedoras, regularize seu débito https://bit.ly/WPP-RMCFAV ';
                  --
                  --
                  pck_cadastros_rmc.prc_historicosconsultasdoc(pidhistoricoconsultadoc => vidhistoricoconsulta,
                                                               pdataconsulta => vdataconsulta,
                                                               pdocumento => vdocumento,
                                                               pliberado => vliberado,
                                                               pusado => vusado,
                                                               pcodigoliberacao => vcodigoliberacao,
                                                               pnroconsultaspc => vnroconsultaspc,
                                                               pidrepresentante => vidrepresentante,
                                                               pidsemana => vidsemana,
                                                               pusuario => vusuario,
                                                               pidpais => vidpais,
                                                               pidfilial => vidfilial,
                                                               pobservacao => vobservacao,
                                                               ptipodebito => vtipodebito,
                                                               pmd5 => vmd5,
                                                               poperacao_dml => 'I');
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Rejeitado com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 805850265203508890
        }
        serverSideCondition {
            type: request=Value
            value: COM_DEBITO
        }
    )

    process cadastro-com-débito-terceirizada (
        name: Cadastro com Débito Terceirizada
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidhistoricoconsulta number := null;
                  vdataconsulta        date := sysdate;
                  vdocumento           varchar2(15);
                  vliberado            varchar2(1) := 'N';
                  vusado               varchar2(1) := 'N';
                  vcodigoliberacao     number := null;
                  vnroconsultaspc      number := null;
                  vidrepresentante     number := null;
                  vidsemana            number := null;
                  vusuario             varchar2(30) := v('APP_USER');
                  vidpais              number := null;
                  vidfilial            number := :P750_IDIFLIAL;
                  vobservacao          varchar2(4000);
                  vtipodebito          varchar2(1) := 'T';
                  vmd5                 varchar2(1000);
                  --
                begin
                  --
                  vdocumento := replace(replace(:P750_CPF,'.',''),'-','');
                  --
                  --vobservacao := 'Não aprovada, deve para as marcas de Romance+Favorita. (Pode verificar no fone 08000500145 ou Whatsapp (11) 957130052/ (11) 956837373/ (11) 988238833 Departamento de cobrança) ';
                  vobservacao := 'Não aprovada, deve para as marcas de Romance+Favorita. (Pode verificar nos fones 51 99583-7733 Central De Negociação ou 11 98792-4771 Innovare) ';
                  
                  
                  --
                  pck_cadastros_rmc.prc_historicosconsultasdoc(pidhistoricoconsultadoc => vidhistoricoconsulta,
                                                               pdataconsulta => vdataconsulta,
                                                               pdocumento => vdocumento,
                                                               pliberado => vliberado,
                                                               pusado => vusado,
                                                               pcodigoliberacao => vcodigoliberacao,
                                                               pnroconsultaspc => vnroconsultaspc,
                                                               pidrepresentante => vidrepresentante,
                                                               pidsemana => vidsemana,
                                                               pusuario => vusuario,
                                                               pidpais => vidpais,
                                                               pidfilial => vidfilial,
                                                               pobservacao => vobservacao,
                                                               ptipodebito => vtipodebito,
                                                               pmd5 => vmd5,
                                                               poperacao_dml => 'I');
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Rejeitado com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 805848679839508889
        }
        serverSideCondition {
            type: request=Value
            value: COM_DEBITO_TERCEIRIZADA
        }
    )

    process carrega-informações-da-pagina (
        name: Carrega Informações da Pagina
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdocumento                 varchar2(30);
                  vidpessoa                  number;
                  vidvendedora               number;
                  vnomecliente               varchar2(1000);
                  vnomefilial                varchar2(1000);
                  vpontosromance             number;
                  vidfilial                  number;
                  vfotos                     varchar2(100);
                  vdistribuidor              varchar2(100);                    
                  vidrepresentante           number;
                  vtelefonedistribuidor      varchar2(4000); 
                  vsituacaocliente           varchar2(100);
                  vspc                       varchar2(1);
                  vsecretaria                varchar2(1) := 'N'; 
                  vidnotavenda               number;
                  vemdebito                  varchar2(1) := 'N';
                  vterceirizada              varchar2(1) := 'N';
                  vidioma                    number;
                  vCategoriaClubeDasEstrelas varchar2(350);
                  vIDCategoriaClubeEstrelas  number;
                  vIDFilialVendedora         number;
                  vFraude                    varchar2(3);
                  --
                begin
                  
                  :P750_EMDEBITO_MSG := '0'; -- Maicon Aimi - 09/01/2024 - ticket 7734024
                  vdocumento := replace(replace(replace(nvl(:P750_DOCUMENTOESTRANGEIRO,:P750_CPF),'.',''),'-',''),' ','');
                  --
                  select ididioma
                  into :P750_IDPAIS
                  from filiais f
                  where f.idfilial = :P750_IDFILIAL;
                  --
                  if :P750_DOCUMENTOESTRANGEIRO is not null then
                    :P750_RUT_MD5 := roman.pck_ti.fnc_md5(:P750_DOCUMENTOESTRANGEIRO);
                  end if;
                  --
                  -- INICIO -  BLOCO PARA TRATAR A MENSGEM DE VINCULO COM DEBITO
                  if :P750_CPF is not null and :P750_TIPO = 'C' then 
                    --
                    begin 
                      -- verifica se o cpf informado na página possui vinculo com algum outro cpf que possui débido na empresa.
                      select 'O CPF ' || :P750_CPF || ' possui vinculo / restrição Interna com o CPF ' || vd.cpfpessoavinculante || ' que possui débito na empresa!'
                        into :P750_AVISO_VINCULO_DEBITO_MSG
                        from vinculodebito vd
                       where vd.cpfpessoavinculada = :P750_CPF
                         and vd.datadesvinculacao is null
                         and rownum = 1;
                       
                    exception
                      when others then
                        :P750_AVISO_VINCULO_DEBITO_MSG := '';
                    end;
                    
                  elsif :P750_DOCUMENTOESTRANGEIRO is not null and :P750_TIPO = 'D' then 
                   
                    begin
                      -- verifica se o Doc. Estrangeiro informado na página possui vinculo com algum outro Doc. Estrangeiro que possui débido na empresa.
                      select 'O Doc. Estrangeiro ' || :P750_DOCUMENTOESTRANGEIRO || ' possui vinculo / restrição interna com o Doc. ' || vd.docextpessoavinculante || ' que possui débito na empresa!'
                        into :P750_AVISO_VINCULO_DEBITO_MSG
                        from vinculodebito vd
                       where vd.docextpessoavinculada = :P750_DOCUMENTOESTRANGEIRO
                         and vd.datadesvinculacao is null
                         and rownum = 1;
                       
                    exception
                      when others then
                        :P750_AVISO_VINCULO_DEBITO_MSG := '';
                    end;
                
                  else
                    :P750_AVISO_VINCULO_DEBITO_MSG := '';
                  end if;
                  -- FIM -  BLOCO PARA TRATAR A MENSGEM DE VINCULO COM DEBITO
                  --
                  --
                  if :P750_IDPEDIDO is null then
                    --
                    begin
                      --
                      select p.idpessoa 
                           , initcap(p.nomepessoa) nomepessoa
                      into vidpessoa 
                         , vnomecliente
                      from pessoas p
                      where ( ( :P750_CPF IS NOT NULL AND p.cpf = vdocumento )
                           or ( :P750_DOCUMENTOESTRANGEIRO IS NOT NULL AND p.documentoestrangeiro = vdocumento ) );
                      --
                    exception
                      when others then
                        vidpessoa := null;
                        vnomecliente := 'Cadastro não encontrado';
                    end;
                    --
                  elsif :P750_IDPEDIDO is not null then
                    --
                    select v.idvendedora
                         , v.idpessoa
                         , pck_romance.fnc_nomepessoa(v.idpessoa) nomepessoa
                    into vidvendedora 
                       , vidpessoa
                       , vnomecliente
                    from favorita.pedidos p
                       , vendedoras v
                    where p.idpedido = :P750_IDPEDIDO
                      and v.idvendedora = p.idvendedora;
                    --
                  end if;
                  --
                  if vidpessoa is not null then
                    --
                    begin
                      --
                      select v.idvendedora
                           , trunc(v.pontos)
                           , pck_romance.fnc_nomefilial(v.idfilial)
                           , pck_romance.fnc_nomerepresentante(v.idrepresentante) distribuidor
                           , idrepresentante
                           , decode(v.ativo,'S','Ativo','N','Inativo') situacao
                           , nvl(spc,'N') spc
                           , nvl((select max(idnotavenda)
                                  from notasvendas nv
                                  where nv.idvendedora = v.idvendedora
                                    and nv.idsituacaonotavenda = 3),null) idnotavenda
                           , decode(v.fraude, 'S','Sim','Não')
                      into vidvendedora
                         , vpontosromance
                         , vnomefilial
                         , vdistribuidor    
                         , vidrepresentante
                         , vsituacaocliente
                         , vspc
                         , vidnotavenda
                         , vFraude
                      from catal.vendedoras v
                      where v.idpessoa            = vidpessoa;
                      --
                      select ididioma
                      into vidioma
                      from vw_filiais f
                      where f.idfilial = :P0_IDFILIAL;
                      --where f.idfilial = :P750_IDFILIAL;
                      --
                      :P750_IDPAIS := vidioma;
                      --
                      if vspc = 'S' and vidioma in (2,4,6) then 
                        --
                        :P750_PAIS := 'E';
                        --
                      elsif vspc = 'S' and vidioma = 1 then 
                        --
                        :P750_PAIS := 'B';
                        --
                      else
                        --
                        :P750_PAIS := '';
                        --
                      end if;    
                      --     
                      begin
                        --
                        select listagg(translate(t.telefone,'0123456789AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvXxYyWwZz_-,.  !@#$%?&*()/??','0123456789'),' ') within group (order by 1)
                        into vtelefonedistribuidor
                        from telefonespessoas t
                            , representantes r
                        where t.idpessoa = r.idpessoa
                          and r.idrepresentante = vidrepresentante;
                        --
                      exception
                        when others then
                          vtelefonedistribuidor := null;
                      end;
                
                    exception
                      when others then
                        --
                        :P750_IDPESSOA := vidpessoa;
                        :P750_CLIENTE := vnomecliente;
                        :P750_IDVENDEDORA := null;
                        :P750_PONTOSROMANCE := 0.00;
                        --:P750_IDFILIAL := :P0_IDFILIAL;
                        :P750_POSSUIFOTOS := 'Não';
                        :P750_DISTRIBUIDORATENDE := null;
                        :P750_TELEFONEDISTRIBUIDOR := null;
                        :P750_SITUACAOCLIENTE := null;
                        :P750_SPC := null;
                        :P750_PAIS := null;
                        :P750_IDNOTAVENDA := null;
                        :P750_EMDEBITO := 'N';
                        :P750_CATEGORIA_CLUBE_ESTRELAS := null;
                        :P750_FRAUDE := null;
                        --
                    end;
                    --
                    begin
                      --
                      select 'Sim'
                      into vfotos
                      from dual
                      where exists ( select 1
                                     from fotosdocumentos f
                                     where f.idpessoa = vidpessoa 
                                       and f.recebida = 'S'
                                       and f.datadadosrecebido is not null );
                      --
                    exception
                      when others then
                        vfotos := 'Não';
                    end;
                    --
                    begin
                      select 'S'
                      into vsecretaria
                      from dual
                      where not exists ( select 1
                                         from usuariosgruposatendimento ug
                                         where ug.usuario = v('APP_USER')
                                           and ug.idgrupoatendimento in (22,4,3,9,0) );
                    exception
                      when others then
                        vsecretaria := 'N';
                    end;
                    --
                    if vsecretaria = 'S' then
                      --
                      :P750_IDFILIAL := :P0_IDFILIAL;
                      --
                    end if;
                    --
                    IF vsecretaria = 'N' and VIDVENDEDORA is not null THEN
                      --
                      begin
                        --
                        select 'S'
                        into vemdebito
                        from dual
                        where exists ( select 1
                                       from usuariosgruposatendimento ug
                                       where ug.usuario = v('APP_USER')
                                         and ug.idgrupoatendimento in (22,9,4,3,0) )
                          and ( exists ( select 1
                                         from notasvendas nv
                                         where nv.idvendedora        = VIDVENDEDORA
                                           and nv.idsituacaonotavenda = 4
                                           and nv.saldo               > 0 )
                             or exists ( select 1
                                         from catal.boletos b
                                         where b.situacao in ('V','G','S','M','K','E')
                                           and b.idvendedora = VIDVENDEDORA )
                             or exists ( select 1
                                         from favorita.pedidos p
                                         where p.idvendedora = VIDVENDEDORA
                                           and p.idsituacaoentrega >= 20000
                                           and exists ( select 1
                                                        from favorita.vencimentospedidos v
                                                        where v.idpedido = p.idpedido
                                                          and v.datavencimento < sysdate
                                                          and v.valorpago < v.valorpagar
                                                          and v.situacaovencimento = 'V')
                                           and not exists ( select 1
                                                            from favorita.classificacoespedidos c
                                                            where c.idpedido = p.idpedido
                                                              and c.idcaracteristicapedido = 46 )
                                           and not exists ( select 1
                                                            from favorita.classificacoespedidos c
                                                            where c.idpedido = p.idpedido
                                                              and c.idcaracteristicapedido = 25 ) ) );
                        --
                        -- Maicon Aimi - 09/01/2024 - ticket 7734024
                        select nvl(sum(nv.saldo),0) saldo
                          into :P750_EMDEBITO_MSG
                          from notasvendas nv
                         where nv.idvendedora         = VIDVENDEDORA
                           and nv.idsituacaonotavenda = 4
                           and nv.saldo               > 0;
                        -- Maicon Aimi - 09/01/2024 - ticket 7734024
                        --
                      exception
                        when others then
                          vemdebito := 'N';
                      end;
                      --
                      if vemdebito = 'S' then
                        --
                        begin
                          --
                          select 'S'
                          into vterceirizada
                          from dual
                          where ( exists ( select 1
                                           from notasvendas nv
                                           where nv.idvendedora = vidvendedora
                                            and nv.idsituacaonotavenda = 4
                                            and nv.saldo       > 0
                                            and exists ( select 1
                                                         from classificacoesnotasvendas cf
                                                         where cf.idcaracteristicanotavenda = 30
                                                           and cf.idnotavenda               = nv.idnotavenda ) )
                               or exists ( select 1
                                           from boletos b
                                           where b.idvendedora = vidvendedora 
                                             and b.situacao in ('V','G','S','M','K','E','A')
                                             and b.cobrancaterceirizada = 'S' )
                               or exists ( select 1
                                           from favorita.vw_pedidos_fav p
                                           where p.idvendedora = vidvendedora
                                             and p.idsituacaoentrega >= 20000
                                             and p.saldodevedor > 0
                                             and exists ( select 1
                                                          from favorita.classificacoespedidos c
                                                          where c.idpedido = p.idpedido
                                                            and c.idcaracteristicapedido = 77 )
                                             and not exists ( select 1
                                                              from favorita.classificacoespedidos c
                                                              where c.idpedido = p.idpedido
                                                                and c.idcaracteristicapedido = 25 ) ) );
                          --
                        exception
                          when others then 
                            vterceirizada := 'N';
                        end;
                        --
                      end if;
                      --
                    end if;
                    --
                  elsif vidpessoa is null then
                    --
                    :P750_IDPESSOA := null;
                    --:P750_CLIENTE := 'Cadastro não encontrado';
                    :P750_IDVENDEDORA := null;
                    :P750_PONTOSROMANCE := 0.00;
                    --:P750_IDFILIAL := :P0_IDFILIAL;
                    :P750_POSSUIFOTOS := 'Não';
                    :P750_DISTRIBUIDORATENDE := null;  
                    :P750_TELEFONEDISTRIBUIDOR := null;
                    :P750_SITUACAOCLIENTE := null;
                    :P750_SPC := null;
                    --:P750_PAIS := null;
                    :P750_IDNOTAVENDA := null;
                    :P750_EMDEBITO := 'N';
                    :P750_TERCEIRIZADA := vterceirizada;
                    :P750_CATEGORIA_CLUBE_ESTRELAS := null;
                    :P750_FRAUDE := null;
                    --
                  end if;
                  
                  
                  -- Maicon Aimi - 03/07/2024 - ticket 9092124 - Busca a classificação clube das estrelas da vendedora.
                  begin
                    if roman.pck_clubedesucesso.fnc_FilialVendedoraPossuiCampanhaAtiva(VIDVENDEDORA) then
                      
                      select ct.nomecategoria
                           , (select vv.idfilial from catal.vendedoras vv where vv.idvendedora = pp.idvendedora)
                           , ct.idcategoriaclube
                        into vCategoriaClubeDasEstrelas
                           , vIDFilialVendedora
                           , vIDCategoriaClubeEstrelas
                        from roman.pontuacoesclubedesucesso pp
                           , roman.categoriasclubes ct
                       where pp.idcategoriaclube = ct.idcategoriaclube
                         and pp.idpontuacaoclube = (select max(pc.idpontuacaoclube)
                                                      from catal.pessoas p
                                                         , catal.vendedoras v
                                                         , roman.pontuacoesclubedesucesso pc
                                                     where v.idpessoa = p.idpessoa
                                                       and pc.idvendedora = v.idvendedora
                                                       and v.idpessoa = vidpessoa);
                    else
                      vcategoriaclubedasestrelas := 'Não participa de campanha.';
                      vIDFilialVendedora        := null;
                      vIDCategoriaClubeEstrelas := null;
                    end if;
                  exception
                    when others then
                      vcategoriaclubedasestrelas := 'Não participa de campanha.';
                      vIDFilialVendedora        := null;
                      vIDCategoriaClubeEstrelas := null;
                  end;
                  
                  
                  --
                  :P750_IDPESSOA := VIDPESSOA;
                  :P750_CLIENTE := VNOMECLIENTE||' - '||VNOMEFILIAL;
                  :P750_IDVENDEDORA := VIDVENDEDORA;
                  :P750_PONTOSROMANCE := VPONTOSROMANCE;
                  :P750_POSSUIFOTOS := VFOTOS;
                  :P750_DISTRIBUIDORATENDE := VDISTRIBUIDOR;     
                  :P750_TELEFONEDISTRIBUIDOR := vtelefonedistribuidor;
                  :P750_SITUACAOCLIENTE := VSITUACAOCLIENTE;
                  :P750_SPC := vspc;
                  :P750_IDNOTAVENDA := vidnotavenda;
                  :P750_EMDEBITO := VEMDEBITO;
                  -- Maicon Aimi - 09/01/2024 - ticket 7734024
                  if :P750_EMDEBITO_MSG > 0 then
                    :P750_EMDEBITO_MSG := 'Este CPF possui débito na Empresa! (Débito total R$ '|| to_char(:P750_EMDEBITO_MSG,'FM999G999G990D00')|| '). OBS: Considerar somente débito maior que R$ 5,00!';  
                  else
                    :P750_EMDEBITO_MSG := 'Este CPF possui débito na Empresa!';  
                  end if;
                  -- Maicon Aimi - 09/01/2024 - ticket 7734024
                  :P750_TERCEIRIZADA := vterceirizada;
                  :P750_CATEGORIA_CLUBE_ESTRELAS := vCategoriaClubeDasEstrelas;
                  :P750_IDFILIALVENDEDORA        := vIDFilialVendedora;
                  :P750_IDCATEGORIACLUBEESTRELAS := vIDCategoriaClubeEstrelas;
                  :P750_FRAUDE := vFraude;
                
                exception 
                  when others then
                    :P750_IDPESSOA := null;
                    --:P750_CLIENTE := 'Cadastro não encontrado';
                    :P750_IDVENDEDORA := null;
                    :P750_PONTOSROMANCE := 0.00;
                    --:P750_IDFILIAL := :P0_IDFILIAL;
                    :P750_POSSUIFOTOS := 'Não';
                    :P750_DISTRIBUIDORATENDE := null;   
                    :P750_TELEFONEDISTRIBUIDOR := null;
                    :P750_SITUACAOCLIENTE := null;
                    :P750_SPC := null;
                    --:P750_PAIS := null;
                    :P750_IDNOTAVENDA := null;
                    :P750_EMDEBITO := 'N';
                    :P750_TERCEIRIZADA := 'N';
                    :P750_CATEGORIA_CLUBE_ESTRELAS := null;
                    :P750_IDFILIALVENDEDORA := null;
                    :P750_IDCATEGORIACLUBEESTRELAS := null;
                    :P750_FRAUDE := null;
                end;
                
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 805850631978508891
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P750_CPF is not null
                   or :P750_DOCUMENTOESTRANGEIRO is not null
                   or :P750_IDPEDIDO is not null
                ```
        }
    )

    process insert-tabela-controlecontatossite (
        name: Insert Tabela Controlecontatossite
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    for v_dados_controlecontatossite in (Select p.nomepessoa, p.cpf, p.datanascimento, p.enderecoprincipal, p.numero, p.complemento, p.bairro, p.idcidade, p.cep, p.email, v.idfilial, v.idrepresentante, p.idpais
                                                           from catal.pessoas p,
                                                                catal.vendedoras v
                                                          where v.idpessoa(+) = p.idpessoa
                                                            and p.cpf = :P750_CPF
                                                            and p.cpf is not null)
                    loop
                        INSERT INTO roman.controlecontatossite(
                            idcontrolecontatossite,
                            nomecompleto,
                            cpf,
                            datanascimento,
                            rua,
                            nr,
                            complemento,
                            bairro,
                            idcidade,
                            cep,
                            fone,
                            fone2,
                            email,
                            msn,
                            mensagem,
                            observacao,
                            situacao,
                            datacadastro,
                            idfilial,
                            idrepresentante,
                            dataliberadofilial,
                            datapassadorepres,
                            observacaofilial,
                            origem,
                            tipo,
                            idfilialorig,
                            idrepresentanteorig,
                            idvendedoraorig,
                            cadastrado,
                            tiposolicitacao,
                            attach_data,
                            attach_mimetype,
                            attach_filename,
                            attach_last_update,
                            attach_charset,
                            cidade,
                            inadimplente,
                            nroconsultaspc,
                            usuariocadastrou,
                            cadastrosistema,
                            observacaorepresentante,
                            datacadastrorepresentante,
                            idfilialfavorita,
                            divulgar,
                            idsemana,
                            codigoliberacao,
                            documentoestrangeiro,
                            idpais,
                            idtarefa,
                            usuarioliberoufilial,
                            usuarioliberourepres,
                            dataultimaatualizacao,
                            blogueira,
                            campanha,
                            autorizacaoconsultadoc,
                            dataintegracao,
                            idtablet,
                            idcontroletablet,
                            horarioatendimento,
                            idpromotor,
                            idsetor,
                            tipoprotocolo,
                            subtiposol)
                        VALUES(
                            -- idcontrolecontatossite 
                            roman.seq_idctrlcontatosite.nextval,
                            -- nomecompleto 
                            v_dados_controlecontatossite.nomepessoa,
                            -- cpf 
                            v_dados_controlecontatossite.cpf,
                            -- datanascimento 
                            v_dados_controlecontatossite.datanascimento,
                            -- rua 
                            v_dados_controlecontatossite.enderecoprincipal,
                            -- nr 
                            v_dados_controlecontatossite.numero,
                            -- complemento 
                            v_dados_controlecontatossite.complemento,
                            -- bairro 
                            v_dados_controlecontatossite.bairro,
                            -- idcidade 
                            v_dados_controlecontatossite.idcidade,
                            -- cep 
                            v_dados_controlecontatossite.cep,
                            -- fone 
                            NULL,
                            -- fone2 
                            NULL,
                            -- email 
                            v_dados_controlecontatossite.email,
                            -- msn 
                            NULL,
                            -- mensagem 
                            'Quer voltar a vender!!',
                            -- observacao 
                            'Registro criado via página consulta Doc.<280> por User: '|| v('APP_USER'),
                            -- situacao 
                            NULL,
                            -- datacadastro 
                            sysdate,
                            -- idfilial 
                            v_dados_controlecontatossite.idfilial,
                            -- idrepresentante 
                            v_dados_controlecontatossite.idrepresentante,
                            -- dataliberadofilial 
                            NULL,
                            -- datapassadorepres 
                            NULL,
                            -- observacaofilial 
                            NULL,
                            -- origem 
                            'NC',
                            -- tipo 
                            NULL,
                            -- idfilialorig 
                            NULL,
                            -- idrepresentanteorig 
                            NULL,
                            -- idvendedoraorig 
                            NULL,
                            -- cadastrado 
                            'S',
                            -- tiposolicitacao 
                            NULL,
                            -- attach_data 
                            NULL,
                            -- attach_mimetype 
                            NULL,
                            -- attach_filename 
                            NULL,
                            -- attach_last_update 
                            NULL,
                            -- attach_charset 
                            NULL,
                            -- cidade 
                            NULL,
                            -- inadimplente 
                            NULL,
                            -- nroconsultaspc 
                            NULL,
                            -- usuariocadastrou 
                            NULL,
                            -- cadastrosistema 
                            'S',
                            -- observacaorepresentante 
                            NULL,
                            -- datacadastrorepresentante 
                            NULL,
                            -- idfilialfavorita 
                            NULL,
                            -- divulgar 
                            NULL,
                            -- idsemana 
                            NULL,
                            -- codigoliberacao 
                            NULL,
                            -- documentoestrangeiro 
                            NULL,
                            -- idpais 
                            v_dados_controlecontatossite.idpais,
                            -- idtarefa 
                            NULL,
                            -- usuarioliberoufilial 
                            NULL,
                            -- usuarioliberourepres 
                            NULL,
                            -- dataultimaatualizacao 
                            NULL,
                            -- blogueira 
                            NULL,
                            -- campanha 
                            NULL,
                            -- autorizacaoconsultadoc 
                            NULL,
                            -- dataintegracao 
                            NULL,
                            -- idtablet 
                            NULL,
                            -- idcontroletablet 
                            NULL,
                            -- horarioatendimento 
                            NULL,
                            -- idpromotor 
                            NULL,
                            -- idsetor 
                            NULL,
                            -- tipoprotocolo 
                            'C',
                            -- subtiposol 
                            NULL);
                    end loop;
                end;
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Lead sinalizando que a vendedora Quer voltar a vender! gravado com sucesso.
        }
        error {
            errorMessage: OPS!  Ocorreu um erro!  Não foi possível gravar o Lead indicando que a vendedora Quer voltar a vender!
        }
        advanced {
            executionMappingIdentifier: 805851088444508891
        }
        serverSideCondition {
            whenButtonPressed: @quer-voltar-a-vender
        }
    )

    process limpa-campos (
        name: Limpa Campos
        type: clearSessionState
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 805851872042508892
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: ( :P750_CPF is null and :P750_DOCUMENTOESTRANGEIRO is null and :P750_IDPEDIDO is null )
        }
    )

    process marca-desmarca-fraude (
        name: MARCA DESMARCA FRAUDE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    update catal.vendedoras v
                       set fraude = (case 
                                        when v.fraude = 'S' then null
                                        else 'S' 
                                     end)
                     where v.idvendedora = :P750_IDVENDEDORA;
                end;
                ```
        }
        execution {
            sequence: 80
        }
        successMessage {
            successMessage: Situação da vendedora foi atualizada com sucesso.
        }
        error {
            errorMessage: Atenção!  Ocorreu um erro ao tentar Marcar/Desmarcar situação da vendedora como Fraude!!
        }
        advanced {
            executionMappingIdentifier: 805851457671508892
        }
        serverSideCondition {
