    process rejeição-de-cadastro (
        name: Rejeição de Cadastro
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidhistoricoconsulta number := null;
                  vdataconsulta        date := sysdate;
                  vdocumento           varchar2(15);
                  vliberado            varchar2(1) := 'N';
                  vusado               varchar2(1) := 'N';
                  vcodigoliberacao     number := null;
                  vnroconsultaspc      number := null;
                  vidrepresentante     number := null;
                  vidsemana            number := null;
                  vusuario             varchar2(30) := v('APP_USER');
                  vidpais              number := null;
                  vidfilial            number := :P0_IDFILIAL;
                  vobservacao          varchar2(4000) := :P750_OBSERVACAO_CPF;
                  vmd5                 varchar2(1000);
                  --
                begin
                  --
                  if :P750_TIPO = 'C' then
                    --
                    vdocumento := replace(replace(:P750_CPF,'.',''),'-','');
                    --
                  elsif :P750_TIPO = 'D' then
                    --
                    vdocumento := replace(replace(:P750_DOCUMENTOESTRANGEIRO,'.',''),'-','');
                    --
                  end if;
                  --
                  vobservacao := :P750_OBSERVACAO_CPF;
                  --
                  pck_cadastros_rmc.prc_historicosconsultasdoc(pidhistoricoconsultadoc => vidhistoricoconsulta,
                                                               pdataconsulta => vdataconsulta,
                                                               pdocumento => vdocumento,
                                                               pliberado => vliberado,
                                                               pusado => vusado,
                                                               pcodigoliberacao => vcodigoliberacao,
                                                               pnroconsultaspc => vnroconsultaspc,
                                                               pidrepresentante => vidrepresentante,
                                                               pidsemana => vidsemana,
                                                               pusuario => vusuario,
                                                               pidpais => vidpais,
                                                               pidfilial => vidfilial,
                                                               pobservacao => vobservacao,
                                                               pmd5 => vmd5,
                                                               poperacao_dml => 'I');
                  --
                  commit;
                  --
                  :P750_IDREJEICAO := vidhistoricoconsulta;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: "Cadastro Rejeitado com sucesso! "
        }
        advanced {
            executionMappingIdentifier: 805849430733508890
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CADASTRAR_TELEFONES','REJEITAR_CPF')
                ```
        }
    )

    process retira-do-spc (
        name: Retira do SPC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                --
                update vendedoras 
                set spc = 'N'
                where idvendedora = ( select v.idvendedora
                                      from pessoas p
                                         , vendedoras v
                                      where cpf = replace(replace(:P750_CPF,'-',''),'.','')
                                        and p.idpessoa = v.idpessoa );
                --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Retirada do SPC com sucesso!
        }
        advanced {
            executionMappingIdentifier: 805849040695508889
        }
        serverSideCondition {
            whenButtonPressed: @retirarspc
        }
    )

