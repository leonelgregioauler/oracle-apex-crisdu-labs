            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from usuarios
                               where usuario = v('APP_USER')
                                 and idgerente in (80,143) )
                  or exists ( select 1
                              from usuariosgruposatendimento ug
                              where ug.idgrupoatendimento = 22
                                and ug.usuario = v('APP_USER') )
                  or exists ( select 1
                              from catal.vendedoras vd
                              where vd.idvendedora = :P750_IDVENDEDORA
                                and vd.idfilial = ( select g.idfilial
                                                    from catal.usuarios us
                                                       , catal.gerentes g
                                                    where us.idgerente = g.idgerente
                                                      and us.usuario = v('APP_USER') ) )
                ```
        }
    )

