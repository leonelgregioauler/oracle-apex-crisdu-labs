    region infos-de-consultas-e-históricos (
        name: Infos de Consultas e Históricos
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from consultaspc c
                               where coalesce(c.cpf,c.runrut,c.documentoestrangeiro) = replace(replace(nvl(:P750_CPF,:P750_DOCUMENTOESTRANGEIRO),'.',''),'-','') )
                   or exists ( select 1
                               from historicosconsultasdoc h
                               where replace(replace(h.documento,'.',''),'-','') = replace(replace(nvl(:P750_CPF,:P750_DOCUMENTOESTRANGEIRO),'.',''),'-','') )
                   or exists ( select 1
                               from historicosconsultacheques ch
                               where replace(replace(ch.idvendedora,'.',''),'-','') = :P750_IDVENDEDORA )
                ```
        }
    )

    region notas-romance (
        name: Notas Romance
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.numeronota "Numero"
                 , nv.semanacobranca "Sem. Cobrança"
                 , (select ss.descricao 
                    from roman.situacoesnotavenda ss 
                    where ss.idsituacaonotavenda = nv.idsituacaonotavenda) "Situação"
                 , nv.valortotalnota "Valor Total"
                 , nv.valortotalvenda "Valor da Venda"
                 , nv.saldo "Saldo"
                 , roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) "Representante"
                 , idnotavenda
                 , pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(NV.IDREPRESENTANTE)) "Empresa Cliente R"
                 , null "Ir p/ Nota"
                 , nv.idfilial
                 , case 
                     when nv.idfilial = pck_romance.fnc_filialusuario(v('APP_USER')) then
                       '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                     else '-'
                   end URL
                 , nv.valorpago "Valor Pago"
                 , decode(nv.recuperarpromissoria,'S','Sim','Não') recuperarpromissoria
                 , decode(nv.promissoriarecuperada,'S','Sim','Não') promissoriarecuperada
                 , case
                     when nv.idsituacaopromissoria is not null then
                       ( select initcap(s.descricao)
                         from catal.situacoespromissorias s
                         where s.idsituacaopromis = nv.idsituacaopromissoria ) 
                     else
                       '-'
                   end situacaopromissoria
                 , dataacerto
                 , ( select c.observacao
                     from roman.classificacoesnotasvendas c 
                     where c.idnotavenda = nv.idnotavenda 
                       and c.idcaracteristicanotavenda = 67 ) Pedido_ecommerce
                from roman.notasvendas nv
                where nv.idvendedora = :P750_IDVENDEDORA
                  and :P750_IDPESSOA is not null
                order by idnotavenda desc
                ```
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where :P750_CPF is not null
                 or :P750_DOCUMENTOESTRANGEIRO is not null
                 or :P750_IDPEDIDO is not null
                ```
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Nenhuma nota encontrada!
        }

