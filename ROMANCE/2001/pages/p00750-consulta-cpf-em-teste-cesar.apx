    pageItem P750_AVISO_ATIVO_GRUPOS (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 120
            region: @consulta-documento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText:
                ```html
                <font color="GREEN">
                    <h3>
                    Este CPF está ATIVO na Romance!
                    </h3>
                </font>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P750_CPF is not null
                  and :P750_IDPESSOA is not null
                  and exists ( select 1
                               from usuariosgruposatendimento ug
                               where ug.usuario = v('APP_USER')
                                 and ug.idgrupoatendimento = 22 )
                  and exists ( select 1
                               from catal.vendedoras v
                                  , catal.pessoas p
                               where v.idpessoa = p.idpessoa
                                 and v.idpessoa = :P750_IDPESSOA
                                 and v.ativo    = 'S' 
                                 and p.cpf is not null
                                 and p.documentoestrangeiro is null)
                ```
        }
        security {
            encryptSessionState: false
        }
    )

