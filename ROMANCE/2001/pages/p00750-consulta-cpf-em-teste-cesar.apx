    pageItem P750_AVISO_CEDENCIA (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 260
            region: @consulta-documento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText:
                ```html
                <font color="RED">
                    <h2>
                    Cedência de débito ao Distribuidor!
                    </h2>
                </font>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.notasvendas nv
                where nv.idvendedora = :P750_IDVENDEDORA
                  and exists ( select 1
                               from roman.classificacoesnotasvendas cl
                               where cl.idnotavenda = nv.idnotavenda
                                 and cl.idcaracteristicanotavenda = 59)
                  and nvl(nv.saldo,0) > 0 --T11584018
                union
                select 1
                from favorita.vw_pedidos_fav p
                where p.idvendedora = :P750_IDVENDEDORA
                  and nvl(p.saldodevedor,0) > 0 -- T10303592
                  and exists ( select 1
                               from favorita.classificacoespedidos cc
                               where cc.idpedido = p.idpedido
                                 and cc.idcaracteristicapedido = 104)
                ```
        }
        security {
            encryptSessionState: false
        }
    )

