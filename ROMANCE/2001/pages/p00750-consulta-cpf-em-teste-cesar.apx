    region débitos-favorita (
        name: Débitos Favorita
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.dataemissao "Dt Emissão"
                  , b.datavencimento "Dt Vencimento"
                  , b.numero "Numero"
                  , (select s.descricao
                     from catal.situacoes s
                     where s.idsituacao = b.situacao) "Situação"
                  , null "Situação Cobrança"
                  , nvl(b.valornegociado,b.valororiginal) "Valor"
                  , (nvl(b.valornegociado,b.valororiginal) - nvl(b.valorpagonegociacao,0)) "Saldo"
                  , pck_romance.fnc_nomerepresentante(b.idrepresentante) "Representante"
                  , pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(b.IDREPRESENTANTE)) "Empresa Cliente R."
                  , ( select nrpedido from pedidos where idpedido = b.idpedido ) "Nr Pedido"
                  , pck_util.fnc_calculajuros(pvalororiginal      => (nvl(b.valornegociado,b.valororiginal) - nvl(b.valorpagonegociacao,0)),
                                              pdatavencimentoorig => b.datavencimento,
                                              pdatavencimentonovo => sysdate,
                                              ppercmulta          => 2,
                                              ppercjuros          => 1) valoratualizado
                from catal.boletos b
                where b.situacao in ('V','G','S','M','K','E','A')
                  and b.idvendedora = :P750_IDVENDEDORA
                  and :P750_IDPESSOA is not null
                union
                select p.dataemissao
                     , p.datavencimentomenor
                     , p.numeropedido
                     , p.situacaoentrega
                     , p.situacaocobranca
                     , p.valorapagar
                     , p.saldodevedor
                     , p.representante
                     , pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(p.IDREPRESENTANTE))
                     , p.numeropedido
                     , favorita.pck_util_fav.fnc_calculajurosporvencimento( pidpedido   => p.idpedido,
                                                                            ppercmulta  => 2,
                                                                            ppercjuros  => 1) valoratualizado
                from favorita.vw_pedidos_fav p
                where p.idvendedora = :P750_IDVENDEDORA
                  and trunc(p.saldodevedor,2) > 0
                  and p.idsituacaoentrega >= 20000
                  and :P750_IDPESSOA is not null
                  and exists ( select 1
                               from favorita.vencimentospedidos v
                               where v.idpedido = p.idpedido
                                 and v.datavencimento < sysdate
                                 --and v.valorpago < v.valorpagar
                                 and v.valorpago < v.valorpagar
                                 and v.situacaovencimento = 'V')
                  and not exists ( select 1
                                   from favorita.classificacoespedidos c
                                   where c.idpedido = p.idpedido
                                     and c.idcaracteristicapedido = 46 )
                  and not exists ( select 1
                                   from favorita.classificacoespedidos c
                                   where c.idpedido = p.idpedido
                                     and c.idcaracteristicapedido = 25 )
                  and p.ididioma = 1
                  and not exists ( select 1
                                   from favorita.classificacoespedidos cl
                                   where cl.idpedido = p.idpedido
                                     and cl.idcaracteristicapedido = 104)
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where :P750_CPF is not null
                 or :P750_DOCUMENTOESTRANGEIRO is not null
                 or :P750_IDPEDIDO is not null
                ```
        }
