    region informações-da-consulta (
        name: Informações da Consulta
        type: classicReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  v_sql clob;
                  --
                begin
                  --
                  if :P750_IDPAIS = 4 then
                    --
                    v_sql := q'~
                        select c.dataconsulta
                             , c.protocolo
                             , c.regiaocpf
                             , c.situacaocpf
                             , c.nome
                             , c.nomemae
                             , case
                                 when spc_quantidade > 0 then
                                   '<font color="red"><b>'||spc_quantidade||'</b></font>'
                                 else
                                   '<font color="blue"><b>'||spc_quantidade||'</b></font>'
                               end spc_quantidade
                             , case
                                 when spc_quantidade > 0 then
                                   '<font color="red"><b>'||spc_quantidade||'</b></font>'
                                 else
                                   '<font color="blue"><b>'||spc_quantidade||'</b></font>'
                               end spc_quantidade_franquias
                             , c.spc_valortotal
                             , decode(c.restricao,'S','Possui Restrição','Sem Restrição') restricao
                             , idconsultaspc
                             , datanascimento
                             , case
                                 when ccf > 0 then
                                   '<font color="red"><b>'||ccf||'</b></font>'
                                 else
                                   '<font color="blue"><b>'||ccf||'</b></font>'
                               end ccf
                        from consultaspc c
                        where c.documentoestrangeiro = replace(replace(:P750_DOCUMENTOESTRANGEIRO,'.',''),'-','')
                        order by 1 ~';
                    --
                  elsif :P750_IDPAIS = 6 then
                    --
                    v_sql := q'~
                        select c.dataconsulta
                             , c.protocolo
                             , c.regiaocpf
                             , c.situacaocpf
                             , c.nome
                             , c.nomemae
                             , case
                                 when spc_quantidade > 0 then
                                   '<font color="red"><b>'||spc_quantidade||'</b></font>'
                                 else
                                   '<font color="blue"><b>'||spc_quantidade||'</b></font>'
                               end spc_quantidade
                             , case
                                 when spc_quantidade > 0 then
                                   '<font color="red"><b>'||spc_quantidade||'</b></font>'
                                 else
                                   '<font color="blue"><b>'||spc_quantidade||'</b></font>'
                               end spc_quantidade_franquias
                             , c.spc_valortotal
                             , decode(c.restricao,'S','Possui Restrição','Sem Restrição') restricao
                             , idconsultaspc
                             , datanascimento
                             , case
                                 when ccf > 0 then
                                   '<font color="red"><b>'||ccf||'</b></font>'
                                 else
                                   '<font color="blue"><b>'||ccf||'</b></font>'
                               end ccf
                        from consultaspc c
                        where c.runrut = replace(replace(:P750_DOCUMENTOESTRANGEIRO,'.',''),'-','')
                        order by 1 ~';
                    --
                  else
                    --
                    v_sql := q'~
                        select c.dataconsulta
                             , c.protocolo
                             , c.regiaocpf
                             , c.situacaocpf
                             , c.nome
                             , c.nomemae
                             , case
                                 when spc_quantidade > 0 then
                                   '<font color="red"><b>'||spc_quantidade||'</b></font>'
                                 else
                                   '<font color="blue"><b>'||spc_quantidade||'</b></font>'
                               end spc_quantidade
                             , case
                                 when spc_quantidade > 0 then
                                   '<font color="red"><b>'||spc_quantidade||'</b></font>'
                                 else
                                   '<font color="blue"><b>'||spc_quantidade||'</b></font>'
                               end spc_quantidade_franquias
                             , c.spc_valortotal
                             , decode(c.restricao,'S','Possui Restrição','Sem Restrição') restricao
                             , idconsultaspc
                             , datanascimento
                             , case
                                 when ccf > 0 then
                                   '<font color="red"><b>'||ccf||'</b></font>'
                                 else
                                   '<font color="blue"><b>'||ccf||'</b></font>'
                               end ccf
                        from consultaspc c
                        where c.cpf = replace(replace(:P750_CPF,'.',''),'-','')
                        order by 1 ~';
                    --
                  end if;
                  --
                  return v_sql;
                  --
                end;
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @infos-de-consultas-e-históricos
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from (
                    select 1
                    from consultaspc c
                    where c.cpf = replace(replace(:P750_CPF,'.',''),'-','')
                      and :P750_CPF is not null 
                    union 
                    select 1
                    from consultaspc c
                    where c.runrut = replace(replace(:P750_DOCUMENTOESTRANGEIRO,'.',''),'-','')
                      and :P750_DOCUMENTOESTRANGEIRO is not null
                    union
                    select 1
                    from consultaspc c
                    where c.documentoestrangeiro = replace(replace(:P750_DOCUMENTOESTRANGEIRO,'.',''),'-','')
                      and :P750_DOCUMENTOESTRANGEIRO is not null )
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CCF (
            reportColumnQueryId: 13
            derivedColumn: N
            type: link
            heading {
                heading: Cheque S/ Fundo
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            link {
                target: {
