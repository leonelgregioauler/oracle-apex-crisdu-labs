            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from negociacoesparceiros np
                where np.idvendedora = :P750_IDVENDEDORA
                  and origem = 'B'
                having max(np.datanegociacao) > sysdate- 7 
                  and :P750_IDVENDEDORA is not null
                  
                union
                
                -- ticket 8943956 - 30/07/2024 - Maicon Aimi
                -- consulta para verificar se tem alguma negociação em boleto com SITUAÇÃO em aberto para a vendedora.
                select 2
                  from roman.pagamentosnegociacoesparceiros p
                 where :P750_IDVENDEDORA is not null
                   and p.situacao = 'A'
                   and exists (select 1
                                 from roman.negociacoesparceiros n
                                where n.idvendedora          = :P750_IDVENDEDORA
                                  and n.idnegociacaoparceiro = p.idnegociacaoparceiro
                                  and n.origem               = 'B');
                ```
        }
        security {
            encryptSessionState: false
        }
    )

