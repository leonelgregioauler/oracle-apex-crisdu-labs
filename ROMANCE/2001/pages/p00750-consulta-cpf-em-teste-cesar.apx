    region débitos-notas-em-papéis (
        name: Débitos Notas Em Papéis
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pr.nrpedido "Nr Nota"
                  , pr.valor "Valor"
                  , pr.semana "Semana"
                  , decode(pr.situacao,'N','Novo','P','Pago','C','Cobrança','D','Devolução Representante','S','SPC') "Situação"
                  , pr.semanapago "Semana Pago"
                  , pr.observacao "Observação"
                  , pck_romance.fnc_nomerepresentante(pr.idrepresentante) "Representante"
                  , pr.dataenviocobranca "Data Envio Cob"
                  /*, case when 
                         (select valor - nvl(( select sum(valor)
                                                 from pepinosrepresentantes
                                                where nrpedido = P.NRPEDIDO
                                                  and idrepresentante = P.IDREPRESENTANTE
                                                  and situacao = 'P' ),0)
                               from pepinosrepresentantes P
                                   where idpepinosrepresentante = :P750_IDPEPINOSREPRESENTANTE
                                     and p.idrepresentante = pr.idrepresentante) > 0 
                         then (select valor - nvl(( select sum(valor)
                                                 from pepinosrepresentantes
                                                where nrpedido = P.NRPEDIDO
                                                  and idrepresentante = P.IDREPRESENTANTE
                                                  and situacao = 'P' ),0)
                               from pepinosrepresentantes P
                                   where idpepinosrepresentante = :P750_IDPEPINOSREPRESENTANTE
                                     and p.idrepresentante = pr.idrepresentante)
                         else
                          0
                     end*/
                  , pr.valorsaldo "Saldo Devedor"
                  , nvl(cpf,'PAGAMENTO SEM VÍNCULO DE CPF') "Cpf"
                  , null
                  , pr.idpepinosrepresentante
                  , decode(pr.situacao,'P',pck_romance.fnc_retornacodigoliberacao(pr.idpepinosrepresentante++10000000)) "Cód Liberação"
                from pepinosrepresentantes pr
                where  pr.cpf = replace(replace(:P750_CPF,'-',''),'.','')
                       --or lower(pr.nomevendedora) = :P750_CLIENTE_NOME   )
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <br><font size="4" color="green"> Observar cuidadosamente o CPF que está informado no débito, caso seja diferente do CPF PESQUISADO, pertence a outra consultora com o MESMO nome, caso não possua CPF, há necessidade de verificar com o setor de COBRANÇA.</font></b>
        }
        serverSideCondition {
