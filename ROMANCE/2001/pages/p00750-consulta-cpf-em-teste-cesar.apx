    region débitos-notas-netbook-tablet (
        name: Débitos Notas Netbook/Tablet
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.numeronota
                  , nv.semanadistribuicao "Distribuição"
                  , nv.semanacobranca "Cobrança"
                  , pck_romance.fnc_nomerepresentante(nv.idrepresentante) "Representante"
                  , nv.valortotalnota "Total da Nota"
                  , nv.perccomissao "Comissão"
                  , nv.valortotalvendalqd "Total Venda Liquida"
                  , nvl((select SUM(p.valor)
                          from pepinosrepresentantes p
                          where p.idnotavenda = nv.idnotavenda
                            and p.situacao    = 'P'
                            and p.idfechamentoreprespago is null ),0) +
                          nvl((select sum(pnv.valorpago)
                               from pagamentosnotasvendas pnv
                               where pnv.idnotavenda = nv.idnotavenda
                                 and trim(pnv.semanacobranca) is null
                                 and not exists ( select 1 
                                                  from pepinosrepresentantes p
                                                  where p.idnotavenda = pnv.idnotavenda 
                                                    and p.valor       = pnv.valorpago
                                                    and p.idfechamentoreprespago is null
                                                    and p.situacao = 'P') ),0) SETORCOBRANCA
                  , nv.valorpago "Pago"
                  , nv.saldo "Saldo"
                  , pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(NV.IDREPRESENTANTE)) "Empresa Cliente R"
                  , null
                  , idnotavenda
                  , nv.idfilial
                  , decode(nv.enviadocobranca,'S',pck_util.fnc_calculajuros(pvalororiginal => nv.saldo,
                                                                            pdatavencimentoorig => nvl(nv.dataretornoorig,nv.dataretorno),
                                                                            pdatavencimentonovo => sysdate,
                                                                            ppercmulta => 2,
                                                                            ppercjuros => 1),null) "Saldo Atualizado"
                  , decode(nv.enviadocobranca,'S','Sim','Não') enviadocobranca
                  , nvl( (select 'Data: '||pg.datapagamento||' Valor: '||pg.valorpago
                          from pagamentosnotasvendas pg
                          where pg.idpagtonotavenda = ( select max(pgg.idpagtonotavenda)
                                                        from pagamentosnotasvendas pgg
                                                        where pgg.idnotavenda = nv.idnotavenda ) ) ,'Sem Pagamento') ultimopagamento
                from notasvendas nv
                   , vendedoras v
                where nv.saldo > 0
                  and :P750_IDPESSOA is not null
                  and nv.idsituacaonotavenda = 4
                  and v.idvendedora = nv.idvendedora
                  and v.idpessoa    = :P750_IDPESSOA
                  and not exists ( select 1
                                   from roman.classificacoesnotasvendas cl
                                   where cl.idnotavenda = nv.idnotavenda
                                     and cl.idcaracteristicanotavenda = 59)
                order by 3 desc
                
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
