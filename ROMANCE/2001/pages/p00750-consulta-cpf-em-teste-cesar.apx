    pageItem P750_TICKETMEDIO (
        type: textField
        label {
            label: Ticket Médio
            alignment: left
        }
        layout {
            sequence: 40
            region: @histórico-cliente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(nvl((sum(n.valorpago) / count(n.idnotavenda)),0),'999G999G999G999G999G999G990D00') ticket
                from notasvendas n
                   , vendedoras v
                where v.idvendedora         = n.idvendedora
                  and v.idpessoa            = :P750_IDPESSOA
                  and n.idsituacaonotavenda = 4
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

