    pageItem P750_AVISO_DE_MENOR (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 200
            region: @consulta-documento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText:
                ```html
                <font color="RED">
                    <h2>
                    Este CPF é DE MENOR idade, verifique!
                    </h2>
                </font>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P750_CPF is not null
                  and exists ( select 1
                               from consultaspc c
                               where replace(replace(c.cpf,'.',''),'-','') = replace(replace(:P750_CPF,'.',''),'-','')
                                 and datanascimento is not null
                                 and trunc((months_between(sysdate, c.datanascimento))/12) < 18 )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P750_AVISO_DISTRIBUIDOR_RESPRECEB (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 190
            region: @consulta-documento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText:
                ```html
                <font color="blue">
                    <h2>
                    Distribuidor Recebeu ou se Responsabilizou pelo débito desta consultora!
                    </h2>
                </font>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from usuariosgruposatendimento ug
                               where ug.idgrupoatendimento in (22,0)
                                 and ug.usuario = v('APP_USER') )
                  and ( exists ( select 1
                               from notasvendas nv
                               where nv.idvendedora        = :P750_IDVENDEDORA
                                 and nv.idsituacaocobranca = 70
                                 and nv.idsituacaonotavenda = 4
                                 and nv.saldo              > 0 )
                    or exists ( select 1
                                from favorita.pedidos p
                                where p.idvendedora = :P750_IDVENDEDORA
                                  and exists ( select 1
                                               from favorita.classificacoespedidos c
                                               where c.idcaracteristicapedido = 41
                                                 and c.idpedido               = p.idpedido )
                                  and not exists ( select 1
                                                   from favorita.classificacoespedidos c
                                                   where c.idcaracteristicapedido = 25
                                                     and c.idpedido               = p.idpedido ) ) )
                  and ( nvl(( select 1
                            from dual
                            where exists ( select 1 
                                           from favorita.vw_pedidos_fav pf
                                           where pf.saldodevedor > 0 
                                             and pf.idvendedora = :P750_IDVENDEDORA
                                             and pf.ididioma = 1
                                             and not exists ( select 1
                                                              from favorita.classificacoespedidos c
                                                              where c.idcaracteristicapedido = 25
                                                                and c.idpedido               = pf.idpedido ))),0)
                    + nvl(( select 1
                            from dual
                            where exists ( select 1
                                           from notasvendas nv
                                           where nv.idvendedora = :P750_IDVENDEDORA
                                             and nv.idsituacaonotavenda = 4
                                             and nv.saldo > 0 )),0)
                    + nvl(( select 1
                            from dual
                            where exists ( select 1
                                           from favorita.vw_pedidos_old c
                                           where idvendedora    = :P750_IDVENDEDORA
                                             and c.saldodevedor > 0.5 
                                             and c.idsituacao != 'Q' )),0) ) = 1
                   
                ```
        }
        security {
            encryptSessionState: false
        }
    )

