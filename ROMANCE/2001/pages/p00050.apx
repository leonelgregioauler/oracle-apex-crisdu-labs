        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relação-de-notas-com-pedidos-do-sistema-antigo (
        name: Relação de Notas com Pedidos do Sistema Antigo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                 , n.numeronota||' - '||pck_romance.fnc_nomevendedora(n.idvendedora) nota
                 , p.nrpedido pedido
                 , n.idnotavenda
                 , p.observacao 
                from notasvendas n
                 , catal.pedidos p
                where p.idnotavenda = n.idnotavenda
                  and exists ( select 1
                               from catal.boletos b
                               where b.idpedido = p.idpedido
                                 and b.situacao = 'Z' )
                  and n.idfilial = :P0_IDFILIAL
                  and ( :P50_IDREPRESENTANTE is null or n.idrepresentante = :P50_IDREPRESENTANTE )
                order by 1 
                ```
            pageItemsToSubmit: P50_IDREPRESENTANTE
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma resultado encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 193876610016970338
        }

