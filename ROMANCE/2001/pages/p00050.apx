    region relação-de-notas-com-pedidos-do-sistema-novo (
        name: Relação de Notas com Pedidos do Sistema Novo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , n.numeronota||' - '||pck_romance.fnc_nomevendedora(n.idvendedora) nota
                     , ( select decode(ativo,'S','Ativo','N','Inativo')
                         from vendedoras v
                         where v.idvendedora = n.idvendedora ) situacao
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , n.valortotalnota
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , n.perccomissao comissao
                     , n.valorcomissao
                     , case
                         when n.perccomissao = 40 then
                           30 / 100 * n.basecomissao
                         else
                           n.valorcomissao
                       end comissaocorreta
                     , p.idpedido pedido
                     , n.idnotavenda
                     , nvl(( select m.descricao
                             from favorita.protocolosatendimentos pp
                                , favorita.motivosprotocolos m
                             where m.idmotivoprotocolo = pp.idmotivoprotocolo
                               and pp.idpedido = p.idpedido
                               and pp.idtipoprotocolo = 1
                               and pp.situacao = 'C'
                               and exists ( select 1
                                            from favorita.itensdevolucaopedidos idp
                                            where idp.idprotocoloatendimento = pp.idprotocoloatendimento
                                              and idp.idpedido               = pp.idpedido ) ),'Não Encontrado!') motivo
                from notasvendas n
                   , favorita.pedidos p
                where p.idnotavenda = n.idnotavenda
                  and n.idsituacaonotavenda = 4
                  and exists ( select 1
                               from favorita.classificacoespedidos cp
                               where cp.idcaracteristicapedido = 25
                                 and cp.idpedido               = p.idpedido )
                  and n.idfilial = :P0_IDFILIAL
                  and ( :P50_IDREPRESENTANTE is null or n.idrepresentante = :P50_IDREPRESENTANTE )
                order by 1 
                ```
            pageItemsToSubmit: P50_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
