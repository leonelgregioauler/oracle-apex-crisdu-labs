    pageItem P587_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta||' - De '||s.dt_ini||' até '||s.dt_fim d
                     , s.idsemana
                from semana_dias s
                where s.idsemana <= pck_util.fnc_idsemanadata(sysdate)
                  and s.ano >= 2019
                order by 2 desc
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: expression
            plsqlExpression: pck_util.fnc_idsemanadata(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

