    region ultimas-20-semanas (
        name: Ultimas 20 semanas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta semana
                     , nvl(ped.qtd,0) qtdpedidos
                     , nvl(ped.valorapagar,0) valorpedidos
                     , '+' s1
                     , nvl(rmccasa.qtd,0) qtdrmccasa
                     , nvl(rmccasa.valorapagar,0) valorrmccasa
                     , '=' s2
                     , nvl(ped.valorapagar,0) + nvl(rmccasa.valorapagar,0) total
                     , nvl(ped.qtd,0) + nvl(rmccasa.qtd,0) qtdtotal
                from semana_dias s
                   , ( select sum(pp.valorapagar) valorapagar
                            , count(distinct idpedido) qtd
                            , pp.idsemanaemissao idsemana
                       from favorita.pedidos pp
                       where pp.idsituacaoentrega >= 20000
                         and pp.tipopedido in ('P', 'T', 'V')
                         and pp.valorapagar > 0
                         and pp.datacancelamento is null
                         and not exists ( select 1
                                          from favorita.classificacoespedidos c
                                          where c.idcaracteristicapedido = 8
                                            and c.idvalorcaracteristica  = 16
                                            and c.idpedido               = pp.idpedido )
                         and pp.idfilialromance  = :P0_IDFILIAL 
                       group by idsemanaemissao ) ped
                   , ( select sum(pp.valorapagar) valorapagar
                            , count(distinct idpedido) qtd
                            , pp.idsemanaemissao idsemana
                       from favorita.pedidos pp
                       where pp.idsituacaoentrega >= 20000
                         and pp.tipopedido = 'R'
                         and pp.valorapagar > 0
                         and pp.datacancelamento is null
                         and not exists ( select 1
                                          from favorita.classificacoespedidos c
                                          where c.idcaracteristicapedido = 8
                                            and c.idvalorcaracteristica  = 16
                                            and c.idpedido               = pp.idpedido )
                         and pp.idfilialromance  = :P0_IDFILIAL 
                       group by idsemanaemissao ) rmccasa
                where s.idsemana between pck_util.fnc_idsemanadata(sysdate)-21 and pck_util.fnc_idsemanadata(sysdate)
                  and s.idsemana = ped.idsemana(+)
                  and s.idsemana = rmccasa.idsemana(+)
                order by s.idsemana desc
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
