    region por-canal-de-venda (
        name: Por Canal de Venda
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante )  "Representante"
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(ped.idfilialfavorita) origem
                     , nvl(ped.valorapagar,0) "Valor Total"
                     , nvl(ped.qtd,0) "Qtd Pedidos"
                     , nvl(rmccasa.valorapagar,0) "Valor Total RMC Casa"
                     , nvl(rmccasa.qtd,0) "Qtd RMC Casa"
                     , nvl(ped.valorapagar,0) + nvl(rmccasa.valorapagar,0) "Total"
                     , nvl(ped.qtd,0) + nvl(rmccasa.qtd,0) "QTD Total"
                from representantes r
                   , ( select idrepresentante
                            , pp.idfilialfavorita
                            , sum(nvl(pp.valorapagar,0)) valorapagar
                            , sum(pp.valortotal) valortotal
                            , count(1) qtd
                       from favorita.pedidos pp
                       where pp.idsituacaoentrega >= 20000
                         and pp.tipopedido in ('P', 'T', 'V')
                         and pp.valorapagar > 0
                         and pp.datacancelamento is null
                         and not exists ( select 1
                                          from favorita.classificacoespedidos c
                                          where c.idcaracteristicapedido = 8
                                            and c.idvalorcaracteristica  = 16
                                            and c.idpedido               = pp.idpedido )
                         and pp.idfilialromance  = :P0_IDFILIAL
                         and ( :P587_TIPO_SEMANA = 'S' and pp.idsemanaemissao = :P587_SEMANA
                           or ( :P587_TIPO_SEMANA = 'P' and pp.idsemanaemissao between :P587_SEMANA_INI and :P587_SEMANA_FIM ) )   
                       group by idrepresentante, pp.idfilialfavorita ) ped
                    , ( select idrepresentante
                            , pp.idfilialfavorita
                            , sum(pp.valorapagar) valorapagar
                            , count(1) qtd
                       from favorita.pedidos pp
                       where pp.idsituacaoentrega >= 20000
                         and pp.tipopedido = 'R'
                         and pp.valorapagar > 0
                         and pp.datacancelamento is null
                         and not exists ( select 1
                                          from favorita.classificacoespedidos c
                                          where c.idcaracteristicapedido = 8
                                            and c.idvalorcaracteristica  = 16
                                            and c.idpedido               = pp.idpedido )
                         and pp.idfilialromance  = :P0_IDFILIAL
                         and ( :P587_TIPO_SEMANA = 'S' and pp.idsemanaemissao = :P587_SEMANA
                           or ( :P587_TIPO_SEMANA = 'P' and pp.idsemanaemissao between :P587_SEMANA_INI and :P587_SEMANA_FIM ) )      
                       group by idrepresentante, pp.idfilialfavorita ) rmccasa
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                  and r.ativo = 'S'
                  and r.idrepresentante = ped.idrepresentante(+)
                  and r.idrepresentante = rmccasa.idrepresentante(+)
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
