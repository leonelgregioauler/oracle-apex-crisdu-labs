    dynamicAction tipo-pesquisa (
        name: Tipo Pesquisa
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P587_TIPO_SEMANA
        }
        clientSideCondition {
            type: item=value
            item: P587_TIPO_SEMANA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P587_SEMANA_INI
                    P587_SEMANA_FIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P587_SEMANA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P587_SEMANA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P587_SEMANA_INI
                    P587_SEMANA_FIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 587
                items: {
                    P587_TIPO_SEMANA: &P587_TIPO_SEMANA.
                    P587_SEMANA: &P587_SEMANA.
                    P587_SEMANA_INI: &P587_SEMANA_INI.
                    P587_SEMANA_FIM: &P587_SEMANA_FIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

