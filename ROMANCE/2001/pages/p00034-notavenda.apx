        reloadOnSubmit: always
    }

    region imprime (
        name: imprime
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                   prc_imprimenotavenda ( '02/2012'
                                        , 1593
                                        , null ) ;
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
    )

)

