        series confirmado-na-conta (
            name: Confirmado na Conta
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select trunc(datanegociacao) datanegociacao
                         , count(distinct idrepresentante) qtdistribuidores
                         , sum(valorconfirmado) valorconfirmado
                    from vw_negociacoesparceiros w
                    --where datanegociacao  between to_date('01/01/2020 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date('05/05/2020 23:59:59','DD/MM/RRRR  hh24:mi:ss')
                    where datanegociacao  between to_date(:P571_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P571_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                      and w.idfilial = :P0_IDFILIAL
                      and w.idrepresentante = :P571_IDREPRESENTANTE
                    group by trunc(datanegociacao) 
                    order by 1
                    ```
                pageItemsToSubmit: [
                    P571_IDREPRESENTANTE
                    P571_DATAINICIO
                    P571_DATAFIM
                ]
            }
            columnMapping {
                label: DATANEGOCIACAO
                value: VALORCONFIRMADO
                customColumn: QTDISTRIBUIDORES
            }
            marker {
                show: true
                shape: circle
            }
            label {
                show: true
                position: belowMarker
            }
        )

