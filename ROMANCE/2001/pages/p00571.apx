    region ultimos-logins (
        name: Ultimos Logins
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ln.data
                     , ln.qtdlogins
                     , lg.tempo
                from (
                        select trunc(ln.data) data
                             , count(1) qtdlogins
                        from logsnegociacoesparceiros ln
                        where ln.data between to_date(:P571_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P571_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                          and ln.idrepresentante = :P571_IDREPRESENTANTE
                          and ln.texto = 'Login feito com sucesso'
                        group by trunc(ln.data) ) ln 
                   , ( 
                       select lg.data
                            , pck_util.fnc_tempodecorrido((lg.datafinal-lg.datalogin),'H') tempo
                       from (
                               select d.data
                                    , ( select min(ln.data)
                                        from logsnegociacoesparceiros ln 
                                        where trunc(ln.data)     = d.data 
                                          and ln.texto           = 'Login feito com sucesso'
                                          and ln.idrepresentante = :P571_IDREPRESENTANTE ) datalogin
                                    , ( select max(ln.data)
                                        from logsnegociacoesparceiros ln 
                                        where trunc(ln.data)     = d.data 
                                          and ln.idrepresentante = :P571_IDREPRESENTANTE ) datafinal
                               from dias d
                               where exists ( select 1
                                              from logsnegociacoesparceiros ln
                                              where trunc(ln.data)     = d.data
                                                and ln.texto           = 'Login feito com sucesso'
                                                and ln.idrepresentante = :P571_IDREPRESENTANTE ) ) lg ) lg
                where ln.data = lg.data
                order by 1 desc
                ```
            pageItemsToSubmit: [
                P571_IDREPRESENTANTE
                P571_DATAINICIO
                P571_DATAFIM
            ]
        }
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum Login localizado.
        }
