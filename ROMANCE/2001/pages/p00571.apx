    region utilização-por-distribuidores (
        name: Utilização por Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.idrepresentante
                     , w.nome      empresa
                     , pck_romance.fnc_nomerepresentante(r.idrepresentante) distribuidor
                     , l.qtd_logins             qtd_logins
                     , n.valornegociacao        valornegociacao
                     , n.valorconfirmado        valorconfirmado
                     , ( n.valornegociacao - nvl(n.valorconfirmado,0) ) valorpendente
                     , n.qtd_negociacoes        qtd_negociacoes
                     , nvl(c.valorcomissao,0)   valorcomissao
                     , cn.valor                 comissaodisponivel
                from representantes r
                   , vw_filiais     w                          
                   , ( select idrepresentante
                            , sum(n.valornegociacao)  valornegociacao
                            , count(1)             qtd_negociacoes
                            , sum(valorconfirmado) valorconfirmado
                       from vw_negociacoesparceiros  n
                       where datanegociacao  between to_date(:P571_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P571_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                       group by idrepresentante ) n
                   , ( select cp.idrepresentante
                            , sum(cp.valorpago) valorcomissao
                       from vw_comissoes_cobraki_paga cp
                       where cp.datapagamento between to_date(:P571_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P571_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                       group by idrepresentante ) c
                   , ( select cn.idrepresentante
                            , sum(cn.valorcomissao) valor
                       from vw_comissoes_pagar_neg cn
                       group by cn.idrepresentante ) cn
                   ,  ( select idrepresentante
                             , count(1)   qtd_logins
                        from logsnegociacoesparceiros l 
                        where texto like '%Login feito com sucesso%'
                        group by idrepresentante ) l
                where w.idgerente       = r.idgerente
                  and r.idrepresentante = n.idrepresentante  (+)
                  and r.idrepresentante = l.idrepresentante  (+)  
                  and r.idrepresentante = c.idrepresentante  (+)
                  and r.idrepresentante = cn.idrepresentante (+)
                  and r.ativo           = 'S'
                  and w.idfilial        = :P0_IDFILIAL
                  and r.idrepresentante = :P571_IDREPRESENTANTE
                order by 1  
                ```
            pageItemsToSubmit: [
                P571_IDREPRESENTANTE
                P571_DATAFIM
                P571_DATAINICIO
            ]
        }
