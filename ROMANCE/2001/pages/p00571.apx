        name: Inicia Filtro
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P571_DATAINICIO is null then
                    :P571_DATAINICIO := '01/04/2020';--to_char(trunc(sysdate),'DD/MM/RRRR');
                  end if;
                  --
                  if :P571_DATAFIM is null then
                    :P571_DATAFIM := to_char(trunc(sysdate),'DD/MM/RRRR');
                  end if;
                  --
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 40719499371212926
        }
    )

