    region agendamentos (
        name: Agendamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.vendedora
                     , w.data
                     , w.dataparacontato
                     , w.valor
                from vw_agendamento_vendedoras w
                where w.data between to_date(:P571_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P571_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                  and w.idrepresentante = :P571_IDREPRESENTANTE
                order by data desc
                ```
            pageItemsToSubmit: [
                P571_IDREPRESENTANTE
                P571_DATAINICIO
                P571_DATAFIM
            ]
        }
        layout {
            sequence: 110
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent12
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum agendamento realizado.
        }
        advanced {
            savedReportMappingIdentifier: 40696348899134619
        }

