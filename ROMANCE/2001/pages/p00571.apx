    region comissões-pagas (
        name: Comissões Pagas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util.fnc_semanaid(c.idsemana) semana
                     , sum(c.valorpago) valor
                from vw_comissoes_cobraki_paga c
                where c.idfilial = :P0_IDFILIAL
                  and c.idrepresentante = :P571_IDREPRESENTANTE
                group by c.idsemana
                order by c.idsemana desc
                ```
