page 124 (
    name: Atualizar Produto
    title: Atualizar Produto
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region atualizar-produto (
        name: Atualizar Produto
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P124_ATIVO (
        type: radioGroup
        label {
            label: Ativo
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @atualizar-produto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: ATIVO
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P124_CLASSIFICACAO1 (
        type: radioGroup
        label {
            label: Classificação 1
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Verão;VERAO,Inverno;INVERNO
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @atualizar-produto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: CLASSIFICACAO1
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P124_CLASSIFICACAO2 (
        type: textField
        label {
            label: Classificação 2
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 70
            region: @atualizar-produto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: CLASSIFICACAO2
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P124_COMISSAO (
        type: radioGroup
        label {
            label: Comissão
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @atualizar-produto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: COMISSAO
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P124_IDESTOQUEFILIAL (
        type: hidden
        layout {
            sequence: 10
            region: @atualizar-produto
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDESTOQUEFILIAL
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P124_IDPRODUTO (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto)  nomeproduto
                     , P.IDPRODUTO
                from produtos p
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @atualizar-produto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDPRODUTO
            used: always
        }
        readOnly {
            type: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P124_VLRVENDA (
        type: numberField
        label {
            label: Vlr Venda
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @atualizar-produto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 10
        }
        validation {
            maxLength: 10
        }
        source {
            type: databaseColumn
            databaseColumn: VLRVENDA
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 20
            region: @atualizar-produto
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 185
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 10
            region: @atualizar-produto
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P124_IDESTOQUEFILIAL
        }
    )

    process fetch-row-from-estoquefilial (
        name: Fetch Row from ESTOQUEFILIAL
        type: autoRowFetch
        source {
            tableName: ESTOQUEFILIAL
            pkColumn: IDESTOQUEFILIAL
            pkItem: P124_IDESTOQUEFILIAL
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 277711372202074278
        }
    )

    process process-row-of-estoquefilial (
        name: Process Row of ESTOQUEFILIAL
        type: autoRowProcessing
        target {
            tableName: ESTOQUEFILIAL
            pkColumn: IDESTOQUEFILIAL
            pkItem: P124_IDESTOQUEFILIAL
            supportedOperations: update
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 277711572029074281
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 124
                items: {
                    P124_IDESTOQUEFILIAL: &P124_IDESTOQUEFILIAL.
                }
            }
        }
    )

)

