page 699 (
    name: Relatório de Distribuidor/Vendedora
    title: Relatório de Distribuidor/Vendedora
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 60%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region análise-por-vendedora (
        name: Análise por Vendedora
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                      ,nv.numeronota     
                      ,nv.semanacobranca
                      ,roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) Distribuidor
                      ,nv.idvendedora
                      ,roman.pck_romance.fnc_nomevendedora(nv.idvendedora) Vendedora
                      ,nv.valortotalvenda
                      ,pe.numeropedido
                      ,pe.dataemissao
                      ,pe.valorapagar vlr_pedido_Favorita
                from roman.notasvendas nv
                   , favorita.pedidos  pe
                   , filiais           fi
                where nv.idnotavenda         = pe.idnotavenda(+)
                  and nv.idfilial            = fi.idfilial
                  and nv.perccomissao        = 40
                  and nv.idsituacaonotavenda in (3,4)
                  and nv.valortotalvenda     > 0
                  and pe.datacancelamento    is null
                  and fi.ididioma         = :P699_PAIS
                  and nv.idrepresentante  = :P699_DISTRIBUIDOR
                  and nv.idsemanacobranca BETWEEN :P699_IDSEMANA_INICIO and :P699_IDSEMANA_FIM
                  and nv.idfilial         = :P699_FRANQUIA
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }
        download {
            csvExportEnabled: true
        }

        column DATAEMISSAO (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Data Pedido
                alignment: center
            }
            layout {
                sequence: 9
                columnAlignment: center
            }
        )

        column DISTRIBUIDOR (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column IDNOTAVENDA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column IDVENDEDORA (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
        )

        column NUMERONOTA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: N° Nota
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
        )

        column NUMEROPEDIDO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: N° Pedido
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
        )

        column SEMANACOBRANCA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column VALORTOTALVENDA (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Valor Nota
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column VENDEDORA (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Vendedora
                alignment: center
            }
            layout {
                sequence: 6
            }
        )

        column VLR_PEDIDO_FAVORITA (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Vlr Pedido Favorita
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

    )

    pageItem P699_DISTRIBUIDOR (
        type: hidden
        layout {
            sequence: 20
            region: @análise-por-vendedora
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P699_FRANQUIA (
        type: hidden
        layout {
            sequence: 50
            region: @análise-por-vendedora
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P699_IDSEMANA_FIM (
        type: hidden
        layout {
            sequence: 40
            region: @análise-por-vendedora
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P699_IDSEMANA_INICIO (
        type: hidden
        layout {
            sequence: 30
            region: @análise-por-vendedora
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P699_PAIS (
        type: hidden
        layout {
            sequence: 10
            region: @análise-por-vendedora
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

