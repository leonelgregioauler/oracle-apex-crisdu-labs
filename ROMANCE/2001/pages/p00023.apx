page 23 (
    name: Lista de Defeitos
    title: Lista de Defeitos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region defeitos (
        name: Defeitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "IDDEFEITO", 
                "DESCRICAO",
                decode("ORIGEMDEFEITO",'R','Distribuidor','F','Fornecedor') origemdefeito,
                decode("APARECER",'S','Sim','N','Não') aparecer
                from "#OWNER#"."DEFEITOS" 
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 24
                items: {
                    P24_IDDEFEITO: #IDDEFEITO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Não há defeitos cadastrados.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column APARECER (
            type: plainText
            heading {
                heading: Aparecer
                alignment: center
            }
            layout {
                sequence: 22
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: DESCRICAO
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDDEFEITO (
            type: hidden
            heading {
                heading: Iddefeito
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDDEFEITO
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column ORIGEMDEFEITO (
            type: plainText
            heading {
                heading: Origem Defeito
                alignment: center
            }
            layout {
                sequence: 12
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        savedReport 59179 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn APARECER (
                sequence: 3
            )

            displayColumn DESCRICAO (
                sequence: 1
            )

            displayColumn ORIGEMDEFEITO (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo
        layout {
            sequence: 30
            region: @defeitos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 24
                clearCache: 24
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

