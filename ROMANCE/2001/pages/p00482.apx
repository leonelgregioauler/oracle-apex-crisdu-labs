page 482 (
    name: Fotos de Comprovantes de Depósitos
    title: Fotos de Comprovantes de Depósitos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region fotos-de-tiradas (
        name: Fotos de Tiradas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idleituraocr_deposito
                     , d.dataleitura
                     , d.datadeposito
                     , idrepresentante 
                     , pck_romance.fnc_nomerepresentante(idrepresentante) representante
                     , '<iframe class="img" width=500px; height=655px; src="/apex/f?p=2001:472:&APP_SESSION.::NO:RP:P472_ARQUIVO:'||d.nomearquivo||'"></iframe>' foto
                     , d.banco
                     , 'Agencia: '||d.agenca||' Conta: '||d.conta conta
                     , d.beneficiario
                     , d.valor
                     , d.nroidentificacao  
                     , case 
                         when d.iddepositodiario is null then
                           'Pendente de Revisão'
                         when d.iddepositodiario is not null then
                           'Revisado'
                        end revisado
                     , d.usuariorevisao       
                     , d.datarevisao
                     , nroidentificacao_digitado
                     , valor_digitado        
                from depositosdiarios_leituraocr D
                where trunc(d.dataleitura) between to_date(:P482_DATAINICIO) and to_date(:P482_DATAFIM) 
                  and (( :P482_IDREPRESENTANTE is null and d.idfilial = :P0_idfilial)
                     or d.idrepresentante = :P482_IDREPRESENTANTE )
                  and ( :P482_REVISADO = 'A'
                     or ( :P482_REVISADO = 'S' and d.iddepositodiario is not null )
                     or ( :P482_REVISADO = 'N' and d.iddepositodiario is null ) )
                order by 1 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1544168337539594540
        }

