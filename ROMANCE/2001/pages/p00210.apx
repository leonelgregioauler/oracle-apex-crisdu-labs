page 210 (
    name: Estoque Reservado
    title: Estoque Reservado
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region estoque-reservado (
        name: Estoque Reservado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Transferencia' tipo
                     , pck_romance.fnc_nomefilial(idfilialdestino)||'('||n.documento||')' Destino
                     , nvl(i.qtd_pp,0) qtd_pp
                     , nvl(i.qtd_p,0)   qtd_p
                     , nvl(i.qtd_m,0)   qtd_m
                     , nvl(i.qtd_g,0)   qtd_g
                     , nvl(i.qtd_gg,0)  qtd_gg
                     , nvl(i.qtd_egg,0) qtd_egg
                     , nvl(i.qtd_exgg,0) qtd_exgg
                     , nvl(i.qtd_u,0) qtd_u
                     , pck_romance.fnc_nomeproduto(i.idproduto) produto
                from itemnf i
                  , notasfiscais n
                where n.idnotafiscal = i.idnotafiscal
                  and n.situacaofilial = 'A'
                  and n.tiponota = 'T'
                  and n.idfilialemitente = :P0_IDFILIAL
                  and i.idproduto in ( select idproduto
                                       from estoquefilial e
                                       where e.idestoquefilial = :P210_IDESTOQUEFIL)
                union        
                select 'Carga '||cc.idcargarepresentante||' - '||i.iditemcargarepres
                     , pck_romance.fnc_nomerepresentante(idrepresentante)||'('||cc.semana||', '||decode(cc.situacao,1,'Aberta'
                                                                                                                   ,2,'Aguardando Conclusão'
                                                                                                                   ,3,'Concluida'
                                                                                                                     , 'Cancelado' )||')'  
                     , i.qtd_dist_pp
                     , i.qtd_dist_p
                     , i.qtd_dist_m
                     , i.qtd_dist_g
                     , i.qtd_dist_gg
                     , i.qtd_dist_egg
                     , i.qtd_dist_exgg
                     , i.qtd_dist_u
                     , pck_romance.fnc_nomeproduto(i.idproduto) produto
                from itenscargarepresentante i
                  , cargasrepresentantes cc
                where i.idestoquefil         = :P210_IDESTOQUEFIL
                  and i.idcargarepresentante = cc.idcargarepresentante
                  and cc.situacao            in (1, 2)           
                  AND cc.idfilial = :P0_IDFILIAL
                  and i.cargaamais = 'N'
                  and i.estoquemovto = 'D'
                and ( i.qtd_dist_pp is not null
                     or i.qtd_dist_p is not null
                     or i.qtd_dist_m is not null
                     or i.qtd_dist_g is not null
                     or i.qtd_dist_gg is not null
                     or i.qtd_dist_egg is not null
                     or i.qtd_dist_exgg is not null
                     or i.qtd_dist_u is not null )
                union
                select 'Venda Direta' tipo
                     , ( select initcap(nomepessoa)
                         from pessoas p 
                            , funcionarios f
                         where p.idpessoa = f.idpessoa
                           and f.idfuncionario = v.idfuncionario )||' - '||v.semana funcionario
                     , nvl(i.qtd_pp,0) qtd_pp
                     , nvl(i.qtd_p,0)   qtd_p
                     , nvl(i.qtd_m,0)   qtd_m
                     , nvl(i.qtd_g,0)   qtd_g
                     , nvl(i.qtd_gg,0)  qtd_gg
                     , nvl(i.qtd_egg,0) qtd_egg
                     , nvl(i.qtd_exgg,0) qtd_exgg
                     , nvl(i.qtd_u,0) qtd_u
                     , pck_romance.fnc_nomeproduto(i.idproduto) produto
                from itensvendadireta i
                  , vendasdiretas v
                where i.idvendadireta = v.idvendadireta
                  and v.idsituacao in (1,2)
                  and v.idfilial = :P0_IDFILIAL
                  and i.idestoquefil = :P210_IDESTOQUEFIL
                order by 1, 2
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Não há movimentação deste produto
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1615962119525699667
        }

