page 254 (
    name: Negociações da Cobrança
    title: Negociações da Cobrança
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region negociações-da-cobrança (
        name: Negociações da Cobrança
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P254_CPF (
        type: hidden
        layout {
            sequence: 60
            region: @negociações-da-cobrança
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P254_DATAINCLUSAO (
        type: hidden
        layout {
            sequence: 40
            region: @negociações-da-cobrança
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATAINCLUSAO
            used: always
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P254_DESCRICAO (
        type: textarea
        label {
            label: Descrição
            alignment: left
        }
        layout {
            sequence: 20
            region: @negociações-da-cobrança
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 6
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P254_IDNEGOCIACAOCOBRANCA (
        type: hidden
        layout {
            sequence: 10
            region: @negociações-da-cobrança
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDNEGOCIACAOCOBRANCA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P254_IDPESSOA (
        type: hidden
        layout {
            sequence: 30
            region: @negociações-da-cobrança
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPESSOA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P254_USUARIO (
        type: hidden
        layout {
            sequence: 50
            region: @negociações-da-cobrança
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: expression
            plsqlExpression: v('APP_USER')
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 280
                items: {
                    P280_IDPESSOA: &P254_IDPESSOA.
                    P280_CPF: &P254_CPF.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P254_IDNEGOCIACAOCOBRANCA
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 38605910355670496
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process fetch-row-from-negociacoescobranca (
        name: Fetch Row from NEGOCIACOESCOBRANCA
        type: autoRowFetch
        source {
            tableName: NEGOCIACOESCOBRANCA
            pkColumn: IDNEGOCIACAOCOBRANCA
            pkItem: P254_IDNEGOCIACAOCOBRANCA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 38604329559670495
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P254_IDNEGOCIACAOCOBRANCA is null then
                        select "#OWNER#"."SEQ_IDNEGOCIACAOCOBRANCA".nextval
                          into :P254_IDNEGOCIACAOCOBRANCA
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 38604755421670495
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-negociacoescobranca (
        name: Process Row of NEGOCIACOESCOBRANCA
        type: autoRowProcessing
        target {
            tableName: NEGOCIACOESCOBRANCA
            pkColumn: IDNEGOCIACAOCOBRANCA
            pkItem: P254_IDNEGOCIACAOCOBRANCA
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 38605193520670495
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 38605557261670495
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 280
                items: {
                    P280_CPF: &P254_CPF.
                }
                action: resetPagination
            }
        }
    )

)

