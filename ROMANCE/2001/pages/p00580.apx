page 580 (
    name: Históricos do Balanço
    title: Históricos do Balanço
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region histórico (
        name: Histórico
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P580_DATA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @histórico
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P580_IDHISTORICOBALANCO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @histórico
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P580_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @histórico
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P580_IDSEMANABALANCO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @histórico
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select idsemanabalanco
                from representantes r
                where r.idrepresentante = :P580_IDREPRESENTANTE;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P580_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @histórico
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P580_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 60
            region: @histórico
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
            height: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P580_USUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @histórico
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: v('APP_USER')
        }
        security {
            encryptSessionState: false
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 40
            region: @histórico
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P580_IDHISTORICOBALANCO
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 20
            region: @histórico
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P580_IDHISTORICOBALANCO is not null and :P580_USUARIO = v('APP_USER')
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @histórico
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 10
            region: @histórico
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P580_IDHISTORICOBALANCO is not null and :P580_USUARIO = v('APP_USER')
        }
    )

    process consulta-em-históricos-do-balanço (
        name: Consulta em Históricos do Balanço
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdata date;
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_HISTORICOSBALANCOS( PIDHISTORICOBALANCO => :P580_IDHISTORICOBALANCO,
                                                            PIDREPRESENTANTE => :P580_IDREPRESENTANTE,
                                                            PIDSEMANABALANCO => :P580_IDSEMANABALANCO,
                                                            PDATA => vdata,
                                                            PUSUARIO => :P580_USUARIO,
                                                            POBSERVACAO => :P580_OBSERVACAO,
                                                            PMD5 => :P580_MD5,
                                                            POPERACAO_DML => 'S');
                  --
                  :P580_DATA := to_date(vdata,'DD/MM/RRRR HH24:MI:SS');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 67017461377041838
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P580_IDHISTORICOBALANCO
        }
    )

    process processo-dml-em-históricos-de-balanços (
        name: Processo DML em Históricos de Balanços
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdata date;
                  vusuario varchar2(50) := v('APP_USER');
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  PCK_CADASTROS_RMC.PRC_HISTORICOSBALANCOS( PIDHISTORICOBALANCO => :P580_IDHISTORICOBALANCO,
                                                            PIDREPRESENTANTE => :P580_IDREPRESENTANTE,
                                                            PIDSEMANABALANCO => :P580_IDSEMANABALANCO,
                                                            PDATA => :P580_DATA,
                                                            PUSUARIO => vusuario,
                                                            POBSERVACAO => :P580_OBSERVACAO,
                                                            PMD5 => :P580_MD5,
                                                            POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 69003152914494748
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('DELETAR','SALVAR','CRIAR')
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 580
                items: {
                    P580_IDHISTORICOBALANCO: &P580_IDHISTORICOBALANCO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('SALVAR','CRIAR','DELETAR')
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 554
                items: {
                    P554_IDREPRESENTANTE: &P580_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
    )

)

