    process libera-proxima-semana (
        name: libera proxima semana
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- 
                  :P2_IDFILIAL       := pck_romance.fnc_filialrepresentante(:P2_IDREPRESENTANTE);
                  :P2_IDGERENTE      := pck_romance.fnc_gerenterepresentante(:P2_IDREPRESENTANTE);
                  :P2_SEMANACOBRANCA := pck_romance_2.fnc_proximasemana(:P2_SEMANACOBRANCA);
                  --
                  select idregiaovenda 
                  into :P2_IDREGIAOVENDA
                  from regioesrepresentantes r
                  where r.idrepresentante = :P2_IDREPRESENTANTE
                    and r.semana          = :P2_SEMANACOBRANCA;
                  --
                  insert into LIBERACOESSEMANAIS
                  values (seq_idliberacoessemanais.nextval , :P183_SEMANALIBERAR , 'S', v('APP_USER'), :P183_IDREPRESENTANTE  );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Próxima semana liberada.
        }
        error {
            errorMessage: A próxima semana já foi liberada para este representante.
        }
        advanced {
            executionMappingIdentifier: 127390862889839403
        }
        serverSideCondition {
            type: request=Value
            value: LIBERAR
        }
    )

)

