    pageItem P183_IDREPRESENTANTEFILTRO_N (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select PCK_ROMANCE.fnc_nomepessoa(idpessoa) display_value
                    , r.idrepresentante return_value
                from representantes r
                where pck_romance.fnc_filialgerente(idgerente) = :P0_IDFILIAL
                and (:P0_IDPOSTOAVANCADO is null or  r.idpostoavancado = :P0_IDPOSTOAVANCADO )
                and r.ativo = 'S'
                UNION
                SELECT ' - TODOS - '
                     , -1
                FROM DUAL
                order by 1
                ```
            nullDisplayValue: "- Selecione um Distribuidor - "
        }
        layout {
            sequence: 20
            region: @acertos-distribuidores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

