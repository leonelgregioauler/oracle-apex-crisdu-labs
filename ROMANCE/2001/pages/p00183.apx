    region distribuidores-que-não-possuem-acerto-na-semana-atual (
        name: Distribuidores que não possuem ACERTO na semana atual.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(1)
                     , listagg(pck_romance.fnc_nomerepresentante(r.idrepresentante),',') within group ( order by 1 ) Empreendedores
                from representantes r
                where r.ativo = 'S'
                  and r.idgerente = (select idgerente
                                     from gerentes
                                     where idfilial = :P0_IDFILIAL)
                  and not exists (select 1
                                  from fechamentorepresentantes f
                                  where f.idfilial = :P0_IDFILIAL
                                    and f.idrepresentante = r.idrepresentante
                                    and f.semana = (select pck_util.fnc_semanaid(max(idsemana))
                                                    from fechamentossemanais f
                                                    where f.idfilial = :P0_IDFILIAL))
                  and r.idpessoa != (select idpessoa
                                     from gerentes
                                     where idgerente = r.idgerente)
                ```
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select count(1)
                from representantes r
                where r.ativo = 'S'
                  and r.idgerente = (select idgerente
                                     from gerentes
                                     where idfilial = :P0_IDFILIAL)
                  and not exists (select 1
                                  from fechamentorepresentantes f
                                  where f.idfilial = :P0_IDFILIAL
                                    and f.idrepresentante = r.idrepresentante
                                    and f.semana = (select pck_util.fnc_semanaid(max(idsemana))
                                                    from fechamentossemanais f
                                                    where f.idfilial = :P0_IDFILIAL)) 
                having count(1) > 1
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }

        column "COUNT(1)" (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Qtds.
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

