page 183 (
    name: Acertos Pendentes
    title: Acertos Pendentes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_liberasemana(IDREPRESENTANTE,SEMANA)
            {
            javascript:window.open('?p=&APP_ID.:550:&SESSION.::NO:550:P550_IDREPRESENTANTE,P550_SEMANACOBRANCA,P550_PROCESSAR:'+IDREPRESENTANTE+','+SEMANA+',S'
            ,'popup'+IDREPRESENTANTE,'toolbar=no,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width=800,height=400,screenX=100,screenY =100');void(0);
            }
            
            function listanotas(pidrepres,pidsemana) 
            {
            javascript:window.open('f?p=&APP_ID.:165:&SESSION.::NO:165:P165_IDREPRESENTANTE,P165_SEMANA:'+pidrepres+','
                                                                                                         +pidsemana
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1400,height=800,screenX=50,screenY =100');void(0);
            }
            
            function listanotasnovas(pidrepres,pidsemana) 
            {
            javascript:window.open('f?p=&APP_ID.:161:&SESSION.::NO:161:P161_IDREPRESENTANTE,P161_SEMANA:'+pidrepres+','
                                                                                                         +pidsemana
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=1300,screenX=50,screenY =100');void(0);
            }
            
            function listanotasacertar(pidrepres,pidsemana) 
            {
            javascript:window.open('f?p=&APP_ID.:170:&SESSION.::NO:170:P170_IDREPRESENTANTE,P170_SEMANA:'+pidrepres+','
                                                                                                         +pidsemana
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=1300,screenX=50,screenY =100');void(0);
            }
            
            function verpgto(pidrepres,pidsemana) 
            {
            javascript:window.open('f?p=&APP_ID.:189:&SESSION.::NO:189:P189_IDREPRESENTANTE,P189_SEMANA:'+pidrepres+','
                                                                                                         +pidsemana
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1400,height=800,screenX=50,screenY =100');void(0);
            }
            
            function liberar(pidrepres,pidsemana) 
            {
              document.getElementById('P74_IDREPRESENTANTE').value = pidrepres;
              document.getElementById('P74_SEMANALIBERAR').value   = pidsemana;
              apex.submit('LIBERAR');
            }
            
            function fnc_verinformacoes(IDREPRESENTANTE)
            {
            javascript:window.open('http://webservices.romancemoda.com.br:90/executar/gerais/listar_arquivos?str={"IDREPRESENTANTE":'+IDREPRESENTANTE+',"SQL":false}'
            ,'popup2'+IDREPRESENTANTE,'toolbar=no,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width=800,height=400,screenX=100,screenY =100');void(0);
            }
            
            function Lista_de_Notas_Adicionais (pidrepres,pidsemana) 
            {
            javascript:window.open('f?p=&APP_ID.:468:&SESSION.::NO:468:P468_IDREPRESENTANTE,P468_SEMANA:'+pidrepres+','
                                                                                                         +pidsemana
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=1300,screenX=50,screenY =100');void(0);
            }
            
            function Lista_de_Notas_com_saldo_negativo (pidrepres,pidsemana) 
            {
            javascript:window.open('f?p=&APP_ID.:643:&SESSION.::NO:643:P643_IDREPRESENTANTE,P643_SEMANA:'+pidrepres+','
                                                                                                         +pidsemana
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=1300,screenX=50,screenY =100');void(0);
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region acertos-distribuidores (
        name: Acertos Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select representante "Distribuidor"
                    , semana "Semana"
                     , regiao "Região"
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:165:'||v('APP_SESSION')||'::NO::P165_IDREPRESENTANTE,P165_SEMANA:'||idrepresentante||','||semana,'SESSION')||''',''_blank''); void(0)">'||trim(to_char(nvl(cobranca,0),'999G999G999G990D00'))||'</a>' "Cobrança Notas da Semana"
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:189:'||v('APP_SESSION')||'::NO::P189_IDREPRESENTANTE,P189_SEMANA:'||idrepresentante||','||semana,'SESSION')||''',''_blank''); void(0)">'||trim(to_char(nvl(debitos,0),'999G999G999G990D00'))||'</a>'"Débitos Recebidos"
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:257:'||v('APP_SESSION')||'::NO::P257_IDREPRESENTANTE,P257_SEMANA:'||idrepresentante||','||semana,'SESSION')||''',''_blank''); void(0)">'||trim(to_char(nvl(debitooutrorepres,0),'999G999G999G990D00'))||'</a>'"Deb.Rec.Outro Rep."
                     , nvl(cobranca,0) + nvl(debitos,0) + nvl(debitooutrorepres,0) "Total Cobrança"  -- + debitooutrorepres
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:165:'||v('APP_SESSION')||'::NO::P165_IDREPRESENTANTE,P165_SEMANA,P165_IDSITUACAONOTAVENDA:'||idrepresentante||','||semana||',4','SESSION')||''',''_blank''); void(0)">'||notascobrar||'</a>' "Acertadas"
                     -- , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:165:'||v('APP_SESSION')||'::NO::P165_IDREPRESENTANTE,P165_SEMANA:'||idrepresentante||','||semana,'SESSION')||''',''_blank''); void(0)">'||notascobrar||'</a>' "Acertadas"
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:161:'||v('APP_SESSION')||'::NO::P161_IDREPRESENTANTE,P161_SEMANA:'||idrepresentante||','||semana,'SESSION')||''',''_blank''); void(0)">'||notasnovas||'</a>' "Notas Novas"
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:170:'||v('APP_SESSION')||'::NO::P170_IDREPRESENTANTE,P170_SEMANA:'||idrepresentante||','||semana,'SESSION')||''',''_blank''); void(0)">'||notascobrarproxsem||'</a>' "Próx. Sem."
                     , idrepresentante
                     , proximasemana
                     , '<font color="red">'||represatendeu ||'</font>' represatendeu
                     , decode(nvl(pck_acertosfechamento.fnc_retornaalvo(a.idrepresentante,a.idsemana,a.idregiaovenda),0), 0, 0, (((cobranca + debitos + debitooutrorepres)/(pck_acertosfechamento.fnc_retornaalvo(a.idrepresentante,a.idsemana,a.idregiaovenda)*2))*100) ) "Perc. Venda"
                     , case
                         when versao = 'v1' then
                           '<a href="javascript: fnc_verinformacoes('||idrepresentante||');"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""></a>'
                         else
                           '-'
                       end "Ver Inf."
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:576:'||v('APP_SESSION')||'::NO::P576_IDREPRESENTANTE,P576_SEMANA:'||idrepresentante||','||semana,'SESSION')||''',''_blank''); void(0)">'||qtdnotastinhamparaacertar||'</a>' "Para Atender"
                     , null "Cons. que não Continuaram"
                     , atualizarcad "Cadastros Para Atualizar"
                     , nvl(pck_acertosfechamento.fnc_retornaalvo(a.idrepresentante,a.idsemana,a.idregiaovenda),0) alvo
                     , ( select count(1)
                         from roman.correcoesnotasvendas c
                         where c.idrepresentante = a.idrepresentante
                           and c.situacao = 'P'
                           and c.idnotavenda is not null ) "Correções a Fazer"
                     , case
                         when versao = 'v1' then
                           '<a href="javascript: fnc_liberasemana('||IDREPRESENTANTE||','||Semana||');"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>'
                         else
                           ' - '
                       end "Liberar Próxima Semana"
                     -- maicon aimi - 10588803
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:322:'||v('APP_SESSION')||'::NO::P322_IDREPRESENTANTE,P322_SEMANA:'||idrepresentante||','||semana,'SESSION')||''',''_blank''); void(0)">'||nvl(deppendentes,0)||'</a>' "Débitos Pendentes"
                     --, '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:304:'||v('APP_SESSION')||'::NO::P304_IDREPRESENTANTE,P304_SEMANA:'||idrepresentante||','||semana,'SESSION')||''',''_blank''); void(0)">'||notasemaberto ||'</a>' "Notas em Aberto"
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:304:'||v('APP_SESSION')||'::NO::P304_IDREPRESENTANTE,P304_SEMANA,P304_PAGINA_ORIGEM:'||idrepresentante||','||semana||',183','SESSION')||''',''_blank''); void(0)">'||notasemaberto ||'</a>' "Notas em Aberto"
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:586:'||v('APP_SESSION')||'::NO::P586_IDREPRESENTANTE,P586_SEMANA:'||idrepresentante||','||semana,'SESSION')||''',''_blank''); void(0)">'||trim(to_char(nvl(valoroutrorepres,0),'999G999G999G990D00'))||'</a>'"Valor Rec.Outro Dist."
                     , datadados
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:468:'||v('APP_SESSION')||'::NO::P468_IDREPRESENTANTE,P468_SEMANA:'||idrepresentante||','||semana,'SESSION')||''',''_blank''); void(0)">'||totaladicionais||'</a>' "totaladicionais"
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:643:'||v('APP_SESSION')||'::NO::P643_IDREPRESENTANTE,P643_SEMANA:'||idrepresentante||','||semana,'SESSION')||''',''_blank''); void(0)">'||notascomsaldonegativo||'</a>' "notascomsaldonegativo"
                from ( select 'v1' versao
                            , pck_romance.fnc_nomerepresentante(idrepresentante) representante
                            , null datadados
                            , semana
                            , idsemana
                            , pck_romance.fnc_nomeregiaovenda(idregiaovenda)  regiao
                            , idregiaovenda
                            , ( select sum(p.valorpago)
                                from pagamentosnotasvendas p
                                where p.semanacobranca = i.semana
                                  and p.origem        not in  ('C','E')
                                  and p.idnotavenda in ( select n.idnotavenda
                                                         from notasvendas n 
                                                         where n.idrepresentante = i.idrepresentante 
                                                           and nvl(n.tiponota,'R') = 'R'
                                                           and n.idsemanacobranca  = i.idsemana ) ) 
                              + nvl((select sum(p.valorpago)
                                     from pagamentosnotasvendas p
                                     where p.semanacobranca = i.semana
                                      and p.origem        not in  ('C','E')
                                       and p.idnotavenda in ( select n.idnotavenda
                                                              from notasvendas n
                                                              where n.idrepresentanteatende =  i.idrepresentante
                                                                and n.idsemanacobranca  = idsemana 
                                                                and nvl(n.tiponota,'R') = 'R'
                                                                and exists ( select 1
                                                                            from representantes r
                                                                            where r.idrepresentante = n.idrepresentante
                                                                              and r.ativo = 'N'
                                                                              and r.semanaparou  < pck_util.fnc_idsemana(psemana => i.semana)) ) ),0)  cobranca
                            , nvl(( select sum(p.valorpago)
                                    from pagamentosnotasvendas p
                                    where p.semanacobranca =  i.semana
                                      and p.origem        = 'R'
                                      and p.idnotavenda in ( select n.idnotavenda
                                                             from notasvendas n 
                                                             where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                                               and n.idsemanacobranca != i.idsemana ) ),0) debitos
                            , ( select count(1)
                                from notasvendas n 
                                where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                  and n.idsemanacobranca  = i.idsemana
                                 and nvl(n.tiponota,'R') = 'R' ) notascobrar
                            , ( select count(1)
                                from notasvendas n 
                                where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                  and n.semanadistribuicao = i.semana 
                                  and exists ( select 1
                                               from itensnotavenda it
                                               where it.idnotavenda = n.idnotavenda ) ) notasnovas
                            , idrepresentante
                            , ( select count(1)
                                from notasvendas n 
                                where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                  and n.semanacobranca  = pck_romance.fnc_proximasemana(i.semana) ) notascobrarproxsem
                            , pck_romance.fnc_proximasemana(i.semana) proximasemana
                            , nvl(( select sum(p.valorpago)
                                    from pagamentosnotasvendas p
                                    where p.semanacobranca =  i.semana
                                      and p.origem       = 'R'
                                      and p.idnotavenda in ( select n.idnotavenda
                                                             from notasvendas n 
                                                             where n.idrepresentanteatende = i.idrepresentante 
                                                               and n.idsemanacobranca != i.idsemana ) ),0) debitooutrorepres
                           , ( select listagg(pck_romance.fnc_nomerepresentante(idrepresentanteatende),' ') within group ( order by 1 )
                               from notasvendas n
                               where n.idsemanacobranca  = i.idsemana
                                 and n.idrepresentante = i.idrepresentante) represatendeu
                           , ( select count(1)
                               from notasvendas nv
                               where nv.idrepresentante      = i.idrepresentante
                                 and nv.semanacobrancaorig   = i.semana
                                 and nv.idsituacaonotavenda  != 5 ) qtdnotastinhamparaacertar
                           , ( select count(1)
                               from preatualizacaocadastro p
                               where p.idrepresentante = i.idrepresentante
                                 and p.semana = i.semana
                                 and p.situacao = 'P' ) atualizarcad
                -- 10588803 - Maicon Aimi
                ,(select nvl(sum(aux.saldo),0)
                   from (select valor - NVL(( select SUM(PP.VALOR)
                                                from roman.pepinosrepresentantes pp
                                               where pp.nrpedido = p.nrpedido
                                                 and pp.idfilial = p.idfilial
                                                 and pp.idrepresentante= p.idrepresentante
                                                 and pp.situacao in ('D','P')),0) saldo
                           from roman.pepinosrepresentantes p
                          where p.situacao        = 'N'
                            and p.idnotavenda     is null
                            and p.semana          = i.semana
                            and p.idrepresentante = i.idrepresentante
                          union 
                         select n.saldo  saldo
                           from roman.notasvendas n
                          where n.idsituacaonotavenda = 4
                            and n.semanacobranca      = i.semana
                            and n.idrepresentante     = i.idrepresentante) aux ) as deppendentes
                           , ( select count(1)
                               from notasvendas nv
                               where nv.idrepresentante      = i.idrepresentante
                                 and nv.idsituacaonotavenda  = 3
                                 and nv.idsemanacobranca     = i.idsemana+1
                                 and nv.idsemanacobranca - nv.idsemanadistribuicao >= 7 ) notasemaberto
                           , nvl(( select sum(p.valorpago)
                                   from pagamentosnotasvendas p
                                   where p.semanacobranca =  i.semana
                                     and p.origem       = 'R'
                                     and p.idnotavenda in ( select n.idnotavenda
                                                            from notasvendas n 
                                                             where n.idrepresentanteatende = i.idrepresentante 
                                                               and n.idsemanacobranca      = i.idsemana ) ),0) valoroutrorepres
                           , (select count (na.idnotaadicional)
                                from roman.notasadicionais na
                               where na.idrepresentante = i.idrepresentante
                                 and na.semana = i.semana) totaladicionais
                           , (select count(1)
                                from notasvendas nv
                                where nv.idrepresentante = i.idrepresentante
                                and nv.saldo < -1
                                and nv.idsituacaonotavenda = 4
                                  and ( nv.semanacobranca = i.semana
                                     or exists ( select 1
                                                 from pagamentosnotasvendas pg
                                                 where pg.idnotavenda = nv.idnotavenda
                                                   and pg.semanacobranca = i.semana
                                                   and pg.origem = 'R' ) ) ) notascomsaldonegativo
                      from impnettoservidor i
                      where i.idfilial = :P0_IDFILIAL 
                        and (:P183_IDREPRESENTANTEFILTRO_N  = -1 or i.idrepresentante = :P183_IDREPRESENTANTEFILTRO_N)
                        and (:P0_IDPOSTOAVANCADO is null or exists ( select 1  
                                                                     from representantes r
                                                                     where r.idrepresentante = i.idrepresentante
                                                                       and r.idpostoavancado = :P0_IDPOSTOAVANCADO ) )
                        and i.idsemana >= 615
                        --and i.idrepresentanteatende is null
                        and exists ( select 1
                                     from fechamentorepresentantes f
                                        , fechamentossemanais ff
                                     where f.idfechamentopontuacao = ff.idfechamento
                                       and f.idrepresentante       = i.idrepresentante 
                                       and ff.semana               = i.semana
                                       and ff.concluido            = 'N' ) 
                      union
                      select 'v1' versao
                           , pck_romance.fnc_nomerepresentante(idrepresentante) representante
                           , null
                           , semana
                           , idsemana
                           , ( select pck_romance.fnc_nomeregiaovenda(idregiaovenda)
                               from regioesrepresentantes rr
                               where  ( rr.idrepresentante = i.idrepresentante )
                                 and--( 
                                    rr.semana          = i.semana
                                   --or rr.semana          = pck_romance.fnc_semanacobranca(i.semana) )
                                   ) regiao
                           , ( select idregiaovenda
                               from regioesrepresentantes rr
                               where  ( rr.idrepresentante = i.idrepresentante )
                                 and--(
                                     rr.semana          = i.semana
                                   --or rr.semana          = pck_romance.fnc_semanacobranca(i.semana) )
                                   ) idregiaovenda
                           , ( select sum(p.valorpago)
                               from pagamentosnotasvendas p
                               where p.semanacobranca = i.semana
                                 and p.origem        not in  ('C','E')
                                 and p.idnotavenda in ( select n.idnotavenda
                                                        from notasvendas n 
                                                        where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                                          and n.idsemanacobranca  = i.idsemana ) ) 
                             + nvl((select sum(p.valorpago)
                                    from pagamentosnotasvendas p
                                    where p.semanacobranca = i.semana
                                     and p.origem        not in  ('C','E')
                                      and p.idnotavenda in ( select n.idnotavenda
                                                             from notasvendas n
                                                             where n.idrepresentanteatende =  i.idrepresentante
                                                               and n.idsemanacobranca  = idsemana 
                                                               and exists ( select 1
                                                                            from representantes r
                                                                            where r.idrepresentante = n.idrepresentante
                                                                              and r.ativo = 'N'
                                                                              and r.semanaparou  < pck_util.fnc_idsemana(psemana => i.semana)) ) ),0)  cobranca
                           , nvl(( select sum(p.valorpago)
                                   from pagamentosnotasvendas p
                                   where p.semanacobranca =  i.semana
                                 and p.origem        = 'R'
                                     and p.idnotavenda in ( select n.idnotavenda
                                                            from notasvendas n 
                                                            where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                                              and n.idsemanacobranca != i.idsemana ) ),0) debitos
                           , ( select count(1)
                               from notasvendas n 
                               where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                 and n.idsemanacobranca  = i.idsemana
                                 and nvl(n.tiponota,'R') = 'R' ) notascobrar
                           , ( select count(1)
                               from notasvendas n 
                               where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                 and n.semanadistribuicao = i.semana
                                 and exists ( select 1
                                              from itensnotavenda it
                                              where it.idnotavenda = n.idnotavenda ) ) notasnovas
                           , idrepresentante
                           , ( select count(1)
                               from notasvendas n 
                               where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                 and n.semanacobranca  = pck_romance.fnc_proximasemana(i.semana) ) notascobrarproxsem
                           , pck_romance.fnc_proximasemana(i.semana) proximasemana
                           , nvl(( select sum(p.valorpago)
                                   from pagamentosnotasvendas p
                                   where p.semanacobranca =  i.semana
                                     and p.origem       = 'R'
                                     and p.idnotavenda in ( select n.idnotavenda
                                                            from notasvendas n 
                                                             where n.idrepresentanteatende = i.idrepresentante 
                                                               and n.idsemanacobranca != i.idsemana
                                                               and exists ( select 1
                                                                            from representantes r
                                                                            where r.idrepresentante = n.idrepresentante
                                                                              and r.ativo           = 'N') ) ),0) debitooutrorepres
                           , ( select listagg(pck_romance.fnc_nomerepresentante(idrepresentanteatende),' ') within group ( order by 1 )
                               from notasvendas n
                               where n.idsemanacobranca  = i.idsemana
                                 and n.idrepresentante = i.idrepresentante) represatendeu
                           , ( select count(1)
                               from notasvendas nv
                               where nv.idrepresentante      = i.idrepresentante
                                 and nv.semanacobrancaorig   = i.semana
                                 and nv.idsituacaonotavenda  != 5 ) qtdnotastinhamparaacertar
                           , ( select count(1)
                               from preatualizacaocadastro p
                               where p.idrepresentante = i.idrepresentante
                                 and p.semana = i.semana
                                 and p.situacao = 'P' ) atualizarcad
                -- 10588803 - Maicon Aimi
                ,(select nvl(sum(aux.saldo),0)
                   from (select valor - NVL(( select SUM(PP.VALOR)
                                                from roman.pepinosrepresentantes pp
                                               where pp.nrpedido = p.nrpedido
                                                 and pp.idfilial = p.idfilial
                                                 and pp.idrepresentante= p.idrepresentante
                                                 and pp.situacao in ('D','P')),0) saldo
                           from roman.pepinosrepresentantes p
                          where p.situacao        = 'N'
                            and p.idnotavenda     is null
                            and p.semana          = i.semana
                            and p.idrepresentante = i.idrepresentante
                          union 
                         select n.saldo  saldo
                           from roman.notasvendas n
                          where n.idsituacaonotavenda = 4
                            and n.semanacobranca      = i.semana
                            and n.idrepresentante     = i.idrepresentante) aux ) as deppendentes
                           , ( select count(1)
                               from notasvendas nv
                               where nv.idrepresentante      = i.idrepresentante
                                 and nv.idsituacaonotavenda  = 3
                                 and nv.idsemanacobranca     = i.idsemana + 1
                                 and nv.idsemanacobranca - nv.idsemanadistribuicao >= 7 ) notasemaberto
                           , nvl(( select sum(p.valorpago)
                                   from pagamentosnotasvendas p
                                   where p.semanacobranca =  i.semana
                                     and p.origem       = 'R'
                                     and p.idnotavenda in ( select n.idnotavenda
                                                            from notasvendas n 
                                                             where n.idrepresentanteatende = i.idrepresentante 
                                                               and n.idsemanacobranca      = i.idsemana ) ),0) valoroutrorepres
                           , (select count (na.idnotaadicional)
                              from roman.notasadicionais na
                              where na.idrepresentante = i.idrepresentante
                                and na.semana = i.semana) totaladicionais
                           , (select count(1)
                                from notasvendas nv
                                where nv.idrepresentante = i.idrepresentante
                                and nv.saldo < -1
                                and nv.idsituacaonotavenda = 4
                                  and ( nv.semanacobranca = i.semana
                                     or exists ( select 1
                                                 from pagamentosnotasvendas pg
                                                 where pg.idnotavenda = nv.idnotavenda
                                                   and pg.semanacobranca = i.semana
                                                   and pg.origem = 'R' ) ) ) notascomsaldonegativo
                      from impnettoservidor i
                      where i.idfilial = :P0_IDFILIAL 
                        and (:P183_IDREPRESENTANTEFILTRO_N  = -1 or i.idrepresentante = :P183_IDREPRESENTANTEFILTRO_N)
                        --and i.idrepresentanteatende is null
                        and (:P0_IDPOSTOAVANCADO is null or exists ( select 1  
                                                                     from representantes r
                                                                     where r.idrepresentante = i.idrepresentante
                                                                       and r.idpostoavancado = :P0_IDPOSTOAVANCADO ) )
                        and i.idsemana >= 615
                        and not exists ( select 1
                                         from fechamentorepresentantes f
                                            , fechamentossemanais ff
                                         where f.idfechamentopontuacao = ff.idfechamento
                                           and f.idrepresentante       = i.idrepresentante 
                                           and ff.semana               = i.semana)
                      union
                      select 'v2' versao
                           , pck_romance.fnc_nomerepresentante(idrepresentante) representante
                           , ( select max(d.dataenvio)
                               from dadosenviadossync d
                               where d.idrepresentante = i.idrepresentante
                                 and d.idsemana        = i.idsemana ) datadados
                           , semana
                           , idsemana
                           , pck_romance.fnc_nomeregiaovenda(idregiaovenda) regiao
                           , idregiaovenda
                           , ( select sum(p.valorpago)
                               from pagamentosnotasvendas p
                               where p.semanacobranca = i.semana
                                 and p.origem         = 'R'
                                 and p.idnotavenda in ( select n.idnotavenda
                                                        from notasvendas n 
                                                        where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                                          and nvl(n.tiponota,'R') = 'R'
                                                          and n.idsemanacobranca  = i.idsemana ) ) 
                             + nvl((select sum(p.valorpago)
                                    from pagamentosnotasvendas p
                                    where p.semanacobranca = i.semana
                                      and p.origem         = 'R'
                                      and p.idnotavenda in ( select n.idnotavenda
                                                             from notasvendas n
                                                             where n.idrepresentanteatende =  i.idrepresentante
                                                               and n.idsemanacobranca  = idsemana 
                                                               and nvl(n.tiponota,'R') = 'R'
                                                               and exists ( select 1
                                                                            from representantes r
                                                                            where r.idrepresentante = n.idrepresentante
                                                                              and r.ativo = 'N'
                                                                              and r.semanaparou  < pck_util.fnc_idsemana(psemana => i.semana)) ) ),0)  cobranca
                           , nvl(( select sum(p.valorpago)
                                   from pagamentosnotasvendas p
                                   where p.semanacobranca =  i.semana
                                     and p.origem        = 'R'
                                     and p.idnotavenda in ( select n.idnotavenda
                                                            from notasvendas n 
                                                            where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                                              and n.idsemanacobranca != i.idsemana ) ),0) debitos
                           , ( select count(1)
                               from notasvendas n 
                               where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                 and n.idsemanacobranca  = i.idsemana
                                 and n.idsituacaonotavenda = 4
                                 and nvl(n.tiponota,'R') = 'R' ) notascobrar
                           , ( select count(1)
                               from notasvendas n 
                               where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                 and n.semanadistribuicao = i.semana
                                 and exists ( select 1
                                              from itensnotavenda it
                                              where it.idnotavenda = n.idnotavenda ) ) notasnovas
                           , idrepresentante
                           , ( select count(1)
                               from notasvendas n 
                               where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                 and n.semanacobranca  = pck_romance.fnc_proximasemana(i.semana) ) notascobrarproxsem
                           , pck_romance.fnc_proximasemana(i.semana) proximasemana
                           , nvl(( select sum(p.valorpago)
                                   from pagamentosnotasvendas p
                                   where p.semanacobranca =  i.semana
                                     and p.origem       = 'R'
                                     and p.idnotavenda in ( select n.idnotavenda
                                                            from notasvendas n 
                                                             where n.idrepresentanteatende = i.idrepresentante 
                                                               and n.idsemanacobranca != i.idsemana
                                                               and exists ( select 1
                                                                            from representantes r
                                                                            where r.idrepresentante = n.idrepresentante
                                                                              and r.ativo           = 'N') ) ),0) debitooutrorepres
                           , ( select listagg(pck_romance.fnc_nomerepresentante(idrepresentanteatende),' ') within group ( order by 1 )
                               from notasvendas n
                               where n.idsemanacobranca  = i.idsemana
                                 and n.idrepresentante = i.idrepresentante) represatendeu
                           , ( select count(1)
                               from notasvendas nv
                               where nv.idrepresentante      = i.idrepresentante
                                 and nv.semanacobrancaorig   = i.semana
                                 and nv.idsituacaonotavenda  != 5 ) qtdnotastinhamparaacertar
                           , ( select count(1)
                               from preatualizacaocadastro p
                               where p.idrepresentante = i.idrepresentante
                                 and p.semana = i.semana
                                 and p.situacao = 'P' ) atualizarcad
                -- 10588803 - Maicon Aimi
                ,(select nvl(sum(aux.saldo),0)
                   from (select valor - NVL(( select SUM(PP.VALOR)
                                                from roman.pepinosrepresentantes pp
                                               where pp.nrpedido = p.nrpedido
                                                 and pp.idfilial = p.idfilial
                                                 and pp.idrepresentante= p.idrepresentante
                                                 and pp.situacao in ('D','P')),0) saldo
                           from roman.pepinosrepresentantes p
                          where p.situacao        = 'N'
                            and p.idnotavenda     is null
                            and p.semana          = i.semana
                            and p.idrepresentante = i.idrepresentante
                          union 
                         select n.saldo  saldo
                           from roman.notasvendas n
                          where n.idsituacaonotavenda = 4
                            and n.semanacobranca      = i.semana
                            and n.idrepresentante     = i.idrepresentante) aux ) as deppendentes
                           , ( select count(1)
                               from notasvendas nv
                               where nv.idrepresentante      = i.idrepresentante
                                 and nv.idsituacaonotavenda  = 3
                                 and nv.idsemanacobranca     = i.idsemana ) notasemaberto
                           , nvl(( select sum(p.valorpago)
                                   from pagamentosnotasvendas p
                                   where p.semanacobranca =  i.semana
                                     and p.origem       = 'R'
                                     and p.idnotavenda in ( select n.idnotavenda
                                                            from notasvendas n 
                                                             where n.idrepresentanteatende = i.idrepresentante 
                                                               and n.idsemanacobranca      = i.idsemana ) ),0) valoroutrorepres
                          , (select count (na.idnotaadicional)
                              from roman.notasadicionais na
                              where na.idrepresentante = i.idrepresentante
                                and na.semana = i.semana) totaladicionais
                          , (select count(1)
                             from roman.notasvendas nv
                             where nv.idrepresentante = i.idrepresentante
                               and nv.saldo < -1
                               and nv.idsituacaonotavenda = 4
                             /*and exists ( select 1
                                            from classificacoesnotasvendas cf
                                            where cf.idnotavenda = nv.idnotavenda
                                              and cf.idcaracteristicanotavenda = 47 )*/
                               and ( nv.semanacobranca = i.semana
                                  or exists ( select 1
                                              from pagamentosnotasvendas pg
                                              where pg.idnotavenda = nv.idnotavenda
                                                and pg.semanacobranca = i.semana
                                                and pg.origem = 'R' ) ) ) notascomsaldonegativo
                      from preacertorepresentantes i
                      where i.idfilial = :P0_IDFILIAL 
                        and (:P183_IDREPRESENTANTEFILTRO_N  = -1 or i.idrepresentante = :P183_IDREPRESENTANTEFILTRO_N)
                        and (:P0_IDPOSTOAVANCADO is null or exists ( select 1  
                                                                     from representantes r
                                                                     where r.idrepresentante = i.idrepresentante
                                                                       and r.idpostoavancado = :P0_IDPOSTOAVANCADO ) )
                        and i.idsemana >= 615
                        and not exists ( select 1
                                         from impnettoservidor imp
                                         where imp.idrepresentante = i.idrepresentante
                                           and imp.semana          = i.semana 
                                           --and imp.idrepresentanteatende is null 
                                           ) ) a
                order by a.idsemana
                       , representante
                ```
        }
