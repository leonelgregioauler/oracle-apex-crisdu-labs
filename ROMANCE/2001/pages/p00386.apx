page 386 (
    name: Logins por Equipamento
    title: Logins por Equipamento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region logins-por-equipamento-últimos-42-dias (
        name: Logins por Equipamento Últimos 42 dias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select device_name
                     , device_serial
                     , min(r.datalogin) primeirologin
                     , max(r.datalogin) ultimologin
                     , count(distinct r.idvendedora) qtd
                     , listagg(pck_romance.fnc_nomerepresentante(v.idrepresentante),' ') within group (order by 1) distribuidores
                     , listagg(pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(v.idrepresentante)),' ') within group (order by 1) empresa
                     , count(distinct r.idvendedora) ||' consultoras do(s) distribuidor(es) '||listagg( pck_romance.fnc_nomerepresentante(v.idrepresentante),' ') within group (order by 1)||' logaram no aplicativo a partir do celular/tablet '||device_name descricao
                from registrosloginminhasacola r
                   , vendedoras v
                where primeirologin = 'S'
                  and device_name is not null
                  and datalogin > sysdate - 42
                  and v.idvendedora = r.idvendedora   
                  and device_serial != 'unknown'
                  and ( :P0_IDFILIAL = -1 OR exists ( select 1
                                                      from representantes re
                                                      where re.idrepresentante = v.idrepresentante
                                                        and re.idgerente = ( select idgerente 
                                                                             from gerentes
                                                                             where idfilial =  :P0_IDFILIAL)))
                having count(distinct r.idvendedora) > 1
                group by device_name
                       , device_serial
                order by 3 desc;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <font size=5>Este relatório mostra a quantidade de consultoras que logaram pela <b>primeira vez</b> no aplicativo Minha Sacola Romance a partir de um mesmo celular ou tablet nos <font color="RED">últimos 42 dias</font>
                <BR>
                <BR>
                <font color="green"> Clique na quantidade para ver a lista das consultoras.</font>
                
                <BR>
                <BR>
                </font>
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 2748586952370134467
        }

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 15
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column DEVICE_NAME (
            type: plainText
            heading {
                heading: Device Name
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column DEVICE_SERIAL (
            type: plainText
            heading {
                heading: Device Serial
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column DISTRIBUIDORES (
            type: plainText
            heading {
                heading: Distribuidores
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column PRIMEIROLOGIN (
            type: plainText
            heading {
                heading: Primeirologin
                alignment: center
            }
            layout {
                sequence: 25
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
        )

        column QTD (
            type: link
