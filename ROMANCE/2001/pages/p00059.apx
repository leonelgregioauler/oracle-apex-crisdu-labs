page 59 (
    name: Movimentos de Estoque Cliente
    title: Movimentos de Estoque Cliente
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region movimentos-de-estoque-cliente-v (
        name: Movimentos de Estoque Cliente V
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select initcap( nvl(p.apelido,p.nomepessoa ) ) 
                         from filiais f
                            , pessoas p
                         where f.idpessoa = p.idpessoa
                           and f.idfilial = e.idfilial ) "Filial"
                     , ( select initcap( nvl(pr.apelido,pr.nomepessoa ) ) 
                         from representantes  rr
                            , pessoas         pr
                         where rr.idpessoa        = pr.idpessoa
                           and rr.idrepresentante = ( select idrepresentante
                                                      from vendedoras v
                                                      where v.idvendedora = ev.idvendedora ) ) "Representante"
                     , ( select initcap( nvl(pr.apelido,pr.nomepessoa ) ) 
                         from vendedoras  rr
                            , pessoas         pr
                         where rr.idpessoa        = pr.idpessoa
                           and rr.idvendedora = ev.idvendedora ) "Vendedora"
                     , ( select ca.nome
                         from categorias ca
                         where ca.idcategoria = ( select pr.idcategoria 
                                                 from produtos    pr
                                                 where pr.idproduto = e.idproduto ) ) "Categoria"
                     , ( select pr.codigosisdist 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Código"    
                     , ( select initcap( pr.nomeproduto ) 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Produto"         
                     , ( select c.descricao 
                         from cores c
                         where c.idcor = e.idcor ) "Cor"
                     , e.idestoquefilial
                     , e.idfilial
                     , e.idproduto
                     , e.idcor
                     , me.quantidade    "Quantidade"
                     , me.observacao    "Observação"
                     , me.usuario       "Usuário"
                     , me.datamovimento "Data Movimento"
                     , me.qtd_pp   "Qtd PP"
                     , me.qtd_p    "Qtd P"
                     , me.qtd_m    "Qtd M"
                     , me.qtd_g    "Qtd G"
                     , me.qtd_gg   "Qtd GG"
                     , me.qtd_egg  "Qtd EGG"
                     , me.qtd_u    "Qtd U"
                from estoquefilial           e
                   , estoquevendedora        ev
                   , movimentosestoquevend me
                where e.idestoquefilial  = ev.idestoquefil
                  and e.idestoquefilial  = me.idestoquefil
                  and ( :P0_IDFILIAL is null or e.idfilial = :P0_IDFILIAL)
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Estoque sem movimentação.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

