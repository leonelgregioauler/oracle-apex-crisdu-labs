    dynamicAction atualizadesafio (
        name: AtualizaDesafio
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @engajamento-distribuidores
            columns: TICKETMEDIOINFORMADO
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT NVL(ROUND(to_number(:TICKETMEDIOINFORMADO) * to_number(:DESAFIOCONSFAV) ), :VALORDESAFIOAJUSTADO) FROM DUAL
                itemsToSubmit: [
                    TICKETMEDIOINFORMADO
                    DESAFIOCONSFAV
                ]
            }
            affectedElements {
                selectionType: columns
                columns: VALORDESAFIOAJUSTADO2
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction atualizaengaj (
        name: AtualizaEngaj
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                    /*UPDATE favorita.engajamentosrepresentantes e
                        SET e.valorrealizado = nvl((SELECT round(sum(nvl(p.valorapagarfavorita * fatorconversao, 0)), 2)
                                                FROM favorita.vw_rank_pedidos_dist p
                                                WHERE trunc(p.dataemissao) BETWEEN :P754_DATAINICIAL AND :P754_DATAFINAL
                                                  AND e.idfilial = nvl(p.idfilialromance, e.idfilial)
                                                  AND e.idrepresentante = p.idrepresentante
                                                GROUP BY p.idfilialromance, p.idrepresentante),0)
                        WHERE e.datareferencia = TO_DATE(:P754_DATAREFERENCIA, 'dd/mm/yyyy');*/
                    
                     UPDATE favorita.engajamentosrepresentantes e
                        SET e.valorrealizado = nvl((SELECT round(sum(nvl(p.valorapagarfavorita, 0)), 2)
                                                FROM favorita.vw_rank_pedidos_dist p
                                                WHERE trunc(p.dataemissao) BETWEEN :P754_DATAINICIAL AND :P754_DATAFINAL
                                                  AND e.idfilial = nvl(p.idfilialromance, e.idfilial)
                                                  AND e.idrepresentante = p.idrepresentante
                                                GROUP BY p.idfilialromance, p.idrepresentante),0)
                        WHERE e.datareferencia = TO_DATE(:P754_DATAREFERENCIA, 'dd/mm/yyyy')
                          AND e.idfilial = :P0_IDFILIAL;
                        
                    commit;    
                        
                    end;
                    ```
                itemsToSubmit: [
                    P754_DATAINICIAL
                    P754_DATAFINAL
                    P754_DATAREFERENCIA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

