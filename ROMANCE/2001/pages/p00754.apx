    region engajamento-distribuidores-efetivo (
        name: Engajamento Distribuidores(Efetivo)
        title: Engajamento Distribuidores(Efetivo)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.valordesafioajustado  as "Desafio(R$)"
                     , e.valordesafioajustado2 as "Desafio Ajustado(R$)"
                     , favorita.pck_util_fav.fnc_nomerepresentante(e.idrepresentante) as "Distribuidor Independente"
                     , ( select listagg(m.cnpj, ' - ')
                           from roman.mei m
                          where m.idpessoa = r.idpessoa
                            and m.ativo = 'S') as "CNPJ Distribuidor Independente"
                     , e.valorrealizado as "Realizado(R$)"
                     , case
                         when e.valordesafioajustado2 is not null then 
                           e.valordesafioajustado2 - e.valorrealizado
                         when e.valordesafioajustado is not null then 
                           e.valordesafioajustado - e.valorrealizado
                         when e.valordesafio is not null then 
                           e.valordesafio - e.valorrealizado
                       end as "Falta Atingir"
                  from favorita.engajamentosrepresentantesefetivo e
                     , catal.representantes r
                 where r.idrepresentante = e.idrepresentante
                   and e.datareferencia  = to_date(:P754_DATAREFERENCIA,'dd/mm/rrrr')
                   and e.idfilial = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 45542243818629332
