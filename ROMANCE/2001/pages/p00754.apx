    pageItem P754_IDFILIALROMANCE (
        type: selectList
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.nome display_value
                     , w.idfilial  return_value
                from roman.vw_filiais w
                where w.ativo = 'S'
                  and w.tipofilial = 'D'
                  and exists (  select 1
                                from usuarios u
                                where u.usuario = v('APP_USER')
                                 and u.idgerente in (29,143) )
                                 
                union
                
                select '>> TODAS <<' display_value
                     , -1 return_value
                from roman.vw_filiais w
                where w.ativo = 'S'
                  and w.tipofilial = 'D'
                  and exists (  select 1
                                from usuarios u
                                where u.usuario = v('APP_USER')
                                 and u.idgerente in (29,143) )
                
                union 
                
                select h.nome display_value
                     , h.idfilial return_value
                from roman.vw_filiais h
                where h.idgerente = ( select g.idgerente
                                      from gerentes g
                                      where g.idpessoa = ( select u.idpessoa
                                                           from usuarios u
                                                           where u.usuario = v('APP_USER') ) )
                order by 1 
                
                                 
                 
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P754_MESANO_RECORDE (
        type: hidden
        layout {
            sequence: 20
            region: @rec
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select aux.dataemissao
                  from (  select to_char(p.dataemissao, 'MM/YYYY') dataemissao,
                                 sum(p.valorapagar) as valor_total
                            from favorita.vw_rank_pedidos_agrp p
                           where p.idfilialromance = :P0_idfilial
                             and p.dataemissao >= to_date('01/01/2023', 'DD/MM/YYYY')
                           group by to_char(p.dataemissao, 'MM/YYYY')
                           order by 2 desc
                           fetch first 1 rows only) aux
                /*
                    maicon aimi - 27/06/2025 - 10219242
                    comentei essa query pois substitui pela query acima
                select 
                    coalesce(
                        (
                            select aux.dataemissao
                            from (
                                select to_char(p.dataemissao, 'MM/YYYY') dataemissao,
                                       sum(p.valorapagar) as valor_total
                                from favorita.pedidos p
                                where p.datacancelamento is null
                                  and p.idsituacaoentrega >= 20000
                                  and p.idfilialromance = :p0_idfilial
                                  and p.dataemissao >= to_date('01/01/2023', 'DD/MM/YYYY')
                                group by to_char(p.dataemissao, 'MM/YYYY')
                                order by 2 desc
                            ) aux
                            where rownum = 1
                        ),
                        ' - '
                    ) as valor
                from dual;
                */
                ```
            used: always
        }
    )

    pageItem P754_VALOR_RECORDE (
        type: hidden
        layout {
            sequence: 10
            region: @rec
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select aux.valor
                  from (  select to_char(p.dataemissao, 'MM/YYYY') as mes_ano
                               , nvl(to_char(sum(p.valorapagar), '999G999G999G999G990D00'),'0,00') AS valor
                            from favorita.vw_rank_pedidos_agrp p
                           where p.idfilialromance = :P0_idfilial
                             and p.dataemissao >= to_date('01/01/2023', 'DD/MM/YYYY')
                           group by to_char(p.dataemissao, 'MM/YYYY')
                           order by 2 desc
                           fetch first 1 rows only ) aux
                
                /*
                    Maicon Aimi - 27/06/2025 - 10219242
                    comentei essa query pois substitui pela query acima
                SELECT 
                    COALESCE(
                        (
                            SELECT TO_CHAR(aux.valor_total, '999G999G999G999G990D00') AS Valor
                            FROM (
                                SELECT TO_CHAR(p.dataemissao, 'MM/YYYY') AS mes_ano,
                                       SUM(p.valorapagar) AS valor_total
                                FROM favorita.pedidos p
                                WHERE p.datacancelamento IS NULL
                                  AND p.idsituacaoentrega >= 20000
                                  AND p.idfilialromance = :P0_IDFILIAL
                                  AND p.dataemissao >= TO_DATE('01/01/2023', 'DD/MM/YYYY')
                                GROUP BY TO_CHAR(p.dataemissao, 'MM/YYYY')
                                ORDER BY 2 DESC
                            ) aux
                            WHERE ROWNUM = 1
                        ),
                        '0,00'
                    ) AS Valor
                FROM dual;
                */
                ```
            used: always
        }
    )

