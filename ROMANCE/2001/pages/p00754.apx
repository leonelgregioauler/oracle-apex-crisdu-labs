page 754 (
    name: Desafio Favorita
    title: Desafio Favorita
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region aviso-congelamento (
        name: Aviso Congelamento
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM dual
                WHERE  EXISTS (SELECT 1
                                 FROM favorita.engajamentosrepresentantes eg
                                 WHERE eg.datareferencia = to_date(:P754_DATAREFERENCIA,'dd/mm/rrrr')
                                  AND eg.idfilial = :P0_IDFILIAL
                                  AND trunc(sysdate) <= trunc(eg.datareferencia) + (select p.valor
                                                                                     from favorita.parametros p
                                                                                    where p.nome = 'CONGELAMENTODESAFIOFRANQUIAS'
                                                                                      and p.idfilialromance = :P0_IDFILIAL))
                ```
        }
    )

    region desafio-franquia (
        name: Desafio Franquia
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Desafio Franquia' desafio,
                       case
                         when nvl((select sum(e.valordesafioajustado)
                                      from favorita.engajamentosrepresentantes e
                                     where e.datareferencia = to_date(:P754_DATAREFERENCIA,'dd/mm/rrrr')
                                       and e.idfilial = :P0_IDFILIAL), 0) != 0
                         then to_char((select sum(e.valordesafioajustado)
                                          from favorita.engajamentosrepresentantes e
                                         where e.datareferencia = to_date(:P754_DATAREFERENCIA,'dd/mm/rrrr')
                                           and e.idfilial = :P0_IDFILIAL), '999G999G999G999G990D00')
                         else nvl(to_char((select sum(f.valordesafioajustado)
                                              from favorita.engajamentosfranquias f
                                             where f.datareferencia = to_date(:P754_DATAREFERENCIA,'dd/mm/rrrr')
                                               and f.idfilial = :P0_IDFILIAL), '999G999G999G999G990D00'), 0)
                       end valor
                  from dual
                 
                     
                
                ```
        }
        layout {
            sequence: 20
            parentRegion: @informações-do-momento
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: DESAFIO
            valueColumn: VALOR
        }
    )

    region desafio-novo (
        name: Desafio Novo
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Desafio Ajustado' desafio
                     , nvl(to_char(sum(e.valordesafioajustado2), '999G999G999G999G990D00'),0) valor
                from favorita.engajamentosrepresentantes e
                where e.datareferencia  = to_date(:P754_DATAREFERENCIA,'dd/mm/rrrr')
                  and e.idfilial = :P0_IDFILIAL
                  
                     
                     
                
                ```
        }
        layout {
            sequence: 30
            parentRegion: @informações-do-momento
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: DESAFIO
            valueColumn: VALOR
        }
    )

    region engajamento-distribuidores (
        name: Engajamento Distribuidores
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idfilial
                     , favorita.pck_util_fav.fnc_nomerepresentante(e.idrepresentante) "Representante"
                     , e.valordesafio  valordesafioorig--desafiodistribuidor --"Desafio Distribuidor(R$)"
                     , e.valorrealizado           --"Realizado Mes(R$)" -- buscara a informação de acordo com os filtros informados pelo usuario quando emitir o relatorio
                     , case
                         when e.valordesafioajustado2 is not null then 
                           e.valordesafioajustado2 - e.valorrealizado
                         when e.valordesafioajustado is not null then 
                           e.valordesafioajustado - e.valorrealizado
                         when e.valordesafio is not null then 
                           e.valordesafio - e.valorrealizado
                       end faltaatingir
                     , e.qtdnotasabertas      --"Notas Abertas para o Mês"
                     , e.percengajatual       --"Engajamento Atual%"
                     , e.percengajant         --"Engajamento Anterior%"
                     , e.desafioconsfav      --"Desafio Cons. Favorita"
                     , e.ticketmediocalculado
                     , e.ticketmedioinformado
                     , e.idengajamentorepresentante
                     , e.metadesafio
                     , e.ticketmediodistribuidor
                     , e.percengajnovo
                     , e.valordesafioajustado
                     , e.valordesafioajustado2
                     , ( select eg.ticketmedioajustado
                           from favorita.engajamentosfranquias eg
                          where eg.idfilial = e.idfilial
                            and eg.Datareferencia = e.datareferencia ) ticketmedioajustadofranq
                     -- Maicon Aimi - 9264656 - 27/06/2024 - Criado essa subQuery pra buscar o CNPJ no representante
                     , ( select listagg(m.cnpj, ' - ')
                           from roman.mei m
                          where m.idpessoa = r.idpessoa
                            and m.ativo = 'S') cnpjRepresentante
                  from favorita.engajamentosrepresentantes e
                     , catal.representantes r
                 where r.idrepresentante = e.idrepresentante
                   and e.datareferencia  = to_date(:P754_DATAREFERENCIA,'dd/mm/rrrr')
                   and e.idfilial = :P0_IDFILIAL
                     
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
