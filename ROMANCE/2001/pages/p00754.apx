    validation congelado (
        name: Congelado
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @engajamento-distribuidores
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM dual
                WHERE  EXISTS (SELECT 1
                                 FROM favorita.engajamentosrepresentantes eg
                                 WHERE eg.datareferencia = to_date(:P754_DATAREFERENCIA,'dd/mm/rrrr')
                                  AND eg.idfilial = :P0_IDFILIAL
                                  AND trunc(sysdate) < trunc(eg.datareferencia) + (select p.valor
                                                                                     from favorita.parametros p
                                                                                    where p.nome = 'CONGELAMENTODESAFIOFRANQUIAS'
                                                                                      and p.idfilialromance = :P0_IDFILIAL))
                ```
        }
        error {
            errorMessage: Alteração no Desafio Ajustado está congelado. Para mais informações, entre em contato com o Administrativo Favorita!
        }
    )

    validation valida-lançar-desafio (
        name: valida Lançar Desafio
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where  exists (select 1
                                  from favorita.engajamentosrepresentantes eg
                                 where eg.datareferencia = to_date(:P754_DATAREFERENCIA,'dd/mm/rrrr')
                                   and eg.idfilial = :P0_IDFILIAL
                                   and trunc(sysdate) <= trunc(eg.datareferencia) + (select p.valor
                                                                                      from favorita.parametros p
                                                                                     where p.nome = 'CONGELAMENTODESAFIOFRANQUIAS'
                                                                                       and p.idfilialromance = :P0_IDFILIAL));
                ```
        }
        error {
            errorMessage: Atualização não permitida, Data Referência está congelada. Para mais informações, entre em contato com o Administrativo Favorita!
        }
        serverSideCondition {
            whenButtonPressed: @lancardesafio
        }
    )

    process engajamento-distribuidores-save-interactive-grid-data (
        name: Engajamento Distribuidores - Save Interactive Grid Data
        type: executeCode
        editableRegion: @engajamento-distribuidores
        source {
            plsqlCode:
                ```plsql
                declare 
                    v1 number;
                    v2 number;
                    v_error_message VARCHAR2(200);
                begin
                
                    update favorita.engajamentosrepresentantes e
                       set e.valordesafioajustado2 =      to_number(:VALORDESAFIOAJUSTADO2,'999G999G999G999G990D00')
                         , e.ticketmedioinformado =       :TICKETMEDIOINFORMADO
                     where e.idengajamentorepresentante = :IDENGAJAMENTOREPRESENTANTE;
                
                    v1 := 0;
                    v2 := 0;
                
                    select sum(e.valordesafioajustado) 
                         , sum(e.valordesafioajustado2)
                      into v1
                         , v2
                      from favorita.engajamentosrepresentantes e
                     where e.idfilial = :P0_IDFILIAL
                       and e.datareferencia = to_date(:P754_DATAREFERENCIA,'dd/mm/rrrr');
                
                    if v2 < v1 then 
                        apex_error.add_error( p_message => 'A soma dos desafios ajustados não pode ser menor que os desafios estabelecidos originalmente. Por favor, verifique os valores informados.'||' '||'>>DISTRIBUIDOR<<:'||' '|| :REPRESENTANTE
                                            , p_display_location => apex_error.c_inline_in_notification);
                        rollback;
                       /*raise_application_error(
                            -20001,
                            'A soma dos desafios ajustados não pode ser menor que os desafios estabelecidos originalmente. ' ||
                            'Por favor, verifique os valores informados. >>DISTRIBUIDOR<<: ' || :REPRESENTANTE
                        );*/
                    end if;
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Ajuste Realizado com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 2980232443828932645
        }
    )

    process lançar-desafio (
        name: lançar Desafio
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin    -- Maicon Aimi - 27/08/2024 - Criado para atender o ticket 9264656
                
                    -- Limpa a tabela engajamentosrepresentantesefetivo
                    delete 
                      from favorita.engajamentosrepresentantesefetivo e
                     where e.datareferencia = TO_DATE(:P754_DATAREFERENCIA, 'dd/mm/rrrr')
                       and (nvl(:P0_IDFILIAL, -1) = -1 or e.idfilial = :P0_IDFILIAL);
                
                    -- Atualiza a tabela engajamentosrepresentantesefetivo
                    insert into favorita.engajamentosrepresentantesefetivo ( idengajamentorepresentante
                                                                           , idfilial
                                                                           , idrepresentante
                                                                           , datareferencia
                                                                           , qtdnotasabertas
                                                                           , valordesafio
                                                                           , valorrealizado
                                                                           , percengajant
                                                                           , percengajatual
                                                                           , percengajnovo
                                                                           , idusuarioinclusao
                                                                           , idusuarioalteracao
                                                                           , desafioconsfav
                                                                           , ticketmediocalculado
                                                                           , ticketmedioinformado
                                                                           , metadesafio
                                                                           , valorrealizadofinal
                                                                           , ticketmediodistribuidor
                                                                           , valordesafioajustado
                                                                           , valordesafioajustado2)
                        select idengajamentorepresentante
                             , idfilial
                             , idrepresentante
                             , datareferencia
                             , qtdnotasabertas
                             , valordesafio
                             , valorrealizado
                             , percengajant
                             , percengajatual
                             , percengajnovo
                             , idusuarioinclusao
                             , idusuarioalteracao
                             , desafioconsfav
                             , ticketmediocalculado
                             , ticketmedioinformado
                             , metadesafio
                             , valorrealizadofinal
                             , ticketmediodistribuidor
                             , valordesafioajustado
                             , valordesafioajustado2
                          from favorita.engajamentosrepresentantes e
                         where e.datareferencia = TO_DATE(:P754_DATAREFERENCIA, 'dd/mm/rrrr')
                           and (nvl(:P0_IDFILIAL, -1) = -1 or e.idfilial = :P0_IDFILIAL);
                
                    -- confirmar a transação
                    commit;
                
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 45539962581629309
        }
        serverSideCondition {
            whenButtonPressed: @lancardesafio
        }
    )

)

