page 566 (
    name: Depósitos Localizados da Negociação
    title: Depósitos Localizados da Negociação
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 50%
        resizable: false
    }
    css {
        inline:
            ```css
            .img_produto {
                position: relative;
                max-width:700px;
                max-height:500px;
                width: auto;
                height: auto;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region depósitos-localizados (
        name: Depósitos Localizados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddepositonegociacao
                     , d.dataleitura
                     , d.datadeposito
                     , d.valor
                     , d.nroidentificacao
                     , '<a href="https://cobraki.com.br/fotos/'||nomearquivo||'" target="_blank"> <img src="https://cobraki.com.br/fotos/'||nomearquivo||'" class="img_produto"><a>' foto
                     , case
                         when d.datarevisao is null then
                           'Não'
                         else
                           'Sim' 
                       end revisado
                     , d.datarevisao
                     , d.nroidentificacao_digitado
                     , d.valor_digitado
                from DEPOSITOSNEGOCIACOESPARC d
                where d.idnegociacaoparceiro = :P566_IDNEGOCIACAOPARCEIRO
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 33792222904274433
        }

        column DATADEPOSITO (
            type: plainText
            heading {
                heading: Data do Depósito
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column DATALEITURA (
            type: plainText
            heading {
                heading: Data da Leitura
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column DATAREVISAO (
            type: plainText
            heading {
                heading: Data Revisão
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        column FOTO (
            type: plainText
            heading {
                heading: Foto
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDDEPOSITONEGOCIACAO (
            type: hidden
            heading {
                heading: Iddepositonegociacao
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NROIDENTIFICACAO (
            type: plainText
            heading {
                heading: Nr Identificação
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column NROIDENTIFICACAO_DIGITADO (
            type: plainText
            heading {
                heading: Nr Identificação Rev.
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column REVISADO (
            type: plainText
            heading {
                heading: Revisado
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column VALOR_DIGITADO (
            type: plainText
            heading {
                heading: Valor Revisão
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        savedReport 45097104 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATADEPOSITO (
                sequence: 3
            )

            displayColumn DATALEITURA (
                sequence: 2
            )

            displayColumn DATAREVISAO (
                sequence: 7
            )

            displayColumn FOTO (
                sequence: 1
            )

            displayColumn NROIDENTIFICACAO (
                sequence: 5
            )

            displayColumn NROIDENTIFICACAO_DIGITADO (
                sequence: 8
            )

            displayColumn REVISADO (
                sequence: 6
            )

            displayColumn VALOR (
                sequence: 4
            )

            displayColumn VALOR_DIGITADO (
                sequence: 9
            )

        )

    )

    pageItem P566_IDNEGOCIACAOPARCEIRO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @depósitos-localizados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @depósitos-localizados
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 562
                items: {
                    P562_IDNEGOCIACAOPARCEIRO: &P566_IDNEGOCIACAOPARCEIRO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

