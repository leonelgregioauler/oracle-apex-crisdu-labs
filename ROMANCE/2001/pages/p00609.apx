page 609 (
    name: Log Itens Carga
    title: Log Itens Carga
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region log-itens-carga (
        name: Log Itens Carga
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select lic.usuarioalteracao
                     , decode(TIPOALTERACAO,'INSERT','Inclusão','UPDATE','Alteração','DELETE','Exclusão') "Tipo Alt."
                     , lic.dataalteracao
                     , lic.iditemcargarepres 
                     , lic.idcargarepresentante 
                     , p.codigosisdist "Codigo"
                     , p.nomeproduto "Produto"
                     , lic.idestoquefil
                     , lic.quantidade
                     , lic.valorvenda
                     , lic.valorcusto
                     , lic.idproduto
                     , lic.comissao
                     , lic.cargaamais
                     , lic.qtd_dist_pp
                     , lic.qtd_dist_p
                     , lic.qtd_dist_m
                     , lic.qtd_dist_g
                     , lic.qtd_dist_gg
                     , lic.qtd_dist_egg
                     , lic.qtd_dist_u
                     , decode(estoquemovto, 'D', 'Distribuição' , 'P', 'Posto Avançado', 'R', 'Reembalagem')"Estoque Movimento"
                     , lic.idpostoavancado
                     , lic.qtd_dist_exgg
                     , lic.qtd_egg_sugerida
                     , lic.qtd_exgg_sugerida
                     , lic.qtd_gg_sugerida
                     , lic.qtd_g_sugerida
                     , lic.qtd_m_sugerida
                     , lic.qtd_pp_sugerida
                     , lic.qtd_p_sugerida
                     , lic.qtd_u_sugerida
                from logroman.log_itenscargarepresentant lic
                   , roman.estoquefilial e
                   , roman.produtos p
                where lic.idestoquefil = e.idestoquefilial
                  and e.idproduto = p.idproduto
                 and idcargarepresentante = :P609_IDCARGAREPRESENTANTE
                order by 3 desc
                ```
            pageItemsToSubmit: P609_IDCARGAREPRESENTANTE
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenMoreDataFound: Nenhuma informação encontrada.
        }
        advanced {
            savedReportMappingIdentifier: 110396486208926116
        }

