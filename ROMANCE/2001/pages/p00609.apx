    pageItem P609_IDCARGAREPRESENTANTE (
        type: numberField
        label {
            label: ID Carga
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @log-itens-carga
            slot: regionBody
            alignment: left
