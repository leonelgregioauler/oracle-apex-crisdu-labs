    dynamicAction refresh-relatorio (
        name: Refresh Relatorio
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P609_IDCARGAREPRESENTANTE
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P609_IDCARGAREPRESENTANTE
        }

        action native-refresh (
