page 799 (
    name: Cadastro Características Conquistou Levou
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1200
        height: 600
        resizable: false
    }

    region cadastro-características (
        name: Cadastro Características
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    region caracterìsticas-brindes-conquistou-levou (
        name: Caracterìsticas Brindes Conquistou Levou
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select apex_item.CHECKBOX2(2, cl.idcaracteristica , null) as check1
                     , cl.nomecaracteristica
                     , cl.idcaracteristica
                     , cl.idclassificacao
                from roman.conquistoulevoucaracteristicas cl
                where (:P799_CLASSIFICACAO is null or cl.idclassificacao = :P799_CLASSIFICACAO)
                order by 3
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1800623304044552918
        }

        column CHECK1 (
            type: plainText
            heading {
                heading: Selecione
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDCARACTERISTICA (
            type: hidden
            heading {
                heading: Idcaracteristica
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDCLASSIFICACAO (
            type: plainText
            heading {
                heading: Idclassificacao
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column NOMECARACTERISTICA (
            type: plainText
            heading {
                heading: Características
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 18007326 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CHECK1 (
                sequence: 1
            )

            displayColumn NOMECARACTERISTICA (
                sequence: 2
            )

        )

    )

    pageItem P799_CARACTERISITICA (
        type: textField
        label {
            label: Nome Característica
            alignment: left
        }
        layout {
            sequence: 30
            region: @cadastro-características
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P799_CLASSIFICACAO (
        type: selectList
        label {
            label: Classificação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select cl.nomeclassif display_value
                     , cl.idclassificacao return_value
                from roman.conquistoulevouclassificacoes cl
                ```
        }
        layout {
            sequence: 20
            region: @cadastro-características
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 10
            region: @caracterìsticas-brindes-conquistou-levou
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 10
            region: @cadastro-características
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P799_CLASSIFICACAO
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process processo-cadastro-características (
        name: Processo Cadastro Características
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vseq number;
                  vteste number;
                  --
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'EXCLUIR' then
                    --
                    voperacao_dml := 'E';
                    --
                  end if;
                    --
                    if voperacao_dml = 'I' then 
                      --
                      select roman.seq_idcaractconqlev.nextval
                        into vseq
                      from dual;
                      --
                      insert into ROMAN.CONQUISTOULEVOUCARACTERISTICAS(IDCARACTERISTICA,
                                                                     NOMECARACTERISTICA,
                                                                     IDCLASSIFICACAO)
                      values(vseq, :P799_CARACTERISITICA, :P799_CLASSIFICACAO);
                      --
                      apex_application.g_print_success_message := '<span style="color : white ">Característica Cadastrada com sucesso! </span>'; 
                      --
                    
                    elsif voperacao_dml = 'E' then  
                      -- Loop através de cada item no array
                      --
                      FOR i IN 1..APEX_APPLICATION.G_F02.COUNT 
                
                        LOOP
                          --
                          begin 
                            --
                            select cl.idclassifbrindeclub
                              into vteste
                            from roman.classificacoesbrindesclub cl
                            where cl.idcaracteristica = APEX_APPLICATION.G_F02(i);
                            --
                            exception 
                              when others then 
                                vteste := null;
                          end;
                          --
                          if vteste is null then 
                            --
                            delete ROMAN.CONQUISTOULEVOUCARACTERISTICAS cc
                            where cc.idcaracteristica = APEX_APPLICATION.G_F02(i);
                            --
                            else 
                            --
                            RAISE_APPLICATION_ERROR(-20002,'Não é possivel excluir, característica já vinculada a um brinde');
                            --
                          end if; 
                        END LOOP;
                        --
                        apex_application.g_print_success_message := '<span style="color : white ">Exclusão realizada com sucesso! </span>';
                        --
                    END IF;
                    
                  --
                  COMMIT;
                  --
                  
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1800623657248552921
        }
    )

    branch (
        name: Go To Page 799
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 799
                clearCache: 799
            }
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

)

