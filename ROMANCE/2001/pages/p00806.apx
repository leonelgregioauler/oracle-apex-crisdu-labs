            sequence: 20
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 807
                clearCache: 807
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button totalbrindes (
        buttonName: TOTALBRINDES
        label: Brindes  Por Campanha
        layout {
            sequence: 10
            region: @relatórios
