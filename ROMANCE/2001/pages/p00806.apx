    region relatórios (
        name: Relatórios
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P806_IDCAMPANHA (
        type: selectList
        label {
            label: Campanha :
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select cp.nomecampanha
                     , cp.idconquistoulevou
                from roman.campanhasconquistoulevou cp 
                where cp.idpais = :P806_IDPAIS
                ```
        }
        cascadingLov {
            parentItems: P806_IDPAIS
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P806_IDPAIS (
        type: selectList
        label {
            label: País :
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome 
                     , p.idpais
                from catal.paises p
                where exists ( select 1 
                               from roman.campanhasconquistoulevou cp 
                               where cp.idpais = p.idpais)
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    button novo (
        buttonName: NOVO
