page 806 (
    name: Lista Envio de Brindes
    title: Lista Envio de Brindes
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    region guias-de-envio-brindes-conquistou-levou (
        name: Guias de Envio Brindes Conquistou Levou
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select gb.idguiaentregabrinde
                     , gb.idguiaentregabrinde Guia
                     , gb.idfilial
                     , (nvl(favorita.pck_util_fav.fnc_nomefilialfavorita(gb.idfilial),
                           (select f.nome from roman.vw_filiais f where f.idfilial = gb.idfilial))) loja
                     , gb.idconquistoulevou
                     , (select c.nomecampanha
                        from roman.campanhasconquistoulevou c
                        where c.idconquistoulevou = gb.idconquistoulevou) campanha
                     , gb.dataemissao
                     , gb.dataenvio
                     , gb.datarecebimento 
                     , case
                         when gb.datarecebimento is not null then 
                           'Completo'
                         when exists(select 1 from roman.itensfaltantes if
                                     where if.idguiaentregabrinde = gb.idguiaentregabrinde)  then
                            'Pendente'  
                         else
                           'Não Recebido'
                       end statusrecebimento
                    , gb.idremessafavorita
                from roman.guiasentregasbrindes gb
                where gb.idconquistoulevou = :P806_IDCAMPANHA
                  and exists (select 1
                              from roman.guiasentregascupons gec
                              where gec.idguiaentregabrinde = gb.idguiaentregabrinde)
                order by gb.idfilial,gb.idguiaentregabrinde
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1803024626526884015
        }

        column CAMPANHA (
            type: plainText
            heading {
                heading: Campanha
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column DATAEMISSAO (
            type: plainText
            heading {
                heading: Data Emissão
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DATAENVIO (
