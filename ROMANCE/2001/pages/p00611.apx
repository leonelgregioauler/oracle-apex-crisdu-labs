    pageItem P611_IDDEVOLUCAOREPRESENTANTE (
        type: numberField
        label {
            label: ID Devolução
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @log-itens-devoluções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh-relatorio (
        name: Refresh Relatorio
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P611_IDDEVOLUCAOREPRESENTANTE
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P611_IDDEVOLUCAOREPRESENTANTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @log-itens-devoluções
            }
            execution {
