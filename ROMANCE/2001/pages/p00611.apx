page 611 (
    name: Log Itens Devoluções
    title: Log Itens Devoluções
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region log-itens-devoluções (
        name: Log Itens Devoluções
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select lid.usuarioalteracao
                     , decode(TIPOALTERACAO,'INSERT','Inclusão','UPDATE','Alteração','DELETE','Exclusão') "Tipo Alt."
                     , lid.dataalteracao
                     , lid.iditemdevolucaorepres
                     , lid.iddevolucaorepres
                     , lid.idestoquefil
                     , lid.idproduto
                     , p.codigosisdist "Codigo"
                     , p.nomeproduto "Produto"
                     , lid.qtd_pp
                     , lid.qtd_p
                     , lid.qtd_m
                     , lid.qtd_g
                     , lid.qtd_gg
                     , lid.qtd_egg
                     , lid.qtd_u
                     , decode(estoquedestino,'R','Reembalagem','D','Distribuição','D','Defeito','F','Defeito') "Destino"
                     , lid.idpostoavancado
                     , lid.iddefeito
                     , lid.valorproduto
                     , lid.representanteficou
                     , lid.situacaodefeito
                     , lid.idfechamentoreprespago
                     , lid.comissao
                     , lid.qtd_exgg
                     , lid.datamovimentacao
                     , lid.idsemana
                     , lid.origemdefeito
                     , lid.usuariomovimentacao
                     , lid.comissaofechamento
                     , lid.observacao
                     , lid.valorcobrado 
                from logroman.log_itensdevolucaorepres lid
                   , roman.estoquefilial e
                   , roman.produtos p
                where lid.idestoquefil = e.idestoquefilial
                  and e.idproduto = p.idproduto
                  and iddevolucaorepres = :P611_IDDEVOLUCAOREPRESENTANTE
                order by idlog desc
                ```
            pageItemsToSubmit: P611_IDDEVOLUCAOREPRESENTANTE
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma informação encontrada.
        }
        advanced {
            savedReportMappingIdentifier: 110420675756270425
        }

