page 436 (
    name: ComissaoPagarRep
    title: ComissaoPagar
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function somavalor() {
               var vNum = 0;
               $("#P436_TOTAL").val(vNum);
               var theForm = document.wwv_flow;
               var vTemp = 0;
                
               if (theForm) {
                   for(i=0;i<theForm.f01.length;i++){
                        if(theForm.f01[i].checked){
                            vNum = $(theForm.f05[i]).val();
                            vNum = vNum.replace(',','.');
                            vTemp = parseFloat(vTemp) + parseFloat(vNum);
                            //vTemp = parseInt(vTemp, 10);
                            //$("#P436_TOTAL").val(vTemp);
                            document.getElementById('P436_TOTAL').value = vTemp;   
                        }
                   }
            
                } else {
                        vNum = $("#f09_0001").val();
                        vNum = vNum.replace(',','.');
                        //vTemp = parseFloat(vTemp) + parseFloat(vNum);
                        $("#P436_TOTAL").val(vNum);
                    }
                 // document.getElementById('P436_TOTAL').value = vTemp;        
                
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region pagamento-de-comissões (
        name: Pagamento de Comissões
        type: tabform
        source {
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomevendedora(idvendedora) vendedora
                     , p.idrepresentante
                     , p.valorcomissaorep
                     , p.idpagamentocom
                     , p.datapagamentorep
                     , n.datanota
                     , n.valortotalvenda
                     , n.basecomissao    
                     , pck_util.fnc_semanaid(p.idsemana) semana
                  from PAGAMENTOSCOMISSOESECOM p
                     , notasvendas n
                 where n.idnotavenda       = p.idnotavenda
                   and p.idrepresentante   = :P436_IDREPRESENTANTE
                   and p.datapagamentorep  is null
                   and p.idfechamentorep   is null
                   and sysdate - n.datanota >= 7
                   and trunc(n.datanota) < trunc(sysdate)
                ```
            pageItemsToSubmit: P436_IDREPRESENTANTE
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: onClick="javascript:somavalor();"
        }
        reportLayout {
            numberOfRows: 150
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhuma comissão pendente!
        }
        componentAdvanced {
            stripHtml: true
        }

        column BASECOMISSAO (
