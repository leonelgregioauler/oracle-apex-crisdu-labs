    button pagar (
        buttonName: PAGAR
        label: Pagar Comissão
        layout {
            sequence: 20
            region: @pagamento-de-comissões
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: item=value
            item: P436_TIPO
            value: P
        }
    )

    button voltar (
        buttonName: Voltar
        label: Voltar
        layout {
            sequence: 10
            region: @pagamento-de-comissões
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 75
                items: {
                    P75_IDFECHAMENTOREPRES: &P436_IDFECHAMENTOREPRES.
                    P75_IDREPRESENTANTE: &P436_IDREPRESENTANTE.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-set-value (
            action: setValue
            settings {
                value: 0
            }
            affectedElements {
                selectionType: items
                items: P436_TOTAL
            }
            execution {
                sequence: 10
            }
        )

    )

    process pagacomissao (
        name: PagaComissao
        type: executeCode
        editableRegion: @pagamento-de-comissões
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  --raise_application_error(-20001,'idpagamentocom='||:IDPAGAMENTOCOM);
                      update pagamentosComissoeseCom u
                      set dataPagamentoRep = sysdate 
                        , u.idfechamentorep = :P436_IDFECHAMENTOREPRES
                      where idpagamentocom = :IDPAGAMENTOCOM;
                  --
                  commit;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Comissão paga com sucesso!!
        }
        advanced {
            executionMappingIdentifier: 27886330660501734
        }
        serverSideCondition {
            whenButtonPressed: @pagar
            type: itemIsNotNull
            item: P436_IDREPRESENTANTE
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 436
                items: {
                    P436_IDREPRESENTANTE: &P436_IDREPRESENTANTE.
                    P436_IDFECHAMENTOREPRES: &P436_IDFECHAMENTOREPRES.
                    P436_TIPO: &P436_TIPO.
                    P436_TOTAL:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @pagar
        }
    )

)

