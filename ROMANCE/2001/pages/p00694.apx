page 694 (
    name: Comissão Pagas Romance
    title: Comissão Pagas Romance
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region comissão-pagas-detalhado (
        name: Comissão Pagas -  Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cp.vendedora
                     , cp.datapagamento
                     , cp.semana
                     , cp.valorpago
                     , cp.documentos
                     , roman.pck_romance.fnc_nomerepresentante(cp.idrepresentante) nomedist
                from roman.vw_comissoes_cobraki_paga cp
                   , roman.fechamentossemanais fs
                   , roman.fechamentorepresentantes fr
                where cp.idfechamentorepres = fr.idfechamentorepres
                  and fs.idfechamento = fr.idfechamento
                  and (:P694_IDREPRESENTANTE is null or cp.idrepresentante = :P694_IDREPRESENTANTE)
                  and fs.idfechamento = :P694_SEMANAFECHAMENTO
                  and cp.idgerente is null
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P694_TIPORELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1347114933601883002
        }

        column DATAPAGAMENTO (
            type: plainText
            heading {
                heading: Data do Pagamento
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column DOCUMENTOS (
            type: plainText
            heading {
                heading: Documentos
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column NOMEDIST (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column VALORPAGO (
            type: plainText
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column VENDEDORA (
            type: plainText
