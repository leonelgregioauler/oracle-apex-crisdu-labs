                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
