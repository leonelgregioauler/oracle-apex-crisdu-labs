    region comissões-pagas-resumido (
        name: Comissões Pagas - Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cp.datapagamento
                     , cp.semana
                     , sum(cp.valorpago) valorpago
                     , roman.pck_romance.fnc_nomerepresentante(cp.idrepresentante) nomedist
                from roman.vw_comissoes_cobraki_paga cp
                   , roman.fechamentossemanais fs
                   , roman.fechamentorepresentantes fr
                where cp.idfechamentorepres = fr.idfechamentorepres
                  and fs.idfechamento = fr.idfechamento
                  and (:P694_IDREPRESENTANTE is null or cp.idrepresentante = :P694_IDREPRESENTANTE)
                  and fs.idfechamento = :P694_SEMANAFECHAMENTO
                  and cp.idgerente is null
                group by cp.datapagamento
                       , cp.semana
                       , cp.idrepresentante
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P694_TIPORELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1347175415996141602
        }

        column DATAPAGAMENTO (
            type: plainText
            heading {
                heading: Data do Pagamento
                alignment: center
            }
