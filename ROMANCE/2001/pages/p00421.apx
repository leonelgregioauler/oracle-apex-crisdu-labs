    button verdepositossolicitados (
        buttonName: verdepositossolicitados
        label: Ver depósitos solicitados
        layout {
            sequence: 40
            region: @solicita-depósito
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 232
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @fechar
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction esconde-solicitação (
        name: Esconde solicitação
        execution {
            sequence: 30
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNull
            item: P421_CONTROLE
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P421_VALOR
                    P421_IDREPRESENTANTE
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: button
                button: @submit
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-3 (
            action: hide
            affectedElements {
                selectionType: items
                items: P421_CONTROLE
            }
            execution {
                sequence: 30
            }
        )

        action native-hide-4 (
            action: hide
            affectedElements {
                selectionType: button
                button: @novo
            }
            execution {
                sequence: 40
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P421_VALOR
                    P421_IDREPRESENTANTE
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: button
                button: @submit
            }
            execution {
                sequence: 20
            }
        )

        action native-show-3 (
            action: show
            affectedElements {
                selectionType: items
                items: P421_CONTROLE
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

        action native-show-4 (
            action: show
            affectedElements {
                selectionType: button
                button: @novo
            }
            execution {
                sequence: 40
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @novo
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: NOVO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction solicitar (
        name: SOLICITAR
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @submit
        }

        action native-confirm (
            action: confirm
            settings {
                message: Você confirma o valor da solicitação?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SUBMIT
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation valida-representante (
        name: Valida Representante
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P421_IDREPRESENTANTE
        }
        error {
            errorMessage: Informe o distribuidor!
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

    validation valida-valor (
        name: Valida Valor
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P421_VALOR
        }
        error {
            errorMessage: Informe o valor!
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

    process monta-mensagem (
        name: Monta mensagem
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  :P421_CONTROLE := :P421_BENEFICIARIO||'<br>'||:P421_BANCO||' - Ag: '||:P421_AGENCIA||' Cc: '||:P421_CONTA||'<br> Valor: '||:P421_VALOR;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 3350710111435874445
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P421_CONTROLE
        }
    )

    process novo (
        name: NOVO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  :P421_IDREPRESENTANTE := NULL;
                  :P421_VALOR           := NULL;
                  :P421_CONTROLE        := NULL;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3350315814560479828
        }
        serverSideCondition {
            type: request=Value
            value: NOVO
        }
    )

    process solicita-depósito (
        name: Solicita Depósito
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidrepresentante     number := :P421_IDREPRESENTANTE;
                  viddepositodiario    number;
                  vvalor               number := replace(:P421_VALOR,'.','');
                  vtipopagamento       varchar2(1000);
                  vbanco               varchar2(1000);
                  vagencia             varchar2(1000);
                  vconta               varchar2(1000);
                  vbeneficiario        varchar2(1000);
                  vcnpj                varchar2(1000);
                  vstatus              varchar2(1000);
                  vidtablet            number;
                  vlatitude            varchar2(1000);
                  vlongitude           varchar2(1000);
                  --
                begin
                  -- 
                  pck_financeiro_rmc.prc_solicitadeposito_tablet_v2( pidrepresentante  => :P421_IDREPRESENTANTE
                                                                   , piddepositodiario => :P421_IDDEPOSITODIARIO
                                                                   , pvalor            => vvalor
                                                                   , ptipopagamento    => :P421_TIPOPAGAMENTO
                                                                   , pbanco            => :P421_BANCO
                                                                   , pagencia          => :P421_AGENCIA
                                                                   , pconta            => :P421_CONTA
                                                                   , pbeneficiario     => :P421_BENEFICIARIO
                                                                   , pcnpj             => :P421_CNPJ
                                                                   , pstatus           => :P421_STATUS
                                                                   , pidtablet         => :P421_IDTABLET
                                                                   , platitude         => :P421_LATITUDE
                                                                   , plongitude        => :P421_LONGITUDE );       
                  --
                  :P421_VALOR := vvalor;
                  :P421_CONTROLE := 'X';
                  --                                      
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3350294732771459520
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

    branch (
        name: Go To Page 421 Submit
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 421
            }
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

    branch (
        name: Go To Page 421
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 421
                items: {
                    P421_CONTROLE:
                }
                clearCache: 421
                action: resetPagination
            }
        }
    )

)

