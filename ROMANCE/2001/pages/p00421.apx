page 421 (
    name: Solicita Depósito
    title: Solicita Depósito
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formataMoeda(valor){
              v = valor.value;
              v=v.replace(/\D/g,"") // permite digitar apenas numero
              v=v.replace(/(\d{1})(\d{12})$/,"$1.$2") // coloca ponto antes dos ultimos digitos
              v=v.replace(/(\d{1})(\d{9})$/,"$1.$2") // coloca ponto antes dos ultimos 11 digitos
              v=v.replace(/(\d{1})(\d{6})$/,"$1.$2") // coloca ponto antes dos ultimos 8 digitos
              v=v.replace(/(\d{1})(\d{3})$/,"$1.$2") // coloca ponto antes dos ultimos 5 digitos
              valor.value = v;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region solicita-depósito (
        name: Solicita Depósito
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            outputAs: text
        }
    )

