page 358 (
    name: Mapear Colunas
    title: Mapear Colunas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 80%
        resizable: false
    }
    css {
        inline: ".rc-content-main {height: 400px; overflow: auto !important;}"
    }
    security {
        pageAccessProtection: unrestricted
    }

    region data-load-wizard-progress (
        name: Data Load Wizard Progress
        type: list
        source {
            list: @data-load-wizard-progress-vincular-fotos-cdn
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            excludeTitleFromTranslation: true
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    region mapear-colunas (
        name: Mapear Colunas
        type: dataUploadColMapping
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: style="width:100%;max-width:none;"
        }
        settings {
            dataLoadDefinition: @vincular-fotos-cdn
        }
    )

    button next (
        buttonName: NEXT
        label: Próximo
        layout {
            sequence: 30
            region: @mapear-colunas
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS
        label: Voltar
        layout {
            sequence: 10
            region: @mapear-colunas
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 357
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process prepare-uploaded-data (
        name: Prepare Uploaded Data
        type: prepareUploadedData
        dataLoading {
            dataLoadDefinition: @vincular-fotos-cdn
        }
        processingResult {
            insertCountItem: P360_INSERT_COUNT
            updateCountItem: P360_UPDATE_COUNT
            errorCountItem: P360_ERROR_COUNT
            reviewCountItem: P360_REVIEW_COUNT
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1492256356689844159
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 359
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                                   begin
                                            for c1 in (select skip_validation
                                                      from apex_appl_load_tables
                                                      where name = 'Vincular Fotos CDN' and application_id = apex_application.g_flow_id )
                                            loop
                                                if c1.skip_validation = 'N' then return true;
                                                else return false;
                                                end if;
                                            end loop;
                                        end;
                ```
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 360
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                                   begin
                                            for c1 in (select skip_validation
                                                      from apex_appl_load_tables
                                                      where name = 'Vincular Fotos CDN' and application_id = apex_application.g_flow_id )
                                            loop
                                                if c1.skip_validation = 'Y' then return true;
                                                else return false;
                                                end if;
                                            end loop;
                                        end;
                ```
        }
    )

)

