    button confirmar (
        buttonName: CONFIRMAR
        label: Finalizar Campanha
        layout {
            sequence: 20
            region: @pré-disparo
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @pré-disparo
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 492
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction confirmar (
        name: Confirmar
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @confirmar
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma gerar pré-disparo SMS?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CONFIRMAR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process gerapredisparo (
        name: GeraPredisparo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidmensagemdisparo number;
                  vdata date;
                  vmd5  varchar2(4000);
                  vidpredisparosms number;
                  vPedido number;
                  vNotaVenda number;
                  vidcampanhadisp number;
                  vqtd number;
                begin 
                
                  for cur in ( 
                      select idpais,
                             datahoradisp,
                             mensagem,
                             canaldisp,
                             usuario
                        from tmp_predisparosms
                       where incluir = 'S'
                         and usuario = v('APP_USER')
                         and rownum = 1) 
                  loop
                  -- 
                    vidcampanhadisp := :P493_IDCAMPANHADISP;
                
                    pck_cadastros_rmc.prc_mensagensdisparos(pidmensagemdisparo => vidmensagemdisparo,
                                                            pidpais            => cur.idpais,
                                                            pmensagem          => cur.mensagem,
                                                            pdatadisparo       => cur.datahoradisp,
                                                            pcanal             => cur.canaldisp,
                                                            pusuario           => cur.usuario,
                                                            pmd5               => vmd5,
                                                            poperacao_dml      => 'I');
                    --
                    for c1 in ( 
                            select idpessoa,
                                   iddocumento,
                                   valor,
                                   safra,
                                   idpais,
                                   telefone,
                                   datahoradisp,
                                   mensagem,
                                   canaldisp,
                                   usuario,
                                   idfilial
                               from tmp_predisparosms
                              where incluir = 'S'
                                and usuario = v('APP_USER') ) 
                    loop
                      --
                      vmd5 := null;
                       if :P493_TIPO = 'R' then
                        vNotaVenda := c1.iddocumento;
                        vPedido    := null;
                      else
                        vNotaVenda := null;
                        vPedido    := c1.iddocumento;
                      end if;
                      --
                      vidpredisparosms := null;
                      begin
                        pck_cadastros_rmc.prc_predisparosms (pidpredisparosms   => vidpredisparosms,
                                                             pidmensagemdisparo => vidmensagemdisparo,
                                                             pidpais            => c1.idpais, 
                                                             pidpessoa          => c1.idpessoa, 
                                                             pidnotavenda       => vNotaVenda, 
                                                             pidpedido          => vPedido,
                                                             pvaloracionado     => c1.valor, 
                                                             psafra             => c1.safra, 
                                                             pmensagem          => c1.mensagem, 
                                                             pdatahoradisp      => c1.datahoradisp, 
                                                             pcanaldisp         => c1.canaldisp, 
                                                             ptelefone          => c1.telefone,
                                                             pusuario           => c1.usuario,
                                                             pidCampanhaDisp    => vidcampanhadisp,
                                                             pidfilial          => c1.idfilial,
                                                             pmd5               => vmd5,
                                                             poperacao_dml      => 'I') ;    
                      exception
                        when others then raise_application_error(-20001,'Erro no processo de inclusao de Pré-Disparo. Informe o erro a T.I.');
                      end;
                      --
                      begin
                        pck_cadastros_rmc.prc_finalizadisparo2 (pidmensagemdisparo => vidmensagemdisparo,
                                                                pidprocessosistema => c1.canaldisp,
                                                                pidpessoa          => c1.idpessoa);
                      exception
                        when others then raise_application_error(-20001,'Erro no processo de finalização do disparo. Informe o erro a T.I. ');
                      end;
                    end loop;
                    commit;
                  end loop;
                  --apex_application.g_print_success_message := 'Parabéns!! Disparos de SMS realizados com sucesso!' ;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 501887329646938710
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'CONFIRMAR'
        }
    )

    process geratemp (
        name: GeraTemp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                  v_mensagem varchar2(1000);
                  v_data timestamp          := :P493_DATADISPARO ; --:P492_CANAL :P492_IDPAIS
                  v_canal number            := :P493_CANAL ;  
                
                begin
                  v_mensagem := TRANSLATE (:P493_MENSAGEM,'@',',');
                 -- RAISE_APPLICATION_ERROR(-20001,'MENSAGEM= '||:P493_MENSAGEM);
                  begin
                    delete 
                      from tmp_predisparosms
                     where usuario = v('APP_USER');
                  exception
                    when others then null;
                  end;
                
                  -- Foi colocado aqui pelo fato de não estar carregando o item de página ao clicar em CONFIRMAR
                  select seq_idcampanhadisparo.nextval 
                  into :P493_IDCAMPANHADISP
                  from dual;
                      
                  if :P493_TIPO = 'R' then
                    insert into tmp_predisparosms (id, idpessoa, iddocumento, valor, idfilial, safra, telefone, nomepessoa,
                                                   incluir, usuario, datahoradisp, mensagem, canaldisp, idpais)
                    select rownum
                         , p.idpessoa
                         , nv.idnotavenda 
                        -- , nv.valortotalnota
                         , nv.saldo
                         , nv.idfilial
                         , to_date(to_char(nv.datanota,'mm/rrrr'),'mm/rrrr')
                         , ( select t.telefone
                               from telefonespessoas t
                              where t.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                             from telefonespessoas tt
                                                            where tt.idpessoa = p.idpessoa
                                                              and not REGEXP_LIKE(telefone, '(\d)\1\1\1\1\1') ) ) --telefone
                         , p.nomepessoa      --nomepessoa
                         , 'S'               --incluir
                         , v('APP_USER')     --usuario
                         , v_data            --datahora
                         , v_mensagem        --mensagem 
                         , v_canal           --canaldisparo
                         , :P492_IDPAIS
                     from roman.notasvendas nv
                        , catal.pessoas p
                        , catal.vendedoras v
                    where v.idvendedora = nv.idvendedora
                      and p.idpessoa = v.idpessoa
                      and nv.idsituacaonotavenda = 4
                      and nv.saldo > 0
                      and p.idpais       = :P492_IDPAIS
                      and ( :P492_PESQUISA is null
                           or ( :P492_PESQUISA = 'A' and extract (year from nv.datanota) = :P492_ANO )
                           or ( :P492_PESQUISA = 'P' and nv.datanota between to_date(:P492_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') 
                                                                         and to_date(:P492_DATAFIM   ||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) )
                      and ( :P492_IDFILIAL is null or nv.idfilial = :P492_IDFILIAL)
                      and ( :P492_DATAINICIO is not null or :P492_IDFILIAL is not null or :P492_ANO is not null )
                      and ( :P492_SITUACAO_ASSINATURA = 'X' 
                            or exists ( select 1
                                          from assinaturaseletronicas a
                                          where a.idnotavenda = nv.idnotavenda
                                            and a.status = 'C'
                                            and a.situacao = :P492_SITUACAO_ASSINATURA ) )
                      and ( :P492_ENVIADOCOBR = 'A' 
                            or (:P492_ENVIADOCOBR = 'S' and exists ( select 1
                                                                       from negociacoesparceiros np
                                                                      where np.idvendedora = v.idvendedora
                                                                        and np.origem      = 'B' ) ) 
                            or (:P492_ENVIADOCOBR = 'N' and not exists ( select 1
                                                                           from negociacoesparceiros np
                                                                          where np.idvendedora = v.idvendedora
                                                                            and np.origem      = 'B' ) )   )
                      and ( :P492_ENVIADOSPC = 'A' or nvl(v.spc,'N') = :P492_ENVIADOSPC )
                      and ( :P492_SEXO ='A'        or p.sexo = :P492_SEXO ) 
                -- Solicitado pelo Paulo Saraiva para alterar para saldo
                --      and ( :P492_VALORINI IS NULL or nvl(nv.valortotalnota*nv.fatorconversao,0) between :P492_VALORINI
                --                                                                                     and :P492_VALORFIM) 
                      and ( :P492_VALORINI IS NULL or nvl(nv.saldo*nv.fatorconversao,0) between :P492_VALORINI
                                                                                            and :P492_VALORFIM) 
                      and ( :P492_SMSENVIADO = 'A' or (:P492_SMSENVIADO = 'S' and exists ( select 1
                                                                                               from predisparosms 
                                                                                              where idnotavenda = nv.idnotavenda) ) 
                                                    or (:P492_SMSENVIADO = 'N' and not exists (  select 1
                                                                                               from predisparosms 
                                                                                              where idnotavenda = nv.idnotavenda ) )  ) ;
                   
                  else
                    
                    insert into tmp_predisparosms (id, idpessoa, iddocumento, valor, idfilial, safra, telefone, nomepessoa,
                                                 incluir, usuario, datahoradisp, mensagem, canaldisp, idpais)
                    select rownum
                         , p.idpessoa
                         , pp.idpedido
                         , nvl(pp.saldodevedor*pp.fatorconversao,0) valor
                         , pp.idfilialromance
                         , to_date(to_char(pp.dataemissao,'mm/rrrr'),'mm/rrrr') safra
                         , ( select t.telefone
                               from telefonespessoas t
                              where t.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                             from telefonespessoas tt
                                                            where tt.idpessoa = p.idpessoa 
                                                              and not REGEXP_LIKE(telefone, '(\d)\1\1\1\1\1') ) ) --telefone
                         , p.nomepessoa      --nomepessoa
                         , 'S'               --incluir
                         , v('APP_USER')     --usuario
                         , v_data            --datahora
                         , v_mensagem        --mensagem 
                         , v_canal           --canaldisparo
                         , :P492_IDPAIS
                      from favorita.vw_pedidos_fav pp
                         , catal.vendedoras v
                         , catal.pessoas p
                      where pp.idvendedora = v.idvendedora
                        and v.idpessoa     = p.idpessoa
                        and pp.datacancelamento is null
                        and pp.saldodevedor > 0
                        and p.idpais       = :P492_IDPAIS
                        and ( :P492_PESQUISA is null
                          or ( :P492_PESQUISA = 'A' and extract (year from pp.dataemissao) = :P492_ANO )
                          or ( :P492_PESQUISA = 'P' and pp.dataemissao between to_date(:P492_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') 
                                                                           and to_date(:P492_DATAFIM   ||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) )
                        and ( :P492_IDFILIAL is null or pp.idfilialromance = :P492_IDFILIAL)
                        and ( :P492_DATAINICIO is not null or :P492_IDFILIAL is not null or :P492_ANO is not null )
                        and ( :P492_ENVIADOCOBR = 'A' or pp.enviadocobranca = :P492_ENVIADOCOBR )
                        and ( :P492_ACORDOVIG   = 'A' or (:P492_ENVIADOCOBR = 'S' and exists ( select 1
                                                                                                 from negociacoesparceiros np
                                                                                                where np.idvendedora = v.idvendedora
                                                                                                  and np.origem      = 'B' ) ) 
                                                      or (:P492_ENVIADOCOBR = 'N' and not exists ( select 1
                                                                                                     from negociacoesparceiros np
                                                                                                    where np.idvendedora = v.idvendedora
                                                                                                      and np.origem      = 'B' ) )   )
                        and ( :P492_ENVIADOSPC = 'A' or nvl(v.spc,'N') = :P492_ENVIADOSPC )
                        and ( :P492_SEXO = 'A' OR p.sexo = :P492_SEXO ) 
                -- Solicitado por Paulo Saraiva para pegar saldo devedor
                --        and ( :P492_VALORINI IS NULL or nvl(pp.valorapagar*pp.fatorconversao,0) between :P492_VALORINI
                --                                                                                    and :P492_VALORFIM) 
                        and ( :P492_VALORINI IS NULL or nvl(pp.saldodevedor*pp.fatorconversao,0) between :P492_VALORINI
                                                                                                     and :P492_VALORFIM) 
                        and ( :P492_SMSENVIADO = 'A' or (:P492_SMSENVIADO = 'S' and exists ( select 1
                                                                                               from predisparosms 
                                                                                              where idpedido = pp.idpedido) ) 
                                                     or (:P492_SMSENVIADO = 'N' and not exists (  select 1
                                                                                                    from predisparosms 
                                                                                                   where idpedido = pp.idpedido ) )  ) ;
                
                  end if;
                
                  commit;
                  
                end;
                ```
        }
