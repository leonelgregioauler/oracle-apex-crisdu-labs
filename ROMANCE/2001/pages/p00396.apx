    pageItem P396_AVISO_IMPORTACAO (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 20
            region: @procura-de-distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText:
                ```html
                <font color="GREEN" size="6">
                A troca de regiões só será possível quando o distribuidor estiver já feito o sync da semana atual e antes da liberação da nova semana!
                </font> 
                ```
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where not exists (select 1
                                  from imptablettoservidor
                                  where idrepresentante = :P396_IDREPRESENTANTE)
                 or ( select processo
                        from ( select *
                                from imptablettoservidor
                                where idrepresentante = :P396_IDREPRESENTANTE
                                order by 1 desc) a
                        where rownum = 1 ) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P396_AVISO_REGIAO (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 10
            region: @procura-de-distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText: <font color="red"><h2> Este distribuidor está com região duplicada nos setores de atendimento! Isso causará problemas no tablet! </font></h2>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P396_IDREPRESENTANTE is not null
                  and exists ( select count(1)
                               from regioesrepresentantes rr
                               where rr.idrepresentante = :P396_IDREPRESENTANTE
                               having count(1) > 1
                               group by idregiaovenda )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P396_IDREGIAOREPRESENTANTE (
        type: selectList
        label {
            label: Região
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select rr.semana||' - '||pck_romance.fnc_nomeregiaovenda(rr.idregiaovenda) display_value
                     , rr.idregiaorepresentante return_value
                from regioesrepresentantes rr
                where rr.idrepresentante = :P396_IDREPRESENTANTE
                order by rr.idsemana 
                ```
        }
        cascadingLov {
            parentItems: P396_IDREPRESENTANTE
        }
        layout {
            sequence: 40
            region: @procura-de-distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P396_IDREGIAOVENDA (
        type: popupLov
        label {
            label: Região de Venda Nova
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(idregiaovenda) display_value
                     , r.idregiaovenda return_value
                from regioesvenda r
                where exists ( select 1
                               from filiaisregioesvenda f
                               where f.idfilial = :P0_IDFILIAL
                                 and f.idestado = r.idestado )
                order by 1 
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 60
            region: @procura-de-distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P396_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) nome
                     , idrepresentante id
                from representantes r
                where r.ativo = 'S'
                  and r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 30
            region: @procura-de-distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P396_REALIZAR_TROCA (
        type: radioGroup
        label {
            label: Trocar de Região?
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @procura-de-distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    button aplicar (
        buttonName: APLICAR
        label: Aplicar Troca
        layout {
            sequence: 20
            region: @procura-de-distribuidor
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where not exists (select 1
                                  from imptablettoservidor
                                  where idrepresentante = :P396_IDREPRESENTANTE)
                 or ( select processo
                        from ( select *
                                from imptablettoservidor
                                where idrepresentante = :P396_IDREPRESENTANTE
                                order by 1 desc) a
                        where rownum = 1 ) = 'S'
                ```
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @procura-de-distribuidor
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 36
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction atualiza-regiões (
        name: Atualiza Regiões
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P396_IDREGIAOREPRESENTANTE
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P396_IDREGIAOREPRESENTANTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @notas-da-região
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @regiões-de-atendimento
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction mostra-nova-região (
        name: Mostra nova região
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P396_REALIZAR_TROCA
        }
        clientSideCondition {
            type: item=value
            item: P396_REALIZAR_TROCA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P396_IDREGIAOVENDA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P396_IDREGIAOVENDA
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P396_IDREPRESENTANTE
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P396_IDREPRESENTANTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @procura-de-distribuidor
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation aplicar-troca-de-região (
        name: Aplicar Troca de Região
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P396_IDREGIAOVENDA
        }
        error {
            errorMessage: Antes de aplicar a troca, é necessário escolher uma região!
        }
        serverSideCondition {
            type: request=Value
            value: APLICAR
        }
    )

    process aplicar-atualização-de-regiões (
        name: Aplicar atualização de Regiões
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidregiaoatual number;
                  vsemanaatual   varchar2(15);
                  --
                begin
                  --
                  select idregiaovenda 
                       , vsemanaatual
                  into vidregiaoatual
                     , vsemanaatual
                  from regioesrepresentantes rr
                  where rr.idregiaorepresentante = :P396_IDREGIAOREPRESENTANTE
                    and rr.idrepresentante = :P396_IDREPRESENTANTE;
                  --
                  update regioesrepresentantes r
                  set r.idregiaovenda = :P396_IDREGIAOVENDA
                  where r.idrepresentante = :P396_IDREPRESENTANTE
                    and r.idregiaorepresentante = :P396_IDREGIAOREPRESENTANTE;
                  --
                  commit;
                  --
                  update vendedoras v
                  set v.idregiaovenda = :P396_IDREGIAOVENDA
                  where exists ( select 1
                                 from notasvendas n
                                    , regioesrepresentantes r
                                 where r.idrepresentante = :P396_IDREPRESENTANTE
                                   and r.idregiaorepresentante = :P396_IDREGIAOREPRESENTANTE
                                   and n.idregiaovenda = r.idregiaovenda
                                   and n.idrepresentante = r.idrepresentante
                                   and n.idvendedora = v.idvendedora
                                   and n.idfilial = :P0_IDFILIAL
                                   and n.idsituacaonotavenda = 3
                                   and n.semanacobranca = r.semana );
                  --
                  commit;
                  --
                  update notasvendas n
                  set n.idregiaovenda = :P396_IDREGIAOVENDA
                  where n.idregiaovenda = vidregiaoatual
                    and n.semanacobranca = vsemanaatual
                    and n.idrepresentante = :P396_IDREPRESENTANTE
                    and n.idfilial = :P0_IDFILIAL
                    and n.idsituacaonotavenda = 3;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Semana Atualizada!
        }
        advanced {
            executionMappingIdentifier: 1439068548408488028
        }
        serverSideCondition {
            type: request=Value
            value: APLICAR
        }
    )

    branch (
        name: Go To Page 396
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 396
                items: {
                    P396_IDREPRESENTANTE: &P396_IDREPRESENTANTE.
                    P396_IDREGIAOREPRESENTANTE:
                    P396_REALIZAR_TROCA: &P396_REALIZAR_TROCA.
                    P396_IDREGIAOVENDA:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request!=Value
            value: APLICAR
        }
    )

)

