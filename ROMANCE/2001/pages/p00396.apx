page 396 (
    name: Atualizar Regiões de Distribuidor
    title: Atualizar Regiões de Distribuidor
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region notas-da-região (
        name: Notas da Região
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.numeronota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiao
                     , pck_romance.fnc_nomevendedora(n.idvendedora) vendedora
                     , n.dataretorno
                     , n.valortotalnota
                from notasvendas n
                   , regioesrepresentantes rr
                where rr.idrepresentante       = n.idrepresentante
                  and rr.idrepresentante       = :P396_IDREPRESENTANTE
                  and rr.idregiaorepresentante = :P396_IDREGIAOREPRESENTANTE
                  and n.idfilial               = :P0_IDFILIAL
                  and n.idregiaovenda          = rr.idregiaovenda
                  and n.semanacobranca         = rr.semana
                  and n.idsituacaonotavenda    = 3
                order by idnotavenda
                ```
            pageItemsToSubmit: [
                P396_IDREPRESENTANTE
                P396_IDREGIAOREPRESENTANTE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma nota encontrada para esta região.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1439066859969488011
        }

