page 513 (
    name: Notas para Faturamento
    title: Notas para Faturamento
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_integranota(vidnotavenda,callback_resultado) {
             
              winwidth  = 770;  // largura da nova janela
              winheight = 450;  // altura da nova janela 
              winleft   = 200;  // (nao alterar)
              wintop    = 200;  // (nao alterar)
            
              if(parseInt(navigator.appVersion)>=4) 
              {
                winleft = (screen.width / 2) - (winwidth / 2);  // centro da janela direita para esquerda
                wintop = (screen.height / 2) - (winheight / 2); // centro da janela cima para baixo
              }
                
              var iframe = $("<iframe>");
              window.evento = window.addEventListener("message", function(dados) {
              window.removeEventListener("message", window.evento, true);
              console.log("dados recebidos do filho!");
              console.log(dados);
              dados = JSON.parse(dados.data);
              
              
              if (typeof(dados.ERRO) != "undefined") {
                
                vjanela = window.open('f?p=&APP_ID.:514:&SESSION.::NO:514:P514_IDNOTAVENDA:'+vidnotavenda,'Integracao','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,top='+wintop+',left='+winleft+',width='+winwidth+',height='+winheight+',screenX=50,screenY =100');
            
                vjanela.focus();
              }
                  
              if (typeof(callback_resultado) != "undefined") {
               callback_resultado(dados);
              }
              
              document.location.reload(true);
                  
              $("body").remove(iframe);
              }, true);
              $("body").append(iframe);
              iframe.attr("src", 'https://websocket.romancemoda.com.br/RMC_VA/'+vidnotavenda+"?SISTEMA=true");
            
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region notas-de-vendas-para-integrar (
        name: Notas de Vendas para Integrar
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda 
                     , numeronota
                     , pck_romance.fnc_nomevendedora(idvendedora) consultora
                     , pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                     , dataacerto 
                     , valortotalnota
                     , valortotalvenda
                     , valortotalvendalqd
                     , desconto
                     , case
                         when exists ( select 1
                                       from notasvendas nn
                                        where nn.idnotavenda = nv.idnotavenda 
                                          and nn.idpedidovirtualage is not null ) then
                           ' - '
                         else
                           '<a href="javascript: fnc_integranota('|| idnotavenda ||',function(x){console.log(x)})" ><img src="#APP_IMAGES#ok.png" border="0"></a>' 
                       end integrar
                     , case
                         when exists ( select 1
                                       from notasvendas nn
                                        where nn.idnotavenda = nv.idnotavenda 
                                          and nn.idpedidovirtualage is not null ) then
                           '<font color="green"><b>Integrado Pedido Nr - '||( select idpedidovirtualage
                                                                              from notasvendas nn
                                                                              where nn.idnotavenda = nv.idnotavenda)||'</b></font>'
                         when exists ( select 1
                                       from notasvendas nn
                                        where nn.idnotavenda = nv.idnotavenda 
                                          and nn.idpedidovirtualage is null ) then
                           '<font color="red"><b>Não Interado</b></font>'
                       end situacao
                     , ( select listagg(m.dataintegracao||' - '||m.mensagemintegracaousuario,' ') within group (order by 1)
                         from mensagensintegracaovirtualage m
                         where m.idnotavenda = nv.idnotavenda ) mensagens
                     , ( select idpessoa 
                         from vendedoras v
                         where v.idvendedora = nv.idvendedora ) idpessoavendedora
                     , ( select idpessoa 
                         from representantes r
                         where r.idrepresentante = nv.idrepresentante ) idpessoarepresentante
                from vw_notasvendas_faturar nv
                where nv.idfilial = :P513_IDFILIAL
                  and ( :P513_IDREPRESENTANTE is null or nv.idrepresentante = :P513_IDREPRESENTANTE )
                  and ( :P513_DATAINICIO is null or trunc(nv.dataacerto) between to_date(:P513_DATAINICIO) and to_date(:P513_DATAFIM) )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
