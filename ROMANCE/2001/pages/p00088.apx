    pageItem P88_BUSCA_RAPIDA_CHAMADO (
        type: numberField
        label {
            label: Buscar Ticket Nº
            alignment: left
        }
        layout {
            sequence: 10
            region: @buscar-meu-ticket
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P88_CHAMADO_ENCONTRADO (
        type: hidden
        layout {
            sequence: 20
            region: @buscar-meu-ticket
            slot: regionBody
        }
    )

    pageItem P88_SITUACAO (
        type: radioGroup
        label {
            label: Situação
            alignment: left
        }
        settings {
            noOfCols: 5
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao ||' ['||( select count(1)
                                          from roman.chamados c
                                          where c.usuario = v('APP_USER')
                                            and c.idsituacao = s.idsituacao )||']' display_value
                     , idsituacao return_value
                from situacoes s
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 5
            region: @tickets
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 0
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P88_URL_TICKET (
        type: hidden
        layout {
            sequence: 30
            region: @buscar-meu-ticket
            slot: regionBody
        }
    )

    button btn-buscar-chamado (
        buttonName: BTN_BUSCAR_CHAMADO
        label: Buscar Ticket
        layout {
            sequence: 40
            region: @buscar-meu-ticket
            slot: regionBody
            startNewRow: false
            column: 6
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--gapTop
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @btn-buscar-chamado
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P88_BUSCA_RAPIDA_CHAMADO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      v_existe number;
                      v_url    varchar2(4000);
                    begin
                      select count(*)
                      into v_existe
                      from chamados
                      where idchamado = :P88_BUSCA_RAPIDA_CHAMADO
                        and usuario   = v('APP_USER');
                    
                      if v_existe > 0 then
                        :P88_CHAMADO_ENCONTRADO := 'S';
                        v_url := 'f?p=' || :APP_ID || ':111:' || :APP_SESSION || '::::P111_IDCHAMADO:' || :P88_BUSCA_RAPIDA_CHAMADO;
                        :P88_URL_TICKET := apex_util.prepare_url(v_url);
                      else
                        :P88_CHAMADO_ENCONTRADO := 'N';
                      end if;
                    end;
                    
                    ```
                itemsToSubmit: P88_BUSCA_RAPIDA_CHAMADO
                itemsToReturn: [
                    P88_CHAMADO_ENCONTRADO
                    P88_URL_TICKET
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: window.location.href = $v('P88_URL_TICKET');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P88_CHAMADO_ENCONTRADO
                value: S
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.message.alert('Não foi possível localizar o ticket informado.');
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P88_CHAMADO_ENCONTRADO
                value: N
            }
        )

    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 4
            }
        }
    )

)

