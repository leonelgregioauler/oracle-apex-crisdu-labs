page 88 (
    name: Tickets e Solicitações
    title: Tickets e Solicitações
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function doLoad()
            {
            setTimeout( "refresh()", 120*1000 );
            }
            
            function refresh()
            {
            window.location.href = window.location;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region buscar-meu-ticket (
        name: Buscar meu Ticket
        type: staticContent
