    region tickets-vinculados (
        name: Tickets Vinculados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idchamado
                     , c.dataabertura
                     , pck_romance.fnc_nomefilial(pck_romance.fnc_filialusuario(upper(c.usuario))) "Empresa"
                     , initcap(c.usuario) "Usuário"
                     , pck_chamados.fnc_situacaochamado(c.idsituacao) situacao
                     , c.descricao
                     , c.idtipochamado
                     , pck_chamados.fnc_tipochamado(c.idtipochamado) tipochamado
                     , c.iditemchamado
                     , pck_chamados.fnc_itemchamado(c.iditemchamado) itemchamado
                     , c.idservicochamado
                     , pck_chamados.fnc_servicochamado(c.idservicochamado) servicochamado
                     , ( select count(1) from historicochamados h where h.idchamado = c.idchamado) "Qtd de Históricos"
                     , c.idimpactotrabalho
                     , pck_chamados.fnc_impactochamado(c.idimpactotrabalho) impacto
                     , prioridade
                     , pck_romance.fnc_nomeusuario(responsavel) responsavel
                     , PRAZOATENDIMENTO
                     , PRAZOATENDIMENTO -sysdate prazoestourado
                     , c.dataencerrado
                     , decode(c.complexidade,'ALTA','Alta','MEDIA','Média','BAIXA','Baixa') complexidade
                     , pck_util.fnc_tempodecorrido((dataatendido - datainicioatendimento),'H') temposolucao
                     , pck_util.fnc_tempodecorrido((dataatendido - dataabertura),'H')    tempototal
                     , decode(avaliacaotempo ,'E','Excelente'
                                                    ,'B','Bom'
                                                    ,'R','Regular'
                                                    ,'Z','Ruim') avaliacaotempo
                       , decode(avaliacaoatendimento ,'E','Excelente'
                                                          ,'B','Bom'
                                                          ,'R','Regular'
                                                          ,'Z','Ruim') avaliacaoatendimento
                       , decode(avalcordialidade ,'E','Excelente'
                                                      ,'B','Bom'
                                                      ,'R','Regular'
                                                      ,'Z','Ruim') avalcordialidade
                       , c.datainicioatendimento
                       , c.dataprogramado
                from chamados  c
                where c.idsituacao  not in (40, 2, 21)
                  and idrepresentante is null
                  and exists ( select 1
                                  from usuarioschamados uc
                                  where uc.idchamado  = c.idchamado
                                   and uc.usuario    = V('APP_USER') ) 
                order by 1 desc
                ```
        }
        layout {
            sequence: 40
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 111
                items: {
                    P111_IDCHAMADO: #IDCHAMADO#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 99681894157224601
        }

