page 605 (
    name: Desempenho Distribuidores
    title: Desempenho Distribuidores
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P605_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) distribuidor
                     , r.idrepresentante
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                  and r.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P605_SEMANA_ATE (
        type: selectList
        label {
            label: Até Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta 
                     , s.idsemana
                from semana_dias s
                where s.ano between 2019 and 2021
                order by idsemana
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P605_SEMANA_INICIO (
        type: selectList
        label {
            label: Semana de
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta 
                     , s.idsemana
                from semana_dias s
                where s.ano between 2019 and 2021
                order by idsemana
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P605_TIPO_RELATORIO (
        type: radioGroup
        label {
            label: Tipo de Relatório
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Detalhado por Distribuidor;D,Resumido por Distribuidor;R,Resumido Geral;G
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: D
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction resumido-geral (
        name: Resumido Geral
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P605_TIPO_RELATORIO
        }
        clientSideCondition {
            type: item=value
            item: P605_TIPO_RELATORIO
            value: G
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P605_IDREPRESENTANTE
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P605_IDREPRESENTANTE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

)

