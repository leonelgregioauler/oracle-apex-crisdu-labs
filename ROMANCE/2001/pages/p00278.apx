page 278 (
    name: Relatório de Notas Fiscais
    title: Relatório de Notas Fiscais
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region relatório-de-notas-fiscais (
        name: Relatório de Notas Fiscais
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.idnotafiscal
                     , nf.dtnf
                     , nf.datainclusao
                     , nf.dataconfirmacao
                     , nf.documento
                     , pck_romance.fnc_nomefornecedor(nf.idfornemitente) "Fornecedor"
                     , pck_romance.fnc_nomefilial(nf.idfilialdestino) "Empresa Dest."
                     , pck_romance.fnc_nomeproduto(i.idproduto) "Produto"
                     , i.qtd_total "Total Enviada"
                     , i.qtd_total_chegou "Total Recebida"
                     , i.qtd_total - i.qtd_total_chegou "Diferença"
                from notasfiscais nf
                   , itemnf i
                where nf.idnotafiscal = i.idnotafiscal
                  and nf.situacaofilial = 'R'
                  and nf.emailrecebimento = 'S'
                group by nf.idnotafiscal
                 , nf.dtnf
                 , nf.datainclusao
                 , nf.dataconfirmacao
                 , nf.documento
                 , nf.idfornemitente
                 , nf.idfilialdestino
                 , i.idproduto
                 , i.qtd_total
                 , i.qtd_total_chegou
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
