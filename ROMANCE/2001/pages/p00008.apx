    process processo-dml-em-pessoas (
        name: Processo DML em Pessoas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  --
                  vdatanascimento     date;
                  vultimaatualizacao  date;
                  vdatacadastro       date;
                  --
                  vlimitecredito      number ;
                  --
                  vvendeoutroscatalogos varchar2(1);
                  vobservacaocatalogos  varchar2(1000);
                  --
                begin
                  if v('REQUEST') = 'CREATE' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SAVE' then
                    voperacao_dml := 'U';
                  end if;
                  --
                  vdatanascimento    := to_date(:P8_DATANASCIMENTO    ,'DD/MM/RRRR');
                  vultimaatualizacao := to_date(:P8_ULTIMAATUALIZACAO ,'DD/MM/RRRR HH24:MI:SS');
                  vdatacadastro      := to_date(:P8_DATACADASTRO      ,'DD/MM/RRRR HH24:MI:SS');
                  --
                  favorita.pck_cadastros_fav.prc_pessoas( pidpessoa             => :P8_IDPESSOA,
                                                          pnomepessoa           => :P8_NOMEPESSOA,
                                                          penderecoprincipal    => :P8_ENDERECOPRINCIPAL,
                                                          penderecosecundario   => :P8_ENDERECOSECUNDARIO,
                                                          pidcidade             => :P8_IDCIDADE,
                                                          pemail                => :P8_EMAIL,
                                                          pcpf                  => :P8_CPF,
                                                          pcnpj                 => :P8_CNPJ,
                                                          papelido              => :P8_APELIDO,
                                                          ptipopessoa           => :P8_FISICAJURIDICAESTRANG,
                                                          pobservacao           => :P8_OBSERVACAO,
                                                          preferencia           => :P8_REFERENCIA,
                                                          pativo                => :P8_ATIVO,
                                                          pnumero               => :P8_NUMERO,
                                                          pcomplemento          => :P8_COMPLEMENTO,
                                                          pbairro               => :P8_BAIRRO,
                                                          pcep                  => :P8_CEP,
                                                          prg                   => :P8_RG,
                                                          pcodigosisdist        => :P8_CODIGOSISDIST,
                                                          pdatanascimento       => vdatanascimento,
                                                          pinscricaoestadual    => :P8_INSCRICAOESTADUAL,
                                                          pusuariocadastrou     => :P8_USUARIOCADASTROU,
                                                          pobservacaocobranca   => :P8_OBSERVACAOCOBRANCA,
                                                          pdocumentoestrangeiro => :P8_DOCUMENTOESTRANGEIRO,
                                                          psenhasite            => :P8_SENHASITE,
                                                          plimitecredito        => vlimitecredito,
                                                          pultimaatualizacao    => vultimaatualizacao,
                                                          psexo                 => :P8_SEXO,
                                                          pnroconsultaspc       => :P8_NROCONSULTASPC,
                                                          pdocumentosrecebidos  => :P8_DOCUMENTOSRECEBIDOS,
                                                          pdatacadastro         => vdatacadastro,
                                                          pskype                => :P8_SKYPE,
                                                          psenhaskype           => :P8_SENHASKYPE,
                                                          psenhaemail           => :P8_SENHAEMAIL,
                                                          pobservacaoti         => :P8_OBSERVACAOTI,
                                                          pobservacaocallcenter => :P8_OBSERVACAOCALLCENTER,
                                                          pidpais               => :P8_IDPAIS,
                                                          pvendeoutroscatalogos => vvendeoutroscatalogos,
                                                          pobservacaocatalogos  => vobservacaocatalogos,
                                                          pobservacaointerna    => :P8_OBSERVACAOINTERNA,
                                                          pmd5                  => :P8_MD5,
                                                          poperacao_dml         => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1411804244787104239
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CREATE','SAVE')
                ```
        }
    )

