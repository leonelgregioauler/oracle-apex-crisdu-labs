    button integracao-homologacao (
        buttonName: INTEGRACAO_HOMOLOGACAO
        label: Integrar HMG
        layout {
            sequence: 70
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript: AtivarIntegracaoVirtualAgeHML(function(x){console.log(x)})"
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vhostname   varchar2(20);
                  vacessoliberado varchar2(1);
                begin
                  --
                  select sys_context('USERENV','SERVER_HOST') 
                  into vhostname
                  from dual;
                  --
                  select pck_util.fnc_verificaacesso (2421, v('APP_USER')) acessoliberado
                  into vacessoliberado
                  from dual;
                  --
                  -- HOMOLOGAÇÃO
                  if vhostname = 'srvbd02' and vacessoliberado = 'S' then
                    return true;
                  -- PRODUÇÃO
                  elsif vhostname = 'srvbd01' then
                    return false;
                  end if;
                  --
                end;
                ```
        }
    )

    button integracao-producao (
