    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG_21"';
            
            function validadocumento()
            { 
              var get = new htmldb_Get(null,&APP_ID.,'APPLICATION_PROCESS=validacpfcnpj',0);
              
               pValue  = 'F';
               void(0);
               pVCPF    = html_GetElement('P85_CPF').value;
               void(0);
                
               if (!!pVCPF){
                   get.add('F10008TIPO',pValue ); 
                   get.add('F10008CPF',pVCPF    );
                   gReturn = get.get();
                   if(gReturn=='V'){
                       html_GetElement('P85_VALIDO').value = 'S';
                   }
                   else{
                       if (pValue == 'F'){
                          alert('CPF é inválido!');
                       }
                       html_GetElement('P8_VALIDO').value = 'N';
                   }  
               get = null;
               }
            }
            
            function fnc_popup_pontosh()
            {vidvend = document.getElementById("P8_IDVENDEDORACAD").value;
            njan = window.open('f?p=&APP_ID.:179:&SESSION.::NO::P179_IDVENDEDORA:'+vidvend ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=400,left=250,top=100','_blank'); void(0);
            njan.focus();
            }
            
            function AtivarIntegracaoVirtualAgeHML(callback_resultado) {
              var documento;
              
              if  (document.getElementById('P8_FISICA_JURIDICA_0').checked)
                {
                  TIPOPESSOA = document.getElementById('P8_FISICA_JURIDICA_0').value;
                }
              if (document.getElementById('P8_FISICA_JURIDICA_1').checked)
                {
                  TIPOPESSOA = document.getElementById('P8_FISICA_JURIDICA_1').value;
                }
              void(0);
              CPF = document.getElementById('P8_CPF').value;
              CNPJ = document.getElementById('P8_CNPJ').value;
              
              var winwidth  = 770;  // largura da nova janela
              var winheight = 450;  // altura da nova janela 
              var winleft   = 200;  // (nao alterar)
              var wintop    = 200;  // (nao alterar)
              
              if (TIPOPESSOA == "F") {
                var documento = CPF;
              }
              else {
                var documento = CNPJ;     
              }
            
              if (parseInt(navigator.appVersion)>=4) {
                winleft = (screen.width / 2) - (winwidth / 2);  // centro da janela direita para esquerda
                wintop = (screen.height / 2) - (winheight / 2); // centro da janela cima para baixo
              }
             
              var iframe = $("<iframe>");
              window.evento = window.addEventListener("message", function(dados) {
                                window.removeEventListener("message", window.evento, true);
                                console.log("dados recebidos do filho!");
                                console.log(dados);
                                var dados = JSON.parse(dados.data);
            
                                if (typeof(dados.ERRO) != "undefined") {
                                  vendereco = document.getElementById("P8_SESSION_INTEGRAR").value;
                                  vjanela = window.open(vendereco, '_blank', 'top=' + wintop + ',left=' + winleft + ',height=' + winheight + ',width=' + winwidth); 
                                  vjanela.focus();
                                }
            
                                if (typeof(callback_resultado) != "undefined") {
                                 callback_resultado(dados);
                                }
                                  
                                $("body").remove(iframe);
                              }, true);
              
              $("body").append(iframe);
              iframe.attr("src", 
                'https://dev_ws.catalogofavorita.com.br/executar/integracao_va/cadastrar_pessoa_va?str={"CPF_CNPJ":" ' 
                + documento + '","SISTEMA":true}');
            }
                
            function AtivarIntegracaoVirtualAgePRD(callback_resultado) {
              
              var documento;
              
              if  (document.getElementById('P8_FISICA_JURIDICA_0').checked)
                {
                  TIPOPESSOA = document.getElementById('P8_FISICA_JURIDICA_0').value;
                }
              if (document.getElementById('P8_FISICA_JURIDICA_1').checked)
                {
                  TIPOPESSOA = document.getElementById('P8_FISICA_JURIDICA_1').value;
                }
              void(0);
              CPF = document.getElementById('P8_CPF').value;
              CNPJ = document.getElementById('P8_CNPJ').value;
              
              var winwidth  = 770;  // largura da nova janela
              var winheight = 450;  // altura da nova janela 
              var winleft   = 200;  // (nao alterar)
              var wintop    = 200;  // (nao alterar)
              
              if (TIPOPESSOA == "F") {
                var documento = CPF;
              }
              else {
                var documento = CNPJ;     
              }
            
              if (parseInt(navigator.appVersion)>=4) {
                winleft = (screen.width / 2) - (winwidth / 2);  // centro da janela direita para esquerda
                wintop = (screen.height / 2) - (winheight / 2); // centro da janela cima para baixo
              }
             
              var iframe = $("<iframe>");
              window.evento = window.addEventListener("message", function(dados) {
                                window.removeEventListener("message", window.evento, true);
                                console.log("dados recebidos do filho!");
                                console.log(dados);
                                var dados = JSON.parse(dados.data);
            
                                if (typeof(dados.ERRO) != "undefined") {
                                  vendereco = document.getElementById("P8_SESSION_INTEGRAR").value;
                                  vjanela = window.open(vendereco, '_blank', 'top=' + wintop + ',left=' + winleft + ',height=' + winheight + ',width=' + winwidth); 
                                  vjanela.focus();
                                }
            
                                if (typeof(callback_resultado) != "undefined") {
                                 callback_resultado(dados);
                                }
                                  
                                $("body").remove(iframe);
                              }, true);
              
              $("body").append(iframe);
              iframe.attr("src", 
                'https://ws.catalogofavorita.com.br/executar/integracao_va/cadastrar_pessoa_va?str={"CPF_CNPJ":" ' 
                + documento + '","SISTEMA":true}');
              
            }
            
