    process consulta-em-pessoas (
        name: Consulta em pessoas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  --
                  vdatanascimento     date;
                  vultimaatualizacao  date;
                  vdatacadastro       date;
                  --
                  vcpf                varchar2(15);
                  vcnpj               varchar2(18);
                  vcep                varchar2(20);
                  --
                  vvendeoutroscatalogos varchar2(1);
                  vobservacaocatalogos  varchar2(1000);
                  --
                  vlimitecredito      number := 0;
                  --
                begin
                  --
                  favorita.pck_cadastros_fav.prc_pessoas( pidpessoa             => :P8_IDPESSOA,
                                                          pnomepessoa           => :P8_NOMEPESSOA,
                                                          penderecoprincipal    => :P8_ENDERECOPRINCIPAL,
                                                          penderecosecundario   => :P8_ENDERECOSECUNDARIO,
                                                          pidcidade             => :P8_IDCIDADE,
                                                          pemail                => :P8_EMAIL,
                                                          pcpf                  => vcpf,
                                                          pcnpj                 => vcnpj,
                                                          papelido              => :P8_APELIDO,
                                                          ptipopessoa           => :P8_FISICAJURIDICAESTRANG,
                                                          pobservacao           => :P8_OBSERVACAO,
                                                          preferencia           => :P8_REFERENCIA,
                                                          pativo                => :P8_ATIVO,
                                                          pnumero               => :P8_NUMERO,
                                                          pcomplemento          => :P8_COMPLEMENTO,
                                                          pbairro               => :P8_BAIRRO,
                                                          pcep                  => vcep,
                                                          prg                   => :P8_RG,
                                                          pcodigosisdist        => :P8_CODIGOSISDIST,
                                                          pdatanascimento       => vdatanascimento,
                                                          pinscricaoestadual    => :P8_INSCRICAOESTADUAL,
                                                          pusuariocadastrou     => :P8_USUARIOCADASTROU,
                                                          pobservacaocobranca   => :P8_OBSERVACAOCOBRANCA,
                                                          pdocumentoestrangeiro => :P8_DOCUMENTOESTRANGEIRO,
                                                          psenhasite            => :P8_SENHASITE,
                                                          plimitecredito        => vlimitecredito,
                                                          pultimaatualizacao    => vultimaatualizacao,
                                                          psexo                 => :P8_SEXO,
                                                          pnroconsultaspc       => :P8_NROCONSULTASPC,
                                                          pdocumentosrecebidos  => :P8_DOCUMENTOSRECEBIDOS,
                                                          pdatacadastro         => vdatacadastro,
                                                          pskype                => :P8_SKYPE,
                                                          psenhaskype           => :P8_SENHASKYPE,
                                                          psenhaemail           => :P8_SENHAEMAIL,
                                                          pobservacaoti         => :P8_OBSERVACAOTI,
                                                          pobservacaocallcenter => :P8_OBSERVACAOCALLCENTER,
                                                          pidpais               => :P8_IDPAIS,
                                                          pvendeoutroscatalogos => vvendeoutroscatalogos,
                                                          pobservacaocatalogos  => vobservacaocatalogos,
                                                          pobservacaointerna    => :P8_OBSERVACAOINTERNA,
                                                          pmd5                  => :P8_MD5,
                                                          poperacao_dml         => 'S');
                  --
                  :P8_DATANASCIMENTO    := to_char(vdatanascimento   ,'DD/MM/RRRR');
                  :P8_ULTIMAATUALIZACAO := to_char(vultimaatualizacao,'DD/MM/RRRR HH24:MI:SS');
                  :P8_DATACADASTRO      := to_char(vdatacadastro     ,'DD/MM/RRRR HH24:MI:SS');
                  --
                  :P8_CPF               := REGEXP_REPLACE(vcpf,  '^(\d{3})(\d{3})(\d{3})(\d{2})$', '\1.\2.\3-\4');
                  --:P8_CNPJ              := REGEXP_REPLACE(vcnpj, '^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$', '\1.\2.\3/\4-\5');
                  :P8_CNPJ := REGEXP_REPLACE(vcnpj, '^([A-Z0-9]{2})([A-Z0-9]{3})([A-Z0-9]{3})([A-Z0-9]{4})(\d{2})$', '\1.\2.\3/\4-\5', 1, 1, 'i');  
                              -- flag 'i' para case-insensitive
                  --
                  :P8_CEP               := REGEXP_REPLACE(vcep,  '^(\d{2})(\d{3})(\d{3})$', '\1.\2-\3');
                  --
                  begin
                      select p.observacaointerna
                        into :P8_OBSERVACAOINTERNA
                        from catal.pessoas p
                       where p.idpessoa = :P8_IDPESSOA;
                  exception
                      when others then
                         :P8_IDPESSOA := null;
                  end;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1411804344703104240
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDpessoa.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P8_IDPESSOA := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 30
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 11035478258672992
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

