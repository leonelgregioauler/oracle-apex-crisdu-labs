    pageItem P8_IDPAIS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 430
            region: @cadastro-de-pessoas
            slot: regionBody
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vidpais number;
                begin
                  --
                  select f.ididioma
                  into vidpais
                  from vw_filiais f
                  where f.idgerente = ( select idgerente
                                        from usuarios u
                                        where u.usuario = v('APP_USER') );
                  --
                  return vidpais;
                  --
                exception
                  when others then
                    return 1;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

