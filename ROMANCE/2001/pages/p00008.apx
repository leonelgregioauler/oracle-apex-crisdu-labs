    pageItem P8_SESSION_INTEGRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 400
            region: @cadastro-de-pessoas
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2001;
                    l_session number := v('APP_SESSION');
                    vdocumento varchar2(20);
                BEGIN
                    if :P8_FISICA_JURIDICA = 'F' then
                      vdocumento := :P8_CPF;
                    else 
                      vdocumento := :P8_CNPJ;
                    end if;
                    --
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':349:'||l_session||'::NO::P349_DOCUMENTO:'||vdocumento);
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

