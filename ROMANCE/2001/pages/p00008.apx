    validation cep-dentro-do-range-da-cidade (
        name: CEP dentro do range da cidade
        execution {
            sequence: 55
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  l_cep_num VARCHAR2(20);
                  l_count   NUMBER;
                BEGIN
                  IF :P8_CEP IS NULL OR :P8_IDCIDADE IS NULL THEN
                    RETURN TRUE;
                  END IF;
                  l_cep_num := REGEXP_REPLACE(:P8_CEP, '[^0-9]', '');
                  SELECT COUNT(*)
                    INTO l_count
                    FROM catal.cidades
                   WHERE idcidade  = :P8_IDCIDADE
                     AND l_cep_num BETWEEN cepinicial AND cepfinal;
                  RETURN l_count > 0;
                END;
                ```
        }
        error {
            errorMessage: CEP informado não pertence a região da cidade selecionada.
            associatedItem: @P8_CEP
        }
        serverSideCondition {
            type: item!=value
            item: P8_FISICAJURIDICAESTRANG
            value: D
        }
    )

    validation idoperadoratel-must-be-numeric (
        name: IDOPERADORATEL must be numeric
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @telefones
            type: columnIsNumeric
            column: IDOPERADORATEL
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDOPERADORATEL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation p8-cep (
        name: P8_CEP
        execution {
            sequence: 50
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vteste number := 0;
                  vpais  number := 0;
                  --
                Begin
                  --
                  begin
                    --
                    select 1
                    into vteste
                    from roman.vw_filiais
                    where idgrupo = 5
                      and idfilial = :P0_IDFILIAL;
                    --
                    exception
                      when others then
                        vteste := 0;
                    --
                  end;
                		--
                		if vteste = 0 and :P8_CEP is null then
                		  --
                		  RETURN '<font color="red">CEP Invalido.<font color="red">';
                		  --
                		end if;
                  --
                end;
                ```
        }
    )

    validation p8-cpf (
        name: P8_CPF
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from pessoas 
                where cpf = replace(replace(replace(replace(replace(replace(:P8_CPF,'.',''),'-',''),' ',''),'.',''),'-',''),' ','')
                  and ( :P8_IDPESSOA is null or idpessoa != :P8_IDPESSOA )
                ```
        }
        error {
            errorMessage: CPF já está cadastrado!
            associatedItem: @P8_CPF
        }
        serverSideCondition {
            type: item=value
            item: P8_FISICAJURIDICAESTRANG
            value: F
        }
    )

