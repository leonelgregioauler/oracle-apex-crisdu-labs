    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 40
            region: @telefones
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectUrl
