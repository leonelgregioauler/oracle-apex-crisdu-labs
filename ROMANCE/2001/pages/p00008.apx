        headerAndFooter {
            headerText:
                ```html
                <script language="Javascript">
                function formatar_mascara_cpf_load()
                {
                 var campo = document.getElementById("P8_CPF");  
                 var texto = document.getElementById("P8_CPF").value;
                 var letra = "."; 
                 posicao = texto.indexOf(letra);
                 if ( posicao < 0 )
                   {
                     var formatado = texto.substring(0,3)+'.'+texto.substring(3,6)+'.'+texto.substring(6,9)+'-'+texto.substring(9,11);
                     campo.value = formatado;
                   }
                }
                function formatar_mascara_cnpj_load()
                {
                 var campo = document.getElementById("P8_CNPJ");  
                 var texto = document.getElementById("P8_CNPJ").value;
                 var letra = "."; 
                 posicao = texto.indexOf(letra);
                 if ( posicao < 0 )
                   {
                     var formatado = texto.substring(0,2)+'.'+texto.substring(2,5)+'.'+texto.substring(5,8)+'/'+texto.substring(8,12)+'-'+texto.substring(12,14);
                     campo.value = formatado;
                   }
                }
                
                function formatar_mascara(src,mascara,evt){
                var tecla;  
                if(evt.which){tecla = evt.which}
                else if(evt.keyCode){ tecla = evt.keyCode;}  
                 if( tecla != 8 ){
                 var campo = src.value.length;
                 var saida = mascara.substring(0,1);
                 var texto = mascara.substring(campo);
                 if(texto.substring(0,1) != saida) {
                 src.value+=texto.substring(0,1);}}
                }
                
                
                </script>
                ```
            footerText:
                ```html
                <script language="Javascript">
                
                function fnc_popup_pontos()
                {vidvend = document.getElementById("P8_IDVENDEDORACAD").value;
                njan = window.open('f?p=&APP_ID.:162:&SESSION.::NO::P162_IDVENDEDORA,P162_IDMOVTOPONTOSVEND:'+vidvend +',','page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=180,left=250,top=100','_blank'); void(0);
                njan.focus();
                }
                
                function fnc_formatacep(campo, teclapres)
                {  var tecla = teclapres.keyCode;
                  var vr = new String(campo.value);
                  vr = vr.replace("-", "");
                  tam = vr.length + 1;
                  if (tecla != 8)
                  { if (tam == 6)
                    campo.value = vr.substr(0, 5) + '-' + vr.substr(5, 5);  }
                }
                function fnc_telefone(objeto)
                {  if(objeto.value.length == 0)
                     objeto.value = '(' + objeto.value;
                if(objeto.value.length == 3)
                objeto.value = objeto.value + ')';
                
                if(objeto.value.length == 8)
                objeto.value = objeto.value + '-';}
                </script>
                ```
        }
    )

    region fotos-de-documentos (
        name: Fotos de Documentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.tipofoto
                     , decode(f.recebida,'S','Sim','N','Não') recebida
                     , f.datadadosrecebido
                     , null verfoto
                     , nomearquivo
                from roman.fotosdocumentos f
                where (f.idpessoa = :P8_IDPESSOA
                   or  f.documento = nvl(:P8_CPF,:P8_DOCUMENTOESTRANGEIRO))
                order by 1
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.fotosdocumentos f
                where --f.idpessoa = :P8_IDPESSOA
                      (f.idpessoa = :P8_IDPESSOA
                   or  f.documento = nvl(:P8_CPF,:P8_DOCUMENTOESTRANGEIRO))
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
