    region telefones (
        name: Telefones
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDTELEFONEPESSOA",
                "IDTELEFONEPESSOA" IDTELEFONEPESSOA_DISPLAY,
                "IDPESSOA",
                "IDOPERADORATEL",
                "TELEFONE",
                (
                  select case
                           when pa.codigotelefone is not null
                                and regexp_replace(t."TELEFONE",'[^0-9]','') like pa.codigotelefone || '%'
                           then '+' || pa.codigotelefone || ' ' ||
                                substr(regexp_replace(t."TELEFONE",'[^0-9]',''), length(pa.codigotelefone) + 1)
                           else t."TELEFONE"
                         end
                    from catal.pessoas p
                    join catal.paises  pa on pa.idpais = p.idpais
                   where p.idpessoa = t."IDPESSOA"
                ) as TELEFONE_FORMATADO,
                "ULTIMAATUALIZACAO",
                "OBSERVACAO",
                "PRIORIDADE",
                "WHATSAPP",
                "ENVIOSMS"
                from "CATAL"."TELEFONESPESSOAS" t
                where idpessoa = :P8_IDPESSOA
                order by ULTIMAATUALIZACAO
                ```
        }
