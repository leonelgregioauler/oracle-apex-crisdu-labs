    pageItem P8_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomecidade(idcidade)  display_value
                     , c.IDCIDADE return_value 
                from CIDADES c
                   , filiaisregioesvenda f
                   , estados e
                where f.idfilial = :P0_IDFILIAL
                  and f.idestado = e.idestado
                  and e.idestado = c.idestado
                union
                select pck_romance.fnc_nomecidade(idcidade)  display_value
                     , c.IDCIDADE return_value 
                from CIDADES c
                where :P8_IDGRUPOATENDIMENTO in (22,0,3,4)
                ```
            nullDisplayValue: "   "
        }
        cascadingLov {
            parentItems: P8_IDGRUPOATENDIMENTO
        }
        layout {
            sequence: 220
            region: @cadastro-de-pessoas
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

