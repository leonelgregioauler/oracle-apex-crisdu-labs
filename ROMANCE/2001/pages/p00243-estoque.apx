    pageItem P243_IDREPRESENTANTE_TROCA (
        type: selectOne
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' - '||r.idrepresentante display_value
                     , r.idrepresentante
                from representantes r
                   , pessoas p
                   , gerentes g
                where g.idgerente = r.idgerente
                  and r.ativo = 'S'
                  and r.idpostoavancado = 1
                  and p.idpessoa = r.idpessoa
                  and g.idfilial = :P0_IDFILIAL
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @mudar-distribuidor-de-franquia
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
        }
    )

