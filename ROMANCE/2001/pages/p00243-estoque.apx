    process insere-devolução-como-carga-mais (
        name: Insere Devolução como Carga Mais
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  viddevolucao number := :P243_IDDEV_DC;
                  vidcarga     number := :P243_IDCARGA_DC;
                begin
                  --
                  if :P243_TIPO = 'P' then
                    --
                    insert into itenscargarepresentante (iditemcargarepres, idcargarepresentante, idestoquefil,
                                                         valorvenda,        idproduto,            comissao,
                                                         cargaamais,        qtd_dist_pp,          qtd_dist_p,
                                                         qtd_dist_m,        qtd_dist_g,           qtd_dist_gg,
                                                         qtd_dist_egg,      qtd_dist_u,           estoquemovto,
                                                         qtd_dist_exgg,     idpostoavancado)
                    select seq_iditcargarepres.nextval, vidcarga       , i.idestoquefil
                         , i.valorproduto             , i.idproduto    , i.comissao
                         , 'S'                        , i.qtd_pp       , i.qtd_p
                         , i.qtd_m                    , i.qtd_g        , i.qtd_gg
                         , i.qtd_egg                  , i.qtd_u        , 'P'
                         , i.qtd_exgg                 , i.idpostoavancado
                    from itensdevolucaorepres i
                    where i.iddevolucaorepres = viddevolucao ;
                    --
                  elsif :P243_TIPO = 'D' then
                    --
                    pck_estoque.prc_inseredevnacarga(piddevolucao => :P243_IDDEV_DC,
                                                     pidcargarepres => :P243_IDCARGA_DC);
                    --
                  end if;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 110
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 3365369705409408520
        }
        serverSideCondition {
            type: request=Value
            value: FINALIZAR_DEV_CARGA
        }
    )

