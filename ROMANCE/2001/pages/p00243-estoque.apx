    process transferir-carga (
        name: transferir carga
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P243_TIPOSEMANA = 'S' then
                    --
                    update cargasrepresentantes
                    set idrepresentante = :P243_IDREPRESDEST
                      , observacao = observacao||'Carga transferida do '||pck_romance.fnc_nomerepresentante(:P243_IDREPRESORIG)||' para o '||pck_romance.fnc_nomerepresentante(:P243_IDREPRESDEST)
                    where idcargarepresentante = :P243_IDCARGAREPRES;
                    --
                  else
                    --
                    
                    insert into roman.log_para_debug (coluna1,coluna2,coluna3) values(SYSTIMESTAMP,:P243_IDCARGAREPRES,'Carga transferida do '||pck_romance.fnc_nomerepresentante(:P243_IDREPRESORIG)||' para o '||pck_romance.fnc_nomerepresentante(:P243_IDREPRESDEST)); commit;
                    
                    
                    update cargasrepresentantes
                    set idrepresentante = :P243_IDREPRESDEST
                      , semana = :P243_SEMANA
                      , idsemana = pck_util.fnc_idsemana(:P243_SEMANA)
                      , idregiaovenda = ( select idregiaovenda from regioesrepresentantes where semana = :P243_SEMANA and idrepresentante = :P243_IDREPRESDEST )
                      , observacao = observacao||'Carga transferida do '||pck_romance.fnc_nomerepresentante(:P243_IDREPRESORIG)||' para o '||pck_romance.fnc_nomerepresentante(:P243_IDREPRESDEST)
                    where idcargarepresentante = :P243_IDCARGAREPRES;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: Carga Transferida!
        }
        advanced {
            executionMappingIdentifier: 231220114804716520
        }
        serverSideCondition {
            type: request=Value
            value: TRANSFERIR
        }
    )

