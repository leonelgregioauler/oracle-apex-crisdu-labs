    pageItem P243_IDFILIAL_1 (
        type: selectList
        label {
            label: Franquia Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                ```
        }
        layout {
            sequence: 20
            region: @gerar-transferência-por-devolução
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P243_IDFILIAL_TRANSFERIR (
        type: selectList
        label {
            label: Franquia a Transferir
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome 
                     , idfilial
                from vw_filiais
                where idfilial = 1281
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @transferir-carga-de-franquia
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P243_IDFILIAL_TROCA (
        type: selectOne
        label {
            label: Franquia Nova
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome display_value
                     , f.idfilial return_value
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo < 5
                  and f.idfilial = 1281
                ```
        }
        layout {
            sequence: 20
            region: @mudar-distribuidor-de-franquia
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
