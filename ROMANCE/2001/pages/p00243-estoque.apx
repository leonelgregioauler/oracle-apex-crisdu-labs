    pageItem P243_IDREPRESDEST (
        type: selectList
        label {
            label: Distribuidor Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select pck_romance.fnc_nomerepresentante(r.idrepresentante) display_value
                 , r.idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 50
            region: @transferência-de-cargas-entre-distribuidores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

