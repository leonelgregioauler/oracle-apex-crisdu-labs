    pageItem P243_INFO_DEV_DC (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Sem: '||d.semana||' - '||pck_romance.fnc_nomerepresentante(d.idrepresentante) display_value
                     , 0 return_value
                from devolucoesrepresentantes d
                where d.iddevolucaorepres = :P243_IDDEV_DC
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P243_IDDEV_DC
        }
        layout {
            sequence: 50
            region: @incluir-devolução-como-carga-mais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

