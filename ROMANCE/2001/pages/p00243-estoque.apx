    pageItem P243_IDREPRESENTANTE_CARGA_4 (
        type: selectList
        label {
            label: Distribuidor da Carga
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Sem: '||d.semana||' - '||pck_romance.fnc_nomerepresentante(d.idrepresentante) display_value
                     , 0 return_value
                from cargasrepresentantes d
                where d.idcargarepresentante = :P243_IDCARGA_4
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P243_IDCARGA_4
        }
        layout {
            sequence: 30
            region: @gerar-carga-mais-por-transferência
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P243_IDREPRESENTANTE_D (
        type: selectList
        label {
            label: Distribuidor Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select pck_romance.fnc_nomerepresentante(r.idrepresentante) display_value
                 , r.idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                  and r.idrepresentante != :P243_IDREPRESENTANTE_O
                order by 1
                ```
        }
        cascadingLov {
            parentItems: [
                P0_IDFILIAL
                P243_IDREPRESENTANTE_O
            ]
        }
        layout {
            sequence: 30
            region: @transferência-de-devolução-entre-distribuidores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P243_IDREPRESENTANTE_DEV (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select pck_romance.fnc_nomerepresentante(r.idrepresentante) display_value
                 , r.idrepresentante return_value
                from representantes r
                where r.idrepresentante = (select idrepresentante 
                                           from devolucoesrepresentantes r 
                                           where r.iddevolucaorepres = :P243_IDDEVOLUCAO_CONC)
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
