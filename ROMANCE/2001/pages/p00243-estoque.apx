    validation valida-inclusão-de-dev-na-carga (
        name: Valida Inclusão de DEV na Carga
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P243_TIPO
        }
        error {
            errorMessage: Por favor, informe qual tipo de estoque da Devolução.
        }
        serverSideCondition {
            type: request=Value
            value: FINALIZAR_DEV_CARGA
        }
    )

    validation valida-inserir-dev-na-carga (
        name: Valida Inserir DEV na CARGA
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from itensdevolucaorepres i
                               where i.iddevolucaorepres = :P243_IDDEV_DC
                                 and i.estoquedestino in ('F','R') )
                ```
        }
        error {
            errorMessage: Não é possível utilizar esta devolução, ela contem produtos para Reembalagem ou Defeito
        }
        serverSideCondition {
            type: request=Value
            value: FINALIZAR_DEV_CARGA
        }
    )

    validation valida-transf-de-dev (
        name: Valida Transf de DEV
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P243_IDDEVOLUCAO_1
        }
        error {
            errorMessage: Por favor, informe a devolução
        }
        serverSideCondition {
            type: request=Value
            value: PROCESSAR_1
        }
    )

    validation valida-transf-de-dev-2 (
        name: Valida Transf de DEV_1
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P243_IDFILIAL_1
        }
        error {
            errorMessage: Por favor, informe a Franquia
        }
        serverSideCondition {
            type: request=Value
            value: PROCESSAR_1
        }
    )

    validation valida-troca-de-distribuidor (
        name: Valida Troca de Distribuidor
        execution {
            sequence: 50
        }
        validation {
            type: itemIsNotNull
            item: P243_IDREPRESENTANTE_TROCA
        }
        error {
            errorMessage: Por favor, selecione o Distribuidor!
            associatedItem: @P243_IDREPRESENTANTE_TROCA
        }
        serverSideCondition {
            whenButtonPressed: @processar-troca
        }
    )

    validation valida-troca-de-distribuidor-franquia (
        name: Valida Troca de Distribuidor - Franquia
        execution {
            sequence: 60
        }
        validation {
            type: itemIsNotNull
            item: P243_IDFILIAL_TROCA
        }
        error {
            errorMessage: Por favor, selecione a Franquia!
            associatedItem: @P243_IDFILIAL_TROCA
        }
        serverSideCondition {
            whenButtonPressed: @processar-troca
        }
    )

    process atualiza-estoque-pa (
        name: Atualiza estoque PA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_estoque.prc_geraestoquepostoavancado;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 90
        }
        successMessage {
            successMessage: Estoque Gerado/Atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 3204454517000048011
        }
        serverSideCondition {
            type: request=Value
            value: P243_ATUALIZAR_ESTOQUE_PA
        }
    )

    process conclui-devolução-de-distribuidor (
