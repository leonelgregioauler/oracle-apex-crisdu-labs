    pageItem P243_SEMANA_ATUAL (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.semana
                     , d.idsemana
                from devolucoesrepresentantes d
                where d.iddevolucaorepres = :P243_IDDEVOLUCAO 
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P243_IDDEVOLUCAO
        }
        layout {
            sequence: 30
            region: @transferência-de-devolução-de-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P243_SEMANA_NOVA (
        type: selectList
        label {
            label: Semana Nova
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano d
                     , idsemana  r
                from semana_dias s
                where idsemana between pck_util.fnc_idsemanadata(sysdate)-30 and pck_util.fnc_idsemanadata(sysdate)
                order by s.idsemana desc
                ```
        }
        cascadingLov {
            parentItems: P243_IDDEVOLUCAO
        }
        layout {
            sequence: 40
            region: @transferência-de-devolução-de-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

