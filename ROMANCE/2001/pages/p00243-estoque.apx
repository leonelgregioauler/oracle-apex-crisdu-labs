        clientSideCondition {
            type: item=value
            item: P243_TIPOSEMANA
            value: E
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P243_SEMANA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P243_SEMANA
            }
            execution {
                sequence: 10
            }
        )

    )

