    dynamicAction conclui-devolução (
        name: Conclui Devolução
        execution {
            sequence: 110
        }
        when {
            event: click
            selectionType: button
            button: @concluir-devolucao
        }

        action native-confirm (
            action: confirm
            settings {
                message: Deseja realmente concluir esta devolução?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CONCLUI_DEVOLUCAO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

