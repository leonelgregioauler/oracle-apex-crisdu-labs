    region desempenho-empresa (
        name: Desempenho Empresa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct  f.nome
                     , f.semana semananum
                     --
                     -- , s3.totalgeral geral2022
                     -- , s3.notasnovas notas2022
                     -- , s3.notasatendidas atendidas2022
                     -- , s3.qtdacertos acertos2022
                     --, s6.qtd notasecommerce2022
                     --, s6.valorpago valorecommerce2022
                     --
                     --, s1.totalgeral geral2023
                     --, s1.notasnovas notas2023
                     --, s1.notasatendidas atendidas2023
                     --, s1.qtdacertos acertos2023
                     --, s101.qtd notasecommerce2023
                     --, s101.valorpago valorecommerce2023
                     --
                     , s2.totalgeral geral2024
                     , s2.notasnovas notas2024
                     , s2.notasatendidas atendidas2024
                     , s2.qtdacertos acertos2024
                     , s102.qtd notasecommerce2024
                     , s102.valorpago valorecommerce2024
                     --
                     -- 2025
                     , s3.totalgeral geral2025
                     , s3.notasnovas notas2025
                     , s3.notasatendidas atendidas2025
                     , s3.qtdacertos acertos2025
                     , s103.qtd notasecommerce2025
                     , s103.valorpago valorecommerce2025
                
                     -- 2026
                     , s4.totalgeral geral2026
                     , s4.notasnovas notas2026
                     , s4.notasatendidas atendidas2026
                     , s4.qtdacertos acertos2026
                     , s104.qtd notasecommerce2026
                     , s104.valorpago valorecommerce2026
                
                     -- 2023
                     /*, round(( (s1.totalgeral/s3.totalgeral ) -1)*100,2) crescimentocob2023
                     , round(( (s1.notasnovas/s3.notasnovas ) -1)*100,2) crescimentonotas2023
                     , round(( (s1.notasatendidas/s3.notasatendidas ) -1)*100,2) crescimentoatendidas2023
                     , round(( (s1.qtdacertos/s3.qtdacertos ) -1)*100,2) crescimentoacertos2023
                     , round(( (s101.qtd/s6.qtd ) -1)*100,2) crescnotasecommerce2023
                     , round(( (s101.valorpago/s6.valorpago ) -1)*100,2) crescvalorecommerce2023
                     -- 2024
                     , round(( (decode(s1.totalgeral,0,0, s2.totalgeral /s1.totalgeral )) -1)*100,2) crescimentocob2024
                     , round(( (decode(s1.notasnovas,0,0, s2.notasnovas/s1.notasnovas) ) -1)*100,2) crescimentonotas2024
                     , round(( (decode(s1.notasatendidas,0,0, s2.notasatendidas/s1.notasatendidas) ) -1)*100,2) crescimentoatendidas2024
                     , round(( (s2.qtdacertos/s1.qtdacertos ) -1)*100,2) crescimentoacertos2024
                     , round(( (s102.qtd/s101.qtd ) -1)*100,2) crescnotasecommerce2024
                     , round(( (s102.valorpago/s101.valorpago ) -1)*100,2) crescvalorecommerce2024*/
                    /* , case
                        when s3.totalgeral = 0 then 0
                        else round(((s1.totalgeral / s3.totalgeral) - 1) * 100, 2)
                       end crescimentocob2023
                     , case
                        when s3.notasnovas = 0 then 0
                        else round(((s1.notasnovas / s3.notasnovas) - 1) * 100, 2)
                       end crescimentonotas2023
                     , case
                        when s3.notasatendidas = 0 then 0
                        else round(((s1.notasatendidas / s3.notasatendidas) - 1) * 100, 2)
                       end crescimentoatendidas2023
                     , case
                        when s3.qtdacertos = 0 then 0
                        else round(((s1.qtdacertos / s3.qtdacertos) - 1) * 100, 2)
                       end crescimentoacertos2023
                     , case
                        when s6.qtd = 0 then 0
                        else round(((s101.qtd / s6.qtd) - 1) * 100, 2)
                       end crescnotasecommerce2023
                     , case
                        when s6.valorpago = 0 then 0
                        else round(((s101.valorpago / s6.valorpago) - 1) * 100, 2)
                       end crescvalorecommerce2023*/
                
                    -- 2024
                     , case
                        when s1.totalgeral = 0 then 0
                        else round(((decode(s1.totalgeral, 0, 0, s2.totalgeral / s1.totalgeral)) - 1) * 100, 2)
                       end crescimentocob2024
                     , case
                        when s1.notasnovas = 0 then 0
                        else round(((decode(s1.notasnovas, 0, 0, s2.notasnovas / s1.notasnovas)) - 1) * 100, 2)
                       end crescimentonotas2024
                     , case
                        when s1.notasatendidas = 0 then 0
                        else round(((decode(s1.notasatendidas, 0, 0, s2.notasatendidas / s1.notasatendidas)) - 1) * 100, 2)
                       end crescimentoatendidas2024
                     , case
                        when s1.qtdacertos = 0 then 0
                        else round(((s2.qtdacertos / s1.qtdacertos) - 1) * 100, 2)
                       end crescimentoacertos2024
                     , case
                        when s101.qtd = 0 then 0
                        else round(((s102.qtd / s101.qtd) - 1) * 100, 2)
                       end crescnotasecommerce2024
                     , case
                        when s101.valorpago = 0 then 0
                        else round(((s102.valorpago / s101.valorpago) - 1) * 100, 2)
                       end crescvalorecommerce2024
                
                     -- 2025
                     , case
                        when s2.totalgeral = 0 then 0
                        else round(((decode(s2.totalgeral, 0, 0, s3.totalgeral / s2.totalgeral)) - 1) * 100, 2)
                       end crescimentocob2025
                     , case
                        when s2.notasnovas = 0 then 0
                        else round(((decode(s2.notasnovas, 0, 0, s3.notasnovas / s2.notasnovas)) - 1) * 100, 2)
                       end crescimentonotas2025
                     , case
                        when s2.notasatendidas = 0 then 0
                        else round(((decode(s2.notasatendidas, 0, 0, s3.notasatendidas / s2.notasatendidas)) - 1) * 100, 2)
                       end crescimentoatendidas2025
                     , case
                        when s2.qtdacertos = 0 then 0
                        else round(((s3.qtdacertos / s2.qtdacertos) - 1) * 100, 2)
                       end crescimentoacertos2025
                     , case
                        when s102.qtd = 0 then 0
                        else round(((s103.qtd / s102.qtd) - 1) * 100, 2)
                       end crescnotasecommerce2025
                     , case
                        when s102.valorpago = 0 then 0
                        else round(((s103.valorpago / s102.valorpago) - 1) * 100, 2)
                       end crescvalorecommerce2025
                
                     -- 2026
                     , case
                        when s3.totalgeral = 0 then 0
                        else round(((decode(s3.totalgeral, 0, 0, s4.totalgeral / s3.totalgeral)) - 1) * 100, 2)
                       end crescimentocob2026
                     , case
                        when s3.notasnovas = 0 then 0
                        else round(((decode(s3.notasnovas, 0, 0, s4.notasnovas / s3.notasnovas)) - 1) * 100, 2)
                       end crescimentonotas2026
                     , case
                        when s3.notasatendidas = 0 then 0
                        else round(((decode(s3.notasatendidas, 0, 0, s4.notasatendidas / s3.notasatendidas)) - 1) * 100, 2)
                       end crescimentoatendidas2026
                     , case
                        when s3.qtdacertos = 0 then 0
                        else round(((s4.qtdacertos / s3.qtdacertos) - 1) * 100, 2)
                       end crescimentoacertos2026
                     , case
                        when s103.qtd = 0 then 0
                        else round(((s104.qtd / s103.qtd) - 1) * 100, 2)
                       end crescnotasecommerce2026
                     , case
                        when s103.valorpago = 0 then 0
                        else round(((s104.valorpago / s103.valorpago) - 1) * 100, 2)
                       end crescvalorecommerce2026
                from vw_filiais_semanas f
                   , ( select d.idfilial
                            , d.idsemana
                            , s.semana semananum
                            , s.semanacompleta semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                            , d.qtdacertos
                            , s.ano
                       from vw_desempenho_empresas d
                          , semana_dias s
                       where s.ano      = 2023
                         and s.idsemana = d.idsemana
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s1
                    , ( select d.idfilial
                            , d.idsemana
                            , s.semana semananum
                            , s.semanacompleta semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                            , d.qtdacertos
                            , s.ano
                       from vw_desempenho_empresas d
                          , semana_dias s
                       where s.ano      = 2024
                         and s.idsemana = d.idsemana
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s2 
                    , ( select d.idfilial
                            , d.idsemana
                            , s.semana semananum
                            , s.semanacompleta semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                            , d.qtdacertos
                            , s.ano
                       from vw_desempenho_empresas d
                          , semana_dias s
                       where s.ano      = 2025
                         and s.idsemana = d.idsemana
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s3
                
                    -- 2026
                    , ( select d.idfilial
                            , d.idsemana
                            , s.semana semananum
                            , s.semanacompleta semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                            , d.qtdacertos
                            , s.ano
                       from vw_desempenho_empresas d
                          , semana_dias s
                       where s.ano      = 2026
                         and s.idsemana = d.idsemana
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s4
                
                
                      , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago
                         from vw_desempenho_empresas_ecommerce x
                             , semana_dias s
                         where s.idsemana = x.idsemanacobranca
                           and s.ano = 2023
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s101
                     , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago 
                         from vw_desempenho_empresas_ecommerce x
                            , semana_dias s
                         where s.idsemana = x.idsemanacobranca
                           and s.ano = 2024
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s102
                     , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago 
                         from vw_desempenho_empresas_ecommerce x
                            , semana_dias s
                         where s.idsemana = x.idsemanacobranca
                           and s.ano = 2025
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s103
                
                     -- 2026
                     , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago 
                         from vw_desempenho_empresas_ecommerce x
                            , semana_dias s
                         where s.idsemana = x.idsemanacobranca
                           and s.ano = 2026
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s104
                
                where f.idfilial    = s1.idfilial(+)
                  and f.semana      = s1.semananum(+)
                  and f.idfilial    = s2.idfilial(+)
                  and f.semana      = s2.semananum(+)
                  and f.idfilial    = s3.idfilial(+)
                  and f.semana      = s3.semananum(+)
                  and f.idfilial    = s4.idfilial(+)
                  and f.semana      = s4.semananum(+)
                  and f.idfilial    = s101.idfilial(+)
                  and f.semana      = s101.semananum(+)
                  and f.idfilial    = s102.idfilial(+)
                  and f.semana      = s102.semananum(+)
                  and f.idfilial    = s103.idfilial(+)
                  and f.semana      = s103.semananum(+)
                  and f.idfilial    = s104.idfilial(+)
                  and f.semana      = s104.semananum(+)
                  and ( :P548_PESQUISA_POR is null
                      or ( :P548_PESQUISA_POR = 'R' and f.regional = :P548_REGIONAL )
                      or ( :P548_PESQUISA_POR = 'F' and f.idfilial = :P548_IDFILIAL )
                      or ( :P548_PESQUISA_POR = 'G' and exists (select pc.idfilial
                                                                  from catal.filiais pc --pc->Pertence Comercial
                                                                 where pc.pertencecomercialromance = 'S'
                                                                   and pc.idfilial = f.idfilial)))
                  and f.semana      between :P548_SEMANAINI and :P548_SEMANAFIM
                  and ( :P548_SEMANAINI is not null
                  and :P548_SEMANAFIM is not null )
                  and :P548_TIPO_RELATORIO = 'E'
