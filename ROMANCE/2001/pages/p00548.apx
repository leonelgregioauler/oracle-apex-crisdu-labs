                            , d.notasatendidas
                            , d.qtdacertos
                       from vw_desempenho_empresas d
                          , semana_dias s
                       where s.ano      = 2026
                         and s.idsemana = d.idsemana
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s4
                
                    , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago
                         from vw_desempenho_empresas_ecommerce x
                             , semana_dias s
                         where s.idsemana = x.idsemanacobranca
                           and s.ano = 2023
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s101
                     , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago 
                         from vw_desempenho_empresas_ecommerce x
                            , semana_dias s
                         where s.idsemana = x.idsemanacobranca
                           and s.ano = 2024
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s102
                     , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago 
                         from vw_desempenho_empresas_ecommerce x
                            , semana_dias s
                         where s.idsemana = x.idsemanacobranca
                           and s.ano = 2025
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s103
                
                     -- 2026 
                     , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago 
                         from vw_desempenho_empresas_ecommerce x
                            , semana_dias s
