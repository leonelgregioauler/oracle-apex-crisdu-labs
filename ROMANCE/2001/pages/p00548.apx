                            , d.notasnovas
                            , d.notasatendidas
                            , d.qtdacertos
                       from vw_desempenho_empresas d
                          , semana_dias s
                       where s.ano      = 2024
                         and s.idsemana = d.idsemana
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s2
                     , ( select d.idfilial
                            , d.idsemana
                            , s.semana semananum
                            , s.semanacompleta semana
                            , d.totalcobranca
                            , d.totaldebitos
