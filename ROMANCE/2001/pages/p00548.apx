                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P548_RELATORIO
            }
            execution {
                sequence: 10
            }
        )

    )

    validation valida-semana-inicio-e-fim (
        name: Valida semana inicio e fim
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: to_number(:P548_SEMANAINI) <= to_number(:P548_SEMANAFIM)
        }
        error {
            errorMessage: Atenção! Semana Início não pode ser maior que Semana Fim
        }
    )

    branch (
        name: Go To Page 548
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 548
                items: {
                    P548_SEMANAINI: &P548_SEMANAINI.
                    P548_SEMANAFIM: &P548_SEMANAFIM.
                    P548_IDFILIAL: &P548_IDFILIAL.
                    P548_TIPO_RELATORIO: &P548_TIPO_RELATORIO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

