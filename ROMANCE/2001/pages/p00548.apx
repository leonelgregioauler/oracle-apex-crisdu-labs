                     , round(( (sum(s101.qtd)/sum(s6.qtd ) ) -1)*100,2) crescnotasecommerce2023
                     , round(( (sum(s101.valorpago)/sum(s6.valorpago ) ) -1)*100,2) crescvalorecommerce2023
                     --2024
                     , case 
