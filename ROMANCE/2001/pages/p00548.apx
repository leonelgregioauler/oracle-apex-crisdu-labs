    region desempenho-distribuidores-resumido-backup (
        name: Desempenho Distribuidores (Resumido) - backup
        title: Desempenho Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     --, sum(s3.totalgeral) geral2022
                     --, sum(s3.notasnovas) notas2022
                     --, sum(s3.notasatendidas) atendimentos2022
                     --
                     --, sum(s4.totalgeral) geral2023
                     --, sum(s4.notasnovas) notas2023
                     --, sum(s4.notasatendidas) atendimentos2023
                     --
                     , sum(s5.totalgeral) geral2024
                     , sum(s5.notasnovas) notas2024
                     , sum(s5.notasatendidas) atendimentos2024
                     --
                     , sum(s6.totalgeral) geral2025
                     , sum(s6.notasnovas) notas2025
                     , sum(s6.notasatendidas) atendimentos2025
                     --
                     , sum(s7.totalgeral) geral2026
                     , sum(s7.notasnovas) notas2026
                     , sum(s7.notasatendidas) atendimentos2026
                
                     /*, case
                         when sum(s3.totalgeral) > 0 then
                           round(( (sum(s4.totalgeral)/sum(s3.totalgeral) ) -1)*100,2) 
                         else
                           100
                       end crescimentocob2023
                     , case
                         when sum(s3.notasnovas) > 0 then
                           round(( (sum(s4.notasnovas)/sum(s3.notasnovas) ) -1)*100,2)
                         else
                           100
                       end crescimentonotas2023
                     , case
                         when sum(s3.notasatendidas) > 0 then
                           round(( (sum(s4.notasatendidas)/sum(s3.notasatendidas) ) -1)*100,2)
                         else
                           100
                       end crescimentoatendimentos2023*/
                     -- 2024
                     , case
                         when sum(s4.totalgeral) > 0 then
                           round(( (sum(s5.totalgeral)/sum(s4.totalgeral) ) -1)*100,2) 
                         else
                           100
                       end crescimentocob2024
                     , case
                         when sum(s4.notasnovas) > 0 then
                           round(( (sum(s5.notasnovas)/sum(s4.notasnovas) ) -1)*100,2)
                         else
                           100
                       end crescimentonotas2024
                     , case
                         when sum(s4.notasatendidas) > 0 then
                           round(( (sum(s5.notasatendidas)/sum(s4.notasatendidas) ) -1)*100,2)
                         else
                           100
                       end crescimentoatendimentos2024
                     -- 2025
                     , case
                         when sum(s5.totalgeral) > 0 then
                           round(( (sum(s6.totalgeral)/sum(s5.totalgeral) ) -1)*100,2) 
                         else
                           100
                       end crescimentocob2025
                     , case
                         when sum(s5.notasnovas) > 0 then
                           round(( (sum(s6.notasnovas)/sum(s5.notasnovas) ) -1)*100,2)
                         else
                           100
                       end crescimentonotas2025
                     , case
                         when sum(s5.notasatendidas) > 0 then
                           round(( (sum(s6.notasatendidas)/sum(s5.notasatendidas) ) -1)*100,2)
                         else
                           100
                       end crescimentoatendimentos2025
                     -- 2026
                     , case
                         when sum(s6.totalgeral) > 0 then
                           round(( (sum(s7.totalgeral)/sum(s6.totalgeral) ) -1)*100,2) 
                         else
                           100
                       end crescimentocob2026
                     , case
                         when sum(s6.notasnovas) > 0 then
                           round(( (sum(s7.notasnovas)/sum(s6.notasnovas) ) -1)*100,2)
                         else
                           100
                       end crescimentonotas2026
                     , case
                         when sum(s6.notasatendidas) > 0 then
                           round(( (sum(s7.notasatendidas)/sum(s6.notasatendidas) ) -1)*100,2)
                         else
                           100
                       end crescimentoatendimentos2026
                     -- Maicon Aimi - 16/07/2025 - 10345369
                     , ini.iniciou_na_empresa
                from vw_repres_filial_rmc f
                     -- Maicon Aimi - 16/07/2025 - 10345369
                   , (select nvl(catal.pck_util.fnc_semanaid( min(nv.idsemanadistribuicao)), 'Sem Registro') iniciou_na_empresa
                           , nv.idrepresentante
                        from roman.notasvendas nv
                       where nv.idsituacaonotavenda in (4,3)
                       group by  nv.idrepresentante) ini
                   , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , sum(d.totalcobranca) totalcobranca
                            , sum(d.totaldebitos) totaldebitos
                            , sum(d.totalgeral)   totalgeral
                            , sum(d.notasnovas)   notasnovas
                            , sum(d.notasatendidas) notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2023
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM
                       group by d.idrepresentante, d.idsemana, s.semana,  to_char(s.semana,'00')||'/'||s.ano ) s4
                    , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , sum(d.totalcobranca) totalcobranca
                            , sum(d.totaldebitos) totaldebitos
                            , sum(d.totalgeral)   totalgeral
                            , sum(d.notasnovas)   notasnovas
                            , sum(d.notasatendidas) notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2024
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM
                       group by d.idrepresentante, d.idsemana, s.semana,  to_char(s.semana,'00')||'/'||s.ano ) s5
                    , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , sum(d.totalcobranca) totalcobranca
                            , sum(d.totaldebitos) totaldebitos
                            , sum(d.totalgeral)   totalgeral
                            , sum(d.notasnovas)   notasnovas
                            , sum(d.notasatendidas) notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2025
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM
                       group by d.idrepresentante, d.idsemana, s.semana,  to_char(s.semana,'00')||'/'||s.ano ) s6
                    --2026
                    , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , sum(d.totalcobranca) totalcobranca
                            , sum(d.totaldebitos) totaldebitos
                            , sum(d.totalgeral)   totalgeral
                            , sum(d.notasnovas)   notasnovas
                            , sum(d.notasatendidas) notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2026
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM
                       group by d.idrepresentante, d.idsemana, s.semana,  to_char(s.semana,'00')||'/'||s.ano ) s7
                where f.idfilial        = :P548_IDFILIAL
                  and f.idrepresentante = ini.idrepresentante(+)
                  and f.idrepresentante = s4.idrepresentante(+)
                  and f.idrepresentante = s5.idrepresentante(+)
                  and f.idrepresentante = s6.idrepresentante(+)
                  and f.idrepresentante = s7.idrepresentante(+)
                  and s4.semananum      = s5.semananum (+)
                  and s5.semananum      = s6.semananum (+)
                  and s6.semananum      = s7.semananum (+)
                  and ( :P548_SEMANAINI is not null and
                        :P548_SEMANAFIM is not null )
                  AND :P548_TIPO_RELATORIO = 'D' 
                  AND :P548_RELATORIO      = 'R'
                group by f.nome, ini.iniciou_na_empresa
                --------------------------------------------------------------------------
                union
                --------------------------------------------------------------------------
                select 'Z Total Z'
                     /*, sum(s3.totalgeral) geral2021
                     , sum(s3.notasnovas) notas2021
                     , sum(s3.notasatendidas) atendimentos2021
                     --
                     , sum(s4.totalgeral) geral2022
                     , sum(s4.notasnovas) notas2022
                     , sum(s4.notasatendidas) atendimentos2022*/
                     --
                     --, sum(s4.totalgeral) geral2023
                     --, sum(s4.notasnovas) notas2023
                     --, sum(s4.notasatendidas) atendimentos2023
                     --
                     , sum(s5.totalgeral) geral2024
                     , sum(s5.notasnovas) notas2024
                     , sum(s5.notasatendidas) atendimentos2024
                     --
                     , sum(s6.totalgeral) geral2025
                     , sum(s6.notasnovas) notas2025
                     , sum(s6.notasatendidas) atendimentos2025
                
                     -- 2026
                     , sum(s7.totalgeral) geral2026
                     , sum(s7.notasnovas) notas2026
                     , sum(s7.notasatendidas) atendimentos2026
                     --
                     /*, case
                         when sum(s3.totalgeral) > 0 then
                           round(( (sum(s4.totalgeral)/sum(s3.totalgeral) ) -1)*100,2)
                         else
                           100
                       end crescimentocob2022
                     , case
                         --when sum(s3.totalgeral) > 0 then     
                         when sum(s3.notasnovas) > 0 then     
                           round(( (sum(s4.notasnovas)/sum(s3.notasnovas) ) -1)*100,2)
                         else
                           100
                       end crescimentonotas2022
                     , case
                         --when sum(s3.totalgeral) > 0 then     
                         when sum(s3.notasatendidas) > 0 then     
                           round(( (sum(s4.notasatendidas)/sum(s3.notasatendidas) ) -1)*100,2)
                         else
                           100
                       end crescimentoatendimentos2022
                     --
                     , case
                         when sum(s4.totalgeral) > 0 then
                           round(( (sum(s5.totalgeral)/sum(s4.totalgeral) ) -1)*100,2)
                         else
                           100
                       end crescimentocob2023
                     , case
                         --when sum(s3.totalgeral) > 0 then     
                         when sum(s4.notasnovas) > 0 then     
                           round(( (sum(s5.notasnovas)/sum(s4.notasnovas) ) -1)*100,2)
                         else
                           100
                       end crescimentonotas2023
                     , case
                         --when sum(s3.totalgeral) > 0 then     
                         when sum(s4.notasatendidas) > 0 then     
                           round(( (sum(s5.notasatendidas)/sum(s4.notasatendidas) ) -1)*100,2)
                         else
                           100
                       end crescimentoatendimentos2023*/
                     -- 2024
                     , case
                         when sum(s4.totalgeral) > 0 then
                           round(( (sum(s5.totalgeral)/sum(s4.totalgeral) ) -1)*100,2)
                         else
                           100
                       end crescimentocob2024
                     , case
                         --when sum(s3.totalgeral) > 0 then     
                         when sum(s4.notasnovas) > 0 then     
                           round(( (sum(s5.notasnovas)/sum(s4.notasnovas) ) -1)*100,2)
                         else
                           100
                       end crescimentonotas2024
                     , case
                         --when sum(s3.totalgeral) > 0 then     
                         when sum(s4.notasatendidas) > 0 then     
                           round(( (sum(s5.notasatendidas)/sum(s4.notasatendidas) ) -1)*100,2)
                         else
                           100
                       end crescimentoatendimentos2024
                
                     --2025
                     , case
                         when sum(s5.totalgeral) > 0 then
                           round(( (sum(s7.totalgeral)/sum(s5.totalgeral) ) -1)*100,2)
                         else
                           100
                       end crescimentocob2025
                     , case
                         --when sum(s3.totalgeral) > 0 then     
                         when sum(s5.notasnovas) > 0 then     
                           round(( (sum(s6.notasnovas)/sum(s5.notasnovas) ) -1)*100,2)
                         else
                           100
                       end crescimentonotas2025
                     , case
                         --when sum(s3.totalgeral) > 0 then     
                         when sum(s5.notasatendidas) > 0 then     
                           round(( (sum(s6.notasatendidas)/sum(s5.notasatendidas) ) -1)*100,2)
                         else
                           100
                       end crescimentoatendimentos2025
                
                     --2026
                     , case
                         when sum(s6.totalgeral) > 0 then
                           round(( (sum(s7.totalgeral)/sum(s6.totalgeral) ) -1)*100,2)
                         else
                           100
                       end crescimentocob2026
                     , case
                         --when sum(s3.totalgeral) > 0 then     
                         when sum(s6.notasnovas) > 0 then     
                           round(( (sum(s7.notasnovas)/sum(s6.notasnovas) ) -1)*100,2)
                         else
                           100
                       end crescimentonotas2026
                     , case
                         --when sum(s3.totalgeral) > 0 then     
                         when sum(s6.notasatendidas) > 0 then     
                           round(( (sum(s7.notasatendidas)/sum(s6.notasatendidas) ) -1)*100,2)
                         else
                           100
                       end crescimentoatendimentos2026
                
                     -- Maicon Aimi - 16/07/2025 - 10345369
                     , ' ' as iniciou_na_empresa
                from vw_repres_filial_rmc f
                    , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , sum(d.totalcobranca) totalcobranca
                            , sum(d.totaldebitos) totaldebitos
                            , sum(d.totalgeral)   totalgeral
                            , sum(d.notasnovas)   notasnovas
                            , sum(d.notasatendidas) notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2023
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM 
                       group by d.idrepresentante, d.idsemana, s.semana,  to_char(s.semana,'00')||'/'||s.ano) s4
                    , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , sum(d.totalcobranca) totalcobranca
                            , sum(d.totaldebitos) totaldebitos
                            , sum(d.totalgeral)   totalgeral
                            , sum(d.notasnovas)   notasnovas
                            , sum(d.notasatendidas) notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2024
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM
                       group by d.idrepresentante, d.idsemana, s.semana,  to_char(s.semana,'00')||'/'||s.ano ) s5
                    , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , sum(d.totalcobranca) totalcobranca
                            , sum(d.totaldebitos) totaldebitos
                            , sum(d.totalgeral)   totalgeral
                            , sum(d.notasnovas)   notasnovas
                            , sum(d.notasatendidas) notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2025
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM
                       group by d.idrepresentante, d.idsemana, s.semana,  to_char(s.semana,'00')||'/'||s.ano ) s6
                
                    , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , sum(d.totalcobranca) totalcobranca
                            , sum(d.totaldebitos) totaldebitos
                            , sum(d.totalgeral)   totalgeral
                            , sum(d.notasnovas)   notasnovas
                            , sum(d.notasatendidas) notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2026
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM
                       group by d.idrepresentante, d.idsemana, s.semana,  to_char(s.semana,'00')||'/'||s.ano ) s7
                where f.idfilial        = :P548_IDFILIAL
                  and f.idrepresentante = s4.idrepresentante(+)
                  and f.idrepresentante = s5.idrepresentante(+)
                  and f.idrepresentante = s6.idrepresentante(+)
                  and f.idrepresentante = s7.idrepresentante(+)
                  and s4.semananum   = s5.semananum(+)
                  and s5.semananum   = s6.semananum(+)
                  and s6.semananum   = s7.semananum(+)
                  and ( :P548_SEMANAINI is not null and
                        :P548_SEMANAFIM is not null )
                  AND :P548_TIPO_RELATORIO = 'D' 
                  AND :P548_RELATORIO      = 'R'
                ```
        }
