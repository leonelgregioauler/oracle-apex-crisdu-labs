    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P548_IDFILIAL (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                  from roman.vw_filiais f
                 where f.ativo      = 'S'
                   and f.tipofilial = 'D'
                   -- Maicon Aimi - 28/01/2025 - 9810218: Validação comentada para o filtro que exclui filiais do exterior (idgrupo != 5)
                   -- and f.idgrupo   != 5
                   and ( exists ( select 1
                                 from roman.usuariosfiliais uf
                                 where uf.idfilial = f.idfilial
                                   and uf.usuario  = v('APP_USER') ) or 
                         roman.pck_romance.fnc_filialusuario(v('APP_USER')) = f.idfilial )
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P548_PESQUISA_POR (
        type: radioGroup
        label {
            label: Pesquisa Por
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Grupo Comercial' display_value
                     , 'G' return_value
                from dual
                where v('APP_USER') in ('RAFAELK','GUILHERME','LUCASSOUZA','MAIQUELLINDEN','LEONELG', 'VINICIUSO')
                union
                select 'Franquia'
                     , 'F'
                from dual
                union 
                select 'Regionais'
                     , 'R'
                from dual
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: F
        }
        readOnly {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                --libera utilizar campo pesquisar por
                v('APP_USER') not in ('GUILHERME','RAFAELK','EVERTON','DANIELEPACHECO','BRUNOB','BETHANIASOUTO','LEONELG',
                                      'OSIELF','LUCASSOUZA','DIEGOPIECHO','MAIQUELLINDEN','NAYARAMUNIZ','LIVIAROSARIO','VINICIUSO') --T13896417
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P548_REGIONAL (
        type: selectList
        label {
            label: Regional
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Regional 1' display_value
                     , 1
                from dual
                where v('APP_USER') in ('RAFAELK','GUILHERME','NATHALIAKINAST','DANIELEPACHECO','MAICONAIMI','MAIQUELLINDEN')
                union
                select 'Regional 3' display_value
                     , 3
                from dual
                where v('APP_USER') in ('RAFAELK','GUILHERME','NATHALIAKINAST','BETHANIASOUTO','MAICONAIMI','MAIQUELLINDEN')
                union
                select 'Regional 4' display_value
                     , 4
                from dual
                where v('APP_USER') in ('RAFAELK','GUILHERME','NATHALIAKINAST','LIVIAROSARIO','MAICONAIMI','MAIQUELLINDEN')
                
                -- 10137656 -- Maicon AImi - 15/04/2025 -- Add regional 2 e 5
                union
                select 'Regional 5' display_value
                     , 5
                from dual
                where v('APP_USER') in ('RAFAELK','NATHALIAKINAST','MAICONAIMI','MAIQUELLINDEN')
                union
                select 'Regional 2' display_value
                     , 2
                from dual
                where v('APP_USER') in ('RAFAELK','NATHALIAKINAST','MAICONAIMI','MAIQUELLINDEN','NAYARAMUNIZ')
                union
                -- Regional 7   -   11093436 - Maicon Aimi - 13/10/2025
                select 'Regional 7' display_value
                     , 7
                from dual
                where v('APP_USER') in ('NATHALIAKINAST','MAIQUELLINDEN','JULIANASEVERO','RAFAELK','SUELENBAUER','RENATAFATORI')
                order by 1;
                ```
            nullDisplayValue: - Selecione a Regional -
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

