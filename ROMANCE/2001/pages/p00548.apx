    region desempenho-empresa-2 (
        name: Desempenho Empresa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ' Especial ' s1
                     , f.semana semananum
                     --, sum(s1.qtdacertos) qtdacertos2022
                     --, sum(s1.totalgeral) geral2022
                     --, sum(s1.notasnovas) notas2022
                     --, sum(s1.notasatendidas) atendidas2022
                     --, sum(s101.qtd) notasecommerce2022
                     --, sum(s101.valorpago) valorecommerce2022
                     --
                     
                     --, sum(s2.qtdacertos) qtdacertos2023
                     --, sum(s2.totalgeral) geral2023
                     --, sum(s2.notasnovas) notas2023
                     --, sum(s2.notasatendidas) atendidas2023
                     --, sum(s102.qtd) notasecommerce2023
                     --, sum(s102.valorpago) valorecommerce2023
                     --
                     , sum(s3.qtdacertos) qtdacertos2024
                     , sum(s3.totalgeral) geral2024
                     , sum(s3.notasnovas) notas2024
                     , sum(s3.notasatendidas) atendidas2024
                     , sum(s103.qtd) notasecommerce2024
                     , sum(s103.valorpago) valorecommerce2024
                     --
                     -- 2025
                     , sum(s4.qtdacertos) qtdacertos2025
                     , sum(s4.totalgeral) geral2025
                     , sum(s4.notasnovas) notas2025
                     , sum(s4.notasatendidas) atendidas2025
                     , sum(s104.qtd) notasecommerce2025
                     , sum(s104.valorpago) valorecommerce2025
                     --
                     -- 2026
                     , sum(s5.qtdacertos) qtdacertos2026
                     , sum(s5.totalgeral) geral2026
                     , sum(s5.notasnovas) notas2026
                     , sum(s5.notasatendidas) atendidas2026
                     , sum(s105.qtd) notasecommerce2026
                     , sum(s105.valorpago) valorecommerce2026
                     --
                    /* , round(( (sum(s2.totalgeral)/sum(s1.totalgeral) ) -1)*100,2) crescimentocob2023
                     , round(( (sum(s2.notasnovas)/sum(s1.notasnovas) ) -1)*100,2) crescimentonotas2023
                     , round(( (sum(s2.notasatendidas)/sum(s1.notasatendidas) ) -1)*100,2) crescimentoatendidas2023
                     , round(( (sum(s102.qtd)/sum(s101.qtd ) ) -1)*100,2) crescnotasecommerce2023
                     , round(( (sum(s102.valorpago)/sum(s101.valorpago ) ) -1)*100,2) crescvalorecommerce2023
                     --
                     , round(( (sum(s3.totalgeral)/sum(s2.totalgeral) ) -1)*100,2) crescimentocob2024
                     , round(( (sum(s3.notasnovas)/sum(s2.notasnovas) ) -1)*100,2) crescimentonotas2024
                     , round(( (sum(s3.notasatendidas)/sum(s2.notasatendidas) ) -1)*100,2) crescimentoatendidas2024
                     , round(( (sum(s103.qtd)/sum(s102.qtd ) ) -1)*100,2) crescnotasecommerce2024
                     , round(( (sum(s103.valorpago)/sum(s102.valorpago ) ) -1)*100,2) crescvalorecommerce2024*/
                     --
                     /*, case 
                        when sum(s1.totalgeral) <> 0 then round(((sum(s2.totalgeral) / sum(s1.totalgeral)) - 1) * 100, 2) 
                        else 0 
                       end crescimentocob2023
                     , case 
                        when sum(s1.notasnovas) <> 0 then round(((sum(s2.notasnovas) / sum(s1.notasnovas)) - 1) * 100, 2) 
                        else 0 
                       end crescimentonotas2023
                    , case 
                       when sum(s1.notasatendidas) <> 0 then round(((sum(s2.notasatendidas) / sum(s1.notasatendidas)) - 1) * 100, 2) 
                       else 0 
                      end crescimentoatendidas2023
                    , case 
                       when sum(s101.qtd) <> 0 then round(((sum(s102.qtd) / sum(s101.qtd)) - 1) * 100, 2) 
                       else 0 
                      end crescnotasecommerce2023
                    , case 
                       when sum(s101.valorpago) <> 0 then round(((sum(s102.valorpago) / sum(s101.valorpago)) - 1) * 100, 2) 
                       else 0 
                      end crescvalorecommerce2023*/
                
                    -- 2024
                    , case 
                       when sum(s2.totalgeral) <> 0 then round(((sum(s3.totalgeral) / sum(s2.totalgeral)) - 1) * 100, 2) 
                       else 0 
                      end as crescimentocob2024
                    , case 
                       when sum(s2.notasnovas) <> 0 then round(((sum(s3.notasnovas) / sum(s2.notasnovas)) - 1) * 100, 2) 
                       else 0 
                      end crescimentonotas2024
                    , case 
                       when sum(s2.notasatendidas) <> 0 then round(((sum(s3.notasatendidas) / sum(s2.notasatendidas)) - 1) * 100, 2) 
                       else 0 
                      end crescimentoatendidas2024
                    , case 
                       when sum(s102.qtd) <> 0 then round(((sum(s103.qtd) / sum(s102.qtd)) - 1) * 100, 2) 
                       else 0 
                      end crescnotasecommerce2024
                    , case 
                        when sum(s102.valorpago) <> 0 then round(((sum(s103.valorpago) / sum(s102.valorpago)) - 1) * 100, 2) 
                        else 0 
                      end crescvalorecommerce2024
                
                    -- 2025
                    , case 
                       when sum(s3.totalgeral) <> 0 then round(((sum(s4.totalgeral) / sum(s3.totalgeral)) - 1) * 100, 2) 
                       else 0 
                      end as crescimentocob2025
                    , case 
                       when sum(s3.notasnovas) <> 0 then round(((sum(s4.notasnovas) / sum(s3.notasnovas)) - 1) * 100, 2) 
                       else 0 
                      end crescimentonotas2025
                    , case 
                       when sum(s3.notasatendidas) <> 0 then round(((sum(s4.notasatendidas) / sum(s3.notasatendidas)) - 1) * 100, 2) 
                       else 0 
                      end crescimentoatendidas2025
                    , case 
                       when sum(s103.qtd) <> 0 then round(((sum(s104.qtd) / sum(s103.qtd)) - 1) * 100, 2) 
                       else 0 
                      end crescnotasecommerce2025
                    , case 
                        when sum(s103.valorpago) <> 0 then round(((sum(s104.valorpago) / sum(s103.valorpago)) - 1) * 100, 2) 
                        else 0 
                      end crescvalorecommerce2025
                
                    -- 2026
                    , case 
                       when sum(s4.totalgeral) <> 0 then round(((sum(s5.totalgeral) / sum(s4.totalgeral)) - 1) * 100, 2) 
                       else 0 
                      end as crescimentocob2026
                    , case 
                       when sum(s4.notasnovas) <> 0 then round(((sum(s5.notasnovas) / sum(s4.notasnovas)) - 1) * 100, 2) 
                       else 0 
                      end crescimentonotas2026
                    , case 
                       when sum(s4.notasatendidas) <> 0 then round(((sum(s5.notasatendidas) / sum(s4.notasatendidas)) - 1) * 100, 2) 
                       else 0 
                      end crescimentoatendidas2026
                    , case 
                       when sum(s104.qtd) <> 0 then round(((sum(s105.qtd) / sum(s104.qtd)) - 1) * 100, 2) 
                       else 0 
                      end crescnotasecommerce2026
                    , case 
                        when sum(s104.valorpago) <> 0 then round(((sum(s105.valorpago) / sum(s104.valorpago)) - 1) * 100, 2) 
                        else 0 
                      end crescvalorecommerce2026
                
                from vw_filiais_semanas f
                   , ( select d.idfilial
                            , d.idsemana
                            , s.semana semananum
                            , qtdacertos
                            , s.semanacompleta semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_empresas d
                          , semana_dias s
                       where s.ano      = 2023
                         and s.idsemana = d.idsemana
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s2
                    , ( select d.idfilial
                            , d.idsemana
                            , s.semana semananum
                            , qtdacertos
                            , s.semanacompleta semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_empresas d
                          , semana_dias s
                       where s.ano      = 2024
                         and s.idsemana = d.idsemana
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s3
                    , ( select d.idfilial
                            , d.idsemana
                            , s.semana semananum
                            , qtdacertos
                            , s.semanacompleta semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_empresas d
                          , semana_dias s
                       where s.ano      = 2025
                         and s.idsemana = d.idsemana
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s4
                    -- 2026
                    , ( select d.idfilial
                            , d.idsemana
                            , s.semana semananum
                            , qtdacertos
                            , s.semanacompleta semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_empresas d
                          , semana_dias s
                       where s.ano      = 2026
                         and s.idsemana = d.idsemana
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s5
                    , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago
                         from vw_desempenho_empresas_ecommerce x
                             , semana_dias s
                         where s.idsemana = x.idsemanacobranca
                           and s.ano = 2023
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s102
                     , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago 
                         from vw_desempenho_empresas_ecommerce x
                            , semana_dias s
                         where s.idsemana = x.idsemanacobranca
                           and s.ano = 2024
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s103
                     , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago 
                         from vw_desempenho_empresas_ecommerce x
                            , semana_dias s
                         where s.idsemana = x.idsemanacobranca
                           and s.ano = 2025
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s104
                
                     -- 2026
                     , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago 
                         from vw_desempenho_empresas_ecommerce x
                            , semana_dias s
                         where s.idsemana = x.idsemanacobranca
                           and s.ano = 2026
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s105
                
                where f.idfilial    = s2.idfilial(+)
                  and f.semana      = s2.semananum(+)
                  and f.idfilial    = s3.idfilial(+)
                  and f.semana      = s3.semananum(+)
                  and f.idfilial    = s4.idfilial(+)
                  and f.semana      = s4.semananum(+)
                  and f.idfilial    = s5.idfilial(+)
                  and f.semana      = s5.semananum(+)
                  and f.idfilial    = s102.idfilial(+)
                  and f.semana      = s102.semananum(+)
                  and f.idfilial    = s103.idfilial(+)
                  and f.semana      = s103.semananum(+)
                  and f.idfilial    = s104.idfilial(+)
                  and f.semana      = s104.semananum(+)
                  and f.idfilial    = s105.idfilial(+)
                  and f.semana      = s105.semananum(+)
                  
                  and ( :P548_PESQUISA_POR is null
                      or ( :P548_PESQUISA_POR = 'R' and f.regional = :P548_REGIONAL )
                      or ( :P548_PESQUISA_POR = 'F' and f.idfilial = :P548_IDFILIAL )
                      or ( :P548_PESQUISA_POR = 'G' and exists (select pc.idfilial
                                                                  from catal.filiais pc --pc->Pertence Comercial
                                                                 where pc.pertencecomercialromance = 'S'
                                                                   and pc.idfilial = f.idfilial)))
                  and f.ano         = 2026  -- 2024
                  and f.semana      between :P548_SEMANAINI and :P548_SEMANAFIM
                  and ( :P548_SEMANAINI is not null
                    and :P548_SEMANAFIM is not null )
                  AND :P548_TIPO_RELATORIO = 'E' 
                group by f.semana
                --------------------------------------------------------
                union
                --------------------------------------------------------
                select ' - Total - '
                     , null
                     --
                     --, sum(s1.qtdacertos) qtdacertos2022
                     --, sum(s1.totalgeral) geral2022
                     --, sum(s1.notasnovas) notas2022
                     --, sum(s1.notasatendidas) atendidas2022
                     --
                     --, sum(s2.qtdacertos) qtdacertos2023
                     --, sum(s2.totalgeral) geral2023
                     --, sum(s2.notasnovas) notas2023
                     --, sum(s2.notasatendidas) atendidas2023
                     --
                     , sum(s3.qtdacertos) qtdacertos2024
                     , sum(s3.totalgeral) geral2024
                     , sum(s3.notasnovas) notas2024
                     , sum(s3.notasatendidas) atendidas2024
                      --
                     --, sum(s101.qtd) notasecommerce2022
                     --, sum(s101.valorpago) valorecommerce2022
                     --
                     --, sum(s102.qtd) notasecommerce2023
                     --, sum(s102.valorpago) valorecommerce2023
                     --
                     , sum(s103.qtd) notasecommerce2024
                     , sum(s103.valorpago) valorecommerce2024
                     --
                     -- 2025
                     , sum(s4.qtdacertos) qtdacertos2025
                     , sum(s4.totalgeral) geral2025
                     , sum(s4.notasnovas) notas2025
                     , sum(s4.notasatendidas) atendidas2025
                     , sum(s104.qtd) notasecommerce2025
                     , sum(s104.valorpago) valorecommerce2025
                     --
                     -- 2026
                     , sum(s5.qtdacertos) qtdacertos2026
                     , sum(s5.totalgeral) geral2026
                     , sum(s5.notasnovas) notas2026
                     , sum(s5.notasatendidas) atendidas2026
                     , sum(s105.qtd) notasecommerce2026
                     , sum(s105.valorpago) valorecommerce2026
                
                     /*, round(( (sum(s2.totalgeral)/sum(s1.totalgeral) ) -1)*100,2) crescimentocob2023
                     , round(( (sum(s2.notasnovas)/sum(s1.notasnovas) ) -1)*100,2) crescimentonotas2023
                     , round(( (sum(s2.notasatendidas)/sum(s1.notasatendidas) ) -1)*100,2) crescimentoatendidas2023
                     , round(( (sum(s102.qtd)/sum(s101.qtd ) ) -1)*100,2) crescnotasecommerce2023
                     , round(( (sum(s102.valorpago)/sum(s101.valorpago ) ) -1)*100,2) crescvalorecommerce2023
                     --
                     , round(( (sum(s3.totalgeral)/sum(s2.totalgeral) ) -1)*100,2) crescimentocob2024
                     , round(( (sum(s3.notasnovas)/sum(s2.notasnovas) ) -1)*100,2) crescimentonotas2024
                     , round(( (sum(s3.notasatendidas)/sum(s2.notasatendidas) ) -1)*100,2) crescimentoatendidas2024
                     , round(( (sum(s103.qtd)/sum(s102.qtd ) ) -1)*100,2) crescnotasecommerce2024
                     , round(( (sum(s103.valorpago)/sum(s102.valorpago ) ) -1)*100,2) crescvalorecommerce2024*/
                     --
                     /*, case 
                        when sum(s1.totalgeral) <> 0 then round(((sum(s2.totalgeral)/sum(s1.totalgeral)) - 1) * 100, 2)
                        else 0
                       end crescimentocob2023
                     , case 
                        when sum(s1.notasnovas) <> 0 then round(((sum(s2.notasnovas)/sum(s1.notasnovas)) - 1) * 100, 2)
                        else 0
                       end crescimentonotas2023
                     , case 
                         when sum(s1.notasatendidas) <> 0 then round(((sum(s2.notasatendidas)/sum(s1.notasatendidas)) - 1) * 100, 2)
                         else 0
                       end crescimentoatendidas2023
                     , case 
                        when sum(s101.qtd) <> 0 then round(((sum(s102.qtd)/sum(s101.qtd)) - 1) * 100, 2)
                        else 0
                       end crescnotasecommerce2023
                     , case 
                        when sum(s101.valorpago) <> 0 then round(((sum(s102.valorpago)/sum(s101.valorpago)) - 1) * 100, 2)
                        else 0
                       end crescvalorecommerce2023*/
                     --
                     , case 
                        when sum(s2.totalgeral) <> 0 then round(((sum(s3.totalgeral)/sum(s2.totalgeral)) - 1) * 100, 2)
                        else 0
                       end crescimentocob2024
                     , case 
                        when sum(s2.notasnovas) <> 0 then round(((sum(s3.notasnovas)/sum(s2.notasnovas)) - 1) * 100, 2)
                        else 0
                       end crescimentonotas2024
                     , case 
                        when sum(s2.notasatendidas) <> 0 then round(((sum(s3.notasatendidas)/sum(s2.notasatendidas)) - 1) * 100, 2)
                        else 0
                       end crescimentoatendidas2024
                     , case 
                        when sum(s102.qtd) <> 0 then round(((sum(s103.qtd)/sum(s102.qtd)) - 1) * 100, 2)
                        else 0
                       end crescnotasecommerce2024
                     , case 
                        when sum(s102.valorpago) <> 0 then round(((sum(s103.valorpago)/sum(s102.valorpago)) - 1) * 100, 2)
                        else 0
                       end crescvalorecommerce2024
                     
                     -- 2025
                     , case 
                        when sum(s3.totalgeral) <> 0 then round(((sum(s4.totalgeral)/sum(s3.totalgeral)) - 1) * 100, 2)
                        else 0
                       end crescimentocob2025
                     , case 
                        when sum(s3.notasnovas) <> 0 then round(((sum(s4.notasnovas)/sum(s3.notasnovas)) - 1) * 100, 2)
                        else 0
                       end crescimentonotas2025
                     , case 
                        when sum(s3.notasatendidas) <> 0 then round(((sum(s4.notasatendidas)/sum(s3.notasatendidas)) - 1) * 100, 2)
                        else 0
                       end crescimentoatendidas2025
                     , case 
                        when sum(s103.qtd) <> 0 then round(((sum(s104.qtd)/sum(s103.qtd)) - 1) * 100, 2)
                        else 0
                       end crescnotasecommerce2025
                     , case 
                        when sum(s103.valorpago) <> 0 then round(((sum(s104.valorpago)/sum(s103.valorpago)) - 1) * 100, 2)
                        else 0
                       end crescvalorecommerce2025
                
                     -- 2026
                     , case 
                        when sum(s4.totalgeral) <> 0 then round(((sum(s5.totalgeral)/sum(s4.totalgeral)) - 1) * 100, 2)
                        else 0
                       end crescimentocob2026
                     , case 
                        when sum(s4.notasnovas) <> 0 then round(((sum(s5.notasnovas)/sum(s4.notasnovas)) - 1) * 100, 2)
                        else 0
                       end crescimentonotas2026
                     , case 
                        when sum(s4.notasatendidas) <> 0 then round(((sum(s5.notasatendidas)/sum(s4.notasatendidas)) - 1) * 100, 2)
                        else 0
                       end crescimentoatendidas2026
                     , case 
                        when sum(s104.qtd) <> 0 then round(((sum(s105.qtd)/sum(s104.qtd)) - 1) * 100, 2)
                        else 0
                       end crescnotasecommerce2026
                     , case 
                        when sum(s104.valorpago) <> 0 then round(((sum(s105.valorpago)/sum(s104.valorpago)) - 1) * 100, 2)
                        else 0
                       end crescvalorecommerce2026
                from vw_filiais_semanas f
                   , ( select d.idfilial
                            , d.idsemana
                            , s.semana semananum
                            , qtdacertos 
                            , s.semanacompleta semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_empresas d
                          , semana_dias s
                       where s.ano      = 2023
                         and s.idsemana = d.idsemana
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s2
                    , ( select d.idfilial
                            , d.idsemana
                            , s.semana semananum
                            , qtdacertos 
                            , s.semanacompleta semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_empresas d
                          , semana_dias s
                       where s.ano      = 2024
                         and s.idsemana = d.idsemana
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s3
                    , ( select d.idfilial
                            , d.idsemana
                            , s.semana semananum
                            , qtdacertos 
                            , s.semanacompleta semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_empresas d
                          , semana_dias s
                       where s.ano      = 2025
                         and s.idsemana = d.idsemana
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s4
                    -- 2026
                    , ( select d.idfilial
                            , d.idsemana
                            , s.semana semananum
                            , qtdacertos 
                            , s.semanacompleta semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_empresas d
                          , semana_dias s
                       where s.ano      = 2026
                         and s.idsemana = d.idsemana
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s5
                    , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago
                         from vw_desempenho_empresas_ecommerce x
                             , semana_dias s
                         where s.idsemana = x.idsemanacobranca
                           and s.ano = 2023
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s102
                     , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago 
                         from vw_desempenho_empresas_ecommerce x
                            , semana_dias s
                         where s.idsemana = x.idsemanacobranca
                           and s.ano = 2024
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s103 
                     , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago 
                         from vw_desempenho_empresas_ecommerce x
                            , semana_dias s
                         where s.idsemana = x.idsemanacobranca
                           and s.ano = 2025
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s104
                     -- 2026
                     , ( select x.idfilial
                              , x.idsemanacobranca
                              , s.semana semananum
                              , x.qtd
                              , x.valorpago 
                         from vw_desempenho_empresas_ecommerce x
                            , semana_dias s
                         where s.idsemana = x.idsemanacobranca
                           and s.ano = 2026
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s105
                
                where f.idfilial    = s2.idfilial(+)
                  and f.semana      = s2.semananum(+)
                  and f.idfilial    = s3.idfilial(+)
                  and f.semana      = s3.semananum(+)
                  and f.idfilial    = s4.idfilial(+)
                  and f.semana      = s4.semananum(+)
                  and f.idfilial    = s5.idfilial(+)
                  and f.semana      = s5.semananum(+)
                  and f.idfilial    = s102.idfilial(+)
                  and f.semana      = s102.semananum(+)
                  and f.idfilial    = s103.idfilial(+)
                  and f.semana      = s103.semananum(+)
                  and f.idfilial    = s104.idfilial(+)
                  and f.semana      = s104.semananum(+)
                  and f.idfilial    = s105.idfilial(+)
                  and f.semana      = s105.semananum(+)
                  and ( :P548_PESQUISA_POR is null
                      or ( :P548_PESQUISA_POR = 'R' and f.regional = :P548_REGIONAL )
                      or ( :P548_PESQUISA_POR = 'F' and f.idfilial = :P548_IDFILIAL )
                      or ( :P548_PESQUISA_POR = 'G' and exists (select pc.idfilial
                                                                  from catal.filiais pc --pc->Pertence Comercial
                                                                 where pc.pertencecomercialromance = 'S'
                                                                   and pc.idfilial = f.idfilial)))
                  and f.ano         = 2026 --- 2024
                  and f.semana      between :P548_SEMANAINI and :P548_SEMANAFIM
                  and ( :P548_SEMANAINI is not null
                    and :P548_SEMANAFIM is not null )
                  AND :P548_TIPO_RELATORIO = 'E' 
                
