    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction franquia (
        name: Franquia
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P548_PESQUISA_POR
        }
        clientSideCondition {
            type: item=value
            item: P548_PESQUISA_POR
            value: F
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P548_IDFILIAL
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P548_IDFILIAL
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction regional (
        name: Regional
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P548_PESQUISA_POR
        }
        clientSideCondition {
            type: item=value
            item: P548_PESQUISA_POR
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P548_REGIONAL
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P548_REGIONAL
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-relatorio (
        name: Tipo Relatorio
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P548_TIPO_RELATORIO
        }
        clientSideCondition {
            type: item=value
            item: P548_TIPO_RELATORIO
