                       end crescimentoatendidas2024
                     , round(( (sum(s2.qtdacertos)/sum(s1.qtdacertos) ) -1)*100,2) crescimentoacertos2024
                     , round(( (sum(s102.qtd)/sum(s101.qtd ) ) -1)*100,2) crescnotasecommerce2024
                     , round(( (sum(s102.valorpago)/sum(s101.valorpago ) ) -1)*100,2) crescvalorecommerce2024*/
                     --  
