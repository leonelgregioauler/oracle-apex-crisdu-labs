    region desempenho-distribuidores-resumido (
        name: Desempenho Distribuidores (Resumido)
        title: Desempenho Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome,
                
                       nvl(s5.totalgeral,0)      geral2024,
                       nvl(s5.notasnovas,0)      notas2024,
                       nvl(s5.notasatendidas,0)  atendimentos2024,
                
                       nvl(s6.totalgeral,0)      geral2025,
                       nvl(s6.notasnovas,0)      notas2025,
                       nvl(s6.notasatendidas,0)  atendimentos2025,
                
                       nvl(s7.totalgeral,0)      geral2026,
                       nvl(s7.notasnovas,0)      notas2026,
                       nvl(s7.notasatendidas,0)  atendimentos2026,
                
                       case
                         when nvl(s5.totalgeral,0) > 0 then
                           round(((s6.totalgeral / s5.totalgeral) - 1) * 100, 2)
                         else
                           100
                       end crescimentocob2025,
                
                       case
                         when nvl(s5.notasnovas,0) > 0 then
                           round(((s6.notasnovas / s5.notasnovas) - 1) * 100, 2)
                         else
                           100
                       end crescimentonotas2025,
                
                       case
                         when nvl(s5.notasatendidas,0) > 0 then
                           round(((s6.notasatendidas / s5.notasatendidas) - 1) * 100, 2)
                         else
                           100
                       end crescimentoatendimentos2025,
                
                       case
                         when nvl(s6.totalgeral,0) > 0 then
                           round(((s7.totalgeral / s6.totalgeral) - 1) * 100, 2)
                         else
                           100
                       end crescimentocob2026,
                
                       case
                         when nvl(s6.notasnovas,0) > 0 then
                           round(((s7.notasnovas / s6.notasnovas) - 1) * 100, 2)
                         else
                           100
                       end crescimentonotas2026,
                
                       case
                         when nvl(s6.notasatendidas,0) > 0 then
                           round(((s7.notasatendidas / s6.notasatendidas) - 1) * 100, 2)
                         else
                           100
                       end crescimentoatendimentos2026,
                
                       ini.iniciou_na_empresa
                
                from vw_repres_filial_rmc f,
                
                     (
                       select nvl(catal.pck_util.fnc_semanaid(min(nv.idsemanadistribuicao)),
                                  'Sem Registro') iniciou_na_empresa,
                              nv.idrepresentante
                         from roman.notasvendas nv
                        where nv.idsituacaonotavenda in (3,4)
                        group by nv.idrepresentante
                     ) ini,
                
                     (
                       select d.idrepresentante,
                              sum(d.totalgeral)      totalgeral,
                              sum(d.notasnovas)      notasnovas,
                              sum(d.notasatendidas)  notasatendidas
                         from vw_desempenho_representantes d,
                              semana_dias s
                        where s.ano      = 2024
                          and s.idsemana = d.idsemana
                          and d.idfilial = :P548_IDFILIAL
                          and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM
                        group by d.idrepresentante
                     ) s5,
                
                     (
                       select d.idrepresentante,
                              sum(d.totalgeral)      totalgeral,
                              sum(d.notasnovas)      notasnovas,
                              sum(d.notasatendidas)  notasatendidas
                         from vw_desempenho_representantes d,
                              semana_dias s
                        where s.ano      = 2025
                          and s.idsemana = d.idsemana
                          and d.idfilial = :P548_IDFILIAL
                          and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM
                        group by d.idrepresentante
                     ) s6,
                
                     (
                       select d.idrepresentante,
                              sum(d.totalgeral)      totalgeral,
                              sum(d.notasnovas)      notasnovas,
                              sum(d.notasatendidas)  notasatendidas
                         from vw_desempenho_representantes d,
                              semana_dias s
                        where s.ano      = 2026
                          and s.idsemana = d.idsemana
                          and d.idfilial = :P548_IDFILIAL
                          and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM
                        group by d.idrepresentante
                     ) s7
                
                where f.idfilial = :P548_IDFILIAL
                
                  and f.idrepresentante = ini.idrepresentante(+)
                
                  and f.idrepresentante = s5.idrepresentante(+)
                  and f.idrepresentante = s6.idrepresentante(+)
                  and f.idrepresentante = s7.idrepresentante(+)
                
                  and :P548_SEMANAINI is not null
                  and :P548_SEMANAFIM is not null
                
                  and :P548_TIPO_RELATORIO = 'D'
                  and :P548_RELATORIO      = 'R'
                
                UNION ALL
                
                select 'Z Total Z',
                
                       SUM(nvl(s5.totalgeral,0))      geral2024,
                       SUM(nvl(s5.notasnovas,0))      notas2024,
                       SUM(nvl(s5.notasatendidas,0))  atendimentos2024,
                
                       SUM(nvl(s6.totalgeral,0))      geral2025,
                       SUM(nvl(s6.notasnovas,0))      notas2025,
                       SUM(nvl(s6.notasatendidas,0))  atendimentos2025,
                
                       SUM(nvl(s7.totalgeral,0))      geral2026,
                       SUM(nvl(s7.notasnovas,0))      notas2026,
                       SUM(nvl(s7.notasatendidas,0))  atendimentos2026,
                
                       case
                         when nvl(sum(s5.totalgeral),0) > 0 then
                           round(((sum(s6.totalgeral) / sum(s5.totalgeral)) - 1) * 100, 2)
                         else
                           100
                       end crescimentocob2025,
                
                       case
                         when sum(nvl(s5.notasnovas,0)) > 0 then
                           round(((sum(s6.notasnovas) / sum(s5.notasnovas)) - 1) * 100, 2)
                         else
                           100
                       end crescimentonotas2025,
                
                       case
                         when sum(nvl(s5.notasatendidas,0)) > 0 then
                           round(((sum(s6.notasatendidas) / sum(s5.notasatendidas)) - 1) * 100, 2)
                         else
                           100
                       end crescimentoatendimentos2025,
                
                       case
                         when sum(nvl(s6.totalgeral,0)) > 0 then
                           round(((sum(s7.totalgeral) / sum(s6.totalgeral)) - 1) * 100, 2)
                         else
                           100
                       end crescimentocob2026,
                
                       case
                         when sum(nvl(s6.notasnovas,0)) > 0 then
                           round(((sum(s7.notasnovas) / sum(s6.notasnovas)) - 1) * 100, 2)
                         else
                           100
                       end crescimentonotas2026,
                
                       case
                         when sum(nvl(s6.notasatendidas,0)) > 0 then
                           round(((sum(s7.notasatendidas) / sum(s6.notasatendidas)) - 1) * 100, 2)
                         else
                           100
                       end crescimentoatendimentos2026,
                
                       ' ' as iniciou_na_empresa
                
                from vw_repres_filial_rmc f,
                
                     (
                       select d.idrepresentante,
                              sum(d.totalgeral)      totalgeral,
                              sum(d.notasnovas)      notasnovas,
                              sum(d.notasatendidas)  notasatendidas
                         from vw_desempenho_representantes d,
                              semana_dias s
                        where s.ano      = 2024
                          and s.idsemana = d.idsemana
                          and d.idfilial = :P548_IDFILIAL
                          and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM
                        group by d.idrepresentante
                     ) s5,
                
                     (
                       select d.idrepresentante,
                              sum(d.totalgeral)      totalgeral,
                              sum(d.notasnovas)      notasnovas,
                              sum(d.notasatendidas)  notasatendidas
                         from vw_desempenho_representantes d,
                              semana_dias s
                        where s.ano      = 2025
                          and s.idsemana = d.idsemana
                          and d.idfilial = :P548_IDFILIAL
                          and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM
                        group by d.idrepresentante
                     ) s6,
                
                     (
                       select d.idrepresentante,
                              sum(d.totalgeral)      totalgeral,
                              sum(d.notasnovas)      notasnovas,
                              sum(d.notasatendidas)  notasatendidas
                         from vw_desempenho_representantes d,
                              semana_dias s
                        where s.ano      = 2026
                          and s.idsemana = d.idsemana
                          and d.idfilial = :P548_IDFILIAL
                          and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM
                        group by d.idrepresentante
                     ) s7
                
                where f.idfilial = :P548_IDFILIAL
                
                  and f.idrepresentante = s5.idrepresentante(+)
                  and f.idrepresentante = s6.idrepresentante(+)
                  and f.idrepresentante = s7.idrepresentante(+)
                
                  and :P548_SEMANAINI is not null
                  and :P548_SEMANAFIM is not null
                
                  and :P548_TIPO_RELATORIO = 'D'
                  and :P548_RELATORIO      = 'R'
                
                order by 1 ;
                ```
        }
