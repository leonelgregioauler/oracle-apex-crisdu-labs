                           and s.ano = 2026
                           and s.semana between :P548_SEMANAINI and :P548_SEMANAFIM ) s104
                where f.idfilial    = s1.idfilial(+)
                  and f.semana      = s1.semananum(+)
                  and f.idfilial    = s2.idfilial(+)
                  and f.semana      = s2.semananum(+)
                  and f.idfilial    = s3.idfilial(+)
                  and f.semana      = s3.semananum(+)
                  and f.idfilial    = s4.idfilial(+)
                  and f.semana      = s4.semananum(+)
                  and f.idfilial    = s101.idfilial(+)
                  and f.semana      = s101.semananum(+)
                  and f.idfilial    = s102.idfilial(+)
                  and f.semana      = s102.semananum(+)
                  and f.idfilial    = s103.idfilial(+)
                  and f.semana      = s103.semananum(+)
                  and f.idfilial    = s104.idfilial(+)
                  and f.semana      = s104.semananum(+)
                  and ( :P548_PESQUISA_POR is null
                      or ( :P548_PESQUISA_POR = 'R' and f.regional = :P548_REGIONAL )
                      or ( :P548_PESQUISA_POR = 'F' and f.idfilial = :P548_IDFILIAL )
                      or ( :P548_PESQUISA_POR = 'G' and exists (select pc.idfilial
                                                                  from catal.filiais pc --pc->Pertence Comercial
                                                                 where pc.pertencecomercialromance = 'S'
                                                                   and pc.idfilial = f.idfilial)))
                  and f.semana      between :P548_SEMANAINI and :P548_SEMANAFIM
                  and f.ano         = 2026 ---2024
                  and ( :P548_SEMANAINI is not null
                    and :P548_SEMANAFIM is not null )
                  AND :P548_TIPO_RELATORIO = 'E'
                
