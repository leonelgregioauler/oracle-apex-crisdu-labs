page 548 (
    name: Desempenho Empresas
    title: Desempenho Empresas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    comments {
        comments: Para casos de diferença com valores com relatório IARA, existe um ticket onde isto já foi verificado T10573469
    }

    region desempenho-distribuidores-detalhado (
        name: Desempenho Distribuidores (detalhado)
        title: Desempenho Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH sem AS (
                    SELECT DISTINCT semana semananum
                      FROM semana_dias
                     WHERE semana BETWEEN :P548_SEMANAINI
                                      AND :P548_SEMANAFIM
                )
                
                select f.nome
                     , s5.semananum
                     --
                     , s5.totalgeral geral2024
                     , s5.notasnovas notas2024
                     , s5.notasatendidas atendidas2024
                     --
                     , case
                         when s4.totalgeral > 0 and s5.totalgeral > 0 then
                           round(( (s5.totalgeral/s4.totalgeral ) -1)*100,2) 
                         else
                           100
                       end crescimentocob2024
                     , case
                         when s4.notasnovas > 0  and s5.notasnovas > 0 then
                           round(( (s5.notasnovas/s4.notasnovas ) -1)*100,2)
                         else
                           100
                       end crescimentonotas2024
                     , case
                         when s4.notasatendidas > 0 and s5.notasatendidas > 0 then
                           round(( (s5.notasatendidas/s4.notasatendidas ) -1)*100,2)
                         else
                           100
                       end crescimentoatendidas2024
                     -- 2025
                     , s6.totalgeral geral2025
                     , s6.notasnovas notas2025
                     , s6.notasatendidas atendidas2025
                     --
                     , case
                         when s5.totalgeral > 0 and s6.totalgeral > 0 then
                           round(( (s6.totalgeral/s5.totalgeral ) -1)*100,2) 
                         else
                           100
                       end crescimentocob2025
                     , case
                         when s5.notasnovas > 0  and s6.notasnovas > 0 then
                           round(( (s6.notasnovas/s5.notasnovas ) -1)*100,2)
                         else
                           100
                       end crescimentonotas2025
                     , case
                         when s5.notasatendidas > 0 and s6.notasatendidas > 0 then
                           round(( (s6.notasatendidas/s5.notasatendidas ) -1)*100,2)
                         else
                           100
                       end crescimentoatendidas2025
                    -- 2026
                     , s7.totalgeral geral2026
                     , s7.notasnovas notas2026
                     , s7.notasatendidas atendidas2026
                     --
                     , case
                         when s6.totalgeral > 0 and s7.totalgeral > 0 then
                           round(( (s7.totalgeral/s6.totalgeral ) -1)*100,2) 
                         else
                           100
                       end crescimentocob2026
                     , case
                         when s6.notasnovas > 0  and s7.notasnovas > 0 then
                           round(( (s7.notasnovas/s6.notasnovas ) -1)*100,2)
                         else
                           100
                       end crescimentonotas2026
                     , case
                         when s6.notasatendidas > 0 and s7.notasatendidas > 0 then
                           round(( (s7.notasatendidas/s6.notasatendidas ) -1)*100,2)
                         else
                           100
                       end crescimentoatendidas2026
                     -- Maicon Aimi - 16/07/2025 - 10345369
                     , (select nvl(catal.pck_util.fnc_semanaid( min(nv.idsemanadistribuicao)), 'Sem Registro')
                          from roman.notasvendas nv
                         where nv.idrepresentante = f.idrepresentante
                           and nv.idsituacaonotavenda in (4,3)) iniciou_na_empresa
                from vw_repres_filial_rmc f
                   , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2023
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s4
                   , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2024
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s5
                   , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2025
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s6
                   -- 2026
                   , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2026
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s7
                where f.idfilial        = :P548_IDFILIAL
                  and f.idrepresentante = s4.idrepresentante(+)
                  and f.idrepresentante = s5.idrepresentante(+)
                  and f.idrepresentante = s6.idrepresentante(+)
                  and f.idrepresentante = s7.idrepresentante(+)
                  and s5.semananum  (+)    = s4.semananum
                  and s6.semananum  (+)    = s5.semananum
                  and s7.semananum  (+)    = s6.semananum
                  and ( :P548_SEMANAINI is not null and
                        :P548_SEMANAFIM is not null )
                  AND :P548_TIPO_RELATORIO = 'D' 
                  AND :P548_RELATORIO      = 'D'
                ----------------------------------------------------
                union
                ----------------------------------------------------
                select f.nome
                     , 99
                     --
                     , sum(s5.totalgeral) geral2024
                     , sum(s5.notasnovas) notas2024
                     , sum(s5.notasatendidas) atendidas2024
                     --
                     , case
                         when sum(s4.totalgeral) > 0 and sum(s5.totalgeral) > 0 then
                           round(( (sum(s5.totalgeral)/sum(s4.totalgeral) ) -1)*100,2)
                         else
                           100
                       end crescimentocob2024
                     , case
                         when sum(s4.totalgeral) > 0 and sum(s5.totalgeral) > 0 then     
                           round(( (sum(s5.notasnovas)/sum(s4.notasnovas) ) -1)*100,2)
                         else
                           100
                       end crescimentonotas2024
                     , case
                         when sum(s4.totalgeral) > 0 and sum(s5.totalgeral) > 0 then     
                           round(( (sum(s5.notasatendidas)/sum(s4.notasatendidas) ) -1)*100,2)
                         else
                           100
                       end crescimentoatendidas2024
                     --
                     , sum(s6.totalgeral) geral2025
                     , sum(s6.notasnovas) notas2025
                     , sum(s6.notasatendidas) atendidas2025
                     --
                     -- 2025
                     , case
                         when sum(s5.totalgeral) > 0 and sum(s6.totalgeral) > 0 then
                           round(( (sum(s6.totalgeral)/sum(s5.totalgeral) ) -1)*100,2)
                         else
                           100
                       end crescimentocob2025
                     , case
                         when sum(s5.totalgeral) > 0 and sum(s6.totalgeral) > 0 then     
                           round(( (sum(s6.notasnovas)/sum(s5.notasnovas) ) -1)*100,2)
                         else
                           100
                       end crescimentonotas2025
                     , case
                         when sum(s5.totalgeral) > 0 and sum(s6.totalgeral) > 0 then     
                           round(( (sum(s6.notasatendidas)/sum(s5.notasatendidas) ) -1)*100,2)
                         else
                           100
                       end crescimentoatendidas2025
                     -- 2026
                     , sum(s7.totalgeral) geral2026
                     , sum(s7.notasnovas) notas2026
                     , sum(s7.notasatendidas) atendidas2026
                     --
                     , case
                         when sum(s6.totalgeral) > 0 and sum(s7.totalgeral) > 0 then
                           round(( (sum(s7.totalgeral)/sum(s6.totalgeral) ) -1)*100,2)
                         else
                           100
                       end crescimentocob2026
                     , case
                         when sum(s6.totalgeral) > 0 and sum(s7.totalgeral) > 0 then     
                           round(( (sum(s7.notasnovas)/sum(s6.notasnovas) ) -1)*100,2)
                         else
                           100
                       end crescimentonotas2026
                     , case
                         when sum(s6.totalgeral) > 0 and sum(s7.totalgeral) > 0 then     
                           round(( (sum(s7.notasatendidas)/sum(s6.notasatendidas) ) -1)*100,2)
                         else
                           100
                       end crescimentoatendidas2026
                     , ' ' as iniciou_na_empresa
                from vw_repres_filial_rmc f
                   , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2023
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s4
                    , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2024
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s5
                    , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2025
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s6
                
                    -- 2026
                    , ( select d.idrepresentante
                            , d.idsemana
                            , s.semana semananum
                            , to_char(s.semana,'00')||'/'||s.ano semana
                            , d.totalcobranca
                            , d.totaldebitos
                            , d.totalgeral
                            , d.notasnovas
                            , d.notasatendidas
                       from vw_desempenho_representantes d
                          , semana_dias s
                       where s.ano      = 2026
                         and s.idsemana = d.idsemana
                         and d.idfilial = :P548_IDFILIAL
                         and s.semana   between :P548_SEMANAINI and :P548_SEMANAFIM ) s7
                where f.idfilial        = :P548_IDFILIAL
                  and f.idrepresentante = s4.idrepresentante(+)
                  and f.idrepresentante = s5.idrepresentante(+)
                  and f.idrepresentante = s6.idrepresentante(+)
                  and f.idrepresentante = s7.idrepresentante(+)
                  and s5.semananum   (+)   = s4.semananum
                  and s6.semananum   (+)   = s5.semananum
                  and s7.semananum   (+)   = s6.semananum
                  and ( :P548_SEMANAINI is not null and
                        :P548_SEMANAFIM is not null )
                  AND :P548_TIPO_RELATORIO = 'D' 
                  AND :P548_RELATORIO      = 'D'
                group by nome,2
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
