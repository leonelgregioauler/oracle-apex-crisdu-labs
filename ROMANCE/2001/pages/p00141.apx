        serverSideCondition {
            type: itemIsNull
            item: P141_IDCORRECAORECEBNOTA
        }
    )

    process busca-idestoquefilial (
        name: Busca IDESTOQUEFILIAL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  v_return number;
                  --
                begin
                  --
                  if :P141_IDITEMNF is not null then
                    --
                    select e.idestoquefilial
                      into v_return--:P141_IDESTOQUEFIL
                      from roman.notasfiscais n
                         , roman.itemnf i
                         , roman.estoquefilial e
                     where n.idnotafiscal = i.idnotafiscal
                       and i.idproduto    = e.idproduto
                       and n.idfilialdestino = e.idfilial
                       and i.iditnf = :P141_IDITEMNF;
                    --
                    :P141_IDESTOQUEFIL := v_return;
                    --
                  end if;
                  --
                  exception when no_data_found then
                    raise_application_error(-20001,':P141_IDESTOQUEFIL não pode ser null');
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 175232715801374904
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process envia-email (
        name: envia email
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_util.prc_enviaemail(ppara => 'fernando@romancemoda.com.br'
                                         , pcopia => 'edimilson@romancemoda.com.br'
                                         , passunto => '[CORRECAO DE NOTA DE ENTRADA] '||' - '||pck_romance.fnc_nomefilial(:P25_IDFILIALDESTINO)
                                         , ptexto => 'O usuário '||v('APP_USER')||' está efetuando uma correcao da nota de entrada de número: '||:P25_DOCUMENTO);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 578597279743673245
        }
        serverSideCondition {
            type: never
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P141_IDCORRECAORECEBNOTA is null then
                        select "SEQ_IDCORRECAONOTAFISCAL".nextval
                          into :P141_IDCORRECAORECEBNOTA
                          from dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 270539776940535549
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

