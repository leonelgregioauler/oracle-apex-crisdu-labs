    pageItem P141_IDITEMNF (
        type: selectList
        label {
            label: Item da Nota
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeproduto(pidproduto => i.idproduto)
                     , i.iditnf
                from itemnf i
                where i.idnotafiscal = :P141_IDNOTAFISCAL
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
