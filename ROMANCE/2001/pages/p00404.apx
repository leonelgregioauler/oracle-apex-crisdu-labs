                    P404_SEMANACOBRANCA: &P404_SEMANACOBRANCA.
                    P404_IDREGIAOVENDA: &P404_IDREGIAOVENDA.
                    P404_SEMANAATUAL: &P404_SEMANAATUAL.
                    P404_SEMANANOVA: &P404_SEMANANOVA.
                    P404_IDREPRESENTANTEATENDE: &P404_IDREPRESENTANTEATENDE.
                    P404_IDREGIAOATUAL: &P404_IDREGIAOATUAL.
                    P404_LIBERADO: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
