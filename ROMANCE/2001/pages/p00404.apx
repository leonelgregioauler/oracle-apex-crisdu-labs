page 404 (
    name: Atualizar Notas de Venda
    title: Atualizar Notas de Venda
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            ```
    }
    security {
        formAutoComplete: true
        browserCache: false
    }
    advanced {
        reloadOnSubmit: always
    }

    region notas-de-venda-para-serem-atualizadas (
        name: Notas de Venda para serem Atualizadas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select null atualizar
                     , nv.idnotavenda
                     , to_number(nv.numeronota) "Nr Nota"
                     , pck_romance.fnc_nomerepresentante(pidrepresentante => nv.idrepresentante) "Representante"
                     , nv.semanadistribuicao/*||'  '||pck_romance.fnc_semanadias(psemana => nv.semanadistribuicao)*/ "Semana Distribuição"
                     , nv.semanacobranca/*||'  '||pck_romance.fnc_semanadias(psemana => nv.semanacobranca)*/ "Semana Cobrança"
                     , pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) "Vendedora"
                     , ( select rv.descricao from regioesvenda rv where rv.idregiaovenda = nv.idregiaovenda ) "Região de Venda"
                     , ( select sn.descricao from situacoesnotavenda sn where sn.idsituacaonotavenda = nv.idsituacaonotavenda ) "Situação"
                     , nv.dataretorno
                     , substr(nv.semanacobranca,1,2) semanacobranca
                     , substr(nv.semanacobranca,4,4) anocobranca
                     , pck_romance.fnc_nomecidade(pck_romance.fnc_idcidadevendedora(nv.idvendedora)) "Cidade Cliente"
                from notasvendas nv
                where nv.idfilial = :P0_IDFILIAL
                  and  (:P404_TIPOATUALIZACAO = 'R' 
                       and semanacobranca  = trim(:P404_SEMANAATUAL)
                       and idregiaovenda   = :P404_IDREGIAOVENDA
                       and (idrepresentante = :P404_IDREPRESENTANTE 
                          or  idrepresentanteatende = :P404_IDREPRESENTANTE )
                       and idsituacaonotavenda != 4)
                   or (:P404_TIPOATUALIZACAO = 'M' 
                       and idregiaovenda   = :P404_IDREGIAOVENDA
                       and (idrepresentante = :P404_IDREPRESENTANTE 
                          or  idrepresentanteatende = :P404_IDREPRESENTANTE )
                       and idsituacaonotavenda != 4)
                   or (:P404_TIPOATUALIZACAO = 'D' 
                       and idregiaovenda   = :P404_IDREGIAOVENDA
                       and nv.idsituacaonotavenda = 4
                       and nv.saldo > 0 
                       and nv.idrepresentante = :P404_IDREPRESENTANTE)
                   or (:P404_TIPOATUALIZACAO = 'V' 
                       and nv.idrepresentante = :P404_IDREPRESENTANTE
                       and nv.semanacobranca  = :P404_SEMANACOBRANCA) 
                ```
            pageItemsToSubmit: [
                P404_IDFILIAL
                P404_TIPOATUALIZACAO
                P404_SEMANAATUAL
                P404_IDREGIAOVENDA
                P404_IDREPRESENTANTE
                P404_SEMANACOBRANCA
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P404_LIBERADO
            value: S
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column ANOCOBRANCA (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 12
            }
        )

        column ATUALIZAR (
            reportColumnQueryId: 1
            derivedColumn: N
            type: simpleCheckbox
            heading {
                heading: Atualizar
                alignment: center
            }
            lov {
                checkboxValues: S
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column "Cidade Cliente" (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Cidade cliente
                alignment: center
            }
            layout {
                sequence: 13
            }
        )

        column DATARETORNO (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Data de Retorno
                alignment: center
            }
            layout {
                sequence: 10
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
        )

        column IDNOTAVENDA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
        )

        column "Nr Nota" (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Nr Nota
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column "Região de Venda" (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Região de Venda
                alignment: center
            }
            layout {
                sequence: 8
            }
        )

        column Representante (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column SEMANACOBRANCA (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 11
            }
        )

        column "Semana Cobrança" (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Semana Cobrança
                alignment: center
            }
            layout {
                sequence: 6
            }
        )

        column "Semana Distribuição" (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Semana Distribuição
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column Situação (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Situação
                alignment: center
            }
            layout {
                sequence: 9
            }
        )

        column Vendedora (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Vendedora
                alignment: center
            }
            layout {
                sequence: 7
            }
        )

    )

    region opções-de-atualização (
        name: Opções de Atualização
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color="GREEN"><h3>
                    Caso queiram selecionar somente algumas notas para as atualizações, cliquem no botão >> APLICAR SELECIONAVEIS <<
                    </h3></font>
                <font color="BLUE"><h3>
                    Caso queiram atualizar todas as notas do relatório, cliquem no botão >> APLICAR TODAS <<
                    </h3></font>
                ```
        }
    )

    pageItem P404_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 140
            region: @opções-de-atualização
            slot: regionBody
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidfilial number;
                begin
                  --
                  vidfilial := :P0_IDFILIAL;
                  --
                  return vidfilial;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P404_IDREGIAOATUAL (
        type: selectList
        label {
            label: Região da Semana Selecionada
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(r.idregiaovenda) display_value
                     , idregiaovenda return_value
                from regioesrepresentantes r
                where idrepresentante = :P404_IDREPRESENTANTE
                  and r.semana = :P404_SEMANACOBRANCA
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P404_IDREPRESENTANTE
                P404_SEMANACOBRANCA
            ]
        }
        layout {
            sequence: 110
            region: @opções-de-atualização
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P404_IDREGIAOVENDA (
        type: selectList
        label {
            label: Região de Venda
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(r.idregiaovenda)||' - '||SEMANA display_value
                     , idregiaovenda return_value
                from regioesrepresentantes r
                where idrepresentante = :P404_IDREPRESENTANTE
                order by 1
                
                
                
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P404_IDREPRESENTANTE
        }
        layout {
            sequence: 50
            region: @opções-de-atualização
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P404_IDREGIAOVENDA_NOVA (
        type: selectList
        label {
            label: Região Nova
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(r.idregiaovenda) display_value
                     , idregiaovenda return_value
                from regioesrepresentantes r
                where idrepresentante = :P404_IDREPRESENTANTE
                order by 1
                ```
        }
        layout {
            sequence: 120
            region: @opções-de-atualização
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P404_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||r.idrepresentante||')' || decode(r.ativo,'S','','Inativo') display_value
                     , r.idrepresentante
                from representantes r
                where idgerente in ( select idgerente
                                     from gerentes
                                     where idfilial = :P404_IDFILIAL)
                  and (   (nvl(:P404_SITUACAO_REPRESENTANTE,'T') = 'T')
                       or (:P404_SITUACAO_REPRESENTANTE = 'A' and r.ativo = 'S')
                       or (:P404_SITUACAO_REPRESENTANTE = 'I' and r.ativo = 'N'))
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: [
                P404_IDFILIAL
                P404_SITUACAO_REPRESENTANTE
            ]
        }
        layout {
            sequence: 30
            region: @opções-de-atualização
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P404_IDREPRESENTANTEATENDE (
        type: selectList
        label {
            label: Distribuidor Atende
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante) display_value
                     , r.idrepresentante
                from representantes r
                where pck_romance.fnc_filialgerente(pidgerente => r.idgerente) = :P404_IDFILIAL
                  and r.ativo  = 'S'
                  and r.idrepresentante != :P404_IDREPRESENTANTE
                order by 1 
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: [
                P404_IDREPRESENTANTE
                P404_IDFILIAL
            ]
        }
        layout {
            sequence: 90
            region: @opções-de-atualização
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P404_LABEL (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 60
            region: @opções-de-atualização
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: Semana de Cobrança
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P404_LABELREGIAONOVA (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 100
            region: @opções-de-atualização
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: Escolha as notas que serão atualizadas para a região da semana selecionada!
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P404_LIBERADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 130
            region: @opções-de-atualização
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P404_SEMANAATUAL (
        type: selectList
        label {
            label: Semana Atual
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00')||'/'||ANO) display_value
                     , trim(to_char(semana,'00')||'/'||ANO) return_value
                from semana_dias s
                where s.idsemana between pck_util.fnc_idsemanadata(sysdate)-10 and pck_util.fnc_idsemanadata(sysdate)+30
                order by s.idsemana
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 70
            region: @opções-de-atualização
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vsemana varchar2(10);
                begin
                  --
                  select semana
                  into vsemana
                  from regioesrepresentantes rr
                  where rr.idrepresentante = :P404_IDREPRESENTANTE
                    and rr.idregiaovenda   = :P404_IDREGIAOVENDA;
                  --
                  return vsemana;
                  --
                exception
                  when others then
                    return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P404_SEMANACOBRANCA (
        type: selectList
        label {
            label: Semana de Cobrança
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select SEMANA display_value
                     , SEMANA return_value
                from regioesrepresentantes r
                where idrepresentante = :P404_IDREPRESENTANTE
                order by idsemana
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P404_IDREPRESENTANTE
        }
        layout {
            sequence: 40
            region: @opções-de-atualização
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P404_SEMANANOVA (
        type: selectList
        label {
            label: Semana Nova
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00')||'/'||ANO) display_value
                     , trim(to_char(semana,'00')||'/'||ANO) return_value
                from semana_dias s
                where s.idsemana between pck_util.fnc_idsemanadata(sysdate)-10 and pck_util.fnc_idsemanadata(sysdate)+30
                order by s.idsemana
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 80
            region: @opções-de-atualização
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P404_SITUACAO_REPRESENTANTE (
        type: selectList
        label {
            label: Situação Distribuidor
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Ambos;T,Ativo;A,Inativo;I
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @opções-de-atualização
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: static
            staticValue: T
        }
    )

    pageItem P404_TIPOATUALIZACAO (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Remarcar;R,Marcar Repres. Atende;M,Debitos Repres. Atende;D, Região de Venda;V
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @opções-de-atualização
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button aplicar-todas (
        buttonName: APLICAR_TODAS
        label: Aplicar Todas Notas
        layout {
            sequence: 10
            region: @notas-de-venda-para-serem-atualizadas
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente Atualizar TODAS as Notas?','APLICAR_TODAS');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button buscar-notas (
        buttonName: BUSCAR_NOTAS
        label: Buscar Notas
        layout {
            sequence: 10
            region: @opções-de-atualização
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Aplicar Selecionáveis
        layout {
            sequence: 20
            region: @notas-de-venda-para-serem-atualizadas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente Atualizar somente as Notas Selecionadas?','SUBMIT');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @opções-de-atualização
            slot: copy
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 36
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction muda-de-tipo (
        name: Muda de Tipo
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P404_TIPOATUALIZACAO
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                value: N
            }
            affectedElements {
                selectionType: items
                items: P404_LIBERADO
            }
            execution {
                sequence: 10
                fireOnInit: false
                stopExecutionOnError: false
                waitForResult: false
            }
        )

    )

    dynamicAction tipo-débito-repres-atend (
        name: Tipo Débito Repres Atend
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P404_TIPOATUALIZACAO
        }
        clientSideCondition {
            type: item=value
            item: P404_TIPOATUALIZACAO
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P404_SEMANACOBRANCA
                    P404_LABEL
                    P404_SEMANAATUAL
                    P404_SEMANANOVA
                    P404_LABELREGIAONOVA
                    P404_IDREGIAOATUAL
                    P404_IDREGIAOVENDA_NOVA
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P404_IDREGIAOVENDA
                    P404_IDREPRESENTANTEATENDE
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-regiao-venda (
        name: Tipo Regiao Venda
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P404_TIPOATUALIZACAO
        }
        clientSideCondition {
            type: item=value
            item: P404_TIPOATUALIZACAO
            value: V
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P404_IDREGIAOVENDA
                    P404_SEMANAATUAL
                    P404_LABEL
                    P404_SEMANANOVA
                    P404_IDREPRESENTANTEATENDE
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P404_SEMANACOBRANCA
                    P404_LABELREGIAONOVA
                    P404_IDREGIAOATUAL
                    P404_IDREGIAOVENDA_NOVA
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-remarcar (
        name: Tipo Remarcar
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P404_TIPOATUALIZACAO
        }
        clientSideCondition {
            type: item=value
            item: P404_TIPOATUALIZACAO
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P404_SEMANACOBRANCA
                    P404_IDREPRESENTANTEATENDE
                    P404_LABELREGIAONOVA
                    P404_IDREGIAOATUAL
                    P404_IDREGIAOVENDA_NOVA
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P404_IDREGIAOVENDA
                    P404_SEMANAATUAL
                    P404_SEMANANOVA
                    P404_LABEL
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-repres-atende (
        name: Tipo Repres Atende
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P404_TIPOATUALIZACAO
        }
        clientSideCondition {
            type: item=value
            item: P404_TIPOATUALIZACAO
            value: M
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P404_SEMANACOBRANCA
                    P404_LABEL
                    P404_SEMANANOVA
                    P404_LABELREGIAONOVA
                    P404_IDREGIAOATUAL
                    P404_IDREGIAOVENDA_NOVA
                    P404_SEMANAATUAL
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P404_IDREGIAOVENDA
                    P404_IDREPRESENTANTEATENDE
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    validation valida-região-venda-trocada (
        name: Valida Região Venda Trocada
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P404_IDREGIAOVENDA_NOVA
        }
        error {
            errorMessage: Por favor, escolha uma região de venda válida!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P404_TIPOATUALIZACAO = 'V'
                  and v('REQUEST') in ('SUBMIT','APLICAR_TODAS')
                ```
        }
    )

    validation valida-semana-nova (
        name: Valida Semana Nova
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P404_SEMANANOVA
        }
        error {
            errorMessage: Por favor, selecione a semana de cobrança que será atualizada.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('APLICAR_TODAS','SUBMIT')
                  and :P404_TIPOATUALIZACAO = 'R'
                ```
        }
    )

    process atualizar-notas (
        name: Atualizar Notas
        type: executeCode
        editableRegion: @notas-de-venda-para-serem-atualizadas
        source {
            plsqlCode:
                ```plsql
                declare
                  vidfilial number := :P404_IDFILIAL;
                  vidpessoa number;
                begin
                  --
                  if :ATUALIZAR = 'S' then
                    --
                    if :P404_TIPOATUALIZACAO = 'V' then
                      --
                      update vendedoras v
                      set v.idregiaovenda = :P404_IDREGIAOVENDA_NOVA
                      where v.idvendedora = ( select idvendedora 
                                              from notasvendas n
                                              where n.idnotavenda = :IDNOTAVENDA
                                                and n.idfilial = vidfilial );
                      --
                      update notasvendas n
                      set n.idregiaovenda = :P404_IDREGIAOVENDA_NOVA
                      where n.idnotavenda = :IDNOTAVENDA
                        and n.idfilial    = vidfilial;
                      --
                    elsif :P404_TIPOATUALIZACAO = 'R' then
                      --
                      update notasvendas
                      set semanacobranca = :P404_SEMANANOVA
                        , dataretorno = ( select dt_ini
                                          from semana_dias
                                          where idsemana = pck_util.fnc_idsemana(:P404_SEMANANOVA) )
                      where idnotavenda = :IDNOTAVENDA
                        and idfilial    = vidfilial;
                      --
                      insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao,idrepresentante)
                      values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Nota remarcada da semana: '||:P404_SEMANAATUAL||' para a semana: '||:P404_SEMANANOVA,:IDNOTAVENDA,'C',:P404_IDREPRESENTANTE);
                      --
                    elsif :P404_TIPOATUALIZACAO = 'D' then
                      --
                      update notasvendas
                      set idrepresentanteatende = :P404_IDREPRESENTANTEATENDE
                      where idnotavenda = :IDNOTAVENDA
                        and idfilial    = vidfilial;
                      --
                      update vendedoras 
                      set idrepresentante = nvl(:P404_IDREPRESENTANTEATENDE ,:P404_IDREPRESENTANTE)
                      where idvendedora   = ( select idvendedora
                                              from notasvendas n
                                              where n.idnotavenda = :IDNOTAVENDA
                                                and n.idfilial    = vidfilial );
                      --
                      insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao,idrepresentante)
                      values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Débito marcado para o distribuidor: '||pck_romance.fnc_nomerepresentante(:P404_IDREPRESENTANTEATENDE)||' realizar o atendimento',:IDNOTAVENDA,'C',:P404_IDREPRESENTANTE);
                      --
                    elsif :P404_TIPOATUALIZACAO = 'M' then
                      --
                      update notasvendas
                      set idrepresentanteatende = :P404_IDREPRESENTANTEATENDE
                      where idnotavenda = :IDNOTAVENDA
                        and idfilial    = vidfilial;
                      --
                      update vendedoras 
                      set idrepresentante = nvl(:P404_IDREPRESENTANTEATENDE ,:P404_IDREPRESENTANTE)
                        , idregiaovenda   = :P404_IDREGIAOVENDA
                      where idfilial = vidfilial
                        and idvendedora = ( select idvendedora 
                                            from notasvendas n
                                            where n.idnotavenda = :IDNOTAVENDA
                                              and n.idfilial    = vidfilial);
                      --
                      select idpessoa
                      into vidpessoa
                      from vendedoras v
                      where idvendedora = ( select idvendedora 
                                            from notasvendas n
                                            where n.idnotavenda = :IDNOTAVENDA
                                              and n.idfilial    = vidfilial);
                      --
                      favorita.pck_integracao_fav_widecomm.prc_pessoas ( pidpessoa => vidpessoa );
                      --
                      insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao,idrepresentante)
                      values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Nota marcada para o distribuidor: '||pck_romance.fnc_nomerepresentante(nvl(:P404_IDREPRESENTANTEATENDE ,:P404_IDREPRESENTANTE))||' realizar o atendimento',:IDNOTAVENDA,'C',:P404_IDREPRESENTANTE);
                      --
                    end if;
                    --
                  end if;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Nota(s) Atualizada(s)!
        }
        advanced {
            executionMappingIdentifier: 1463297672050435210
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process atualizar-todas-notas (
        name: Atualizar todas notas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidfilial number := :P404_IDFILIAL;
                begin
                  --
                  if :P404_TIPOATUALIZACAO = 'V' then
                    --
                    for i in ( select n.idnotavenda
                                    , n.idvendedora
                                    , n.idrepresentante
                               from notasvendas n
                               where n.idrepresentante = :P404_IDREPRESENTANTE
                                 and n.semanacobranca  = :P404_SEMANACOBRANCA 
                                 and n.idfilial = vidfilial )
                    loop  
                      --
                      update vendedoras v
                      set v.idregiaovenda = :P404_IDREGIAOVENDA_NOVA
                      where v.idvendedora = i.idvendedora
                        and v.idfilial = vidfilial;
                      --
                      update notasvendas n
                      set n.idregiaovenda = :P404_IDREGIAOVENDA_NOVA
                      where n.idnotavenda = i.idnotavenda
                        and n.idfilial = vidfilial;
                      --
                      insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao,idrepresentante)
                      values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Região de Venda Alterada Para: '||pck_romance.fnc_nomeregiaovenda(:P404_IDREGIAOVENDA_NOVA)||'.',i.idnotavenda,'C',i.idrepresentante);
                      --
                    end loop;
                    --
                  elsif :P404_TIPOATUALIZACAO = 'R' then
                    --
                    for i in ( select n.idnotavenda
                                    , n.idrepresentante
                               from notasvendas n
                               where (n.idrepresentante = :P404_IDREPRESENTANTE
                                   or n.idrepresentanteatende = :P404_IDREPRESENTANTE)
                                 and n.semanacobranca         = :P404_SEMANAATUAL
                                 and n.idregiaovenda          = :P404_IDREGIAOVENDA
                                 and n.idfilial               = vidfilial
                                 and n.idsituacaonotavenda     != 4 )
                    --
                    loop
                      --
                      update notasvendas
                      set semanacobranca = :P404_SEMANANOVA
                        , dataretorno = ( select dt_ini
                                          from semana_dias
                                          where idsemana = pck_util.fnc_idsemana(:P404_SEMANANOVA) )
                      where idnotavenda = i.idnotavenda
                        and idfilial = vidfilial;
                      --
                      insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao,idrepresentante)
                      values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Nota remarcada da semana: '||:P404_SEMANAATUAL||' para a semana: '||:P404_SEMANANOVA,i.idnotavenda,'C',i.idrepresentante);
                      --
                    end loop;
                    --
                  elsif :P404_TIPOATUALIZACAO = 'D' then
                    --
                    for i in ( select n.idrepresentante
                                    , n.idnotavenda
                                    , n.idvendedora
                                    , ( select idpessoa from vendedoras v where idvendedora = n.idvendedora ) idpessoa
                               from notasvendas n
                               where n.idrepresentante = :P404_IDREPRESENTANTE
                                 and n.idsituacaonotavenda = 4
                                 and n.saldo > 0 
                                 and n.idfilial = vidfilial
                                 and idregiaovenda = :P404_IDREGIAOVENDA )
                    loop
                      --
                      update notasvendas
                      set idrepresentanteatende = :P404_IDREPRESENTANTEATENDE
                      where idnotavenda = i.idnotavenda
                        and idfilial = vidfilial;
                      --
                      update vendedoras 
                      set idrepresentante = nvl(:P404_IDREPRESENTANTEATENDE ,:P404_IDREPRESENTANTE)
                      where idvendedora   = i.idvendedora
                        and idfilial = vidfilial;
                      --
                      favorita.pck_integracao_fav_widecomm.prc_pessoas ( pidpessoa => i.idpessoa );
                      --
                      insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao,idrepresentante)
                      values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Débito marcado para o distribuidor: '||pck_romance.fnc_nomerepresentante(:P404_IDREPRESENTANTEATENDE)||' realizar o atendimento',i.idnotavenda,'C',i.idrepresentante);
                      --
                    end loop;
                    --
                  elsif :P404_TIPOATUALIZACAO = 'M' then
                    --
                    for i in ( select n.idnotavenda
                                    , n.idrepresentante
                                    , n.idvendedora
                                    , ( select idpessoa from vendedoras v where idvendedora = n.idvendedora ) idpessoa
                               from notasvendas n
                               where (n.idrepresentante = :P404_IDREPRESENTANTE
                                   or n.idrepresentanteatende = :P404_IDREPRESENTANTE)
                                 and n.idfilial               = vidfilial
                                 and n.idregiaovenda          = :P404_IDREGIAOVENDA
                                 and n.idsituacaonotavenda     != 4 )
                    loop
                      --
                      update notasvendas
                      set idrepresentanteatende = :P404_IDREPRESENTANTEATENDE
                      where idnotavenda = i.idnotavenda
                        and idfilial = vidfilial;
                      --
                      update vendedoras 
                      set idrepresentante = nvl(:P404_IDREPRESENTANTEATENDE ,:P404_IDREPRESENTANTE)
                        , idregiaovenda   = :P404_IDREGIAOVENDA
                      where idvendedora = i.idvendedora
                        and idfilial = vidfilial;
                      --
                      favorita.pck_integracao_fav_widecomm.prc_pessoas ( pidpessoa => i.idpessoa );
                      --
                      insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao,idrepresentante)
                      values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Nota marcada para o distribuidor: '||pck_romance.fnc_nomerepresentante(nvl(:P404_IDREPRESENTANTEATENDE ,:P404_IDREPRESENTANTE))||' realizar o atendimento',i.idnotavenda,'C',i.idrepresentante);
                      --
                    end loop;
                    --
                  end if;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Notas Atualizadas com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1463298460466435218
        }
        serverSideCondition {
            whenButtonPressed: @aplicar-todas
        }
    )

