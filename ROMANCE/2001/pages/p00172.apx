    pageItem P172_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomecidade(idcidade)  display_value
                     , c.IDCIDADE return_value 
                from CIDADES c
                   , filiaisregioesvenda f
                   , estados e
                where f.idfilial = :P0_IDFILIAL
                  and f.idestado = e.idestado
                  and e.idestado = c.idestado
                  and e.idpais   = pck_romance.fnc_paisusuario(v('APP_USER')) 
                order by 1
                ```
        }
        layout {
            sequence: 250
            region: @contato-do-site
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 15
        }
        source {
            type: databaseColumn
            databaseColumn: IDCIDADE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

