    process verifica-acesso-total (
        name: Verifica Acesso Total
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  vacesso varchar2(1);
                  --
                begin
                  --
                  begin
                    --
                    select 'S'
                    into vacesso
                    from dual
                    where exists ( select 1
                                   from usuariosgruposatendimento u
                                   where u.usuario = v('APP_USER')
                                     and u.idgrupoatendimento in (0,58) );
                    --
                  exception
                    when others then
                      vacesso := 'N';
                  end;
                  --
                  :P172_ACESSO_TOTAL := vacesso;
                  --
                end;
