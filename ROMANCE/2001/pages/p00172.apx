        }
        advanced {
            preText:
                ```html
                <font color="red"><h2>
                    Esta indicação Expirou. Por favor, encaminhe novamente para o mesmo ou outro distribuidor!
                    </h2></font>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from controleexpiracaoindicacoes ci
                               where ci.idcontrolecontatossite = :P172_IDCONTROLECONTATOSSITE
                                 and ci.expirado = 'S' )
                  and not exists ( select 1
                                   from controleexpiracaoindicacoes ci
                                   where ci.idcontrolecontatossite = :P172_IDCONTROLECONTATOSSITE
                                     and ci.expirado = 'N' )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

