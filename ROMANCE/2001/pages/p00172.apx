    process rejeitar (
        name: Rejeitar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidclassificacaosac number;
                  vidcaracteristicasac number := 4;
                  vobservacao varchar2(1000);
                  vidvalorclassificacao number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vmd5 varchar2(1000);
                  --
                begin
                  --
                  update controlecontatossite c
                  set situacao = 'F'
                    , observacaofilial = :P172_OBSERVACAOFILIAL
                  where c.idcontrolecontatossite = :P172_IDCONTROLECONTATOSSITE;
                  --
                  select idusuario
                  into vidusuario
                  from usuarios 
                  where usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoessac(pidclassificacaosac => vidclassificacaosac,
