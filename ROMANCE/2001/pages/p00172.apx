    region informações-da-consulta-ao-spc (
        name: Informações da Consulta ao SPC
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.dataconsulta
                     , c.protocolo
                     , c.regiaocpf
                     , c.situacaocpf
                     , c.nome
                     , c.nomemae
                     , c.spc_quantidade
                     , c.spc_valortotal
                     , decode(c.restricao,'S','Possui Restrição','Sem Restrição') restricao
                     , idconsultaspc
                     , datanascimento
                     , ccf
                from consultaspc c
                where c.cpf = replace(replace(:P172_CPF,'.',''),'-','')
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from consultaspc c
                where c.cpf = replace(replace(:P172_CPF,'.',''),'-','')
                  and :P172_CPF is not null
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

