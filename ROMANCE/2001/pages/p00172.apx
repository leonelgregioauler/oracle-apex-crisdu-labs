    pageItem P172_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                    , idrepresentante return_value
                from representantes
                where idgerente = ( select idgerente from gerentes where idfilial = :P0_IDFILIAL)
                  and ativo = 'S'
                order by 1 
                ```
        }
        layout {
            sequence: 80
            region: @contato-do-site
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
