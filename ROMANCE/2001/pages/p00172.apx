    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_imprimir()
            {
              vurl = document.getElementById("P172_SESSION_IMPRIME").value;
              pjan = window.open(vurl,'popup','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=1024,height=1024,left=250,top=100');
              pjan.focus();
            }
            ```
    }
    htmlHeader {
        htmlHeader:
            ```html
            <script language="JavaScript" type="text/javascript"> 
             
            function formatar_mascara(src,mascara,evt){
            var tecla;  
            if(evt.which){tecla = evt.which}
            else if(evt.keyCode){ tecla = evt.keyCode;}  
             if( tecla != 8 ){
             var campo = src.value.length;
             var saida = mascara.substring(0,1);
             var texto = mascara.substring(campo);
             if(texto.substring(0,1) != saida) {
             src.value+=texto.substring(0,1);}}
            }
             
             
            </script>
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region acompanhamento-do-painel (
        name: Acompanhamento do Painel
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.datasituacao Data_motivo
                     , pck_romance.fnc_nomerepresentante (p.iddistribuidor) Distribuidor
                     , pck_romance.fnc_nomefilial (p.idfilial) Franquia 
                     , s.descricao situacao
                     , p.observacao motivo
                from painelcontatossite p
                   , situacoespainel s
                where p.idcontrolecontatossite = :P172_IDCONTROLECONTATOSSITE
                  and p.idsituacaopainel = s.idsituacaopainel
                order by 1 desc;
                
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.painelcontatossite p
                where p.idpainelcontatossite is not null
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }

