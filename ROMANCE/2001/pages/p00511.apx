        column IDFILIAL (
            type: selectList
            heading {
                heading: Empresa
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome      display_value
                         , idfilial  return_value
                    from vw_filiais
                    where tipofilial = 'D'
                      or idfilial = 200
                    order by 1
                    ```
                displayExtraValues: false
                nullDisplayValue: "- Todas - "
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
