            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select w.nome            display_value
                         , w.idrepresentante return_value
                    from vw_repres_filial_rmc w
                    --where idfilial = :IDFILIAL
                    order by 1 asc
                    ```
                displayExtraValues: false
                nullDisplayValue: "- Todas - "
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: IDREPRESENTANTE
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDVENDEDORA (
            type: popupLov
            heading {
                heading: Consultora
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomepessoa(idpessoa) display_value
                         , idvendedora
                    from vendedoras v
                    where exists ( select 1
                                   from notasvendas n
                                   where n.idvendedora = v.idvendedora
                                     and n.idsituacaonotavenda = 4 )
                    /*  and v.idrepresentante = :IDREPRESENTANTE*/
                    order by 1
                    ```
                displayExtraValues: false
                nullDisplayValue: "- Todas - "
            }
            cascadingLov {
                parentColumns: IDREPRESENTANTE
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: IDVENDEDORA
                dataType: number
            }
        )

    )

