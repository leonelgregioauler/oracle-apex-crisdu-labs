    process destino-da-postagem-save-interactive-grid-data (
        name: Destino da Postagem - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @destino-da-postagem
        lockRow {
            lockRow: false
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 1575650451368223028
        }
    )

    process gera-para-grupo-empresas (
        name: Gera para Grupo Empresas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P511_GRUPO_FILIAL is not null then
                    --
                      for a in ( select idfilial
                                 from vw_filiais w
                                 where ( tipofilial = 'D' or idfilial = 200)
                                   and not exists ( select 1
                                                    from destinospostagensmarketing
                                                    where idfilial            = w.idfilial
                                                      and idpostagemmarketing = :P511_IDPOSTAGEMMARKETING ) 
                                   -- < T9343917
                                    and ((:P511_GRUPO_FILIAL = 'BRASIL'    and w.idfilial in (1089,121,290,120,1070,1072,1082,1242,1243,222,1090,1210,320,1083,1071,221,230,1223,140,1252,1303,123,1106,1227,1084,401,100,122,124,1132,1281) )
                                    or ( :P511_GRUPO_FILIAL = 'NORTE'      and w.idfilial in (1089,121,290,120,1070,1072,1082,1242,1243,222,1090,1210,320,1083,1071,221,230,1223,140,1252,1303) )
                                    or ( :P511_GRUPO_FILIAL = 'SUL'        and w.idfilial in (123,1106,1227,1084,401,100,122,124,1132,1281) )
                                    or ( :P511_GRUPO_FILIAL = 'BRASILIA'   and w.idfilial in (1217,1275,1246,1255) )
                                    or ( :P511_GRUPO_FILIAL = 'PARAGUAI'   and w.idfilial in (1081,1095,1111) )
                                    or ( :P511_GRUPO_FILIAL = 'ESTRELASBR' and w.idfilial in (1089,121,290,120,1070,1072,1082,1242,1243,222,1090,1210,320,1083,1071,221,230,1223,140,1252,1303,123,1106,1227,1084,401,100,122,124,1132,1281,1217,1275,1246,1255) )
                                    or ( :P511_GRUPO_FILIAL = 'URUGUAI'    and w.idfilial in (1041) )
                                    or ( :P511_GRUPO_FILIAL = 'AL'         and w.idfilial in (1209,1129,1148,1194,1206,1108,1244,1247,1121))) )
                                    -- T9343917 />)
                      loop
                        --
                        insert into destinospostagensmarketing (iddestinopostagemmarketing, idpostagemmarketing, idfilial, idrepresentante, idvendedora, datainicio, datafim)
                        values ( seq_iddestpostagemmarketing.nextval, :P511_IDPOSTAGEMMARKETING, a.idfilial, null, null, to_date(trim(:P511_DATAINICIO),'DD/MM/RRRR HH24:MI:SS'), to_date(trim(:P511_DATAFIM),'DD/MM/RRRR HH24:MI:SS') );
                        --
                      end loop;
                    --
                    else
                    --
                    raise_application_error(-20001,'Atenção! Informe o Grupo de Empresas.');
                    --
                  end if;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 49869202211628906
        }
        serverSideCondition {
            type: request=Value
            value: GERAGRUPOEMPRESAS
        }
    )

    process gerar-para-todas-empresas (
        name: Gerar Para todas Empresas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  for a in ( select idfilial
                             from vw_filiais w
                             where ( tipofilial = 'D' or idfilial = 200)
                               and not exists ( select 1
                                                from destinospostagensmarketing
                                                where idfilial            = w.idfilial
                                                  and idpostagemmarketing = :P511_IDPOSTAGEMMARKETING ) )
                  loop
                    --
                    insert into destinospostagensmarketing (iddestinopostagemmarketing, idpostagemmarketing, idfilial, idrepresentante, idvendedora, datainicio, datafim)
