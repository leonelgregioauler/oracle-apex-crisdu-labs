page 727 (
    name: Edição Motivo Clientes Reativas
    title: Edição Motivo Clientes Reativas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region edição-motivos-reativação-de-clientes (
        name: Edição Motivos - Reativação de  Clientes
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P727_IDMOTIVOREATIVAVEND (
        type: hidden
        layout {
            sequence: 10
            region: @edição-motivos-reativação-de-clientes
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDMOTIVOREATIVAVEND
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P727_MOTIVO (
        type: textField
        label {
            label: Motivo
            alignment: left
        }
        layout {
            sequence: 20
            region: @edição-motivos-reativação-de-clientes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: MOTIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P727_TIPO (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Conclusão;C,Devolução;D
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @edição-motivos-reativação-de-clientes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: TIPO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 10
            region: @edição-motivos-reativação-de-clientes
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @edição-motivos-reativação-de-clientes
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process atualiza-motivo (
        name: Atualiza Motivo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 
                 vidmotivoreativavend number := :P727_IDMOTIVOREATIVAVEND;
                 vmotivo              varchar2(100) := :P727_MOTIVO;
                 vtipo                varchar2(1) := :P727_TIPO;
                 voperacao_dml        varchar2(1) := 'U';
                 vmd5                 varchar2(32767) := null;
                
                
                begin
                
                roman.pck_cadastros_rmc.prc_motivosreativavend(pidmotivoreativavend => vidmotivoreativavend,
                                                               pmotivo              => vmotivo,
                                                               ptipo                => vtipo,
                                                               pmd5                 => :pmd5,
                                                               poperacao_dml        => voperacao_dml);
                                                               
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2432842410598084418
        }
    )

    process new (
        name: New
        type: autoRowFetch
        source {
            tableName: MOTIVOSREATIVAVEND
            pkColumn: IDMOTIVOREATIVAVEND
            pkItem: P727_IDMOTIVOREATIVAVEND
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 2432841463703084408
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 726
                action: resetPagination
            }
        }
    )

)

