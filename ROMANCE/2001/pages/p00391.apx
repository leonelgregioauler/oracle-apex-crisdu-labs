    process cofnirmar-recebimento-de-abatimento (
        name: Cofnirmar Recebimento de Abatimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_controle_rmc.prc_confirmaabatimentopedido( pidpedido => :P391_IDEDITAR,
                                                                 pusuario => v('APP_USER'),
                                                                 psemana => :P391_SEMANA );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Recebimento confirmado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 814932646539325538
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR
        }
    )

