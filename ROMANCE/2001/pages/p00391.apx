    region pagamentos-recebidos-nesta-semana (
        name: Pagamentos Recebidos nesta Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pp.idpedido
                     , pp.numeropedido
                     , pp.vendedora
                     , pp.dataemissao
                     , pp.databaixa
                     , pp.datavencimentomenor
                     , pp.valorapagar
                     , '-' null1
                     , pp.valorcomissaodistribuidor
                     , '-' null2
                     , pp.valorcomissaogerente
                     , '=' igual
                     , (pp.valorapagar-valorcomissaodistribuidor) valorserabatido
                     , cc.data datarecebimento
                     , cc.usuario recebidopor
                from favorita.vw_comissoes_descontar_fav pp
                   , controleabatimentoscomissoes cc
                where pp.idrepresentante = :P391_IDREPRESENTANTE
                  and pp.idfilialromance = :P0_IDFILIAL
                  and cc.idpedido        = pp.idpedido
                  and cc.semana          = :P391_SEMANA
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from favorita.vw_comissoes_descontar_fav pp
                   , controleabatimentoscomissoes cc
                where pp.idrepresentante = :P391_IDREPRESENTANTE
                  and cc.idpedido        = pp.idpedido
                  and cc.semana          = :P391_SEMANA
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
