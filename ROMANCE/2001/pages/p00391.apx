page 391 (
    name: Pedidos de Venda Direta
    title: Pedidos de Venda Direta
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 70%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_confirmar(pid)
            {
              document.getElementById("P391_IDEDITAR").value = pid;
              apex.submit('CONFIRMAR');
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhar-pedidos-de-venda-direta (
        name: Acompanhar Pedidos de Venda Direta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pp.idpedido
                     , pp.numeropedido
                     , pp.vendedora
                     , pp.dataemissao
                     , pp.databaixa
                     , pp.datavencimentomenor
                     , pp.valorapagar
                     , '-' null1
                     , pp.valorcomissaodistribuidor
                     , '-' null2
                     , pp.valorcomissaogerente
                     , '=' igual
                     , (pp.valorapagar-valorcomissaodistribuidor) valorserabatido
                     , '<a href="javascript:fnc_confirmar('|| idpedido ||')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>' confirmar
                from favorita.vw_comissoes_descontar_fav pp
                where pp.idrepresentante = :P391_IDREPRESENTANTE
                  and pp.idfilialromance = :P0_IDFILIAL
                  and trunc(datavencimentomenor) between trunc(sysdate)-10 and trunc(sysdate)+90
                  and databaixa is null
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 814931074410325522
        }

