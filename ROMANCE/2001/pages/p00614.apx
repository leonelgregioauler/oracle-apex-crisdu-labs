    pageItem P614_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta 
                     , s.idsemana
                from semana_dias s
                   , campanhas c
                where c.tipocampanha = 'M'
                  and s.idsemana between pck_util.fnc_idsemana(c.semanaini) and pck_util.fnc_idsemana(c.semanafim) 
                order by 2
                ```
        }
        layout {
            sequence: 40
            region: @liberar-distribuidor-na-campanha
            slot: regionBody
            alignment: left
        }
        appearance {
