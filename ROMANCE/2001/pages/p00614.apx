    process consulta-dml-em-metricas-campanhas (
        name: Consulta DML em Metricas Campanhas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vmd5 varchar2(1000);
                begin
                  --
                  pck_campanhas.prc_metricascampanhas(pidmetricacampanha => :P614_IDMETRICACAMPANHA,
                                                      pdescricao => :P614_NOME_METRICA,
                                                      pgrupo => :P614_GRUPO_METRICA,
                                                      pmd5 => vmd5,
                                                      poperacao_dml => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5566371867441931926
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P614_IDMETRICACAMPANHA is not null and :P614_OPERACAO = 'M'
        }
    )

    process consulta-dml-em-valores-metricas-campanhas (
        name: Consulta DML em Valores Metricas Campanhas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vmd5 varchar2(1000);
                begin
                  --
                  PCK_CAMPANHAS.PRC_VALORESMETRICASCAMPANHAS( PIDVALORMETRICACAMPANHA => :P614_IDVALORMETRICACAMPANHA,
                                                              PIDCAMPANHA => :P614_IDCAMPANHA,
                                                              PIDMETRICACAMPANHA => :P614_IDMETRICACAMPANHA_VALOR,
                                                              PIDFILIAL => :P614_IDFILIAL,
                                                              PNIVEL => :P614_NIVEL,
                                                              PPONTOS => :P614_PONTOS,
                                                              PVALORINICIAL => :P614_VALORINICIAL,
                                                              PVALORFINAL => :P614_VALORFINAL,
                                                              PMD5 => vmd5,
                                                              POPERACAO_DML => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5566372469113931932
        }
    )

    process processo-dml-em-metricas-campanhas (
        name: Processo DML em Metricas Campanhas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vmd5 varchar2(1000);
                begin
                  --
                  if v('REQUEST') = 'CRIAR_METRICA' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR_METRICA' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR_METRICA' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  pck_campanhas.prc_metricascampanhas(pidmetricacampanha => :P614_IDMETRICACAMPANHA,
                                                      pdescricao => :P614_NOME_METRICA,
                                                      pgrupo => :P614_GRUPO_METRICA,
                                                      pmd5 => vmd5,
                                                      poperacao_dml => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5566371475676931922
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: V('REQUEST') IN ('SALVAR_METRICA','CRIAR_METRICA','DELETAR_METRICA')
        }
    )

    process processo-dml-em-representantes-campanhas (
        name: Processo DML em Representantes Campanhas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vmd5 varchar2(1000);
                begin
                  --
                  if v('REQUEST') = 'CRIAR_REPRES' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR_REPRES' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR_REPRES' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  PCK_CAMPANHAS.PRC_REPRESENTANTESCAMPANHAS( PIDREPRESENTANTECAMPANHA => :P614_IDREPRESENTANTECAMPANHA,
                                                             PIDCAMPANHA => :P614_IDCAMPANHA_REPRES,
                                                             PIDFILIAL => :P614_IDFILIAL_REPRES,
                                                             PIDSEMANA => :P614_IDSEMANA,
                                                             PIDREPRESENTANTE => :P614_IDREPRESENTANTE,
                                                             PMD5 => :P614_MD5,
                                                             POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Distribuidor adicionado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5580936047717529381
        }
        serverSideCondition {
            type: request=Value
            value: CRIAR_REPRES
        }
    )

    process processo-dml-em-valores-metricas-campanhas (
        name: Processo DML em Valores Metricas Campanhas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vmd5 varchar2(1000);
                begin
                  --
                  if v('REQUEST') = 'CRIAR_VALOR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR_VALOR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR_VALOR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  PCK_CAMPANHAS.PRC_VALORESMETRICASCAMPANHAS( PIDVALORMETRICACAMPANHA => :P614_IDVALORMETRICACAMPANHA,
                                                              PIDCAMPANHA => :P614_IDCAMPANHA,
                                                              PIDMETRICACAMPANHA => :P614_IDMETRICACAMPANHA_VALOR,
                                                              PIDFILIAL => :P614_IDFILIAL,
                                                              PNIVEL => :P614_NIVEL,
                                                              PPONTOS => :P614_PONTOS,
                                                              PVALORINICIAL => :P614_VALORINICIAL,
                                                              PVALORFINAL => :P614_VALORFINAL,
                                                              PMD5 => vmd5,
                                                              POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: "Processo realizado com sucesso! "
        }
        advanced {
            executionMappingIdentifier: 5578261513661637864
        }
        serverSideCondition {
            type: request=Value
            value: SALVAR_VALOR
        }
    )

)

