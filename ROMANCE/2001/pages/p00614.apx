page 614 (
    name: Cadastros Operacionais
    title: Cadastros Operacionais
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-métricas (
        name: Cadastro de Métricas
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P614_OPERACAO
            value: M
        }
    )

    region itens (
        name: Itens
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region liberar-distribuidor-na-campanha (
        name: Liberar Distribuidor na Campanha
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        serverSideCondition {
            type: item=value
            item: P614_OPERACAO
            value: R
        }
        settings {
            outputAs: text
        }
    )

    region valores-da-métrica (
        name: Valores da Métrica
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        serverSideCondition {
            type: item=value
            item: P614_OPERACAO
            value: V
        }
        settings {
            outputAs: text
        }
    )

    pageItem P614_GRUPO_METRICA (
        type: radioGroup
        label {
            label: Grupo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Romance;R,Favorita;F,Organização;O,Outros;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @cadastro-de-métricas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P614_IDCAMPANHA (
        type: selectList
        label {
            label: Campanha
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.descricao
                     , c.idcampanha
                from campanhas c
                where c.tipocampanha = 'M'
                ```
        }
        layout {
            sequence: 20
            region: @valores-da-métrica
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

