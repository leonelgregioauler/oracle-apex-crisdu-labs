    pageItem P614_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) display_value
                     , r.idrepresentante return_value
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente
                  and g.idfilial  = :P614_IDFILIAL_REPRES
                order by 1 
                ```
        }
        cascadingLov {
            parentItems: P614_IDFILIAL_REPRES
        }
        layout {
            sequence: 50
            region: @liberar-distribuidor-na-campanha
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

