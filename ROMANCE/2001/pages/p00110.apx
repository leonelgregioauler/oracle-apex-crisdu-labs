            displayLocation: inlineInNotification
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vparametro varchar2(1);
                begin 
                  --
                  select pck_romance.fnc_retornaparametro ( parametro => 'ESTOQUEPORGRADE'
                                                          , pidfilial => :P0_IDFILIAL)
                  into vparametro
                  from dual;     
                  --      
                  if :P110_OPCAO = 'P' then
                      :P110_IDESTOQUEFIL := :P110_IDPRODUTO2;
                  end if;
                  --                                
                  if :P110_IDMOVTOESTOQUEFILIAL is null then
                    :P110_OBSERVACAO := 'Saída Manual. '||:P110_OBSERVACAO;
                    select "SEQ_IDMOVTOESTOQUEFILIAL".nextval
                    into :P110_IDMOVTOESTOQUEFILIAL
                    from dual;
                  end if;
                  --
                  --if vparametro = 'S' then
                    :P110_QTD_PP  := to_number(:P110_QTD_PP ) * -1;
                    :P110_QTD_P   := to_number(:P110_QTD_P  ) * -1;
                    :P110_QTD_M   := to_number(:P110_QTD_M  ) * -1;
                    :P110_QTD_G   := to_number(:P110_QTD_G  ) * -1;
                    :P110_QTD_GG  := to_number(:P110_QTD_GG ) * -1;
                    :P110_QTD_EGG := to_number(:P110_QTD_EGG) * -1;
                    :P110_QTD_EXGG := to_number(:P110_QTD_EXGG) * -1;
                    :P110_QTD_U   := to_number(:P110_QTD_U  ) * -1;
                /*  else
                    :P110_QUANTIDADE  := to_number(:P110_QUANTIDADE  ) * -1;
                  end if;*/
                  --
                  --
                  if :P110_DESTINO = 'P' then
                    --
                    :P110_OBSERVACAO := 'Saída com destino ao estoque distribuição PA. '||:P110_OBSERVACAO;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 203829967471203897
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process idestoquefil (
        name: idestoquefil
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P110_IDESTOQUEFIL is null then
                    :P110_IDESTOQUEFIL := :P110_IDPRODUTO2;
                  end if;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 33661461034315781
        }
    )

    process movimenta-estoque-pa (
        name: movimenta estoque PA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  videstoquepostoavancado number;
                  vquantidade             number;
                begin
                    select ep.idestpostoavancado
                    into videstoquepostoavancado
                    from estoquepostoavancado ep
                    where ep.idestoquefil    = :P110_IDESTOQUEFIL
                      and ep.idpostoavancado = :P110_IDPOSTOAVANCADO;
                    --
                    vquantidade := nvl(:P110_QTD_PP,0) 
                                 + nvl(:P110_QTD_P,0) 
                                 + nvl(:P110_QTD_M,0) 
                                 + nvl(:P110_QTD_G,0) 
                                 + nvl(:P110_QTD_GG,0) 
                                 + nvl(:P110_QTD_EGG,0) 
                                 + nvl(:P110_QTD_EXGG,0) 
                                 + nvl(:P110_QTD_U,0);
                    --
                    -- colocado * -1 nas quantidades para positivar, pois na get_pk, é feito * -1 para dizer que eh saida de estoque
                    --
                    insert into movimentosestoquepostoavan ( idmovtoestpostoavan    , idpostoavancado , idestoquefil
                                                           , observacao             , usuario         , datamovimento
                                                           , idestoquepostoavancado , qtd_u           , idfilial )
                    values ( seq_idmovtoestpostoavancado.nextval                               , :P110_IDPOSTOAVANCADO , :P110_IDESTOQUEFIL
                           , 'Trasnferencia de Mercadoria da distribuição para Posto Avançado' , v('APP_USER')         , sysdate
                           , videstoquepostoavancado                                           , vquantidade *-1      , :P0_IDFILIAL );
                    --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 29885779258922919
        }
        serverSideCondition {
            type: item=value
            item: P110_DESTINO
            value: P
        }
    )

    process movimenta-estoque-reemb (
        name: movimenta estoque reemb
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  videstoquereembalagem number;
                  vqtd  number;
                begin
                    select ee.idestoquereembalagem
                    into videstoquereembalagem
                    from estoquereembalagem ee
                    where ee.idestoquefil = :P110_IDESTOQUEFIL
                      and ee.idfilial     = :P0_IDFILIAL;
                    --
                    -- colocado * -1 nas quantidades para positivar, pois na get_pk, é feito * -1 para dizer que eh saida de estoque
                    --
                    if pck_romance.fnc_retornaparametro(parametro => 'ESTOQUEEMBPORGRADE', pidfilial => :P0_IDFILIAL) = 'N' then
                      --
                      vqtd := nvl( :P110_QTD_PP  *-1 ,0) +nvl( :P110_QTD_P  *-1,0)+
                             nvl( :P110_QTD_M     *-1,0) +nvl(:P110_QTD_G  *-1 ,0)+nvl(:P110_QTD_GG*-1,0)+
                             nvl( :P110_QTD_EGG   *-1 ,0)+nvl(:P110_QTD_EXGG*-1,0)+nvl(:P110_QTD_U  *-1 ,0);
                      --
                      insert into movimentosestoquereemb ( idmovtoestreemb  , idestoquefil          , qtd_u
                                                         , iditprodembal    , observacao
                                                         , usuario          , datamovimento         , idestoquereembalagem
                                                         , idfilial         , iditemdevolucaorepres )
                      values ( seq_idmovtoestreemb.nextval   , :P110_IDESTOQUEFIL              , vqtd
                             , null                          , 'Transferencia de Mercadoria da distribuição para reembalagem'
                             , v('APP_USER')                     , sysdate                    , videstoquereembalagem
                             , :P0_IDFILIAL                   , NULL );
                      --
                    elsif pck_romance.fnc_retornaparametro(parametro => 'ESTOQUEEMBPORGRADE', pidfilial => :P0_IDFILIAL) = 'S' then
                      --
                      insert into movimentosestoquereemb ( idmovtoestreemb  , idestoquefil     
                                                         , iditprodembal    , observacao
                                                         , usuario          , datamovimento    , idestoquereembalagem
                                                         , idfilial         , qtd_pp           , qtd_p
                                                         , qtd_m            , qtd_g            , qtd_gg
                                                         , qtd_egg          , qtd_exgg          , qtd_u            , iditemdevolucaorepres )
                      values ( seq_idmovtoestreemb.nextval   , :P110_IDESTOQUEFIL      
                             , null                          , 'Transferencia de Mercadoria da distribuição para reembalagem'
                             , v('APP_USER')                 , sysdate                 , videstoquereembalagem
                             , :P0_IDFILIAL                  , :P110_QTD_PP  *-1          , :P110_QTD_P  *-1
                             , :P110_QTD_M     *-1              , :P110_QTD_G  *-1           , :P110_QTD_GG*-1
                             , :P110_QTD_EGG   *-1              , :P110_QTD_EXGG   *-1              , :P110_QTD_U  *-1           , NULL );
                      --
                    end if;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 348853372084926581
        }
        serverSideCondition {
            type: item=value
            item: P110_DESTINO
            value: R
        }
    )

