page 110 (
    name: Saída de Estoque da Filial
    title: Saída de Estoque da Filial
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 70%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function confirmaitem(event)
            {
             var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
             console.log (tecla);
             if (tecla==13 && document.getElementById('P0_ESTOQUECONGELADO').value =='N' ) 
             { 
              var answer = confirm("Confirma a saída do item no estoque?")
              if (answer)
              {
                apex.submit('CREATE');
              }
             }
              else if ( document.getElementById('P0_ESTOQUECONGELADO').value =='S' ) 
              {
                alert('Distribuição em andamento, não é possível movimentar este produto.')
              }
              else 
              { if([190,188,110,194].indexOf(tecla) !=-1) 
                {
                 alert('Informe uma Quantidade Válida!'); 
                 return false;
                }
              }
            }
            
            function tem_casas_decimais(valor)
            {
             if (typeof(valor) != 'String')
              valor = valor.toString();
            
             return valor.match(/[.,]/) != null;
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

