    pageItem P110_IDESTOQUEFIL (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap( pr.nomeproduto ) display_value
                     , e.idestoquefilial   return_value
                from estoquefilial e
                   , produtos                pr
                where e.idproduto = pr.idproduto
                  and e.idfilial  = :P0_IDFILIAL 
                  and pr.codigosisdist = :P110_CODIGOSISDIST
                order by 1
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P110_CODIGOSISDIST
        }
        layout {
            sequence: 80
            region: @saída-de-estoque-da-filial
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDESTOQUEFIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

