            target: {
                page: 41
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction focus (
        name: focus
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P110_CODIGOSISDIST
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction mostra-posto-avançado (
        name: Mostra Posto Avançado
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P110_DESTINO
        }
        clientSideCondition {
            type: item=value
            item: P110_DESTINO
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P110_IDPOSTOAVANCADO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P110_IDPOSTOAVANCADO
            }
            execution {
                sequence: 10
            }
        )

    )

