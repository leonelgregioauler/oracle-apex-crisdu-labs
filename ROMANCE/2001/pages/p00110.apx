    validation limitasaida-qtd-egg (
        name: LIMITASAIDA_QTD_EGG
        execution {
            sequence: 160
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from movimentosestoquefilial m
                where m.idestoquefil = :P110_IDESTOQUEFIL
                and trunc(m.datamovimento) = to_date(sysdate,'dd/mm/rrrr')
                and m.qtd_u < 0
                and pck_romance.fnc_retornaparametro(parametro => 'LIMITEDECORRECAOESTOQUE',pidfilial => :P0_IDFILIAL) = 'S'
                having sum ( (nvl(m.qtd_egg,0) * -1) + nvl(to_number(:P110_QTD_EGG),0) ) >= 50
                ```
        }
        error {
            errorMessage: Limite de Saída já atingiu a quantidade de 50 peças.
            associatedItem: @P110_QTD_EGG
        }
    )

