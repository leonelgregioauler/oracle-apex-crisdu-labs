    validation quantidade-movimentada (
        name: Quantidade movimentada >= 15
        execution {
            sequence: 200
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where  nvl(to_number(:P110_QTD_PP),0)
                     + nvl(to_number(:P110_QTD_P),0)
                     + nvl(to_number(:P110_QTD_M),0) 
                     + nvl(to_number(:P110_QTD_G),0) 
                     + nvl(to_number(:P110_QTD_GG),0) 
                     + nvl(to_number(:P110_QTD_EGG),0) 
                     + nvl(to_number(:P110_QTD_EXGG),0) 
                     + nvl(to_number(:P110_QTD_U),0) >= 15
                ```
        }
        error {
            errorMessage: Quantidade não permitida para movimentar o estoque! Registre um evento explicando o motivo dessa quantidade e solicitando liberação!
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2401,v('APP_USER')) = 'N'
                ```
        }
    )

