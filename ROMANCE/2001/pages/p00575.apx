            valueColumn: QUANTIDADE
            maximumRows: 20
        }
    )

    region utilização-por-distribuidor (
        name: Utilização Por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.nome
                     , nvl(total.qtd,0) total
                     , nvl(pendente.qtd,0) pendente
                     , ( nvl(aprovado.qtd,0) + nvl(reprovado.qtd,0) ) analisado
                     , nvl(aprovado.qtd,0) aprovado
                     , nvl(reprovado.qtd,0) reprovado
                     , case
                         when reprovado.qtd > 0 then
                           round((reprovado.qtd/total.qtd) * 100,2)
                         else
                           0
                       end perc_reprovado
                     , case
                         when aprovado.qtd > 0 then
                           round((aprovado.qtd/total.qtd) * 100,2)
                         else
                           0
                       end perc_aprovado
                from vw_repres_filial_rmc r
                   , ( select c.idrepresentante
                            , count(distinct c.idassinaturaeletronica) qtd
                       from vw_assinaturas_eletronicas c
                       where c.datarealizada between to_date(:P575_DATAINICIO||' 00:00:01'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P575_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                         and (:P575_IDFILIAL = -1 or c.idfilial = :P575_IDFILIAL)
                         and c.status           = 'C'
                       group by c.idrepresentante ) total
                   , ( select c.idrepresentante
                            , count(distinct c.idassinaturaeletronica) qtd
                       from vw_assinaturas_eletronicas c
                       where c.datarealizada between to_date(:P575_DATAINICIO||' 00:00:01'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P575_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                         and (:P575_IDFILIAL = -1 or c.idfilial = :P575_IDFILIAL)
                         and c.situacao      = 'P'
                         and c.status        = 'C'
                       group by c.idrepresentante ) pendente
                   , ( select c.idrepresentante
                            , count(distinct c.idassinaturaeletronica) qtd
                       from vw_assinaturas_eletronicas c
                       where c.datarealizada between to_date(:P575_DATAINICIO||' 00:00:01'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P575_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                         and (:P575_IDFILIAL = -1 or c.idfilial = :P575_IDFILIAL)
                         and c.situacao      = 'A'
                       group by c.idrepresentante ) aprovado
                   , ( select c.idrepresentante
                            , count(distinct c.idassinaturaeletronica) qtd
                       from vw_assinaturas_eletronicas c
                       where c.datarealizada between to_date(:P575_DATAINICIO||' 00:00:01'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P575_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                         and (:P575_IDFILIAL = -1 or c.idfilial = :P575_IDFILIAL)
                         and c.situacao      = 'R'
                       group by c.idrepresentante ) reprovado
                where (:P575_IDFILIAL = -1 or r.idfilial = :P575_IDFILIAL)
                  -- Maicon Aimi - 8773203 - 29/08/2024 inclusão das filiais (1275 e 1246 Brasilia)
                  and (exists ( select 1
                               from parametrosrepresentantes pr
                               where pr.idrepresentante = r.idrepresentante
                                 and pr.parametro       = 'UTILIZAASSINATURAELETRONICA'
                                 and pr.valor           = 'Z' ) or r.idfilial in (1275,1246))
                  and exists ( select 1
                               from representantes rep
                               where rep.idrepresentante = r.idrepresentante
                                 and rep.ativo = 'S' )
                  and r.idrepresentante = total.idrepresentante(+)
                  and r.idrepresentante = pendente.idrepresentante(+)
                  and r.idrepresentante = aprovado.idrepresentante(+)
                  and r.idrepresentante = reprovado.idrepresentante(+)
                order by 1
                ```
        }
        layout {
            sequence: 120
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma assinatura encontrada.
        }
        advanced {
            savedReportMappingIdentifier: 6617939217778826373
        }

