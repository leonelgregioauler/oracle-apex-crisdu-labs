    region reprovações (
        name: Reprovações
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select w.motivoreprovacao motivo
                     , count(distinct w.idassinaturaeletronica) quantidade
                from vw_assinaturas_eletronicas w
                where (:P575_IDFILIAL = -1 or w.idfilial = :P575_IDFILIAL)
                  and w.situacao             = 'R'
                  and trunc(w.datarealizada) between to_date(:P575_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P575_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                group by motivoreprovacao
                order by 2 desc
                ```
            pageItemsToSubmit: [
