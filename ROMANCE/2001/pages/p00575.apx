    region da-semana (
        name: Da Semana
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select w.representante distribuidor
                     , count( distinct w.idassinaturaeletronica ) qtd
                from vw_assinaturas_eletronicas w
                where w.datarealizada between sysdate-5 and sysdate
                  and (:P575_IDFILIAL = -1 or w.idfilial = :P575_IDFILIAL)
                  and w.status = 'C'
                group by w.representante
                order by 2 desc
                ```
            pageItemsToSubmit: [
                P575_DATAINICIO
                P575_DATAFIM
            ]
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DISTRIBUIDOR
            valueColumn: QTD
            maximumRows: 10
            messageWhenNoDataFound: Nenhuma assinatura encontrada.
        }
    )

    region de-hoje (
        name: De Hoje
        type: plugin/html5BarChart
