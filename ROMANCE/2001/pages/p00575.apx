page 575 (
    name: "Dashboard Assinaturas "
    title: "Dashboard Assinaturas "
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region análise-por-usuário (
        name: Análise Por Usuário
        type: chart
        layout {
            sequence: 100
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select u.usuario
                         , count(distinct c.idassinaturaeletronica) quantidade
                    from roman.vw_assinaturas_eletronicas c
                       , catal.usuarios u
                    where c.idusuarioavaliacao = u.idusuario
                      and c.dataavaliacao between to_date(:P575_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P575_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                      and (:P575_IDFILIAL = -1 or c.idfilial = :P575_IDFILIAL)
                      and c.situacao != 'P'
                    group by u.usuario 
                    ```
            }
            columnMapping {
                label: USUARIO
                value: QUANTIDADE
            }
            label {
                show: true
            }
        )

    )

    region assinaturas-por-dia (
        name: Assinaturas Por Dia
        type: chart
        source {
            pageItemsToSubmit: [
                P575_DATAINICIO
                P575_DATAFIM
            ]
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: line
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }
        messages {
            whenNoDataFound: Nenhuma assinatura encontrada.
        }

        series por-dia (
            name: Por dia
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select trunc(c.datarealizada) data
                         , count(distinct c.idassinaturaeletronica) quantidade
                    from vw_assinaturas_eletronicas c
                    where c.datarealizada between to_date(:P575_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P575_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                      and (:P575_IDFILIAL = -1 or c.idfilial = :P575_IDFILIAL)
                      and c.status = 'C'
                    group by trunc(c.datarealizada)
                    order by 1
                    ```
            }
            columnMapping {
                label: DATA
                value: QUANTIDADE
                customColumn: QUANTIDADE
            }
            marker {
                show: true
                shape: circle
            }
        )

        series revisadas (
            name: Revisadas
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select trunc(c.datarealizada) data
                         , count(distinct c.idassinaturaeletronica) quantidade
                    from vw_assinaturas_eletronicas c
                    where c.datarealizada between to_date(:P575_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P575_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                      and (:P575_IDFILIAL = -1 or c.idfilial = :P575_IDFILIAL)
