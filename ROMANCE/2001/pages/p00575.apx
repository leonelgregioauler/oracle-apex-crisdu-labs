    process indica-filtros (
        name: Indica filtros
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P575_DATAINICIO is null then
                    :P575_DATAINICIO := trunc(SYSDATE,'MM');
                  end if;
                  --
                  if :P575_DATAFIM is null then
                    :P575_DATAFIM := to_char(trunc(sysdate),'DD/MM/RRRR');
                  end if;
                  --
                  if :P575_IDFILIAL is null then
                    :P575_IDFILIAL := :P0_IDFILIAL;
                  end if;
                  --
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1039171514512798873
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 575
                items: {
                    P575_IDFILIAL: &P575_IDFILIAL.
                    P575_DATAINICIO: &P575_DATAINICIO.
                    P575_DATAFIM: &P575_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

