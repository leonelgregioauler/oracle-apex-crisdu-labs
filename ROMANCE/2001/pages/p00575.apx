                    group by trunc(c.datarealizada)
                    order by 1
                    ```
            }
            columnMapping {
                label: DATA
                value: QUANTIDADE
                customColumn: QUANTIDADE
            }
            marker {
                show: true
                shape: circle
            }
        )

        axis x (
            name: x
