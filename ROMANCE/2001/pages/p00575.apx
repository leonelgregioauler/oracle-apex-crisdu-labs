    region utilização-por-empresa (
        name: Utilização Por Empresa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(f.idfilial) empresa
                     , nvl(total.qtd,0) total
                     , nvl(pendente.qtd,0) pendente
                     , ( nvl(aprovado.qtd,0) + nvl(reprovado.qtd,0) ) analisado
                     , nvl(aprovado.qtd,0) aprovado
                     , nvl(reprovado.qtd,0) reprovado
                     , case
                         when reprovado.qtd > 0 then
                           round((reprovado.qtd/total.qtd) * 100,2)
                         else
                           0
                       end perc_reprovado
                     , case
                         when aprovado.qtd > 0 then
                           round((aprovado.qtd/total.qtd) * 100,2)
                         else
                           0
                       end perc_aprovado
                     , nvl(reprovado_s_reassi.qtd,0) reprovado_s_reassi
                     , case
                         when reprovado_s_reassi.qtd > 0 then
                           round((reprovado_s_reassi.qtd/total.qtd) * 100,0)
                         else
                           0
                       end perc_reprovado_s_reassi
                from vw_filiais f
                   , ( select c.idfilial
                            , count(distinct c.idassinaturaeletronica) qtd
                       from vw_assinaturas_eletronicas c
                       where c.datarealizada between to_date(:P575_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P575_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                         and c.status = 'C'
                       group by c.idfilial ) total
                   , ( select c.idfilial
                            , count(distinct c.idassinaturaeletronica) qtd
                       from vw_assinaturas_eletronicas c
                       where c.datarealizada between to_date(:P575_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P575_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                         and c.situacao      = 'P'
                         and c.status        = 'C'
                       group by c.idfilial ) pendente
                   , ( select c.idfilial
                            , count(distinct c.idassinaturaeletronica) qtd
                       from vw_assinaturas_eletronicas c
                       where c.datarealizada between to_date(:P575_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P575_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                         and c.situacao      = 'A'
                       group by c.idfilial ) aprovado
                   , ( select c.idfilial
                            , count(distinct c.idassinaturaeletronica) qtd
                       from vw_assinaturas_eletronicas c
                       where c.datarealizada between to_date(:P575_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P575_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                         and c.situacao      = 'R'
                       group by c.idfilial ) reprovado
                   , ( select c.idfilial
                            , count(distinct c.idassinaturaeletronica) qtd
                       from roman.vw_assinaturas_eletronicas c
                       where c.datarealizada between to_date(:P575_DATAINICIO||' 00:00:01'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P575_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                         and c.situacao      = 'R'
                         and not exists ( select 1
                                          from roman.assinaturaseletronicas aa
                                          where aa.idnotavenda = c.idnotavenda  
                                            and aa.idassinaturaeletronica > c.idassinaturaeletronica
                                            and aa.status = 'C'
                                            and aa.situacao = 'A')
                       group by c.idfilial ) reprovado_s_reassi
                      
                where f.idfilial = total.idfilial(+)
                  and f.idfilial = pendente.idfilial(+)
                  and f.idfilial = aprovado.idfilial(+)
                  and f.idfilial = reprovado.idfilial(+)
                  and f.idfilial = reprovado_s_reassi.idfilial (+)
                  and f.ativo    = 'S'
                  and f.tipofilial = 'D'
                  -- Maicon Aimi - 8773203 - 29/08/2024 inclusão das filiais (1275 e 1246 Brasilia)
                  and (    ( f.idfilial in (1275,1246))
                        or (      ( exists ( select 1
                                               from usuariosfiliais u
                                              where u.idfilial  = f.idfilial
                                                and u.usuario   = v('APP_USER')))
                             and  ( exists ( select 1
                                               from parametrosrepresentantes pr
                                              where pck_romance.fnc_filialrepresentante(pr.idrepresentante) = f.idfilial
                                                and pr.parametro       = 'UTILIZAASSINATURAELETRONICA'
                                                and pr.valor           in  ('S','Z') ))))
                order by 1;
                ```
        }
        layout {
            sequence: 110
            slot: body
        }
