    validation valida-representante (
        name: Valida representante
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P823_IDREPRESENTANTE is null
                ```
        }
        error {
            errorMessage: Por favor selecionar um distribuidor para realizar a consulta!
        }
        serverSideCondition {
            whenButtonPressed: @consultacupom
        }
    )

    process impressão-termo-em-lote (
        name: "Impressão Termo em Lote "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vseq        number;
                  vqtd        number := apex_application.g_f01.count;
                  vloteexist  number := 0;
                  vidusuario number;
                begin
                  --
                  select u.idusuario
                    into vidusuario
                  from catal.usuarios u 
                  where u.usuario = v('APP_USER');
                
                  -- verifica se já existe lote
                  select count(1)
                    into vloteexist
                    from roman.conquistoulevoucupons cp
                       , catal.vendedoras v
                   where v.idvendedora = cp.idvendedora 
                     and v.idrepresentante = :P823_IDREPRESENTANTE
                     and cp.loteimpressao   = :P823_LOTEIMPRESSAO;
                
                  -- recria collection
                  if apex_collection.collection_exists('CUPONS_SEL') then
                     apex_collection.delete_collection('CUPONS_SEL');
                  end if;
                
                  apex_collection.create_collection('CUPONS_SEL');
                
                  ------------------------------------------------------------------
                  -- CASO 1: JÁ EXISTE LOTE ¿ apenas carrega collection
                  ------------------------------------------------------------------
                  if vloteexist > 0 then
                
                     for r in (
                        select cp.idconquistoulevoucupom
                 from roman.conquistoulevoucupons cp
                    , catal.vendedoras v
                where v.idvendedora = cp.idvendedora 
                  and v.idrepresentante = :P823_IDREPRESENTANTE
                  and cp.loteimpressao   = :P823_LOTEIMPRESSAO
                     ) loop
                
                        apex_collection.add_member(
                            p_collection_name => 'CUPONS_SEL',
                            p_c001            => r.idconquistoulevoucupom
                        );
                
                     end loop;
                
                  ------------------------------------------------------------------
                  -- CASO 2: NÃO EXISTE LOTE ¿ exige seleção e gera novo
                  ------------------------------------------------------------------
                  else
                
                     if vqtd = 0 then
                        raise_application_error(-20001,
                          'Selecione ao menos um cupom.');
                     end if;
                
                     -- gera número do lote
                     select roman.seq_idloteimpressao.nextval
                       into vseq
                       from dual;
                
                     -- adiciona selecionados
                     for i in 1 .. apex_application.g_f01.count loop
                        apex_collection.add_member(
                            p_collection_name => 'CUPONS_SEL',
                            p_c001            => apex_application.g_f01(i)
                        );
                     end loop;
                
                     -- atualiza SOMENTE se ainda não tiver lote
                     update roman.conquistoulevoucupons cp
                        set cp.loteimpressao = vseq,
                            cp.dataretirada  = sysdate,
                            cp.retiradopor   = 'D',
                            cp.idusuarioentrega = vidusuario
                      where cp.idconquistoulevoucupom in
                            (select c001
                               from apex_collections
                              where collection_name = 'CUPONS_SEL')
                        and cp.loteimpressao is null;
                
                  end if;
                
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 23377481609164103
        }
        serverSideCondition {
            whenButtonPressed: @imprimelote
        }
    )

