    pageItem P823_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) Distribuidor
                     , r.idrepresentante
                from catal.representantes r 
                where exists ( select 1
                               from roman.conquistoulevoucupons clc 
                                  , roman.itensconqlevcupons itc 
                                  , catal.vendedoras v 
                                  , catal.pessoas p 
                               where clc.idconquistoulevoucupom = itc.idconquistoulevoucupom
                                 and clc.idvendedora = v.idvendedora
                                 and v.idpessoa = p.idpessoa 
                                 and clc.dataguia is not null
                                 and clc.datarecebfilial is not null
                                 and v.idrepresentante = r.idrepresentante
                                 and clc.idfilialretira in (select g.idfilial
                                                            from catal.usuarios u 
                                                               , catal.gerentes g 
                                                            where g.idgerente = u.idgerente
                                                              and u.usuario = v('APP_USER')) )
                order by 1 
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P823_LOTEIMPRESSAO (
        type: selectList
        label {
            label: Lote de Impressão
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(clc.loteimpressao) lote
                     , clc.loteimpressao
                from roman.conquistoulevoucupons clc  
                   , catal.vendedoras v 
                where clc.idvendedora = v.idvendedora
                  and v.idrepresentante = :P823_IDREPRESENTANTE
                order by 1 desc
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P823_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
    )

