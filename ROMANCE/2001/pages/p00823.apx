    region cupons-conquistou-levou (
        name: "Cupons Conquistou Levou "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct clc.idconquistoulevoucupom cupom 
                     , apex_item.CHECKBOX2(1, clc.idconquistoulevoucupom, null) as check1
                    -- , clc.idconquistoulevoucupom idcp
                     , p.nomepessoa empreendedora 
                     , roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) Distribuidor
                     , nvl(p.cpf,p.documentoestrangeiro) documento
                     , clc.dataresgate 
                     , clc.dataenviofilial
                     , clc.datarecebfilial 
                     , clc.dataretirada
                     , clc.idvendedora
                     , clc.retiradopor
                     , clc.loteimpressao 
                from roman.conquistoulevoucupons clc 
                   , roman.itensconqlevcupons itc 
                   , catal.vendedoras v 
                   , catal.pessoas p 
                where clc.idconquistoulevoucupom = itc.idconquistoulevoucupom
                  and clc.idvendedora = v.idvendedora
                  and v.idpessoa = p.idpessoa 
                  and clc.dataguia is not null
                  and clc.datarecebfilial is not null
                  and v.idrepresentante = :P823_IDREPRESENTANTE
                  and clc.loteimpressao is null and :P823_LOTEIMPRESSAO is null
                  and exists (select 1 
                              from roman.parametros pr 
                              where pr.idfilial = clc.idfilialretira
                                and pr.nome = 'CONQUISTOULEVOULOJA'
                                and pr.valor not in ('LF','LR'))
                  and clc.idfilialretira in (select g.idfilial
                                             from catal.usuarios u 
                                                , catal.gerentes g 
                                             where g.idgerente = u.idgerente
                                              and u.usuario = v('APP_USER'))
                union
                select distinct clc.idconquistoulevoucupom cupom 
                     , apex_item.CHECKBOX2(1, clc.idconquistoulevoucupom, null) as check1
                    -- , clc.idconquistoulevoucupom idcp
                     , p.nomepessoa empreendedora 
                     , roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) Distribuidor
                     , nvl(p.cpf,p.documentoestrangeiro) documento
                     , clc.dataresgate 
                     , clc.dataenviofilial
                     , clc.datarecebfilial 
                     , clc.dataretirada
                     , clc.idvendedora
                     , clc.retiradopor
                     , clc.loteimpressao 
                from roman.conquistoulevoucupons clc 
                   , roman.itensconqlevcupons itc 
                   , catal.vendedoras v 
                   , catal.pessoas p 
                where clc.idconquistoulevoucupom = itc.idconquistoulevoucupom
                  and clc.idvendedora = v.idvendedora
                  and v.idpessoa = p.idpessoa 
                  and clc.dataguia is not null
                  and clc.datarecebfilial is not null
                  and v.idrepresentante = :P823_IDREPRESENTANTE
                  and clc.loteimpressao = :P823_LOTEIMPRESSAO and clc.loteimpressao is not null
                  and exists (select 1 
                              from roman.parametros pr 
                              where pr.idfilial = clc.idfilialretira
                                and pr.nome = 'CONQUISTOULEVOULOJA'
                                and pr.valor not in ('LF','LR'))
                  and clc.idfilialretira in (select g.idfilial
                                             from catal.usuarios u 
                                                , catal.gerentes g 
                                             where g.idgerente = u.idgerente
                                              and u.usuario = v('APP_USER'));
                ```
        }
