page 418 (
    name: Consulta Distribuidor
    title: Consulta Distribuidor
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region carga-da-semana (
        name: Carga da Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT P.IDPRODUTO
                     , P.IDCATEGORIA
                     , ( SELECT C.NOME FROM CATEGORIAS C WHERE C.IDCATEGORIA = P.IDCATEGORIA ) CATEGORIA
                     , P.DESCRPRODUTO
                     , P.ATIVO
                     , P.CODIGOSISDIST as CODIGO
                     , P.NOMEPRODUTO as PRODUTO
                     , P.DESCRICAOCOMERCIAL as DESCRICAO
                     , ITENSCARGA.QTD as QUANTIDADE
                     , ITENSCARGA.VALORVENDA as PRECO
                     , decode(ITENSCARGA.DESCONTO,'S','Sim','N','Não') as DESCONTO
                     , semana
                FROM PRODUTOS P
                   , ( SELECT C.IDREPRESENTANTE
                            , I.IDPRODUTO  
                            , semana
                            , AVG(I.VALORVENDA) VALORVENDA
                            , MIN(I.COMISSAO) DESCONTO
                            , SUM( NVL(I.QTD_DIST_PP  ,0 )
                                 + NVL(I.QTD_DIST_P   ,0 )
                                 + NVL(I.QTD_DIST_M   ,0 )
                                 + NVL(I.QTD_DIST_G   ,0 )
                                 + NVL(I.QTD_DIST_GG  ,0 )
                                 + NVL(I.QTD_DIST_EGG ,0 )
                                 + NVL(I.QTD_DIST_EXGG,0 ) 
                                 + NVL(I.QTD_DIST_U   ,0 ) )  QTD
                       FROM ITENSCARGAREPRESENTANTE I
                          , CARGASREPRESENTANTES    C
                       WHERE I.IDCARGAREPRESENTANTE = C.IDCARGAREPRESENTANTE   
                         AND C.IDREPRESENTANTE      = :P418_IDREPRESENTANTE
                         AND C.IDSEMANA = ( SELECT MAX(CC.IDSEMANA)
                                            FROM CARGASREPRESENTANTES  CC
                                            WHERE CC.IDREPRESENTANTE =  C.IDREPRESENTANTE
                                              AND CC.SITUACAO        = 3 )
                       GROUP BY C.IDREPRESENTANTE, I.IDPRODUTO, semana) ITENSCARGA
                WHERE P.IDPRODUTO = ITENSCARGA.IDPRODUTO
                order by nomeproduto
                ```
        }
        layout {
            sequence: 80
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent12
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color="BLUE"><h2>
                    São consideradas apenas as cargas que estão com situação -> Concluída <- 
                    </h2></font>
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P418_IDREPRESENTANTE
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma Carga encontrada!
        }
        advanced {
            savedReportMappingIdentifier: 4547025046797037211
        }

