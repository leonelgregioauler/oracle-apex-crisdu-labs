    region lista (
        name: Lista
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select '1 - Consultoras Possiveis' descricao
                     , trim(to_char(count(1),'999G999G990'))  quantidade
                from vendedoras v
                where ativo = 'S'
                  and not exists ( select 1
                                   from representantes r
                                   where r.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from funcionarios f
                                   where f.idpessoa = v.idpessoa )
                --  and ( :P0_IDFILIAL = -1 or pck_romance.fnc_filialrepresentante(v.idrepresentante) = :P0_IDFILIAL ) 
                  and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE )
                  and v.idfilial = :P0_IDFILIAL
                union all
                select '2 - Logaram nos últimos 42 dias' descricao
                     , trim(to_char(count(1),'999G999G990'))  quantidade
                from vendedoras v
                where exists ( select 1
                               from registrosloginminhasacola e
                               where e.idvendedora = v.idvendedora
                                 and e.datalogin  >= sysdate-42 )
                  and  ativo = 'S'
                  and not exists ( select 1
                                   from representantes r
                                   where r.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from funcionarios f
                                   where f.idpessoa = v.idpessoa )
                  and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE )
                  and v.idfilial = :P0_IDFILIAL
                union all
                select '4 - Fotos Compartilhadas' descricao
                     , trim(to_char(count(1),'999G999G990'))  quantidade
                from registroscompartilhafotos rr
                where ( :P0_IDFILIAL = -1 or exists ( select 1
                                                      from vendedoras     v
                                                         , representantes r
                                                      where v.idvendedora     = rr.idvendedora
                                                        and v.idrepresentante = r.idrepresentante
                                                        and v.ativo           = 'S'
                                                        and r.ativo           = 'S'
                                                        and not exists ( select 1
                                                                         from representantes r
                                                                         where r.idpessoa = v.idpessoa )
                                                        and not exists ( select 1
                                                                         from gerentes g
                                                                         where g.idpessoa = v.idpessoa )
                                                        and not exists ( select 1
                                                                         from funcionarios f
                                                                         where f.idpessoa = v.idpessoa )
                                                        and ( :P0_IDFILIAL = -1 or pck_romance.fnc_filialgerente(r.idgerente) = :P0_IDFILIAL ) 
                                                        and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE ) ) )
                union all
                select '5 - Notas c/ atraso a MENOS de 42 dias' descricao
                     , trim(to_char(count(1),'999G999G990'))||' - '||trim(to_char(sum(n.valortotalnota),'999G999G999G999G999G990D00'))  quantidade
                from notasvendas n
                where n.idsituacaonotavenda   = 3
                  and n.dataretornoorig       < sysdate-42
                  and n.semanacobranca       != n.semanacobrancaorig
                  and ( :P418_IDREPRESENTANTE is null or n.idrepresentante = :P418_IDREPRESENTANTE )
                  and ( :P0_IDFILIAL          = -1    or n.idfilial        = :P0_IDFILIAL          )
                union all
                select '6 - Notas c/ atraso a MAIS de 42 dias' descricao
                     , trim(to_char(count(1),'999G999G990'))||' - '||trim(to_char(sum(n.valortotalnota),'999G999G999G999G999G990D00'))  quantidade
                from notasvendas n
                where n.idsituacaonotavenda   = 3
                  and n.dataretornoorig      >= sysdate-42
                  and n.semanacobranca       != n.semanacobrancaorig
                  and ( :P418_IDREPRESENTANTE is null or n.idrepresentante = :P418_IDREPRESENTANTE )
                  and ( :P0_IDFILIAL          = -1    or n.idfilial        = :P0_IDFILIAL          )
                union all
                select '3 - % de uso nos últimos 42 dias' descricao
                     , trim(to_char((comapp.quantidade * 100/ total.quantidade) ,'999G999G990')) quantidade
                from (  select count(1)  quantidade
                        from vendedoras v
                        where ativo = 'S'
                          and not exists ( select 1
                                           from representantes r
                                           where r.idpessoa = v.idpessoa )
                          and not exists ( select 1
                                           from gerentes g
                                           where g.idpessoa = v.idpessoa )
                          and not exists ( select 1
                                           from funcionarios f
                                           where f.idpessoa = v.idpessoa )
                          and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE )
                          and v.idfilial = :P0_IDFILIAL ) total
                          
                    , ( select count(1)   quantidade
                        from vendedoras v
                        where ativo = 'S'
                          and not exists ( select 1
                                           from representantes r
                                           where r.idpessoa = v.idpessoa )
                          and not exists ( select 1
                                           from gerentes g
                                           where g.idpessoa = v.idpessoa )
                          and not exists ( select 1
                                           from funcionarios f
                                           where f.idpessoa = v.idpessoa )
                          and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE )
                          and v.idfilial = :P0_IDFILIAL
                          and exists ( select 1
                                       from registrosloginminhasacola e
                                       where e.idvendedora = v.idvendedora
                                         and e.datalogin  >= sysdate-42 ) ) comapp
                ```
            pageItemsToSubmit: P0_IDFILIAL
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DESCRICAO
            valueColumn: QUANTIDADE
        }
    )

    region lista-de-consultoras (
        name: Lista de Consultoras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(idvendedora) consultora
                     , idnotavenda
                     , numeronota
                     , qtditens
                     , qtditensfotos
                     , case 
                         when qtditens > 0 then 
                           round((qtditensfotos * 100)/qtditens) 
                         else
                          0
                          end perc
                         
                     , datanascimento
                     , round((sysdate - datanascimento)/365) idade 
                     , pck_romance.fnc_nomefilial(idfilial) empresa
                     , qtdlogin
                     , qtdcompfotos
                     , ultimocomp
                     , primeirologin
                     , ultimologin
                     , idvendedora
                from( select n.idnotavenda
                           , n.idvendedora
                           , n.idrepresentante
                           , p.datanascimento
                           , n.numeronota
                           , n.idfilial
                           , ( select count(1)
                               from itensnotavenda i1
                               where i1.idnotavenda = n.idnotavenda ) qtditens
                           , ( select count(1)
                               from itensnotavenda i2
                                  , estoquefilial  e
                               where i2.idnotavenda    = n.idnotavenda 
                                 and e.idestoquefilial = i2.idestoquefil
                                 and exists ( select 1
                                              from fotosprodutos f
                                              where f.idproduto = e.idproduto )  ) qtditensfotos     
                           , ( select count(1)
                               from registrosloginminhasacola r
                               where r.idvendedora = n.idvendedora
                                 and ( :P418_FILTRAR = 'T' 
                                      or ( :P418_FILTRAR = 'P'
                                       and :P418_DATAINICIO is not null
                                       and :P418_DATAFIM is not null
                                       and trunc(r.datalogin) between to_date(:P418_DATAINICIO) and to_date(:P418_DATAFIM) ) ) ) qtdlogin
                           , ( select max(r.datalogin) 
                               from registrosloginminhasacola r
                               where r.idvendedora = n.idvendedora ) ultimologin
                           , ( select min(r.datalogin) 
                               from registrosloginminhasacola r
                               where r.idvendedora = n.idvendedora ) primeirologin
                           , ( select count(1)
                               from registroscompartilhafotos rg
                               where rg.idvendedora = n.idvendedora
                                 and ( :P418_FILTRAR = 'T' 
                                      or ( :P418_FILTRAR = 'P'
                                       and :P418_DATAINICIO is not null
                                       and :P418_DATAFIM is not null
                                       and trunc(rg.datacompartilhamento) between to_date(:P418_DATAINICIO) and to_date(:P418_DATAFIM) ) ) ) qtdcompfotos
                           , ( select max(rg.datacompartilhamento)
                               from registroscompartilhafotos rg
                               where rg.idvendedora = n.idvendedora ) ultimocomp
                      from notasvendas n
                         , vendedoras v
                         , pessoas    p 
                      where n.idsituacaonotavenda = 3
                        and p.idpessoa = v.idpessoa
                        and v.idvendedora = n.idvendedora
                        and v.ativo = 'S'
                        and not exists ( select 1
                                         from representantes r
                                         where r.idpessoa = v.idpessoa )
                        and not exists ( select 1
                                         from gerentes g
                                         where g.idpessoa = v.idpessoa )
                        and not exists ( select 1
                                         from funcionarios f
                                         where f.idpessoa = v.idpessoa )
                        and not exists ( select 1
                                         from biroman.notasvendas bn
                                         where bn.idvendedora = n.idvendedora
                                          and bn.datanota > n.datanota )
                        and n.idfilial = :P0_IDFILIAL
                        and ( :P418_IDCIDADE is null or p.idcidade = :P418_IDCIDADE )
                        and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE )
                        
                     
                        ) vv
                order by 7 desc
                ```
            pageItemsToSubmit: [
                P418_DATAINICIO
                P418_DATAFIM
                P418_FILTRAR
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
