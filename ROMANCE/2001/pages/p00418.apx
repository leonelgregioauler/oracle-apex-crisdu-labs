            lazyLoading: true
        }
        legend {
            show: false
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select trunc(datalogin) sequencia 
                         , count(1) qtd
                    from registrosloginminhasacola r
                       , vendedoras                v
                    where primeirologin     = 'S'
                      and v.idvendedora     = r.idvendedora
                      and trunc(datalogin) >= trunc(sysdate) - 35
                      and v.idrepresentante = :P418_IDREPRESENTANTE 
                      and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE )
                      and v.idfilial = :P0_IDFILIAL
                    group by trunc(datalogin) 
                    ORDER BY 1
                    ```
            }
            columnMapping {
                label: SEQUENCIA
                value: QTD
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

