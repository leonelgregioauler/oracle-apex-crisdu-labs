    region compartilhamentos-e-logins-por-semana (
        name: Compartilhamentos e Logins por Semana
        type: chart
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: area
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        legend {
            show: false
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 'Total de Compartilhamentos'  informacao
                         , to_number(substr(pck_util.fnc_semanaid(r.idsemana   ),4,4)||substr(pck_util.fnc_semanaid(r.idsemana   ),1,2)) semana 
                         , count(1) quantidade 
                         , r.idsemana
                    from registroscompartilhafotos r
                       , vendedoras v               
                    where r.datacompartilhamento > sysdate-90
                      and v.idvendedora = r.idvendedora                
                      and ( :P0_IDFILIAL = -1 or exists (  select 1
                                                              from gerentes g
                                                                 , representantes rr
                                                              where g.idgerente       = rr.idgerente
                                                                and rr.idrepresentante = v.idrepresentante
                                                                and rr.idrepresentante = :P418_IDREPRESENTANTE 
                                                                and g.idfilial = :P0_IDFILIAL ))     
                    group by r.idsemana  
                    union all
                    select 'Consultoras que Compartilharam'  informacao
                         , to_number(substr(pck_util.fnc_semanaid(r.idsemana   ),4,4)||substr(pck_util.fnc_semanaid(r.idsemana   ),1,2)) semana 
                         , count(distinct v.idvendedora) qtdunico 
                         , r.idsemana
                    from registroscompartilhafotos r
                       , vendedoras v               
                    where r.datacompartilhamento > sysdate-90
                      and v.idvendedora = r.idvendedora             
                      and ( :P0_IDFILIAL = -1 or exists (  select 1
                                                              from gerentes g
                                                                 , representantes rr
                                                              where g.idgerente       = rr.idgerente
                                                                and rr.idrepresentante = v.idrepresentante
                                                                and rr.idrepresentante = :P418_IDREPRESENTANTE 
                                                                and g.idfilial = :P0_IDFILIAL ))        
                    group by r.idsemana  
                    union all
                    select 'Total de Logins '  informacao
                         , to_number(substr(pck_util.fnc_semanaid(r.idsemana   ),4,4)||substr(pck_util.fnc_semanaid(r.idsemana   ),1,2)) semana 
                         , count( 1) qtdunico 
                         , r.idsemana
                    from registrosloginminhasacola r
                       , vendedoras v               
                    where r.datalogin > sysdate-90
                      and v.idvendedora = r.idvendedora               
                      and ( :P0_IDFILIAL = -1 or exists (  select 1
                                                              from gerentes g
                                                                 , representantes rr
                                                              where g.idgerente       = rr.idgerente
                                                                and rr.idrepresentante = v.idrepresentante
                                                                and rr.idrepresentante = :P418_IDREPRESENTANTE 
                                                                and g.idfilial = :P0_IDFILIAL ))      
                    group by r.idsemana  
                    union all
                    select 'Logins únicos'  informacao
                         , to_number(substr(pck_util.fnc_semanaid(r.idsemana   ),4,4)||substr(pck_util.fnc_semanaid(r.idsemana   ),1,2)) semana 
                         , count(distinct v.idvendedora) qtdunico 
                         , r.idsemana
                    from registrosloginminhasacola r
                       , vendedoras v               
                    where r.datalogin > sysdate-90
                      and v.idvendedora = r.idvendedora          
                      and ( :P0_IDFILIAL = -1 or exists (  select 1
                                                              from gerentes g
                                                                 , representantes rr
                                                              where g.idgerente       = rr.idgerente
                                                                and rr.idrepresentante = v.idrepresentante
                                                                and rr.idrepresentante = :P418_IDREPRESENTANTE 
                                                                and g.idfilial = :P0_IDFILIAL ))           
                    group by r.idsemana  
                    order by 4
                    ```
            }
            columnMapping {
                seriesName: INFORMACAO
                label: SEMANA
                value: QUANTIDADE
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region consultoras-com-app (
        name: Consultoras com APP
        type: chart
        source {
            pageItemsToSubmit: [
                P418_IDESTADO
                P418_IDCIDADE
                P0_IDFILIAL
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select min(round((sysdate - datanascimento)/365)) ||' - '|| max(round((sysdate - datanascimento)/365))  idade 
                         , count(1) qtd
                    from vendedoras v
                       , pessoas    p 
                    where p.idpessoa = v.idpessoa
                      and p.datanascimento is not null
                      and v.ativo = 'S'
                      and round((sysdate - datanascimento)/365) between 0 and 19
                      and exists ( select 1
                                   from registrosloginminhasacola r
                                   where r.idvendedora = v.idvendedora )
                      and ( :P418_IDCIDADE        is null or p.idcidade        = :P418_IDCIDADE )
                      and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE )
                      and v.idfilial = :P0_IDFILIAL
                    union all
                    select min(round((sysdate - datanascimento)/365)) ||' - '|| max(round((sysdate - datanascimento)/365))  idade 
                         , count(1) qtd
                    from vendedoras v
                       , pessoas    p 
                    where p.idpessoa = v.idpessoa
                      and p.datanascimento is not null
                      and v.ativo = 'S'
                      and round((sysdate - datanascimento)/365) between 20 and 29
                      and exists ( select 1
                                   from registrosloginminhasacola r
                                   where r.idvendedora = v.idvendedora )
                      and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE )
                      and v.idfilial = :P0_IDFILIAL
                    union all
                    select min(round((sysdate - datanascimento)/365)) ||' - '|| max(round((sysdate - datanascimento)/365))  idade 
                         , count(1) qtd
                    from vendedoras v
                       , pessoas    p 
                    where p.idpessoa = v.idpessoa
                      and p.datanascimento is not null
                      and v.ativo = 'S'
                      and round((sysdate - datanascimento)/365) between 30 and 39
                      and exists ( select 1
                                   from registrosloginminhasacola r
                                   where r.idvendedora = v.idvendedora )
                      and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE )
                      and v.idfilial = :P0_IDFILIAL
                    union all
                    select min(round((sysdate - datanascimento)/365)) ||' - '|| max(round((sysdate - datanascimento)/365))  idade 
                         , count(1) qtd
                    from vendedoras v
                       , pessoas    p 
                    where p.idpessoa = v.idpessoa
                      and p.datanascimento is not null
                      and v.ativo = 'S'
                      and round((sysdate - datanascimento)/365) between 40 and 49
                      and exists ( select 1
                                   from registrosloginminhasacola r
                                   where r.idvendedora = v.idvendedora )
                      and ( :P418_IDCIDADE        is null or p.idcidade        = :P418_IDCIDADE )
                      and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE )
                      and v.idfilial = :P0_IDFILIAL
                    union all
                    select min(round((sysdate - datanascimento)/365)) ||' - '|| max(round((sysdate - datanascimento)/365))  idade 
                         , count(1) qtd
                    from vendedoras v
                       , pessoas    p 
                    where p.idpessoa = v.idpessoa
                      and p.datanascimento is not null
                      and v.ativo = 'S'
                      and round((sysdate - datanascimento)/365) between 50 and 59
                      and exists ( select 1
                                   from registrosloginminhasacola r
                                   where r.idvendedora = v.idvendedora )
                      and ( :P418_IDCIDADE        is null or p.idcidade        = :P418_IDCIDADE )
                      and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE )
                      and v.idfilial = :P0_IDFILIAL
                      and v.idrepresentante = :P418_IDREPRESENTANTE 
                    union all
                    select min(round((sysdate - datanascimento)/365)) ||' - '|| max(round((sysdate - datanascimento)/365))  idade 
                         , count(1) qtd
                    from vendedoras v
                       , pessoas    p 
                    where p.idpessoa = v.idpessoa
                      and p.datanascimento is not null
                      and v.ativo = 'S'
                      and round((sysdate - datanascimento)/365) between 60 and 100
                      and exists ( select 1
                                   from registrosloginminhasacola r
                                   where r.idvendedora = v.idvendedora )
                      and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE )
                      and v.idfilial = :P0_IDFILIAL
                      and ( :P418_IDCIDADE        is null or p.idcidade        = :P418_IDCIDADE )
                      and v.idrepresentante = :P418_IDREPRESENTANTE 
                    union all
                    select 'Cadastro com data errada' idade 
                         , count(1) qtd
                    from vendedoras v
                       , pessoas    p 
                    where p.idpessoa = v.idpessoa
                      and p.datanascimento is not null
                      and v.ativo = 'S'
                      and round((sysdate - nvl(datanascimento,sysdate-200))/365) not between 0 and 100
                      and exists ( select 1
                                   from registrosloginminhasacola r
                                   where r.idvendedora = v.idvendedora )
                      and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE )
                      and v.idfilial = :P0_IDFILIAL
                    order by 1
                    
                    ```
            }
            columnMapping {
                label: IDADE
                value: QTD
            }
            label {
                show: true
            }
        )

    )

