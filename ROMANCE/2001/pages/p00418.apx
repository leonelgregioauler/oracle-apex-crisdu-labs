    region consultoras-sem-app-minha-sacola (
        name: Consultoras sem APP Minha Sacola
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) ||'<br>'||pck_romance.fnc_nomeregiaovenda(v.idregiaovenda) consultora
                     , nvl(p.documentoestrangeiro,p.cpf)||' - ID Site: '||v.idvendedora cpf
                     , pck_util.fnc_retornatelefones(p.idpessoa) telefones
                     , ( select datanota
                         from notasvendas n
                         where n.idnotavenda = ( select max(idnotavenda)
                                                 from notasvendas nv
                                                 where nv.idvendedora = v.idvendedora
                                                   and nv.idsituacaonotavenda between 1 and 4) ) ultimanota
                     , p.idade 
                from vendedoras v
                   , pessoas p
                where v.ativo = 'S'
                  and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE )
                  and v.idfilial = :P0_IDFILIAL
                  and v.idpessoa = p.idpessoa
                  and not exists ( select 1
                                   from representantes rr
                                   where rr.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from funcionarios f
                                   where f.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from registrosloginminhasacola r
                                   where r.idvendedora = v.idvendedora
                                     and r.datalogin   >= trunc(sysdate)-42 )
                order by 1
                ```
        }
        layout {
            sequence: 70
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent7
