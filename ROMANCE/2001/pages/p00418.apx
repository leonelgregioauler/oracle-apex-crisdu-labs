    region produtos-mais-compartilhados (
        name: Produtos mais Compartilhados
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                -- Created on 11/10/2018 by ÉVERTON PASSOS 
                declare 
                  -- Local variables here
                  vqtdcolunas number := 0;
                  --
                begin
                  -- 
                  htp.p('  <style type="text/css">
                .img_produto {
                    position: relative;
                    max-width: 210px;
                    width: 60%;
                }
                </style>');
                  htp.p('<table border=0>');
                  htp.p('  <tr align="center">');
                  -- 
                  for a in ( select idfotoproduto
                                  , codigosisdist
                                  , nome
                                  , imagem
                                  , qtd
                             from (  select f.idfotoproduto
                                         , p.codigosisdist
                                         , initcap(nomeproduto) nome
                                         , '<a href="'||url||'" target="_blank"> <img src="'||urlreduzida||'" class="img_produto"><a>' imagem
                                         , count(1) qtd
                                    from fotosprodutos             f
                                       , produtos                  p
                                       , registroscompartilhafotos rr
                                       , vendedoras                v
                                       , representantes            r
                                    where f.idproduto       = p.idproduto
                                      and rr.idproduto       = f.idproduto
                                      and ( :P418_IDREPRESENTANTE is null or v.idrepresentante = :P418_IDREPRESENTANTE )
                                      and v.idfilial = :P0_IDFILIAL
                                      and rr.idfotoproduto   = f.idfotoproduto
                                      and rr.idvendedora     = v.idvendedora
                                      and v.idrepresentante = r.idrepresentante
                                      and 1 = 2
                                    group by f.idfotoproduto
                                           , p.codigosisdist
                                           , initcap(p.nomeproduto)
                                           , urlreduzida
                                           , url
                                    order by 5 desc )
                               where rownum <= 24 )
                  loop
                    --
                    htp.p('  <td align="center">');
                    htp.p(       a.imagem );
                    htp.p('    <br>');
                    htp.p(       a.codigosisdist||' <br> '||a.nome ||'<br>'||a.qtd);
                    htp.p('  </td>');
                    --
                    vqtdcolunas := vqtdcolunas + 1;
                    --
                    if  vqtdcolunas = 9 then
                      vqtdcolunas := 0;
                      --
                      htp.p('  </tr>');
                      htp.p('  <tr>');
                    end if;
                    --
                  end loop;
                  --
                  htp.p('  </tr>');
                  htp.p('<table>');
                  --
                end;
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    pageItem P418_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 30
            region: @lista-de-consultoras
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P418_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 20
            region: @lista-de-consultoras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P418_FILTRAR (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Por Período;P,Tudo;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @lista-de-consultoras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P418_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecidade||' - '||e.sigla display_value
                     , c.idcidade return_value
                from cidades c
                   , estados e
                where e.idestado = c.idestado
                  and e.idpais   = 1
                  and e.idestado = :P418_IDESTADO
                  and exists ( select 1
                               from pessoas p
                                  , vendedoras v
                               where v.idpessoa = p.idpessoa
                                 and p.idcidade = c.idcidade
                                 and v.ativo    = 'S' )
                order by c.nomecidade
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P418_IDESTADO
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P418_IDESTADO (
        type: selectList
        label {
            label: Estado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nome||' - '||e.sigla display_value
                     , e.idestado return_value
                from estados e
                where e.idpais = 1
                order by e.nome
                ```
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P418_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomepessoa(r.idpessoa)||' - '||idrepresentante  display_value
                     , r.idrepresentante return_vaue
                from representantes r
                   , gerentes       g
                where r.idgerente = g.idgerente
                  and g.idfilial  = :P0_IDFILIAL
                  and r.ativo     = 'S'
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Ver todos -
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P418_SEMANA_CARGA (
        type: textField
        label {
            label: Ultima Carga
            alignment: left
        }
        layout {
            sequence: 10
            region: @carga-da-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select pck_util.fnc_semanaid(idsemana) semana
                from (
                       select max(c.idsemana) idsemana
                       from cargasrepresentantes c
                       where c.idrepresentante = :P418_IDREPRESENTANTE ) s
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P418_SITUACAO_CARGA (
        type: textField
        label {
            label: Situação da Carga
            alignment: left
        }
        layout {
            sequence: 20
            region: @carga-da-semana
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select decode(c.situacao,1,'Aberta',2,'Aguardando Conclusão',3,'Concluída',0,'Cancelada') situacao
                from cargasrepresentantes c
                where c.idcargarepresentante = ( select max(cc.idcargarepresentante)
                                                 from cargasrepresentantes cc
                                                 where cc.idrepresentante = :P418_IDREPRESENTANTE )
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P418_TABLETS (
        type: selectList
        label {
            label: Tablets
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nome  ||' (' || e.chaveativacao||')' ||' - '|| case
                                                                          when s.datatablet is null then
                                                                            ' ainda não recebido'
                                                                          else
                                                                              trim(to_char(s.datatablet,'dd/mm/rrrr hh24:mi:ss') )
                                                                        end recebidoem  
                     , s.idtablet
                from roman.equipamentos   e
                   , catal.usuarios       u
                   , catal.representantes r
                   , biroman.sincronizar  s
                where e.usuario             = u.usuario
                  and u.idpessoa            = r.idpessoa 
                  and e.chaveativacao       = s.idtablet (+)
                  and e.idtipoequipamento   = 0
                  and e.situacao            = 'U'
                  and r.idrepresentante     = :P418_IDREPRESENTANTE
                ```
        }
        cascadingLov {
            parentItems: P418_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    dynamicAction altera-data-fim (
        name: Altera Data Fim
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P418_DATAFIM
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-consultoras
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction altera-data-inicio (
        name: Altera Data Inicio
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P418_DATAINICIO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-consultoras
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction tipo-cidade (
        name: Tipo Cidade
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P418_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P418_TIPOPESQUISA
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P418_IDREPRESENTANTE
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P418_IDESTADO
                    P418_IDCIDADE
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-empresa (
        name: Tipo Empresa
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P418_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P418_TIPOPESQUISA
            value: E
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P418_IDESTADO
                    P418_IDCIDADE
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P418_IDREPRESENTANTE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-filtro (
        name: Tipo Filtro
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P418_FILTRAR
        }
        clientSideCondition {
            type: item=value
            item: P418_FILTRAR
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P418_DATAINICIO
                    P418_DATAFIM
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-consultoras
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-consultoras
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P418_DATAINICIO
                    P418_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 418
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 418
                items: {
                    P418_IDESTADO: &P418_IDESTADO.
                    P418_IDCIDADE: &P418_IDCIDADE.
                    P418_IDREPRESENTANTE: &P418_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

