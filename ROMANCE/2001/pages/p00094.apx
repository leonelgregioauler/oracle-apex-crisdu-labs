    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @page_plug
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 20
            region: @page_plug
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:window.print();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process excluir (
        name: excluir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  delete pagamentocomissoes
                  where idpgtocomissao = :P94_DELETAR;
                  --
                  update controlepgtocomissoesped cp
                    set cp.fechado_repres = 'N'
                    where cp.comissaorepres_paga < cp.comissaorepres_disponivel
                      and exists ( select 1
                                   from logcatal.log_pagamentocomissoes p
                                   where p.idfechamentorepres = :P94_IDFECHAMENTOREPRES
                                     and p.idpedido = cp.idpedido );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 171458879524273360
        }
    )

    branch (
        name: Go To Page 94
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 94
                items: {
                    P94_IDREPRESENTANTE: &P94_IDREPRESENTANTE.
                    P94_FECHAMENTO: &P94_FECHAMENTO.
                    P94_DATAINICIO: &P94_DATAINICIO.
                    P94_DATAFIM: &P94_DATAFIM.
                }
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
        comments {
            comments: Created 06-FEV-2012 10:19 by ROMAN
        }
    )

    branch (
        execution {
            sequence: 20
