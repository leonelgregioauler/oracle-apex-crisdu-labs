    pageItem P94_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) Nome
                     , r.idrepresentante
                from pessoas p
                   , representantes r
                where r.idpessoa  = p.idpessoa  
                  and r.idrepresentante = :P94_IDREPRESENTANTE
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @page_plug
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            height: 1
        }
        source {
            used: always
        }
        security {
