page 94 (
    name: Pagamentos Efetuados
    title: Pagamentos Efetuados
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function deletapgto(pid)
            {
            
              var answer = confirm("Confirma exlusão do pagamento da comissão?")
              if (answer)
                {
                  document.getElementById('P94_DELETAR').value = pid;
                  apex.submit('DELETAR');
                }
            }
            ```
        executeWhenPageLoads: window.opener.location.reload();
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region pagamentos-efetuados-distribuidores (
        name: Pagamentos Efetuados Distribuidores
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case
                          when ( select concluido
                                 from fechamentossemanais
                                 where idfechamento = :P94_IDFECHAMENTO ) = 'N'  then
                           '<a href="javascript: deletapgto('||idpgtocomissao||')"> Excluir Pgto</a>'
                        else
                          '-'
                        end idpgtocomissao
                     , datapagamento "Data Pgto"
                     , valorpago "Valor Pago"
                     , p.fechamento "Fechamento"
                     , pp.nrpedido
                     , pck_romance.fnc_nomevendedora(pp.idvendedora) Consultora
                from pagamentocomissoes p
                   , pedidos pp
                where ( :P94_IDREPRESENTANTE is not null and p.idrepresentante = :P94_IDREPRESENTANTE )
                  and p.idpedido = pp.idpedido
                  and p.idfechamentorepres = :P94_IDFECHAMENTOREPRES
                  and p.tipopedido = 'P'
                  and pp.idpedido < 3000000
                		and ((to_date(:P94_DATAINICIO) is null and to_date(:P94_DATAFIM) is null)
                		      or ( trunc(p.datapagamento) between to_date(:P94_DATAINICIO) and to_date(:P94_DATAFIM)))
                union all
                select case
                          when exists ( select 1
                                        from fechamentossemanais
                                        where idfechamento = :P94_IDFECHAMENTO
                                          and concluido = 'N') then
                         '<a href="javascript: deletapgto('||idpgtocomissao||')"> Excluir Pgto</a>'
                        else
                          '-'
                        end idpgtocomissao
                     , datapagamento "Data Pgto"
                     , valorpago "Valor Pago"
                     , p.fechamento "Fechamento"
                     , pp.nrpedido
                     , pck_romance.fnc_nomevendedora(pp.idvendedora) Consultora
                from pagamentocomissoes p
                   , pedidos pp
                where ( :P94_IDGERENTE is not null and p.idgerente = :P94_IDGERENTE )
                  and p.idpedido = pp.idpedido
                  and p.tipopedido in ('P','R','T')
                  and p.idfechamentorepres = :P94_IDFECHAMENTOREPRES
                  and pp.idpedido < 3000000
                		and ((:P94_DATAINICIO is null and :P94_DATAFIM is null)
                		      or ( trunc(p.datapagamento) between to_date(:P94_DATAINICIO) and to_date(:P94_DATAFIM)))
                union all -- sistema novo
                select case
                          when ( select concluido
                                 from fechamentossemanais
                                 where idfechamento = :P94_IDFECHAMENTO ) = 'N' and pp.tipopedido in ('P','R','T') then
                           '<a href="javascript: deletapgto('||idpgtocomissao||')"> Excluir Pgto</a>'
                        else
                          '-'
                        end idpgtocomissao
                     , datapagamento "Data Pgto"
                     , valorpago "Valor Pago"
                     , p.fechamento "Fechamento"
                     , to_char(pp.numeropedido) numeropedido
                     , pck_romance.fnc_nomevendedora(pp.idvendedora) Consultora
                from pagamentocomissoes p
                   , favorita.pedidos pp
                where ( :P94_IDREPRESENTANTE is not null and p.idrepresentante = :P94_IDREPRESENTANTE )
                  and p.idpedido = pp.idpedido
                  and p.tipopedido in ('P','R','T')
                  and p.idfechamentorepres = :P94_IDFECHAMENTOREPRES
                  and pp.idpedido >= 3000000
                		and ((to_date(:P94_DATAINICIO) is null and to_date(:P94_DATAFIM) is null)
                		      or ( trunc(p.datapagamento) between to_date(:P94_DATAINICIO) and to_date(:P94_DATAFIM)))
                union all
                select case
                          when exists ( select 1
                                        from fechamentossemanais
                                        where idfechamento = :P94_IDFECHAMENTO
                                          and concluido = 'N') and pp.tipopedido in ('P','R','T') then
                         '<a href="javascript: deletapgto('||idpgtocomissao||')"> Excluir Pgto</a>'
                        else
                          '-'
                        end idpgtocomissao
                     , datapagamento "Data Pgto"
                     , valorpago "Valor Pago"
                     , p.fechamento "Fechamento"
                     , to_char(pp.numeropedido) numeropedido
                     , pck_romance.fnc_nomevendedora(pp.idvendedora) Consultora
                from pagamentocomissoes p
                   , favorita.pedidos pp
                where ( :P94_IDGERENTE is not null and p.idgerente = :P94_IDGERENTE )
                  and p.idpedido = pp.idpedido
                  and p.tipopedido in ('P','R','T')
                  and p.idfechamentorepres = :P94_IDFECHAMENTOREPRES
                  and pp.idpedido >= 3000000
                		and ((to_date(:P94_DATAINICIO) is null and to_date(:P94_DATAFIM) is null)
                		      or ( trunc(p.datapagamento) between to_date(:P94_DATAINICIO) and to_date(:P94_DATAFIM)))
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        pagination {
            type: setPaginationSearchEngine
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Não há pagamentos efetuados.
        }
        componentAdvanced {
            stripHtml: true
        }

