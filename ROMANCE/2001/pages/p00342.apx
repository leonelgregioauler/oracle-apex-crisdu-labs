    button create (
        buttonName: CREATE
        label: Anexar este documento
        layout {
            sequence: 50
            region: @anexos-de-entradas
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P342_IDANEXOENTRADA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 20
            region: @anexos-de-entradas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P342_IDANEXOENTRADA
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @anexos-de-entradas
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 72
                items: {
                    P72_IDENTRADA: &P342_IDENTRADA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_entradas(pidentrada => :P342_IDENTRADA
                                                  ,pidanexo => :P342_IDANEXOENTRADA);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Arquivo anexado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 779754177172840814
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P342_IDANEXOENTRADA := null;
                  pck_anexos.prc_apagaanexo_entradas(pidanexoentrada => :P342_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 779754210326840815
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexosentradas (
        name: Fetch Row from ANEXOSENTRADAS
        type: autoRowFetch
        source {
            tableName: ANEXOSENTRADAS
            pkColumn: IDANEXOENTRADA
            pkItem: P342_IDANEXOENTRADA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 779771801143402939
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P342_IDANEXOENTRADA is null then
                        select "#OWNER#"."SEQ_IDANEXOENTRADA".nextval
                          into :P342_IDANEXOENTRADA
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 779772223124402940
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexosentradas (
        name: Process Row of ANEXOSENTRADAS
        type: autoRowProcessing
        target {
            tableName: ANEXOSENTRADAS
            pkColumn: IDANEXOENTRADA
            pkItem: P342_IDANEXOENTRADA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 779772615044402941
        }
    )

)

