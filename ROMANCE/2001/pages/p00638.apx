    pageItem P638_CATEGORIA (
        type: selectList
        label {
            label: Categoria
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct (roman.pck_romance.fnc_nomecategoria(p.idcategoria)) ctegoria
                    , p.idcategoria return_value
                from roman.produtos p
                where p.idcategoria not in (140,141,142)
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
