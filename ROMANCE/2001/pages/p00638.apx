page 638 (
    name: Consulta de Produtos
    title: Consulta de Produtos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .img_produto_new {
                position: relative;
                max-width: 152px;
                width: 50%;
            }
            .img_produto {
                position: relative;
                max-width: 210px;
                width: 60%;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region consulta-de-produtos (
        name: Consulta de Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(e.idfilial) Filial
                     , p.codigosisdist
                     , roman.pck_romance.fnc_nomecategoria(p.idcategoria) Categoria
                     , p.codigosisdist||' - '|| initcap(p.nomeproduto) nomeproduto
                     , sum (nvl(e.qtd_pp,0)   + nvl(e.qtd_p,0)
                          + nvl(e.qtd_m,0)    + nvl(e.qtd_g,0)
                          + nvl(e.qtd_gg,0)   + nvl(e.qtd_egg,0)
                          + nvl(e.qtd_exgg,0) + nvl(e.qtd_u,0)) Quantidade
                    , p.dtinclusao
                    , decode(e.comissao,'S','Sim','N','Não') comissao
                    , '<a href="'||url||'" target="_blank"> <img src="'||urlreduzida||'" class="img_produto"><a>' imagem
                    ,  ( select listagg (roman.pck_romance.fnc_nomefornecedor (f.idfornecedor),', ') within group (order by f.idfornecedor) fornecedor
                         from roman.fornecedoresprodutos f
                         where f.idproduto = p.idproduto ) fornecedor
                from roman.estoquefilial e
                   , roman.produtos p
                   , roman.fotosprodutos fp
                where e.idproduto = p.idproduto
                 and p.idproduto = fp.idproduto(+)
                 and e.ativo = 'S'
                 and e.comissao is not null 
                 and exists ( select 1 
                              from roman.vw_filiais f
                              where f.idfilial = e.idfilial
                                and f.tipofilial = 'D'
                                and f.idgrupo is not null)
                 and ( :P638_IDFILIAL is null or e.idfilial = :P638_IDFILIAL)
                 and ( :P638_CODIGO is null or p.codigosisdist = :P638_CODIGO )
                 and ( :P638_PRODUTO is null or lower(p.nomeproduto) like '%'||lower(replace(:P638_PRODUTO,' ','%' ))||'%')
                 and ( :P638_CATEGORIA is null  or p.idcategoria = :P638_CATEGORIA)
                 and ( :P638_TIPOPESQUISA = 'A'
                  or ( :P638_TIPOPESQUISA = 'C' and exists ( select 1 
                                                             from roman.fotosprodutos fp 
                                                             where fp.idproduto = p.idproduto))
                  or ( :P638_TIPOPESQUISA = 'S' and not exists ( select 1 
                                                                 from roman.fotosprodutos fp 
                                                                 where fp.idproduto = p.idproduto)))
                 and :P638_FILTRAR = 'S'
                group by p.codigosisdist, p.nomeproduto  ,p.idcategoria, e.comissao, url, urlreduzida , e.idfilial, p.dtinclusao,p.idproduto
                order by  Quantidade desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
