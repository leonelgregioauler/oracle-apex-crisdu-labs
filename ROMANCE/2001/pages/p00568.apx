    region pagamentos (
        name: Pagamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.id
                     , v.numeroparcela
                     , v.datavencimento
                     , v.valorparcela
                     , v.databaixa
                     , v.baixarealizada
                     , case 
                         when situacao in ('A','E','V') and exists ( select 1 
                                                                     from negociacoesparceiros np
                                                                     where np.idnegociacaoparceiro = v.idnegociacaoparceiro  
                                                                       and np.formapagamento in ('T','G','D') ) then
                           '<a href="javascript:fnc_quitar('|| idnegociacaoparceiro ||')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         else 
                           null
                       end QUITAR
                from vw_pgto_neg_parceiros v
                where v.idnegociacaoparceiro = :P568_IDNEGOCIACAOPARCEIRO
                order by 2
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
