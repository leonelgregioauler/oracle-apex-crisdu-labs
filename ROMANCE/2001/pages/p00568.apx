    button remover-negociacao (
        buttonName: REMOVER_NEGOCIACAO
        label: Remover Negociação
        layout {
            sequence: 10
            region: @negociação-de-parceiro
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('APP_USER') in ('ALEXIASILVA','GUILHERME','OSIELF','BRUNOB','ADRIANABERGER','GRAZIELAMORAES','DEBORALIMA','CAROLINISEVERO')
        }
    )

    process consulta-em-negociações-parceiros (
        name: Consulta em Negociações Parceiros
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalor number; 
                  vvalorabatido number;
                  vvalorjuros number;
                  vdata  date;
                  vdatalimite date;
                begin
                  --
                  pck_negociacoes_rmc.prc_negociacoesparceiros(pidnegociacaoparceiro => :P568_IDNEGOCIACAOPARCEIRO,
                                                               pidvendedora => :P568_IDVENDEDORA,
                                                               pdatanegociacao => vdata,
                                                               pvalornegociacao => vvalor,
                                                               pformapagamento => :P568_FORMAPAGAMENTO,
                                                               ptid => :P568_TID,
                                                               pnsu => :P568_NSU,
                                                               pqtdparcelas => :P568_QTDPARCELAS,
                                                               parquivoenvio_operadora => null,
                                                               parquivoretorno_operadora => null,
                                                               pdatalimitedeposito => vdatalimite,
                                                               pidcontabancaria => :P568_IDCONTABANCARIA,
                                                               pvalorabatido => vvalorabatido,
                                                               pvalorjuros => vvalorjuros,
                                                               pmd5 => :P568_MD5,
                                                               poperacao_dml => 'S');
                  --
                  :P568_DATANEGOCIACAO     := to_char(vdata,'DD/MM/RRRR HH24:MI:SS'); 
                  :P568_DATALIMITEDEPOSITO := to_char(vdatalimite,'DD/MM/RRRR'); 
                  :P568_VALORNEGOCIACAO    := to_char(vvalor,'999G999G999G999G990D00');
                  :P568_VALORABATIDO       := to_char(vvalorabatido,'999G999G999G999G990D00');
                  :P568_VALORJUROS         := to_char(vvalorjuros,'999G999G999G999G990D00');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 33857856770967892
        }
    )

    process quita-parcela (
        name: Quita Parcela
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_negociacoes_rmc.prc_realizabaixapagamento(pidnegociacaoparceiro => :P568_IDEDITAR);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Quitado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 819495639607729107
        }
        serverSideCondition {
            type: request=Value
            value: QUITAR
        }
    )

    process remove-negociação (
        name: Remove Negociação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_negociacoes_rmc.prc_remove_negociacao(pidnegociacao => :P568_IDNEGOCIACAOPARCEIRO);
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Negociação Removida com sucesso!
        }
        advanced {
            executionMappingIdentifier: 132697757346068505
        }
        serverSideCondition {
            type: request=Value
            value: REMOVER_NEGOCIACAO
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 567
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @remover-negociacao
        }
    )

)

