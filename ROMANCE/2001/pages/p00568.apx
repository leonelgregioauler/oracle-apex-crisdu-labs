    region documentos-sinalizados (
        name: Documentos Sinalizados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select (select p.documentoestrangeiro
                          from catal.vendedoras v
                             , catal.pessoas p
                         where v.idpessoa = p.idpessoa
                           and v.idvendedora = d.idvendedora) doc_est 
                     , case
                         when d.idnotavenda is not null then
                           'Sacola Romance'
                         when d.idpedido is not null then
                           'Pedido Favorita'
                         when d.idboleto is not null then
                           'Pedido Catalogo'
                         when d.idpepinorepres is not null then
                           'Pepino Antigo'
                       end origem
                     , d.documento
                     , (d.valor-valordesconto) valor
                     , d.valororiginal 
                     , d.valoratualizado
                     , d.valordesconto
                     , (d.valoratualizado - valororiginal) juros
                from documentosnegociacao d
                where d.idnegociacaoparceiro = :P568_IDNEGOCIACAOPARCEIRO
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }

