    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir Débitos
        layout {
            sequence: 10
            region: @lista-de-débitos
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: fnc_imprime();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction esconde-campos (
        name: Esconde campos
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P239_FILTRAR_POR_DATA
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P239_DATAINICIO
                    P239_DATAFIM
                ]
            }
            execution {
                sequence: 20
            }
            clientSideCondition {
                type: item=value
                item: P239_FILTRAR_POR_DATA
                value: N
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P239_DATAINICIO
                    P239_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: item=value
                item: P239_FILTRAR_POR_DATA
                value: S
            }
        )

    )

    branch (
        name: imprime
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 242
                items: {
                    P242_IDREPRESENTANTE: &P239_IDREPRESENTANTE.
                    P242_ENVIADOCOBRANCA: &P239_ENVIADOCOBRANCA.
                    P242_IDREGIAOVENDA: &P239_IDREGIAOVENDA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

    branch (
        name: Go To Page 239
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 239
                items: {
                    P239_IDREPRESENTANTE: &P239_IDREPRESENTANTE.
                    P239_ENVIADOCOBRANCA: &P239_ENVIADOCOBRANCA.
                    P239_IDREGIAOVENDA: &P239_IDREGIAOVENDA.
                    P239_SITUACAO_CLIENTE: &P239_SITUACAO_CLIENTE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

