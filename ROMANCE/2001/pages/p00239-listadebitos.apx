    region lista-de-débitos (
        name: Lista de Débitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct p.idpessoa
                     , v.idvendedora 
                     , n.dataretorno
                     , initcap(p.nomepessoa)||' - '||nvl(p.documentoestrangeiro,cpf) nomepessoa
                     , decode(v.ativo,'S','Ativo','N','Inativo') situacaocliente
                     , n.numeronota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_retornatelefones(v.idvendedora) telefone
                     , initcap(p.enderecoprincipal) ||', '|| p.numero||'<br>'||p.bairro endereco
                     , ( select initcap(c.nomecidade)||' - '||e.sigla
                         from cidades c
                            , estados e
                         where p.idcidade = c.idcidade
                           and c.idestado = e.idestado ) nomecidade
                     , ( select rv.descricao from regioesvenda rv where rv.idregiaovenda = ( select vv.idregiaovenda from vendedoras vv where vv.idpessoa = p.idpessoa)) "Regiao Vendedora"
                     , v.observacao||', '||p.observacao observacao
                     , n.valortotalnota
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , nvl(n.valorpago,0) valorpago
                     , n.saldo
                from pessoas p
                   , vendedoras v
                   , notasvendas n
                where v.idpessoa        = p.idpessoa
                  and ( :P239_ENVIADOCOBRANCA = 'A' 
                     or ( :P239_ENVIADOCOBRANCA = 'S' and nvl(n.enviadocobranca,'N') = 'S' )
                     or ( :P239_ENVIADOCOBRANCA = 'N' and nvl(n.enviadocobranca,'N') = 'N' ) )
                  and ( :P239_SITUACAO_CLIENTE = 'A'
                     or ( :P239_SITUACAO_CLIENTE = 'S' and v.ativo = 'S')
                     or ( :P239_SITUACAO_CLIENTE = 'N' and v.ativo = 'N') )
                  and ( n.idrepresentante = :P239_IDREPRESENTANTE
                      or n.idrepresentanteatende = :P239_IDREPRESENTANTE )
                  and ( :P239_IDREGIAOVENDA = -1 or n.idregiaovenda = :P239_IDREGIAOVENDA )
                  and ( :P239_FILTRAR_POR_DATA = 'N' 
                       or (:P239_FILTRAR_POR_DATA = 'S' 
                       and n.dataretorno between :P239_DATAINICIO and :P239_DATAFIM))
                  and v.idvendedora     = n.idvendedora
                  --and n.idrepresentante = v.idrepresentante
                  AND N.SALDO > 0
                  and n.idsituacaonotavenda = 4
                order by 3,4
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
