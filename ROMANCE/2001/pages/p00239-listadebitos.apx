    pageItem P239_IDREGIAOVENDA (
        type: selectList
        label {
            label: Região de Venda
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.descricao||' - '||rr.semana d
                     , r.idregiaovenda r
                from regioesvenda r
                   , regioesrepresentantes rr
                where rr.idrepresentante = :P239_IDREPRESENTANTE
                  and r.idregiaovenda    = rr.idregiaovenda
                order by rr.idsemana
                ```
            nullDisplayValue: - Todas -
            nullReturnValue: -1
        }
        cascadingLov {
            parentItems: P239_IDREPRESENTANTE
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P239_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||'('||idrepresentante||')'||' - '||decode(ativo,'S','Ativo','N','Inativo') d
                     , idrepresentante r
                  from representantes r 
                 where r.idgerente = ( select idgerente
                                         from gerentes g
                                        where g.idfilial = :P0_IDFILIAL )
                   and (   (:P239_STREPRESENTANTE = 'A') 
                        or (:P239_STREPRESENTANTE = 'N' and r.ativo = 'N') 
                        or (:P239_STREPRESENTANTE = 'S' and r.ativo = 'S') )
                order by 1
                ```
            nullDisplayValue: - Selecione o Distribuidor -
        }
        cascadingLov {
            parentItems: P239_STREPRESENTANTE
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P239_SESSION_IMPRIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2001;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':242:'||l_session||'::NO::P242_IDREPRESENTANTE,P242_IDREGIAOVENDA,P242_ENVIADOCOBRANCA:'||:P239_IDREPRESENTANTE||','||:P239_IDREGIAOVENDA||','||:P239_ENVIADOCOBRANCA,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

