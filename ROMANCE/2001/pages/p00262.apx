            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column "Usuario Alterou" (
            type: plainText
            heading {
                heading: Usuario Alterou
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 673705 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Ativo" (
                sequence: 6
            )

            displayColumn CPF (
                sequence: 12
            )

            displayColumn "Data Alteração" (
                sequence: 1
            )

            displayColumn "ID Pessoa" (
                sequence: 5
            )

            displayColumn "ID Vendedora" (
                sequence: 4
            )

            displayColumn "Observação" (
                sequence: 7
            )

            displayColumn "Pontos" (
