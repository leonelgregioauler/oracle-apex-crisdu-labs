page 262 (
    name: Log Clientes
    title: "Log Clientes "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region log-clientes-v (
        name: Log Clientes V
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.dataalteracao "Data Alteração"
                     , v.usuarioalteracao "Usuario Alterou"
                     , decode(v.tipoalteracao,'U','Alteração','I','Inclusão','D','Exclusão') "Tipo Alteração"
                     , v.idvendedora "ID Vendedora"
                     , v.idpessoa "ID Pessoa"
                     , decode(v.ativo,'S','Sim','N','Não') "Ativo"
                     , v.observacao "Observação"
                     , pck_romance.fnc_nomerepresentante(v.idrepresentante) "Representante"
                     , v.pontos "Pontos"
                     , pck_romance.fnc_nomeregiaovenda(v.idregiaovenda) "Região de Venda"
                     , v.spc
                     , (select cpf from pessoas where idpessoa = v.idpessoa) "CPF"
                from logcatal.log_vendedoras v
                where v.idvendedora = :P262_IDVENDEDORA
                order by v.idlog desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: singleRowView
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        singleRowView {
            excludeNullValues: true
            onlyDisplayedColumns: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Não há informações.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 67363994766050233
        }

        column Ativo (
            type: plainText
            heading {
                heading: Ativo
                alignment: center
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column CPF (
            type: plainText
            heading {
                heading: Cpf
                alignment: center
            }
            layout {
                sequence: 12
            }
            source {
