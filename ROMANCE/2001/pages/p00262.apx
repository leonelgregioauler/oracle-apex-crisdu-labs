        )

    )

    region log-de-cliente (
        name: "Log de Cliente "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P262_IDVENDEDORA (
        type: popupLov
        label {
            label: Cliente
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||p.cpf||')'
                     , v.idvendedora
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and v.idrepresentante in (select idrepresentante 
                                            from representantes 
                                            where idgerente = (select idgerente
                                                               from gerentes 
                                                               where idfilial = :P0_IDFILIAL))
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @log-de-cliente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtar (
        buttonName: Filtar
        label: Filtar
        layout {
            sequence: 10
            region: @log-de-cliente
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
            point: processing
        }
        behavior {
            target: {
                page: 262
                items: {
                    P262_IDVENDEDORA: &P262_IDVENDEDORA.
                }
                action: resetPagination
            }
        }
    )

)

