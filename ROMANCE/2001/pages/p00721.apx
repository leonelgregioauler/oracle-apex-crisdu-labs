page 721 (
    name: Anexos Débito Cliente
    title: Anexos Débito Cliente
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            //var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P721_IDANEXODELETAR":pidanexo}
              });
            }
            ```
        executeWhenPageLoads: initDeleteAnexo();
    }

    region anexos-débito-cliente (
        name: Anexos Débito Cliente
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            footerText: <font color="green"> Você pode anexar mais de um arquivo.</font>
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idanexodebitocliente
                     , t.nomearquivo
                     , data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     --, '<a href="javascript: fnc_removeanexo('||t.idanexodebitocliente||','''||t.nomearquivo||''');">Remover</a>' remover
                     , roman.pck_bucket.sp_abre_anexo(url_bucket) preview
                from ANEXOSDEBITOCLIENTE t
                where idpessoa = :P721_IDPESSOA
                --order by t.data
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: documentos
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from ANEXOSDEBITOCLIENTE a
                where a.idpessoa = :P721_IDPESSOA
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/yyyy
            }
        )

        column IDANEXODEBITOCLIENTE (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Nome Arquivo
            }
            layout {
                sequence: 20
            }
        )

        column PREVIEW (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Anexo
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
        )

    )

    pageItem P721_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo ...
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            filenameColumn: NOMEARQUIVO
            fileTypes: image/png,image/jpeg,application/pdf
        }
        layout {
            sequence: 20
            region: @anexos-débito-cliente
            slot: regionBody
            alignment: left
            column: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P721_DATA (
        type: hidden
        layout {
            sequence: 60
            region: @anexos-débito-cliente
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P721_IDANEXODEBITOCLIENTE (
        type: hidden
        layout {
            sequence: 10
            region: @anexos-débito-cliente
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXODEBITOCLIENTE
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P721_IDANEXODELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @anexos-débito-cliente
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P721_IDANEXODESPESA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @anexos-débito-cliente
            slot: regionBody
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
    )

    pageItem P721_IDPESSOA (
        type: hidden
        layout {
            sequence: 10
            region: @anexos-débito-cliente
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPESSOA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P721_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @anexos-débito-cliente
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                begin
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  return vidusuario;
                  --
                end;
                  
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P721_NOMEARQUIVO (
        type: hidden
        layout {
            sequence: 30
            region: @anexos-débito-cliente
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 30
            region: @anexos-débito-cliente
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 20
            region: @anexos-débito-cliente
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: item=value
            item: P721_IDANEXODEBITOCLIENTE
            value: -1
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @anexos-débito-cliente
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction fechar-modal (
        name: Fechar Modal
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @voltar
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation informar-arquivo (
        name: Informar arquivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P721_ARQUIVOTEMP
        }
        error {
            errorMessage: Selecione o arquivo!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_debitos_cliente(pidpessoa => :P721_IDPESSOA);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 2120050596076835303
        }
    )

    process deletar-anexo (
        name: Deletar Anexo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P721_IDANEXODESPESA := null;
                  pck_anexos.prc_apagaanexo(pidanexodespesa => :P721_IDANEXODESPESA);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 512256216532613315
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexosdebitocliente (
        name: Fetch Row from ANEXOSDEBITOCLIENTE
        type: autoRowFetch
        source {
            tableName: ANEXOSDEBITOCLIENTE
            pkColumn: IDANEXODEBITOCLIENTE
            pkItem: P721_IDANEXODEBITOCLIENTE
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 2120050937699835304
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    --if :P721_idanexodebitocliente is null then
                        select "#OWNER#"."SEQ_ANEXOSDEBITOCLIENTE".nextval
                          into :P721_idanexodebitocliente
                          from sys.dual;
                  --  end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 2120051357350835304
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexosbalancos (
        name: Process Row of ANEXOSBALANCOS
        type: autoRowProcessing
        target {
            tableName: ANEXOSDEBITOCLIENTE
            pkColumn: IDANEXODEBITOCLIENTE
            pkItem: P721_IDANEXODEBITOCLIENTE
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Arquivo Anexado
        }
        advanced {
            executionMappingIdentifier: 2120051722289835304
        }
    )

    branch (
        name: Close
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 37
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

)

