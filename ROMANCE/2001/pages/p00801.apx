    region categorias (
        name: Categorias
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ct.idcampanhacategoria
                     , ct.idcategoriaclube
                     , ct.idconquistoulevou
                     , ct.ativabrinde
                    -- , 'f?p=&APP_ID.:803:&SESSION.::NO::P803_IDCAMPANHACATEGORIA,' || ct.idcampanhacategoria as link_page
                     , case
                         when ct.ativabrinde = 'S' then
                           '<a href="f?p=&APP_ID.:803:&SESSION.::NO::P803_IDCAMPANHACATEGORIA:' ||
                           ct.idcampanhacategoria || '">' ||
                           '<img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">' ||
                           '</a>'
                         else
                           ' '
                       end Incluibrinde
                from roman.campanhascategorias ct
                where ct.idconquistoulevou = :P801_IDCONQUISTOULEVOU
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
