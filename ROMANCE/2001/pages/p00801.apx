    process categorias-pendentes (
        name: Categorias pendentes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Ajuste Conquistou Levou (04/11/2026): lista as categorias do Clube que ainda nao estao cadastradas na campanha.
                -- O aviso em vermelho aparece enquanto faltar alguma (deposito, cupom e fechamento usam CAMPANHASCATEGORIAS).
                begin
                  :P801_AVISO_CATEGORIAS := null;
                  if :P801_IDCONQUISTOULEVOU is not null then
                    select listagg(cc.nomecategoria, ', ') within group (order by cc.idcategoriaclube)
                      into :P801_AVISO_CATEGORIAS
                      from roman.categoriasclubes cc
                     where not exists (select 1
                                         from roman.campanhascategorias ct
                                        where ct.idconquistoulevou = :P801_IDCONQUISTOULEVOU
                                          and ct.idcategoriaclube  = cc.idcategoriaclube);
                  end if;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1808010000000000003
        }
    )

    process categorias-save-interactive-grid-data (
        name: Categorias - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @categorias
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1800853045881802828
        }
        serverSideCondition {
            type: never
        }
