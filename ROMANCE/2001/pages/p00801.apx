    process processo-dml-campanhas (
        name: Processo DML Campanhas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdatainicio        date := :P801_DATAINICIO;
                  vdatafinal         date := :P801_DATAFINAL;
                  vdatadivulgacao    date := :P801_DATADIVULGACAO;
                  vdatafimdivulgacao date := :P801_DATAFIMDIVULGACAO;
                  vdatafindivulg     date;
                  voperacao_dml      varchar2(1);
                  vidcampanha        number;
                  vseq               number;
                  vdatainicio_atual  date;
                  vdatafinal_atual   date;
                  --
                  -- Ajuste Conquistou Levou fase 1 (30/10/2026) - itens 1.13 e 2.9 (decisoes D2 e D3):
                  -- a data de inicio so muda ate 24 horas antes do inicio e a data final so muda ate 24 horas antes do fim da troca.
                  -- A troca vai ate as 24h da data final. Excecoes sao tratadas com a TI.
                  --
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'SALVAR' then
                    --
                    voperacao_dml := 'U';
                    --  
                  elsif v('REQUEST') = 'DELETAR' then
                    --
                    voperacao_dml := 'D';
                    --
                  end if;
                  --
                  if voperacao_dml = 'I' then 
                    --
                     begin 
                       --
                       select c.idconquistoulevou
                            , c.datafinal
                         into vidcampanha
                            ,  vdatafindivulg
                       from roman.campanhasconquistoulevou c
                       where c.idconquistoulevou = (select max(idconquistoulevou)
                                                    from roman.campanhasconquistoulevou
                                                    where idpais = :P801_IDPAIS
                                                      and status = 'S');
                     exception 
                        when others then 
                          null;
                     end;
                     --
                     if trunc(vdatadivulgacao) < trunc(vdatafindivulg) then  
                       --
                       raise_application_error(-20001,'Data divulgação deve ser maior que a data fim divulgação da ultima campanha' );
                       --
                     elsif trunc(vdatafinal) < trunc(vdatainicio) then
                       --
                       raise_application_error(-20001,'Data final deve ser maior que a data Inicio' );
                       --
                     elsif trunc(vdatainicio) < trunc(vdatadivulgacao) then
                       --
                       raise_application_error(-20001,'Data Inicio deve ser maior ou igual a data de divulgação' );
                       --
                     elsif  trunc(vdatafimdivulgacao) < trunc(vdatadivulgacao) then
                       --
                       raise_application_error(-20001,'Data Fim de Divulgação deve ser maior que a Data de Divulgação' );
                       --
                     elsif vdatainicio - sysdate < 1 then
                       --
                       raise_application_error(-20001,'A data de início precisa estar a mais de 24 horas do cadastro. Procure a TI.' );
                       --
                     else 
                      --
                      select roman.seq_idconquistoulevou.nextval
                        into vseq
                      from dual;
                      --
                      :P801_IDCONQUISTOULEVOU := vseq;
                      --
                      if not regexp_like(:P801_CAMPANHA, '^[A-Za-z0-9 ]+$') then
                        --
                        raise_application_error(-20001,'O nome da campanha não pode conter caracteres especiais.');
                        --
                      end if;
                      --
                      insert into roman.campanhasconquistoulevou(IDCONQUISTOULEVOU,
                                                                 NOMECAMPANHA,
                                                                 DATACRIACAO,
                                                                 DATAINICIO,
                                                                 DATAFINAL,
                                                                 DATADIVULGACAO,
                                                                 STATUS,
                                                                 IDPAIS,
                                                                 DATAFIMDIVULGACAO)
                      values(vseq,
                             :P801_CAMPANHA,
                             sysdate,
                             :P801_DATAINICIO,
                             :P801_DATAFINAL,
                             :P801_DATADIVULGACAO,
                             :P801_STATUS,
                             :P801_IDPAIS,
                             :P801_DATAFIMDIVULGACAO);
                      end if;
                    --
                  elsif voperacao_dml = 'U' then
                    --
                    if not regexp_like(:P801_CAMPANHA, '^[A-Za-z0-9 ]+$') then
                      --
                      raise_application_error(-20001,'O nome da campanha não pode conter caracteres especiais.');
                    end if;
                    --
                    select cc.datainicio
                         , cc.datafinal
                      into vdatainicio_atual
                         , vdatafinal_atual
                      from roman.campanhasconquistoulevou cc
                     where cc.idconquistoulevou = :P801_IDCONQUISTOULEVOU;
                    --
                    if trunc(vdatainicio) != trunc(vdatainicio_atual)
                       and (vdatainicio_atual - sysdate < 1 or vdatainicio - sysdate < 1) then
                      --
                      raise_application_error(-20001,'Data de início só pode ser alterada até 24 horas antes do início. Procure a TI.' );
                      --
                    elsif trunc(vdatafinal) != trunc(vdatafinal_atual)
                       and (trunc(vdatafinal_atual) + 1 - sysdate < 1 or trunc(vdatafinal) + 1 - sysdate < 1) then
                      --
                      raise_application_error(-20001,'Data final só pode ser alterada até 24 horas antes do fim da troca. Procure a TI.' );
                      --
                    elsif trunc(vdatafinal) < trunc(vdatainicio) then
                      --
                      raise_application_error(-20001,'Data final deve ser maior que a data Inicio' );
                      --
                    elsif trunc(vdatainicio) < trunc(vdatadivulgacao) then
                      --
                      raise_application_error(-20001,'Data Inicio deve ser maior ou igual a data de divulgação' );
                      --
                    elsif trunc(vdatafimdivulgacao) < trunc(vdatadivulgacao)  then
                      --
                      raise_application_error(-20001,'Data Fim de Divulgação deve ser maior que a Data de Divulgação' );
                    --
                    else
                    --
                    update roman.campanhasconquistoulevou cc
                    set cc.nomecampanha = :P801_CAMPANHA, cc.datainicio = :P801_DATAINICIO, cc.datafinal = :P801_DATAFINAL,
                        cc.datadivulgacao = :P801_DATADIVULGACAO, cc.status = :P801_STATUS, CC.DATAFIMDIVULGACAO = :P801_DATAFIMDIVULGACAO
                    where cc.idconquistoulevou = :P801_IDCONQUISTOULEVOU;
                    end if;
                  end if;
                  --
                  COMMIT;
                  --
                  if voperacao_dml = 'I' then
                     --
                     apex_application.g_print_success_message := '<span style="color : white ">Campanha Cadastrada com sucesso! </span>';  
                      
                  elsif  voperacao_dml = 'U' then
                     --
                     apex_application.g_print_success_message := '<span style="color : white ">Alteração realizada com sucesso! </span>';
                    
                  elsif  voperacao_dml = 'D' then
                     --
                     apex_application.g_print_success_message := '<span style="color : white ">Exclusão realizada com sucesso! </span>';
                  end if;
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1800852355150802821
        }
    )

    process processo-grid-categorias (
        name: Processo grid categorias
        type: executeCode
        editableRegion: @categorias
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  -- Ajuste Conquistou Levou (04/11/2026): substitui o Save nativo do grid (desligado).
                  -- Depois do inicio da troca (0h da data de inicio), a categoria da campanha nao pode ser excluida nem trocada:
                  -- deposito, cupom e fechamento usam CAMPANHASCATEGORIAS.ATIVABRINDE. Mesma trava da pagina 803 para os brindes.
                  -- Tambem impede categoria repetida na mesma campanha. A coluna Ativa Brinde continua editavel.
                  vdataini DATE;
                  vqtd     NUMBER;
                  v_atual  roman.campanhascategorias%ROWTYPE;
                BEGIN
                  SELECT c.datainicio
                    INTO vdataini
                    FROM roman.campanhasconquistoulevou c
                   WHERE c.idconquistoulevou = :P801_IDCONQUISTOULEVOU;
                
                  IF :APEX$ROW_STATUS IN ('C', 'U') THEN
                    IF :IDCATEGORIACLUBE IS NULL THEN
                      raise_application_error(-20001, 'Informe a categoria.');
                    END IF;
                    SELECT COUNT(*)
                      INTO vqtd
                      FROM roman.campanhascategorias ct
                     WHERE ct.idconquistoulevou = :P801_IDCONQUISTOULEVOU
                       AND ct.idcategoriaclube  = TO_NUMBER(:IDCATEGORIACLUBE)
                       AND (:APEX$ROW_STATUS = 'C' OR ct.idcampanhacategoria != TO_NUMBER(:IDCAMPANHACATEGORIA));
                    IF vqtd > 0 THEN
                      raise_application_error(-20001, 'A categoria já está cadastrada nesta campanha.');
                    END IF;
                  END IF;
                
                  IF :APEX$ROW_STATUS = 'C' THEN
                
                    INSERT INTO roman.campanhascategorias (idcampanhacategoria, idconquistoulevou, idcategoriaclube, ativabrinde)
                    VALUES (roman.seq_idcategoriabrinde.nextval, :P801_IDCONQUISTOULEVOU, TO_NUMBER(:IDCATEGORIACLUBE), NVL(:ATIVABRINDE, 'N'))
                    RETURNING idcampanhacategoria INTO :IDCAMPANHACATEGORIA;
                
                  ELSIF :APEX$ROW_STATUS IN ('U', 'D') THEN
                
                    BEGIN
                      SELECT *
                        INTO v_atual
                        FROM roman.campanhascategorias ct
                       WHERE ct.idcampanhacategoria = TO_NUMBER(:IDCAMPANHACATEGORIA)
                         FOR UPDATE;
                    EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                        raise_application_error(-20001, 'A categoria da campanha não foi encontrada. Atualize a página.');
                    END;
                
                    IF :APEX$ROW_STATUS = 'D' THEN
                
                      IF vdataini <= SYSDATE THEN
                        raise_application_error(-20001,
                          'Campanha iniciada: a categoria não pode ser excluída. Para tirar a categoria da troca, altere Ativa Brinde para Não.');
                      END IF;
                
                      SELECT COUNT(*)
                        INTO vqtd
                        FROM roman.categoriasbrindes cb
                       WHERE cb.idcampanhacategoria = v_atual.idcampanhacategoria;
                      IF vqtd > 0 THEN
                        raise_application_error(-20001,
                          'A categoria tem ' || vqtd || ' brinde(s) cadastrado(s). Exclua os brindes antes de excluir a categoria.');
                      END IF;
                
                      DELETE FROM roman.campanhascategorias ct
                       WHERE ct.idcampanhacategoria = v_atual.idcampanhacategoria;
                
                    ELSE
                
                      IF TO_NUMBER(:IDCATEGORIACLUBE) != v_atual.idcategoriaclube AND vdataini <= SYSDATE THEN
                        raise_application_error(-20001,
                          'Campanha iniciada: a categoria de uma linha já gravada não pode ser trocada.');
                      END IF;
                
                      UPDATE roman.campanhascategorias ct
                         SET ct.idcategoriaclube = TO_NUMBER(:IDCATEGORIACLUBE),
                             ct.ativabrinde      = NVL(:ATIVABRINDE, 'N')
                       WHERE ct.idcampanhacategoria = v_atual.idcampanhacategoria;
                
                    END IF;
                
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 1808010000000000004
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

)

