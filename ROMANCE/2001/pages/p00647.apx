page 647 (
    name: Perdas - Escolha do Distribuidor
    title: Perdas - Escolha do Distribuidor
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region escolha-do-distribuidor (
        name: Escolha do Distribuidor
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region nova-perda (
        name: Nova Perda
        type: list
        source {
            list: @nova-perda
        }
        layout {
            sequence: 10
            slot: dialogHeader
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    pageItem P647_IDFILIAL (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo != 5
                ```
        }
        layout {
            sequence: 20
            region: @escolha-do-distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P647_IDNEGOCIACAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @escolha-do-distribuidor
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P647_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
            executeValidations: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||decode(r.ativo,'S','Ativo','N','Inativo') nome
                     , r.idrepresentante 
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P647_IDFILIAL )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P647_IDFILIAL
        }
        layout {
            sequence: 30
            region: @escolha-do-distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    button proximo (
        buttonName: PROXIMO
        label: Avançar
        layout {
            sequence: 10
            region: @escolha-do-distribuidor
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction inicia-negociacao (
        name: Inicia Negociacao
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @proximo
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vidnegociacao number;
                    begin
                      -- Call the procedure
                      pck_negociacoes_rmc.prc_inicianegociacaoperda(pidnegociacaoparceiro => vidnegociacao,
                                                                    pidfilial => :P647_IDFILIAL,
                                                                    pidrepresentante => :P647_IDREPRESENTANTE,
                                                                    pusuario => v('APP_USER') );
                      --
                      :P647_IDNEGOCIACAO := vidnegociacao;
                      --
                    end;
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: PROXIMO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go To Page 647
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 647
                items: {
                    P647_IDNEGOCIACAO: &P647_IDNEGOCIACAO.
                    P647_IDFILIAL: &P647_IDFILIAL.
                    P647_IDREPRESENTANTE: &P647_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
    )

    branch (
        name: Go To Page 648
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 648
                items: {
                    P648_IDNEGOCIACAO: &P647_IDNEGOCIACAO.
                    P648_IDREPRESENTANTE: &P647_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @proximo
        }
    )

)

