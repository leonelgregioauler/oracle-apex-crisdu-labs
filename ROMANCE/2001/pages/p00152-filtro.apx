    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatar_mascara(src,mascara,evt){
            var tecla;  
            if(evt.which){tecla = evt.which}
            else if(evt.keyCode){ tecla = evt.keyCode;}  
             if( tecla != 8 ){
             var campo = src.value.length;
             var saida = mascara.substring(0,1);
             var texto = mascara.substring(campo);
             if(texto.substring(0,1) != saida) {
             src.value+=texto.substring(0,1);}}
            }
            
            
            function validadocumento()
            { 
              var get = new htmldb_Get(null,&APP_ID.,'APPLICATION_PROCESS=validacpfcnpj',0);
              if  (document.getElementById('P152_FISICA_JURIDICA_0').checked)
                {
                  pValue = document.getElementById('P152_FISICA_JURIDICA_0').value;
                }
              if (document.getElementById('P152_FISICA_JURIDICA_1').checked)
                {
                  pValue = document.getElementById('P152_FISICA_JURIDICA_1').value;
                }
               void(0);
               pVCPF    = html_GetElement('P152_CPF').value;
               void(0);
               pVCNPJ    = html_GetElement('P152_CNPJ').value;
               void(0);
            
               get.add('F10008TIPO',pValue ); 
               get.add('F10008CPF',pVCPF    );
               get.add('F10008CNPJ',pVCNPJ    );
            
               gReturn = get.get();
            
               if(gReturn=='V')
                 {null;
               //    if (pValue == 'F')
               //   {
               //  alert('CPF é válido!');
               //      }
              //      if (pValue == 'J')
              //       {
              //      alert('CNPJ é válido!');
               //      }
                //    html_GetElement('P152_VALIDO').value = 'S';
                 }
                else
                {
                  if (pValue == 'F')
                  {
                    alert('CPF é inválido!');
                    }
                 if (pValue == 'J')
                  {
                  alert('CNPJ é inválido!');
                  }
                  html_GetElement('P152_VALIDO').value = 'N';
                }  
            
               get = null;
            }
            
            ```
