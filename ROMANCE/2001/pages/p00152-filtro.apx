    pageItem P152_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'CPF' as display_value
                     , 'C'   as return_value
                  from dual
                union
                select 'Doc. Estrangeiro' as display_value
                     , 'D'   as return_value
                  from dual
                union
                select 'ID Site' as display_value
                     , 'V'   as return_value
                  from dual
                union
                -- Maicon Aimi - 06/02/2025 - 9866361: opção representante deve aparecer semente para usuários do TI.
                select 'ID Representante' as display_value
                     , 'R'   as return_value
                  from dual
                 where exists (select 1
                                 from roman.usuariosgruposatendimento ug
                                where ug.usuario = v('APP_USER')
                                  and ug.idgrupoatendimento = 0)
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: C
        }
        security {
