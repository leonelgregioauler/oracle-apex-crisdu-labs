    validation p152-cpf (
        name: P152_CPF
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                /* Validação para opção CPF                     -   :P152_TIPO = 'C'*/
                select 1
                  from dual
                 where :P152_TIPO = 'C'
                   and exists ( select 1
                                  from catal.pessoas p 
                                 where replace(replace(p.cpf,'.',''),'-','') = replace(replace(:P152_CPF,'.',''),'-',''))
                
                union
                
                /* Validação para opção Documento estrangeiro   -   :P152_TIPO = 'D'*/
                select 1
                  from dual
                 where :P152_TIPO = 'D'
                   and exists ( select 1
                                  from catal.pessoas p
                                 where replace(replace(p.documentoestrangeiro,'.',''),'-','') = replace(replace(:P152_DOCESTRANGEIRO,'.',''),'-',''))
                
                union 
                
                /* Validação para opção ID Site(Vendedora)      -   :P152_TIPO = 'V'*/
                select 1
                  from dual
                 where :P152_TIPO = 'V'
                   and exists ( select 1
                                  from catal.vendedoras v
                                     , catal.pessoas p
                                 where v.idpessoa = p.idpessoa
                                   and v.idvendedora = :P152_IDVENDEDORA)
                
                union 
                
                /* Validação para opção ID Representante        -   :P152_TIPO = 'R'*/
                select 1
                  from dual
                 where :P152_TIPO = 'R'
                   and exists ( select 1
                                  from catal.representantes r
                                     , catal.pessoas p 
                                 where p.idpessoa = r.idpessoa
                                   and r.idrepresentante = :P152_IDREPRESENTANTE)
                ```
        }
        error {
            errorMessage: Cadastro não encontrado!
            associatedItem: @P152_CPF
        }
    )

    process busca-id (
        name: busca id
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  
                  if :P152_TIPO = 'C' then
                
                    select idpessoa
                      into :P152_IDPESSOA
                      from pessoas
                     where cpf = replace(replace(:P152_CPF,'.',''),'-','');
                     --where replace(replace(cpf,'.',''),'-','') = replace(replace(:P152_CPF,'.',''),'-','');
                
                  elsif :P152_TIPO = 'V' then 
                
                    select v.idpessoa
                      into :P152_IDPESSOA
                      from catal.vendedoras v
                     where v.idvendedora = :P152_IDVENDEDORA;
                
                  elsif :P152_TIPO = 'D' then
                
                    select idpessoa
                      into :P152_IDPESSOA
                      from pessoas
                     where DOCUMENTOESTRANGEIRO = replace(replace(:P152_DOCESTRANGEIRO,'.',''),'-','');
                     --where replace(replace(DOCUMENTOESTRANGEIRO,'.',''),'-','') = replace(replace(:P152_DOCESTRANGEIRO,'.',''),'-','');
                
                  -- Maicon Aimi - 06/02/2025 - 9866361: Adicionado essa opção para podeser buscar a pessoa pelo ID Representante.
                  elsif :P152_TIPO = 'R' then
                
                    select r.idpessoa
                      into :P152_IDPESSOA
                      from catal.representantes r
                     where r.idrepresentante = :P152_IDREPRESENTANTE;
                
                  end if;
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 315342656934014420
        }
    )

    branch (
        name: Go To Page 151
        execution {
