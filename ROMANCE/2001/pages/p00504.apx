page 504 (
    name: Histórico Mov. Cargas
    title: Histórico Mov. Cargas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 60%
        resizable: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            if ($('#movcargas td[headers="COR"]').val() =="S" ) {
                $('#movcargas td[headers="COR"]').filter(function(){
                    return $(this).text() === 'S'
                }).parent().children().css('background-color', 'Beige')
            } else {
                $('#movcargas td[headers="COR"]').filter(function(){
                    return $(this).text() === 'N'
                }).parent().children().css('background-color', 'White')
            }
            ```
    }
    css {
        inline: "#movcargas td {background-color: Beige}"
    }
    security {
        pageAccessProtection: unrestricted
    }

    region movimentação-dos-itens-da-carga (
        name: Movimentação dos Itens da Carga
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.usuarioalteracao
                     , (select codigosisdist from produtos where idproduto = l.idproduto) Produto
                     , pck_romance.fnc_nomeproduto(l.idproduto) "Nome Produto"
                     , l.tipoalteracao
                     , to_char(l.dataalteracao,'dd/mm/rrrr hh24:mi:ss') dataalteracao
                     , l.quantidade
                     , l.valorvenda
                     , l.comissao
                     , l.qtd_dist_pp
                     , l.qtd_dist_p
                     , l.qtd_dist_m
                     , l.qtd_dist_g
                     , l.qtd_dist_gg
                     , l.qtd_dist_egg
                     , l.qtd_dist_exgg
                     , l.qtd_dist_u
                     , case when to_date(l.dataalteracao,'dd/mm/rrrr hh24:mi:ss') > to_date(:P504_DATACONCLUSAO,'dd/mm/rrrr hh24:mi:ss') then 'S' else 'N' end cor 
                     
                  from logroman.log_itenscargarepresentant l
                 where idcargarepresentante = :P504_IDCARGAREPRES
                 order by dataalteracao desc
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: movcargas
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            formats: [
                excel
                pdf
            ]
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 1108724357195543920
        }

        column COMISSAO (
            type: plainText
            heading {
                heading: Comissão
            }
            layout {
                sequence: 80
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

