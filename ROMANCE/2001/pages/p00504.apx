        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 11087760 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COMISSAO (
                sequence: 8
            )

            displayColumn DATAALTERACAO (
                sequence: 4
            )

            displayColumn "Nome Produto" (
                sequence: 3
            )

            displayColumn PRODUTO (
                sequence: 2
            )

            displayColumn QTD_DIST_EGG (
                sequence: 14
            )

            displayColumn QTD_DIST_EXGG (
                sequence: 15
            )

            displayColumn QTD_DIST_G (
                sequence: 12
            )

            displayColumn QTD_DIST_GG (
                sequence: 13
            )

            displayColumn QTD_DIST_M (
                sequence: 11
            )

