    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-pesquisa-empresa (
        name: Tipo Pesquisa Empresa
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P731_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P731_TIPOPESQUISA
            value: E
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P731_TODOSPRODUTOS
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P731_IDEMPRESA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P731_IDEMPRESA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P731_TODOSPRODUTOS
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction tipo-pesquisa-grupo (
        name: Tipo Pesquisa Grupo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P731_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P731_TIPOPESQUISA
            value: G
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P731_IDGRUPO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P731_IDGRUPO
            }
            execution {
                sequence: 10
            }
        )

    )

    validation semana-final-menor (
        name: Semana final menor
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where ( select s.idsemana 
                        from semana_dias s
                        where s.semanacompleta = :P731_SEMANAFIM ) > ( select s.idsemana
                                                                       from semana_dias s
                                                                       where s.semanacompleta = :P731_SEMANAINI )
                ```
        }
        error {
            errorMessage: Semana final não pode ser menor que a semana inicial!
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    branch (
        name: Go To Page 731
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 731
                items: {
                    P731_IDPRODUTO: &P731_IDPRODUTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

