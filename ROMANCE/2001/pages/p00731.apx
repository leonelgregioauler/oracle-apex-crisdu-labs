page 731 (
    name: Produtos Notas
    title: Produtos Notas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region produto-notas (
        name: Produto Notas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.idnotavenda
                     , roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) Distribuidor_nota 
                     , nv.semanacobranca 
                     , initcap(p.nomeproduto) produto 
                     , i.valorvenda
                     , i.quantidade
                     , p.idproduto
                     , p.codigosisdist
                  from roman.itensnotavenda i
                     , roman.notasvendas nv
                     , roman.produtos    p
                 where nv.idnotavenda = i.idnotavenda
                   and i.idproduto    = p.idproduto
                   and nv.idfilial    = :P0_IDFILIAL
                   and p.idproduto = :P731_IDPRODUTO
                   and (:P731_IDREPRESENTANTE is null or nv.idrepresentante = :P731_IDREPRESENTANTE)
                   and (:P731_SEMANAINI is null or nv.idsemanacobranca between ( select s.idsemana
                                                                                 from semana_dias s
                                                                                 where s.semanacompleta = :P731_SEMANAINI ) and ( select s.idsemana
                                                                                                                                  from semana_dias s
                                                                                                                                  where s.semanacompleta = :P731_SEMANAFIM ))
                order by 1 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3932115508764565691
        }

        column CODIGOSISDIST (
            type: hidden
            heading {
                heading: Codigosisdist
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: O
            }
            security {
                escapeSpecialChars: false
            }
        )

        column DISTRIBUIDOR_NOTA (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: P
            }
        )

