    pageItem P731_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist||' - '||p.nomeproduto display_value
                     , p.idproduto return_value
                from produtos p
                order by p.nomeproduto
                ```
            nullDisplayValue: "- Escolha um Produto - "
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 71
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P731_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||'('||idrepresentante||')'||' - '||decode(ativo,'S','Ativo','N','Inativo') d
                     , idrepresentante r
                from catal.representantes r 
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P731_SEMANAFIM (
        type: textField
        label {
