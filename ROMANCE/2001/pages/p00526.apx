        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region débitos-gerados (
        name: Débitos Gerados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.numeronota
                     , n.semanacobranca
                     , n.idsemanacobranca
                     , pck_romance.fnc_nomerepresentante(idrepresentante) representante
                     , pck_romance.fnc_nomevendedora(n.idvendedora) nomevendedora
                     , n.valortotalvendalqd
                     , n.valorpago valorpago
                     , n.saldo  saldo
                     , pck_romance.fnc_nomefilial(idfilial) filial
                     , ( select max(trunc(pn.datapagamento))
                         from pagamentosnotasvendas pn
                         where pn.idnotavenda = n.idnotavenda) ultimopagamento
                     , pck_romance.fnc_cpfvendedora(idvendedora) cpf
                     , n.idnotavenda
                     , n.idrepresentante
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||n.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' url
                from notasvendas n
                where n.idsituacaonotavenda = 4
                  and n.saldo > 0
                  and ( :P526_IDREGIAOVENDA is null or n.idregiaovenda = :P526_IDREGIAOVENDA )
                  and ( :P526_IDREPRESENTANTE is null or n.idrepresentante = :P526_IDREPRESENTANTE )
                  and n.idfilial = :P0_IDFILIAL
                  and :P526_TIPORELATORIO = 'D'
                  and :P526_TIPO_DEBITO = 'G'   
                  and ( :P526_TIPO_SEMANA is null
                     or ( :P526_TIPO_SEMANA = 'P' and n.idsemanacobranca between :P526_IDSEMANAINICIO and :P526_IDSEMANAFIM )
                     or ( :P526_TIPO_SEMANA = 'S' and n.idsemanacobranca = :P526_IDSEMANA ) )
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P526_TIPORELATORIO = 'D'
                  and :P526_TIPO_DEBITO = 'G'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1592283766024560232
        }

