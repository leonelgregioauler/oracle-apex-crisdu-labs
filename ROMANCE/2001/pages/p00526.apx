    region débitos-gerados-resumido (
        name: Débitos Gerados Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante (n.idrepresentante) Distribuidor
                     , count(n.idnotavenda) qtd
                     , sum(n.saldo) Saldo
                from notasvendas n
                where n.idsituacaonotavenda = 4
                  and n.saldo > 0
                  and n.idfilial = :P0_IDFILIAL
                  and ( :P526_TIPO_SEMANA is null
                     or ( :P526_TIPO_SEMANA = 'P' and n.idsemanacobranca between :P526_IDSEMANAINICIO and :P526_IDSEMANAFIM )
                     or ( :P526_TIPO_SEMANA = 'S' and n.idsemanacobranca = :P526_IDSEMANA ) )
                  and ( :P526_IDREGIAOVENDA is null or n.idregiaovenda = :P526_IDREGIAOVENDA )
                  and :P526_TIPORELATORIO = 'R'
                  and :P526_TIPO_DEBITO = 'G'  
                group by n.idrepresentante
                order by 1 
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P526_TIPORELATORIO = 'R'
                  and :P526_TIPO_DEBITO = 'G'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1560994484599981337
        }

