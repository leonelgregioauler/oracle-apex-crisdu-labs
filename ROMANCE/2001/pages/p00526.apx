    region débitos-pagos (
        name: Débitos Pagos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(n.idvendedora) consultora 
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) representante
                     , p.datapagamento
                     , p.valorpago
                     , p.semanacobranca
                     , n.numeronota     
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||p.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' url
                from pagamentosnotasvendas p
                   , notasvendas n 
                where ( :P526_TIPO_SEMANA is null
                     or ( :P526_TIPO_SEMANA = 'P' and p.idsemanacobranca between :P526_IDSEMANAINICIO and :P526_IDSEMANAFIM )
                     or ( :P526_TIPO_SEMANA = 'S' and p.idsemanacobranca = :P526_IDSEMANA ) )
                  and p.idnotavenda    = n.idnotavenda
                  and n.idsemanacobranca != p.idsemanacobranca
                  and p.origem = 'R'
                  and n.idfilial = :P0_IDFILIAL
                  and ( :P526_IDREGIAOVENDA is null or n.idregiaovenda = :P526_IDREGIAOVENDA )
                  and ( :P526_IDREPRESENTANTE is null or n.idrepresentante = :P526_IDREPRESENTANTE )
                  and :P526_TIPORELATORIO = 'D'         
                  and :P526_TIPO_DEBITO = 'P'     
                order by 1    
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
