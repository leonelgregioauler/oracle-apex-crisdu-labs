    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconRight
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-semana (
        name: Tipo Semana
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P526_TIPO_SEMANA
        }
        clientSideCondition {
            type: item=value
            item: P526_TIPO_SEMANA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P526_IDSEMANA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P526_IDSEMANAINICIO
                    P526_IDSEMANAFIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P526_IDSEMANA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P526_IDSEMANAINICIO
                    P526_IDSEMANAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 526
                items: {
                    P526_IDREPRESENTANTE: &P526_IDREPRESENTANTE.
                    P526_IDREGIAOVENDA: &P526_IDREGIAOVENDA.
                    P526_TIPO_SEMANA: &P526_TIPO_SEMANA.
                    P526_IDSEMANA: &P526_IDSEMANA.
                    P526_IDSEMANAINICIO: &P526_IDSEMANAINICIO.
                    P526_IDSEMANAFIM: &P526_IDSEMANAFIM.
                    P526_TIPO_DEBITO: &P526_TIPO_DEBITO.
                    P526_TIPORELATORIO: &P526_TIPORELATORIO.
                }
                action: resetPagination
            }
        }
    )

)

