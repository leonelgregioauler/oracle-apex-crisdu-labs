    pageItem P526_IDREGIAOVENDA (
        type: selectList
        label {
            label: Região de Venda
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(r.idregiaovenda) d
                     , r.idregiaovenda r
                from regioesrepresentantes r
                where r.idrepresentante = :P526_IDREPRESENTANTE
                order by r.idsemana 
                ```
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: P526_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P526_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)display_value
                     , rr.idrepresentante return_value
                from pessoas p
                   , representantes rr
                where rr.idpessoa = p.idpessoa
                  and rr.ativo = 'S'
                  and rr.idgerente = ( select idgerente
                                       from gerentes g
                                       where idfilial = :P0_IDFILIAL)
                order by 1
                ```
            nullDisplayValue: - Selecionar Todos -
        }
        cascadingLov {
            parentItems: P0_IDFILIAL
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P526_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00')||'/'||ano) display_value
                     , idsemana RETURN_VALUE
                from semana_dias
                where idsemana >=600
                order by idsemana desc
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 40
            region: @filtros
