                ```sql
                select 1
                from dual
                where :P526_TIPORELATORIO = 'D'
                  and :P526_TIPO_DEBITO = 'P'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5864095449895848
        }

