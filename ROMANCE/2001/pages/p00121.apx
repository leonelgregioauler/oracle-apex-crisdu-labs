    process fetch-row-from-mei (
        name: Fetch Row from MEI
        type: autoRowFetch
        source {
            tableName: MEI
            pkColumn: IDMEI
            pkItem: P121_IDMEI
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 172720077656231478
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P121_IDMEI is null then
                        select "SEQ_IDMEI".nextval
                          into :P121_IDMEI
                          from dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 172720264656231482
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process nomecampo (
        name: NomeCampo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  v_idpais number;
                begin
                  --
                  select ididioma
                    into v_idpais
                    from vw_filiais f
                   where f.idfilial = :P0_IDFILIAL;
                
                  if v_idpais = 6 then
                    :P121_CAMPO := 'RUT';
                  else
                    :P121_CAMPO := 'CNPJ';
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1334340874927544815
        }
    )

    process process-row-of-mei (
        name: Process Row of MEI
        type: autoRowProcessing
        target {
            tableName: MEI
            pkColumn: IDMEI
            pkItem: P121_IDMEI
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada!
        }
        error {
            errorMessage: Ocorreu erro no processamento. Informe a T.I
        }
        advanced {
            executionMappingIdentifier: 172720468054231483
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 172720665741231483
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: Go To Page 121
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 121
            }
        }
        serverSideCondition {
            type: never
        }
    )

)

