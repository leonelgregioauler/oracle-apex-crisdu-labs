page 121 (
    name: Cadastro de MEI
    title: Cadastro de MEI
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function formatar_mascara(src, mascara, evt) {
              var tecla;  
              if (evt.which) {
                tecla = evt.which;
              } else if (evt.keyCode) {
                tecla = evt.keyCode;
              }
            
              // só aplica se tiver máscara definida (ex: "99.999.999/9999-99")
              if (!mascara) {
                return;
              }
            
              // aqui você pode decidir aplicar só se a máscara for de CNPJ
              // ex.: se começar com "99." (ou qualquer outro critério que você use)
              if (mascara !== "99.999.999/9999-99" && mascara !== "##.###.###/####-##") {
                return; // sai sem aplicar
              }
            
              if (tecla !== 8) { // não aplica no backspace
                var campo = src.value.length;
                var saida = mascara.substring(0, 1);
                var texto = mascara.substring(campo);
                if (texto.substring(0, 1) !== saida) {
                  src.value += texto.substring(0, 1);
                }
              }
            }
            
            
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-mei (
        name: Cadastro de MEI
        type: staticContent
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
    )

    pageItem P121_ATIVO (
        type: radioGroup
        label {
            label: Ativo
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 110
            region: @cadastro-de-mei
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: ATIVO
            used: always
        }
        default {
            type: static
            staticValue: S
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

