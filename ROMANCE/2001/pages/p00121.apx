        }
        serverSideCondition {
            type: itemIsNotNull
            item: P121_IDMEI
        }
    )

    dynamicAction mostracep (
        name: MostraCEP
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P121_CAMPO
        }
        clientSideCondition {
            type: item=value
            item: P121_CAMPO
            value: CNPJ
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P121_CEP
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction ocultacep (
        name: OcultaCEP
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P121_CAMPO
        }
        clientSideCondition {
            type: item=value
            item: P121_CAMPO
            value: RUT
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P121_CEP
            }
            execution {
                sequence: 10
            }
        )

    )

