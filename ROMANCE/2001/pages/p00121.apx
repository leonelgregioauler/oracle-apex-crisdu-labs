        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where :P121_CEP IS NULL
                   and :P121_CAMPO = 'CNPJ'
                ```
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P121_CEP
        }
    )

    validation p121-cnpj (
        name: P121_CNPJ
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_cnpj   VARCHAR2(14);
                    v_soma   NUMBER;
                    v_resto  NUMBER;
                    v_dig1   NUMBER;
                    v_dig2   NUMBER;
                BEGIN
                    -- Remove máscara
                    --v_cnpj := REGEXP_REPLACE(:P121_CNPJ, '[^0-9]', '');
                    v_cnpj := REPLACE(REPLACE(REPLACE(:P121_CNPJ,'.',''),'/',''),'-','');
                    --
                    if catal.pck_util.validacnpj(v_cnpj) then
                       RETURN NULL;
                    else
                       RETURN 'CNPJ inválido';
                    end if;
                
                    -- Deve ter 14 dígitos
                    /*IF LENGTH(v_cnpj) <> 14 THEN
                       RETURN 'CNPJ inválido';
                    END IF;
                
                    -- Bloqueia sequências repetidas
                    --IF REGEXP_LIKE(v_cnpj, '^(\d)\1{13}$') THEN
                    IF REGEXP_LIKE(v_cnpj, '^(.)\1{13}$') THEN
                       RETURN 'CNPJ inválido';
                    END IF;
                
                    -- 1º dígito
                
                    v_soma :=
                          SUBSTR(v_cnpj, 1, 1)  * 5
                        + SUBSTR(v_cnpj, 2, 1)  * 4
                        + SUBSTR(v_cnpj, 3, 1)  * 3
                        + SUBSTR(v_cnpj, 4, 1)  * 2
                        + SUBSTR(v_cnpj, 5, 1)  * 9
                        + SUBSTR(v_cnpj, 6, 1)  * 8
                        + SUBSTR(v_cnpj, 7, 1)  * 7
                        + SUBSTR(v_cnpj, 8, 1)  * 6
                        + SUBSTR(v_cnpj, 9, 1)  * 5
                        + SUBSTR(v_cnpj,10, 1)  * 4
                        + SUBSTR(v_cnpj,11, 1)  * 3
                        + SUBSTR(v_cnpj,12, 1)  * 2;
                
                    v_resto := MOD(v_soma, 11);
                    v_dig1  := CASE WHEN v_resto < 2 THEN 0 ELSE 11 - v_resto END;
                
                    IF v_dig1 <> TO_NUMBER(SUBSTR(v_cnpj, 13, 1)) THEN
                        RETURN 'CNPJ inválido';
                    END IF;
                
                    -- 2º dígito
                
                    v_soma :=
                          SUBSTR(v_cnpj, 1, 1)  * 6
                        + SUBSTR(v_cnpj, 2, 1)  * 5
                        + SUBSTR(v_cnpj, 3, 1)  * 4
                        + SUBSTR(v_cnpj, 4, 1)  * 3
                        + SUBSTR(v_cnpj, 5, 1)  * 2
                        + SUBSTR(v_cnpj, 6, 1)  * 9
                        + SUBSTR(v_cnpj, 7, 1)  * 8
                        + SUBSTR(v_cnpj, 8, 1)  * 7
                        + SUBSTR(v_cnpj, 9, 1)  * 6
                        + SUBSTR(v_cnpj,10, 1)  * 5
                        + SUBSTR(v_cnpj,11, 1)  * 4
                        + SUBSTR(v_cnpj,12, 1)  * 3
                        + SUBSTR(v_cnpj,13, 1)  * 2;
                
                    v_resto := MOD(v_soma, 11);
                    v_dig2  := CASE WHEN v_resto < 2 THEN 0 ELSE 11 - v_resto END;
                
                    IF v_dig2 <> TO_NUMBER(SUBSTR(v_cnpj, 14, 1)) THEN
                        RETURN 'CNPJ inválido';
                    END IF; */
                
                    -- Se chegou aqui, está válido
                    --RETURN NULL;
                END;
                ```
        }
        error {
            associatedItem: @P121_CNPJ
        }
        serverSideCondition {
            type: item!=value
            item: P121_CAMPO
            value: RUT
        }
    )

