    pageItem P121_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecidade||' - '||e.sigla display_value
                     , c.idcidade  return_value
                from cidades c
                   , estados e
                where c.idestado = e.idestado
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @cadastro-de-mei
            slot: regionBody
