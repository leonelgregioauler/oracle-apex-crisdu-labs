page 390 (
    name: Mercadorias na Rua
    title: Mercadorias na Rua
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region mercadorias-na-rua (
        name: Mercadorias na Rua
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ first_rows (30) */( select initcap(c.nome)
                         from categorias c
                         where c.idcategoria = p.idcategoria ) categoria
                     , p.codigosisdist referencia
                     , initcap(p.nomeproduto) produto
                     , p.idproduto id
                     , e.vlrvenda valorvenda
                     , decode(e.comissao,'S','Com Comissão','N','Sem Comissão') comissao
                     , case
                         when not exists ( select 1
                                           from fotosprodutos ft
                                           where ft.idproduto = p.idproduto
                                             and ft.ativo = 'S' ) then
                           'Não possui Foto'
                         else
                           'Possui Foto'
                       end foto
                     , pck_estoque.fnc_esttotalDISPfilial(e.idestoquefilial) totaldisponivel
                     , nvl(( select sum(quantidade) 
                             from itensnotavenda it
                             where it.idestoquefil = e.idestoquefilial
                               and exists ( select 1
                                            from notasvendas n
                                            where n.idnotavenda = it.idnotavenda
                                              and n.idsituacaonotavenda = 3 
                                              and n.idfilial = :P0_IDFILIAL ) ),0) totalnarua
                from produtos p
                   , estoquefilial e
                where e.idproduto     = p.idproduto
                  and e.idfilial      = :P0_IDFILIAL
                  and exists ( select 1 
                               from itensnotavenda it
                               where it.idestoquefil = e.idestoquefilial
                                 and exists ( select 1
                                              from notasvendas n
                                              where n.idnotavenda = it.idnotavenda
                                                and n.idsituacaonotavenda = 3 
                                                and n.idfilial = :P0_IDFILIAL ) )
                order by 3
                      
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        advanced {
            savedReportMappingIdentifier: 814929525004325507
        }

