page 771 (
    name: Acessos Infoboard
    alias: ACESSOS-INFOBOARD
    title: Acessos Infoboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region acessos-cadastrados (
        name: Acessos Cadastrados
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
    )

    region acessos-infoboard (
        name: Acessos Infoboard
        type: form
        source {
            location: localDatabase
            tableName: ACESSOSINFOBOARD
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region registros (
        name: Registros
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDACESSOINFOBOARD,
                       NOMEPERFIL,
                       favorita.pck_util_fav.fnc_nomeusuario (IDUSUARIO) usuario,
                       (select nomeinfoboard
                          from modulosinfoboard
                         where idmodinfoboard = (select idmodinfoboard
                                                   from perfisinfoboard
                                                  where idperfilinfoboard = a.idperfilinfoboard)) "Modulo"
                  from ACESSOSINFOBOARD A
                     , PERFISINFOBOARD  P
                 where P.IDPERFILINFOBOARD = A.IDPERFILINFOBOARD
                ```
        }
        layout {
            sequence: 20
            parentRegion: @acessos-cadastrados
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }

        column IDACESSOINFOBOARD (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column Modulo (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Modulo
            }
            layout {
                sequence: 40
            }
        )

        column NOMEPERFIL (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Nome do Perfil
            }
            layout {
                sequence: 20
            }
        )

        column USUARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Usuario
            }
            layout {
                sequence: 30
            }
        )

    )

    pageItem P771_IDACESSO (
        type: selectList
        label {
            label: "Informe o Acesso "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select NOMEPERFIL || '  -  ' || favorita.pck_util_fav.fnc_nomeusuario (IDUSUARIO) D,
                       IDACESSOINFOBOARD R
                  from ACESSOSINFOBOARD A
                     , PERFISINFOBOARD  P
                 where P.IDPERFILINFOBOARD = A.IDPERFILINFOBOARD
                 ORDER BY 2
                ```
        }
        layout {
            sequence: 20
            region: @acessos-infoboard
            slot: regionBody
            alignment: left
            columnSpan: 4
            columnAttributes: [
                Style="font-weight:
                bold;"
            ]
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: expression
            plsqlExpression: NULL
        }
    )

    pageItem P771_IDACESSOINFOBOARD (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @acessos-infoboard
            slot: regionBody
        }
        source {
            formRegion: @acessos-infoboard
            column: IDACESSOINFOBOARD
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: SEQ_IDACESSOINFOBOARD
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P771_IDMODINFOBOARD (
        type: selectList
        label {
            label: Módulo Infoboard
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomeinfoboard d
                     , idmodinfoboard r 
                  from modulosinfoboard
                  order by 1
                ```
        }
        layout {
            sequence: 30
            region: @acessos-infoboard
            slot: regionBody
            alignment: left
            columnSpan: 4
            columnAttributes: [
                Style="font-weight:
                bold;"
            ]
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P771_IDPERFILINFOBOARD (
        type: selectList
        label {
            label: Perfil Infoboard
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomeperfil d 
                     , idperfilinfoboard r
                  from perfisinfoboard
                 where (:P771_IDMODINFOBOARD is null or idmodinfoboard = :P771_IDMODINFOBOARD)
                 order by 1
                ```
        }
        layout {
            sequence: 40
            region: @acessos-infoboard
            slot: regionBody
            alignment: left
            columnSpan: 4
            columnAttributes: [
                Style="font-weight:
                bold;"
            ]
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @acessos-infoboard
            column: IDPERFILINFOBOARD
            dataType: number
        }
    )

    pageItem P771_IDUSUARIO (
        type: selectList
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT INITCAP(P.NOMEPESSOA) D
                     , U.IDUSUARIO R
                  FROM USUARIOS U
                     , PESSOAS  P
                 WHERE U.IDPESSOA = P.IDPESSOA
                   AND U.ATIVO = 'S'
                 ORDER BY 1
                ```
        }
        layout {
            sequence: 50
            region: @acessos-infoboard
            slot: regionBody
            alignment: left
            columnSpan: 4
            columnAttributes: [
                Style="font-weight:
                bold;
                "
            ]
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @acessos-infoboard
            column: IDUSUARIO
            dataType: number
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir Acesso
        layout {
            sequence: 50
            region: @acessos-infoboard
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P771_IDACESSOINFOBOARD
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir Acesso
        layout {
            sequence: 40
            region: @acessos-infoboard
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-times-square
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @acessos-infoboard
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: never
        }
    )

    dynamicAction mostraexcluir (
        name: MostraExcluir
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P771_IDACESSOINFOBOARD
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P771_IDACESSOINFOBOARD
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @create
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P771_IDACESSO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P771_IDACESSOINFOBOARD
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select idacessoinfoboard
                         , idperfilinfoboard
                         , idusuario 
                         , (select idmodinfoboard
                              from modulosinfoboard
                             where idmodinfoboard = (select idmodinfoboard
                                                       from perfisinfoboard
                                                      where idperfilinfoboard = a.idperfilinfoboard)) modulo
                     -- into :P771_IDPERFILINFOBOARD
                     --    , :P771_IDUSUARIO
                     --    , :P771_IDACESSOINFOBOARD
                      from acessosinfoboard a
                     where idacessoinfoboard = :P771_IDACESSO
                    ```
                itemsToSubmit: P771_IDACESSO
            }
            affectedElements {
                selectionType: items
                items: [
                    P771_IDACESSOINFOBOARD
                    P771_IDPERFILINFOBOARD
                    P771_IDUSUARIO
                    P771_IDMODINFOBOARD
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction ocultaexcluir (
        name: OcultaExcluir
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P771_IDACESSOINFOBOARD
        }
        clientSideCondition {
            type: itemIsNull
            item: P771_IDACESSOINFOBOARD
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: button
                button: @create
            }
            execution {
                sequence: 20
            }
        )

    )

    process initialize-form-acessos-infoboard (
        name: Initialize form Acessos Infoboard
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vmd5 varchar2(4000);
                begin
                  
                  pck_infoboard.prc_acessosinfoboard(:P771_IDACESSOINFOBOARD,
                                                     :P771_IDUSUARIO,
                                                     :P771_IDPERFILINFOBOARD,
                                                     vmd5,
                                                     'S');
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 377460843139920016
        }
    )

    process process-form-acessos-infoboard (
        name: Process form Acessos Infoboard
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  v_dml varchar2(1);
                  v_md5 varchar2(4000);
                  --
                begin
                  --
                  --
                  if v('REQUEST') = 'CREATE' then
                    v_dml := 'I';
                  elsif  v('REQUEST') = 'SAVE' then
                    v_dml := 'U';
                  else
                    v_dml := 'D';
                  end if;
                  --
                 -- raise_application_error(-20001, v_dml );
                
                  pck_infoboard.prc_acessosinfoboard(:P771_IDACESSOINFOBOARD,
                                                     :P771_IDUSUARIO,
                                                     :P771_IDPERFILINFOBOARD,
                                                     v_md5,
                                                     v_dml);
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: AÇÃO PROCESSADA COM SUCESSO!
        }
        advanced {
            executionMappingIdentifier: 377461270229920017
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE, SAVE, DELETE
        }
    )

    branch (
        name: Go To Page 773
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 771
                clearCache: 771
            }
        }
    )

)

