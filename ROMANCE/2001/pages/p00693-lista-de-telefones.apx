page 693 (
    name: Lista de telefones
    alias: LISTA-DE-TELEFONES
    title: Lista de telefones
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }

    region lista-de-telefones (
        name: Lista de Telefones
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '(' || substr(t.telefonelimpo, 1, 2) || ') ' ||
                              substr(t.telefonelimpo, 3, 1) || ' ' ||
                              substr(t.telefonelimpo, 4, 4) || '-' ||
                              substr(t.telefonelimpo, 8, 4)             as "Telefone Formatado"
                     , t.telefonelimpo                                  as "Telefone Limpo"
                     , nvl(o.nome,'Não informado')                      as "Operadora"
                  from catal.telefonespessoas t
                     , catal.operadorastelefonia o
                 where o.idoperadoratel(+) = t.idoperadoratel
                   and t.idpessoa = (select v.idpessoa
                                        from catal.vendedoras v
                                       where v.idvendedora = :P693_IDVENDEDORA)
                 order by t.idtelefonepessoa;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1320533892168278819
        }

        column Operadora (
            type: plainText
            heading {
                heading: Operadora
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column "Telefone Formatado" (
            type: plainText
            heading {
                heading: Telefone Formatado
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column "Telefone Limpo" (
            type: plainText
            heading {
                heading: Telefone Limpo
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        savedReport 13206463 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Operadora" (
                sequence: 3
            )

            displayColumn "Telefone Formatado" (
                sequence: 1
            )

            displayColumn "Telefone Limpo" (
                sequence: 2
            )

        )

    )

    pageItem P693_IDVENDEDORA (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

)

