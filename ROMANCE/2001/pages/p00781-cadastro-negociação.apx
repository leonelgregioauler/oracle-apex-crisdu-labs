page 781 (
    name: Cadastro Negociação
    alias: CADASTRO-NEGOCIAÇÃO
    title: Cadastro Negociação
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 800
        height: 500
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_quitar(pid)
            {
              document.getElementById("P562_IDEDITAR").value = pid;
              apex.submit('QUITAR');
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region negociação (
        name: "Negociação "
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    pageItem P781_FORMAPAGAMENTO (
        type: selectOne
        label {
            label: Forma de Pagto
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.descricao
                     , f.idformapagamento
                  from roman.formaspagamentosnegociacoes F
                 where f.idformapagamento in ('C','P');
                ```
        }
        layout {
            sequence: 30
            region: @negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: C
        }
    )

    pageItem P781_IDVENDEDORA (
        type: popupLov
        label {
            label: Pessoa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(v.idvendedora)||' (CPF: '||roman.pck_romance.fnc_cpfvendedora(v.idvendedora)||' / Doc: '||p.documentoestrangeiro||')' consultora
                     , v.idvendedora
                  from catal.vendedoras v
                     , catal.pessoas p
                 where p.idpessoa = v.idpessoa
                   and v.ativo = 'S'
                   
                  /*select pck_romance.fnc_nomevendedora(v.idvendedora)||' (CPF: '||roman.pck_romance.fnc_cpfvendedora(v.idvendedora)||')' consultora
                     , v.idvendedora
                  from catal.vendedoras v
                 where v.ativo = 'S'*/
                ```
        }
        layout {
            sequence: 20
            region: @negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P781_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 50
            region: @negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
    )

    pageItem P781_ORIGEM (
        type: selectList
        label {
            label: Origem
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT O.DESCRICAO
                      ,O.ORIGEMCOBRANCA
                  FROM ROMAN.ORIGENSCOBRANCA O
                     , ROMAN.FILIAISORIGCOB T
                     , CATAL.USUARIOS U
                     , CATAL.GERENTES G
                 WHERE O.ORIGEMCOBRANCA = T.ORIGEMCOBRANCA
                   AND T.IDFILIAL = G.IDFILIAL
                   AND G.IDGERENTE = U.IDGERENTE
                   AND U.USUARIO = V('APP_USER');
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P781_QTDPARCELAS (
        type: selectList
        label {
            label: Parcelas
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    1 || 'x de R$ ' || TO_CHAR(ROUND(nvl(TO_NUMBER(nvl(:P781_VALORNEGOCIACAO,0)),0) /  1, 2), 'FM999G990D00') AS display_value,
                    1 AS return_value
                FROM dual;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P781_VALORNEGOCIACAO
        }
        layout {
            sequence: 60
            region: @negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: 1
        }
    )

    pageItem P781_VALORNEGOCIACAO (
        type: numberField
        label {
            label: Valor
            alignment: left
        }
        layout {
            sequence: 40
            region: @negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: 0
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @negociação
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 10
            region: @negociação
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction esconde-parcelas (
        name: Esconde Parcelas
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P781_FORMAPAGAMENTO
        }
        clientSideCondition {
            type: item=value
            item: P781_FORMAPAGAMENTO
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P781_QTDPARCELAS
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction fechat-tela (
        name: Fechat Tela
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction mostra-parcelas (
        name: Mostra Parcelas
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P781_FORMAPAGAMENTO
        }
        clientSideCondition {
            type: item=value
            item: P781_FORMAPAGAMENTO
            value: C
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P781_QTDPARCELAS
            }
            execution {
                sequence: 10
            }
        )

    )

    process cria-negociacao (
        name: Cria Negociacao
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidnegociacaoparceiro roman.negociacoesparceiros.idnegociacaoparceiro%type;
                  vidvendedora          roman.negociacoesparceiros.idvendedora%type := :P781_IDVENDEDORA;
                  vvalortotal           roman.negociacoesparceiros.valornegociacao%type := to_number(:P781_VALORNEGOCIACAO);
                  vvalordesconto        roman.negociacoesparceiros.valordesconto%type := 0;
                  vformapagamento       roman.negociacoesparceiros.formapagamento%type := :P781_FORMAPAGAMENTO;
                  vvalorentrada         roman.pagamentosnegociacoesparceiros.valorparcela%type := 0;
                  vvencimentoentrada    roman.pagamentosnegociacoesparceiros.datavencimento%type := SYSDATE + 30;
                  vparcelas             roman.negociacoesparceiros.qtdparcelas%type := 1;--:P781_QTDPARCELAS; -- PRIMEIRO MONENTO SERA LIBERADO APENAS UMA PARCELA
                  vvalorparcela         roman.pagamentosnegociacoesparceiros.valorparcela%type := vvalortotal;
                  vidusuario            roman.negociacoesparceiros.idusuarioresponsavel%type := favorita.pck_util_fav.fnc_retornaidusuario(v('APP_USER'));
                  vvencimento           roman.pagamentosnegociacoesparceiros.datavencimento%type := SYSDATE + 30;
                  vobservacao           roman.negociacoesparceiros.observacao%type := :P781_OBSERVACAO;
                  vidtarefa             roman.negociacoesparceiros.idtarefa%type;
                  vorigemcobranca       roman.negociacoesparceiros.origem%type := :P781_ORIGEM;
                  --
                begin
                  --
                  if v('REQUEST') = 'CREATE' then
                    --
                    if vvalortotal = 0 or vvalortotal < 0 then
                      --
                      RAISE_APPLICATION_ERROR(-20001,'Informe um valor válido');
                      --
                    end if;
                    --
                    roman.pck_negociacoes_servicos.prc_negociacoes_servicos(pidnegociacaoparceiro => vidnegociacaoparceiro,
                                                                            pidvendedora          => vidvendedora,
                                                                            pvalortotal           => vvalortotal,
                                                                            pvalordesconto        => vvalordesconto,
                                                                            pformapagamento       => vformapagamento,
                                                                            pvalorentrada         => vvalorentrada,
                                                                            pvencimentoentrada    => vvencimentoentrada,
                                                                            pparcelas             => vparcelas,
                                                                            pvalorparcela         => vvalorparcela,
                                                                            pidusuario            => vidusuario,
                                                                            pvencimento           => vvencimento,
                                                                            pobservacao           => vobservacao,
                                                                            pidtarefa             => vidtarefa,
                                                                            porigemcobranca       => vorigemcobranca);
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro criado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 380870494126494625
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch (
        name: Go to Page 779
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 779
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: v('REQUEST') = 'CREATE'
        }
    )

)

