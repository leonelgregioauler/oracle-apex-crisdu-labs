    pageItem P602_IDFILIAL (
        type: selectList
        label {
            label: <b>Filial</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and exists ( select 1
                               from parametrosrepresentantes pr
                               where pr.parametro = 'UTILIZAASSINATURAELETRONICA'
                                 and pr.valor     = 'Z'
                                 and pck_romance.fnc_filialrepresentante(pr.idrepresentante) = f.idfilial )
                  and ( pck_util.fnc_verificaacesso(2844,v('APP_USER')) = 'S'
                     or v('APP_USER') = 'LUCASRAMOS' )
                
                union
                -- Maicon Aimi - 8773203 - 29/08/2024 inclusão das filiais (1275 e 1246 Brasilia)
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.idfilial in  (1275,1246)
                  and ( pck_util.fnc_verificaacesso(2844,v('APP_USER')) = 'S'
                     or v('APP_USER') = 'LUCASRAMOS' )
                
                union
                
                select (select initcap(nvl(apelido,nomepessoa))
                        from pessoas 
                        where idpessoa = f.idpessoa )|| CASE when v('APP_USER') in ('EVERTON','GUILHERME','LUIZV','FERNANDO','LUCASRAMOS') then
                                                                    ' - '||f.idfilial
                                                                    end display_value
                     , f.idfilial
                from filiais f
                where idfilial = pck_romance.fnc_filialusuario(v('APP_USER'))
                  and pck_util.fnc_verificaacesso(2844,v('APP_USER')) = 'N'
                  and v('APP_USER') != 'MYCON'
                union
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.idfilial in (100,1071,1082)
                  and v('APP_USER') = 'MYCON'
                union
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.idfilial in  (1089,1090,1106,1132,124,122,320,221) 
                  and v('APP_USER') in ('RENATAF','RAFAELK')
                
                union
                
                select '- Todas -'
                     , -1
                from dual
                where roman.pck_util.fnc_verificaacesso(2844,v('APP_USER')) = 'S'
                
                union 
                
                -- Maicon Aimi - 10050006 - 25/03/2025 -- Traz as filiais do usuário
                select f.nome
                     , f.idfilial
                  from roman.vw_filiais f
                 where f.idfilial in ( select uf.idfilial
                                          from roman.usuariosfiliais uf
                                         where uf.usuario = v('APP_USER'))
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P602_IDREPRESENTANTE (
        type: selectList
        label {
            label: <b>Distribuidor</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) d
                     , idrepresentante r
                  from representantes r
                 where r.ativo = 'S'
                   and (:P602_IDFILIAL = -1 or r.idgerente = ( select idgerente
                                                                   from gerentes g
                                                                  where g.idfilial = :P602_IDFILIAL))
                 order by 1
                ```
        }
        cascadingLov {
            parentItems: P602_IDFILIAL
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

