    process informa-valores (
        name: Informa Valores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                  --
                  if :P602_DATAINICIO is null then
                    --
                    select trunc(SYSDATE,'MM')
                    into :P602_DATAINICIO
                    from dual;
                    --
                  end if;
                  --
                  if :P602_DATAFIM is null then
                    --
                    select trunc(sysdate) 
                    into :P602_DATAFIM
                    from dual;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1039157192481794663
        }
    )

    branch (
        name: Go To Page 602
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 602
                items: {
                    P602_IDREPRESENTANTE: &P602_IDREPRESENTANTE.
                    P602_SITUACAO: &P602_SITUACAO.
                    P602_DATAINICIO: &P602_DATAINICIO.
                    P602_DATAFIM: &P602_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

