page 602 (
    name: Assinaturas Eletrônicas
    title: Assinaturas Eletrônicas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function aprovaassinatura(pid){ 
            
              document.getElementById('P573_ID').value = pid;
                
              var answer = confirm("Aprova a Assinatura Eletronica?")
              if (answer)
                {
                  apex.submit('APROVA_ASSINATURA');
                }
            }
            
            function reprovaassinatura(pid){ 
            
              document.getElementById('P573_ID').value = pid;
              openModal('REPROVAR');
              
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region assinaturas-realizadas (
        name: Assinaturas Realizadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                       select a.datarealizada dataclassificado
                     , a.vendedora nomepessoa
                     , a.cpf
                     , a.representante
                     , a.link
                     , case
                         when a.situacao = 'A' then
                           '<font color="green"><b>Aprovada!</b></font>'
                         else
                           '-'
                       end aprovarassinatura
                     , case
                         when a.situacao = 'R' then
                           '<font color="red"><b>Reprovada</b></font>'||' - '||nvl(a.motivoreprovacao,'Motivo não informado')
                         else
                           '-'
                       end reprovarassinatura
                     , identificacao
                     , a.desctiponota tipo
                     , decode (a.tipoassinatura, 'P', 'Titular', 'T', 'Terceiro') Tipo_de_Assinatura
                     , case
                       when (select count(1)
                               from roman.notasvendas nv
                              where a.idvendedora = nv.idvendedora) = '1' then 'Sim'
                        else 'Não'
                       end Abertura
                     , a.telefone
                     , nv.numeronota
                     , nv.semanadistribuicao 
                     , case 
                        when nv.idsituacaonotavenda = '4' and nv.saldo > 0 then 'Débito'
                        when nv.idsituacaonotavenda = '3' then 'Aguardando Acerto'
                        when nv.idsituacaonotavenda = '5' then 'Cancelada'
                        when nv.saldo <= 0 then 'Quitada'        
                        else '-'
                       end situacao_nota
                     , nv.valortotalnota
                     , nv.valortotalvenda
                     , nv.valorpago
                     , nv.saldo
                     -- Maicon Aimi - 10122034 - 18/07/2025
                     , a.nome_terceiro
                     , favorita.pck_util_fav.fnc_nomefilialromance(a.idfilial) FRANQUIA
                     -- Maicon Aimi - 10620793 - 02/10/2025
                     , ( select initcap(p.nomepessoa)
                           from catal.usuarios u
                              , catal.pessoas p
                          where p.idpessoa = u.idpessoa
                            and u.idusuario = a.idusuarioavaliacao ) analisado_por
                from vw_assinaturas_eletronicas a
                   , notasvendas nv
                where a.idnotavenda = nv.idnotavenda 
                  and a.datarealizada between to_date(:P602_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P602_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and ( :P602_IDFILIAL = -1 or a.idfilial = :P602_IDFILIAL)
                  and ( :P602_IDREPRESENTANTE is null or a.idrepresentante = :P602_IDREPRESENTANTE )
                  and ( :P602_SITUACAO = 'X'
                     or ( :P602_SITUACAO = 'A' and a.situacao = 'A' )
                     or ( :P602_SITUACAO = 'R' and a.situacao = 'R' )
                     or ( :P602_SITUACAO = 'S' and a.situacao = 'R' and not exists (select 1
                                                                                      from roman.assinaturaseletronicas aa
                                                                                     where aa.idnotavenda = a.idnotavenda  
                                                                                       and aa.idassinaturaeletronica > a.idassinaturaeletronica
                                                                                       and aa.status = 'C'
                                                                                       and aa.situacao = 'A' )))
                  and a.situacao != 'P'
                order by a.datarealizada desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma assinatura encontrada!
        }
        advanced {
            savedReportMappingIdentifier: 6721182937142707862
        }

