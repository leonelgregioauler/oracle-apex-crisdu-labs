    region pessoas-envolvidas (
        name: Pessoas Envolvidas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.idusuarioSCHAMADO
                     , u.IDCHAMADO
                     , pck_romance.fnc_nomeusuario(u.usuario) usuario
                     , ( select email 
                         from pessoas
                         where idpessoa = ( select idpessoa
                                            from usuarios
                                            where usuario = u.usuario ) ) email
                from usuarioschamados u
                where u.idchamado = :P111_IDCHAMADO 
                order by usuario
                ```
        }
        layout {
            sequence: 30
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
