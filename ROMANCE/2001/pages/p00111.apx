    process envia-email (
        name: envia email
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  catal.pck_util.prc_enviaemail(ppara => :P111_EMAIL,
                                                passunto => '[Informativo] Evento '||:P111_IDCHAMADO ||' respondido.',
                                                ptexto => 'Olá!'||chr(10)||chr(10)||
                                                          'O evento nrº '||:P111_IDCHAMADO||' foi respondido!'||chr(10)||chr(10)||
                                                          'Atenciosamente,'||chr(10)||        
                                                          'TI - Romance Moda' );
                
                  for i in ( select ( select email 
                             from pessoas
                             where idpessoa = ( select idpessoa
                                                from usuarios
                                                where usuario = u.usuario ) ) email
                             from usuarioschamados u
                             where u.idchamado= :P111_IDCHAMADO )
                  loop
                    catal.pck_util.prc_enviaemail(ppara => i.EMAIL,
                                                  passunto => '[Informativo] Chamado '||:P111_IDCHAMADO ||' respondido.',
                                                  ptexto => 'Olá!'||chr(10)||chr(10)||
                                                            'O evento nrº '||:P111_IDCHAMADO||' foi respondido!'||chr(10)||chr(10)||
                                                            'Você está recebendo este email por estar vinculado a este evento.'||chr(10)||chr(10)||
                                                            'Atenciosamente,'||chr(10)||        
                                                            'TI - Romance Moda' );
                
                  end loop;
                end;
                ```
        }
        execution {
            sequence: 190
        }
        successMessage {
            successMessage: Email enviado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 31239767645393316
        }
        serverSideCondition {
            type: request=Value
            value: ENVIAEMAIL
        }
    )

