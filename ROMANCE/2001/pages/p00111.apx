    process reabrir-evento (
        name: Reabrir Evento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update chamados c
                  set c.idsituacao = 0
                    , DATAATENDIDO = null
                  where c.idchamado = :P111_IDCHAMADO;
                  --
                  catal.pck_util.prc_enviaemail(ppara => 'ti@romancemoda.com.br',
                                                pcopia => :P111_EMAIL,
                                                passunto => '[Informativo] Evento '||:P111_IDCHAMADO ||' reaberto.',
                                                ptexto => 'Olá!'||chr(10)||chr(10)||
                                                          'O evento nrº '||:P111_IDCHAMADO||' foi reaberto!'||chr(10)||chr(10)||
                                                          'Atenciosamente,'||chr(10)||        
                                                          'TI - Romance Moda' );
                
                end;
                ```
        }
        execution {
            sequence: 150
        }
        advanced {
            executionMappingIdentifier: 31238589241393314
        }
        serverSideCondition {
            whenButtonPressed: @reabrir
        }
    )

