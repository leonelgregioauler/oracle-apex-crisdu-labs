    region anexos (
        name: Anexos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDANEXOEVENTO
                     , IDCHAMADO
                     , ATTACH_MIMETYPE TipoArquivo
                     , ATTACH_FILENAME NomeDoArquivo
                     , ATTACH_LAST_UPDATE DataDoUpload
                     , ATTACH_CHARSET
                     , round(sys.dbms_lob.getlength(ATTACH_DATA)/1024,2)||' kb' file_length
                     , sys.dbms_lob.getlength(ATTACH_DATA) download
                  from ANEXOSEVENTOS
                where idchamado = :P111_IDCHAMADO
                and publico = 'S'
                ```
        }
        layout {
            sequence: 50
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P111_IDCHAMADO
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
