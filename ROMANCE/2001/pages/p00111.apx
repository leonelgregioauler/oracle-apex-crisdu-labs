    region históricos (
        name: Históricos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idhistoricochamado
                     , idchamado
                     , datahistorico
                     , descricao
                     , usuario
                     , pck_romance.fnc_emailusuario(pusuario => trim(upper(:P111_USUARIO))) email
                     , DATAFIM 
                from historicochamados
                where idchamado = :P111_idchamado
                  and publico = 'S'
                order by idhistoricochamado
                ```
        }
        layout {
            sequence: 40
            slot: body-3
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
