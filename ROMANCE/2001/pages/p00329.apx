    region lista-de-notas-para-acertar (
        name: Lista de Notas para Acertar
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct p.idpessoa
                   , n.dataretorno
                   , initcap(p.nomepessoa)||' - '||p.cpf||' (cod. site: '||v.idvendedora||')' nomepessoa
                   , n.numeronota
                   , pck_romance.fnc_retornatelefones(v.idvendedora)telefone
                   , initcap(p.enderecoprincipal) ||', '|| p.numero||', '||p.bairro endereco
                   , pck_romance.fnc_nomecidade(p.idcidade) nomecidade
                   , ( select rv.descricao from regioesvenda rv where rv.idregiaovenda = ( select vv.idregiaovenda from vendedoras vv where vv.idpessoa = p.idpessoa)) "Regiao Vendedora"
                   , p.observacao observacao
                   , p.bairro
                   , p.datanascimento
                   , decode(p.documentosrecebidos,'S','Sim','Não') docreb
                   , v.idregiaovenda
                   , p.idcidade
                   , n.semanadistribuicao
                   , n.semanacobranca
                from pessoas p
                 , catal.vendedoras v
                 , roman.notasvendas n
                where v.idpessoa        = p.idpessoa
                  and ((p.idcidade = :P329_IDCIDADE
                        and n.idregiaovenda  = :P329_IDREGIAOVENDA)
                       or (:P329_IDCIDADE is null
                           and n.idregiaovenda  = :P329_IDREGIAOVENDA)
                       or (p.idcidade = :P329_IDCIDADE
                           and :P329_IDREGIAOVENDA is null))
                  and v.idvendedora     = n.idvendedora
                  and nvl(n.idrepresentanteatende, n.idrepresentante) = :P329_IDREPRESENTANTE
                  and n.idsituacaonotavenda = 3
                order by 2, 10
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
