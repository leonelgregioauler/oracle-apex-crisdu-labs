    region lista-de-débitos (
        name: Lista de Débitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct p.idpessoa
                   , n.dataretorno
                   , initcap(p.nomepessoa) nomepessoa
                   , n.numeronota
                   , pck_romance.fnc_retornatelefones(v.idvendedora) telefone
                   , initcap(p.enderecoprincipal) ||', '|| p.numero||'<br>'||p.bairro endereco
                   , ( select initcap(c.nomecidade)||' - '||e.sigla
                       from cidades c
                          , estados e
                       where p.idcidade = c.idcidade
                         and c.idestado = e.idestado ) nomecidade
                   , ( select rv.descricao from regioesvenda rv where rv.idregiaovenda = ( select vv.idregiaovenda from vendedoras vv where vv.idpessoa = p.idpessoa)) "Regiao Vendedora"
                   , v.observacao||', '||p.observacao observacao
                   , n.saldo SALDO
                from pessoas p
                 , vendedoras v
                 , notasvendas n
                where v.idpessoa        = p.idpessoa
                  and nvl(n.enviadocobranca,'X') = 'X'
                  and ((p.idcidade = :P329_IDCIDADE
                        and n.idregiaovenda  = :P329_IDREGIAOVENDA)
                       or (:P329_IDCIDADE is null
                           and n.idregiaovenda  = :P329_IDREGIAOVENDA)
                       or (p.idcidade = :P329_IDCIDADE
                           and :P329_IDREGIAOVENDA is null))
                  and ( n.idrepresentante = :P329_IDREPRESENTANTE
                     or n.idrepresentanteatende = :P329_IDREPRESENTANTE )
                  and v.idvendedora     = n.idvendedora
                  and n.idrepresentante = v.idrepresentante
                  AND N.SALDO > 0
                order by 2,3
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: - Sem notas na cidade ou região informada para esse distribuidor -
        }
        advanced {
            savedReportMappingIdentifier: 341033752762212034
        }

