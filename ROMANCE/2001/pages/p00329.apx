            lov: @representantes-2
            nullDisplayValue: - Selecione o Distribuidor -
        }
        layout {
            sequence: 10
            region: @relatório-de-supervisores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @relatório-de-supervisores
            slot: belowBox
            horizontalAlignment: left
