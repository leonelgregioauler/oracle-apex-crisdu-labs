        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 329
                items: {
                    P329_IDREPRESENTANTE: &P329_IDREPRESENTANTE.
                    P329_IDREGIAOVENDA: &P329_IDREGIAOVENDA.
                    P329_IDCIDADE: &P329_IDCIDADE.
                }
                action: resetPagination
            }
        }
    )

)

