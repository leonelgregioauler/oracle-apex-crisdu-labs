    region relatório-de-supervisores (
        name: Relatório de Supervisores
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P329_IDCIDADE (
        type: selectList
        label {
            label: Cidade
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select catal.pck_romance.fnc_nomecidade(idcidade)  display_value
                     , c.IDCIDADE return_value 
                from catal.cidades c
                where exists(select p.idcidade 
                             from catal.pessoas p
                             where p.idcidade = c.idcidade
                               and exists(select v.idpessoa
                                          from catal.vendedoras v
                                          where v.idpessoa = p.idpessoa
                                            and v.idrepresentante = :P329_IDREPRESENTANTE
                                            and exists(select n.idvendedora
                                                       from roman.notasvendas n
                                                       where n.idvendedora = v.idvendedora
                                                         and (n.saldo > nvl(0 ,0)
                                                              or n.idsituacaonotavenda = 3))))
                order by 1
                
                
                ```
            nullDisplayValue: " - Selecione a Cidade - "
        }
        cascadingLov {
            parentItems: P329_IDREPRESENTANTE
        }
        layout {
            sequence: 30
            region: @relatório-de-supervisores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P329_IDREGIAOVENDA (
        type: selectList
        label {
            label: Região
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.descricao||' - '||rr.semana display_value
                     , r.idregiaovenda return_value
                from regioesvenda r
                   , regioesrepresentantes rr
                where r.idregiaovenda = rr.idregiaovenda
                  and rr.idrepresentante = :P329_IDREPRESENTANTE
                order by rr.ordem  
                ```
            nullDisplayValue: - Selecione a Região -
        }
        cascadingLov {
            parentItems: P329_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            region: @relatório-de-supervisores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P329_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
