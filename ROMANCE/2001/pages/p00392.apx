    region tarefas-da-cliente-2 (
        name: Tarefas da Cliente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select decode(ordem,1,null,t.tipo) tipo,
                       decode(ordem,1,null,t.tarefa) tarefa,
                       t.status_tarefa, 
                       decode(ordem,1,null,t.atendimento) atendimento, 
                       t.atendente,
                       t.data,
                       t.status_atendimento,
                       t.observacoes
                  from beeunified.vw_atendimentos_tarefas t
                 where t.idpessoa = :P392_IDPESSOA
                   and t.data > sysdate - 180
                 order by t.tipo, t.tarefa desc, t.atendimento, t.ordem, t.data
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
