page 392 (
    name: Tarefas da Cliente
    title: Tarefas da Cliente
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region tarefas-da-cliente (
        name: Tarefas da Cliente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtarefa
                     , ( select initcap(tp.descricao)
                         from favorita.tipostarefas tp
                         where tp.idtipotarefa = t.idtipotarefa ) tipotarefa
                     , t.telefone
                     , ( select initcap(st.descricao)
                         from favorita.situacoestarefas st
                         where st.idsituacaotarefa = t.idsituacao ) situacao
                     , t.datainclusao
                     , t.datainicio
                     , t.dataconclusao
                     , ( select u.usuario
                         from usuarios u
                         where u.idusuario = t.idusuario ) atendidopor
                     , ( select initcap(ga.descricao)
                         from gruposatendimento ga
                         where ga.idgrupoatendimento = t.idgrupoatendimento ) grupodeatendimento
                     , observacao
                     , observacaohistorico
                from favorita.tarefas t
                where t.idpessoa = :P392_IDPESSOA
                union 
                select tt.idtarefa
                     , ( select initcap(ttp.descricao)
                         from catal.tipostarefas ttp
                         where ttp.idtipotarefa = tt.idtipotarefa )
                     , tt.telefone
                     , decode(tt.situacao,'A','Aberta','P','Pendente','F','Encerrada') situacao
                     , tt.datainclusao
                     , tt.datainicio
                     , tt.dataconclusao
                     , tt.usuario
                     , ( select initcap(ga.descricao)
                         from gruposatendimento ga
                         where ga.idgrupoatendimento = tt.idgrupoatendimento )
                     , observacao
                     , ( select LISTAGG(h.observacao,', ')
                                WITHIN GROUP (ORDER BY h.idtarefa) 
                         from catal.historicotarefas h
                         where h.idtarefa = tt.idtarefa ) observacaohistorico
                from catal.tarefas tt
                where tt.idpessoa = :P392_IDPESSOA
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma Tarefa encontrada para esta cliente!
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1432926685469513339
        }

