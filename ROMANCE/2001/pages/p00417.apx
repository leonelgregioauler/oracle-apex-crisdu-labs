page 417 (
    name: Anexos de Indicações
    title: Anexos de Indicações
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function deletaanexo(pid)
            {
            
              var answer = confirm("Confirma exlusão do Anexo?")
              if (answer)
                {
                  document.getElementById('P417_DELETAR').value = pid;
                  apex.submit('DELETAR');
                }
            }
            
            
            
            ```
    }

    region anexos-de-indicações (
        name: Anexos de Indicações
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.idanexocontrolecontatosite,
                       a.idcontrolecontatossite,
                       attach_data,
                       attach_mimetype,
                       attach_filename,
                       attach_last_update,
                       attach_charset,
                       round(sys.dbms_lob.getlength(attach_data)/1024,2)||' kb' file_length,
                       sys.dbms_lob.getlength(attach_data) download,
                       '<a href="javascript: deletaanexo('||a.idanexocontrolecontatosite||')"> Excluir </a>' remover
                from roman.anexoscontrolecontatossite a
                where a.idcontrolecontatossite = :P417_IDCONTROLECONTATOSSITE;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.anexoscontrolecontatossite a
                where a.idcontrolecontatossite = :P417_IDCONTROLECONTATOSSITE;
                ```
        }
