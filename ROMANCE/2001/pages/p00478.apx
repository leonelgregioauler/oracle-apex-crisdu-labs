page 478 (
    name: Judicialização de Promissórias
    title: Judicialização de Promissórias
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region judicialização-de-promissórias (
        name: Judicialização de Promissórias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpromissoriajudicial
                     , p.idfilial
                     , p.nomefilial
                     , p.idrepresentante
                     , p.nomerepresentante
                     , p.idvendedora
                     , p.nomevendedora
                     , p.documento
                     , p.datainicio
                     , p.idsituacaojudicial
                     , p.situacao
                from vw_promissoriasjudiciais p
                where ( :P478_DATAINICIO is null or trunc(datainicio) between to_date(:P478_DATAINICIO) and to_date(:P478_DATAFIM) )
                  and ( :P478_IDFILIAL is null or p.idfilial = :P478_IDFILIAL )
                  and ( :P478_IDREPRESENTANTE is null or p.idrepresentante = :P478_IDREPRESENTANTE )
                  and ( :P478_IDVENDEDORA is null or p.idvendedora = :P478_IDVENDEDORA )
                order by 1 desc
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
        }
        advanced {
            savedReportMappingIdentifier: 1539417272984078425
        }

        column DATAINICIO (
            type: plainText
            heading {
                heading: Data de Início
                alignment: center
            }
