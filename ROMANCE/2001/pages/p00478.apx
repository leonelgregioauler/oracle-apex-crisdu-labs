    )

    button novo (
        buttonName: NOVO
        label: Novo Envío
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 479
                items: {
                    P479_IDPROMISSORIAJUDICIAL:
                    P479_DATAINICIO:
                    P479_IDFILIAL:
                    P479_IDREPRESENTANTE:
                    P479_IDVENDEDORA:
                    P479_IDSITUACAOJUDICIAL:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 478
                items: {
                    P478_DATAINICIO: &P478_DATAINICIO.
                    P478_DATAFIM: &P478_DATAFIM.
                    P478_IDFILIAL: &P478_IDFILIAL.
                    P478_IDREPRESENTANTE: &P478_IDREPRESENTANTE.
                    P478_IDVENDEDORA: &P478_IDVENDEDORA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

