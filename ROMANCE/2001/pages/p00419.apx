            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 27561741 (
            visibility: primaryDefault
            view {
                groupBy: true
                default: groupBy
                rowsPerPage: 100000
            }

            displayColumn DATAERRO (
                sequence: 4
            )

            displayColumn DISTRIBUIDOR (
                sequence: 1
            )

            displayColumn DOCUMENTO (
                sequence: 2
            )

            displayColumn MOTIVO (
                sequence: 3
            )

            displayColumn ULTIMOCOMPARTILHAMENTO (
                sequence: 6
            )

            displayColumn ULTIMOLOGIN (
                sequence: 5
            )

            sort (
                column: DATAERRO
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            groupByColumn (
                column: MOTIVO
                layout {
                    sequence: 1
                }
            )

            groupByAggregate (
                heading: Qtd de Problemas
                aggregate {
                    function: countDistinct
                    column: DOCUMENTO
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 1
                }
            )

            groupBySort (
                column: MOTIVO
                sort {
                    sequence: 1
                }
            )

        )

    )

    region problemas-registrados (
        name: Problemas Registrados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idchamado
                     , dataabertura
                     , substr(descricao, instr(descricao, 'motivo:')+5,100) motivo
                     , substr(descricao,23,instr(descricao,'(')-25) documento
                from chamados c
                where idgrupoatendimento = 31
                  and ( :P419_DOCUMENTO is null or substr(descricao,23,instr(descricao,'(')-23) = replace(replace(replace(:P419_DOCUMENTO,'-',''),'.',''),' ','') )
                order by 1 desc;
                ```
            pageItemsToSubmit: P419_DOCUMENTO
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2756162793045090911
        }

        column DATAABERTURA (
            type: plainText
            heading {
                heading: Data Abertura
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
