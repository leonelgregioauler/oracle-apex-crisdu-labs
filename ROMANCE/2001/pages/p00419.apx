page 419 (
    name: Análise de Problemas
    title: Análise de Problemas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region documento (
        name: Documento
        type: staticContent
        layout {
            sequence: 20
            slot: body
            column: 5
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region placar-de-problemas (
        name: Placar de Problemas
        type: chart
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                i-h240
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartAppearance {
            orientation: horizontal
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series valor (
            name: Valor
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select substr(descricao, instr(descricao, 'motivo:')+5,100) motivo
                         , count(1) qtd
                    from chamados c
                    where idgrupoatendimento = 31
                      and trunc(c.dataabertura) between to_date(:P419_DATAINICIO) and to_date(:P419_DATAFIM)
                     --and descricao like '%01602692297%'
                     group by substr(descricao, instr(descricao, 'motivo:')+5,100)
                    order by 1 desc;
                    ```
                pageItemsToSubmit: [
                    P419_DATAINICIO
                    P419_DATAFIM
                ]
            }
            columnMapping {
                label: MOTIVO
                value: QTD
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    region possíveis-problemas (
        name: Possíveis Problemas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select documento
                     , motivo
                     , dataerro
                     , nvl( 
                             ( select pck_romance.fnc_nomerepresentante(v.idrepresentante) 
                                 from pessoas p
                                    , vendedoras v
                                 where p.idpessoa = v.idpessoa
                                   and p.cpf = aa.documento ) 
                             , ( select pck_romance.fnc_nomerepresentante(v.idrepresentante) 
                                 from pessoas p
                                    , vendedoras v
                                 where p.idpessoa = v.idpessoa
                                   and p.documentoestrangeiro = aa.documento
                                   and rownum = 1 ) ) distribuidor
                     , ( select max(r.datalogin)
                         from registrosloginminhasacola r
                         where r.idvendedora = ( select idvendedora
                                                 from pessoas p
                                                    , vendedoras v
                                                 where p.idpessoa = v.idpessoa
                                                   and p.cpf = aa.documento ) ) ultimologin
                     , ( select max(rr.datacompartilhamento)
                         from registroscompartilhafotos rr
                         where rr.idvendedora = ( select idvendedora
                                                 from pessoas p
                                                    , vendedoras v
                                                 where p.idpessoa = v.idpessoa
                                                   and p.cpf = aa.documento ) ) ultimocompartilhamento
                --     , 'Digi: '||senhamd5 
                --      ||'<br>Cad: '|| ( select p.senhasite
                --                                     from pessoas p
                --                                     where p.cpf = documento ) descricao
                --     , senhaaberta
                from ( select distinct substr(descricao,23,instr(descricao,'(')-23)  documento
                           , substr(descricao, instr(descricao, 'motivo:')+8,100) motivo
                           , max(c.dataabertura) dataerro 
                                           , ( select substr( initcap(p.nomepessoa) , 1 , instr(p.nomepessoa,' '))
                                               from pessoas p
                                               where p.cpf = substr(descricao,23,instr(descricao,'(')-23)   ) consultora
                                           , ( select idpessoa
                                               from pessoas p
                                               where p.cpf = substr(descricao,23,instr(descricao,'(')-23)   ) idpessoa
                                           , ( select v.idvendedora
                                               from pessoas p
                                                  , vendedoras v
                                               where p.idpessoa = v.idpessoa
                                                 and p.cpf = substr(descricao,23,instr(descricao,'(')-23)   ) id
                    --       , substr(descricao,instr(descricao,'(')+1,instr(descricao,':')-instr(descricao,'(')-1)  senhaaberta
                     --      , substr(descricao,instr(descricao,':')+1,instr(descricao,')')-instr(descricao,':')-1)  senhamd5
                      from chamados c
                      where idgrupoatendimento = 31 
                        and substr(descricao,23,instr(descricao,'(')-23)  is not null
                        and (  exists  ( select idvendedora
                                         from pessoas p
                                            , vendedoras v
                                         where p.idpessoa = v.idpessoa
                                           and p.cpf      =  substr(descricao,23,instr(descricao,'(')-23)
                                           and v.ativo    = 'S' )
                             or exists  ( select idvendedora
                                          from pessoas p
                                             , vendedoras v
                                          where p.idpessoa = v.idpessoa
                                            and p.documentoestrangeiro =  substr(descricao,23,instr(descricao,'(')-23)
                                            and v.ativo = 'S' ) ) 
                --        and ( :P419_DOCUMENTO is null or substr(descricao,23,instr(descricao,'(')-23) = replace(replace(replace(:P419_DOCUMENTO,'-',''),'.',''),' ','') )
                      group by substr(c.descricao,23,instr(c.descricao,'(')-23)  
                             , substr(descricao, instr(descricao, 'motivo:')+8,100)
                             --, substr(descricao,instr(descricao,'(')+1,instr(descricao,':')-instr(descricao,'(')-1)  
                             --, substr(descricao,instr(descricao,':')+1,instr(descricao,')')-instr(descricao,':')-1)
                               ) aa
                where dataerro > nvl(( select max(r.datalogin)
                                    from registrosloginminhasacola r
                                    where r.idvendedora = nvl(  ( select idvendedora
                                                                    from pessoas p
                                                                       , vendedoras v
                                                                    where p.idpessoa = v.idpessoa
                                                                      and p.cpf = aa.documento 
                                                                      and v.ativo = 'S') ,    ( select idvendedora
                                                                                                from pessoas p
                                                                                                   , vendedoras v
                                                                                                where p.idpessoa = v.idpessoa
                                                                                                  and p.documentoestrangeiro = aa.documento 
                                                                                                  and v.ativo = 'S')  )  ),dataerro-1)
                and not exists ( select *
                                  from mensagenssms m
                                  where m.idprocessosistema = 20
                                    and m.idpessoa          = aa.idpessoa)
                and exists ( select 1
                             from notasvendas n
                                , vendedoras v
                                , pessoas p
                             where n.idvendedora = v.idvendedora
                               and v.idpessoa = p.idpessoa
                               and n.idsituacaonotavenda = 3
                               and p.cpf = documento)
                order by 3 desc
                ```
            pageItemsToSubmit: P419_DOCUMENTO
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2735039722028636648
        }

        column DATAERRO (
            type: plainText
            heading {
                heading: Data do Problema
                alignment: center
            }
            layout {
                sequence: 40
