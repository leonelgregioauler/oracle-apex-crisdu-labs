                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    pageItem P419_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @placar-de-problemas
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                margin-top-sm
                margin-bottom-sm
                margin-left-sm
                margin-right-sm
            ]
            formatMask: DD/MM/RRRR
            width: 12
        }
        default {
            type: expression
            plsqlExpression: trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P419_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @placar-de-problemas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                margin-top-sm
                margin-bottom-sm
                margin-left-sm
                margin-right-sm
            ]
            formatMask: DD/MM/RRRR
            width: 12
        }
        default {
            type: expression
            plsqlExpression: trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P419_DOCUMENTO (
        type: textField
        label {
            label: Documento
            alignment: left
        }
        layout {
            sequence: 10
            region: @documento
            slot: regionBody
            alignment: left
            column: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P419_PROBLEMAS (
        type: displayOnly
        label {
            label: Consultoras com Problemas para logar:
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 10
            region: @possíveis-problemas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1)
                from ( select distinct substr(descricao,23,instr(descricao,'(')-23)  documento
                           , substr(descricao, instr(descricao, 'motivo:')+8,100) motivo
                           , max(c.dataabertura) dataerro 
                    --       , substr(descricao,instr(descricao,'(')+1,instr(descricao,':')-instr(descricao,'(')-1)  senhaaberta
                     --      , substr(descricao,instr(descricao,':')+1,instr(descricao,')')-instr(descricao,':')-1)  senhamd5
                  , ( select substr( initcap(p.nomepessoa) , 1 , instr(p.nomepessoa,' '))
                      from pessoas p
                      where p.cpf = substr(descricao,23,instr(descricao,'(')-23)   ) consultora
                  , ( select idpessoa
                      from pessoas p
                      where p.cpf = substr(descricao,23,instr(descricao,'(')-23)   ) idpessoa
                  , ( select v.idvendedora
                      from pessoas p
                         , vendedoras v
                      where p.idpessoa = v.idpessoa
                        and p.cpf = substr(descricao,23,instr(descricao,'(')-23)   ) id
                      from chamados c
                      where idgrupoatendimento = 31 
                        and substr(descricao,23,instr(descricao,'(')-23)  is not null
                        and (  exists  ( select idvendedora
                                         from pessoas p
                                            , vendedoras v
                                         where p.idpessoa = v.idpessoa
                                           and p.cpf      =  substr(descricao,23,instr(descricao,'(')-23)
                                           and v.ativo    = 'S' )
                             or exists  ( select idvendedora
                                          from pessoas p
                                             , vendedoras v
                                          where p.idpessoa = v.idpessoa
                                            and p.documentoestrangeiro =  substr(descricao,23,instr(descricao,'(')-23)
                                            and v.ativo = 'S' ) ) 
                --        and ( :P419_DOCUMENTO is null or substr(descricao,23,instr(descricao,'(')-23) = replace(replace(replace(:P419_DOCUMENTO,'-',''),'.',''),' ','') )
                      group by substr(c.descricao,23,instr(c.descricao,'(')-23)  
                             , substr(descricao, instr(descricao, 'motivo:')+8,100)
                             --, substr(descricao,instr(descricao,'(')+1,instr(descricao,':')-instr(descricao,'(')-1)  
                             --, substr(descricao,instr(descricao,':')+1,instr(descricao,')')-instr(descricao,':')-1)
                               ) aa
                where dataerro > nvl(( select max(r.datalogin)
                                    from registrosloginminhasacola r
                                    where r.idvendedora = nvl(  ( select idvendedora
                                                                    from pessoas p
                                                                       , vendedoras v
                                                                    where p.idpessoa = v.idpessoa
                                                                      and p.cpf = aa.documento 
                                                                      and v.ativo = 'S') ,    ( select idvendedora
                                                                                                from pessoas p
                                                                                                   , vendedoras v
                                                                                                where p.idpessoa = v.idpessoa
                                                                                                  and p.documentoestrangeiro = aa.documento 
                                                                                                  and v.ativo = 'S')  )  ),dataerro-1)
                                                                                                  
                 and not exists ( select *
                                   from mensagenssms m
                                   where m.idprocessosistema = 20
                                     and m.idpessoa          = aa.idpessoa)
                 and exists ( select 1
                              from notasvendas n
                                 , vendedoras v
                                 , pessoas p
                              where n.idvendedora = v.idvendedora
                                and v.idpessoa = p.idpessoa
                                and n.idsituacaonotavenda = 3
                                and p.cpf = documento)
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction atualiza-relatório (
        name: Atualiza Relatório
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P419_DOCUMENTO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @possíveis-problemas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @problemas-registrados
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: Refresh 2
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P419_DATAFIM
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @placar-de-problemas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-2 (
        name: Refresh 1
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P419_DATAINICIO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @placar-de-problemas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

