            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column ULTIMOLOGIN (
            type: plainText
            heading {
                heading: Ultimo Login
                alignment: center
