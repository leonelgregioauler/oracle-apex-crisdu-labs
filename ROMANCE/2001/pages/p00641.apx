    region todas-as-vendedoras (
        name: "Todas as Vendedoras "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select roman.pck_romance.fnc_nomerepresentante (v.idrepresentante) Distribuidor
                      , p.nomepessoa vendedora 
                      , ''''||p.cpf||'''' CPF
                      , v.idvendedora
                      , case
                           when v.ativo = 'S' then 'Sim'
                        else 'Não'
                        end Ativo
                      , nvl(round(v.pontospremios),0) pontos
                      , case when round(pontospremios) > 9999 then '5'
                             when round(pontospremios) between 3000 and 4999 then '2'
                             when round(pontospremios) between 5000 and 9999 then '3'
                        else
                             '0'
                        end            categoria
                      , (select decode(Sum(debito),0,'N','S') debito
                          from (
                          select (vp.valorpagar-pp.valorpago) debito
                          from favorita.pedidos            p
                              ,favorita.vencimentospedidos vp
                              ,favorita.pagamentospedidos  pp
                          where p.idpedido    = vp.idpedido
                            and vp.idvencimentopedido = pp.idvencimentopedido
                            and vp.situacaovencimento = 'V'
                            and trunc(vp.datavencimento) < trunc(sysdate)
                            and p.idvendedora = v.idvendedora
                          union
                          select distinct 1 debito
                          from roman.notasvendas nv
                          where nv.idsituacaonotavenda = 4
                            and nv.saldo               > 0 
                            and nv.idvendedora         = v.idvendedora
                            )) debito
                      , cd.nomecidade  Cidade
                      , es.sigla       Estado
                      , upper(pa.nome) Pais      
                      , '<a href="javascript: fnc_abrelogin('''||fnc_encode_base64(pstring => v.idvendedora )||''')"> Ver Tela</a>'  link
                      , (select max(rl.datalogin)
                         from roman.registrosloginminhasacola rl
                         where  rl.idvendedora = v.idvendedora) "Ultimo Acesso APP"
                  from catal.vendedoras        v
                     , catal.pessoas           p
                     , roman.mei               m
                     , catal.representantes    r
                     , catal.pessoas           pr
                     , catal.cidades           cd
                     , catal.estados           es
                     , catal.paises            pa
                 where v.idrepresentante = r.idrepresentante
                   and v.idpessoa        = p.idpessoa     
                   and v.idfilial        = :P0_IDFILIAL
                   and v.ativo = 'S'
                   and not exists ( select 1
                                    from representantes r
                                    where r.idpessoa = v.idpessoa
                                      and ativo = 'S' ) 
                   --and v.ativo = 'S'
                   and ( :P641_IDCIDADE is null or p.idcidade = :P641_IDCIDADE )
                
                   and r.idpessoa = pr.idpessoa
                   and p.idcidade  = cd.idcidade
                   and cd.idestado = es.idestado
                   and es.idpais   = pa.idpais
                   and r.idpessoa = m.idpessoa (+)
                   and ( :P641_TIPOPESQUISA = 'T')
                   --and r.idrepresentante = :P642_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P641_TIPOPESQUISA
            value: T
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
