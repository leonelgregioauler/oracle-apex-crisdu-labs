    process alimenta-semanas (
        name: Alimenta Semanas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  select c.idsemanainicio
                         , c.idsemanafim
                    into :P641_IDSEMANAINI
                       , :P641_IDSEMANAFIM
                    from campanhasespeciais c
                       , campanhasfiliaisespeciais cf
                    where cf.idfilial = :P0_IDFILIAL
                      and cf.idcampanhaespecial = c.idcampanhaespecial;
                  --
                exception
                  when others then
                    :P641_IDSEMANAINI := null;
                    :P641_IDSEMANAFIM := null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 132698654427068514
        }
    )

    branch (
        name: FILTRO
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 641
                items: {
                    P641_IDSEMANAFIM: &P641_IDSEMANAFIM.
                    P641_IDSEMANAINI: &P641_IDSEMANAINI.
                    P641_IDCIDADE: &P641_IDCIDADE.
                    P641_TIPOPESQUISA: &P641_TIPOPESQUISA.
