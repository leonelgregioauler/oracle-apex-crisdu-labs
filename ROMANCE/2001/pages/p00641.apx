    pageItem P641_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct c.nomecidade || ' - ' || e.sigla d
                     , c.idcidade r
                     
                  from usuariosfiliais     u
                     , filiaisregioesvenda f
                     , cidades             c
                     , estados             e
                 where u.usuario = v('APP_USER')
                   and u.idfilial = f.idfilial
                   and f.idestado = c.idestado
                   and c.idestado = e.idestado
                   order by 1; 
                 
                
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P641_IDSEMANAFIM (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano semana
                     , idsemana 
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-2 and to_char(sysdate,'RRRR')+3
                  and s.idsemana >= :P641_IDSEMANAINI
                order by idsemana desc
                ```
        }
        cascadingLov {
            parentItems: P641_IDSEMANAINI
            itemsToSubmit: P641_IDSEMANAINI
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

