    region convite-de-distribuidores (
        name: Convite de Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select roman.pck_romance.fnc_nomerepresentante (v.idrepresentante) Distribuidor
                      , p.nomepessoa vendedora 
                      , ''''||p.cpf||'''' CPF
                      , v.idvendedora
                      , 'Sim' Ativo
                      , '0' pontos
                      , '5' categoria
                      , 'N'  debito
                      , cd.nomecidade  Cidade
                      , es.sigla       Estado
                      , upper(pa.nome) Pais      
                      , '<a href="javascript: fnc_abrelogin('''||fnc_encode_base64(pstring => v.idvendedora )||''')"> Ver Tela</a>'  link
                      , (select max(rl.datalogin)
                         from roman.registrosloginminhasacola rl
                         where  rl.idvendedora = v.idvendedora) "Ultimo Acesso APP"
                  from catal.vendedoras        v
                     , catal.pessoas           p
                     , roman.mei               m
                     , catal.representantes    r
                     , catal.pessoas           pr
                     , catal.cidades           cd
                     , catal.estados           es
                     , catal.paises            pa
                 where r.ativo           = 'S'
                   and v.idpessoa        = p.idpessoa     
                   and v.idfilial        = :P0_IDFILIAL
                   and v.ativo           = 'S'
                   and v.idpessoa        = r.idpessoa
                   --and v.ativo = 'S'
                   --and ( :P641_IDCIDADE is null or p.idcidade = :P641_IDCIDADE )
                
                   and r.idpessoa = pr.idpessoa
                   and p.idcidade  = cd.idcidade
                   and cd.idestado = es.idestado
                   and es.idpais   = pa.idpais
                   and r.idpessoa = m.idpessoa (+)
                   and ( :P641_TIPOPESQUISA = 'C')
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P641_TIPOPESQUISA
            value: C
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 50127877216900606
        }

