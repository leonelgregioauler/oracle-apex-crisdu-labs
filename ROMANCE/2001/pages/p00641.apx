    region pontuação-de-distribuidores (
        name: Pontuação de Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*select idrepresentante, Distribuidor, cnpj, idvendedora, trunc(xx.pontos) pontos,
                       case when trunc(xx.pontos) > 9999 then '4-Rosa'
                            when trunc(xx.pontos) between 3000 and 4999 then '2-Bronze'
                            when trunc(xx.pontos) between 5000 and 9999 then '3-Prata'
                       else
                            '1-Nenhum'
                       end categoria,
                       
                       --
                       
                       case when trunc(xx.pontos) > 9999 then '4'
                            when trunc(xx.pontos) between 3000 and 4999 then '2'
                            when trunc(xx.pontos) between 5000 and 9999 then '3'
                       else
                            '1'
                       end idcategoria,
                       
                       qtde SubTotal
                       
                  from (
                      
                        select v.idrepresentante,
                               upper(pr.nomepessoa) Distribuidor, 
                               m.cnpj, 
                               v.idvendedora, 
                               sum(h.pontos) pontos,
                               count(*) qtde
                          from historicospontospremios h
                             , catal.vendedoras        v
                             , catal.pessoas           p
                             , roman.mei               m
                             , representantes          r
                             , catal.pessoas           pr
                         where h.idvendedora     = v.idvendedora
                           and v.idrepresentante = r.idrepresentante
                           and v.idpessoa        = p.idpessoa       
                           and v.idfilial        = :P0_IDFILIAL
                           and ( :P641_IDCIDADE is null or p.idcidade  = :P641_IDCIDADE )
                           and r.ativo = 'S'
                           and r.idpessoa = pr.idpessoa
                           and r.idpessoa = m.idpessoa (+)
                           
                           and h.data between (select to_date(dt_ini||' 00:00:01','dd/mm/rrrr hh24:mi:ss')  
                                                 from semana_dias where idsemana = :P641_IDSEMANAINI)
                                          and (select to_date(dt_fim||' 23:59:59','dd/mm/rrrr hh24:mi:ss') 
                                                 from semana_dias where idsemana = :P641_IDSEMANAFIM)
                           and nvl(h.pontos,0) > 0
                          group by v.idrepresentante, pr.nomepessoa, m.cnpj, v.idvendedora 
                      
                    ) xx */
                    
                with xx as (      
                        select v.idrepresentante,
                               upper(pr.nomepessoa) Distribuidor, 
                               m.cnpj, 
                               v.idvendedora, 
                               sum(h.pontos) pontos
                          from historicospontospremios h
                             , catal.vendedoras        v
                             , catal.pessoas           p
                             , roman.mei               m
                             , representantes          r
                             , catal.pessoas           pr
                         where h.idvendedora     = v.idvendedora
                           and v.idrepresentante = r.idrepresentante
                           and v.idpessoa        = p.idpessoa  
                           and not exists ( select 1
                                            from representantes r
                                            where r.idpessoa = v.idpessoa ) 
                             and v.ativo = 'S'
                             and v.idfilial        = :P0_IDFILIAL
                             and ( :P641_IDCIDADE is null or p.idcidade  = :P641_IDCIDADE )
                             --and r.idrepresentante = 51919
                             and r.idpessoa = pr.idpessoa
                             and r.idpessoa = m.idpessoa (+)
                             and r.ativo = 'S'
                
                             and h.data between (select to_date(dt_ini||' 00:00:01','dd/mm/rrrr hh24:mi:ss')  
                                                   from semana_dias where idsemana = :P641_IDSEMANAINI)
                                            and (select to_date(dt_fim||' 23:59:59','dd/mm/rrrr hh24:mi:ss') 
                                                   from semana_dias where idsemana = :P641_IDSEMANAFIM)
                             and nvl(h.pontos,0) > 0
                             and :P641_TIPOPESQUISA = 'P'
                      group by v.idrepresentante, pr.nomepessoa, m.cnpj, v.idvendedora 
                      
                    ) 
                
                select idrepresentante, Distribuidor, cnpj, idvendedora, trunc(xx.pontos) pontos,
                       case when trunc(xx.pontos) > 9999 then '5 Estrelas'
                            when trunc(xx.pontos) between 3000 and 4999 then '2 Estrelas'
                            when trunc(xx.pontos) between 5000 and 9999 then '3 Estrelas'
                       else
                            'Nenhum'
                       end categoria,
                       
                       --
                       
                       case when trunc(xx.pontos) > 9999 then '4'
                            when trunc(xx.pontos) between 3000 and 4999 then '2'
                            when trunc(xx.pontos) between 5000 and 9999 then '3'
                       else
                            '1'
                       end idcategoria
                       
                    , count(*) over(partition by idrepresentante) as SubTotal
                    
                 from xx  
                 --where :P641_TIPOPESQUISA = 'P'
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
