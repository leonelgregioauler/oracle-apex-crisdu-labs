        )

        column IDCONTACONTABIL (
            reportColumnQueryId: 5
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomeconta display_value
                         , idcontafinan  return_value
                    from contasfinanceiras c
                    order by 1
                    ```
            }
            layout {
                sequence: 7
            }
            appearance {
                width: 20
            }
        )

        column IDDESPESA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingTrigger
            }
        )

        column IDDESPESA_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 3
