page 340 (
    name: Despesas Vinculadas a Distribuidores
    title: Despesas Vinculadas a Distribuidores
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region conferir-despesas-vinculadas-a-distribuidores (
        name: Conferir Despesas vinculadas a Distribuidores
        type: tabform
        source {
            sqlQuery:
                ```sql
                select IDDESPESA
                     , IDDESPESA IDDESPESA_DISPLAY
                     , nvl(pck_romance.fnc_nomerepresentante(idrepresentante)
                          ,(select pck_romance.fnc_nomerepresentante(idrepresentante)
                            from fechamentorepresentantes fr
                            where fr.idfechamentorepres = d.idfechamentorepres)) representante
                     , IDFECHAMENTOREPRES
                     , IDCONTACONTABIL
                     , OBSERVACAO
                     , VALOR
                     , EMMAOS
                     , IDSUBCONTACONTABIL
                     , DATAVENCIMENTO
                     , DESCRICAOORIGEM
                     , OBSERVACAOCONTROLE
                     , null anexos
                     , ( select count(1)
                         from anexosdespesas dd
                         where dd.iddespesa = d.iddespesa ) qtdanexos
                     , null questionar
                     , replace(observacao||' - '||trim(to_char(valor,'999G999G999G999G990D00')),',','.') questionamento
                     , IDMATRIZCLASSIFICACAO
                from DESPESAS d
                where idfechamento = :P0_IDFECHAMENTO
                  and IDFECHAMENTOREPRES is not null
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 80
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhuma despesa encontrada!
        }
        componentAdvanced {
            stripHtml: true
        }

        column ANEXOS (
            reportColumnQueryId: 13
            derivedColumn: N
            type: link
            heading {
                heading: Anexos
                alignment: center
            }
            layout {
                sequence: 16
                columnAlignment: center
            }
            link {
                target: {
                    page: 328
                    items: {
                        P328_IDDESPESA: #IDDESPESA#
                        P328_PAGINA: 340
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
        )

        column CHECK$01 (
            reportColumnQueryId: 18
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
            serverSideCondition {
                type: never
            }
        )

        column DATAVENCIMENTO (
            reportColumnQueryId: 10
