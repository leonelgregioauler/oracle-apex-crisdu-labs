        column IDMATRIZCLASSIFICACAO (
            reportColumnQueryId: 17
            derivedColumn: N
            type: selectList
            heading {
                heading: Classificação
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select m.classificacaodespesa
                         , m.idmatrizclassificacao
                    from matrizclassificacoesdespesas m
                    where m.idfilial = :P0_IDFILIAL
                    order by 1
                    ```
            }
            layout {
                sequence: 6
            }
        )

        column IDSUBCONTACONTABIL (
            reportColumnQueryId: 9
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Sub Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select c.nomeconta ||' - '||s.nomeconta display_value
                         , s.idsubcontafinan return_value
                    from subcontasfinanceiras s
                       , contasfinanceiras c
                    where c.idcontafinan = s.idcontafinan
                    order by 1
                    ```
            }
            layout {
                sequence: 8
            }
            appearance {
                width: 20
            }
        )

        column OBSERVACAO (
