page 347 (
    name: Notas Enviadas para Cobrança
    title: Notas Enviadas para Cobrança
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function confirma(pid)
            {
              document.getElementById('P347_IDEDITAR').value = pid;
                
              var answer = confirm("Confirma o recebimento da promissória?");
              if (answer)
                {
                  apex.submit('PROMISSORIA');
                }
            }
            
            function confirmaenvio(pid)
            {
              document.getElementById('P347_IDEDITAR').value = pid;
                
              var answer = confirm("Confirma o envio da promissória?");
              if (answer)
                {
                  apex.submit('ENVIOPROMISSORIA');
                }
            }
            
            function fnc_imprime()
              {
                window.open('f?p=&APP_ID.:348:&SESSION.::NO::P348_IDREPRESENTANTE,P348_IDREGIAOVENDA:'+document.getElementById('P347_IDREPRESENTANTE').value +','+document.getElementById('P347_IDREGIAOVENDA').value ,'imprime', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1200,height=800,left=250,top=100','_blank'); void(0);
              }
            
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

