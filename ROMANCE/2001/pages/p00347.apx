    process confirmar-promissória-recebida (
        name: Confirmar promissória recebida
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcaracteristica number := 26;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P347_IDEDITAR,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidvalorcaracteristica,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                  --
                  update notasvendas n
                  set n.promissoriarecuperada = 'S'
                  where n.idnotavenda = :P347_IDEDITAR;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Promissória Recebida na empresa com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1212490769389266601
        }
        serverSideCondition {
            type: request=Value
            value: PROMISSORIA
        }
    )

