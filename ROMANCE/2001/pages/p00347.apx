    pageItem P347_IDREGIAOVENDA (
        type: selectList
        label {
            label: Região de Venda
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(r.idregiaovenda)||' - '||r.semana display_value
                     , r.idregiaovenda return_value
                from regioesrepresentantes r
                where r.idrepresentante = :P347_IDREPRESENTANTE
                order by r.idsemana
                ```
            nullDisplayValue: - Todas Regiões -
        }
        cascadingLov {
            parentItems: P347_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P347_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||decode(r.ativo,'S','Ativo','Inativo') display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                union all
                select ' - Todos - ' 
                     , 999999999
                from dual
                where exists ( select 1
                               from usuarios u
                               where u.usuario = v('APP_USER')
                                 and u.idgerente in (143,80,29,259) )
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

