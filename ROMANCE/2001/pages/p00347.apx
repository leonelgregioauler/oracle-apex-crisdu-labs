    region notas-enviadas-para-cobrança (
        name: Notas Enviadas para Cobrança
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.numeronota
                     , pck_romance.fnc_nomerepresentante(nv.idrepresentante) representante
                     , pck_romance.fnc_nomevendedora(nv.idvendedora) vendedora
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.datanota
                     , nv.dataretorno
                     , nv.dataacerto
                     , nv.valortotalnota
                     , nv.valortotalvendalqd
                     , nv.valorpago
                     , nv.saldo
                     , '<a href="javascript: confirma('||IDNOTAVENDA||')"> Confirmar Recebimento </a>' promissoriarecuperada
                     , pck_romance.fnc_nomeregiaovenda(nv.idregiaovenda) regiaovenda
                     , nv.dataenviadocobranca
                     , nvl(( select 'Sim'
                             from dual
                             where exists ( select 1 
                                            from correcoesnotasvendas c
                                            where c.idnotavenda = nv.idnotavenda
                                              and c.usuario = 'OPTIMUS'
                                              and c.motivo like '%Nota enviada para o departamento de cobrança%')),'Não') envioautomatico
                     , case
                         when not exists ( select 1
                                           from classificacoesnotasvendas cf
                                           where cf.idnotavenda = nv.idnotavenda
                                             and cf.idcaracteristicanotavenda = 19 ) then
                           '<a href="javascript: confirmaenvio('||IDNOTAVENDA||')"> Confirmar Envio Promissória </a>'
                         else
                           'Promissória Enviada'
                       end enviopromissoria 
                     , nvl(( select 'Sim'
                             from dual
                             where exists (select 1
                                           from classificacoesnotasvendas cf
                                           where cf.idnotavenda = nv.idnotavenda
                                             and cf.idcaracteristicanotavenda = 4)),'Não') recebimento
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' url 
                     , ( select decode(v.spc,'S','Sim','Não')
                         from vendedoras v
                         where v.idvendedora = nv.idvendedora ) spc
                from notasvendas nv
                where nv.idsituacaonotavenda = 4
                  and nv.saldo > 0
                  and ( nv.enviadocobranca = 'S'
                     or nv.enviocobrancaterceirizada = 'S' )
                  and nv.idfilial = :P0_IDFILIAL
                  and ( :P347_PROMISSORIA_RECEBIDA = 'A'
                       or ( :P347_PROMISSORIA_RECEBIDA = 'S' and exists ( select 1
                                                                         from classificacoesnotasvendas cf
                                                                         where cf.idnotavenda = nv.idnotavenda
                                                                           and cf.idcaracteristicanotavenda = 4 ) ) 
                       or ( :P347_PROMISSORIA_RECEBIDA = 'N' and not exists ( select 1
                                                                             from classificacoesnotasvendas cf
                                                                             where cf.idnotavenda = nv.idnotavenda
                                                                               and cf.idcaracteristicanotavenda = 4 ) ) )
                  and ( :P347_IDREPRESENTANTE = 999999999 or nv.idrepresentante = :P347_IDREPRESENTANTE )
                  and ( :P347_IDREGIAOVENDA is null or nv.idregiaovenda = :P347_IDREGIAOVENDA )
                  and ( :P347_ENVIADA is null
                       or ( :P347_ENVIADA = 'S' and exists ( select 1
                                                             from classificacoesnotasvendas cn
                                                             where cn.idnotavenda = nv.idnotavenda
                                                               and cn.idcaracteristicanotavenda = 19 ) )
                       or ( :P347_ENVIADA = 'N' and not exists ( select 1
                                                                 from classificacoesnotasvendas cn
                                                                 where cn.idnotavenda = nv.idnotavenda
                                                                   and cn.idcaracteristicanotavenda = 19 ) ) )
                  and ( :P347_AUTOMATICO is null
                       or ( :P347_AUTOMATICO = 'T' and nv.enviadocobranca = 'S' )
                       or ( :P347_AUTOMATICO = 'S' and nv.envioautomatico = 'S' )
                       or ( :P347_AUTOMATICO = 'N' and nv.envioautomatico = 'N' ) )
                  and ( :P347_ASSINATURA_ELETRONICA = 'A'
                     or ( :P347_ASSINATURA_ELETRONICA = 'S' and exists ( select 1
                                                                         from classificacoesnotasvendas cf
                                                                         where cf.idnotavenda = nv.idnotavenda
                                                                           and cf.idcaracteristicanotavenda = 35 ) )
                     or ( :P347_ASSINATURA_ELETRONICA = 'N' and not exists ( select 1
                                                                             from classificacoesnotasvendas cf
                                                                             where cf.idnotavenda = nv.idnotavenda
                                                                               and cf.idcaracteristicanotavenda = 35 ) ) )
                order by 3
                ```
            pageItemsToSubmit: [
                P347_IDREPRESENTANTE
                P347_IDREGIAOVENDA
                P347_ENVIADA
                P347_AUTOMATICO
                P347_PROMISSORIA_RECEBIDA
                P347_ASSINATURA_ELETRONICA
            ]
        }
