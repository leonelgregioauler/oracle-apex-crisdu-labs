page 363 (
    name: Imprimir Nota para Fiscal
    title: Imprimir Nota para Fiscal
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region page_plug (
        name: " "
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_imprime.prc_imprimenotavenda_fiscal(:P363_IDNOTAVENDA,:P363_TIPO);
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P363_IDNOTAVENDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @page_plug
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P363_TIPO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @page_plug
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

