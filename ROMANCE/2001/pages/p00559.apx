page 559 (
    name: Logs Indicações
    title: Logs Indicações
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
    )

    region logs-indicações (
        name: Logs Indicações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select lc.idlog
                     , lc.usuarioalteracao
                     , lc.desctipoalteracao
                     , lc.dataalteracao
                     , lc.protocolo
                     , lc.nomecompleto
                     , lc.cpf
                     , lc.datanascimento
                     , lc.rua
                     , lc.nr
                     , lc.complemento
                     , lc.bairro
                     , lc.fone
                     , lc.fone2
                     , lc.email
                     , lc.mensagem
                     , lc.observacao
                     , lc.situacao
                     , lc.datacadastro
                     , lc.filial filial
                     , lc.representante distribuidor
                     , lc.dataliberadofilial
                     , lc.datapassadorepres
                     , lc.observacaofilial
                     , lc.origemdesc
                     , lc.tipodesc
                     , lc.nroconsultaspc
                     , lc.usuariocadastrou
                     , lc.datacadastrorepresentante
                     , lc.observacaorepresentante
                from vw_logcontrolecontatossite_fav lc
                where lc.protocolo = :P559_IDSAC
                order by 1 desc
                ```
            pageItemsToSubmit: P559_IDSAC
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum dado localizado!
        }
        advanced {
            savedReportMappingIdentifier: 26587978843629332
        }

