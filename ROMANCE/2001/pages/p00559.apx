    pageItem P559_IDSAC (
        type: textField
        label {
            label: ID Indicação
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
            valuePlaceholder: Informe o ID Indicação
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P559_IDSAC
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @logs-indicações
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

