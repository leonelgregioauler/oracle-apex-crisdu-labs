page 259 (
    name: Distribuído para Cliente
    title: Distribuído para Cliente
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 50%
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    headerAndFooter {
        footerText:
            ```html
            <script javascript>
             window.resizeTo(screen.width*.46,screen.height*.46);  
                window.moveTo(screen.width*.26, screen.height*.20);  
            </script>
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region distribuído-para-cliente (
        name: Distribuído para Cliente
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeprodutoestoque(idestoque) produto
                     , g.quantidade
                     , e.vlrvenda
                     , g.quantidade * e.vlrvenda valortotal
                from gerarcargas_temp g
                   , estoquefilial e
                where e.idestoquefilial = g.idestoque
                  and semana            = :P259_SEMANA
                  and g.idfilial        = :P0_IDFILIAL
                  and g.idrepresentate  = :P259_IDREPRESENTANTE
                  and g.quantidade      > 0
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: showAll
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Cliente não recebeu mercadoria até o momento.
        }
        componentAdvanced {
            stripHtml: true
        }

        column PRODUTO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column QUANTIDADE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            advanced {
                computeSum: true
            }
        )

        column VALORTOTAL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Total
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

        column VLRVENDA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Vlr Venda
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990D00
            }
        )

    )

    pageItem P259_IDREGIAOVENDA (
        type: selectList
        label {
            label: Região
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(idregiaovenda) display_value
                     , idregiaovenda return_value
                from regioesrepresentantes
                where semana           = :P259_SEMANA
                  and idrepresentante  = :P259_IDREPRESENTANTE
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @distribuído-para-cliente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P259_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sharedComponent
            lov: @representantes-2
        }
        layout {
            sequence: 20
            region: @distribuído-para-cliente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P259_SEMANA (
        type: hidden
        layout {
            sequence: 10
            region: @distribuído-para-cliente
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

