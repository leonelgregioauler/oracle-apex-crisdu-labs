    process busca-idestoque (
        name: BUSCA IDESTOQUE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  --
                  select idestoquefilial
                  into :P216_IDESTOQUEFIL
                  from estoquefilial e
                  where e.idfilial  = :P0_IDFILIAL
                    and e.idproduto = :P216_IDPRODUTO;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 39582584894384221
        }
    )

    process fetch-row-from-itemnf (
        name: Fetch Row from ITEMNF
        type: autoRowFetch
        source {
            tableName: ITEMNF
            pkColumn: IDITNF
            pkItem: P216_IDITNF
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 422587364329625218
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDTEMNF.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P216_IDITNF := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 422587584642625221
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-itemnf (
        name: Process Row of ITEMNF
        type: autoRowProcessing
        target {
            tableName: ITEMNF
            pkColumn: IDITNF
            pkItem: P216_IDITNF
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela ITEMNF.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 422587776475625221
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        clear {
            type: pages
            pages: 23
        }
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 422587960535625222
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: Go To Page 214
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 214
                clearCache: 216
                successMessage: false
            }
            saveStateBeforeBranching: true
        }
    )

)

