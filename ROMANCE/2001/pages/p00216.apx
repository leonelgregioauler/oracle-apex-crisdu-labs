        serverSideCondition {
            type: itemIsNotNull
            item: P216_IDITNF
        }
    )

    validation p216-idproduto (
        name: P216_IDPRODUTO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P216_IDPRODUTO
            alwaysExecute: true
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            displayLocation: inlineInNotification
            associatedItem: @P216_IDPRODUTO
        }
    )

    validation valida-egg (
        name: Valida EGG
        execution {
            sequence: 70
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_estoque.fnc_estoquedisponivel(:P216_IDESTOQUEFIL,'EGG') >= nvl(to_number(:P216_QTD_EGG),0)
                ```
        }
        error {
            errorMessage: Lançamento é maior que a quantidade disponível em estoque!
        }
    )

