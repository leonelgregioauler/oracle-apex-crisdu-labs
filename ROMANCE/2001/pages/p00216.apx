                return :P27_IDNOTAFISCAL;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P216_IDPRODUTO (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto) display_value
                , p.idproduto return_value
                from produtos p
                where idproduto = :P216_IDPRODUTO
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @cadastro-de-itens-da-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            customAttributes: onChange="getcusto();"
        }
        source {
            type: databaseColumn
            databaseColumn: IDPRODUTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

