    region despesas (
        name: Despesas
        type: staticContent
        source {
            htmlCode:
                ```html
                <script language="javascript">
                function  confirmadespesa(event)
                { 
                var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
                
                if (tecla==13) {
                var answer = confirm("Confirma inclusão da despesa?")
                	if (answer){            
                		apex.submit('CREATE');
                	}
                }
                }
                </script>
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region despesas-incluídas-na-semana (
        name: Despesas Incluídas na Semana
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddespesa
                     , d.idfechamentorepres
                     , initcap(c.nomeconta) Conta
                     , initcap(sc.nomeconta) SubConta
                     , d.observacao
                     , d.semana
                     , d.valor
                from despesas d
                   , contasfinanceiras      c
                   , subcontasfinanceiras   sc
                where d.idfechamentorepres = :P77_IDFECHAMENTOREPRES
                  and d.idcontacontabil = c.idcontafinan
                  and d.idsubcontacontabil = sc.idsubcontafinan(+)
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from despesas d
                where d.idfechamentorepres = :P77_IDFECHAMENTOREPRES
                ```
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }
        componentAdvanced {
            stripHtml: true
        }

