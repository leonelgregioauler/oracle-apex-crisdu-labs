    pageItem P77_ANO (
        type: hidden
        layout {
            sequence: 60
            region: @despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ANO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vsemana fechamentorepresentantes.semana%type;
                begin
                  select fr.semana
                    into vsemana
                    from fechamentorepresentantes fr
                   where fr.idfechamentorepres = :P77_IDFECHAMENTOREPRES;
                  --
                  return substr(vsemana, instr(vsemana, '/') + 1);
                exception
                  when no_data_found then
                    return to_char(sysdate - 7, 'IYYY');
                end; --16498603
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P77_IDCONTACONTABIL (
        type: selectList
        label {
            label: Conta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idcontafinan  return_value
                from contasfinanceiras c
                where exists ( select 1
                               from matrizclassificacoesdespesas m
                               where m.idmatrizclassificacao = :P77_IDMATRIZCLASSIFICACAO
                                 and m.idcontafinan          = c.idcontafinan )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P77_IDMATRIZCLASSIFICACAO
        }
        layout {
            sequence: 70
            region: @despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
