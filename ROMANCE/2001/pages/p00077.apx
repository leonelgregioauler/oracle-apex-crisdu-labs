    button anexar-documento (
        buttonName: ANEXAR_DOCUMENTO
        label: Anexar Documento
        layout {
            sequence: 10
            region: @despesas
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 328
                items: {
                    P328_IDDESPESA: &P77_IDDESPESA.
                    P328_IDANEXODESPESA:
                    P328_PAGINA: 77
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P77_IDDESPESA is not null
                  and exists ( select 1
                               from parametros p
                               where p.idfilial = :P0_IDFILIAL 
                                 and p.nome     = 'ANEXARDOCUMENTOS' 
                                 and p.valor    = 'S' )
                  and exists ( select 1
                               from fechamentossemanais f
                               where f.idfilial = :P0_IDFILIAL 
                                 and f.concluido = 'N')
                ```
        }
    )

