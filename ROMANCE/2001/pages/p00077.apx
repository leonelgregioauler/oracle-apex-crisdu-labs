                    P77_IDFECHAMENTOREPRES: &P77_IDFECHAMENTOREPRES.
                    P77_IDDESPESA:
                    P77_IDREPRESENTANTE: &P77_IDREPRESENTANTE.
                    P77_IDFECHAMENTO: &P77_IDFECHAMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @nova-despesa
        }
    )

)

