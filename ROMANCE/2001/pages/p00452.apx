page 452 (
    name: Ajustar Descrição de Produto
    title: Ajustar Descrição de Produto
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ajustar-descrição-de-produto (
        name: Ajustar Descrição de Produto
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P452_DESCRICAOATUAL (
        type: textField
        label {
            label: Descrição Atual
            alignment: left
        }
        layout {
            sequence: 20
            region: @ajustar-descrição-de-produto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vdescricao varchar2(4000);
                  --
                begin
                  --
                  select descricaocomercial
                  into vdescricao
                  from produtos p
                  where p.idproduto = :P452_IDPRODUTO;
                  --
                  return vdescricao;
                  --
                exception
                  when others then
                    return 'Descrição não encontrada!';
                end;
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P452_DESCRICAO_NOVA (
        type: textarea
        label {
            label: Descrição Nova
            alignment: left
        }
        layout {
            sequence: 30
            region: @ajustar-descrição-de-produto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
            height: 5
        }
        validation {
            valueRequired: true
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vdescricao varchar2(4000);
                  --
                begin
                  --
                  select descrproduto
                  into vdescricao
                  from produtos p
                  where p.idproduto = :P452_IDPRODUTO;
                  --
                  return vdescricao;
                  --
                exception
                  when others then
                    return 'Descrição não encontrada!';
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P452_IDPRODUTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @ajustar-descrição-de-produto
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 20
            region: @ajustar-descrição-de-produto
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @ajustar-descrição-de-produto
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process atualizar-descrição (
        name: Atualizar Descrição
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update produtos p
                  set p.descricaocomercial = :P452_DESCRICAO_NOVA
                  where p.idproduto = :P452_IDPRODUTO;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Descrição atualizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1514295053870217049
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 361
                action: resetPagination
            }
        }
    )

)

