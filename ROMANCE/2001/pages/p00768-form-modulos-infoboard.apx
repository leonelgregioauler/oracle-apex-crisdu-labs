page 768 (
    name: Form Modulos Infoboard
    alias: FORM-MODULOS-INFOBOARD
    title: Detalhes Modulos Infoboard
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-700x
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region detalhes-modulos-infoboard (
        name: Detalhes Modulos Infoboard
        type: form
        source {
            location: localDatabase
            tableName: MODULOSINFOBOARD
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P768_IDMODINFOBOARD (
        type: hidden
        layout {
            sequence: 10
            region: @detalhes-modulos-infoboard
            slot: regionBody
        }
        source {
            formRegion: @detalhes-modulos-infoboard
            column: IDMODINFOBOARD
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: SEQ_IDMODINFOBOARD
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P768_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @detalhes-modulos-infoboard
            slot: regionBody
        }
    )

    pageItem P768_NOMEINFOBOARD (
        type: textField
        label {
            label: Nome Infoboard
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @detalhes-modulos-infoboard
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 50
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @detalhes-modulos-infoboard
            column: NOMEINFOBOARD
            dataType: varchar2
        }
    )

    pageItem P768_OPERACAODML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @detalhes-modulos-infoboard
            slot: regionBody
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar/Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P768_IDMODINFOBOARD
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P768_IDMODINFOBOARD
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar alterações
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P768_IDMODINFOBOARD
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-nome (
        name: Valida Nome
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                  from modulosinfoboard
                 where lower(nomeinfoboard) = lower(:P768_NOMEINFOBOARD);
                ```
        }
        error {
            errorMessage: Nome já existe. Informe outro nome!
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,CREATE
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 377212162224835038
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-form-modulos-infoboard (
        name: Initialize form Form Modulos Infoboard
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  
                  pck_infoboard.prc_modulosinfoboard(:P768_IDMODINFOBOARD,
                                                     :P768_NOMEINFOBOARD,
                                                     :P768_MD5,
                                                     'S');
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 377211370921835037
        }
    )

    process process-form-form-modulos-infoboard (
        name: Process form Form Modulos Infoboard
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  v_dml varchar2(1);
                  --
                begin
                  --
                  --raise_application_error(-20001,v('REQUEST') );
                  --
                  if v('REQUEST') = 'CREATE' then
                    v_dml := 'I';
                  elsif  v('REQUEST') = 'SAVE' then
                    v_dml := 'U';
                  else
                    v_dml := 'D';
                  end if;
                  --
                  pck_infoboard.prc_modulosinfoboard(:P768_IDMODINFOBOARD,
                                                     :P768_NOMEINFOBOARD,
                                                     :P768_MD5,
                                                     v_dml);
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 377211719382835037
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE, DELETE, SAVE
        }
    )

)

