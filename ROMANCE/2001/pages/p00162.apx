    region despesas-pendentes (
        name: Despesas Pendentes
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial( f.idfilial) empresa
                     , count(D.IDDESPESA) qtd
                     , f.idfilial
                from despesas d
                   , fechamentossemanais f
                where NVL(d.EMMAOS,'N') = 'N'
                --  and D.IDFECHAMENTOREPRES is null  
                  and d.idfechamento     = f.idfechamento 
                  and f.idsemana >= 909
                  and exists ( select 1
                               from filiais ff
                                  , usuariosfiliais uf
                               where ff.idfilial   = f.idfilial 
                                 and uf.idfilial   = ff.idfilial
                                 and uf.usuario    = v('APP_USER')
                                 and ff.tipofilial in ('D','A') )
                having count(1) > 0                 
                group by f.idfilial
                order by 1
                ```
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: QTD
            linkTarget: {
                page: 162
                items: {
                    P0_IDFILIAL: &IDFILIAL.
                    P0_IDFECHAMENTO:
                }
                action: resetPagination
            }
            layout: 5Columns
            color: yes
        }
    )

