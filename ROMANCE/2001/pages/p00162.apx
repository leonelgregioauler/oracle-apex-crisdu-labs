        column IDCONTACONTABIL (
            reportColumnQueryId: 5
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomeconta display_value
                         , idcontafinan  return_value
                    from contasfinanceiras c
                    where exists ( select 1
                                   from matrizclassificacoesdespesas m
                                   where m.idfilial = :P0_IDFILIAL
                                     and m.idcontafinan = c.idcontafinan )
                      or nvl(c.centrodecusto,'N') = 'N'
                    order by 1
                    ```
            }
            layout {
                sequence: 8
            }
            appearance {
                width: 30
            }
        )

