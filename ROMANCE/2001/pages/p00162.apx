    region conferir-despesas-normais (
        name: Conferir Despesas Normais
        type: tabform
        source {
            sqlQuery:
                ```sql
                select d.IDDESPESA
                     , d.IDDESPESA IDDESPESA_DISPLAY
                     , roman.pck_romance.fnc_nomerepresentante(idrepresentante) IDREPRESENTANTE
                     , d.IDFECHAMENTOREPRES
                     , d.IDCONTACONTABIL
                     , d.OBSERVACAO
                     , d.VALOR
                     , d.EMMAOS
                     , d.IDSUBCONTACONTABIL
                     , d.DATAVENCIMENTO
                     , d.DESCRICAOORIGEM
                     , d.OBSERVACAOCONTROLE
                     , null anexos
                     , ( select count(1)
                         from roman.anexosdespesas dd
                         where dd.iddespesa = d.iddespesa ) qtdanexos
                     , ( select decode(cf.tipo,'V','Variável','F','Fixa')
                         from roman.contasfinanceiras cf
                         where cf.idcontafinan = d.idcontacontabil ) tipodespesa
                     , null questionamento
                     , replace(replace(replace(OBSERVACAO||' - '||VALOR,',','.') ,'+',''),'-','.')  questionar 
                     , d.idmatrizclassificacao 
                     , ( select vw.valor
                         from roman.vw_despesas_distribuidoras vw
                         where vw.iddespesa = d.iddespesa ) valor_convertido
                     , (select r.cnpj
                        from roman.razoessociaisfiliais r
                        where r.idrazaosocialfilial = d.idrazaosocialfilial) "CNPJ Despesa"
                from roman.DESPESAS d
                where d.idfechamento = :P0_IDFECHAMENTO
                  and d.idfilial   = :P0_IDFILIAL
                  and d.IDFECHAMENTOREPRES is null
                --order by 15, 7 
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: conferir-despesas-normais
        }
        reportLayout {
            numberOfRows: 80
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        breakFormatting {
            breakColumns: col1
        }
        componentAdvanced {
            stripHtml: true
        }

