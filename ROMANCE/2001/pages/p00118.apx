    process update (
        name: "UPDATE "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidlucratividade     number := :P118_IDLUCRATIVIDADE;
                  vidfechamentorepres  number := :P118_IDFECHAMENTOREPRES;
                begin
                  -- 
                  pck_romance.prc_atualiza_lucratividade( pidlucratividade    => vidlucratividade 
                                                        , pidfechamentorepres => vidfechamentorepres);
                  --
                exception
                  when others then 
                    null;
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 171584267285324761
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        execution {
            sequence: 5
        }
