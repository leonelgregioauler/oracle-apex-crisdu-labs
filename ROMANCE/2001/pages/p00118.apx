    pageItem P118_TOTALPEPINOSABERTOS (
        type: numberField
        label {
            label: Acumulado Pepinos Abertos
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 250
            region: @lucratividade
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G990D00
            width: 10
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: style="text-align: right;" readonly="readonly"
        }
        source {
            type: databaseColumn
            databaseColumn: ACUMULADOPEPINOSABERTOS
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vpepinoaberto number(15,2);
                  --
                begin
                  --
                  select nvl(sum(valor),0)
                  into vpepinoaberto
                  from pepinosrepresentantes pa
                  where pa.idfechamentorepres in ( select idfechamentorepres
                                                   from fechamentorepresentantes f
                                                   where idrepresentante = ( select idrepresentante
                                                                             from fechamentorepresentantes ff
                                                                             where ff.idfechamentorepres = :P120_IDFECHAMENTOREPRES ) )
                    and pa.situacao = 'N';
                  --
                  return vpepinoaberto;
                  --
                end;
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

