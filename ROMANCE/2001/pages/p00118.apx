    process fetch-row-from-lucratividade (
        name: Fetch Row from LUCRATIVIDADE
        type: autoRowFetch
        source {
            tableName: LUCRATIVIDADE
            pkColumn: IDLUCRATIVIDADE
            pkItem: P118_IDLUCRATIVIDADE
        }
        execution {
            sequence: 30
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 171583458583324760
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDLUCRATIVIDADE.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P118_IDLUCRATIVIDADE := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 171583685559324760
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

