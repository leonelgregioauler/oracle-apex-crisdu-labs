    pageItem P118_COMISDESPESAS (
        type: textField
        label {
            label: Desp. e Comis. (-)
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 140
            region: @lucratividade
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 4000
        }
        advanced {
            customAttributes: readonly style="text-align: right;"
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select trim(to_char((nvl((select sum(valor)
                            from despesas r
                            where r.idfechamentorepres = f.idfechamentorepres),0) 
                    + f.vlrcomissao 
                    +  nvl(( select f.totalgeral * (  g.perccomissao/100)
                              from gerentes g
                              where g.idfilial =  f.idfilial)  ,0))*-1,'999G999G990D00')) comissoesg
                from fechamentorepresentantes f
                where idfechamentorepres = :P118_IDFECHAMENTOREPRES
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

