page 729 (
    name: Logs Regiões Representantes
    title: Logs Regiões Representantes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region logs-de-regiões-representantes (
        name: Logs de Regiões Representantes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomeregiaovenda(r.idregiaovenda) regiao
                     , r.usuarioalteracao
                     , r.tipoalteracao
                     , r.dataalteracao
                     , r.semana
                from logroman.log_regioesrepresentantes r
                where r.idrepresentante =  :P729_IDREPRESENTANTE
                 and :P729_FILTRAR = 'S'
                order by 4 desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2434276125965366103
        }

        column DATAALTERACAO (
            type: plainText
            heading {
                heading: Data Alteração
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column REGIAO (
            type: plainText
            heading {
                heading: Região
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column TIPOALTERACAO (
            type: plainText
            heading {
                heading: Tipo Alteração
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column USUARIOALTERACAO (
            type: plainText
            heading {
                heading: Usuário Alteração
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 24342863 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAALTERACAO (
                sequence: 2
            )

            displayColumn REGIAO (
                sequence: 1
            )

            displayColumn SEMANA (
                sequence: 5
            )

            displayColumn TIPOALTERACAO (
                sequence: 4
            )

            displayColumn USUARIOALTERACAO (
                sequence: 3
            )

        )

    )

    pageItem P729_FILTRAR (
        type: hidden
        layout {
            sequence: 20
            region: @logs-de-regiões-representantes
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P729_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante) || decode(r.ativo,'S','','Inativo') display_value
                     , r.idrepresentante
                from representantes r
                where idgerente in ( select idgerente
                                     from gerentes
                                     where idfilial = :P0_IDFILIAL)
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @logs-de-regiões-representantes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

    button p729-filtrar (
        buttonName: P729_FILTRAR
        label: Filtrar
        layout {
            sequence: 30
            region: @logs-de-regiões-representantes
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: FILTRAR
        }
    )

    branch (
        execution {
            sequence: 10
            point: processing
        }
        behavior {
            target: {
                page: 729
                items: {
                    P729_FILTRAR: S
                }
                action: resetPagination
            }
        }
    )

)

