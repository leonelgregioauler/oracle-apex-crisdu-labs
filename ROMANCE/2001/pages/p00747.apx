    process gera-tarefas-de-atendimento (
        name: Gera Tarefas de Atendimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidtarefa             number;
                  vdatainclusao         date          := sysdate;
                  vidsituacao           number        :=  0;
                  vobservacao           varchar2(4000);
                  vidusuario            number        := :P747_ATENDENTE;
                  vidtipotarefa         number        := 70;
                  vidpessoa             number;
                  vidgrupoatendimento   number        := 73;
                  vidcanalatendimento   number        := :P747_CANALATENDIMENTO;
                  vtelefone             varchar2(100);
                  vidpais               number        := 1;
                  vidvendedora          number;  
                  vidnotavenda          number;
                  --
                  vnumber               number;
                  vvarchar              varchar2(5);
                  vdata                 date;
                  vexiste               varchar2(1);
                  --
                begin
                  --
                  if APEX_APPLICATION.G_F02.COUNT > 0 then 
                    --
                    FOR i in 1..APEX_APPLICATION.G_F02.COUNT 
                    LOOP
                      --
                      vidnotavenda := to_number(APEX_APPLICATION.G_F02(i));
                      --
                      select idpessoa
                           , v.idvendedora
                      into vidpessoa
                         , vidvendedora
                      from notasvendas nv
                         , vendedoras v
                      where idnotavenda = vidnotavenda
                        and v.idvendedora = nv.idvendedora;
                      --
                      vobservacao := roman.pck_romance.fnc_retornatelefones(vidvendedora);
                      --
                      begin
                        --
                        select telefone
                        into vtelefone
                        from telefonespessoas t
                        where t.idpessoa = vidpessoa
                          and rownum = 1
                        order by t.idtelefonepessoa desc;
                        --
                      exception 
                        when NO_DATA_FOUND then
                          vtelefone := null;
                      end;
                      --
                      if vidusuario is null then
                        --
                        vidsituacao := 0;
                        --
                      else
                        --
                        vidsituacao := 50;
                        --
                      end if;
                      --
                      favorita.pck_tarefas_fav.prc_tarefas( pidtarefa                 => vidtarefa,
                                                            pidtipotarefa             => vidtipotarefa,
                                                            pidticketcallcenter       => vnumber,
                                                            ptelefone                 => vtelefone,
                                                            pdatainclusao             => vdatainclusao,
                                                            pprioridade               => vnumber,
                                                            pidsituacao               => vidsituacao,
                                                            pobservacao               => vobservacao,
                                                            pidusuario                => vidusuario,
                                                            pidpessoa                 => vidpessoa,
                                                            pidgrupoatendimento       => vidgrupoatendimento,
                                                            pdatainicio               => vdata,
                                                            pdataconclusao            => vdata,
                                                            pnumeroposicaoatendimento => vvarchar,
                                                            pidpedido                 => vnumber,
                                                            pcodigoarea               => vnumber,
                                                            pidpais                   => vidpais,
                                                            pidcanalatendimento       => vidcanalatendimento,
                                                            pmd5                      => vvarchar,
                                                            poperacao_dml             => 'I' );
                      --
                      insert into notastarefasgeradaspap
                      values ( vidnotavenda, vidtarefa, sysdate);
                      --
                      commit;
                      --
                    end loop;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Tarefa(s) Gerada(s) com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 3072254955641250618
        }
        serverSideCondition {
            whenButtonPressed: @gerar-tarefa-atendimento
        }
    )

    branch (
        name: Go To Page 747
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 747
                items: {
                    P747_IDFILIAL: &P747_IDFILIAL.
                    P747_IDREPRESENTANTE: &P747_IDREPRESENTANTE.
                    P747_TIPO: &P747_TIPO.
                    P747_FILTRAR: S
                    P747_TIPO_RELATORIO: &P747_TIPO_RELATORIO.
                    P747_DATAINICIO: &P747_DATAINICIO.
                    P747_DATAFIM: &P747_DATAFIM.
                    P747_ATENDENTE: &P747_ATENDENTE.
                    P747_CANALATENDIMENTO: &P747_CANALATENDIMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

