    pageItem P747_ATENDENTE (
        type: selectList
        label {
            label: Atendente a Receber a(s) Tarefa(s)
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeusuario(usuario) display_value
                     , idusuario
                from usuarios u
                where u.ativo = 'S'
                  and exists ( select 1
                               from usuariosgruposatendimento ug
                               where ug.usuario = u.usuario 
                                 and ug.idgrupoatendimento = 22 )
                order by 1
                ```
            nullDisplayValue: - Todas Atendentes -
        }
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

