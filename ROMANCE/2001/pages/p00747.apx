        }
    )

    pageItem P747_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) nome
                     , r.idrepresentante
                from representantes r  
                   , gerentes g
                where r.idgerente = g.idgerente
                  and g.idfilial = :P747_IDFILIAL
                  and (:P747_SITUACAO_REPRESENTANTE = 'A' or nvl(r.ativo,'N') = :P747_SITUACAO_REPRESENTANTE)
                order by 1
                ```
        }
        cascadingLov {
            parentItems: [
                P747_IDFILIAL
                P747_SITUACAO_REPRESENTANTE
            ]
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

