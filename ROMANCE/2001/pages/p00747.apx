    region análise-de-notas-após-atendimentos (
        name: Análise de Notas Após Atendimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) consultora
                     , pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor
                     , nvl(p.cpf,p.documentoestrangeiro) cpf
                     , t.datainclusao datatarefa
                     , nv.idnotavenda
                     , nv.datanota
                     , nv.numeronota
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.valortotalnota
                     , nv.valorpago
                     , nv.saldo
                     , nvl(( select sum(pn.valorpago)
                             from pagamentosnotasvendas pn
                             where pn.idnotavenda = nv.idnotavenda
                               and pn.datapagamento > nt.data ),0) pagamentos_apos_atendimento
                     -- Maicon Aimi - 10/09/2024 - 9262255 - Busca o ultimo telefone que foi cadastrado para a consultora.
                     , ( select tel2.telefonelimpo
                           from catal.telefonespessoas tel2
                          where tel2.idtelefonepessoa = ( select max(tel.idtelefonepessoa)
                                                            from catal.telefonespessoas tel
                                                           where tel.idpessoa = v.idpessoa)) telefone_consultora
                from notastarefasgeradaspap nt
                   , notasvendas nv
                   , vendedoras v
                   , pessoas p
                   , favorita.tarefas t
                   , representantes r
                where t.idtarefa = nt.idtarefa
                  and p.idpessoa = v.idpessoa
                  and nv.idnotavenda = nt.idnotavenda
                  and v.idvendedora = nv.idvendedora
                  and nv.idrepresentante = r.idrepresentante
                  and v.idfilial = :P747_IDFILIAL
                  and ( :P747_IDREPRESENTANTE is null or v.idrepresentante = :P747_IDREPRESENTANTE )
                  and (:P747_SITUACAO_REPRESENTANTE = 'A' or nvl(r.ativo,'N') = :P747_SITUACAO_REPRESENTANTE) -- T10083337
                  and nt.data between to_date(:P747_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P747_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  -- Maicon Aimi - 10/09/2024 - 9262255 - Adicionado filtro por data de pagamento da nota.
                  and (    ( :P747_DATA_INICIO_PAGAMENTO is null or :P747_DATA_FIM_PAGAMENTO is null)
                        or ( exists ( select 1
                                       from roman.pagamentosnotasvendas pag
                                      where pag.idnotavenda = nv.idnotavenda
                                        and trunc(pag.datapagamento) between :P747_DATA_INICIO_PAGAMENTO and :P747_DATA_FIM_PAGAMENTO)))
                  and (:P747_SEMANA_COB_INICIO IS NULL or nv.idsemanacobranca between :P747_SEMANA_COB_INICIO and nvl(:P747_SEMANA_COB_FIM, nv.idsemanacobranca)) -- T13528314
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P747_TIPO_RELATORIO = 1 and :P747_FILTRAR = 'S'
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3072256212104250631
        }

