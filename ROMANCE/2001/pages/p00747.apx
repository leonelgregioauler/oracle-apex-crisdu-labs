    region análise-de-notas-para-atendimentos (
        name: Análise de Notas para Atendimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select info.idpessoa
                     , info.nome consultora
                     , decode(nvl(info.ativo,'N'),'S','Ativa','Inativa') st_vendedora
                     , info.cpf
                     , info.distribuidor
                     , info.qtd_acertos_quitados
                     , info.sacola_aguardando_acerto
                     , info.maior_sacola_com_debito
                     , deb.idnotavenda
                     , deb.numeronota
                     , deb.semanadistribuicao
                     , deb.semanacobranca
                     , deb.saldo
                     , deb.ultimo_pgto
                     , apex_item.checkbox2( p_idx        => 2,
                                            p_value      => deb.idnotavenda,
                                            p_attributes => 'class="select-item"'
                                          ) as CHECK1
                from ( select p.idpessoa
                            , v.idvendedora
                            , v.idrepresentante
                            , v.ativo
                            , initcap(p.nomepessoa) nome
                            , nvl(p.cpf,p.documentoestrangeiro) cpf
                            , pck_romance.fnc_nomerepresentante(v.idrepresentante) distribuidor
                            , ( select count(1)
                                from notasvendas nv
                                where nv.idvendedora = v.idvendedora
                                  and nv.idsituacaonotavenda = 4
                                  and nv.saldo = 0 ) qtd_acertos_quitados
                            , ( select max(cn.idvalorcaracteristica)
                                from notasvendas nv
                                   , classificacoesnotasvendas cn
                                where cn.idcaracteristicanotavenda = 52
                                  and cn.idnotavenda = nv.idnotavenda 
                                  and nv.idvendedora = v.idvendedora
                                  and nv.idsituacaonotavenda = 3 ) sacola_aguardando_acerto
                            , ( select max(cn.idvalorcaracteristica)
                                from notasvendas nv
                                   , classificacoesnotasvendas cn
                                where cn.idcaracteristicanotavenda = 52
                                  and cn.idnotavenda = nv.idnotavenda 
                                  and nv.idvendedora = v.idvendedora
                                  and nv.idsituacaonotavenda = 4
                                  and nv.saldo > 0 ) maior_sacola_com_debito
                       from vendedoras v
                          , pessoas p
                          , representantes r
                       where v.idpessoa = p.idpessoa
                         and v.idrepresentante = r.idrepresentante
                         and (:P747_ST_VENDEDORAS = 'T' or nvl(v.ativo,'N') = :P747_ST_VENDEDORAS) --T13528314
                         and v.idfilial = :P747_IDFILIAL
                         and ( :P747_IDREPRESENTANTE is null or v.idrepresentante = :P747_IDREPRESENTANTE )
                         and (:P747_SITUACAO_REPRESENTANTE = 'A' or nvl(r.ativo,'N') = :P747_SITUACAO_REPRESENTANTE) -- T10083337
                         and exists ( select 1
                                      from notasvendas nn
                                      where nn.idvendedora = v.idvendedora
                                        and nn.idsituacaonotavenda = 4
                                        and nn.saldo > 0 ) ) info
                   , ( select nv.idvendedora
                            , cn.idvalorcaracteristica nrsacola
                            , nv.idnotavenda
                            , nv.numeronota
                            , nv.semanadistribuicao
                            , nv.semanacobranca
                            , nv.saldo
                            , ( select to_char(pn.valorpago,'999G999G999G990D00')||' em '||to_char(pn.datapagamento,'DD/MM/RRRR HH24:MI:SS')
                                from pagamentosnotasvendas pn
                                where pn.idpagtonotavenda = ( select max(pp.idpagtonotavenda)
                                                              from pagamentosnotasvendas pp
                                                              where pp.idnotavenda = nv.idnotavenda
                                                                and pp.valorpago > 0 ) ) ultimo_pgto
                       from notasvendas nv
                          , classificacoesnotasvendas cn
                       where nv.idnotavenda = cn.idnotavenda
                         and cn.idcaracteristicanotavenda = 52
                         and nv.idsituacaonotavenda = 4
                         and nv.saldo > 0 
                         and (:P747_SEMANA_COB_INICIO IS NULL or nv.idsemanacobranca between :P747_SEMANA_COB_INICIO and nvl(:P747_SEMANA_COB_FIM, nv.idsemanacobranca)) /*T13528314*/) deb
                where ( :P747_TIPO = 'T'
                     or ( :P747_TIPO = 1 and info.sacola_aguardando_acerto - info.maior_sacola_com_debito = 1 )
                     or ( :P747_TIPO = 2 and info.sacola_aguardando_acerto - info.maior_sacola_com_debito > 1 ) )
                  and info.idvendedora = deb.idvendedora
                  and info.maior_sacola_com_debito = deb.nrsacola
                  -- 
                  -- Comentado no T13528314
                  /*and not exists ( select 1
                                   from favorita.tarefas t
                                      , notastarefasgeradaspap nt
                                   where nt.idtarefa = t.idtarefa
                                     and nt.idnotavenda = deb.idnotavenda
                                     and t.idsituacao = 0 )*/
                order by 2
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: partnerslRR
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P747_TIPO_RELATORIO = 2 and :P747_FILTRAR = 'S'
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum dado encontrado, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 2118953961077156350
        }

