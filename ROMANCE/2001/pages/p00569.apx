    region top-10-cobradores (
        name: Top 10 Cobradores
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select w.distribuidor distribuidor
                     , round(sum(valornegociacao)) valornegociacao
                from vw_negociacoesparceiros w
                --where datanegociacao  between to_date('01/05/2020 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date('05/05/2020 23:59:59','DD/MM/RRRR  hh24:mi:ss')
                where datanegociacao  between to_date(:P569_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P569_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                  and w.idfilial = :P0_IDFILIAL
                  and w.origem   = 'C'
                group by w.distribuidor
                order by 2 desc
                ```
            pageItemsToSubmit: [
                P569_DATAINICIO
                P569_DATAFIM
            ]
