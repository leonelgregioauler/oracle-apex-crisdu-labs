    region utilização-por-empresa (
        name: Utilização por Empresa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.nome                                 empresa
                     , w.qddistribuidores                     distribuidoresnaempresa
                     , l.distribuidores_logaram               distribuidores_logaram   
                     , l.qtd_logins                           qtd_logins                           
                  
                     , nvl(( select sum(n.valornegociacao) 
                             from vw_negociacoesparceiros n
                             where n.idfilial = w.idfilial
                               and n.origem = 'C'
                               and datanegociacao  between to_date(:P569_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P569_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                               ),0) valornegociacao                     
                     , nvl(( select sum(n.valorconfirmado) 
                             from vw_negociacoesparceiros n
                             where n.idfilial = w.idfilial 
                               and n.origem = 'C'
                               and datanegociacao  between to_date(:P569_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P569_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                               ),0) valorconfirmado
                     , nvl(( select sum(n.valornegociacao-nvl(n.valorconfirmado,0)) 
                             from vw_negociacoesparceiros n
                             where n.idfilial = w.idfilial 
                               and n.origem = 'C'
                               and datanegociacao  between to_date(:P569_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P569_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                               ),0) valorpendente
                     , ( select count(1) 
                         from vw_negociacoesparceiros n
                         where n.idfilial = w.idfilial  
                           and n.origem = 'C'
                           and datanegociacao  between to_date(:P569_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P569_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                           ) qtd_negociacoes
                     , nvl(( select sum(c.valorpago)
                             from vw_comissoes_cobraki_paga c
                             where c.idfilial = w.idfilial 
                               and c.datapagamento between to_date(:P569_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P569_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                               ),0) comissaopaga
                from vw_filiais w
                   , ( select r.idgerente
                            , count(distinct r.idrepresentante)  distribuidores_logaram  
                            , count(1)                         qtd_logins                                             
                         from logsnegociacoesparceiros ll
                            , representantes           r
                         where ll.idrepresentante      = r.idrepresentante
                           and data  between to_date(:P569_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P569_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')           
                         group by r.idgerente )    l
                where w.tipofilial = 'D'
                  and w.ativo      = 'S'      
                  and w.idgerente  = l.idgerente
                  and w.idfilial   = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
