    process inicia-filtro (
        name: Inicia Filtro
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P569_DATAINICIO is null then
                    :P569_DATAINICIO := '01/04/2020';--to_char(trunc(sysdate),'DD/MM/RRRR');
                  end if;
                  --
                  if :P569_DATAFIM is null then
                    :P569_DATAFIM := to_char(trunc(sysdate),'DD/MM/RRRR');
                  end if;
                  --
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 40652046309587494
        }
    )

