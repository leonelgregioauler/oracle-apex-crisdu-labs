                    where datanegociacao  between to_date(:P569_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P569_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                      and w.idfilial = :P0_IDFILIAL
                      and w.origem   = 'C'
                    group by trunc(datanegociacao) 
                    order by 1
                    ```
                pageItemsToSubmit: [
                    P569_DATAINICIO
                    P569_DATAFIM
                ]
            }
            columnMapping {
                label: DATANEGOCIACAO
                value: VALORNEGOCIACAO
                customColumn: QTDISTRIBUIDORES
            }
            marker {
                show: true
                shape: circle
            }
            label {
                show: true
                position: aboveMarker
            }
        )

