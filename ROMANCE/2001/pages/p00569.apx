    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--large
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region negociações (
        name: Negociações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.distribuidor 
                     , round(sum(valornegociacao)) valornegociacao
                     , round(sum(valorconfirmado)) valorconfirmado
                     , nvl(( select sum(cp.valorpago) 
                             from vw_comissoes_cobraki_paga cp
                             where cp.idrepresentante = w.idrepresentante
                               and cp.datapagamento between to_date(:P569_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P569_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss') ),0) valorcomissao
                     , nvl(( select sum(cn.valorcomissao) 
                             from vw_comissoes_pagar_neg cn
                             where cn.idrepresentante = w.idrepresentante ),0) valorcomissaopendente
                from vw_negociacoesparceiros w
                where datanegociacao    between to_date(:P569_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P569_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                  and w.idfilial        = :P0_IDFILIAL
                  and w.origem          = 'C'
                group by w.distribuidor
                       , w.idrepresentante
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4547299913949223199
        }

