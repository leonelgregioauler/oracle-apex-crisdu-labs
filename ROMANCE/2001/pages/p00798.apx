    region classificações-brindes-conquistou-levou (
        name: Classificações Brindes Conquistou Levou
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select apex_item.CHECKBOX2(2, cl.idclassificacao , null) as check1
                     , cl.idclassificacao
                     , cl.nomeclassif 
                from ROMAN.CONQUISTOULEVOUCLASSIFICACOES cl
                order by 2
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1800621860280552903
        }

