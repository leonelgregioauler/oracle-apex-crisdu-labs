    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 10
            region: @classificações-brindes-conquistou-levou
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @cadastro-classificações
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process processo-cadastro-classificacao (
        name: Processo Cadastro Classificacao
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vseq number;
                  vteste number;
                  v_qtd_class number;
                  --
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'EXCLUIR' then
                    --
                    voperacao_dml := 'E';
                    --
                  end if;
                  --
                  if voperacao_dml = 'I' then 
                    --
                    select roman.seq_idclasconqlev.nextval
                      into vseq
                    from dual;
                    --
                    insert into ROMAN.CONQUISTOULEVOUCLASSIFICACOES(IDCLASSIFICACAO, NOMECLASSIF)
                    values (vseq, :P798_CLASSIFICACAO);
                    --
                    apex_application.g_print_success_message := '<span style="color : white ">Classificação Cadastrada com sucesso! </span>'; 
                    --
                    elsif voperacao_dml = 'E' then  
                      --raise_application_error(-20001,'passei aqui');
                      -- Loop através de cada item no array
                      --
                      FOR i IN 1..APEX_APPLICATION.G_F02.COUNT 
                        LOOP
                          --
                          begin 
                            --
                            select cl.idclassifbrindeclub
                              into vteste
                            from roman.classificacoesbrindesclub cl
                            where cl.idclassificacao = APEX_APPLICATION.G_F02(i);
                            --raise_application_error(-20001,'xxxxx');
                            --
                            exception 
                              when others then 
                                vteste := null;
                          end;
                          --
                          if vteste is null then 
                            --
                            -- 1) Valida se existe classificação vinculada ao brinde
                            select count(*)
                              into v_qtd_class
                              from roman.classificacoesbrindesclub cb
                             where cb.idclassificacao = APEX_APPLICATION.G_F02(i);
                
                            if v_qtd_class > 0 then
                              raise_application_error(
                                -20001,
                                'Não é possivel excluir, classificação já vinculada a um brinde');
                            end if;
                            --
                            delete ROMAN.CONQUISTOULEVOUCLASSIFICACOES cc
                            where cc.idclassificacao = APEX_APPLICATION.G_F02(i);
                            --
                            --else 
                            --
                            --RAISE_APPLICATION_ERROR(-20002,'Não é possivel excluir, classificação já vinculada a um brinde');
                            --
                          end if; 
                        END LOOP;
                        --
                        apex_application.g_print_success_message := '<span style="color : white ">Exclusão realizada com sucesso! </span>';
                        --
                  end if;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1800622448097552909
        }
    )

    branch (
        name: Go To Page 798
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 798
                items: {
                    P798_CLASSIFICACAO:
                }
                clearCache: 798
            }
        }
    )

)

