page 196 (
    name: Histórico de Pendência de Depósitos
    title: Histórico de Pendência de Depósitos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region depósitos-com-pendências (
        name: Depósitos com pendências
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select beneficiario
                         from contasbancarias b
                         where b.idcontabanc = d.idcontabanc ) Beneficiario
                     , d.data
                     , decode(pendencia,'MA', 'Valor Maior'
                                       ,'ME', 'Valor Menor'
                                       ,'NL', 'Não Localizado' ) pendencia
                     , d.valordeposito
                     , valorlocalizado
                     , observacao
                     , d.nrocomprovante
                     , decode(d.resolvido,null,'Não','Sim') resolvido
                     , d.dataresolvido
                     , ( select semana 
                         from fechamentossemanais f
                         where f.idfechamento = ( select idfechamento 
                                                  from fechamentorepresentantes ff 
                                                  where ff.idfechamentorepres = d.idfechamentorepres ) ) Fechamento
                from depositosdiarios_orig d
                where d.pendencia is not null
                  and resolvido is null
                  and idrepresentante = :P196_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from depositosdiarios_orig d
                where d.pendencia is not null
                  and resolvido is null
                  and idrepresentante = :P196_IDREPRESENTANTE
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 276776101144321463
        }

