page 179 (
    name: Histórico de Pontos
    title: Histórico de Pontos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region histórico-de-pontos (
        name: Histórico de Pontos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select data
                     , ( select n.numeronota from roman.notasvendas n where n.idnotavenda = m.idnotavenda ) "Nr Nota"
                     , nvl(( select n.valorpago from roman.notasvendas n where n.idnotavenda = m.idnotavenda ),0)
                     + nvl((select SUM(p.valor)
                              from roman.pepinosrepresentantes p
                              where p.idnotavenda = m.idnotavenda
                                and p.situacao    = 'P' ),0) "Valor Pago"
                     , ( select p.nrpedido from catal.pedidos p where p.idpedido = m.idpedidofavorita
                         union
                         select to_char(pp.idpedido) from favorita.pedidos pp where pp.idpedido = m.idpedidofavorita) "Nr Pedido"
                     , pontos
                     , observacao
                from roman.movimentospontosvendedoras m
                where idvendedora = :P179_IDVENDEDORA
                order by m.idmovtopontosvend desc;
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column "Nr Nota" (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Nr nota
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column "Nr Pedido" (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Nr pedido
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column PONTOS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Pontos
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column "Valor Pago" (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Valor pago
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P179_IDVENDEDORA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @histórico-de-pontos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

