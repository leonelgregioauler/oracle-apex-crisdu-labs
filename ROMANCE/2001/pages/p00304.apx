    region legenda (
        name: Legenda
        type: staticContent
        source {
            htmlCode:
                ```html
                Origem Distribuidor:<br>
                <b>- Próprio</b> = Distribuidor quem cadastrou a Sacola da Empreendedora<br>
                <b>- Distribuidor Atende</b> = Distribuidor está responsável pelo atendimento da Sacola deixada por outro Distribuidor.
                ```
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region notas-em-aberto-chamado-pág (
        name: Notas Em Aberto (Chamado Pág 75)
        title: Notas Em Aberto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , to_number(nv.numeronota) numeronota
                     , nv.datanota
                     , nv.semanadistribuicao "Semana Distribuição"
                     , nv.semanacobranca "Semana Cobrança"
                     , pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) "Vendedora"
                     , rv.descricao "Região Venda"
                     , nv.valortotalnota
                     , nv.valortotaldevolucao
                     , nv.valortotalvenda
                     , nv.basecomissao
                     , nv.perccomissao
                     , nv.valorcomissao
                     , nv.valortotalvenda - nv.valorcomissao valorpagar
                     , nv.valorpago
                     , nv.saldo
                     , ( select sn.descricao from situacoesnotavenda sn where sn.idsituacaonotavenda = nv.idsituacaonotavenda ) "Situação"
                     , decode(nv.quitadapepino,'Q','Quitado','P','Inadimplente','R','Remarcada') "Quitado/Pepino"
                     , pck_util.fnc_idsemana(nv.semanacobranca) - pck_util.fnc_idsemana(nv.semanadistribuicao) intervalo
                     , case 
                        when exists ( select 1 
                                       from notasvendas nn
                                       where nn.idvendedora          = nv.idvendedora
                                         and nn.idnotavenda          != nv.idnotavenda
                                         and nn.idsituacaonotavenda != 5 ) then
                          'Não'
                        else
                          'Sim'
                        end "Abertura"
                     , pck_util.fnc_retornatelefones(vv.idpessoa) telefones
                     , pck_romance.fnc_enderecovendedora(vv.idvendedora) "Endereço"
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' irparanota
                     , case
                         when nv.idrepresentante = :P304_IDREPRESENTANTE then
                           'Proprio'
                         else
                           'Distribuidor Atende'
                       end origem_distribuidor
                from roman.notasvendas    nv
                   , catal.vendedoras     vv
                   , roman.regioesvenda   rv
                where nv.idvendedora   = vv.idvendedora
                  and nv.idregiaovenda = rv.idregiaovenda
                  and nv.idfilial      = :P0_IDFILIAL
                  and ( nv.idrepresentante = :P304_IDREPRESENTANTE
                     or nv.idrepresentanteatende = :P304_IDREPRESENTANTE )
                  and nv.semanacobranca = pck_romance.fnc_proximasemana(:P304_SEMANA)
                  and nv.idsituacaonotavenda = 3
                  and pck_util.fnc_idsemana(nv.semanacobranca) - pck_util.fnc_idsemana(nv.semanadistribuicao) > to_number(pck_controle_rmc.fnc_retornaparametronetbook('SEMANASDEATENDIMENTO',nv.idfilial))
                ```
        }
