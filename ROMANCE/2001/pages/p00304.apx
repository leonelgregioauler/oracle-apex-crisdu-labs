    region notas-em-aberto-chamado-pág-2 (
        name: Notas Em Aberto (Chamado Pág 183)
        title: Notas Em Aberto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , to_number(nv.numeronota) numeronota
                     , nv.datanota
                     , nv.semanadistribuicao/*||'  '||pck_romance.fnc_semanadias(psemana => nv.semanadistribuicao)*/ "Semana Distribuição"
                     , nv.semanacobranca/*||'  '||pck_romance.fnc_semanadias(psemana => nv.semanacobranca)*/ "Semana Cobrança"
                     , pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) "Vendedora"
                     , rv.descricao "Região Venda"
                     , nv.valortotalnota
                     , nv.valortotaldevolucao
                     , nv.valortotalvenda
                     , nv.basecomissao
                     , nv.perccomissao
                     , nv.valorcomissao
                     , nv.valortotalvenda - nv.valorcomissao valorpagar
                     , nv.valorpago
                     , nv.saldo
                     , ( select sn.descricao from situacoesnotavenda sn where sn.idsituacaonotavenda = nv.idsituacaonotavenda ) "Situação"
                     , decode(nv.quitadapepino,'Q','Quitado','P','Inadimplente','R','Remarcada') "Quitado/Pepino"
                     , pck_util.fnc_idsemana(nv.semanacobranca) - pck_util.fnc_idsemana(nv.semanadistribuicao) intervalo
                     , case 
                        when exists ( select 1 
                                       from notasvendas nn
                                       where nn.idvendedora          = nv.idvendedora
                                         and nn.idnotavenda          != nv.idnotavenda
                                         and nn.idsituacaonotavenda != 5 ) then
                          'Não'
                        else
                          'Sim'
                        end "Abertura"
                     , pck_util.fnc_retornatelefones(vv.idpessoa) telefones
                     , pck_romance.fnc_enderecovendedora(vv.idvendedora) "Endereço"
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' irparanota
                     , case
                         when nv.idrepresentante = :P304_IDREPRESENTANTE then
                           'Proprio'
                         else
                           'Distribuidor Atende'
                       end origem_distribuidor
                from notasvendas    nv
                   , vendedoras     vv
                   , regioesvenda   rv
                where nv.idvendedora   = vv.idvendedora
                  and nv.idregiaovenda = rv.idregiaovenda
                  and nv.idnotavenda in (   -- UNIÃO 1
                                            select nv.idnotavenda
                                              from roman.impnettoservidor i,
                                                   roman.notasvendas nv
                                             where nv.idrepresentante = i.idrepresentante
                                               and nv.idsemanacobranca = i.idsemana + 1
                                               and nv.idsituacaonotavenda = 3
                                               and (nv.idsemanacobranca - nv.idsemanadistribuicao) >= 7
                                               and i.idsemana >= 615
                                               and i.idfilial = :P0_IDFILIAL 
                                               and (:P304_IDREPRESENTANTE = -1 or i.idrepresentante = :P304_IDREPRESENTANTE)
                                               and (:P0_IDPOSTOAVANCADO is null or exists (select 1 
                                                                                             from catal.representantes r 
                                                                                            where r.idrepresentante = i.idrepresentante 
                                                                                              and r.idpostoavancado = :P0_IDPOSTOAVANCADO))
                                               and exists (select 1 
                                                             from roman.fechamentorepresentantes f,
                                                                  roman.fechamentossemanais ff
                                                            where f.idfechamentopontuacao = ff.idfechamento
                                                              and f.idrepresentante = i.idrepresentante
                                                              and ff.semana = i.semana
                                                              and ff.concluido = 'N')
                
                                            union all
                                            -- UNIÃO 2
                                            select nv.idnotavenda
                                              from roman.impnettoservidor i,
                                                   roman.notasvendas nv
                                             where nv.idrepresentante = i.idrepresentante
                                               and nv.idsemanacobranca = i.idsemana + 1
                                               and nv.idsituacaonotavenda = 3
                                               and (nv.idsemanacobranca - nv.idsemanadistribuicao) >= 7
                                               and i.idsemana >= 615
                                               and i.idfilial = :P0_IDFILIAL 
                                               and (:P304_IDREPRESENTANTE = -1 or i.idrepresentante = :P304_IDREPRESENTANTE)
                                               and (:P0_IDPOSTOAVANCADO is null or exists (select 1 
                                                                                             from catal.representantes r 
                                                                                            where r.idrepresentante = i.idrepresentante 
                                                                                              and r.idpostoavancado = :P0_IDPOSTOAVANCADO))
                                               and not exists (select 1 
                                                                 from roman.fechamentorepresentantes f,
                                                                      roman.fechamentossemanais ff
                                                                where f.idfechamentopontuacao = ff.idfechamento
                                                                  and f.idrepresentante = i.idrepresentante
                                                                  and ff.semana = i.semana)
                
                                            union all
                                            -- UNIÃO 3
                                            select nv.idnotavenda
                                              from roman.preacertorepresentantes i,
                                                   roman.notasvendas nv
                                             where nv.idrepresentante = i.idrepresentante
                                               and nv.idsemanacobranca = i.idsemana
                                               and nv.idsituacaonotavenda = 3
                                               and i.idsemana >= 615
                                               and i.idfilial = :P0_IDFILIAL 
                                               and (:P304_IDREPRESENTANTE = -1 or i.idrepresentante = :P304_IDREPRESENTANTE)
                                               and (:P0_IDPOSTOAVANCADO is null or exists (select 1 
                                                                                             from catal.representantes r 
                                                                                            where r.idrepresentante = i.idrepresentante 
                                                                                              and r.idpostoavancado = :P0_IDPOSTOAVANCADO))
                                               and not exists (select 1 
                                                                 from roman.impnettoservidor imp
                                                                where imp.idrepresentante = i.idrepresentante
                                                                  and imp.semana = i.semana));
                ```
        }
