page 739 (
    name: Consulta Exclusões/Alterações
    title: Consulta Exclusões/Alterações
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region consulta-exclusões-alterações (
        name: Consulta Exclusões/Alterações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select lpg.usuarioalteracao 
                      , decode(lpg.tipoalteracao,'INSERT','Incluído','UPDATE','Alteração','DELETE','Exclusão') tipoalteracao
                      , lpg.datapagamento
                      , lpg.valorpago
                      , lpg.semanacobranca
                      , lpg.observacao
                      , lpg.origem
                      , lpg.dataalteracao
                      , nv.numeronota
                      , nv.saldo
                      , nv.idnotavenda as id_nota
                      , nv.idvendedora as id_vendedora
                      , case
                          when exists (
                                 select 1
                                 from roman.notasvendas nv2
                                 where nv2.idvendedora         = nv.idvendedora
                                   and nv2.idnotavenda         != nv.idnotavenda
                                   and nv2.idsituacaonotavenda  = 4
                                   and nv2.saldo                > 0
                               )
                          then 'Sim'
                          else 'Não'
                        end as outra_nota_debito
                        , case
                          when exists (
                                 select 1
                                 from roman.notasvendas nv3
                                 where nv3.idvendedora        = nv.idvendedora
                                   and nv3.idsituacaonotavenda = 3
                               )
                          then 'Sim'
                          else 'Não'
                        end as nota_aguardando_acerto
                      , pv.cpf as cpf_consultora
                      , pv.nomepessoa as nome_consultora
                      , nv.idrepresentante as id_distribuidor
                      , pr.cpf as cpf_distribuido
                      , pr.nomepessoa as nome_distribuidor
                 from logroman.log_pagamentosnotasvendas lpg,
                      roman.notasvendas nv,
                      catal.vendedoras v,
                      catal.pessoas pv,
                      catal.representantes r,
                      catal.pessoas pr
                where nv.idnotavenda = lpg.idnotavenda
                  and v.idvendedora = nv.idvendedora
                  and pv.idpessoa = v.idpessoa
                  and r.idrepresentante = nv.idrepresentante
                  and pr.idpessoa = r.idpessoa
                  and nv.idfilial = :P0_IDFILIAL
                  --and nv.dataacerto between nvl(:P739_DATA_INICIO,sysdate) and nvl(:P739_DATA_FIM,sysdate)
                  and trunc(lpg.dataalteracao) between nvl(:P739_DATA_INICIO,sysdate) and nvl(:P739_DATA_FIM,sysdate) --Alteração realizada 14934691 - osiel
                  and (:P739_ID_NOTA is null or nv.idnotavenda = :P739_ID_NOTA)
                  AND (:P739_TIPO_ALTERACAO is null or lpg.tipoalteracao = :P739_TIPO_ALTERACAO)
                order by lpg.dataalteracao;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
