page 494 (
    name: Parametros App Romance
    title: Parametros App Romance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region parametros-app-romance (
        name: Parametros App Romance
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDCADASTROPARAMETROVEND,
                       IDFILIAL,
                       PARAMETRO,
                       VALOR,
                       OBSERVACAO
                  from CADASTROSPARAMETROSVEND
                where idfilial = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 235873812139383195
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDCADASTROPARAMETROVEND
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDFILIAL
                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @PARAMETRO
                layout {
                    width: 305
                    sequence: 3
                }
            )

            displayColumn (
                column: @VALOR
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @OBSERVACAO
                layout {
                    sequence: 4
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDCADASTROPARAMETROVEND (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDCADASTROPARAMETROVEND
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDFILIAL (
            type: numberField
            heading {
                heading: Idfilial
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column OBSERVACAO (
            type: textarea
            heading {
                heading: Observacao
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: OBSERVACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column PARAMETRO (
            type: textarea
            heading {
                heading: Parametro
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: PARAMETRO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column VALOR (
            type: textarea
            heading {
                heading: Valor
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 2000
            }
            source {
                databaseColumn: VALOR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @parametros-app-romance
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 235878609708383204
        }
    )

)

