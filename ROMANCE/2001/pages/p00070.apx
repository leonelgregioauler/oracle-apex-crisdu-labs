page 70 (
    name: Entradas Diversas
    title: Entradas Diversas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region entradas (
        name: Entradas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana
                     , ano "Ano"
                     , semana "Semana"
                     , idfechamento
                     , identrada
                     , idfilial
                     , filial Filial
                     , Filialorig
                     , Filialdestino
                     , data
                     , mes "Mês"
                     , fechamentoorig
                     , conta
                     , subconta
                     , valortotal
                     , descricao
                     , Tipo
                     , tipoentrada "Tipo Entrada"
                     , DESCRICAOORIGEM "Descrição da Origem" 
                     , ( select me.classificacaoentrada
                         from matrizclassificacoesentradas me
                         where me.idmatrizentrada = t.idmatrizentrada ) "Classificação"
                from vw_entradas_distribuidoras t
                where t.idfilial     = :P0_IDFILIAL
                  and (:P0_IDFECHAMENTO = 999999999999 or t.idfechamento = :P0_IDFECHAMENTO )
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma entrada confirmada.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column Ano (
            type: plainText
            heading {
                heading: Ano
                alignment: center
            }
            layout {
                sequence: 11
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Ano
                endUserAlias: AK
            }
            enableUsersTo {
                pivot: false
            }
        )

        column CONTA (
            type: plainText
            heading {
                heading: Conta
            }
            layout {
                sequence: 81
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: CONTA
                endUserAlias: AB
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Classificação (
            type: plainText
            heading {
                heading: Classificação
                alignment: center
            }
            layout {
                sequence: 191
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AN
            }
        )

        column DATA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 61
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DATA
                endUserAlias: Z
            }
            enableUsersTo {
                pivot: false
            }
        )

