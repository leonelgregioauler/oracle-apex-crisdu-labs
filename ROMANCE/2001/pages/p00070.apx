        )

        column VALORTOTAL (
            type: plainText
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 101
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: VALORTOTAL
                endUserAlias: AD
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 1509900 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn "Ano" (
                sequence: 11
            )

            displayColumn CONTA (
                sequence: 5
            )

            displayColumn "Classificação" (
                sequence: 4
            )

            displayColumn DESCRICAO (
                sequence: 7
            )

            displayColumn "Descrição da Origem" (
                sequence: 8
            )

            displayColumn FILIALDESTINO (
                sequence: 3
            )

            displayColumn FILIALORIG (
                sequence: 2
            )

            displayColumn IDENTRADA (
                sequence: 1
            )

            displayColumn SUBCONTA (
                sequence: 6
            )

            displayColumn "Semana" (
                sequence: 10
            )

            displayColumn VALORTOTAL (
                sequence: 9
            )

            sort (
                column: "Ano"
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            sort (
                column: "Semana"
                sort {
                    direction: desc
                    sequence: 2
                }
            )

            aggregate (
                column: VALORTOTAL
            )

            controlBreak (
                column: "Ano"
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: "Semana"
                layout {
                    sequence: 2
                }
            )

        )

    )

    button confirmar-entrada (
        buttonName: CONFIRMAR_ENTRADA
        label: Confirmar Entrada
        layout {
            sequence: 10
            region: @entradas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 71
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button novaentrada (
        buttonName: NOVAENTRADA
        label: Nova Entrada
        layout {
            sequence: 20
            region: @entradas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 72
                items: {
                    P72_IDFECHAMENTO: &P0_IDFECHAMENTO.
                    P72_IDFILIAL: &P0_IDFILIAL.
                    P72_IDENTRADA:
                }
                clearCache: 99
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from fechamentossemanais f
                         where f.idfilial = :P0_IDFILIAL
                           and f.idfechamento = :P0_IDFECHAMENTO
                           and f.concluido = 'N' )
                and pck_util.fnc_verificaacesso(pidaplicacao => 4036, pusuario => v('APP_USER')) = 'S'
                ```
        }
    )

)

