            }
            advanced {
                htmlDomId: FILIALORIG
                endUserAlias: AG
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDENTRADA (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 41
                columnAlignment: center
            }
            link {
                target: {
                    page: 72
                    items: {
                        P72_IDENTRADA: #IDENTRADA#
                    }
                }
                linkText: <img src="#IMAGE_PREFIX#menu/pencil2_16x16.gif" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDENTRADA
                endUserAlias: X
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDFECHAMENTO (
            type: plainText
            heading {
                heading: Idfechamento
                alignment: center
            }
            layout {
                sequence: 1
