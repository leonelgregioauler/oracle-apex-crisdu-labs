page 98 (
    name: Anexar Arquivo
    title: Anexar Arquivo
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutStart
            js-dialog-class-t-Drawer--md
        ]
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region anexar-arquivo (
        name: Anexar Arquivo
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <font color="green">Você pode anexar mais de um arquivo.</font>
            footerText: <font color="red" size="5"> ===========>>> Após selecionar o arquivo, clique em anexar.</font>
        }
        settings {
            outputAs: text
        }
    )

    region botões (
        name: Botões
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region incluídos (
        name: Incluídos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDANEXOEVENTO,
                       IDCHAMADO,
                       ATTACH_DATA,
                       ATTACH_MIMETYPE,
                       ATTACH_FILENAME,
                       ATTACH_LAST_UPDATE,
                       ATTACH_CHARSET
                  from ANEXOSEVENTOS
                WHERE IDCHAMADO = :P98_IDCHAMADO
                  and publico = 'S'
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1 
                FROM ANEXOSEVENTOS
                WHERE IDCHAMADO = :P98_IDCHAMADO
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column ATTACH_CHARSET (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 7
            }
        )

        column ATTACH_DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column ATTACH_FILENAME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Arquivo
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column ATTACH_LAST_UPDATE (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 6
            }
        )

        column ATTACH_MIMETYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column IDANEXOEVENTO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column IDCHAMADO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

    )

    region passo-a-passo (
        name: Passo a Passo
        type: list
        source {
            list: @registrar-evento
        }
        layout {
            sequence: 30
            slot: dialogHeader
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    pageItem P98_ATTACH_CHARSET (
        type: hidden
        layout {
            sequence: 70
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACH_CHARSET
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P98_ATTACH_DATA (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            mimeTypeColumn: ATTACH_MIMETYPE
            filenameColumn: ATTACH_FILENAME
            charSetColumn: ATTACH_CHARSET
            bobLastUpdatedColumn: ATTACH_LAST_UPDATE
        }
        layout {
            sequence: 30
            region: @anexar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACH_DATA
            used: always
        }
    )

    pageItem P98_ATTACH_FILENAME (
        type: hidden
        layout {
            sequence: 50
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACH_FILENAME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P98_ATTACH_LAST_UPDATE (
        type: hidden
        layout {
            sequence: 60
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACH_LAST_UPDATE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P98_ATTACH_MIMETYPE (
        type: hidden
        layout {
            sequence: 40
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACH_MIMETYPE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P98_IDANEXOEVENTO (
        type: hidden
        layout {
            sequence: 10
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXOEVENTO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P98_IDCHAMADO (
        type: hidden
        layout {
            sequence: 20
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCHAMADO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar ao Evento
        layout {
            sequence: 40
            region: @anexar-arquivo
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 85
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar o arquivo que selecionei
        layout {
            sequence: 20
            region: @anexar-arquivo
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P98_IDANEXOEVENTO
        }
    )

    button finalizar (
        buttonName: FINALIZAR
        label: Finalizar
        layout {
            sequence: 10
            region: @botões
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 99
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @anexar-arquivo
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P98_IDANEXOEVENTO
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process fetch-row-from-anexoseventos (
        name: Fetch Row from ANEXOSEVENTOS
        type: autoRowFetch
        source {
            tableName: ANEXOSEVENTOS
            pkColumn: IDANEXOEVENTO
            pkItem: P98_IDANEXOEVENTO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 16416907483063797
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P98_IDANEXOEVENTO is null then
                        select "#OWNER#"."SEQ_IDANEXOEVENTO".nextval
                          into :P98_IDANEXOEVENTO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 16417287992063798
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexoseventos (
        name: Process Row of ANEXOSEVENTOS
        type: autoRowProcessing
        target {
            tableName: ANEXOSEVENTOS
            pkColumn: IDANEXOEVENTO
            pkItem: P98_IDANEXOEVENTO
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 16417731108063798
        }
    )

    branch (
        name: limpa PK
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 98
                items: {
                    P98_IDANEXOEVENTO:
                    P98_IDCHAMADO: &P98_IDCHAMADO.
                }
                action: resetPagination
            }
        }
    )

)

