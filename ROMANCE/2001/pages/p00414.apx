page 414 (
    name: Produtividade Reembalagem Empresas
    title: Produtividade Reembalagem Empresas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region produtividade (
        name: Produtividade
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*select pck_util.fnc_semanaid(s.idsemana) semana
                     , nvl(dev.qtd,0) devolucao
                     , nvl(emb.qtd,0) embalagem
                     , nvl(dev.qtd,0) - nvl(emb.qtd,0) saldo
                from semana_dias s
                   , catal.filiais f
                   , ( select d.idsemana, d.idfilial
                            , sum( nvl(it.qtd_pp,0)
                                 + nvl(it.qtd_p,0)
                                 + nvl(it.qtd_m,0)
                                 + nvl(it.qtd_g,0)
                                 + nvl(it.qtd_gg,0)
                                 + nvl(it.qtd_egg,0)
                                 + nvl(it.qtd_exgg,0)
                                 + nvl(it.qtd_u,0)) qtd
                       from devolucoesrepresentantes d
                          , itensdevolucaorepres it
                       where it.iddevolucaorepres = d.iddevolucaorepres
                         and it.estoquedestino    = 'R'
                         and ( :P414_IDFILIAL is null or d.idfilial = :P414_IDFILIAL )
                       group by d.idsemana, d.idfilial ) dev
                   , ( select mr.idsemana, mr.idfilial
                            , sum( nvl(mr.qtd_pp,0)
                                 + nvl(mr.qtd_p,0)
                                 + nvl(mr.qtd_m,0)
                                 + nvl(mr.qtd_g,0)
                                 + nvl(mr.qtd_gg,0)
                                 + nvl(mr.qtd_egg,0)
                                 + nvl(mr.qtd_exgg,0)
                                 + nvl(mr.qtd_u,0) )*-1 qtd
                       from movimentosestoquereemb mr
                       where ( :P414_IDFILIAL is null or mr.idfilial = :P414_IDFILIAL )
                         and mr.transfereparaestoque = 'D'
                       group by mr.idsemana, mr.idfilial ) emb
                where s.idsemana between :P414_IDSEMANAINICIO and :P414_IDSEMANAFIM
                  and emb.idsemana(+) = s.idsemana
                  and dev.idsemana(+) = s.idsemana
                  and emb.idfilial = f.idfilial
                  and dev.idfilial = f.idfilial
                order by s.idsemana desc*/
                
                --new
                select favorita.pck_util_fav.fnc_nomefilialromance(f.idfilial) filial
                     , pck_util.fnc_semanaid(s.idsemana) semana
                     , nvl(dev.qtd,0) devolucao
                     , nvl(emb.qtd,0) embalagem
                     , nvl(dev.qtd,0) - nvl(emb.qtd,0) saldo
                from semana_dias s
                   , catal.filiais f
                   , ( select d.idsemana, d.idfilial
                            , sum(nvl(it.qtd_pp,0)+nvl(it.qtd_p,0)+nvl(it.qtd_m,0)+nvl(it.qtd_g,0)
                                 +nvl(it.qtd_gg,0)+nvl(it.qtd_egg,0)+nvl(it.qtd_exgg,0)+nvl(it.qtd_u,0)) qtd
                       from devolucoesrepresentantes d, itensdevolucaorepres it
                       where it.iddevolucaorepres = d.iddevolucaorepres
                         and it.estoquedestino    = 'R'
                         and ( :P414_IDFILIAL is null or d.idfilial = :P414_IDFILIAL )
                       group by d.idsemana, d.idfilial ) dev
                   , ( select mr.idsemana, mr.idfilial
                            , sum(nvl(mr.qtd_pp,0)+nvl(mr.qtd_p,0)+nvl(mr.qtd_m,0)+nvl(mr.qtd_g,0)
                                 +nvl(mr.qtd_gg,0)+nvl(mr.qtd_egg,0)+nvl(mr.qtd_exgg,0)+nvl(mr.qtd_u,0))*-1 qtd
                       from movimentosestoquereemb mr
                       where ( :P414_IDFILIAL is null or mr.idfilial = :P414_IDFILIAL )
                         and mr.transfereparaestoque = 'D'
                       group by mr.idsemana, mr.idfilial ) emb
                where s.idsemana between :P414_IDSEMANAINICIO and :P414_IDSEMANAFIM
                  and ( :P414_IDFILIAL is null or f.idfilial = :P414_IDFILIAL )
                  and dev.idsemana(+) = s.idsemana
                  and dev.idfilial(+) = f.idfilial
                  and emb.idsemana(+) = s.idsemana
                  and emb.idfilial(+) = f.idfilial
                order by f.idfilial, s.idsemana desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros informados.
        }
        advanced {
            savedReportMappingIdentifier: 1466843463790105349
        }

