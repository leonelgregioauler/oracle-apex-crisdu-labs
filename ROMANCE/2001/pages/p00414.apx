    )

    pageItem P414_IDFILIAL (
        type: selectList
        label {
            label: Empresa Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome display_value
                     , f.idfilial return_value
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P414_IDSEMANAFIM (
        type: selectOne
        label {
            label: Até Semana
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(s.semana,'00')||'/'||to_char(s.ano)) semana
                     , s.idsemana
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-1 and to_char(sysdate,'RRRR')+1
                order by s.idsemana desc
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P414_IDSEMANAINICIO (
        type: selectOne
        label {
            label: De Semana
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(s.semana,'00')||'/'||to_char(s.ano)) semana
                     , s.idsemana
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-1 and to_char(sysdate,'RRRR')+1
                order by s.idsemana desc
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 414
                items: {
                    P414_IDSEMANAINICIO: &P414_IDSEMANAINICIO.
                    P414_IDSEMANAFIM: &P414_IDSEMANAFIM.
                    P414_IDFILIAL: &P414_IDFILIAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

