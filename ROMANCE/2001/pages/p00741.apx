    pageItem P741_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido,p.nomepessoa))  as display_value
                     , f.idfilial as return_value
                  from catal.filiais f
                     , catal.pessoas p
                 where p.idpessoa = f.idpessoa
                   and f.ativo = 'S'
                   and f.tipofilial  = 'D'
                 order by 1;
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
    )

    pageItem P741_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) || ' - (' || decode(r.ativo,'S','Ativo','Inativo') || ') - (' || r.idrepresentante || ')' display_value,
                       r.idrepresentante return_value
                  from catal.representantes r
                 order by 1;
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
