page 741 (
    name: Débitos de Distribuidores Romance
    title: Débitos de Distribuidores Romance
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region débitos-de-distribuidores-romance (
        name: Débitos de Distribuidores Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||n.idnotavenda ,'SESSION')||''',''_blank''); void(0)"><img src="/i/app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt=""></a>' as "Consulta"
                     , roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) || ' - (' || decode(r.ativo,'S','Ativo','Inativo') || ') - (' || r.idrepresentante || ')'as "Distribuidor"
                     , n.idnotavenda                        as "Número Nota"
                     , initcap(nvl(p.apelido,p.nomepessoa)) as "Filial"
                     , roman.pck_romance.fnc_nomevendedora(v.idvendedora) || ' - (' || decode(v.ativo,'S','Ativo','Inativo') || ') - (' || v.idvendedora || ')'as "Vendedora" 
                     , ( select NVL(regexp_replace(pp.cpf,'(\d{3})(\d{3})(\d{3})(\d{2})', '\1.\2.\3-\4'),pp.documentoestrangeiro) 
                         from catal.vendedoras vv
                            , catal.pessoas pp 
                         where vv.idpessoa = pp.idpessoa
                           and vv.idvendedora = n.idvendedora ) as "Documento"
                     , roman.pck_romance.fnc_retornatelefones(v.idvendedora)  Telefones
                     --, regexp_replace(roman.pck_romance.fnc_cpfvendedora(v.idvendedora), '(\d{3})(\d{3})(\d{3})(\d{2})', '\1.\2.\3-\4') as "Documento"
                     , s.descricao                          as "Situação"
                     , n.datanota                           as "Data Nota"
                     , n.valortotalnota  * n.fatorconversao as "R$ Valor Original Convertido"
                     , n.valortotalnota as "Valor Original"
                     , n.valortotalvenda * n.fatorconversao as "R$ Valor Venda Convertido"
                     , n.valortotalvenda as "Valor Venda"
                     , n.valorcomissao   * n.fatorconversao as "R$ Valor Comissão Convertido"
                     , n.valorcomissao as "Valor Comissão"
                     , n.valorpago       * n.fatorconversao as "R$ Valor Pago Convertido"
                     , n.valorpago as "Valor Pago"
                     , n.saldo           * n.fatorconversao as "R$ Saldo Convertido"
                     , n.saldo as "Saldo"
                     , roman.pck_util.fnc_calculajuros_v2( p_valor_debito => n.saldo,
                                                            p_data_venc    => n.dataretornoorig,
                                                            p_data_calc    => sysdate,
                                                            p_idpais       => catal.pck_util.fnc_paisvendedora(pidvendedora => n.idvendedora)) as "Valor Atualizado"         
                  from catal.representantes     r
                     , roman.notasvendas        n
                     , catal.vendedoras         v
                     , roman.situacoesnotavenda s
                     , catal.filiais            f
                     , catal.pessoas            p
                 where n.idrepresentante     = r.idrepresentante
                   and v.idvendedora         = n.idvendedora
                   and s.idsituacaonotavenda = n.idsituacaonotavenda
                   and f.idfilial            = n.idfilial
                   and p.idpessoa            = f.idpessoa
                   and n.idsituacaonotavenda = 4
                   and n.saldo               > 0
                   and n.datanota            between :P741_DATA_INICIAL_NOTA and :P741_DATA_FINAL_NOTA
                   and ( :P741_IDREPRESENTANTE is null or r.idrepresentante = :P741_IDREPRESENTANTE )
                   and ( ( :P741_SITUACAO_REPRESENTANTE = 'T' )                   or 
                         ( :P741_SITUACAO_REPRESENTANTE = 'A' and r.ativo = 'S' ) or
                         ( :P741_SITUACAO_REPRESENTANTE = 'I' and r.ativo = 'N' ))
                   and (:P741_IDFILIAL is null or n.idfilial = :P741_IDFILIAL)
                 order by 3,1,4;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
