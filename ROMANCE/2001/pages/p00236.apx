page 236 (
    name: Importar Arquivo Carga
    title: Importar Arquivo Carga
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function executar()
            {
             document.getElementById('loading').style.display="block";
              apex.submit('SYNC');
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region erro-importação (
        name: Erro Importação
        type: staticContent
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P236_CONTROLE
            value: P
        }
    )

    region erros-encontrados (
        name: Erros encontrados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.referencia
                 , e.dataerro
                 , e.idcarga
                 , e.observacao
                from erroimportacarga e
                where e.idfilial = :p236_idfilial
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Não foi encontrado erros.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 572424711302647752
        }

        column DATAERRO (
            type: plainText
            heading {
                heading: Data do erro
                alignment: center
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: dd/mm/rrrr HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DATAERRO
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDCARGA (
            type: plainText
            heading {
                heading: Carga
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: IDCARGA
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: OBSERVACAO
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column REFERENCIA (
            type: plainText
            heading {
                heading: Referência
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: REFERENCIA
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 5724253 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn DATAERRO (
                sequence: 2
            )

            displayColumn IDCARGA (
                sequence: 3
            )

            displayColumn OBSERVACAO (
                sequence: 4
            )

            displayColumn REFERENCIA (
                sequence: 1
            )

            sort (
                column: DATAERRO
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    region importar-arquivo (
        name: Importar Arquivo
        type: staticContent
        source {
            htmlCode:
                ```html
                <div id="loading" style="position:absolute; width:100%; text-align:center; top:300px; display:none;" >
                  <img src="http://romance.dyndns.tv:8888/apex/wwv_flow_file_mgr.get_file?p_security_group_id=1000002&p_fname=m2brloading3.gif" border=0>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        headerAndFooter {
            headerText: <font color="green"> Alterada a forma de importar carga. Primeiro selecione o arquivo e clique em "Importar Arquivo", após clique em "Processar"</font>
        }
    )

    pageItem P236_ARQUIVO (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        layout {
            sequence: 20
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVO
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P236_ROWID is null
                and NOT EXISTS ( select 1 
                from importacoescargas
                where idfilial = :P0_IDFILIAL)
                ```
        }
    )

    pageItem P236_CONTROLE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @importar-arquivo
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P236_IDFILIAL (
        type: hidden
        layout {
            sequence: 50
            region: @importar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return :P0_IDFILIAL;
                end;
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P236_ROWID (
        type: hidden
        layout {
            sequence: 10
            region: @importar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ROWID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Importar Arquivo
        layout {
            sequence: 40
            region: @importar-arquivo
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
            databaseAction: insert
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P236_ROWID is null
                and NOT EXISTS ( select 1 
                from importacoescargas
                where idfilial = :P0_IDFILIAL)
                ```
        }
    )

    button processar (
        buttonName: PROCESSAR
        label: Processar
        layout {
            sequence: 50
            region: @importar-arquivo
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from importacoescargas
                where idfilial = :P0_IDFILIAL
                ```
        }
    )

    button reiniciar (
        buttonName: REINICIAR
        label: Reiniciar Processo
        layout {
            sequence: 60
            region: @importar-arquivo
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                Select 1 
                from importacoescargas
                where idfilial = :P236_IDFILIAL
                ```
        }
    )

    dynamicAction create (
        name: CREATE
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @create
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CREATE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction deleta-arquivo-da-carga (
        name: Deleta arquivo da carga
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @reiniciar
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from importacoescargas
                    where idfilial = :P236_IDFILIAL;
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction processar (
        name: PROCESSAR
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @processar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: PROCESSAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction redirecionar (
        name: Redirecionar
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @reiniciar
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation p236-arquivo (
        name: P236_ARQUIVO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P236_ARQUIVO
        }
        error {
            errorMessage: Selecione o arquivo!
            associatedItem: @P236_ARQUIVO
        }
        serverSideCondition {
            type: request=Value
            value: CREATE
        }
    )

    process fetch-row-from-importacoescargas (
        name: Fetch Row from IMPORTACOESCARGAS
        type: autoRowFetch
        source {
            tableName: IMPORTACOESCARGAS
            pkColumn: ROWID
            pkItem: P236_ROWID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 578218087183781501
        }
    )

    process importa-arquivo (
        name: importa Arquivo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  pck_integracao.prc_importa_carga(pidfilial => :P0_IDFILIAL);
                  commit;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Arquivo processado! Caso a carga não tenha sido gerada, verifique os códigos de produto e representante.
        }
        advanced {
            executionMappingIdentifier: 578218474303781504
        }
        serverSideCondition {
            type: request=Value
            value: PROCESSAR
        }
    )

    process process-row-of-importacoescargas (
        name: Process Row of IMPORTACOESCARGAS
        type: autoRowProcessing
        target {
            tableName: IMPORTACOESCARGAS
            pkColumn: ROWID
            pkItem: P236_ROWID
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: "Arquivo importado, clique em PROCESSAR! "
        }
        advanced {
            executionMappingIdentifier: 578218255906781503
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 236
                items: {
                    P236_CONTROLE: I
                }
            }
        }
        serverSideCondition {
            type: request=Value
            value: CREATE
        }
    )

    branch (
        name: Processar
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 236
                items: {
                    P236_CONTROLE: P
                }
            }
        }
        serverSideCondition {
            type: request=Value
            value: PROCESSAR
        }
    )

)

