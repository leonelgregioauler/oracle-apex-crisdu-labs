        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 149
                items: {
                    P149_IDPEPINOSREPRESENTANTE: &P289_IDPEPINOREPRESENTANTE.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Adicionar
        layout {
            sequence: 30
            region: @históricos-débitos-antigos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P289_IDOBSPEPINOREPRESENTANTE
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 40
            region: @históricos-débitos-antigos
