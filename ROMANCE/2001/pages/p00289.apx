    process fetch-row-from-observacoespepinosrepres (
        name: Fetch Row from OBSERVACOESPEPINOSREPRES
        type: autoRowFetch
        source {
            tableName: OBSERVACOESPEPINOSREPRES
            pkColumn: IDOBSPEPINOREPRESENTANTE
            pkItem: P289_IDOBSPEPINOREPRESENTANTE
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 234114850835562648
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P289_IDOBSPEPINOREPRESENTANTE is null then
                        select "#OWNER#"."SEQ_IDOBSPEPINOSREPRES".nextval
                          into :P289_IDOBSPEPINOREPRESENTANTE
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 234115226694562649
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-observacoespepinosrepres (
        name: Process Row of OBSERVACOESPEPINOSREPRES
        type: autoRowProcessing
