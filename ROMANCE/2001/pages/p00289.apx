        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P289_IDOBSPEPINOREPRESENTANTE
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 20
            region: @históricos-débitos-antigos
