    pageItem P589_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            initialFetch: onUserRequest
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||decode(r.ativo,'S','Ativo','N','Inativo') d
                     , r.idrepresentante r
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente
                  and ( :P589_IDFILIAL is null or g.idfilial = :P589_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: "- Todos - "
        }
        cascadingLov {
            parentItems: P589_IDFILIAL
        }
