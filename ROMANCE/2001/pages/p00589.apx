                    P589_TIPO_DATA: &P589_TIPO_DATA.
                    P589_CAMPANHA_ESPECIAL: &P589_CAMPANHA_ESPECIAL.
                    P589_IDNEGOCIACAOPARCEIRO: &P589_IDNEGOCIACAOPARCEIRO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

