        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomepessoa) d
                     , u.idusuario r
                from pessoas p
                   , usuarios u
                where p.idpessoa = u.idpessoa
                  and u.idgerente = 80
                  and u.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: "- Todos - "
        }
        layout {
