    process verifica-visualizar-todos (
        name: Verifica Visualizar Todos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vacesso varchar2(1);
                begin
                  --
                  vacesso := pck_util.fnc_verificaacesso(2577,v('APP_USER'));
                  --
                  :P589_VISUALIZAR_TODOS := vacesso;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 4932741148470481344
        }
    )

    branch (
        name: Go To Page 589
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 589
                items: {
                    P589_IDVENDEDORA: &P589_IDVENDEDORA.
                    P589_IDREPRESENTANTE: &P589_IDREPRESENTANTE.
                    P589_IDFILIAL: &P589_IDFILIAL.
                    P589_IDRESPONSAVEL: &P589_IDRESPONSAVEL.
                    P589_SITUACAO: &P589_SITUACAO.
                    P589_DATAFIM: &P589_DATAFIM.
