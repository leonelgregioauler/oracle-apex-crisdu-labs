    region lista-de-acordos (
        name: Lista de Acordos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idnegociacaoparceiro
                     , w.filial
                     , w.representante
                     , w.vendedora
                     , w.documento
                     , w.datanegociacao
                     , w.valornegociacao
                     , w.valorquitado
                     , w.valoremespera
                     , w.formapgto
                     , w.conta
                     , w.observacao
                     , w.responsavel
                     , w.qtdparcelas
                     , boletomesenviado
                     , boletoemailenviado
                     , w.valorvigente
                     , w.valorvencido
                     , w.idnegociacaoparceiro id
                     , w.situacaoacordo
                     , w.origem_negociacao
                from vw_acordos_bee w 
                where ( :P589_TIPO_DATA is null
                    or ( :P589_TIPO_DATA = 'N' and w.datanegociacao between to_date(:P589_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P589_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                    or ( :P589_TIPO_DATA = 'V' and exists ( select 1
                                                            from pagamentosnegociacoesparceiros pp
                                                            where pp.idnegociacaoparceiro = w.idnegociacaoparceiro
                                                              and pp.datavencimento       between to_date(:P589_DATAINICIO,'DD/MM/RRRR') and to_date(:P589_DATAFIM,'DD/MM/RRRR') ) )
                    or ( :P589_TIPO_DATA = 'P' and exists ( select 1
                                                            from pagamentosnegociacoesparceiros pp
                                                            where pp.idnegociacaoparceiro = w.idnegociacaoparceiro
                                                              and trunc(pp.datapagamento) between to_date(:P589_DATAINICIO,'DD/MM/RRRR') and to_date(:P589_DATAFIM,'DD/MM/RRRR') ) )
                    or ( :P589_TIPO_DATA = 'B' and exists ( select 1
                                                            from pagamentosnegociacoesparceiros pp
                                                            where pp.idnegociacaoparceiro = w.idnegociacaoparceiro
                                                              and pp.databaixa between to_date(:P589_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P589_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) ) )
                  and ( :P589_IDRESPONSAVEL is null or w.idusuarioresponsavel = :P589_IDRESPONSAVEL )
                  and ( :P589_SITUACAO = 'T'
                     or ( :P589_SITUACAO = 'Q' and w.valorquitado > 0 )
                     or ( :P589_SITUACAO = 'E' and w.valoremespera > 0 )
                     or ( :P589_SITUACAO = 'A' and w.valornegociacao > w.valorquitado )
                     or ( :P589_SITUACAO = 'C' and w.situacaoacordo = 'Quebrado' ) ) -- cancelado T10400546
                  and ( :P589_IDFILIAL is null or w.idfilial = :P589_IDFILIAL )
                  and ( :P589_IDREPRESENTANTE is null or w.idrepresentante = :P589_IDREPRESENTANTE )
                  and ( :P589_IDVENDEDORA is null or w.idvendedora = :P589_IDVENDEDORA )
                  and ( :P589_FORMA_PGTO = 'A' or w.formapagamento = :P589_FORMA_PGTO )
                  and ( :P589_IDPAIS is null or w.idpais = :P589_IDPAIS)
                  and ( :P589_CAMPANHA_ESPECIAL = 'A' or w.campanhaespecial = :P589_CAMPANHA_ESPECIAL )
                  and ( :P589_IDNEGOCIACAOPARCEIRO is null or w.idnegociacaoparceiro = :P589_IDNEGOCIACAOPARCEIRO )
                  and ( :P589_ORIGEM_NEGOCIACAO = 'A'
                    or (:P589_ORIGEM_NEGOCIACAO = 'C' and w.origem_negociacao = 'Consultora')
                    or (:P589_ORIGEM_NEGOCIACAO = 'D' and w.origem_negociacao = 'Distribuidor'))
                  --and :P589_VISUALIZAR_TODOS = 'S'
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 249481340289264071
        }

