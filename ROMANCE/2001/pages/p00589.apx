    pageItem P589_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            initialFetch: onUserRequest
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' CPF: '||p.cpf d
                     , v.idvendedora r
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and ( :P589_IDREPRESENTANTE is null or v.idrepresentante = :P589_IDREPRESENTANTE )
                  and ( :P589_IDFILIAL is null or v.idfilial = :P589_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 100
            region: @filtros
