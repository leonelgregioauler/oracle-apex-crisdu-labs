    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 474
                items: {
                    P474_FILTRODATA: &P474_FILTRODATA.
                    P474_IDFILIAL: &P474_IDFILIAL.
                    P474_IDREPRESENTANTE: &P474_IDREPRESENTANTE.
                    P474_IDVENDEDORA: &P474_IDVENDEDORA.
                    P474_DATAINICIO: &P474_DATAINICIO.
                    P474_DATAFIM: &P474_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: BUSCAR
        }
    )

)

