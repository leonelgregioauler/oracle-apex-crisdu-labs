page 474 (
    name: Envío Informconf
    title: Envío Informconf
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region envios-realizados (
        name: Envios Realizados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idenviocobranca
                     , e.idfilial
                     , e.nomefilial
                     , e.idrepresentante
                     , e.nomerepresentante
                     , e.idvendedora
                     , e.nomevendedora
                     , e.documento
                     , e.identificacao
                     , e.dataenvio
                     , e.datavencimento
                     , e.tipo
                     , e.desctipo
                     , e.usuario
                     , e.observacao
                from vw_envioscobrancas e
                where ( :P474_FILTRODATA = 'N'
                     or ( :P474_FILTRODATA = 'E' and trunc(e.dataenvio) between to_date(:P474_DATAINICIO) and to_date(:P474_DATAFIM) )
                     or ( :P474_FILTRODATA = 'V' and trunc(e.datavencimento) between to_date(:P474_DATAINICIO) and to_date(:P474_DATAFIM) ) )
                  and ( :P474_IDFILIAL is null or e.idfilial = :P474_IDFILIAL )
                  and ( :P474_IDREPRESENTANTE is null or e.idrepresentante = :P474_IDREPRESENTANTE )
                  and ( :P474_IDVENDEDORA is null or e.idvendedora = :P474_IDVENDEDORA )
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
        }
        advanced {
            savedReportMappingIdentifier: 1534782405926038025
        }

