    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 50
            region: @anexos-de-empréstimos
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P341_IDANEXOEMPRESTIMO
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 20
            region: @anexos-de-empréstimos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P341_IDANEXOEMPRESTIMO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @anexos-de-empréstimos
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 211
                items: {
                    P211_IDEMPRESTIMO: &P341_IDEMPRESTIMO.
                    P211_IDPAGAMENTO: &P341_IDPAGAMENTO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process anexo (
        name: Anexo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_emprestimos(pidemprestimo => :P341_IDEMPRESTIMO);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Arquivo anexado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 767069713288495638
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P341_IDANEXOEMPRESTIMO := null;
                  pck_anexos.prc_apagaanexo_emprestimos(pidanexoemprestimo => :P341_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 767069864737495639
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexosemprestimos (
        name: Fetch Row from ANEXOSEMPRESTIMOS
        type: autoRowFetch
        source {
            tableName: ANEXOSEMPRESTIMOS
            pkColumn: IDANEXOEMPRESTIMO
            pkItem: P341_IDANEXOEMPRESTIMO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 779731661262466039
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P341_IDANEXOEMPRESTIMO is null then
                        select "#OWNER#"."SEQ_IDANEXOEMPRESTIMO".nextval
                          into :P341_IDANEXOEMPRESTIMO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 779732052420466041
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexosemprestimos (
        name: Process Row of ANEXOSEMPRESTIMOS
        type: autoRowProcessing
        target {
            tableName: ANEXOSEMPRESTIMOS
            pkColumn: IDANEXOEMPRESTIMO
            pkItem: P341_IDANEXOEMPRESTIMO
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 779732427324466042
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 341
                items: {
                    P341_IDANEXOEMPRESTIMO:
                    P341_IDEMPRESTIMO: &P341_IDEMPRESTIMO.
                    P341_IDPAGAMENTO: &P341_IDPAGAMENTO.
                }
                action: resetPagination
            }
        }
    )

)

