page 704 (
    name: "Auditoria de Pagamentos "
    title: "Auditoria de Pagamentos "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region auditoria-pagamentos (
        name: Auditoria Pagamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) Distribuidor
                     , roman.pck_romance.fnc_nomevendedora(nv.idvendedora) Consultora 
                     , roman.pck_romance.fnc_cpfvendedora(nv.idvendedora) CPF
                     , nv.numeronota
                     , nv.valortotalvenda
                     , pn.valorpago valor_duplicado
                     , count(pn.valorpago) qtd_duplicado
                     , nv.idnotavenda
                from roman.notasvendas nv
                   , roman.pagamentosnotasvendas pn 
                where nv.idnotavenda = pn.idnotavenda
                  and nv.idrepresentante = :P704_IDREPRESENTANTE
                  and pn.valorpago != 0
                  and pn.semanacobranca = :P704_SEMANA
                  and pn.origem = 'R' 
                group by nv.idrepresentante, nv.idvendedora, nv.valortotalvenda,  nv.numeronota, pn.valorpago , pn.semanacobranca, nv.idnotavenda
                HAVING count(pn.valorpago) > 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1504087626985693805
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column CPF (
            type: plainText
            heading {
                heading: CPF
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDNOTAVENDA (
            type: plainText
            heading {
                heading: Idnotavenda
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column NUMERONOTA (
            type: link
            heading {
                heading: Nota
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            link {
                target: {
                    page: 37
                    items: {
                        P37_IDNOTAVENDA: #IDNOTAVENDA#
                    }
                    action: resetPagination
                }
                linkText: #NUMERONOTA#
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column QTD_DUPLICADO (
            type: link
            heading {
                heading: Qtd Pagamento Repetido
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            link {
                target: {
                    page: 164
                    items: {
                        P164_IDNOTAVENDA: #IDNOTAVENDA#
                    }
                    action: resetPagination
                }
                linkText: #QTD_DUPLICADO#
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALORTOTALVENDA (
            type: plainText
            heading {
                heading: Valor Venda
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column VALOR_DUPLICADO (
            type: plainText
            heading {
                heading: Valor Pagamento Repetido
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        savedReport 15040998 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONSULTORA (
                sequence: 2
            )

            displayColumn CPF (
                sequence: 3
            )

            displayColumn DISTRIBUIDOR (
                sequence: 1
            )

            displayColumn NUMERONOTA (
                sequence: 4
            )

            displayColumn QTD_DUPLICADO (
                sequence: 6
            )

            displayColumn VALORTOTALVENDA (
                sequence: 5
            )

            displayColumn VALOR_DUPLICADO (
                sequence: 7
            )

            controlBreak (
                column: DISTRIBUIDOR
                layout {
                    sequence: 1
                }
            )

        )

    )

    region filtros (
        name: "Filtros "
        type: staticContent
        layout {
            sequence: 10
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P704_IDREPRESENTANTE (
        type: hidden
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P704_SEMANA (
        type: hidden
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
            point: processing
        }
        behavior {
            target: {
                page: 704
                items: {
                    P704_FILTRAR: S
                }
                action: resetPagination
            }
        }
    )

)

