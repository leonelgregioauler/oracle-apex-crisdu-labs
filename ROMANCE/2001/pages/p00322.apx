    region débitos-pendentes (
        name: Débitos Pendentes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nrpedido
                     , semana
                     , representante
                     , nomevendedora
                     , valor
                     , valorpago
                     , saldo
                     , filial
                     , ultimopagamento
                     , idpepinosrepresentante
                     , cpf
                     , idnotavenda
                     , idrepresentante 
                     , origem
                     , ( select pck_romance.fnc_retornatelefones( idvendedora )
                         from vendedoras v
                            , pessoas p
                         where v.idpessoa = p.idpessoa
                           and p.cpf = w.cpf ) telefones 
                     , ( select nroconsultaspc
                         from pessoas
                         where idpessoa = ( select idpessoa 
                                             from vendedoras 
                                             where idvendedora = ( select idvendedora 
                                                                   from notasvendas 
                                                                   where idnotavenda = w.idnotavenda ) ) ) "Consulta SPC"
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||w.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' url
                from vw_debitosrepresentantes w
                where saldo > 0
                  and idrepresentante = :P322_IDREPRESENTANTE
                  and semana = :P322_SEMANA
                ```
        }
