page 295 (
    name: Comissão Favorita
    title: Comissão Favorita
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region comissão-favorita (
        name: Comissão Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(1) qtd
                     , round(sum(comissao),2) comissao
                from vw_comissoes_pagar t
                where t.idrepresentante = :P295_IDREPRESENTANTE
                  and not exists ( select 1 
                                   from pagamentocomissoes pp
                                   where pp.idpedido  = t.idpedido 
                                     and pp.idrepresentante = t.idrepresentante )
                union
                select count(1)
                     , round(sum(comissaodistribuidor),2) 
                from favorita.vw_comissoes_pagar_fav v
                where v.idrepresentante = :P295_IDREPRESENTANTE
                  and not exists ( select 1 
                                   from pagamentocomissoes pp
                                   where pp.idpedido  = v.idpedido 
                                     and pp.idrepresentante = v.idrepresentante )
                ```
            pageItemsToSubmit: P295_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma comissão encontrada
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 309069877228289943
        }

        column COMISSAO (
            type: plainText
            heading {
                heading: Comissão
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column QTD (
            type: plainText
            heading {
                heading: Qtd de Pedidos
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        savedReport 3090741 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COMISSAO (
                sequence: 2
            )

            displayColumn QTD (
                sequence: 1
            )

            aggregate (
                column: QTD
            )

            aggregate (
                column: COMISSAO
            )

        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P295_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                 , idrepresentante return_value
                from representantes 
                where idgerente = ( select idgerente 
                                    from gerentes
                                    where idfilial = :P0_IDFILIAL )
                  and ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh (
        name: refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P295_IDREPRESENTANTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @comissão-favorita
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

