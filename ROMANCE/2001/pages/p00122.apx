page 122 (
    name: Estoque Posto Avançado
    title: Estoque Posto Avançado
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_popup_estreserva(pidestoquefil,pidpostoavancado)
            {
              window.open( 'f?p=&APP_ID.:207:&SESSION.::NO::P207_IDESTOQUEFIL,P207_IDPOSTOAVANCADO:'+pidestoquefil+','+pidpostoavancado, 'ESTRESERVA', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1100,height=900,left=100,top=50','_blank'); void(0);
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region estoque-posto-avançado-atual (
        name: Estoque Posto Avançado Atual
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select c.nome
                         from categorias c
                         where c.idcategoria = ( select pr.idcategoria
                                                 from produtos pr
                                                 where pr.idproduto = (select ef.idproduto
                                                                       from estoquefilial ef
                                                                       where ef.idestoquefilial = e.idestoquefil) ) ) "Categoria"
                     , ( select pr.codigosisdist
                         from produtos pr
                         where pr.idproduto = (select ef.idproduto
                                               from estoquefilial ef
                                               where ef.idestoquefilial = e.idestoquefil) )  "Código"
                     , ( select initcap( pr.nomeproduto )
                         from produtos pr
                         where pr.idproduto = (select ef.idproduto
                                               from estoquefilial ef
                                               where ef.idestoquefilial = e.idestoquefil) )  "Produto"
                     , ( select c.descricao
                         from cores c
                         where c.idcor = (select ef.idcor
                                         from estoquefilial ef
                                         where ef.idestoquefilial = e.idestoquefil))  "Cor"
                     , e.quantidade
                     , (select decode(ef.ativo,'S','Sim','Não')
                        from estoquefilial ef
                        where ef.idestoquefilial = e.idestoquefil) ativo
                     , e.idestoquefil
                     , pck_romance.fnc_nomepostoavancado(e.idpostoavancado) "Posto Avançado"
                     , e.idpostoavancado
                     , (select ef.idproduto
                        from estoquefilial ef
                        where ef.idestoquefilial = e.idestoquefil) idproduto
                     , (select ef.idcor
                        from estoquefilial ef
                        where ef.idestoquefilial = e.idestoquefil) idcor
                     , (select decode(ef.comissao, 'S', 'Sim','N','Não')
                        from estoquefilial ef
                        where ef.idestoquefilial = e.idestoquefil)comissao
                     , (select ef.vlrvenda
                        from estoquefilial ef
                        where ef.idestoquefilial = e.idestoquefil)vlrvenda
                     , '|' "EF"
                     , nvl(e.qtd_u  ,0) "EF U"  
                     , '|' "ER"
                     , pck_estoque.fnc_estoquereserva_pa(pidestoquefil => e.idestoquefil,ptamanho => 'U',pidpostoavancado => e.idpostoavancado)   "ER U"
                     , '|' "ED"
                     , nvl(e.qtd_u  ,0) - pck_estoque.fnc_estoquereserva_pa(pidestoquefil => e.idestoquefil,ptamanho => 'U',pidpostoavancado => e.idpostoavancado)   "ED U"
                     , nvl(e.qtd_u  ,0) - pck_estoque.fnc_estoquereserva_pa(pidestoquefil => e.idestoquefil,ptamanho => 'U',pidpostoavancado => e.idpostoavancado) "ED TOTAL"
                from estoquepostoavancado e 
                where e.idpostoavancado = :P122_IDPOSTOAVANCADO
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                EF = Estoque Físico <br>
                ER = Estoque Reservado (Produtos que estão em cargas em aberto ou cargas canceladas que não tiveram itens excluidos)<br>
                ED = Estoque Disponível (Estoque Físico - Estoque Reservado)<br><br>
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
