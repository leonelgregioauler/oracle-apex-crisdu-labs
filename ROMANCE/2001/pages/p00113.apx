page 113 (
    name: Devoluções Distribuidor
    title: Devoluções Distribuidor
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region devoluções-distribuidor (
        name: Devoluções Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  p_where varchar2(4000);
                  p_from  varchar2(4000);
                  p_xx varchar2(4000);
                  
                begin
                  --
                  -- OBS: TODOS OS PAGE ITENS TEM QUE SER COLOCADOS EM CONDICAO(IF), SENAO DA ERRO DE COMPILACAO
                  --
                  p_from := ' from devolucoesrepresentantes d
                                 , itensdevolucaorepres     i 
                             where d.idpostoavancado is null 
                               and d.iddevolucaorepres = i.iddevolucaorepres(+) ' ;
                  
                  p_where := ' and d.idfilial = '|| v('P0_IDFILIAL');
                
                  --
                  IF nvl(:P113_IDREPRESENTANTE,0) > 0 THEN
                     p_where := p_where || ' and d.idrepresentante = '|| v('P113_IDREPRESENTANTE');
                  END IF;
                  --
                  IF :P113_IDSEMANA IS NOT NULL THEN
                     p_where := p_where || ' and d.idsemana = '|| v('P113_IDSEMANA');
                  END IF;
                
                
                  return 
                     ' select d.iddevolucaorepres
                     , pck_romance.fnc_nomerepresentante(d.idrepresentante) "Representante"
                     , d.semana
                     , d.valortotal
                     , d.idfilial
                     , decode( d.situacao , 1 , ''Aberta''
                                          , 2 , ''Aguardando Conclusão''
                                          , 3 , ''Concluída''
                                          , 0 , ''Cancelada'') "Situação"
                     , d.observacao
                     , sum(i.qtd_pp)   "Qtd PP"
                     --
                     , sum(i.qtd_p)    "Qtd P"
                     --
                     , sum(i.qtd_m)    "Qtd M"
                     --
                     , sum(i.qtd_g)    "Qtd G"            
                     , sum(i.qtd_gg)   "Qtd GG"
                     , sum(i.qtd_egg)  "Qtd EGG"
                     , sum(i.qtd_exgg) "Qtd EXGG"
                     , sum(i.qtd_u)    "Qtd U" 
                     --
                     , sum( CASE WHEN i.comissao = ''S''
                                 THEN ((nvl(i.qtd_u,0)
                                      + nvl(i.qtd_exgg,0)
                                      + nvl(i.qtd_egg,0)
                                      + nvl(i.qtd_gg ,0)
                                      + nvl(i.qtd_g  ,0)
                                      + nvl(i.qtd_m  ,0)
                                      + nvl(i.qtd_p  ,0)
                                      + nvl(i.qtd_pp ,0))*i.valorproduto)
                                 ELSE
                                   0
                            END)  "Total COM Comissão" 
                     --
                     , sum( CASE WHEN i.comissao = ''N''
                                 THEN ((nvl(i.qtd_u,0)
                                      + nvl(i.qtd_exgg,0)
                                      + nvl(i.qtd_egg,0)
                                      + nvl(i.qtd_gg ,0)
                                      + nvl(i.qtd_g  ,0)
                                      + nvl(i.qtd_m  ,0)
                                      + nvl(i.qtd_p  ,0)
                                      + nvl(i.qtd_pp ,0))*I.valorproduto)
                                 ELSE
                                   0
                            END)  "Total SEM Comissão"  
                     --
                     , sum(nvl(i.qtd_u,0)
                                  + nvl(i.qtd_exgg,0)
                                  + nvl(i.qtd_egg,0)
                                  + nvl(i.qtd_gg ,0)
                                  + nvl(i.qtd_g  ,0)
                                  + nvl(i.qtd_m  ,0)
                                  + nvl(i.qtd_p  ,0)
                                  + nvl(i.qtd_pp ,0))  "Total Peças" 
                     , d.datainclusao "Data_Inclusão"
                     , d.dataconclusao "Data Conclusão"
                     , d.usuario "Usuário Incluiu"
                     , case
                         when d.situacao = 3 and d.dataconclusao is not null then
                           pck_util.fnc_tempodecorrido(d.dataconclusao - d.datainclusao,''D'')
                         else 
                           ''Não Contabilizado''
                       end tempototal
                     , case
                         when d.situacao = 3 and d.dataconclusao is not null
                           and exists ( select 1
                                        from itensdevolucaorepres it
                                        where it.iddevolucaorepres = d.iddevolucaorepres  ) 
                         then pck_util.fnc_tempodecorrido( ( d.dataconclusao - d.datainclusao ) / 
                                                           ( select count(1)
                                                               from itensdevolucaorepres it
                                                              where it.iddevolucaorepres = d.iddevolucaorepres ),''D'' ) 
                         else 
                           ''Não Contabilizado''
                       end tempoporproduto '
                 || p_from
                 || p_where
                 || ' group by
                           d.idfilial
                         , d.iddevolucaorepres
                         , d.idrepresentante
                         , d.semana
                         , d.dataconclusao
                         , d.valortotal
                         , d.situacao 
                         , d.observacao
                         , d.datainclusao
                         , d.usuario' ;
                
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 115
                items: {
                    P115_IDDEVOLUCAOREPRES: #IDDEVOLUCAOREPRES#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhuma devolução efetuada.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        actionsMenu {
            pivot: false
            savePublicReport: true
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

