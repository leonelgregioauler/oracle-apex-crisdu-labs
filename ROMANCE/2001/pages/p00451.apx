page 451 (
    name: Consulta Distribuidor
    title: Consulta Distribuidor
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos-favorita (
        name: Pedidos Favorita
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select '1 -Pedidos até R$250,00' descricao
                     , count(1) qtd
                from favorita.pedidos p
                where p.idrepresentante = :P451_IDREPRESENTANTE
                  and p.valortotal between 0 and 249.99
                  and p.idsituacaoentrega >= 20000
                  and not exists ( select 1
                                   from favorita.classificacoespedidos c
                                   where c.idcaracteristicapedido = 25
                                     and c.idpedido               = p.idpedido )
                union
                select '2 - Pedidos R$250,00 até R$500,00' descricao
                     , count(1) qtd
                from favorita.pedidos p
                where p.idrepresentante = :P451_IDREPRESENTANTE
                  and p.valortotal between 250.01 and 499.99
                  and p.idsituacaoentrega >= 20000
                  and not exists ( select 1
                                   from favorita.classificacoespedidos c
                                   where c.idcaracteristicapedido = 25
                                     and c.idpedido               = p.idpedido )
                union
                select '3 - Pedidos R$500,00 até R$1000,00' descricao
                     , count(1) qtd
                from favorita.pedidos p
                where p.idrepresentante = :P451_IDREPRESENTANTE
                  and p.valortotal between 500 and 999.99
                  and p.idsituacaoentrega >= 20000
                  and not exists ( select 1
                                   from favorita.classificacoespedidos c
                                   where c.idcaracteristicapedido = 25
                                     and c.idpedido               = p.idpedido )
                union
                select '4 - Pedidos maiores de R$1000,00' descricao
                     , count(1) qtd
                from favorita.pedidos p
                where p.idrepresentante = :P451_IDREPRESENTANTE
                  and p.valortotal >= 1000
                  and p.idsituacaoentrega >= 20000
                  and not exists ( select 1
                                   from favorita.classificacoespedidos c
                                   where c.idcaracteristicapedido = 25
                                     and c.idpedido               = p.idpedido )
                union
                select '5 - Comissão Favorita para Resgatar'
                     , nvl(( select round(sum(comissao),2)
                             from vw_comissoes_pagar t
                             where idrepresentante = :P451_IDREPRESENTANTE
                               and not exists ( select 1 
                                                from pagamentocomissoes pp
                                                where pp.idpedido  = t.idpedido 
                                                  and pp.idrepresentante is not null) ),0)
                     + nvl(( select round(sum(comissaodistribuidor),2)
                             from favorita.vw_comissoes_pagar_fav tf
                             where idrepresentante = :P451_IDREPRESENTANTE
                                and not exists ( select 1 
                                                 from pagamentocomissoes pp
                                                 where pp.idpedido  = tf.idpedido 
                                                   and pp.idrepresentante is not null) ),0) valor
                from dual
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DESCRICAO
            valueColumn: QTD
            layout: floatToLeft
        }
    )

    region resumo (
        name: Resumo
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select '1 - Consultoras para Atender' descricao
                     , trim(to_char(count(1),'999G999G990')) quantidade
                from vendedoras v
                where not exists ( select 1
                                   from representantes r
                                   where r.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from funcionarios f
                                   where f.idpessoa = v.idpessoa )
                  and exists ( select 1
                               from notasvendas n
                               where n.idvendedora         = v.idvendedora
                                 and n.idsituacaonotavenda = 3
                                 and idfilial = :P0_IDFILIAL )
                  and v.idrepresentante = :P451_IDREPRESENTANTE 
                union
                select '2 - Consultoras com APP'
                     , trim(to_char(count(1),'999G999G990')) quantidade
                from vendedoras v
                where not exists ( select 1
                                   from representantes r
                                   where r.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from funcionarios f
                                   where f.idpessoa = v.idpessoa )
                  and exists ( select 1
                               from notasvendas n
                               where n.idvendedora         = v.idvendedora
                                 and n.idsituacaonotavenda = 3
                                 and idfilial = :P0_IDFILIAL )
                  and exists ( select 1
                               from registrosloginminhasacola e
                               where e.idvendedora = v.idvendedora )
                  and v.idrepresentante = :P451_IDREPRESENTANTE 
                union
                select '3 - Consultoras Inativas'
                     , trim(to_char(count(1),'999G999G990')) quantidade
                from vendedoras v
                where not exists ( select 1
                                   from representantes r
                                   where r.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from funcionarios f
                                   where f.idpessoa = v.idpessoa )
                  and v.idrepresentante = :P451_IDREPRESENTANTE 
                  and v.ativo = 'S'
                union 
                select '4 - Fotos Compartilhadas' descricao
                     , trim(to_char(count(1),'999G999G990'))  quantidade
                from registroscompartilhafotos r
                where exists ( select 1
                               from vendedoras     v
                                  , representantes r
                               where v.idvendedora     = r.idvendedora
                                 and v.idrepresentante = r.idrepresentante
                                 and v.idrepresentante = :P451_IDREPRESENTANTE 
                                 and r.ativo           = 'S'
                                 and not exists ( select 1
                                                  from representantes r
                                                  where r.idpessoa = v.idpessoa )
                                 and idgerente         = ( select idgerente 
                                                           from gerentes 
                                                           where idfilial = :P0_IDFILIAL ) )
                union
                select '5 - Total de Cargas'
                     , trim(to_char(count(1),'999G999G990')) quantidade
                from cargasrepresentantes c
                where c.idrepresentante = :P451_IDREPRESENTANTE
                  and c.situacao != 0
                union 
                select '6 - Total de Devoluções'
                     , trim(to_char(count(1),'999G999G990')) quantidade
                from devolucoesrepresentantes d
                where d.idrepresentante = :P451_IDREPRESENTANTE
                  and d.situacao != 0
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            customAttributes: align="center"
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DESCRICAO
            valueColumn: QUANTIDADE
            layout: floatToLeft
        }
    )

    region resumo-das-regiões (
        name: Resumo das Regiões
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(rg.idregiaovenda) "Região"
                     , nvl(( select sum(nv.valorpago)/count(1)
                             from notasvendas nv
                             where nv.idregiaovenda = rg.idregiaovenda
                               and nv.idrepresentante = rg.idrepresentante
                               and nv.idsituacaonotavenda = 4
                               and nv.valorpago > 0
                               and nv.idsemanacobranca between pck_util.fnc_idsemanadata(sysdate)-24 and pck_util.fnc_idsemanadata(sysdate) ),0) "Ticket Médio"
                     , nvl(( select count(1)
                             from notasvendas nv
                             where nv.idregiaovenda = rg.idregiaovenda
                               and nv.idrepresentante = rg.idrepresentante
                               and nv.idsituacaonotavenda = 3 ),0) "Notas para Atender"
                     , nvl((select sum(nv.valortotalnota)
                             from notasvendas nv
                             where nv.idregiaovenda = rg.idregiaovenda
                               and nv.idrepresentante = rg.idrepresentante
                               and nv.idsituacaonotavenda = 3),0) "Total para Atender"
                     , nvl(( select sum(it.quantidade)
                             from itensnotavenda it
                                , notasvendas nv
                             where nv.idnotavenda = it.idnotavenda
                               and nv.idsituacaonotavenda = 3
                               and nv.idrepresentante = rg.idrepresentante
                               and nv.idregiaovenda = rg.idregiaovenda),0) "Total Distribuido"
                     , nvl(( select count(1)
                             from favorita.pedidos p
                             where p.idrepresentante = rg.idrepresentante
                               and exists ( select 1
                                            from vendedoras v
                                            where v.idvendedora = p.idvendedora
                                              and v.idrepresentante = rg.idrepresentante
                                              and v.idregiaovenda = rg.idregiaovenda )
                               and not exists ( select 1
                                                from favorita.classificacoespedidos c
                                                where c.idpedido = p.idpedido
                                                  and c.idcaracteristicapedido = 25 ) ),0) "Pedidos Emitidos"
                     , nvl(( select f.totalgeral
                             from fechamentorepresentantes f
                             where f.idfechamentorepres = ( select max(fr.idfechamentorepres)
                                                            from fechamentorepresentantes fr
                                                            where fr.idrepresentante = rg.idrepresentante
                                                              and fr.idregiaovenda = rg.idregiaovenda
                                                              and fr.idfilial = :P0_IDFILIAL )),0) "Ultima Cobrança"
                     , nvl(( select count(1)
                             from notasvendas nv
                             where nv.idregiaovenda = rg.idregiaovenda
                               and nv.idrepresentante = rg.idrepresentante
                               and nv.idsituacaonotavenda = 4),0) "Notas já Acertadas"
                     , nvl(( select count(1)
                             from notasvendas nv
                             where nv.idregiaovenda = rg.idregiaovenda
                               and nv.idrepresentante = rg.idrepresentante
                               and nv.idsituacaonotavenda = 4
                               and nv.saldo > 0),0) "Débitos"
                     , nvl(( select sum(nv.saldo)
                             from notasvendas nv
                             where nv.idregiaovenda = rg.idregiaovenda
                               and nv.idrepresentante = rg.idrepresentante
                               and nv.idsituacaonotavenda = 4
                               and nv.saldo > 0),0) "Total Débitos"
                     , nvl(( select count(1)
                             from notasvendas nv
                             where nv.idregiaovenda = rg.idregiaovenda
                               and nv.idrepresentante = rg.idrepresentante
                               and nv.idsituacaonotavenda = 4
                               and nv.saldo > 0
                               and nvl(nv.enviadocobranca,'N') = 'S'),0) "Na Cobrança"
                     , nvl(( select count(1)
                             from notasvendas nv
                             where nv.idregiaovenda = rg.idregiaovenda
                               and nv.idrepresentante = rg.idrepresentante
                               and nv.idsituacaonotavenda = 4
                               and nv.saldo > 0),0) - nvl(( select count(1)
                                                            from notasvendas nv
                                                            where nv.idregiaovenda = rg.idregiaovenda
                                                              and nv.idrepresentante = rg.idrepresentante
                                                              and nv.idsituacaonotavenda = 4
                                                              and nv.saldo > 0
                                                              and nvl(nv.enviadocobranca,'N') = 'S'),0) "Débitos Pendentes"
                     , nvl(( select sum(nv.saldo)
                             from notasvendas nv
                             where nv.idregiaovenda = rg.idregiaovenda
                               and nv.idrepresentante = rg.idrepresentante
                               and nv.idsituacaonotavenda = 4
                               and nv.saldo > 0),0) - nvl(( select sum(nv.saldo)
                                                            from notasvendas nv
                                                            where nv.idregiaovenda = rg.idregiaovenda
                                                              and nv.idrepresentante = rg.idrepresentante
                                                              and nv.idsituacaonotavenda = 4
                                                              and nv.saldo > 0
                                                              and nvl(nv.enviadocobranca,'N') = 'S'),0) "Total Pendentes"
                from regioesrepresentantes rg
                where rg.idrepresentante = :P451_IDREPRESENTANTE
                group by idregiaovenda , rg.idrepresentante
                order by pck_romance.fnc_nomeregiaovenda(rg.idregiaovenda);
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 6
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: showAll
            partialPageRefresh: false
        }

