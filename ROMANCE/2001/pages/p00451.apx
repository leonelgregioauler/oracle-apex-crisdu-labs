    region top-10-em-cargas-ultimas-semanas (
        name: Top 10 Em Cargas - Ultimas Semanas
        type: chart
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        legend {
            show: false
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomeprodutoestoque(c.idestoquefil) "Produto"
                         , c.qtd "Quantidade"
                    from ( select /*+ FIRST_ROWS(10) */ ic.idestoquefil
                                , sum(nvl(ic.qtd_dist_pp,0)
                                     +nvl(ic.qtd_dist_p,0)
                                     +nvl(ic.qtd_dist_m,0)
                                     +nvl(ic.qtd_dist_g,0)
                                     +nvl(ic.qtd_dist_gg,0)
                                     +nvl(ic.qtd_dist_egg,0)
                                     +nvl(ic.qtd_dist_exgg,0)
                                     +nvl(ic.qtd_dist_u,0)) qtd
                           from cargasrepresentantes c
                              , itenscargarepresentante ic
                           where c.idrepresentante       = :P451_IDREPRESENTANTE
                             and ic.idcargarepresentante = c.idcargarepresentante
                             and c.situacao              != 0
                             and c.idsemana between pck_util.fnc_idsemanadata(sysdate)-6 and pck_util.fnc_idsemanadata(sysdate)
                           group by ic.idestoquefil
                           order by 2 desc ) c
                    where rownum <= 10
                           
                    ```
            }
            columnMapping {
                label: "Produto"
                value: "Quantidade"
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region top-10-em-devoluções-ultimas-semanas (
        name: Top 10 Em Devoluções- Ultimas Semanas
        type: chart
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        legend {
            show: false
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomeprodutoestoque(d.idestoquefil) "Produto"
                         , d.qtd "Quantidade"
                    from ( select /*+ FIRST_ROWS(10) */ i.idestoquefil
                                , sum(nvl(i.qtd_pp,0)
                                     +nvl(i.qtd_p,0)
                                     +nvl(i.qtd_m,0)
                                     +nvl(i.qtd_g,0)
                                     +nvl(i.qtd_gg,0)
                                     +nvl(i.qtd_egg,0)
                                     +nvl(i.qtd_exgg,0)
                                     +nvl(i.qtd_u,0)) qtd
                           from devolucoesrepresentantes d
                              , itensdevolucaorepres i
                           where d.idrepresentante       = :P451_IDREPRESENTANTE
                             and i.iddevolucaorepres     = d.iddevolucaorepres
                             and d.situacao              != 0
                             and d.idsemana between pck_util.fnc_idsemanadata(sysdate)-6 and pck_util.fnc_idsemanadata(sysdate)
                           group by i.idestoquefil
                           order by 2 desc ) d
                    where rownum <= 10
                           
                    ```
            }
            columnMapping {
                label: "Produto"
                value: "Quantidade"
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region top-10-em-sacolas-ultimas-semanas (
        name: Top 10 Em Sacolas - Ultimas Semanas
        type: chart
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        legend {
            show: false
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomeprodutoestoque(n.idestoquefil) "Produto"
                         , n.qtd "Quantidade"
                    from ( select /*+ FIRST_ROWS(10) */ it.idestoquefil
                                , sum(it.quantidade) qtd
                           from notasvendas nv
                              , itensnotavenda it
                           where nv.idrepresentante     = :P451_IDREPRESENTANTE
                             and it.idnotavenda         = nv.idnotavenda
                             and nv.idsituacaonotavenda = 3
                           group by it.idestoquefil
                           order by 2 desc ) n
                    where rownum <= 10
                           
                    ```
            }
            columnMapping {
                label: "Produto"
                value: "Quantidade"
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region top-10-vendidos-ultimas-semanas (
        name: Top 10 Vendidos - Ultimas Semanas
        type: chart
        layout {
            sequence: 60
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        legend {
            show: false
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomeprodutoestoque(n.idestoquefil) "Produto"
                         , n.qtd "Quantidade"
                    from ( select /*+ FIRST_ROWS(10) */ it.idestoquefil
                                , sum(it.quantidade-it.qtddevolvida) qtd
                           from notasvendas nv
                              , itensnotavenda it
                           where nv.idrepresentante     = :P451_IDREPRESENTANTE
                             and it.idnotavenda         = nv.idnotavenda
                             and nv.idsituacaonotavenda = 4 
                             and nv.idsemanacobranca between pck_util.fnc_idsemanadata(sysdate)-6 and pck_util.fnc_idsemanadata(sysdate)
                           group by it.idestoquefil
                           order by 2 desc ) n
                    where rownum <= 10
                           
                    ```
            }
            columnMapping {
                label: "Produto"
                value: "Quantidade"
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    pageItem P451_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'ID '||r.idrepresentante||' - '||pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - ('||decode(r.ativo,'S','Ativo','N','Inativo')||')'   display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                  and r.usanetbook = 'S'
                order by pck_romance.fnc_nomerepresentante(r.idrepresentante)
                
                ```
            nullDisplayValue: - Selecione o Distribuidor -
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction change-distribuidor (
        name: Change Distribuidor
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P451_IDREPRESENTANTE
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P451_IDREPRESENTANTE
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

