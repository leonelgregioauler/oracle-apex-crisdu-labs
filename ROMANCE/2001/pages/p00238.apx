page 238 (
    name: Itens Distribuídos
    title: Itens Distribuídos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
    )

    region itens-distribuídos (
        name: Itens Distribuídos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct v.produto
                     , v.distribuido
                     , v.valordistribuido
                     , pck_romance.fnc_nomerepresentante(v.idrepresentante) distribuidor
                from vw_produtosdistribuidos v
                where ( :P238_IDREPRESENTANTE is null and v.idfilial = :P0_IDFILIAL 
                   or v.idrepresentante = :P238_IDREPRESENTANTE )
                  and v.semanadistribuicao = :P238_SEMANA
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 574886223438455314
        }

        column DISTRIBUIDO (
            type: plainText
            heading {
                heading: Distribuido
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: DISTRIBUIDO
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 13
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column PRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: PRODUTO
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column VALORDISTRIBUIDO (
            type: plainText
            heading {
                heading: Valor Distribuido
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: VALORDISTRIBUIDO
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 5748934 (
            visibility: primaryDefault
            view {
                rowsPerPage: 1000
            }

            displayColumn DISTRIBUIDO (
                sequence: 2
            )

            displayColumn DISTRIBUIDOR (
                sequence: 4
            )

            displayColumn PRODUTO (
                sequence: 1
            )

            displayColumn VALORDISTRIBUIDO (
                sequence: 3
            )

            controlBreak (
                column: DISTRIBUIDOR
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P238_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Cliente R
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @representantes-2
            nullDisplayValue: "-TODOS - "
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P238_SEMANA (
        type: textField
        label {
            label: Semana
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 15
        }
        validation {
            maxLength: 15
        }
        security {
            encryptSessionState: false
        }
    )

    button p238-filtrar (
        buttonName: P238_FILTRAR
        label: Filtrar
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: P238_FILTRAR
        }
    )

    branch (
        name: filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 238
                items: {
                    P238_IDREPRESENTANTE: &P238_IDREPRESENTANTE.
                    P238_SEMANA: &P238_SEMANA.
                }
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @p238-filtrar
        }
    )

)

