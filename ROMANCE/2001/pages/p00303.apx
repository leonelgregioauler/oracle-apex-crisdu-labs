page 303 (
    name: Usuários Filiais
    title: Usuários Filiais
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region usuários-filiais (
        name: Usuários Filiais
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDUSUARIOFILIAL",
                "IDUSUARIOFILIAL" IDUSUARIOFILIAL_DISPLAY,
                "USUARIO",
                "IDFILIAL"
                from "#OWNER#"."USUARIOSFILIAIS"
                where usuario = :P303_USUARIO
                order by pck_romance.fnc_nomefilial(idfilial)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P303_USUARIO
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 5
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 4
            derivedColumn: N
            type: selectList
            heading {
                heading: Filial
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomefilial(idfilial) display_value
                      , idfilial return_value
                    from filiais f 
                    order by pck_romance.fnc_nomefilial(idfilial)
                    ```
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column IDUSUARIOFILIAL (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDUSUARIOFILIAL
            }
            sorting {
                sortable: false
            }
        )

        column IDUSUARIOFILIAL_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Idusuariofilial
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: textField
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 16
            }
            default {
                type: item
                item: P303_USUARIO
            }
            sorting {
                sortable: false
            }
            advanced {
                customAttributes: readonly
            }
        )

    )

    pageItem P303_USUARIO (
        type: selectList
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(username)||' - '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialusuario(username)) display_value
                ,username return_value
                from dba_users d
                where trunc(d.created) >= to_date('07/12/2010','dd/mm/rrrr')
                  AND USERNAME NOt IN ('APEX_PUBLIC_USER','APEX_040000','CATAL')
                  and account_status != 'LOCKED'
                  and exists (select 1 from usuariossistemas u where usuario = d.username and u.idsistema = 2001)
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar Filial
        layout {
            sequence: 40
            region: @usuários-filiais
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @usuários-filiais
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 303
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @usuários-filiais
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Inserir
        layout {
            sequence: 30
            region: @usuários-filiais
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction carregar-usuario (
        name: Carregar Usuario
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P303_USUARIO
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P303_USUARIO
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation idfilial-must-be-numeric (
        name: IDFILIAL must be numeric
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @usuários-filiais
            type: columnIsNumeric
            column: IDFILIAL
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDFILIAL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @usuários-filiais
        target {
            tableName: USUARIOSFILIAIS
            pkColumn: IDUSUARIOFILIAL
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# row(s) deleted.
        }
        advanced {
            executionMappingIdentifier: 341448669032103767
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @usuários-filiais
        target {
            tableName: USUARIOSFILIAIS
            pkColumn: IDUSUARIOFILIAL
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 341448268301103767
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 303
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

