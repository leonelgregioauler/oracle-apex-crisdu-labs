                begin 
                  --
                  if :P365_IDPAGAMENTOVENDADIRETA is null then
                    select "#OWNER#"."SEQ_IDPAGAMENTOVENDADIRETA".nextval
                    into :P365_IDPAGAMENTOVENDADIRETA
                    from sys.dual;
                  end if;
                  --
