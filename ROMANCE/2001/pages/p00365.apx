    validation valida-valor-pago (
        name: Valida Valor Pago
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vvalorpago       NUMBER(15,2);
                  vvalorapagar     NUMBER(15,2);
                begin
                  --
                  select SUM(VALORPAGO)
                  into vvalorpago
                  from pagamentosvendasdiretas pv
                  where pv.idvendadireta = :P365_IDVENDADIRETA
                    and pv.idpagamentovendadireta != nvl(:P365_IDPAGAMENTOVENDADIRETA,-1);
                  --
                  vvalorpago := nvl(vvalorpago,0) + :P365_VALORPAGO;
                  --
                  select nvl(v.valortotal,0)
                  into vvalorapagar
                  from vendasdiretas v
                  where v.idvendadireta = :P365_IDVENDADIRETA;
                  --
                  if (vvalorpago > vvalorapagar) then
                     Return ('Valor pago maior que valor a pagar.');
                  end if;
                  --
                end;
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('SAVE','CREATE')
                ```
        }
    )

    validation valida-valor-pago-zerado-ou-neg (
        name: Valida Valor Pago Zerado ou Neg.
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_number(:P365_VALORPAGO) <= 0
                ```
        }
        error {
            errorMessage: Por favor, inclua um valor válido!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SAVE','CREATE');
                ```
        }
    )

