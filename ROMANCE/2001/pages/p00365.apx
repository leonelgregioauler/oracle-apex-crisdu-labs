            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P365_IDPAGAMENTOVENDADIRETA is not null
                  and exists ( select 1
                               from pagamentosvendasdiretas pv
                                  , fechamentossemanais f
                               where pv.idpagamentovendadireta = :P365_IDPAGAMENTOVENDADIRETA
