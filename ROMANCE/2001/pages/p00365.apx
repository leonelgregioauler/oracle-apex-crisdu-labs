    region pagamentos-incluídos (
        name: Pagamentos Incluídos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pv.idpagamentovendadireta
                     , pv.datapagamento
                     , pv.valorpago
                     , pv.semanacobranca
                     , pv.observacao
                     , pv.usuario
                from pagamentosvendasdiretas pv
                where pv.idvendadireta = :P365_IDVENDADIRETA
                ```
