    pageItem P365_CONCLUIDO (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 10
            region: @pagamentos-de-venda-direta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: Essa semana está concluída! Para alterar, solicite reabertura para o Escritório.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from pagamentosvendasdiretas pv
                                  , fechamentossemanais f
                               where pv.idpagamentovendadireta = :P365_IDPAGAMENTOVENDADIRETA
                                 and pv.idfechamento           = f.idfechamento
                                 and f.concluido               = 'S' )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P365_IDFECHAMENTO (
        type: hidden
        layout {
            sequence: 40
            region: @pagamentos-de-venda-direta
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vidfechamento number;
                  --
                begin
                  --
                  select max(idfechamento)
                  into vidfechamento
                  from fechamentossemanais f
                  where f.idfilial = :P0_IDFILIAL
                    and f.concluido = 'N';
                  --
                  return vidfechamento;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

