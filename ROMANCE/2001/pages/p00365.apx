    pageItem P365_SEMANACOBRANCA (
        type: textField
        label {
            label: Semana Cobrança
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @pagamentos-de-venda-direta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 10
        }
        source {
            type: databaseColumn
            databaseColumn: SEMANACOBRANCA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vsemanacobranca varchar2(10);
                begin
                  --
                  select semana
                  into vsemanacobranca
                  from fechamentossemanais f
                  where f.idfechamento = ( select max(idfechamento)
                                           from fechamentossemanais ff
                                           where ff.idfilial = :P0_IDFILIAL
                                             and ff.concluido = 'N' );
                  --
                  return vsemanacobranca;
                  --
                end;
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

