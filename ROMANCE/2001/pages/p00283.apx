    region parcelamentos-realizados (
        name: Parcelamentos Realizados
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "IDPARCPEPINOSREPRES",
                "IDPEPINOREPRESENTANTE",
                "DATAVENCIMENTO",
                "VALORORIGINAL",
                "JUROS",
                "VALORAPAGAR",
                "SITUACAO",
                "COMPROVANTE",
                "IDCONTABANCARIAFILIAL",
                "DATABAIXA"
                from "#OWNER#"."PARCELAMENTOSPEPINOSREPRES"
                where IDPEPINOREPRESENTANTE = :P283_IDPEPINOREPRESENTANTE
                ```
        }
        layout {
            sequence: 15
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from PARCELAMENTOSPEPINOSREPRES
                where idpepinorepresentante = :P283_IDPEPINOREPRESENTANTE
                ```
        }
        reportLayout {
            numberOfRows: 24
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

