    process desfazer-parcelamento (
        name: Desfazer Parcelamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  delete PARCELAMENTOSPEPINOSREPRES
                  where idpepinorepresentante = :P283_IDPEPINOREPRESENTANTE
                    and situacao != 'Q';
                  --
                  insert into OBSERVACOESPEPINOSREPRES
                  values (seq_idobspepinosrepres.nextval, :P283_IDPEPINOREPRESENTANTE, sysdate, 'Parcelamento da negociação Desfeito.', v('APP_USER'));
                  --
                  delete catal.tarefasnegociacoes t
                  where t.idpepinorepres = :P283_IDPEPINOREPRESENTANTE;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Parcelamento Desfeito!
        }
        advanced {
            executionMappingIdentifier: 207108014271628906
        }
        serverSideCondition {
            whenButtonPressed: @desfazer
        }
    )

    process efetuar-parcelamento (
        name: Efetuar Parcelamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 --
                 vidpepinorepres number := :P283_IDPEPINOREPRESENTANTE;
                 vqtdparcelas    number;
                 vvalortotal     number(15,2);
                 vvalorparcela   number(15,2);
                 vjuros          number(15,2) := 1;
                 vvalorapagar    number(15,2);
                 vdatavencimento date;
                 vvalororiginal  number(15,2);
                 vvalorentrada   number(15,2);
                 verro           varchar2(2000);
                 vtarefa         number;
                 vidconta        number := trim(to_number(:P283_IDCONTABANCARIA,'999G999G999G999D00'));
                 vtipoparcelamento varchar2(1) := :P283_TIPOPARCELAMENTO;
                 --
                begin
                  --
                  vqtdparcelas     := trim(to_number(:P283_QTDPARCELAMENTO,'999G999G999G999D00'));
                  vvalorentrada    := trim(to_number(:P283_VALORENTRADA,'999G999G999G999D00'));
                  --
                  select valor - nvl(( select sum(valor)
                                 from pepinosrepresentantes
                                 where nrpedido = P.NRPEDIDO
                                   and idrepresentante = P.IDREPRESENTANTE
                                   and situacao = 'P' ),0)
                  into vvalortotal
                  from pepinosrepresentantes P
                  where idpepinosrepresentante = :P283_IDPEPINOREPRESENTANTE;
                  --
                  begin
                    --
                    select idtarefa
                    into vtarefa
                    from catal.tarefas t
                    where t.situacao = 'A'
                      and t.usuario = v('APP_USER');
                  exception
                    when others then
                      null;
                    --
                  end;
                  --
                  if vtipoparcelamento = 'E' then
                    --
                    vdatavencimento := to_date(:P283_VENCIMENTOENTRADA,'DD/MM/RRRR');
                    vvalororiginal := trim( (vvalortotal-vvalorentrada)  / vqtdparcelas);
                    vvalorapagar := trim( (vvalortotal-vvalorentrada)/ vqtdparcelas);
                    --
                    insert into parcelamentospepinosrepres 
                    values (seq_idparcpepinosrepres.nextval, vidpepinorepres, vdatavencimento, trim(to_number(:P283_VALORENTRADA,'999G999G999G999D00')), vjuros, trim(to_number(:P283_VALORENTRADA,'999G999G999G999D00')), 'A', null, vidconta, null, 'N',null,null);
                    --
                  elsif vtipoparcelamento = 'S' then
                    --
                    vvalororiginal := trim(vvalortotal/vqtdparcelas);
                    vvalorapagar := trim(vvalortotal/vqtdparcelas);
                    vdatavencimento := sysdate;
                    --
                  end if;
                  --
                  for i in 1..vqtdparcelas
                  loop
                    --
                    vdatavencimento := vdatavencimento + 30;
                    -- vvalorapagar    := vvalorapagar + (vvalorapagar * 0,01);
                    --
                    insert into parcelamentospepinosrepres 
                    values (seq_idparcpepinosrepres.nextval, vidpepinorepres, vdatavencimento, vvalororiginal, vjuros, vvalorapagar, 'A', null, vidconta, null, 'N',null,null);
                    --
                  end loop;
                  --
                  insert into OBSERVACOESPEPINOSREPRES
                  values (seq_idobspepinosrepres.nextval, vidpepinorepres, sysdate, 'Parcelamento da negociação realizado.', v('APP_USER'), null);
                  --
                  begin
                    insert into catal.TAREFASNEGOCIACOES
                    values (catal.SEQ_IDTAREFASNEGOCIACAO.nextval, sysdate, vtarefa, vidpepinorepres, null, v('APP_USER'),null);
                  exception
                    when others then
                      null;
                  end;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Parcelamento realizado com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 207107929762628905
        }
        serverSideCondition {
            whenButtonPressed: @parcelar
        }
    )

    branch (
        name: go to page 283
