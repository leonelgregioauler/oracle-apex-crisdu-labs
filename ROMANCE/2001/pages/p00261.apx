page 261 (
    name: Log Pessoas
    title: Log Pessoas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region log-de-pessoas (
        name: Log de Pessoas
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region log-pessoas (
        name: Log Pessoas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.idlog
                     , l.dataalteracao
                     , l.usuarioalteracao 
                     , decode(l.tipoalteracao, 'INSERT', 'Inserido'
                                             , 'UPDATE', 'Atualizado'
                                             , 'DELETE', 'Deletado') tipoalteracao
                     , l.idpessoa
                     , l.nomepessoa
                     , l.enderecoprincipal
                     , l.enderecosecundario
                     , (select c.nomecidade
                          from cidades c
                         where c.idcidade = l.idcidade) cidade
                     , l.email
                     , l.cpf
                     , l.cnpj
                     , l.apelido
                     , decode(l.tipopessoa, 'F', 'Física'
                                          , 'J', 'Jurídica') tipopessoa
                     , l.observacao
                     , l.referencia
                     , l.ativo
                     , l.numero
                     , l.complemento
                     , l.bairro
                     , l.cep
                     , l.usuariocadastrou
                from logcatal.log_pessoas l
                where idpessoa = :P261_IDPESSOA
                order by 1 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Não há informações.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 67346179758973712
