    pageItem P261_IDPESSOA (
        type: popupLov
        label {
            label: Pessoa
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||p.cpf||') ['||/*Translate(To_Char(*/cpf/*/100 ,'000,000,000.00') ,',.' ,'.-')*/||']' display_value
                     , p.idpessoa return_value
                from pessoas p
                    , vendedoras v
                where p.ativo = 'S'
                  and p.idpessoa = v.idpessoa
                  and v.idrepresentante in (select idrepresentante
                                            from representantes 
                                            where idgerente = (select idgerente
                                                               from gerentes
                                                               where idfilial = :P0_IDFILIAL))
                
                ```
        }
        layout {
            sequence: 10
            region: @log-de-pessoas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 10
            region: @log-de-pessoas
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
            point: processing
        }
        behavior {
            target: {
                page: 261
                items: {
                    P261_IDPESSOA: &P261_IDPESSOA.
                }
                action: resetPagination
            }
        }
    )

