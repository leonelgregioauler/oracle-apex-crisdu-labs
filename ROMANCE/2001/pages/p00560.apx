    pageItem P560_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P560_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                with filiais_escopo as (
                  -- Mesma regra de escopo de filial usada em query_estoquefilial_filtro_p0_idfilial.sql
                  -- (Comercial Romance / regional / America Latina / todas / uma especifica).
                  select f.idfilial
                  from roman.vw_filiais_filtro f
                  where f.ref_filial =  :P0_IDFILIAL
                )
                select distinct
                       (p.codigosisdist ||' - '|| pck_romance.fnc_nomeproduto(e.idproduto)) display_value
                     , e.idproduto return_value
                from estoquefilial e
                   , produtos      p
                   , filiais_escopo fe
                where e.idproduto = p.idproduto
                  and e.idfilial  = fe.idfilial
                  and e.ativo     = 'S'
                order by 1
                
                ```
            nullDisplayValue: - Todos -
            nullReturnValue: -1
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        default {
            type: static
            staticValue: -1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P560_IDSEMANAATE (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00'))||'/'||trim(to_char(ano,'0000')) dsplay_value
                     , s.idsemana return_value
                from semana_dias s
                where s.dt_fim < sysdate
                 -- and s.dt_fim > sysdate- 265
                order by ano desc, semana desc
                ```
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P560_IDSEMANADE (
        type: selectList
        label {
            label: De
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00'))||'/'||trim(to_char(ano,'0000')) dsplay_value
                     , s.idsemana return_value
                from semana_dias s
                where s.dt_fim < sysdate
                  --and s.dt_fim > sysdate- 265
                order by ano desc, semana desc
                ```
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

