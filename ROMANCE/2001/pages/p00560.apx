    region estoque-atual (
        name: Estoque Atual
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with filiais_escopo as (
                  select f.idfilial
                  from roman.vw_filiais_filtro f
                  where f.ref_filial = :P0_IDFILIAL
                )
                -- 1) Vendas acertadas (situação 4) no período, já agregadas por estoque
                , vendas as (
                  select it.idestoquefil
                       , count(*)                             qtdnotas      -- mesma regra atual (conta itens)
                       , sum(it.quantidade)                   distribuidos
                       , sum(it.quantidade - it.qtddevolvida) vendido
                  from notasvendas    nv
                  join filiais_escopo fe on fe.idfilial = nv.idfilial
                  join itensnotavenda it on it.idnotavenda = nv.idnotavenda
                  where nv.idsituacaonotavenda = 4
                    and nv.idsemanacobranca between to_number(:P560_IDSEMANADE)
                                                and to_number(:P560_IDSEMANAATE)
                  group by it.idestoquefil
                )
                -- 2) Base: só os estoques que tiveram venda no período
                , base as (
                  select /*+ materialize */
                         e.idestoquefilial, e.idfilial, e.idproduto, e.ativo, e.comissao, e.vlrvenda
                       , nvl(e.qtd_pp,0) + nvl(e.qtd_p,0)  + nvl(e.qtd_m,0)    + nvl(e.qtd_g,0)
                       + nvl(e.qtd_gg,0) + nvl(e.qtd_egg,0) + nvl(e.qtd_exgg,0) + nvl(e.qtd_u,0) qtd_fisica
                       , v.qtdnotas, v.distribuidos, v.vendido
                  from vendas         v
                  join estoquefilial  e  on e.idestoquefilial = v.idestoquefil
                  join filiais_escopo fe on fe.idfilial       = e.idfilial
                  where (:P560_IDPRODUTO = -1 or e.idproduto = to_number(:P560_IDPRODUTO))
                )
                -- 3) Reserva: mesma regra de pck_estoque.fnc_estoquereserva, somando todos os tamanhos
                , res_carga as (
                  select b.idestoquefilial
                       , sum( nvl(i.qtd_dist_pp,0) + nvl(i.qtd_dist_p,0)   + nvl(i.qtd_dist_m,0)
                            + nvl(i.qtd_dist_g,0)  + nvl(i.qtd_dist_gg,0)  + nvl(i.qtd_dist_egg,0)
                            + nvl(i.qtd_dist_exgg,0)
                            + case when i.estoquemovto = 'D' then nvl(i.qtd_dist_u,0) else 0 end ) qtd
                  from base b
                  join itenscargarepresentante i  on i.idestoquefil = b.idestoquefilial
                  join cargasrepresentantes    cc on cc.idcargarepresentante = i.idcargarepresentante
                                                 and cc.idfilial = b.idfilial
                  where i.cargaamais = 'N'
                    and cc.situacao in (1, 2)
                  group by b.idestoquefilial
                )
                , res_vd as (
                  select b.idestoquefilial
                       , sum( nvl(it.qtd_pp,0) + nvl(it.qtd_p,0)   + nvl(it.qtd_m,0)    + nvl(it.qtd_g,0)
                            + nvl(it.qtd_gg,0) + nvl(it.qtd_egg,0) + nvl(it.qtd_exgg,0) + nvl(it.qtd_u,0) ) qtd
                  from base b
                  join itensvendadireta it on it.idestoquefil = b.idestoquefilial
                  join vendasdiretas    v  on v.idvendadireta = it.idvendadireta
                                          and v.idfilial      = b.idfilial
                  where v.idsituacao in (1, 2)
                    and not exists ( select 1
                                     from movimentosestoquefilial me
                                     where me.iditemvendadireta = it.iditemvendadireta )
                  group by b.idestoquefilial
                )
                , res_transf as (
                  select b.idestoquefilial
                       , sum( nvl(i.qtd_pp,0) + nvl(i.qtd_p,0)   + nvl(i.qtd_m,0)    + nvl(i.qtd_g,0)
                            + nvl(i.qtd_gg,0) + nvl(i.qtd_egg,0) + nvl(i.qtd_exgg,0) + nvl(i.qtd_u,0) ) qtd
                  from base b
                  join notasfiscais n on n.idfilialemitente = b.idfilial
                  join itemnf       i on i.idnotafiscal     = n.idnotafiscal
                                     and i.idproduto        = b.idproduto
                  where n.situacaofilial = 'A'
                    and n.situacao       = 'A'
                    and n.tiponota       = 'T'
                  group by b.idestoquefilial
                )
                -- 4) Último recebimento e em aberto, só para as linhas da base
                , ult_receb as (
                  select b.idestoquefilial, max(nf.datarecebimento) ultimorecebimento
                  from base b
                  join notasfiscais nf on nf.idfilialdestino = b.idfilial
                  join itemnf       ii on ii.idnotafiscal    = nf.idnotafiscal
                                      and ii.idproduto       = b.idproduto
                  group by b.idestoquefilial
                )
                , em_aberto as (
                  select b.idestoquefilial, sum(i.quantidade) emaberto
                  from base b
                  join itensnotavenda i  on i.idestoquefil = b.idestoquefilial
                  join notasvendas    nv on nv.idnotavenda = i.idnotavenda
                                        and nv.idfilial    = b.idfilial
                  where nv.idsituacaonotavenda = 3
                  group by b.idestoquefilial
                )
                -- 5) Montagem final
                select filial, categoria, codigo, produto, ativo, idestoquefilial, idfilial, idproduto
                     , comissao, vlrvenda, edtotal, ultimorecebimento
                     , qtdnotas, qtdnotascomprod, distribuidos, vendido
                     , case when vendido > 0 and :P560_IDSEMANAATE != :P560_IDSEMANADE
                            then edtotal / ( vendido / ( to_number(:P560_IDSEMANAATE) - to_number(:P560_IDSEMANADE) ) )
                            else 0
                       end tempodeestoque
                     , mediaporsacola
                     , emaberto
                from (
                  select pck_romance.fnc_nomefilial(b.idfilial) filial
                       , c.nome          categoria
                       , p.codigosisdist codigo
                       , p.nomeproduto   produto
                       , decode(b.ativo, 'S', 'Sim', 'Não')            ativo
                       , b.idestoquefilial
                       , b.idfilial
                       , b.idproduto
                       , decode(b.comissao, 'S', 'Sim', 'N', 'Não')    comissao
                       , b.vlrvenda
                       , b.qtd_fisica - ( nvl(rc.qtd,0) + nvl(rv.qtd,0) + nvl(rt.qtd,0) ) edtotal
                       , ur.ultimorecebimento
                       , b.qtdnotas
                       , b.qtdnotas qtdnotascomprod
                       , b.distribuidos
                       , b.vendido
                       , case when b.qtdnotas > 0 then b.distribuidos / b.qtdnotas else 0 end mediaporsacola
                       , nvl(ea.emaberto,0) emaberto
                  from base b
                  join produtos   p on p.idproduto   = b.idproduto
                  join categorias c on c.idcategoria = p.idcategoria
                  left join res_carga  rc on rc.idestoquefilial = b.idestoquefilial
                  left join res_vd     rv on rv.idestoquefilial = b.idestoquefilial
                  left join res_transf rt on rt.idestoquefilial = b.idestoquefilial
                  left join ult_receb  ur on ur.idestoquefilial = b.idestoquefilial
                  left join em_aberto  ea on ea.idestoquefilial = b.idestoquefilial
                )
                where (qtdnotas + distribuidos + vendido + mediaporsacola) > 0
                ```
        }
