    region estoque-atual-view (
        name: Estoque Atual - view
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                             pck_romance.fnc_nomefilial(e.idfilial ) filial
                             , c.nome categoria
                             , p.codigosisdist "Código"
                             , p.nomeproduto produto
                             , decode(e.ativo,'S','Sim','Não') ativo
                             , e.idestoquefilial
                             , e.idfilial
                             , e.idproduto
                             , decode(e.comissao, 'S', 'Sim','N','Não') comissao
                             , e.vlrvenda       
                             ----
                             , (nvl(e.qtd_pp  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'PP')  )
                             + (nvl(e.qtd_p   ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'P')   )
                             + (nvl(e.qtd_m   ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'M')   )
                             + (nvl(e.qtd_g   ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'G')   )
                             + (nvl(e.qtd_gg  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'GG')  )
                             + (nvl(e.qtd_egg ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EGG') )
                             + (nvl(e.qtd_exgg,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EXGG'))
                             + (nvl(e.qtd_u   ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'U')) "ED TOTAL"         
                             ----
                             , ( select max( nf.datarecebimento)
                                 from notasfiscais nf
                                 where nf.idfilialdestino = e.idfilial
                                   and exists ( select 1
                                                from itemnf ii
                                                where ii.idnotafiscal = nf.idnotafiscal
                                                  and ii.idproduto = e.idproduto ) ) "Ultimo Recebimento"
                             ----
                             , sum(case when n.idsemanacobranca between :P560_IDSEMANADE AND :P560_IDSEMANAATE  
                                    then n.qtdnotas
                                    else 0
                                end) qtdnotas
                             ----
                             , sum(case when n.idsemanacobranca between :P560_IDSEMANADE AND :P560_IDSEMANAATE
                                    then n.qtdnotascomprod
                                    else 0
                                end) qtdnotascomprod
                             ----
                             , sum(case when n.idsemanacobranca between :P560_IDSEMANADE AND :P560_IDSEMANAATE
                                    then n.distribuidos
                                    else 0
                                end) distribuidos
                             ----
                             , sum(case when n.idsemanacobranca between :P560_IDSEMANADE AND :P560_IDSEMANAATE
                                    then n.vendido
                                    else 0
                                end) Vendido
                                
                             ----
                             , sum(case when n.idsemanacobranca between :P560_IDSEMANADE AND :P560_IDSEMANAATE
                                    then n.comConsultoras
                                    else 0
                                end) comconsultorasnoperiodo
                                
                             ----
                             , case when sum(case when n.idsemanacobranca between :P560_IDSEMANADE AND :P560_IDSEMANAATE
                                                  then n.vendido
                                                  else 0
                                              end) > 0 and :P560_IDSEMANAATE != :P560_IDSEMANADE
                                              
                                         then (  (nvl(e.qtd_pp  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'PP')  )
                                               + (nvl(e.qtd_p   ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'P')   )
                                               + (nvl(e.qtd_m   ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'M')   )
                                               + (nvl(e.qtd_g   ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'G')   )
                                               + (nvl(e.qtd_gg  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'GG')  )
                                               + (nvl(e.qtd_egg ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EGG') )
                                               + (nvl(e.qtd_exgg,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EXGG'))
                                               + (nvl(e.qtd_u   ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'U')) )   / 
                                           
                                           ( sum(case when n.idsemanacobranca between :P560_IDSEMANADE AND :P560_IDSEMANAATE
                                                      then n.vendido
                                                      else 0
                                                  end)   /    ( to_number(:P560_IDSEMANAATE) - to_number(:P560_IDSEMANADE ) ))   
                                    else 
                                    0
                                    end  tempodeestoque             
                             ----
                             , case when sum(case when n.idsemanacobranca between :P560_IDSEMANADE AND :P560_IDSEMANAATE  
                                                  then n.qtdnotascomprod
                                                  else 0
                                              end) > 0
                                    then sum(case when n.idsemanacobranca between :P560_IDSEMANADE AND :P560_IDSEMANAATE
                                                  then n.distribuidos
                                                  else 0
                                              end)    /  sum(case when n.idsemanacobranca between :P560_IDSEMANADE AND :P560_IDSEMANAATE 
                                                                  then n.qtdnotascomprod
                                                                  else 0
                                                              end) 
                                    else
                                      0
                                end mediaporsacola
                             ----
                
                             , NVL( ( select sum(i.quantidade)
                                         from itensnotavenda i
                                         where i.idestoquefil = e.idestoquefilial
                                           and i.idproduto    = e.idproduto
                                           and exists ( select 1
                                                        from notasvendas nv
                                                        where nv.idnotavenda         = i.idnotavenda     
                                                          and nv.idsituacaonotavenda = 3
                                                          and nv.idfilial            = e.idfilial
                                                        --  and n.dataacerto between to_date(:P560_ATE||' 00:00:00','DD/MM/RRRR HH24:MI:SS' ) and to_date(:P560_ATE||' 23:59:59','DD/MM/RRRR HH24:MI:SS' ) 
                                                          ) )  ,0) emaberto
                             
                        from estoquefilial  e 
                           , categorias     c
                           , produtos       p
                           , vw_notasvendas_qtd n
                                                 
                        where e.idfilial        = :P0_IDFILIAL
                          and e.idproduto       = p.idproduto  
                          and p.idcategoria     = c.idcategoria
                
                          and e.idfilial        = n.idfilial(+)
                          and e.idestoquefilial = n.idestoquefil(+)
                          
                          and ( :P560_IDPRODUTO = -1 or e.idproduto = :P560_IDPRODUTO )
                          and :P560_FILTRAR = 'S'
                  and 1=2         
                  group by   pck_romance.fnc_nomefilial(e.idfilial ) 
                             , c.nome
                             , p.codigosisdist
                             , p.nomeproduto 
                             , decode(e.ativo,'S','Sim','Não') 
                             , e.idestoquefilial
                             , e.idfilial
                             , e.idproduto
                             , decode(e.comissao, 'S', 'Sim','N','Não') 
                             , e.vlrvenda 
                             , e.qtd_pp
                             , e.qtd_p   
                             , e.qtd_m   
                             , e.qtd_g   
                             , e.qtd_gg  
                             , e.qtd_egg 
                             , e.qtd_exgg
                             , e.qtd_u 
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
