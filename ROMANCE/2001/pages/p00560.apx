    region estoque-atual-antiga (
        name: Estoque Atual_antiga
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select filial "Filial"
                     , categoria "Categoria"
                     , codigo "Código" 
                     , produto "Produto"   
                     , cor "Cor"    
                     , ativo
                     , e.idestoquefilial
                     , e.idfilial
                     , e.idproduto
                     , e.idcor
                     , comissao
                     , e.vlrvenda 
                     , edtotal "ED TOTAL"     
                     , vendido   
                     , case 
                         when vendido > 0 and :P560_IDSEMANAATE != :P560_IDSEMANADE then
                            edtotal / (vendido/( to_number(:P560_IDSEMANAATE) - to_number(:P560_IDSEMANADE ) ))   
                          else 
                            0
                          end tempodeestoque
                     , distribuidos   
                     , ultimorecebimento
                   --, comconsultorasnoperiodo
                     , qtdnotas
                     , qtdnotascomprod
                     , emaberto
                     , case
                         when qtdnotascomprod > 0 then
                           distribuidos /qtdnotascomprod 
                         end mediaporsacola
                from (     
                      select pck_romance.fnc_nomefilial(e.idfilial ) filial
                           , ( select c.nome
                               from categorias c
                               where c.idcategoria = ( select pr.idcategoria
                                                       from produtos pr
                                                       where pr.idproduto = e.idproduto ) ) categoria
                           , ( select pr.codigosisdist
                               from produtos pr
                               where pr.idproduto = e.idproduto )  codigo 
                           , ( select pr.nomeproduto 
                               from produtos pr
                               where pr.idproduto = e.idproduto )  produto 
                           , ( select c.descricao
                               from cores c
                               where c.idcor = e.idcor)  cor 
                           , decode(e.ativo,'S','Sim','Não') ativo
                           , e.idestoquefilial
                           , e.idfilial
                           , e.idproduto
                           , e.idcor
                           , decode(e.comissao, 'S', 'Sim','N','Não') comissao
                           , e.vlrvenda       
                      /*     , '|' "EF"
                           , nvl(e.qtd_pp ,0) "EF PP" 
                           , nvl(e.qtd_p  ,0) "EF P"  
                           , nvl(e.qtd_m  ,0) "EF M"  
                           , nvl(e.qtd_g  ,0) "EF G"  
                           , nvl(e.qtd_gg ,0) "EF GG" 
                           , nvl(e.qtd_egg,0) "EF EGG"
                           , nvl(e.qtd_exgg,0) "EF EXGG"
                           , nvl(e.qtd_u  ,0) "EF U"  
                           , '|' "ER"
                           , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'PP')  "ER PP"
                           , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'P')   "ER P"
                           , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'M')   "ER M"
                           , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'G')   "ER G"
                           , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'GG')  "ER GG"
                           , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EGG') "ER EGG"
                           , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EXGG') "ER EXGG"
                           , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'U')   "ER U"     
                           , '|' "ED"
                           , nvl(e.qtd_pp ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'PP')  "ED PP"
                           , nvl(e.qtd_p  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'P')   "ED P"
                           , nvl(e.qtd_m  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'M')   "ED M"
                           , nvl(e.qtd_g  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'G')   "ED G"
                           , nvl(e.qtd_gg ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'GG')  "ED GG"
                           , nvl(e.qtd_egg,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EGG') "ED EGG"
                           , nvl(e.qtd_exgg,0)- pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EXGG') "ED EXGG"
                           , nvl(e.qtd_u  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'U')   "ED U"         */
                           --    
                           , (nvl(e.qtd_pp ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'PP')  )
                           + (nvl(e.qtd_p  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'P')   )
                           + (nvl(e.qtd_m  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'M')   )
                           + (nvl(e.qtd_g  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'G')   )
                           + (nvl(e.qtd_gg ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'GG')  )
                           + (nvl(e.qtd_egg,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EGG') )
                           + (nvl(e.qtd_exgg,0)- pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EXGG'))
                           + (nvl(e.qtd_u  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'U')) edtotal         
                           , ( select max( n.datarecebimento)
                               from notasfiscais n
                               where n.idfilialdestino = e.idfilial
                                 and exists ( select 1
                                              from itemnf i
                                              where i.idnotafiscal = n.idnotafiscal
                                                and i.idproduto = e.idproduto ) ) ultimorecebimento
                           , ( select count(1)
                               from notasvendas n
                               where n.idfilial    = e.idfilial
                                 and n.idsituacaonotavenda = 4
                                 and n.idsemanacobranca between :P560_IDSEMANADE AND :P560_IDSEMANAATE  ) qtdnotas
                           , ( select count(1)
                               from notasvendas n
                               where n.idfilial    = e.idfilial
                                 and n.idsituacaonotavenda = 4
                                 and n.idsemanacobranca between :P560_IDSEMANADE AND :P560_IDSEMANAATE  
                                 and exists ( select 1
                                              from itensnotavenda i
                                              where i.idnotavenda  = n.idnotavenda
                                                and i.idestoquefil = e.idestoquefilial ) ) qtdnotascomprod
                           , NVL( ( select sum(i.quantidade)
                                       from itensnotavenda i
                                       where i.idestoquefil = e.idestoquefilial 
                                         and exists ( select 1
                                                      from notasvendas n
                                                      where n.idnotavenda = i.idnotavenda
                                                        and n.idfilial    = e.idfilial
                                                        and n.idsituacaonotavenda = 4
                                                        and n.idsemanacobranca between :P560_IDSEMANADE AND :P560_IDSEMANAATE
                                                        --and n.dataacerto between to_date(:P560_ATE||' 00:00:00','DD/MM/RRRR HH24:MI:SS' ) and to_date(:P560_ATE||' 23:59:59','DD/MM/RRRR HH24:MI:SS' ) 
                                                        ))  ,0) distribuidos /* distribuidos de notas acertadas no periodo*/
                           , NVL( ( select sum(i.quantidade - i.qtddevolvida)
                                       from itensnotavenda i
                                       where i.idestoquefil = e.idestoquefilial 
                                         and exists ( select 1
                                                      from notasvendas n
                                                      where n.idnotavenda = i.idnotavenda
                                                        and n.idfilial    = e.idfilial
                                                        and n.idsituacaonotavenda = 4
                                                        and n.idsemanacobranca between :P560_IDSEMANADE AND :P560_IDSEMANAATE
                                                        --and n.dataacerto between to_date(:P560_ATE||' 00:00:00','DD/MM/RRRR HH24:MI:SS' ) and to_date(:P560_ATE||' 23:59:59','DD/MM/RRRR HH24:MI:SS' ) 
                                                        ))  ,0) vendido     
                           , NVL( ( select sum(i.quantidade)
                                       from itensnotavenda i
                                       where i.idestoquefil = e.idestoquefilial 
                                         and exists ( select 1
                                                      from notasvendas n
                                                      where n.idnotavenda = i.idnotavenda     
                                                        and n.idsituacaonotavenda = 3
                                                        and n.idfilial    = e.idfilial
                                                        and n.idsemanacobranca between :P560_IDSEMANADE AND :P560_IDSEMANAATE
                                                      --  and n.dataacerto between to_date(:P560_ATE||' 00:00:00','DD/MM/RRRR HH24:MI:SS' ) and to_date(:P560_ATE||' 23:59:59','DD/MM/RRRR HH24:MI:SS' ) 
                                                        ) )  ,0) comconsultorasnoperiodo
                           , NVL( ( select sum(i.quantidade)
                                       from itensnotavenda i
                                       where i.idestoquefil = e.idestoquefilial 
                                         and exists ( select 1
                                                      from notasvendas n
                                                      where n.idnotavenda = i.idnotavenda     
                                                        and n.idsituacaonotavenda = 3
                                                        and n.idfilial    = e.idfilial
                                                      --  and n.dataacerto between to_date(:P560_ATE||' 00:00:00','DD/MM/RRRR HH24:MI:SS' ) and to_date(:P560_ATE||' 23:59:59','DD/MM/RRRR HH24:MI:SS' ) 
                                                        ) )  ,0) emaberto
                      from estoquefilial e 
                      where e.idfilial  = :P0_IDFILIAL
                        and ( :P560_IDPRODUTO = -1 or e.idproduto = :P560_IDPRODUTO ) ) e
                where 1 = 2
                ```
        }
