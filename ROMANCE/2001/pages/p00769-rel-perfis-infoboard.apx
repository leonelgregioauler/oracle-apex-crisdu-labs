page 769 (
    name: Rel Perfis Infoboard
    alias: REL-PERFIS-INFOBOARD
    title: Rel Perfis Infoboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region rel-perfis-infoboard (
        name: Rel Perfis Infoboard
        type: interactiveReport
        source {
            location: localDatabase
            tableName: PERFISINFOBOARD
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 770
                items: {
                    P770_IDPERFILINFOBOARD: \#IDPERFILINFOBOARD#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 377225095911889707
        }

        column IDMODINFOBOARD (
            type: plainTextBasedOnLov
            heading {
                heading: Módulo Infoboard
            }
            lov {
                lov: @modulosinfoboard-nomeinfoboard
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            columnFilter {
                type: defaultBasedOnColumnType
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDPERFILINFOBOARD (
            type: hidden
            heading {
                heading: Idperfilinfoboard
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMEPERFIL (
            type: plainText
            heading {
                heading: Nome Perfil
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Rel Perfis Infoboard
        }

        savedReport 3772822 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IDMODINFOBOARD (
                sequence: 2
            )

            displayColumn IDPERFILINFOBOARD (
                sequence: 1
            )

            displayColumn NOMEPERFIL (
                sequence: 3
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Perfil
        layout {
            sequence: 10
            region: @rel-perfis-infoboard
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 770
                clearCache: 770
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @rel-perfis-infoboard
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @rel-perfis-infoboard
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

