    dynamicAction valida-de-para (
        name: Valida DE_PARA
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @salvar
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                        apex.message.clearErrors();
                    
                        // Só valida se Tipo Produto = E
                        if ($v("P797_TIPOPRODUTO") !== "E") {
                            return;
                        }
                    
                        var region = apex.region("ig_classificacoes");
                        var gridView = region.widget().interactiveGrid("getViews", "grid");
                        var model = gridView.model;
                    
                        var encontrouErro = false;
                        var linhaErro = null;
                        var linha = 0;
                    
                        function getValor(valor) {
                            if (valor === null || valor === undefined) {
                                return null;
                            }
                    
                            // Quando a coluna é LOV, o APEX pode retornar objeto {v,d}
                            if (typeof valor === "object" && valor.v !== undefined) {
                                return valor.v;
                            }
                    
                            return valor;
                        }
                    
                        function estaVazio(valor) {
                            valor = getValor(valor);
                            return valor === null || valor === undefined || String(valor).trim() === "";
                        }
                    
                        model.forEach(function (record, index, id) {
                            var meta = model.getRecordMetadata(id);
                    
                            // Ignora linha marcada para exclusão
                            if (meta && meta.deleted) {
                                return;
                            }
                    
                            linha++;
                    
                            var idProdFav = model.getValue(record, "IDPRODDETAL_FAV");
                            var idProdRom = model.getValue(record, "IDPRODDETAL_ROM");
                    
                            if (estaVazio(idProdFav) || estaVazio(idProdRom)) {
                                encontrouErro = true;
                                linhaErro = linha;
                                return false;
                            }
                        });
                    
                       if (encontrouErro) {
                        apex.message.showErrors([
                            {
                                type: "error",
                                location: "page",
                                message: "Quando o Tipo Produto for 'Estoque CD', é obrigatório informar Produto Favorita e Produto RMC em todas as classificações. Verifique a linha " + linhaErro + ".",
                                unsafe: false
                            }
                        ]);
                    
                        apex.event.gCancelFlag = true;
                        return false;
                    } else {
                        apex.page.submit("SALVAR");
                    }
                    })();
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SALVAR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process busca-dados (
        name: Busca Dados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                --
                vbrinde        varchar2(50);
                vrecompensa    varchar2(1);
                vstatus        varchar2(1);
                vclassificacao varchar2(1);
                vidbrinde      number;
                vidpais        number;
                vqtdmaxima     number;
                vtipoproduto   varchar2(1);
                vdescricao     roman.brindesclub.descricao%type;
                --
                begin
                  --
                  select b.nomebrinde, b.recompensa, b.status, b.classificacao,b.IDBRINDECLUBE, b.idpais, b.qtdemaxima, b.tipoproduto, b.descricao
                    into vbrinde, vrecompensa, vstatus, vclassificacao,vidbrinde, vidpais, vqtdmaxima, vtipoproduto, vdescricao
                  from roman.brindesclub b 
                  where b.idbrindeclube = :P797_IDBRINDECLUBE;
                  --
                  :P797_BRINDE          := vbrinde;
                  :P797_STATUS          := vstatus;
                  :P797_CLASSIFICACOES  := vclassificacao;
                  :P797_RECOMPENSA      := vrecompensa;
                  :P797_IDBRINDECLUBE   := vidbrinde;
                  :P797_IDPAIS          := vidpais;
                  :P797_QTDEMAXIMA      := vqtdmaxima;
                  :P797_TIPOPRODUTO     := vtipoproduto;
                  :P797_DESCRICAO       := vdescricao;
                  --
                  exception
                    when others then 
                    null;
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1800964464470206006
        }
