    region classificações (
        name: Classificações
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cb.idclassifbrindeclub
                     , cb.status
                     , cb.idclassificacao
                     , cb.idbrindeclube
                     , cb.idcaracteristica
                     , cb.idproddetal_fav
                     --, favorita.pck_util_fav.fnc_nomeprodutodetalhado(cb.idproddetal_fav, bc.idpais) desc_prod_det_fav
                     , cb.idproddetal_rom 
                    -- , roman.pck_romance.fnc_nomeproduto(cb.idproddetal_rom ) desc_prod_rmc
                from roman.classificacoesbrindesclub cb
                    , roman.brindesclub bc
                where cb.idbrindeclube = bc.idbrindeclube
                  and cb.idbrindeclube = :P797_IDBRINDECLUBE
                
                ```
        }
