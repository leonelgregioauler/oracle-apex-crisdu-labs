    process processo-classificação (
        name: Processo Classificação
        type: executeCode
        editableRegion: @classificações
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  --
                  vseqgrid number;
                  vclassif varchar(1); 
                  vverificadepara number := 0;
                  --
                BEGIN
                  --
                  begin 
                    --
                    select 'S'
                      into vclassif
                      from dual
                     where exists ( select 1
                                      from roman.classificacoesbrindesclub ct 
                                     where ct.idclassifbrindeclub = :IDCLASSIFBRINDECLUB);
                    --
                    exception 
                      when no_data_found then
                        vclassif := 'N';
                  end;
                  -- Linha NOVA (Create)
                  IF :APEX$ROW_STATUS = 'C' THEN
                    --
                    IF :P797_TIPOPRODUTO = 'C' THEN -- COMPRA EXTERNA NAO TEM DE/PARA
                      --
                      IF ( NVL(:idproddetal_fav,0)  + NVL(:idproddetal_rom,0) ) > 0 THEN
                        --
                        raise_application_error(-20001,'Brinde do tipo COMPRA EXTERNA não pode tem vínculo com produtos Favorita ou RMC nas classificações'||( NVL(:idproddetal_fav,0)  + NVL(:idproddetal_rom,0) ) );
                        --
                      END IF;
                      --
                    END IF;
                    --
                    select roman.seq_idclassifbrindeclub.nextval
                      into vseqgrid
                      from dual;
                    --
                    insert into roman.classificacoesbrindesclub(idclassifbrindeclub,
                                                                idbrindeclube,
                                                                status,
                                                                idclassificacao,
                                                                idcaracteristica,
                                                                idproddetal_fav,
                                                                idproddetal_rom)
                                                        values (vseqgrid,
                                                               :P797_IDBRINDECLUBE,
                                                               :STATUS,
                                                               :IDCLASSIFICACAO,
                                                               :IDCARACTERISTICA,
                                                               :idproddetal_fav,
                                                               :idproddetal_rom)
                    
                  RETURNING IDCLASSIFBRINDECLUB INTO :IDCLASSIFBRINDECLUB;
                   --
                  --Linha ALTERADA (Update)
                  ELSIF :APEX$ROW_STATUS = 'U' THEN
                    --
                     IF :P797_TIPOPRODUTO = 'C' THEN -- COMPRA EXTERNA NAO TEM DE/PARA
                      --
                      select count (*)
                        into vverificadepara
                        from roman.classificacoesbrindesclub c
                       where c.idbrindeclube = :P797_IDBRINDECLUBE
                         and ( nvl(c.idproddetal_fav,0) + nvl(c.idproddetal_rom,0) ) > 0;
                      --
                      IF vverificadepara > 0 THEN
                        --
                        raise_application_error(-20002,'Brinde do tipo COMPRA EXTERNA não pode tem vínculo com produtos Favorita ou RMC nas classificações' );
                        --
                      END IF;
                      --
                    END IF;
                    --
                    if vclassif = 'S' then 
                      --
                      UPDATE roman.classificacoesbrindesclub clb
                         SET idclassificacao   = :IDCLASSIFICACAO,
                             idcaracteristica  = :IDCARACTERISTICA,
                             status            = :STATUS,
                             idproddetal_fav   = :idproddetal_fav,
                             idproddetal_rom   = :idproddetal_rom
                       WHERE clb.idclassifbrindeclub = :IDCLASSIFBRINDECLUB;
                    else
                      --
                      raise_application_error(-20003,'Alteração não pode ser realizada, o brinde possui vinculo com campanha' );
                      --
                    end if; 
                      --
                  --Linha EXCLUÍDA (Delete)
                  ELSIF :APEX$ROW_STATUS = 'D' THEN
                    --
                    if vclassif = 'S' then 
                      -- 
                      begin
                        --
                        delete roman.classificacoesbrindesclub clb
                         where clb.idclassifbrindeclub = :IDCLASSIFBRINDECLUB
                           and clb.idclassificacao = :IDCLASSIFICACAO
                           and clb.idcaracteristica = :IDCARACTERISTICA
                           and clb.idbrindeclube = :IDBRINDECLUBE;
                        --
                        exception
                         when others then
                          if sqlcode = -2292 then raise_application_error(-20003, 'Não é possível excluir esta classificação, pois existem registros vinculados a Campanhas!');
                          else
                           raise; -- mantém qualquer outro erro “como é”
                          end if;
                  end;
                    else
                      --
                      raise_application_error(-20004,'Exclusão não pode ser realizada, o brinde possui vinculo com campanha' );
                      --
                    end if; 
                      
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 1801610532350389921
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

    process processo-dml-brinde (
        name: Processo DML Brinde
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vseq number;
                  vseqgrid number;
                  vtemclassifi varchar2(1) := 'N';
                  vidclassificacao number;
                 -- vidcaracteristica number;
                  v_qtd_class number;
                  v_verifica number := 0;
                  --
                begin
                --
                --apex_application.g_print_success_message := 'REQUEST: '||v('REQUEST');  --
                --
                  -- raise_application_error(-20001,v('REQUEST'));
                  if v('REQUEST') = 'INSERIR' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'SALVAR' then
                    --
                    voperacao_dml := 'U';
                    --  
                  elsif v('REQUEST') = 'EXCLUIR' then
                    --
                    voperacao_dml := 'D';
                    --
                  end if;
                  --
                  if voperacao_dml in ('I','U') and :P797_QTDEMAXIMA < 0 then
                    --
                    raise_application_error(-20001,'Número inválido para o campo "Quantidade Máxima" ');
                    --
                  end if;
                  --
                  if voperacao_dml = 'I' then 
                    --
                    select roman.seq_idbrindeclube.nextval
                      into vseq
                      from dual;
                    --
                    :P797_IDBRINDECLUBE := vseq;
                    --
                    insert into roman.brindesclub(idbrindeclube,
                                                  nomebrinde,
                                                  classificacao,
                                                  recompensa,
                                                  status,
                                                  idpais,
                                                  descricao,
                                                  qtdemaxima,
                                                  tipoproduto)
                                           values(vseq,
                                                  :P797_BRINDE,
                                                  :P797_CLASSIFICACOES,
                                                  :P797_RECOMPENSA,
                                                  :P797_STATUS,
                                                  :P797_IDPAIS,
                                                  :P797_DESCRICAO,
                                                  :P797_QTDEMAXIMA,
                                                  :P797_TIPOPRODUTO);
                    --
                    commit;
                    --
                    -- Projeto V3 decidido que todos os brinde terão classificação
                    /*begin 
                    -- Verifica se o brinde tem classificação
                    select bd.classificacao
                      into vtemclassifi
                    from roman.brindesclub bd
                    where bd.idbrindeclube = :P797_IDBRINDECLUBE
                      and bd.classificacao = 'N';
                
                    exception 
                      when others then 
                       vtemclassifi := null;
                
                     end;*/
                
                    --
                    if  vtemclassifi = 'N' then
                      --
                      insert into roman.classificacoesbrindesclub(idclassifbrindeclub,
                                                                  idbrindeclube,
                                                                  status,
                                                                  idclassificacao,
                                                                  idcaracteristica)
                                                           values(roman.seq_idclassifbrindeclub.nextval,
                                                                  :P797_IDBRINDECLUBE,
                                                                  :P797_STATUS,
                                                                  0,
                                                                  0);
                               
                    end if;
                    --
                  elsif voperacao_dml = 'U' then
                    --
                    update roman.brindesclub b
                       set b.nomebrinde  = :P797_BRINDE,
                           b.recompensa  = :P797_RECOMPENSA,
                           b.status      = :P797_STATUS,
                           b.idpais      = :P797_IDPAIS,
                           b.descricao   = :P797_DESCRICAO,
                           b.qtdemaxima  = :P797_QTDEMAXIMA,
                           b.tipoproduto = :P797_TIPOPRODUTO,
                           b.classificacao = :P797_CLASSIFICACOES
                     where b.idbrindeclube = :P797_IDBRINDECLUBE;
                    --
                  elsif voperacao_dml = 'D' then
                    --
                    -- Ounico impedimento de exclusão é o uso do brinde em campanha
                    select count(*)
                      into v_verifica
                      from roman.ITENSCONQLEVCUPONS b
                     where b.idbrindeclube = :P797_IDBRINDECLUBE;
                    --
                    if v_verifica > 0 then
                      --
                      raise_application_error(-20001,'Este Brinde não pode ser excluido pois está sendo usado em Campanha. Sujestão: Inativar Brinde');
                      --
                    end if;
                    --
                    -- caso nao esteja sendo usado em campanha, pode ser excluido
                    delete from roman.fotosbrindesconqlev b
                          where b.idbrindeclube = :P797_IDBRINDECLUBE;
                    --
                    delete from roman.categoriasbrindes b
                     where b.idbrindeclube = :P797_IDBRINDECLUBE;
                    --
                    -- Valida se existe classificação vinculada ao brinde
                    /*select count(*)
                      into v_qtd_class
                      from roman.classificacoesbrindesclub cb
                     where cb.idbrindeclube = :P797_IDBRINDECLUBE;
                    --
                    begin
                      --
                      select cb.idclassificacao
                        into vidclassificacao
                        from roman.classificacoesbrindesclub cb
                       where cb.idbrindeclube = :P797_IDBRINDECLUBE;
                    exception 
                       when no_data_found then 
                         vidclassificacao := 0;
                    end;
                    --
                
                    if v_qtd_class > 0 and vidclassificacao != 0 then
                      --
                      raise_application_error(-20002,'Não é possível excluir este brinde, pois existem classificações vinculadas a ele. ' ||
                                                     'Exclua primeiro as classificações para depois excluir o brinde.');
                    end if;*/
                
                    -- Se o brinde for sem classificação remove o vinculo para poder remover o brinde. 
                    delete roman.classificacoesbrindesclub cbc 
                     where cbc.idbrindeclube = :P797_IDBRINDECLUBE;
                
                    -- Se não tiver vínculo, pode excluir 
                    delete roman.brindesclub b
                     where b.idbrindeclube = :P797_IDBRINDECLUBE;
                    --
                  end if;
                  --
                  COMMIT;
                  --
                  if voperacao_dml = 'I' then
                     --
                     apex_application.g_print_success_message := '<span style="color : black ">Brinde Cadastrado com sucesso! </span>';  
                      
                  elsif  voperacao_dml = 'U' then
                     --
                     apex_application.g_print_success_message := '<span style="color : black ">Alteração realizada com sucesso! </span>';
                    
                  elsif  voperacao_dml = 'D' then
                     --
                     apex_application.g_print_success_message := '<span style="color : black ">Exclusão realizada com sucesso! </span>';
                  end if;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1800476731072830432
        }
    )

