        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1)
                from favorita.tarefas t
                where t.idgrupoatendimento = 73
                  and t.datainicio is null
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P384_TIPODATA (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Não Atendidas;N,Atendimento Iniciado;A
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar Tarefas
        layout {
            sequence: 120
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-data (
        name: Tipo Data
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P384_TIPODATA
        }
        clientSideCondition {
            type: item=value
            item: P384_TIPODATA
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P384_DATAINICIO
                    P384_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P384_DATAINICIO
                    P384_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        name: Go To Page 384
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 384
                items: {
                    P384_ATENDENTE: &P384_ATENDENTE.
                    P384_IDTIPOTAREFA: &P384_IDTIPOTAREFA.
                    P384_DATAINICIO: &P384_DATAINICIO.
                    P384_DATAFIM: &P384_DATAFIM.
                    P384_IDREPRESENTANTE: &P384_IDREPRESENTANTE.
                    P384_IDFILIAL: &P384_IDFILIAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

