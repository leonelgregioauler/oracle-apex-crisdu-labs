            plsqlExpression: sysdate
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P384_IDFILIAL (
        type: selectList
        label {
            label: Empresa Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo      = 'S'
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P384_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes 
                                      where idfilial = :P384_IDFILIAL )
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P384_IDFILIAL
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P384_IDTIPOTAREFA (
        type: selectList
        label {
            label: Tipo de Tarefa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao
                     , tt.idtipotarefa
                from favorita.tipostarefas tt
                where tt.idtipotarefa in (14,15,16,17,18,19,22,26,27,31,64,65)
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

