    region acompanhamento-semanal (
        name: Acompanhamento Semanal
        type: chart
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: lineWithArea
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series qtd-por-dia (
            name: Qtd Por Dia
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_date(t.dia,'DD/MM/RRRR') dia
                         , t.nome
                         , t.quantidade
                    from ( select 'Total' nome
                                , count(1) quantidade
                                , trunc(t.datainicio) dia
                           from favorita.tarefas t
                           where t.idgrupoatendimento = 73
                             and trunc(t.datainicio) between trunc(sysdate)-7 and trunc(sysdate)+1
                           group by trunc(t.datainicio) ) t
                    order by 1;
                    
                    ```
            }
            columnMapping {
                seriesName: NOME
                label: DIA
                value: QUANTIDADE
                customColumn: NOME
            }
            marker {
                show: true
                shape: circle
            }
        )

        axis x (
            name: x
            title: DIA
            value {
                format: dateShort
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: QTD
            value {
                format: decimal
            }
            minorTicks {
                show: false
            }
        )

    )

    region filtros (
