    region por-atendente (
        name: Por Atendente
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomeusuario(taf.idusuario) atendente
                     , taf.qtd quantidade
                from ( select count(1) qtd
                            , t.idusuario
                       from favorita.tarefas t
                       where t.idgrupoatendimento = 73
                         and t.datainicio is not null
                       group by t.idusuario ) taf
                order by 2 desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent6
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: ATENDENTE
            valueColumn: QUANTIDADE
            colorScheme: modern2
        }
    )

    region por-empresa (
        name: Por Empresa
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(taf.idfilial) empresa
                     , taf.qtd quantidade
                from ( select count(1) qtd
                            , v.idfilial
                       from favorita.tarefas t
                          , vendedoras v
                       where t.idgrupoatendimento = 73
                         and t.datainicio is not null
                         and v.idpessoa = t.idpessoa
                       group by v.idfilial ) taf
                order by 2 desc
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent7
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: QUANTIDADE
            colorScheme: modern2
            maximumRows: 20
        }
    )

    pageItem P384_ATENDENTE (
        type: selectList
        label {
            label: Atendente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) display_value
                     , u.idusuario return_value
                from usuarios u
                   , pessoas p
                where p.idpessoa = u.idpessoa 
                  and exists ( select 1
                               from usuariosgruposatendimento uu
                               where uu.usuario = u.usuario
                                 and uu.idgrupoatendimento = 73)
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P384_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
