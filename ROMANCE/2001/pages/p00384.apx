    region acompanhamento-diário (
        name: Acompanhamento Diário
        type: chart
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--noBorder
                t-Region--scrollBody
            ]
