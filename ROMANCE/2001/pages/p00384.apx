        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: lineWithArea
        }
        title {
            title: Atendimento por Hora
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            hideAndShowBehavior: none
        }

        series qtd-por-hora (
            name: Qtd Por Hora
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select h.hora
                         , t.nome
                         , t.quantidade
                    from roman.horas h
                       , ( select 'Total' nome
                                , count(1) quantidade
                                , to_number(to_char(t.datainicio,'HH24')) hora
                           from favorita.tarefas t
                           where t.idgrupoatendimento = 73
                             and trunc(t.datainicio) = trunc(sysdate)
                           group by to_number(to_char(t.datainicio,'HH24')) ) t
                    where h.hora  = t.hora(+)
                    order by 1
                    ```
            }
            columnMapping {
                seriesName: NOME
                label: HORA
                value: QUANTIDADE
                customColumn: NOME
            }
            marker {
                show: true
                shape: circle
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    region acompanhamento-dos-atendimentos (
        name: Acompanhamento dos Atendimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtarefa
                     , t.tipotarefa
                     , t.telefone
                     , t.datainclusao
                     , t.datainicio
                     , t.situacao
                     , t.observacao
                     , ( select pck_romance.fnc_nomerepresentante(v.idrepresentante)
                         from vendedoras v
                         where v.idpessoa = t.idpessoa ) distribuidor
                     , t.cliente
                     , replace(t.historicos, 'CLIENTE ABORDADO COM SUCESSO', '') Historicos
                     , t.nomeusuario
                     , t.cpfcliente
                from favorita.vw_tarefas_fav t
                where t.idgrupoatendimento = 73
                  and t.ididioma           = 1
                  and ( :P384_ATENDENTE is null or t.idusuario = :P384_ATENDENTE )
                  and ( :P384_IDTIPOTAREFA is null or t.idtipotarefa = :P384_IDTIPOTAREFA )
                  and ( :P384_TIPODATA = 'N' and t.datainicio is null 
                     or ( :P384_TIPODATA = 'A' and trunc(t.datainicio) between to_date(:P384_DATAINICIO) and to_date(:P384_DATAFIM) ) )
                  and ( :P384_IDFILIAL is null or exists ( select 1
                                                           from vendedoras v
                                                           where v.idpessoa = t.idpessoa
                                                             and v.idfilial = :P384_IDFILIAL ) )
                  and ( :P384_IDREPRESENTANTE is null or exists ( select 1
                                                                  from vendedoras v
                                                                  where v.idpessoa = t.idpessoa 
                                                                    and v.idrepresentante = :P384_IDREPRESENTANTE ) )
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma Tarefa Encontrada
        }
        advanced {
            savedReportMappingIdentifier: 1422413549484678828
        }

