page 193 (
    name: Habilitar Produtos
    title: Habilitar Produtos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region habilitar-produtos (
        name: Habilitar Produtos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idestoquefilial
                     , pck_romance.fnc_nomefilial(idfilial) filial
                     , idproduto
                     , ativo
                     , comissao
                     , vlrvenda
                     , idestoquefilial id
                from estoquefilial
                where idproduto = :P193_IDPRODUTO
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column ATIVO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: radioGroup
            heading {
                heading: Ativo
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
                displayNullValue: false
            }
            layout {
                sequence: 4
            }
            element {
                numberOfColumns: 2
            }
        )

        column COMISSAO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: radioGroup
            heading {
                heading: Comissão
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
                displayNullValue: false
            }
            layout {
                sequence: 5
            }
            element {
                numberOfColumns: 2
            }
        )

        column FILIAL (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
        )

        column ID (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 7
            }
        )

        column IDESTOQUEFILIAL (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 1
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDESTOQUEFIL
            }
        )

        column IDPRODUTO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: item
                item: P289_IDPRODUTO
            }
        )

        column VLRVENDA (
            reportColumnQueryId: 6
            derivedColumn: N
            type: textField
            heading {
                heading: Vlr Venda
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
                width: 8
            }
            advanced {
                customAttributes: " style=\"text-align:right\""
            }
        )

    )

    pageItem P193_IDPRODUTO (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomeproduto) display_value
                     , idproduto return_value
                from produtos
                where idproduto = :P193_IDPRODUTO
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @habilitar-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @habilitar-produtos
            slot: topAndBottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: window.parent.location.reload(); window.close();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 20
            region: @habilitar-produtos
            slot: topAndBottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation comissao (
        name: COMISSAO
        execution {
            sequence: 100
        }
        validation {
            editableRegion: @habilitar-produtos
            type: columnIsNotNull
            column: COMISSAO
        }
        error {
            errorMessage: Informe se tem comissão!
            associatedColumn: COMISSAO
        }
    )

    validation vlrvenda-must-be-numeric (
        name: VLRVENDA must be numeric
        execution {
            sequence: 90
        }
        validation {
            editableRegion: @habilitar-produtos
            type: columnIsNumeric
            column: VLRVENDA
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: VLRVENDA
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @habilitar-produtos
        target {
            tableName: ESTOQUEFILIAL
            pkColumn: IDESTOQUEFILIAL
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 32717535612297736
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 289
            }
        }
    )

)

