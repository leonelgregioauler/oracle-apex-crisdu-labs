page 306 (
    name: Produtos por Categoria
    title: Produtos por Categoria
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region produtos-por-categoria (
        name: Produtos por Categoria
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomeproduto
                 , p.codigosisdist 
                 , decode(p.comissao,'S','Sim','N','Não') comissao
                 , p.precovenda
                 , decode(p.ativo,'S','Sim','N','Não') ativo
                from produtos p
                where p.idcategoria = :P306_IDCATEGORIA
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 2000
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum produto cadastrado na categoria
        }
        componentAdvanced {
            stripHtml: true
        }

        column ATIVO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Ativo
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column CODIGOSISDIST (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column COMISSAO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Comissão
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column NOMEPRODUTO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column PRECOVENDA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Preço Venda
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P306_IDCATEGORIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @produtos-por-categoria
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

