page 660 (
    name: Notas de Rep. atende
    title: Notas de Rep. atende
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region notas-de-rep-atende (
        name: "Notas de Rep. atende "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.numeronota 
                     , roman.pck_romance.fnc_nomevendedora(nv.idvendedora) consultora
                     , roman.pck_romance.fnc_nomerepresentante (nv.idrepresentante) Distribuidor
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.valortotalnota
                     , p.valorpago
                     , nv.idnotavenda
                  from roman.notasvendas nv
                     , roman.pagamentosnotasvendas p
                where p.idnotavenda = nv.idnotavenda
                  --and nv.idrepresentanteatende = p.idrepresentanteacertou
                  and nv.idrepresentanteatende = :P75_IDREPRESENTANTE
                  and nv.idsituacaonotavenda = 4
                  and p.valorpago > 0
                  and p.origem = 'R'
                  and p.idsemanacobranca = ( select d.idsemana 
                                               from fechamentossemanais d
                                             where idfechamento = :P75_IDFECHAMENTOPONTUACAO ) 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 99339294088623603
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 200
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: BL
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 220
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: BN
            }
        )

        column IDNOTAVENDA (
            type: plainText
            heading {
                heading: Idnotavenda
                alignment: center
            }
            layout {
                sequence: 230
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: BO
            }
        )

        column NUMERONOTA (
            type: plainText
            heading {
                heading: Nota
                alignment: center
            }
            layout {
                sequence: 190
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: S
            }
        )

        column SEMANACOBRANCA (
            type: plainText
            heading {
                heading: Semana de Cobrança
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column SEMANADISTRIBUICAO (
            type: plainText
            heading {
                heading: Semana de Distribuição
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALORPAGO (
            type: plainText
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 160
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: P
            }
        )

        column VALORTOTALNOTA (
            type: plainText
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 993734 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn CONSULTORA (
                sequence: 7
            )

            displayColumn DATASEMANADISTRIBUICAO (
                sequence: 1
            )

            displayColumn DISTRIBUIDOR (
                sequence: 8
            )

            displayColumn IDNOTAVENDA (
                sequence: 9
            )

            displayColumn NUMEROIDSITUACAONOTAVENDA (
                sequence: 5
            )

            displayColumn SEMANACOBRANCA (
                sequence: 2
            )

            displayColumn TIPOVLRFRETE (
                sequence: 6
            )

            displayColumn VALORPAGO (
                sequence: 4
            )

            displayColumn VALORTOTALVALORTOTALDEVOLUCAO (
                sequence: 3
            )

            aggregate (
                column: VALORPAGO
            )

        )

    )

    pageItem P660_IDFECHAMENTOPONTUACAO (
        type: hidden
        layout {
            sequence: 20
            region: @notas-de-rep-atende
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P660_IDREPRESENTANTE (
        type: hidden
        layout {
            sequence: 10
            region: @notas-de-rep-atende
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

