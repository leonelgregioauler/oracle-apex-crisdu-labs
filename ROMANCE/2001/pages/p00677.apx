page 677 (
    name: Produtos para Faturamento
    title: Produtos para Faturamento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <font color="red"><h3>Importante! Este relatório considera apenas notas que estão QUITADAS!</h3></font>
        }
    )

    region relação-de-produtos (
        name: Relação de Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist
                     , p.nomeproduto
                     , sum(it.quantidade) distribuidor
                     , sum(it.quantidade - it.qtddevolvida) venvido
                     , sum( (it.quantidade - it.qtddevolvida) * it.valorvenda ) totalvendido
                     , round((sum(it.quantidade - it.qtddevolvida) / sum(it.quantidade)) * 100,2) percentual_vendido
                     , round((sum( (it.quantidade - it.qtddevolvida) * it.valorvenda ) * 0.80)*0.70) vendido_com_descontos
                from itensnotavenda it
                   , produtos p
                   , notasvendas nv
                where it.idnotavenda = nv.idnotavenda
                  and p.idproduto    = it.idproduto
                  and ( :P677_TIPO_PESQUISA is null
                     or ( :P677_TIPO_PESQUISA = 'S' and nv.idsemanacobranca = :P677_IDSEMANA )
                     or ( :P677_TIPO_PESQUISA = 'P' and nv.idsemanacobranca between :P677_IDSEMANA_INI and :P677_IDSEMANA_FIM ) )
                  and nv.idsituacaonotavenda = 4
                  and nv.idrepresentante = :P677_IDREPRESENTANTE
                  and nv.valorpago > 0 
                  and nv.saldo = 0
                group by p.codigosisdist
                       , p.nomeproduto;
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 33117718570152225
        }

        column CODIGOSISDIST (
            type: plainText
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuído
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column NOMEPRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column PERCENTUAL_VENDIDO (
            type: plainText
            heading {
                heading: % Vendido
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column TOTALVENDIDO (
            type: plainText
            heading {
                heading: Total Vendido
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column VENDIDO_COM_DESCONTOS (
            type: plainText
            heading {
                heading: Total com Descontos
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column VENVIDO (
            type: plainText
            heading {
                heading: Vendido
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 5632525 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CODIGOSISDIST (
                sequence: 1
            )

            displayColumn DISTRIBUIDOR (
                sequence: 3
            )

            displayColumn NOMEPRODUTO (
                sequence: 2
            )

            displayColumn PERCENTUAL_VENDIDO (
                sequence: 6
            )

            displayColumn TOTALVENDIDO (
                sequence: 5
            )

            displayColumn VENDIDO_COM_DESCONTOS (
                sequence: 7
            )

            displayColumn VENVIDO (
                sequence: 4
            )

        )

    )

    pageItem P677_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||r.idrepresentante d
                     , r.idrepresentante r
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente
                  and g.idfilial = :P0_IDFILIAL
                  and r.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: - Escolha o Distribuidor -
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P677_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semanacompleta
                     , idsemana
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-1 and to_char(sysdate,'RRRR')
                order by s.idsemana desc
                ```
            nullDisplayValue: - Escolha a Semana -
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P677_IDSEMANA_FIM (
        type: selectList
        label {
            label: até Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semanacompleta
                     , idsemana
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-1 and to_char(sysdate,'RRRR')
                order by s.idsemana desc
                ```
            nullDisplayValue: "- Escolha a Semana - "
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P677_IDSEMANA_INI (
        type: selectList
        label {
            label: Semana de
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semanacompleta
                     , idsemana
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-1 and to_char(sysdate,'RRRR')
                order by s.idsemana desc
                ```
            nullDisplayValue: - Escolha a Semana -
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P677_TIPO_PESQUISA (
        type: radioGroup
        label {
            label: Tipo Pesquisa
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Semana;S,Pesquisa;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-semana (
        name: Tipo Semana
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P677_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P677_TIPO_PESQUISA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P677_IDSEMANA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P677_IDSEMANA_INI
                    P677_IDSEMANA_FIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P677_IDSEMANA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P677_IDSEMANA_INI
                    P677_IDSEMANA_FIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 677
                items: {
                    P677_TIPO_PESQUISA: &P677_TIPO_PESQUISA.
                    P677_IDSEMANA: &P677_IDSEMANA.
                    P677_IDSEMANA_INI: &P677_IDSEMANA_INI.
                    P677_IDSEMANA_FIM: &P677_IDSEMANA_FIM.
                    P677_IDREPRESENTANTE: &P677_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

