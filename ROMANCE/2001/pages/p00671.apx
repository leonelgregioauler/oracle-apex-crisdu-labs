        column PAGOTOTALACORDOCONV (
            type: plainText
            heading {
                heading: Pago Total Acordo (R$)
                alignment: center
            }
            layout {
                sequence: 410
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: CO
            }
            serverSideCondition {
                type: expression
                language: sql
                sqlExpression:
                    ```sql
                    exists ( select 1
                             from roman.negociacoesparceiros n
