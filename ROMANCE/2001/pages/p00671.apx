    pageItem P671_CANAL (
        type: radioGroup
        label {
            label: <b>Origem do Pagamento:</b>
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Cobrança Interna;B,Cobraki;C,Débitos Romance;A,Todos;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P671_CONSULTORA (
        type: popupLov
        label {
            label: <b>Consultora:</b>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' CPF: '||p.cpf d
                     , v.idvendedora r
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and ( :P671_DISTRIBUIDOR is null or v.idrepresentante = :P671_DISTRIBUIDOR  )
                  and ( :P671_FRANQUIA is null or v.idfilial = :P671_FRANQUIA )
                  and ( :P671_IDPAIS = 1)
                union
                select initcap(p.nomepessoa)||' Doc. Estran.: '||p.documentoestrangeiro d
                     , v.idvendedora r
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and ( :P671_DISTRIBUIDOR is null or v.idrepresentante = :P671_DISTRIBUIDOR  )
                  and ( :P671_FRANQUIA is null or v.idfilial = :P671_FRANQUIA )
                  and ( :P671_IDPAIS != 1)
                order by 1
                
                ```
        }
        layout {
            sequence: 130
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

