    region relatório-de-pagamentos-detalhado (
        name: "Relatório de Pagamentos (Detalhado) "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select * 
                from ( select distinct (y.idnegociacaoparceiro)
                            , y.idnegociacaoparceiro link
                            , y.franquia
                            , y.nome
                            , y.Distribuidor
                            , y.Documento
                            , y.tipo_debito 
                            , y.valororiginal
                            , nvl(y.valororiginal * y.fatorconversao, 0) valororiginalconv 
                            , y.valoratualizado
                            , nvl(y.valoratualizado * y.fatorconversao, 0) valoratualizadoconv 
                            , y.juro
                            , nvl(y.juro * y.fatorconversao, 0) juroconv 
                            , y.valordescontoneg 
                            , nvl(y.valordescontoneg * y.fatorconversao,0)  valordescontonegconv
                            , y.valorfinalneg 
                            , nvl(y.valorfinalneg * y.fatorconversao, 0) valorfinalconv 
                            , y.valorpagoneg
                            , nvl(y.valorpagoneg * y.fatorconversao, 0) valorpagonegconv 
                            , y.nmr_debito
                            , y.datanegociacao
                            , y.formapgto
                            , y.vendedora
                            , y.origem_negociacao
                            , y.pagovigente 
                            , nvl(y.pagovigente * y.fatorconversao, 0) pagovigenteconv
                            , nvl(y.saldo,0) saldotitulo
                            , nvl((y.saldo  * y.fatorconversao),0) saldotituloconv
                            , y.dtpagamento
                            , nvl( ( select sum(dc.valorfinal)
                                     from roman.documentosnegociacao dc
                                     where dc.idnegociacaoparceiro = y.idnegociacaoparceiro ),0) vlrfinalacordo
                            --
                            , nvl( ( select sum(dc.valorfinal)
                                  from roman.documentosnegociacao dc
                                  where dc.idnegociacaoparceiro = y.idnegociacaoparceiro ) *  y.fatorconversao,0 )  vlrfinalacordoconv
                            --
                            , nvl( ( select sum(pg.valorparcela) 
                                     from roman.pagamentosnegociacoesparceiros pg
                                     where pg.idnegociacaoparceiro =  y.idnegociacaoparceiro
                                     and pg.situacao = 'A' ) ,0) Saldoacordo
                            --
                            , nvl( ( select sum(pg.valorparcela) 
                                     from roman.pagamentosnegociacoesparceiros pg
                                     where pg.idnegociacaoparceiro =  y.idnegociacaoparceiro
                                     and pg.situacao = 'A' )  *  y.fatorconversao ,0) Saldoacordoconv
                            --
                            , nvl( ( select sum(pg.valorparcela) 
                                     from roman.pagamentosnegociacoesparceiros pg
                                     where pg.idnegociacaoparceiro =  y.idnegociacaoparceiro
                                     and pg.situacao = 'Q' ) ,0) pagototalacordo
                            --
                            , nvl( ( select sum(pg.valorparcela) 
                                     from roman.pagamentosnegociacoesparceiros pg
                                     where pg.idnegociacaoparceiro =  y.idnegociacaoparceiro
                                     and pg.situacao = 'Q' )  *  y.fatorconversao  ,0) pagototalacordoconv
                      
                            -- Considerar pagamentos realizados no tablet com data posterior a data de envio para cobrança e que não tenha código de liberação. 
                          /*  , nvl( ( select sum(pn.valorpago)
                                     from roman.pagamentosnotasvendas pn
                                        , roman.documentosnegociacao d
                                        , roman.notasvendas nv
                                     where pn.idnotavenda = d.idnotavenda
                                       and nv.idnotavenda = pn.idnotavenda
                                       and d.idnegociacaoparceiro = y.idnegociacaoparceiro
                                       and pn.origem = 'R'
                                       and pn.valorpago > 0
                                       and nv.enviadocobranca = 'S'
                                       and trunc(pn.datapagamento) > trunc(nv.dataenviadocobranca) 
                                       and not exists ( select 1 
                                                        from roman.codigosliberacoescobranca c 
                                                        where c.idnotavenda = nv.idnotavenda ) ),0)  pagodis */ --(Osiel) --Removido por solicitação da Alexia durante homologação. 
                            --
                           /* , nvl( ( select sum(pn.valorpago)
                                     from roman.pagamentosnotasvendas pn
                                        , roman.documentosnegociacao d
                                        , roman.notasvendas nv
                                     where pn.idnotavenda = d.idnotavenda
                                       and nv.idnotavenda = pn.idnotavenda
                                       and d.idnegociacaoparceiro = y.idnegociacaoparceiro
                                       and pn.origem = 'R'
                                       and pn.valorpago > 0
                                       and nv.enviadocobranca = 'S'
                                       and trunc(pn.datapagamento) > trunc(nv.dataenviadocobranca) 
                                       and not exists ( select 1 
                                                        from roman.codigosliberacoescobranca c 
                                                        where c.idnotavenda = nv.idnotavenda ) ) *  y.fatorconversao ,0)  pagodisconv */ --(Osiel) --Removido por solicitação da Alexia durante homologação. 
                
                            --
                            , case
                                 when 'S' = ( select v.spc
                                              from catal.vendedoras v
                                              where v.idvendedora = y.vendedora
                                                and v.spc = 'S' ) then 'Sim'
                              else 'Não'  
                              end enviada
                            --
                            , case
                                 when y.tipo_debito = 'Nota' then ( select nv.datanota
                                                                    from roman.notasvendas nv
                                                                    where nv.idnotavenda = y.nmr_debito )
                                 when y.tipo_debito = 'Pedido' then ( select ped.dataemissao
                                                                     from favorita.pedidos ped
                                                                     where ped.idpedido = y.nmr_debito )
                                 when y.tipo_debito = 'Pepino' then ( select pp.datainclusao
                                                                      from roman.pepinosrepresentantes pp
                                                                      where pp.nrpedido = y.nmr_debito
                                                                        and pp.idpepinosrepresentante = y.idpepinorepres )
                                 when y.tipo_debito = 'Boleto' then ( select b.dataemissao
                                                                      from catal.boletos b
                                                                      where b.numero = y.nmr_debito
                                                                        and b.idboleto = y.idboleto ) 
                             end data_debito
                             --
                            , case
                                 when y.tipo_debito = 'Nota' then ( select extract(year from nv.datanota)
                                                                    from roman.notasvendas nv
                                                                    where nv.idnotavenda = y.nmr_debito )
                                 when y.tipo_debito = 'Pedido' then ( select extract(year from ped.dataemissao)
                                                                      from favorita.pedidos ped
                                                                      where ped.idpedido = y.nmr_debito )
                                 when y.tipo_debito = 'Pepino' then ( select extract( year from pp.datainclusao) 
                                                                      from roman.pepinosrepresentantes pp
                                                                      where pp.nrpedido = y.nmr_debito
                                                                        and pp.idpepinosrepresentante = y.idpepinorepres )
                                 when y.tipo_debito = 'Boleto' then ( select extract( year from b.dataemissao)
                                                                      from catal.boletos b
                                                                      where b.numero = y.nmr_debito
                                                                        and b.idboleto = y.idboleto ) 
                              end ano_debito
                            --
                            , case 
                                 when y.origem = 'B' then 'Cobrança Interna'
                                 when y.origem = 'A' then 'Plataforma Déb. Romance'
                                 when y.origem = 'C' then 'Cobraki' 
                              end canal_negociacao
                            --
                            , case
                                 when y.tipo_debito in ('Nota','Pepino') then 'Romance'
                                 when y.tipo_debito in ('Pedido','Boleto') then 'Favorita'
                              else 'Não'                                               
                              end origem
                            --
                           , case
                                when y.tipo_debito = 'Nota' then ( select max(ob.data) 
                                                                   from roman.observacoesnotasvendas ob
                                                                      , roman.documentosnegociacao d
                                                                   where ob.idnotavenda = d.idnotavenda
                                                                     and d.idnegociacaoparceiro = y.idnegociacaoparceiro )
                                 when y.tipo_debito = 'Pedido' then ( select max(f.datahistorico) 
                                                                      from favorita.vw_historicospedidos_fav f
                                                                         , roman.documentosnegociacao d
                                                                      where f.idpedido = d.idpedido
                                                                       and d.idnegociacaoparceiro = y.idnegociacaoparceiro )
                                 when y.tipo_debito = 'Pepino' then ( select max(op.data)
                                                                      from roman.observacoespepinosrepres op 
                                                                         , roman.documentosnegociacao d
                                                                      where op.idpepinorepresentante = d.idpepinorepres
                                                                        and d.idnegociacaoparceiro = y.idnegociacaoparceiro )
                                 when y.tipo_debito = 'Boleto' then ( select max(h.data) 
                                                                      from catal.historicos_boletos h
                                                                         , roman.documentosnegociacao d
                                                                      where h.idboleto = d.idboleto
                                                                        and d.idnegociacaoparceiro = y.idnegociacaoparceiro ) 
                             end registro
                             --
                             , ( select max(m.dataenvio)
                                 from roman.mensagenssms m
                                    , catal.pessoas p 
                                    , catal.vendedoras v
                                    , roman.documentosnegociacao d 
                                 where m.idpessoa = p.idpessoa
                                   and p.idpessoa = v.idpessoa
                                   and v.idvendedora = d.idvendedora 
                                   and d.idnegociacaoparceiro = y.idnegociacaoparceiro ) sms
                              --
                              , ( select u.usuario 
                                  from catal.usuarios u 
                                     , roman.negociacoesparceiros n
                                  where n.idusuarioresponsavel = u.idusuario
                                    and n.idnegociacaoparceiro = y.idnegociacaoparceiro ) responsavel     
                       from ( select roman.pck_romance.fnc_nomefilial(n.idfilial) franquia
                                   , roman.pck_romance.fnc_nomevendedora(n.idvendedora) nome 
                                   , roman.pck_romance.fnc_nomerepresentante(n.idrepresentante) Distribuidor 
                                   , nvl(d.valororiginal,0) valororiginal 
                                   , nvl(d.valoratualizado,0) valoratualizado
                                   , nvl((d.valoratualizado - d.valororiginal),0) juro
                                   , nvl(d.valordesconto,0) valordescontoneg 
                                   , nvl(d.valorfinal,0) valorfinalneg 
                                   , nvl(d.valorpago,0) valorpagoneg 
                                   , n.datanegociacao
                                   , n.idnegociacaoparceiro
                                   , d.idpepinorepres
                                   , d.idboleto
                                   , n.origem
                                   , decode(n.formapagamento,'C','Cartão de Credito','D','Deposito','B','Boleto','P','Pix','G','Giro de Pago','T','Giro Tigo') formapgto
                                   , n.idvendedora vendedora
                                   , d.saldo
                                   --
                                   , ( select max(pn.datapagamento) 
                                       from roman.pagamentosnegociacoesparceiros pn 
                                       where pn.idnegociacaoparceiro = n.idnegociacaoparceiro 
                                         and (:P671_DATAINI is not null and trunc(pn.datapagamento) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR') 
                                          or  :P671_DATAINI is not null and pn.datapagamento is null and trunc(pn.databaixa) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR')) ) dtpagamento
                                   --
                                   
                                    , nvl( ( select sum(p.valorparcela) 
                                             from roman.pagamentosnegociacoesparceiros p
                                             where p.idnegociacaoparceiro = n.idnegociacaoparceiro
                                               and p.situacao = 'Q' 
                                               and (trunc(p.datapagamento) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR') 
                                                  or  p.datapagamento is null and trunc(p.databaixa) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR'))),0) pagovigente 
                                    --
                                    , ( select vf.fatorconversao 
                                        from roman.vw_filiais vf
                                        where vf.idfilial = n.idfilial) fatorconversao 
                                    --
                                    , ( select nvl(pe.documentoestrangeiro,roman.pck_romance.fnc_cpfvendedora(vv.idvendedora)) 
                                        from catal.pessoas pe
                                           , catal.vendedoras vv
                                        where pe.idpessoa = vv.idpessoa
                                          and vv.idvendedora = n.idvendedora) Documento
                                    --
                                    , case
                                         when x.carteira = 'F' then 'Pedido'
                                         when x.carteira = 'R' then 'Nota'
                                         when x.carteira = 'P' then 'Pepino'
                                         when x.carteira = 'B' then 'Boleto'
                                      end tipo_debito
                                    --
                                    , case 
                                         when d.idnotavenda is not null then to_char(d.idnotavenda)
                                         when d.idpepinorepres is not null then ( select pr.nrpedido
                                                                                  from roman.pepinosrepresentantes pr
                                                                                  where pr.idpepinosrepresentante = d.idpepinorepres )
                                         when d.idpedido is not null then to_char(d.idpedido)
                                         when d.idboleto is not null then ( select bt.numero
                                                                            from catal.boletos bt
                                                                            where bt.idboleto = d.idboleto )
                                      end nmr_debito
                                    --
                                    , decode( (select 1
                                               from catal.vendedoras v
                                                  , catal.representantes r
                                               where v.idpessoa = r.idpessoa
                                                 and v.idvendedora = n.idvendedora),1,'Distribuidor','Consultora') origem_negociacao
                
                              from roman.documentosnegociacao d
                                 , roman.negociacoesparceiros n
                                 , roman.vw_filiais w
                                 , ( select case
                                               when ddd.idpedido       is not null then 'F'
                                               when ddd.idnotavenda    is not null then 'R'
                                               when ddd.idpepinorepres is not null then 'P'
                                               when ddd.idboleto       is not null then 'B'
                                            end carteira
                                            , ddd.idnegociacaoparceiro
                                            , ddd.idrepresentante
                                            , ddd.iddocumentonegociacao
                                     from roman.documentosnegociacao ddd) x
                                     where d.idnegociacaoparceiro = n.idnegociacaoparceiro
                                       and d.iddocumentonegociacao = x.iddocumentonegociacao
                                       and n.tiponegociacao  is null
                                       and nvl(n.idusuarioresponsavel,0) not in (172,549,5755)
                                       and (:P671_FILTRAR = 'S')
                                       and ( :P671_TIPODATA is null
                                          or ( :P671_TIPODATA = 'N' and n.datanegociacao between to_date(:P671_DATAINI||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P671_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                                          or ( :P671_TIPODATA = 'V' and exists ( select 1
                                                                                 from pagamentosnegociacoesparceiros pp
                                                                                 where pp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                                   and pp.datavencimento between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR') ) )
                                          or ( :P671_TIPODATA = 'P' and exists ( select 1
                                                                                 from pagamentosnegociacoesparceiros pp
                                                                                 where pp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                                   and (trunc(pp.datapagamento) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR')
                                                                                           or  pp.datapagamento is null and trunc(pp.databaixa) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR')) )) )
                                       and ( :P671_FRANQUIA      is null or n.idfilial = :P671_FRANQUIA )
                                       and ( :P671_DISTRIBUIDOR  is null or n.idrepresentante = :P671_DISTRIBUIDOR )
                                       and ( :P671_CONSULTORA    is null or n.idvendedora = :P671_CONSULTORA )
                                       and ( :P671_IDRESPONSAVEL is null or n.idusuarioresponsavel = :P671_IDRESPONSAVEL )
                                       and ( :P671_IDPAIS        is null or n.idpais = :P671_IDPAIS)
                                       and ( :P671_FORMA_PGTO     = 'A' or n.formapagamento = :P671_FORMA_PGTO )
                                       and ( :P671_ORIGEMDEBITO   = 'A' 
                                          or ( :P671_ORIGEMDEBITO = 'F' and d.idpedido is not null or d.idboleto is not null )
                                          or ( :P671_ORIGEMDEBITO = 'R' and d.idnotavenda is not null or d.idpepinorepres is not null ) )
                                       and ( :P671_SITUACAO   = 'T'
                                          or ( :P671_SITUACAO = 'Q' and nvl( ( select sum(pnp.valorparcela)
                                                                               from pagamentosnegociacoesparceiros pnp
                                                                               where pnp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                                 and pnp.situacao  = 'Q'
                                                                                 and pnp.baixarealizada  = 'S' ),0) > 0 )
                                          or ( :P671_SITUACAO = 'E' and nvl( ( select sum(pnp.valorparcela)
                                                                                 from pagamentosnegociacoesparceiros pnp
                                                                                 where pnp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                                   and pnp.situacao  = 'E' ),0) > 0 )
                                          or ( :P671_SITUACAO = 'A' and n.valornegociacao > nvl( ( select sum(pnp.valorparcela)
                                                                                                   from pagamentosnegociacoesparceiros pnp
                                                                                                   where pnp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                                                     and pnp.situacao = 'Q'
                                                                                                     and pnp.baixarealizada = 'S' ),0) ) 
                                          or ( :P671_SITUACAO = 'V' and nvl( ( select sum(pnp.valorparcela)
                                                                               from pagamentosnegociacoesparceiros pnp
                                                                               where pnp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                                 and pnp.situacao  = 'V' ),0) > 0 )) 
                
                                       and (:P671_CANAL   = 'T' 
                                          or (:P671_CANAL = 'A' and n.origem = :P671_CANAL )
                                          or (:P671_CANAL = 'B' and n.origem = :P671_CANAL )
                                          or (:P671_CANAL = 'C' and n.origem = :P671_CANAL ) ) ) y
                                        /*  or (:P671_CANAL = 'R' and exists ( select 1
                                                                             from roman.pagamentosnotasvendas pn
                                                                                , roman.documentosnegociacao d
                                                                                , roman.notasvendas nv
                                                                             where pn.idnotavenda = d.idnotavenda
                                                                               and nv.idnotavenda = pn.idnotavenda
                                                                               and d.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                               and pn.origem = 'R'
                                                                               and pn.valorpago > 0
                                                                               and nv.enviadocobranca = 'S'
                                                                               and trunc(pn.datapagamento) > trunc(nv.dataenviadocobranca) 
                                                                               and not exists ( select 1 
                                                                                                from roman.codigosliberacoescobranca c 
                                                                                                where c.idnotavenda = nv.idnotavenda ) ) )  ) ) y */
                ) yy
                where ( :P671_SPC  = 'A' or ( :P671_SPC = 'S'  and yy.enviada = 'Sim' ) or ( :P671_SPC = 'N'  and yy.enviada = 'Não' ) )
                  and (:P671_ORIGEM_NEGOCIACAO = 'A' or (:P671_ORIGEM_NEGOCIACAO = 'C' and yy.origem_negociacao = 'Consultora') or (:P671_ORIGEM_NEGOCIACAO = 'D' and yy.origem_negociacao = 'Distribuidor'))
                order by yy.idnegociacaoparceiro
                
                ```
        }
