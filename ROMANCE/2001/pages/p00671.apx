    pageItem P671_IDRESPONSAVEL (
        type: selectList
        label {
            label: <b>Responsável Cob.:</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomepessoa) d
                     , u.idusuario r
                from pessoas p
                   , usuarios u
                where p.idpessoa = u.idpessoa
                  and u.idgerente = 80
                  and u.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 140
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

