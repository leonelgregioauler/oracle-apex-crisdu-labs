    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @filtros
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction origem-débito (
        name: Origem Débito
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P671_TIPORELATORIO
        }
        clientSideCondition {
            type: item=value
            item: P671_TIPORELATORIO
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P671_ORIGEMDEBITO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P671_ORIGEMDEBITO
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 671
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 671
                items: {
                    P671_FILTRAR: S
                    P671_CONSULTORA: &P671_CONSULTORA.
                    P671_DISTRIBUIDOR: &P671_DISTRIBUIDOR.
                    P671_FRANQUIA: &P671_FRANQUIA.
                    P671_IDRESPONSAVEL: &P671_IDRESPONSAVEL.
                    P671_DATAINI: &P671_DATAINI.
                    P671_DATAFIM: &P671_DATAFIM.
                    P671_FORMA_PGTO: &P671_FORMA_PGTO.
                    P671_TIPODATA: &P671_TIPODATA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

