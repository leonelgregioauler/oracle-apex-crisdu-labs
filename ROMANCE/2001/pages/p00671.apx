page 671 (
    name: Relatório de Pagamentos
    title: Relatório de Acordos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: FILTROS
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-de-pagamentos-completo (
        name: Relatório de Pagamentos (Completo)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select * 
                from (
                select nm.idnegociacaoparceiro
                     , nm.idnegociacaoparceiro link
                     , nm.datanegociacao
                     , roman.pck_romance.fnc_nomefilial(nm.idfilial) Franquia
                     , roman.pck_romance.fnc_nomevendedora(nm.idvendedora) Consultora
                     , roman.pck_romance.fnc_nomerepresentante(nm.idrepresentante) Distribuidor
                     , decode(nm.formapagamento,'C','Cartão de Credito','D','Deposito','B','Boleto','P','Pix','G','Giro de Pago','T','Giro Tigo') formapgto
                     , nvl(r.pagovigenteroman,0)  pagovigenter
                     , nvl(r.pagovigenteroman  * ( select nvl(vf.fatorconversao,1)  from roman.vw_filiais vf where vf.idfilial = nm.idfilial),0) pagovigenterconv
                     , nvl(f.pagovigentefav,0)  pagovigentef
                     , nvl(f.pagovigentefav  * ( select nvl(vf.fatorconversao,1)  from roman.vw_filiais vf where vf.idfilial = nm.idfilial),0) pagovigentefavconv
                     , nvl(f.saldofav,0) saldofav
                     , nvl(f.saldofav  * ( select nvl(vf.fatorconversao,1)  from roman.vw_filiais vf where vf.idfilial = nm.idfilial),0) saldofavconv
                     , nvl(r.saldoroman,0) saldoroman
                     , nvl(r.saldoroman  * ( select nvl(vf.fatorconversao,1)  from roman.vw_filiais vf where vf.idfilial = nm.idfilial),0) saldoromanconv
                     --, nvl(r.pagodis,0) PagoTablet
                     --, nvl(r.pagodis * ( select nvl(vf.fatorconversao,1)  from roman.vw_filiais vf where vf.idfilial = nm.idfilial),0) PagoTabletconv
                     --
                     , case 
                         when nm.origem = 'B' then 'Cobrança Interna'
                         when nm.origem = 'A' then 'Plataforma Déb. Romance'
                         when nm.origem = 'C' then 'Cobraki'
                       end canal_negociacao
                     --
                     , case
                         when 'S' = ( select v.spc
                                      from catal.vendedoras v
                                      where v.idvendedora = nm.idvendedora
                                        and v.spc = 'S' ) then 'Sim'
                         else 'Não'  
                       end enviada  
                     --
                     , ( select max(pn.datapagamento) 
                         from roman.pagamentosnegociacoesparceiros pn 
                         where pn.idnegociacaoparceiro = nm.idnegociacaoparceiro
                         and (:P671_DATAINI is not null and trunc(pn.datapagamento) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR') 
                          or  :P671_DATAINI is not null and pn.datapagamento is null and trunc(pn.databaixa) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR')) ) dtpagamento
                     --
                     , ( select nvl(pe.documentoestrangeiro,roman.pck_romance.fnc_cpfvendedora(nm.idvendedora)) 
                         from catal.pessoas pe
                            , catal.vendedoras vv
                         where pe.idpessoa = vv.idpessoa
                           and vv.idvendedora = nm.idvendedora) Documento
                     --      
                     , ( select count(p.numeroparcela)
                         from roman.pagamentosnegociacoesparceiros p
                         where p.idnegociacaoparceiro = nm.idnegociacaoparceiro
                           and p.situacao = 'Q' )||'/'||( select max(p.numeroparcela)from roman.pagamentosnegociacoesparceiros p where p.idnegociacaoparceiro = nm.idnegociacaoparceiro ) qtdparcelas
                     --
                     , to_number( ( select count(dc.iddocumentonegociacao) qtd
                                    from roman.documentosnegociacao dc
                                    where dc.idnegociacaoparceiro = nm.idnegociacaoparceiro ) ) qtd_documentos
                     --
                     , nvl( ( select sum(p.valorjuros)
                              from roman.pagamentosnegociacoesparceiros p
                              where p.idnegociacaoparceiro = nm.idnegociacaoparceiro
                                and p.situacao = 'Q' ),0 ) acres_pag
                     , nvl( ( select y.tarifa
                              from ( select sum(x.tarifa) tarifa
                                          , x.idnegociacaoparceiro
                                     from ( select case
                                                     when substr(to_char(p.canalpagamento),
                                                          instr(to_char(p.canalpagamento),'6',1),2) = 61 then 0.45
                                                   else 0.95
                                                   end tarifa
                                                 , p.idnegociacaoparceiro
                                            from roman.pagamentosnegociacoesparceiros p
                                            where p.situacao = 'Q'
                                              and p.canalpagamento is not null) x
                                            group by x.idnegociacaoparceiro) y
                              where y.idnegociacaoparceiro = nm.idnegociacaoparceiro),0) taxa
                     --
                     , nvl(r.valororiginal,0) r_valororiginal
                     , nvl(nvl(r.valororiginal,0) * ( select nvl(vf.fatorconversao,1)  from roman.vw_filiais vf where vf.idfilial = r.idfilial_r),0) r_valororiginal_conv 
                     --
                     , nvl(r.valoratualizado,0)     r_valoratualizado
                     , nvl(nvl(r.valoratualizado,0) * ( select nvl(vf.fatorconversao,1) from roman.vw_filiais vf where vf.idfilial = r.idfilial_r),0) r_valoratualizado_conv
                     --
                     , nvl(r.juro,0) r_juro
                     , nvl(nvl(r.juro,0) * ( select nvl(vf.fatorconversao,1) from roman.vw_filiais vf where vf.idfilial = r.idfilial_r),0) r_juro_conv
                     --
                     , nvl(r.valordesconto,0) r_valordesconto
                     , nvl(nvl(r.valordesconto,0) * ( select nvl(vf.fatorconversao,1) from roman.vw_filiais vf where vf.idfilial = r.idfilial_r),0) r_valordesconto_conv
                     --
                     , nvl(r.valorfinal,0) r_valorfinal
                     , nvl(nvl(r.valorfinal,0) * ( select nvl(vf.fatorconversao,1) from roman.vw_filiais vf where vf.idfilial = r.idfilial_r),0) r_valorfinal_conv
                     --
                     , nvl(r.r_valorpagoneg,0) r_valorpag
                     , nvl(nvl(r.r_valorpagoneg,0) * ( select nvl(vf.fatorconversao,1) from roman.vw_filiais vf where vf.idfilial = r.idfilial_r),0) r_valorpago_conv
                     --
                     , nvl(f.valororiginal,0) f_valororiginal
                     , nvl(nvl(f.valororiginal,0) * ( select nvl(vf.fatorconversao,1) from roman.vw_filiais vf where vf.idfilial = f.idfilial_f),0) f_valororiginal_conv
                     --
                     , nvl(f.valoratualizado,0) f_valoratualizado
                     , nvl(nvl(f.valoratualizado,0) * ( select nvl(vf.fatorconversao,1) from roman.vw_filiais vf where vf.idfilial = f.idfilial_f),0) f_valoratualizado_conv
                     --
                     , nvl(f.juro,0) f_juro
                     , nvl(nvl(f.juro,0) * ( select nvl(vf.fatorconversao,1) from roman.vw_filiais vf where vf.idfilial = f.idfilial_f),0) f_juro_conv
                     --
                     , nvl(f.valordesconto,0) f_valordesconto
                     , nvl(nvl(f.valordesconto,0) * ( select nvl(vf.fatorconversao,1) from roman.vw_filiais vf where vf.idfilial = f.idfilial_f),0) f_valordesconto_conv 
                     --
                     , nvl(f.valorfinal,0)  f_valorfinal
                     , nvl(nvl(f.valorfinal,0) * ( select nvl(vf.fatorconversao,1) from roman.vw_filiais vf where vf.idfilial = f.idfilial_f),0) f_valorfinal_conv 
                     --
                     , nvl(f.valorpagoneg,0) f_valorpago
                     , nvl(nvl(f.valorpagoneg,0) * ( select nvl(vf.fatorconversao,1) from roman.vw_filiais vf where vf.idfilial = f.idfilial_f),0) f_valorpago_conv
                     --
                     , nvl( ( select sum(p.valorparcela)  -- Total pago na negociação
                              from roman.pagamentosnegociacoesparceiros p
                              where p.idnegociacaoparceiro = nm.idnegociacaoparceiro
                                and p.situacao = 'Q' ),0) totalpago
                      , nvl( ( select sum(p.valorparcela)   
                              from roman.pagamentosnegociacoesparceiros p
                              where p.idnegociacaoparceiro = nm.idnegociacaoparceiro
                                and p.situacao = 'Q' ),0) * ( select nvl(vf.fatorconversao,1)  from roman.vw_filiais vf where vf.idfilial = nvl(r.idfilial_r,f.idfilial_f))  totalpagoconv 
                      --           
                      , nvl( ( select sum(p.valorparcela)  -- Total pago na negociação dentro do período filtrado
                               from roman.pagamentosnegociacoesparceiros p
                               where p.idnegociacaoparceiro = nm.idnegociacaoparceiro
                                 and p.situacao = 'Q' 
                                 and (trunc(p.datapagamento) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR') or  p.datapagamento is null and trunc(p.databaixa) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR'))),0) totalpagovigente                                               
                      , nvl( ( select sum(p.valorparcela)
                               from roman.pagamentosnegociacoesparceiros p
                               where p.idnegociacaoparceiro = nm.idnegociacaoparceiro
                                 and p.situacao = 'Q' 
                                 and (trunc(p.datapagamento) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR') or  p.datapagamento is null and trunc(p.databaixa) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR'))),0) * ( select nvl(vf.fatorconversao,1) 
                                                                                                                                                                                                                                                                                                 from roman.vw_filiais vf                                                                                                                                                                                                                                                                                                                                          where vf.idfilial = nvl(r.idfilial_r,f.idfilial_f)) totalpagovigenteconv  
                      --    
                      , nvl((nvl(r.valorfinal,0) + nvl(f.valorfinal,0)),0) valor_final_neg
                      , nvl((nvl(r.valorfinal,0) + nvl(f.valorfinal,0)),0) * ( select nvl(vf.fatorconversao,1) from roman.vw_filiais vf where vf.idfilial = nvl(r.idfilial_r,f.idfilial_f)) valor_final_neg_conv
                      --
                      , nvl( ( select n.saldo
                               from roman.negociacoesparceiros n
                               where n.idnegociacaoparceiro = nm.idnegociacaoparceiro ),0 ) saldo
                      
                      , nvl(nvl( ( select n.saldo
                                   from roman.negociacoesparceiros n
                                   where n.idnegociacaoparceiro = nm.idnegociacaoparceiro ),0 ) * ( select nvl(vf.fatorconversao,1) from roman.vw_filiais vf  where vf.idfilial = nm.idfilial),0) saldoconv 
                      --
                      , ( select max(m.dataenvio)
                           from roman.mensagenssms m
                              , catal.pessoas p 
                              , catal.vendedoras v
                              , roman.documentosnegociacao d 
                           where m.idpessoa = p.idpessoa
                             and p.idpessoa = v.idpessoa
                             and v.idvendedora = d.idvendedora 
                             and d.idnegociacaoparceiro = nm.idnegociacaoparceiro ) sms
                      --     
                      , ( select u.usuario 
                           from catal.usuarios u 
                              , roman.negociacoesparceiros n
                           where n.idusuarioresponsavel = u.idusuario
                             and n.idnegociacaoparceiro = nm.idnegociacaoparceiro ) responsavel
                      --
                      , decode((select 1
                                  from catal.vendedoras v
                                     , catal.representantes r
                                 where v.idpessoa = r.idpessoa
                                   and v.idvendedora = nm.idvendedora),1,'Distribuidor','Consultora') origem_negociacao
                from roman.negociacoesparceiros nm
                -- INICIO VALORES ROMANCE
                    , (select distinct (n.idnegociacaoparceiro) idneg
                            , n.idfilial idfilial_r
                            , sum(nvl(d.valororiginal,0)) valororiginal
                            , sum(nvl(d.valoratualizado,0)) valoratualizado
                            , sum(nvl((d.valoratualizado - d.valororiginal),0)) juro
                            , sum(nvl(d.valordesconto,0)) valordesconto
                            , sum(d.valoratualizado - d.valordesconto) valorfinal
                            , sum(nvl(d.valorpago,0)) r_valorpagoneg 
                            , sum(d.valoratualizado - d.valordesconto) - sum(nvl(d.valorpago,0))  saldoroman
                            , nvl( ( select sum(p.valorparcela)  
                                     from roman.pagamentosnegociacoesparceiros p
                                     where p.idnegociacaoparceiro = n.idnegociacaoparceiro
                                       and p.situacao = 'Q' 
                                       and (trunc(p.datapagamento) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR') 
                                            or  p.datapagamento is null and trunc(p.databaixa) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR'))),0) pagovigenteroman  
                           /* , ( select sum(pn.valorpago)
                                from roman.pagamentosnotasvendas pn
                                   , roman.documentosnegociacao d
                                   , roman.notasvendas nv
                                where pn.idnotavenda = d.idnotavenda
                                    and nv.idnotavenda = pn.idnotavenda
                                    and d.idnegociacaoparceiro = n.idnegociacaoparceiro
                                    and pn.origem = 'R'
                                    and pn.valorpago > 0
                                    and nv.enviadocobranca = 'S'
                                    and trunc(pn.datapagamento) > trunc(nv.dataenviadocobranca) 
                                    and not exists ( select 1 
                                             from roman.codigosliberacoescobranca c 
                                             where c.idnotavenda = nv.idnotavenda ) )  pagodis */ -- (Osiel) - Retirada a coluna do relatório por solicitação da Alexia durante homologação. 
                       from roman.negociacoesparceiros n
                          , roman.documentosnegociacao d
                          , ( select case
                                       when ddd.idpedido is not null then  'F'
                                       when ddd.idnotavenda is not null  then 'R'
                                       when ddd.idpepinorepres is not null then 'P'
                                       when ddd.idboleto is not null  then 'B'
                                     end carteira
                                   , ddd.idnegociacaoparceiro
                                   , ddd.idrepresentante
                                   , ddd.iddocumentonegociacao
                                from roman.documentosnegociacao ddd ) xx
                        where n.idnegociacaoparceiro = d.idnegociacaoparceiro
                          and d.iddocumentonegociacao = xx.iddocumentonegociacao
                          and n.tiponegociacao       is null
                          and nvl(n.idusuarioresponsavel,0) not in (172,549,5755)
                          and xx.carteira in ('R','P')
                          and (:P671_FILTRAR = 'S')
                          and ( :P671_TIPODATA is null or ( :P671_TIPODATA = 'N' and n.datanegociacao between to_date(:P671_DATAINI||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P671_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                           or ( :P671_TIPODATA = 'V' and exists ( select 1
                                                                  from pagamentosnegociacoesparceiros pp
                                                                  where pp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                    and pp.datavencimento   between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR') ) )
                           or ( :P671_TIPODATA = 'P' and exists ( select 1
                                                                    from pagamentosnegociacoesparceiros pp
                                                                    where pp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                      and (trunc(pp.datapagamento) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR') 
                                                                           or  pp.datapagamento is null and trunc(pp.databaixa) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR')) ) ) )
                           and ( :P671_FRANQUIA      is null or n.idfilial = :P671_FRANQUIA )
                           and ( :P671_DISTRIBUIDOR  is null or n.idrepresentante = :P671_DISTRIBUIDOR )
                           and ( :P671_CONSULTORA    is null or n.idvendedora = :P671_CONSULTORA )
                           and ( :P671_IDRESPONSAVEL is null or n.idusuarioresponsavel = :P671_IDRESPONSAVEL )
                           and ( :P671_IDPAIS        is null or n.idpais = :P671_IDPAIS)
                           and ( :P671_FORMA_PGTO = 'A' or n.formapagamento = :P671_FORMA_PGTO )
                           and ( :P671_SITUACAO   = 'T'
                            or ( :P671_SITUACAO   = 'Q' and nvl(( select sum(pnp.valorparcela)
                                                                  from pagamentosnegociacoesparceiros pnp
                                                                  where pnp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                    and pnp.situacao             = 'Q'
                                                                    and pnp.baixarealizada       = 'S' ),0) > 0 )
                            or ( :P671_SITUACAO   = 'E' and nvl(( select sum(pnp.valorparcela)
                                                                  from pagamentosnegociacoesparceiros pnp
                                                                  where pnp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                    and pnp.situacao             = 'E' ),0) > 0 )
                            or ( :P671_SITUACAO   = 'A' and n.valornegociacao > nvl(( select sum(pnp.valorparcela)
                                                                                      from pagamentosnegociacoesparceiros pnp
                                                                                      where pnp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                                        and pnp.situacao             = 'Q'
                                                                                        and pnp.baixarealizada       = 'S' ),0) ) 
                            or ( :P671_SITUACAO   = 'V' and nvl(( select sum(pnp.valorparcela)
                                                                  from pagamentosnegociacoesparceiros pnp
                                                                  where pnp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                    and pnp.situacao             = 'V' ),0) > 0 ))
                           and (:P671_CANAL = 'T' 
                              or (:P671_CANAL = 'A' and n.origem = :P671_CANAL )
                              or (:P671_CANAL = 'B' and n.origem = :P671_CANAL )
                              or (:P671_CANAL = 'C' and n.origem = :P671_CANAL ) )
                            /*  or (:P671_CANAL = 'R' and exists ( select sum(pn.valorpago)
                                                                 from roman.pagamentosnotasvendas pn
                                                                    , roman.documentosnegociacao d
                                                                    , roman.notasvendas nv
                                                                 where pn.idnotavenda = d.idnotavenda
                                                                   and nv.idnotavenda = pn.idnotavenda
                                                                   and d.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                   and pn.origem = 'R'
                                                                   and pn.valorpago > 0
                                                                   and nv.enviadocobranca = 'S'
                                                                   and (trunc(pn.datapagamento) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR') ) ) ) ) */
                        group by n.idnegociacaoparceiro, n.idfilial) r
                -- INICIO VALORES FAVORITA
                    , ( select distinct (n.idnegociacaoparceiro) idneg
                             , n.idfilial idfilial_f
                             , sum(nvl(d.valororiginal,0)) valororiginal
                             , sum(nvl(d.valoratualizado,0)) valoratualizado
                             , sum(nvl((d.valoratualizado - d.valororiginal),0)) juro
                             , sum(nvl(d.valordesconto,0)) valordesconto
                             , sum(d.valoratualizado - d.valordesconto) valorfinal
                             , sum(nvl(d.valorpago,0)) valorpagoneg --Ajustado
                             , nvl( ( select sum(p.valorparcela)  
                                      from roman.pagamentosnegociacoesparceiros p
                                      where p.idnegociacaoparceiro = n.idnegociacaoparceiro
                                        and p.situacao = 'Q' 
                                        and (trunc(p.datapagamento) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR')  or  p.datapagamento is null and trunc(p.databaixa) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR'))),0)  pagovigentefav 
                             , sum(d.valoratualizado - d.valordesconto) - sum(nvl(d.valorpago,0))  saldofav
                        from roman.negociacoesparceiros n
                           , roman.documentosnegociacao d
                           , ( select case
                                        when ddd.idpedido is not null then  'F'
                                        when ddd.idnotavenda is not null  then 'R'
                                        when ddd.idpepinorepres is not null then 'P'
                                        when ddd.idboleto is not null  then 'B'
                                      end carteira
                                    , ddd.idnegociacaoparceiro
                                    , ddd.idrepresentante
                                    , ddd.iddocumentonegociacao
                               from roman.documentosnegociacao ddd) xx
                        where n.idnegociacaoparceiro = d.idnegociacaoparceiro
                          and n.tiponegociacao is null
                          and nvl(n.idusuarioresponsavel,0) not in (172,549,5755)
                          and d.iddocumentonegociacao = xx.iddocumentonegociacao
                          and xx.carteira in ('F','B')
                          and (:P671_FILTRAR = 'S')
                          and ( :P671_TIPODATA is null or ( :P671_TIPODATA = 'N' and n.datanegociacao between to_date(:P671_DATAINI||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P671_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                           or ( :P671_TIPODATA = 'V' and exists ( select 1
                                                                  from pagamentosnegociacoesparceiros pp
                                                                  where pp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                    and pp.datavencimento between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR') ) )
                           or ( :P671_TIPODATA = 'P' and exists ( select 1
                                                                  from pagamentosnegociacoesparceiros pp
                                                                  where pp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                    and (trunc(pp.datapagamento) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR')
                                                                           or  pp.datapagamento is null and trunc(pp.databaixa) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR') )) ) )
                           and ( :P671_FRANQUIA      is null or n.idfilial = :P671_FRANQUIA )
                           and ( :P671_DISTRIBUIDOR  is null or n.idrepresentante = :P671_DISTRIBUIDOR )
                           and ( :P671_CONSULTORA    is null or n.idvendedora = :P671_CONSULTORA )
                           and ( :P671_IDRESPONSAVEL is null or n.idusuarioresponsavel = :P671_IDRESPONSAVEL )
                           and ( :P671_IDPAIS        is null or n.idpais = :P671_IDPAIS)
                           and ( :P671_FORMA_PGTO = 'A' or n.formapagamento = :P671_FORMA_PGTO )
                           and ( :P671_SITUACAO = 'T'
                            or ( :P671_SITUACAO = 'Q' and nvl(( select sum(pnp.valorparcela)
                                                                from pagamentosnegociacoesparceiros pnp
                                                                where pnp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                  and pnp.situacao             = 'Q'
                                                                  and pnp.baixarealizada       = 'S' ),0) > 0 )
                            or ( :P671_SITUACAO = 'E' and nvl(( select sum(pnp.valorparcela)
                                                                from pagamentosnegociacoesparceiros pnp
                                                                where pnp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                  and pnp.situacao             = 'E' ),0) > 0 )
                            or ( :P671_SITUACAO = 'A' and n.valornegociacao > nvl(( select sum(pnp.valorparcela)
                                                                                    from pagamentosnegociacoesparceiros pnp
                                                                                    where pnp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                                      and pnp.situacao             = 'Q'
                                                                                      and pnp.baixarealizada       = 'S' ),0) ) 
                            or ( :P671_SITUACAO = 'V' and nvl(( select sum(pnp.valorparcela)
                                                                 from pagamentosnegociacoesparceiros pnp
                                                                 where pnp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                   and pnp.situacao             = 'V' ),0) > 0 ))
                           and (:P671_CANAL   = 'T'  
                              or (:P671_CANAL = 'A' and n.origem = :P671_CANAL )
                              or (:P671_CANAL = 'B' and n.origem = :P671_CANAL )
                              or (:P671_CANAL = 'C' and n.origem = :P671_CANAL ) ) 
                            /*  or (:P671_CANAL = 'R' and exists ( select sum(pn.valorpago)
                                                                 from roman.pagamentosnotasvendas pn
                                                                    , roman.documentosnegociacao d
                                                                    , roman.notasvendas nv
                                                                 where pn.idnotavenda = d.idnotavenda
                                                                   and nv.idnotavenda = pn.idnotavenda
                                                                   and d.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                   and pn.origem = 'R'
                                                                   and pn.valorpago > 0
                                                                   and nv.enviadocobranca = 'S'
                                                                   and (trunc(pn.datapagamento) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR') ) ) ) ) */
                      group by n.idnegociacaoparceiro, idfilial ) f  
                -- FIM VALORES FAVORITA
                where nm.idnegociacaoparceiro = r.idneg(+)
                  and nm.idnegociacaoparceiro = f.idneg(+)
                  and nm.tiponegociacao       is null
                  and nvl(nm.idusuarioresponsavel,0) not in (172,549,5755)
                  and (:P671_FILTRAR = 'S')
                      and ( :P671_TIPODATA is null or ( :P671_TIPODATA = 'N' and nm.datanegociacao between to_date(:P671_DATAINI||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P671_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                       or ( :P671_TIPODATA = 'V' and exists ( select 1
                                                              from pagamentosnegociacoesparceiros pp
                                                              where pp.idnegociacaoparceiro = nm.idnegociacaoparceiro
                                                                and pp.datavencimento between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR') ) )
                       or ( :P671_TIPODATA = 'P' and exists ( select 1
                                                              from pagamentosnegociacoesparceiros pp
                                                              where pp.idnegociacaoparceiro = nm.idnegociacaoparceiro
                                                                and (trunc(pp.datapagamento) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR')
                                                                       or  pp.datapagamento is null and trunc(pp.databaixa) between to_date(:P671_DATAINI,'DD/MM/RRRR') and to_date(:P671_DATAFIM,'DD/MM/RRRR')) )) )
                       and ( :P671_FRANQUIA      is null or nm.idfilial = :P671_FRANQUIA )
                       and ( :P671_DISTRIBUIDOR  is null or nm.idrepresentante = :P671_DISTRIBUIDOR )
                       and ( :P671_CONSULTORA    is null or nm.idvendedora = :P671_CONSULTORA )
                       and ( :P671_IDRESPONSAVEL is null or nm.idusuarioresponsavel = :P671_IDRESPONSAVEL )
                       and ( :P671_IDPAIS        is null or nm.idpais = :P671_IDPAIS)
                       and ( :P671_FORMA_PGTO = 'A' or nm.formapagamento = :P671_FORMA_PGTO )
                       and ( :P671_SITUACAO   = 'T'
                        or ( :P671_SITUACAO   = 'Q' and nvl(( select sum(pnp.valorparcela)
                                                              from pagamentosnegociacoesparceiros pnp
                                                              where pnp.idnegociacaoparceiro = nm.idnegociacaoparceiro
                                                                and pnp.situacao             = 'Q'
                                                                and pnp.baixarealizada       = 'S' ),0) > 0 )
                         or ( :P671_SITUACAO  = 'E' and nvl(( select sum(pnp.valorparcela)
                                                              from pagamentosnegociacoesparceiros pnp
                                                              where pnp.idnegociacaoparceiro = nm.idnegociacaoparceiro
                                                                and pnp.situacao             = 'E' ),0) > 0 )
                         or ( :P671_SITUACAO  = 'A' and nm.valornegociacao > nvl(( select sum(pnp.valorparcela)
                                                                                   from pagamentosnegociacoesparceiros pnp
                                                                                   where pnp.idnegociacaoparceiro = nm.idnegociacaoparceiro
                                                                                     and pnp.situacao             = 'Q'
                                                                                     and pnp.baixarealizada       = 'S' ),0) ) 
                         or ( :P671_SITUACAO  = 'V' and nvl(( select sum(pnp.valorparcela)
                                                              from pagamentosnegociacoesparceiros pnp
                                                              where pnp.idnegociacaoparceiro = nm.idnegociacaoparceiro
                                                                and pnp.situacao             = 'V' ),0) > 0 ))
                        and (:P671_CANAL    = 'T'  or (:P671_CANAL = 'A' and nm.origem = :P671_CANAL ) 
                            or (:P671_CANAL = 'B' and nm.origem = :P671_CANAL ) 
                            or (:P671_CANAL = 'C' and nm.origem = :P671_CANAL ) ) )
                           /* or (:P671_CANAL = 'R' and exists ( select 1
                                                               from roman.pagamentosnotasvendas pn
                                                                  , roman.documentosnegociacao d
                                                                  , roman.notasvendas nv
                                                               where pn.idnotavenda = d.idnotavenda
                                                                 and nv.idnotavenda = pn.idnotavenda
                                                                 and d.idnegociacaoparceiro = nm.idnegociacaoparceiro
                                                                 and pn.origem = 'R'
                                                                 and pn.valorpago > 0
                                                                 and nv.enviadocobranca = 'S'
                                                                 and trunc(pn.datapagamento) > trunc(nv.dataenviadocobranca) 
                                                                 and not exists ( select 1 
                                                                                  from roman.codigosliberacoescobranca c 
                                                                                  where c.idnotavenda = nv.idnotavenda ) ) ) ) ) */ --(Osiel) -- Removido por solicitação da Alexia durante homologação.
                where ( :P671_SPC  = 'A' or ( :P671_SPC = 'S' and enviada = 'Sim' ) or ( :P671_SPC = 'N' and enviada = 'Não' ) ) 
                  and (:P671_ORIGEM_NEGOCIACAO = 'A' or (:P671_ORIGEM_NEGOCIACAO = 'C' and origem_negociacao = 'Consultora') or (:P671_ORIGEM_NEGOCIACAO = 'D' and origem_negociacao = 'Distribuidor'))
                ```
        }
