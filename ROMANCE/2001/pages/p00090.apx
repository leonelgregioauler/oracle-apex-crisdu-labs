    pageItem P90_IDFUNCIONARIO (
        type: selectList
        label {
            label: Funcionário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) display_value
                     , f.idfuncionario return_value
                from funcionarios f
                   , pessoas p
                where f.idpessoa = p.idpessoa
                  and f.ativo    = 'S'
                  and idgerente  = ( select idgerente
                                     from gerentes g
                                     where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o Funcionário -
        }
        layout {
            sequence: 60
            region: @nova-venda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDFUNCIONARIO
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P90_IDVENDADIRETA
