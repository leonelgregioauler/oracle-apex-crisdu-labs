            formatMask: 999G999G999G999G990D00
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select v.valortotal - nvl(( select sum(pv.valorpago)
                                            from pagamentosvendasdiretas pv
                                            where pv.idvendadireta = v.idvendadireta ),0) saldo
                from vendasdiretas v
                where v.idvendadireta = :P90_IDVENDADIRETA
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

