    process libera-correção (
        name: Libera Correção
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  IF :P90_NUMEROEVENTO IS NULL THEN
                    APEX_ERROR.ADD_ERROR( p_message => 'Obrigatório informar numero do evento para liberar correção!',
                                          p_display_location => apex_error.c_inline_in_notification);
                  ELSE
                    --
                    update vendasdiretas v
                    set v.idsituacao = 2
                    where v.idvendadireta = :P90_IDVENDADIRETA;
                    --
                    insert into correcoesvendasdiretas( idvendadireta
                                                      , usuario
                                                      , motivo )
                    values ( :P90_IDVENDADIRETA
                           , v('APP_USER')
                           , 'Venda direta liberada para realizar correção - Evento '||:P90_NUMEROEVENTO);
                      --
                  END IF;
                end;
                
                
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 374702742675261649
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR_LIBERACAO
        }
    )

