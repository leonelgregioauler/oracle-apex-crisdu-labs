    validation valida-débito-funcionário (
        name: Valida Débito Funcionário
        execution {
            sequence: 30
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare 
                    -- Variáveis de controle da rotina de validação de débitos Funcionário.
                    v_dias_em_atraso number;
                    v_valor_debito   number := 0;
                    v_idvendedora    number;
                
                begin
                    -- Verifica se o funcionário possui cadastro na tabela de vendedoras
                    begin
                        select v.idvendedora
                          into v_idvendedora
                          from catal.funcionarios f
                             , catal.vendedoras v
                         where v.idpessoa = f.idpessoa
                           and f.idfuncionario = :P90_IDFUNCIONARIO;
                    exception 
                        when others then
                            -- não possui cadastro na tabela de vendedoras
                            v_idvendedora := null;
                    end;
                
                    -- Verifica Débitos (Venda Direta)
                    select nvl(sum(vd.saldo),0)
                      into v_valor_debito
                      from roman.vendasdiretas vd
                     where vd.saldo > 0
                       and trunc(sysdate) - trunc(vd.data) > 30
                       and vd.idfuncionario = :P90_IDFUNCIONARIO;
                    
                    -- Verifica se o débito tam mais de 30 dias
                    if v_valor_debito > 0 then
                        -- Mensagem complementar 
                        apex_error.add_error(
                            p_message => 'Funcionário(a) possui venda direta em aberto a mais de 30 dias no valor de R$ '||v_valor_debito,
                            p_display_location => apex_error.c_inline_in_notification);
                        return false;
                    end if;
                
                
                    -- Verifica Débitos (Pedido Favorita)
                    if v_idvendedora is not null then
                        -- Verifica se possui Pedidos vencidos a mais de 30 dias
                        select nvl(sum(vp.valorpago - vp.valorpagar),0)
                          into v_valor_debito
                        from favorita.pedidos p
                           , favorita.vencimentospedidos vp
                        where p.idpedido = vp.idpedido
                          and (vp.valorpago - vp.valorpagar) > 0
                          and (trunc(sysdate) - vp.datavencimento) > 30
                          and p.idvendedora = v_idvendedora
                          and p.idpedido not in (6986266,6901411,6984042);
                
                        -- Se o débito for maior que zero deve barrar a venda direta
                        if v_valor_debito > 0 then
                            -- Mensagem complementar 
                            apex_error.add_error(
                                p_message => 'Funcionário(a) Possui Pedido em aberto a mais de 30 dias, valor do débito R$ '||v_valor_debito,
                                p_display_location => apex_error.c_inline_in_notification);
                            return false;
                        end if;
                    end if;
                
                
                    -- Verifica Débitos (Nota Venda Romance)
                    if v_idvendedora is not null then
                    null;
                    end if;
                
                
                    -- não possui debito
                    return True;
                
                -- Tratamento de excessões da rotina
                exception
                    when others then
                        -- Erro para auxiliar Suporte/Desenvolvimento
                        apex_error.add_error(
                            p_message => 'Ops! Ocorreu um erro no processo Valida Débito Funcionário. Erro: ' || SQLERRM || ' - Código: ' || SQLCODE,
                            p_display_location => apex_error.c_inline_in_notification);
                
                        -- Em caso de erro, bloqueia a venda direta
                        return false;
                
                end;
                ```
        }
        error {
            errorMessage: Venda direta não autorizada!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

