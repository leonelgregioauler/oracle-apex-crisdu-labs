    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='Confirma exclusão da venda direta?';
            
            function fnc_imprime() 
            {
              vurl = document.getElementById("P90_SESSION_IMPRIME").value;
              pjan = window.open(vurl,'popup','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=1200,height=600,screenX=50,screenY =100');
              pjan.focus();
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

