    region itens-incluidos (
        name: Itens Incluidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select it.iditemvendadireta
                     , it.idvendadireta
                     , p.codigosisdist
                     , initcap(p.nomeproduto) nomeproduto
                     , decode(it.comissao,'N','Não','S','Sim') comissao
                     , it.valorvenda
                     , nvl(it.qtd_pp,0) qtd_pp
                     , nvl(it.qtd_p,0) qtd_p
                     , nvl(it.qtd_m,0) qtd_m
                     , nvl(it.qtd_g,0) qtd_g
                     , nvl(it.qtd_gg,0) qtd_gg
                     , nvl(it.qtd_egg,0) qtd_egg
                     , nvl(it.qtd_exgg,0) qtd_exgg
                     , nvl(it.qtd_u,0) qtd_u
                     , ( nvl(it.qtd_pp,0)
                       + nvl(it.qtd_p,0)
                       + nvl(it.qtd_m,0)
                       + nvl(it.qtd_g,0)
                       + nvl(it.qtd_gg,0)
                       + nvl(it.qtd_egg,0)
                       + nvl(it.qtd_exgg,0)
                       + nvl(it.qtd_u,0) ) qtdtotal
                     , (( nvl(it.qtd_pp,0)
                        + nvl(it.qtd_p,0)
                        + nvl(it.qtd_m,0)
                        + nvl(it.qtd_g,0)
                        + nvl(it.qtd_gg,0)
                        + nvl(it.qtd_egg,0)
                        + nvl(it.qtd_exgg,0)
                        + nvl(it.qtd_u,0) ) * it.valoracobrar ) valoracobrar
                from itensvendadireta it
                   , produtos p
                where it.idproduto = p.idproduto
                  and it.idvendadireta = :P90_IDVENDADIRETA
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent7
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from itensvendadireta it
                where it.idvendadireta = :P90_IDVENDADIRETA;
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum produto encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 2983428972579656189
        }

