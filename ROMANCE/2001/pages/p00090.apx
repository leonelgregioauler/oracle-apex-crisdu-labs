    process concluir-venda-direta (
        name: Concluir Venda Direta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                  --
                  update vendasdiretas v
                  set v.idsituacao = 3
                  where v.idvendadireta = :P90_IDVENDADIRETA;
                  --
                  for i in ( select it.idestoquefil
                                  , v.IDFILIAL
                                  , it.qtd_pp
                                  , it.qtd_p
                                  , it.qtd_m
                                  , it.qtd_g
                                  , it.qtd_gg
                                  , it.qtd_egg
                                  , it.qtd_exgg
                                  , it.qtd_u
                                  , it.iditemvendadireta
                                  , ( select initcap(nomepessoa)
                                      from pessoas p 
                                         , funcionarios f
                                      where p.idpessoa = f.idpessoa 
                                        and f.idfuncionario = v.idfuncionario ) funcionario
                                  , v.semana 
                             from itensvendadireta it
                                , vendasdiretas v
                             where it.idvendadireta = v.IDVENDADIRETA
                               and v.IDVENDADIRETA  = :P90_IDVENDADIRETA
                               and not exists ( select 1
                                                from movimentosestoquefilial me
                                                where me.iditemvendadireta = it.iditemvendadireta ) )
                  loop
                    --
                    insert into movimentosestoquefilial ( idmovtoestoquefilial
                                                        , idestoquefil
                                                        , idfilial
                                                        , observacao
                                                        , usuario
                                                        , datamovimento
                                                        , qtd_pp
                                                        , qtd_p
                                                        , qtd_m
                                                        , qtd_g
                                                        , qtd_gg
                                                        , qtd_egg
                                                        , qtd_exgg
                                                        , qtd_u
                                                        , iditemvendadireta )
                    values ( seq_idmovtoestoquefilial.nextval
                           , i.idestoquefil
                           , i.idfilial
                           , 'Inclusão de mercadoria em Venda Direta do(a) '||i.funcionario||' na semana '||i.semana
                           , v('APP_USER')
                           , sysdate
                           , i.qtd_pp*-1
                           , i.qtd_p*-1
                           , i.qtd_m*-1
                           , i.qtd_g*-1
                           , i.qtd_gg*-1
                           , i.qtd_egg*-1
                           , i.qtd_exgg*-1
                           , i.qtd_u*-1
                           , i.iditemvendadireta );
                           
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Venda Direta concluída com sucesso!
        }
        advanced {
            executionMappingIdentifier: 794661333427135567
        }
        serverSideCondition {
            type: request=Value
            value: CONCLUIR
        }
    )

