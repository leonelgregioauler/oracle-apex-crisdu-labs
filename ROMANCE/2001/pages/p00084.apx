page 84 (
    name: Saídas
    title: Saídas Diversas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region saídas (
        name: Saídas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null Editar
                     , e.idsaida
                     , e.idfilial
                     , substr(f.semana,4,4) ano
                     , substr(f.semana,1,2) semana
                     , pck_romance.fnc_nomefilial(e.idfilial) "Empresa"
                     , pck_romance.fnc_nomefilial(e.idfilialdest) "Empresa Destino"
                     , f.semana fechamento
                     , e.data
                     , e.fechamentoorig
                     , e.valortotal
                     , e.descricao
                     , decode(e.tipo,'D','Dinheiro','Pagamento de Conta') "Tipo"
                     , pck_romance.fnc_nomecontafinan(e.idcontacontabil) "Conta Contabil" 
                     , pck_romance.fnc_nomesubcontafinan(e.idsubcontacontabil) "Sub Conta Contabil"
                     , ( select count(1)
                         from anexossaidas a
                         where a.idsaida = e.idsaida ) qtdanexos
                     , case
                         when exists ( select 1
                                       from subcontasfinanceiras ss
                                       where ss.idsubcontafinan = ( select sd.idsubcontacontabil
                                                                    from saidasdiversas sd
                                                                    where sd.idsaida = e.idsaida ) 
                                         and ss.tipo is not null ) and e.idsubcontacontabil is not null then
                           ( select decode(sf.tipo,'F','Fixa','V','Variável')
                             from subcontasfinanceiras sf
                             where sf.idsubcontafinan = ( select sd.idsubcontacontabil
                                                          from saidasdiversas sd
                                                          where sd.idsaida = e.idsaida ) )
                         else
                           ( select decode(c.tipo,'F','Fixa','V','Variável')
                             from contasfinanceiras c
                             where c.idcontafinan = ( select se.idcontacontabil
                                                      from saidasdiversas se
                                                      where se.idsaida = e.idsaida )
                               and c.tipo is not null )
                       end tiposaida
                     , observacaocontrole  
                     , e.fatorconversao
                     , case 
                         when e.ididiomaorigem in (2,3,4,6,12,13) and e.ididiomadestino = 1 then -- 12 e 13 add no T11826220
                           e.valortotal * nvl(f.fatorconversao,1)
                         when e.ididiomadestino = 1 and e.ididiomaorigem in (2,3,4,6,12,13) then
                           e.valortotal / nvl(e.fatorconversao,f.fatorconversao)
                         when e.ididiomaorigem in (2,3,4,6,12,13) and e.ididiomaorigem != e.ididiomadestino then
                           round( ( e.valortotal * f.fatorconversao ) / e.fatorconversao,2)
                         else
                           e.valortotal
                       end valorconversao
                     , ( select md.classificacaodespesa
                         from matrizclassificacoesdespesas md
                         where md.idmatrizclassificacao = e.idmatrizclassificacao ) classificacao
                     , (select cnpj
                          from razoessociaisfiliais
                         where idrazaosocialfilial = e.idrazaosocialfilial) "CNPJ Despesa"
                     , lu.usuariocriacao "Usuário Criação"
                from saidasdiversas e
                   , fechamentossemanais f
                   , ( select l.idsaida
                            , min(l.usuarioalteracao) keep (dense_rank first order by l.idlog) usuariocriacao
                       from logroman.log_saidasdiversas l
                       where l.tipoalteracao = 'INSERT'
                         and l.idsaida in ( select s.idsaida
                                            from saidasdiversas s
                                            where s.idfilial = :P0_IDFILIAL )
                       group by l.idsaida ) lu
                where e.idfilial     = :P0_IDFILIAL
                  and f.idfechamento = e.idfechamento
                  and lu.idsaida(+)  = e.idsaida
                  and (:P0_IDFECHAMENTO = 999999999999 or e.idfechamento = :P0_IDFECHAMENTO)
                ORDER BY 1 DESC
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma saída incluída.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

