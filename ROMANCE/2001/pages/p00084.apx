    button confirmasaida (
        buttonName: CONFIRMASAIDA
        label: Confirmar Saídas
        layout {
            sequence: 20
            region: @saídas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 87
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novasaida (
        buttonName: NOVASAIDA
        label: Nova Saída
        layout {
            sequence: 40
            region: @saídas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 86
                items: {
                    P86_IDFECHAMENTO: &P0_IDFECHAMENTO.
                    P86_IDFILIAL: &P0_IDFILIAL.
                    P86_IDSAIDA:
                }
                clearCache: 86
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais
                where idfechamento = :P0_IDFECHAMENTO
                  and concluido = 'N'
                ```
        }
    )

    button novo-questionamento (
        buttonName: NOVO_QUESTIONAMENTO
        label: Novo Questionamento
        layout {
            sequence: 10
            region: @saídas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 389
                items: {
                    P389_IDQUESTIONAMENTO:
                    P389_IDFILIAL: &P0_IDFILIAL.
                    P389_IDFECHAMENTO: &P0_IDFECHAMENTO.
                    P389_PAGINA: 84
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento in ( 2 , 0 )
                  and ug.usuario = v('APP_USER')
                  and :P0_IDFECHAMENTO is not null
                ```
        }
    )

    button revisarsaidas (
        buttonName: REVISARSAIDAS
        label: Revisar Saídas
        layout {
            sequence: 30
            region: @saídas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 250
                items: {
                    P250_ORIGEM: S
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2309,v('APP_USER')) = 'S'
                ```
        }
    )

)

