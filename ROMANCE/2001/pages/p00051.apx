            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 
                    from dual
                    where exists ( select 1
                                   from usuarios u
                                   where u.idgerente = 143
                                     and u.usuario   = v('APP_USER') )
                    ```
            }
        )

