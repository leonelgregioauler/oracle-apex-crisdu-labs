    pageItem P51_PAGINACORRENTE (
        type: textField
        label {
            label: Página
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtrar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_USUARIOS (
        type: selectOne
        label {
            label: Usuários
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(username)||' - '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialusuario(username)) display_value
                ,username return_value
                from dba_users d
                where trunc(d.created) >= to_date('07/12/2010','dd/mm/rrrr')
                  AND USERNAME NOt IN ('APEX_PUBLIC_USER','APEX_040000','CATAL')
                  and account_status != 'LOCKED'
                  and exists (select 1 from usuariossistemas u where usuario = d.username and u.idsistema = 2001)
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtrar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_USUARIO_COPIAR (
        type: selectList
        label {
            label: Usuário que será Copiado os acessos
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(username)||' - '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialusuario(username)) display_value
                ,username return_value
                from dba_users d
                where trunc(d.created) >= to_date('07/12/2010','dd/mm/rrrr')
                  AND USERNAME NOt IN ('APEX_PUBLIC_USER','APEX_040000','CATAL')
                  and account_status != 'LOCKED'
                  and exists (select 1 from usuariossistemas u where usuario = d.username and u.idsistema = 2001)
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @duplicar-acessos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button confirmar (
        buttonName: CONFIRMAR
        label: Confirmar
        layout {
            sequence: 40
            region: @duplicar-acessos
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar Acessos
        layout {
            sequence: 20
            region: @filtrar
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--stretch
                t-Button--gapBottom
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Liberar Acesso
        layout {
            sequence: 10
            region: @filtrar
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction recarrega (
        name: Recarrega
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P51_USUARIOS
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: REDIRECIONA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction recarrega-pagina-corrente (
        name: Recarrega Pagina Corrente
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P51_PAGINACORRENTE
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-mesmo-usuário (
        name: Valida mesmo Usuário
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P51_USUARIOS = :P51_USUARIO_COPIAR
                ```
        }
        error {
            errorMessage: Usuários iguais, verifique e tente novamente!
            associatedItem: @P51_USUARIO_COPIAR
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR
        }
    )

    process copia-acessos (
        name: Copia acessos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  insert into acessos ( idacesso,
                                        usuario,
                                        idaplicacao,
                                        ativo )
                  select seq_idacessos.nextval
                       , :P51_USUARIOS
                       , a.idaplicacao
                       , 'S'
                  from acessos a
                  where a.usuario = :P51_USUARIO_COPIAR
                    and not exists ( select 1
                                     from acessos aa
                                     where aa.usuario = :P51_USUARIOS
                                       and aa.idaplicacao = a.idaplicacao )
                    and exists ( select 1
                                 from aplicacoes ap
                                 where ap.idaplicacao = a.idaplicacao
                                   and ap.idsistema   = 2001 );
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: Acessos duplicados.
        }
        advanced {
            executionMappingIdentifier: 2816111835502251037
        }
        serverSideCondition {
            whenButtonPressed: @confirmar
        }
    )

    process deleta-acesso (
        name: deleta acesso
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                vpedido number;
                begin
                 FOR i IN 1.. HTMLDB_APPLICATION.G_F01.COUNT 
                 loop
                   --
                   delete acessos
                   where idaplicacao = HTMLDB_APPLICATION.G_F02(HTMLDB_APPLICATION.G_F01(i))
                     and usuario = :P51_USUARIOS;
                   --
                  END LOOP;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1412137095092681521
        }
        serverSideCondition {
            whenButtonPressed: @deletar
        }
    )

    process liberaracesso (
        name: liberaracesso
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                vpedido number;
                begin
                 FOR i IN 1.. HTMLDB_APPLICATION.G_F01.COUNT 
                 loop
                
                    insert into acessos (idacesso, usuario, idaplicacao, ativo)
                    values (seq_idacessos.nextval, :P51_USUARIOS, HTMLDB_APPLICATION.G_F02(HTMLDB_APPLICATION.G_F01(i)), 'S');
                
                  END LOOP;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 149573767743697504
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 51
            }
            saveStateBeforeBranching: true
        }
    )

    branch (
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 51
                items: {
                    P51_USUARIOS: &P51_USUARIOS.
                    P51_USUARIO_COPIAR: &P51_USUARIO_COPIAR.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @confirmar
        }
    )

)

