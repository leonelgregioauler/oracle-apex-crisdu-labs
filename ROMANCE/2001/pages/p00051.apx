page 51 (
    name: Controle de Acessos
    title: Controle de Acessos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region duplicar-acessos (
        name: Duplicar Acessos
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                margin-top-lg
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where :P51_USUARIOS is not null
                  and exists ( select 1
                               from usuarios u
                               where u.idgerente = 143
                                 and u.usuario   = v('APP_USER') )
                ```
        }
    )

    region filtrar (
        name: Filtrar
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    region liberar-acessos (
        name: Liberar Acessos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idaplicacao
                      ,descricao
                      ,hierarquia
                      ,decode( hierarquia , null , '<b>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao) ||'</b>'
                                                 , DECODE(LEVEL , 2 , '<i>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>'
                                                                , 3 , '<i>'||LPAD('-> ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>') ) nivel_hierarquico
                      , nvl( ( select 'Já possui acesso!'
                               from acessos b 
                                where b.idaplicacao = a.idaplicacao 
                                  and b.usuario = :P51_USUARIOS),'<font color="red">Não possui acesso!</font>') possuiacesso
                      , (select descricao from tiposcontrolesaplicacoes tc where tc.idtiposcontroles = a.idtiposcontroles) tiposcontroles
                      , paginascorrentes
                      , observacao
                      , pagina
                      , idaplicacao id
                      , 'OBS_APLICACAO' "Criar/Editar Obs."
                  from ( select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                              , a.idtiposcontroles
                              , a.paginascorrentes
                              , a.observacao
                              , a.pagina
                         from aplicacoes a 
                         where a.idsistema = 2001
                           and :P51_PAGINACORRENTE is null
                         union
                         select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                              , a.idtiposcontroles
                              , a.paginascorrentes
                              , a.observacao
                              , a.pagina
                         from aplicacoes a 
                         where a.idsistema = 2001
                           and a.hierarquia is null
                           and :P51_PAGINACORRENTE is null
                         ORDER BY IDAPLICACAO) a
                 start with hierarquia is null
                connect by prior idaplicacao = hierarquia
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P51_USUARIOS is not null and :P51_PAGINACORRENTE is null
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: " - "
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Usu¿o com acesso total.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 12
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column "Criar/Editar Obs." (
            reportColumnQueryId: 11
            derivedColumn: N
            type: link
