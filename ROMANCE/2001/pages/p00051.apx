    region liberar-acessos-páginas (
        name: Liberar Acessos (Páginas)
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idaplicacao
                      ,descricao
                      ,hierarquia
                      ,descricao nivel_hierarquico
                      , nvl( ( select 'Já possui acesso!'
                               from acessos b 
                                where b.idaplicacao = a.idaplicacao 
                                  and b.usuario = :P51_USUARIOS),'<font color="red">Não possui acesso!</font>') possuiacesso
                      , (select descricao from tiposcontrolesaplicacoes tc where tc.idtiposcontroles = a.idtiposcontroles) tiposcontroles
                      , paginascorrentes
                      , observacao
                      , a.pagina
                      , idaplicacao id
                  from ( select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                              , a.idtiposcontroles
                              , a.paginascorrentes
                              , a.observacao
                              , a.pagina
                         from aplicacoes a 
                         where a.idsistema = 2001
                           and (:P51_PAGINACORRENTE = a.paginascorrentes or :P51_PAGINACORRENTE = a.pagina)
                         order by idaplicacao) a
                
                ```
        }
        layout {
            sequence: 40
            slot: body-3
        }
