    validation informar-representante-ou-semana (
        name: Informar Representante ou Semana
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM DUAL
                 WHERE :P787_IDREPRESENTANTE IS NULL 
                   AND :P787_SEMANA IS NULL
                ```
        }
        error {
            errorMessage: Informe pelo menos um dos campos: REPRESENTANTE ou SEMANA
        }
    )

