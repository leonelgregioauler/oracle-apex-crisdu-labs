    region relatorio-guia-de-despacho-acertos (
        name: Relatorio Guia de Despacho - Acertos
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v_sql clob;
                begin
                  v_sql := 
                        'WITH c AS (
                           SELECT a.idrepresentante
                                , a.semanacobranca
                                , trunc(a.fchemis) fchemis
                                , listagg(a.folio,'';'') within group (order by a.folio)  folio
                             FROM acertosnotas_dtemite a
                            where trunc(a.fchemis) between :P787_DATAINICIO and :P787_DATAFIM
                             GROUP BY a.idrepresentante
                                    , a.semanacobranca
                                    , trunc(a.fchemis) )
                          SELECT c.fchemis 
                               , c.folio
                               , v.rutrecep
                               , roman.pck_romance.fnc_nomerepresentante (v.idrepresentante) nomecliente
                               , v.correorecep
                               , v.semanacobranca semana
                               , v.MONTOTOTAL valortotal
                               , v.valor_iva
                               , (select telefone
                                    from telefonespessoas
                                   where idtelefonepessoa = (select max(idtelefonepessoa)
                                                               from telefonespessoas 
                                                              where idpessoa = (select idpessoa
                                                                                  from catal.representantes
                                                                                 where idrepresentante = v.idrepresentante))) telefone
                            FROM vw_notasvendas_dtemite v
                                 JOIN c ON v.idrepresentante = c.idrepresentante
                                       AND v.semanacobranca  = c.semanacobranca
                           WHERE v.idrepresentante in (SELECT a.idrepresentante
                                                         FROM acertosnotas_dtemite a
                                                        WHERE trunc(a.fchemis) between :P787_DATAINICIO and :P787_DATAFIM)
                             AND v.semanacobranca in (SELECT a.semanacobranca
                                                         FROM acertosnotas_dtemite a
                                                        where trunc(a.fchemis) between :P787_DATAINICIO and :P787_DATAFIM)
                             AND :P787_FILTRAR = ''S'' ';
                  --
                  if :P787_IDREPRESENTANTE is not null then
                    v_sql := v_sql || ' AND v.idrepresentante = :P787_IDREPRESENTANTE ';
                  end if;
                  --
                  if :P787_SEMANA is not null then 
                    v_sql := v_sql || ' AND v.semanacobranca  = :P787_SEMANA';
                  end if;
                  --
                  return v_sql;
                  --
                end; 
                
                ```
            pageItemsToSubmit: P787_FILTRAR
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
