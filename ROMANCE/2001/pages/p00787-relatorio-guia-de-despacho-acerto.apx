    pageItem P787_IDFILIAL (
        type: selectList
        label {
            label: Tienda
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.ididioma = (select ididioma 
                                      from vw_filiais
                                     where idfilial = :P0_IDFILIAL)
                  
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @fecha-emission
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        default {
            type: item
            item: P0_IDFILIAL
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select idusuario
                  from usuarios u
                 where u.ativo = 'S'
                   and u.ididioma = 6
                   and u.idusuario = :P0_IDUSUARIO
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P787_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Representante
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) d
                     , r.idrepresentante r
                  from representantes r
                 where r.idfilial = :P787_IDFILIAL
                   and r.ativo = 'S'
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P787_IDFILIAL
        }
        layout {
            sequence: 20
            region: @fecha-emission
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
