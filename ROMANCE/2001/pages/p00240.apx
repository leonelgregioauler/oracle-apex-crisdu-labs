        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region balanço (
        name: Balanço
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cod
                     , nome
                     , carga
                     , valorcarga
                     , '-' s1
                     , devolucao
                     , valordevolucao
                     , '-' s2
                     , vendeu
                     , valorvendeu
                     , '-' s3
                     , emaberto
                     , valoremaberto
                     , '=' s4
                     , ( carga-devolucao-vendeu-emaberto) faltadevolver
                     , ( valorcarga-valordevolucao-valorvendeu-valoremaberto) valorfaltadevolver
                     , ativo
                from (
                        select r.idrepresentante cod
                             , pck_romance.fnc_nomerepresentante(r.idrepresentante) nome
                             , nvl( ( select sum((nvl(qtd_dist_pp ,0) 
                                                + nvl(qtd_dist_p ,0)  
                                                + nvl(qtd_dist_m ,0)  
                                                + nvl(qtd_dist_g ,0)
                                                + nvl(qtd_dist_gg,0)  
                                                + nvl(qtd_dist_egg,0) 
                                                 + nvl(qtd_dist_exgg,0) 
                                                + nvl(qtd_dist_u,0))) 
                                       from itenscargarepresentante i 
                                       where i.idcargarepresentante in ( select c.idcargarepresentante
                                                                         from cargasrepresentantes c
                                                                         where c.idrepresentante = r.idrepresentante
                                                                           and c.situacao        != 0
                                                                           and pck_util.fnc_idsemana(c.semana) >= r.idsemanabalanco )),0) carga
                             , nvl( ( select sum( (nvl(qtd_dist_pp ,0) 
                                                 + nvl(qtd_dist_p ,0)  
                                                 + nvl(qtd_dist_m ,0)  
                                                 + nvl(qtd_dist_g ,0)
                                                 + nvl(qtd_dist_gg,0)  
                                                 + nvl(qtd_dist_egg,0) 
                                                 + nvl(qtd_dist_exgg,0) 
                                                 + nvl(qtd_dist_u,0))*i.valorvenda )
                                       from itenscargarepresentante i 
                                       where i.idcargarepresentante in ( select c.idcargarepresentante
                                                                         from cargasrepresentantes c
                                                                         where c.idrepresentante = r.idrepresentante
                                                                           and c.situacao        != 0
                                                                           and pck_util.fnc_idsemana(c.semana) >= r.idsemanabalanco )),0) valorcarga
                             , nvl(( select sum(nvl(i.qtd_u,0)
                                              + nvl(i.qtd_egg,0)
                                              + nvl(i.qtd_gg ,0)
                                              + nvl(i.qtd_g  ,0)
                                              + nvl(i.qtd_m  ,0)
                                              + nvl(i.qtd_p  ,0)
                                              + nvl(i.qtd_pp ,0))
                                     from itensdevolucaorepres i
                                     where i.iddevolucaorepres in ( select d.iddevolucaorepres
                                                                     from devolucoesrepresentantes d
                                                                     where d.idrepresentante = r.idrepresentante
                                                                       and d.situacao        != 0
                                                                       and pck_util.fnc_idsemana(d.semana) >= r.idsemanabalanco ) ),0) devolucao
                             , nvl(( select sum((nvl(i.qtd_u,0)
                                               + nvl(i.qtd_egg,0)
                                               + nvl(i.qtd_gg ,0)
                                               + nvl(i.qtd_g  ,0)
                                               + nvl(i.qtd_m  ,0)
                                               + nvl(i.qtd_p  ,0)
                                               + nvl(i.qtd_pp ,0))*i.valorproduto)
                                     from itensdevolucaorepres i
                                     where i.iddevolucaorepres in ( select d.iddevolucaorepres
                                                                     from devolucoesrepresentantes d
                                                                     where d.idrepresentante = r.idrepresentante
                                                                       and d.situacao        != 0
                                                                       and pck_util.fnc_idsemana(d.semana) >= r.idsemanabalanco ) ),0) valordevolucao
                             , nvl(( select sum(nvl(i.quantidade,0)-nvl(i.qtddevolvida,0))
                                     from itensnotavenda i
                                     where i.idnotavenda in ( select idnotavenda
                                                              from notasvendas n
                                                              where n.idrepresentante = r.idrepresentante
                                                                and n.idsituacaonotavenda = 4 
                                                                and pck_util.fnc_idsemana(n.semanacobranca) >= r.idsemanabalanco ) ),0) vendeu
                             , nvl(( select sum((nvl(i.quantidade,0)-nvl(i.qtddevolvida,0))*i.valorvenda )
                                     from itensnotavenda i
                                     where i.idnotavenda in ( select idnotavenda
                                                              from notasvendas n
                                                              where n.idrepresentante = r.idrepresentante
                                                                and n.idsituacaonotavenda = 4 
                                                                and pck_util.fnc_idsemana(n.semanacobranca) >= r.idsemanabalanco ) ),0) valorvendeu
                             , nvl(( select sum(i.quantidade)
                                     from itensnotavenda i
                                     where i.qtddevolvida is null
                                       and i.idnotavenda in ( select idnotavenda
                                                              from notasvendas n
                                                              where n.idrepresentante = r.idrepresentante
                                                                and n.idsituacaonotavenda < 4  ) ),0) emaberto
                             , nvl(( select sum(i.quantidade*i.valorvenda)
                                     from itensnotavenda i
                                     where i.qtddevolvida is null
                                       and i.idnotavenda in ( select idnotavenda
                                                              from notasvendas n
                                                              where n.idrepresentante = r.idrepresentante
                                                                and n.idsituacaonotavenda < 4 ) ),0) valoremaberto
                             , decode(r.ativo,'S','Sim','Não') ativo 
                        from representantes r
                        where r.idgerente = ( select idgerente 
                                              from gerentes
                                              where idfilial = :P0_IDFILIAL ))
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        headerAndFooter {
            headerText:
                ```html
                <b>Números expressos em quantidade de peças.</b><br><br>
                <b>-> Carga </b>= Soma de todas quantidades de produtos carregados até hoje.<br>
                <b>-> Devolução </b>= Soma de todas quantidades devolvidas até hoje.<br>
                <b>-> Vendeu </b>= Soma de todas quantidades vendidas até hoje.<br>
                <b>-> Consultoras </b>= Soma de produtos que estão em notas não atendidas.<br>
                <b>-> Falta devolver </b>= Produtos que falta prestar contas.<br>
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
