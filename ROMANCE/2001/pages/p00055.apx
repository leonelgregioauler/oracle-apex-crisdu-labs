page 55 (
    name: "Estoque Cliente "
    title: "Estoque Cliente "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region estoque-cliente (
        name: Estoque Cliente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select initcap( nvl(p.apelido,p.nomepessoa ) ) 
                         from filiais f
                            , pessoas p
                         where f.idpessoa = p.idpessoa
                           and f.idfilial = e.idfilial ) "Filial"
                     , ( select initcap( nvl(pr.apelido,pr.nomepessoa ) ) 
                         from representantes  rr
                            , pessoas         pr
                         where rr.idpessoa        = pr.idpessoa
                           and rr.idrepresentante = ( select idrepresentante
                                                      from vendedoras v
                                                      where v.idvendedora = ev.idvendedora ) ) "Representante"
                     , ( select initcap( nvl(pr.apelido,pr.nomepessoa ) ) 
                         from vendedoras  rr
                            , pessoas         pr
                         where rr.idpessoa        = pr.idpessoa
                           and rr.idvendedora = ev.idvendedora ) "Vendedora"
                     , ( select ca.nome
                         from categorias ca
                         where ca.idcategoria = ( select pr.idcategoria 
                                                 from produtos    pr
                                                 where pr.idproduto = e.idproduto ) ) "Categoria"
                     , ( select pr.codigosisdist 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Código"  
                     , ( select initcap( pr.nomeproduto ) 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Produto"         
                     , ( select c.descricao 
                         from cores c
                         where c.idcor = e.idcor ) "Cor"
                     , ev.quantidade
                     , ev.idestoquevendedora
                     , ev.idvendedora
                     , e.idestoquefilial
                     , e.idfilial
                     , e.idproduto
                     , e.idcor
                     , ev.qtd_pp            
                     , ev.qtd_p             
                     , ev.qtd_m   
                     , ev.qtd_g             
                     , ev.qtd_gg            
                     , ev.qtd_egg 
                     , ev.qtd_u 
                from estoquevendedora     ev
                   , estoquefilial        e
                where ev.idestoquefil   = e.idestoquefilial
                  and e.idfilial   = pck_romance.fnc_filialusuario(v('APP_USER'))
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Estoque não cadastrado.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

