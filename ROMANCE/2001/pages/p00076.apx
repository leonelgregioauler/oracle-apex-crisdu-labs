    validation p76-nrpedido (
        name: P76_NRPEDIDO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P76_NRPEDIDO
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            displayLocation: inlineInNotification
            associatedItem: @P76_NRPEDIDO
        }
        serverSideCondition {
            type: request!=Value
            value: ENVIARCOBRANCA
        }
    )

    validation p76-nrpedido-2 (
        name: P76_NRPEDIDO
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from pepinosrepresentantes r 
                where r.nrpedido = :P76_NRPEDIDO
                  and r.idrepresentante = :P76_IDREPRESENTANTE
                  and r.situacao = 'N'
                ```
        }
        error {
            errorMessage: Já existe um pepino incluído com este número!
            displayLocation: inlineInNotification
            associatedItem: @P76_NRPEDIDO
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: item=value
            item: P76_SITUACAO
            value: N
        }
    )

    validation p76-nrpedido-3 (
        name: P76_NRPEDIDO
        execution {
            sequence: 70
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists (select 1
                              from pepinosrepresentantes r 
                              where r.nrpedido = :P76_NRPEDIDO
                                and r.idrepresentante = :P76_IDREPRESENTANTE
                                and r.situacao = 'C')
                  or  exists (select 1
                              from notasvendas n 
                              where n.numeronota = :P76_NRPEDIDO
                                and n.idrepresentante = :P76_IDREPRESENTANTE
                                and n.enviadocobranca = 'S')
                ```
        }
        error {
            errorMessage: Não é possível receber este valor, o débito já foi enviado para o Setor de Cobrança! O representante deve entrar em contato com o Setor de Cobranças.
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: item=value
            item: P76_SITUACAO
            value: P
        }
    )

    validation p76-semana (
        name: P76_SEMANA
        execution {
            sequence: 50
        }
        validation {
            type: itemIsNotNull
            item: P76_SEMANA
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P76_SEMANA
        }
        serverSideCondition {
            type: request!=Value
            value: ENVIARCOBRANCA
        }
    )

    validation p76-valor (
        name: P76_VALOR
        execution {
            sequence: 40
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P76_VALOR is not null
                  and to_number(:P76_VALOR) > 0
                  and v('REQUEST') != 'ENVIACOBRANCA'
                ```
        }
        error {
            errorMessage: #LABEL# deve ser informado! E não pode ser negativo!
            associatedItem: @P76_VALOR
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM DUAL
                WHERE :P76_SITUACAO = 'C'
                  and v('REQUEST') != 'ENVIACOBRANCA'
                ```
        }
    )

    validation p76-valor-2 (
        name: P76_VALOR
        execution {
            sequence: 60
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from pepinosrepresentantes r 
                where r.nrpedido = :P76_NRPEDIDO
                  and r.situacao = 'N'
                  and r.idrepresentante = :P76_IDREPRESENTANTE
                  having r.valor < (NVL(( select sum(pg.valor) 
                                          from pepinosrepresentantes pg
                                          where pg.nrpedido = r.nrpedido
                                            and pg.idrepresentante = r.idrepresentante
                                            and pg.situacao = 'P' ),0) + to_number(:P76_VALOR,'999999990D00'))
                group by r.nrpedido
                       , r.valor
                       , r.idrepresentante
                ```
        }
        error {
            errorMessage: O valor a ser pago deve ser menor que o valor em aberto deste pepino.
            displayLocation: inlineInNotification
            associatedItem: @P76_VALOR
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: item=value
            item: P76_SITUACAO
            value: P
        }
    )

    validation valida-pagamento (
        name: valida pagamento
        execution {
            sequence: 80
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM NOTASVENDAS N
                WHERE IDREPRESENTANTE = :P76_IDREPRESENTANTE
                  AND N.NUMERONOTA = :P76_NRPEDIDO
                ```
        }
        error {
            errorMessage: ClienteR possui uma nota no sistema com este número! Para efetuar o pagamento, entre na nota de venda!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process atualiza-pago (
        name: atualiza pago
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                if :P76_SITUACAO in ('P', 'D') then
                 :P76_IDFECHAMENTOREPRESPAGO := :P76_IDFECHAMENTOREPRES;
                else 
                :P76_IDFECHAMENTOREPRESPAGO := null;
                end if;
                end;
                ```
        }
        execution {
            sequence: 75
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 157257956660227670
        }
    )

    process envia-cobranca (
        name: envia cobranca
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P76_SITUACAO in ('C') then
                    --
                    update pepinosrepresentantes p
                    set situacao = 'C'
                    WHERE p.nrpedido = :P76_NRPEDIDO
                      and p.idrepresentante = :P76_IDREPRESENTANTE
                      and p.situacao = 'N';
                    --
                    update notasvendas n
                    set n.enviadocobranca = 'S'
                    WHERE n.numeronota = :P76_NRPEDIDO
                      and n.idrepresentante = :P76_IDREPRESENTANTE;
                    --
                  end if;
                end;
                ```
        }
        execution {
            sequence: 1
        }
        advanced {
            executionMappingIdentifier: 17898176899011530
        }
        serverSideCondition {
            type: itemIsNull
            item: P76_IDPEPINOSREPRESENTANTE
        }
    )

    process envia-cobranca-2 (
        name: envia cobranca
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                update pepinosrepresentantes p
                set situacao = 'C'
                where idpepinosrepresentante = :P75_IDPEPINO;
                end;
                ```
        }
        execution {
            sequence: 11
        }
        successMessage {
            successMessage: Débito enviado para cobrança!
        }
