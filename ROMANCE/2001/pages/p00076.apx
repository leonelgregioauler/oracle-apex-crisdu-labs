    pageItem P76_MSG (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 180
            region: @débitos-de-distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 'Valor em aberto: R$ '||TRIM(to_char(r.valor - NVL(( select sum(pg.valor) 
                                                           from pepinosrepresentantes pg
                                                           where pg.nrpedido = r.nrpedido
                                                             and pg.idfechamentorepres in ( select f.idfechamentorepres from fechamentorepresentantes f where f.idrepresentante = :P76_IDREPRESENTANTE)
                                                             and pg.situacao = 'P' ),0) ,'999G999G990D00'))
                from pepinosrepresentantes r 
                where r.nrpedido = :P76_NRPEDIDO
                and r.situacao = 'N'
                and r.idfechamentorepres in ( select f.idfechamentorepres from fechamentorepresentantes f where f.idrepresentante = :P76_IDREPRESENTANTE)
                group by  r.nrpedido
                     , r.valor
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

