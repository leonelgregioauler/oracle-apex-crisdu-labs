        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region débitos-abertos (
        name: Débitos Abertos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nrpedido
                     , semana
                     , representante
                     , nomevendedora
                     , valor
                     , valorpago
                     , saldo
                     , filial
                     , ultimopagamento
                     , idpepinosrepresentante
                     , cpf
                     , idnotavenda
                     , idrepresentante 
                     , origem
                     , ( select pck_romance.fnc_retornatelefones( idvendedora )
                         from vendedoras v
                            , pessoas p
                         where v.idpessoa = p.idpessoa
                           and p.cpf = w.cpf ) telefones 
                from vw_debitosrepresentantes w
                where saldo > 0
                  and idrepresentante = :P76_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <FONT COLor="RED"> Para enviar para cobrança, basta clicar no ícone cinza.</font>
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum pepino aberto para este promotor.
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
        }

        column CPF (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: CPF
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
        )

