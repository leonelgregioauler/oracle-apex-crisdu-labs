        column IDPEPINOSREPRESENTANTE (
            reportColumnQueryId: 10
            derivedColumn: N
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            link {
                target: {
                    page: 76
                    items: {
                        P76_IDPEPINOSREPRESENTANTE: #IDPEPINOSREPRESENTANTE#
                    }
                }
                linkText: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt="">
            }
            sorting {
                defaultSequence: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from fechamentossemanais f
                    where nvl(f.concluido,'N') = 'N'
                      and f.idfechamento       = ( select fr.idfechamento
                                                     from roman.fechamentorepresentantes fr
                                                    where fr.idfechamento = f.idfechamento
                                                      and fr.idfechamentorepres = :P76_IDFECHAMENTOREPRES)
                      and f.idfilial           = :P0_IDFILIAL
                     -- and :P76_IDFECHAMENTOREPRES is not null
                      and exists (select 1
                                  from representantes
                                  where idrepresentante = :P76_IDREPRESENTANTE
                                    and usanetbook = 'S')
                    ```
            }
        )

        column IDREPRESENTANTE (
            reportColumnQueryId: 13
            derivedColumn: N
            type: hidden
            layout {
                sequence: 14
            }
        )

        column LINK$01 (
            reportColumnQueryId: 16
            derivedColumn: Y
            type: link
            heading {
                heading: Enviar Cobrança
                alignment: center
            }
            layout {
                sequence: 12
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: javascript: document.getElementById('P76_IDPEPINO').value = #IDPEPINOSREPRESENTANTE#; apex.submit('ENVIARCOBRANCA');
                }
                linkText: <img src="#IMAGE_PREFIX#e2.gif" alt="">
                linkAttributes: alt="#NRPEDIDO#"
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from fechamentossemanais f
                    where nvl(f.concluido,'N') = 'N'
                      and f.idfechamento       = ( select fr.idfechamento
                                                     from roman.fechamentorepresentantes fr
                                                    where fr.idfechamento = f.idfechamento
                                                      and fr.idfechamentorepres = :P76_IDFECHAMENTOREPRES)
                      and f.idfilial           = :P0_IDFILIAL
                     -- and :P76_IDFECHAMENTOREPRES is not null
                      and exists (select 1
                                  from representantes
                                  where idrepresentante = :P76_IDREPRESENTANTE
                                    and usanetbook = 'S')
                    ```
            }
        )

