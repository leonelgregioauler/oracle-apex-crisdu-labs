    region débitos-de-distribuidor (
        name: Débitos de Distribuidor
        type: staticContent
        source {
            htmlCode:
                ```html
                <script language="javascript">
                function  confirmapepino(event)
                { 
                var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
                
                if (tecla==13) {
                var answer = confirm("Confirma inclusão do débito?")
                	if (answer){            
                		apex.submit('CREATE');
                	}
                }
                }
                </script>
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where nvl(f.concluido,'N') = 'N'
                  and f.idfechamento       = ( select fr.idfechamento
                                                 from roman.fechamentorepresentantes fr
                                                where fr.idfechamento = f.idfechamento
                                                  and fr.idfechamentorepres = :P76_IDFECHAMENTOREPRES)
                  and f.idfilial           = :P0_IDFILIAL
                 -- and :P76_IDFECHAMENTOREPRES is not null
                  and exists (select 1
                              from representantes
                              where idrepresentante = :P76_IDREPRESENTANTE
                                and usanetbook = 'S')
                ```
        }
    )

    region débitos-pagos-devolvidos-enviados-para-cobrança-na-semana (
        name: Débitos Pagos/Devolvidos/Enviados para Cobrança na Semana
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.idpepinosrepresentante
                     , r.idfechamentorepres 
                     , r.nrpedido
                     , r.valor
                     , r.semana
                     , decode(r.situacao,'N','Novo','P','Pago','D','Mercadoria Devolvida', 'C', 'Enviado para Cobrança') situacao
                     , r.semanapago
                     , r.observacao
                     , r.nomevendedora
                     , r.cpf
                     , r.idrepresentante "ID"
                from pepinosrepresentantes r
                where r.idfechamentoreprespago = :P76_IDFECHAMENTOREPRES
                  or ( r.idfechamentorepres = :P76_IDFECHAMENTOREPRES
                     and r.situacao = 'C' )
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum pepino pago para este Distribuidor.
        }
        componentAdvanced {
            stripHtml: true
        }

