    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select seq_idpepinosrepres.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P76_IDPEPINOSREPRESENTANTE := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 70
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 157257756242227670
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

