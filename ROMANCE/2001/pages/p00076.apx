        }
        serverSideCondition {
            type: request=Value
            value: ENVIARCOBRANCA
        }
    )

    process excluir (
        name: excluir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidpepino number := :P76_IDPEPINOSREPRESENTANTE;
                  vidnota number;
                begin
                  --
                  select idnotavenda
                  into vidnota
                  from pepinosrepresentantes p
                  where p.idpepinosrepresentante = vidpepino;
                  --
                  delete pagamentosnotasvendas n
                  where (idnotavenda, n.valorpago) = ( select idnotavenda, p.valor
                                                       from pepinosrepresentantes p
                                                       where p.idpepinosrepresentante = vidpepino); 
                  --
                  pck_romance.prc_atualizanotavenda(vidnota);
                  --
                exception
                  when others then
                    null;
                end;
                ```
        }
        execution {
            sequence: 1
        }
        advanced {
            executionMappingIdentifier: 45528657529231984
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

