            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vsemana varchar2(10);
                begin
                  select semana
                  into vsemana
                  from fechamentorepresentantes f
                  where f.idfechamentorepres = :P76_IDFECHAMENTOREPRES;
                  return vsemana;
                exception 
                  when others then 
                    null;
                end;
                ```
