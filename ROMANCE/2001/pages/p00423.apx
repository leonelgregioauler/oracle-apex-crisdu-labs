page 423 (
    name: Processos Notificações App Romance
    title: Processos Notificações App Romance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region enviar-teste (
        name: Enviar Teste
        type: staticContent
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region notificações-enviadas (
        name: Notificações enviadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.titulo
                     , n.mensagem
                     , n.datainclusao
                     , n.dataenvio
                     , n.datarecebimento
                     , p.nomeprocesso  
                     , n.urlimagem
                     , n.urldestino
                from notificacoesconsultoras  n
                   , processosnotificavendedoras p
                where n.idprocessonotificavendedora = p.idprocessonotificavendedora (+)   
                  and n.idpessoa                    = 369697
                --order by n.idnotificacao desc
                ```
            pageItemsToSubmit: P423_IDPESSOA
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 9090350780397352068
        }

        column DATAENVIO (
            type: plainText
            heading {
                heading: Envio
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
