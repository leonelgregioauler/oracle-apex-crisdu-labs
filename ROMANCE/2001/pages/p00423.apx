    region processos-notificações-app-romance (
        name: Processos Notificações App Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idprocessonotificavendedora
                     , t.nomeprocesso
                     , t.urlimagem
                     , t.urldestino
                     , decode(t.tiposomnotificacao,0,'Sem Som',1,'Notificação Padrão', 2, 'Dinheiro' ) tiposomnotificacao
                     , t.titulo
                     , t.mensagem
                     , decode(t.entrarlogado,'S','Sim','Não') entrarlogado
                     , (select p.nome
                        from catal.paises p
                        where p.idpais = t.idpais ) pais
                from processosnotificavendedoras t
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 424
                items: {
                    P424_IDPROCESSONOTIFICAVENDEDO: #IDPROCESSONOTIFICAVENDEDORA#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 4581621521732979290
        }

        column ENTRARLOGADO (
            type: plainText
            heading {
                heading: Entrar Logado Favorita
                alignment: center
            }
            layout {
                sequence: 27
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

