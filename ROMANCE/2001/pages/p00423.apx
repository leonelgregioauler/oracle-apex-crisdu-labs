    pageItem P423_CPFTESTE (
        type: displayOnly
        label {
            label: CPF de Teste
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 20
            region: @enviar-teste
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue:
                ```
                Para fazer teste de postagem:
                1) Ative apenas para a "Empresa Teste".
                2) Entre no aplicativo com o cpf 263.455.080-47
                
                Antigo, não usar mais:
                <s>032.376.400-26 - IDPESSOA: 369697 - IDVENDEDORA: 308220</s>
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P423_IDPROCESSONOTIFICACAO (
        type: selectList
        label {
            label: Notificação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idprocessonotificavendedora||' - '|| t.nomeprocesso                display_value
                     , t.idprocessonotificavendedora return_value
                from processosnotificavendedoras t
                order by 1 
                ```
        }
        layout {
            sequence: 10
            region: @enviar-teste
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button enviar (
        buttonName: ENVIAR
        label: Enviar
        layout {
            sequence: 30
            region: @enviar-teste
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button novo (
        buttonName: Novo
        label: Novo
        layout {
            sequence: 10
            region: @processos-notificações-app-romance
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 424
                items: {
                    P424_IDPROCESSONOTIFICAVENDEDO:
                }
                clearCache: 424
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction submit (
        name: SUBMIT
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @enviar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ENVIARNOTIFICACAO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process notificação-teste (
        name: Notificação Teste
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 20/06/2020 by EVERT 
                declare 
                  -- Local variables here
                  i integer;
                begin
                  -- Test statements here
                   roman.pck_appminhasacola.prc_notificacoesconsultoras(pidnotificacao               => null,
                                                                       pidpessoa                    => 369697 ,
                                                                       pidpedido                    => null,
                                                                       ptiponotificacao             => 'A',
                                                                       ptitulo                      => null,
                                                                       pmensagem                    => null,
                                                                       ptiposomnotificacao          => null,
                                                                       pidfilial                    => null,
                                                                       pdatainclusao                => null,
                                                                       pdataenvio                   => null,
                                                                       pdatarecebimento             => null,
                                                                       pdataleitura                 => null,
                                                                       purlimagem                   => null,
                                                                       purldestino                  => null,
                                                                       pidprocessonotificavendedora => :P423_IDPROCESSONOTIFICACAO,
                                                                       poperacao_dml                => 'I')  ;
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 4489509790346677728
        }
        serverSideCondition {
            type: request=Value
            value: ENVIARNOTIFICACAO
        }
    )

)

