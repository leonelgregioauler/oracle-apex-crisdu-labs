page 845 (
    name: Chaves de Acesso Requisição Pagamento
    title: Chaves de Acesso Requisição Pagamento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        inline:
            ```css
            .t-aviso-formato { color: #E65100; font-weight: bold; white-space: normal !important; word-break: break-word; }
            .t-aviso-duplicidade { color: #C62828; font-weight: bold; white-space: normal !important; word-break: break-word; }
            ```
    }

    region chaves-de-acesso-requisição-pagamento (
        name: Chaves de Acesso Requisição Pagamento
        title: Chaves de Acesso Requisição Pagamento
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.IDCHAVEACESSOREQUISICAO
                          , C.IDREQUISICAOPGTO
                          , C.TIPODOCUMENTO
                          , C.CHAVEACESSO
                          , C.VALORDOCUMENTO
                          , C.ORDEM
                          , CASE
                              WHEN C.TIPODOCUMENTO IN ('NFE','CTE') AND LENGTH(C.CHAVEACESSO) != 44
                                THEN 'Quantidade de caracteres fora do padrão (esperado 44).'
                              WHEN C.TIPODOCUMENTO = 'NFSE_NAC' AND LENGTH(C.CHAVEACESSO) != 50
                                THEN 'Quantidade de caracteres fora do padrão (esperado 50).'
                              ELSE ROMAN.PCK_REQUISICOESPAGAMENTO.FNC_VALIDA_DV_CHAVEACESSO(C.CHAVEACESSO)
                            END AVISO
                          , ROMAN.PCK_REQUISICOESPAGAMENTO.FNC_CHAVEACESSO_DUPLICADA(C.CHAVEACESSO, C.IDREQUISICAOPGTO) AVISO_DUPLICIDADE
                     FROM   ROMAN.CHAVESACESSOREQUISICOES C
                     WHERE  C.IDREQUISICAOPGTO = :P845_IDREQUISICAO
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        componentAppearance {
            showNullValuesAs: -
            fixedRowHeight: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 845000000000000003
        }

        savedReport 84500004 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDCHAVEACESSOREQUISICAO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDREQUISICAOPGTO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @TIPODOCUMENTO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @CHAVEACESSO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @VALORDOCUMENTO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @ORDEM
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @AVISO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @AVISO_DUPLICIDADE
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            sort (
                column: @ORDEM
                sort {
                    nulls: last
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 2
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 1
            }
        )

        column AVISO (
            type: displayOnly
            heading {
                heading: Aviso
            }
            layout {
                sequence: 60
            }
            appearance {
                cssClasses: t-aviso-formato
            }
            source {
                databaseColumn: AVISO
                dataType: varchar2
                queryOnly: true
            }
            enableUsersTo {
                sort: false
            }
        )

        column AVISO_DUPLICIDADE (
            type: displayOnly
            heading {
                heading: Chave em Outra Requisição
            }
            layout {
                sequence: 70
            }
            appearance {
                cssClasses: t-aviso-duplicidade
            }
            source {
                databaseColumn: AVISO_DUPLICIDADE
                dataType: varchar2
                queryOnly: true
            }
            enableUsersTo {
                sort: false
            }
        )

        column CHAVEACESSO (
            type: textField
            heading {
                heading: Chave de Acesso
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: CHAVEACESSO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDCHAVEACESSOREQUISICAO (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: IDCHAVEACESSOREQUISICAO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: ROMAN.SEQ_IDCHAVEACESSOREQUISICAO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDREQUISICAOPGTO (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                databaseColumn: IDREQUISICAOPGTO
                dataType: number
            }
            default {
                type: item
                item: P845_IDREQUISICAO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ORDEM (
            type: displayOnly
            heading {
                heading: Ordem
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: ORDEM
                dataType: number
                queryOnly: true
            }
            default {
                type: sqlQuerySingleValue
                sqlQuerySingleValue: select 0 from dual
            }
            columnFilter {
                lovType: none
            }
        )

        column TIPODOCUMENTO (
            type: selectList
            heading {
                heading: Tipo Documento
            }
            lov {
                type: staticValues
                staticValues: STATIC:NF-e;NFE,CT-e;CTE,NFS-e nacional;NFSE_NAC,Municipal;MUNICIPAL,Outro;OUTRO
            }
            layout {
                sequence: 30
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: TIPODOCUMENTO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column VALORDOCUMENTO (
            type: numberField
            heading {
                heading: Valor do Documento
                alignment: end
            }
            settings {
                numberAlignment: end
            }
            layout {
                sequence: 45
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: VALORDOCUMENTO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Chaves de Acesso Requisição Pagamento
        }
    )

    pageItem P845_IDREQUISICAO (
        type: hidden
        layout {
            sequence: 10
            region: @chaves-de-acesso-requisição-pagamento
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @chaves-de-acesso-requisição-pagamento
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 674
                items: {
                    P674_IDREQUISICAO: &P845_IDREQUISICAO.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-chave (
        name: valida_chave
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @chaves-de-acesso-requisição-pagamento
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                if nvl(:TIPODOCUMENTO,'X') != 'OUTRO' and :CHAVEACESSO is null then
                  return 'Chave de Acesso é obrigatória para este Tipo de Documento.';
                end if;
                return null;
                ```
        }
        error {
            associatedColumn: CHAVEACESSO
        }
    )

    validation valida-valor (
        name: valida_valor
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @chaves-de-acesso-requisição-pagamento
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                if nvl(:TIPODOCUMENTO,'X') != 'OUTRO' and :VALORDOCUMENTO is null then
                  return 'Valor do Documento é obrigatório para este Tipo de Documento.';
                end if;
                return null;
                ```
        }
        error {
            associatedColumn: VALORDOCUMENTO
        }
    )

    process chaves-de-acesso-save-interactive-grid-data (
        name: Chaves de Acesso - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @chaves-de-acesso-requisição-pagamento
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 845000000000000026
        }
    )

)

