    pageItem P75_IDCOMISSAO (
        type: selectList
        label {
            label: % Desconto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(c.percpromotor,'999G999G990D00')||'%') display_value -- Query para Controladoria
                     , c.idcomissaofilial return_value
                from comissoesfiliais c
                where c.idfilial = :P0_IDFILIAL
                  and exists (select 1 
                                from roman.usuariosgruposatendimento uga
                               where uga.idgrupoatendimento in (0,2) -- Ti / Controladoria de Despesas
                                 and uga.usuario = v('APP_USER'))
                --
                union
                -- se o representante tiver comissão cadastrada, usa apenas essa
                select trim(to_char(c.percpromotor,'999G999G990D00')||'%') display_value
                     , c.idcomissaofilial return_value
                from roman.comissoesfiliais c
                   , catal.representantes re
                where re.idcomissao = c.idcomissaofilial
                  and c.idfilial = :P0_IDFILIAL
                  and re.idrepresentante = :P75_IDREPRESENTANTE
                  and re.idcomissao is not null
                --
                union
                -- se o rep nao tem comissão cadastrada, libera a lista que ja tem hoje
                select trim(to_char(c.percpromotor,'999G999G990D00')||'%') display_value
                     , c.idcomissaofilial return_value
                from comissoesfiliais c
                where c.idfilial = :P0_IDFILIAL
                  and not exists (select 1
                                    from catal.representantes re
                                   where re.idrepresentante = :P75_IDREPRESENTANTE
                                     and re.idcomissao is not null)
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 640
            region: @romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: databaseColumn
            databaseColumn: IDCOMISSAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

