                                     where pp.idpedido  = tf.idpedido 
                                       and pp.idvencimentopedido = tf.idvencimentopedido
                                       and pp.idgerente is not null
                                       and pp.idgerente = ( select idgerente
                                                             from gerentes
                                                             where idpessoa = ( select idpessoa
                                                                                from representantes u
                                                                                where u.idrepresentante = :P75_IDREPRESENTANTE ) ) );
