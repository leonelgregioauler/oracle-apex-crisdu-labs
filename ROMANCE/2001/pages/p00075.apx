    pageItem P75_MSGNEGBALANCOS (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
            sendOnPageSubmit: false
        }
        layout {
            sequence: 20
            region: @romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<h3><b>Este distribuidor possui uma negociação de balanço em aberto.</h3></b>' a
                from (
                      select nb.valor + nvl(nb.valorjuros,0) total
                           , nvl((select sum(pb.valorpago)
                                  from pagamentosnegociacoesbalanco pb
                                  where pb.conferido = 'S'
                                    and pb.idnegociacaobalanco = nb.idnegociacaobalanco ),0) pago
                      from negociacoesbalanco nb
                      where nb.idrepresentante = :P75_IDREPRESENTANTE ) neg
                where total - pago > 5
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from (
                      select nb.valor + nvl(nb.valorjuros,0) total
                           , nvl((select sum(pb.valorpago)
                                  from pagamentosnegociacoesbalanco pb
                                  where pb.conferido = 'S'
                                    and pb.idnegociacaobalanco = nb.idnegociacaobalanco ),0) pago
                      from negociacoesbalanco nb
                      where nb.idrepresentante = :P75_IDREPRESENTANTE ) neg
                where total - pago > 0
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P75_MSGRECORDE (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 10
            region: @romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<span class="recorde-badge">'
                       || '<span class="fa fa-trophy" aria-hidden="true"></span> '
                       || case when h.recorde_anterior > 0
                               then 'RECORDE! Maior cobrança semanal deste distribuidor. Anterior: '
                                    || trim(to_char(h.recorde_anterior,'999G999G990D00'))
                                    || ' (semana ' || h.semana_anterior || ')'
                               else 'PRIMEIRO RECORDE! Maior cobrança semanal deste distribuidor.'
                          end
                       || '</span>' msgrecorde
                from ( select nvl(max(f.totalgeral),0) recorde_anterior
                            , max(f.semana) keep (dense_rank last order by nvl(f.totalgeral,0)) semana_anterior
                       from fechamentorepresentantes f
                       where f.idrepresentante     = :P75_IDREPRESENTANTE
                         and f.idfechamentorepres <> nvl(:P75_IDFECHAMENTOREPRES,-1)
                       ) h
                where nvl(to_number(:P75_TOTALGERAL,'999G999G999G999G999G999G999G990D00'),0) > h.recorde_anterior
                  and nvl(to_number(:P75_TOTALGERAL,'999G999G999G999G999G999G999G990D00'),0) > 0
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from ( select nvl(max(f.totalgeral),0) recorde_anterior
                            , max(f.semana) keep (dense_rank last order by nvl(f.totalgeral,0)) semana_anterior
                       from fechamentorepresentantes f
                       where f.idrepresentante     = :P75_IDREPRESENTANTE
                         and f.idfechamentorepres <> nvl(:P75_IDFECHAMENTOREPRES,-1)
                       --and f.idregiaovenda = nvl(:P75_IDREGIAOVENDA_1,:P75_IDREGIAOVENDA)  -- se o recorde for por região
                       ) h
                where nvl(to_number(:P75_TOTALGERAL,'999G999G999G999G999G999G999G990D00'),0) > h.recorde_anterior
                  and nvl(to_number(:P75_TOTALGERAL,'999G999G999G999G999G999G999G990D00'),0) > 0
                ```
        }
    )

    pageItem P75_MSGREPATENDE (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
            sendOnPageSubmit: false
        }
        layout {
            sequence: 90
            region: @romance
            slot: regionBody
            alignment: left
            columnAttributes: [
                onclick="javascript:repatende()"
                readonly
            ]
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="red">Este distribuidor cobrou: R$'||to_char(sum(d.valorpago),'999G999G999G999G990D00')||' em nota(s) de outro(s) distribuidore(s)</font><br>' cobrou
                      -- '<font color="green"> O acerto de '||d.distribuidor||' estará disponível quando sincronizar o seu tablet.</font>' cobrou
                from ( select sum(p.valorpago) valorpago
                           -- , pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                       from roman.notasvendas n
                          , roman.pagamentosnotasvendas p
                       where p.idnotavenda = n.idnotavenda
                         and n.idrepresentanteatende = :P75_IDREPRESENTANTE
                         and n.idsituacaonotavenda = 4
                         and p.origem = 'R'
                         and p.idsemanacobranca = ( select d.idsemana 
                                                    from fechamentossemanais d
                                                    where idfechamento = :P75_IDFECHAMENTOPONTUACAO ) group by idrepresentante ) d
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from notasvendas b
                where b.idrepresentanteatende = :P75_IDREPRESENTANTE
                  and b.semanacobranca = ( select semana 
                                           from fechamentossemanais
                                           where idfechamento = :P75_IDFECHAMENTOPONTUACAO )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P75_MSGRESGATES (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
            sendOnPageSubmit: false
        }
        layout {
            sequence: 60
            region: @romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<h3><font color ="green"> Existem peças com defeitos pendentes de resgate! Total de Peças: '||nvl(sum(nvl(it.qtd_pp,0)
                                                                                                                       +nvl(it.qtd_p,0)
                                                                                                                       +nvl(it.qtd_m,0)
                                                                                                                       +nvl(it.qtd_g,0)
                                                                                                                       +nvl(it.qtd_gg,0)
                                                                                                                       +nvl(it.qtd_egg,0)
                                                                                                                       +nvl(it.qtd_exgg,0)
                                                                                                                       +nvl(it.qtd_u,0)),0)||'.</h3></font>' a
                from itensdevolucaorepres it
                where exists ( select 1
                               from devolucoesrepresentantes d
                               where it.iddevolucaorepres = d.iddevolucaorepres
                                 and d.idrepresentante    = :P75_IDREPRESENTANTE )
                  and it.iddefeito         is not null
                  and it.idfechamentoreprespago is null
                  and it.situacaodefeito is null
                  and exists ( select 1
                                 from defeitos dd
                                 where dd.iddefeito = it.iddefeito
                                   and dd.origemdefeito = 'R')
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from itensdevolucaorepres it
                where exists ( select 1
                               from devolucoesrepresentantes d
                               where it.iddevolucaorepres = d.iddevolucaorepres
                                 and d.idrepresentante    = :P75_IDREPRESENTANTE )
                  and it.iddefeito         is not null
                  and it.idfechamentoreprespago is null
                  and it.situacaodefeito is null
                  and exists ( select 1
                                 from defeitos dd
                                 where dd.iddefeito = it.iddefeito
                                   and dd.origemdefeito = 'R')
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P75_MSGTABLETALTERADO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
            sendOnPageSubmit: false
        }
        layout {
            sequence: 70
            region: @romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<h3><font color ="red">O Tablet deste distribuidor foi formatado ou removido o aplicativo de vendas durante esta semana, isso pode impactar nos valores do acerto! Últimos dados recebidos no dia '
                       ||to_date(max(r.databackup),'DD/MM/RRRR HH24:MI:SS')||'.</h3></font>' a
                from registrosbackuptablet r
                where r.semana = :P75_SEMANA
                  and r.idrepresentante = :P75_IDREPRESENTANTE
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from equipamentos e
                                  , representantes r
                                  , usuarios u
                               where e.dataultimaalteracao is not null
                                 and e.usuario = u.usuario
                                 and r.idpessoa = u.idpessoa
                                 and r.idrepresentante = :P75_IDREPRESENTANTE
                                 and (e.idsemanaalteracao-1) = pck_util.fnc_idsemana(:P75_SEMANA) )
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P75_MSGVEND2NOTAS (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 100
            region: @romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
