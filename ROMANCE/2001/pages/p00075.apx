    region desafio-favorita (
        name: Desafio Favorita
        type: staticContent
        layout {
            sequence: 30
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: &P75_MSGDESAFIOFAV!RAW.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from favorita.engajamentosrepresentantes e
                 where e.idrepresentante = :P75_IDREPRESENTANTE
                   and e.idfilial        = :P75_IDFILIAL
                   and e.datareferencia  = ( select case when to_number(to_char(b.dt,'DD')) between 1 and 5
                                                         then add_months(trunc(b.dt,'MM'),-1)
                                                         else trunc(b.dt,'MM')
                                                    end
                                               -- dia de hoje (nao a data do acerto): de 01 a 05 vale o mes anterior
                                               from ( select trunc(sysdate) dt
                                                        from dual ) b )
                 group by e.idrepresentante
                having sum(nvl(coalesce(e.valordesafioajustado2
                                       ,e.valordesafioajustado
                                       ,e.valordesafio),0)) > 0
                ```
        }
    )

    region desafio-romance (
        name: Desafio Romance
        type: staticContent
        layout {
            sequence: 35
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: &P75_MSGDESAFIOROM!RAW.&P75_MSGDESAFIOROMSEM!RAW.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from metasdesafiodistribuidores d
                 where d.idrepresentante = :P75_IDREPRESENTANTE
                   and d.idfilial        = :P75_IDFILIAL
                   and d.cicloromance    = (select s.cicloromance from semana_dias s
                                             where s.semanacompleta = :P75_SEMANA)
                   and nvl(d.desafiocalculadoatual,0) > 0
                ```
        }
    )

    region despesas-incluídas-na-semana (
        name: Despesas Incluídas na Semana
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddespesa
                     , d.idfechamentorepres
                     , initcap(c.nomeconta) Conta
                     , pck_romance.fnc_nomesubcontafinan( IDSUBCONTACONTABIL) SubConta
                     , d.observacao
                     , d.semana
                     , d.valor
                from despesas d
                   , contasfinanceiras      c
                where d.idfechamentorepres = :P75_IDFECHAMENTOREPRES
                  and d.idcontacontabil = c.idcontafinan
                ```
        }
        layout {
            sequence: 180
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
