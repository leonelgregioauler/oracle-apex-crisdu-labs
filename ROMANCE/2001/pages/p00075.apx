            function listaconsultorasnaorenovadas() {
                var vurl = $v("P75_URL_CONSULTORAS_NAO_RENOVADAS");
            
                if (!vurl) {
                    apex.message.alert(
                        "O representante e a semana precisam estar preenchidos."
                    );
                    return;
                }
            
                apex.navigation.dialog(
                vurl,
                {
                    title: "Consultoras não renovadas",
                    height: 600,
                    width: 800,
                    maxWidth: 1200,
                    modal: true,
                    resizable: true
                },
                "t-Dialog-page--standard",
                "#P75_QTDCONSULTORASNAORENOVADAS"
               );
            }
