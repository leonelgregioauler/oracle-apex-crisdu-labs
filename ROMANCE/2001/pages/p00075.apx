    button delete (
        buttonName: DELETE
        label: Excluir Acerto
        layout {
            sequence: 100
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente excluir o acerto?','DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where nvl(f.concluido,'N') = 'N'
                  and f.idfechamento       = :P75_IDFECHAMENTO
                  and f.idfilial           = :P0_IDFILIAL
                  and :P75_IDFECHAMENTOREPRES is not null
                  and exists ( select 1
                               from usuariosgruposatendimento ug
                               where ug.usuario = v('APP_USER')
                                 and ug.idgrupoatendimento in (0,2) )
                union             
                select 1
                from fechamentossemanais f
                where nvl(f.concluido,'N') = 'N'
                  and f.idfechamento       = :P75_IDFECHAMENTO
                  and f.idfilial           = :P0_IDFILIAL
                  and :P75_IDFECHAMENTOREPRES is not null
                  and exists ( select 1
                               from catal.usuarios u 
                               where u.ativo = 'S'
                                 and u.idgerente = 21 
                                 and u.usuario = v('APP_USER')) --somente canoas ticket 13744400
                ```
        }
    )

