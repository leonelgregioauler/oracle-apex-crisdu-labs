    pageItem P75_COMISSAOPAGA_NEGPAR (
        type: numberField
        label {
            label: <font color="BLUE">Comis. Paga Negociações</font>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @negociações-cobraki
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 10
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vvalor  number(15,2);
                begin  
                  --
                  select sum(pg.valorpago)
                  into vvalor
                  from pagamentoscomissoesnegociacoes pg
                  where pg.idrepresentante    = :P75_IDREPRESENTANTE
                    and pg.idfechamentorepres = :P75_IDFECHAMENTOREPRES
                    and pg.tipopagamento      = 'R'
                    and exists ( select 1
                                 from negociacoesparceiros np
                                 where np.idnegociacaoparceiro = pg.idnegociacaoparceiro
                                   and np.origem               = 'C' );
                  --
                  return to_char(vvalor,'999G999G999G990D00');
                  --
                exception
                  when others then
                    return 0;
                end;
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0.00
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

