    validation p75-idfechamentopontuacao (
        name: P75_IDFECHAMENTOPONTUACAO
        execution {
            sequence: 40
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentorepresentantes f
                where f.idfechamentorepres != :P75_IDFECHAMENTOREPRES
                  and f.idfechamentopontuacao = :P75_IDFECHAMENTOPONTUACAO
                  and f.idrepresentante = :P75_IDREPRESENTANTE
                ```
        }
        error {
            errorMessage: Este representante já tem um acerto referente a esta semana!
            associatedItem: @P75_IDFECHAMENTOPONTUACAO
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation p75-idregiaovenda (
        name: P75_IDREGIAOVENDA
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P75_IDREGIAOVENDA
        }
        error {
            errorMessage: Região deve ser informada!
            associatedItem: @P75_IDREGIAOVENDA
        }
        serverSideCondition {
            type: never
        }
    )

    validation p75-idrepresentante (
        name: P75_IDREPRESENTANTE
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P75_IDREPRESENTANTE
        }
        error {
            errorMessage: Representante deve ser informado!
            associatedItem: @P75_IDREPRESENTANTE
        }
    )

    validation valida-deletar (
        name: valida deletar
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where not exists ( select *
                                   from depositosdiarios_orig d
                                   where d.idfechamentorepres = :P75_IDFECHAMENTOREPRES )
                  and not exists ( select *
                                   from despesas d
                                   where d.idfechamentorepres = :P75_IDFECHAMENTOREPRES )
                ```
        }
        error {
            errorMessage: O acerto só pode ser excluído quando estiver zerado!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    validation valida-inclusão-de-acerto (
        name: Valida Inclusão de Acerto
        execution {
            sequence: 50
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentorepresentantes f
                where f.idrepresentante       = :P75_IDREPRESENTANTE
                  and f.semana                = :P75_SEMANA
                  and f.idfechamentopontuacao = :P75_IDFECHAMENTOPONTUACAO
                  and f.idfechamento          = :P75_IDFECHAMENTO
                ```
        }
        error {
            errorMessage: Este Distribuidor já possui um acerto criado para esta semana!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process atualiza (
        name: atualiza
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidfechamento number;
                begin
                  --
                  if :P75_IDFECHAMENTOREPRES is not null then -- id adicionado no ticket 13862419
                      --
                      pck_acertosfechamento.prc_buscacobranca( :P75_IDFECHAMENTOREPRES );
                      pck_acertosfechamento.prc_atualiza_acerto ( :P75_IDFECHAMENTOREPRES );
                      --
                      select idfechamento
                      into vidfechamento
                      from FECHAMENTOREPRESENTANTES
                      where idfechamentorepres = :P75_IDFECHAMENTOREPRES;
                      --
                      pck_acertosfechamento.prc_atualiza_gavetas ( vidfechamento );
                      --
                      commit;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 51
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 157169971813207708
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select * 
                from fechamentossemanais f
                where nvl(f.concluido,'N') = 'N'
                  and f.idfilial = pck_romance.fnc_filialusuario(v('APP_USER'))
                  and f.idfechamento = ( select idfechamento --/*pontuacao*/
                                         from fechamentorepresentantes
                                         where idfechamentorepres = :P75_IDFECHAMENTOREPRES ) 
                ```
        }
    )

    process atualiza-depósitos (
        name: Atualiza Depósitos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_acertosfechamento.prc_confirmadepositos(pidfechamentorepres => :P75_IDFECHAMENTOREPRES
                                                             ,pusuario => :P0_USUARIO);
                end;
                ```
        }
        execution {
            sequence: 41
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 2976761179023724312
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from parametros p
                where p.nome = 'CONFIRMADEPOSITOSAUTOMATICO' 
                  and p.valor = 'S'
                  and p.idfilial = :P0_IDFILIAL  
                  and :P75_IDREPRESENTANTE != 3358
                  and ( select g.idfilial
                        from gerentes g
                           , usuarios u
                        where g.idgerente = u.idgerente
                          and u.usuario = v('APP_USER') ) = :P0_IDFILIAL
                ```
        }
    )

    process atualiza-saldos (
        name: atualiza saldos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidrep number;
                  vidfechamentoinicio  number;
                  vidfilial   number := nvl(:P0_IDFILIAL,pck_romance.fnc_filialusuario(v('APP_USER')));
                begin
                  --
                  begin
                    select idfechamento
                    into vidfechamentoinicio
                    from fechamentossemanais
                    where idfilial = vidfilial
                      and semana   = '30/2018';
                   exception
                     when others then
                       select min(idfechamento)
                       into vidfechamentoinicio
                       from fechamentossemanais
                       where idfilial = vidfilial;
                   end;
                   --
                   if :P75_IDFECHAMENTOREPRES is not null then -- if adicionado no ticket 13862419
                     --
                     select idrepresentante
                       into vidrep
                       from fechamentorepresentantes 
                      where idfechamentorepres  = :P75_IDFECHAMENTOREPRES;
                      --
                      for a in ( select ff.idfechamentorepres
                                 from fechamentorepresentantes ff
                                 where ff.idrepresentante = vidrep
                                   and ff.idfechamentopontuacao >= vidfechamentoinicio 
                                 order by 1)
                      loop
                        --
                       --pck_acertosfechamento.prc_buscacobranca( a.idfechamentorepres );
                        pck_acertosfechamento.prc_atualiza_acerto(a.idfechamentorepres);
                        --
                      end loop;
                      --
                      commit;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 1
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 605536258171536291
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P75_IDFECHAMENTOREPRES
        }
    )

    process bloqueia-desbloqueia-comissão (
        name: "Bloqueia/Desbloqueia Comissão "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    v_bloqueado_comissao varchar2(1); -- Variável para armazenar o status de bloqueio da comissão
                begin
                    -- Busca o status de bloqueio da comissão
                    select nvl(r.bloqueadocomissao,'N')
                    into v_bloqueado_comissao
                    from catal.representantes r
                    where r.idrepresentante = :P75_IDREPRESENTANTE;
                    
                    -- Atualiza o status de bloqueio da comissão
                    update catal.representantes r
                    set r.bloqueadocomissao = decode(v_bloqueado_comissao, 'N', 'S', 'N')
                    where r.idrepresentante = :P75_IDREPRESENTANTE;
                
                    -- Confirma as alterações feitas na transação
                    commit;
                
                    -- Exibe uma mensagem de sucesso com base no status de bloqueio
                    if v_bloqueado_comissao = 'N' then
                        apex_application.g_print_success_message := 
                            '<span style="color: white;">Processo de Bloqueio realizado com sucesso! Lucro do Distribuidor está Bloqueado.</span>';
                    else
                        apex_application.g_print_success_message := 
                            '<span style="color: white;">Processo de Desbloqueio realizado com sucesso! Lucro do Distribuidor está Desbloqueado.</span>';
                    end if;
                
                    -- Exceção para captura de erros
                exception
                    when others then
                        -- Adiciona um erro customizado com detalhes do erro para o usuário
                        apex_error.add_error(
                            p_message => 'Ops! Ocorreu um erro no processo (Bloqueia/Desbloqueia Comissão). Erro: ' || SQLERRM || ' - Código: ' || SQLCODE,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                end;
                ```
        }
        execution {
            sequence: 100
        }
        advanced {
            executionMappingIdentifier: 378504107913702908
        }
        serverSideCondition {
            whenButtonPressed: @bloquear-desbloquear-comissao
        }
        comments {
            comments: Criado em 20/03/2025 - Maicon Aimi - 9233332
        }
    )

