    pageItem P75_MSGCHEQUES (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 80
            region: @romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 'Este distribuidor tem R$ '||trim(to_char(sum(valor),'999G999G990D00'))||' de cheques sem fundo.' a 
                from ( select sum(c.VALOR ) valor
                        from CHEQUES2 c
                        where c.semfundo = 'S'
                          and nvl(c.chequepredatado,'N') = 'N'
                          and nvl(c.emprestimo,'N') = 'N'
                          and c.idrepresentante = :P75_IDREPRESENTANTE
                        having c.valor > ( select nvl(sum(p.valor),0) from cheques2pgto p where p.idcheque = c.idcheque )
                        group by c.idcheque ,c.valor );
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from ( select sum(c.VALOR ) valor
                        from CHEQUES2 c
                        where c.semfundo = 'S'
                          and nvl(c.chequepredatado,'N') = 'N'
                          and nvl(c.emprestimo,'N') = 'N'
                          and c.idrepresentante = :P75_IDREPRESENTANTE
                        having c.valor > ( select nvl(sum(p.valor),0) from cheques2pgto p where p.idcheque = c.idcheque )
                        group by c.idcheque ,c.valor );
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

