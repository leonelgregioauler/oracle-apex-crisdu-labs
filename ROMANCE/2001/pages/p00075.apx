        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 'A(s) consultora(s) '||listagg(pck_romance.fnc_nomevendedora(idvendedora),' ') within group ( order by 1 desc )||' possui nota distribuida com outro Distribuidor' data
                from notasvendas n
                where n.idrepresentante = :P75_IDREPRESENTANTE
                  and n.semanadistribuicao = :P75_SEMANA
                  and exists ( select 1
                               from notasvendas nn
                               where nn.idvendedora = n.idvendedora
                                 and nn.semanadistribuicao = n.semanadistribuicao
                                 and nn.idrepresentante != n.idrepresentante)
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from notasvendas n
                where n.idrepresentante = :P75_IDREPRESENTANTE
                  and n.semanadistribuicao = :P75_SEMANA
                  and exists ( select 1
                               from notasvendas nn
                               where nn.idvendedora = n.idvendedora
                                 and nn.semanadistribuicao = n.semanadistribuicao
                                 and nn.idrepresentante != n.idrepresentante) 
                ```
        }
        security {
            encryptSessionState: false
        }
    )

