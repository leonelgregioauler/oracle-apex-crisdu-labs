    pageItem P75_ACESSOAPPSEMANA (
        type: textField
        label {
            label: Acessos Consultoras APP
            alignment: left
        }
        layout {
            sequence: 430
            region: @romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select x.qtdacesso||' / '||( select count(vv.idvendedora)
                                             from catal.vendedoras vv
                                             where vv.idrepresentante = :P75_IDREPRESENTANTE
                                               and vv.ativo = 'S'
                                               and exists ( select 1
                                                            from roman.notasvendas nv
                                                            where nv.idvendedora = vv.idvendedora
                                                              and nv.idsituacaonotavenda = 3)) qtdunico
                from ( select count(distinct v.idvendedora) qtdacesso
                       from roman.registrosloginminhasacola r
                          , catal.vendedoras v 
                       where v.idvendedora = r.idvendedora 
                         and r.datalogin between ( select to_date(ss.dt_ini||' 00:00:00', 'dd/mm/rrrr hh24:mi:ss') from roman.semana_dias ss where ss.idsemana = r.idsemana )  
                                             and ( select to_date(ss.dt_fim||' 23:59:59', 'dd/mm/rrrr hh24:mi:ss') from roman.semana_dias ss where ss.idsemana = r.idsemana )   
                         and r.idsemana = ( select ff.idsemana
                                            from roman.fechamentossemanais ff
                                            where ff.idfechamento = :P75_IDFECHAMENTOPONTUACAO)  
                         and exists ( select 1
                                      from catal.gerentes g
                                         , catal.representantes rr
                                      where g.idgerente = rr.idgerente
                                        and rr.idrepresentante = v.idrepresentante
                                        and rr.idrepresentante = :P75_IDREPRESENTANTE 
                                        and g.idfilial = :P75_IDFILIAL ) ) x
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

