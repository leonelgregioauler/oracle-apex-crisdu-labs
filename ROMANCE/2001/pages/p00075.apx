    process calcula-desafios-do-acerto (
        name: Calcula desafios do acerto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Calcula o HTML dos desafios ANTES de desenhar as regioes. Os cabecalhos
                -- das regioes usam os itens P75_MSGDESAFIO* e sao impressos antes dos itens
                -- da propria regiao: com o calculo no item, o cabecalho mostrava o valor
                -- em sessao do acerto aberto antes (06/10/2026: dados da Adria em todos).
                begin
                  begin
                    select q.msg into :P75_MSGDESAFIOFAV from (
                with d as (
                select case when to_number(to_char(b.dt,'DD')) between 1 and 5
                            then add_months(trunc(b.dt,'MM'),-1) else trunc(b.dt,'MM') end dtref
                     , case when to_number(to_char(b.dt,'DD')) between 1 and 5 then 'S' else 'N' end ant
                     , trunc(b.dt,'MM') dtmes
                  -- dia de hoje (nao a data do acerto): de 01 a 05 vale o mes anterior
                  from (select trunc(sysdate) dt from dual) b
                ), g as (
                select d.dtref, d.ant
                     , to_char(d.dtref,'MM/YYYY') mesref
                     , to_char(d.dtmes,'MM/YYYY') mesacerto
                     , to_number(to_char(last_day(d.dtref),'DD')) dm
                     , least(greatest(trunc(sysdate)-d.dtref+1,1)
                            ,to_number(to_char(last_day(d.dtref),'DD'))) dc
                     , sum(nvl(coalesce(e.valordesafioajustado2
                                       ,e.valordesafioajustado
                                       ,e.valordesafio),0)) des
                  from d, favorita.engajamentosrepresentantes e
                 where e.datareferencia  = d.dtref
                   and e.idrepresentante = :P75_IDREPRESENTANTE
                   and e.idfilial        = :P75_IDFILIAL
                 group by d.dtref, d.ant, d.dtmes
                ), r as (
                select g.*
                     , round(g.des / g.dm * g.dc, 2) id
                     , round(g.dc / g.dm * 100) pi
                     , nvl((select round(sum(nvl(p.valorapagarfavorita,0)),2)
                              from favorita.vw_rank_pedidos_dist p
                             where p.idrepresentante = :P75_IDREPRESENTANTE
                               and trunc(p.dataemissao)
                                   between g.dtref and least(trunc(sysdate),last_day(g.dtref))),0) rea
                  from g
                 where g.des > 0
                ), x as (
                select r.*
                     , r.des - r.rea fa
                     , round(r.rea / nullif(r.des,0) * 100) pc
                     , least(round(r.rea / nullif(r.des,0) * 100),100) pb
                  from r
                )
                select '<div class="df'||case when x.ant='S' then ' df--ant' end||'">'
                ||'<div class="df-top"><span class="df-badge"><span class="fa '
                ||case when x.ant='S' then 'fa-calendar' else 'fa-bullseye' end||'"></span> '
                ||case when x.ant='S'
                       then 'DESAFIO ANTERIOR - '||x.mesref||' (o desafio de '||x.mesacerto||' ainda nao foi lancado)'
                       else x.mesref||case when x.fa>0 then ' - FALTA '||trim(to_char(x.fa,'999G999G990D00'))
                                           else ' - ATINGIDO' end end
                ||'</span><span class="df-perc'||case when x.fa<=0 then ' df-ok' end||'">'
                ||trim(to_char(x.pc))||'%</span></div><div class="df-cards">'
                ||'<div class="df-card"><span class="df-lab">Desafio</span><span class="df-val">'
                ||trim(to_char(x.des,'999G999G990D00'))||'</span></div>'
                ||'<div class="df-card df-ideal"><span class="df-lab">Ideal '
                ||case when x.ant='S' then 'do mes' else 'ate hoje' end||'</span><span class="df-val">'
                ||trim(to_char(x.id,'999G999G990D00'))||'</span></div>'
                ||'<div class="df-card"><span class="df-lab">Realizado</span><span class="df-val'
                ||case when x.rea>=x.id then ' df-ok' end||'">'
                ||trim(to_char(x.rea,'999G999G990D00'))||'</span></div>'
                ||'<div class="df-card"><span class="df-lab">'
                ||case when x.fa>0 then 'Falta atingir' else 'Resultado' end||'</span><span class="df-val'
                ||case when x.fa<=0 then ' df-ok' end||'">'
                ||case when x.fa>0 then trim(to_char(x.fa,'999G999G990D00')) else 'Atingido' end
                ||'</span></div></div>'
                ||'<div class="df-bar"><span class="'||case when x.fa<=0 then 'df-ok' end
                ||'" style="width:'||trim(to_char(x.pb))||'%"></span>'
                ||'<i class="df-mark" style="left:'||trim(to_char(x.pi))||'%"></i></div>'
                ||'<span class="df-cap">Periodo '||to_char(x.dtref,'DD/MM/RRRR')||' a '
                ||to_char(last_day(x.dtref),'DD/MM/RRRR')||' - marca na barra = ideal ate hoje ('
                ||trim(to_char(x.pi))||'% do mes)</span></div>' msg
                  from x
                    ) q where rownum = 1;
                  exception
                    when no_data_found then :P75_MSGDESAFIOFAV := null;
                  end;
                  begin
                    select q.msg into :P75_MSGDESAFIOROM from (
                with c as (
                select s.cicloromance cic, s.semana sem
                     , (select count(*) from semana_dias where cicloromance = s.cicloromance) tot
                     , (select max(dt_fim) from semana_dias where cicloromance = s.cicloromance) fim
                     , (select count(*) from semana_dias
                         where cicloromance = s.cicloromance and idsemana <= s.idsemana) pos
                  from semana_dias s
                 where s.semanacompleta = :P75_SEMANA
                ), k as (
                select c.*
                     , case when trunc(sysdate) > c.fim then c.tot
                            else greatest((select count(*) from semana_dias
                                            where cicloromance = c.cic and dt_fim <= trunc(sysdate)),1)
                       end enc
                     , (select count(*) from semana_dias
                         where cicloromance = c.cic and dt_fim > trunc(sysdate)) rest
                  from c
                ), m as (
                select k.*
                     , nvl((select sum(d.desafiocalculadoatual)
                              from metasdesafiodistribuidores d
                             where d.cicloromance    = k.cic
                               and d.idrepresentante = :P75_IDREPRESENTANTE
                               and d.idfilial        = :P75_IDFILIAL),0) des
                     , nvl((select sum(fr.totalgeral)
                              from fechamentossemanais f, fechamentorepresentantes fr
                             where fr.idfechamento     = f.idfechamento
                               and fr.idrepresentante  = :P75_IDREPRESENTANTE
                               and f.idsemana in (select idsemana from semana_dias
                                                   where cicloromance = k.cic)),0) rea
                  from k
                ), x as (
                select m.*
                     , m.des - m.rea fa
                     , round(m.des / nullif(m.tot,0) * m.enc, 2) id
                     , round(m.rea / nullif(m.des,0) * 100) pc
                     , case when m.rest = 0 or m.des - m.rea <= 0 then 0
                            else round((m.des - m.rea) / m.rest, 2) end fps
                  from m
                 where m.des > 0
                )
                select '<div class="dr"><div class="df-top"><span class="df-badge dr-badge">'
                ||'<span class="fa fa-th-large"></span> CICLO '||x.cic||' - SEMANA '||x.sem||', '
                ||trim(to_char(x.pos))||'a DE '||trim(to_char(x.tot))
                ||case when x.fa>0 then ' - FALTA '||trim(to_char(x.fa,'999G999G990D00')) else ' - ATINGIDO' end
                ||'</span><span class="df-perc dr-perc'||case when x.fa<=0 then ' df-ok' end||'">'
                ||trim(to_char(x.pc))||'%</span></div><div class="df-cards">'
                ||'<div class="df-card dr-card"><span class="df-lab dr-lab">Desafio do ciclo</span>'
                ||'<span class="df-val dr-val">'||trim(to_char(x.des,'999G999G990D00'))||'</span></div>'
                ||'<div class="df-card dr-card df-ideal"><span class="df-lab dr-lab">Ideal ate o momento</span>'
                ||'<span class="df-val dr-val">'||trim(to_char(x.id,'999G999G990D00'))||'</span></div>'
                ||'<div class="df-card dr-card"><span class="df-lab dr-lab">Realizado no ciclo</span>'
                ||'<span class="df-val dr-val'||case when x.rea>=x.id then ' df-ok' end||'">'
                ||trim(to_char(x.rea,'999G999G990D00'))||'</span></div>'
                ||'<div class="df-card dr-card"><span class="df-lab dr-lab">'
                ||case when x.fa>0 then 'Falta atingir' else 'Resultado' end||'</span>'
                ||'<span class="df-val dr-val'||case when x.fa<=0 then ' df-ok' end||'">'
                ||case when x.fa>0 then trim(to_char(x.fa,'999G999G990D00')) else 'Atingido' end||'</span></div>'
                ||'<div class="df-card dr-card"><span class="df-lab dr-lab">Falta por semana</span>'
                ||'<span class="df-val dr-val">'||trim(to_char(x.fps,'999G999G990D00'))||'</span></div>'
                ||'</div></div>' msg
                  from x
                    ) q where rownum = 1;
                  exception
                    when no_data_found then :P75_MSGDESAFIOROM := null;
                  end;
                  begin
                    select q.msg into :P75_MSGDESAFIOROMSEM from (
                with c as (
                select s.cicloromance cic from semana_dias s
                 where s.semanacompleta = :P75_SEMANA
                ), w as (
                select sd.idsemana ids, sd.semana sem, sd.dt_ini ini, sd.dt_fim fim, c.cic
                     , nvl((select sum(d.mediasemanal)
                              from metasdesafiodistribuidores d
                             where d.cicloromance    = c.cic
                               and d.idrepresentante = :P75_IDREPRESENTANTE
                               and d.idfilial        = :P75_IDFILIAL),0) med
                     , case when sd.semanacompleta = :P75_SEMANA then 'S' else 'N' end agora
                     , nvl((select sum(fr.totalgeral)
                              from fechamentossemanais f, fechamentorepresentantes fr
                             where fr.idfechamento    = f.idfechamento
                               and fr.idrepresentante = :P75_IDREPRESENTANTE
                               and f.idsemana         = sd.idsemana),0) rea
                  from c, semana_dias sd
                 where sd.cicloromance = c.cic
                )
                select '<div class="dr-weeks">'
                ||listagg('<div class="dr-w'||case when w.agora='S' then ' dr-now' end||'">'
                  ||'<span class="dr-wnow">'||case when w.agora='S' then 'Este acerto' else '&nbsp;' end||'</span>'
                  ||'<div class="dr-wbar"><i class="'||case when w.med>0 and w.rea>=w.med then 'dr-full' end
                  ||'" style="width:'||trim(to_char(nvl(least(round(w.rea/nullif(w.med,0)*100),100),0)))
                  ||'%"></i></div><div class="dr-wlab"><span>Sem '||w.sem||'</span><span>'
                  ||case when w.rea>0 then trim(to_char(w.rea,'999G999G990'))
                         else '<i class="dr-sv">sem valor</i>' end
                  ||'</span></div></div>','') within group (order by w.ids)
                ||'</div><span class="df-cap">Ciclo '||max(w.cic)||' - '||to_char(min(w.ini),'DD/MM/RRRR')
                ||' a '||to_char(max(w.fim),'DD/MM/RRRR')||' - meta semanal '
                ||trim(to_char(max(w.med),'999G999G990D00'))||' - ideal por '
                ||trim(to_char(least(greatest(sum(case when w.fim <= trunc(sysdate) then 1 else 0 end),1),count(*))))
                ||' semanas encerradas de '||trim(to_char(count(*)))||'</span>' msg
                  from w
                    ) q where rownum = 1;
                  exception
                    when no_data_found then :P75_MSGDESAFIOROMSEM := null;
                  end;
                end;
                ```
        }
        execution {
            sequence: 5
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 9911750002075005
        }
    )

