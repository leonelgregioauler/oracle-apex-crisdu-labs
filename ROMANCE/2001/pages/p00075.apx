                ```plsql
                declare
                  vvalor   number(15,2);
                  vidsemana number := pck_util.fnc_idsemana(:P75_SEMANA);
                begin  
                
                  -- comissoes pagas
                  select sum(valorcomissaorep)
                  into vvalor
                  from pagamentoscomissoesecom p
                  where p.idfechamentorep = :P75_IDFECHAMENTOREPRES 
                --  where p.idsemana         = vidsemana -- aqui é a semana de geração do crédito, e não de pagamento
