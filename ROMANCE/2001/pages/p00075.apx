    region débitos-pendentes-nesta-semana (
        name: Débitos Pendentes Nesta Semana
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.numeronota nrpedido
                     , nv.semanacobranca semana
                     , pck_romance.fnc_nomerepresentante(nv.idrepresentante) representante
                     , pck_romance.fnc_nomevendedora(nv.idvendedora) nomevendedora
                     , nv.valortotalvendalqd valor
                     , nv.valorpago valorpago
                     , saldo
                     , pck_romance.fnc_nomefilial(nv.idfilial) filial
                     , ( select max(trunc(pn.datapagamento))
                         from pagamentosnotasvendas pn
                         where pn.idnotavenda = nv.idnotavenda ) ultimopagamento
                     , pck_romance.fnc_cpfvendedora(nv.idvendedora) cpf
                     , idnotavenda
                     , idrepresentante 
                     , pck_romance.fnc_retornatelefones(nv.idvendedora) telefones 
                     , ( select nroconsultaspc
                         from pessoas
                         where idpessoa = ( select idpessoa 
                                             from vendedoras 
                                             where idvendedora = nv.idvendedora ) ) "Consulta SPC"
                     , ( select decode(v.ativo,'S','Ativa','N','Inativa')
                         from vendedoras v
                         where v.idvendedora = nv.idvendedora ) situacao
                from notasvendas nv
                where nv.saldo > 0
                  and nv.idrepresentante = :P75_IDREPRESENTANTE 
                  and nv.idsituacaonotavenda = 4
                  and nv.idrepresentanteatende is null
                  and nv.idfilial = :P0_IDFILIAL
                  and nv.semanacobranca = :P75_SEMANA
                ```
        }
        layout {
            sequence: 190
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <br>
                <br>
                <b>Este relatório mostra o saldo atual das notas que geraram débito nesta semana de acerto.</b>
                <br>
                ```
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: Nenhum pepino aberto para este promotor.
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
            linkText: Download para CSV
        }

