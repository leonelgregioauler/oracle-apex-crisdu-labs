    button integrar-dtemite (
        buttonName: INTEGRAR_DTEMITE
        label: Enviar DTEMITE
        layout {
            sequence: 1030
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual 
                 where exists (select 1
                                 from vw_itensnotavenda_dtemite it
                                where it.idrepresentante = :P75_IDREPRESENTANTE
                                  and it.semanacobranca  = ( select semana
                                                               from fechamentossemanais 
                                                              where idfechamento = (select idfechamentopontuacao
                                                                                      from fechamentorepresentantes
                                                                                      where idfechamentorepres = :P75_IDFECHAMENTOREPRES))
                                  and it.qtyitem > 0
                                  and exists (select 1
                                                from notasvendas a
                                               where a.idnotavenda = it.idnotavenda
                                                 and a.idsituacaonotavenda = 4
                                                 and nvl(a.dtemite,'E') = 'E' ));
                ```
        }
    )

