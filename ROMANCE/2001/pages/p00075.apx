        layout {
            sequence: 10
            region: @romance
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from fechamentorepresentantes f
                         where f.idfechamentorepres = :P75_IDFECHAMENTOREPRES
                           and f.datafinalizado     is null
                           and f.usuariofinalizou   is null ) and :P0_IDFILIAL in (140,100)
