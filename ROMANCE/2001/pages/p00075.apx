    pageItem P75_PAGAMENTOS_REPETIDOS (
        type: displayOnly
        label {
            label: Notas C/ Pagamento Repetido(*)
            alignment: left
        }
        layout {
            sequence: 460
            region: @romance
            slot: regionBody
            alignment: left
            startNewRow: false
            columnAttributes: [
                onclick="listapagamentosrepetidos()"
                readonly="readonly"
            ]
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select sum(qtd_duplicado)
                from ( select 0 qtd_duplicado  -- USado desta forma pois com o having não funcionava o nvl e não trazia zero na tela 
                       from dual
                       union
                       select count(x.qtd_duplicado) qtd_duplicado
                       from ( select roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) Distribuidor
                                   , roman.pck_romance.fnc_nomevendedora(nv.idvendedora) Consultora 
                                   , roman.pck_romance.fnc_cpfvendedora(nv.idvendedora) CPF
                                   , nv.valortotalvenda
                                   , pn.valorpago valor_duplicado
                                   , count(pn.valorpago) qtd_duplicado
                              from roman.notasvendas nv
                                 , roman.pagamentosnotasvendas pn 
                              where nv.idnotavenda = pn.idnotavenda
                                and nv.idfilial = :P75_IDFILIAL
                                and nv.idrepresentante = :P75_IDREPRESENTANTE
                                and pn.valorpago != 0
                                and pn.semanacobranca = :P75_SEMANA
                                and pn.origem = 'R' 
                              group by nv.idfilial, nv.idrepresentante, nv.idvendedora, nv.valortotalvenda, nv.idnotavenda, pn.valorpago
                              HAVING count(pn.valorpago) > 1 )x
                       group by x.Distribuidor
                )
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

