    pageItem P75_TOTALCOMISSOESFAVORITAGER (
        type: textField
        label {
            label: <font color="Purple">Comis. Paga Favorita Gerente.</font>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 110
            region: @favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 10
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(sum(valorpago),'999G999G990D00')
                from pagamentocomissoes p
                where p.fechamento = :P75_SEMANA
                  and p.idgerente = ( select idgerente
                                      from gerentes
                                      where idpessoa = ( select idpessoa
                                                         from representantes u
                                                         where u.idrepresentante = :P75_IDREPRESENTANTE ) )
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0,00
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from gerentes
                where idpessoa = ( select idpessoa
                                   from representantes u
                                   where u.idrepresentante = :P75_IDREPRESENTANTE )
                and 1 = 2
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

