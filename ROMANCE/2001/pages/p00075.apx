            customAttributes: style="background-color:#D62839; color:white; border: 1px solid #8B0000; border-radius: 4px; font-weight: bold; transition: 0.3s ease-in-out; box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);" onmouseover="this.style.backgroundColor='#A91021'; this.style.boxShadow='4px 4px 10px rgba(0, 0, 0, 0.5)'; this.style.transform='scale(1.05)';" onmouseout="this.style.backgroundColor='#D62839'; this.style.boxShadow='2px 2px 5px rgba(0, 0, 0, 0.2)'; this.style.transform='scale(1)';"
        }
