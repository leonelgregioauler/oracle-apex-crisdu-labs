                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction liberar-proxima-semana (
        name: liberar proxima semana
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P75_LIBERAPROXIMASEMANA
        }
        clientSideCondition {
            type: item=value
            item: P75_LIBERAPROXIMASEMANA
            value: S
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      -- Call the procedure
                      pck_acertosfechamento.prc_gravanotasliberasemana(pidfechamentorepres => :P75_IDFECHAMENTOREPRES);
                    end;
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: "javascript: { fnc_liberasemana(document.getElementById('P75_IDREPRESENTANTE').value,document.getElementById('P75_SEMANALIBERAR').value)};"
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

