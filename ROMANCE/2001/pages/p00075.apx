    pageItem P75_SESSION_ACERTADAS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 920
            region: @romance
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2001;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':165:'||l_session||'::NO:165:P165_IDREPRESENTANTE,P165_SEMANA:'||:P75_IDREPRESENTANTE||','||:P75_SEMANAPONTUACAO,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

