    button buscar-cobrança (
        buttonName: BUSCAR_COBRANÇA
        label: Buscar Cobrança
        layout {
            sequence: 60
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where nvl(f.concluido,'N') = 'N'
                  and f.idfechamento       = :P75_IDFECHAMENTO
                  and f.idfilial           = :P0_IDFILIAL
                  and :P75_IDFECHAMENTOREPRES is not null
                 /* and exists (select 1
                              from representantes
                              where idrepresentante = :P75_IDREPRESENTANTE
                                and usanetbook = 'S')*/
                ```
        }
    )

