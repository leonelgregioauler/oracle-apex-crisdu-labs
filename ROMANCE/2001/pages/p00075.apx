    region top-5-vendidos (
        name: Top 5 Vendidos (%)
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select link
                     , display
                     , value
                from (
                select null link
                     , produto display 
                     , sum(vendido) value
                from vw_percvendaprodutos t
                where idrepresentante  = :P75_IDREPRESENTANTE
                  and t.semanacobranca = ( select semana
                                           from fechamentossemanais
                                           where idfechamento  = :P75_IDFECHAMENTOPONTUACAO)
                having sum(vendido) > 0
                group by produto
                order by 3 desc)
                where rownum <=5
                order by 3
                ```
        }
        layout {
            sequence: 130
            slot: body
        }
