    pageItem P75_QTD_PEDIDOS_FAVORITA (
        type: numberField
        label {
            label: <font color="green">Qtd. Pedidos Favorita</font>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @pedidos-comissão-receber
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 10
        }
        validation {
            maxLength: 4000
        }
        advanced {
            customAttributes: readonly style="text-align: right;"
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vvalor   number;
                  vvalor2  number;
                  vvalor3  number;
                  vtotal  number;
                begin  
                  --
                  select count(t.idpedido)
                  into vvalor
                  from vw_comissoes_pagar t
                  where idrepresentante = :P75_IDREPRESENTANTE
                    and not exists ( select 1 
                                     from pagamentocomissoes pp
                                     where pp.idpedido  = t.idpedido 
                                       and pp.idrepresentante is not null);
                  --
                  select count(tf.idpedido)
                  into vvalor2
                  from favorita.VW_COMISSOESPAGAR_NOVA_M tf
                  where idrepresentante = :P75_IDREPRESENTANTE
                    and tf.tipopedido = 'P' -- Favorita T10278212
                    and exists ( select 1
                                 from controlepgtocomissoesped cp
                                 where cp.idpedido = tf.idpedido
                                   and cp.fechado_repres = 'N' )
                    and not exists ( select 1 
                                     from pagamentocomissoes pp
                                     where pp.idpedido  = tf.idpedido 
                                       and pp.idvencimentopedido = tf.idvencimentopedido
                                       and pp.idrepresentante is not null);
                  --
                  vtotal := nvl(vvalor,0) + nvl(vvalor2,0);
                  --
                  return (vtotal);
                  --
                end;
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

