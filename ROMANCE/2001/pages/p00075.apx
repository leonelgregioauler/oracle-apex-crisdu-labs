            ]
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(round( (sum(nv.valortotalvenda) / sum(nv.valortotalnota)) * 100),0) Percentual_Sacola
                from roman.notasvendas nv
                where  nv.semanacobranca = :P75_SEMANA 
                  and  nv.idsituacaonotavenda = 4
                  and  nv.idrepresentante = :P75_IDREPRESENTANTE
                ```
            used: always
