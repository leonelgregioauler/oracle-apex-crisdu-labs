    pageItem P75_MSGFAVORITAREPRES (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
            sendOnPageSubmit: false
        }
        layout {
            sequence: 30
            region: @favorita
            slot: regionBody
            alignment: left
            columnAttributes: onclick="listadebitosdistribuidor()"
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                -- (new) - 11087034 - Maicon Aimi - 28/10/2025
                select 'Há débito(s) de R$ '||trim(to_char(sum(case 
                         when b.origem = 'antigo' then
                           b.valoratualizado
                         else
                           (select pck_util.fnc_calculajuros_v2(p_valor_debito      => (p.saldodevedor-case when b.origem = 'novo' then 
                                                                                                        nvl(( select sum(vp.valorpagar) valor
                                                                                                              from favorita.vencimentospedidos vp
                                                                                                              where vp.idpedido = b.idboleto
                                                                                                                and vp.situacaovencimento = 'V'
                                                                                                                and vp.datavencimento >= TRUNC(sysdate)
                                                                                                                and vp.valorpago < vp.valorpagar
                                                                                                                and vp.valorpagar > 0 ),0) 
                                                                                                     else 
                                                                                                       0
                                                                                                     end),
                                                 p_data_venc         => p.datavencimentomenor,
                                                 p_data_calc         => sysdate,
                                                 p_idpais            => p.idpais)/*+case when b.origem = 'novo' then 
                                                                                                        nvl(( select sum(vp.valorpagar) valor
                                                                                                              from favorita.vencimentospedidos vp
                                                                                                              where vp.idpedido = b.idboleto
                                                                                                                and vp.situacaovencimento = 'V'
                                                                                                                and vp.datavencimento >= TRUNC(sysdate)
                                                                                                                and vp.valorpago < vp.valorpagar
                                                                                                                and vp.valorpagar > 0 ),0) 
                                                                                                     else 
                                                                                                       0
                                                                                                     end|*/
                           from favorita.vw_pedidos_fav_new p 
                           where p.idpedido = b.idboleto)
                       end),'999G999G999G999G990D00'))||' (Valor Atualizado) com a Favorita, referente a pedidos que o Distribuidor se responsabilizou. Veja mais detalhes na aba "Favorita".' d
                from roman.debitosdistribuidoresfav b
                where  b.idrepresentante = :P75_IDREPRESENTANTE
                  and nvl(b.valorpago,0) < b.valororiginal
                
                -- (old) - 11087034 - Maicon Aimi - 28/10/2025
                /*
                select 'Há débito(s) de R$ '||trim(to_char(fr.debitosfavoritaproprio,'999G999G999G999G990D00'))||' (Valor Atualizado) com a Favorita, referente a pedidos que o Distribuidor se responsabilizou. Veja mais detalhes na aba "Favorita".' d
                from fechamentorepresentantes fr
                where fr.idfechamentorepres = :P75_IDFECHAMENTOREPRES
                */
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                -- (new) - 11087034 - Maicon Aimi - 28/10/2025
                select 1 
                  from roman.debitosdistribuidoresfav b
                 where b.idrepresentante = :P75_IDREPRESENTANTE
                   and nvl(b.valorpago,0) < b.valororiginal
                
                -- (old) - 11087034 - Maicon Aimi - 28/10/2025
                /*
                select 1 
                from fechamentorepresentantes fr
                where fr.idfechamentorepres = :P75_IDFECHAMENTOREPRES
                  and fr.debitosfavoritaproprio > 0
                */
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

