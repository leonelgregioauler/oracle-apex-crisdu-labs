    pageItem P75_TOTAL_DISTRIBUIDO (
        type: textField
        label {
            label: Distribuído na Semana
            alignment: left
        }
        layout {
            sequence: 480
            region: @romance
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vvalor varchar2(100);
                  --
                begin
                  --
                  select to_char(nvl(sum(nv.valortotalnota),0),'999G999G999G999G999G999G999G990D00') distribuido
                  into vvalor
                  from roman.notasvendas nv
                  where  nv.semanadistribuicao = :P75_SEMANA 
                    and  nv.idsituacaonotavenda = 3
                    and  nv.idrepresentante = :P75_IDREPRESENTANTE;
                  --
                  return vvalor;
                  --
                exception
                  when others then
                    return 0;
                end;
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P75_TOTAL_LEADS_EFETIVADOS (
        type: displayOnly
        label {
            label: <span style="font-size:13px;">Quantidade total de Leads efetivados:</span>
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 20
            region: @span-style-font-size-24px-display-block-painel-de-leads-e-painel-de-inativas-span-span-style-font-size-14px-display-block-ações-feitas-pelo-distribuidor-na-semana-p75-periodo-semana-span
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 5
            columnAttributes: [
                onClick="javascript:chamaPagina556()"
                readonly
            ]
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                -- Pequeno gafanhoto! Atenção! Se ajustar essa query aqui na página 2001.75, é preciso replicar na query corespondente na página 2001.556 - Maicon Aimi - 10/10/2025 10276934
                select '<div><span style="color:#2F75B5; font-weight:bold; font-size:28px;"> ' || count(*) || ' </span></div>' as qtd
                from roman.controlecontatossite c,
                     roman.painelcontatossite p,
                     roman.fechamentorepresentantes vv,
                     roman.semana_dias sd,
                     catal.pessoas pe,
                     catal.vendedoras v
                where c.idcontrolecontatossite = p.idcontrolecontatossite
                  and vv.idfechamentorepres = :P75_idfechamentorepres
                  and sd.semanacompleta = vv.semana
                  and c.idrepresentante = :P75_idrepresentante
                  and v.idpessoa = pe.idpessoa
                  and (    (c.idpais = 1 AND c.cpf = pe.cpf)
                        or (c.idpais != 1 AND c.documentoestrangeiro = pe.documentoestrangeiro) )
                  and p.idsituacaopainel = 2
                  and trunc(p.datasituacao) between trunc(sd.dt_ini) and trunc(sd.dt_fim)
                  and trunc(v.datainclusao) between trunc(sd.dt_ini) and trunc(sd.dt_fim);
                ```
        }
    )

    pageItem P75_URL_CONSULTORAS_NAO_RENOVADAS (
        type: hidden
        layout {
            sequence: 1130
            region: @romance
            slot: regionBody
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                    IF :P75_IDREPRESENTANTE IS NULL OR :P75_SEMANA IS NULL THEN
                        RETURN NULL;
                    END IF;
                
                    RETURN APEX_PAGE.GET_URL(
                        p_page        => '288',
                        p_clear_cache => '288',
                        p_items       => 'P288_IDREPRESENTANTE,P288_SEMANA',
                        p_values      => :P75_IDREPRESENTANTE || ',' || :P75_SEMANA,
                        p_plain_url   => TRUE
                    );
                END;
                ```
        }
    )

