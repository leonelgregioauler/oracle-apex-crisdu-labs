    pageItem P75_MSG_PEDIDOSENTREGUES (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 130
            region: @romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="blue"><h3>Este Distribuidor possui '||( select count(1)
                                                      from favorita.classificacoespedidos c
                                                      where c.idcaracteristicapedido = 75
                                                        and pck_util.fnc_idsemanadata(c.dataclassificado) = pck_util.fnc_idsemana(:P75_SEMANA)
                                                        and exists ( select 1
                                                                     from favorita.pedidos p
                                                                     where p.idpedido = c.idpedido 
                                                                       and p.idrepresentante = :P75_IDREPRESENTANTE ) )||' pedido(s) não entregue(s) e '||( select count(1)
                                                                                                                                                          from favorita.classificacoespedidos c
                                                                                                                                                          where c.idcaracteristicapedido = 76
                                                                                                                                                            and pck_util.fnc_idsemanadata(c.dataclassificado) = pck_util.fnc_idsemana(:P75_SEMANA)
                                                                                                                                                            and exists ( select 1
                                                                                                                                                                         from favorita.pedidos p
                                                                                                                                                                         where p.idpedido = c.idpedido 
                                                                                                                                                                           and p.idrepresentante = :P75_IDREPRESENTANTE ) )||' pedido(s) entregue(s).</font>' display_value
                from dual
                where 1 = 2
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from parametrosrepresentantes r
                where r.idrepresentante = :P75_IDREPRESENTANTE
                  and r.parametro       = 'CONFIRMAENTREGAPEDIDOFAVORITA'
                  and r.valor           = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

