        layout {
            sequence: 20
            region: @comissões-ecommerce-distribuidor
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vvalor   number(15,2);
                begin
                
                  -- comissoes a receber
                  select sum(valorcomissaorep)
                    into vvalor
                  from PAGAMENTOSCOMISSOESECOM p
                     , notasvendas n
                 where n.idnotavenda       = p.idnotavenda
                   and p.idrepresentante   = :P75_IDREPRESENTANTE
                   and p.datapagamentorep  is null
                   and p.idfechamentorep   is null
                   and sysdate - n.datanota >= 7;
                /*    from pagamentoscomissoesecom p
                   where datapagamentorep is null 
                     and idrepresentante = :P75_IDREPRESENTANTE 
                     and exists ( select 1
                                  from notasvendas nv
                                  where nv.idnotavenda = p.idnotavenda
                                    and nv.datanota >= nv.datanota+7 );*/
                  --
                  return to_char(nvl(vvalor,0),'999G999G999G990D00');
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

