    region manutenções-à-pagar (
        name: Manutenções à pagar
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idmanutencao
                     , ( select e.numeroserie||' - '||e.nome
                         from equipamentos e
                         where e.idequipamento = m.idequipamento ) "Equipamento"
                     , s.descricao
                     , valorservico
                     , nvl(( select sum(p.valorpago)
                         from pagamentosmanutencoes p
                         where p.idmanutencao = m.idmanutencao ),0) "Valor Pago"
                     , valorservico
                     - nvl(( select sum(p.valorpago)
                         from pagamentosmanutencoes p
                         where p.idmanutencao = m.idmanutencao ),0) "Pendente"
                     , idrepresentante
                     , idchamado
                     , cobrar
                     , Motivo
                     , Cuidados
                     , null LINK
                     , :P75_IDFECHAMENTOREPRES IDFECHAMENTOREPRES
                     , m.datamanutencao
                from manutencoesrealizadas m
                   , servicosmanutencao s
                where m.idrepresentante = :P75_IDREPRESENTANTE
                  and s.idservicomanutencao = m.idservico
                  and nvl(m.cobrar,'S') = 'S'
                  and valorservico
                     - nvl(( select sum(p.valorpago)
                         from pagamentosmanutencoes p
                         where p.idmanutencao = m.idmanutencao ),0) >0
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from manutencoesrealizadas m
                where m.idrepresentante = :P75_IDREPRESENTANTE
                  and nvl(m.cobrar,'S') = 'S'
                  and valorservico
                     - nvl(( select sum(p.valorpago)
                         from pagamentosmanutencoes p
                         where p.idmanutencao = m.idmanutencao ),0) >0;
                ```
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        messages {
            whenNoDataFound: no data found
        }
        componentAdvanced {
            stripHtml: true
        }

