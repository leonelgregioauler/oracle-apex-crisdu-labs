            encryptSessionState: false
        }
    )

    pageItem P75_SALDOACERTO (
        type: numberField
        label {
            label: Deste Acerto(=)
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 730
            region: @romance
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 15
        }
        validation {
            maxLength: 4000
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(f.totalgeral - nvl(f.vlrespecie,0) 
                     - nvl(f.vlrcheque,0)
                     - nvl(f.totaldepositos,0)
                     - nvl(f.totaldepositoschq,0)
                     + nvl(f.valordevolvidoaorepres,0)
                     - nvl((select sum(valor)
                            from despesas r
                            where r.idfechamentorepres = f.idfechamentorepres ),0)
                     - f.vlrcomissao
                   /*  - nvl(f.totalcomissoesfavoritarepres,0)
                     - nvl((select sum(valorpago)
                            from pagamentocomissoes p
                            where p.idfechamentorepres = f.idfechamentorepres
                              and p.idgerente = ( select idgerente
                                                  from gerentes
                                                  where idpessoa = ( select idpessoa
                                                                     from representantes u
                                                                     where u.idrepresentante = f.idrepresentante ) )),0)*/,'999G999G999G999G990D00') saldo
                from fechamentorepresentantes F
                where idfechamentorepres = :P75_IDFECHAMENTOREPRES
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P75_SALDOANTERIOR (
        type: textField
        label {
            label: "Acerto anterior (+) "
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 720
            region: @romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G990D00
            width: 15
        }
        validation {
            maxLength: 4000
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select trim(to_char(f.saldo,'999G999G990D00')) valor
                from fechamentorepresentantes f
                where idfechamentorepres = ( select max(idfechamentorepres)
                                             from fechamentorepresentantes
                                             where idrepresentante     = :P75_IDREPRESENTANTE
                                                and idfechamentorepres < :P75_IDFECHAMENTOREPRES )
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0,00
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P75_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00')||'/'||ano) ||' ('||dt_ini||' a '||dt_fim||')' display_value
                     , trim(to_char(semana,'00')||'/'||ano) return_value
                from semana_dias s
                where ( :P75_SEMANA is null 
                      and trim(to_char(semana,'00')||'/'||ano) in ( select f.semana
                                                             from fechamentossemanais f
                                                             where f.concluido = 'N'
                                                               and f.idfilial = :P0_IDFILIAL ) ) 
                 or ( trim(to_char(semana,'00')||'/'||ano) = :P75_SEMANA )
                order by 1 desc
                ```
            displayNullValue: false
        }
        layout {
            sequence: 230
            region: @romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: SEMANA
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P75_SEMANA
        }
        security {
            encryptSessionState: false
        }
    )

