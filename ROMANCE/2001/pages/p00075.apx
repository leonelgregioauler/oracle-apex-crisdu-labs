    region depósitos-confirmados-neste-acerto (
        name: Depósitos Confirmados neste Acerto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select depdia.iddepositodiarios
                     , pck_romance.fnc_nomerepresentante(idrepresentante) Representante
                     , depdia.data  Data_deposito
                     , pck_cadastros_rmc.fnc_retornacontabancaria(depdia.idcontabanc) conta
                     , depdia.valordeposito Valor_depositado
                     , decode (depdia.tipo, 'DD','Depósito Dinheiro'
                                          , 'CR','Cheque Resgate'
                                          , 'CD','Cheque Cobrir'
                                          , 'CC','Depósito Cheque'
                                          , 'AS','Abate Saldo Fornecedor') tipo
                     , decode(depdia.comprovado,'S','Sem Comprovante'
                                               ,'C','Cópia'
                                               ,'M','Em Mãos'
                                               ,'G','Com Gerente') Comprovado
                     , depdia.nrocomprovante
                     , depdia.observacao
                     , nvl(( select count(1)
                             from depositosdiarios_leituraocr dr
                             where dr.iddepositodiario = depdia.iddepositodiarios ),0) qtdfotos
                from depositosdiarios_orig depdia
                where depdia.idfechamentorepres = :P75_IDFECHAMENTOREPRES
                
                ```
        }
        layout {
            sequence: 170
            slot: body
        }
        appearance {
            template: @/standard
