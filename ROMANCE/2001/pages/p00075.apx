    pageItem P75_IDREGIAOVENDA (
        type: selectList
        label {
            label: Região
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value
                     , return_value
                from ( select pck_romance.fnc_nomeregiaovenda(idregiaovenda) display_value
                            , idregiaovenda return_value
                       from regioesrepresentantes
                       where idrepresentante = :P75_IDREPRESENTANTE
                         and semana = ( select semana
                                        from fechamentossemanais df
                                        where df.idfechamento = :P75_IDFECHAMENTOPONTUACAO )
                       union
                       select pck_romance.fnc_nomeregiaovenda(idregiaovenda) display_value
                            , idregiaovenda return_value
                       from preacertorepresentantes p
                       where p.idrepresentante = :P75_IDREPRESENTANTE
                         and semana = ( select semana
                                        from fechamentossemanais df
                                        where df.idfechamento = :P75_IDFECHAMENTOPONTUACAO )
                         and rownum <= 1
                       union
                       select pck_romance.fnc_nomeregiaovenda(idregiaovenda) display_value
                            , idregiaovenda return_value
                       from regioesrepresentantes rr
                       where idrepresentante = :P75_IDREPRESENTANTE
                         and pck_romance.fnc_semanaciclo( semana ) = ( select semana
                                                                        from fechamentossemanais df
                                                                        where df.idfechamento = :P75_IDFECHAMENTOPONTUACAO )  
                       union
                       select pck_romance.fnc_nomeregiaovenda(idregiaovenda) display_value
                            , idregiaovenda return_value
                       from regioesvenda r
                       where r.idregiaovenda in ( select idregiaovenda
                                                  from regioesrepresentantes rr
                                                  where pck_romance.fnc_filialrepresentante(rr.idrepresentante) = :P0_IDFILIAL )
                         and exists ( select 1
                                      from gerentes g
                                         , representantes r
                                      where g.idpessoa = r.idpessoa
                                        and r.idrepresentante = :P75_IDREPRESENTANTE  ) )
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P75_IDFECHAMENTOPONTUACAO
                P75_IDREPRESENTANTE
            ]
        }
        layout {
            sequence: 240
            region: @romance
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
