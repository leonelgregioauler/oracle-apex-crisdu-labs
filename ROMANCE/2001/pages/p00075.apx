    css {
        inline:
            ```css
            .recorde-badge{
              display:inline-flex; align-items:center; gap:.4rem;
              padding:.3rem .8rem; border-radius:999px;
              font-weight:700; font-size:.8rem; color:#5c3d00;
              background:linear-gradient(135deg,#ffe27a 0%,#ffc93c 45%,#ffb703 100%);
              border:1px solid #e0a800;
              animation:recordePulse 1.8s ease-out infinite;
            }
            @keyframes recordePulse{
              0%  {box-shadow:0 0 0 0 rgba(255,183,3,.65)}
              70% {box-shadow:0 0 0 10px rgba(255,183,3,0)}
              100%{box-shadow:0 0 0 0 rgba(255,183,3,0)}
            }
            #P75_TOTALGERAL.is-recorde{
              background:#fff8e1 !important;
              border:2px solid #ffb703 !important;
              font-weight:700; color:#8a5a00 !important;
            }
            @media (prefers-reduced-motion: reduce){ .recorde-badge{animation:none} }
            
            .df{ margin:0 }
            .df-top{ display:flex; align-items:center; justify-content:space-between;
              gap:16px; flex-wrap:wrap }
            .df-badge{
              display:inline-flex; align-items:center; gap:.5rem;
              padding:.45rem 1.1rem; border-radius:999px;
              font-weight:700; font-size:1rem; color:#5c3d00;
              background:linear-gradient(135deg,#ffe27a 0%,#ffc93c 45%,#ffb703 100%);
              border:1px solid #e0a800;
            }
            .df--ant .df-badge{
              color:#0c447c;
              background:linear-gradient(135deg,#d7e8fa 0%,#b5d4f4 45%,#85b7eb 100%);
              border:1px solid #378add;
            }
            .df-perc{ font-size:2.4rem; font-weight:700; line-height:1; color:#b07d00 }
            .df--ant .df-perc{ color:#185fa5 }
            .df-perc.df-ok{ color:#3b6d11 }
            .df-cards{ display:flex; flex-wrap:wrap; gap:14px; margin-top:14px }
            .df-card{
              flex:1 1 0; min-width:170px;
              background:#fff8e1; border:1px solid #ffe0a3; border-radius:10px;
              padding:14px 18px;
            }
            .df--ant .df-card{ background:#eef5fd; border:1px solid #c7ddf6 }
            .df-card.df-ideal{ background:#fffdf3; border-style:dashed }
            .df--ant .df-card.df-ideal{ background:#f6faff; border-style:dashed }
            .df-lab{ display:block; font-size:.78rem; letter-spacing:.04em;
              text-transform:uppercase; color:#7a6a46; margin-bottom:2px }
            .df--ant .df-lab{ color:#4a6d92 }
            .df-val{ display:block; font-size:1.75rem; font-weight:700; color:#5c3d00 }
            .df--ant .df-val{ color:#0c447c }
            .df-val.df-ok{ color:#3b6d11 }
            .df-bar{ position:relative; height:14px; border-radius:999px; background:#f0e6cf;
              margin-top:14px; overflow:hidden }
            .df--ant .df-bar{ background:#dce9f7 }
            .df-bar span{ display:block; height:100%; background:#ffb703 }
            .df--ant .df-bar span{ background:#378add }
            .df-bar span.df-ok{ background:#639922 }
            .df-mark{ position:absolute; top:0; bottom:0; width:3px; margin-left:-1px;
              background:#5c3d00; border-radius:2px }
            .df--ant .df-mark{ background:#0c447c }
            .df-cap{ display:block; margin-top:8px; font-size:.82rem; color:#6b6b6b }
            
            .dr-badge{ color:#2d1c60; border:1px solid #6a4fbf;
              background:linear-gradient(135deg,#cdbdf5 0%,#a88ee8 45%,#8c6fdd 100%) }
            .dr-perc{ color:#5b3fb0 }
            .dr-perc.df-ok{ color:#3b6d11 }
            .dr-card{ background:#f4f0ff; border:1px solid #dcd0f7 }
            .dr-card.df-ideal{ background:#faf8ff; border-style:dashed }
            .dr-lab{ color:#5b4a86 }
            .dr-val{ color:#2d1c60 }
            .dr-val.df-ok{ color:#3b6d11 }
            .dr-weeks{ display:flex; gap:16px; margin-top:18px }
            .dr-w{ flex:1 1 0; min-width:0 }
            .dr-wbar{ position:relative; height:26px; border-radius:6px; background:#ece5fb;
              border:1px solid #dcd0f7; overflow:hidden }
            .dr-wbar i{ position:absolute; left:0; top:0; bottom:0; display:block; background:#8c6fdd }
            .dr-wbar i.dr-full{ background:#639922 }
            .dr-w.dr-now .dr-wbar{ border:2px solid #2d1c60; box-shadow:0 0 0 3px rgba(45,28,96,.12) }
            .dr-wlab{ display:flex; justify-content:space-between; font-size:.72rem;
              color:#5b4a86; margin-top:5px }
            .dr-w.dr-now .dr-wlab{ font-weight:700; color:#2d1c60 }
            .dr-wnow{ display:block; height:14px; margin-bottom:4px; font-size:.68rem;
              font-weight:700; color:#2d1c60; text-transform:uppercase; letter-spacing:.05em }
            .dr-sv{ font-style:normal; color:#a79ec2 }
            
            #P75_QTDCONSULTORASNAORENOVADAS,
            #P75_QTDCONSULTORASNAORENOVADAS * {
                cursor: pointer;
            }
            ```
    }
    security {
        authorizationScheme: @acesso-acertos
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region acompanhamento (
        name: Acompanhamento
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select link
                     , (decode(rownum,1,'A',2,'B',3,'C',4,'D',5,'E',6,'F',7,'G',8,'H',9,'I',10,'J')||' '||label) label 
                     , value "Notas Novas"
                from( select fr.idfechamentorepres link
                           , fr.semana label
                           , fr.qtdnotasnovas value
                      from fechamentorepresentantes fr
                      where fr.idrepresentante = :P75_IDREPRESENTANTE
                        and fr.idregiaovenda = nvl(:P75_IDREGIAOVENDA_1,:P75_IDREGIAOVENDA)
                      order by 1 desc )
                where rownum <= 10
                order by 1
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: link
        }
        layout {
            sequence: 10
            parentRegion: @atendimento-da-região
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: combination
        }
        title {
            title: Acompanhamento
        }
        chartLayout {
            maxWidth: 700
            height: 435
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            position: bottom
            hideAndShowBehavior: none
        }

        series cobrança (
            name: Cobrança
            type: line
            execution {
                sequence: 40
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select link
                         , (decode(rownum,1,'A',2,'B',3,'C',4,'D',5,'E',6,'F',7,'G',8,'H',9,'I',10,'J')||' '||label) label 
                         , value "Cobrança"
                    from( select fr.idfechamentorepres link
                               , fr.semana label
                               , fr.totalgeral value
                          from fechamentorepresentantes fr
                          where fr.idrepresentante = :P75_IDREPRESENTANTE
                            and fr.idregiaovenda = nvl(:P75_IDREGIAOVENDA_1,:P75_IDREGIAOVENDA)
                          order by 1 desc)
                    where rownum <= 10
                    order by 1
                    ```
            }
            columnMapping {
                label: LABEL
                value: "Cobrança"
            }
            appearance {
                assignedToY2Axis: true
            }
            label {
                show: true
            }
        )

        series nro-notas (
            name: Nro Notas
            type: line
            execution {
                sequence: 30
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: LABEL
                value: "Notas Novas"
            }
            label {
                show: true
                position: aboveMarker
            }
            performance {
                maxRowsToProcess: 15
            }
        )

        series venda (
            name: % Venda
            execution {
                sequence: 50
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select link
                         , (decode(rownum,1,'A',2,'B',3,'C',4,'D',5,'E',6,'F',7,'G',8,'H',9,'I',10,'J')||' '||label) label 
                         , value "% Venda"
                    from( select fr.idfechamentorepres link
                               , fr.semana label
                               , round( decode(nvl(fr.vlralvo,0), 0, 0, ((fr.totalgeral/(fr.vlralvo*2))*100) ),2) value
                          from fechamentorepresentantes fr
                          where fr.idrepresentante = :P75_IDREPRESENTANTE
                            and fr.idregiaovenda = nvl(:P75_IDREGIAOVENDA_1,:P75_IDREGIAOVENDA)
                          order by 1 desc)
                    where rownum <= 10
                    order by 1
                    
                    ```
            }
            columnMapping {
                label: LABEL
                value: "% Venda"
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            value {
                formatScaling: none
            }
            majorTicks {
                show: false
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: true
            }
        )

        axis y-1 (
            name: y2
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: true
            }
        )

    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     , observacao
                     , idfechamentorepres||idanexoacerto||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , dataanexo
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                from anexosacertos t
                where t.idfechamentorepres = :P75_IDFECHAMENTOREPRES
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 150
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum arquivo encontrado...
        }
        advanced {
            savedReportMappingIdentifier: 79788802848366908
        }

        column DATAANEXO (
            type: plainText
            heading {
                heading: Anexado Quando?
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
