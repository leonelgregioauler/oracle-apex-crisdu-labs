    pageItem P75_ASSINATURAS_REALIZADAS (
        type: numberField
        label {
            label: Ass. Realizadas(*)
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 410
            region: @romance
            slot: regionBody
            alignment: left
            columnAttributes: [
                onclick="listarealizadas()"
                readonly="readonly"
            ]
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 8
        }
        validation {
            maxLength: 255
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1)
                from notasvendas nv
                where nv.idrepresentante = :P75_IDREPRESENTANTE
                  and nv.semanadistribuicao = :P75_SEMANA
                  and exists ( select 1
                               from assinaturaseletronicas a
                               where a.idnotavenda = nv.idnotavenda
                                 and a.status = 'C' )
                ```
            used: always
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from parametrosrepresentantes pr
                         where pr.parametro = 'UTILIZAASSINATURAELETRONICA'
                           and pr.idrepresentante = :P75_IDREPRESENTANTE
                           and pr.valor in ('S','Z') )
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P75_ASSINATURA_REPROVADAS (
        type: numberField
        label {
            label: <font color="red">Ass. Reprovadas(*)</font>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 420
            region: @romance
            slot: regionBody
            alignment: left
            startNewRow: false
            columnAttributes: [
                onclick="listareprovadas()"
                readonly="readonly"
            ]
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 8
        }
        validation {
            maxLength: 255
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select sum(quantidadeassinaturasreprovadas)
                from (
                    select nvl(count(1),0) quantidadeassinaturasreprovadas
                    from notasvendas nv
                       , assinaturaseletronicas a
                    where nv.idnotavenda = a.idnotavenda
                      and a.status = 'C'
                      and a.tiponota = 'N'
                      and a.situacao = 'R'
                      and nv.idrepresentante = :P75_IDREPRESENTANTE
                      and nv.semanadistribuicao = :P75_SEMANA
                    union
                    select nvl(count(1),0) quantidadeassinaturasreprovadas
                    from notasadicionais na
                       , notasvendas nv
                       , assinaturaseletronicas a
                    where nv.idnotavenda = a.idnotavenda
                      and na.idnotavenda = nv.idnotavenda
                      and a.status = 'C'
                      and a.tiponota = 'A'
                      and a.situacao = 'R'
                      and nv.idrepresentante = :P75_IDREPRESENTANTE
                      and na.semana = :P75_SEMANA
                )
                ```
            used: always
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from parametrosrepresentantes pr
                         where pr.parametro = 'UTILIZAASSINATURAELETRONICA'
                           and pr.idrepresentante = :P75_IDREPRESENTANTE
                           and pr.valor in ('S','Z') )
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P75_AVISOEMPRESTIMO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
            sendOnPageSubmit: false
        }
        layout {
            sequence: 110
            region: @romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="red"><h3>Este distribuidor possui empréstimo pendente no valor de R$ '||trim(to_char((emp.valor - emp.pago),'999G999G999G999G9990D00'))||'</h3></font>'  a
                from (
                      select e.idrepresentante
                           , sum(e.valor + nvl(e.valorjuros,0)) valor
                           , sum( nvl( ( select sum(pe.valorpago)
                                         from pagamentosemprestimos pe
                                         where pe.idemprestimo = e.idemprestimo ),0) ) pago
                      from emprestimos e
                      where e.idrepresentante in ( select idrepresentante
                                                   from representantes r
                                                   where pck_romance.fnc_filialrepresentante(r.idrepresentante) = 1071 )
                      group by e.idrepresentante ) emp
                where emp.idrepresentante = :P75_IDREPRESENTANTE
                  and emp.valor - emp.pago > 0
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from (
                      select e.idrepresentante
                           , sum(e.valor + nvl(e.valorjuros,0)) valor
                           , sum( nvl( ( select sum(pe.valorpago)
                                         from pagamentosemprestimos pe
                                         where pe.idemprestimo = e.idemprestimo ),0) ) pago
                      from emprestimos e
                      where e.idrepresentante in ( select idrepresentante
                                                   from representantes r
                                                   where pck_romance.fnc_filialrepresentante(r.idrepresentante) = 1071 )
                      group by e.idrepresentante ) emp
                where emp.idrepresentante = :P75_IDREPRESENTANTE
                  and emp.valor - emp.pago > 0
                ```
        }
