    region correções-ainda-não-efetuadas (
        name: Correções ainda não efetuadas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(c.idrepresentante) representante
                     , pck_romance.fnc_nomevendedora(n.idvendedora) consultora
                     , nvl(n.numeronota,'Nota não vinculada') numeronota
                     , c.motivo
                     , decode(c.situacao,'P','Pendente','R','Rejeitada','Ajustada') Situacao
                     , n.idnotavenda
                     , case
                         when c.idnotavenda is not null then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||n.idnotavenda ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                       else
                         null
                       end Ajustar
                from correcoesnotasvendas c
                   , notasvendas n
                where C.idnotavenda = n.idnotavenda(+)
                  and c.idrepresentante = :P75_IDREPRESENTANTE
                  and c.situacao = 'P'
                  /*and n.semanacobranca = (select semana
                                          from fechamentossemanais f
                                          where f.idfechamento  = :P75_IDFECHAMENTOPONTUACAO )*/
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from correcoesnotasvendas c
                   , notasvendas n
                where C.idnotavenda = n.idnotavenda
                  and c.idrepresentante = :P75_IDREPRESENTANTE
                  and c.situacao = 'P'
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        messages {
            whenNoDataFound: -
        }
        componentAdvanced {
            stripHtml: true
        }

