    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDFECHAMENTOREPRES.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  --
                  if :P75_IDREGIAOVENDA is not null then -- T16243467
                    --
                    :P75_IDFECHAMENTOREPRES := get_pk; 
                    --
                    insert into fechamentorepresentantes (idfechamentorepres, idrepresentante, idfilial, idfechamento, idfechamentopontuacao, semana, idregiaovenda)
                         values (  :P75_IDFECHAMENTOREPRES, :P75_IDREPRESENTANTE, :P0_IDFILIAL, :P75_IDFECHAMENTO, :P75_IDFECHAMENTOPONTUACAO, :P75_SEMANA,:P75_IDREGIAOVENDA);
                    commit;
                    --
                  end if;
                  --
                end; 
