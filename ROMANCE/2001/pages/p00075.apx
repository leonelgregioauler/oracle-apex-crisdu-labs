    pageItem P75_COMISSOESFAVORITA_GERENTE (
        type: numberField
        label {
            label: <font color="Purple">Comis. Paga Favorita Gerente</font>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 90
            region: @favorita
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 10
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vvalor number;
                begin
                  --
                  select sum(pg.valorpago)
                  into vvalor
                  from pagamentocomissoes pg
                  where pg.idgerente = ( select idgerente
                                         from representantes r
                                         where r.idrepresentante = :P75_IDREPRESENTANTE )
                    and pg.idfechamentorepres = :P75_IDFECHAMENTOREPRES;
                  --
                  return vvalor;
                  --
                exception
                  when others then
                    return 0;
                end;
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0,00
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from representantes r
                   , gerentes g
                where r.idpessoa = g.idpessoa 
                  and r.idrepresentante = :P75_IDREPRESENTANTE
                  and ( exists ( select 1
                               from usuarios u
                               where u.idpessoa = g.idpessoa 
                                 and u.usuario = v('APP_USER') )
                     or ( v('APP_USER') in ('GUILHERME','EVERTON','CINARA','GRASIELI','LEDIELEPERES','TAISESTEFFEN', 'FERNANDAS') ) )
                ```
        }
        readOnly {
            type: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

