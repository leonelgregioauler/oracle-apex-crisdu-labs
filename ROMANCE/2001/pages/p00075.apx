            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char((i.data ),'DD/MM/RRRR HH24:MI:SS')
                from roman.imptablettoservidor i 
                where i.processo = 'L'
                  and i.idsemana = ( select s.idsemana + 1
                                     from roman.fechamentorepresentantes f
                                        , roman.semana_dias s
                                     where s.semanacompleta = f.semana
                                       and f.idrepresentante = i.idrepresentante
                                       and f.idfechamentorepres = :P75_IDFECHAMENTOREPRES )
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
