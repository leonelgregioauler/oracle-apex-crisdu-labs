    region notas-com-problemas-de-pagamento (
        name: Notas com problemas de Pagamento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.idnotavenda
                     , n.numeronota
                     , roman.pck_romance.fnc_nomevendedora(n.idvendedora) vendedora
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , roman.pck_romance.fnc_cpfvendedora(n.idvendedora) cpfvendedora
                     , n.valortotalvendalqd
                     , n.saldo
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||n.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' url
                from roman.notasvendas n
                where n.idrepresentante = :P75_IDREPRESENTANTE
                  and n.idsituacaonotavenda = 4
                  and exists ( select 1
                               from roman.pagamentosnotasvendas p
                               where p.idnotavenda = n.idnotavenda
                                 and p.semanacobranca = :P75_SEMANA )
                  and ( n.saldo < 0
                     or n.valortotalvendalqd < (select sum(p.valorpago)
                                                from roman.pagamentosnotasvendas p
                                                where p.idnotavenda = n.idnotavenda) )
                ```
        }
        layout {
            sequence: 210
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
