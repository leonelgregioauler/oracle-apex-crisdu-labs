            sqlQuery:
                ```sql
                select 1
                from notasvendas nv
                where nv.idrepresentante = :P75_IDREPRESENTANTE
                  and nv.semanacobranca  = :P75_SEMANA
                  and nv.saldo          <= 30
                  and nv.saldo           > 0
                  and nv.idsituacaonotavenda = 4
                  and nv.idfilial = 290
                ```
        }
        security {
            encryptSessionState: false
