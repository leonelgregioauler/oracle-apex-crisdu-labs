    process integrar-dtemite (
        name: Integrar_dtemite
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  v_retorno varchar2(1000);
                  v_existe  number;
                begin
                  --
                  begin
                    --
                    select 1
                      into v_existe
                      from roman.mei 
                     where idpessoa = (select idpessoa
                                         from representantes 
                                        where idrepresentante = :P75_IDREPRESENTANTE);
                  exception
                    when no_data_found then 
                      apex_error.add_error ( p_message          => 'DISTRIBUIDOR NAO TEM MEI CADASTRADO!',
                                             p_display_location => APEX_ERROR.C_INLINE_IN_NOTIFICATION );  
                  --
                  end;
                  --
                  if nvl(v_existe,0) = 1 then
                    pck_integracao_ecommerceva.prc_dtemite_acerto (p_idfechamento  => :P75_IDFECHAMENTOREPRES,
                                                                   p_mensagem => v_retorno);
                    commit;
                    --
                    if substr(v_retorno,1,12) = 'Ocorreu erro' then
                      apex_error.add_error ( p_message          => v_retorno,
                                             p_display_location => APEX_ERROR.C_INLINE_IN_NOTIFICATION );  
                    else
                      apex_application.g_print_success_message := TRIM (v_retorno);
                    end if;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 110
        }
        advanced {
            executionMappingIdentifier: 1334773747451357586
        }
        serverSideCondition {
            whenButtonPressed: @integrar-dtemite
            type: request=Value
            value: INTEGRAR_DTEMITE
        }
    )

    process libera-pagamento-de-comissão (
        name: Libera Pagamento de Comissão
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalor number := 0;
                  --
                begin
                  --
                  select fr.debitosfavoritaproprio
                  into vvalor
                  from fechamentorepresentantes fr
                  where fr.idfechamentorepres = :P75_IDFECHAMENTOREPRES;
                  --
