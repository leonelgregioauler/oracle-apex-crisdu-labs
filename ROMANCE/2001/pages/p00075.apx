    region débitos-pagos-na-semana (
        name: Débitos Pagos na Semana
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.idpepinosrepresentante
                     , r.idfechamentorepres 
                     , r.nrpedido
                     , r.valor
                     , r.semana
                     , decode(r.situacao,'N','Novo','P','Pago', 'D', 'Mercadoria Devolvida') situacao
                     , r.semanapago
                     , r.observacao
                     , pck_romance.fnc_nomerepresentante(r.idrepresentante) nomerepresentante
                     , r.nomevendedora
                     , r.cpf
                     , r.idnotavenda idnotavenda2
                     , null representantecobrou
                     , null idnotavenda
                     , null telefones
                     , null enviadocobranca
                     , null idtablet
                from pepinosrepresentantes r
                where r.idfechamentoreprespago = :P75_IDFECHAMENTOREPRES
                  and r.situacao = 'P'
                union all
                select null
                     , p.idfechamentorepres 
                     , n.numeronota
                     , p.valorpago
                     , p.semanacobranca  semana
                     , 'Pago' situacao
                     , p.semanacobranca semanapago
                     , null observacao
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) nomerepresentante
                     , pck_romance.fnc_nomevendedora(n.idvendedora) nomevendedora
                     , pck_romance.fnc_cpfvendedora(n.idvendedora) cpf
                     , n.idnotavenda idnotavenda2
                     , pck_romance.fnc_nomerepresentante(n.idrepresentanteatende) representanteatende 
                     , n.idnotavenda
                     , pck_romance.fnc_retornatelefones(n.idvendedora) telefones
                     , n.enviadocobranca
                     , p.idtablet
                from pagamentosnotasvendas p
                   , notasvendas           n
                where p.idnotavenda        = n.idnotavenda
                  and p.idfechamentorepres = :P75_IDFECHAMENTOREPRES
                  and n.semanacobranca    != ( select f.semana  
                                               from fechamentossemanais f
                                               where f.idfechamento = :P75_IDFECHAMENTOPONTUACAO )
                ```
        }
        layout {
            sequence: 200
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum débito pago por este distribuidor.
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
            linkText: Download deste Relatorio
        }

