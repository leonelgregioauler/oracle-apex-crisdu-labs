    region depósitos-com-pendências (
        name: Depósitos com pendências
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select beneficiario
                         from contasbancarias b
                         where b.idcontabanc = d.idcontabanc ) Beneficiario
                     , d.data
                     , decode(pendencia,'MA', 'Valor Maior'
                                       ,'ME', 'Valor Menor'
                                       ,'NL', 'Não Localizado' ) pendencia
                     , d.valordeposito
                     , valorlocalizado
                     , observacao
                     , d.nrocomprovante
                     , ( select semana 
                         from fechamentossemanais f
                         where f.idfechamento = ( select idfechamento 
                                                  from fechamentorepresentantes ff 
                                                  where ff.idfechamentorepres = d.idfechamentorepres ) ) Fechamento
                from depositosdiarios_orig d
                where d.pendencia is not null
                  and resolvido is null
                  and idrepresentante = :P75_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 160
            slot: body
        }
