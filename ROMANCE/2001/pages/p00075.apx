                select '<font color="red"><h3>Este Distribuidor ficou com '||count(1)||' nota(s) com saldo a baixo de 30 reais.</font>' display_value
                from notasvendas nv
                where nv.idrepresentante = :P75_IDREPRESENTANTE
                  and nv.semanacobranca  = :P75_SEMANA
