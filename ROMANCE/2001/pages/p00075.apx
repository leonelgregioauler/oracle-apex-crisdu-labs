    pageItem P75_PERCENTUAL_INADIMPLENCIA (
        type: numberField
        label {
            label: % INAD
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 450
            region: @romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 8
        }
        validation {
            maxLength: 255
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(round(sum(luc.totdebnovos)/decode(sum(luc.totdebnovosger),0,1,sum(luc.totdebnovosger)) *100,2),0)
                from ( select r.idrepresentante
                            , g.idfilial
                            ,(select sum(case
                                         when totaldebitosnovos > 0 then
                                           totaldebitosnovos
                                         else
                                           0
                                         end )
                             from fechamentorepresentantes fr
                                , fechamentossemanais   ff
                             where ff.idfechamento    = fr.idfechamento
                               and fr.idrepresentante = r.idrepresentante
                               and trim(ff.semana)    = trim(s.semanacompleta)) totdebnovos
                            ,(select sum(case
                                         when totaldebitosnovos > 0 then
                                           ( totalgeral + totaldebitosnovos  ) 
                                         else
                                           0
                                         end )
                             from fechamentorepresentantes fr
                                , fechamentossemanais   ff
                             where ff.idfechamento    = fr.idfechamento
                               and fr.idrepresentante = r.idrepresentante
                               and trim(ff.semana)    = trim(s.semanacompleta)) totdebnovosger
                        from semana_dias s
                           , representantes r
                           , gerentes g
                        where r.idgerente = g.idgerente 
                      and ( :P75_IDFILIAL is null 
                            or ( :P75_IDFILIAL = 1135 and g.idfilial in (1089,1090,1106,1132,124,122,320,221,1070,1072 ) )
                            or ( :P75_IDFILIAL != 1135 and g.idfilial  = :P75_IDFILIAL ) )
                          and r.ativo = 'S'
                          and s.semanacompleta = :P75_SEMANA
                          and r.idrepresentante = :P75_IDREPRESENTANTE) luc
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

