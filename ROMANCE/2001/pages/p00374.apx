    region históricos-de-consulta-ao-spc (
        name: Históricos de Consulta ao SPC
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idhistoricoconsultadoc
                     , w.dataconsulta
                     , w.documento
                     , w.nroconsultaspc
                     , w.nomerepresentante
                     , w.descliberado
                     , w.usuario 
                     , w.codigoliberacao
                     , (select n.datanota
                          from catal.pessoas p
                             , catal.vendedoras v
                             , roman.notasvendas n
                         where p.idpessoa = v.idpessoa 
                           and v.idvendedora = n.idvendedora
                           and n.idrepresentante = w.idrepresentante
                           and ( p.cpf = replace(replace(w.documento,'.',''),'-','') or p.documentoestrangeiro = w.documento)
                           and n.idsituacaonotavenda = 3
                           and rownum = 1) datacadastro 
                     , w.observacao
                     , telefones
                from roman.vw_historicosconsultasdoc w
                where trunc(w.dataconsulta) between to_date(:P374_DATAINICIO,'DD/MM/RRRR') and to_date(:P374_DATAFIM,'DD/MM/RRRR')
                  and ( :P374_LIBERADO = 'T' or w.liberado = :P374_LIBERADO )
                  and ( :P374_IDREPRESENTANTE is null or w.idrepresentante = :P374_IDREPRESENTANTE )
                  and ( :P374_NRCONSULTASPC is null or w.nroconsultaspc = :P374_NRCONSULTASPC )
                  and ( :P374_DOCUMENTO is null or w.documento = :P374_DOCUMENTO )
                  and ( :P374_IDFILIAL is null or w.idfilial = :P374_IDFILIAL )
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma Consulta encontrada!
        }
        advanced {
            savedReportMappingIdentifier: 1411802901833104226
        }

