    pageItem P374_IDFILIAL (
        type: selectOne
        label {
            label: Empresa
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo != 5
                union
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.ididioma in (2,4,6,11,12,13)
                union
                select f.nome
                     , f.idfilial
                  from roman.vw_filiais f
                 where f.idfilial in (1217,1246,1275) --Lojas Brasilia
                   and f.tipofilial = 'D'
                   and f.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P374_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) d
                     , idrepresentante r
                from catal.representantes r
                where r.ativo = 'S'
                  and (:P374_IDFILIAL is null or r.idgerente = (select idgerente
                                                                  from catal.gerentes g
                                                                 where g.idfilial = :P374_IDFILIAL ))
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P374_IDFILIAL
            parentRequired: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

