    button ver-acompanhamento (
        buttonName: VER_ACOMPANHAMENTO
        label: Acompanhamento Resumido
        layout {
            sequence: 10
            region: @históricos-de-consulta-ao-spc
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 400
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 374
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 374
                items: {
                    P374_IDREPRESENTANTE: &P374_IDREPRESENTANTE.
                    P374_LIBERADO: &P374_LIBERADO.
                    P374_NRCONSULTASPC: &P374_NRCONSULTASPC.
                    P374_DATAINICIO: &P374_DATAINICIO.
                    P374_DATAFIM: &P374_DATAFIM.
                    P374_DOCUMENTO: &P374_DOCUMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

