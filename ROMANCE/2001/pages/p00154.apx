page 154 (
    name: Lista de Preço
    title: Lista de Preço
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .img_produto_new {
                position: relative;
                max-width: 152px;
                width: 50%;
            }
            .img_produto {
                position: relative;
                max-width: 210px;
                width: 60%;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region lista-de-produtos (
        name: Lista de Produtos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomecategoria(p.idcategoria) Categoria
                    , p.codigosisdist||' - '|| initcap(p.nomeproduto) nomeproduto
                    , decode(e.comissao,'S','Sim','N','Não') comissao
                    , to_char(e.vlrvenda,'999G999G999G990D00') vlrvenda
                    , p.codigosisdist
                    , '<a href="'||url||'" target="_blank"> <img src="'||urlreduzida||'" class="img_produto"><a>' imagem
                from roman.estoquefilial e
                   , roman.produtos p
                   , roman.fotosprodutos fp
                where e.idfilial = :P0_IDFILIAL
                 and e.idproduto = p.idproduto
                 and p.idproduto = fp.idproduto(+)
                 and e.ativo = 'S'
                 and e.comissao is not null
                 and e.vlrvenda is not null
                 and ( :P154_CODIGO is null or p.codigosisdist = :P154_CODIGO )
                 and ( :P154_PRODUTO is null or lower(p.nomeproduto) like '%'||lower(replace(:P154_produto,' ','%' ))||'%')
                 and ( :P154_CATEGORIA is null 
                      or p.idcategoria = :P154_CATEGORIA)
                 and ( :P154_TIPOPESQUISA = 'A'
                       or :P154_TIPOPESQUISA = 'C' and exists ( select 1 
                                                                from roman.fotosprodutos fp 
                                                                where fp.idproduto = p.idproduto)
                      or :P154_TIPOPESQUISA = 'S' and not exists ( select 1 
                                                                   from roman.fotosprodutos fp 
                                                                   where fp.idproduto = p.idproduto))
                 and (:P154_FILTRAR  = 'S')                                                  
                order by p.nomeproduto
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 200
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        download {
            csvExportEnabled: true
        }

        column CATEGORIA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Categoria
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column CODIGOSISDIST (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Referência
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column COMISSAO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Comissão
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column IMAGEM (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Imagem
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEPRODUTO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Nome Produto
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column VLRVENDA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Valor Venda
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P154_CATEGORIA (
        type: selectList
        label {
            label: Categoria
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct (roman.pck_romance.fnc_nomecategoria(p.idcategoria)) ctegoria
                    , p.idcategoria return_value
                from roman.produtos p
                where p.idcategoria not in (140,141,142)
                order by 1
                ```
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P154_CODIGO (
        type: textField
        label {
            label: Código
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P154_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P154_PRODUTO (
        type: textField
        label {
            label: Produto
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P154_TIPOPESQUISA (
        type: radioGroup
        label {
            label: Tipo Pesquisa
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Com Foto;C,Sem Foto;S,Ambos;A
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: C
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process imprime (
        name: imprime
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_imprime.prc_imprimelistapreco(:P0_IDFILIAL);
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 332948487977619692
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        name: FILTRAR
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 154
                items: {
                    P154_FILTRAR: S
                }
            }
        }
    )

    branch (
        name: Go To Page 154
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 154
                items: {
                    P154_CATEGORIA: &P154_CATEGORIA.
                    P154_TIPOPESQUISA: &P154_TIPOPESQUISA.
                    P154_CODIGO: &P154_CODIGO.
                    P154_PRODUTO: &P154_PRODUTO.
                    P154_FILTRAR: &P154_FILTRAR.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

