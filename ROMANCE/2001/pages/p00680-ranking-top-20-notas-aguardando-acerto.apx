page 680 (
    name: Ranking Top 20 Notas Aguardando Acerto
    alias: RANKING_TOP_20_NOTAS_AGUARDANDO_ACERTO
    title: Ranking Top 20 Notas Aguardando Acerto
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/wizard-modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1100
        height: 800
    }

    region olhar-o-html-source-desta-região (
        name: Olhar o HTML source desta região
        type: staticContent
        source {
            htmlCode:
                ```html
                Olá, bem vindo Sr! Dev, tudo certo?
                
                Essa página foi criada em 02/04/2025 por Maicon Aimi para atender ao ticket 9962933.
                
                Como acessar essa página via sistema:
                    Simples!  
                        Na página 2001_page_554.sql foi criado um botão RANKING_NF_AGUARDANDO_ACERTO que ao ser clicado abre essa página.
                ```
        }
        layout {
            sequence: 10
            slot: wizardBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
    )

    region ranking-top-20-notas-aguardando-acerto (
        name: Ranking top 20 notas aguardando acerto
        title: Ranking top 20 notas aguardando acerto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.idvendedora
                     , n.idnotavenda         as "ID Nota"
                     , n.numeronota          as "Nº Nota"
                     , p.CPF                 as "CPF Vendedora"
                     , initcap(p.nomepessoa) as "Vendedora"
                     , n.datanota            as "Data Emis. Nota"
                     , n.valortotalnota      as "Valor Total Nota"
                     , (select avg(valortotalnota) as media_valor_total
                          from (select nv.valortotalvenda
                                  from roman.notasvendas nv
                                 where nv.idvendedora = n.idvendedora
                                   and nv.idsituacaonotavenda = 4
                                 order by nv.datanota desc
                                 fetch first 5 rows only)) as "Media Ult 5 Acertos"
                  from roman.notasvendas n
                     , catal.vendedoras v
                     , catal.pessoas p
                 where v.idvendedora = n.idvendedora
                   and p.idpessoa = v.idpessoa
                   and n.idsituacaonotavenda = 3
                   and n.idrepresentante = :P680_idrepresentante
                 order by n.valortotalnota desc
                 fetch first 20 rows only;
                ```
        }
        layout {
            sequence: 20
            slot: wizardBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 379742101597957205
        }

        column "CPF Vendedora" (
            type: plainText
            heading {
                heading: CPF Vendedora
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column "Data Emis. Nota" (
            type: plainText
            heading {
                heading: Data Emis. Nota
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column "ID Nota" (
            type: plainText
            heading {
                heading: ID Nota
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDVENDEDORA (
            type: link
            heading {
                heading: Detalhar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: javascript:void(0)
                }
                linkText: <span class="fa fa-chevron-down"></span><span class="IDVENDEDORA" style="display:none">#IDVENDEDORA#</span>
                linkAttributes: class="listadetalhada"
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column "Media Ult 5 Acertos" (
            type: plainText
            heading {
                heading: Media Ult. 5 Acertos
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column "Nº Nota" (
            type: plainText
            heading {
                heading: Nº Nota
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column "Valor Total Nota" (
            type: plainText
            heading {
                heading: Valor Total Nota
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column Vendedora (
            type: plainText
            heading {
                heading: Vendedora
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Ranking top 20 notas aguardando acerto
        }

        savedReport 3797820 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "CPF Vendedora" (
                sequence: 4
            )

            displayColumn "Data Emis. Nota" (
                sequence: 6
            )

            displayColumn "ID Nota" (
                sequence: 2
            )

            displayColumn IDVENDEDORA (
                sequence: 1
            )

            displayColumn "Media Ult 5 Acertos" (
                sequence: 8
            )

            displayColumn "Nº Nota" (
                sequence: 3
            )

            displayColumn "Valor Total Nota" (
                sequence: 7
            )

            displayColumn "Vendedora" (
                sequence: 5
            )

        )

    )

    pageItem P680_IDREPRESENTANTE (
        type: hidden
        layout {
            sequence: 10
            region: @ranking-top-20-notas-aguardando-acerto
            slot: regionBody
        }
    )

    dynamicAction lista-detalhada (
        name: Lista Detalhada
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .listadetalhada
        }

        action plugin-pretius-apex-nested-reports (
            action: plugin/pretiusApexNestedReports
            settings {
                defaultCallbackOptions: [
                    collapseExpanded
                    addAnimation
                    cacheResults
                ]
                defaultTemplateOptions: [
                    strechReport
                    sortingData
                ]
                detailsQuery:
                    ```sql
                    select '<span style="text-align:center; display:block;">' || nv.idnotavenda || '</span>'         as "ID Nota"
                         , '<span style="text-align:center; display:block;">' || nv.numeronota || '</span>'          as "Nº Nota"
                         , '<span style="text-align:center; display:block;">' || to_char(nv.datanota, 'DD/MM/YYYY') || '</span>'            as "Data Emissão Nota"
                         , '<span style="text-align:center; display:block;">' || to_char(nv.valortotalnota, '999G999G999G999G990D00') || '</span>'      as "Valor Total Nota"
                         , '<span style="text-align:center; display:block;">' || to_char(nvl(nv.valortotalvenda, 0), '999G999G999G999G990D00') || '</span>'     as "Valor Total Venda"
                         , '<span style="text-align:center; display:block;">' || to_char(nvl(round(nvl(nv.valortotalvenda, 0) / nullif(nv.valortotalnota, 0) * 100, 2), 0), '990D00') || '%</span>'     as "% Venda"
                      from roman.notasvendas nv
                     where nv.idvendedora = '#IDVENDEDORA#'
                       and nv.idsituacaonotavenda = 4
                     order by nv.datanota desc
                     fetch first 5 rows only
                    ```
                whenNoDataFound: Nenhuma nota encontrada
            }
            affectedElements {
                selectionType: region
                region: @ranking-top-20-notas-aguardando-acerto
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

