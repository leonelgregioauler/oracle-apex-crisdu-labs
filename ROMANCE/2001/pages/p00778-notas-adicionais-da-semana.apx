page 778 (
    name: Notas Adicionais da Semana
    alias: NOTAS-ADICIONAIS-DA-SEMANA
    title: Notas Adicionais da Semana
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region notas-da-semana (
        name: Notas da Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , nv.idnotavenda idnota
                     , nv.numeronota
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.idvendedora
                     , na.idtablet
                     , pck_romance.fnc_nomevendedora(nv.idvendedora) consultora
                     , na.data 
                     , ( select sum(it.quantidade) --count(1)
                         from itensnotasadicionais it
                         where it.idnotaadicional = na.idnotaadicional ) qtd_itens
                from notasadicionais na
                   , notasvendas nv
                where na.idrepresentante = :P778_IDREPRESENTANTE
                  and na.semana = :P778_SEMANA
                  and na.idnotavenda = nv.idnotavenda
                order by 4
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1056538973299954111
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column DATA (
            type: plainText
            heading {
                heading: Data Adicional
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: F
            }
        )

        column IDNOTA (
            type: plainText
            heading {
                heading: "ID Nota Venda "
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column IDNOTAVENDA (
            type: link
            heading {
                heading: Ir Para Nota
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 37
                    items: {
                        P37_IDNOTAVENDA: #IDNOTAVENDA#
                    }
                }
                linkText: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
                linkAttributes: target="_blank"
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDTABLET (
            type: plainText
            heading {
                heading: ID Tablet
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column IDVENDEDORA (
            type: plainText
            heading {
                heading: "ID Consultora "
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column NUMERONOTA (
            type: plainText
            heading {
                heading: Nr Nota
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column QTD_ITENS (
            type: plainText
            heading {
                heading: Qtd Itens
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column SEMANACOBRANCA (
            type: plainText
            heading {
                heading: Semana Cobrança
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column SEMANADISTRIBUICAO (
            type: plainText
            heading {
                heading: Semana Distribuição
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 10594754 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONSULTORA (
                sequence: 7
            )

            displayColumn DATA (
                sequence: 8
            )

            displayColumn IDNOTA (
                sequence: 2
            )

            displayColumn IDNOTAVENDA (
                sequence: 1
            )

            displayColumn IDTABLET (
                sequence: 10
            )

            displayColumn IDVENDEDORA (
                sequence: 6
            )

            displayColumn NUMERONOTA (
                sequence: 3
            )

            displayColumn QTD_ITENS (
                sequence: 9
            )

            displayColumn SEMANACOBRANCA (
                sequence: 5
            )

            displayColumn SEMANADISTRIBUICAO (
                sequence: 4
            )

        )

    )

    pageItem P778_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @notas-da-semana
            slot: regionBody
        }
    )

    pageItem P778_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @notas-da-semana
            slot: regionBody
        }
    )

)

