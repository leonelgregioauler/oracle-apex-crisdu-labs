            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                -- Validação para notas de COMPRAS
                select 1 
                  from dual
                 where :P25_SITUACAOFILIAL != 'R'
                   and :P25_DATARECEBIMENTO is not null
                   and :P25_VOLUMESRECEBIDOS is not null
                   and :P25_VOLUMESVIOLADOS is not null
                   and :P25_TIPONOTA = 'C'
                   and roman.pck_romance.fnc_retornaparametro('RECEBIMENTOPARCIALCOMPRA',:P0_IDFILIAL) = 'S'
                
                union
                
                -- Validação para notas de Transferência
                select 1
                  from roman.notasfiscais n
                 where n.idnotafiscal = :P25_IDNOTAFISCAL
                   and n.tiponota = 'T'
                   and n.idtransportadora = 44--Transportadora Em Maos
                   and roman.pck_romance.fnc_retornaparametro('RECEBIMENTOPARCIALCOMPRA',:P0_IDFILIAL) = 'S'
                ```
        }
    )

