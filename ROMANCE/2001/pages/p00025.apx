    pageItem P25_MENSAGEM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 270
            region: @recebimento-de-compra
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select distinct 'Ha divergencia na nota! Quantidade recebida e menor que a quantidade na nota!' 
                from itemnf i
                where i.idnotafiscal = :P25_IDNOTAFISCAL
                  and qtd_total > qtd_total_chegou
                union
                select distinct 'Ha divergencia na nota! Quantidade recebida e maior que a quantidade na nota!' 
                from itemnf i
                where i.idnotafiscal = :P25_IDNOTAFISCAL
                  and qtd_total < qtd_total_chegou
                union
                select distinct 'Nota recebida sem divergencias!' 
                from itemnf i
                where i.idnotafiscal = :P25_IDNOTAFISCAL
                  and qtd_total = qtd_total_chegou
                ```
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

