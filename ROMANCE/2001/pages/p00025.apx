    dynamicAction atualizaregiao (
        name: AtualizaRegiao
        execution {
            sequence: 50
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @itens-aguardando-recebimento
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @itens-aguardando-recebimento
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction carrega-dados-da-nf-selecionada (
        name: Carrega dados da NF Selecionada
        execution {
            sequence: 110
        }
        when {
            event: ready
        }
        comments {
            comments:
                ```
                Resolve problema:
                Ao carregar, existe um processo que carrega todos os campos, porém, para radio-buttons / listas que possuem SQL Queryes, estes valores são sobrepostos. Necessitam carregar novamente após o seu valor inicial.
                ```
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    select situacaofilial
                         , tiponota
                    into :P25_SITUACAOFILIAL
                       , :P25_TIPONOTA
                    from notasfiscais
                    where idnotafiscal = :P25_IDNOTAFISCAL;
                    ```
                itemsToSubmit: P25_IDNOTAFISCAL
                itemsToReturn: [
                    P25_SITUACAOFILIAL
                    P25_TIPONOTA
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

