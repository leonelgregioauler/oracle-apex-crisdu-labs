    process grava-observação-empresa-item-nota (
        name: Grava Observação empresa Item nota
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Begin
                
                
                  -- atualiza a observação empresa do item da nota fiscal.
                  update roman.itemnf i
                     set i.observacaofilial = substr(:P25_OBSERVACAOFILIAL,1,300)
                   where i.iditnf = :P25_ITEMNF;
                
                
                  -- comite do processo
                  commit;
                  
                  
                  -- limpa o campo da tela 
                  :P25_OBSERVACAOFILIAL := '';
                  
                  
                end;
                ```
        }
        execution {
            sequence: 140
        }
        successMessage {
            successMessage: Observação empresa atualizada com sucesso.
        }
        error {
            errorMessage: Ops! Ocorreu um erro ao tentar grava a observação empresa do item da nota.
        }
        advanced {
            executionMappingIdentifier: 3630191686189451119
        }
        serverSideCondition {
            whenButtonPressed: @gravar-obs
        }
    )

