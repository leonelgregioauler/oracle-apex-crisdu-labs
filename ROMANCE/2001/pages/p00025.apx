    region itens-previstos-na-nota (
        name: Itens Previstos na Nota
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.Produto "Produto" 
                     , x.qtd_pp "Qtd PP"
                     , x.qtd_p "Qtd P"
                     , x.qtd_m "Qtd M"
                     , x.qtd_g "Qtd G"
                     , x.qtd_gg "Qtd GG"
                     , x.qtd_egg "Qtd EGG"
                     , x.qtd_exgg "Qtd EXGG"
                     , x.qtd_u "Qtd U"
                     , x.qtd_total "Qtd TOTAL"
                     , x.observacao
                  from (
                          select ( select codigosisdist||' - '||initcap(p.nomeproduto)
                                   from roman.produtos p
                                   where p.idproduto = i.idproduto) produto 
                               , i.qtd_pp 
                               , i.qtd_p 
                               , i.qtd_m 
                               , i.qtd_g 
                               , i.qtd_gg 
                               , i.qtd_egg 
                               , i.qtd_exgg 
                               , i.qtd_u 
                               , i.qtd_total 
                               , i.observacao
                          from roman.itemnf i
                          where i.idnotafiscal = :P25_IDNOTAFISCAL
                          order by roman.pck_romance.fnc_nomeproduto(idproduto)) x
                where x.produto is not null
                order by x.produto asc
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from itemnf i
                where i.idnotafiscal = :P25_IDNOTAFISCAL
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 3094863466548545352
        }

