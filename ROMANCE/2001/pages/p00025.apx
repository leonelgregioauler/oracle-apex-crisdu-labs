    region defeitos (
        name: Defeitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select codigosisdist||' - '||initcap(p.nomeproduto)
                         from produtos p
                         where p.idproduto = d.idproduto) "Produto"  
                     , d.qtd_pp
                     , d.qtd_p
                     , d.qtd_m
                     , d.qtd_g
                     , d.qtd_gg
                     , d.qtd_egg
                     , d.qtd_exgg
                     , d.qtd_u
                     , (select df.descricao
                        from defeitos df
                        where df.iddefeito = d.iddefeito) "Defeito"
                     , d.observacao
                from defeitosfornecedores d
                where idnotafiscal = :P25_IDNOTAFISCAL
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from defeitosfornecedores
                where idnotafiscal = :P25_IDNOTAFISCAL
                ```
        }
