        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process confirma-recebimento (
        name: Confirma recebimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  --i integer;
                  vidnotafiscal  number := :P25_IDNOTAFISCAL;
                  videstoque     number;
                  vtipofilialemitente varchar2(1);
                  --
                  cursor cnota is
                    select *
                    from notasfiscais
                    where idnotafiscal = vidnotafiscal;
                  --
                  rnota cnota%rowtype;
                  --
                  vnomefornecedor varchar2(1000);
                  --
                begin
                  --
                  open cnota;
                  fetch cnota into rnota;
                  close cnota;
                  --
                  begin
                    select tipofilial
                      into vtipofilialemitente
                      from vw_filiais 
                     where idfilial = rnota.idfilialemitente;
                  exception
                  when NO_DATA_FOUND then
                    vtipofilialemitente := 'X';
                  end;
                  --
                  for i in ( select n.idproduto
                                  , n.idprodutorecebido 
                                  , n.qtd_total_chegou
                                  , p.comissao
                                  , p.precovenda
                                  , n.qtd_pp_chegou
                                  , n.qtd_p_chegou
                                  , n.qtd_m_chegou
                                  , n.qtd_g_chegou
                                  , n.qtd_gg_chegou
                                  , n.qtd_egg_chegou
                                  , n.qtd_exgg_chegou
                                  , n.qtd_u_chegou
                                  , n.iditnf
                             from itemnf n
                                , produtos p
                             where n.idproduto    = p.idproduto
                               and n.idnotafiscal = vidnotafiscal
                               and not exists ( select 1
                                                from movimentosestoquefilial me
                                                where me.iditemnf = n.iditnf ) )
                  loop
                    --
                    -- movimenta estoque da filial que está recebendo
                    --
                    begin
                      select e.idestoquefilial
                      into videstoque
                      from estoquefilial e
                      where e.idfilial = rnota.idfilialdestino
                        and e.idproduto = i.idprodutorecebido;
                      --
                      /*update estoquefilial
                      set ativo = 'S'
                      where idestoquefilial = videstoque;*/
                      --
                    exception
                      when others then
                         --
                         select seq_idestoquefil.nextval
                         into videstoque
                         from dual;
                         --
                         insert into estoquefilial ( idestoquefilial  , idfilial  , idproduto
                                                   , ativo            , comissao
                                                   , vlrvenda         , qtd_pp    , qtd_p
                                                   , qtd_m            , qtd_g     , qtd_gg
                                                   , qtd_egg          , qtd_u )
                         values ( videstoque        , rnota.idfilialdestino  , i.idprodutorecebido
                                ,  'N'                    , null/*i.comissao*/
                                , null /*i.precovenda*/      , 0                      , 0
                                , 0                 , 0                      , 0
                                , 0  , 0  );             
                         
                         --
                         commit;
                    end;
                    --
                    insert into movimentosestoquefilial ( idmovtoestoquefilial , idestoquefil  , idfilial  
                                                        ,  observacao          , usuario
                                                        , datamovimento        , qtd_pp        , qtd_p
                                                        , qtd_m                , qtd_g         , qtd_gg
                                                        , qtd_egg              , qtd_exgg      , qtd_u 
                                                        , iditemnf)
                    values ( seq_idmovtoestoquefilial.nextval   , videstoque                             , rnota.idfilialdestino
                           ,  'Recebimento da nota'||rnota.documento , v('APP_USER')
                           , sysdate                            , i.qtd_pp_chegou                        , i.qtd_p_chegou
                           , i.qtd_m_chegou                     , i.qtd_g_chegou                         , i.qtd_gg_chegou
                           , i.qtd_egg_chegou                   , i.qtd_exgg_chegou                      , i.qtd_u_chegou
                           , i.iditnf ); 
                    --        @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
                    -- @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
                    -- movimenta estoque da filial que enviou a mercadoria
                    --@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
                    --        @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
                    
                    if rnota.idfilialemitente is not null and 
                       rnota.tipoemitente != 'FOR' and 
                       vtipofilialemitente not in ('F','L','T','A','O','X') then  
                      -- movimenta produto que saiu da filial emitente
                     begin
                       begin
                         select e.idestoquefilial
                         into videstoque
                         from estoquefilial e
                         where e.idfilial = rnota.idfilialemitente
                           and e.idproduto = i.idproduto;
                       exception
                         when others then
                           --
                           select seq_idestoquefil.nextval
                           into videstoque
                           from dual;
                           --
                           insert into estoquefilial ( idestoquefilial  , idfilial  , idproduto
                                                     , ativo            , comissao
                                                     , vlrvenda         , qtd_pp    , qtd_p
                                                     , qtd_m            , qtd_g     , qtd_gg
                                                     , qtd_egg          , qtd_exgg  , qtd_u )
                           values ( videstoque        , rnota.idfilialemitente  , i.idprodutorecebido
                                  ,  'N'                    , null/*i.comissao*/
                                  , null /*i.precovenda*/      , i.qtd_pp_chegou         , i.qtd_p_chegou
                                  , i.qtd_m_chegou                 , i.qtd_g_chegou                      , i.qtd_gg_chegou
                                  , i.qtd_egg_chegou  , i.qtd_exgg_chegou , i.qtd_u_chegou   );        
                           --
                           commit;
                       end;
                      --
                      insert into movimentosestoquefilial ( idmovtoestoquefilial , idestoquefil  , idfilial  
                                                          , observacao           , usuario
                                                          , datamovimento        , qtd_pp        , qtd_p
                                                          , qtd_m                , qtd_g         , qtd_gg
                                                          , qtd_egg              , qtd_exgg      , qtd_u 
                                                          , iditemnf)
                      values ( seq_idmovtoestoquefilial.nextval   , videstoque                             , rnota.idfilialemitente
                             ,  'Recebimento da nota '||rnota.documento||' na filial '||pck_romance.fnc_nomefilial(rnota.idfilialdestino) , v('APP_USER')
                             , sysdate                            , i.qtd_pp_chegou  *-1                      , i.qtd_p_chegou*-1
                             , i.qtd_m_chegou *-1                    , i.qtd_g_chegou  *-1                       , i.qtd_gg_chegou*-1
                             , i.qtd_egg_chegou  *-1                 , i.qtd_exgg_chegou  *-1      , i.qtd_u_chegou  *-1
                             , i.iditnf); 
                      --  
                      --exception   
                        --when others then
                          --null;
                      end;
                    end if;   
                  end loop;
                  --
                  if :P25_TIPONOTA != 'T' then
                    --
                    pck_estoque_v2.prc_movimentaestoquefaltante( pidnotafiscal => vidnotafiscal
                                                               , pusuario => v('APP_USER') );
                    --
                  elsif :P25_TIPONOTA = 'T' then
                    --
                    pck_estoque_v2.prc_geravencimentostransf(pidnotafiscal => vidnotafiscal);
                    --
                  end if;
                  --
                  update notasfiscais
                     set situacaofilial = 'R'
                       , emailrecebimento = 'S'
                       , dataconfirmacao = sysdate
                   where idnotafiscal = vidnotafiscal;
                  -- 
                end;
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 1483893132179945084
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'RECEBER'
                ```
        }
    )

    process confirma-recebimento-insumos (
        name: Confirma Recebimento Insumos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  i integer;
                  vidnotafiscal    number := :P25_IDNOTAFISCAL;
                  videstoqueinsumo number;
                  --
                  cursor cnota is
                    select *
                    from notasfiscais
                    where idnotafiscal = vidnotafiscal;
                  --
                  rnota cnota%rowtype;
                  --
                  vnomefornecedor varchar2(1000);
                  --
                begin
                --
                  open cnota;
                  fetch cnota into rnota;
                  close cnota;
                  --
                  for i in ( select n.idproduto
                                  , n.idprodutorecebido 
                                  , n.qtd_total_chegou
                                  , p.comissao
                                  , p.precovenda
                                  , ( nvl(n.qtd_pp_chegou,0)
                                    + nvl(n.qtd_p_chegou,0)
                                    + nvl(n.qtd_m_chegou,0)
                                    + nvl(n.qtd_g_chegou,0)
                                    + nvl(n.qtd_gg_chegou,0)
                                    + nvl(n.qtd_egg_chegou,0)
                                    + nvl(n.qtd_exgg_chegou,0)
                                    + nvl(n.qtd_u_chegou,0) ) qtd_chegou
                                  , n.iditnf
                             from itemnf n
                                , produtos p
                             where n.idproduto    = p.idproduto
                               and n.idnotafiscal = vidnotafiscal
                               and not exists ( select 1
                                                from movimentosestoquesinsumos mi
                                                where mi.iditemnf = n.iditnf ) )
                  loop
                    --
                    -- movimenta estoque da filial que está recebendo
                    --
                    begin
                      --
                      select e.idestoqueinsumo
                      into videstoqueinsumo
                      from estoquesinsumos e
                      where e.idfilial = rnota.idfilialdestino
                        and e.idproduto = i.idprodutorecebido;
                      --
                    exception
                      when others then
                         --
                         select seq_idestoqueinsumo.nextval
                         into videstoqueinsumo
                         from dual;
                         --
                         insert into estoquesinsumos ( idestoqueinsumo , idfilial
                                                     , idproduto       , ativo
                                                     , valor           , entrada
                                                     , saida           , atual )
                         values ( videstoqueinsumo     , rnota.idfilialdestino
                                , i.idprodutorecebido  , 'S'
                                , null                 , 0
                                , 0                    , 0 );
                         
                         --
                         commit;
                    end;
                    --
                    insert into movimentosestoquesinsumos ( idmovtoestoqueinsumo , idestoqueinsumo
                                                          , idproduto            , idfilial
                                                          , iditemnf             , usuario
                                                          , datamovimento        , tipo
                                                          , quantidade           , observacao
                                                          , idsemana )
                    values ( seq_idmovtoestoqueinsumo.nextval
                           , videstoqueinsumo
                           , i.idprodutorecebido
                           , rnota.idfilialdestino
                           , i.iditnf
                           , v('APP_USER')
                           , sysdate
                           , 'E'
                           , i.qtd_chegou
                           , 'Recebimento da nota '||rnota.documento
                           , pck_util.fnc_idsemanadata(sysdate) );
                    --
                  end loop;
                  --
                  update notasfiscais
                  set situacaofilial = 'R'
                    , emailrecebimento = 'S'
                    , dataconfirmacao = sysdate
                  where idnotafiscal = vidnotafiscal;
                  -- 
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Recebimento realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1483895962540945086
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'CONFIRMAR_RECEBIMENTO' 
                  and :P25_TIPONOTA = 'I'
                  and :P25_IDFORNEMITENTE is not null
                ```
        }
    )

    process confirma-recebimento-insumos-transf (
        name: Confirma Recebimento Insumos Transf
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  i integer;
                  vidnotafiscal    number := :P25_IDNOTAFISCAL;
                  videstoqueinsumo number;
                  --
                  cursor cnota is
                    select *
                    from notasfiscais
                    where idnotafiscal = vidnotafiscal;
                  --
                  rnota cnota%rowtype;
                  --
                begin
                --
                  open cnota;
                  fetch cnota into rnota;
                  close cnota;
                  --
                  for i in ( select n.idproduto
                                  , n.idprodutorecebido 
                                  , n.qtd_total_chegou
                                  , p.comissao
                                  , p.precovenda
                                  , ( nvl(n.qtd_pp_chegou,0)
                                    + nvl(n.qtd_p_chegou,0)
                                    + nvl(n.qtd_m_chegou,0)
                                    + nvl(n.qtd_g_chegou,0)
                                    + nvl(n.qtd_gg_chegou,0)
                                    + nvl(n.qtd_egg_chegou,0)
                                    + nvl(n.qtd_exgg_chegou,0)
                                    + nvl(n.qtd_u_chegou,0) ) qtd_chegou
                                  , n.iditnf
                             from itemnf n
                                , produtos p
                             where n.idproduto    = p.idproduto
                               and n.idnotafiscal = vidnotafiscal
                               and not exists ( select 1
                                                from movimentosestoquesinsumos mi
                                                where mi.iditemnf = n.iditnf ) )
                  loop
                    --
                    -- movimenta estoque da filial que está recebendo
                    --
                    begin
                      --
                      select e.idestoqueinsumo
                      into videstoqueinsumo
                      from estoquesinsumos e
                      where e.idfilial = rnota.idfilialdestino
                        and e.idproduto = i.idprodutorecebido;
                      --
                    exception
                      when others then
                         --
                         select seq_idestoqueinsumo.nextval
                         into videstoqueinsumo
                         from dual;
                         --
                         insert into estoquesinsumos ( idestoqueinsumo , idfilial
                                                     , idproduto       , ativo
                                                     , valor           , entrada
                                                     , saida           , atual )
                         values ( videstoqueinsumo     , rnota.idfilialdestino
                                , i.idprodutorecebido  , 'S'
                                , null                 , 0
                                , 0                    , 0 );
                         
                         --
                         commit;
                    end;
                    --
                    insert into movimentosestoquesinsumos ( idmovtoestoqueinsumo , idestoqueinsumo
                                                          , idproduto            , idfilial
                                                          , iditemnf             , usuario
                                                          , datamovimento        , tipo
                                                          , quantidade           , observacao
                                                          , idsemana )
                    values ( seq_idmovtoestoqueinsumo.nextval
                           , videstoqueinsumo
                           , i.idprodutorecebido
                           , rnota.idfilialdestino
                           , i.iditnf
                           , v('APP_USER')
                           , sysdate
                           , 'E'
                           , i.qtd_chegou
                           , 'Recebimento da nota '||rnota.documento
                           , pck_util.fnc_idsemanadata(sysdate) );
                    --
                    select e.idestoqueinsumo
                    into videstoqueinsumo
                    from estoquesinsumos e
                    where e.idfilial = rnota.idfilialemitente
                      and e.idproduto = i.idprodutorecebido;
                    --
                    insert into movimentosestoquesinsumos ( idmovtoestoqueinsumo , idestoqueinsumo
                                                          , idproduto            , idfilial
                                                          , iditemnf             , usuario
                                                          , datamovimento        , tipo
                                                          , quantidade           , observacao
                                                          , idsemana )
                    values ( seq_idmovtoestoqueinsumo.nextval
                           , videstoqueinsumo
                           , i.idprodutorecebido
                           , rnota.idfilialemitente
                           , i.iditnf
                           , v('APP_USER')
                           , sysdate
                           , 'S'
                           , i.qtd_chegou
                           , 'Recebimento da Transferência de Insumos '||rnota.documento
                           , pck_util.fnc_idsemanadata(sysdate) );
                    --
                  end loop;
                  --
                  update notasfiscais
                  set situacaofilial = 'R'
                    , emailrecebimento = 'S'
                    , dataconfirmacao = sysdate
                  where idnotafiscal = vidnotafiscal;
                  -- 
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 80
        }
        successMessage {
            successMessage: Recebimento realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1514215265004934940
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'CONFIRMAR_RECEBIMENTO' 
                  and :P25_TIPONOTA = 'I'
                  and :P25_IDFILIALEMITENTE is not null
                ```
        }
    )

    process confirma-recebimento-parcial (
        name: Confirma recebimento Parcial
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  i integer;
                  vidnotafiscal  number := :P25_IDNOTAFISCAL;
                  videstoque     number;
                  vtipofilialemitente varchar2(1);
                  --
                  cursor cnota is
                    select *
                    from notasfiscais
                    where idnotafiscal = vidnotafiscal;
                  --
                  rnota cnota%rowtype;
                  --
                  vnomefornecedor varchar2(1000);
                  --
                  vcount number := 0;
                  vtotalitens number := 0;
                  --
                begin
                --
                  open cnota;
                  fetch cnota into rnota;
                  close cnota;
                  --
                  begin
                    select tipofilial
                    into vtipofilialemitente
                    from vw_filiais 
                    where idfilial = rnota.idfilialemitente;
                  exception
                  when NO_DATA_FOUND then
                    vtipofilialemitente := 'X';
                  end;
                  --
                  select count(1)
                  into vtotalitens
                  from itemnf n
                  where n.idnotafiscal = vidnotafiscal;
                  --
                  for i in ( select n.idproduto
                                  , n.idprodutorecebido 
                                  , n.qtd_total_chegou
                                  , p.comissao
                                  , p.precovenda
                                  , n.qtd_pp_chegou
                                  , n.qtd_p_chegou
                                  , n.qtd_m_chegou
                                  , n.qtd_g_chegou
                                  , n.qtd_gg_chegou
                                  , n.qtd_egg_chegou
                                  , n.qtd_exgg_chegou
                                  , n.qtd_u_chegou
                                  , n.iditnf
                             from itemnf n
                                , produtos p
                             where n.idproduto    = p.idproduto
                               and n.idnotafiscal = vidnotafiscal
                               and n.confirmar    = 'S'
                               and not exists ( select 1
                                                from movimentosestoquefilial me
                                                where me.iditemnf = n.iditnf ) )
                  loop
                    --
                    -- movimenta estoque da filial que está recebendo
                    --
                    begin
                      select e.idestoquefilial
                      into videstoque
                      from estoquefilial e
                      where e.idfilial = rnota.idfilialdestino
                        and e.idproduto = i.idprodutorecebido;
                      --
                      /*update estoquefilial
                      set ativo = 'S'
                      where idestoquefilial = videstoque;*/
                      --
                    exception
                      when others then
                         --
                         select seq_idestoquefil.nextval
                         into videstoque
                         from dual;
                         --
                         insert into estoquefilial ( idestoquefilial  , idfilial  , idproduto
                                                   , ativo     , comissao
                                                   , vlrvenda         , qtd_pp    , qtd_p
                                                   , qtd_m            , qtd_g     , qtd_gg
                                                   , qtd_egg          , qtd_u )
                         values ( videstoque        , rnota.idfilialdestino  , i.idprodutorecebido
                                ,  'N'                    , null/*i.comissao*/
                                , null /*i.precovenda*/      , 0                      , 0
                                , 0                 , 0                      , 0
                                , 0  , 0  );             
                         
                         --
                         commit;
                    end;
                    --
                    insert into movimentosestoquefilial ( idmovtoestoquefilial , idestoquefil  , idfilial  
                                                        ,  observacao    , usuario
                                                        , datamovimento        , qtd_pp        , qtd_p
                                                        , qtd_m                , qtd_g         , qtd_gg
                                                        , qtd_egg              , qtd_exgg      , qtd_u 
                                                        , iditemnf)
                    values ( seq_idmovtoestoquefilial.nextval   , videstoque                             , rnota.idfilialdestino
                           ,  'Recebimento da nota'||rnota.documento , v('APP_USER')
                           , sysdate                            , i.qtd_pp_chegou                        , i.qtd_p_chegou
                           , i.qtd_m_chegou                     , i.qtd_g_chegou                         , i.qtd_gg_chegou
                           , i.qtd_egg_chegou                   , i.qtd_exgg_chegou                      , i.qtd_u_chegou
                           , i.iditnf ); 
                    --        @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
                    -- @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
                    -- movimenta estoque da filial que enviou a mercadoria
                    --@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
                    --        @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
                    
                    if rnota.idfilialemitente is not null and rnota.tipoemitente != 'FOR' and vtipofilialemitente != 'F' then  
                      -- movimenta produto que saiu da filial emitente
                     begin
                       begin
                         select e.idestoquefilial
                         into videstoque
                         from estoquefilial e
                         where e.idfilial = rnota.idfilialemitente
                           and e.idproduto = i.idproduto;
                       exception
                         when others then
                           --
                           select seq_idestoquefil.nextval
                           into videstoque
                           from dual;
                           --
                           insert into estoquefilial ( idestoquefilial  , idfilial  , idproduto
                                                     , ativo     , comissao
                                                     , vlrvenda         , qtd_pp    , qtd_p
                                                     , qtd_m            , qtd_g     , qtd_gg
                                                     , qtd_egg          , qtd_exgg  , qtd_u )
                           values ( videstoque        , rnota.idfilialemitente  , i.idprodutorecebido
                                  ,  'N'                    , null/*i.comissao*/
                                  , null /*i.precovenda*/      , i.qtd_pp_chegou         , i.qtd_p_chegou
                                  , i.qtd_m_chegou                 , i.qtd_g_chegou                      , i.qtd_gg_chegou
                                  , i.qtd_egg_chegou  , i.qtd_exgg_chegou , i.qtd_u_chegou   );        
                           --
                           commit;
                       end;
                      --
                      insert into movimentosestoquefilial ( idmovtoestoquefilial , idestoquefil  , idfilial  
                                                          , observacao    , usuario
                                                          , datamovimento        , qtd_pp        , qtd_p
                                                          , qtd_m                , qtd_g         , qtd_gg
                                                          , qtd_egg              , qtd_exgg      , qtd_u 
                                                          , iditemnf)
                      values ( seq_idmovtoestoquefilial.nextval   , videstoque                             , rnota.idfilialemitente
                             ,  'Recebimento da nota '||rnota.documento||' na filial '||pck_romance.fnc_nomefilial(rnota.idfilialdestino) , v('APP_USER')
                             , sysdate                            , i.qtd_pp_chegou  *-1                      , i.qtd_p_chegou*-1
                             , i.qtd_m_chegou *-1                    , i.qtd_g_chegou  *-1                       , i.qtd_gg_chegou*-1
                             , i.qtd_egg_chegou  *-1                 , i.qtd_exgg_chegou  *-1      , i.qtd_u_chegou  *-1
                             , i.iditnf); 
                      --  
                      --exception   
                        --when others then
                          --null;
                      end;
                    end if;
                    --
                  end loop;
                  --
                  select count(1)
                  into vcount
                  from itemnf n
                  where n.idnotafiscal = vidnotafiscal
                    and n.confirmar    = 'S';
                  --
                  if vtotalitens = vcount then
                    --
                    update notasfiscais
                    set situacaofilial = 'R'
                      , emailrecebimento = 'S'
                      , dataconfirmacao = sysdate
                    where idnotafiscal = vidnotafiscal;
                    --
                  else
                    --
                    update notasfiscais
                    set situacaofilial = 'P'
                      , dataconfirmacao = sysdate
                      , emailrecebimento = 'S'
                    where idnotafiscal = vidnotafiscal;
                    --
                  end if;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 100
        }
        advanced {
            executionMappingIdentifier: 1539419655151078449
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'RECEBIMENTO_PARCIAL'
                ```
        }
    )

