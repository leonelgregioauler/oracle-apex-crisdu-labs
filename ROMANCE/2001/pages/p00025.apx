    region itens-aguardando-recebimento (
        name: Itens Aguardando Recebimento
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                IDITNF,
                IDITNF IDITNF_DISPLAY,
                IDNOTAFISCAL,
                IDPRODUTORECEBIDO IDPRODUTORECEBIDO,
                QTD_PP_CHEGOU,
                QTD_P_CHEGOU,
                QTD_M_CHEGOU,
                QTD_G_CHEGOU,
                QTD_GG_CHEGOU,
                QTD_EGG_CHEGOU,
                QTD_EXGG_CHEGOU,
                QTD_TOTAL_CHEGOU,
                QTD_U_CHEGOU,
                OBSERVACAOFILIAL,
                CONFIRMAR,
                'N' EDITAVEL,
                null,
                (select iddefeitofornecedor 
                 from defeitosfornecedores
                 where iditemnf = it.IDITNF) iddefeitofornecedor
                
                from ITEMNF it
                where idnotafiscal = :P25_IDNOTAFISCAL
                  and not exists ( select 1
                                   from movimentosestoquefilial me
                                   where me.iditemnf = it.iditnf )
                  and it.idproduto is not null
                
                ```
        }
        layout {
            sequence: 42
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from notasfiscais
                where situacaofilial = 'R'
                  and idnotafiscal = :P25_IDNOTAFISCAL
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
