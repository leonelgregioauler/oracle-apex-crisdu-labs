    pageItem P25_TEXTO (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 360
            region: @recebimento-de-compra
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v_ret  varchar2(1000);
                  v_ret2 varchar2(1000);
                  v_controle number;
                begin
                  --
                  if :P25_TIPONOTA = 'T' then
                    --
                    if ( NVL(:P25_MEI,'N') = 'N' and 
                         :P25_DATALIBERARECEB is null ) and
                       (:P25_IDRAZAOSOCIALEMITENTE IS NULL or
                        :P25_IDRAZAOSOCIALDESTINO  IS NULL or
                        :P25_IDFILIALDESTINO       IS NULL or
                        :P25_NFE                   IS NULL or
                        :P25_DTNF                  IS NULL or
                        :P25_DATAVENCIMENTONFE     IS NULL ) then
                      --
                      v_ret := 'Nota Fiscal não está apta para ser recebida! ' ||
                              'Para receber é preciso: Mei=Sim ou o emitente autorizar o recebimento na tela '||
                              'de Transferência';
                      v_controle := 0;
                      v_ret2 := ' ou ainda completar os campos: ';
                      --
                      if :P25_IDRAZAOSOCIALEMITENTE IS NULL then
                        v_ret2 := v_ret2 || '  Razão Social Emitente';
                        v_controle := 1;
                      end if;
                      --
                      if :P25_IDRAZAOSOCIALDESTINO IS NULL then
                        v_ret2 := v_ret2 || '  Razão Social Destino';
                        v_controle := 1;
                      end if;
                      --
                      if :P25_IDFILIALDESTINO IS NULL then
                        v_ret2 := v_ret2 || '  Empresa Destino';
                        v_controle := 1;
                      end if;
                      --
                      if :P25_NFE IS NULL then
                        v_ret2 := v_ret2 || '  NFe';
                        v_controle := 1;
                      end if;
                      --
                      if :P25_DTNF IS NULL then
                        v_ret2 := v_ret2 || '  Data Nota';
                        v_controle := 1;
                      end if;
                      --
                      if :P25_DATAVENCIMENTONFE IS NULL then
                        v_ret2 := v_ret2 || '  Data Vencimento NFe';
                        v_controle := 1;
                      end if;
                      --
                      if nvl(v_controle,0) = 0 then
                        --
                        RETURN (v_ret);
                        --
                      else
                        --
                        RETURN (v_ret || v_ret2);
                        --
                      end if;
                      --
                      --
                    end if;
                    --
                  end if;
                  --
                  RETURN ('');
                end;
                ```
        }
    )

