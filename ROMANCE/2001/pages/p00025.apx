            sequence: 10
            region: @itens-aguardando-recebimento
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 290
                items: {
                    P290_IDNOTAFISCAL: &P25_IDNOTAFISCAL.
                    P290_IDITNF:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from acessos 
                where idaplicacao=4011
                  and ativo = 'S'
                  and usuario = v('APP_USER')
                ```
        }
    )

