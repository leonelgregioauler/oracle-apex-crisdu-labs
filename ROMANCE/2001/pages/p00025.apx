            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select codigosisdist
                           from produtos p
                          where p.idproduto = i.idproduto )||' - '||pck_romance.fnc_nomeproduto(i.idprodutorecebido) as diplay_value
                     , i.iditnf as retun_value
                  from roman.itemnf i
                 where i.idnotafiscal = :P25_IDNOTAFISCAL
                   and exists ( select 1
                                  from roman.movimentosestoquefilial me
                                 where me.iditemnf = i.iditnf )
                   and exists ( select 1
                                  from notasfiscais nf
                                 where nf.idnotafiscal = i.idnotafiscal
                                   and nf.situacaofilial in ('P','R'))
                 order by 2
                ```
