    process atualiza-data (
        name: atualiza data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vidnotafiscal  number := :P25_IDNOTAFISCAL;
                  vcontrole number;
                  --
                begin
                  --
                  select count(*)
                    into vcontrole
                    from notasfiscais
                   where idnotafiscal = vidnotafiscal
                     and ( mei = 'S' and
                           dataliberareceb is not null )
                      or ( datavencimentonfe     is not null and
                           idfilialdestino       is not null and 
                           idrazaosocialemitente is not null and 
                           idrazaosocialdestino  is not null and
                           valortotal            is not null and
                           nfe                   is not null);
                  --
                  if :P25_TIPONOTA = 'T' and 
                    nvl(vcontrole,0) = 1 then
                    --
                    update notasfiscais
                       set datarecebimento       = :P25_DATAVENCIMENTONFE
                         , datavencimentonfe     = :P25_DATAVENCIMENTONFE
                         , mei                   = nvl(:P25_MEI,'N')
                         , nfe                   = :P25_NFE
                     where idnotafiscal = vidnotafiscal;
                    --
                  else
                    --
                    update notasfiscais
                       set datarecebimento       = :P25_DATARECEBIMENTO
                         , nfe                   = :P25_NFE
                     where idnotafiscal = vidnotafiscal;
                    --
                  end if;
                  --
                  if :P25_TIPONOTA = 'T' then
                    --
                    update notasfiscais
                       set valortotal            = to_number(:P25_VALORTOTAL, '999999999999990D00')
                         , dtnf                  = :P25_DTNF
                         , nfe                   = :P25_NFE
                         , datavencimentonfe     = :P25_DATAVENCIMENTONFE
                         , idrazaosocialemitente = :P25_IDRAZAOSOCIALEMITENTE
                         , idrazaosocialdestino  = :P25_IDRAZAOSOCIALDESTINO
                     where idnotafiscal = vidnotafiscal;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: "Data de recebimento atualizada com sucesso! "
        }
        error {
            errorMessage: Ocorreu um erro ao receber os produtos no estoque! Contate o Adminsitrador!
        }
        advanced {
            executionMappingIdentifier: 1483895523562945086
        }
        serverSideCondition {
            type: request=Value
            value: SAVE
        }
    )

