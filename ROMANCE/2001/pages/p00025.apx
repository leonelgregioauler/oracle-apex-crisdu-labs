    button confirmar-recebimento (
        buttonName: CONFIRMAR_RECEBIMENTO
        label: Recebimento Total da NF
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Confirma o Recebimento Total da NF?','RECEBER');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                -- Se! o parametro Contabiliza for = "Não", Libera o uso do botão
                -- não existe este parâmetro para Franquias, OK.
                select 1
                  from roman.parametros p
                 where p.idfilial = :P0_IDFILIAL
                   and p.nome = 'CONTABILIZAEMPRESA'
                   and p.valor = 'N'
                   and :P25_SITUACAOFILIAL != 'R'
                   
                union all
                
                -- Se! a nota estiver data de liberação recebimento é por que foi liberado para recebimento
                -- ao clicar no botão "Libera Recebimento"
                select 1
                  from roman.notasfiscais n
                 where n.idnotafiscal = :P25_IDNOTAFISCAL
                   and n.dataliberareceb is not null
                
                union all
                
                -- Se! for Nota de Compra ou Insumo, não precisa validar
                -- Revisar
                select 1
                  from dual 
                 where :P25_SITUACAOFILIAL != 'R'
                   and not exists ( select 1
                                      from itemnf i
                                     where i.idnotafiscal = :P25_IDNOTAFISCAL 
                                       and ( i.qtd_pp_chegou   is null
                                         and i.qtd_p_chegou    is null
                                         and i.qtd_m_chegou    is null
                                         and i.qtd_g_chegou    is null
                                         and i.qtd_gg_chegou   is null
                                         and i.qtd_egg_chegou  is null
                                         and i.qtd_exgg_chegou is null
                                         and i.qtd_u_chegou    is null ) )
                   and :P25_TIPONOTA in ('C','I')
                
                 union all
                
                -- Aqui sim, se nenhum dos critérios acima foi atendido, então realiza a validação dos compos obrigando o preenchimento.
                select 1 
                  from dual
                 where :P25_SITUACAOFILIAL != 'R'
                   and not exists ( select 1
                                      from itemnf i
                                     where i.idnotafiscal = :P25_IDNOTAFISCAL 
                                       and ( i.qtd_pp_chegou   is null
                                         and i.qtd_p_chegou    is null
                                         and i.qtd_m_chegou    is null
                                         and i.qtd_g_chegou    is null
                                         and i.qtd_gg_chegou   is null
                                         and i.qtd_egg_chegou  is null
                                         and i.qtd_exgg_chegou is null
                                         and i.qtd_u_chegou    is null ) )
                  and ( :P25_TIPONOTA = 'T' )
                
                  union all
                
                  select 1
                  from roman.notasfiscais n
                 where n.idnotafiscal = :P25_IDNOTAFISCAL
                   and n.dataliberareceb is not null
                   and not ( :P25_TIPONOTA = 'C' and :P25_SITUACAOFILIAL = 'R' )
                ```
        }
    )

    button corrigir (
        buttonName: CORRIGIR
        label: Corrigir
        layout {
            sequence: 80
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 141
                items: {
                    P141_IDNOTAFISCAL: &P25_IDNOTAFISCAL.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P25_SITUACAOFILIAL in ('R','P')
                  and pck_util.fnc_verificaacesso(2304,v('APP_USER')) = 'S'
                --  and :P25_DATACONCLUSAO >= sysdate -2
                  and exists (select 1 
                              from correcoesnotasfiscais c
                              where c.idnotafiscal = :P25_IDNOTAFISCAL 
                                and c.usuario = 'OPTIMUS'
                                and trunc(sysdate) - trunc(c.datacorrecao) <= 1)
                  and exists (select 1 
                              from correcoesnotasfiscais c
                              where c.idnotafiscal = :P25_IDNOTAFISCAL 
                                and c.usuario = v('APP_USER')
                                and trunc(sysdate) - trunc(c.datacorrecao) <= 1)
                union
                select 1
                from dual
                where v('APP_USER') = 'DIEGOPIECHO'
                ```
        }
    )

