page 25 (
    name: Recebimento de Compra
    title: Recebimento de Compra
    appearance {
        pageTemplate: @/marquee
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function enviaemail()
            {
              vdocumento  = document.getElementById('P25_DOCUMENTO').value;
              vfornecedor = document.getElementById('P25_NOMEFORNECEDOR').value;
              vfilial     = document.getElementById('P0_NOMEFILIAL').value;
              vmensagem   = document.getElementById('P25_MENSAGEM').value;
              
               javascript:window.open("http://www.atacadofavorita.com.br/romance/sendmailrecebnota.php?documento="+vdocumento+
                                                                                                 "&fornecedor="+vfornecedor+
                                                                                                 "&filial="+vfilial+
                                                                                                 "&mensagem="+vmensagem
             ,'MAIL','toolbar=no,location=no,status=no,menubar=yes,scrollbars=no,resizable=no,width=2,height=2,left=400,top=400','_blank'); void(0);  		
               
            }
            
            function fnc_popup_correcao()
            {
              vidnf = document.getElementById('P25_IDNOTAFISCAL').value;
              window.open('f?p=&APP_ID.:141:&SESSION.::NO::P141_IDCORRECAORECEBNOTA,P141_IDNOTAFISCAL:,'+vidnf ,'CORRECAO', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=700,height=300,left=600,top=100','_blank'); void(0);
            }
            
            function fnc_popup_imprimenf(vidnotafiscal)
            {
              window.open('f?p=&APP_ID.:237:&SESSION.::NO::P237_IDNOTAFISCAL:'+vidnotafiscal, 'Imprime NF','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=900,height=600,left=5,top=5'); void(0);
            }
            
            function fnc_popup_defeito(vidnotafiscal,pidproduto,piditemnf,piddefeito)
            {
              if (piddefeito == -1) {
                piddefeito = ""; 
              }
              
              window.open('f?p=&APP_ID.:249:&SESSION.::NO::P249_IDNOTAFISCAL,P249_IDPRODUTO,P249_IDITEMNF,P249_IDDEFEITOFORNECEDOR:'+vidnotafiscal+','+pidproduto+','+piditemnf+','+piddefeito, 'Defeito','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=600,height=300,left=5,top=5'); void(0);
            }
            ```
    }
