    region correções-de-recebimento-de-compra (
        name: Correções de Recebimento de Compra
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.datacorrecao "Data da Correção"
                  , c.usuario "Usuário"
                  , c.motivo "Motivo"
                from correcoesnotasfiscais c
                where idnotafiscal = :P25_IDNOTAFISCAL
                ```
