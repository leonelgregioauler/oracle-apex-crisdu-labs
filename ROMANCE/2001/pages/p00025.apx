    region itens-recebidos (
        name: Itens Recebidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDITNF
                     , IDITNF IDITNF_DISPLAY
                     , IDNOTAFISCAL
                     , IDPRODUTO
                     , ( select codigosisdist
                         from produtos p
                         where p.idproduto = it.idproduto )||' - '||pck_romance.fnc_nomeproduto(IDPRODUTORECEBIDO) PRODUTO
                     , QTD_PP_CHEGOU
                     , QTD_P_CHEGOU
                     , QTD_M_CHEGOU
                     , QTD_G_CHEGOU
                     , QTD_GG_CHEGOU
                     , QTD_EGG_CHEGOU
                     , QTD_EXGG_CHEGOU
                     , QTD_TOTAL_CHEGOU
                     , QTD_U_CHEGOU
                     , OBSERVACAOFILIAL
                     , null
                     , ( select iddefeitofornecedor 
                         from defeitosfornecedores
                         where iditemnf = it.IDITNF) iddefeitofornecedor
                from ITEMNF it
                where idnotafiscal = :P25_IDNOTAFISCAL
                  and exists ( select 1
                               from movimentosestoquefilial me
                               where me.iditemnf = it.iditnf )
                  and exists ( select 1
                               from notasfiscais nf
                               where nf.idnotafiscal = it.idnotafiscal
                                 and nf.situacaofilial in ('P','R') )
                 order by 1
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from ITEMNF it
                where idnotafiscal = :P25_IDNOTAFISCAL
                  and exists ( select 1
                                   from movimentosestoquefilial me
                                   where me.iditemnf = it.iditnf )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 10000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 2999837615514274122
        }

