        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2001;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':484:'||l_session||'::NO::P484_IDFILIAL,P484_IDCAMPANHA,P484_TIPO,P484_IDGRUPO,P484_IDCAMPANHAFILIAL:'||:P0_IDFILIAL||','||:P582_IDCAMPANHA||','||:P582_TIPO||','||:P582_IDGRUPO||','||:P582_IDCAMPANHAFILIAL,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
