            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select f.idgrupo
                from filiais f
                   , gruposromance g
                where f.idgrupo = g.idgrupo
                  and (:P0_IDFILIAL = -1 or f.idfilial = :P0_IDFILIAL);
                ```
        }
