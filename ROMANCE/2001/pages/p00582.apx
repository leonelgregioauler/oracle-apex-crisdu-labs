    pageItem P582_IDCAMPANHA (
        type: selectList
        label {
            label: <b>Campanha</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.descricao||' ('||c.semanaini||' até '||c.semanafim||')' display_value
                     , c.idcampanha return_value
                from campanhas c
                where c.ativa = 'S'
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidcampanha number;
                begin
                  --
                  select c.idcampanha
                  into vidcampanha
                  from campanhas c
                  where c.ativa = 'S';
                  --
                  return vidcampanha;
                  --
                exception
                  when others then
                    null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

