                items: {
                    P582_IDCAMPANHA: &P582_IDCAMPANHA.
                    P582_TIPO: &P582_TIPO.
                    P582_IDCAMPANHAFILIAL: &P582_IDCAMPANHAFILIAL.
                    P582_SEMANAINICIO: &P582_SEMANAINICIO.
                    P582_SEMANAFIM: &P582_SEMANAFIM.
                    P582_IDGRUPO: &P582_IDGRUPO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

