    region pontuação-de-distribuidores (
        name: Pontuação de Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rownum posicao
                     , empresa "Filial"
                     , distribuidor "Representante"
                     , contacertos "Contagem de Acertos"
                     , mediageral
                     , mediaromance
                     , mediafavorita
                     , cnpj
                     , vendaecommerce
                from ( select t.*
                       from (  
                           select p.empresa
                                , p.distribuidor
                                , p.idpessoa
                                , m.cnpj
                                , p.contagemacertos contacertos
                                , p.mediageral
                                , p.mediaromance
                                , p.mediafavorita
                                , p.vendaecommerce
                           from vw_pontuacaogeral_rmc p
                              , mei m
                              , catal.filiais f
                           where f.idfilial = p.idfilial
                             and (    ( :P0_IDFILIAL = -1 )                   -- TODAS AS FILIAIS
                                   or ( :P0_IDFILIAL = -2 and f.ididioma = 1) -- TODAS AS FILIAIS DO BRASIL 
                                   or ( :P0_IDFILIAL = -3 and f.ididioma > 1) -- TODAS AS FILIAIS DA AMERICA LATINA
                                   or ( :P0_IDFILIAL in (1,2,3,4) and f.regional = :P0_IDFILIAL) -- TRATA O FILTRO DE FILIAIS POR REGIONAL
                                   or ( :P0_IDFILIAL != 1135 and f.idfilial = :P0_IDFILIAL ) 
                                   or ( :P0_IDFILIAL  = 1135 and exists (select pc.idfilial
                                                                           from catal.filiais pc --pc->Pertence Comercial
                                                                          where pc.pertencecomercialromance = 'S'
                                                                            and pc.idfilial = f.idfilial )))
                                   
                             and p.idpessoa = m.idpessoa(+)
                           order by mediageral desc ) t )
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
