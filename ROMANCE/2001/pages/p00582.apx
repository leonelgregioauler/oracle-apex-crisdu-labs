    process busca-informações-de-campanha (
        name: Busca Informações de Campanha
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vsemanainicio     varchar2(10);
                  vsemanafim        varchar2(10);
                  vidcampanhafilial number;
                  vidcampanha       number;
                  --
                begin
                  --
                  if :P582_TIPO is null then
                    --
                    :P582_TIPO := 'E';
                    --
                  end if;
                  --
                  if :P582_TIPO = 'E' then
                    --
                    select idcampanhafilial
                         , cf.semanainicio
                         , cf.semanafim
                    into vidcampanhafilial
                       , vsemanainicio
                       , vsemanafim
                    from campanhasfiliais cf
                       , campanhas c
                    where cf.idfilial = :P0_IDFILIAL
                      and c.idcampanha = cf.idcampanha
                      and c.ativa      = 'S';
                    --
                  elsif :P582_TIPO = 'G' then
                    --
                    select idcampanhafilial
                         , cf.semanainicio
                         , cf.semanafim
                    into vidcampanhafilial
                       , vsemanainicio
                       , vsemanafim
                    from campanhasfiliais cf
                       , campanhas c
                    where cf.idfilial = ( select min(idfilial)
                                          from vw_filiais f
                                          where f.idgrupo = :P582_IDGRUPO )
                      and c.idcampanha = cf.idcampanha
                      and c.ativa      = 'S';
                    --
                  end if;
                  --
                  :P582_SEMANAINICIO     := vsemanainicio;
                  :P582_SEMANAFIM        := vsemanafim;
                  :P582_IDCAMPANHAFILIAL := vidcampanhafilial;
                  --
                exception
                  when others then
                    null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 4772546813642176329
        }
    )

    branch (
        name: Go To Page 483
        execution {
