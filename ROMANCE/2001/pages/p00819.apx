    pageItem P819_GUIAENVIO (
        type: selectList
        label {
            label: "Guia Envio : "
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.idguiaentregabrinde d
                     , g.idguiaentregabrinde r
                from roman.guiasentregasbrindes g 
                where g.dataenvio is not null
                  and g.idfilial = :P819_IDFRANQUIA --:P819_LOJA
                  and exists (select 1 
                              from roman.campanhasconquistoulevou cp
                              where cp.idconquistoulevou = g.idconquistoulevou
                                and cp.status = 'S')
                
                ```
        }
        cascadingLov {
            parentItems: P819_IDFRANQUIA
        }
        layout {
            sequence: 50
            region: @recebimento-de-brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDGUIAENTREGABRINDE
            used: always
        }
        default {
            type: item
            item: P819_GUIAENVIO
        }
        comments {
            comments: Retorna as guias de envio de acordo com a filial do usuário.
        }
    )

    pageItem P819_IDCAMPANHA (
        type: selectList
        label {
            label: "Campanha : "
            alignment: left
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                
                select cp.nomecampanha
                     , cp.idconquistoulevou
                from roman.campanhasconquistoulevou cp
                where cp.status = 'S'
                  and trunc(sysdate) between cp.datadivulgacao and cp.datafimdivulgacao
                  and cp.idpais = ( select f.ididioma
                                    from catal.filiais f
                                    where f.idfilial = :P819_IDFRANQUIA)
                
                                 
                          
                ```
        }
        cascadingLov {
            parentItems: P819_IDFRANQUIA
        }
        layout {
            sequence: 30
            region: @recebimento-de-brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        comments {
            comments: Retorna somente a campanha que esta ativa ou seja que a data atual esteja dentro do período de divulgação da campanha.
        }
    )

    pageItem P819_IDCUPOM (
        type: hidden
        layout {
            sequence: 60
            region: @recebimento-de-brindes
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select cl.idconquistoulevoucupom
                from roman.conquistoulevoucupons cl 
                   , roman.guiasentregascupons gc
                   , roman.guiasentregasbrindes ge
                where cl.idconquistoulevoucupom = gc.idconquistoulevoucupom
                  and gc.idguiaentregabrinde = ge.idguiaentregabrinde
                  and cl.datarecebfilial is null
                  and ge.idguiaentregabrinde = :P819_GUIAENVIO
                ```
        }
        default {
            type: item
            item: P819_IDCUPOM
        }
    )

    pageItem P819_IDFRANQUIA (
        type: selectList
        label {
            label: Franquia :
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(g.idfilial) loja
                     , g.idfilial
                from catal.usuarios u 
                   , catal.gerentes g 
                where g.idgerente = u.idgerente
                  and u.usuario = v('APP_USER')
                  and exists (select 1 
                              from roman.parametros pr
                              where pr.nome = 'CONQUISTOULEVOULOJA'
                                and pr.idfilial = g.idfilial
                                and pr.valor = 'FR')
                  
                union 
                select roman.pck_romance.fnc_nomefilial(gb.idfilial) loja
                    , gb.idfilial
                from roman.guiasentregasbrindes gb
                   , roman.guiasentregascupons gc
                   , roman.conquistoulevoucupons cp 
                where gb.idguiaentregabrinde = gc.idguiaentregabrinde
                  and gc.idconquistoulevoucupom = cp.idconquistoulevoucupom
                  and exists (select 1 
                              from roman.parametros pr
                              where pr.nome = 'CONQUISTOULEVOULOJA'
                                and pr.idfilial = gb.idfilial
                                and pr.valor = 'FR')
                  and exists ( select 1
                                 from roman.usuariosgruposatendimento ug
                                 where ug.usuario = v('APP_USER')
                                   and ug.idgrupoatendimento in (0,1,2) )-- Grupo TI
                  
                ```
        }
        layout {
            sequence: 10
            region: @recebimento-de-brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        comments {
            comments: Traz a filial do usuário baseado no cadastro do seu gerente e também valida o parâmetro para o tipo de loja.
        }
    )

