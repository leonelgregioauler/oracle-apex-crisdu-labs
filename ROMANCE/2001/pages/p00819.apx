    region cupons-guia-de-envios (
        name: Cupons Guia de Envios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ge.idguiaentregabrinde
                     , cl.idconquistoulevoucupom
                     , roman.pck_romance.fnc_nomevendedora(cl.idvendedora) Vendedora 
                     , ge.dataemissao
                     , ge.dataenvio
                     , cl.datarecebfilial
                     , cl.retiradopor
                     , cl.idvendedora
                     , roman.pck_romance.fnc_nomefilial(ge.idfilial) Franquia
                     , (select descricao from table(catal.pck_util.fnc_siglasistema('TIPO_SITUACAO_CONQ_LEVOU_CUPONS',cl.situacao)) ) AS situacao_cupom
                from roman.conquistoulevoucupons cl 
                   , roman.guiasentregascupons gc
                   , roman.guiasentregasbrindes ge
                where cl.idconquistoulevoucupom = gc.idconquistoulevoucupom
                  and gc.idguiaentregabrinde = ge.idguiaentregabrinde
                  and ge.dataenvio is not null
                  and ge.idguiaentregabrinde = :P819_GUIAENVIO
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
