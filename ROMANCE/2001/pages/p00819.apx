    button receberfaltante (
        buttonName: RECEBERFALTANTE
        label: Receber Brindes Parcial
        layout {
            sequence: 40
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.guiasentregasbrindes ge
                where ge.idguiaentregabrinde = :p819_guiaenvio
                  and (
                       /* situação 1: ainda não marcada como itens faltantes */
                       ( ge.itensfaltantes is null )
                       or
                       /* situação 3: recebimento parcial (já existe cupom recebido) */
                       (
                           ge.itensfaltantes = 'S'
                           and exists (
                                select 1
                                from roman.itensfaltantes it
                                where it.idguiaentregabrinde = ge.idguiaentregabrinde
                           )
                           and exists (
                                select 1
                                from roman.guiasentregascupons gec
                                   , roman.conquistoulevoucupons clc
                                where gec.idguiaentregabrinde   = ge.idguiaentregabrinde
                                  and clc.idconquistoulevoucupom = gec.idconquistoulevoucupom
                                  and clc.datarecebfilial is not null
                           )
                       )
                  )
                ```
        }
    )

