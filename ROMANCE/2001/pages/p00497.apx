    region negociações-versão-nova (
        name: Negociações Versão Nova
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idnegociacao
                     , w.tiponegociacao
                     , w.filial
                     , w.distribuidor
                     , w.pessoa
                     , w.data 
                     , w.usuario
                     , w.valor
                     , w.valorjuros
                     , w.valortotal
                     , w.entrada
                     , w.valorpago
                     , w.saldo
                     , w.observacao
                     , w.perda
                     , w.idfechamento
                     , w.valordescontonegociacao
                     , decode(w.cancelado,'S','Sim','Não') Cancelado
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2650 || ':405:'||v('APP_SESSION')||'::NO::P405_IDNEGOCIACAO:'||w.idnegociacao,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""></a>' Link
                from vw_negociacoes_rmc w
                where ( :P497_TIPO = 'T'
                      or ( :P497_TIPO = 'A' and w.saldo > 0  )
                      or ( :P497_TIPO = 'P' and w.saldo = 0 ) 
                      or ( :P497_TIPO = 'V' and exists (select 1
                                                          from roman.pagamentosnegociacoes p
                                                         where p.situacao = 'V'
                                                           and p.idnegociacao = w.idnegociacao) ) )
                  and ( :P497_DATA_INICIO is null or trunc(w.data) between to_date(:P497_DATA_INICIO) and to_date(:P497_DATA_FIM) )
                  --and :P497_FILTRAR = 'S'
                  and ( :P497_TIPO_NEGOCIACAO is null or w.idtiponegociacao = :P497_TIPO_NEGOCIACAO) -- BALANCO
                  --and (:P497_PESSOA is null or w.idpessoa = :P497_PESSOA)
                  --and (:P497_FECHAMENTO = 999999999999 or w.idfechamento = :P497_FECHAMENTO)
                  /*and  ( :P497_VISUALIZAR = -1 --todos
                    or ( :P497_VISUALIZAR = 1 and exists ( select 1 --brasil
                                                             from vw_filiais f
                                                             where f.idfilial = w.idfilial
                                                               and f.idgrupo is not null
                                                               and f.ididioma = 1 ) )
                    or ( :P497_VISUALIZAR = 2 and exists ( select 1 --america latina
                                                             from vw_filiais f
                                                             where f.idfilial = w.idfilial
                                                               and f.idgrupo is not null
                                                               and f.ididioma != 1 )) )*/
                  and (:P497_IDFILIAL = -1 or w.idfilial = :P497_IDFILIAL)
                  and (:P497_IDREPRESENTANTE is null or w.idrepresentante = :P497_IDREPRESENTANTE)
                order by 6 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
