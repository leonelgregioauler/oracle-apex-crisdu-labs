    pageItem P497_IDREPRESENTANTE (
        type: selectOne
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) d
                     , r.idrepresentante r
                from representantes r
                where r.idgerente in ( select idgerente 
                                      from gerentes g
                                         , filiais fil
                                      where g.idfilial = fil.idfilial
                                        and ( :P497_IDFILIAL = -1  -- Todos
                                          or ( :P497_IDFILIAL = -2 and fil.idgrupo != 5  ) -- Brasil
                                          or ( :P497_IDFILIAL = -3 and fil.idgrupo  = 5  ) -- America Latina
                                          or ( :P497_IDFILIAL >  0 and g.idfilial = :P497_IDFILIAL )))
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P497_IDFILIAL
        }
        layout {
            sequence: 30
            region: @ações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

