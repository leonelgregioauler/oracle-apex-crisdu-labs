    region controle-de-negociações-de-balanços-antiga (
        name: Controle de Negociações de Balanços (Antiga)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nb.idnegociacaobalanco
                     , nb.idfilial
                     , nb.empresa
                     , nb.idrepresentante
                     , nb.distribuidor
                     , nb.idsemana
                     , nb.semana
                     , nb.data
                     , nb.observacao
                     , nb.valor
                     , nb.valorpago
                     , nb.valordesconto
                     , ( nb.valor - nb.valorpago - nb.valordesconto ) saldo
                     , nb.qtdparcelas
                     , cancelado
                     , vencido
                from vw_negociacoesbalanco nb
                   , filiais fil
                where nb.idfilial = fil.idfilial
                  and (:P497_IDREPRESENTANTE is null or nb.idrepresentante = :P497_IDREPRESENTANTE )
                  and ( :P497_TIPO = 'T' 
                       or ( :P497_TIPO = 'A' and (nb.valor - nb.valorpago - nb.valordesconto) > 0 and nb.vencido = 'Não') -- Aberto
                       or ( :P497_TIPO = 'P' and (nb.valor - nb.valorpago - nb.valordesconto) = 0 and nb.vencido = 'Não') -- Quitados
                       or ( :P497_TIPO = 'V' and nb.vencido = 'Sim')) -- Vencidos
                  and (:P497_DATA_INICIO is null or trunc(nb.data) between :P497_DATA_INICIO and :P497_DATA_FIM)
                  and ( :P497_IDFILIAL = -1  -- Todos
                     or ( :P497_IDFILIAL = -2 and fil.idgrupo != 5  ) -- Brasil
                     or ( :P497_IDFILIAL = -3 and fil.idgrupo  = 5  ) -- America Latina
                     or ( :P497_IDFILIAL >  0 and nb.idfilial = :P497_IDFILIAL ))
                  and :P497_IDNEGOCIACAOBALANCO is null
                union
                select nb.idnegociacaobalanco
                     , nb.idfilial
                     , nb.empresa
                     , nb.idrepresentante
                     , nb.distribuidor
                     , nb.idsemana
                     , nb.semana
                     , nb.data
                     , nb.observacao
                     , nb.valor
                     , nb.valorpago
                     , nb.valordesconto
                     , ( nb.valor - nb.valorpago - nb.valordesconto ) saldo
                     , nb.qtdparcelas
                     , cancelado
                     , vencido
                from vw_negociacoesbalanco nb
                   , filiais fil
                where nb.idfilial = fil.idfilial
                  and nb.idnegociacaobalanco = :P497_IDNEGOCIACAOBALANCO
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma informação encontrada!
        }
        advanced {
            savedReportMappingIdentifier: 4690108477460107939
        }

