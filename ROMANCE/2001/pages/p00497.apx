    process restringe-filial-por-grupo-de-atendimento (
        name: Restringe Filial por Grupo de Atendimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vacessototal varchar2(1);
                  vidfilial    number;
                begin
                  select case
                           when exists ( select 1
                                           from roman.usuariosgruposatendimento uga
                                          where uga.usuario = v('APP_USER')
                                            and uga.idgrupoatendimento in (0,2,104,20) )
                           then 'S'
                           else 'N'
                         end
                    into vacessototal
                    from dual;
                  --
                  if vacessototal = 'N' then
                    begin
                      select g.idfilial
                        into vidfilial
                        from catal.usuarios u
                           , catal.gerentes g
                       where u.idgerente = g.idgerente
                         and u.usuario   = v('APP_USER');
                    exception
                      when no_data_found then
                        vidfilial := null;
                    end;
                    --
                    :P497_IDFILIAL := vidfilial;
                  end if;
                end;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 9500000000000000010
        }
    )

