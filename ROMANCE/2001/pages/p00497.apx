    pageItem P497_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select opcoes.display_value
                     , opcoes.return_value
                from ( select '- Todas - ' display_value
                            , -1 return_value
                            , 'T' tipolinha
                         from dual
                       union all
                       select '- Brasil - ' display_value
                            , -2 return_value
                            , 'T' tipolinha
                         from dual
                       union all
                       select '- América Latina - ' display_value
                            , -3 return_value
                            , 'T' tipolinha
                         from dual
                       union all
                       select nome display_value
                            , idfilial return_value
                            , 'F' tipolinha
                         from vw_filiais f
                        where f.ativo = 'S'
                          and f.tipofilial = 'D' ) opcoes
                   , ( select case
                                when exists ( select 1
                                                from roman.usuariosgruposatendimento uga
                                               where uga.usuario = v('APP_USER')
                                                 and uga.idgrupoatendimento in (0,2,104,20) )
                                then 'S'
                                else 'N'
                              end acessototal
                         from dual ) acesso
                where ( acesso.acessototal = 'S' )
                   or ( acesso.acessototal = 'N'
                        and opcoes.tipolinha = 'F'
                        and opcoes.return_value = ( select g.idfilial
                                                       from catal.usuarios u
                                                          , catal.gerentes g
                                                      where u.idgerente = g.idgerente
                                                        and u.usuario   = v('APP_USER') ) )
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @ações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: static
            staticValue: -1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P497_IDNEGOCIACAOBALANCO (
        type: hidden
        layout {
            sequence: 90
            region: @ações
            slot: regionBody
        }
