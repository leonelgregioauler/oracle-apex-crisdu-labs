page 477 (
    name: Cadastro de Notificação Judicial
    title: Cadastro de Notificação Judicial
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-notificação-judicial (
        name: Cadastro de Notificação Judicial
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P477_DATAENTREGA (
        type: datePickerJquery
        label {
            label: Data da Entrega
            alignment: left
        }
        layout {
            sequence: 60
            region: @cadastro-de-notificação-judicial
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P477_DATAINCLUSAO (
        type: datePickerJquery
        label {
            label: Data da Inclusão
            alignment: left
        }
        layout {
            sequence: 50
            region: @cadastro-de-notificação-judicial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P477_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(u.idfilial) display_value
                     , u.idfilial return_value
                from usuariosfiliais u
                where u.usuario = v('APP_USER')
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @cadastro-de-notificação-judicial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P477_IDNOTIFICACAOJUDICIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-notificação-judicial
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P477_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' ('||decode(ativo,'S','Ativo','N','Inativo')||')' display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P477_IDFILIAL)
                order by 1  
                ```
        }
        cascadingLov {
            parentItems: P477_IDFILIAL
        }
        layout {
            sequence: 30
            region: @cadastro-de-notificação-judicial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P477_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' - '||nvl(documentoestrangeiro,cpf) display_value
                     , idvendedora return_value
                from pessoas p
                   , vendedoras v
                where v.idpessoa = p.idpessoa
                  and ( :P477_IDFILIAL is null or v.idfilial = :P477_IDFILIAL )
                  and ( :P477_IDREPRESENTANTE is null or v.idrepresentante = :P477_IDREPRESENTANTE )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: [
                P477_IDFILIAL
                P477_IDREPRESENTANTE
            ]
        }
        layout {
            sequence: 40
            region: @cadastro-de-notificação-judicial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P477_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @cadastro-de-notificação-judicial
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P477_RESULTADO (
        type: textarea
        label {
            label: Resultado
            alignment: left
        }
        layout {
            sequence: 80
            region: @cadastro-de-notificação-judicial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
            height: 5
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P477_USUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @cadastro-de-notificação-judicial
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: v('APP_USER')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P477_VALORDIVIDA (
        type: textField
        label {
            label: Valor Dívida
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 70
            region: @cadastro-de-notificação-judicial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @cadastro-de-notificação-judicial
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P477_IDNOTIFICACAOJUDICIAL
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 10
            region: @cadastro-de-notificação-judicial
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P477_IDNOTIFICACAOJUDICIAL
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @cadastro-de-notificação-judicial
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P477_IDNOTIFICACAOJUDICIAL
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @cadastro-de-notificação-judicial
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 476
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-valor-incluido (
        name: Valida Valor Incluido
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P477_VALORDIVIDA <= 0
                ```
        }
        error {
            errorMessage: Por favor, informe um valor válido.
            associatedItem: @P477_VALORDIVIDA
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SAVE','CREATE')
                ```
        }
    )

    process consulta-em-notificacoes-judiciais (
        name: Consulta em Notificacoes Judiciais
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                  --
                  PCK_CADASTROS_RMC.PRC_NOTIFICACOESJUDICIAIS( PIDNOTIFICACAOJUDICIAL => :P477_IDNOTIFICACAOJUDICIAL,
                                                               PIDFILIAL => :P477_IDFILIAL,
                                                               PIDREPRESENTANTE => :P477_IDREPRESENTANTE,
                                                               PIDVENDEDORA => :P477_IDVENDEDORA,
                                                               PDATAINCLUSAO => :P477_DATAINCLUSAO,
                                                               PDATAENTREGA => :P477_DATAENTREGA,
                                                               PRESULTADO => :P477_RESULTADO,
                                                               PVALORDIVIDA => :P477_VALORDIVIDA,
                                                               PUSUARIO => :P477_USUARIO,
                                                               PMD5 => :P477_MD5,
                                                               POPERACAO_DML => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1534784178277038042
        }
    )

    process processo-dml-em-notificacoes-judiciais (
        name: Processo DML em Notificacoes Judiciais
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'CREATE' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SAVE' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETE' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  PCK_CADASTROS_RMC.PRC_NOTIFICACOESJUDICIAIS( PIDNOTIFICACAOJUDICIAL => :P477_IDNOTIFICACAOJUDICIAL,
                                                               PIDFILIAL => :P477_IDFILIAL,
                                                               PIDREPRESENTANTE => :P477_IDREPRESENTANTE,
                                                               PIDVENDEDORA => :P477_IDVENDEDORA,
                                                               PDATAINCLUSAO => :P477_DATAINCLUSAO,
                                                               PDATAENTREGA => :P477_DATAENTREGA,
                                                               PRESULTADO => :P477_RESULTADO,
                                                               PVALORDIVIDA => :P477_VALORDIVIDA,
                                                               PUSUARIO => :P477_USUARIO,
                                                               PMD5 => :P477_MD5,
                                                               POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1539371796553821620
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CREATE','SAVE','DELETE')
                ```
        }
    )

    branch (
        name: Go To Page 477
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 477
                items: {
                    P477_IDNOTIFICACAOJUDICIAL:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETE
        }
    )

    branch (
        name: Go To Page 477
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 477
                items: {
                    P477_IDNOTIFICACAOJUDICIAL: &P477_IDNOTIFICACAOJUDICIAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SAVE','CREATE')
                ```
        }
    )

)

