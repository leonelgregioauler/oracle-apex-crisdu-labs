page 147 (
    name: Excluir Notas Brancas
    alias: LIMPARNOTASBRANCAS
    title: Excluir Notas Brancas
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            
            function formatar_mascara(src,mascara,evt){
            var tecla;  
            if(evt.which){tecla = evt.which}
            else if(evt.keyCode){ tecla = evt.keyCode;}  
             if( tecla != 8 ){
             var campo = src.value.length;
             var saida = mascara.substring(0,1);
             var texto = mascara.substring(campo);
             if(texto.substring(0,1) != saida) {
             src.value+=texto.substring(0,1);}}
            }
            
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region parâmetros (
        name: Parâmetros
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
    )

    pageItem P147_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @representantes-2
            nullDisplayValue: - Selecione o Representante -
        }
        layout {
            sequence: 10
            region: @parâmetros
            slot: regionBody
            alignment: left
            columnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P147_SEMANA (
        type: textField
        label {
            label: Semana
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @parâmetros
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 4000
        }
        advanced {
            customAttributes: "onkeyPress=\"javascript:{formatar_mascara(this, '##/###',event); }\""
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 10
            region: @parâmetros
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process limparnotas (
        name: limparnotas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  delete notasvendas n
                  where idrepresentante = :P147_IDREPRESENTANTE
                    and semanadistribuicao = :P147_SEMANA
                    and not exists ( select 1
                                     from itensnotavenda i
                                     where i.idnotavenda = n.idnotavenda )
                    and not exists ( select 1
                                     from correcoesnotasvendas i
                                     where i.idnotavenda = n.idnotavenda );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Notas brancas excluídas com sucesso!
        }
        error {
            errorMessage: Ocorreu um erro ao excluir as notas brancas!
        }
        advanced {
            executionMappingIdentifier: 310037762656904315
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 147
                successMessage: false
            }
        }
        comments {
            comments: Created 22-JUN-2012 16:58 by ROMAN
        }
    )

)

