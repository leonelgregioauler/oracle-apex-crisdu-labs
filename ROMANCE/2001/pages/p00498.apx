    process cancelar-negociação-balanço (
        name: Cancelar Negociação Balanço
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    
                    /* Define o status da negociação de balanço como cancelado*/
                    update roman.negociacoesbalanco n
                       set n.cancelado = 'S'
                     where n.idnegociacaobalanco = :P498_IDNEGOCIACAOBALANCO;
                
                    /* Ajusta a situação das parcelas da negociação para cancelado (OBS: AJUSTA SOMENTE PARCELAS NÃO QUITADAS)*/
                    update roman.parcelanegociacaobalanco p
                       set p.situacao = 'CAN'
                     where p.idnegociacaobalanco = :P498_IDNEGOCIACAOBALANCO
                       and p.situacao != 'QUI';
                
                    /* Exibe mensagem aviso de sucesso*/
                    apex_application.g_print_success_message := '<span style="color : white ">Negociação Balanço Cancelada com sucesso! </span>';
                
                    /* Confirma a alteração de cancelamento*/
                    Commit;
                
                /* Tratamento de erros da rotina de cancelamento*/
                exception
                    when others then
                        apex_error.add_error( p_message          => 'Erro ao tentar cancelar a negociação de balanço:  '|| SQLERRM
                   				            , p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 110
        }
        advanced {
            executionMappingIdentifier: 370056617997365520
        }
        serverSideCondition {
            whenButtonPressed: @cancelar-neg-balanco
        }
    )

    process consulta-em-negociacoes-de-balanços (
        name: Consulta em Negociacoes de Balanços
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdata       date;
                  vvalor      number;
                  vvalorjuros number;
                  vvalordescontonegociacao number;
                  --
                begin
                  --
                  PCK_ACERTOS_RMC.PRC_NEGOCIACOESBALANCO( PIDNEGOCIACAOBALANCO => :P498_IDNEGOCIACAOBALANCO,
                                                          PIDFILIAL => :P498_IDFILIAL,
                                                          PIDREPRESENTANTE => :P498_IDREPRESENTANTE,
                                                          PIDSEMANA => :P498_IDSEMANA,
                                                          PSEMANA => :P498_SEMANA,
                                                          PDATA => vdata, --:P498_DATA,
                                                          POBSERVACAO => :P498_OBSERVACAO,
                                                          PVALOR => vvalor,  --:P498_VALOR,
                                                          PVALORJUROS => vvalorjuros, --:P498_VALORJUROS,
                                                          PQTDPARCELAS => :P498_QTDPARCELAS,
                                                          PCANCELADO => :P498_CANCELADO,
                                                          PMD5 => :P498_MD5,
                                                          POPERACAO_DML => 'S',
                                                          PVALORDESCONTO => vvalordescontonegociacao, -- :P498_VALORDESCONTONEGOCIACAO
                                                          PCHEQUE => :P498_CHEQUE,
                                                          PIDMATRIZENTRADA => :P498_IDMATRIZENTRADA);
                  --
                  :P498_DATA := to_char(vdata,'DD/MM/RRRR HH24:MI:SS');
                  --
                  :P498_VALOR      := to_char(vvalor     ,'999G999G999G990D00');   
                  :P498_VALORJUROS := to_char(vvalorjuros,'999G999G999G990D00');
                  :P498_VALORDESCONTONEGOCIACAO := to_char(vvalordescontonegociacao,'999G999G999G990D00');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1564515823615810654
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P498_IDNEGOCIACAOBALANCO
        }
    )

