    pageItem P498_SALDO (
        type: displayOnly
        label {
            label: Saldo ( = )
            alignment: left
        }
        layout {
            sequence: 140
            region: @negociação-de-balanço
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select round(( nvl(n.valor,0) + nvl(n.valorjuros,0) ) - nvl(( select sum(pn.valorpago)
                                                                       from pagamentosnegociacoesbalanco pn
                                                                       where pn.idnegociacaobalanco = n.idnegociacaobalanco
                                                                         and pn.conferido           = 'S' ),0),2) pago
                from negociacoesbalanco n
                where n.idnegociacaobalanco = :P498_IDNEGOCIACAOBALANCO
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P498_IDNEGOCIACAOBALANCO
        }
        security {
            encryptSessionState: false
        }
    )

