page 498 (
    name: Negociação de Balanço
    title: Negociação de Balanço
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 80%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formataMoeda(valor){
                  v = valor.value;
                  v=v.replace(/\D/g,"") // permite digitar apenas numero
                  v=v.replace(/(\d{1})(\d{14})$/,"$1.$2") // coloca ponto antes dos ultimos digitos
                  v=v.replace(/(\d{1})(\d{11})$/,"$1.$2") // coloca ponto antes dos ultimos 11 digitos
                  v=v.replace(/(\d{1})(\d{8})$/,"$1.$2") // coloca ponto antes dos ultimos 8 digitos
                  v=v.replace(/(\d{1})(\d{5})$/,"$1.$2") // coloca ponto antes dos ultimos 5 digitos
                  v=v.replace(/(\d{1})(\d{1,2})$/,"$1,$2") // coloca virgula antes dos ultimos 2 digitos
                  valor.value = v;
                };
            
            (function($) {
                
                function update(model) {
                    var salKey = model.getFieldKey("VALOR"),
                        total = 0,
                        count = 0;
            
                    console.log(">> Somando coluna VALOR...")
                    model.forEach(function(record, index, id) {
                        var valor = parseFloat(record[salKey].replaceAll(".","").replace(",",".")), 
                            meta = model.getRecordMetadata(id);
                        console.log(">> Linha..." + (count += 1) + " Valor " + valor)
                        //console.log(">> Linha..." + valor)
                        if (!isNaN(valor) && !meta.deleted && !meta.agg) {
                            
                            total += valor;
                        }
                    });
                    console.log(">> Atualizando total parcelas para: " + total)
                    $s("P498_TOTAL_PARCELA", total.toFixed(2).replaceAll(".",",").replace(".",""));
                }
            
                $(function() {
                   
                    $("#emp").on("interactivegridviewmodelcreate", function(event, ui) {
                        var sid,
                            model = ui.model;
            
                        if ( ui.viewId === "grid" ) {
                            sid = model.subscribe( {
                                onChange: function(type, change) {
                                    console.log(">> model changed ", type, change);
                                    if ( type === "set" ) {
                                         if (change.field === "VALOR" ) {
                                            update( model );
                                        }
                                    } else if (type !== "move" && type !== "metaChange") {
                                      update( model );
                                    }
                                },
                                progressView: $("#P498_TOTAL_PARCELA") 
                            } );
                             update( model );           
                            model.fetchAll(function() {});
                        }
                    });
            
                });
            
            })(apex.jQuery);
            
            function fnc_deletar_parcela(pid)
            {
              apex.confirm("Deseja realmente excluir a parcela?", {
              request:"DELETA_PARCELAS",
              set:{"P498_IDPARCELANEGOCIACAOBALANCO":pid}
              });
            }
            
            
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region classificaçãoes-da-negociação (
        name: Classificaçãoes da Negociação
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select cl.idclassificacaonegociacao
                     , cl.idcaracteristicanegociacao
                     , cl.idnegociacao
                     , cl.dataclassificacao
                     , (select u.usuario
                          from usuarios u
                         where u.idusuario = cl.idusuario) usuario
                     , cl.observacao
                     , ca.descricao
                     , APEX_ITEM.CHECKBOX2(1, cl.idclassificacaonegociacao , NULL )  deletar
                  from classificacoesnegociacoes cl
                     , caracteristicasnegociacoes ca
                 where cl.idcaracteristicanegociacao = ca.idcaracteristicanegociacao
                   and cl.idnegociacaobalanco = :P498_IDNEGOCIACAOBALANCO
                   ORDER BY cl.dataclassificacao DESC
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from classificacoesnegociacoes cl
                 where cl.idnegociacaobalanco = :P498_IDNEGOCIACAOBALANCO
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
