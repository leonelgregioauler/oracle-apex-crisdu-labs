    region pagamentos-parcelas (
        name: Pagamentos Parcelas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pg.idpagamentonegociacao
                     , pg.idnegociacaobalanco
                     , pg.data
                     , pg.valorpago
                     , pg.desctipo tipo
                     , pg.descconferido conferido
                     , pg.descidentificacao identificacao
                     , pg.observacao
                     , pg.bompara
                     , pg.idparcelanegociacaobalanco
                from vw_pgtonegociacoesbalanco pg
                where pg.idnegociacaobalanco = :P498_IDNEGOCIACAOBALANCO
                  and pg.idparcelanegociacaobalanco is not null
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
        }
