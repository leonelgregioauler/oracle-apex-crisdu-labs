    process processo-dml-em-negociações-de-balanços (
        name: Processo DML em Negociações de Balanços
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vvalor        number;
                  vvalorjuros   number;
                  vdata         date;
                  voperacao_dml_gera_parcelas varchar2(1) := null;
                  vverifica     number;
                  vvalordescontonegociacao number;
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  if voperacao_dml != 'D' then 
                    --
                    :P498_SEMANA := pck_util.fnc_semanaid(:P498_IDSEMANA);
                    --
                    vdata := to_date(:P498_DATA,'DD/MM/RRRR HH24:MI:SS');
                    --
                    vvalor      := to_number(:P498_VALOR      ,'999G999G999G990D00');   
                    vvalorjuros := to_number(:P498_VALORJUROS ,'999G999G999G990D00');
                    vvalordescontonegociacao := to_number(:P498_VALORDESCONTONEGOCIACAO ,'999G999G999G990D00');
                    --
                  end if;
                  --
                  PCK_ACERTOS_RMC.PRC_NEGOCIACOESBALANCO( PIDNEGOCIACAOBALANCO => :P498_IDNEGOCIACAOBALANCO,
                                                          PIDFILIAL => :P498_IDFILIAL,
                                                          PIDREPRESENTANTE => :P498_IDREPRESENTANTE,
                                                          PIDSEMANA => :P498_IDSEMANA,
                                                          PSEMANA => :P498_SEMANA,
                                                          PDATA => vdata,
                                                          POBSERVACAO => :P498_OBSERVACAO,
                                                          PVALOR => vvalor,
                                                          PVALORJUROS => vvalorjuros,
                                                          PQTDPARCELAS => :P498_QTDPARCELAS,
                                                          PCANCELADO => :P498_CANCELADO,
                                                          PMD5 => :P498_MD5,
                                                          POPERACAO_DML => voperacao_dml,
                                                          PDATAPRIMEIRAPARCELA => :P498_DTVENCIMENTOPRIMEIRAPARCELA,
                                                          PDIAPRAZOPARCELAS => :P498_QTDDIASENTREPARCELAS,
                                                          PVALORDESCONTO => vvalordescontonegociacao,
                                                          PCHEQUE => :P498_CHEQUE,
                                                          PIDMATRIZENTRADA => :P498_IDMATRIZENTRADA );
