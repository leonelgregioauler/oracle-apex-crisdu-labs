    region parcela-negociação-balanço (
        name: Parcela Negociação Balanço
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pp.idparcelanegociacaobalanco
                     , pp.idnegociacaobalanco
                     , pp.valor
                     , (nvl(pp.valor,0) - (select nvl(sum(p.valorpago),0) from roman.pagamentosnegociacoesbalanco p where nvl(p.conferido,'N') = 'S' and p.idparcelanegociacaobalanco = pp.idparcelanegociacaobalanco)) vl_saldo
                     , pp.data_vencimento
                     , pp.cheque
                     , case 
                         when pp.situacao = 'ABE' then
                           'ABERTO'
                         when pp.situacao = 'QUI' then
                           'QUITADO'
                         when pp.situacao = 'VEN' then
                           'VENCIDO'
                         when pp.situacao = 'CAN' then
                           'CANCELADO'
                       end situacao
                     , pp.observacao
                     , decode(pp.cheque,'S','CH','DR') forma_pagto
                from roman.parcelanegociacaobalanco pp
                where pp.idnegociacaobalanco = :P498_IDNEGOCIACAOBALANCO
                  and pp.idparcelanegociacaobalanco is not null
                
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
