    process reverter-cancelamento (
        name: Reverter Cancelamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    
                    /* Define o status da negociação de balanço como não cancelado*/
                    update roman.negociacoesbalanco n
                       set n.cancelado = 'N'
                     where n.idnegociacaobalanco = :P498_IDNEGOCIACAOBALANCO;
                
                    /* Ajusta a situação das parcelas da negociação de CANCELADA para VENCIDA*/
                    update roman.parcelanegociacaobalanco p
                       set p.situacao = 'VEN'
                     where p.idnegociacaobalanco = :P498_IDNEGOCIACAOBALANCO
                       and p.situacao = 'CAN'
                       and trunc(data_vencimento) < trunc(sysdate);
                
                    /* Ajusta a situação das parcelas da negociação de CANCELADA para VENCIDA*/
                    update roman.parcelanegociacaobalanco p
                       set p.situacao = 'ABE'
                     where p.idnegociacaobalanco = :P498_IDNEGOCIACAOBALANCO
                       and p.situacao = 'CAN'
                       and trunc(data_vencimento) >= trunc(sysdate);
                
                
                    /* Exibe mensagem aviso de sucesso*/
                    apex_application.g_print_success_message := '<span style="color : black ">Revertido o cancelamento da Negociação Balanço com sucesso! </span>';
                
                    /* Confirma a alteração de cancelamento*/
                    Commit;
                
                /* Tratamento de erros da rotina de cancelamento*/
                exception
                    when others then
                        apex_error.add_error( p_message          => 'Erro ao tentar reverter o cancelamneto da negociação de balanço:  '|| SQLERRM
                   				            , p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 120
        }
        advanced {
            executionMappingIdentifier: 370059168695365545
        }
        serverSideCondition {
            whenButtonPressed: @reverter-cancelamento
        }
    )

