page 292 (
    name: Aprovação de Cadastros
    title: Aprovação de Cadastros
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region aprovação-de-cadastros (
        name: Aprovação de Cadastros
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null "ANALISAR"
                 , p.idpessoa "Cod Pessoa"
                 , p.nomepessoa "Nome"
                 , p.cpf "Cpf"
                 , p.rg "RG"
                 , pck_romance.fnc_nomerepresentante(p.idrepresentante) "Distribuidor que Atualizou"
                 , p.idpreatualizacao
                 , p.dataalteracao "Data Pré - Cadastro"
                 , decode(p.situacao,'A','Aprovado','R','Reprovado','P','Pendente') "Situação"
                 , p.semana 
                from preatualizacaocadastro p
                where exists ( select 1
                               from representantes r
                               where r.idrepresentante = p.idrepresentante
                                 and r.idgerente =  ( select idgerente
                                                      from gerentes g
                                                      where idfilial = :P0_IDFILIAL ) )
                  and p.situacao = 'P'                                     
                  and ( :P292_IDREPRESENTANTE_FILTRO is null or p.idrepresentante = :P292_IDREPRESENTANTE_FILTRO )
                  and ( :P292_SEMANA is null or p.semana = :P292_SEMANA )
                ```
            pageItemsToSubmit: [
                P292_IDREPRESENTANTE_FILTRO
                P292_SEMANA
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma atualização de cadastro encontrada!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 269434978332998842
        }

        column ANALISAR (
            type: link
            heading {
                heading: Analisar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 293
                    items: {
                        P293_IDPREATUALIZACAO: #IDPREATUALIZACAO#
                        P293_IDPESSOA: #Cod Pessoa#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt="">
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AM
            }
        )

        column "Cod Pessoa" (
            type: plainText
            heading {
                heading: Cod pessoa
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: V
            }
        )

        column Cpf (
            type: plainText
            heading {
                heading: Documento
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: W
            }
        )

        column "Data Pré - Cadastro" (
            type: plainText
            heading {
                heading: Data pré - cadastro
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: AQ
            }
        )

        column "Distribuidor que Atualizou" (
            type: plainText
            heading {
                heading: Distribuidor que atualizou
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AO
            }
        )

        column IDPREATUALIZACAO (
            type: hidden
            heading {
                heading: Idpreatualizacao
            }
            layout {
                sequence: 70
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: AP
            }
            security {
                escapeSpecialChars: false
            }
        )

        column Nome (
            type: plainText
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AN
            }
        )

        column RG (
            type: plainText
            heading {
                heading: Rg
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: N
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AS
            }
        )

        column Situação (
            type: plainText
            heading {
                heading: Situação
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AR
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 2694387 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ANALISAR (
                sequence: 1
            )

            displayColumn "Cod Pessoa" (
                sequence: 2
            )

            displayColumn "Cpf" (
                sequence: 5
            )

            displayColumn "Data Pré - Cadastro" (
                sequence: 7
            )

            displayColumn "Distribuidor que Atualizou" (
                sequence: 6
            )

            displayColumn "Nome" (
                sequence: 3
            )

            displayColumn RG (
                sequence: 4
            )

            displayColumn SEMANA (
                sequence: 9
            )

            displayColumn "Situação" (
                sequence: 8
            )

            sort (
                column: "Data Pré - Cadastro"
                sort {
                    sequence: 1
                }
            )

            controlBreak (
                column: "Distribuidor que Atualizou"
                layout {
                    sequence: 1
                }
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P292_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @aprovação-de-cadastros
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P292_IDREPRESENTANTE_FILTRO (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante return_value
                from representantes r
                where r.ativo = 'S'
                  and r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P292_SEMANA (
        type: textField
        label {
            label: Semana
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 292
                items: {
                    P292_IDREPRESENTANTE_FILTRO: &P292_IDREPRESENTANTE_FILTRO.
                    P292_SEMANA: &P292_SEMANA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

