    region ranking-da-semana (
        name: Ranking da Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.posicao
                     , t.distribuidor
                     , t.regiao
                     , t.total
                     , t.cnpj
                     , t.empresa
                from ( select rownum posicao
                            , t.*
                       from ( select pck_romance.fnc_nomerepresentante(r.idrepresentante) distribuidor
                                   , fr.totalgeral total
                                   , pck_romance.fnc_nomeregiaovenda(fr.idregiaovenda) regiao
                                   , cnpj
                                   , pck_romance.fnc_nomefilial(f.idfilial) empresa
                              from fechamentorepresentantes fr
                                 , fechamentossemanais f
                                 , representantes r
                                 , mei m
                                 , filiais l
                              where f.idfechamento    = fr.idfechamento
                                and r.idrepresentante = fr.idrepresentante
                                and r.idpessoa        = m.idpessoa(+)
                                and fr.idfilial       = l.idfilial
                                and f.idsemana        = :P585_IDSEMANACOBRANCA 
                                -- INICIO FILTRO FILIAL
                                and (   ( :P0_IDFILIAL = -1 )                                                        -- TODAS AS FILIAIS
                                     or ( :P0_IDFILIAL = -2 and l.ididioma = 1)                                      -- SOMENTE FILIAIS DO BRASIL
                                     or ( :P0_IDFILIAL = -3 and l.ididioma > 1)                                      -- SOMENTE FILIAIS FORA DO BRASIL 
                                     or ( :P0_IDFILIAL != 1135 and f.idfilial = :P0_IDFILIAL )                       -- SOMENTE FILIAIS SELECIONADA NA TELA
                                     or ( :P0_IDFILIAL  = 1135 and exists (select pc.idfilial
                                                                             from catal.filiais pc 
                                                                            where pc.pertencecomercialromance = 'S'
                                                                              and pc.idfilial = f.idfilial ))        -- FILIAL COMERCIAL ROMANCE 1135(NÃO SEI BEM O QUE É PRA SER)
                                     or ( :P0_IDFILIAL  in (1,2,3,4) and l.regional = :P0_IDFILIAL))                 -- BUSCA PELA REGIONAL
                                -- FINAL FILTRO FILIAL
                                and not exists (select 1
                                                  from catal.gerentes ge
                                                 where ge.idpessoa = r.idpessoa
                                                   and ge.ativo = 'S') -- Gerentes nao devem aparecer nesse relatorio T9549348
                              order by 2 desc ) t ) t
                order by 1
                ```
            pageItemsToSubmit: P585_IDSEMANACOBRANCA
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma cobrança localizada, verifique os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 6297987865274467678
        }

