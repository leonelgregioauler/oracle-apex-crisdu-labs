    region top-20-geral (
        name: Top 20 (Geral)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select fil.idsemana
                     , fe.semana
                     , pck_romance.fnc_nomerepresentante(fe.idrepresentante) repres
                     , nvl( ( select m.cnpj
                                from representantes r
                                   , mei m
                               where r.idrepresentante = fe.idrepresentante
                                 and m.idpessoa        = r.idpessoa ) , ' - ') cnpj
                     , fe.totalgeral
                     , pck_romance.fnc_nomefilial(fe.idfilial) empresa
                from fechamentorepresentantes fe
                   , ( select f.idsemana
                            , ( select fr.idfechamentorepres
                                  from fechamentorepresentantes fr
                                 where fr.idfechamentopontuacao = f.idfechamento
                                   and fr.totalgeral            = ( select max(ff.totalgeral)
                                                                      from fechamentorepresentantes ff
                                                                     where ff.idfechamentopontuacao = f.idfechamento 
                                                                       and ff.totalgeral > 0) ) idfechamentorepres
                         from fechamentossemanais f
                            , filiais l
                        where f.idfilial = l.idfilial
                          and  (   ( :P0_IDFILIAL  = -1 )                   -- TODAS AS FILIAIS
                                or ( :P0_IDFILIAL  = -2 and l.ididioma = 1) -- SOMENTE FILIAIS DO BRASIL
                                or ( :P0_IDFILIAL  = -3 and l.ididioma > 1) -- SOMENTE FILIAIS FORA DO BRASIL                 
                                or ( :P0_IDFILIAL != 1135 and f.idfilial = :P0_IDFILIAL ) 
                                or ( :P0_IDFILIAL  = 1135 and exists (select pc.idfilial
                                                                      from catal.filiais pc --pc->Pertence Comercial
                                                                     where pc.pertencecomercialromance = 'S'
                                                                       and pc.idfilial = f.idfilial))
                                or ( :P0_IDFILIAL  in (1,2,3,4) and l.regional = :P0_IDFILIAL) )
                        order by idsemana desc ) fil
                where fe.idfechamentorepres = fil.idfechamentorepres
                  and rownum <= 20;
                ```
            pageItemsToSubmit: P585_TIPO_PESQUISA
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
