    dynamicAction tipo-pesquisa-distribuidor (
        name: Tipo Pesquisa Distribuidor
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P585_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P585_TIPO_PESQUISA
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P585_IDREPRESENTANTE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P585_IDREPRESENTANTE
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 585
                items: {
                    P585_TIPO_PESQUISA: &P585_TIPO_PESQUISA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: REFRESH
        }
    )

