    pageItem P585_IDREPRESENTANTE (
        type: selectList
        label {
            label: <b>MEI</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' - '||decode(ativo,'S','Ativo','N','Inativo') d
                     , r.idrepresentante r
                  from representantes r
                 where :P0_IDFILIAL in (-1, -2, -3 )
                 or ( r.idgerente = ( select idgerente 
                                        from gerentes g
                                       where g.idfilial = :P0_IDFILIAL ))
                order by 1
                ```
            nullDisplayValue: - Selecione o Distribuidor -
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P585_IDSEMANACOBRANCA (
        type: selectList
        label {
            label: <b>Semana de Cobrança</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(semana)
                     , f.idsemana
                  from fechamentossemanais f
                     , catal.filiais fi
                 where f.idfilial = fi.idfilial
                   and (   ( :P0_IDFILIAL = -1 )                    -- TODAS AS FILIAIS
                        or ( :P0_IDFILIAL = -2 and fi.ididioma = 1) -- TODAS AS FILIAIS DO BRASIL
                        or ( :P0_IDFILIAL = -3 and fi.ididioma > 1) -- TODAS AS FILIAIS FORA DO BRASIL
                        or ( f.idfilial = :P0_IDFILIAL or (:P0_IDFILIAL = 1135 and exists ( select pc.idfilial
                                                                                             from catal.filiais pc --pc->Pertence Comercial
                                                                                            where pc.pertencecomercialromance = 'S'
                                                                                              and pc.idfilial = f.idfilial ))))
                  and :P0_IDFILIAL not in (1,2,3,4)
                  
                union
                
                select distinct(semana)
                     , f.idsemana
                from fechamentossemanais f
                   , filiais l
                where l.idfilial = f.idfilial
                  and :P0_IDFILIAL in (1,2,3,4)
                order by 2 desc
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

