    pageItem P459_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select P.CODIGOSISDIST ||' - '|| initcap(p.nomeproduto) display_value
                     , e.idestoquefilial return_value
                from produtos      p
                   , estoquefilial e
                where e.idproduto = p.idproduto
                  and e.idfilial = :P0_IDFILIAL
                  and e.ativo = 'S'
                order by p.nomeproduto
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @transferir-para-distribuição
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return :P459_IDPRODUTO;
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P459_IDSEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 240
            region: @transferir-para-distribuição
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDSEMANA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidsemana number;
                begin
                  --
                  select pck_util.fnc_idsemanadata(trunc(sysdate))
                  into vidsemana
                  from dual;
                  --
                  return vidsemana;
                  --
                exception
                  when others then
                    null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

