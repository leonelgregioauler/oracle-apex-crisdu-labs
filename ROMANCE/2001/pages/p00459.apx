    validation quantidade-movimentada (
        name: Quantidade movimentada >= 400
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where nvl(to_number(:P459_QTD_PP),0) >= 400
                   or nvl(to_number(:P459_QTD_P),0)>= 400
                   or nvl(to_number(:P459_TD_M),0) >= 400
                   or nvl(to_number(:P459_QTD_G),0) >= 400
                   or nvl(to_number(:P459_QTD_GG),0) >= 400
                   or nvl(to_number(:P459_QTD_EGG),0) >= 400
                   or nvl(to_number(:P459_QTD_EXGG),0) >= 400
                   or nvl(to_number(:P459_QTD_U),0) >= 400
                ```
        }
        error {
            errorMessage: Quantidade não permitida para movimentar o estoque! Realize o movimento em mais de um lançamento!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('CREATE','SALVAR')
                ```
        }
    )

    validation valida-uso-de-embalado-por (
        name: Valida Uso de Embalado Por
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P459_EMBALADOPOR
        }
        error {
            errorMessage: É necessário informar por quem foi realizado a Embalagem.
            associatedItem: @P459_EMBALADOPOR
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'CREATE'
                  and :P459_TRANSFEREPARAESTOQUE = 'D'
                ```
        }
    )

    validation validar-quantidade (
        name: Validar Quantidade
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(:P459_QTD_PP) >= 0
                  or to_number(:P459_QTD_P) >= 0
                  or to_number(:P459_QTD_M) >= 0
                  or to_number(:P459_QTD_G) >= 0
                  or to_number(:P459_QTD_GG) >= 0
                  or to_number(:P459_QTD_EGG) >= 0
                  or to_number(:P459_QTD_EXGG) >= 0
                  or to_number(:P459_QTD_U) >= 0
                ```
        }
        error {
            errorMessage: Informe uma quantidade Válida!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process busca-ultimo-embalado (
        name: Busca Ultimo Embalado
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vembaladopor varchar2(100);
                begin
                  --
                  select mr.embaladopor
                  into vembaladopor
                  from movimentosestoquereemb mr
                  where mr.idmovtoestreemb = ( select max(mer.idmovtoestreemb)
                                               from movimentosestoquereemb mer
                                               where mer.idfilial = :P0_IDFILIAL );
                  --
                  :P459_EMBALADOPOR := vembaladopor;
                  --
                exception
                  when others then
                    :P459_EMBALADOPOR := null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 6902549309822619
        }
    )

    process desfazer (
        name: DESFAZER
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    --
                    insert into movimentosestoquereemb( idmovtoestreemb    , idestoquefil         
                                                      , iditprodembal      , observacao           , usuario
                                                      , datamovimento      , idestoquereembalagem , idfilial
                                                      , qtd_pp             , qtd_p                , qtd_m
                                                      , qtd_g              , qtd_gg               , qtd_egg
                                                      , qtd_u              , transfereparaestoque , qtd_exgg 
                                                      , embaladopor)
                    select seq_idmovtoestreemb.nextval    , me.idestoquefil                      
                         , me.iditprodembal               , 'Transferência de estoque desfeita'  , v('APP_USER')
                         , sysdate                        , me.idestoquereembalagem              , e.idfilial
                         , me.qtd_pp  *-1                 , me.qtd_p       *-1                   , me.qtd_m       *-1                
                         , me.qtd_g   *-1                 , me.qtd_gg      *-1                   , me.qtd_egg     *-1                
                         , me.qtd_u   *-1                 , me.transfereparaestoque              , me.qtd_exgg    *-1
                         , me.embaladopor
                    from estoquefilial           e
                       , movimentosestoquereemb me
                    where e.idestoquefilial = me.idestoquefil
                      and me.idmovtoestreemb = :P459_IDDESFAZER
                      and nvl(transfereparaestoque,'N') = 'D';
                    --
                
                    --
                    update movimentosestoquereemb 
                    set desfeito = 'S'
                    where idmovtoestreemb = :P459_IDDESFAZER;
                    COMMIT;
                    --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Movimento desfeito com sucesso!
        }
        advanced {
            executionMappingIdentifier: 6902174094822619
        }
        serverSideCondition {
            type: request=Value
            value: DESFAZER
        }
    )

