    pageItem P459_EMBALADOPOR (
        type: selectList
        label {
            label: Embalado Por
            alignment: left
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                
                select pck_romance.fnc_nomepessoa(f.idpessoa) nome
                     , f.identificacao
                from funcionarios f
                where f.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                  and f.idcargo in (0,7)
                  and f.ativo     = 'S' 
                  and f.identificacao is not null
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @transferir-para-distribuição
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

