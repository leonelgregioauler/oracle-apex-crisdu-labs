    region movimentos-do-dia-reembalagem (
        name: Movimentos do Dia (Reembalagem)
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                
                p_where varchar2(4000);
                
                begin
                
                p_where := ' select * from ( 
                        select ( select initcap( nvl(p.apelido,p.nomepessoa ) ) 
                                 from filiais f
                                    , pessoas p
                                 where f.idpessoa = p.idpessoa
                                   and f.idfilial = e.idfilial ) "Filial"
                             , ( select ca.nome
                                 from categorias ca
                                 where ca.idcategoria = ( select pr.idcategoria 
                                                         from produtos    pr
                                                         where pr.idproduto = e.idproduto ) ) "Categoria"
                             , ( select initcap( pr.codigosisdist ) 
                                 from produtos    pr
                                 where pr.idproduto = e.idproduto ) "Código"      
                             , ( select initcap( pr.nomeproduto ) 
                                 from produtos    pr
                                 where pr.idproduto = e.idproduto ) "Produto"         
                             , ( select c.descricao 
                                 from cores c
                                 where c.idcor = e.idcor ) "Cor"
                             , e.idestoquefilial
                             , e.idfilial
                             , e.idproduto
                             , e.idcor
                             , me.observacao    "Observação"
                             , me.usuario       "Usuário"
                             , me.datamovimento "Data Movimento"
                             , trunc(me.datamovimento) "Dia"
                             , me.qtd_pp
                             , me.qtd_p
                             , me.qtd_m
                             , me.qtd_g
                             , me.qtd_gg
                             , me.qtd_egg
                             , me.qtd_exgg
                             , me.qtd_u 
                             , nvl(me.qtd_pp,0)
                             + nvl(me.qtd_p,0)
                             + nvl(me.qtd_m,0)
                             + nvl(me.qtd_g,0)
                             + nvl(me.qtd_gg,0)
                             + nvl(me.qtd_egg,0)
                             + nvl(me.qtd_exgg,0)
                             + nvl(me.qtd_u,0) "Quantidade"
                             , me.idmovtoestreemb
                             , me.transfereparaestoque
                             , case 
                                 when nvl(desfeito,''N'') = ''N'' then 
                                   case 
                                       when me.transfereparaestoque = ''D'' then
                                         (select ''<a href="javascript: desfazer(''||me.idmovtoestreemb||'')" ><img src="/i/menu/pencil2_16x16.gif" alt=""></a>''
                                          from dual
                                          where me.qtd_pp < 0
                                             or me.qtd_p  < 0
                                             or me.qtd_m  < 0
                                             or me.qtd_g  < 0
                                             or me.qtd_gg < 0
                                             or me.qtd_egg< 0
                                             or me.qtd_exgg< 0
                                             or me.qtd_u  < 0)
                                       else
                                          ''-''
                                       end 
                                 else  
                                    ''Já Desfeito''
                                 end  desfazer
                             , me.idmovtoestreemb "ID"
                             , embaladopor
                        from estoquefilial           e
                           , movimentosestoquereemb me
                        where me.datamovimento > (trunc(sysdate)-1)
                          and e.idestoquefilial = me.idestoquefil
                          and e.idfilial = (select v(''P0_IDFILIAL'') from dual) 
                        order by me.datamovimento desc )
                     where rownum < 31 ' ;
                
                
                return p_where;
                
                end;
                ```
        }
