    button bipar-produto (
        buttonName: BIPAR_PRODUTO
        label: Bipar produto
        layout {
            sequence: 10
            region: @transferir-para-distribuição
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 532
                items: {
                    P532_IDFILIAL: &P0_IDFILIAL.
                    P532_USUARIO: &P459_USUARIO.
                    P532_CODIGOBARRAS:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2034,v('APP_USER')) = 'S'
                ```
        }
    )

    button create (
        buttonName: CREATE
        label: Movimentar
        layout {
            sequence: 40
            region: @transferir-para-distribuição
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P459_IDMOVTOESTREEMB
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @transferir-para-distribuição
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
