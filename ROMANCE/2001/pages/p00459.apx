        helpText: Não há ajuda disponível para esta página.
    }

    region movimentos-de-estoque-distribuição (
        name: Movimentos de Estoque Distribuição
        type: classicReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                
                p_where varchar2(4000);
                
                begin
                
                p_where := '
                        select /*+ first_rows (100) */ ( select initcap( nvl(p.apelido,p.nomepessoa ) ) 
                                 from filiais f
                                    , pessoas p
                                 where f.idpessoa = p.idpessoa
                                   and f.idfilial = e.idfilial ) "Filial"
                             , ( select ca.nome
                                 from categorias ca
                                 where ca.idcategoria = ( select pr.idcategoria 
                                                         from produtos    pr
                                                         where pr.idproduto = e.idproduto ) ) "Categoria"
                             , ( select initcap( pr.codigosisdist ) 
                                 from produtos    pr
                                 where pr.idproduto = e.idproduto ) "Código"      
                             , ( select initcap( pr.nomeproduto ) 
                                 from produtos    pr
                                 where pr.idproduto = e.idproduto ) "Produto"         
                             , ( select c.descricao 
                                 from cores c
                                 where c.idcor = e.idcor ) "Cor"
                             , e.idestoquefilial
                             , e.idfilial
                             , e.idproduto
                             , e.idcor
                             , me.qtd_pp   
                             , me.qtd_p    
                             , me.qtd_m    
                             , me.qtd_g    
                             , me.qtd_gg   
                             , me.qtd_egg  
                             , me.qtd_exgg  
                             , me.qtd_u   
                             , me.observacao    "Observação"
                             , me.usuario       "Usuário"
                             , me.datamovimento "Data Movimento"
                             , trunc(me.datamovimento) "Dia"
                             , me.idmovtoestoquefilial
                        from estoquefilial           e
                           , movimentosestoquefilial me
                        where e.idestoquefilial = me.idestoquefil
                          and e.idfilial = (select v(''P0_IDFILIAL'') from dual) 
                        order by me.idmovtoestoquefilial desc  ';
                
                return p_where;
                
                end;
                ```
        }
