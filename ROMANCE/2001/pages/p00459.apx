    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vid       number;
                  vparametro varchar2(1) := :P459_TRANSFEREPARAESTOQUE;
                begin 
                  --
                  select pck_romance.fnc_retornaparametro( parametro => 'ESTOQUEEMBPORGRADE'
                                                         , pidfilial => :P0_IDFILIAL )  
                  into vparametro
                  from dual;
                  --
                  if :P459_OPCAO = 'P' then
                    :P459_IDESTOQUEFIL := :P459_IDPRODUTO;
                  end if;
                  --
                  begin
                    select e.idestoquereembalagem
                    into :P459_IDESTOQUEREEMBALAGEM  
                    from estoquereembalagem e
                    where e.idestoquefil  = :P459_IDESTOQUEFIL
                      and e.idfilial      = :P0_IDFILIAL;
                  exception
                    when no_data_found then
                      select seq_idestoquereemb.nextval
                      into :P459_IDESTOQUEREEMBALAGEM  
                      from dual;
                      --
                        insert into estoquereembalagem ( idestoquereembalagem  , idestoquefil  
                                                       , idfilial              , qtd_pp        , qtd_p    
                                                       , qtd_m                 , qtd_g         , qtd_gg   
                                                       , qtd_egg               , qtd_exgg       , qtd_u         )
                        VALUES ( :P459_IDESTOQUEREEMBALAGEM   , :P459_IDESTOQUEFIL   
                               , :P459_IDFILIAL               , 0                    , 0   
                               , 0                            , 0                    , 0   
                               , 0                            , 0                    , 0);      
                        --
                  end;
                  --
                  :P459_QTD_PP  := to_number(:P459_QTD_PP )*-1;
                  :P459_QTD_P   := to_number(:P459_QTD_P  )*-1;
                  :P459_QTD_M   := to_number(:P459_QTD_M  )*-1;       
                  :P459_QTD_G   := to_number(:P459_QTD_G  )*-1;
                  :P459_QTD_GG  := to_number(:P459_QTD_GG )*-1;
                  :P459_QTD_EGG := to_number(:P459_QTD_EGG)*-1;       
                  :P459_QTD_EXGG := to_number(:P459_QTD_EXGG)*-1;       
                  :P459_QTD_U   := to_number(:P459_QTD_U  )*-1;
                  --
                  if :P459_TRANSFEREPARAESTOQUE = 'D' then
                    --
                    :P459_OBSERVACAO :=  'Transferido para estoque distribuição. '||:P459_OBSERVACAO ;
                    --
                  else
                    --      
                    :P459_OBSERVACAO := 'Saída manual sem transferir para estoque distribuição. '||:P459_OBSERVACAO ;
                    --
                  end if;         
                  --
                  if :P459_IDMOVTOESTREEMB is null then
                    select "SEQ_IDMOVTOESTREEMB".nextval
                    into :P459_IDMOVTOESTREEMB
                    from dual;
                  end if;
                  --
                  :P459_EMBALADO := :P459_EMBALADOPOR;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 6900969149822619
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

