    region notas-para-gerar-tarefas (
        name: Notas para Gerar Tarefas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , v.idpessoa
                     , v.idvendedora
                     , nv.numeronota
                     , roman.pck_romance.fnc_nomevendedora(v.idvendedora) consultora
                     , pck_util.fnc_retornatelefones(v.idpessoa)Telefone
                     , roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor
                     , nv.datanota
                     , nv.dataenviadocobranca
                     , nvl(( select s.descricao
                             from catal.situacoespromissorias s
                             where s.idsituacaopromis = nv.idsituacaopromissoria ),'-') situacaopromissoria
                     , nv.valortotalnota
                     , nv.valortotalvenda
                     , nv.valortotalvendalqd
                     , nv.valorpago
                     , nv.saldo
                     , round(nv.saldo*nv.fatorconversao,2) Saldo2
                   --  , roman.pck_romance.fnc_cpfvendedora(v.idvendedora) cpf
                     , (select nvl(p.documentoestrangeiro,cpf)
                        from catal.pessoas p
                        where p.idpessoa = v.idpessoa)Documento
                     , ( select max(data)
                         from roman.notastarefasgeradas nf
                         where nf.idnotavenda = nv.idnotavenda) ultimatarefa
                     , nvl(( select max (cn.dataclassificado)
                             from roman.classificacoesnotasvendas cn
                             where cn.idnotavenda = nv.idnotavenda
                               and cn.idcaracteristicanotavenda = 42 ),null) dataenviadaspc
                from roman.notasvendas nv
                   , catal.vendedoras v
                where v.idvendedora = nv.idvendedora
                  and nv.enviadocobranca = 'S'
                  and nv.saldo > 0
                  and ( :P522_RESPCOBRANCA = 'A'
                   or ( :P522_RESPCOBRANCA = 'S' and nv.responsavelcobranca is not null )
                   or ( :P522_RESPCOBRANCA = 'N' and nv.responsavelcobranca is null ) )
                  and ( :P522_PROMISSORIARECEBIDA = 'A'
                   or ( :P522_PROMISSORIARECEBIDA = 'S' and nv.idsituacaopromissoria is not null )
                   or ( :P522_PROMISSORIARECEBIDA = 'N' and nv.idsituacaopromissoria is null ) )
                  and ( :P522_ASSINATURA_ELETRONICA = 'A'
                   or ( :P522_ASSINATURA_ELETRONICA = 'S' and exists ( select 1
                                                                       from classificacoesnotasvendas cn
                                                                       where cn.idcaracteristicanotavenda = 35
                                                                         and cn.idnotavenda               = nv.idnotavenda ) )
                   or ( :P522_ASSINATURA_ELETRONICA = 'N' and not exists ( select 1
                                                                           from classificacoesnotasvendas cn
                                                                           where cn.idcaracteristicanotavenda = 35
                                                                             and cn.idnotavenda               = nv.idnotavenda ) ) )
                  and ( :P522_IDFILIAL is null or nv.idfilial = :P522_IDFILIAL )
                  and ( :P522_IDREPRESENTANTE is null or nv.idrepresentante = :P522_IDREPRESENTANTE )
                  and ( :P522_TIPO_DATA is null
                     or ( :P522_TIPO_DATA = 'N' and trunc(nv.datanota) between to_date(:P522_DATAINICIO) and to_date(:P522_DATAFIM) )
                     or ( :P522_TIPO_DATA = 'C' and trunc(nv.dataenviadocobranca) between to_date(:P522_DATAINICIO) and to_date(:P522_DATAFIM) ) )
                  and not exists ( select 1
                                   from classificacoesnotasvendas cn
                                   where cn.idnotavenda = nv.idnotavenda
                                     and cn.idcaracteristicanotavenda = 30 )
                  and ( :P522_TAREFA_GERADA is null
                     or ( :P522_TAREFA_GERADA = 'S' and exists ( select 1
                                                                 from favorita.tarefas t
                                                                 where t.idtipotarefa in (35,53,55,52)
                                                                   and t.datainclusao < sysdate-30
                                                                   and t.idpessoa = v.idpessoa )
                                                    and not exists ( select 1
                                                                     from favorita.tarefas t
                                                                     where t.idtipotarefa in (35,53,55,52)
                                                                       and t.datainclusao > (sysdate-30)
                                                                       and t.idpessoa = v.idpessoa ) )
                     or ( :P522_TAREFA_GERADA = 'N' and not exists ( select 1
                                                                     from favorita.tarefas t
                                                                     where t.idtipotarefa in (35,53,55,52)
                                                                       and t.idpessoa = v.idpessoa ) ) )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
