    process gera-tarefas-de-cobrança (
        name: Gera Tarefas de Cobrança
        type: executeCode
        editableRegion: @notas-para-gerar-tarefas
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidusuario  number := :P522_ATENDENTE; 
                  vidpessoa   number;
                  vtelefone   varchar2(30) := null;
                  vcodigoarea number;
                  vidtarefa   number;
                  vtipotarefa number;
                  --
                  vidfilial   number := :P522_IDFILIAL;
                  vididioma   number;
                  --
                  vidgrupoatendimento number;
                  --
                begin
                  --
                  select f.ididioma
                  into vididioma
                  from vw_filiais f
                  where f.idfilial = vidfilial;
                  --
                  vidpessoa := :IDPESSOA;
                  --
                  for i in ( select translate(t.telefone,'0123456789AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvXxYyWwZz_-,.  Ññ~ !@#$%?&*()/??','0123456789') telefone
                             from telefonespessoas t
                             where t.idpessoa = vidpessoa
                             order by t.idtelefonepessoa desc )
                  loop
                    --
                    vtelefone := i.telefone;
                    vcodigoarea := substr(to_number(i.telefone),0,2);
                    --
                  end loop;
                  --
                  if vtelefone is not null then
                    --
                    select favorita.seq_idtarefa.nextval
                    into vidtarefa
                    from dual;
                    --
                    if :P522_ASSINATURA_ELETRONICA = 'S' then
                      vtipotarefa := 52;
                    else
                      vtipotarefa := 35;
                    end if;
                    --
                    if vididioma = 4 then
                      vtipotarefa := 53;
                      vidgrupoatendimento := 55;
                    elsif vididioma = 2 then
                      vtipotarefa := 55;
                      vcodigoarea := 598;
                      vidgrupoatendimento := 55;
                    elsif vididioma = 11 then
                      vidgrupoatendimento := 89;
                    elsif vididioma = 6 then
                      vidgrupoatendimento := 78;
                    else
                      vidgrupoatendimento := 3;
                    end if;
                    --
                    insert into favorita.tarefas ( idtarefa            , datainclusao    , idsituacao
                                                 , observacao          , idtipotarefa    , idpessoa
                                                 , idgrupoatendimento  , telefone        , codigoarea 
                                                 , idusuario           , idpais )
                    values ( vidtarefa,   sysdate,  0
                           , roman.pck_romance.fnc_retornatelefones(:IDVENDEDORA) , vtipotarefa  , vidpessoa
                           , vidgrupoatendimento , vtelefone , vcodigoarea
                           , vidusuario  , vididioma ); 
                    --
                    insert into notastarefasgeradas 
                    values (SEQ_IDNOTATAREFAGERADA.nextval, :IDNOTAVENDA, vidtarefa, sysdate);
                    --
                    commit;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Tarefas geradas com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1585703575170339338
        }
        serverSideCondition {
            type: request=Value
            value: GERAR_TAREFAS
        }
    )

    branch (
        name: Go To Page 522
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 522
                items: {
                    P522_IDFILIAL: &P522_IDFILIAL.
                    P522_IDREPRESENTANTE: &P522_IDREPRESENTANTE.
                    P522_PROMISSORIARECEBIDA: &P522_PROMISSORIARECEBIDA.
                    P522_ATENDENTE: &P522_ATENDENTE.
                    P522_ASSINATURA_ELETRONICA: &P522_ASSINATURA_ELETRONICA.
                    P522_DATAINICIO: &P522_DATAINICIO.
                    P522_DATAFIM: &P522_DATAFIM.
                    P522_TIPO_DATA: &P522_TIPO_DATA.
                    P522_RESPCOBRANCA: &P522_RESPCOBRANCA.
                    P522_TAREFA_GERADA: &P522_TAREFA_GERADA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: BUSCAR
        }
    )

)

