    dynamicAction mostra-filtros (
        name: mostra filtros
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P131_FILTRAR2
        }
        clientSideCondition {
            type: item=value
            item: P131_FILTRAR2
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P131_CPF
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P131_NOME
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P131_CPF
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
