page 131 (
    name: Debitos Cobrança (Antigo)
    title: Debitos Cobrança (Antigo)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region débitos-pagos (
        name: Débitos Pagos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*FIRST_ROWS(15)*/ nrpedido
                     , 0 valordebito 
                     , valor valorpago
                     , 0 saldo
                     , pck_romance.fnc_nomefilial(idfilial) filial
                     , pck_romance.fnc_nomerepresentante(idrepresentante) representante
                     , nomevendedora 
                     , datainclusao
                     , cpf
                from pepinosrepresentantes p
                where p.situacao = 'P' 
                  and ( ( :P131_FILTRAR2 = 'T')
                      or( :P131_FILTRAR2 = 'C' and cpf = :P131_CPF )
                      or( :P131_FILTRAR2 = 'N' and lower(nomevendedora) like '%'||lower(:P131_NOME)||'%' ) )
                  and not exists ( select 1
                                   from pepinosrepresentantes pn
                                   where pn.nrpedido = p.nrpedido
                                     and pn.idrepresentante = p.idrepresentante 
                                     and pn.situacao = 'N')
                union
                select /*FIRST_ROWS(15)*/ nrpedido
                     , valor 
                     , valorpago
                     , valorsaldo saldo
                     , pck_romance.fnc_nomefilial(idfilial) filial
                     , pck_romance.fnc_nomerepresentante(idrepresentante) representante
                     , nomevendedora 
                     , datainclusao
                     , cpf
                from pepinosrepresentantes p
                where p.situacao = 'N' 
                  and ( ( :P131_FILTRAR2 = 'T')
                      or( :P131_FILTRAR2 = 'C' and cpf = :P131_CPF )
                      or( :P131_FILTRAR2 = 'N' and lower(nomevendedora) like '%'||lower(:P131_NOME)||'%' ) )
                  --and ( :P131_FILTRAR2 = 'T' or cpf = :P131_CPF )
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum registro encontrado.
            whenMoreDataFound: "Número máximo de registros encontrados, por favor revise seu filtro. "
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
