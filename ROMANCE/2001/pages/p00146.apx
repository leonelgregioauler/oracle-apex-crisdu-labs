            item: P146_IDITEMNOTAVENDA
        }
    )

    dynamicAction pula-campo (
        name: pula campo
        execution {
            sequence: 10
        }
        when {
            event: focusout
            selectionType: items
            items: P146_CODIGO
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P146_QUANTIDADE
            }
            execution {
                sequence: 10
            }
        )

    )

    validation p146-idproduto (
        name: P146_IDPRODUTO
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from produtos
                where codigosisdist  = :P146_CODIGO;
                ```
        }
        error {
            errorMessage: Informe o produto!
            displayLocation: inlineInNotification
        }
    )

    validation valida-estoque-da-representante (
        name: Valida estoque da Representante
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from estoquerepresentante e
                where e.idestoquefil = ( select f.idestoquefilial
                                         from estoquefilial f
                                         where f.idfilial  = ( select idfilial
                                                               from notasvendas 
                                                               where idnotavenda = :P146_IDNOTAVENDA ) 
                                           and f.idproduto = :P146_IDPRODUTO )
                  and e.idrepresentante = ( select idrepresentante
                                            from notasvendas 
                                            where idnotavenda = :P146_IDNOTAVENDA ) 
                  and e.qtd_u >= to_number(:P146_QUANTIDADE)
                ```
        }
        error {
            errorMessage: Quantidade não disponível na carga do(a) Representante.
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: never
        }
    )

    process atualiza (
        name: atualiza
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                  --
                  select iditemnotavenda
                  into :P146_IDITEMNOTAVENDA
                  from itensnotavenda i
                  where i.idnotavenda  = :P146_IDNOTAVENDA
                    and i.idestoquefil = ( select f.idestoquefilial
                                           from estoquefilial f
                                           where f.idfilial = :P0_IDFILIAL
                                             and f.idproduto = ( select idproduto
                                                                 from produtos
                                                                 where codigosisdist  = :P146_CODIGO ) );
                  --
                  update itensnotavenda i
                  set i.qtddevolvida = :P146_QTDDEVOLVIDA
                  where i.iditemnotavenda = :P146_IDITEMNOTAVENDA;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 299661383791880348
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process fetch-row-from-itensnotavenda (
        name: Fetch Row from ITENSNOTAVENDA
        type: autoRowFetch
        source {
            tableName: ITENSNOTAVENDA
            pkColumn: IDITEMNOTAVENDA
            pkItem: P146_IDITEMNOTAVENDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 299661973881880353
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        clear {
            type: pages
            pages: 38
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 299661779802880353
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 146
                items: {
                    P146_IDNOTAVENDA: &P146_IDNOTAVENDA.
                    P146_IDITEMNOTAVENDA:
                }
                successMessage: false
            }
        }
    )

)

