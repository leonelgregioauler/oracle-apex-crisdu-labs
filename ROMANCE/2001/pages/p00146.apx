page 146 (
    name: Acertar Item da Nota
    title: Acertar Item da Nota
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function changeEnter(event) 
            {
              if (event.keyCode == 13 || event.keyCode == 3)
                { 
                  document.getElementById('P38_QUANTIDADE').focus();
                  return null;
            
                }
            }
            
            function mudacampo()
            { 
              campo = document.getElementById('P146_CODIGO');
              var length = campo.value.length;
              if (eval(campo.value.length) == "5")
               {
                 document.getElementById('P146_QTDDEVOLVIDA').focus();
               }
               return (true);
            }
            ```
        executeWhenPageLoads: "window.opener.location.reload(); "
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region inclui-atualizar-item-da-nota (
        name: Inclui/Atualizar Item da Nota
        type: staticContent
        source {
            htmlCode:
                ```html
                <script language="javascript">
                function  confirmapepino(event)
                { 
                var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
                
                if (tecla==13) {
                /*var answer = confirm("Confirma inclusão do pepino?")
                	if (answer){            */
                		apex.submit('CREATE');
                /*	}*/
                }
                }
                </script>
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

