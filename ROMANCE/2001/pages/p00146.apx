    pageItem P146_IDPRODUTO (
        type: selectList
        label {
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto) display_value
                     , p.idproduto return_value
                from produtos      p
                where p.codigosisdist = trim(:P146_CODIGO)
                union
                select :P146_CODIGO
                , 1
                from dual
                order by 1;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P146_CODIGO
        }
        layout {
            sequence: 75
            region: @inclui-atualizar-item-da-nota
            slot: regionBody
            startNewRow: false
            newColumn: false
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

