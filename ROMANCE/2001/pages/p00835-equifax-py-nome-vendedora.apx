page 835 (
    name: Equifax_PY Nome Vendedora
    alias: EQUIFAX-PY-NOME-VENDEDORA
    title: Atualizar Dados Vendedora
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }

    region dados (
        name: Dados
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    pageItem P835_DATANASCIMENTO (
        type: datePicker
        label {
            label: Data Nascimento
            alignment: left
        }
        layout {
            sequence: 20
            region: @dados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
    )

    pageItem P835_DOCUMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @dados
            slot: regionBody
        }
    )

    pageItem P835_IDCONSULTASPC (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @dados
            slot: regionBody
        }
    )

    pageItem P835_MD5_DOC (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @dados
            slot: regionBody
        }
    )

    pageItem P835_NOME (
        type: textField
        label {
            label: Nome Vendedora
            alignment: left
        }
        layout {
            sequence: 10
            region: @dados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
    )

    pageItem P835_RETORNO (
        type: textField
        label {
            label: Retorno
            alignment: left
        }
        layout {
            sequence: 80
            region: @dados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar / Voltar
        layout {
            sequence: 40
            region: @dados
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button gerartermo (
        buttonName: GERARTERMO
        label: Gerar Termo
        layout {
            sequence: 30
            region: @dados
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P835_DATANASCIMENTO
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 10
            region: @dados
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction chama-endpoint (
        name: Chama Endpoint
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @gerartermo
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        --
                        l_response CLOB;
                        l_retorno  number;
                        l_body varchar2(1000);
                        --
                    BEGIN
                        --
                        l_body := '{ "ci": "'         || :P835_DOCUMENTO || '",' || chr(10) ||
                                  '"validador": "'    || :P835_MD5_DOC   || '",' || chr(10) ||
                                  '"nomecompleto": "' || :P835_NOME || '"}';
                        --
                        l_response := APEX_WEB_SERVICE.MAKE_REST_REQUEST(
                            p_url         => 'https://websocket.romancemoda.com.br/rmc_equifax_py/gerar_termo',
                            p_http_method => 'POST',
                            p_body        => l_body
                        );
                       --
                       select JSON_VALUE(l_response,'$.ERRO') 
                         into l_retorno
                         from dual;
                       --
                       if l_retorno = 0 then
                          :P835_RETORNO := 'Termo gerado com sucesso!'; --l_response;
                       else
                          :P835_RETORNO := 'Ocorreu erro ao gerar o termo. Contate a TI !'; --l_response;
                       end if;
                       --
                    END;
                    ```
                itemsToSubmit: [
                    P835_DOCUMENTO
                    P835_MD5_DOC
                    P835_NOME
                ]
                itemsToReturn: P835_RETORNO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction fechamodal (
        name: FechaModal
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @fechar
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New_1
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P835_DOCUMENTO
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: MD5( :P835_DOCUMENTO )
                itemsToSubmit: P835_DOCUMENTO
            }
            affectedElements {
                selectionType: items
                items: P835_MD5_DOC
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new-2 (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @salvar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SALVAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                  select nome, datanascimento
                  into :P835_NOME, :P835_DATANASCIMENTO
                  from consultaspc
                 where idconsultaspc = :P835_IDCONSULTASPC;
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 46442359984443608
        }
    )

    process salvardados (
        name: SalvarDados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  --
                  update consultaspc
                     set nome = :P835_NOME
                       , datanascimento = :P835_DATANASCIMENTO
                   where idconsultaspc = :P835_IDCONSULTASPC;
                  --
                  commit;
                  --
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        successMessage {
            successMessage: Registro atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 46442438086443609
        }
    )

    branch (
        name: Atualizar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 835
                items: {
                    P835_NOME: &P835_NOME.
                    P835_DATANASCIMENTO: &P835_DATANASCIMENTO.
                }
            }
        }
        serverSideCondition {
            type: request=Value
            value: SALVAR
        }
    )

)

