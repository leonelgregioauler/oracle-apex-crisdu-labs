page 628 (
    name: Acompanhamento de Quitações no SPC
    title: Acompanhamento de Quitações no SPC
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 50%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region lista-de-consultoras (
        name: Lista de Consultoras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct v.idvendedora "ID Site"
                     , initcap(p.nomepessoa) "Consultora"
                     , p.cpf "CPF"
                     , decode(v.spc,'S','Sim','Não') "SPC"
                     , v.dataenviospc "Data enviada ao SPC"
                     , np.datanegociacao "Data Negociação"
                     , decode(np.origem,'B','Cobrança','A','Débitos Romance','P','PAP') "Origem Negociação"
                     , pp.valorparcela "Valor Pago"
                     , pp.databaixa "Data da Baixa"
                     , ( select decode(pn.origem,'R','Distribuidor','C','Cobrança','G','PAP','D','Deb Romance','O','Cobraki')
                         from pagamentosnotasvendas pn
                         where pn.idpagtonotavenda = ( select max(pnv.idpagtonotavenda)
                                                       from pagamentosnotasvendas pnv
                                                          , notasvendas nv
                                                       where nv.idnotavenda = pnv.idnotavenda
                                                         and pnv.valorpago > 0
                                                         and nv.idvendedora = v.idvendedora ) ) "Origem Ult. Pgto"
                from vendedoras v
                   , pessoas p
                   , vendedoraspcnegociacao vv
                   , pagamentosnegociacoesparceiros pp
                   , negociacoesparceiros np
                where v.spc = 'S'
                  and p.idpessoa = v.idpessoa
                  and vv.idvendedora = v.idvendedora 
                  and not exists ( select 1
                                   from emailprocessossistema ep
                                   where ep.idvendedora = v.idvendedora
                                     and ep.idprocessosistema = 29 )
                  and np.idvendedora = v.idvendedora
                  and pp.idnegociacaoparceiro = np.idnegociacaoparceiro 
                  and pp.datapagamento > v.dataenviospc
                  and pp.situacao = 'Q' 
                  and p.cpf is not null
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <font color="blue"><b>Esta lista se refere a Consultoras que pagaram uma parcela após serem enviadas ao SPC e não foi enviado o email para sinalizar a Retirada!</b></font>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma consultora localizada.
        }
        advanced {
            savedReportMappingIdentifier: 5983348354309539902
        }

