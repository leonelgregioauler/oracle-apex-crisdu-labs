    region itens-faltantes (
        name: "Itens Faltantes "
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cb.idbrindeclube 
                     , cb.idclassifbrindeclub
                     , it.qtdfaltante
                     , it.datarecebimento
                     , it.iditemfaltante
                     , it.qtdrecebida
                from roman.itensfaltantes it 
                   , roman.classificacoesbrindesclub cb
                where cb.idclassifbrindeclub = it.idclassifbrindeclub
                  and it.idguiaentregabrinde = :P821_GUIAENVIO
                ```
            pageItemsToSubmit: P821_GUIAENVIO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 23276043828053405
        }

