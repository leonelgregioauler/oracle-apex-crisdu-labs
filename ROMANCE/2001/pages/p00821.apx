            sqlQuery:
                ```sql
                select distinct 1
                from roman.conquistoulevoucupons clc
                   , roman.guiasentregascupons gec 
                   , roman.guiasentregasbrindes ge
                where clc.idconquistoulevoucupom = gec.idconquistoulevoucupom
                  and gec.idguiaentregabrinde = ge.idguiaentregabrinde
