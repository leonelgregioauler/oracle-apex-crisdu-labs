        column DATARECEBIMENTO (
            type: datePicker
            heading {
                heading: Data Recebimento
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI
            }
            source {
                databaseColumn: DATARECEBIMENTO
                dataType: date
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from  roman.guiasentregascupons gc
                    where gc.idguiaentregabrinde = :P821_GUIAENVIO
                      and exists (select 1 
                                  from roman.conquistoulevoucupons cl 
                                  where cl.idconquistoulevoucupom = gc.idconquistoulevoucupom
                                    and cl.datarecebfilial is not null )
                    ```
            }
        )

        column IDBRINDECLUBE (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDBRINDECLUBE
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDCLASSIFBRINDECLUB (
            type: selectList
            heading {
                heading: Brinde
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select bd.nomebrinde
                           || ' - ' || c.nomeclassif
                           || ' - ' || cc.nomecaracteristica descricao
                         , cb.idclassifbrindeclub
                    from roman.brindesclub bd
                       , roman.classificacoesbrindesclub cb
                       , roman.conquistoulevouclassificacoes c
                       , roman.conquistoulevoucaracteristicas cc
                    where bd.idbrindeclube = cb.idbrindeclube
                      and c.idclassificacao (+) = cb.idclassificacao
                      and cc.idcaracteristica (+) = cb.idcaracteristica
                      and exists (select 1
                                  from roman.itensconqlevcupons itc
                                     , roman.guiasentregascupons gec
                                     , roman.guiasentregasbrindes geb
                                  where itc.idconquistoulevoucupom = gec.idconquistoulevoucupom
                                    and gec.idguiaentregabrinde = geb.idguiaentregabrinde
                                    and itc.idbrindeclube = bd.idbrindeclube
                                    and (itc.idclassificacao = cb.idclassificacao or itc.idclassificacao is null)
                                    and (itc.idcaracteristica = cb.idcaracteristica or itc.idcaracteristica is null)
                                    and geb.idguiaentregabrinde = :P821_GUIAENVIO)
                    union all
                    select bd.nomebrinde
                           || ' - sem classificação - sem característica' descricao
                         , null idclassifbrindeclub
                    from roman.brindesclub bd
                    where not exists (select 1
                                      from roman.classificacoesbrindesclub cb
                                      where cb.idbrindeclube = bd.idbrindeclube)
                      and exists (select 1
                                  from roman.itensconqlevcupons itc
                                     , roman.guiasentregascupons gec
                                     , roman.guiasentregasbrindes geb
                                  where itc.idconquistoulevoucupom = gec.idconquistoulevoucupom
                                    and gec.idguiaentregabrinde = geb.idguiaentregabrinde
                                    and itc.idbrindeclube = bd.idbrindeclube
                                    and geb.idguiaentregabrinde = :P821_GUIAENVIO)
                    
                    ```
            }
            layout {
                sequence: 80
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDCLASSIFBRINDECLUB
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

