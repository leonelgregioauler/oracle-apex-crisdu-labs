    region relatório-negociações-de-balanço-versão-nova (
        name: Relatório Negociações de Balanço Versão Nova
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idnegociacao
                     , w.tiponegociacao
                     , w.filial
                     , w.distribuidor
                     , w.pessoa
                     , w.data 
                     , w.usuario
                     , w.valor
                     , w.valorjuros
                     , w.valortotal
                     , w.entrada
                     , w.valorpago
                     , w.saldo
                     , w.observacao
                     , w.perda
                     , w.idfechamento
                     , w.valordescontonegociacao
                     , decode(w.cancelado,'S','Sim','Não') Cancelado
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2650 || ':405:'||v('APP_SESSION')||'::NO::P405_IDNEGOCIACAO:'||w.idnegociacao,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""></a>' Link
                from vw_negociacoes_rmc w
                where ( :P629_TIPOPESQUISA = 'T'
                      or ( :P629_TIPOPESQUISA = 'A' and w.saldo > 0  )
                      or ( :P629_TIPOPESQUISA = 'P' and w.saldo = 0 ) 
                      or ( :P629_TIPOPESQUISA = 'V' ) )
                  and w.idtiponegociacao = 3-- BALANCO
                  and w.idfilial = :P0_IDFILIAL
                  and nvl(w.cancelado,'N') = 'N'
                  and (:P629_IDREPRESENTANTE = -1 or w.idrepresentante = :P629_IDREPRESENTANTE)
                order by 6 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
