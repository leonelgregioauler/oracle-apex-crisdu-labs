    region relatório-negociações-de-balanço (
        name: Relatório Negociações de Balanço
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nb.idnegociacaobalanco
                     , nb.idfilial
                     , nb.empresa
                     , nb.idrepresentante
                     , nb.distribuidor
                     , nb.semana
                     , nb.data
                     , nb.observacao
                     , nb.valor
                     , nb.valorpago
                     , nb.valordesconto
                     , nb.qtdparcelas
                from roman.vw_negociacoesbalanco nb
                where nb.charcancelado = 'N'
                  and nb.idfilial = :P0_IDFILIAL
                  and ( :P629_TIPOPESQUISA = 'T' 
                       or ( :P629_TIPOPESQUISA = 'A' and (nb.valor - nb.valorpago - nb.valordesconto) > 0 )
                       or ( :P629_TIPOPESQUISA = 'P' and (nb.valor - nb.valorpago - nb.valordesconto) = 0 ) )
                  and ( :P629_IDREPRESENTANTE = -1 or nb.idrepresentante = :P629_IDREPRESENTANTE )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma negociação encontrada!
        }
        advanced {
            savedReportMappingIdentifier: 365028588731150679
        }

