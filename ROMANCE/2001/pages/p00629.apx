    pageItem P629_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) d
                     , idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL)
                order by 1
                ```
            nullDisplayValue: - Todos -
            nullReturnValue: -1
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P629_TIPOPESQUISA (
        type: radioGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Em Aberto;A,Pago;P,Todos;T
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

