    region negociações-realizadas (
        name: Negociações Realizadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select np.idnegociacaoparceiro
                     , np.idfilial
                     , roman.pck_romance.fnc_nomefilial(np.idfilial) filial
                     , np.idvendedora
                     , roman.pck_romance.fnc_nomevendedora(np.idvendedora) consultora
                     , np.datanegociacao
                     , (select fp.descricao
                        from roman.formaspagamentosnegociacoes fp
                        where fp.idformapagamento = np.formapagamento) formapagamento
                     , np.qtdparcelas
                     , np.valornegociacao
                     , np.observacao
                     , nvl(np.valorpago,0) valorpago
                     , nvl(np.saldo,0) saldo
                     -- Maicon Aimi - 18/06/2025 - Jeny pediu por que visualmente não fica bom quando é PIX
                     , case 
                         when np.formapagamento != 'P' then
                           np.linknegociacao
                         else
                           '-'
                       end as link_da_negociacao
                     , np.idnegociacaoparceiro id
                     , np.valordesconto
                     , (select listagg(distinct(to_char(pnp.datapagamento,'dd/mm/yyyy')),' - ') within group (order by pnp.datapagamento)
                          from pagamentosnegociacoesparceiros pnp
                         where pnp.idnegociacaoparceiro = np.idnegociacaoparceiro
                           and pnp.situacao = 'Q') datapagamento
                     , ( select initcap(nomepessoa)
                          from pessoas p
                             , usuarios u
                          where p.idpessoa = u.idpessoa
                            and u.idusuario = np.idusuarioresponsavel ) usuario 
                     , pck_romance.fnc_nomerepresentante(np.idrepresentante) distribuidor
                     , nvl(( select sum(pn.valorparcela)
                             from pagamentosnegociacoesparceiros pn
                             where pn.idnegociacaoparceiro = np.idnegociacaoparceiro
                               and pn.situacao             = 'V' ),0) valorvencido
                     , nvl(( select sum(pn.valorparcela)
                             from pagamentosnegociacoesparceiros pn
                             where pn.idnegociacaoparceiro = np.idnegociacaoparceiro
                               and pn.situacao             = 'A' 
                               and trunc(pn.datavencimento) between :P646_DATAINI and :P646_DATAFIM),0) valorvencerperiodo
                     , (select nvl(p.documentoestrangeiro,cpf)
                        from catal.pessoas p
                           , catal.vendedoras v
                        where p.idpessoa = v.idpessoa
                          and v.idvendedora = np.idvendedora) documento
                     , nvl(( select sum(pnp.valorparcela)
                             from pagamentosnegociacoesparceiros pnp
                             where pnp.idnegociacaoparceiro = np.idnegociacaoparceiro
                               and pnp.situacao             = 'E' ),0) valoremespera
                     , ( select c.beneficiario||' ('||b.nomebanco||' - Ag: '||c.agencia||'- CC: '||c.conta||')'
                         from roman.contasbancarias c
                            , roman.bancos b
                         where b.idbanco = c.idbanco
                           and c.idcontabanc = np.idcontabancaria ) conta
                from roman.negociacoesparceiros np
                where np.origem = 'P' -- Gestão de Perda
                  and ( :P646_IDFILIAL is null or np.idfilial = :P646_IDFILIAL )
                  and ( :P646_IDREPRESENTANTE is null or np.idrepresentante = :P646_IDREPRESENTANTE )
                  and ( :P646_PESQUISAR_POR = 'T'
                   or ( :P646_PESQUISAR_POR = 'N' and trunc(np.datanegociacao) between :P646_DATAINI and :P646_DATAFIM )
                   or ( :P646_PESQUISAR_POR = 'P' and exists (select 1 
                                                                from pagamentosnegociacoesparceiros t
                                                               where t.idnegociacaoparceiro = np.idnegociacaoparceiro
                                                                 and trunc(t.datapagamento) between :P646_DATAINI and :P646_DATAFIM))
                   or ( :P646_PESQUISAR_POR = 'V' and exists (select 1 
                                                                from pagamentosnegociacoesparceiros t
                                                               where t.idnegociacaoparceiro = np.idnegociacaoparceiro
                                                                 and trunc(t.datavencimento) between :P646_DATAINI and :P646_DATAFIM))
                  )
                  and ( :P646_IDVENDEDORA is null or np.idvendedora = :P646_IDVENDEDORA )
                  and ( :P646_FILTRAR = 'S')
                  and ( :P646_IDNEGOCIACAO is null or np.idnegociacaoparceiro = :P646_IDNEGOCIACAO)
                  and ( :P646_FORMAPGTO = 'A' or np.formapagamento = :P646_FORMAPGTO )
                  and ( :P646_IDRESPONSAVEL is null or np.idusuarioresponsavel = :P646_IDRESPONSAVEL)
                  and ( :P646_TIPO = 'X' 
                      or ( :P646_TIPO = 'T' and not exists ( select 1
                                                             from classificacoesnegociacoesparc cn
                                                             where cn.idnegociacaoparceiro = np.idnegociacaoparceiro ) )
                      or ( :P646_TIPO = 'C' and exists ( select 1
                                                         from classificacoesnegociacoesparc cn
                                                         where cn.idnegociacaoparceiro = np.idnegociacaoparceiro
                                                           and cn.idcaracteristicanegociacao = 5 ) ) -- Negociação Cruzeiro
                      or ( :P646_TIPO = 'D' and exists ( select 1
                                                         from classificacoesnegociacoesparc cn
                                                         where cn.idnegociacaoparceiro = np.idnegociacaoparceiro
                                                           and cn.idcaracteristicanegociacao = 4 ) ) ) -- Negociação de Distribuidor
                  --< T9775421
                  and ( :P646_SITUACAO is null
                   or ( :P646_SITUACAO = 'Q' and exists (select 1 -- Onde esteja todo quitado
                                                           from pagamentosnegociacoesparceiros p
                                                          where p.idnegociacaoparceiro = np.idnegociacaoparceiro
                                                            and p.situacao = 'Q'
                                                            and not exists (select 1 
                                                                              from pagamentosnegociacoesparceiros pnp 
                                                                             where pnp.idnegociacaoparceiro = np.idnegociacaoparceiro
                                                                               and pnp.situacao in ('A','C','E','V'))))
                   or ( :P646_SITUACAO <> 'Q' and exists (select 1
                                                            from pagamentosnegociacoesparceiros p
                                                           where p.idnegociacaoparceiro = np.idnegociacaoparceiro
                                                             and p.situacao = :P646_SITUACAO)))
                  -- T9775421 >
                
                  union
                
                  select np.idnegociacaoparceiro
                     , np.idfilial
                     , roman.pck_romance.fnc_nomefilial(np.idfilial) filial
                     , np.idvendedora
                     , roman.pck_romance.fnc_nomevendedora(np.idvendedora) consultora
                     , np.datanegociacao
                     , (select fp.descricao
                        from roman.formaspagamentosnegociacoes fp
                        where fp.idformapagamento = np.formapagamento) formapagamento
                     , np.qtdparcelas
                     , np.valornegociacao
                     , np.observacao
                     , nvl(np.valorpago,0) valorpago
                     , nvl(np.saldo,0) saldo
                     , np.linknegociacao link_da_negociacao
                     , np.idnegociacaoparceiro id
                     , np.valordesconto
                     , (select listagg(distinct(to_char(pnp.datapagamento,'dd/mm/yyyy')),' - ') within group (order by pnp.datapagamento)
                          from pagamentosnegociacoesparceiros pnp
                         where pnp.idnegociacaoparceiro = np.idnegociacaoparceiro
                           and pnp.situacao = 'Q') datapagamento
                     , ( select initcap(nomepessoa)
                          from pessoas p
                             , usuarios u
                          where p.idpessoa = u.idpessoa
                            and u.idusuario = np.idusuarioresponsavel ) usuario 
                     , pck_romance.fnc_nomerepresentante(np.idrepresentante) distribuidor
                     , nvl(( select sum(pn.valorparcela)
                             from pagamentosnegociacoesparceiros pn
                             where pn.idnegociacaoparceiro = np.idnegociacaoparceiro
                               and pn.situacao             = 'V' ),0) valorvencido
                     , nvl(( select sum(pn.valorparcela)
                             from pagamentosnegociacoesparceiros pn
                             where pn.idnegociacaoparceiro = np.idnegociacaoparceiro
                               and pn.situacao             = 'A' 
                               and trunc(pn.datavencimento) between :P646_DATAINI and :P646_DATAFIM),0) valorvencerperiodo
                     , (select nvl(p.documentoestrangeiro,cpf)
                        from catal.pessoas p
                           , catal.vendedoras v
                        where p.idpessoa = v.idpessoa
                          and v.idvendedora = np.idvendedora) documento
                     , nvl(( select sum(pnp.valorparcela)
                             from pagamentosnegociacoesparceiros pnp
                             where pnp.idnegociacaoparceiro = np.idnegociacaoparceiro
                               and pnp.situacao             = 'E' ),0) valoremespera
                     , ( select c.beneficiario||' ('||b.nomebanco||' - Ag: '||c.agencia||'- CC: '||c.conta||')'
                         from roman.contasbancarias c
                            , roman.bancos b
                         where b.idbanco = c.idbanco
                           and c.idcontabanc = np.idcontabancaria ) conta
                from roman.negociacoesparceiros np
                where idnegociacaoparceiro = 271689
                  and v('APP_USER') = 'MAICONAIMI'
                ```
        }
