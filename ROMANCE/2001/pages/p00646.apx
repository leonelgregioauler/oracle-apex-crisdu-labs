    region placar-do-dia (
        name: Placar do Dia
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select descricao
                     , quantidade
                from ( select 'Acordos Formalizados' descricao
                            , count(1) quantidade
                       from negociacoesparceiros np
                       where np.origem = 'P'
                         and trunc(np.datanegociacao) = trunc(sysdate)
                       union
                       select 'Boletos Registrados'
                            , count(1)
                       from favorita.controlearquivosbanco ca
                       where trunc(ca.dataprocessado) = trunc(sysdate)
                         and ca.idconveniobanco = 3
                         and exists ( select 1
                                      from pagamentosnegociacoesparceiros pp
                                      where pp.idpagamentonegociacaoparceiro = ca.idpagamentonegociacao
                                        and exists ( select 1
                                                     from negociacoesparceiros np
                                                     where np.idnegociacaoparceiro = pp.idnegociacaoparceiro
                                                       and np.origem = 'P'
                                                       and trunc(np.datanegociacao) = trunc(sysdate)))
                       union
                       select 'Acordos Quitados'
                            , count(1)
                       from pagamentosnegociacoesparceiros pp
                       where trunc(pp.databaixa) = trunc(sysdate)
                         and exists ( select 1
                                      from negociacoesparceiros np
                                      where np.idnegociacaoparceiro = pp.idnegociacaoparceiro
                                        and np.origem               = 'P'
                                        and np.saldo = 0 )
                       union
                       select 'Débitos Diversos' descricao
                            , count(1) quantidade
                       from negociacoesparceiros np
                       where np.origem = 'P'
                         and trunc(np.datanegociacao) = trunc(sysdate)
                         and exists ( select 1
                                      from documentosnegociacao dc
                                      where dc.idnegociacaoparceiro = np.idnegociacaoparceiro
                                        and dc.iddiverso is not null)
                       union
                       select 'Cedência de Débitos'
                            , count(1) quantidade
                       from negociacoesparceiros np
                       where np.origem = 'P'
                         and trunc(np.datanegociacao) = trunc(sysdate)
                         and exists ( select 1
                                      from documentosnegociacao dc
                                      where dc.idnegociacaoparceiro = np.idnegociacaoparceiro
                                        and (exists ( select 1
                                                     from classificacoesnotasvendas cl
                                                     where cl.idnotavenda = dc.idnotavenda
                                                       and cl.idcaracteristicanotavenda = 59)
                                          or exists ( select 1
                                                      from favorita.classificacoespedidos cp
                                                      where cp.idpedido = dc.idpedido
                                                        and cp.idcaracteristicapedido = 104 ))) )
                ```
        }
        layout {
            sequence: 40
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DESCRICAO
            valueColumn: QUANTIDADE
        }
    )

