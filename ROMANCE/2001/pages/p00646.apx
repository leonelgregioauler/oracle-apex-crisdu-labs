    pageItem P646_DATAINI (
        type: datePickerJquery
        label {
            label: De:
            alignment: left
        }
        layout {
            sequence: 50
            region: @ações-filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P646_FILTRAR (
        type: hidden
        layout {
            sequence: 10
            region: @negociações-realizadas
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P646_FORMAPGTO (
        type: radioGroup
        label {
            label: Forma Pagto
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Cartão Crédito;C,Depósito;D,Boleto ;B,PIX ;P,Giro de Pago;G,Giro de Tigo;T,Ambos;A,MBWAY;M
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @ações-filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: A
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P646_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                ```
        }
        layout {
            sequence: 80
            region: @ações-filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P646_IDNEGOCIACAO (
        type: textField
        label {
            label: Id Negociação
            alignment: left
        }
        layout {
            sequence: 130
            region: @ações-filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P646_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) d
                     , idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P646_IDFILIAL )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P646_IDFILIAL
        }
        layout {
            sequence: 90
            region: @ações-filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P646_IDRESPONSAVEL (
        type: selectList
        label {
            label: Responsável PAP
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomepessoa) d
                     , u.idusuario r
                from pessoas p
                   , usuarios u
                where p.idpessoa = u.idpessoa
                  and u.idgerente = 364
                  and u.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 110
            region: @ações-filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P646_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' CPF: '||p.cpf d
                     , v.idvendedora r
                from catal.vendedoras v
                   , catal.pessoas p
                where p.idpessoa = v.idpessoa
                  and ( :P646_IDREPRESENTANTE is null or v.idrepresentante = :P646_IDREPRESENTANTE )
                  and ( :P646_IDFILIAL is null or v.idfilial = :P646_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 100
            region: @ações-filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

