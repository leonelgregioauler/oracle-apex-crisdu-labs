    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 140
            region: @ações-filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button nova-negociacao (
        buttonName: NOVA_NEGOCIACAO
        label: Nova Negociação
        layout {
            sequence: 10
            region: @ações-filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 647
                items: {
                    P647_IDFILIAL:
                    P647_IDNEGOCIACAO:
                    P647_IDREPRESENTANTE:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        name: Go To Page 646
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 646
                items: {
                    P646_IDFILIAL: &P646_IDFILIAL.
                    P646_IDREPRESENTANTE: &P646_IDREPRESENTANTE.
                    P646_FILTRAR: S
                    P646_TIPO: &P646_TIPO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

