page 692 (
    name: Inserir Opção Perda Romance
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region inserir-opção-baixa-perda-romance (
        name: Inserir Opção Baixa Perda Romance
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    pageItem P692_IDMOTIVOBAIXA (
        type: hidden
        layout {
            sequence: 10
            region: @inserir-opção-baixa-perda-romance
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDMOTIVOBAIXA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P692_MOTIVO (
        type: textField
        label {
            label: Nome Motivo:
            alignment: left
        }
        layout {
            sequence: 20
            region: @inserir-opção-baixa-perda-romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        validation {
            maxLength: 1000
        }
        source {
            type: databaseColumn
            databaseColumn: MOTIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 10
            region: @inserir-opção-baixa-perda-romance
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    process fetch-row-from-opcao-baixa-romance (
        name: Fetch Row from OPCAO BAIXA Romance
        type: autoRowFetch
        source {
            tableName: MOTIVOSBAIXAS
            pkColumn: IDMOTIVOBAIXA
            pkItem: P692_IDMOTIVOBAIXA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1110318888274630507
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select roman.seq_idmotivobaixa.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P692_IDMOTIVOBAIXA := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1110319246142630511
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-opção-baixa-romance (
        name: Process Row of OPÇÃO BAIXA Romance
        type: autoRowProcessing
        target {
            tableName: MOTIVOSBAIXAS
            pkColumn: IDMOTIVOBAIXA
            pkItem: P692_IDMOTIVOBAIXA
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Inserido com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 1110319303539630512
        }
    )

)

