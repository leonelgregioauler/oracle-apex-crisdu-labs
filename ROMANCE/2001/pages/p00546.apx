page 546 (
    name: Filtro de Distribuidores
    title: Filtro de Distribuidores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtro-de-distribuidores (
        name: Filtro de Distribuidores
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "IDREPRESENTANTE",
                "USUARIO"
                from "#OWNER#"."FILTROSREPRESENTANTES"
                where usuario = v('APP_USER')
                ```
        }
        layout {
            sequence: 15
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum Distribuidor adicionado.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 4
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDREPRESENTANTE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: selectList
            heading {
                heading: Distribuidor
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomerepresentante(idrepresentante) d
                         , idrepresentante r
                    from representantes r
                    where r.ativo = 'S'
                      and r.idgerente = ( select idgerente
                                          from gerentes g
                                          where g.idfilial = :P0_IDFILIAL )
                    order by 1
                    ```
            }
            layout {
                sequence: 3
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
            default {
                type: plsqlExpression
                plsqlExpression: v('APP_USER')
            }
        )

    )

    button add (
        buttonName: ADD
        label: Add +
        layout {
            sequence: 40
            region: @filtro-de-distribuidores
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @filtro-de-distribuidores
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Gravar
        layout {
            sequence: 30
            region: @filtro-de-distribuidores
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @filtro-de-distribuidores
        target {
            tableName: FILTROSREPRESENTANTES
            pkColumn: ROWID
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# linha(s) deletadas(s).
        }
        advanced {
            executionMappingIdentifier: 4102333506531568448
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @filtro-de-distribuidores
        target {
            tableName: FILTROSREPRESENTANTES
            pkColumn: ROWID
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# linha(s) atualizada(s), #MRI_COUNT# linha(s) inserida(s).
        }
        advanced {
            executionMappingIdentifier: 4102333185836568447
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Go To Page 546
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 546
            }
        }
    )

)

