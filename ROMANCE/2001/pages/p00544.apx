        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 159166 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONFERENCIA (
                sequence: 12
            )

            displayColumn DEPOSITOS (
                sequence: 9
            )

            displayColumn DEPOSITOSCONFERIDOS (
                sequence: 10
            )

            displayColumn DEPOSITOSFALTANTES (
                sequence: 11
            )

            displayColumn DESPESAS (
                sequence: 3
            )

            displayColumn DESPESASCONFERIDAS (
                sequence: 4
            )

            displayColumn DESPESASFALTANTES (
                sequence: 5
            )

            displayColumn NOME (
                sequence: 1
            )

            displayColumn SAIDASCONFERIDAS (
                sequence: 7
            )

            displayColumn SAIDASDIVERSAS (
                sequence: 6
            )

            displayColumn SAIDASFALTANTES (
                sequence: 8
            )

            displayColumn SEMANA (
                sequence: 2
            )

            sort (
                column: IDSEMANA
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            controlBreak (
                column: NOME
                layout {
                    sequence: 1
                }
            )

            highlight ir-condition (
                name: Semana Finalizada
                condition {
                    column: CONFERENCIA
                    value: Finalizada
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #99FF99
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-2 (
                name: Pendente de Conferência
                condition {
                    column: CONFERENCIA
                    value: Não Finalizada
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #FFFF99
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P544_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and exists ( select 1
                               from usuariosfiliais uf
                               where uf.usuario  = v('APP_USER')
                                 and uf.idfilial = f.idfilial )
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P544_IDSEMANAFIM (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano semana
                     , s.idsemana
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-2 and to_char(sysdate,'RRRR')
                order by idsemana desc;
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P544_IDSEMANAINI (
        type: selectList
        label {
            label: Semana de
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano semana
                     , s.idsemana
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-2 and to_char(sysdate,'RRRR')
                order by idsemana;
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 544
                items: {
                    P544_IDSEMANAINI: &P544_IDSEMANAINI.
                    P544_IDSEMANAFIM: &P544_IDSEMANAFIM.
                    P544_IDFILIAL: &P544_IDFILIAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

