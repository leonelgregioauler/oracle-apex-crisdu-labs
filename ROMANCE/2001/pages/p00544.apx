page 544 (
    name: Conferência de Caixas
    title: Conferência de Caixas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region conferência-de-caixas (
        name: Conferência de Caixas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.nome
                     , t.idsemana
                     , t.semana
                     , t.despesas
                     , t.despesasconferidas
                     , (t.despesas-t.despesasconferidas) despesasfaltantes
                     , t.saidasdiversas
                     , t.saidasconferidas
                     , (t.saidasdiversas-t.saidasconferidas) saidasfaltantes
                     , t.depositos Depositos
                     , t.DepositosConferidos DepositosConferidos
                     , t.Depositosfaltantes Depositosfaltantes
                     , case
                         when (t.despesas-t.despesasconferidas) + (t.saidasdiversas-t.saidasconferidas ) + (t.depositos - t.DepositosConferidos ) > 0 then
                           'Não Finalizada'
                         else
                           'Finalizada'
                       end conferencia 
                from ( 
                        select f.nome
                             , fs.idsemana
                             , fs.semana
                             , ( select count(1)
                                 from despesas d
                                 where d.idfechamento = fs.idfechamento
                                   and d.idfilial     = f.idfilial ) despesas
                             , ( select count(1)
                                 from despesas dc
                                 where dc.idfechamento = fs.idfechamento
                                   and dc.emmaos       = 'S' ) despesasconferidas
                             , ( select count(1)
                                 from saidasdiversas s
                                 where s.idfechamento = fs.idfechamento ) saidasdiversas
                             , ( select count(1)
                                 from saidasdiversas sc
                                 where sc.idfechamento = fs.idfechamento
                                   and sc.emmaos       = 'S' ) saidasconferidas
                             , ( select count(1)
                                 from roman.depositosfavorita de
                                 where de.idfechamento = fs.idfechamento )Depositos
                             , ( select count(1)
                                 from roman.depositosfavorita de
                                 where de.idfechamento = fs.idfechamento 
                                   and de.emmaos = 'S' )DepositosConferidos
                             , ( select count(1)
                                 from roman.depositosfavorita de
                                 where de.idfechamento = fs.idfechamento 
                                   and de.emmaos is null )Depositosfaltantes
                        from vw_filiais f
                           , fechamentossemanais fs
                        where f.ativo = 'S'
                          and fs.idfilial = f.idfilial
                          and ( :P544_IDFILIAL is null or f.idfilial = :P544_IDFILIAL )
                          and exists ( select 1
                                       from usuariosfiliais uf
                                       where uf.usuario  = v('APP_USER')
                                         and uf.idfilial = f.idfilial )
                          and fs.idsemana between :P544_IDSEMANAINI and :P544_IDSEMANAFIM ) t
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 15906117717862404
        }

        column CONFERENCIA (
            type: plainText
            heading {
                heading: Situação
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column DEPOSITOS (
            type: plainText
            heading {
