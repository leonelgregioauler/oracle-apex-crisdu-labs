page 709 (
    name: Relatorio Franquias Estrelas Romance
    title: Relatorio Franquias Estrelas Romance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region franquias-estrelas-romance (
        name: Franquias Estrelas Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.IDFILIALCLUBEDESUCESSO, 
                       f.IDCLUBEDESUCESSO,
                       f.idfilial,
                       c.nomeclube,
                       pck_util.fnc_semanaid(f.IDSEMANAINICIO) IDSEMANAINICIO,
                       f.QUANTIDADENOTAS,
                       f.QUANTIDADECICLOS,
                       pck_util.fnc_semanaid(f.IDSEMANADISPARO) IDSEMANADISPARO
                  from ROMAN.FILIAISCLUBEDESUCESSO F
                     , ROMAN.CLUBEDESUCESSO  C
                 where f.idclubedesucesso = c.idclubedesucesso
                 
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 710
                items: {
                    P710_IDFILIALCLUBEDESUCESSO: #IDFILIALCLUBEDESUCESSO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1505290276575370544
        }

        column IDCLUBEDESUCESSO (
            type: hidden
            heading {
                heading: Clube de Sucesso
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDFILIAL (
            type: plainTextBasedOnLov
            heading {
                heading: Franquia
                alignment: center
            }
            lov {
                lov: @lov-filiais
            }
            layout {
                sequence: 25
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column IDFILIALCLUBEDESUCESSO (
            type: hidden
            heading {
                heading: Idfilialclubedesucesso
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDSEMANADISPARO (
            type: plainText
            heading {
                heading: Semana Início Disparo
                alignment: center
            }
            layout {
                sequence: 45
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column IDSEMANAINICIO (
            type: plainText
            heading {
                heading: Semana Início
                alignment: center
            }
            layout {
                sequence: 35
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column NOMECLUBE (
            type: plainText
            heading {
                heading: Nome Clube
                alignment: center
            }
            layout {
                sequence: 15
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column QUANTIDADECICLOS (
            type: plainText
            heading {
                heading: Qtd Semanas
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column QUANTIDADENOTAS (
            type: plainText
            heading {
                heading: Qtd Notas
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 15052935 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IDFILIAL (
                sequence: 5
            )

            displayColumn IDSEMANADISPARO (
                sequence: 6
            )

            displayColumn IDSEMANAINICIO (
                sequence: 1
            )

            displayColumn NOMECLUBE (
                sequence: 4
            )

            displayColumn QUANTIDADECICLOS (
                sequence: 3
            )

            displayColumn QUANTIDADENOTAS (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo registro
        layout {
            sequence: 30
            region: @franquias-estrelas-romance
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 710
                clearCache: 710
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

