page 26 (
    name: Configurar Usuario
    title: Configurar Usuario
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region perfil-do-usuário (
        name: Perfil do Usuário
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P26_PERFIL (
        type: selectList
        label {
            label: Perfil
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(descricao) display_value
                 , idperfil return_value
                from perfil
                where idsistema = 2001
                ```
        }
        layout {
            sequence: 20
            region: @perfil-do-usuário
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P26_USUARIO (
        type: selectList
        label {
            label: Usuario
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(username) display_value
                ,username return_value
                from dba_users d
                where trunc(d.created) >= to_date('07/12/2010','dd/mm/rrrr')
                AND USERNAME NOt IN ('APEX_PUBLIC_USER','APEX_040000','CATAL')
                and account_status != 'LOCKED'
                and exists ( select 1 
                               from usuariossistemas u 
                               where u.usuario   = d.username 
                                 and u.idsistema = 2001)
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @perfil-do-usuário
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Aplicar Acessos
        layout {
            sequence: 10
            region: @perfil-do-usuário
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process aplicar-acessos (
        name: aplicar acessos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  delete acessos
                  where usuario = :P26_USUARIO
                    and idaplicacao in (select a.idaplicacao
                                    from   aplicacoes a
                                    where  a.idsistema = 2001); 
                  --
                  for a in (select p.idaplicacao
                            from perfilacesso p
                            where idperfil = :P26_PERFIL
                              and not exists (select 1
                                              from  acessos a
                                              where a.idaplicacao = p.idaplicacao
                                                and a.usuario     = :P26_USUARIO))
                  --
                  loop
                    --
                    insert into acessos (idacesso,usuario,idaplicacao,ativo)
                    values (seq_idacessos.nextval, :P26_USUARIO, a.idaplicacao, 'S');
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Acesso Liberado!
        }
        advanced {
            executionMappingIdentifier: 29120573556843292
        }
    )

)

