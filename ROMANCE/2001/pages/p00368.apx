page 368 (
    name: Editar Item Venda Direta
    title: Editar Item Venda Direta
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    advanced {
        reloadOnSubmit: always
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region itens-da-venda-direta (
        name: Itens da Venda Direta
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P368_COMISSAO (
        type: hidden
        layout {
            sequence: 80
            region: @itens-da-venda-direta
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: COMISSAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P368_IDESTOQUEFIL (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select codigosisdist ||' - '|| initcap(p.nomeproduto)/*||ef.idestoquefilial */ display_value
                     , ef.idestoquefilial return_value
                from produtos      p
                   , estoquefilial ef
                where p.idproduto        = ef.idproduto
                  and ef.idestoquefilial = :P368_IDESTOQUEFIL
                ```
        }
        layout {
            sequence: 70
            region: @itens-da-venda-direta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDESTOQUEFIL
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

