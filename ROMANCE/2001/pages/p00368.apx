    validation valida-quantidade-limite (
        name: Valida quantidade limite
        execution {
            sequence: 100
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(:P368_QTD_PP) >= :P368_LIMITEPRODUTOS+1
                   or to_number(:P368_QTD_P) >= :P368_LIMITEPRODUTOS+1
                   or to_number(:P368_QTD_M) >= :P368_LIMITEPRODUTOS+1
                   or to_number(:P368_QTD_G) >= :P368_LIMITEPRODUTOS+1
                   or to_number(:P368_QTD_GG) >= :P368_LIMITEPRODUTOS+1
                   or to_number(:P368_QTD_EGG) >= :P368_LIMITEPRODUTOS+1
                   or to_number(:P368_QTD_EXGG) >= :P368_LIMITEPRODUTOS+1
                   or to_number(:P368_QTD_U) >= :P368_LIMITEPRODUTOS+1
                ```
        }
        error {
            errorMessage: "Limite de 10(dez) peças excedido! Verifique a quantidade informada. "
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'SAVE'
                  and not exists ( select 1
                                   from funcionarios f
                                   where f.idfuncionario = :P368_IDFUNCIONARIO 
                                     and f.idpessoa      = ( select idpessoa 
                                                             from gerentes g
                                                             where g.idfilial = :P0_IDFILIAL ) )
                ```
        }
    )

    validation valida-quantidade-total-alterada (
        name: Valida Quantidade Total Alterada
        execution {
            sequence: 110
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where(nvl(to_number(:P366_QTD_PP),0)
                    + nvl(to_number(:P366_QTD_P),0)
                    + nvl(to_number(:P366_QTD_M),0)
                    + nvl(to_number(:P366_QTD_G),0)
                    + nvl(to_number(:P366_QTD_GG),0)
                    + nvl(to_number(:P366_QTD_EGG),0)
                    + nvl(to_number(:P366_QTD_EXGG),0)
                    + nvl(to_number(:P366_QTD_U),0)) >= :P368_LIMITEPRODUTOS+1
                ```
        }
        error {
            errorMessage: "Limite de 10(dez) peças excedido! Verifique a quantidade informada. "
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'SAVE'
                  and not exists ( select 1
                                   from funcionarios f
                                   where f.idfuncionario = :P368_IDFUNCIONARIO 
                                     and f.idpessoa      = ( select idpessoa 
                                                             from gerentes g
                                                             where g.idfilial = :P0_IDFILIAL ) )
                ```
        }
    )

    validation valida-quantos-produtos-incluídos (
        name: Valida quantos produtos incluídos
        execution {
            sequence: 120
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where nvl(( select sum(qtdtotal)
                            from itensvendadireta it
                            where it.iditemvendadireta != :P368_IDITEMVENDADIRETA
                              and exists ( select 1
                                           from vendasdiretas v
                                           where v.idvendadireta = it.idvendadireta 
                                             and v.idfuncionario = :P368_IDFUNCIONARIO
                                             and trunc(sysdate) - trunc(v.data) <= 30 ) ),0) + ( nvl(:P368_QTD_PP,0)
                                                                                               + nvl(:P368_QTD_P,0)
                                                                                               + nvl(:P368_QTD_M,0)
                                                                                               + nvl(:P368_QTD_G,0)
                                                                                               + nvl(:P368_QTD_GG,0)
                                                                                               + nvl(:P368_QTD_EGG,0)
                                                                                               + nvl(:P368_QTD_EXGG,0)
                                                                                               + nvl(:P368_QTD_U,0)) > :P368_LIMITEPRODUTOS
                ```
        }
        error {
            errorMessage: Limite de produtos por mês atingido! Aguarde próximo mês para realizar a venda direta.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'SAVE'
                  and not exists ( select 1
                                   from funcionarios f
                                   where f.idfuncionario = :P368_IDFUNCIONARIO 
                                     and f.idpessoa      = ( select idpessoa 
                                                             from gerentes g
                                                             where g.idfilial = :P0_IDFILIAL ) )
                ```
        }
    )

    process atualiza-venda-direta (
        name: Atualiza Venda DIreta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidsituacao number;
                  --
                begin 
                  --
                  select idsituacao
                  into vidsituacao
                  from vendasdiretas v
                  where v.idvendadireta = :P368_IDVENDADIRETA;
                  --
                  if vidsituacao = 1 then
                    --
                    update vendasdiretas v
                    set v.idsituacao = 2
                    where v.idvendadireta = :P368_IDVENDADIRETA;
                    --
                  end if;
                  --
                  update vendasdiretas v
                  set v.valortotal = ( select sum(qtdtotal*it.valorvenda)
                                       from itensvendadireta it
                                       where it.idvendadireta = :P368_IDVENDADIRETA )
                  where v.idvendadireta = :P368_IDVENDADIRETA;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1407827653237657450
        }
    )

