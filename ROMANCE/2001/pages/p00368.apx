    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 90
                items: {
                    P90_IDVENDADIRETA: &P368_IDVENDADIRETA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: Remover Produto
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P368_IDITEMVENDADIRETA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P368_IDITEMVENDADIRETA
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction editar-produto (
        name: Editar Produto
        execution {
            sequence: 40
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P368_IDITEMVENDADIRETA
        }

        action native-set-value (
            action: setValue
            settings {
                value: P
            }
            affectedElements {
                selectionType: items
                items: P368_OPCAO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction estoque-por-grade (
        name: Estoque por Grade
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: item=value
            item: P0_ESTOQUEPORGRADE
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P368_QTD_PP
                    P368_QTD_P
                    P368_QTD_M
                    P368_QTD_G
                    P368_QTD_GG
                    P368_QTD_EGG
                    P368_QTD_EXGG
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P368_QTD_PP
                    P368_QTD_P
                    P368_QTD_M
                    P368_QTD_G
                    P368_QTD_GG
                    P368_QTD_EGG
                    P368_QTD_EXGG
                    P368_QTD_U
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo (
        name: Tipo
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P368_OPCAO
        }
        clientSideCondition {
            type: item=value
            item: P368_OPCAO
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P368_IDPRODUTO2
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P368_CODIGO
                    P368_IDPRODUTO
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P368_CODIGO
                    P368_IDPRODUTO
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P368_IDPRODUTO2
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    validation p368-idproduto (
        name: P368_IDPRODUTO
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P368_IDPRODUTO is not null
                or :P368_IDPRODUTO2 is not null
                ```
        }
        error {
            errorMessage: Informe o produto!
            associatedItem: @P368_IDPRODUTO
        }
    )

    validation valida-qtd-egg (
        name: Valida QTD EGG
        execution {
            sequence: 70
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_estoque.fnc_estoquedisponivel(:P368_IDESTOQUEFIL,'EGG') >= nvl(to_number(:P368_QTD_EGG),0)
                ```
        }
        error {
            errorMessage: Lançamento é maior que a quantidade disponível em estoque!
            associatedItem: @P368_QTD_EGG
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P368_QTD_EGG
        }
    )

