page 234 (
    name: Liberar Semana
    title: Liberar Semana
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_liberasemana(IDREPRESENTANTE)
            {
            javascript:window.open('f?p=&APP_ID.:550:&SESSION.::NO:550:P550_IDREPRESENTANTE,P550_PROCESSAR:'+IDREPRESENTANTE+',S'
            ,'popup'+IDREPRESENTANTE,'toolbar=no,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width=800,height=400,screenX=100,screenY =100');void(0);
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region liberar-semana-para-distribuidor (
        name: Liberar Semana para Distribuidor
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
    )

    region regiões-que-atende (
        name: Regiões que Atende
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(r.idregiaovenda) regiao
                     , ordem
                     , semana
                from regioesrepresentantes r
                where idrepresentante = :P234_IDREPRESENTANTE
                order by r.idregiaorepresentante
                
                ```
        }
        layout {
            sequence: 20
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P234_IDREPRESENTANTE
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column ORDEM (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Ordem
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column REGIAO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Região de Venda
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column SEMANA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P234_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sharedComponent
            lov: @representantes-2
        }
        layout {
            sequence: 20
            region: @liberar-semana-para-distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button liberar (
        buttonName: LIBERAR
        label: Liberar
        layout {
            sequence: 30
            region: @liberar-semana-para-distribuidor
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript: { fnc_liberasemana(document.getElementById('P234_IDREPRESENTANTE').value)};"
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: processa
        execution {
            sequence: 10
        }
        behavior {
            target: {
                type: otherApp
                app: 220
                page: 2
                items: {
                    P2_IDREPRESENTANTE: &P234_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
    )

)

