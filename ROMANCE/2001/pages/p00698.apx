    process pedidos-parcialmente-pagos (
        name: PEDIDOS_PARCIALMENTE_PAGOS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Pedidos que foram parcialmente pagos
                select sum(xx.qtd_pedidos)qtd
                     , sum(xx.valorpagar) valor
                  into :P698_QTD_PEDIDO_PARCIALMENTE_PAGO
                     , :P698_VALOR_PEDIDO_PARCIALMENTE_PAGO
                 from (
                select (select count(p.idpedido) 
                          from favorita.pedidos p
                         where p.idnotavenda      = nv.idnotavenda
                           and p.datacancelamento is null) qtd_pedidos
                      ,(select sum(vp.valorpagar)
                          from favorita.pedidos p
                              ,favorita.vencimentospedidos vp
                         where p.idpedido         = vp.idpedido
                           and p.datacancelamento is null
                           and p.idnotavenda      = nv.idnotavenda) valorpagar
                      ,(select sum(vp.valorpago)
                          from favorita.pedidos p
                              ,favorita.vencimentospedidos vp
                         where p.idpedido         = vp.idpedido
                           and p.datacancelamento is null
                           and p.idnotavenda      = nv.idnotavenda) valorpago
                from roman.notasvendas nv
                    ,filiais fi
                where nv.idfilial            = fi.idfilial
                  and nv.perccomissao        = 40
                  and nv.idsituacaonotavenda in (3,4)
                  and nv.valortotalvenda     > 0
                  and (:P698_PAIS is null or fi.ididioma = :P698_PAIS)
                  and (:P698_DISTRIBUIDOR is null or nv.idrepresentante = :P698_DISTRIBUIDOR)
                  and (:P698_SEMANA_INICIO is null or nv.idsemanacobranca between :P698_SEMANA_INICIO AND :P698_SEMANA_FIM)
                  and (:P698_FRANQUIA is null or nv.idgerente = :P698_FRANQUIA)
                  and  exists (select 1
                        from   favorita.pedidos p
                        where  p.idnotavenda = nv.idnotavenda
                          and  p.datacancelamento is null)
                ) xx
                where xx.valorpago > 0 
                  and xx.valorpago < xx.valorpagar;
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 1503480795287794509
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    process pedidos-quitados (
