        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P698_MOSTRAR
            value: S
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        legend {
            hideAndShowBehavior: none
        }
        messages {
            whenNoDataFound: Registros não encontrados
        }

        series franquia (
            name: Franquia
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    --:P698_VLR_INVESTIDO_RMC
                    select franquia
                          , nvl(sum(to_number(replace(replace(:P698_VLR_INVESTIDO_RMC,',',''),'.','')) / vlr_total_notas_40),0) total
                    From (
                    select roman.pck_romance.fnc_nomefilial(nv.idfilial) franquia,
                           sum(nv.valortotalvenda*0.40) vlr_total_notas_40
                    from roman.notasvendas nv
                        ,filiais fi
                    where nv.idfilial = fi.idfilial
                      and nv.perccomissao = 40
                      and nv.idsituacaonotavenda in (3,4)
                      and nv.valortotalvenda > 0
                      and (:P698_PAIS is null or fi.ididioma = :P698_PAIS)
                      and (:P698_DISTRIBUIDOR is null or nv.idrepresentante = :P698_DISTRIBUIDOR)
                      and (:P698_SEMANA_INICIO is null or nv.idsemanacobranca between :P698_SEMANA_INICIO AND :P698_SEMANA_FIM)
                      and (:P698_FRANQUIA is null or nv.idgerente = :P698_FRANQUIA)
                      and  exists (select 1
                            from   favorita.pedidos p
                            where  p.idnotavenda = nv.idnotavenda
                              and  p.datacancelamento is null)
                      group by roman.pck_romance.fnc_nomefilial(nv.idfilial)   
                    ) xx
                    group by franquia 
                    ```
            }
            columnMapping {
                label: FRANQUIA
                value: TOTAL
                customColumn: FRANQUIA
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

