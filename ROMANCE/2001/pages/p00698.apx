        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idgerente
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.idfilial != 1063
                  and exists (select 1
                              from roman.notasvendas nv
                              where nv.idfilial = f.idfilial
                                and nv.idsituacaonotavenda = 3)
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
