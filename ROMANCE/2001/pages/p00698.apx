    region pedidos-emitidos (
        name: Pedidos Emitidos
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select label
                     , qtd
                from(
                select '1 - Qtd. Pedidos Emitidos' label
                     , to_number(:P698_QTD_PEDIDO_EMITIDOS) qtd
                  from dual
                union
                select '2 - Qtd. Pedidos Quitados' label
                     , to_number(:P698_QTD_PEDIDO_QUITADOS) qtd
                 from dual
                union
                select '3 - Valor Pedidos Quitados' Label,
                       to_number(:P698_VALOR_PEDIDO_QUITADOS) qtd
                 from dual
                union
                select '4 - Qtd. Pedidos Parcialmente Pagos' Label,
                       to_number(:P698_QTD_PEDIDO_PARCIALMENTE_PAGO) qtd
                 from dual
                union
                select '5 - Valor Pedidos Parcialmente Pagos' Label,
                        to_number(:P698_VALOR_PEDIDO_PARCIALMENTE_PAGO) qtd
                 from dual
                union
                select '6 - Qtd Pedidos Total Pagos' Label,
                       to_number(:P698_QTD_PEDIDOS_TOTAL_PAGOS) qtd
                 from dual
                union 
                select '7 - Valor Pedidos Total Pagos' Label,
                       to_number(:P698_VALOR_PEDIDOS_TOTAL_PAGOS) qtd
                 from dual
                )
                order by 1;
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P698_MOSTRAR
            value: S
        }
        settings {
            labelColumn: LABEL
            valueColumn: QTD
            maximumRows: 10
            messageWhenNoDataFound: Registros não encontrados
        }
    )

