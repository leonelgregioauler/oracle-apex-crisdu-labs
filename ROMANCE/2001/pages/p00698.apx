    region analise-por-franquia (
        name: Analise Por Franquia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Analise Macro
                select xx.Filial Franquia
                      ,xx.semanacobranca
                      ,sum(xx.valortotalvenda) valortotalvenda
                      ,count(xx.idnotavenda) qtd_nota_40
                      ,sum(xx.Perc_40) Perc_40
                      ,count(xx.idnotavenda) qtd_nota_30
                      ,sum(xx.Perc_30) Perc_30
                      ,sum(xx.valor_investido) valor_investido
                      ,sum(xx.qtd_pedido_Favorita) qtd_pedido_Favorita
                      ,sum(xx.vlr_pedido_Favorita) vlr_pedido_Favorita
                From (
                select nv.semanacobranca
                      ,nv.idnotavenda
                      ,nv.idfilial
                      ,roman.pck_romance.fnc_nomefilial(nv.idfilial) Filial
                      ,nv.idrepresentante
                      ,roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) Distribuidor
                      ,nv.idvendedora
                      ,roman.pck_romance.fnc_nomevendedora(nv.idvendedora) Vendedora
                      ,nv.valortotalvenda
                      ,(nv.valortotalvenda*0.40) Perc_40
                      ,(nv.valortotalvenda*0.30) Perc_30
                      ,((nv.valortotalvenda*0.40) - (nv.valortotalvenda*0.30)) valor_investido
                      ,(select count(p.idpedido)
                        from   favorita.pedidos p
                        where  p.idnotavenda = nv.idnotavenda
                          and  p.datacancelamento is null) qtd_pedido_Favorita
                      ,(select sum(p.valorapagar)
                        from   favorita.pedidos p
                        where  p.idnotavenda = nv.idnotavenda
                          and  p.datacancelamento is null) vlr_pedido_Favorita
                from roman.notasvendas nv
                    ,filiais fi
                where nv.idfilial = fi.idfilial
                  and nv.perccomissao = 40
                  and nv.idsituacaonotavenda in (3,4)
                  and nv.valortotalvenda > 0
                  and (:P698_PAIS is null or fi.ididioma = :P698_PAIS)
                  and (:P698_DISTRIBUIDOR is null or nv.idrepresentante = :P698_DISTRIBUIDOR)
                  and (:P698_SEMANA_INICIO is null or nv.idsemanacobranca between :P698_SEMANA_INICIO AND :P698_SEMANA_FIM)
                  and (:P698_FRANQUIA is null or nv.idgerente = :P698_FRANQUIA)
                ) xx
                group by xx.Filial, xx.semanacobranca
                order by xx.Filial, xx.semanacobranca;
                
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
