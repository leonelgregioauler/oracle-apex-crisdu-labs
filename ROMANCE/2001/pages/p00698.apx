        source {
            plsqlCode:
                ```plsql
                -- Pedidos que foram totalmente pagos
                select sum(xx.qtd_pedidos) qtd
                     , sum(xx.valorpago) valor
                  into :P698_QTD_PEDIDO_QUITADOS
