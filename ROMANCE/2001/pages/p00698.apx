    pageItem P698_DISTRIBUIDOR (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap (p.nomepessoa) display_value
                     , r.idrepresentante return_value
                from pessoas p
                   , representantes r
                where r.idpessoa = p.idpessoa 
                  and r.ativo = 'S'
                  and r.idgerente = :P698_FRANQUIA
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P698_FRANQUIA
            itemsToSubmit: P698_DISTRIBUIDOR
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

