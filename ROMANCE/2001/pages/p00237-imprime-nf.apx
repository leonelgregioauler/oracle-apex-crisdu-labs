page 237 (
    name: Imprime NF
    alias: IMPRIME_NF
    title: Imprime NF
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region imprime-nota-fiscal (
        name: Imprime Nota Fiscal
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                --
                  pck_imprime.prc_imprimenotadeentrada(:P237_IDNOTAFISCAL);
                --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P237_IDNOTAFISCAL (
        type: hidden
        layout {
            sequence: 10
            region: @imprime-nota-fiscal
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

