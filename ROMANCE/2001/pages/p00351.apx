page 351 (
    name: Fotos de Documentos
    title: Fotos de Documentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-por-dia (
        name: Acompanhamento Por Dia
        type: chart
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent14
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series por-dia (
            name: Por Dia
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select tipofoto
                         , quantidade 
                         , to_char(data,'DD/MM/RRRR') data
                    from (  select f.tipofoto tipofoto
                                 , count(1) quantidade
                                 , trunc(data) data
                            from fotosdocumentos f
                            where f.idrepresentante = :P351_IDREPRESENTANTE
                              and f.idsemana        = :P351_IDSEMANA
                            group by f.tipofoto
                                   , trunc(data) 
                            order by 3 desc )
                    where rownum <= 12
                    ```
                pageItemsToSubmit: [
                    P351_IDREPRESENTANTE
                    P351_IDSEMANA
                ]
            }
            columnMapping {
                seriesName: TIPOFOTO
                label: DATA
                value: QUANTIDADE
            }
        )

        axis x (
            name: x
            title: Data
            value {
                format: dateMedium
                formatScaling: thousand
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Quantidade
            value {
                format: decimal
                decimalPlaces: 0
            }
            minorTicks {
                show: false
            }
        )

    )

    region ano (
        name: Ano 2017
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select initcap(to_char(f.data,'day')) dia
                     , COUNT(1) qtd
                from fotosdocumentos f
                where to_char(f.data,'RRRR') = to_char(sysdate,'RRRR')-1
                  and f.recebida = 'S'
                  and exists ( select 1
                               from representantes r
                               where r.idgerente = ( select idgerente
                                                     from gerentes 
                                                     where idfilial = :P0_IDFILIAL ) ) 
                group by to_char(f.data,'day')
                order by 2 desc
                ```
        }
        layout {
            sequence: 10
            parentRegion: @fotos-tiradas-por-dia
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: DIA
            valueColumn: QTD
            valueDisplay: percentage
            barWidthCalculation: relative
            maximumRows: 7
            messageWhenNoDataFound: Nenhum dado encontrado.
        }
    )

    region ano-2 (
        name: Ano 2018
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select initcap(to_char(f.data,'day')) dia
                     , COUNT(1) qtd
                from fotosdocumentos f
                where to_char(f.data,'RRRR') = to_char(sysdate,'RRRR')
                   and f.recebida = 'S'
                   and exists ( select 1
                               from representantes r
                               where r.idgerente = ( select idgerente
                                                     from gerentes 
                                                     where idfilial = :P0_IDFILIAL ) ) 
                group by to_char(f.data,'day')
                order by 2 desc
                ```
        }
        layout {
            sequence: 20
            parentRegion: @fotos-tiradas-por-dia
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: DIA
            valueColumn: QTD
            valueDisplay: percentage
            barWidthCalculation: relative
            maximumRows: 7
            messageWhenNoDataFound: Nenhum dado encontrado.
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region fotos-tiradas-por-dia (
        name: Fotos Tiradas por Dia
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region total-geral (
        name: Total Geral
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select representante
                    , quantidade
                from (  select pck_romance.fnc_nomerepresentante(f.idrepresentante) representante
                             , count(1) quantidade
                        from fotosdocumentos f
                        where f.recebida = 'S'
                          and exists ( select 1
                                       from representantes r
                                       where r.idrepresentante = f.idrepresentante 
                                         and r.ativo = 'S' 
                                         and r.idgerente = ( select idgerente 
                                                             from gerentes
                                                             where idfilial = :P0_IDFILIAL ) )
                        group by idrepresentante
                        order by 1 )
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent13
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: REPRESENTANTE
            valueColumn: QUANTIDADE
            layout: 5Columns
            chartType: circular
            chartSize: medium
            color: yes
        }
    )

    region total-semanal (
        name: Total Semanal
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select tipofoto tipofoto
                    , 'Qtd Total: '||quantidade QTD
                from (  select f.tipofoto tipofoto
                             , count(1) quantidade
                        from fotosdocumentos f
                        where f.idrepresentante = :P351_IDREPRESENTANTE
                          and f.idsemana        = :P351_IDSEMANA
                        group by f.tipofoto
                        order by 2 desc )
                where rownum <= 12
                ```
            pageItemsToSubmit: [
                P351_IDREPRESENTANTE
                P351_IDSEMANA
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: TIPOFOTO
            valueColumn: QTD
        }
    )

    pageItem P351_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' ( '||r.idrepresentante||' ) - '||decode(r.ativo,'S','Ativo','N','Inativo') display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1 
                ```
            nullDisplayValue: - Selecione o Distribuidor -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P351_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semana||'/'||s.ano display_value
                     , s.idsemana return_value
                from semana_dias s
                where s.ano between 2017 and 2018
                order by s.idsemana desc
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction alterar-informações (
        name: Alterar Informações
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P351_IDREPRESENTANTE
                P351_IDSEMANA
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @total-semanal
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @acompanhamento-por-dia
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

