page 416 (
    name: Registros de CCF Detalhados
    title: Registros de CCF Detalhados
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 800
        height: 300
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cheques-detalhados (
        name: Cheques Detalhados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.codigo
                     , c.descricao 
                     , c.banco
                     , c.dataultimocheque
                     , c.origem
                     , c.quantidade
                from roman.chequesconsultaspc c
                where c.idconsultaspc = :P416_IDCONSULTASPC;
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: "Nenhum Cheque Encontrado! "
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 3477260718513971763
        }

        column BANCO (
            type: plainText
            heading {
                heading: Banco
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column CODIGO (
            type: plainText
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column DATAULTIMOCHEQUE (
            type: plainText
            heading {
                heading: Data Ultimo Cheque
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: M
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Motivo
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column ORIGEM (
            type: plainText
            heading {
                heading: Banco Origem
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: N
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: O
            }
        )

        savedReport 14733627 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BANCO (
                sequence: 3
            )

            displayColumn CODIGO (
                sequence: 1
            )

            displayColumn DATAULTIMOCHEQUE (
                sequence: 4
            )

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn ORIGEM (
                sequence: 5
            )

            displayColumn QUANTIDADE (
                sequence: 6
            )

            aggregate (
                column: VALOR
            )

        )

    )

    pageItem P416_IDCONSULTASPC (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cheques-detalhados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

