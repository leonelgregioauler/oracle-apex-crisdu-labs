    pageItem P746_IDPRODUTO (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto) as display_value
                     , p.idproduto            as return_value
                  from roman.produtos p
                 where p.idproduto in ( select distinct l.idproduto
                                          from logroman.log_itensvendadireta l
                                         where l.idvendadireta = :P746_IDVENDADIRETA)
                order by 1;
                ```
            nullDisplayValue: -Todos -
        }
        layout {
            sequence: 10
            region: @log-movimentações-itens-venda-direta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P746_IDVENDADIRETA (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    dynamicAction atualiza-região-itens-venda-direta (
        name: Atualiza região itens venda direta
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P746_IDPRODUTO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @log-movimentações-itens-venda-direta
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

