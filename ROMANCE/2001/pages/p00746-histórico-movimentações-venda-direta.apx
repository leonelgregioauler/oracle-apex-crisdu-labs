    region log-movimentações-itens-venda-direta (
        name: Log Movimentações Itens Venda Direta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select decode(l.tipoalteracao,'INSERT', 'Inserido', 'UPDATE', 'Alterado','Removido') as "Tipo Alteração"
                     , l.usuarioalteracao as "Usuário Alteração"
                     , l.dataalteracao as "Data Alteração"
                     , initcap(p.nomeproduto) "Produto"
                     , decode(l.comissao, 'S','Sim','Não') as "Comissão"
                     , l.valorvenda as "Valor Venda"
                     , l.valoracobrar as "Valor a Cobrar"
                     , nvl(l.qtd_pp,0) as "Qtd PP"
                     , nvl(l.qtd_p,0) as "Qtd P"
                     , nvl(l.qtd_m,0) as "Qtd M"
                     , nvl(l.qtd_g,0) as "Qtd G"
                     , nvl(l.qtd_gg,0) as "Qtd GG"
                     , nvl(l.qtd_egg,0) as "Qtd EGG"
                     , nvl(l.qtd_exgg,0) as "Qtd EXGG"
                     , nvl(l.qtd_u,0) as "Qtd U"
                     , nvl(l.qtdtotal,0) as "Qtd Total"
                  from logroman.log_itensvendadireta l
                     , roman.produtos p
                 where p.idproduto = l.idproduto
                   and l.idvendadireta = :P746_IDVENDADIRETA
                   and ( :P746_IDPRODUTO is null or p.idproduto = :P746_IDPRODUTO)
                 order by l.idlog desc;
                ```
            pageItemsToSubmit: P746_IDPRODUTO
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1321619835137606449
        }

