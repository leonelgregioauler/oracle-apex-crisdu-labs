    region log-movimentações-venda-direta (
        name: Log Movimentações Venda Direta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select decode(l.tipoalteracao,'INSERT', 'Inserido', 'UPDATE', 'Alterado','Removido') as "Tipo Alteração"
                     , l.usuarioalteracao as "Usuário Alteração"
                     , l.dataalteracao as "Data Alteração"
                     , roman.pck_romance.fnc_nomefilial(l.idfilial) as "Franquia"
                     , l.semana as "Semana"
                     , l.data as "Data Venda Direta"
                     , initcap(p.nomepessoa) as "Funcionário"
                     , l.descricao as "Descrição"
                     , decode(l.idsituacao, 1,'Aberta', 2,'Em Atendimento', 'Concluída') as "Situação"
                     , l.valortotal as "Valor Total"
                     , l.valorpago as "Valor Pago"
                     , l.saldo as "Saldo"
                  from logroman.log_vendasdiretas l
                     , catal.funcionarios f
                     , catal.pessoas p
                 where f.idfuncionario = l.idfuncionario
                   and p.idpessoa = f.idpessoa
                   and l.idvendadireta = :P746_IDVENDADIRETA
                 order by l.idlog;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1321618227676606433
        }

