page 794 (
    name: Lista Brindes
    title: Lista Brindes
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region brindes-conquistou-levou (
        name: "Brindes Conquistou Levou "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.idbrindeclube
                     , b.nomebrinde
                     , decode(b.classificacao, 'S','SIM','NÃO') classificacao
                     , decode(b.recompensa, 'S','SIM','NÃO')  recompensa
                     , decode(b.status, 'S','ATIVO','INATIVO')  status
                     , b.idbrindeclube xxxx
                     , ( select p.nome
                         from paises p
                         where p.idpais = b.idpais ) pais
                from roman.brindesclub b
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1800771947862206013
        }

        column CLASSIFICACAO (
            type: plainText
            heading {
                heading: Classificação
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column IDBRINDECLUBE (
            type: link
            heading {
                heading: Ver/Editar
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    page: 797
                    items: {
                        P797_IDBRINDECLUBE: #IDBRINDECLUBE#
                    }
                    clearCache: 797
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMEBRINDE (
            type: plainText
            heading {
                heading: Brinde
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column PAIS (
            type: plainText
            heading {
                heading: País
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: N
            }
        )

        column RECOMPENSA (
            type: plainText
            heading {
                heading: Recompensa
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column XXXX (
            type: plainText
            heading {
                heading: Xxxx
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: M
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 18008008 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CLASSIFICACAO (
                sequence: 4
            )

            displayColumn IDBRINDECLUBE (
                sequence: 1
            )

            displayColumn NOMEBRINDE (
                sequence: 2
            )

            displayColumn PAIS (
                sequence: 6
            )

            displayColumn RECOMPENSA (
                sequence: 5
            )

            displayColumn STATUS (
                sequence: 3
            )

        )

    )

    button cadcaracteristica (
        buttonName: CADCARACTERISTICA
        label: Nova Característica
        layout {
            sequence: 40
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 799
                clearCache: 799
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

