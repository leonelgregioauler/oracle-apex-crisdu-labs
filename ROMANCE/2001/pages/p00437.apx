page 437 (
    name: ComissaoPagarGer
    title: ComissaoPagarGer
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function somavalor() {
               var vNum = 0;
               $("#P437_TOTAL").val(vNum);
               var theForm = document.wwv_flow;
               var vTemp = 0;
                
               if (theForm) {
                   for(i=0;i<theForm.f01.length;i++){
                        if(theForm.f01[i].checked){
                            vNum = $(theForm.f03[i]).val();
                            vNum = vNum.replace(',','.');
                            vTemp = parseFloat(vTemp) + parseFloat(vNum);
                            document.getElementById('P437_TOTAL').value = vTemp;   
                        }
                   }
            
                } else {
                        vNum = $("#f09_0001").val();
                        vNum = vNum.replace(',','.');
                        //vTemp = parseFloat(vTemp) + parseFloat(vNum);
                        $("#P437_TOTAL").val(vNum);
                    }
                 // document.getElementById('P436_TOTAL').value = vTemp;        
                
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region pagamento-de-comissões (
        name: Pagamento de Comissões
        type: tabform
        source {
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomevendedora((select idvendedora from notasvendas where idnotavenda = p.idnotavenda)) vendedora
                     , p.idgerente
                     , p.valorcomissaoger
                     , p.idpagamentocom
                     , p.datapagamentoger
                     , p.idfechamentoger
                     , n.datanota
                     , n.valortotalvenda
                     , n.basecomissao
                     , pck_util.fnc_semanaid(p.idsemana) semana
                  from PAGAMENTOSCOMISSOESECOM p
                     , notasvendas n
                 where n.idnotavenda = p.idnotavenda
                   and p.idgerente   = :P437_IDGERENTE
                   and p.datapagamentoger is null
                   and :P437_TIPO = 'P'
                   and p.idfechamentoger  is null
                union
                select roman.pck_romance.fnc_nomevendedora((select idvendedora from notasvendas where idnotavenda = p.idnotavenda)) vendedora
                     , p.idgerente
                     , p.valorcomissaoger
                     , p.idpagamentocom
                     , p.datapagamentoger
                     , p.idfechamentoger
                     , n.datanota
                     , n.valortotalvenda
                     , n.basecomissao
                     , pck_util.fnc_semanaid(p.idsemana) semana
                  from PAGAMENTOSCOMISSOESECOM p
                     , notasvendas n
                 where n.idnotavenda = p.idnotavenda
                   and p.idgerente   = :P437_IDGERENTE
                   and p.datapagamentoger is not null
                   and :P437_TIPO = 'V'
                   and p.idfechamentoger = :P437_IDFECHAMENTOREPRES
                ```
            pageItemsToSubmit: P437_IDGERENTE
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: onClick="javascript:somavalor();"
        }
        reportLayout {
            numberOfRows: 150
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhuma comissão pendente!
        }
        componentAdvanced {
            stripHtml: true
        }

