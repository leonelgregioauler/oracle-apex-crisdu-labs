    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-set-value (
            action: setValue
            settings {
                value: 0
            }
            affectedElements {
                selectionType: items
                items: P437_TOTAL
            }
            execution {
                sequence: 10
            }
        )

    )

    process pagacomissao (
        name: PagaComissao
        type: executeCode
        editableRegion: @pagamento-de-comissões
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  ---raise_application_error(-20001,'xxxxxxxx='||:IDPAGAMENTOCOM);
                      update pagamentosComissoeseCom u
                      set dataPagamentoGer = sysdate 
                        , u.idfechamentoGer = :P437_IDFECHAMENTOREPRES
                      where idpagamentocom = :IDPAGAMENTOCOM;
                  --
                  commit;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Comissão paga com sucesso!!
        }
        advanced {
            executionMappingIdentifier: 28467841925191838
        }
        serverSideCondition {
            whenButtonPressed: @pagar
            type: itemIsNotNull
            item: P437_IDGERENTE
        }
    )

)

