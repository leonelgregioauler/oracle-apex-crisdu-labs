page 616 (
    name: Pontuação Motivou Levou
    title: Pontuação Motivou Levou
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pontuação (
        name: Pontuação
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.filial
                     , w.semana
                     , w.idmetricacampanha
                     , w.metrica
                     , w.grupo
                     , w.nivel
                     , w.media
                     , w.pontos
                from vw_pontuacaocampanha w
                where w.idfilial = :P0_IDFILIAL
                  and ( :P616_TIPO_PESQUISA is null 
                    or ( :P616_TIPO_PESQUISA = 'S' and w.idsemana = :P616_IDSEMANA )
                    or ( :P616_TIPO_PESQUISA = 'P' and w.idsemana between :P616_IDSEMANA_INI and :P616_IDSEMANA_FIM ) )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5589905292669058207
        }

        column FILIAL (
            type: hidden
            heading {
                heading: Filial
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column GRUPO (
            type: plainText
            heading {
                heading: Grupo
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDMETRICACAMPANHA (
            type: plainText
            heading {
                heading: Idmetricacampanha
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column MEDIA (
            type: plainText
            heading {
                heading: Média
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column METRICA (
            type: plainText
            heading {
                heading: Métrica
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column NIVEL (
            type: plainText
            heading {
                heading: Nível
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column PONTOS (
            type: plainText
            heading {
                heading: Pontos
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 55899779 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn GRUPO (
                sequence: 3
            )

            displayColumn MEDIA (
                sequence: 5
            )

            displayColumn METRICA (
                sequence: 2
            )

            displayColumn NIVEL (
                sequence: 4
            )

            displayColumn PONTOS (
                sequence: 6
            )

            displayColumn SEMANA (
                sequence: 1
            )

            sort (
                column: IDMETRICACAMPANHA
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: PONTOS
            )

            controlBreak (
                column: SEMANA
                layout {
                    sequence: 1
                }
            )

            highlight ir-condition (
                name: Bronze
                condition {
                    column: NIVEL
                    value: Bronze
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #CD7F32
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-2 (
                name: Diamante
                condition {
                    column: NIVEL
                    value: Diamante
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #DCC5DD
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-3 (
                name: Ouro
                condition {
                    column: NIVEL
                    value: Ouro
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #FFD700
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-4 (
                name: Prata
                condition {
                    column: NIVEL
                    value: Prata
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #C0C0C0
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

    pageItem P616_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta 
                     , s.idsemana
                from semana_dias s
                   , campanhas c
                where c.tipocampanha = 'M'
                  and s.idsemana between pck_util.fnc_idsemana(c.semanaini) and pck_util.fnc_idsemana(c.semanafim) 
                order by 2
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P616_IDSEMANA_FIM (
        type: selectList
        label {
            label: Até Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta 
                     , s.idsemana
                from semana_dias s
                   , campanhas c
                where c.tipocampanha = 'M'
                  and s.idsemana between pck_util.fnc_idsemana(c.semanaini) and pck_util.fnc_idsemana(c.semanafim) 
                order by 2
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P616_IDSEMANA_INI (
        type: selectList
        label {
            label: Semana de
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta 
                     , s.idsemana
                from semana_dias s
                   , campanhas c
                where c.tipocampanha = 'M'
                  and s.idsemana between pck_util.fnc_idsemana(c.semanaini) and pck_util.fnc_idsemana(c.semanafim) 
                order by 2
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P616_TIPO_PESQUISA (
        type: radioGroup
        label {
            label: Pesquisar por
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Por Semana;S,Por Período;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-semana (
        name: Tipo Semana
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P616_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P616_TIPO_PESQUISA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P616_IDSEMANA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P616_IDSEMANA_INI
                    P616_IDSEMANA_FIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P616_IDSEMANA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P616_IDSEMANA_INI
                    P616_IDSEMANA_FIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 616
                items: {
                    P616_TIPO_PESQUISA: &P616_TIPO_PESQUISA.
                    P616_IDSEMANA: &P616_IDSEMANA.
                    P616_IDSEMANA_INI: &P616_IDSEMANA_INI.
                    P616_IDSEMANA_FIM: &P616_IDSEMANA_FIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

