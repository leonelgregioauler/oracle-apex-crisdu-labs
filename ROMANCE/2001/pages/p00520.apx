            encryptSessionState: false
        }
    )

    pageItem P520_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano d
                     , idsemana r
                from semana_dias s
                where idsemana between pck_util.fnc_idsemanadata(sysdate)-30 and pck_util.fnc_idsemanadata(sysdate)
                order by s.idsemana desc
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

