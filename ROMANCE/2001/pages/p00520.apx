    region balanço-de-catálogos-2 (
        name: Balanço de Catálogos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(t.idrepresentante) distribuidor
                     , sum(t.qtdrecebido) qtdrecebido
                     , sum(t.qtddistribuido) qtddistribuido
                     , sum(t.qtdgerado) qtdgerado
                     , sum(t.qtdrecebido - qtddistribuido - qtdgerado) saldo
                     , idrepresentante
                     , case
                         when sum(t.qtdrecebido - qtddistribuido) > 0 then
                           '<a href=javascript:apex.submit({request:''GERARVENDA'',set:{''P520_IDREPRESENTANTE_VENDA'':'||idrepresentante||'}});><img src=/i/menu/pencil16x16.gif alt=Gerar Venda border=0 width=16 height=16></a>' 
                         else
                           ' - '
                       end gerarvenda
                from (
                       select r.idrepresentante
                            , nvl( ( select sum(( nvl(qtd_dist_pp ,0)
                                            + nvl(qtd_dist_p ,0)
                                            + nvl(qtd_dist_m ,0)
                                            + nvl(qtd_dist_g ,0)
                                            + nvl(qtd_dist_gg,0)
                                            + nvl(qtd_dist_egg,0)
                                            + nvl(qtd_dist_exgg,0)
                                            + nvl(qtd_dist_u,0) ))
                                     from itenscargarepresentante ic
                                     where ic.idestoquefil = :P520_IDESTOQUEFILIAL
                                       and exists ( select 1
                                                    from cargasrepresentantes c
                                                    where c.idcargarepresentante = ic.idcargarepresentante
                                                      and c.idrepresentante      = r.idrepresentante
                                                      and c.situacao             = 3 -- concluida
                                                      and c.idsemana             = s.idsemana ) )  ,0) qtdrecebido
                             , nvl( ( select sum(it.quantidade)
                                      from itensnotavenda it
                                      where it.idestoquefil = :P520_IDESTOQUEFILIAL
                                        and exists ( select 1
                                                     from notasvendas nv
                                                     where nv.idnotavenda          = it.idnotavenda
                                                       and nv.idsemanadistribuicao = s.idsemana
                                                       and nv.idsituacaonotavenda  in (3,4)
                                                       and nv.idrepresentante      = r.idrepresentante
                                                       and not exists ( select 1
                                                                        from classificacoesnotasvendas cn
                                                                        where cn.idcaracteristicanotavenda = 33
                                                                          and cn.idnotavenda               = nv.idnotavenda ) ) ) ,0) qtddistribuido
                             , nvl( ( select sum(it.quantidade)
                                      from itensnotavenda it
                                      where it.idestoquefil = :P520_IDESTOQUEFILIAL
                                        and exists ( select 1
                                                     from notasvendas nv
                                                     where nv.idnotavenda          = it.idnotavenda
                                                       and nv.idsemanadistribuicao = s.idsemana
                                                       and nv.idsituacaonotavenda  in (3,4)
                                                       and nv.idrepresentante      = r.idrepresentante
                                                       and exists ( select 1
                                                                    from classificacoesnotasvendas cn
                                                                    where cn.idcaracteristicanotavenda = 33
                                                                      and cn.idnotavenda               = nv.idnotavenda ) ) ) ,0) qtdgerado
                       from semana_dias s
                           , representantes r
                       where r.idgerente = ( select idgerente
                                             from gerentes g
                                             where g.idfilial = :P0_IDFILIAL )
                         and r.ativo = 'S'
                         and ( :P520_TIPOPESQUISA is null
                            or ( :P520_TIPOPESQUISA = 'S' and s.idsemana = :P520_SEMANA )
                            or ( :P520_TIPOPESQUISA = 'P' and s.idsemana between :P520_SEMANA_INI and :P520_SEMANA_FIM ) )
                         and ( :P520_IDREPRESENTANTE is null or r.idrepresentante = :P520_IDREPRESENTANTE )
                         and :P520_IDESTOQUEFILIAL is not null
                         and :P520_TIPORELATORIO = 'R' ) t
                group by idrepresentante
                order by 1
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P520_TIPORELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: "Nenhum resultado encontrado! "
        }
        advanced {
            savedReportMappingIdentifier: 1585634543179790122
        }

