    dynamicAction tipo-pesquisa (
        name: Tipo Pesquisa
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P520_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P520_TIPOPESQUISA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P520_SEMANA_INI
                    P520_SEMANA_FIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P520_SEMANA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P520_SEMANA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P520_SEMANA_INI
                    P520_SEMANA_FIM
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

    validation valida-filtrar (
        name: Valida Filtrar
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P520_IDESTOQUEFILIAL
        }
        error {
            errorMessage: Por favor, escolha o catálogo para ver o balanço dos distribuidores.
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    process gera-venda-para-distribuidor (
