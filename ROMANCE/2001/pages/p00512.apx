page 512 (
    name: Venda Direta Recebida da Favorita
    title: Venda Direta Recebida da Favorita
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region pedidos-detalhados (
        name: Pedidos Detalhados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido  
                     , pck_romance.fnc_nomevendedora(idvendedora) consultora
                     , pp.databaixa
                     , round(( p.valorapagar-( select sum(i.valorcomissaodistribuidor)
                                               from favorita.itenspedidos i
                                               where i.idpedido = p.idpedido )-( p.valorapagar * 0.05 ) ),2) valorsomarcaixa
                     , favorita.pck_util_fav.fnc_nomeusuario( pp.idusuariopagamento ) || decode(pp.idusuariopagamento,2542,' [Automático]') observacao  
                from favorita.pedidos      p   
                   , favorita.vencimentospedidos v
                   , favorita.pagamentospedidos  pp
                where p.tipopedido          = 'V' --venda direta   
                  and v.situacaovencimento  = 'V'
                  and v.idpedido            = p.idpedido
                  and pp.idvencimentopedido = v.idvencimentopedido
                  and pp.idfechamento       = :P512_IDFECHAMENTO
                order by 3
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CONSULTORA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column DATABAIXA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data baixa
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
            sorting {
                sortable: false
            }
        )

        column IDPEDIDO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nr Pedido
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column VALORSOMARCAIXA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Entrou no Caixa
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

    )

    pageItem P512_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @pedidos-detalhados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

