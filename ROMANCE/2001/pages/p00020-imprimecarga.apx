page 20 (
    name: Imprime Carga
    alias: IMPRIMECARGA
    title: Imprime Carga
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region font-color-white-font (
        name: <font color="white"></font>
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_imprime.prc_imprimecargafilial( vidfilial        => :P20_IDFILIAL
                                                    , vidrepresentante => :P20_IDREPRESENTANTE
                                                    , vsemana          => :P20_SEMANA
                                                    , vcargamais       => :P20_CARGAMAIS );
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P20_CARGAMAIS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @font-color-white-font
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P20_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @font-color-white-font
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P20_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @font-color-white-font
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P20_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @font-color-white-font
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

