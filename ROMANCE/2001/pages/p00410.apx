page 410 (
    name: Histórico de Movimentações de Insumos
    title: Histórico de Movimentações de Insumos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region histórico-de-movimentação (
        name: Histórico de Movimentação
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.idmovtoestoqueinsumo
                     , m.idestoqueinsumo
                     , m.idproduto
                     , p.codigosisdist||' - '||initcap(p.nomeproduto) produto
                     , m.datamovimento
                     , decode(m.tipo,'E','Entrada','S','Consumo Interno','V','Venda') tipo
                     , m.quantidade
                     , m.usuario
                     , m.observacao
                     , m.idsemana
                     , pck_util.fnc_semanaid(m.idsemana) semana
                from movimentosestoquesinsumos m
                   , produtos p
                where p.idproduto = m.idproduto
                  and m.idfilial  = :P0_IDFILIAL
                order by datamovimento desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4437878196879677071
        }

