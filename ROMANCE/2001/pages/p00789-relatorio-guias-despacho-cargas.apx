page 789 (
    name: Relatorio Guias Despacho - Cargas
    alias: RELATORIO-GUIAS-DESPACHO-CARGAS
    title: Relatorio Guias Despacho - Cargas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }

    region relatorio-guias-despacho-cargas (
        name: Relatorio Guias Despacho - Cargas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select folio, fchemis, pdfdtemite as URL_PDF
                       --'<a href="' || pdfdtemite || '" target="_blank">' ||
                       --'Clique para Visualizar PDF do DTEMITE' ||
                       --'</a>' as URL_PDF
                  from cargasrepres_dtemite
                 where idcargarepresentante = :P789_IDCARGAREPRES
                 order by idcargadtemite desc
                ```
            pageItemsToSubmit: P789_IDCARGAREPRES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 3125715479152497988
        }

        column FCHEMIS (
            type: plainText
            heading {
                heading: Emissión
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: DD-MM-YYYY HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column FOLIO (
            type: plainText
            heading {
                heading: Folio
                alignment: end
            }
            layout {
                sequence: 12
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column URL_PDF (
            type: plainText
            heading {
                heading: Url Pdf
            }
            layout {
                sequence: 22
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
            security {
                escapeSpecialChars: false
            }
        )

        savedReport 13349292 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FCHEMIS (
                sequence: 2
            )

            displayColumn FOLIO (
                sequence: 1
            )

            displayColumn URL_PDF (
                sequence: 3
            )

        )

    )

    pageItem P789_IDCARGAREPRES (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @relatorio-guias-despacho-cargas
            slot: regionBody
        }
    )

)

