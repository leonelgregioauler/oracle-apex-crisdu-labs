    pageItem P432_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial in ('D','L')
                  and exists ( select 1
                               from usuariosfiliais uf
                               where uf.usuario = v('APP_USER') 
                                 and uf.idfilial = f.idfilial )
                ```
            nullDisplayValue: - Selecione a Empresa -
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: item=value
            item: P432_LIBERADO
            value: N
        }
