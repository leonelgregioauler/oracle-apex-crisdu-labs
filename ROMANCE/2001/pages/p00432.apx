    process verifica-acessos (
        name: Verifica Acessos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vliberaacesso varchar2(1);
                begin
                  --
                  begin
                    select 'S'
                    into vliberaacesso
                    from dual
                    where exists ( select 1
                                   from usuarios u
                                      , gerentes g
                                   where g.idpessoa = u.idpessoa 
                                     and u.usuario = v('APP_USER'));
                  exception
                    when others then
                      vliberaacesso := 'N';
                  end;
                  --
                  begin 
                    select 'S'
                    into vliberaacesso
                    from dual
                    where ( exists ( select 1
                                     from usuariosgruposatendimento ug
                                     where ug.usuario = v('APP_USER')
                                       and ug.idgrupoatendimento in (0,1) )
                          or ( v('APP_USER') in ('EDUARDO','RITAS','GUILHERME','PRISCILAREIS','CAMILAE','FERNANDAZS','SAMANTASIQUEIRA','PAMELAB','THAISW','FERNANDANF','RICIERYS','BIANCAPADILHA','ALEXQ','LAURAF','RAFAELRC','KEILASOUZA','ALEXANDREH','MATHEUSSCHMIDT','JENIFEROLIVEIRA','LUCASBRENTANO','LUANASILVA','MARIACLOPES','ANGELICAJIENSUR','LUCIANOKRAFCIZINSKI','VERIDIANAMAZOTI','MARIELAC','SUELENBAUER','RENANSILVA') ) );
                  exception
                    when NO_DATA_FOUND then
                      vliberaacesso := 'N';
                  end;
                  --
                  if vliberaacesso is null then
                    vliberaacesso := 'N';
                  end if;
                  --
                  :P432_LIBERADO := vliberaacesso;
                  --
                exception 
                  when others then
                    vliberaacesso := 'N';
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 2575159150672387138
        }
    )

    branch (
        name: Go To Page 432
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 432
                items: {
                    P432_TIPOPESQUISA: &P432_TIPOPESQUISA.
                    P432_IDGRUPO: &P432_IDGRUPO.
                    P432_IDEMPRESA: &P432_IDEMPRESA.
                    P432_IDPRODUTO: &P432_IDPRODUTO.
                    P432_TODOSPRODUTOS: &P432_TODOSPRODUTOS.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

