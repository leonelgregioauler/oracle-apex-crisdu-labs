            encryptSessionState: false
        }
    )

    pageItem P432_IDGRUPO (
        type: selectList
        label {
            label: Grupo de Empresas
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.descricao||' - '||( select LISTAGG(F.nome, ', ') within group (order by f.idgrupo , f.nome) empresas
                                             from vw_filiais f
                                             where f.idgrupo = g.idgrupo) display_value
                     , g.idgrupo return_value
                from gruposromance g
                order by idgrupo;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: item=value
            item: P432_LIBERADO
            value: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P432_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist||' - '||p.nomeproduto display_value
                     , p.idproduto return_value
                from produtos p
                where p.ativo = 'S'
                  /*and exists ( select 1
                               from fotosprodutos f
                               where f.idproduto = p.idproduto )*/
                  and exists ( select 1
                               from estoquefilial e
                               where e.idproduto = p.idproduto
                                 and e.ativo     = 'S' )
                order by p.nomeproduto
                ```
            nullDisplayValue: "- Escolha um Produto - "
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

