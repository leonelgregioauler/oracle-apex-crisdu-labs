    region controle-de-todos-produtos (
        name: Controle de Todos Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeproduto(e.idproduto) produto
                     , ( select codigosisdist
                         from produtos p
                         where p.idproduto = e.idproduto ) codigo
                     , decode(e.comissao,'S','Com Comissão','N','Sem Comissão') comissao
                     , e.vlrvenda
                     , (nvl(e.qtd_p,0)
                      + nvl(e.qtd_pp,0)
                      + nvl(e.qtd_m,0)
                      + nvl(e.qtd_g,0)
                      + nvl(e.qtd_gg,0)
                      + nvl(e.qtd_egg,0)
                      + nvl(e.qtd_exgg,0)
                      + nvl(e.qtd_u,0) ) fisico
                     , nvl(carga.qtd,0) carga
                     , nvl(consultoras.qtd,0) consultoroas
                     , ( (nvl(e.qtd_p,0)
                          + nvl(e.qtd_pp,0)
                          + nvl(e.qtd_m,0)
                          + nvl(e.qtd_g,0)
                          + nvl(e.qtd_gg,0)
                          + nvl(e.qtd_egg,0)
                          + nvl(e.qtd_exgg,0)
                          + nvl(e.qtd_u,0) ) + nvl(carga.qtd,0) + nvl(consultoras.qtd,0) ) total
                from estoquefilial e
                   , ( select it.idproduto
                            , sum( nvl(it.qtd_dist_pp,0)
                                 + nvl(it.qtd_dist_p,0)
                                 + nvl(it.qtd_dist_m,0)
                                 + nvl(it.qtd_dist_g,0)
                                 + nvl(it.qtd_dist_gg,0)
                                 + nvl(it.qtd_dist_egg,0)
                                 + nvl(it.qtd_dist_exgg,0)
                                 + nvl(it.qtd_dist_u,0) ) qtd
                        from cargasrepresentantes c
                           , itenscargarepresentante it
                        where c.idcargarepresentante = ( select max(cc.idcargarepresentante)
                                                         from cargasrepresentantes cc
                                                         where cc.idfilial = c.idfilial 
                                                           and cc.situacao = 3 )
                          and c.idfilial = :P432_IDEMPRESA 
                          and it.idcargarepresentante = c.idcargarepresentante
                        group by it.idproduto ) carga
                     , ( select e.idproduto
                              , sum(itv.quantidade) qtd
                         from notasvendas nv
                            , itensnotavenda itv
                            , estoquefilial e
                         where itv.idnotavenda = nv.idnotavenda
                           and e.idfilial = :P432_IDEMPRESA 
                           and nv.idsituacaonotavenda = 3
                           and e.idestoquefilial = itv.idestoquefil
                         group by e.idproduto ) consultoras
                where e.idfilial = :P432_IDEMPRESA 
                  and carga.idproduto(+) = e.idproduto
                  and consultoras.idproduto(+) = e.idproduto
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
