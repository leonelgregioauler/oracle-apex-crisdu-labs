    region controle-de-produtos (
        name: Controle de Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , fisico.comissao
                     , fisico.vlrvenda
                     , nvl(fisico.qtd,0) fisico
                     , nvl(carga.qtd,0) carga
                     , nvl(consultoras.qtd,0) consultoroas
                     , ( nvl(fisico.qtd,0) + nvl(carga.qtd,0) + nvl(consultoras.qtd,0) ) total
                from vw_filiais f
                   , ( select e.idfilial 
                            , decode(e.comissao,'S','Com Comissão','N','Sem Comissão') comissao
                            , e.vlrvenda
                            , pck_estoque.fnc_esttotalDISPfilial(e.idestoquefilial) qtd
                       from estoquefilial e
                       where e.idproduto = :P432_IDPRODUTO
                         and ( :P432_TIPOPESQUISA = 'T' 
                             or ( :P432_TIPOPESQUISA = 'G' and exists ( select 1 
                                                                        from vw_filiais ff
                                                                        where ff.idfilial = e.idfilial
                                                                          and ff.idgrupo = :P432_IDGRUPO )
                             or ( :P432_TIPOPESQUISA = 'E' and e.idfilial = :P432_IDEMPRESA ) ) )
                       group by e.idfilial , vlrvenda , comissao, e.idestoquefilial ) fisico
                    , ( select c.idfilial
                             , sum( nvl(it.qtd_dist_pp,0)
                                  + nvl(it.qtd_dist_p,0)
                                  + nvl(it.qtd_dist_m,0)
                                  + nvl(it.qtd_dist_g,0)
                                  + nvl(it.qtd_dist_gg,0)
                                  + nvl(it.qtd_dist_egg,0)
                                  + nvl(it.qtd_dist_exgg,0)
                                  + nvl(it.qtd_dist_u,0) ) qtd
                        from cargasrepresentantes c
                           , itenscargarepresentante it
                        where c.idcargarepresentante = ( select max(cc.idcargarepresentante)
                                                         from cargasrepresentantes cc
                                                         where cc.idfilial = c.idfilial 
                                                           and cc.situacao = 3 )
                          and ( :P432_TIPOPESQUISA = 'T' 
                             or ( :P432_TIPOPESQUISA = 'G' and exists ( select 1 
                                                                        from vw_filiais ff
                                                                        where ff.idfilial = c.idfilial
                                                                          and ff.idgrupo = :P432_IDGRUPO )
                             or ( :P432_TIPOPESQUISA = 'E' and c.idfilial = :P432_IDEMPRESA ) ) )
                          and it.idcargarepresentante = c.idcargarepresentante
                          and it.idproduto = :P432_IDPRODUTO 
                        group by c.idfilial ) carga
                     , ( select nv.idfilial
                              , sum(itv.quantidade) qtd
                         from notasvendas nv
                            , itensnotavenda itv
                            , estoquefilial e
                         where itv.idnotavenda = nv.idnotavenda
                           and ( :P432_TIPOPESQUISA = 'T' 
                             or ( :P432_TIPOPESQUISA = 'G' and exists ( select 1 
                                                                        from vw_filiais ff
                                                                        where ff.idfilial = nv.idfilial
                                                                          and ff.idgrupo = :P432_IDGRUPO )
                             or ( :P432_TIPOPESQUISA = 'E' and nv.idfilial = :P432_IDEMPRESA ) ) )
                           and nv.idsituacaonotavenda = 3
                           and e.idestoquefilial = itv.idestoquefil
                           and e.idproduto = :P432_IDPRODUTO 
                         group by nv.idfilial ) consultoras
                where f.ativo = 'S'
                  and f.tipofilial in ('D','L')
                  and f.idfilial not in ( 1063 , 1079 )
                  and exists ( select 1
                               from notasvendas nv
                               where nv.idfilial = f.idfilial )
                  and ( :P432_TIPOPESQUISA = 'T' 
                       or ( :P432_TIPOPESQUISA = 'G' and f.idgrupo = :P432_IDGRUPO )
                       or ( :P432_TIPOPESQUISA = 'E' and f.idfilial = :P432_IDEMPRESA ) )
                  and fisico.idfilial(+) = f.idfilial
                  and carga.idfilial(+) = f.idfilial
                  and consultoras.idfilial(+) = f.idfilial
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P432_LIBERADO = 'S'
                  and :P432_TODOSPRODUTOS is null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1497774235290920525
        }

