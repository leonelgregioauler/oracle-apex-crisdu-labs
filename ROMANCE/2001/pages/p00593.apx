page 593 (
    name: Observações Acordos
    title: Observações Acordos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region observação (
        name: Observação
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P593_DATA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @observação
            slot: regionBody
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P593_IDOBSERVACAONEGOCIACAO
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P593_IDNEGOCIACAOPARCEIRO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @observação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P593_IDOBSERVACAONEGOCIACAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @observação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P593_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @observação
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select idusuario
                from usuarios 
                where usuario = v('APP_USER')
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P593_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @observação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P593_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 50
            region: @observação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
            height: 8
        }
        security {
            encryptSessionState: false
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 20
            region: @observação
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P593_IDOBSERVACAONEGOCIACAO
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 30
            region: @observação
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P593_IDOBSERVACAONEGOCIACAO
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 10
            region: @observação
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P593_IDOBSERVACAONEGOCIACAO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 40
            region: @observação
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 591
                items: {
                    P591_IDNEGOCIACAOPARCEIRO: &P593_IDNEGOCIACAOPARCEIRO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-em-observação (
        name: Consulta em Observação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                PCK_CADASTROS_RMC.PRC_OBSERVACOESNEGOCIACOES( PIDOBSERVACAONEGOCIACAO => :P593_IDOBSERVACAONEGOCIACAO,
                                                                PIDNEGOCIACAOPARCEIRO => :P593_IDNEGOCIACAOPARCEIRO,
                                                                PIDUSUARIO => :P593_IDUSUARIO,
                                                                PDATA => :P593_DATA,
                                                                POBSERVACAO => :P593_OBSERVACAO,
                                                                PMD5 => :P593_MD5,
                                                                POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 4954356550415263938
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P593_IDOBSERVACAONEGOCIACAO
        }
    )

    process processo-dml-em-observações (
        name: Processo DML em Observações
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdata  date;
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                   elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  PCK_CADASTROS_RMC.PRC_OBSERVACOESNEGOCIACOES( PIDOBSERVACAONEGOCIACAO => :P593_IDOBSERVACAONEGOCIACAO,
                                                                PIDNEGOCIACAOPARCEIRO => :P593_IDNEGOCIACAOPARCEIRO,
                                                                PIDUSUARIO => :P593_iDUSUARIO,
                                                                PDATA => vdata,
                                                                POBSERVACAO => :P593_OBSERVACAO,
                                                                PMD5 => :P593_MD5,
                                                                POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 4959558690804507426
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 593
                items: {
                    P593_IDOBSERVACAONEGOCIACAO: &P593_IDOBSERVACAONEGOCIACAO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('SALVAR','CRIAR')
        }
    )

    branch (
        name: Go To Page 593
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 593
                items: {
                    P593_IDOBSERVACAONEGOCIACAO:
                    P593_IDNEGOCIACAOPARCEIRO: &P593_IDNEGOCIACAOPARCEIRO.
                    P593_OBSERVACAO:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @deletar
        }
    )

)

