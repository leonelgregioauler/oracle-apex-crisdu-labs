page 448 (
    name: Lista de Notas da Cliente
    title: Lista de Notas da Cliente
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region notas-da-cliente (
        name: Notas da Cliente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.numeronota
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(nv.idregiaovenda) regiaovenda
                     , nv.datanota
                     , nv.valortotalnota
                     , nv.valortotalvendalqd
                     , nv.valorpago
                     , nv.saldo
                from notasvendas nv
                where nv.idsituacaonotavenda = 4
                  and nv.idvendedora         = :P448_IDVENDEDORA
                order by idnotavenda desc
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma Nota Encontrada
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1508327978198004015
        }

        column DATANOTA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column NUMERONOTA (
            type: plainText
            heading {
                heading: Nr Nota
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column REGIAOVENDA (
            type: plainText
            heading {
                heading: Região de Venda
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column SALDO (
            type: plainText
            heading {
                heading: Saldo
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column SEMANACOBRANCA (
            type: plainText
            heading {
                heading: Cobrança
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column SEMANADISTRIBUICAO (
            type: plainText
            heading {
                heading: Distribuição
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column VALORPAGO (
            type: plainText
            heading {
                heading: Pago
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column VALORTOTALNOTA (
            type: plainText
            heading {
                heading: Total da Nota
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column VALORTOTALVENDALQD (
            type: plainText
            heading {
                heading: Total Venda
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        savedReport 15083738 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATANOTA (
                sequence: 5
            )

            displayColumn NUMERONOTA (
                sequence: 1
            )

            displayColumn REGIAOVENDA (
                sequence: 4
            )

            displayColumn SALDO (
                sequence: 9
            )

            displayColumn SEMANACOBRANCA (
                sequence: 3
            )

            displayColumn SEMANADISTRIBUICAO (
                sequence: 2
            )

            displayColumn VALORPAGO (
                sequence: 8
            )

            displayColumn VALORTOTALNOTA (
                sequence: 6
            )

            displayColumn VALORTOTALVENDALQD (
                sequence: 7
            )

        )

    )

    pageItem P448_IDVENDEDORA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @notas-da-cliente
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

