page 542 (
    name: Log Entradas
    title: Log Entradas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region alterações-de-entradas (
        name: Alterações de Entradas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idfechamento
                     , e.usuarioalteracao
                     , decode(e.tipoalteracao,'INSERT','Inclusão','UPDATE','Atualização','DELETE','Exclusão') tipoalteracao
                     , e.dataalteracao
                     , e.identrada
                     , pck_romance.fnc_nomefilial(idfilial) idfilial
                     , pck_romance.fnc_nomefilial(idfilialorig) idfilialorig
                     , e.semana
                     , e.data
                     , e.valortotal 
                     , e.fechamentoorig
                     , e.descricao
                     , e.tipo
                     , ( select nomeconta
                         from contasfinanceiras c
                         where c.idcontafinan = e.idcontacontabil ) conta
                     , ( select nomeconta
                         from subcontasfinanceiras s
                         where s.idsubcontafinan = e.idsubcontacontabil ) subconta
                     , e.tipoentrada
                     , e.idmovimentogeral
                     , e.descricaoorigem
                from logroman.log_entradasdiversas e
                where e.idfechamento = :P542_IDFECHAMENTO
                order by e.dataalteracao desc;
                ```
            pageItemsToSubmit: P542_IDFECHAMENTO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum dado localizado!
        }
        advanced {
            savedReportMappingIdentifier: 56759049885110244
        }

        column CONTA (
            type: plainText
            heading {
                heading: Conta
                alignment: center
            }
            layout {
                sequence: 320
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AF
            }
        )

