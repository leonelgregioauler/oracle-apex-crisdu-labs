    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P542_IDFECHAMENTO (
        type: numberField
        label {
            label: ID Fechamento
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Informe o ID Fechamento
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P542_IDFECHAMENTO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @alterações-de-entradas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

