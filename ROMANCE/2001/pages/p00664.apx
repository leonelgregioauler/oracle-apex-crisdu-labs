    button nova-postagem (
        buttonName: NOVA_POSTAGEM
        label: Nova Postagem
        layout {
            sequence: 10
            region: @postagens
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 665
                items: {
                    P665_IDPOSTAGEMMARKETING:
                }
                clearCache: 665
