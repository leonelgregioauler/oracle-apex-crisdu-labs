page 664 (
    name: Postagens Vendas Plus
    title: Postagens Vendas Plus
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region postagens (
        name: "Postagens "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idpostagemmarketing
                     , data
                     , pck_romance.fnc_nomeusuario(usuario) usuario
                     , nome
                     , decode(tipo,'I','Imagem','V','Vídeo') tipo
                     , '<a href="'||endereco||'">'||endereco||'</a>' endereco
                     , '<a href="'||link||'">'||link||'</a>' link
                     , decode(appdestino ,1,'Minha Sacola Romance','Vendas') appdestino
                     , ordem            
                     , ( select min(d.datainicio)
                         from destinospostagensmarketing d
                         where d.idpostagemmarketing = p.idpostagemmarketing ) de
                     , ( select max(d.datafim)
                         from destinospostagensmarketing d
                         where d.idpostagemmarketing = p.idpostagemmarketing ) ate
                     , ( select listagg('<b>'||pck_romance.fnc_nomefilial(d.idfilial)||'</b>[ '||d.datainicio||'-'||d.datafim||']','<br>') within group (order by 1)
                         from destinospostagensmarketing d
                         where d.idpostagemmarketing = p.idpostagemmarketing
                       --    and rownum <= 10 
                       ) empresas
                from postagensmarketing  p
                where p.appdestino = 3
                order by idpostagemmarketing desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 665
                items: {
                    P665_IDPOSTAGEMMARKETING: #IDPOSTAGEMMARKETING#
                }
                clearCache: 665
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma Postagem realizada!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 101536201780818102
        }

