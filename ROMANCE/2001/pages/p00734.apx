    button create (
        buttonName: CREATE
        label: Novo Ciclo
        layout {
            sequence: 30
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 735
                items: {
                    P735_CICLOROMANCE:
                }
                clearCache: 735
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button deletar-ciclos (
        buttonName: DELETAR_CICLOS
        label: Deletar Ciclos Selecionados
        layout {
            sequence: 40
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from roman.usuariosgruposatendimento ug where ug.usuario = v('APP_USER') and ug.idgrupoatendimento in (0,58)
        }
    )

    dynamicAction atualiza-regiao (
        name: Atualiza_Regiao
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P734_CICLOROMANCE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction da-confirmar-deletar (
        name: DA_CONFIRMAR_DELETAR
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @deletar-ciclos
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.confirm("Confirma a exclusão dos ciclos selecionados? Esta ação não pode ser desfeita.", "DELETAR_CICLOS");
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process atualizarciclo (
        name: AtualizarCiclo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_metasromance.prc_gerametasdesafioromance(:P734_CICLOROMANCE,
                                                               V('APP_USER'),
                                                               'N',
                                                               'T');
                  commit;
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        successMessage {
            successMessage: Ciclo atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 2434713892707866970
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZARCICLO
        }
    )

