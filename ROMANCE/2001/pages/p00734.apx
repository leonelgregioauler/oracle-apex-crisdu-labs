page 734 (
    name: Relatorio Metas RMC Distribuidor
    title: Relatorio Metas Distribuidor
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                  from ( 
                        select case when exists (
                                      select 1
                                        from roman.usuariosgruposatendimento ug
                                       where ug.usuario = v('APP_USER')
                                         and ug.idgrupoatendimento in (0,58)
                                    )
                               then apex_item.checkbox2(1,
                                      m.idfilial || '|' || m.cicloromance,
                                      case when m.ciclocongelado = 'S'
                                           then 'disabled="disabled"'
                                      end)
                               else null
                               end as selecionar,
                               m.cicloromance,
                               m.idfilial,
                               decode(m.ciclocongelado, 'S', 'Sim','Não') ciclocongelado,
                               to_char(trunc(m.datacongelado),'dd/mm/rrrr') datacongelado, 
                               m.usuariocongelamento, 
                               to_char(trunc(m.datacriacao),'dd/mm/rrrr') datacriacao, 
                               m.usuariocriacao, 
                               count(*) qtdedist,
                               sum(m.desafiocalculadoromance) desafioromance,
                               sum(m.desafiocalculadoatual) desafiofranquia,
                               (select to_char(desafiocalculadoatual,'999g999g999g990d00')
                                  from metasdesafioromance
                                 where idfilial = m.idfilial
                                   and cicloromance = m.cicloromance ) metafranquia,
                               sum(m.desafiocalculadoromance * f.fatorconversao) desafioromanceConv,
                               sum(m.desafiocalculadoatual * f.fatorconversao) desafiofranquiaConv
                          from metasdesafiodistribuidores m
                             , catal.filiais f
                         where m.idfilial = :P0_IDFILIAL
                           and m.idfilial = f.idfilial
                         group by m.cicloromance, 
                               m.idfilial,
                               m.ciclocongelado, 
                               trunc(m.datacongelado), 
                               m.usuariocongelamento, 
                               trunc(m.datacriacao), 
                               m.usuariocriacao )
                 order by to_number(substr(cicloromance,4,4)) desc,
                          to_number(substr(cicloromance,1,2)) desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4869288317384646641
        }

