    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @incluir-item-nf
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 25
                items: {
                    P25_IDNOTAFISCAL: &P290_IDNOTAFISCAL.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir Produto
        layout {
            sequence: 20
            region: @incluir-item-nf
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P290_IDITNF
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-se-existe-um-item-já-incluido-do-mesmo-produto (
        name: valida se existe um item já incluido do mesmo produto
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from itemnf i
                where i.idnotafiscal = :P290_IDNOTAFISCAL
                  and i.idproduto = :P290_IDPRODUTORECEBIDO
                  and i.idproduto not in (5634, 27769)
                ```
        }
        error {
            errorMessage: Já existe o Produto incluído no Rec. de Compras!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process fetch-row-from-itemnf (
        name: Fetch Row from ITEMNF
        type: autoRowFetch
        source {
            tableName: ITEMNF
            pkColumn: IDITNF
            pkItem: P290_IDITNF
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 290099754942709720
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P290_IDITNF is null then
                        select "#OWNER#"."SEQ_IDTEMNF".nextval
                          into :P290_IDITNF
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 290100148170709720
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-itemnf (
        name: Process Row of ITEMNF
        type: autoRowProcessing
        target {
            tableName: ITEMNF
            pkColumn: IDITNF
            pkItem: P290_IDITNF
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Item incluído com sucesso!
        }
        advanced {
            executionMappingIdentifier: 290100580182709720
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 25
                items: {
                    P25_IDNOTAFISCAL: &P290_IDNOTAFISCAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)

