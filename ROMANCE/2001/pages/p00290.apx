    pageItem P290_IDPRODUTORECEBIDO (
        type: selectOne
        label {
            label: Produto
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                
                select distinct codigosisdist||' - '||initcap(nomeproduto) DISPLAY_VALUE
                     , p.idproduto return_value
                from produtos p
                   , fornecedoresprodutos f
                where p.idproduto = f.idproduto 
                  and f.idfornecedor = ( select idfornemitente from notasfiscais where idnotafiscal = :P290_IDNOTAFISCAL )
                  and exists ( select 1 from notasfiscais where idnotafiscal = :P290_IDNOTAFISCAL  and tiponota in ( 'C','R'))
                  and p.ativo = 'S'
                union
                select initcap(p.nomeproduto) display_value
                , p.idproduto return_value
                from produtos p
                where exists ( select 1 from notasfiscais where idnotafiscal = :P290_IDNOTAFISCAL  and tiponota = 'T')
                  and p.ativo = 'S'
                ```
        }
        layout {
            sequence: 30
            region: @incluir-item-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: IDPRODUTORECEBIDO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

