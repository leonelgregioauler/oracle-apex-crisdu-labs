    region produtos (
        name: Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*select idfotoproduto
                     , p.idproduto
                     , decode(f.ativo,'S','Ativo','N','Inativo') ativo
                     , p.codigosisdist
                     , initcap(nomeproduto) nome
                     , '<a href="'||replace(url,'acessar','acessar3')||'/BR" target="_blank"> <img src="'||urlreduzida||'" class="img_produto"><a>' imagem
                     , '<a href="'||replace(url,'acessar','acessar3')||'/BR/assinada_v2'||'" target="_blank"> <img src="'||urlreduzida||'/BR/assinada_v2'||'" class="img_produto"><a>' imagemcommarca
                     , data
                     , SUBSTR(URL, 50,15) nomefoto
                     , nvl(p.descricaocomercial,'Clique aqui para Alterar') descricao
                     , ( select initcap(c.nome)
                         from categorias c
                         where c.idcategoria = p.idcategoria ) categoria
                     , f.ordem
                     , idtextotraduzido
                     
                from fotosprodutos  f
                   , produtos       p
                where f.idproduto (+) = p.idproduto
                order by nome*/
                
                select idfotoproduto
                     , p.idproduto
                     , decode(f.ativo,'S','Ativo','N','Inativo') ativo
                     , p.codigosisdist
                     , initcap(nomeproduto) nome
                     , '<a href="'||replace(url,'acessar','acessar3')||'/BR" target="_blank"> <img src="'||urlreduzida||'" class="img_produto"><a>' imagem
                     , '<a href="'||replace(url,'acessar','acessar3')||'/BR/assinada_v2'||'" target="_blank"> <img src="'||urlreduzida||'/BR/assinada_v2'||'" class="img_produto"><a>' imagemcommarca
                     , data
                     , SUBSTR(URL, 50,15) nomefoto
                     , nvl(p.descricaocomercial,'Clique aqui para Alterar') descricao
                     , ( select initcap(c.nome)
                         from categorias c
                         where c.idcategoria = p.idcategoria ) categoria
                     , f.ordem
                     , idtextotraduzido
                from fotosprodutos  f
                   , produtos       p
                where f.idproduto = p.idproduto
                order by nome
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
