    region produtos-sem-foto-na-rua (
        name: Produtos sem foto na rua
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idproduto
                     , ( select p.nomeproduto from produtos p where p.idproduto = i.idproduto ) nome
                     , sum(i.quantidade ) qtd
                     , count(distinct idnotavenda) vendedoras
                from itensnotavenda i
                where not exists ( select 1
                                   from fotosprodutos f
                                   where f.idproduto = i.idproduto )
                  and exists ( select 1
                               from notasvendas n
                               where n.idnotavenda = i.idnotavenda
                                 and n.idsituacaonotavenda = 3 )                   
                group by idproduto
                order by 3 desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
