    region produtos-2 (
        name: Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist
                     , initcap(nomeproduto) nome
                     , nvl(( select listagg('<a href="'||ft.url||'" target="_blank"> <img src="'||ft.urlreduzida||'" class="img_produto_new"><a>',' ') within group (order by 1)
                             from fotosprodutos ft 
                             where ft.idproduto = p.idproduto ),'<a href="https://fotosprodutos.romancemoda.com.br/acessar?INDISPONIVEL.JPG" target="_blank"> <img src="https://fotosprodutos.romancemoda.com.br/acessar?INDISPONIVEL.JPG/true" class="img_produto"><a>') imagem
                     , sum(nvl(e.qtd_pp,0)
                          +nvl(e.qtd_p,0)
                          +nvl(e.qtd_m,0)
                          +nvl(e.qtd_g,0)
                          +nvl(e.qtd_gg,0)
                          +nvl(e.qtd_egg,0)
                          +nvl(e.qtd_exgg,0)
                          +nvl(e.qtd_u,0))emestoque
                     , nvl(sum(it.quantidade),0) narua
                from produtos       p
                   , estoquefilial e
                   , itensnotavenda it
                where e.idproduto = p.idproduto
                  and it.idestoquefil = e.idestoquefilial
                  and :P361_TIPORELATORIO = 'Q'
                  and exists ( select 1
                               from notasvendas nv
                               where nv.idnotavenda = it.idnotavenda
                                 and nv.idsituacaonotavenda = 3 )
                group by p.codigosisdist , p.nomeproduto , p.idproduto
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
