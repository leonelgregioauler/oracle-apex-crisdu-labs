    region evolução (
        name: Evolução
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select 'Total' descricao
                     , count(distinct e.idproduto) qtdprodutos
                from estoquefilial  e
                where exists ( select 1
                               from itensnotavenda i
                               where i.idestoquefil = e.idestoquefilial 
                                 and exists ( select 1
                                              from notasvendas    n
                                              where n.idsituacaonotavenda = 3 
                                                and i.idnotavenda  = n.idnotavenda ) )
                  or nvl(e.qtd_pp,0)
                   + nvl(e.qtd_p,0)
                   + nvl(e.qtd_m,0)
                   + nvl(e.qtd_g,0)
                   + nvl(e.qtd_gg,0)
                   + nvl(e.qtd_egg,0)
                   + nvl(e.qtd_exgg,0)
                   + nvl(e.qtd_u,0) > 0 
                union
                select 'Com fotos' 
                     , count( distinct idproduto)
                from fotosprodutos
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        settings {
            labelColumn: DESCRICAO
            valueColumn: QTDPRODUTOS
            colorScheme: modern2
        }
    )

