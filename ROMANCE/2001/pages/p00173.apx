page 173 (
    name: Empréstimos
    title: Empréstimos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region empréstimos (
        name: Empréstimos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idemprestimo
                     , nome
                     , pck_romance.fnc_nomefilial(e.idfilial) empresa
                     , data
                     , to_char(data, 'RRRR') ano
                     , observacao
                     , valor
                     , nvl(valor,0)+nvl(valorjuros,0) "A Pagar"
                     , ( select semana
                         from fechamentossemanais
                         where idfechamento = e.idfechamento) "Fechamento"
                     , pck_romance.fnc_nomefilial(idfilial) "Empresa"
                     , nvl(( select sum(p.valorpago)
                             from pagamentosemprestimos p
                             where p.idemprestimo = e.idemprestimo
                               and trunc(p.data) <= trunc(sysdate) ),0) "Valor Pago"
                     , nvl(valor,0)+nvl(valorjuros,0)- NVL(( select sum(VALORPAGO) 
                                                             from pagamentosemprestimos t
                                                             where idemprestimo = e.idemprestimo
                                                               and trunc(t.data) <= trunc(sysdate) ) ,0) "Saldo"
                     , decode(e.distrato,'S','Sim','Não') distrato
                from emprestimos e
                where ( :P173_VERTUDO = 'S' 
                    or ( :P173_VERTUDO_BR = 'S' and exists ( select 1
                                                             from vw_filiais f
                                                             where f.idfilial = e.idfilial
                                                               and f.idgrupo is not null
                                                               and f.ididioma = 1 ) )
                    or ( :P173_VERTUDO_AL = 'S' and exists ( select 1
                                                             from vw_filiais f
                                                             where f.idfilial = e.idfilial
                                                               and f.idgrupo is not null
                                                               and f.ididioma != 1 )  )
                    or ( idfilial     = :P0_IDFILIAL 
                         and ( :P0_IDFECHAMENTO = 999999999999 or e.idfechamento = :P0_IDFECHAMENTO ) ) )
                  and :P173_IDEMPRESTIMO is null
                union
                       select idemprestimo
                     , nome
                     , pck_romance.fnc_nomefilial(e.idfilial) empresa
                     , data
                     , to_char(data, 'RRRR') ano
                     , observacao
                     , valor
                     , nvl(valor,0)+nvl(valorjuros,0) "A Pagar"
                     , ( select semana
                         from fechamentossemanais
                         where idfechamento = e.idfechamento) "Fechamento"
                     , pck_romance.fnc_nomefilial(idfilial) "Empresa"
                     , nvl(( select sum(p.valorpago)
                             from pagamentosemprestimos p
                             where p.idemprestimo = e.idemprestimo
                               and trunc(p.data) <= trunc(sysdate) ),0) "Valor Pago"
                     , nvl(valor,0)+nvl(valorjuros,0)- NVL(( select sum(VALORPAGO) 
                                                             from pagamentosemprestimos t
                                                             where idemprestimo = e.idemprestimo
                                                               and trunc(t.data) <= trunc(sysdate) ) ,0) "Saldo"
                     , decode(e.distrato,'S','Sim','Não') distrato
                from emprestimos e
                where idemprestimo = :P173_IDEMPRESTIMO
                order by 8 desc
                ```
            pageItemsToSubmit: [
                P173_VERTUDO_BR
                P173_VERTUDO_AL
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
