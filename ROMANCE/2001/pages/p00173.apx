    pageItem P173_VERTUDO_AL (
        type: checkboxGroup
        label {
            label: Ver todos América Latina
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC: ;S
        }
        layout {
            sequence: 30
            region: @empréstimos
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2408,v('APP_USER')) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

