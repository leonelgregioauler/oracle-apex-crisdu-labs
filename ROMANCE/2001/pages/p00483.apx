    pageItem P483_IDCAMPANHA (
        type: selectList
        label {
            label: Campanha
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.descricao/*||' ('||c.semanaini||' até '||c.semanafim||')' */ display_value
                     , c.idcampanha return_value
                from campanhas c
                where c.ativa = 'S'
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidcampanha number;
                begin
                  --
                  select c.idcampanha
                  into vidcampanha
                  from campanhas c
                  where c.ativa = 'S';
                  --
                  return vidcampanha;
                  --
                exception
                  when others then
                    null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

