    region pontuação-de-distribuidores (
        name: Pontuação de Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rownum posicao
                     , t.filial "Filial"
                     , pck_romance.fnc_nomerepresentante(idrepresentante) "Representante"
                  --   , t.pontromance "Pontuação Romance"
                  --   , t.pontfavorita "Pontuação Favorita"
                  --   , pontfavoritaparis "Pontuação Favorita Paris"
                  --   , t.percfavorita "% Venda Favorita" 
                  --   , t.percfavritaparis "% Venda Favorita Paris" 
                  --   , t.ponttotal "Pontuação Total"
                     , t.contacertos "Contagem de Acertos"
                     , mediageral
                     , mediaromance
                     , mediafavorita
                     , mediafavoritaparis
                     , t.contaparis "Contagem Fav. Paris"
                from ( 
                       select t.*
                       from (  
                           select filial        
                                , idrepresentante
                                , pontromance
                                , pontfavorita
                                , pontfavoritaparis
                                , contacertos
                                , contaparis
                                , qtdsemanas
                                , pontromance + pontfavoritaparis + pontfavorita ponttotal
                                , round((pontromance + pontfavorita + ( pontfavorita* to_number(nvl('','1') )/ 100 )) / decode( contacertos,0,1,contacertos)) + round( pontfavoritaparis / decode( contaparis,0,1,contaparis))   mediageral
                                , round(pontromance / decode( contacertos,0,1,contacertos))        mediaromance
                                , round(pontfavorita / decode( contacertos,0,1,contacertos))       mediafavorita
                                , round(pontfavoritaparis / decode( contaparis,0,1,contaparis))  mediafavoritaparis
                                , pontfavorita / pontromance *100 percfavorita
                                , pontfavoritaparis / pontromance *100 percfavritaparis
                           from (
                                    select pck_romance.fnc_nomefilial( pck_romance.fnc_filialgerente( pck_romance.fnc_gerenterepresentante(r.idrepresentante))) filial
                                         , r.idrepresentante
                                         , pck_rankingpontuacao.fnc_pontuacaoromance ( psemanaini       => cf.semanainicio
                                                                                    , psemanafim       => cf.semanafim
                                                                                    , pidrepresentante => r.idrepresentante ) pontromance
                                         , pck_rankingpontuacao.fnc_pontuacaofavorita ( psemanaini       => cf.semanainicio
                                                                                     , psemanafim       => cf.semanafim
                                                                                     , pidrepresentante => r.idrepresentante ) pontfavorita
                                         , pck_rankingpontuacao.fnc_pontuacaofavoritaparis ( psemanaini       => cf.semanainicio
                                                                                          , psemanafim       => cf.semanafim
                                                                                          , pidrepresentante => r.idrepresentante ) pontfavoritaparis
                                         , pck_rankingpontuacao.fnc_contagemacertos ( psemanaini       => cf.semanainicio
                                                                                    , psemanafim       => cf.semanafim
                                                                                    , pidrepresentante => r.idrepresentante ) contacertos
                                         , pck_rankingpontuacao.fnc_contagemfavoritaparis( psemanaini => cf.semanainicio
                                                                                         , psemanafim => cf.semanafim
                                                                                         , pidrepresentante => r.idrepresentante ) contaparis
                                         , cf.idsemanafim - cf.idsemanainicio+1 qtdsemanas
                                    from representantes r
                                       , campanhasfiliais cf
                                    where r.ativo = 'S'
                                      and cf.idcampanhafilial = :P483_IDCAMPANHAFILIAL
                                      and exists ( select 1
                                                   from gerentes g
                                                   where g.idgerente = r.idgerente
                                                     and (( :P483_TIPO = 'G' and exists ( select 1 
                                                                                          from filiais f
                                                                                          where f.idfilial = g.idfilial
                                                                                            and f.idgrupo  = :P483_IDGRUPO ))
                                                       or ( :P483_TIPO = 'P' and exists ( select 1 
                                                                                          from filiais f
                                                                                          where f.idfilial = g.idfilial
                                                                                            and f.ididioma  = :P483_IDPAIS ) )
                                                       or (:P483_TIPO = 'E' and g.idfilial = :P0_IDFILIAL) ) ) )  a
                              where a.contacertos > 0  ) t
                              order by mediageral desc ) t
                
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado. Entre em contato com a TI.
        }
        advanced {
            savedReportMappingIdentifier: 1544392482385612824
        }

