            function fnc_imprimepontuacao() 
            {
              vurl = document.getElementById("P483_SESSION_IMPRIME").value;
              pjan = window.open(vurl,'popup','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=1200,height=600,screenX=50,screenY =100');
              pjan.focus();
