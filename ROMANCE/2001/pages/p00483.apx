    pageItem P483_AVISO_JOB (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @informações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="blue"><h2>Última atualização '||to_char(nvl(last_date,sysdate),'dd/mm/rrrr hh24:mi:ss')||', próxima atualização '|| to_char(next_date,'DD/MM/RRRR HH24:MI:SS')||'.</h2></font>'  a
                from all_jobs a
                where job = 6884525
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

