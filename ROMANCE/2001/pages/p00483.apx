    region pontuação-de-distribuidores-2 (
        name: Pontuação de Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rownum posicao
                     , empresa "Filial"
                     , distribuidor "Representante"
                  --   , t.pontromance "Pontuação Romance"
                  --   , t.pontfavorita "Pontuação Favorita"
                  --   , pontfavoritaparis "Pontuação Favorita Paris"
                  --   , t.percfavorita "% Venda Favorita" 
                  --   , t.percfavritaparis "% Venda Favorita Paris" 
                  --   , t.ponttotal "Pontuação Total"
                     , contacertos "Contagem de Acertos"
                     , mediageral
                     , mediaromance
                     , mediafavorita
                     --, mediafavoritaparis
                     --, contagemfavoritaparis "Contagem Fav. Paris"
                     , medianegbalancos
                     , contnegociacoes
                     , vendaecommerce
                     , inad_geral
                     , valor_premio
                     , idrepresentante
                from ( select t.*
                       from (  
                           select p.empresa
                                , p.distribuidor
                                , p.contagemacertos contacertos
                                , p.mediageral
                                , p.mediaromance
                                , p.mediafavorita
                                --, p.mediafavoritaparis
                                --, p.contagemfavoritaparis 
                                , p.contnegociacoes
                                , p.medianegbalancos
                                , p.vendaecommerce 
                                , p.inad_geral
                                , p.valor_premio
                                , p.idrepresentante
                           from vw_pontuacaogeral_rmc p
                              , catal.representantes r
                           where p.idrepresentante = r.idrepresentante
                             and ( :p483_TIPO = 'G' and exists ( select 1  -- GRUPO
                                                                 from filiais f
                                                                 where f.idfilial = p.idfilial
                                                                   and f.idgrupo  = :p483_IDGRUPO )
                             or ( :p483_TIPO = 'P' and exists ( select 1  -- PAIS
                                                                from filiais f
                                                                where f.idfilial = p.idfilial
                                                                  and f.ididioma  = :p483_IDPAIS ) )
                             --or (:p483_TIPO = 'E' and p.idfilial = :p0_IDFILIAL) )  -- EMPRESA
                             -- 10183969 >
                             or ( :p483_TIPO = 'E' and :p0_IDFILIAL = -1 ) --Todos
                             --  Regionais
                             or ( :p483_TIPO = 'E' and :p0_IDFILIAL in (1,2,3,4,5) and exists ( select 1 
                                                                                                  from gerentes g
                                                                                                 where g.idgerente = r.idgerente
                                                                                                   and g.idfilial in (select f.idfilial
                                                                                                                        from catal.filiais f
                                                                                                                       where f.regional = :p0_IDFILIAL) ) )
                             -- Brasil
                             or ( :p483_TIPO = 'E' and :p0_IDFILIAL = -2 and exists ( select 1 
                                                                                        from gerentes g
                                                                                       where g.idgerente = r.idgerente
                                                                                         and g.idfilial in (select f.idfilial
                                                                                                              from catal.filiais f
                                                                                                             where f.ididioma = 1) ) )
                             -- America Latina
                             or ( :p483_TIPO = 'E' and :p0_IDFILIAL = -3 and exists ( select 1
                                                                                        from gerentes g
                                                                                       where g.idgerente = r.idgerente
                                                                                         and g.idfilial in (select f.idfilial
                                                                                                              from catal.filiais f
                                                                                                             where f.ididioma in (2,3,4,6,7,8,13,14,15,16)) ) )
                             -- Comercial Romance
                             or ( :p483_TIPO = 'E' and :P0_IDFILIAL = 1135 and exists ( select 1
                                                                                          from gerentes g
                                                                                         where g.idgerente = r.idgerente
                                                                                           and g.idfilial in (select f.idfilial
                                                                                                                from catal.filiais f
                                                                                                               where f.pertencecomercialromance = 'S')))
                            -- Pega qualquer outra empresa selecionada
                            or ( :p483_TIPO = 'E' and exists ( select 1
                                                                 from gerentes g
                                                                where g.idgerente = r.idgerente
                                                                  and g.idfilial = :p0_IDFILIAL )) )
                            )t
                           order by mediageral desc 
                           ) 
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
