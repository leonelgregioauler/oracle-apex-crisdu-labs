    process busca-informações-de-campanha (
        name: Busca Informações de Campanha
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vsemanainicio     varchar2(10);
                  vsemanafim        varchar2(10);
                  vidcampanhafilial number;
                  vidcampanha       number;
                  --
                begin
                  --
                  if :P483_TIPO is null then
                    --
                    :P483_TIPO := 'E';
                    --
                  end if;
                  --
                  if :P483_TIPO = 'E' then
                    --
                    select idcampanhafilial
                         , cf.semanainicio
                         , cf.semanafim
                    into vidcampanhafilial
                       , vsemanainicio
                       , vsemanafim
                    from campanhasfiliais cf
                       , campanhas c
                    where cf.idfilial = :P0_IDFILIAL
                      and c.idcampanha = cf.idcampanha
                      and c.ativa      = 'S';
                    --
                  elsif :P483_TIPO = 'G' then
                    --
                    select idcampanhafilial
                         , cf.semanainicio
                         , cf.semanafim
                    into vidcampanhafilial
                       , vsemanainicio
                       , vsemanafim
                    from campanhasfiliais cf
                       , campanhas c
                    where cf.idfilial = ( select min(idfilial)
                                          from vw_filiais f
                                          where f.idgrupo = :P483_IDGRUPO )
                      and c.idcampanha = cf.idcampanha
                      and c.ativa      = 'S';
                    --
                  end if;
                  --
                  :P483_SEMANAINICIO     := vsemanainicio;
                  :P483_SEMANAFIM        := vsemanafim;
                  :P483_IDCAMPANHAFILIAL := vidcampanhafilial;
                  --
                exception
                  when others then
                    null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1544391934158612819
        }
    )

    branch (
        name: Go To Page 483
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 483
                items: {
                    P483_IDCAMPANHA: &P483_IDCAMPANHA.
                    P483_TIPO: &P483_TIPO.
                    P483_IDCAMPANHAFILIAL: &P483_IDCAMPANHAFILIAL.
                    P483_SEMANAINICIO: &P483_SEMANAINICIO.
                    P483_SEMANAFIM: &P483_SEMANAFIM.
                    P483_IDGRUPO: &P483_IDGRUPO.
                    P483_IDPAIS: &P483_IDPAIS.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

