    region notas-perdidas-detalhadas (
        name: Notas Perdidas Detalhadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , roman.pck_romance.fnc_nomevendedora(n.idvendedora) vendedora
                     , n.numeronota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , roman.pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiao
                     , ( select sn.descricao from roman.situacoesnotavenda sn where sn.idsituacaonotavenda = n.idsituacaonotavenda ) situacao
                     , nvl(n.valortotalnota,0)
                     , nvl(n.valortotaldevolucao,0)
                     , nvl(n.valortotalvenda,0)
                     , nvl(n.perccomissao,0)
                     , nvl(n.valorcomissao,0)
                     , nvl(n.valorpago,0)  valorpago
                     , nvl(n.saldo,0)
                     , case 
                         when n.idfilial = pck_romance.fnc_filialusuario(v('APP_USER')) then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||n.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                         else '-'
                       end URL
                     , pck_util.fnc_idsemana(n.semanacobranca) - pck_util.fnc_idsemana(n.semanadistribuicao) - 6 qtdremarcadas
                     , roman.pck_romance.fnc_cpfvendedora(n.idvendedora) cpfvendedora
                     , roman.pck_romance.fnc_enderecovendedora(n.idvendedora) endereco
                     , roman.pck_romance.fnc_retornatelefones(n.idvendedora) telefones
                     , ( select roman.pck_romance.fnc_nomecidade(idcidade)
                         from pessoas p
                         where p.idpessoa = ( select idpessoa
                                              from vendedoras v
                                              where v.idvendedora = n.idvendedora) ) cidade
                     , roman.pck_romance.fnc_nomerepresentante(n.idrepresentanteatende) distribuidor_atende
                from roman.notasvendas n
                where n.idfilial = :P0_IDFILIAL
                  and ( n.idrepresentante = :P297_IDREPRESENTANTE
                     or n.idrepresentanteatende = :P297_IDREPRESENTANTE )
                  and (  :P297_TIPONOTAS is null 
                      or ( :P297_TIPONOTAS = 'D' and n.idsituacaonotavenda = 4 and n.saldo > 0)
                      or ( :P297_TIPONOTAS = 'N' and n.idsituacaonotavenda = 3 )
                      or ( :P297_TIPONOTAS = 'R' and n.idsituacaonotavenda = 3 and pck_util.fnc_idsemana(n.semanacobranca) - pck_util.fnc_idsemana(n.semanadistribuicao) > (6+ nvl(:P297_QTDSEMANAS,0)) ) )
                  and pck_util.fnc_idsemana(n.semanacobranca) - pck_util.fnc_idsemana(n.semanadistribuicao) >= 6
                order by 5 
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P297_TIPORELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 340593635489423101
        }

