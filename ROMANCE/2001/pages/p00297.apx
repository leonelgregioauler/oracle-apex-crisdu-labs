    pageItem P297_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' ('||decode(r.ativo,'S','Ativo','N','Inativo')||')' display_value
                     , r.idrepresentante return_value
                  from representantes r
                 where r.idgerente = ( select idgerente 
                                         from gerentes 
                                        where idfilial = :P0_IDFILIAL )
                   and (   (:P297_STREPRESENTANTE = 'A') 
                        or (:P297_STREPRESENTANTE = 'N' and r.ativo = 'N') 
                        or (:P297_STREPRESENTANTE = 'S' and r.ativo = 'S'))
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P297_STREPRESENTANTE
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

