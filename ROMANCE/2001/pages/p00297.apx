    dynamicAction remarcadas (
        name: Remarcadas
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P297_TIPONOTAS
        }
        clientSideCondition {
            type: item=value
            item: P297_TIPONOTAS
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P297_QTDSEMANAS
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P297_QTDSEMANAS
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 297
                items: {
                    P297_IDREPRESENTANTE: &P297_IDREPRESENTANTE.
                    P297_TIPONOTAS: &P297_TIPONOTAS.
                    P297_QTDSEMANAS: &P297_QTDSEMANAS.
                    P297_TIPORELATORIO: &P297_TIPORELATORIO.
                }
                action: resetPagination
            }
        }
    )

)

