page 679 (
    name: Débitos Recuperados
    title: Débitos Recuperados
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-do-percentual (
        name: Acompanhamento do Percentual
        type: chart
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }

        series percentual (
            name: Percentual
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select t.franquia
                         , round( (t.recuperado / t.gerado) * 100,2 ) perc_recuperado 
                         , 'Gerado '||gerado||' e recuperado '||recuperado legenda
                    from ( 
                            select f.nome franquia
                                 , ( select sum(saldo)
                                     from notasvendas nv
                                     where nv.idsemanacobranca between :P679_IDSEMANAINI and :P679_IDSEMANAFIM
                                       and nv.idfilial = f.idfilial 
                                       and nv.idsituacaonotavenda = 4
                                       and nv.saldo > 0 ) gerado
                                 , ( select sum(pg.valorpago)
                                     from pagamentosnotasvendas pg
                                     where pg.origem = 'R'
                                       and pg.idsemanacobranca between :P679_IDSEMANAINI and :P679_IDSEMANAFIM
                                       and exists ( select 1
                                                    from notasvendas nn
                                                    where nn.idnotavenda = pg.idnotavenda
                                                      and nn.idfilial = f.idfilial
                                                      and nn.idsemanacobranca != pg.idsemanacobranca ) ) recuperado
                            from vw_filiais f
                            where f.ididioma = :P679_IDPAIS
                              and ( :P679_IDFILIAL is null or f.idfilial = :P679_IDFILIAL )
                              and f.tipofilial = 'D'
                              and f.idgrupo is not null
                            group by f.nome, f.idfilial ) t
                    order by 2 desc
                    ```
            }
            columnMapping {
                label: FRANQUIA
                value: PERC_RECUPERADO
                legendTooltip: LEGENDA
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region acompanhamento-dos-débitos (
        name: Acompanhamento dos Débitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.franquia
                     , t.gerado
                     , t.recuperado
                     , round( (t.recuperado / t.gerado) * 100,2 ) perc_recuperado 
                from ( 
                        select f.nome franquia
                             , ( select sum(saldo)
                                 from notasvendas nv
                                 where nv.idsemanacobranca between :P679_IDSEMANAINI and :P679_IDSEMANAFIM
                                   and nv.idfilial = f.idfilial 
                                   and nv.idsituacaonotavenda = 4
                                   and nv.saldo > 0 ) gerado
                             , ( select sum(pg.valorpago)
                                 from pagamentosnotasvendas pg
                                 where pg.origem = 'R'
                                   and pg.idsemanacobranca between :P679_IDSEMANAINI and :P679_IDSEMANAFIM
                                   and exists ( select 1
                                                from notasvendas nn
                                                where nn.idnotavenda = pg.idnotavenda
                                                  and nn.idfilial = f.idfilial
                                                  and nn.idsemanacobranca != pg.idsemanacobranca ) ) recuperado
                        from vw_filiais f
                        where f.ididioma = :P679_IDPAIS
                          and ( :P679_IDFILIAL is null or f.idfilial = :P679_IDFILIAL )
                          and f.tipofilial = 'D'
                          and f.idgrupo is not null
                        group by f.nome, f.idfilial ) t
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 31604323526017532
        }

        column FRANQUIA (
            type: plainText
            heading {
                heading: Franquia
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column GERADO (
            type: plainText
            heading {
                heading: Gerado
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column PERC_RECUPERADO (
            type: plainText
            heading {
                heading: % Recuperado
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column RECUPERADO (
            type: plainText
            heading {
                heading: Recuperado
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 5636517 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FRANQUIA (
                sequence: 1
            )

            displayColumn GERADO (
                sequence: 2
            )

            displayColumn PERC_RECUPERADO (
                sequence: 4
            )

            displayColumn RECUPERADO (
                sequence: 3
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P679_IDFILIAL (
        type: selectOne
        label {
            label: Franquia
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo is not null
                  and f.ididioma = :P679_IDPAIS
                ```
        }
        cascadingLov {
            parentItems: P679_IDPAIS
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P679_IDPAIS (
        type: radioGroup
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome
                     , p.idpais
                from paises p
                where p.idpais in (1,2,4,6,8,11,12)
                order by 2
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P679_IDSEMANAFIM (
        type: selectOne
        label {
            label: Até
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta
                     , s.idsemana
                from semana_dias s
                where ano between to_char(sysdate,'RRRR')-3 and to_char(sysdate,'RRRR')
                  and s.idsemana >= :P679_IDSEMANAINI
                order by idsemana
                ```
        }
        cascadingLov {
            parentItems: P679_IDSEMANAINI
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P679_IDSEMANAINI (
        type: selectOne
        label {
            label: De
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta
                     , s.idsemana
                from semana_dias s
                where ano between to_char(sysdate,'RRRR')-3 and to_char(sysdate,'RRRR')
                order by idsemana
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 679
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 679
                items: {
                    P679_IDSEMANAINI: &P679_IDSEMANAINI.
                    P679_IDSEMANAFIM: &P679_IDSEMANAFIM.
                    P679_IDPAIS: &P679_IDPAIS.
                    P679_IDFILIAL: &P679_IDFILIAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

