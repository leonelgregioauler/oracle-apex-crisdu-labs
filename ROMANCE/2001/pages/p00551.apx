    region por-empresa (
        name: % por Empresa
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(pck_romance.fnc_filialgerente(idgerente)) ||' - '||sum(consultorasapp)||'/'||sum(consultoras) ||' - '||case when sum(consultoras) > 0 then
                          round(sum(consultorasapp)*100/sum(consultoras),2)
                        else 
                          0
                          END ||'%' empresa
                     , sum(consultoras) consultoras
                     , sum(consultorasapp) consultorasapp
                     , case when sum(consultoras) > 0 then
                        round(sum(consultorasapp)*100/sum(consultoras))
                        else 
                          0
                        end perc
                     , case when sum(consultoras) > 0 then
                        round(sum(consultorasapp)*100/sum(consultoras),2)
                        else 
                          0
                        end perc2
                from (
                        select idgerente
                             , r.idrepresentante
                             , ( select count(1)
                                 from vendedoras v
                                 where v.idrepresentante = r.idrepresentante
                                   and v.ativo           = 'S'
                                   and not exists ( select 1
                                                    from representantes r
                                                    where r.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa ) ) consultoras
                             , ( select count( distinct v.idvendedora)
                                 from registrosloginminhasacola rr 
                                    , vendedoras                v
                                 where v.idvendedora      = rr.idvendedora 
                                   and v.idrepresentante  = r.idrepresentante
                                   and v.ativo            = 'S'
                                   and exists ( select 1
                                                from registroscompartilhafotos rg
                                                where rg.idvendedora = v.idvendedora
                                                having max(rg.datacompartilhamento) > sysdate- 21 )
                                   and not exists ( select 1
                                                    from representantes r
                                                    where r.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from usuarios f
                                                    where f.idpessoa = v.idpessoa ) ) consultorasapp  
                        from representantes r
                        where r.ativo     = 'S' 
                        /*  and ( :P0_IDFILIAL = -1 or exists  ( select 1
                                                               from gerentes g
                                                               where g.idgerente = r.idgerente
                                                                and  g.idfilial = :P0_IDFILIAL ) ) */ )
                having sum(consultoras) > 0
                group by idgerente
                union
                select '- Esperado - 100%' empresa
                     , count(1) consultoras
                     , count(1) consultorasapp
                     , 100 perc
                     , 100 perc2
                from vendedoras c
                where ativo = 'S'
                  and not exists ( select 1
                                   from representantes r
                                   where r.idpessoa = c.idpessoa )
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = c.idpessoa )
                  and not exists ( select 1
                                   from funcionarios f
                                   where f.idpessoa = c.idpessoa )
                union
                select '- Geral - '|| case when sum(consultoras) > 0 then
                                        round(sum(consultorasapp)*100/sum(consultoras),2)
                                        else 
                                          0
                                        end||'%'  empresa
                     , sum(consultoras) consultoras
                     , sum(consultorasapp) consultorasapp
                     , case when sum(consultoras) > 0 then
                        round(sum(consultorasapp)*100/sum(consultoras))
                        else 
                          0
                        end perc
                     , case when sum(consultoras) > 0 then
                        round(sum(consultorasapp)*100/sum(consultoras),2)
                        else 
                          0
                        end perc2
                from (
                        select ( select count(1)
                                 from vendedoras v
                                 where v.idrepresentante = r.idrepresentante
                                   and v.ativo           = 'S' 
                                   and not exists ( select 1
                                                    from representantes r
                                                    where r.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa ) ) consultoras
                             , ( select count( distinct v.idvendedora)
                                 from registrosloginminhasacola rr 
                                    , vendedoras                v
                                 where v.idvendedora      = rr.idvendedora 
                                   and v.idrepresentante  = r.idrepresentante
                                   and v.ativo            = 'S'
                                   and exists ( select 1
                                                from registroscompartilhafotos rg
                                                where rg.idvendedora = v.idvendedora
                                                having max(rg.datacompartilhamento) > sysdate- 21 )
                                   and not exists ( select 1
                                                    from representantes r
                                                    where r.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa ) ) consultorasapp  
                        from representantes r
                        where r.ativo     = 'S'  )
                order by 5 desc
                ```
        }
        layout {
            sequence: 100
            slot: body
            columnSpan: 5
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: PERC
            colorScheme: modern2
            maximumRows: 50
        }
    )

    region produtos-mais-compartilhados (
        name: Produtos Mais compartilhados
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                -- Created on 11/10/2018 by ÉVERTON PASSOS 
                declare 
                  -- Local variables here
                  vqtdcolunas number := 0;
                  --
                begin
                  -- 
                  htp.p('  <style type="text/css">
                .img_produto {
                    position: relative;
                    max-width: 210px;
                    width: 60%;
                }
                </style>');
                  htp.p('<table border=0>');
                  htp.p('  <tr align="center">');
                  -- 
                  for a in ( select f.idfotoproduto
                                 , p.codigosisdist
                                 , initcap(nomeproduto) nome
                                 , '<a href="'||url||'" target="_blank"> <img src="'||urlreduzida||'" class="img_produto"><a>' imagem
                                 , ra.qtd qtd
                            from fotosprodutos f
                               , produtos      p
                               , (
                                    select rr.idproduto
                                         , rr.idfotoproduto
                                         , count(1) qtd
                                    from registroscompartilhafotos rr
                                    where ( :P0_IDFILIAL = -1 
                                         or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                                             from vw_filiais f
                                                                             where f.idfilial = rr.idfilial
                                                                               and f.ativo    = 'S'
                                                                               and f.idgrupo != 5 ) )
                                         or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                                             from vw_filiais f
                                                                             where f.idfilial = rr.idfilial
                                                                               and f.ativo    = 'S'
                                                                               and f.idgrupo  = 5 ) )
                                         or ( :P0_IDFILIAL > 0 and rr.idfilial = :P0_IDFILIAL ) ) 
                                    group by rr.idproduto
                                         , rr.idfotoproduto        
                                    order by 3 desc     )   ra
                            where rownum <= 27        
                              and ra.idfotoproduto = f.idfotoproduto
                              and f.idproduto      = p.idproduto)
                  loop
                    --
                    htp.p('  <td align="center">');
                    htp.p(       a.imagem );
                    htp.p('    <br>');
                    htp.p(       a.codigosisdist||' <br> '||a.nome ||'<br>'||a.qtd);
                    htp.p('  </td>');
                    --
                    vqtdcolunas := vqtdcolunas + 1;
                    --
                    if  vqtdcolunas = 9 then
                      vqtdcolunas := 0;
                      --
                      htp.p('  </tr>');
                      htp.p('  <tr>');
                    end if;
                    --
                  end loop;
                  --
                  htp.p('  </tr>');
                  htp.p('<table>');
                  --
                end;
                ```
        }
        layout {
            sequence: 200
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

