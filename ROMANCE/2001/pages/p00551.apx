    region cliques-favorita-pelo-app (
        name: Cliques Favorita Pelo APP
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select trunc(h.datalogin) "Data"
                     , count(1) "Qtd Pedidos"
                from favorita.vw_historicocliques_fav h
                where h.fezpedido = 'S'
                  and ( :P0_IDFILIAL= -1 or h.idfilial = :P0_IDFILIAL)
                  and trunc(datalogin) between to_date(:P551_DATAINICIO) and to_date(:P551_DATAFIM)
                group by trunc(h.datalogin);
                ```
            pageItemsToSubmit: P0_IDFILIAL
