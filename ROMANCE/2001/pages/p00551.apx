    region ranking-de-novas-consultoras-no-período (
        name: Ranking de Novas Consultoras no Período
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(e.idfilial) empresa
                     , pck_romance.fnc_nomerepresentante(v.idrepresentante) distribuidor
                     , count( distinct v.idvendedora) qtd
                from registrosloginminhasacola e
                   , vendedoras                v
                where e.primeirologin    = 'S'
                  and v.ativo = 'S'
                  and v.idvendedora      = e.idvendedora 
                  and e.datalogin between to_date(trim(:P551_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P551_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = v.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo != 5 ) )
                     or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = v.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo  = 5 ) )
                     or ( :P0_IDFILIAL > 0 and v.idfilial = :P0_IDFILIAL ) ) 
                group by v.idrepresentante
                       , e.idfilial
                order by 2 desc
                ```
