    region compartilhamento-geral (
        name: Compartilhamento Geral
        type: plugin/d3LineChart
        source {
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(f.idfilial) empresa
                     ,  to_number(trim(to_char(trunc(f.datacompartilhamento),'RRRRMMDD'))) sequencia 
                     , count(1) qtd
                from registroscompartilhafotos f
                group by trunc(datacompartilhamento) , f.idfilial
                ORDER BY 1, trunc(datacompartilhamento) 
                ```
        }
        layout {
            sequence: 180
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-expanded
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        settings {
            xValuesColumn: SEQUENCIA
            yValuesColumn: QTD
            multipleSeriesColumn: EMPRESA
            xAxisValueFormatMask: attributeValue2
            yAxisValueFormatMask: attributeValue
            tooltips: [
                showSeriesName
                showXValue
                showYValue
            ]
            legend: aboveChart
            colorScheme: modern2
        }
    )

    region compartilhamento-por-dia-e-hora (
        name: Compartilhamento por Dia e Hora
        type: plugin/d3LineChart
        source {
            sqlQuery:
                ```sql
                select to_char(f.datacompartilhamento,'DAY') dia 
                     , to_number(trim(to_char(f.datacompartilhamento,'HH24'))) hora 
                     , count(1) qtd
                from registroscompartilhafotos f
                where f.datacompartilhamento > sysdate-30
                group by to_char(f.datacompartilhamento,'D') 
                       , to_char(f.datacompartilhamento,'DAY') 
                       , to_number(trim(to_char(f.datacompartilhamento,'HH24'))) 
                order by to_char(f.datacompartilhamento,'D') , 2
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-expanded
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        settings {
            xValuesColumn: HORA
            yValuesColumn: QTD
            multipleSeriesColumn: DIA
            xAxisValueFormatMask: attributeValue2
            yAxisValueFormatMask: attributeValue
            tooltips: [
                showSeriesName
                showXValue
                showYValue
            ]
            legend: aboveChart
            colorScheme: modern2
        }
    )

    region compartilhamentos-e-logins-por-semana (
        name: Compartilhamentos e Logins por Semana
        type: plugin/flotLineChart
        source {
            sqlQuery:
                ```sql
                select 'Total de Compartilhamentos'  informacao
                     , to_number(substr(pck_util.fnc_semanaid(r.idsemana   ),4,4)||substr(pck_util.fnc_semanaid(r.idsemana   ),1,2)) semana 
                     , count(1) quantidade 
                     , r.idsemana
                from registroscompartilhafotos r
                where r.datacompartilhamento > sysdate-90           
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = r.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo != 5 ) )
                     or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = r.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo  = 5 ) )
                     or ( :P0_IDFILIAL > 0 and r.idfilial = :P0_IDFILIAL ) ) 
                group by r.idsemana  
                union
                select 'Consultoras que Compartilharam'  informacao
                     , to_number(substr(pck_util.fnc_semanaid(r.idsemana   ),4,4)||substr(pck_util.fnc_semanaid(r.idsemana   ),1,2)) semana 
                     , count(distinct r.idvendedora) qtdunico 
                     , r.idsemana
                from registroscompartilhafotos r      
                where r.datacompartilhamento > sysdate-90    
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = r.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo != 5 ) )
                     or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = r.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo  = 5 ) )
                     or ( :P0_IDFILIAL > 0 and r.idfilial = :P0_IDFILIAL ) )  
                group by r.idsemana  
                union
                select 'Total de Logins '  informacao
                     , to_number(substr(pck_util.fnc_semanaid(r.idsemana   ),4,4)||substr(pck_util.fnc_semanaid(r.idsemana   ),1,2)) semana 
                     , count( 1) qtdunico 
                     , r.idsemana
                from registrosloginminhasacola r
                where r.datalogin > sysdate-90             
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = r.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo != 5 ) )
                     or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = r.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo  = 5 ) )
                     or ( :P0_IDFILIAL > 0 and r.idfilial = :P0_IDFILIAL ) ) 
                group by r.idsemana  
                union
                select 'Logins únicos'  informacao
                     , to_number(substr(pck_util.fnc_semanaid(r.idsemana   ),4,4)||substr(pck_util.fnc_semanaid(r.idsemana   ),1,2)) semana 
                     , count(distinct r.idvendedora) qtdunico 
                     , r.idsemana
                from registrosloginminhasacola r
                where r.datalogin > sysdate-90      
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = r.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo != 5 ) )
                     or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = r.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo  = 5 ) )
                     or ( :P0_IDFILIAL > 0 and r.idfilial = :P0_IDFILIAL ) ) 
                group by r.idsemana  
                order by 4
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        settings {
            xValuesType: number
            xValuesColumn3: SEMANA
            yValuesColumn: QUANTIDADE
            multipleSeries: attributeValue
            multipleSeriesColumn: INFORMACAO
            dataPoints: circle
            fillArea: attributeValue
            valueFormatMask: 999G990
            tooltips: [
                showSeriesName
                showYValue
            ]
            legend: attributeValue
            colorScheme: solar
        }
    )

    region consultoras-que-entraram-pela-primeira-vez-no-período (
        name: Consultoras que Entraram pela Primeira vez no Período
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select initcap(nomepessoa)||' - '||nvl(cpf, documentoestrangeiro)||'['||r.idvendedora||']'
                         from pessoas p
                         where p.idpessoa = v.idpessoa ) consultora
                     , pck_romance.fnc_nomepessoa(rr.idpessoa) ||'<br>'||
                        ( select pck_romance.fnc_nomefilial(idfilial)  
                          from gerentes g
                          where g.idgerente = rr.idgerente ) distribuidor
                     , r.datalogin
                     , ( select count(1) qtd
                         from registroscompartilhafotos f
                         where f.idvendedora = r.idvendedora
                           and f.datacompartilhamento between to_date(trim(:P551_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P551_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')) qtdcompartilhamento
                     , v.idvendedora
                     , r.versaoaplicativo
                from registrosloginminhasacola r
                   , vendedoras                v
                   , representantes            rr
                where primeirologin = 'S' 
                  and v.idvendedora     = r.idvendedora
                  and v.ativo           = 'S'
                  and v.idrepresentante = rr.idrepresentante
                  and r.datalogin  between to_date(trim(:P551_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P551_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = v.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo != 5 ) )
                     or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = v.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo  = 5 ) )
                     or ( :P0_IDFILIAL > 0 and idgerente = ( select idgerente 
                                                             from gerentes 
                                                             where idfilial = :P0_IDFILIAL ) ) ) 
                order by 3 desc
                ```
            pageItemsToSubmit: [
                P551_DATAINICIO
                P551_DATAFIM
            ]
        }
        layout {
            sequence: 20
            parentRegion: @maximizar
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                js-showMaximizeButton
                t-Region--accent4
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
