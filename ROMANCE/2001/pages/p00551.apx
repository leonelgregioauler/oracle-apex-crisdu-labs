    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 551
                items: {
                    P551_DATAINICIO: &P551_DATAINICIO.
                    P551_DATAFIM: &P551_DATAFIM.
                }
                action: resetPagination
