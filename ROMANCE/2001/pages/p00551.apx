    dynamicAction filtrar (
        name: Filtrar
        execution {
            sequence: 120
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction tipo-de-filtro (
        name: Tipo de Filtro
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P551_FILTRAR
        }
        clientSideCondition {
            type: item=value
            item: P551_FILTRAR
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P551_DATAINICIO
                    P551_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @utilização-por-distribuidor
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @utilização-por-distribuidor
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P551_DATAINICIO
                    P551_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

