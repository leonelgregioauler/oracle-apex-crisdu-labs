                    formatMask: 999G990
                }
                layout {
                    sequence: 1
                }
            )

        )

    )

    region evolução-da-adesão-35-dias (
        name: Evolução da Adesão - 35 dias
        type: chart
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: area
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        legend {
            show: false
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 'Geral' serie
                         , trunc(datalogin) sequencia 
                         , count(1) qtd
                         , trunc(datalogin) ||' - '|| initcap(to_char(datalogin,'DAY')) DATA
                    from registrosloginminhasacola r
                    where primeirologin = 'S'
                      and datalogin >= sysdate - 35
                      and ( :P0_IDFILIAL = -1 
                         or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                             from vw_filiais f
                                                             where f.idfilial = r.idfilial
                                                               and f.ativo    = 'S'
                                                               and f.idgrupo != 5 ) )
                         or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                             from vw_filiais f
                                                             where f.idfilial = r.idfilial
                                                               and f.ativo    = 'S'
                                                               and f.idgrupo  = 5 ) )
                         or ( :P0_IDFILIAL > 0 and idfilial = :P0_IDFILIAL ) )
                    group by trunc(datalogin) 
                           , trunc(datalogin) ||' - '||initcap( to_char(datalogin,'DAY'))
                    union
                    select 'Até '||to_char(sysdate,'HH24:MI:SS') serie
                         , trunc(datalogin) sequencia 
                         , count(1) qtd
                         , trunc(datalogin) ||' - '|| initcap(to_char(datalogin,'DAY')) data 
                    from registrosloginminhasacola r
                    where primeirologin = 'S'
                      and datalogin >= sysdate - 35
                    --  and trunc(r.datalogin) != trunc(sysdate)
                      and datalogin <= to_date(TRUNC(datalogin)||' '||to_char(sysdate,'HH24:MI:SS' ),'DD/MM/RRRR HH24:MI:SS')
                      and ( :P0_IDFILIAL = -1 
                         or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                             from vw_filiais f
                                                             where f.idfilial = r.idfilial
                                                               and f.ativo    = 'S'
                                                               and f.idgrupo != 5 ) )
                         or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                             from vw_filiais f
                                                             where f.idfilial = r.idfilial
                                                               and f.ativo    = 'S'
                                                               and f.idgrupo  = 5 ) )
                         or ( :P0_IDFILIAL > 0 and idfilial = :P0_IDFILIAL ) )
                    group by trunc(datalogin) 
                           , trunc(datalogin) ||' - '||initcap( to_char(datalogin,'DAY'))
                    ORDER BY 2
                    ```
            }
            columnMapping {
                seriesName: SERIE
                label: SEQUENCIA
                value: QTD
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

