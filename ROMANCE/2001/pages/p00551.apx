    region adesão-por-dia (
        name: Adesão por Dia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select trunc(rl.datalogin) data
                     , pck_romance.fnc_nomerepresentante(v.idrepresentante) distribuidor
                     , count(distinct rl.idvendedora) quantidade
                from registrosloginminhasacola rl
                   , vendedoras v
                where rl.primeirologin  = 'S'
                  and v.idvendedora     = rl.idvendedora
                  and v.ativo           = 'S'
                  and not exists ( select 1
                                    from representantes rr
                                    where rr.idpessoa = v.idpessoa ) 
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from funcionarios f
                                   where f.idpessoa = v.idpessoa )
                  and v.idfilial = :P0_IDFILIAL
                group by trunc(rl.datalogin) , v.idrepresentante
                order by 1 desc
                ```
        }
        layout {
            sequence: 190
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent12
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
