    region lista (
        name: Lista
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Consultoras Possiveis' descricao
                     , trim(to_char(count(distinct idvendedora),'999G999G990'))  quantidade
                from notasvendas r
                where r.idsituacaonotavenda = 3 
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = r.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo != 5 ) )
                     or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = r.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo  = 5 ) )
                     or ( :P0_IDFILIAL > 0 and idfilial = :P0_IDFILIAL ) )
                union
                select 'Consultoras com App' descricao
                     , trim(to_char(count(distinct e.idvendedora),'999G999G990'))  quantidade
                from registrosloginminhasacola e
                   , vendedoras v
                where  exists ( select 1
                               from notasvendas r
                               where r.idvendedora = v.idvendedora    
                                 and r.idsituacaonotavenda = 3 )
                  and e.primeirologin = 'S'
                  and v.ativo         = 'S'
                  and v.idvendedora   = e.idvendedora 
                  and not exists ( select 1
                                   from representantes r
                                   where r.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from funcionarios f
                                   where f.idpessoa = v.idpessoa )    
                  and not exists ( select 1
                                   from usuarios u
                                   where u.idpessoa = v.idpessoa )
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = v.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo != 5 ) )
                     or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = v.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo  = 5 ) )
                     or ( :P0_IDFILIAL > 0 and exists ( select 1
                                                        from representantes r
                                                        where r.idrepresentante = v.idrepresentante
                                                          and r.ativo           = 'S'
                                                          and idgerente         = ( select idgerente 
                                                                                    from gerentes 
                                                                                    where idfilial = :P0_IDFILIAL ) ) ) ) 
                union                     
                select 'Fotos Compartilhadas' descricao
                     , trim(to_char(count(1),'999G999G990'))  quantidade
                from registroscompartilhafotos rr
                where ( :P0_IDFILIAL = -1
                      or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                          from representantes r  
                                                             , vendedoras     v
                                                             , vw_filiais f
                                                          where v.idrepresentante = r.idrepresentante      
                                                            and v.idvendedora     = rr.idvendedora
                                                            and not exists ( select 1
                                                                             from representantes r
                                                                             where r.idpessoa = v.idpessoa )
                                                            and f.idgerente       = r.idgerente
                                                            and r.ativo           = 'S'
                                                            and f.ativo           = 'S'
                                                            and f.idgrupo        != 5 ) )
                      or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                          from representantes r  
                                                             , vendedoras     v
                                                             , vw_filiais f
                                                          where v.idrepresentante = r.idrepresentante      
                                                            and v.idvendedora     = rr.idvendedora
                                                            and not exists ( select 1
                                                                             from representantes r
                                                                             where r.idpessoa = v.idpessoa )
                                                            and f.idgerente       = r.idgerente
                                                            and r.ativo           = 'S'
                                                            and f.ativo           = 'S'
                                                            and f.idgrupo         = 5 ) )
                      or ( :P0_IDFILIAL > 0 and exists ( select 1
                                                         from representantes r  
                                                            , vendedoras     v
                                                         where v.idrepresentante = r.idrepresentante      
                                                           and v.idvendedora     = rr.idvendedora
                                                           and r.ativo           = 'S'
                                                           and not exists ( select 1
                                                                            from representantes r
                                                                            where r.idpessoa = v.idpessoa )
                                                           and idgerente         = ( select idgerente 
                                                                                     from gerentes 
                                                                                     where idfilial = :P0_IDFILIAL ) ) ) )
                ```
            pageItemsToSubmit: P0_IDFILIAL
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DESCRICAO
            valueColumn: QUANTIDADE
            layout: 4Columns
        }
    )

    region lista-2 (
        name: Lista
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select '0 - Atendimento Em Dia' descricao
                     , trim(to_char(count(distinct idvendedora),'999G999G990'))  quantidade
                from notasvendas n
                where n.dataretornoorig     > sysdate-7 
                  and n.idsituacaonotavenda = 3                            
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = n.idrepresentante
                                 and r.ativo           = 'S' )
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = n.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo != 5 ) )
                     or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = n.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo  = 5 ) )
                     or ( :P0_IDFILIAL > 0 and idfilial = :P0_IDFILIAL ) )
                union
                select '1 - Atrasadas a MENOS de 42 dias' descricao
                     , trim(to_char(count(distinct idvendedora),'999G999G990'))  quantidade
                from notasvendas n
                where n.dataretornoorig     between sysdate-41 and sysdate-7
                  and n.idsituacaonotavenda = 3        
                  and n.idsemanacobranca - n.idsemanadistribuicao > 6                    
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = n.idrepresentante
                                 and r.ativo           = 'S' )
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = n.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo != 5 ) )
                     or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = n.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo  = 5 ) )
                     or ( :P0_IDFILIAL > 0 and idfilial = :P0_IDFILIAL ) )
                union
                select '2 - Atrasados ENTRE 42 e 90 dias' descricao
                     , trim(to_char(count(distinct idvendedora),'999G999G990'))  quantidade
                from notasvendas n
                where n.dataretornoorig     between sysdate-90 AND sysdate-42 
                  and n.idsituacaonotavenda = 3           
                  and n.idsemanacobranca - n.idsemanadistribuicao > 6               
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = n.idrepresentante
                                 and r.ativo           = 'S' )
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = n.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo != 5 ) )
                     or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = n.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo  = 5 ) )
                     or ( :P0_IDFILIAL > 0 and idfilial = :P0_IDFILIAL ) )
                union
                select '3 - Atrasados a MAIS de 90 dias' descricao
                     , trim(to_char(count(distinct idvendedora),'999G999G990'))  quantidade
                from notasvendas n
                where n.dataretornoorig     <= sysdate-90
                  and n.idsituacaonotavenda = 3              
                  and n.idsemanacobranca - n.idsemanadistribuicao > 6
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = n.idrepresentante
                                 and r.ativo           = 'S' )
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = n.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo != 5 ) )
                     or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = n.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo  = 5 ) )
                     or ( :P0_IDFILIAL > 0 and idfilial = :P0_IDFILIAL ) )
                union
                select '4 - Sem programação de atendimento' descricao
                     , trim(to_char(count(distinct idvendedora),'999G999G990'))  quantidade
                from notasvendas n
                where n.idsituacaonotavenda = 3           
                  and n.idrepresentanteatende is null    
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = n.idrepresentante
                                 and r.ativo           = 'N' )
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = n.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo != 5 ) )
                     or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = n.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo  = 5 ) )
                     or ( :P0_IDFILIAL > 0 and idfilial = :P0_IDFILIAL ) )
                ```
            pageItemsToSubmit: P0_IDFILIAL
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DESCRICAO
            valueColumn: QUANTIDADE
            layout: 5Columns
        }
    )

    region login-por-dia-e-hora (
        name: Login por Dia e Hora
        type: plugin/d3LineChart
        source {
            sqlQuery:
                ```sql
                select to_char(f.datalogin,'DAY') dia 
                     , to_number(trim(to_char(f.datalogin,'HH24'))) hora 
                     , count(1) qtd
                from registrosloginminhasacola f
                where datalogin > sysdate - 7
                group by to_char(f.datalogin,'D') 
                       , to_char(f.datalogin,'DAY') 
                       , to_number(trim(to_char(f.datalogin,'HH24'))) 
                order by to_char(f.datalogin,'D') , 2 ;
                ```
        }
        layout {
            sequence: 80
