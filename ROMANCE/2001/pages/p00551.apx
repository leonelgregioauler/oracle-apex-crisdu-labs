    region compartilhamento-de-fotos-no-período (
        name: Compartilhamento de Fotos no Período
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select initcap(nomepessoa)||' - '||nvl(cpf, documentoestrangeiro)
                         from pessoas p
                         where p.idpessoa = v.idpessoa )||' - Ver: '||
                       ( select versaoaplicativo
                         from registrosloginminhasacola r1
                         where r1.idregistrologinminhasacola = ( select max(idregistrologinminhasacola)
                                                                from registrosloginminhasacola rr
                                                                where rr.idvendedora = r.idvendedora )) consultora
                     , pck_romance.fnc_nomerepresentante(v.idrepresentante) ||'<br>'||
                       pck_romance.fnc_nomefilial(v.idfilial) ||'<br>'  distribuidor
                     , count(1) qtdcompartilhamento             
                from registroscompartilhafotos r
                   , vendedoras                v
                where v.idvendedora     = r.idvendedora
                  and v.ativo           = 'S'
                  and r.datacompartilhamento between to_date(trim(:P551_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P551_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = v.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo != 5 ) )
                     or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = v.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo  = 5 ) )
                     or ( :P0_IDFILIAL > 0 and v.idfilial = :P0_IDFILIAL ) ) 
                group by r.idvendedora , v.idpessoa , v.idrepresentante , v.idfilial
                order by 3 desc
                ```
            pageItemsToSubmit: [
                P551_DATAINICIO
                P551_DATAFIM
            ]
        }
        layout {
            sequence: 30
            parentRegion: @maximizar
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 7348316530243263983
        }

