    region utilização-por-distribuidor (
        name: Utilização por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select empresa
                     , distribuidor
                     , consultoras
                     , consultorasapp
                     , case
                         when consultorasapp > 0 and consultoras > 0 then
                           (consultorasapp*100/consultoras)
                         else 
                           0
                       end  perc
                     , qtdcompartilhamento
                     , consultorasapp14dias
                     , idrepresentante
                from (
                        select pck_romance.fnc_nomefilial(g.idfilial) empresa
                             , pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                             , r.idrepresentante
                             , ( select count(1)
                                 from vendedoras v
                                 where v.idrepresentante = r.idrepresentante
                                   and v.ativo           = 'S'
                                   and not exists ( select 1
                                                    from representantes rr
                                                    where rr.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa ) ) consultoras
                             , ( select count( distinct v.idvendedora)
                                 from registrosloginminhasacola e
                                    , vendedoras                v
                                 where e.primeirologin = 'S'
                                   and v.ativo           = 'S'
                                   and v.idvendedora   = e.idvendedora 
                                   and v.idrepresentante = r.idrepresentante
                                  -- and e.datalogin between to_date(trim(:P551_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P551_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                   and not exists ( select 1
                                                    from representantes rr
                                                    where rr.idpessoa = v.idpessoa ) 
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa ) ) consultorasapp  
                             , ( select count( distinct v.idvendedora)
                                 from registrosloginminhasacola e
                                    , vendedoras                v
                                 where v.ativo           = 'S'
                                   and v.idvendedora   = e.idvendedora 
                                   and e.datalogin >= trunc(sysdate)-14
                                   and v.idrepresentante = r.idrepresentante
                                  -- and e.datalogin between to_date(trim(:P551_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P551_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                   and not exists ( select 1
                                                    from representantes rr
                                                    where rr.idpessoa = v.idpessoa ) 
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa ) ) consultorasapp14dias 
                             , ( select count(1)
                                 from registroscompartilhafotos f
                                    , vendedoras                v
                                 where f.idvendedora      = v.idvendedora 
                                   and v.idrepresentante  = r.idrepresentante
                                   and f.datacompartilhamento between to_date(trim(:P551_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P551_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )  qtdcompartilhamento
                        from representantes r
                           , gerentes g
                        where r.ativo     = 'S'
                          and g.idgerente = r.idgerente
                          and exists ( select 1
                                       from vendedoras v
                                       where v.idrepresentante = r.idrepresentante
                                         and v.ativo           = 'S' ) 
                          and not exists ( select 1
                                           from gerentes g
                                           where g.idpessoa = r.idpessoa )
                          and ( :P0_IDFILIAL = -1 
                             or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                                 from vw_filiais f
                                                                 where r.idgerente = f.idgerente
                                                                   and f.ativo     = 'S'
                                                                   and f.idgrupo  != 5 ) )
                             or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                                 from vw_filiais f
                                                                 where r.idgerente = f.idgerente
                                                                   and f.ativo     = 'S'
                                                                   and f.idgrupo   = 5 ) )
                             or ( :P0_IDFILIAL > 0 and g.idfilial  = :P0_IDFILIAL ) ) )
                order by 1, 2
                ```
            pageItemsToSubmit: [
                P551_DATAINICIO
                P551_DATAFIM
                P0_IDFILIAL
            ]
        }
        layout {
            sequence: 10
            parentRegion: @maximizar
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
