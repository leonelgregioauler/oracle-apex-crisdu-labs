    region distribuidor-que-não-baixaram (
        name: Distribuidor que não baixaram
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(g.idfilial) empresa
                     , pck_romance.fnc_nomepessoa(r.idpessoa) distribuidor
                from representantes            r
                   , gerentes g
                where r.ativo = 'S'
                  and r.idgerente = g.idgerente
                  and not exists ( select 1 from gerentes gg where gg.idpessoa = r.idpessoa )
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = g.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo != 5 ) )
                     or ( :P0_IDFILIAL = -3 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial = g.idfilial
                                                           and f.ativo    = 'S'
                                                           and f.idgrupo  = 5 ) )
                     or ( :P0_IDFILIAL > 0 and g.idfilial = :P0_IDFILIAL ) )
                  and exists ( select 1
                               from filiais f
                               where f.idfilial = g.idfilial
                                 and f.tipofilial = 'D' 
                                 and f.ativo = 'S')
                  and not exists ( select 1
                                   from registrosloginminhasacola e
                                      , vendedoras                v
                                   where e.idvendedora = v.idvendedora
                                     and v.idrepresentante = r.idrepresentante
                                     and e.primeirologin    = 'S' 
                                     and e.datalogin between to_date(trim(:P551_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P551_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS'))
                order by 1,2
                ```
            pageItemsToSubmit: P0_IDFILIAL
        }
        layout {
            sequence: 150
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 7115485639138926177
        }

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        savedReport 44256756 (
            visibility: primaryDefault
            view {
                groupBy: true
                rowsPerPage: 30
            }

            displayColumn DISTRIBUIDOR (
                sequence: 2
            )

            displayColumn EMPRESA (
                sequence: 1
            )

            groupByColumn (
                column: EMPRESA
                layout {
                    sequence: 1
                }
            )

            groupByAggregate (
                heading: Não Baixou
                aggregate {
                    function: countDistinct
                    column: DISTRIBUIDOR
                    displaySum: true
                }
