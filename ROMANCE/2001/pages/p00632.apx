page 632 (
    name: Mapeando Informação
    title: Mapeando Informação
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        inline: ".rc-content-main {height: 400px; overflow: auto !important;}"
    }
    security {
        pageAccessProtection: unrestricted
    }

    region etapa-do-processo (
        name: Etapa do Processo<
        type: list
        source {
            list: @data-load-wizard-progress-disparo-sms-3
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            excludeTitleFromTranslation: true
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    region mapeando-informação (
        name: Mapeando Informação
        type: dataUploadColMapping
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: style="width:100%;max-width:none;"
        }
        settings {
            dataLoadDefinition: @disparo-sms
        }
    )

    pageItem P632_IDMENSAGEMDISPARO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @mapeando-informação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 20
            region: @mapeando-informação
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 631
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Próximo
        layout {
            sequence: 30
            region: @mapeando-informação
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS
        label: Anterior
        layout {
            sequence: 10
            region: @mapeando-informação
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 631
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process prepare-uploaded-data (
        name: Prepare Uploaded Data
        type: prepareUploadedData
        dataLoading {
            dataLoadDefinition: @disparo-sms
        }
        processingResult {
            insertCountItem: P634_INSERT_COUNT
            updateCountItem: P634_UPDATE_COUNT
            errorCountItem: P634_ERROR_COUNT
            reviewCountItem: P634_REVIEW_COUNT
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 123414660857500513
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

    branch (
        name: Go To Page 633
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 633
                items: {
                    P633_IDMENSAGEMDISPARO: &P632_IDMENSAGEMDISPARO.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                                   begin
                                            for c1 in (select skip_validation
                                                      from apex_appl_load_tables
                                                      where name = 'Disparo SMS' and application_id = apex_application.g_flow_id )
                                            loop
                                                if c1.skip_validation = 'N' then return true;
                                                else return false;
                                                end if;
                                            end loop;
                                        end;
                ```
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 634
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                                   begin
                                            for c1 in (select skip_validation
                                                      from apex_appl_load_tables
                                                      where name = 'Disparo SMS' and application_id = apex_application.g_flow_id )
                                            loop
                                                if c1.skip_validation = 'Y' then return true;
                                                else return false;
                                                end if;
                                            end loop;
                                        end;
                ```
        }
    )

)

