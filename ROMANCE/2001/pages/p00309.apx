page 309 (
    name: Logs de Pagamento(s)
    title: Logs de Pagamento(s)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region logs-de-pagamento-s (
        name: Logs de Pagamento(s)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select lpg.usuarioalteracao 
                     , decode(lpg.tipoalteracao,'INSERT','Incluído','UPDATE','Alteração','DELETE','Exclusão') tipoalteracao
                     , lpg.datapagamento
                     , lpg.valorpago
                     , lpg.semanacobranca
                     , lpg.observacao
                     , lpg.origem
                     , lpg.dataalteracao 
                     , lpg.idtablet --16031000
                from logroman.log_pagamentosnotasvendas lpg
                where lpg.idnotavenda = :P309_IDNOTAVENDA
                order by lpg.dataalteracao desc
                 --and (:P309_FILTROVEND is null or :P309_FILTROVEND = idvendedora)
                  --and (:P309_FILTRONOTA is null or :P309_FILTRONOTA = numeronota)
                  --and ( (:P309_FILTROTIPOSEMANA is null or :P309_FILTROTIPOSEMANA = 'D' and ( :P309_FILTROSEMANA is null or Semanadistribuicao = :P309_FILTROSEMANA ) )
                  -- or (:P309_FILTROTIPOSEMANA is null or :P309_FILTROTIPOSEMANA = 'C' and ( :P309_FILTROSEMANA is null or Semanacobranca = :P309_FILTROSEMANA ) ) )
                  --and IDFILIAL = :P0_IDFILIAL
                  
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
            displayPosition: bottomLeft
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum log encontrado.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 514129951230332709
        }

        column DATAALTERACAO (
            type: plainText
            heading {
                heading: Data Alteração
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: AI
            }
        )

        column DATAPAGAMENTO (
            type: plainText
            heading {
                heading: Data do pagamento
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: AE
            }
        )

        column IDTABLET (
            type: plainText
            heading {
                heading: ID Tablet
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: AJ
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AF
            }
        )

        column ORIGEM (
            type: plainText
            heading {
                heading: Origem
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AG
            }
        )

        column SEMANACOBRANCA (
            type: plainText
            heading {
                heading: Semana Cob.
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: SEMANACOBRANCA
                endUserAlias: K
            }
            enableUsersTo {
                pivot: false
            }
        )

        column TIPOALTERACAO (
            type: plainText
            heading {
                heading: Tipo de Alteração
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AD
            }
        )

        column USUARIOALTERACAO (
            type: plainText
            heading {
                heading: Usuário que Alterou
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: USUARIOALTERACAO
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column VALORPAGO (
            type: plainText
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: VALORPAGO
                endUserAlias: S
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 49928 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn DATAALTERACAO (
                sequence: 1
            )

            displayColumn DATAPAGAMENTO (
                sequence: 6
            )

            displayColumn IDTABLET (
                sequence: 9
            )

            displayColumn OBSERVACAO (
                sequence: 7
            )

            displayColumn ORIGEM (
                sequence: 8
            )

            displayColumn SEMANACOBRANCA (
                sequence: 3
            )

            displayColumn TIPOALTERACAO (
                sequence: 5
            )

            displayColumn USUARIOALTERACAO (
                sequence: 2
            )

            displayColumn VALORPAGO (
                sequence: 4
            )

            sort (
                column: DATAALTERACAO
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    pageItem P309_FILTRONOTA (
        type: textField
        label {
            label: Número da Nota
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @logs-de-pagamento-s
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 10
        }
        source {
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P309_FILTROREPRES (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante) || decode(r.ativo,'S','','Inativo') display_value
                     , r.idrepresentante
                from representantes r
                where idgerente in ( select idgerente
                                     from gerentes
                                     where idfilial = :P0_IDFILIAL)
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @logs-de-pagamento-s
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 4000
        }
        source {
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P309_FILTROSEMANA (
        type: textField
        label {
            label: Semana
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 80
            region: @logs-de-pagamento-s
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 4000
        }
        source {
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P309_FILTROTIPOSEMANA (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Distribuição;D,Cobrança;C
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @logs-de-pagamento-s
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P309_FILTROVEND (
        type: popupLov
        label {
            label: Cliente
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomepessoa)||' - '||nvl(cpf,replace(replace(documentoestrangeiro,'-',''),'.','')) display_value
                     , v.idvendedora return_value
                from vendedoras v
                   , pessoas p
                where v.idpessoa = p.idpessoa
                  and ( :P309_FILTROREPRES is null  or v.idrepresentante = :P309_FILTROREPRES ) 
                  and v.idrepresentante in (select idrepresentante
                                            from representantes
                                            where idgerente in ( select idgerente
                                                                 from gerentes
                                                                 where idfilial = :P0_IDFILIAL))
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P309_FILTROREPRES
        }
        layout {
            sequence: 20
            region: @logs-de-pagamento-s
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 4000
        }
        source {
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P309_IDNOTAVENDA (
        type: textField
        label {
            label: IDNOTAVENDA
            alignment: left
        }
        layout {
            sequence: 90
            region: @logs-de-pagamento-s
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button p309-filtrar (
        buttonName: P309_FILTRAR
        label: Filtrar
        layout {
            sequence: 100
            region: @logs-de-pagamento-s
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: P227_FILTRAR
        }
    )

    branch (
        name: filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 309
                items: {
                    P309_IDNOTAVENDA: &P309_IDNOTAVENDA.
                }
                action: resetPagination
            }
        }
    )

)

