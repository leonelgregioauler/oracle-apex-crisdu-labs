page 411 (
    name: Movimentação Manual de Insumo
    title: Movimentação Manual de Insumo
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region movimentação-manual (
        name: Movimentação Manual
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P411_CODIGO (
        type: textField
        label {
            label: Código
            alignment: left
        }
        layout {
            sequence: 50
            region: @movimentação-manual
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P411_DATAMOVIMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 120
            region: @movimentação-manual
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            used: always
        }
        default {
            type: expression
            plsqlExpression: to_date(sysdate,'DD/MM/RRRR HH24:MI:SS')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P411_IDESTOQUEINSUMO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap( pr.nomeproduto )  display_value
                     , e.idestoqueinsumo   return_value
                from estoquesinsumos e
                   , produtos                pr
                where e.idproduto = pr.idproduto
                  and e.idfilial  = :P0_IDFILIAL 
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @movimentação-manual
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P411_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @movimentação-manual
            slot: regionBody
        }
        source {
            used: always
        }
        default {
            type: expression
            plsqlExpression: :P0_IDFILIAL
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P411_IDINSUMO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @movimentação-manual
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P411_IDMOVTOESTOQUEINSUMO (
        type: hidden
        layout {
            sequence: 20
            region: @movimentação-manual
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDMOVTOESTOQUEINSUMO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P411_IDPRODUTO (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap( pr.nomeproduto )  display_value
                     , e.idproduto   return_value
                from estoquesinsumos e
                   , produtos                pr
                where e.idproduto = pr.idproduto
                  and e.idfilial  = :P0_IDFILIAL 
                  and pr.codigosisdist = :P411_CODIGO
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P411_CODIGO
        }
        layout {
            sequence: 60
            region: @movimentação-manual
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P411_IDSEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 150
            region: @movimentação-manual
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDSEMANA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidsemana number;
                begin
                  --
                  select pck_util.fnc_idsemanadata(sysdate)
                  into vidsemana
                  from dual;
                  --
                  return vidsemana;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P411_OBSERVACAO (
        type: textarea
        label {
            label: Observacao
            alignment: left
        }
        layout {
            sequence: 140
            region: @movimentação-manual
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 1000
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P411_OPCAO (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Código;C,Pesquisa;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @movimentação-manual
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        default {
            type: static
            staticValue: C
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P411_QUANTIDADE (
        type: numberField
        label {
            label: Quantidade
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 130
            region: @movimentação-manual
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        validation {
            maxLength: 255
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P411_TIPO (
        type: radioGroup
        label {
            label: "Tipo "
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Entrada;E,Consumo Interno;S,Venda;V
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @movimentação-manual
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P411_USUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 110
            region: @movimentação-manual
            slot: regionBody
        }
        source {
            used: always
        }
        default {
            type: expression
            plsqlExpression: v('APP_USER')
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Movimentar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P411_IDMOVTOESTOQUEINSUMO
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P411_IDMOVTOESTOQUEINSUMO
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P411_IDMOVTOESTOQUEINSUMO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-de-opção (
        name: Tipo de Opção
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P411_OPCAO
        }
        clientSideCondition {
            type: item=value
            item: P411_OPCAO
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P411_IDESTOQUEINSUMO
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P411_CODIGO
                    P411_IDPRODUTO
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P411_CODIGO
                    P411_IDPRODUTO
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P411_IDESTOQUEINSUMO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    validation valida-observacao (
        name: Valida Observacao
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P411_OBSERVACAO
        }
        error {
            errorMessage: Por favor, informe um motivo!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SAVE','CREATE','DELETE')
                ```
        }
    )

    validation valida-produtos (
        name: Valida Produtos
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P411_IDESTOQUEINSUMO is not null or :P411_IDPRODUTO is not null
                ```
        }
        error {
            errorMessage: Informe o produto a ser movimentado.
        }
        serverSideCondition {
            type: request=Value
            value: CREATE
        }
    )

    validation valida-quantidade (
        name: Valida Quantidade
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(:P411_QUANTIDADE) >= 0
                ```
        }
        error {
            errorMessage: Informe uma quantidade válida!
            associatedItem: @P411_QUANTIDADE
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                Select 1
                from dual
                where v('REQUEST') in ('SAVE','CREATE')
                ```
        }
    )

    process confirmar-movimentação (
        name: Confirmar Movimentação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  videstoqueinsumo number;
                  vidproduto       number;
                  --
                begin
                  --
                  if :P411_OPCAO = 'C' then
                    --
                    select e.idestoqueinsumo
                         , e.idproduto
                    into videstoqueinsumo
                       , vidproduto
                    from estoquesinsumos e
                    where e.idfilial = :P411_IDFILIAL
                      and e.idproduto = :P411_IDPRODUTO;
                    --
                  elsif :P411_OPCAO = 'P' then
                    --
                    select e.idestoqueinsumo
                         , e.idproduto
                    into videstoqueinsumo
                       , vidproduto
                    from estoquesinsumos e
                    where e.idestoqueinsumo = :P411_IDESTOQUEINSUMO;
                    --
                  end if;
                  --
                  insert into movimentosestoquesinsumos ( idmovtoestoqueinsumo
                                                        , idestoqueinsumo
                                                        , idproduto
                                                        , idfilial
                                                        , usuario
                                                        , datamovimento
                                                        , tipo
                                                        , quantidade
                                                        , observacao
                                                        , idsemana )
                  values ( seq_idmovtoestoqueinsumo.nextval
                         , videstoqueinsumo
                         , vidproduto
                         , :P411_IDFILIAL
                         , :P411_USUARIO
                         , sysdate
                         , :P411_TIPO
                         , :P411_QUANTIDADE
                         , :P411_OBSERVACAO
                         , pck_util.fnc_idsemanadata(sysdate) );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1483935273451868725
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                Select 1
                from dual
                where v('REQUEST') in ('SAVE','CREATE')
                ```
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 413
                items: {
                    P413_IDINSUMO: &P411_IDINSUMO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
        }
    )

)

