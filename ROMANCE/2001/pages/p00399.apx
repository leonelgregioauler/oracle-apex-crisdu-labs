page 399 (
    name: Detalhamento notas vendas
    title: Detalhamento Notas Vendas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        width: 1000
        height: 400
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region nota-venda (
        name: Nota Venda
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , to_number(nv.numeronota) numeronota
                     , pck_romance.fnc_nomerepresentante(pidrepresentante => nv.idrepresentante) "Representante"
                     , nv.datanota
                     , nv.semanadistribuicao/*||'  '||pck_romance.fnc_semanadias(psemana => nv.semanadistribuicao)*/ "Semana Distribuição"
                     , nv.semanacobranca/*||'  '||pck_romance.fnc_semanadias(psemana => nv.semanacobranca)*/ "Semana Cobrança"
                     , pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) "Vendedora" 
                     , pck_romance.fnc_nomeregiaovenda( nv.idregiaovenda ) "Região de Venda"
                     , nv.idregiaovenda
                     , nv.valortotalnota
                     , nv.valortotaldevolucao
                     , nv.idrepresentante
                     , nv.idvendedora
                     , nv.valortotalvenda
                     , nv.valortotalvendalqd
                     , nv.basecomissao
                     , nv.perccomissao
                     , nv.valorcomissao
                     , nv.valorpago  valorpago
                     , nvl(( select sum(p.valorpago)
                             from pagamentosnotasvendas p
                             where p.idsemanacobranca = nv.idsemanacobranca
                               and p.idnotavenda = nv.idnotavenda ),0) pagonasemana
                     , nv.saldo
                     , substr(cpf,1,3)||'.'||substr(pp.cpf,4,3)||'.'||substr(pp.cpf,7,3)||'-'||substr(pp.cpf,10) "CPF. Vend."
                     , pp.documentoestrangeiro "Doc Estrangeiro"
                     , pck_romance.fnc_nomecidade(pp.idcidade) "Cidade. Vend."
                     , ( select sn.descricao from situacoesnotavenda sn where sn.idsituacaonotavenda = nv.idsituacaonotavenda ) "Situação"
                     , decode(nv.quitadapepino,'Q','Quitado','P','Débito','R','Remarcada') "Quitado/Débito"
                     , nv.dataretorno
                     , to_number(substr(nv.semanacobranca,1,2)) semanacobranca
                     , to_number(substr(nv.semanacobranca,4,4)) anocobranca
                     , pck_romance.fnc_nomerepresentante(idrepresentanteatende) "Repres. Atende"
                     , decode(nv.enviadocobranca,'S', 'Sim','Não') "Enviado para Cobrança"
                     , idrepresentanteatende "ID Repres Atende"
                     , decode(v.ativo,'S','Sim','Não') "Situação Vendedora"
                     , nv.idsemanacobranca
                     , pck_util.fnc_idsemana(psemana => to_char(sysdate,'IW/RRRR')) as "Idsemana Atual"
                     , (select count(1)
                        from notasvendas n
                        where n.idvendedora = nv.idvendedora
                          and n.idnotavenda = nv.idnotavenda) "Qtd Notas"
                     , (select count(1)
                        from regioesrepresentantes r
                        where r.idrepresentante = nv.idrepresentante
                           and r.idregiaovenda = nv.idregiaovenda) regrepresentante
                     , pck_romance.fnc_retornatelefones(nv.idvendedora) "Telefones"
                     , (select sum(ii.quantidade)
                        from itensnotavenda ii
                        where ii.idnotavenda = nv.idnotavenda) "Qtd Dist"
                     , (select sum(i.quantidade - nvl(i.qtddevolvida,0))
                        from itensnotavenda i
                        where i.idnotavenda = nv.idnotavenda
                          and nv.idsituacaonotavenda = 4) "Qtd Vendida"
                     , pp.nroconsultaspc "Nro Consulta SPC"
                     , ( select listagg(oo.data|| '-' || oo.observacao,' ') within group (order by 1)
                         from observacoesnotasvendas oo
                         where oo.idnotavenda= nv.idnotavenda ) "Histórico Cobrança"
                     , pck_romance.fnc_nomefilial(nv.idfilial) "Filial"  
                     , pck_romance.fnc_verificadebito(nv.idvendedora) "Qtd Débito"
                     , dataacerto
                     , extract( month from nv.dataacerto) mesacerto
                     , case
                         when exists ( select 1
                                       from classificacoesnotasvendas cn
                                       where cn.idnotavenda = nv.idnotavenda
                                         and cn.IDCARACTERISTICANOTAVENDA = 3 ) then
                           'Sim'
                         else
                           'Não'
                       end promissoriarecebida
                     , case
                        when nv.idsemanacobranca - nv.idsemanadistribuicao > 6 and nv.idsituacaonotavenda = 4 then
                          'Débito Recebido'
                        when nv.idsemanacobranca - nv.idsemanadistribuicao <= 6 and nv.idsituacaonotavenda = 4 then
                          'Cobrança da Semana'
                        else
                          'Não Acertada'
                       end identificacao   
                from notasvendas    nv
                   , vendedoras v
                   , pessoas pp
                where nv.idfilial      = :P0_IDFILIAL
                  and v.idvendedora    = nv.idvendedora
                  and pp.idpessoa      = v.idpessoa
                  and nv.idnotavenda = :P399_IDNOTAVENDA
                  and ( :P36_NRNOTA is null or nv.numeronota = :P36_NRNOTA  )
                  and ( :P36_IDREPRESENTANTE is null or ( nv.idrepresentante = :P36_IDREPRESENTANTE or nv.idrepresentanteatende = :P36_IDREPRESENTANTE  ) )
                  and ( :P36_IDVENDEDORA     is null or nv.idvendedora = :P36_IDVENDEDORA )
                  and ( :P36_REGIAOVENDA is null or nv.idregiaovenda = :P36_REGIAOVENDA )
                  and ( :P36_HISTORICO is null or exists ( select 1
                                                           from observacoesnotasvendas o
                                                           where lower(o.observacao) like '%'||lower(:P36_HISTORICO)||'%'
                                                             and o.idnotavenda = nv.idnotavenda))
                  
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1450650568221510802
        }

