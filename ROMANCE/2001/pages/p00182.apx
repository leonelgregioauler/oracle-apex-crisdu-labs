    pageItem P182_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto)||' - '||p.codigosisdist||' - '||e.vlrvenda display_value
                     , p.idproduto return_value
                from produtos      p
                   , estoquefilial e
                where p.idproduto = e.idproduto
                  and e.ativo = 'S'
                  and e.idfilial = :P0_IDFILIAL
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P182_CODIGO
        }
        layout {
            sequence: 75
            region: @inclui-atualizar-item-da-nota
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 4000
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

