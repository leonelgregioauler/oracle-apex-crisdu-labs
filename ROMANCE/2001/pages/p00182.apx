    dynamicAction pula-campo (
        name: pula campo
        execution {
            sequence: 10
        }
        when {
            event: focusout
            selectionType: items
            items: P182_CODIGO
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P182_QUANTIDADE
            }
            execution {
                sequence: 10
            }
        )

    )

    validation p182-codigo (
        name: P182_CODIGO
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from itensnotavenda i
                where i.idnotavenda  = :P182_IDNOTAVENDA
                   and i.idestoquefil = ( select f.idestoquefilial
                                           from estoquefilial f
                                           where f.idfilial = :P0_IDFILIAL
                                             and f.ativo = 'S'
                                             and f.idproduto = :P182_IDPRODUTO ) ;
                ```
        }
        error {
            errorMessage: Este item já está incluído na nota!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation p182-idproduto (
        name: P182_IDPRODUTO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P182_IDPRODUTO
        }
        error {
            errorMessage: Informe o produto!
            displayLocation: inlineInNotification
        }
    )

    process fetch-row-from-itensnotavenda (
        name: Fetch Row from ITENSNOTAVENDA
        type: autoRowFetch
        source {
            tableName: ITENSNOTAVENDA
            pkColumn: IDITEMNOTAVENDA
            pkItem: P182_IDITEMNOTAVENDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 111189169538123479
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidproduto  number;
                  --
                begin 
                  --
                  if :P182_IDITEMNOTAVENDA is null then
                    --
                    select "SEQ_ITEMNOTAVENDA".nextval
                    into :P182_IDITEMNOTAVENDA
                    from dual;
                    --
                    vidproduto := :P182_IDPRODUTO;
                    --
                    select ee.idestoquefilial
                         , ee.vlrvenda
                         , ee.comissao
                    into :P182_IDESTOQUEFIL
                       , :P182_VALORVENDA
                       , :P182_COMISSAO
                    from estoquefilial ee
                    where idfilial  = ( select idfilial from notasvendas n where n.idnotavenda = :P182_IDNOTAVENDA)
                      and ativo = 'S'
                      and  idproduto = vidproduto;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 111188565755123476
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-itensnotavenda (
        name: Process Row of ITENSNOTAVENDA
        type: autoRowProcessing
        target {
            tableName: ITENSNOTAVENDA
            pkColumn: IDITEMNOTAVENDA
            pkItem: P182_IDITEMNOTAVENDA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 111188759064123479
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        clear {
            type: pages
            pages: 38
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 111188959808123479
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 182
                items: {
                    P182_IDNOTAVENDA: &P182_IDNOTAVENDA.
                    P182_IDITEMNOTAVENDA:
                }
                successMessage: false
            }
        }
    )

