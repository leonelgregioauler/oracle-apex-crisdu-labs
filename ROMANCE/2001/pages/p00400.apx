page 400 (
    name: Acompanhamento dos Históricos
    title: Acompanhamento dos Históricos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-do-dia (
        name: Acompanhamento do Dia
        type: plugin/flotPieChart
        source {
            sqlQuery:
                ```sql
                select decode(liberado,'S','Aprovado','N','Reprovado') liberado
                     , count(1) qtd
                from historicosconsultasdoc h
                where trunc(h.dataconsulta) = trunc(sysdate)
                  and h.idfilial = :P0_IDFILIAL
                group by h.liberado
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: LIBERADO
            valueColumn: QTD
            width: 600
            colorScheme: metro
        }
    )

    region acompanhamento-do-período (
        name: Acompanhamento do Período
        type: plugin/flotPieChart
        source {
            sqlQuery:
                ```sql
                select decode(liberado,'S','Aprovado','N','Reprovado') liberado
                     , count(1) qtd
                from historicosconsultasdoc h
                where trunc(h.dataconsulta) between to_date(:P400_DATAINICIO) and to_date(:P400_DATAFIM)
                  and h.idfilial = :P0_IDFILIAL
                group by h.liberado
                ```
            pageItemsToSubmit: [
                P400_DATAINICIO
                P400_DATAFIM
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: LIBERADO
            valueColumn: QTD
            width: 600
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region por-data (
        name: Por Data
        type: plugin/slideTooltip
        source {
            sqlQuery:
                ```sql
                select 'fa-circle' icon
                     , trunc(h.dataconsulta) dataconsulta
                     , ( select count(1)
                         from historicosconsultasdoc hd
                         where hd.liberado = 'S'
                           and trunc(hd.dataconsulta) = trunc(h.dataconsulta)
                           and hd.idfilial = h.idfilial ) aprovado
                     , ( select count(1)
                         from historicosconsultasdoc hd
                         where nvl(hd.liberado,'N') = 'N'
                           and trunc(hd.dataconsulta) = trunc(h.dataconsulta)
                           and hd.idfilial = h.idfilial ) reprovado
                     , count(1) quantidade
                from historicosconsultasdoc h
                where trunc(h.dataconsulta) between to_date(:P400_DATAINICIO) and to_date(:P400_DATAFIM)
                  and h.idfilial = :P0_IDFILIAL
                group by trunc(h.dataconsulta), h.idfilial
                order by 2 
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            mode: tooltip
            iconColumn: ICON
            titleColumn: DATACONSULTA
            badgeColumn: QUANTIDADE
            linkTarget: {
                type: url
                url: #&ENAME.
            }
        }

        column APROVADO (
            source {
                dataType: NUMBER
            }
            heading {
                heading: Aprovado
            }
            layout {
                sequence: 30
            }
        )

        column DATACONSULTA (
            source {
                dataType: DATE
            }
            heading {
                heading: Data da Consulta
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
        )

        column ICON (
            source {
                dataType: VARCHAR2
            }
            heading {
                heading: Icon
            }
            layout {
                sequence: 20
            }
        )

        column QUANTIDADE (
            source {
                dataType: NUMBER
            }
            heading {
                heading: Quantidade
            }
            layout {
                sequence: 50
            }
        )

        column REPROVADO (
            source {
                dataType: NUMBER
            }
            heading {
                heading: Reprovado
            }
            layout {
                sequence: 40
            }
        )

    )

    region por-distribuidor (
        name: Por Distribuidor
        type: plugin/slideTooltip
        source {
            sqlQuery:
                ```sql
                select 'fa-circle' icon
                     , pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                     , ( select count(1)
                         from historicosconsultasdoc hd
                         where hd.idrepresentante = h.idrepresentante
                           and hd.liberado = 'S'
                           and trunc(hd.dataconsulta) between to_date(:P400_DATAINICIO) and to_date(:P400_DATAFIM) ) aprovado
                     , ( select count(1)
                         from historicosconsultasdoc hd
                         where hd.idrepresentante = h.idrepresentante
                           and nvl(hd.liberado,'N') = 'N'
                           and trunc(hd.dataconsulta) between to_date(:P400_DATAINICIO) and to_date(:P400_DATAFIM) ) reprovado
                     , count(1) quantidade
                from historicosconsultasdoc h
                where trunc(h.dataconsulta) between to_date(:P400_DATAINICIO) and to_date(:P400_DATAFIM)
                  and h.idfilial = :P0_IDFILIAL
                group by idrepresentante 
                order by 5 desc
                ```
        }
        layout {
            sequence: 70
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            mode: tooltip
            iconColumn: ICON
            titleColumn: DISTRIBUIDOR
            badgeColumn: QUANTIDADE
            linkTarget: {
                type: url
                url: #&ENAME.
            }
        }

        column APROVADO (
            source {
                dataType: NUMBER
            }
            heading {
                heading: Aprovado
            }
            layout {
                sequence: 30
            }
        )

        column DISTRIBUIDOR (
            source {
                dataType: VARCHAR2
            }
            heading {
                heading: Distribuidor
            }
            layout {
                sequence: 10
            }
        )

        column ICON (
            source {
                dataType: VARCHAR2
            }
            heading {
                heading: Icon
            }
            layout {
                sequence: 20
            }
        )

        column QUANTIDADE (
            source {
                dataType: NUMBER
            }
            heading {
                heading: Quantidade
            }
            layout {
                sequence: 50
            }
        )

        column REPROVADO (
            source {
                dataType: NUMBER
            }
            heading {
                heading: Reprovado
            }
            layout {
                sequence: 40
            }
        )

    )

    region por-usuário (
        name: Por Usuário
        type: plugin/d3PieChart
        source {
            sqlQuery:
                ```sql
                select usuario
                     , count(1) quantidade
                from historicosconsultasdoc h
                where trunc(h.dataconsulta) between to_date(:P400_DATAINICIO) and to_date(:P400_DATAFIM)
                  and h.idfilial = :P0_IDFILIAL
                group by usuario
                order by 1
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: USUARIO
            valueColumn: QUANTIDADE
            width: 500
            chartType: donut
            innerRadius: 10
            displayOptions: [
                labels
                percentages
            ]
        }
    )

    region últimos-10-dias (
        name: Últimos 10 Dias
        type: plugin/d3BarChart
        source {
            sqlQuery:
                ```sql
                select trunc(h.dataconsulta) dataconsulta
                     , decode(liberado,'S','Aprovado','N','Reprovado') liberado
                     , count(1) qtd
                from historicosconsultasdoc h
                where trunc(h.dataconsulta) between trunc(sysdate)-10 and trunc(sysdate)
                  and h.idfilial = :P0_IDFILIAL
                group by trunc(h.dataconsulta) , h.liberado
                order by 1 desc
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            xValuesColumn: LIBERADO
            yValuesColumn: QTD
            display: horizontalSideBySide
            multipleSeries: attributeValue
            seriesColumn: DATACONSULTA
            tooltips: [
                showSeriesName
                showXValue
                showYValue
            ]
            colorScheme: modern
        }
    )

    pageItem P400_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P400_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P400_TOTAL (
        type: numberField
        label {
            label: Total
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @acompanhamento-do-período
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1) qtd
                from historicosconsultasdoc h
                where trunc(h.dataconsulta) between to_date(:P400_DATAINICIO) and to_date(:P400_DATAFIM)
                  and h.idfilial = :P0_IDFILIAL
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P400_TOTAL_DIA (
        type: numberField
        label {
            label: Total
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @acompanhamento-do-dia
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1) qtd
                from historicosconsultasdoc h
                where trunc(h.dataconsulta) = trunc(sysdate)
                  and h.idfilial = :P0_IDFILIAL
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @filtros
            slot: copy
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 374
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction change-value (
        name: Change Value
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P400_DATAFIM
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P400_DATAFIM
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @acompanhamento-do-período
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @por-distribuidor
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @acompanhamento-do-dia
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-4 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @por-data
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh-5 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @por-usuário
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

    )

)

