    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @itens-da-venda-direta
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P366_IDITEMVENDADIRETA
        }
    )

    button delete (
        buttonName: DELETE
        label: Remover Produto
        layout {
            sequence: 30
            region: @itens-da-venda-direta
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P366_IDITEMVENDADIRETA
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 20
            region: @itens-da-venda-direta
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P366_IDITEMVENDADIRETA
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @itens-da-venda-direta
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 90
                items: {
                    P90_IDVENDADIRETA: &P366_IDVENDADIRETA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction editar-produto (
        name: Editar Produto
        execution {
            sequence: 40
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P366_IDITEMVENDADIRETA
        }

        action native-set-value (
            action: setValue
            settings {
                value: P
            }
            affectedElements {
                selectionType: items
                items: P366_OPCAO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction estoque-por-grade (
        name: Estoque por Grade
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: item=value
            item: P0_ESTOQUEPORGRADE
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P366_QTD_PP
                    P366_QTD_P
                    P366_QTD_M
                    P366_QTD_G
                    P366_QTD_GG
                    P366_QTD_EGG
                    P366_QTD_EXGG
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P366_QTD_PP
                    P366_QTD_P
                    P366_QTD_M
                    P366_QTD_G
                    P366_QTD_GG
                    P366_QTD_EGG
                    P366_QTD_EXGG
                    P366_QTD_U
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-focus (
        name: Set Focus
        execution {
            sequence: 50
        }
        when {
            event: ready
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P366_CODIGO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo (
        name: Tipo
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P366_OPCAO
        }
        clientSideCondition {
            type: item=value
            item: P366_OPCAO
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P366_IDPRODUTO2
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P366_CODIGO
                    P366_IDPRODUTO
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P366_CODIGO
                    P366_IDPRODUTO
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P366_IDPRODUTO2
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    validation p366-idproduto (
        name: P366_IDPRODUTO
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P366_IDPRODUTO is not null
                or :P366_IDPRODUTO2 is not null
                ```
        }
        error {
            errorMessage: Informe o produto!
            associatedItem: @P366_IDPRODUTO
        }
    )

    validation valida-mesmo-idestoquefil (
        name: Valida mesmo IDESTOQUEFIL
        execution {
            sequence: 100
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from itensvendadireta
                where idvendadireta = :P366_IDVENDADIRETA
                  and idestoquefil  = ( select ee.idestoquefilial
                                        from estoquefilial ee
                                        where idfilial  = :P0_IDFILIAL
                                          and ( idproduto = :P366_IDPRODUTO
                                            or  idproduto = :P366_IDPRODUTO2 ) )
                ```
        }
        error {
            errorMessage: Este produto já foi incluído na Venda Direta
            associatedItem: @P366_IDESTOQUEFIL
        }
    )

    validation valida-qtd-egg (
        name: Valida QTD EGG
        execution {
            sequence: 70
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_estoque.fnc_estoquedisponivel(:P366_IDESTOQUEFIL,'EGG') >= nvl(to_number(:P366_QTD_EGG),0)
                ```
        }
        error {
            errorMessage: Lançamento é maior que a quantidade disponível em estoque!
            associatedItem: @P366_QTD_EGG
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P366_QTD_EGG
        }
    )

