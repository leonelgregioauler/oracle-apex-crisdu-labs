page 366 (
    name: Itens da Venda Direta
    title: Itens da Venda Direta
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region itens-da-venda-direta (
        name: Itens da Venda Direta
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P366_CODIGO (
        type: numberField
        label {
            label: Código
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @itens-da-venda-direta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 6
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P366_COMISSAO (
        type: hidden
        layout {
            sequence: 80
            region: @itens-da-venda-direta
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: COMISSAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

