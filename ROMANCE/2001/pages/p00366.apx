        }
        source {
            type: databaseColumn
            databaseColumn: IDESTOQUEFIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P366_IDFUNCIONARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 180
            region: @itens-da-venda-direta
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P366_IDITEMVENDADIRETA (
        type: hidden
        layout {
            sequence: 10
            region: @itens-da-venda-direta
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDITEMVENDADIRETA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P366_IDPRODUTO (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto) display_value
                     , p.idproduto return_value
                from produtos      p
                   , estoquefilial e
                where p.codigosisdist = :P366_CODIGO
                  and e.idfilial      = :P0_IDFILIAL
                  and e.idproduto = p.idproduto
                  and e.ativo = 'S'
                  and e.comissao is not null
                  and nvl(e.vlrvenda,0) > 0
                order by 1;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P366_CODIGO
        }
        layout {
            sequence: 50
            region: @itens-da-venda-direta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDPRODUTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P366_IDPRODUTO2 (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto) display_value
                     , p.idproduto return_value
                from produtos      p
                   , estoquefilial e
                where e.idfilial      = :P0_IDFILIAL
                  and e.idproduto = p.idproduto
                  and e.ativo = 'S'
                  and e.comissao is not null
                  and nvl(e.vlrvenda,0) > 0
                order by p.nomeproduto
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @itens-da-venda-direta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P366_IDVENDADIRETA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @itens-da-venda-direta
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDVENDADIRETA
            used: always
