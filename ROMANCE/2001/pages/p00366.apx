    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P366_IDPRODUTO is null then
                      :P366_IDPRODUTO := :P366_IDPRODUTO2;
                    end if;
                    
                    if :P366_IDITEMVENDADIRETA is null then
                        select "#OWNER#"."SEQ_IDITEMVENDADIRETA".nextval
                          into :P366_IDITEMVENDADIRETA
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
