    )

    pageItem P366_LIMITEPRODUTOS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 190
            region: @itens-da-venda-direta
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select valor
                from parametros p
                where p.idfilial = :P0_IDFILIAL
                  and p.nome = 'LIMITEPRODUTOSVENDADIRETA'
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P366_OPCAO (
        type: radioGroup
        label {
            label: Opção de Busca
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Código;C,Pesquisa;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @itens-da-venda-direta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: C
        }
        security {
            encryptSessionState: false
        }
    )

