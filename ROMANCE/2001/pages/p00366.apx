    validation valida-quantidade (
        name: Valida Quantidade
        execution {
            sequence: 110
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(:P366_QTD_PP) > 0
                   or to_number(:P366_QTD_P) > 0
                   or to_number(:P366_QTD_M) > 0
                   or to_number(:P366_QTD_G) > 0
                   or to_number(:P366_QTD_GG) > 0
                   or to_number(:P366_QTD_EGG) > 0
                   or to_number(:P366_QTD_EXGG) > 0
                   or to_number(:P366_QTD_U) > 0
                ```
        }
        error {
            errorMessage: Informe uma quantidade Válida!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation valida-quantidade-limite (
        name: Valida Quantidade Limite
        execution {
            sequence: 120
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(:P366_QTD_PP) >= :P366_LIMITEPRODUTOS+1
                   or to_number(:P366_QTD_P) >= :P366_LIMITEPRODUTOS+1
                   or to_number(:P366_QTD_M) >= :P366_LIMITEPRODUTOS+1
                   or to_number(:P366_QTD_G) >= :P366_LIMITEPRODUTOS+1
                   or to_number(:P366_QTD_GG) >= :P366_LIMITEPRODUTOS+1
                   or to_number(:P366_QTD_EGG) >= :P366_LIMITEPRODUTOS+1
                   or to_number(:P366_QTD_EXGG) >= :P366_LIMITEPRODUTOS+1
                   or to_number(:P366_QTD_U) >= :P366_LIMITEPRODUTOS+1
                ```
        }
        error {
            errorMessage: "Limite de 10(dez) peças excedido! Verifique a quantidade informada. "
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'CREATE'
                  and :P366_IDFUNCIONARIO != 2393
                  and not exists ( select 1
                                   from funcionarios f
                                   where f.idfuncionario = :P366_IDFUNCIONARIO 
                                     and f.idpessoa      = ( select idpessoa 
                                                             from gerentes g
                                                             where g.idfilial = :P0_IDFILIAL ) )
                ```
        }
    )

    validation valida-quantos-produtos-incluídos (
        name: Valida quantos produtos incluídos
        execution {
            sequence: 130
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where ( select sum(nvl(it.qtd_pp,0)+nvl(it.qtd_p,0)+nvl(it.qtd_m,0)+nvl(it.qtd_g,0)+nvl(it.qtd_gg,0)+nvl(it.qtd_egg,0)+nvl(it.qtd_exgg,0)+nvl(it.qtd_u,0))
                        from itensvendadireta it
                        where exists ( select 1
                                       from vendasdiretas v
                                       where v.idvendadireta = it.idvendadireta 
                                         and v.idfuncionario = :P366_IDFUNCIONARIO
                                         and to_char(v.data,'MM/RRRR') = to_char(sysdate,'MM/RRRR') ) ) + ( nvl(:P366_QTD_PP,0)
                                                                                                + nvl(:P366_QTD_P,0)
                                                                                                + nvl(:P366_QTD_M,0)
                                                                                                + nvl(:P366_QTD_G,0)
                                                                                                + nvl(:P366_QTD_GG,0)
                                                                                                + nvl(:P366_QTD_EGG,0)
                                                                                                + nvl(:P366_QTD_EXGG,0)
                                                                                                + nvl(:P366_QTD_U,0) )  > :P366_LIMITEPRODUTOS
                  and :P366_IDFUNCIONARIO != 2393
                ```
        }
        error {
            errorMessage: Limite de 10(dez) peças por mês atingido! Aguarde próximo mês para realizar a venda direta.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'CREATE'
                  and not exists ( select 1
                                   from funcionarios f
                                   where f.idfuncionario = :P366_IDFUNCIONARIO 
                                     and f.idpessoa      = ( select idpessoa 
                                                             from gerentes g
                                                             where g.idfilial = :P0_IDFILIAL ) )
                ```
        }
    )

    process atualiza-venda-direta (
        name: Atualiza Venda DIreta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidsituacao number;
                  vvalorvenda number;
                  --
                begin 
                  --
                  select idsituacao
                  into vidsituacao
                  from vendasdiretas v
                  where v.idvendadireta = :P366_IDVENDADIRETA;
                  --
                  if vidsituacao = 1 then
                    --
                    update vendasdiretas v
                    set v.idsituacao = 2
                    where v.idvendadireta = :P366_IDVENDADIRETA;
                    --
                  end if;
                  --
                  select Sum(it.qtdtotal*it.valoracobrar)
                  into vvalorvenda
                  from itensvendadireta it
                  where it.idvendadireta = :P366_IDVENDADIRETA;
                  --
                  update vendasdiretas v
                  set v.valortotal = vvalorvenda
                  where v.idvendadireta = :P366_IDVENDADIRETA;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 794684889159165607
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process busca-idestoquefil (
        name: Busca IDESTOQUEFIL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                select idestoquefilial
                     , comissao
                into :P366_IDESTOQUEFIL
                   , :P366_COMISSAO
                from estoquefilial e
                where ( e.idproduto = :P366_IDPRODUTO
                   or e.idproduto = :P366_IDPRODUTO2 )
                 and e.idfilial = :P0_IDFILIAL;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 794684427066165607
        }
    )

