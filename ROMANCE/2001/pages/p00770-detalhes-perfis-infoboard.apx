page 770 (
    name: Detalhes Perfis Infoboard
    alias: DETALHES-PERFIS-INFOBOARD
    title: Detalhes Perfis Infoboard
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-700x
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region detalhes-perfil-infoboard (
        name: Detalhes Perfil Infoboard
        type: form
        source {
            location: localDatabase
            tableName: PERFISINFOBOARD
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P770_IDMODINFOBOARD (
        type: selectList
        label {
            label: Módulo Infoboard
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomeinfoboard  d
                     , idmodinfoboard r
                  from modulosinfoboard
                 order by 1
                
                ```
        }
        layout {
            sequence: 20
            region: @detalhes-perfil-infoboard
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P770_IDPERFILINFOBOARD (
        type: hidden
        layout {
            sequence: 10
            region: @detalhes-perfil-infoboard
            slot: regionBody
        }
        source {
            formRegion: @detalhes-perfil-infoboard
            column: IDPERFILINFOBOARD
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: SEQ_IDPERFILINFOBOARD
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P770_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @detalhes-perfil-infoboard
            slot: regionBody
        }
    )

    pageItem P770_NOMEPERFIL (
        type: textField
        label {
            label: Nome Perfil
            alignment: left
        }
        layout {
            sequence: 30
            region: @detalhes-perfil-infoboard
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @detalhes-perfil-infoboard
            column: NOMEPERFIL
            dataType: varchar2
        }
    )

    pageItem P770_OPERACAODML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @detalhes-perfil-infoboard
            slot: regionBody
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar/Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P770_IDPERFILINFOBOARD
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P770_IDPERFILINFOBOARD
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar alterações
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P770_IDPERFILINFOBOARD
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-nome (
        name: Valida Nome
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                  from perfisinfoboard
                 where lower(nomeperfil) = lower(:P770_NOMEPERFIL)
                   and idmodinfoboard = :P770_IDMODINFOBOARD;
                ```
        }
        error {
            errorMessage: Nome de perfil já existe. Escolha outro nome!
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,CREATE
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 377274908525351783
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-form-modulos-infoboard (
        name: Initialize form Form Modulos Infoboard
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  
                  pck_infoboard.prc_perfisinfoboard(:P770_IDPERFILINFOBOARD,
                                                     :P770_IDMODINFOBOARD,
                                                     :P770_NOMEPERFIL,
                                                     :P770_MD5,
                                                     'S');
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 377274169060351782
        }
    )

    process process-form-perfil-infoboard (
        name: Process form perfil Infoboard
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  v_dml varchar2(1);
                  --
                begin
                  --
                  --
                  if v('REQUEST') = 'CREATE' then
                    v_dml := 'I';
                  elsif  v('REQUEST') = 'SAVE' then
                    v_dml := 'U';
                  else
                    v_dml := 'D';
                  end if;
                  --
                 -- raise_application_error(-20001, v_dml );
                
                  pck_infoboard.prc_perfisinfoboard(:P770_IDPERFILINFOBOARD,
                                                    :P770_IDMODINFOBOARD,
                                                    :P770_NOMEPERFIL,
                                                    :P770_MD5,
                                                    v_dml);
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 377274583412351783
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE, DELETE, SAVE
        }
    )

)

