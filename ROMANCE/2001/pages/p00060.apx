page 60 (
    name: Mapa do Sistema
    title: Mapa do Sistema
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region mapa-do-sistema (
        name: Mapa do Sistema
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idaplicacao
                      ,descricao
                      ,hierarquia
                      ,decode( hierarquia , null , '<b>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao) ||'</b>'
                                                 , DECODE(LEVEL , 2 , '<i>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>'
                                                                , 3 , '<i>'||LPAD('-> ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>') ) nivel_hierarquico
                      , nvl( ( select 'Já possui acesso!'
                               from acessos b 
                                where b.idaplicacao = a.idaplicacao 
                                  and b.usuario = v('APP_USER')),'<font color="red">Não possui acesso!</font>') possuiacesso
                      , '<a href="f?p=&APP_ID.:'||pagina||':&SESSION.::NO:::" ><img src="#IMAGE_PREFIX#e2.gif" alt="" /></a>' url
                  from ( select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                              , a.pagina
                              , null
                         from aplicacoes a 
                         where a.idsistema = 2001
                           and a.idaplicacao != 2300
                           and a.hierarquia != 2300
                         union
                         select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                              , a.pagina
                              , null
                         from aplicacoes a 
                         where a.idsistema = 2001
                           and a.hierarquia is null
                           and a.idaplicacao != 2300
                         ORDER BY IDAPLICACAO
                         ) a
                 start with hierarquia is null
                connect by prior idaplicacao = hierarquia
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 85543363217670606
        }

