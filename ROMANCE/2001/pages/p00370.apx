page 370 (
    name: Abre arquivo
    title: Abre arquivo
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
        browserCache: false
    }
    advanced {
        reloadOnSubmit: always
    }

    region abrir-arquivo (
        name: Abrir Arquivo
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P370_NOMEARQUIVO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @abrir-arquivo
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    process arquivo (
        name: Arquivo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  varquivo varchar2(100) := :P370_NOMEARQUIVO;
                begin
                  -- Call the procedure
                  pck_anexos.prc_abreaqruivo_web(pnomearquivo => varquivo);
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1408949667963225698
        }
    )

)

