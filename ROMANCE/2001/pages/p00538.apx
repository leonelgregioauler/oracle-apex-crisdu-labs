page 538 (
    name: Indicadores de Questionamentos
    title: Indicadores de Questionamentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    htmlHeader {
        htmlHeader:
            ```html
            <style>
            
              .contadores {
                color: black;
                font-weight: bold;  
              }
                
                .t-BadgeList-label {
                    color: cadetblue !important;
                    font-weight: bold !important; 
                }
                
                .t-BadgeList--circular .t-BadgeList-value {
                    background-color: cadetblue !important;
                }
            
            </style>
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-das-empresas (
        name: Acompanhamento das Empresas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , nvl(tot.qtd,0) "Total"
                     , nvl(resp.qtd,0) "Total Respondido"
                     , nvl(pck_util.fnc_tempodecorrido(resp.tempo,'H'),0) "Tempo Médio Resposta"
                     , nvl(nresp.qtd,0) "Não Respondido"
                from vw_filiais f
                   , ( select idfilial
                            , count(1) qtd
                       from questionamentoscontroladoria q
                       where trunc(q.datainclusao) between to_date(:P538_DATAINICIO) and to_date(:P538_DATAFIM)
                       group by q.idfilial ) tot
                   , ( select idfilial
                            , count(1) qtd
                            , avg(q.dataleitura-q.datainclusao) tempo
                       from questionamentoscontroladoria q
                       where q.confirmacaoleitura = 'S' 
                         and trunc(q.datainclusao) between to_date(:P538_DATAINICIO) and to_date(:P538_DATAFIM)
                         and q.datainclusao is not null
                       group by q.idfilial ) resp
                   , ( select idfilial
                            , count(1) qtd
                       from questionamentoscontroladoria q
                       where q.confirmacaoleitura = 'N'
                         and trunc(q.datainclusao) between to_date(:P538_DATAINICIO) and to_date(:P538_DATAFIM)
                       group by idfilial ) nresp
                where f.idfilial = tot.idfilial(+)
                  and f.idfilial = resp.idfilial(+)
                  and f.idfilial = nresp.idfilial(+)
                  and f.tipofilial = 'D'
                  and f.ativo = 'S'
                ```
            pageItemsToSubmit: [
                P538_DATAINICIO
                P538_DATAFIM
            ]
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 11878279226365326
        }

        column NOME (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column "Não Respondido" (
