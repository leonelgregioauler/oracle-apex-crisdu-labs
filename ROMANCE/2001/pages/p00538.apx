    region conferidos-no-mês (
        name: Conferidos no Mês
        type: plugin/flotPieChart
        source {
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(q.idfilial) empresa
                     , count(distinct(q.idquestionamento)) qtd
                from questionamentoscontroladoria q
                where extract ( month from q.datainclusao ) = to_char(sysdate,'MM')
                  and extract ( year from q.datainclusao ) = to_char(sysdate,'RRRR')  
                  and q.conferido = 'S'
                group by q.idfilial
                ```
        }
        layout {
            sequence: 60
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: QTD
            displayOptions: [
                tooltip
                label
                value
            ]
            colorScheme: modern2
        }
    )

