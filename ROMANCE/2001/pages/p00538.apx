    dynamicAction escolhe-data (
        name: Escolhe Data
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P538_DATAINICIO
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P538_DATAINICIO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @acompanhamento-das-empresas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction muda-data-fim (
        name: Muda Data Fim
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P538_DATAFIM
        }
