    region ultimos-dias-conferidos (
        name: Ultimos Dias Conferidos
        type: chart
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        performance {
            lazyLoading: true
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series dados (
            name: Dados
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(tt.data,'dd/Mon (Dy)') data, tt.usuarioconferencia dado , nvl(dr.qtd,0) qtde
                    from vw_questconferidos_rmc dr
                       , ( select distinct q.usuarioconferencia
                                , u7.data data
                           from vw_questconferidos_rmc q
                              , beeweb.vw_ultimos_7_dias u7
                           where u7.data >= trunc(sysdate-8)
                             and to_char(u7.data,'d') <> '1' ) tt
                    where dr.usuarioconferencia(+) = tt.usuarioconferencia
                      and dr.dataconferencia(+)    = tt.data 
                    order by tt.data
                    ```
            }
            columnMapping {
                seriesName: DADO
                label: DATA
                value: QTDE
            }
        )

        axis x (
            name: x
            title: Data
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Quantidade
            value {
                format: decimal
            }
            majorTicks {
                show: auto
            }
            minorTicks {
                show: false
            }
        )

