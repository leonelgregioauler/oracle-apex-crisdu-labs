    region questionamentos-gerais (
        name: Questionamentos Gerais
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select count(1)
                         from questionamentoscontroladoria q ) total
                     , ( select count(1) respondidos
                         from questionamentoscontroladoria q
                         where q.confirmacaoleitura = 'S' ) respondidos
                     , ( select count(1) naorespondidos
                         from questionamentoscontroladoria q
                         where q.confirmacaoleitura = 'N' ) naorespondidos
                from dual;
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
