                }
                layout {
                    sequence: 2
                }
            )

        )

    )

    pageItem P276_IDFECHAMENTO (
        type: selectList
        label {
            label: Semana Fechamento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.semana||' - '||decode(f.concluido,'S','Fechado','N','Aberto') display_value
                  , f.idfechamento return_value
                from fechamentossemanais f
                where f.idfilial = :P0_IDFILIAL
                order by f.idfechamento desc
                ```
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P276_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||r.idrepresentante||')' || decode(r.ativo,'S','','Inativo') display_value
                     , r.idrepresentante
                from representantes r
                where idgerente in ( select idgerente
                                     from gerentes
                                     where idfilial = :P0_IDFILIAL)
                order by 1
                ```
            nullDisplayValue: - Todos -
            nullReturnValue: -1
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: redireciona
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 276
                items: {
                    P276_IDFECHAMENTO: &P276_IDFECHAMENTO.
                    P276_IDREPRESENTANTE: &P276_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
    )

)

