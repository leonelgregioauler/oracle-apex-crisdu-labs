            layout {
                sequence: 34
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column Valor (
            type: plainText
            heading {
                heading: Valor Produto
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 47221601 (
            visibility: alternativeDefault
            name: Agrupado por Distribuidor
            view {
                groupBy: true
                default: groupBy
                rowsPerPage: 100000
            }

            displayColumn DISTRIBUIDOR (
                sequence: 6
            )

            displayColumn "Produto" (
                sequence: 1
            )

            displayColumn "Qtd" (
                sequence: 2
            )

            displayColumn "Semana Devolução" (
                sequence: 5
            )

            displayColumn VALORPAGO (
                sequence: 4
            )

            displayColumn VALORSEMCOMISSAO (
                sequence: 7
            )

            displayColumn "Valor" (
                sequence: 3
            )

            aggregate (
                column: "Qtd"
            )

            aggregate (
                column: VALORPAGO
            )

            controlBreak (
                column: DISTRIBUIDOR
                layout {
                    sequence: 1
                }
            )

            groupByColumn (
                column: DISTRIBUIDOR
                layout {
                    sequence: 1
                }
            )

            groupByAggregate (
                heading: Quantidade
                aggregate {
                    column: "Qtd"
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 1
                }
            )

            groupByAggregate (
                heading: Valor total Pago
                aggregate {
                    column: VALORPAGO
                    displaySum: true
                }
                appearance {
                    formatMask: FML999G999G999G999G990D00
                }
                layout {
                    sequence: 2
                }
            )

            groupByAggregate (
                heading: Valor pago Sem Desconto
                aggregate {
                    column: VALORSEMCOMISSAO
                    displaySum: true
                }
                appearance {
                    formatMask: FML999G999G999G999G990D00
                }
                layout {
                    sequence: 3
                }
            )

        )

        savedReport 759540 (
