page 276 (
    name: Resgates
    title: Resgates Incluídos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region resgates-incluídos (
        name: Resgates Incluídos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select p.codigosisdist
                         from produtos p
                         where p.idproduto = i.idproduto ) ||' - '||pck_romance.fnc_nomeproduto(i.idproduto) "Produto"
                  , ( nvl(i.qtd_pp,0)
                    + nvl(i.qtd_p,0)
                    + nvl(i.qtd_m,0)
                    + nvl(i.qtd_g,0)
                    + nvl(i.qtd_gg,0)
                    + nvl(i.qtd_egg,0)
                    + nvl(i.qtd_exgg,0)
                    + nvl(i.qtd_u,0) ) "Qtd"
                  , i.valorproduto "Valor"
                  , d.semana "Semana Devolução"
                  , pck_romance.fnc_nomerepresentante(d.idrepresentante) Distribuidor
                  , case
                     when f.idgrupo != 5 then
                         ((( nvl(i.qtd_pp,0)
                              + nvl(i.qtd_p,0)
                              + nvl(i.qtd_m,0)
                              + nvl(i.qtd_g,0)
                              + nvl(i.qtd_gg,0)
                              + nvl(i.qtd_egg,0)
                              + nvl(i.qtd_exgg,0)
                              + nvl(i.qtd_u,0) ) * i.valorproduto )*decode(i.comissao,'S',0.6,1)) 
                      -  ((( nvl(i.qtd_pp,0)
                                + nvl(i.qtd_p,0)
                                + nvl(i.qtd_m,0)
                                + nvl(i.qtd_g,0)
                                + nvl(i.qtd_gg,0)
                                + nvl(i.qtd_egg,0)
                                + nvl(i.qtd_exgg,0)
                                + nvl(i.qtd_u,0) ) * i.valorproduto )*decode(i.comissao,'S',0.6,1))*( select (c.percpromotor/100)
                                                                                                      from fechamentorepresentantes fr
                                                                                                         , comissoesfiliais c
                                                                                                      where fr.idfechamentorepres = i.idfechamentoreprespago
                                                                                                        and c.idcomissaofilial    = fr.idcomissao )
                     when f.idgrupo = 5 then
                         ((( nvl(i.qtd_pp,0)
                              + nvl(i.qtd_p,0)
                              + nvl(i.qtd_m,0)
                              + nvl(i.qtd_g,0)
                              + nvl(i.qtd_gg,0)
                              + nvl(i.qtd_egg,0)
                              + nvl(i.qtd_exgg,0)
                              + nvl(i.qtd_u,0) ) * i.valorproduto )*decode(i.comissao,'S',0.7,1))
                      - ((( nvl(i.qtd_pp,0)
                                + nvl(i.qtd_p,0)
                                + nvl(i.qtd_m,0)
                                + nvl(i.qtd_g,0)
                                + nvl(i.qtd_gg,0)
                                + nvl(i.qtd_egg,0)
                                + nvl(i.qtd_exgg,0)
                                + nvl(i.qtd_u,0) ) * i.valorproduto )*decode(i.comissao,'S',0.7,1))*( select (c.percpromotor/100)
                                                                                                      from fechamentorepresentantes fr
                                                                                                         , comissoesfiliais c
                                                                                                      where fr.idfechamentorepres = i.idfechamentoreprespago
                                                                                                        and c.idcomissaofilial    = fr.idcomissao )
                    end valorpago
                  , case
                     when f.idgrupo != 5 then
                         ((( nvl(i.qtd_pp,0)
                              + nvl(i.qtd_p,0)
                              + nvl(i.qtd_m,0)
                              + nvl(i.qtd_g,0)
                              + nvl(i.qtd_gg,0)
                              + nvl(i.qtd_egg,0)
                              + nvl(i.qtd_exgg,0)
                              + nvl(i.qtd_u,0) ) * i.valorproduto )*decode(i.comissao,'S',0.6,1)) 
                     when f.idgrupo = 5 then
                         ((( nvl(i.qtd_pp,0)
                              + nvl(i.qtd_p,0)
                              + nvl(i.qtd_m,0)
                              + nvl(i.qtd_g,0)
                              + nvl(i.qtd_gg,0)
                              + nvl(i.qtd_egg,0)
                              + nvl(i.qtd_exgg,0)
                              + nvl(i.qtd_u,0) ) * i.valorproduto )*decode(i.comissao,'S',0.7,1))
                    end valorsemcomissao
                from devolucoesrepresentantes d
                   , itensdevolucaorepres i
                   , vw_filiais f
                where d.iddevolucaorepres = i.iddevolucaorepres
                  and f.idfilial          = d.idfilial
                  and d.idfilial = :P0_IDFILIAL
                  and ( :P276_IDREPRESENTANTE = -1 or d.idrepresentante = :P276_IDREPRESENTANTE )
                  and i.idfechamentoreprespago in ( select f.idfechamentorepres      
                                                   from fechamentorepresentantes f
                                                   where f.idfechamento = :P276_IDFECHAMENTO 
                                                     and f.idrepresentante = d.idrepresentante )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resgate incluído encontrado!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 75947212462206291
        }

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 14
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column Produto (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
