page 385 (
    name: Consultoras
    title: Consultoras
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region consultoras (
        name: Consultoras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select initcap(nomepessoa)||' - '||cpf
                         from pessoas p
                         where p.idpessoa = v.idpessoa ) consultora
                     , r.datalogin
                     , ( select count(1)
                         from registrosloginminhasacola rr
                         where rr.idvendedora = r.idvendedora ) qtdlogin
                     , ( select max(rr.datalogin)
                         from registrosloginminhasacola rr
                         where rr.idvendedora = r.idvendedora ) ultimologin
                     , ( select count(1) qtd
                         from registroscompartilhafotos f
                         where f.idvendedora = r.idvendedora ) qtdcompartilhamento
                from registrosloginminhasacola r
                   , vendedoras                v
                where primeirologin     = 'S'
                  and v.idvendedora     = r.idvendedora
                  and v.idrepresentante = :P385_IDREPRESENTANTE
                order by 1
                ```
            pageItemsToSubmit: P385_IDREPRESENTANTE
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 2496787255356805922
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column DATALOGIN (
            type: plainText
            heading {
                heading: Primeiro Login
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column QTDCOMPARTILHAMENTO (
            type: plainText
            heading {
                heading: Qtd Compartilhada
                alignment: center
            }
            layout {
                sequence: 14
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column QTDLOGIN (
            type: plainText
            heading {
                heading: Qtd Login
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column ULTIMOLOGIN (
            type: plainText
            heading {
                heading: Último Login
            }
            layout {
                sequence: 4
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 24967960 (
            visibility: primaryDefault
            view {
                rowsPerPage: 1000
            }

            displayColumn CONSULTORA (
                sequence: 1
            )

            displayColumn DATALOGIN (
                sequence: 2
            )

            displayColumn QTDCOMPARTILHAMENTO (
                sequence: 5
            )

            displayColumn QTDLOGIN (
                sequence: 3
            )

            displayColumn ULTIMOLOGIN (
                sequence: 4
            )

        )

    )

    pageItem P385_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @consultoras
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

