page 573 (
    name: Assinaturas Eletrônicas
    title: Assinaturas Eletrônicas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function aprovaassinatura(pid){ 
            
              document.getElementById('P573_ID').value = pid;
                
              var answer = confirm("Aprova a Assinatura Eletronica?")
              if (answer)
                {
                  apex.submit('APROVA_ASSINATURA');
                }
            }
            
            function voltarassinatura(pid){ 
            
              document.getElementById('P573_ID').value = pid;
                
              var answer = confirm("Deseja Voltar a Situação da Assinatura Eletronica?")
              if (answer)
                {
                  apex.submit('VOLTAR_ASSINATURA');
                }
            }
            
            function reprovaassinatura(pid){ 
            
              document.getElementById('P573_ID').value = pid;
              openModal('REPROVAR');
              
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region assinaturas-realizadas (
        name: Assinaturas Realizadas
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  v_sql clob;
                  --
                begin
                  --
                  v_sql := q'~
                    select a.datarealizada dataclassificado
                         , a.vendedora nomepessoa
                         , a.cpf
                         , a.representante
                         , a.link
                         , case
                             when a.situacao = 'A' then
                               '<font color="green"><b>Aprovada!</b></font>'
                             when a.situacao = 'P' then
                               '<a href=javascript:aprovaassinatura('||a.idassinaturaeletronica||');><img src="#APP_IMAGES#ok.png" alt=""/></a>' 
                             else
                               '-'
                           end aprovarassinatura
                         , case
                             when a.situacao = 'R' then
                               '<font color="red"><b>Reprovada</b></font>'||' - '||nvl(a.motivoreprovacao,'Motivo não informado')
                             when a.situacao = 'P' then
                               '<a href=javascript:reprovaassinatura('||a.idassinaturaeletronica||');><img src="#APP_IMAGES#excluir.png" alt=""/></a>' 
                             else
                               '-'
                           end reprovarassinatura
                         , case
                             when a.situacao  != 'P' then
                               '<a href=javascript:voltarassinatura('||a.idassinaturaeletronica||');><img src="#APP_IMAGES#VOLTAR.png" alt=""/></a>' 
                             else
                               '-'
                           end voltarsituacao
                         , identificacao
                         , a.desctiponota tipo
                         , decode (a.tipoassinatura, 'P', 'Titular', 'T', 'Terceiro') Tipo_de_Assinatura
                         , case
                           when (select count(1)
                                   from roman.notasvendas nv
                                  where a.idvendedora = nv.idvendedora) = '1' then 'Sim'
                            else 'Não'
                           end Abertura
                         , a.descorigem origem
                         , ( select initcap(p.nomepessoa)
                             from usuarios u
                                , pessoas p
                             where p.idpessoa = u.idpessoa
                               and u.idusuario = a.idusuarioavaliacao ) analisado_por
                         , decode(status_avaliacao,'F','Sim','V','Nao') foto_preta
                         , a.nome_terceiro nome_terceiro
                         , a.cpf_terceiro cpf_terceiro
                         , case
                             when zs.idintegracaozapsign is null then
                               '-'
                             when zs.decisao = 'aprovado_automaticamente' then
                               '<span style="background:#EAF3DE;color:#3B6D11;padding:2px 8px;border-radius:8px;white-space:nowrap">'||zs.descaplicada||'</span>'
                             when zs.decisao = 'rejeitado_automaticamente' then
                               '<span style="background:#FCEBEB;color:#A32D2D;padding:2px 8px;border-radius:8px;white-space:nowrap">'||zs.descaplicada||'</span>'
                             when zs.decisao = 'revisao_manual' then
                               '<span style="background:#FAEEDA;color:#854F0B;padding:2px 8px;border-radius:8px;white-space:nowrap">'||zs.descaplicada||'</span>'
                             else
                               zs.descaplicada
                           end agente
                         , zs.score            agente_score
                         , zs.reasonprioridade agente_prioridade
                         , zs.reasonlabel      agente_motivo
                         , zs.sinaisfalhos     agente_sinais
                         , zs.evidencias       agente_evidencias
                    from vw_assinaturas_eletronicas a
                    left join roman.vw_integracao_zapsign zs
                           on zs.idassinaturaeletronica = a.idassinaturaeletronica
                    where a.datarealizada between to_date(:P573_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') 
                                              and to_date(:P573_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                      and a.idfilial         = :P573_IDFILIAL 
                      and a.status           = 'C' ~';
                
                  if :P573_IDREPRESENTANTE is not null then 
                    v_sql := v_sql || chr(10) || 
                            ' and a.idrepresentante = :P573_IDREPRESENTANTE ' ;
                  end if;
                  --
                  if :P573_SITUACAO = 'A' then 
                    v_sql := v_sql || chr(10) || 
                            ' and a.situacao = ''A''';
                  end if;
                  --
                  if :P573_SITUACAO = 'R' then 
                    v_sql := v_sql || chr(10) || 
                             ' and a.situacao = ''R''';
                  end if;
                  --
                  if :P573_ANALISE = 'S' then 
                    v_sql := v_sql || chr(10) || 
                             ' and a.situacao = ''P''';
                  end if;
                  --
                  if :P573_ANALISE = 'N' then 
                    v_sql := v_sql || chr(10) || 
                             ' and a.situacao != ''P''';
                  end if;
                  --
                  v_sql := v_sql || chr(10) ||
                           ' order by a.datarealizada desc ';
                  --
                  return v_sql;
                  --
                end;
                ```
            pageItemsToSubmit: [
                P573_DATAINICIO
                P573_DATAFIM
                P573_IDREPRESENTANTE
                P573_SITUACAO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
