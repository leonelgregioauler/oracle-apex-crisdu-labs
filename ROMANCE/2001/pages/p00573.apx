    region notas-realizadas-no-dia (
        name: Notas Realizadas no dia
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Notas Feitas no dia' situacao
                     , count(1) qtd
                from notasvendas n
                where n.datanota between trunc(sysdate) and sysdate
                  and n.idfilial not in (
                                          select idfilial
                                          from vw_filiais
                                          where idgrupo = 5)
                  and n.idfilial != 1083               
                  and exists ( select 1 
                               from parametrosrepresentantes r
                               where r.idrepresentante = n.idrepresentante
                                 and r.parametro = 'UTILIZAASSINATURAELETRONICA'
                                 AND R.Valor = 'Z')
                ```
        }
        layout {
            sequence: 10
            parentRegion: @placar-do-momento
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            labelColumn: SITUACAO
            valueColumn: QTD
        }
    )

