    region assinaturas-recebidas-no-dia (
        name: Assinaturas Recebidas no dia
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Assinaturas Recebidas no dia' situacao
                     , count(1) qtd
                from assinaturaseletronicas a
                where a.datarealizada between trunc(sysdate) and sysdate
                  and a.status = 'C'
                  and idnotavenda is not null   
                ```
        }
        layout {
            sequence: 20
            parentRegion: @placar-do-momento
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            labelColumn: SITUACAO
            valueColumn: QTD
        }
    )

