    pageItem P573_IDFILIAL (
        type: selectList
        label {
            label: <b>Empresa</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                  from vw_filiais f
                 where f.ativo = 'S'
                   and exists ( select 1
                                  from parametrosrepresentantes pr
                                     , representantes r
                                 where pr.parametro = 'UTILIZAASSINATURAELETRONICA'
                                   and pr.valor     = 'Z'
                                   and r.idrepresentante = pr.idrepresentante
                                   and r.idfilial = f.idfilial )
                
                union
                
                select f.nome
                     , f.idfilial
                  from vw_filiais f
                 where idfilial = 1217
                
                union
                
                 select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.idfilial in  (1275,1246)
                  and ( pck_util.fnc_verificaacesso(2844,v('APP_USER')) = 'S'
                     or v('APP_USER') = 'LUCASRAMOS' )
                order by 1
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P573_IDMOTIVO (
        type: selectList
        label {
            label: Motivo Reprovação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select motivo
                     , idmotivoreprovacao
                from motivosreprovacoes 
                order by 1
                ```
            nullDisplayValue: - Selecione o Motivo -
        }
        layout {
            sequence: 10
            region: @reprovar-assinatura
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P573_IDREPRESENTANTE (
        type: selectList
        label {
            label: <b>Distribuidor</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) d
                     , idrepresentante r
                from representantes r
                where r.ativo = 'S'
                  and r.idfilial = :P573_IDFILIAL 
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P573_IDFILIAL
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P573_SITUACAO (
        type: radioGroup
        label {
            label: <b>Situação</b>
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Ambos;X,Aprovado;A,Reprovado;R
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        default {
            type: static
            staticValue: X
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reprovar (
        buttonName: REPROVAR
        label: "Reprovar "
        layout {
            sequence: 10
            region: @reprovar-assinatura
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-motivo-reprovação (
        name: Valida Motivo Reprovação
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P573_IDMOTIVO
        }
        error {
            errorMessage: Por favor, informe um motivo para reprovação!
        }
        serverSideCondition {
            type: request=Value
            value: REPROVAR
        }
    )

    process informa-valores (
        name: Informa Valores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                  --
                  if :P573_DATAINICIO is null then
                    --
                    select trunc(SYSDATE,'MM')
                    into :P573_DATAINICIO
                    from dual;
                    --
                  end if;
                  --
                  if :P573_DATAFIM is null then
                    --
                    select trunc(sysdate) 
                    into :P573_DATAFIM
                    from dual;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1039143564997782372
        }
    )

    process realiza-procedimento (
        name: Realiza procedimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vid number := :P573_ID;
                  --
                  vsituacao  varchar2(1);
                  vidmotivo  number := null;
                  vidusuario number;
                  --
                begin 
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  if v('REQUEST') = 'APROVA_ASSINATURA' then
                     vsituacao := 'A';
                  elsif v('REQUEST') = 'REPROVAR' then
                     vsituacao := 'R';
                     vidmotivo := :P573_IDMOTIVO;
                  elsif v('REQUEST') = 'VOLTAR_ASSINATURA' then
                     vsituacao := 'P';
                  end if;
                  --
                     pck_cadastros_rmc.prc_atualizasituacaoassinatura( pidassinaturaeletronica => vid,
                                                                    psituacao               => vsituacao,
                                                                    pidmotivo               => vidmotivo,
                                                                    pidusuario              => vidusuario);
                  --
                  if vsituacao = 'R' and vidmotivo is not null then
                    pck_controle_rmc.prc_geranotificacao_assinatura(vid);
                  end if;
                  --
                  commit;
                  --
                  :P573_IDMOTIVO := '';
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Assinatura atualizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1039143938570782373
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('APROVA_ASSINATURA','REPROVAR','VOLTAR_ASSINATURA')
        }
    )

    branch (
        name: Go To Page 573
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 573
                items: {
                    P573_IDREPRESENTANTE: &P573_IDREPRESENTANTE.
                    P573_ANALISE: &P573_ANALISE.
                    P573_SITUACAO: &P573_SITUACAO.
                    P573_IDFILIAL: &P573_IDFILIAL.
                    P573_DATAINICIO: &P573_DATAINICIO.
                    P573_DATAFIM: &P573_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

