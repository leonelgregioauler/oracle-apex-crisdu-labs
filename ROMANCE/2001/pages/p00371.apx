page 371 (
    name: Cadastrar Consulta Documento
    title: Cadastrar Consulta Documento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region cadastrar-consulta-de-documento (
        name: Cadastrar Consulta de Documento
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region telefones-consulta-documento (
        name: Telefones Consulta Documento
        type: tabform
        source {
            sqlQuery:
                ```sql
                select t.IDTELEFONEHISTORICO
                     , t.IDHISTORICOCONSULTADOC
                     , t.DATA
                     , t.USUARIO
                     , t.TELEFONE
                     , t.OBSERVACAO
                from telefoneshistoricosconsultas t
                where t.IDHISTORICOCONSULTADOC = :P371_IDHISTORICOCONSULTADOC
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P371_IDHISTORICOCONSULTADOC
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CHECK$01 (
            reportColumnQueryId: 7
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
        )

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 7
            }
            default {
                type: plsqlExpression
                plsqlExpression: sysdate
            }
        )

        column IDHISTORICOCONSULTADOC (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: item
                item: P371_IDHISTORICOCONSULTADOC
            }
            advanced {
                customAttributes: readonly
            }
        )

        column IDTELEFONEHISTORICO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDTELEFONEHISTORICO
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 6
            derivedColumn: N
            type: textField
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 6
            }
            appearance {
                width: 50
            }
        )

        column TELEFONE (
            reportColumnQueryId: 5
            derivedColumn: N
            type: textField
            heading {
                heading: Telefone
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 20
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
            default {
                type: plsqlExpression
                plsqlExpression: v('APP_USER')
            }
            advanced {
                customAttributes: readonly
            }
        )

    )

