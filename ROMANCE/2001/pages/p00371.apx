    pageItem P371_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) d
                     , idrepresentante r
                from representantes r
                where r.ativo = 'S'
                  and r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = nvl(:P371_IDFILIAL,:P0_IDFILIAL) )
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P371_IDFILIAL
        }
        layout {
            sequence: 80
            region: @cadastrar-consulta-de-documento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

