    pageItem P371_NROCONSULTASPC (
        type: textField
        label {
            label: Nro Consulta SPC
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 70
            region: @cadastrar-consulta-de-documento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vconsulta varchar2(4000);
                begin
                  --
                  select protocolo
                  into vconsulta
                  from vw_consultaspc_rmc r
                  where --r.cpf = replace(replace(:P371_DOCUMENTO,'.',''),'-','');
                  replace(replace(:P371_DOCUMENTO,'.',''),'-','') = COALESCE(r.cpf,r.runrut,r.documentoestrangeiro);
                  --
                  return vconsulta;
                  --
                exception 
                  when others then
                    return null;
                end;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vconsulta varchar2(4000);
                begin
                  --
                  select protocolo
                  into vconsulta
                  from vw_consultaspc_rmc r
                  where --r.cpf = replace(replace(:P371_DOCUMENTO,'.',''),'-','');
                  replace(replace(:P371_DOCUMENTO,'.',''),'-','') = coalesce(r.cpf,r.runrut,r.documentoestrangeiro);
                  --
                  return vconsulta;
                  --
                exception 
                  when others then
                    return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P371_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 150
            region: @cadastrar-consulta-de-documento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
            height: 5
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vmensagem varchar2(500);
                begin
                  --
                  if :P371_IDHISTORICOCONSULTADOC is null then
                    --
                    select case 
                             when c.restricao = 'S' and spc_quantidade > 4 then
                               'Reprovado. '||c.nome
                             when nvl(spc_valortotal,0) = 0 and spc_quantidade = 0 then
                               'Aprovado. '||c.nome
                             when c.restricao = 'S' and spc_valortotal > 1500 and spc_quantidade > 4 then
                               'Reprovado. '||c.nome
                             when c.restricao = 'S' 
                               and spc_valortotal <= 1500 
                                 and spc_quantidade = 4 
                                   and exists ( select 1
                                                from restricoesconsultaspc r
                                                where r.idconsultaspc = c.idconsultaspc
                                                  and extract ( year from r.datainclusao ) = to_number(to_char(sysdate,'RRRR')) ) then
                               'Reprovado com Restrição. '||c.nome
                             when c.ccf >= 2 then
                               'Reprovado com Restrição. '||c.nome
                             when c.restricao = 'S' 
                               and spc_valortotal <= 1500 
                                 and spc_quantidade < 4 then
                               'Aprovado com Restrição. '||c.nome
                             when c.restricao = 'S' 
                               and spc_valortotal <= 1500 
                                 and spc_quantidade = 4 
                                   and not exists ( select 1
                                                    from restricoesconsultaspc r
                                                    where r.idconsultaspc = c.idconsultaspc
                                                      and extract ( year from r.datainclusao ) = to_number(to_char(sysdate,'RRRR')) ) then
                               'Aprovado com Restrição. '||c.nome
                             when c.restricao = 'N' then
                               'Aprovado. '||c.nome
                             when c.restricao = 'S' and spc_valortotal > 1500 and spc_quantidade >= 3 then
                               'Reprovado. '||c.nome
                           end observacao
                    into vmensagem
                    from consultaspc c
                    where c.idconsultaspc = ( select max(cc.idconsultaspc)
                                              from consultaspc cc
                                              where coalesce(cc.cpf,cc.runrut,cc.documentoestrangeiro) = replace(replace(replace(:P371_DOCUMENTO,'.',''),'-',''),' ','') );
                    --
                  elsif :P371_IDHISTORICOCONSULTADOC is not null then
                    --
                    select observacao
                    into vmensagem
                    from historicosconsultasdoc h
                    where h.idhistoricoconsultadoc = :P371_IDHISTORICOCONSULTADOC;
                    --
                  end if;
                  --
                  return vmensagem;
                  --
                exception
                  when others then
                    return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

