    pageItem P371_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(u.idfilial) empresa
                     , u.idfilial 
                from usuariosfiliais u
                where u.usuario = v('APP_USER')
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @cadastrar-consulta-de-documento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  --
                  vidfilial number;
                  --
                begin
                  --
                  if :P371_IDHISTORICOCONSULTADOC is not null then
                    --
                    select h.idfilial
                    into vidfilial
                    from historicosconsultasdoc h
                    where h.idhistoricoconsultadoc = :P371_IDHISTORICOCONSULTADOC;
                    --
                  elsif :P371_IDHISTORICOCONSULTADOC is null then
                    --
                    vidfilial := :P0_IDFILIAL;
                    --
                  end if;
                  --
                  return vidfilial;
                  --
                end;
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.usuario = v('APP_USER')
                 and ug.idgrupoatendimento in ( 22,23,25,4,3,9,1,2,3,0 ) 
                ```
        }
        security {
            encryptSessionState: false
        }
    )

