    validation distribuidor-não-pode-ser-nulo (
        name: Distribuidor não pode ser nulo
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P371_IDREPRESENTANTE
        }
        error {
            errorMessage: Por favor, selecione um distribuidor(a).
        }
    )

    validation liberar-consulta (
        name: liberar consulta
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P371_LIBERADO
        }
        error {
            errorMessage: Por favor, selecione uma opção
        }
    )

    validation valida-inclusão-para-o-período-de-5-dias (
        name: Valida Inclusão para o período de 5 dias
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from historicosconsultasdoc h
                where h.documento = :P371_DOCUMENTO
                  and h.liberado = 'S'
                  and trunc(sysdate) - trunc(h.dataconsulta)  < 5
                ```
        }
        error {
            errorMessage: Já existe uma consulta válida para esse documento!
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation válida-nr-consulta (
        name: Válida Nr Consulta
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P371_NROCONSULTASPC
        }
        error {
            errorMessage: É necessário informar o número de consulta ao SPC
        }
        serverSideCondition {
            type: item=value
            item: P371_LIBERADO
            value: S
        }
    )

