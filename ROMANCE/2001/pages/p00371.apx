                  :P371_OBSERVACAO := NULL;
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3076218247397921103
        }
    )

    process processo-dml-em-historicos-consultas-doc (
        name: Processo DML em Historicos Consultas Doc
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'SUBMIT' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SAVE' then
                    voperacao_dml := 'U';
                  end if;
                  --
                  PCK_CADASTROS_RMC.PRC_HISTORICOSCONSULTASDOC( PIDHISTORICOCONSULTADOC => :P371_IDHISTORICOCONSULTADOC,
                                                                PDATACONSULTA => :P371_DATACONSULTA,
                                                                PDOCUMENTO => :P371_DOCUMENTO,
                                                                PLIBERADO => :P371_LIBERADO,
                                                                PUSADO => :P371_USADO,
                                                                PCODIGOLIBERACAO => :P371_CODIGOLIBERACAO,
                                                                PNROCONSULTASPC => :P371_NROCONSULTASPC,
                                                                PIDREPRESENTANTE => :P371_IDREPRESENTANTE,
                                                                PIDSEMANA => :P371_IDSEMANA,
                                                                PUSUARIO => :P371_USUARIO,
                                                                PIDPAIS => :P371_IDPAIS,
                                                                PIDFILIAL => :P371_IDFILIAL,
                                                                POBSERVACAO => :P371_OBSERVACAO,
                                                                PMD5 => :P371_MD5,
                                                                POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1408977750593451938
        }
    )

    branch (
        name: Go To Page 280
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 280
                items: {
                    P280_TIPO: &P371_TIPODOCUMENTO.
                    P280_DOCUMENTOESTRANGEIRO: &P371_DOCUMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P371_TIPODOCUMENTO = 'D'
                  and v('REQUEST') = 'VOLTAR'
                ```
        }
    )

