page 515 (
    name: Controle de Devoluções de Mercadorias
    title: Controle de Devoluções de Mercadorias
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region mercadorias-devolvidas (
        name: Mercadorias Devolvidas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist "Código"
                     , pck_romance.fnc_nomeprodutoestoque(it.idestoquefil) "Produto"
                     , it.valorvenda
                     , sum(it.qtddevolvida) "Devolvido"
                     , sum(it.qtddevolvida)*it.valorvenda "Total Devolvido"
                from itensnotavenda it
                   , estoquefilial e
                   , produtos p
                where it.idestoquefil = e.idestoquefilial
                  and p.idproduto     = e.idproduto
                  and it.qtddevolvida > 0
                  and exists ( select 1
                               from notasvendas nv
                               where nv.idnotavenda = it.idnotavenda
                                 and nv.idfilial    = :P0_IDFILIAL
                                 and ( :P515_TIPO_PESQUISA is null
                                     or ( :P515_TIPO_PESQUISA = 'S' and nv.idsemanacobranca = :P515_IDSEMANA )
                                     or ( :P515_TIPO_PESQUISA = 'P' and nv.idsemanacobranca between :P515_IDSEMANA_INI and :P515_IDSEMANA_FIM ) )
                                 and ( :P515_IDREPRESENTANTE is null or nv.idrepresentante = :P515_IDREPRESENTANTE )
                                 and nv.idsituacaonotavenda = 4 )
                group by p.codigosisdist
                       , it.idestoquefil
                       , it.valorvenda
                order by 2 
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum dado encontrado! Verifique os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 1576759513151910417
        }

        column Código (
            type: plainText
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column Devolvido (
            type: plainText
            heading {
                heading: Devolvido
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column Produto (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column "Total Devolvido" (
            type: plainText
            heading {
                heading: Total devolvido
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column VALORVENDA (
            type: plainText
            heading {
                heading: Valor de Venda
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 15795643 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn "Código" (
                sequence: 1
            )

            displayColumn "Devolvido" (
                sequence: 4
            )

            displayColumn "Produto" (
                sequence: 2
            )

            displayColumn "Total Devolvido" (
                sequence: 5
            )

            displayColumn VALORVENDA (
                sequence: 3
            )

            aggregate (
                column: "Total Devolvido"
            )

            aggregate (
                column: "Devolvido"
            )

        )

    )

    pageItem P515_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) d
                     , r.idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                  and r.ativo     = 'S'
                order by 1
                ```
            nullDisplayValue: - Mostrar Todos -
        }
        cascadingLov {
            parentItems: P0_IDFILIAL
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P515_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00')||'/'||ano) display_value
                     , idsemana return_value
                from roman.semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-1 and to_char(sysdate,'RRRR')
                order by s.ano
                       , s.semana
                       
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P515_IDSEMANA_FIM (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00')||'/'||ano) display_value
                     , idsemana return_value
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-1 and to_char(sysdate,'RRRR')
                order by s.ano
                       , s.semana
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P515_IDSEMANA_INI (
        type: selectList
        label {
            label: De
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00')||'/'||ano) display_value
                     , idsemana return_value
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-1 and to_char(sysdate,'RRRR')
                order by s.ano
                       , s.semana
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P515_TIPO_PESQUISA (
        type: radioGroup
        label {
            label: Pesquisar Por
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Semana;S,Período;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-periodo (
        name: Tipo Periodo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P515_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P515_TIPO_PESQUISA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P515_IDSEMANA_INI
                    P515_IDSEMANA_FIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P515_IDSEMANA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P515_IDSEMANA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P515_IDSEMANA_INI
                    P515_IDSEMANA_FIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 515
                items: {
                    P515_IDREPRESENTANTE: &P515_IDREPRESENTANTE.
                    P515_TIPO_PESQUISA: &P515_TIPO_PESQUISA.
                    P515_IDSEMANA: &P515_IDSEMANA.
                    P515_IDSEMANA_INI: &P515_IDSEMANA_INI.
                    P515_IDSEMANA_FIM: &P515_IDSEMANA_FIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

