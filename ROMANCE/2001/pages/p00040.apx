page 40 (
    name: Incluir Correção
    title: Incluir Correção
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fechajanela()
            {
              if (document.getElementById("P40_IDCORRECAONOTAVENDA").value != '')
                 {
                   window.opener.location.reload();
                   window.close();
                 }
            }
            ```
        executeWhenPageLoads: fechajanela();
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region incluir-correção (
        name: Incluir Correção
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P40_DATACORRECAO (
        type: hidden
        layout {
            sequence: 20
            region: @incluir-correção
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATACORRECAO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return(to_date(to_char(sysdate,'DD/MM/RRRR HH24:MI:SS'),'DD/MM/RRRR HH24:MI:SS'));
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P40_IDCORRECAONOTAVENDA (
        type: hidden
        layout {
            sequence: 10
            region: @incluir-correção
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCORRECAONOTAVENDA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P40_IDNOTAVENDA (
        type: hidden
        layout {
            sequence: 70
            region: @incluir-correção
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDNOTAVENDA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P40_MOTIVO (
        type: textarea
        label {
            label: Motivo
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @incluir-correção
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            valueRequired: true
            maxLength: 500
        }
        source {
            type: databaseColumn
            databaseColumn: MOTIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P40_USUARIO (
        type: hidden
        layout {
            sequence: 30
            region: @incluir-correção
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return v('APP_USER');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 20
            region: @incluir-correção
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 37
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Salvar
        layout {
            sequence: 10
            region: @incluir-correção
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P40_IDCORRECAONOTAVENDA
        }
    )

    validation p40-motivo (
        name: P40_MOTIVO
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where length(:P40_MOTIVO) > 15
                ```
        }
        error {
            errorMessage: Informe um motivo sucinto.
            displayLocation: inlineInNotification
            associatedItem: @P40_MOTIVO
        }
        serverSideCondition {
            type: never
        }
    )

    process atualiza-bloqueio-da-nota (
        name: "Atualiza bloqueio da nota "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update notasvendas
                  set edicaobloqueada = 'N'
                  where idnotavenda = :P40_IDNOTAVENDA;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Nota liberada para correção!
        }
        error {
            errorMessage:
                ```
                Erro ao liberar correção!
                Registre um vento.
                ```
        }
        advanced {
            executionMappingIdentifier: 391496579381867647
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process envia-email (
        name: envia email
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_util.prc_enviaemail(ppara => 'ti@romancemoda.com.br'
                                         , passunto => '[CORRECAO DE NOTA DE VENDA] '||' - '||pck_romance.fnc_nomefilial(:P0_IDFILIAL)
                                         , ptexto => 'O usuário '||v('APP_USER')||' está efetuando uma correcao da nota de venda do Rep: '||pck_romance.fnc_nomerepresentante(:P37_IDREPRESENTANTE)||' de número: '||:P37_NUMERONOTA||'<br>Motivo:'||:P40_MOTIVO );
                exception
                  when others then
                   null;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 594507157846820587
        }
        serverSideCondition {
            type: never
        }
    )

    process fetch-row-from-correcoesnotasvendas (
        name: Fetch Row from CORRECOESNOTASVENDAS
        type: autoRowFetch
        source {
            tableName: CORRECOESNOTASVENDAS
            pkColumn: IDCORRECAONOTAVENDA
            pkItem: P40_IDCORRECAONOTAVENDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 18513985032774633
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P40_IDCORRECAONOTAVENDA is null then
                        select "SEQ_IDCORRECAONOTAVENDA".nextval
                          into :P40_IDCORRECAONOTAVENDA
                          from dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 18514171914774637
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-correcoesnotasvendas (
        name: Process Row of CORRECOESNOTASVENDAS
        type: autoRowProcessing
        target {
            tableName: CORRECOESNOTASVENDAS
            pkColumn: IDCORRECAONOTAVENDA
            pkItem: P40_IDCORRECAONOTAVENDA
            supportedOperations: insert
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 18514360611774637
        }
    )

    branch (
        name: Go To Page 37
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 37
                successMessage: false
            }
        }
    )

)

