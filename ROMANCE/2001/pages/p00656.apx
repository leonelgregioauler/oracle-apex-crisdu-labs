    pageItem P656_DISTRIBUIDOR (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap (p.nomepessoa) display_value
                     , r.idrepresentante return_value
                from pessoas p
                   , representantes r
                where r.idpessoa = p.idpessoa 
                  and r.ativo = 'S'
                  and r.idgerente = :P656_FRANQUIA
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P656_FRANQUIA
            itemsToSubmit: P656_DISTRIBUIDOR
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P656_FRANQUIA (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idgerente
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.idfilial != 1063
                  and f.ididioma = :P656_PAIS
                  and exists (select 1
                              from roman.notasvendas nv
                              where nv.idfilial = f.idfilial
                                and nv.idsituacaonotavenda = 3)
                ```
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: P656_PAIS
            itemsToSubmit: P656_PAIS
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

