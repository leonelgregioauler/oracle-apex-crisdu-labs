page 656 (
    name: Dash de notas com ass. reprovada
    title: Dash de notas com ass. reprovada
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function listanotas(pidrepres,pidsemana) 
            {
            javascript:window.open('f?p=&APP_ID.:658:&SESSION.::NO:658:P655_DISTRIBUIDOR,:'+pidrepres'
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=1300,screenX=50,screenY =100');void(0);
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acertadas-débitos-reprovadas-qtd (
        name: Acertadas/Débitos Reprovadas - Qtd
        type: chart
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent8
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P656_DETALHADO
            value: N
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select roman.pck_romance.fnc_nomefilial(x.idfilial) franquia
                         , nvl(count(x.notas),0) total
                      from (select distinct(nv.idnotavenda) notas
                                 , nv.idfilial
                              from roman.notasvendas nv
                                 , roman.vw_assinaturas_eletronicas a
                                 , catal.gerentes g
                                 , catal.representantes r
                                 , catal.filiais f --Maicon Aimi 8353041 - Adicionar filtro por pais
                              where nv.idnotavenda = a.idnotavenda
                                and nv.idfilial = g.idfilial
                                and nv.idrepresentante = r.idrepresentante
                                and a.situacao = 'R'
                                and f.idfilial = nv.idfilial  --Maicon Aimi 8353041 - Adicionar filtro por pais
                                and f.ididioma = :P656_PAIS   --Maicon Aimi 8353041 - Adicionar filtro por pais
                                and nv.idsituacaonotavenda = 4
                                and nv.saldo > 0
                                and not exists ( select 1
                                                   from roman.assinaturaseletronicas aa
                                                   where aa.idnotavenda = nv.idnotavenda
                                                     and aa.situacao = 'A')
                                --and nv.idfilial = 100
                                and (:P656_DATAINI is null or trunc(nv.datanota) between to_date(:P656_DATAINI,'dd/mm/rrrr') and to_date(:P656_DATAFIM, 'dd/mm/rrrr'))
                                and (:P656_FRANQUIA is null or g.idgerente = :P656_FRANQUIA)
                                and (:P656_NAOFILTRAR = 'S')
                                and (:P656_ATIVO = 'A' and r.ativo in ('S','N') or :P656_ATIVO = 'S' and r.ativo = 'S' or :P656_ATIVO = 'N' and r.ativo = 'N')
                              ) x
                    group by x.idfilial
                    order by 1
                              
                    ```
            }
            columnMapping {
                label: FRANQUIA
                value: TOTAL
            }
            label {
                show: true
            }
        )

    )

    region acertadas-débitos-reprovadas-qtd-2 (
