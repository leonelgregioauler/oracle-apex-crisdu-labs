    region total-por-franquia (
        name: Total Por Franquia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial (xx.idfilial) franquia 
                     , xx.em_aberto_qtd
                     , xx.em_aberto_vlr
                     , yy.acertada_qtd
                     , yy.acertada_vlr
                     , nvl(xx.em_aberto_qtd,0) + nvl(yy.acertada_qtd,0) total_geral_qtd
                     , nvl(xx.em_aberto_vlr,0) + nvl(yy.acertada_vlr,0) total_geral_valor
                from( select count(x.notas_qtd) em_aberto_qtd
                           , sum(x. notas_vlr) em_aberto_vlr
                           , x.idfilial
                        from (select distinct(nv.idnotavenda) notas_qtd
                                   , sum(nv.valortotalnota) notas_vlr
                                   , nv.idfilial
                                from roman.notasvendas nv
                                   , roman.vw_assinaturas_eletronicas a
                                   , catal.gerentes g
                                   , catal.representantes r
                                   , catal.filiais f --Maicon Aimi 8353041 - Adicionar filtro por pais
                                where nv.idnotavenda = a.idnotavenda
                                  and nv.idfilial = g.idfilial
                                  and f.idfilial = nv.idfilial  --Maicon Aimi 8353041 - Adicionar filtro por pais
                                  and f.ididioma = :P656_PAIS   --Maicon Aimi 8353041 - Adicionar filtro por pais
                                  and nv.idrepresentante = r.idrepresentante
                                  and a.situacao = 'R'
                                  and nv.idsituacaonotavenda = 3 
                                  and not exists ( select 1
                                                     from roman.assinaturaseletronicas aa
                                                     where aa.idnotavenda = nv.idnotavenda
                                                       and aa.situacao = 'A')
                                 -- and nv.idfilial = 100
                                  and (:P656_DATAINI is null or trunc(nv.datanota) between to_date(:P656_DATAINI,'dd/mm/rrrr') and to_date(:P656_DATAFIM, 'dd/mm/rrrr'))
                                  and (:P656_FRANQUIA is null or g.idgerente = :P656_FRANQUIA)
                                  and (:P656_ATIVO = 'A' and r.ativo in ('S','N') or :P656_ATIVO = 'S' and r.ativo = 'S' or :P656_ATIVO = 'N' and r.ativo = 'N')
                               group by nv.idfilial, nv.idnotavenda, nv.valortotalnota
                                ) x
                        group by x.idfilial ) xx
                          
                    ,( select count(y.notas_qtd) acertada_qtd
                            , sum(y.notas_vlr) acertada_vlr
                            , y.idfilial
                         from (select distinct(nv.idnotavenda) notas_qtd
                                    , sum(nv.saldo) notas_vlr
                                    , nv.idfilial
                                 from roman.notasvendas nv
                                    , roman.vw_assinaturas_eletronicas a
                                    , catal.gerentes g
                                    , catal.representantes r
                                    , catal.filiais f --Maicon Aimi 8353041 - Adicionar filtro por pais
                                 where nv.idnotavenda = a.idnotavenda
                                   and nv.idfilial = g.idfilial
                                   and f.idfilial = nv.idfilial  --Maicon Aimi 8353041 - Adicionar filtro por pais
                                   and f.ididioma = :P656_PAIS   --Maicon Aimi 8353041 - Adicionar filtro por pais
                                   and nv.idrepresentante = r.idrepresentante
                                   and a.situacao = 'R'
                                   and nv.idsituacaonotavenda = 4 
                                   and nv.saldo > 0
                                   and not exists ( select 1
                                                      from roman.assinaturaseletronicas aa
                                                      where aa.idnotavenda = nv.idnotavenda
                                                        and aa.situacao = 'A')
                                   --and nv.idfilial = 100
                                   and (:P656_DATAINI is null or trunc(a.datarealizada) between to_date(:P656_DATAINI,'dd/mm/rrrr') and to_date(:P656_DATAFIM, 'dd/mm/rrrr'))
                                   and (:P656_FRANQUIA is null or g.idgerente = :P656_FRANQUIA)
                                   and (:P656_ATIVO = 'A' and r.ativo in ('S','N') or :P656_ATIVO = 'S' and r.ativo = 'S' or :P656_ATIVO = 'N' and r.ativo = 'N')
                                  group by nv.idfilial , nv.idnotavenda, nv.valortotalnota
                                ) y
                        group by idfilial ) yy
                where xx.idfilial = yy.idfilial
                  and (:P656_NAOFILTRAR = 'S')
                order by 1 
                          
                
                ```
        }
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
