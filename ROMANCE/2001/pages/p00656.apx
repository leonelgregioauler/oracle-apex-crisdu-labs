    region notas-acertadas-qtd (
        name: Notas Acertadas - QTD
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Acertadas/Débitos Reprovadas - Qtd' situacao
                     , to_char(count(x.notas),'999G999G999G999G990') total_notas
                  from (select distinct(nv.idnotavenda) notas
                          from roman.notasvendas nv
                             , roman.vw_assinaturas_eletronicas a
                             , catal.gerentes g
                             , catal.representantes r
                             , catal.filiais f --Maicon Aimi 8353041 - Adicionar filtro por pais
                          where nv.idnotavenda = a.idnotavenda
                            and f.idfilial = nv.idfilial  --Maicon Aimi 8353041 - Adicionar filtro por pais
                            and f.ididioma = :P656_PAIS   --Maicon Aimi 8353041 - Adicionar filtro por pais
                            and nv.idrepresentante = r.idrepresentante 
                            and nv.idfilial = g.idfilial
                            and a.situacao = 'R'
                            and nv.idsituacaonotavenda = 4 
                            and nv.saldo > 0
                            and not exists ( select 1
                                               from roman.assinaturaseletronicas aa
                                               where aa.idnotavenda = nv.idnotavenda
                                                 and aa.situacao = 'A')
                           -- and nv.idfilial = 100
                            and (:P656_DATAINI is null or trunc(nv.datanota) between to_date(:P656_DATAINI,'dd/mm/rrrr') and to_date(:P656_DATAFIM, 'dd/mm/rrrr'))
                            and (:P656_FRANQUIA is null or g.idgerente = :P656_FRANQUIA)
                            and (:P656_DISTRIBUIDOR is null or r.idrepresentante = :P656_DISTRIBUIDOR )
                            and (:P656_ATIVO = 'A' and r.ativo in ('S','N') or :P656_ATIVO = 'S' and r.ativo = 'S' or :P656_ATIVO = 'N' and r.ativo = 'N')
                          ) x
                ```
        }
        layout {
            sequence: 20
            parentRegion: @placar-do-momento
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            labelColumn: SITUACAO
            valueColumn: TOTAL_NOTAS
        }
    )

