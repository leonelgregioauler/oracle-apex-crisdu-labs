    dynamicAction mostra-dist (
        name: Mostra Dist.
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P656_DETALHADO
        }
        clientSideCondition {
            type: item=value
            item: P656_DETALHADO
            value: S
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P656_DISTRIBUIDOR
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction oculta-dist (
        name: Oculta Dist.
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P656_DETALHADO
        }
        clientSideCondition {
            type: item=value
            item: P656_DETALHADO
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P656_DISTRIBUIDOR
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 656
                items: {
                    P656_NAOFILTRAR: S
                }
                action: resetPagination
            }
        }
    )

)

