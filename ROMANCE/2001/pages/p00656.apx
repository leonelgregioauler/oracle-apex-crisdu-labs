    region total-por-distribuidor (
        name: Total Por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(xy.idrepresentante) distribuidor
                     --, sum(case when situacao = 1 then xy.qtd else 0 end) em_aberto_qtd
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:659:'||v('APP_SESSION')||'::NO::P659_DISTRIBUIDOR,P659_DATAINI,P659_DATAFIM:'||idrepresentante||','||:P656_DATAINI||','||:P656_DATAFIM,'SESSION')||''',''_blank''); void(0)">'||sum(case when situacao = 1 then xy.qtd else 0 end)||'</a>'"aguardandoacerto_qtd"
                     , sum(case when situacao = 1 then xy.vlr else 0 end) em_aberto_vlr
                     --, sum(case when situacao = 2 then xy.qtd else 0 end) acertada_qtd
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:658:'||v('APP_SESSION')||'::NO::P658_DISTRIBUIDOR,P658_DATAINI,P658_DATAFIM:'||idrepresentante||','||:P656_DATAINI||','||:P656_DATAFIM,'SESSION')||''',''_blank''); void(0)">'||sum(case when situacao = 2 then xy.qtd else 0 end)||'</a>'"acertada_qtd"
                     , sum(case when situacao = 2 then xy.vlr else 0 end) acertada_vlr
                     , sum(xy.qtd) total_geral_qtd
                     , sum(xy.vlr) total_geral_valor
                from( select count(x.notas_qtd) qtd
                           , sum(x. notas_vlr) vlr
                           , x.idrepresentante
                           , 1 situacao
                        from (select distinct(nv.idnotavenda) notas_qtd
                                   , sum(nv.valortotalnota) notas_vlr
                                   , nv.idrepresentante
                                from roman.notasvendas nv
                                   , roman.vw_assinaturas_eletronicas a
                                   , catal.gerentes g
                                   , catal.representantes r
                                   , catal.filiais f --Maicon Aimi 8353041 - Adicionar filtro por pais
                                where nv.idnotavenda = a.idnotavenda
                                  and nv.idfilial = g.idfilial
                                  and f.idfilial = nv.idfilial  --Maicon Aimi 8353041 - Adicionar filtro por pais
                                  and f.ididioma = :P656_PAIS   --Maicon Aimi 8353041 - Adicionar filtro por pais
                                  and nv.idrepresentante = r.idrepresentante
                                  and a.situacao = 'R'
                                  and nv.idsituacaonotavenda = 3 
                                  and not exists ( select 1
                                                     from roman.assinaturaseletronicas aa
                                                     where aa.idnotavenda = nv.idnotavenda
                                                       and aa.situacao = 'A')
                                  --and nv.idfilial = 100
                                  and (:P656_DATAINI is null or trunc(nv.datanota) between to_date(:P656_DATAINI,'dd/mm/rrrr') and to_date(:P656_DATAFIM, 'dd/mm/rrrr'))
                                  and (:P656_FRANQUIA is null or g.idgerente = :P656_FRANQUIA)
                                  and (:P656_DISTRIBUIDOR is null or r.idrepresentante = :P656_DISTRIBUIDOR )
                                  and (:P656_ATIVO = 'A' and r.ativo in ('S','N') or :P656_ATIVO = 'S' and r.ativo = 'S' or :P656_ATIVO = 'N' and r.ativo = 'N')
                               group by nv.idrepresentante, nv.idnotavenda, nv.valortotalnota
                                ) x
                        group by x.idrepresentante
                        
                     union all   
                          
                     select count(y.notas_qtd) qtd
                            , sum(y.notas_vlr) vlr
                            , y.idrepresentante
                            , 2 situacao
                         from (select distinct(nv.idnotavenda) notas_qtd
                                    , sum(nv.saldo) notas_vlr
                                    , nv.idrepresentante
                                 from roman.notasvendas nv
                                    , roman.vw_assinaturas_eletronicas a
                                    , catal.gerentes g
                                    , catal.representantes r
                                    , catal.filiais f --Maicon Aimi 8353041 - Adicionar filtro por pais
                                 where nv.idnotavenda = a.idnotavenda
                                   and nv.idfilial = g.idfilial
                                   and nv.idrepresentante = r.idrepresentante
                                   and a.situacao = 'R'
                                   and f.idfilial = nv.idfilial  --Maicon Aimi 8353041 - Adicionar filtro por pais
                                   and f.ididioma = :P656_PAIS   --Maicon Aimi 8353041 - Adicionar filtro por pais
                                   and nv.idsituacaonotavenda = 4 
                                   and nv.saldo > 0
                                   and not exists ( select 1
                                                      from roman.assinaturaseletronicas aa
                                                      where aa.idnotavenda = nv.idnotavenda
                                                        and aa.situacao = 'A')
                                   --and nv.idfilial = 100
                                   and (:P656_DATAINI is null or trunc(nv.datanota) between to_date(:P656_DATAINI,'dd/mm/rrrr') and to_date(:P656_DATAFIM, 'dd/mm/rrrr'))
                                   and (:P656_FRANQUIA is null or g.idgerente = :P656_FRANQUIA)
                                   and (:P656_DISTRIBUIDOR is null or r.idrepresentante = :P656_DISTRIBUIDOR )
                                   and (:P656_ATIVO = 'A' and r.ativo in ('S','N') or :P656_ATIVO = 'S' and r.ativo = 'S' or :P656_ATIVO = 'N' and r.ativo = 'N')
                                  group by nv.idrepresentante , nv.idnotavenda, nv.valortotalnota
                                ) y
                        group by y.idrepresentante)xy
                where  (:P656_NAOFILTRAR = 'S')
                group by xy.idrepresentante
                order by 1 
                          
                
                ```
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent8
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P656_DETALHADO
            value: S
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 99002709879793224
        }

