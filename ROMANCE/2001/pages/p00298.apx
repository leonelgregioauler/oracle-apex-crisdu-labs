page 298 (
    name: Importar Arquivo
    title: Importar Arquivo
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region data-load-process-train (
        name: Data Load Process Train
        type: list
        source {
            list: @data-load-process-train-importar-estoque
        }
        layout {
            sequence: 10
            slot: body
        }
        advanced {
            excludeTitleFromTranslation: true
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    region globalization (
        name: Globalization
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: style="width:100%;max-width:none;"
        }
        settings {
            outputAs: text
        }
    )

    region importar-arquivo (
        name: Importar Arquivo
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: style="width:100%;max-width:none;"
        }
        settings {
            outputAs: text
        }
    )

    pageItem P298_APP_DATE_FORMAT (
        type: checkboxGroup
        label {
            label: Usar formato de data da aplicação
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @date-format-option
        }
        layout {
            sequence: 51
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Y
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Select this box if you would like to use the application Date/Timestamp formats during your data loading.
        }
    )

    pageItem P298_CHAR_SET (
        type: selectList
        label {
            label: File Character Set
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: sharedComponent
            lov: @data-load-charset
            displayNullValue: false
        }
        layout {
            sequence: 55
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: UTF-8
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: DATA_LOAD.CHAR_SET_ITEM_HELP
        }
    )

    pageItem P298_COPY_PASTE (
        type: textarea
        label {
            label: Copy and Paste Delimited Data
            alignment: above
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 80
            height: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P298_CURRENCY (
        type: textField
        label {
            label: Currency Symbol
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @globalization
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 2
        }
        validation {
            maxLength: 2
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select value
                  from nls_session_parameters
                 where parameter = 'NLS_CURRENCY'
                ```
        }
        default {
            type: static
            staticValue: $
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: If your data contains international currency symbol, enter it here. For example, if your data has "&euro;1,234.56" or "&yen;1,234.56", enter "&euro;" or "&yen;".  Otherwise the data will not load correctly.
        }
    )

    pageItem P298_DECIMAL_CHARACTER (
        type: textField
        label {
            label: Decimal Character
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @globalization
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 2
        }
        validation {
            maxLength: 2
        }
        source {
            type: expression
            plsqlExpression: apex_application.get_nls_decimal_separator
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText:
                ```html
                <p>The decimal character separates the integer and decimal parts of a number.</p>
                <p> Any character can be the decimal character. The character specified must be single-byte, and the decimal character must be different from group separator. The character can be a space, but cannot be any numeric character or any of the following characters:</p>
                <ul class="noIndent">
                <li>plus (+)</li>
                <li>hyphen (-)</li> 
                <li>less than sign (<)</li>
                <li>greater than sign (>)</li> 
                </ul>
                ```
        }
    )

    pageItem P298_ENCLOSED_BY (
        type: textField
        label {
            label: Opção de Definição de Valor
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 2
        }
        validation {
            maxLength: 2
        }
        default {
            type: static
            staticValue: "
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Enter a delimiter character. You can use this character to delineate the starting and ending boundary of a data value. If you specify a delimiter character, Data Workshop ignores whitespace occurring before the starting and ending boundary of a data value. You can also use this option to enclose a data value with the specified delimiter character.
        }
    )

    pageItem P298_FILE_NAME (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            type: appTempFiles
            purgeFileAt: endOfRequest
        }
        layout {
            sequence: 20
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Name of the file to upload
        }
    )

    pageItem P298_FIRST_ROW (
        type: checkboxGroup
        label {
            label: Primeira linha tem título?
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @first-row-option
        }
        layout {
            sequence: 50
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Y
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Select this box if your data contains column names in the first row.
        }
    )

    pageItem P298_GROUP_SEPARATOR (
        type: textField
        label {
            label: Group Separator
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @globalization
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 2
        }
        validation {
            maxLength: 2
        }
        source {
            type: expression
            plsqlExpression: apex_application.get_nls_group_separator
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText:
                ```html
                <p>A group separator is a character that separates integer groups, for example to show thousands and millions.</p>
                <p>Any character can be the group separator. The character specified must be single-byte, and the group separator must be different from any other decimal character. The character can be a space, but cannot be a numeric character or any of the following:</p>
                <ul class="noIndent">
                <li>plus (+)</li>
                <li>hyphen (-)</li> 
                <li>less than sign (<)</li>
                <li>greater than sign (>)</li> 
                </ul>
                ```
        }
    )

    pageItem P298_IMPORT_FROM (
        type: radioGroup
        label {
            label: Importar de
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @data-load-option
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: PASTE
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P298_SEPARATOR (
        type: textField
        label {
            label: Separador
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 2
        }
        validation {
            valueRequired: true
            maxLength: 2
        }
        default {
            type: static
            staticValue: ;
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Identify a column separator character. Use <code>\t</code> for tab separators.
        }
        comments {
            comments: "\\t - "
        }
    )

    pageItem P298_STOP_START_TABLE (
        type: stopAndStartGridLayout
        label {
            alignment: right
        }
        layout {
            sequence: 60
            region: @importar-arquivo
            slot: regionBody
            startNewRow: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @importar-arquivo
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button next (
        buttonName: NEXT
        label: Próximo
        layout {
            sequence: 20
            region: @importar-arquivo
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.textareaClob.upload('P298_COPY_PASTE', 'NEXT');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction import-from-copy-and-paste (
        name: Import From Copy and Paste
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P298_IMPORT_FROM
        }
        clientSideCondition {
            type: item=value
            item: P298_IMPORT_FROM
            value: PASTE
        }

        action native-hide (
            action: hide
            settings {
                hidePageItemsOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P298_COPY_PASTE
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            settings {
                showAllOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P298_COPY_PASTE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction import-from-file (
        name: Import from File
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P298_IMPORT_FROM
        }
        clientSideCondition {
            type: item=value
            item: P298_IMPORT_FROM
            value: UPLOAD
        }

        action native-hide (
            action: hide
            settings {
                hidePageItemsOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P298_FILE_NAME
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            settings {
                showAllOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P298_FILE_NAME
            }
            execution {
                sequence: 10
            }
        )

    )

    validation filename-is-not-null (
        name: Filename is not null
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P298_FILE_NAME
        }
        error {
            errorMessage: #LABEL# must have some value.
            associatedItem: @P298_FILE_NAME
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: item=value
            item: P298_IMPORT_FROM
            value: UPLOAD
        }
    )

    process parse-uploaded-data (
        name: Parse Uploaded Data
        type: parseUploadedData
        dataLoading {
            dataLoadDefinition: @importar-estoque
        }
        sourceData {
            importFromItem: P298_IMPORT_FROM
            fileNameItem: P298_FILE_NAME
            copyAndPasteItem: P298_COPY_PASTE
            charSetItem: P298_CHAR_SET
            dateFormatItem: P298_APP_DATE_FORMAT
        }
        parsingOptions {
            separatorItem: P298_SEPARATOR
            enclosedByItem: P298_ENCLOSED_BY
            firstRowItem: P298_FIRST_ROW
            currencySymbolItem: P298_CURRENCY
            groupSeparatorItem: P298_GROUP_SEPARATOR
            decimalCharItem: P298_DECIMAL_CHARACTER
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 303717026143478014
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 299
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)

