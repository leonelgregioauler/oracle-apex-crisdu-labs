    region categoria-sem-comissão (
        name: Categoria Sem Comissão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomecategoria(c.idcategoria) categoria
                     , '|' separador
                     , sum(nvl(prod.qtdbalancoinicial,0)) qtdbalancoinicial
                     , sum(nvl(prod.valorbalancoinicial,0)) valorbalancoinicial
                     , '+' seq_balanco
                     , sum(nvl(prod.carga,0)) carga
                     , sum(nvl(prod.vlrcarga,0)) vlrcarga
                     , '-' sep_devol
                     , sum(nvl(prod.devolucao,0)) devolucao
                     , sum(nvl(prod.vlrdevolucao,0)) vlrdevolucao
                     , '-' sep_vend
                     , sum(nvl(prod.vendido,0)) vendido
                     , sum(nvl(prod.vlrvendido,0)) vlrvendido
                     , '-' sep_foiparaoutro
                     , sum(nvl(prod.qtddevolveufoioutro,0)) qtddevolveufoioutro
                     , sum(nvl(prod.valordevolveufoioutro,0)) valordevolveufoioutro
                     , '+' sep_veiodeoutro
                     , sum(nvl(prod.qtddevolveuveiooutros,0)) qtddevolveuveiooutros
                     , sum(nvl(prod.valordevolveuveiooutros,0)) valordevolveuveiooutros
                     , '-' sep_aberto
                     , sum(nvl(prod.acobrar,0)) acobrar
                     , sum(nvl(prod.vlrcobrar,0)) vlrcobrar
                     , '=' sep_resultado
                     , sum(nvl(prod.qtdresultado,0)) qtdresultado
                     , sum(nvl(prod.vlrresultado,0)) vlrresultado
                from categorias c
                   , ( select idcategoria
                            , qtdbalancoinicial
                            , valorbalancoinicial
                            , carga
                            , vlrcarga
                            , devolucao
                            , vlrdevolucao
                            , vendido
                            , vlrvendido
                            , qtddevolveufoioutro 
                            , valordevolveufoioutro
                            , qtddevolveuveiooutros 
                            , valordevolveuveiooutros
                            , acobrar
                            , vlracobrar vlrcobrar
                            , ( qtdbalancoinicial
                              + carga
                              - devolucao
                              - vendido
                              - qtddevolveufoioutro
                              + qtddevolveuveiooutros
                              - acobrar ) qtdresultado
                            , ( nvl(valorbalancoinicial,0)
                              + nvl(vlrcarga,0)
                              - nvl(vlrdevolucao,0)
                              - nvl(vlrvendido,0)
                              - nvl(valordevolveufoioutro,0)
                              + nvl(valordevolveuveiooutros,0)
                              - nvl(vlracobrar,0) ) vlrresultado
                       from vw_balancoprod_repres_sem_v4 w
                       where w.idrepresentante = :P554_IDREPRESENTANTE ) prod
                where prod.idcategoria(+) = c.idcategoria
