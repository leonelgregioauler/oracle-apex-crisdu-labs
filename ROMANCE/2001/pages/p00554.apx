    pageItem P554_ATENDIMENTOS_SEM_ATUAL (
        type: displayOnly
        label {
            label: Acertos Efetuados Sem. Atual
            alignment: left
        }
        layout {
            sequence: 80
            region: @informações-do-distribuidor
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(distinct nv.idnotavenda) qtd
                from notasvendas nv
                where nv.idsituacaonotavenda = 4
                  and nv.idsemanacobranca = ( select min(rg.idsemana)
                                                  from regioesrepresentantes rg
                                                  where rg.idrepresentante = :P554_IDREPRESENTANTE )
                  and nv.idrepresentante = :P554_IDREPRESENTANTE
                  and nv.idfilial != 1098
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0
        }
        security {
            encryptSessionState: false
        }
    )

