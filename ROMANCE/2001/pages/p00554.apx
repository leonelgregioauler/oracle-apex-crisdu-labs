    button ranking-nf-aguardando-acerto (
        buttonName: RANKING_NF_AGUARDANDO_ACERTO
        label: Ranking Nf Aguardando Acerto
        layout {
            sequence: 120
            region: @filtro
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 680
                items: {
                    P680_IDREPRESENTANTE: &P554_IDREPRESENTANTE.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
