    region liberações-de-valores-do-balanço (
        name: Liberações de Valores do Balanço
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select lb.idliberacaobalanco
                     , lb.idsemanabalanco
                     , lb.dataliberacao
                     , lb.datalimitevisuazacao
                     , lb.usuarioliberacao
                from liberacoesbalancos lb
                where lb.idrepresentante = :P554_IDREPRESENTANTE
                  and lb.idsemanabalanco = :P554_IDSEMANABALANCO
                ```
        }
        layout {
            sequence: 50
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (0,1)
                  and ug.usuario            = v('APP_USER')
                  and :P554_IDREPRESENTANTE is not null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
