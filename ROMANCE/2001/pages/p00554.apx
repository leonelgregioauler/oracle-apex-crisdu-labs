    button atualiza-valores-balanco (
        buttonName: ATUALIZA_VALORES_BALANCO
        label: Atualizar Valores Bal. Inicial
        layout {
            sequence: 90
            region: @filtro
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Essa ação irá atualizar os preços de todos os códigos, pegando os preços atuais de venda. Você confirma essa ação?','ATUALIZA_VALORES');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P554_IDREPRESENTANTE is not null and pck_util.fnc_verificaacesso(4018,v('APP_USER')) = 'S'
                /*:P554_IDREPRESENTANTE is not null and v('APP_USER') in ('FERNANDO','GUILHERME','KELVISD','THIAGOSOUZA','JACKSONM','ALEXDUTRA','GABRIELASR','RAIMUNDOROB','KEIZIH','LUCASFK','DIOGOJ')*/
                ```
        }
    )

