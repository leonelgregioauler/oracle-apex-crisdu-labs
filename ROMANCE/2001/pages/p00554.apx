page 554 (
    name: Balanço V4
    title: Balanço V4
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_popup_representante(vidrepresentante)
            { njan =   window.open('f?p=&APP_ID.:135:&SESSION.::NO::P135_IDREPRESENTANTE:'+vidrepresentante ,'rep', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=500,left=250,top=100','_blank'); void(0);
            njan.focus();
            }
            
            
            function fnc_abrebalanco(vidrepresentante){
              atualizarBalancoDistribuidor.executar(vidrepresentante);
            }
            
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region balanço-detalhado-v4-0-com-comissão (
        name: Balanço Detalhado v4.0 Com Comissão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distribuidor
                   , semana
                   , carga        
                   , valorcarga     valorcarga
                   , '-' s1
                   , devolucao
                   , valordevolucao    valordevolucao
                   , '-' s2
                   , vendeu
                   , valorvendeu      valorvendeu
                   , '-' s3
                   , emaberto
                   , valoremaberto      valoremaberto
                   , '-' s7
                   , w.qtddevolveufoioutro
                   , w.valordevolveufoioutro
                   , '+' s8
                   , w.qtddevolveuveiooutros
                   , w.valordevolveuveiooutros
                   , '=' s4
                   , faltadevolver
                   , w.valorfaltadevolver valorfaltadevolver
                   , '|' s5
                   , ( select sum(w1.faltadevolver)
                       from vw_balanco_romance_v4_com w1
                       where w1.idrepresentante = w.idrepresentante
                         and w1.idsemana       <= w.idsemana ) qtdsaldoparcial
                   , ( select sum(w1.valorfaltadevolver)
                       from vw_balanco_romance_v4_com w1
                       where w1.idrepresentante = w.idrepresentante
                         and w1.idsemana       <= w.idsemana ) valorsaldoparcial
                   , '|' s6
                   , '-' s9
                from vw_balanco_romance_v4_com w
                where idrepresentante = :P554_IDREPRESENTANTE
                
                ```
        }
        layout {
            sequence: 90
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P554_TIPO = 'T'
                  and ( :P554_COMISSAO = 'S'
                      or :P554_COMISSAO = 'A' )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            sort: false
            controlBreak: false
            chart: false
            groupBy: false
            pivot: false
            flashback: false
        }
        advanced {
            savedReportMappingIdentifier: 6010693764860721276
        }

