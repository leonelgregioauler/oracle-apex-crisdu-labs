                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region débitos (
        name: Débitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idrepresentante
                     , sum(w.debitosnovos) debitos
                     , sum(w.debitoscobrados) debitoscobrados
                     , sum(w.debitossetorcobranca) debitossetorcobranca
                from vw_debitos_balanco w
                where w.idrepresentante = :P554_IDREPRESENTANTE 
                  and w.idgerente = ( select idgerente 
                                      from gerentes
                                      where idfilial = :P0_IDFILIAL )
                group by w.idrepresentante
                
                ```
        }
        layout {
            sequence: 160
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P554_IDREPRESENTANTE is not null and pck_util.fnc_verificaacesso(2568,v('APP_USER')) = 'S'
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            savePublicReport: true
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 2879106121143696787
        }

