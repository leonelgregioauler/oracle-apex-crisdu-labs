    region mensagem-2 (
        name: Mensagem
        type: staticContent
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P554_IDREPRESENTANTE is not null
                  and exists ( select *
                               from negociacoesbalanco nb
                               where nb.idrepresentante = :P554_IDREPRESENTANTE
                                 and nb.valor           > 0 )
                ```
        }
    )

    region passou-de-com-comissão-para-sem-comissão (
        name: Passou de: Com Comissão para Sem Comissão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                     -- c.nome categoria
                      ltrim(vp.produto) produto
                     , vp.codigo
                    -- , vp.quantidade
                    -- , vp.totalcusto
                     --, vp.totalvenda
                     , decode(vp.comissao,'S','Com Comissão','N','Sem Comissão') comissao
                    -- , vp.valorvenda
                from roman.vw_pecas_produtos_repres vp
                   , roman.produtos p
                   , roman.categorias c
                where vp.idproduto       = p.idproduto
                  and p.idcategoria      = c.idcategoria
                  and vp.idrepresentante = :P554_IDREPRESENTANTE
                  and vp.comissao        = 'N'
                  and vp.idfilial        = :P0_idfilial
                  and vp.quantidade > 0
                  and vp.totalcusto > 0
                  and vp.totalvenda > 0
                  and exists (select 1
                                from logroman.log_estoquefilial lef
                                   , semana_dias sd
                               where lef.tipoalteracao = 'UPDATE'
                                 and lef.comissao = 'S'
                                 and lef.idproduto = p.idproduto
                                 and sd.idsemana = :P554_IDSEMANABALANCO
                                 and trunc(lef.dataalteracao) between sd.dt_ini and sd.dt_fim)
                ```
        }
        layout {
            sequence: 20
            parentRegion: @comissões-alteradas
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
