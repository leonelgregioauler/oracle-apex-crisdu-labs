    region balanço-resumido-v4-0-com-comissão (
        name: Balanço Resumido v4.0 Com Comissão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distribuidor
                     , pck_util.fnc_semanaid(w.idsemanabalanco) semana
                     , sum(nvl(QTDINICIALBALANCO_COM,0)) qtdbalancoinicial
                     , sum(nvl(valorinicialbalanco,0)) balancoinicial
                     , '+' s0
                     , sum(carga                ) carga
                     , sum(valorcarga           ) valorcarga
                     , '-' s1               
                     , sum(devolucao            ) devolucao
                     , sum(valordevolucao       ) valordevolucao
                     , '-' s2               
                     , sum(vendeu               ) vendeu
                     , sum(valorvendeu          ) valorvendeu
                     , '-' s3               
                     , sum(emaberto             ) emaberto
                     , sum(valoremaberto        ) valoremaberto
                     , '+' s6
                     , sum(qtddevolveuveiooutros)   qtddevolveuveiooutros
                     , sum(valordevolveuveiooutros) valordevolveuveiooutros
                     , '-' s7
                     , sum(qtddevolveufoioutro)    qtddevolveufoioutro
                     , sum(valordevolveufoioutro)  valordevolveufoioutro
                     , '=' s4               
                     , sum(faltadevolver        ) faltadevolver
                     , sum(w.valorfaltadevolver ) valorfaltadevolver
                     , '|' s5
                     , w.idrepresentante
                     , w.idsemanabalanco
                from vw_balanco_romance_v4_com w
                where  w.idrepresentante = :P554_IDREPRESENTANTE 
                  and w.idgerente = ( select idgerente 
                                      from gerentes
                                      where idfilial = :P0_IDFILIAL )
                group by distribuidor, w.idsemanabalanco
                     , w.idrepresentante
                
                ```
        }
        layout {
            sequence: 70
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P554_TIPO = 'R' and ( :P554_COMISSAO = 'S' or :P554_COMISSAO = 'A' )
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            savePublicReport: true
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 6007616639859144853
        }

