    region históricos-do-balanço (
        name: Históricos do Balanço
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.idhistoricobalanco
                     , h.data
                     , h.usuario
                     , h.observacao
                from historicosbalancos h
                   , representantes r
                where r.idrepresentante = h.idrepresentante
                  and r.idrepresentante = :P554_IDREPRESENTANTE
                order by 1
                ```
        }
        layout {
            sequence: 60
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from historicosbalancos h
                   , representantes r
                where r.idrepresentante = h.idrepresentante
                  and r.idrepresentante = :P554_IDREPRESENTANTE
                  and exists ( select 1
                               from usuariosgruposatendimento ug
                               where ug.idgrupoatendimento in (0,1)
                                 and ug.usuario            = v('APP_USER')
                                 and :P554_IDREPRESENTANTE is not null )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 4721641725905044930
        }

