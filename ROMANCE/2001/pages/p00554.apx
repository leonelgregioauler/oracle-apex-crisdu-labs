    dynamicAction confirma-balanço (
        name: Confirma Balanço
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @confirmar
        }

        action native-confirm (
            action: confirm
            settings {
                message:
                    ```html
                    Confirma o Balanço deste distribuidor?
                    
                    Isto pode demorar alguns minutos.
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CONFIRMABALANCO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction confirma-liberação-de-valores (
        name: Confirma Liberação de Valores
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @p554-liberar-visualizacao-valores
        }

        action native-confirm (
            action: confirm
            settings {
                message: Deseja realmente liberar a visualização de valores?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: LIBERAR_VALORES
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction escolhe-resumido (
        name: Escolhe Resumido
        execution {
            sequence: 60
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNull
            item: P554_TIPO
        }

        action native-set-value (
            action: setValue
            settings {
                value: R
            }
            affectedElements {
                selectionType: items
                items: P554_TIPO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction filtrar (
        name: filtrar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @p554-filtrar
        }
        clientSideCondition {
            type: item=value
            item: P554_TIPO
            value: R
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction filtrar-produtos-e-categorias (
        name: FIltrar produtos e categorias
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @p554-filtrar
        }
        clientSideCondition {
            type: item!=value
            item: P554_TIPO
            value: R
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: fnc_abrebalanco(document.getElementById('P554_IDREPRESENTANTE'+'_HIDDENVALUE').value);
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction filtro (
        name: filtro
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P554_FILTRO
        }
        clientSideCondition {
            type: item=value
            item: P554_FILTRO
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P554_IDREPRESENTANTE
                    P554_TIPO
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P554_IDREPRESENTANTE
                    P554_TIPO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    validation valida-semana (
        name: Valida Semana
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P554_IDSEMANA
        }
        error {
            errorMessage: Informe a Semana!
            associatedItem: @P554_IDSEMANA
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMABALANCO
        }
    )

    process atualiza-valores-de-balanço (
        name: Atualiza Valores de Balanço
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_balanco_rmc.prc_atualizabalanco(pidrepresentante => :P554_IDREPRESENTANTE);
                  --
                  pck_balanco_rmc.prc_liberacaobalanco(pidrepresentante => :P554_IDREPRESENTANTE,
                                                       pusuario => v('APP_USER') );
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Valores atualizados com sucesso!
        }
        advanced {
            executionMappingIdentifier: 4638893032391160818
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZA_VALORES
        }
    )

    process confirma-balanço (
        name: Confirma Balanço
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidusuario    number;
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios 
                  where usuario = v('APP_USER');
                  --
                  pck_balanco_rmc.prc_novobalanco(pidrepresentante => :P554_IDREPRESENTANTE,
                                                  pidsemana => :P554_IDSEMANA,
                                                  pidusuario => vidusuario,
                                                  pidfilial => :P0_IDFILIAL);
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 26555554504385270
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMABALANCO
        }
    )

    process libera-visualização-de-valores (
        name: Libera Visualização de Valores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_balanco_rmc.prc_liberacaobalanco(pidrepresentante => :P554_IDREPRESENTANTE,
                                                       pusuario => :P0_USUARIO);
                end;
                
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Liberado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 4990350517989264626
        }
        serverSideCondition {
            type: request=Value
            value: LIBERAR_VALORES
        }
    )

    branch (
        name: filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
