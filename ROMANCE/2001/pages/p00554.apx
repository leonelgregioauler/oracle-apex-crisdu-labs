                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: openModal('INICIARBALANCO');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: pck_util.fnc_verificaacesso(2563,v('APP_USER')) = 'S' and :P554_IDREPRESENTANTE is not null
        }
    )

    button p554-liberar-visualizacao-valores (
        buttonName: P554_LIBERAR_VISUALIZACAO_VALORES
        label: Liberar Visualização de Valores
        layout {
            sequence: 110
            region: @filtro
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (0,1)
                  and ug.usuario            = v('APP_USER')
                  and :P554_IDREPRESENTANTE is not null
                ```
        }
    )

    button p554-verbalancoatual (
        buttonName: P554_VERBALANCOATUAL
        label: Ver Balanço Inicial Atual
