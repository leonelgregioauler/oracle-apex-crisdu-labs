    region produto-com-comissão (
        name: Produto Com Comissão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ first_rows (50) */ produto
                     , ativo
                     , comissao
                     , vlrvenda
                     , '|' separador
                     , qtdbalancoinicial
                     , valorbalancoinicial
                     , '+' sep_balancoinicial
                     , carga
                     , vlrcarga
                     , '-' sep_devol
                     , devolucao
                     , vlrdevolucao
                     , '-' sep_vend
                     , vendido
                     , vlrvendido
                     , '-' sep_foiparaoutro
                     , qtddevolveufoioutro
                     , valordevolveufoioutro
                     , '+' sep_veiodeoutro
                     , qtddevolveuveiooutros
                     , valordevolveuveiooutros
                     , '-' sep_aberto
                     , acobrar
                     , vlracobrar
                     , '=' sep_result
                     , ( qtdbalancoinicial
                       + carga
                       - devolucao
                       - vendido
                       - qtddevolveufoioutro
                       + qtddevolveuveiooutros
                       - acobrar ) qtdresultado
                     , ( nvl(valorbalancoinicial,0)
                       + nvl(vlrcarga,0)
                       - nvl(vlrdevolucao,0)
                       - nvl(vlrvendido,0)
                       - nvl(valordevolveufoioutro,0)
                       + nvl(valordevolveuveiooutros,0)
                       - nvl(vlracobrar,0) ) vlrresultado
                from vw_balancoprod_repres_com_v4 w
                where idrepresentante = :P554_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 110
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent13
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P554_TIPO = 'P' and ( :P554_COMISSAO = 'S' or :P554_COMISSAO = 'A' )
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4336692160314266610
        }

