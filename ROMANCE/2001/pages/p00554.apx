    pageItem P554_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||'('||decode(r.ativo,'S','Ativo','N','Inativo')||') - Ult. Balanço: '||pck_util.fnc_semanaid( r.idsemanabalanco ) display_value
                     , r.idrepresentante return_value
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente
                  and g.idfilial = :P0_IDFILIAL
                  and ( :P554_REPREATIVO = 'A' 
                     or :P554_REPREATIVO = 'S' and r.ativo = 'S'
                    or :P554_REPREATIVO = 'N' and r.ativo = 'N' )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P554_REPREATIVO
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P554_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00'))||'/'||ano||' - ( '||to_char(dt_ini,'DD/MM/RRRR')||' - '||to_char(dt_fim,'DD/MM/RRRR')||' ) ' display_value
                     , idsemana return_value
                from semana_dias s
                where s.idsemana = ( select idsemana
                                     from regioesrepresentantes rr
                                     where rr.idrepresentante = :P554_IDREPRESENTANTE
                                       and rr.idsemana = ( select max(t.idsemana)
                                                           from imptablettoservidor t
                                                           where t.processo = 'S'
                                                             and t.idrepresentante = rr.idrepresentante ) + 1 )
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione -
        }
        cascadingLov {
            parentItems: P554_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            region: @iniciar-balanço
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P554_IDSEMANABALANCO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 110
