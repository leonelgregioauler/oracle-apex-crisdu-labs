    pageItem P554_MEDIA_COBRANCA (
        type: displayOnly
        label {
            label: Média Cobrança
            alignment: left
        }
        layout {
            sequence: 30
            region: @informações-do-distribuidor
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select trim(to_char(round(cobranca/qtd,2),'999G999G999G999G999G999G990D00')) valor
                from ( select count(distinct fr.idfechamentorepres) qtd
                            , sum(fr.totalcobranca) cobranca
                       from fechamentorepresentantes fr
                       where fr.idrepresentante = :P554_IDREPRESENTANTE
                         and exists ( select 1
                                      from fechamentossemanais ff
                                      where ff.idfechamento = fr.idfechamento
                                        and ff.idsemana >= :P554_IDSEMANABALANCO ) )
                ```
            used: always
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from usuariosgruposatendimento ug
                         where ug.idgrupoatendimento in (0,1)
                           and ug.usuario            = :P0_USUARIO ) or pck_util.fnc_verificaacesso(2578,v('APP_USER')) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

