    region resultado (
        name: Resultado
        type: staticContent
        layout {
            sequence: 170
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P554_IDREPRESENTANTE is not null and pck_util.fnc_verificaacesso(2568,v('APP_USER')) = 'S' and exists ( select lb.idliberacaobalanco
                                                                                                                              , lb.idsemanabalanco
                                                                                                                              , lb.dataliberacao
                                                                                                                              , lb.datalimitevisuazacao
                                                                                                                              , lb.usuarioliberacao
                                                                                                                         from liberacoesbalancos lb
                                                                                                                         where lb.idrepresentante = :P554_IDREPRESENTANTE
                                                                                                                           and lb.idsemanabalanco = :P554_IDSEMANABALANCO
                                                                                                                           and trunc(sysdate) between trunc(lb.dataliberacao) and trunc(lb.datalimitevisuazacao) )
                ```
        }
    )

    region saldo-bruto (
        name: Saldo Bruto
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Resultado Sistema' r1
                     , case
                         when exists ( select 1
                                       from vw_filiais f
                                       where f.idfilial = :P0_IDFILIAL 
                                         and f.idgrupo = 5 ) then
                           trim(to_char((( comissao.saldo*0.70 ) + semcomissao.saldo),'999G999G999G999G999G990D00'))
                         else
                           trim(to_char((( comissao.saldo*0.60 ) + semcomissao.saldo),'999G999G999G999G999G990D00'))
                       end saldo
                from ( 
                       select sum(w.valorfaltadevolver) saldo
                       from vw_balanco_romance_v4_com w
                       where w.idrepresentante = :P554_IDREPRESENTANTE 
                         and w.idgerente = ( select idgerente 
                                             from gerentes
                                             where idfilial = :P0_IDFILIAL )
                     ) comissao
                   , ( 
                       select sum(w.valorfaltadevolver) saldo
                       from vw_balanco_romance_v4_sem w
                       where w.idrepresentante = :P554_IDREPRESENTANTE 
                         and w.idgerente = ( select idgerente 
                                             from gerentes
                                             where idfilial = :P0_IDFILIAL )
                     ) semcomissao
                ```
        }
        layout {
            sequence: 20
            parentRegion: @resultado
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: R1
            valueColumn: SALDO
            color: yes
        }
    )

    region saldo-com-desconto (
        name: Saldo com Desconto 22,5%
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Resultado com Desconto 22,5%' r1
                     , case
                         when exists ( select 1
                                       from vw_filiais f
                                       where f.idfilial = :P0_IDFILIAL 
                                         and f.idgrupo = 5 ) then
                           trim(to_char(((( comissao.saldo*0.70 )*0.775) + (semcomissao.saldo*0.775)),'999G999G999G999G999G990D00'))
                         else
                           trim(to_char(((( comissao.saldo*0.60 )*0.775) + (semcomissao.saldo*0.775)),'999G999G999G999G999G990D00'))
                       end saldo
                from ( 
                       select sum(w.valorfaltadevolver) saldo
                       from vw_balanco_romance_v4_com w
                       where w.idrepresentante = :P554_IDREPRESENTANTE 
                         and w.idgerente = ( select idgerente 
                                             from gerentes
                                             where idfilial = :P0_IDFILIAL )
                     ) comissao
                   , ( 
                       select sum(w.valorfaltadevolver) saldo
                       from vw_balanco_romance_v4_sem w
                       where w.idrepresentante = :P554_IDREPRESENTANTE 
                         and w.idgerente = ( select idgerente 
                                             from gerentes
                                             where idfilial = :P0_IDFILIAL )
                     ) semcomissao
                ```
        }
        layout {
            sequence: 30
            parentRegion: @resultado
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: R1
            valueColumn: SALDO
            color: yes
        }
    )

    region valor-vendeu-detalhado (
        name: Valor Vendeu Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select sum(w.vendaliquida) vendaliquida
                     , sum(w.comissaoconsultora) comissaoconsulta
                     , sum(w.debitospagos) debitospagos
                     , sum(w.valorpagoconsultora) pagoconsultora
                from vw_venda_balanco_v3 w
                where w.idrepresentante = :P554_IDREPRESENTANTE 
                  and w.idgerente = ( select idgerente 
                                      from gerentes
                                      where idfilial = :P0_IDFILIAL )
                
                ```
        }
        layout {
            sequence: 150
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent9
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color="BLUE"><b>* Valor Vendeu = Venda Líquida + Comissão Consultora.<br></b></font>
                <font color="GREEN"><b>* Valor Pago pela Consultora não está somando no Valor Vendeu, é apenas informação.</b></font><br>
                <font color="GRAY"><b>* Débitos pagos não está somando no Valor Vendeu, é apenas informação.</b></font><br>
                ```
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
