page 631 (
    name: Carregar Arquivo
    title: Carregar Arquivo
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region carregar-arquivo (
        name: Carregar Arquivo
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: style="width:100%;max-width:none;"
        }
        settings {
            outputAs: text
        }
    )

    region dados-mensagem (
        name: Dados Mensagem
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <b>Informações:</b><br><br>
                <b> < PRIMEIRONOME > </b> - O sistema entende que deve colocar o primeiro nome da consultora no texto.<br><br>
                ```
        }
    )

    region etapa-do-processo (
        name: Etapa do Processo
        type: list
        source {
            list: @data-load-wizard-progress-disparo-sms-3
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            excludeTitleFromTranslation: true
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    pageItem P631_APP_DATE_FORMAT (
        type: radioGroup
        label {
            label: Date / Number Formats to use
            alignment: rightTop
        }
        lov {
            type: sharedComponent
            lov: @date-format-opt
            displayNullValue: false
        }
        layout {
            sequence: 150
            region: @carregar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Y
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Choose whether to provide custom or to use standard format masks
        }
    )

    pageItem P631_CANAL (
        type: radioGroup
        label {
            label: Canal de Disparo
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC:Comunicação Análise de Crédito;25,Comunicação Cobrança;40,Comunicação Call Center;41
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @dados-mensagem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P631_CHAR_SET (
        type: selectList
        label {
            label: File Character Set
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: sharedComponent
            lov: @data-load-charset
            displayNullValue: false
        }
        layout {
            sequence: 140
            region: @carregar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: UTF-8
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: DATA_LOAD.CHAR_SET_ITEM_HELP
        }
    )

    pageItem P631_COPY_PASTE (
        type: textarea
        label {
            label: Copy and Paste Delimited Data
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 15
            region: @carregar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 80
            height: 10
        }
        advanced {
            customAttributes: spellcheck="false"
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P631_CURRENCY (
        type: textField
        label {
            label: Currency Symbol
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 130
            region: @carregar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 2
        }
        validation {
            maxLength: 2
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select value
                  from nls_session_parameters
                 where parameter = 'NLS_CURRENCY'
                ```
        }
        default {
            type: static
            staticValue: $
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: If your data contains international currency symbol, enter it here. For example, if your data has "&euro;1,234.56" or "&yen;1,234.56", enter "&euro;" or "&yen;".  Otherwise the data will not load correctly.
        }
    )

    pageItem P631_DATADISPARO (
        type: datePickerJquery
        label {
            label: Data Disparo
            alignment: left
        }
        layout {
            sequence: 30
            region: @dados-mensagem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr hh24:mi:ss
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P631_DECIMAL_CHARACTER (
        type: textField
        label {
            label: Decimal Character
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 110
            region: @carregar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 2
        }
        validation {
            maxLength: 2
        }
        source {
            type: expression
            plsqlExpression: apex_application.get_nls_decimal_separator
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText:
                ```html
                <p>The decimal character separates the integer and decimal parts of a number.</p>
                <p> Any character can be the decimal character. The character specified must be single-byte, and the decimal character must be different from group separator. The character can be a space, but cannot be any numeric character or any of the following characters:</p>
                <ul class="noIndent">
                <li>plus (+)</li>
                <li>hyphen (-)</li> 
                <li>less than sign (<)</li>
                <li>greater than sign (>)</li> 
                </ul>
                ```
        }
    )

    pageItem P631_ENCLOSED_BY (
        type: textField
        label {
            label: Optionally Enclosed By
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carregar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 2
        }
        validation {
            maxLength: 2
        }
        default {
            type: static
            staticValue: "
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Enter a delimiter character. You can use this character to delineate the starting and ending boundary of a data value. If you specify a delimiter character, Data Workshop ignores whitespace occurring before the starting and ending boundary of a data value. You can also use this option to enclose a data value with the specified delimiter character.
        }
    )

    pageItem P631_FILE_NAME (
        type: fileUpload
        label {
            label: Informe o Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            type: appTempFiles
            purgeFileAt: endOfRequest
        }
        layout {
            sequence: 20
            region: @carregar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Name of the file to upload
        }
    )

    pageItem P631_FIRST_ROW (
        type: checkboxGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Primeira linha contém cabeçalho;Y
        }
        layout {
            sequence: 50
            region: @carregar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Y
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Select this box if your data contains column names in the first row.
        }
    )

    pageItem P631_GROUP_SEPARATOR (
        type: textField
        label {
            label: Group Separator
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 120
            region: @carregar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 2
        }
        validation {
            maxLength: 2
        }
        source {
            type: expression
            plsqlExpression: apex_application.get_nls_group_separator
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText:
                ```html
                <p>A group separator is a character that separates integer groups, for example to show thousands and millions.</p>
                <p>Any character can be the group separator. The character specified must be single-byte, and the group separator must be different from any other decimal character. The character can be a space, but cannot be a numeric character or any of the following:</p>
                <ul class="noIndent">
                <li>plus (+)</li>
                <li>hyphen (-)</li> 
                <li>less than sign (<)</li>
                <li>greater than sign (>)</li> 
                </ul>
                ```
        }
    )

    pageItem P631_IDMENSAGEMDISPARO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @dados-mensagem
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P631_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                
                select p.nome
                     , p.idpais
                from paises p
                where p.idpais in (1,2,4)
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @dados-mensagem
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: static
            staticValue: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P631_IMPORT_FROM (
        type: radioGroup
        label {
            label: Importar
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @data-load-option
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @carregar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: UPLOAD
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P631_MENSAGEM (
        type: textField
        label {
            label: Mensagem
            alignment: left
        }
        layout {
            sequence: 20
            region: @dados-mensagem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 150
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P631_SEPARATOR (
        type: textField
        label {
            label: Separator
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carregar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 2
        }
        validation {
            valueRequired: true
            maxLength: 2
        }
        default {
            type: static
            staticValue: ;
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Identify a column separator character. Use <code>\t</code> for tab separators.
        }
    )

    pageItem P631_SHOW_ADV_SETTINGS (
        type: checkboxGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Opções Avançadas;Y
        }
        layout {
            sequence: 55
            region: @carregar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText:
                ```html
                Display advanced settings for data loading: Currency Symbol, Decimal Characters, File Encoding or Date Formats
                
                ```
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @carregar-arquivo
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 631
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Próximo
        layout {
            sequence: 20
            region: @carregar-arquivo
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.textareaClob.uploadNonEmpty('P631_COPY_PASTE', 'NEXT');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction import-from-copy-and-paste (
        name: Import From Copy and Paste
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P631_IMPORT_FROM
        }
        clientSideCondition {
            type: item=value
            item: P631_IMPORT_FROM
            value: PASTE
        }

        action native-hide (
            action: hide
            settings {
                hidePageItemsOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P631_COPY_PASTE
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: \t
            }
            affectedElements {
                selectionType: items
                items: P631_SEPARATOR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-show (
            action: show
            settings {
                showAllOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P631_COPY_PASTE
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction import-from-file (
        name: Import from File
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P631_IMPORT_FROM
        }
        clientSideCondition {
            type: item=value
            item: P631_IMPORT_FROM
            value: UPLOAD
        }

        action native-hide (
            action: hide
            settings {
                hidePageItemsOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P631_FILE_NAME
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: ,
            }
            affectedElements {
                selectionType: items
                items: P631_SEPARATOR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-show (
            action: show
            settings {
                showAllOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P631_FILE_NAME
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction show-hide-advanced-settings (
        name: Show/Hide Advanced Settings
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P631_SHOW_ADV_SETTINGS
        }
        clientSideCondition {
            type: item=value
            item: P631_SHOW_ADV_SETTINGS
            value: Y
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P631_CURRENCY
                    P631_GROUP_SEPARATOR
                    P631_DECIMAL_CHARACTER
                    P631_APP_DATE_FORMAT
                    P631_CHAR_SET
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P631_CURRENCY
                    P631_GROUP_SEPARATOR
                    P631_DECIMAL_CHARACTER
                    P631_APP_DATE_FORMAT
                    P631_CHAR_SET
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    validation filename-is-not-null (
        name: Filename is not null
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P631_FILE_NAME
        }
        error {
            errorMessage: #LABEL# must have some value.
            associatedItem: @P631_FILE_NAME
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: item=value
            item: P631_IMPORT_FROM
            value: UPLOAD
        }
    )

    validation uploaded-data-is-not-null (
        name: Uploaded data is not null
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P631_COPY_PASTE
        }
        error {
            errorMessage: #LABEL# must have some value.
            associatedItem: @P631_COPY_PASTE
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: item=value
            item: P631_IMPORT_FROM
            value: PASTE
        }
    )

    process parse-uploaded-data (
        name: Parse Uploaded Data
        type: parseUploadedData
        dataLoading {
            dataLoadDefinition: @disparo-sms
        }
        sourceData {
            importFromItem: P631_IMPORT_FROM
            fileNameItem: P631_FILE_NAME
            copyAndPasteItem: P631_COPY_PASTE
            charSetItem: P631_CHAR_SET
            dateFormatItem: P631_APP_DATE_FORMAT
        }
        parsingOptions {
            separatorItem: P631_SEPARATOR
            enclosedByItem: P631_ENCLOSED_BY
            firstRowItem: P631_FIRST_ROW
            currencySymbolItem: P631_CURRENCY
            groupSeparatorItem: P631_GROUP_SEPARATOR
            decimalCharItem: P631_DECIMAL_CHARACTER
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 123411413919500512
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

    process processo-dml-em-mensagens-disparos (
        name: Processo DML em Mensagens Disparos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidmensagemdisparo number;
                  vmd5 varchar2(4000);
                  vdata date;
                  vusuario varchar2(100) := v('APP_USER');
                begin
                  -- 
                  vdata := to_date(:P631_DATADISPARO,'DD/MM/RRRR HH24:MI:SS');
                  --
                  pck_cadastros_rmc.prc_mensagensdisparos(pidmensagemdisparo => vidmensagemdisparo,
                                                          pidpais => :P631_IDPAIS,
                                                          pmensagem => :P631_MENSAGEM,
                                                          pdatadisparo => vdata,
                                                          pcanal => :P631_CANAL,
                                                          pusuario => vusuario,
                                                          pmd5 => vmd5,
                                                          poperacao_dml => 'I');
                  --
                  :P631_IDMENSAGEMDISPARO := vidmensagemdisparo;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 123281852211162214
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

    branch (
        name: Go To Page 632
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 632
                items: {
                    P632_IDMENSAGEMDISPARO: &P631_IDMENSAGEMDISPARO.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)

