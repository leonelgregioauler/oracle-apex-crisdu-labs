    region erros (
        name: Erros
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DATAERRO
                     , substr(observacao,0,instr(observacao,' User-Defined')) observacao
                from erroimportacarga t
                where idfilial = :P0_IDFILIAL
                  and sysdate - dataerro < 0.006
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
