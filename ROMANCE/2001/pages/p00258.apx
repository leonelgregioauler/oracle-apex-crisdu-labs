            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            customAttributes: "onkeyPress=\"javascript:{formatar_mascara(this, '##/###',event); }\" "
        }
        security {
            encryptSessionState: false
        }
    )

