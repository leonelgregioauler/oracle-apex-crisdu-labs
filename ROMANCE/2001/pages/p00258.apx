    region distribuir (
        name: Distribuir
        type: tabform
        source {
            sqlQuery:
                ```sql
                select ROWID
                     , IDREPRESENTATE
                     , QUANTIDADE
                     , pck_romance.fnc_nomerepresentante(idREPRESENTATE ) ||' <br> <i> '|| ( select pck_romance.fnc_nomeregiaovenda(idregiaovenda) 
                                                                                      from regioesrepresentantes
                                                                                      where semana           = g.SEMANA
                                                                                        and idrepresentante  = g.IDREPRESENTATE )||'</i>' representante
                     , (select sum(gg.quantidade) ||' / <i> '||trim(to_char(sum(gg.quantidade * e.vlrvenda),'999G999G999G999G990D00'))||'</i>'
                                     ||' / <b> '
                           
                        from gerarcargas_temp gg
                           , estoquefilial e
                        where e.idestoquefilial = gg.idestoque
                          and gg.semana         = g.SEMANA
                          and gg.idrepresentate = g.IDREPRESENTATE
                          and gg.quantidade      > 0) ||
                   case 
                            when ( select count(1) 
                                                                 from notasvendas n
                                                                 where ( ( idrepresentante  = g.IDREPRESENTATE and idrepresentanteatende is null ) or idrepresentanteatende  = g.IDREPRESENTATE ) 
                                                                   and n.idregiaovenda   = ( select idregiaovenda 
                                                                                              from regioesrepresentantes
                                                                                              where semana           = g.SEMANA
                                                                                                and idrepresentante  = g.IDREPRESENTATE ) 
                                                                   and trim(n.semanacobranca) = g.semana 
                                                                   and n.idsituacaonotavenda != 5
                                                                   and n.idsituacaonotavenda > 1 ) <= 0 then
                                  '0'
                             else
                                  trim(to_char(  (select sum(gg.quantidade)            
                                                  from gerarcargas_temp gg
                                                     , estoquefilial e
                                                  where e.idestoquefilial = gg.idestoque
                                                    and gg.semana         = g.SEMANA
                                                    and gg.idrepresentate = g.IDREPRESENTATE
                                                    and gg.quantidade      > 0)/
                                                 ( select count(1) 
                                                   from notasvendas n
                                                   where ( ( idrepresentante  = g.IDREPRESENTATE and idrepresentanteatende is null ) or idrepresentanteatende  = g.IDREPRESENTATE ) 
                                                     and n.idregiaovenda   = ( select idregiaovenda 
                                                                                from regioesrepresentantes
                                                                                where semana           = g.SEMANA
                                                                                  and idrepresentante  = g.IDREPRESENTATE ) 
                                                     and trim(n.semanacobranca) = g.semana 
                                                     and n.idsituacaonotavenda != 5
                                                                   and n.idsituacaonotavenda > 1 ) ,'999G999G999G999G990'))||'  </b> '
                                                                   end       qtddistribuido
                
                     , ( select count(1) ||' <br> <i> '||trim(to_char(sum(n.valortotalnota)* 0.675/2 ,'999G999G999G999G990D00'))||'</i>'
                         from notasvendas n
                         where ( ( idrepresentante  = g.IDREPRESENTATE and idrepresentanteatende is null ) or idrepresentanteatende  = g.IDREPRESENTATE ) 
                           and n.idregiaovenda   = ( select idregiaovenda 
                                                      from regioesrepresentantes
                                                      where semana           = g.SEMANA
                                                        and idrepresentante  = g.IDREPRESENTATE ) 
                           and trim(n.semanacobranca) = g.semana 
                           and n.idsituacaonotavenda != 5
                           and n.idsituacaonotavenda > 1 )  qtdnotas
                
                     , ( select count(1)||' <br> <i> '||trim(to_char( sum(n.valortotalnota)* 0.675/2 ,'999G999G999G999G990D00'))||'</i>'
                         from notasvendas n
                         where ( ( idrepresentante  = g.IDREPRESENTATE and idrepresentanteatende is null ) or idrepresentanteatende  = g.IDREPRESENTATE ) 
                           and n.idregiaovenda   != ( select idregiaovenda 
                                                       from regioesrepresentantes
                                                       where semana           = g.SEMANA
                                                        and idrepresentante  = g.IDREPRESENTATE )
                           and n.idsituacaonotavenda != 5
                           and trim(n.semanacobranca) = g.semana 
                          -- and n.semanadistribuicao   = pck_romance.fnc_semanaciclo(g.semana)--trim(n.semanacobranca) = psemana
                           and n.idsituacaonotavenda > 1 )  notasemaberto
                     
                       , nvl( ( select sum(nvl(i.quantidade,0))||'/'||sum(nvl(i.quantidade,0) - nvl(i.qtddevolvida,0))
                                                             ||'/'||case 
                                                                       when sum(nvl(i.quantidade,0)) = 0 then
                                                                        '0%' 
                                                                     else 
                                                                        trim(to_char((sum(nvl(i.quantidade,0))-sum(nvl(i.qtddevolvida,0)))*100/sum(nvl(i.quantidade,0)),'999G990'))||'%'
                                                                     end
                              from itensnotavenda i
                              where i.idestoquefil = g.idestoque
                                and exists ( select 1
                                              from notasvendas n
                                              where ( ( idrepresentante  = g.IDREPRESENTATE and idrepresentanteatende is null ) or idrepresentanteatende  = g.IDREPRESENTATE ) 
                                                and n.idregiaovenda   = ( select idregiaovenda 
                                                                           from regioesrepresentantes r
                                                                           where semana           = g.SEMANA
                                                                             and idrepresentante  = g.IDREPRESENTATE ) 
                                                and n.semanacobranca       = pck_util.fnc_semanaid( pck_util.fnc_idsemanaciclo(pck_util.fnc_idsemana( g.semana )))
                                                and n.idsituacaonotavenda  = 4
                                                and n.idnotavenda          = i.idnotavenda ) ),0) vendido
                                                
                     , ( select sum(ic.valorvenda* ( nvl(ic.qtd_dist_pp,0) 
                                                   + nvl(ic.qtd_dist_p,0) 
                                                   + nvl(ic.qtd_dist_m,0) 
                                                   + nvl(ic.qtd_dist_g,0) 
                                                   + nvl(ic.qtd_dist_gg,0) 
                                                   + nvl(ic.qtd_dist_egg,0) 
                                                   + nvl(ic.qtd_dist_exgg,0) 
                                                   + nvl(ic.qtd_dist_u,0) ) )
                         from itenscargarepresentante ic
                            , cargasrepresentantes c
                          where c.idcargarepresentante = ic.idcargarepresentante
                            and c.idrepresentante      = g.idrepresentate
                            and c.semana               = g.semana )  carga
                     , ( select c.idcargarepresentante
                          from cargasrepresentantes c
                          where c.idrepresentante      = g.idrepresentate
                            and c.semana               = g.semana ) idcarga
                from GERARCARGAS_TEMP g
                where idfilial  = :P0_IDFILIAL
                  and semana    = :P258_SEMANA
                  and idestoque = :P258_IDESTOQUE
                  and not exists( select 1
                                  from cargasrepresentantes c
                                  where c.idrepresentante = g.idrepresentate 
                                    and c.semana          = g.semana )
                order by pck_romance.fnc_nomerepresentante(idREPRESENTATE )
                ```
        }
        layout {
            sequence: 60
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: 2
        }
        headerAndFooter {
            headerText:
                ```html
                <b>Alvo e Notas</b> = <i>Refere-se as notas que serão cobradas na semana informada, e que são da região desta semana.</i><br>
                <b>Alvo e Notas Em Aberto</b> = <i>Refere-se as notas que serão cobradas na semana informada, e que <font color="red">NÃO</font> são da região desta semana.</i><br>
                <br>
                <b><font color="red">Atenção:</font></b> <u> Abaixo aparecem todos Distribuidores que estão ativos! Para retirar da lista, inative o cadastro. ( O cadastro será retirado a partir da próxima semana></u>
                
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P258_IDESTOQUE
        }
