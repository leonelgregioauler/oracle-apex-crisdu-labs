    region foto (
        name: Foto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(( select listagg('<a href="'||ft.url||'" target="_blank"> <img src="'||ft.urlreduzida||'" class="img_produto"><a>',' ') within group (order by 1)
                             from fotosprodutos ft 
                             where ft.idproduto = p.idproduto ),'<a href="https://fotosprodutos.romancemoda.com.br/acessar?INDISPONIVEL.JPG" target="_blank"> <img src="https://fotosprodutos.romancemoda.com.br/acessar?INDISPONIVEL.JPG/true" class="img_produto"><a>') foto
                from produtos p
                where idproduto = ( select idproduto 
                                    from estoquefilial e 
                                    where e.idestoquefilial = :P258_IDESTOQUE )
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent11
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from produtos p
                where idproduto = ( select idproduto 
                                    from estoquefilial e 
                                    where e.idestoquefilial = :P258_IDESTOQUE )
                  and  p.linkfoto is not null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 2790863268361868711
        }

        column FOTO (
            type: plainText
            heading {
                heading: Foto
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        savedReport 27922010 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FOTO (
                sequence: 1
            )

        )

    )

