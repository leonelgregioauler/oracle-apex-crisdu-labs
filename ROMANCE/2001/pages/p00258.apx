    process gerar-temp (
        name: gerar_temp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  INSERT into gerarcargas_temp (idfilial,idrepresentate,referencia,semana,idestoque,data)
                  select :P0_IDFILIAL
                       , r.idrepresentante
                       , '-'
                       , :P258_SEMANA
                       ,  ee.idestoquefilial
                       , sysdate
                  from representantes r
                     , estoqueplanilhadistrib ee
                  where idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = ee.idfilial )
                    and ativo = 'S' 
                    and ee.idfilial = :P0_IDFILIAL
                    and ee.semana         = :P258_SEMANA
                    and not exists ( select 1
                                     from gerarcargas_temp e
                                     where e.idfilial       = ee.idfilial
                                       and e.idestoque      = ee.idestoquefilial
                                       and e.semana         = :P258_SEMANA
                                       and e.idrepresentate = r.idrepresentante  );
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 32817333225583210
        }
        serverSideCondition {
            type: request=Value
            value: INICIAR
        }
    )

    process iniciar-atualizar (
        name: Iniciar/atualizar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    --
                    insert into estoqueplanilhadistrib  (idestoquefilial, idfilial, semana, quantidade)
                    select idestoquefilial
                         , :P0_IDFILIAL
                         , :P258_SEMANA
                         , (nvl(e.qtd_pp ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'PP')  )
                         + (nvl(e.qtd_p  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'P')   )
                         + (nvl(e.qtd_m  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'M')   )
                         + (nvl(e.qtd_g  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'G')   )
                         + (nvl(e.qtd_gg ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'GG')  )
                         + (nvl(e.qtd_egg,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EGG') )
                         + (nvl(e.qtd_exgg,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EXGG') )
                         + (nvl(e.qtd_u  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'U'))  estoque
                    from estoquefilial e
                    where e.idfilial = :P0_IDFILIAL
                      and e.ativo = 'S'
                      and comissao is not null
                      and vlrvenda is not null
                      and ((nvl(e.qtd_pp ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'PP')  ) > 0 
                        or (nvl(e.qtd_p  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'P')   ) > 0 
                        or (nvl(e.qtd_m  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'M')   ) > 0 
                        or (nvl(e.qtd_g  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'G')   ) > 0 
                        or (nvl(e.qtd_gg ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'GG')  ) > 0 
                        or (nvl(e.qtd_egg,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EGG') ) > 0 
                        or (nvl(e.qtd_exgg,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EXGG') ) > 0 
                        or (nvl(e.qtd_u  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'U')) > 0  )
                      and not exists ( select 1
                                       from estoqueplanilhadistrib ee
                                       where ee.idestoquefilial = e.idestoquefilial
                                         and ee.semana          = :P258_SEMANA );
                    --
                    update estoqueplanilhadistrib ee
                    set (ee.quantidade)  = ( select (nvl(e.qtd_pp ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'PP')  )
                                             + (nvl(e.qtd_p  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'P')   )
                                             + (nvl(e.qtd_m  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'M')   )
                                             + (nvl(e.qtd_g  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'G')   )
                                             + (nvl(e.qtd_gg ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'GG')  )
                                             + (nvl(e.qtd_egg,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EGG') )
                                             + (nvl(e.qtd_exgg,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EXGG') )
                                             + (nvl(e.qtd_u  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'U'))  
                                            from estoquefilial e
                                            where e.idestoquefilial = ee.idestoquefilial )
                    where ee.idfilial = :P0_IDFILIAL
                      and ee.semana   = :P258_SEMANA;
                    --
                    commit;
                    --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 32816473968583202
        }
        serverSideCondition {
            type: request=Value
            value: INICIAR
        }
    )

