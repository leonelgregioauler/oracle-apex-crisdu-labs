    region disponivel (
        name: Disponivel
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select --case
                        -- when quantidade - distribuido > 0 then
                        --    '<a href="javascript:window.location='''||APEX_UTIL.PREPARE_URL('f?p=2001:258:'||v('APP_SESSION')||'::NO::P258_IDESTOQUE,P258_DISPONIVEL,P258_DISTRIBUIDO,P258_SALDO,P258_SEMANA:'
                        --                                                                                            ||e.idestoquefilial||','||e.quantidade||','||distribuido||','|| to_char(quantidade - distribuido)||','||e.semana ,'SESSION') ||'''"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                        -- else
                        --   '-'
                        -- end 
                            '<a href="javascript:iniciar('||e.idestoquefilial||','||e.quantidade||','||distribuido||','|| to_char(quantidade - distribuido)||','''||e.semana||''')"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                        editar 
                     , idestoquefilial
                     , idfilial
                     , semana
                     , classificacao1
                     , classificacao2
                     , categoria
                     , produto
                     , quantidade
                     , vlrvenda
                     , comissao
                     , distribuido
                     , quantidade - distribuido saldo
                from ( select e.idestoquefilial
                           , e.idfilial
                           , e.semana
                           , ee.classificacao1
                           , ee.classificacao2
                           , ( select c.nome
                               from categorias c
                               where c.idcategoria = ( select idcategoria
                                                       from produtos p
                                                       where p.idproduto = ee.idproduto ) ) categoria
                           , pck_romance.fnc_nomeproduto(ee.idproduto) produto
                           , e.quantidade
                           , ee.vlrvenda
                           , DECODE(ee.comissao,'S','Sim','Não') comissao
                           , nvl(( select sum(g.quantidade)
                                   from gerarcargas_temp g
                                   where g.idestoque = ee.idestoquefilial
                                     and g.semana    = e.semana
                                     and not exists ( select 1
                                                      from cargasrepresentantes  cr
                                                      where cr.idrepresentante  = g.idrepresentate
                                                        and cr.semana           = g.semana 
                                                    --    and cr.situacao         in ( 0,3) 
                                                    ) ),0) distribuido
                      from estoqueplanilhadistrib e
                         , estoquefilial ee
                      where e.idestoquefilial  = ee.idestoquefilial
                        and ee.idfilial        = :P0_IDFILIAL
                        and e.idfilial         = ee.idfilial        
                        and e.semana           = :P258_SEMANA
                        and ( :P258_CLASSIFICACAO1 = 'T' 
                                 OR ( :P258_CLASSIFICACAO1 = 'Z' and ee.classificacao1 is null )
                                 or ( :P258_CLASSIFICACAO1 not in ('T','Z') and ee.classificacao1 = :P258_CLASSIFICACAO1 ) )
                        and ( :P258_CLASSIFICACAO2 = 'T' 
                                 OR ( :P258_CLASSIFICACAO2 = 'Z' and ee.classificacao2 is null )
                                 or ( :P258_CLASSIFICACAO2 not in ('T','Z') and ee.classificacao2 = :P258_CLASSIFICACAO2 ) )
                        and ( :P258_QUANTIDADE is null or e.quantidade       > :P258_QUANTIDADE)
                        and (:P258_IDCATEGORIA = -1 or ( exists ( select 1 
                                                                  from produtos p 
                                                                  where p.idproduto = ee.idproduto
                                                                    and p.idcategoria = :P258_IDCATEGORIA)) ) ) e
                ```
        }
