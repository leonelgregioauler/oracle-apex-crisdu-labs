    pageItem P258_IDCATEGORIA (
        type: selectList
        label {
            label: Categoria
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nome        display_value
                     , c.idcategoria return_value
                from categorias c
                   , produtos p
                   , estoquefilial ee
                where c.idcategoria = p.idcategoria
                  and p.idproduto   = ee.idproduto
                  and ee.idfilial   = :P0_IDFILIAL
                  and exists ( select 1
                               from estoqueplanilhadistrib e
                               where e.idestoquefilial = ee.idestoquefilial
                                 and e.semana          = :P258_SEMANA 
                                 and quantidade > 0)
                union
                select '- Mostrar todas -' 
                     , -1
                from dual
                order by 1
                ```
            nullDisplayValue: "- Selecione a opção - "
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

