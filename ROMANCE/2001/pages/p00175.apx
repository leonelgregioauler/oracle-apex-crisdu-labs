page 175 (
    name: Imprime Devolução
    title: Imprime Devolução
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region imprime-devolução (
        name: Imprime Devolução
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_imprime.prc_imprimedevolucao( vidrepresentante => :P175_IDREPRESENTANTE
                                                  , vsemana          => :P175_SEMANA );
                end;
                ```
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
    )

    pageItem P175_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @imprime-devolução
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P175_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @imprime-devolução
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

