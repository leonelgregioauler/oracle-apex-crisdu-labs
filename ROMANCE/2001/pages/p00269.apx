page 269 (
    name: Rank Pedidos Clientes V
    title: Rank Pedidos Clientes V
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region rank-pedidos-clientes (
        name: Rank Pedidos Clientes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(p.idvendedora) Vendedora
                     , sum(nvl(p.VLRTOTALSEMCOMISSAO,0)) Valor
                     , pck_romance.fnc_nomerepresentante(p.idrepresentante) Empreendedor
                     , pck_romance.fnc_retornatelefones(p.idvendedora) Telefone
                from catal.pedidos p
                where p.idfilial = :P0_IDFILIAL
                  and (:P269_IDREPRESENTANTE is null or p.idrepresentante = :P269_IDREPRESENTANTE)
                  and p.situacao != 'Z'
                  and p.idpedido > 500000
                group by p.idvendedora
                       , p.idrepresentante
                order by 2 desc
                ```
            pageItemsToSubmit: P269_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <b> Rank por pedidos! Rank não conta pedidos cancelados. </b>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 54797006562289646
        }

        column EMPREENDEDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column TELEFONE (
            type: plainText
            heading {
                heading: Telefone
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column VENDEDORA (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 548025 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn EMPREENDEDOR (
                sequence: 1
            )

            displayColumn TELEFONE (
                sequence: 3
            )

            displayColumn VALOR (
                sequence: 4
            )

            displayColumn VENDEDORA (
                sequence: 2
            )

            sort (
                column: VALOR
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            aggregate (
                column: VALOR
            )

            controlBreak (
                column: EMPREENDEDOR
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P269_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @representantes
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P269_IDREPRESENTANTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @rank-pedidos-clientes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 269
                items: {
                    P269_IDREPRESENTANTE: &P269_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
    )

)

