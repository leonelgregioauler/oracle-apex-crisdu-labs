    region pagamentos-favorita-realizados-pela-cobrança (
        name: "Pagamentos Favorita Realizados pela Cobrança "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialromance(p.idfilialromance) Franquia
                     , favorita.pck_util_fav.fnc_nomerepresentante(p.idrepresentante) Distribuidor
                     , favorita.pck_util_fav.fnc_nomevendedora(p.idvendedora) Consultora
                     , nvl(favorita.pck_util_fav.fnc_cpfvendedora(p.idvendedora), favorita.pck_util_fav.fnc_docestrangeiro(p.idvendedora)) doc
                     , p.idpedido
                     , pg.valorpago
                     , ( pg.valorpago * f.fatorconversao ) Pagoconv
                     , nvl(pg.databaixa,pg.datapagamento) Data_pagamento
                     , ( select LISTAGG (DISTINCT u.usuario||' ')
                           from favorita.historicospedidos h 
                              , catal.usuarios u
                              , roman.opcaobaixaporperda op
                           where u.idusuario = h.idusuario
                             and op.idopcaobaixaperda = h.idopcaobaixaperda
                             and h.idpedido = p.idpedido ) Usuário
                from favorita.pedidos p
                   , favorita.vencimentospedidos vp
                   , favorita.pagamentospedidos pg
                   , roman.vw_filiais f
                where p.idpedido = vp.idpedido
                  and vp.idvencimentopedido = pg.idvencimentopedido
                  and p.idfilialromance = f.idfilial
                  and pg.origempagamento = 'C'
                  and (:P260_IDFILIAL is null or (:P260_IDFILIAL = -1 and p.idfilialromance in ( select idfilial
                                                                                                 from roman.vw_filiais v
                                                                                                 where v.idfilial = p.idfilialromance
                                                                                                   and v.idgrupo != 5 --Grupo Brasil
                                                                                                   and v.tipofilial = 'D'
                                                                                                   and v.ativo = 'S' ))
                                              or (:P260_IDFILIAL = -2 and p.idfilialromance in ( select idfilial
                                                                                                 from roman.vw_filiais v
                                                                                                 where v.idfilial = p.idfilialromance
                                                                                                   and v.idgrupo = 5 --Grupo exterior
                                                                                                   and v.tipofilial = 'D'
                                                                                                   and v.ativo = 'S' ))
                                              or p.idfilialromance in :P260_IDFILIAL)
                  and trunc(nvl(pg.databaixa,pg.datapagamento)) between to_date(:P260_DTINI,'dd/mm/rrrr') and to_date(:P260_DTFIM,'dd/mm/rrrr')
                  and :P260_ORIGEMDEBITO = 'F'
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P260_TIPO = 'C'
                  and :P260_ORIGEMDEBITO = 'F'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1507283051354144915
        }

