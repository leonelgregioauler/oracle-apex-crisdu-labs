    region pagamentos-romance-realizados-por-motivo-de-perda (
        name: Pagamentos Romance Realizados Por Motivo de Perda
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.numeronota
                     , pck_romance.fnc_nomefilial(n.idfilial) Filial
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) representante
                     , pck_romance.fnc_nomevendedora(n.idvendedora) vendedora
                     , nvl(favorita.pck_util_fav.fnc_cpfvendedora(n.idvendedora), favorita.pck_util_fav.fnc_docestrangeiro(n.idvendedora))doc
                     , pg.valorpago
                     , (pg.valorpago * f.fatorconversao) valorpagoConvert
                     , pg.datapagamento
                     , nvl(( select max(vc.descricao)
                          from roman.vw_classificacoesnotasvendas vc
                          where vc.idcaracteristicanotavenda = 43
                            and vc.idnotavenda = n.idnotavenda),'Sem Motivo') Motivo
                  , (select distinct lpg.usuarioalteracao 
                     from logroman.log_pagamentosnotasvendas lpg
                     where lpg.idnotavenda = pg.idnotavenda
                       and lpg.idpagtonotavenda = pg.idpagtonotavenda
                       and lpg.tipoalteracao = 'INSERT' ) usuario
                  , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||n.idnotavenda ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>'  irparanota
                from notasvendas n
                   , pagamentosnotasvendas pg
                   , roman.vw_filiais f
                where pg.idnotavenda = n.idnotavenda
                  and n.idfilial     = f.idfilial
                  and pg.origem = 'P'
                  and (:P260_IDFILIAL is null or (:P260_IDFILIAL = -1 and n.idfilial in ( select idfilial
                                                                                          from roman.vw_filiais v
                                                                                          where v.idgrupo != 5 --Grupo Brasil
                                                                                            and v.tipofilial = 'D'
                                                                                            and v.ativo = 'S' ))
                                              or (:P260_IDFILIAL = -2 and n.idfilial in ( select idfilial
                                                                                          from roman.vw_filiais v
                                                                                          where v.idgrupo = 5 --Grupo exterior
                                                                                            and v.tipofilial = 'D'
                                                                                            and v.ativo = 'S' ))
                                              or n.idfilial in :P260_IDFILIAL)
                  and trunc(pg.datapagamento) between to_date(:P260_DTINI,'dd/mm/rrrr') and to_date(:P260_DTFIM,'dd/mm/rrrr')
                  and :P260_ORIGEMDEBITO = 'R'
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P260_TIPO = 'P'
                  and :P260_ORIGEMDEBITO = 'R'
                ```
        }
