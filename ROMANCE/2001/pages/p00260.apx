    pageItem P260_IDFILIAL (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select '- Brasil - ' display_value
                     , -1 return_value
                from dual
                
                union all
                
                select '- Exterior - ' display_value
                     , -2 return_value
                from dual
                
                union all
                
                select roman.pck_romance.fnc_nomefilial(f.idfilial) display_value
                     , f.idfilial return_value
                from catal.filiais f
                where f.ativo = 'S'
                  and f.idfilial != 1217
                  and f.tipofilial = 'D'
                  and exists ( select 1
                               from usuariosfiliais u
                               where u.idfilial  = f.idfilial
                                 and u.usuario   = v('APP_USER') )
                order by 1 
                                 
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @tipo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: static
            staticValue: -1
        }
        security {
            encryptSessionState: false
        }
    )

