page 820 (
    name: Dados Cupom
    alias: DADOS-CUPOM
    title: Dados Cupom
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 50
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region brindes (
        name: Brindes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.nomebrinde 
                     , b.idbrindeclube
                     , (select cc.nomeclassif
                        from roman.conquistoulevouclassificacoes cc
                        where cc.idclassificacao = it.idclassificacao) classificação
                     , (select cr.nomecaracteristica
                        from roman.conquistoulevoucaracteristicas cr
                        where cr.idcaracteristica = it.idcaracteristica ) característica
                from roman.brindesclub b
                   , roman.itensconqlevcupons it 
                where it.idbrindeclube = b.idbrindeclube
                  and it.idconquistoulevoucupom = :P820_CUPOM
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 23225865584672002
        }

        column CARACTERÍSTICA (
            type: plainText
            heading {
                heading: Característica
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column CLASSIFICAÇÃO (
            type: plainText
            heading {
                heading: Classificação
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDBRINDECLUBE (
            type: plainText
            heading {
                heading: Id brindeclube
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column NOMEBRINDE (
            type: plainText
            heading {
                heading: Brinde
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 232375 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CARACTERÍSTICA (
                sequence: 3
            )

            displayColumn CLASSIFICAÇÃO (
                sequence: 2
            )

            displayColumn NOMEBRINDE (
                sequence: 1
            )

        )

    )

    region cupom-conquistou-levou (
        name: "Cupom Conquistou Levou "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
    )

    pageItem P820_CUPOM (
        type: displayOnly
        label {
            label: Cupom
            alignment: left
        }
        layout {
            sequence: 40
            region: @cupom-conquistou-levou
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
    )

    pageItem P820_DATARESGATE (
        type: displayOnly
        label {
            label: Data Resgate
            alignment: left
        }
        layout {
            sequence: 50
            region: @cupom-conquistou-levou
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD-MON-YYYY
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select ge.dataemissao 
                from roman.guiasentregasbrindes ge
                where ge.idguiaentregabrinde = :P820_GUIA
                ```
        }
    )

    pageItem P820_DISTRIBUIDOR (
        type: displayOnly
        label {
            label: Distribuidor
            alignment: left
        }
        layout {
            sequence: 30
            region: @cupom-conquistou-levou
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(v.idrepresentante)
                  from catal.vendedoras v 
                  where v.idvendedora = :P820_IDVENDEDORA
                ```
        }
    )

    pageItem P820_DOCUMENTO (
        type: displayOnly
        label {
            label: Documento
            alignment: left
        }
        layout {
            sequence: 20
            region: @cupom-conquistou-levou
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(p.cpf,p.documentoestrangeiro) documento
                from catal.pessoas p 
                   , catal.vendedoras v 
                where p.idpessoa = v.idpessoa
                  and v.idvendedora = :P820_IDVENDEDORA
                ```
        }
    )

    pageItem P820_GUIA (
        type: hidden
        layout {
            sequence: 60
            region: @cupom-conquistou-levou
            slot: regionBody
        }
    )

    pageItem P820_IDVENDEDORA (
        type: hidden
        layout {
            sequence: 70
            region: @cupom-conquistou-levou
            slot: regionBody
        }
    )

    pageItem P820_RECEBIDOPOR (
        type: displayOnly
        label {
            label: "Recebido Por: "
            alignment: left
        }
        layout {
            sequence: 80
            region: @cupom-conquistou-levou
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomeusuario(u.usuario)
                from catal.usuarios u 
                where u.idusuario = (select gb.idusuario
                                     from roman.guiasentregasbrindes gb
                                     where gb.idguiaentregabrinde = :P820_GUIA)
                ```
        }
        default {
            type: item
            item: P820_RECEBIDOPOR
        }
    )

    pageItem P820_VENDEDORA (
        type: displayOnly
        label {
            label: Empreendedora
            alignment: left
        }
        layout {
            sequence: 10
            region: @cupom-conquistou-levou
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 819
        execution {
            sequence: 10
            point: processing
        }
        behavior {
            target: {
                page: 819
                items: {
                    P819_GUIAENVIO: &P820_GUIA.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
        }
    )

)

