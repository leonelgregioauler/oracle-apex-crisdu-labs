page 826 (
    name: Impressão Cupom em Lote
    title: Impressão Cupom em Lote
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region dados (
        name: Dados
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
    )

    region lista-a-imprimir (
        name: Lista  a Imprimir
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select clc.loteimpressao
                     , clc.idconquistoulevoucupom
                     , p.nomepessoa
                     , roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) distribuidor
                     , nvl(p.cpf,p.documentoestrangeiro) documento
                     , clc.dataresgate
                     , clc.dataretirada
                from roman.conquistoulevoucupons clc
                   , catal.vendedoras v
                   , catal.pessoas p
                   , apex_collections c
                where c.collection_name = 'CUPONS_SEL'
                  and c.c001 = clc.idconquistoulevoucupom
                  and clc.idvendedora = v.idvendedora
                  and v.idpessoa = p.idpessoa
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }

        column DATARESGATE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Data Resgate Cupom
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI
            }
        )

        column DATARETIRADA (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Data Retirada Brinde
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI
            }
        )

        column DISTRIBUIDOR (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 60
            }
        )

        column DOCUMENTO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: CPF/DOC
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
        )

        column IDCONQUISTOULEVOUCUPOM (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Cupom
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
        )

        column LOTEIMPRESSAO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Lote Impressão
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
        )

        column NOMEPESSOA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: "Consultora "
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

    )

    pageItem P826_IDREPRESENTANTE (
        type: hidden
        layout {
            sequence: 50
            region: @ações
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(:P826_IDREPRESENTANTE) Nome 
                from dual;
                ```
        }
    )

    pageItem P826_LOTEIMPRESSAO (
        type: hidden
        layout {
            sequence: 60
            region: @ações
            slot: regionBody
        }
    )

    pageItem P826_RESPONSAVEL (
        type: hidden
        layout {
            sequence: 40
            region: @ações
            slot: regionBody
        }
    )

    button imprimedist (
        buttonName: IMPRIMEDIST
        label: Termo Distribuidor
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button imprimelote (
        buttonName: IMPRIMELOTE
        label: Termo Consultora
        layout {
            sequence: 20
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction abre-impresão-termo-consultora (
        name: "Abre Impresão Termo Consultora "
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @imprimelote
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var url = apex.util.makeApplicationUrl({
                        pageId: 828,
                        clearCache: 828,
                        itemNames: ["P828_IDREPRESENTANTE","P828_RESPONSAVEL"],
                        itemValues: [
                            $v("P826_IDREPRESENTANTE"),
                            $v("P826_RESPONSAVEL")
                        ]
                    });
                    
                    window.open(url, "_blank");
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction abre-impresão-termo-distribuidor (
        name: Abre Impresão Termo Distribuidor
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @imprimedist
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var url = apex.util.makeApplicationUrl({
                        pageId: 827,
                        clearCache: 827,
                        itemNames: ["P827_IDREPRESENTANTE","P827_RESPONSAVEL"],
                        itemValues: [
                            $v("P826_IDREPRESENTANTE"),
                            $v("P826_RESPONSAVEL")
                        ]
                    });
                    window.open(url, "_blank");
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process busca-dados (
        name: "Busca Dados "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vidrepresentante number;
                  vloteimpressao   number;
                  vresponsavel     varchar2(50);
                  --
                begin
                  -- busca id do usuário logado
                  --select roman.pck_romance.fnc_nomeusuario(u.idusuario)
                   --= into vresponsavel
                  --from catal.usuarios u 
                  --where u.usuario = v('APP_USER');
                
                    select p.nomepessoa
                    into vresponsavel
                  from catal.usuarios u
                     , catal.pessoas p
                  where p.idpessoa = u.idpessoa
                    and u.usuario = v('APP_USER');
                
                  :P826_RESPONSAVEL := vresponsavel;
                
                  -- busca idrepresentante da collection
                  begin
                    select min(v.idrepresentante),  min(clc.loteimpressao)
                      into vidrepresentante, vloteimpressao
                    from apex_collections c
                       , roman.conquistoulevoucupons clc
                       , catal.vendedoras v
                    where c.collection_name = 'CUPONS_SEL'
                      and c.c001 = clc.idconquistoulevoucupom
                      and v.idvendedora = clc.idvendedora;
                
                    :P826_IDREPRESENTANTE := vidrepresentante;
                    :P826_LOTEIMPRESSAO   := vloteimpressao;
                
                  exception
                    when no_data_found then
                      :P826_IDREPRESENTANTE := null;
                      :P826_LOTEIMPRESSAO   := null;
                  end;
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 23480999062187602
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 823
                clearCache: 823
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
        }
    )

)

