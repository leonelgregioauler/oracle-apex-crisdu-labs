        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
    )

    pageItem P836_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select d, r
                from (
                select 'Todos' d
                     , -1 r
                     , 0 ord
                 from dual
                 union
                select distinct pa.nome d
                     , pa.idpais r
                     , 1 ord
                  from roman.campanhasconquistoulevou cp 
                     , catal.paises pa
                 where cp.idpais = pa.idpais
                order by ord asc
                )
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
    )

