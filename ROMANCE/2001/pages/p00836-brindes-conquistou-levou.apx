    pageItem P836_IDCONQUISTOULEVOU (
        type: selectList
        label {
            label: Campanha
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT d, r
                FROM (
                    SELECT 'Todos'              d,  -1                    r, 0 ord FROM dual
                    UNION ALL
                    SELECT ccl.nomecampanha     d,  ccl.idconquistoulevou r, 1 ord
                    FROM roman.campanhasconquistoulevou ccl
                    WHERE (:P836_IDPAIS = -1 OR ccl.idpais = :P836_IDPAIS)
                )
                ORDER BY ord, d
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P836_IDPAIS
            itemsToSubmit: [
                P836_IDPAIS
                P836_IDCONQUISTOULEVOU
            ]
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
    )

    pageItem P836_IDFILIAL (
        type: selectList
        label {
            label: Franquia/Loja
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomefilial
                     , idfilial
                 from roman.vw_franquia_loja_conquistou_levou
                where idpais in ( select cp.idpais
                                    from roman.campanhasconquistoulevou cp 
                                    where ( :P836_IDCONQUISTOULEVOU = -1 or cp.idconquistoulevou = :P836_IDCONQUISTOULEVOU )
                                      and ( :P836_idpais = -1 or cp.idpais = :P836_idpais) )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: Todos
            nullReturnValue: -1
        }
        cascadingLov {
            parentItems: [
                P836_IDPAIS
                P836_IDCONQUISTOULEVOU
            ]
            itemsToSubmit: [
                P836_IDPAIS
                P836_IDCONQUISTOULEVOU
            ]
        }
        layout {
