    region itens-faltantes (
        name: Itens Faltantes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.franquia
                     , t.nr_guia
                     , t.nomecampanha
                     , t.brinde 
                     , t.classificacao 
                     , t.caracteristica
                     , t.tipo_produto_brinde
                     , sum(t.qtdfaltante) qtdfaltante
                  from(
                select ifa.idbrindeclube
                     , fil.nomefilial franquia
                     , geb.idguiaentregabrinde nr_guia
                     , ccl.nomecampanha
                     , bc.nomebrinde brinde
                     , (select clc.nomeclassif
                        from roman.conquistoulevouclassificacoes clc
                        where clc.idclassificacao = cbc.idclassificacao) classificacao
                     , (select cca.nomecaracteristica
                        from roman.conquistoulevoucaracteristicas cca
                        where cca.idcaracteristica = cbc.idcaracteristica) caracteristica
                     , ifa.qtdfaltante
                     , (select descricao from table(catal.pck_util.fnc_siglasistema('TIPO_PRODUTO_BRINDE_CONQUISTOU_LEVOU',bc.tipoproduto)) ) AS tipo_produto_brinde
                from roman.itensfaltantes           ifa
                   , roman.classificacoesbrindesclub cbc
                   , roman.guiasentregasbrindes      geb
                   , roman.campanhasconquistoulevou  ccl
                   , roman.vw_franquia_loja_conquistou_levou fil
                   , roman.brindesclub bc
                where ifa.idclassifbrindeclub  = cbc.idclassifbrindeclub
                  and ifa.idguiaentregabrinde  = geb.idguiaentregabrinde
                  and geb.idconquistoulevou    = ccl.idconquistoulevou
                  and geb.idfilial             = fil.idfilial
                  and ifa.idbrindeclube = bc.idbrindeclube
                  and ifa.qtdfaltante          < 0
                  and ( :P836_IDPAIS           = -1 or ccl.idpais            = :P836_IDPAIS )
                  and ( :P836_IDFILIAL         = -1 or geb.idfilial          = :P836_IDFILIAL )
                  and (:P836_IDCONQUISTOULEVOU = -1 or ccl.idconquistoulevou = :P836_IDCONQUISTOULEVOU )
                  ) t
                group by all
                order by t.nr_guia, t.brinde
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P836_TP_RELATORIO
            value: 2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 512257703960613330
        }

