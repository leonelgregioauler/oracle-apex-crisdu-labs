    region separação-de-brindes (
        name: Separação de Brindes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    roman.pck_romance.fnc_nomefilial(clc.idfilialretira)  AS franquia
                  , roman.pck_romance.fnc_nomevendedora(clc.idvendedora)  AS consultora
                  , geb.idguiaentregabrinde                               AS nr_guia
                  , clc.idconquistoulevoucupom                            AS nr_cupom
                  , initcap(bc.nomebrinde)                                AS nome_brinde
                  , initcap(cl.nomecaracteristica)                        AS caracteristica_brinde
                  , SUM(icl.qtditem)                                      AS quantidade
                  , (select descricao
                       from table(catal.pck_util.fnc_siglasistema('TIPO_PRODUTO_BRINDE_CONQUISTOU_LEVOU',
                                                                    bc.tipoproduto))) AS tipo_produto_brinde
                  , MAX(CASE
                      WHEN clc.dataentrega     IS NOT NULL THEN 'Entregue'
                      WHEN clc.dataretirada    IS NOT NULL THEN 'Retirado Distribuidor'
                      WHEN clc.datarecebfilial IS NOT NULL THEN 'Recebido Franquia/Loja'
                      WHEN clc.dataenviofilial IS NOT NULL THEN 'Enviado Franquia/Loja'
                      WHEN clc.dataguia        IS NOT NULL THEN 'Em separação CD'
                      ELSE 'Criado'
                    END)                                                  AS situacao_cupom
                  , (SELECT CASE 
                                 WHEN EST.TIPOFILIAL = 'FR' THEN
                                   CASE 
                                     WHEN EST.DATAENVIOFILIAL IS NOT NULL THEN 'Completo'
                                     WHEN EST.DATAGUIA IS NOT NULL THEN 'Processamento'
                                     ELSE 'Criado' END
                                 ELSE (SELECT DESCRICAO FROM TABLE(CATAL.PCK_UTIL.FNC_SIGLASISTEMA('TIPO_SITUACAO_CONQ_LEVOU_CUPONS',EST.SITUACAO)) )
                                   END SITUACAO_ESTOQUE
                        FROM (SELECT CUP.DATARESGATE
                                    ,CUP.DATAGUIA
                                    ,CUP.SITUACAO
                                    ,CUP.DATAENVIOFILIAL
                                    ,NVL((SELECT PAR.VALOR
                                      FROM ROMAN.PARAMETROS PAR
                                      WHERE PAR.IDFILIAL = CUP.IDFILIALRETIRA
                                        AND PAR.NOME     = 'CONQUISTOULEVOULOJA'),'LJ') TIPOFILIAL
                              FROM ROMAN.CONQUISTOULEVOUCUPONS CUP
                              WHERE CUP.IDCONQUISTOULEVOUCUPOM = CLC.IDCONQUISTOULEVOUCUPOM) EST)           AS SITUACAO_ESTOQUE
                FROM roman.guiasentregasbrindes      geb
                JOIN roman.campanhasconquistoulevou  ccl ON ccl.idconquistoulevou      = geb.idconquistoulevou
                JOIN roman.guiasentregascupons       gec ON gec.idguiaentregabrinde    = geb.idguiaentregabrinde
                JOIN roman.conquistoulevoucupons     clc ON clc.idconquistoulevoucupom = gec.idconquistoulevoucupom
                JOIN roman.itensconqlevcupons        icl ON icl.idconquistoulevoucupom = clc.idconquistoulevoucupom
                JOIN roman.brindesclub               bc  ON bc.idbrindeclube           = icl.idbrindeclube
                JOIN roman.conquistoulevoucaracteristicas cl ON cl.idcaracteristica    = icl.idcaracteristica
                WHERE ( :P836_IDPAIS            = -1 or ccl.idpais            = :P836_IDPAIS)
                  AND ( :P836_IDFILIAL          = -1 or clc.idfilialretira    = :P836_IDFILIAL)
                  AND ( :P836_IDCONQUISTOULEVOU = -1 or ccl.idconquistoulevou = :P836_IDCONQUISTOULEVOU)
                GROUP BY
                    clc.idfilialretira
                  , clc.idvendedora
                  , geb.idguiaentregabrinde
                  , clc.idconquistoulevoucupom
                  , icl.idbrindeclube
                  , bc.nomebrinde
                  , icl.idcaracteristica
                  , cl.nomecaracteristica
                  , bc.tipoproduto
                order by roman.pck_romance.fnc_nomefilial(clc.idfilialretira) , geb.idguiaentregabrinde, roman.pck_romance.fnc_nomevendedora(clc.idvendedora) asc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P836_TP_RELATORIO
            value: 1
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            savePublicReport: true
            subscription: false
        }
        download {
            formats: pdf
        }
        advanced {
            savedReportMappingIdentifier: 836010000000000007
        }

