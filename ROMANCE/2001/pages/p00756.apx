page 756 (
    name: Inadimplência Detalhada
    title: Inadimplência Detalhada
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region inadimplência-detalhada (
        name: Inadimplência Detalhada
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select romance.total total_romance
                     , romance.debitosnovos debitos_romance
                     , favorita.total total_favorita
                     , favorita.debitos debitos_favorita
                     , round(pck_romance.FNC_DIVISOR_ZERO((romance.debitosnovos+favorita.debitos),(romance.total+favorita.total))*100,2) inadimplencia
                from ( 
                      select sum(totaldebitosnovos) debitosnovos
                           , sum(totalgeral+totaldebitosnovos) total
                      from fechamentossemanais ff 
                         , fechamentorepresentantes fr
                         , campanhasfiliais cf
                      where fr.idrepresentante = :P756_IDREPRESENTANTE
                        and fr.idfechamentopontuacao = ff.idfechamento
                        and cf.idcampanhafilial = :P756_IDCAMPANHAFILIAL
                        and 1 = 2
                        and ff.idsemana between cf.idsemanainicio and cf.idsemanafim 
                     ) romance
                   , ( 
                      select ((t.total_pagar) - (valor_pago_emdia) - (pago_30dias) - (pago_42dias) - (pago_90dias)) debitos
                           , (t.total_pagar) total
                      from (
                            select p.idrepresentante 
                                 , roman.pck_romance.fnc_nomerepresentante(p.idrepresentante) distribuidor
                                 , count(1) Qtd_Vencimentos 
                                 , sum(nvl(v.valorpagar,0) * nvl(p.fatorconversao,1)) total_pagar 
                                 , sum( nvl(pg.valorpago,0) * nvl(p.fatorconversao,1)) total_pago
                                 , sum( case  
                                          when nvl(pg.datapagamento,pg.databaixa) <= v.datavencimento 
                                            then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                          else 
                                            0 
                                        end )  valor_pago_emdia
                                 , sum( case 
                                          when nvl(pg.datapagamento,pg.databaixa) between v.datavencimento + 1 and v.datavencimento + 30 
                                            then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                          else 
                                            0 
                                        end ) pago_30dias
                                 , sum( case  
                                          when nvl(pg.datapagamento,pg.databaixa) between v.datavencimento + 31 and v.datavencimento + 42 
                                            then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                          else 
                                            0 
                                        end ) pago_42dias
                                 , sum( case 
                                          when nvl(pg.datapagamento,pg.databaixa) between v.datavencimento + 43 and v.datavencimento + 90 
                                            then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                          else 
                                            0 
                                        end ) pago_90dias
                             from favorita.vencimentospedidos v                 
                                , favorita.pedidos p                            
                                , favorita.filiaisfavorita f      
                                , semana_dias s
                                , campanhasfiliais cf                       
                                , (select sum(valorpago) valorpago             
                                        , min(trunc(datapagamento)) datapagamento
                                        , min(trunc(databaixa)) databaixa   
                                        , idvencimentopedido                    
                                     from favorita.pagamentospedidos                     
                                    where idsituacao = 20                       
                                    group by idvencimentopedido ) pg
                            where v.idpedido = p.idpedido 
                              and p.idfilialromance is not null  
                              and cf.idcampanhafilial = :P756_IDCAMPANHAFILIAL
                              and s.idsemana = cf.idsemanainicio                             
                              and p.datacancelamento is null                            
                              and v.situacaovencimento = 'V'         
                              and p.idrepresentante = :P756_IDREPRESENTANTE 
                              and p.idfilialfavorita = f.idfilialfavorita                   
                              and v.idvencimentopedido = pg.idvencimentopedido(+)    
                              and trunc(p.dataemissao) >= s.dt_ini
                              and v.valorpagar > 0                      
                              and 1 = 2
                              and trunc(v.datavencimento) between s.dt_ini and trunc(sysdate)-1
                            group by p.idrepresentante ) t 
                     ) favorita
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 3076124191773249810
        }

