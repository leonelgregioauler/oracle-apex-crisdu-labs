    region inadimplência-detalhada-2 (
        name: Inadimplência Detalhada
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.faturamento_rmc total_romance
                     , i.debitos_rmc debitos_romance
                     , i.faturamento_fav total_favorita
                     , i.debitos_fav debitos_favorita
                     , round(pck_romance.FNC_DIVISOR_ZERO((debitos_rmc+debitos_fav),(faturamento_rmc+faturamento_fav))*100,2) inadimplencia
                     , round(i.inad_rmc,2) inad_rmc
                     , round(i.inad_fav,2) inad_fav
                from inadimplenciacampanhas i
                where i.idinadimplenciacampanha = ( select max(ii.idinadimplenciacampanha)
                                                    from inadimplenciacampanhas ii
                                                    where ii.idrepresentante = :P756_IDREPRESENTANTE )
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
