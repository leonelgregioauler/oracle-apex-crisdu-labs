                    ```sql
                    -- Validacao adicionada no T10389382
                    select 1
                      from catal.usuarios u
                         , catal.gerentes g
                         , catal.filiais f
                     where u.idpessoa = g.idpessoa
                       and g.idfilial = f.idfilial
                       and f.tipofilial = 'D' -- Distribuidora (Franquia)
                       and u.usuario = v('APP_USER')
                    ```
