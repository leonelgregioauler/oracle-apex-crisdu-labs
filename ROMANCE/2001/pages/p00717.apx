    region itens (
        name: ITENS
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region placar (
        name: Placar
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select x.tipo
                     , nvl(x.qtd,0) qtd
                from ( select 'Inclusão' tipo
                            , count(1) qtd
                       from vw_negativacao_spc_lote
                       union
                       select 'Exclusão' tipo
                           , count(1) qtd
                       from vw_exclusao_spc_lote ) x
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: TIPO
            valueColumn: QTD
            color: yes
        }
    )

    pageItem P717_TIPO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @itens
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

