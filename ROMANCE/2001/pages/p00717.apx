    region documentos-para-exclusão (
        name: Documentos para Exclusão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idnotavenda,
                       w.idvendedora,
                       w.idpessoa,
                       w.cpf,
                       w.nomepessoa,
                       w.datanascimento,
                       w.email,
                       w.endereco,
                       w.bairro,
                       w.numero,
                       w.cidade,
                       w.sigla,
                       w.cep,
                       w.numerocontrato,
                       w.valorcontrato,
                       w.datacontrato,
                       w.datavencimento
                from vw_exclusao_spc_lote w
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
