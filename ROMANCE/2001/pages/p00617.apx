page 617 (
    name: Detalhes de Despesas das Filiais
    title: Detalhes de Despesas das Filiais
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region detalhe-de-despesas (
        name: Detalhe de Despesas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P617_DATA (
        type: textField
        label {
            label: Data Criação
            alignment: left
        }
        layout {
            sequence: 30
            region: @detalhe-de-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P617_IDDETALHEDESPESA
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P617_DETALHE (
        type: textarea
        label {
            label: Detalhe
            alignment: left
        }
        layout {
            sequence: 50
            region: @detalhe-de-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
            height: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P617_IDDETALHEDESPESA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @detalhe-de-despesas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P617_IDFILIAL (
        type: hidden
