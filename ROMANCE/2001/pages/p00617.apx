            valueProtected: false
        }
        layout {
            sequence: 20
            region: @detalhe-de-despesas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P617_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @detalhe-de-despesas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P617_USUARIO (
        type: textField
        label {
            label: Usuário
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @detalhe-de-despesas
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P617_IDDETALHEDESPESA
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 40
            region: @detalhe-de-despesas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P617_IDDETALHEDESPESA
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 20
            region: @detalhe-de-despesas
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P617_IDDETALHEDESPESA
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 30
            region: @detalhe-de-despesas
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P617_IDDETALHEDESPESA
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @detalhe-de-despesas
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 81
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process processo-dml-em-detalhes-de-despesa (
        name: Processo DML em Detalhes de Despesa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdata date;
                begin
                  --
                  PCK_ACERTOS_RMC.PRC_DETALHESDESPESASFILIAIS( PIDDETALHEDESPESA => :P617_IDDETALHEDESPESA,
                                                               PIDFILIAL => :P617_IDFILIAL,
                                                               PDATA => vdata,
                                                               PUSUARIO => :P617_USUARIO,
                                                               PDETALHE => :P617_DETALHE,
                                                               PMD5 => :P617_MD5,
                                                               POPERACAO_DML => 'S');
                  --
                  :P617_DATA := to_char(vdata,'DD/MM/RRRR HH24:MI:SS');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5643137094564989820
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P617_IDDETALHEDESPESA
        }
    )

    process processo-dml-em-detalhes-de-despesas (
        name: Processo DML em Detalhes de Despesas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vusuario varchar2(100) := v('APP_USER');
                  vdata date;
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'SALVAR' then
                    --
                    voperacao_dml := 'U';
                    --
                  elsif v('REQUEST') = 'DELETAR' then
                    --
                    voperacao_dml := 'D';
                    --
                  end if;
                  --
                  PCK_ACERTOS_RMC.PRC_DETALHESDESPESASFILIAIS( PIDDETALHEDESPESA => :P617_IDDETALHEDESPESA,
                                                               PIDFILIAL => :P617_IDFILIAL,
                                                               PDATA => vdata,
                                                               PUSUARIO => vusuario,
                                                               PDETALHE => :P617_DETALHE,
                                                               PMD5 => :P617_MD5,
                                                               POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5655304949365360164
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('CRIAR','SALVAR','DELETAR')
        }
    )

)

