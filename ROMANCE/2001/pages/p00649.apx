page 649 (
    name: Perdas - Condições de Pagamento
    title: Perdas - Condições de Pagamento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region condições-de-pagamento (
        name: Condições de Pagamento
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region nova-perda (
        name: Nova Perda
        type: list
        source {
            list: @nova-perda
        }
        layout {
            sequence: 40
            slot: dialogHeader
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    pageItem P649_DATAVENCIMENTO (
        type: datePickerJquery
        label {
            label: Data 1a Parcela
            alignment: left
        }
        layout {
            sequence: 50
            region: @condições-de-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 20
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P649_FORMADEPAGAMENTO (
        type: selectList
        label {
            label: Forma de Pagamento
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Depósito;D,Cartão de Crédito;C,Boleto;B
        }
        layout {
            sequence: 30
            region: @condições-de-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P649_IDNEGOCIACAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @condições-de-pagamento
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P649_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @condições-de-pagamento
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P649_PARCELAS (
        type: numberField
        label {
            label: Nr de Parcelas
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @condições-de-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P649_VALORTOTAL (
        type: numberField
        label {
            label: Valor
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @condições-de-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            valueRequired: true
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vtotal number;
                  --
                begin
                  --
                  select sum(d.valor)
                  into vtotal
                  from documentosnegociacao d
                  where d.idnegociacaoparceiro = :P649_IDNEGOCIACAO;
                  --
                  return vtotal;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button gerar-negociacao (
        buttonName: GERAR_NEGOCIACAO
        label: Gerar Negociação
        layout {
            sequence: 20
            region: @condições-de-pagamento
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @condições-de-pagamento
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 648
                items: {
                    P648_IDNEGOCIACAO: &P649_IDNEGOCIACAO.
                    P648_IDREPRESENTANTE: &P649_IDREPRESENTANTE.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process gera-negociação (
        name: Gera Negociação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- 
                  pck_negociacoes_rmc.prc_finalizanegociacaoperda(pidnegociacaoparceiro => :P649_IDNEGOCIACAO,
                                                                  pformapagamento => :P649_FORMADEPAGAMENTO,
                                                                  pparcelas => :P649_PARCELAS,
                                                                  pvalortotal => :P649_VALORTOTAL,
                                                                  pdataentrada => :P649_DATAVENCIMENTO);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 32587463308143217
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 650
                items: {
                    P650_IDNEGOCIACAOPARCEIRO: &P649_IDNEGOCIACAO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @gerar-negociacao
        }
    )

)

