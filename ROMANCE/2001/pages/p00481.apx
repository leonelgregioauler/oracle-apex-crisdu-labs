    pageItem P481_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and f.idgrupo is not null
                ```
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P481_IDPAIS (
        type: radioGroup
        label {
            label: País
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Brasil;1,Paraguai;4,Uruguay;2,Chile;6,Portugal;11,Peru;8,Mexico;12,Panama;13
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P481_IDREPRESENTANTE (
        type: selectOne
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' ('||decode(ativo,'S','Ativo','N','Inativo')||')' d
                     , idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P481_IDFILIAL )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P481_IDFILIAL
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P481_PAGO (
        type: radioGroup
        label {
            label: Pagamento Realizado?
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N,Ambos;A
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        default {
            type: static
            staticValue: A
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P481_TIPODATA (
        type: radioGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Pagamento;P,Envio Desfeito;D,Fechamento;F,Pagamentos Tablet;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        default {
            type: static
            staticValue: D
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process período-vigente (
        name: Período Vigente
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vde date;
                  vate date;
                  --
                begin
                  --
                  select de
                       , ate
                  into vde
                     , vate
                  from vw_periodo_metas w 
                  where w.data = trunc(sysdate);
                  --
                  :P481_DATAINICIOVIG  := to_date(vde,'DD/MM/RRRR');
                  :P481_DATAFIMVIG := to_date(vate,'DD/MM/RRRR');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 9861273357396026
        }
        serverSideCondition {
            type: itemIsNull
            item: P481_DATAINICIOVIG
        }
    )

    branch (
        name: Go To Page 481
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 481
                items: {
                    P481_IDFILIAL: &P481_IDFILIAL.
                    P481_IDREPRESENTANTE: &P481_IDREPRESENTANTE.
                    P481_PAGO: &P481_PAGO.
                    P481_DATAINICIO: &P481_DATAINICIO.
                    P481_DATAFIM: &P481_DATAFIM.
                    P481_TIPODATA: &P481_TIPODATA.
                    P481_IDPAIS: &P481_IDPAIS.
                    P481_DATAINICIOVIG: &P481_DATAINICIOVIG.
                    P481_DATAFIMVIG: &P481_DATAFIMVIG.
                    P481_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: BUSCAR
        }
    )

)

