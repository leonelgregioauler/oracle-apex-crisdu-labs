    region notas-desfeitas-envio-da-cobrança (
        name: Notas Desfeitas Envio da Cobrança
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                  11035508 - Gabriel Andriola - 25/11/2025
                  Adicionada coluna com o cpf da vendedora, busca a partir da vw_vendedoras
                  View vw_notasdesfeitasenvio foi alterada
                */
                select n.idnotavenda
                     , n.numeronota
                     , n.dataclassificado 
                     , n.dataenviadocobranca
                     , n.usuario
                     , n.empresa
                     , n.representante
                     , ( select nvl(vw.cpf_vendedora,vw.docestrangeiro_vendedora)
                         from roman.vw_vendedoras vw
                         where vw.idvendedora = n.idvendedora) documento
                     , n.vendedora
                     , n.saldo
                     , n.saldocongelado
                     , n.valorpago
                     , n.responsavelcobranca
                     , n.maiorpagamento
                     , n.qtdpagamentos
                     , ( select sum (pgt.valorpago)
                         from pagamentosnotasvendas pgt
                         where pgt.idnotavenda = n.idnotavenda
                           and pgt.origem != 'C'
                           and trunc(pgt.datapagamento) between to_date(:P481_DATAINICIOVIG) and to_date(:P481_DATAFIMVIG)) "VALOR PAGO NO MÊS VIGENTE"
                from vw_notasdesfeitasenvio n
                   , catal.filiais f
                where n.idfilial = f.idfilial
                  and ( :P481_TIPODATA is null
                     or ( :P481_TIPODATA = 'F' and trunc(n.dataclassificado) between to_date(:P481_DATAINICIO) and to_date(:P481_DATAFIM)
                                               and exists ( select 1 
                                                            from pagamentosnotasvendas pg
                                                            where pg.idnotavenda = n.idnotavenda
                                                              and pg.origem != 'C'
                                                              and trunc(pg.datapagamento) between to_date(:P481_DATAINICIO) and to_date(:P481_DATAFIM) ) )
                     or ( :P481_TIPODATA = 'D' and trunc(n.dataclassificado) between to_date(:P481_DATAINICIO) and to_date(:P481_DATAFIM) )
                     or ( :P481_TIPODATA = 'P' and exists ( select 1 
                                                            from pagamentosnotasvendas pg
                                                            where pg.idnotavenda = n.idnotavenda
                                                              and pg.origem != 'C'
                                                              and trunc(pg.datapagamento) between to_date(:P481_DATAINICIO) and to_date(:P481_DATAFIM) )
                                               and trunc(n.dataclassificado) between to_date(:P481_DATAINICIO) and to_date(:P481_DATAFIM) ) )
                  and ( :P481_IDFILIAL is null or n.idfilial = :P481_IDFILIAL )
                  and ( :P481_IDREPRESENTANTE is null or n.idrepresentante = :P481_IDREPRESENTANTE )
                  and ( :P481_PAGO = 'A' 
                      or ( :P481_PAGO = 'N' and not exists ( select 1 
                                                             from pagamentosnotasvendas pg
                                                             where trunc(pg.datapagamento) >= trunc(n.dataclassificado)
                                                               and pg.idnotavenda          = n.idnotavenda ) ) 
                      or ( :P481_PAGO = 'S' and exists ( select 1 
                                                         from pagamentosnotasvendas pg
                                                         where trunc(pg.datapagamento) >= trunc(n.dataclassificado)
                                                           and pg.origem               != 'C'
                                                           and pg.idnotavenda           = n.idnotavenda ) ) )
                  and ( :P481_IDPAIS is null or f.ididioma  = :P481_IDPAIS)
                  and :P481_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item!=value
            item: P481_TIPODATA
            value: T
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1544166185951594518
        }

