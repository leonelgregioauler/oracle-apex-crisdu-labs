    region pagamentos-tablet (
        name: "Pagamentos Tablet "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                  11035508 - Gabriel Andriola - 25/11/2025
                  Adicionada coluna com o cpf da vendedora, busca a partir da vw_vendedoras
                  View vw_notasdesfeitasenvio foi alterada
                */
                select sum(x.valorpago) valorpago
                       /*( select nvl(sum (pgt.valorpago),0)
                         from pagamentosnotasvendas pgt
                         where pgt.idnotavenda = x.idnotavenda
                           and pgt.origem != 'C'
                           and trunc(pgt.datapagamento) between to_date(:P481_DATAINICIOVIG) and to_date(:P481_DATAFIMVIG)) valorpago*/
                     , max(x.datapagamento) datapagamento
                     , count(x.idpagtonotavenda) qtd_pag
                     , x.saldo
                     , x.saldo + sum(x.valorpago) saldo_congelado
                     , x.idnotavenda
                     , x.dataenviadocobranca
                     , x.nome
                     , x.dist
                     , x.franquia
                     , x.numeronota
                     , x.responsavelcobranca "Resp. Cobrança"
                     , x.cpf_vendedora "CPF Vendedora"
                from ( select distinct pg.idnotavenda
                            , nv.dataenviadocobranca
                            , pg.datapagamento
                            , nv.saldo
                            , pg.valorpago
                            , pg.idpagtonotavenda
                            , nv.numeronota
                            , roman.pck_romance.fnc_nomevendedora(nv.idvendedora) nome
                            , roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) dist
                            , f.nome franquia
                            , nv.responsavelcobranca
                            , vend.cpf_vendedora
                       from notasvendas nv
                          , pagamentosnotasvendas pg
                          , classificacoesnotasvendas cl
                          , vw_filiais f
                          , vw_vendedoras vend
                       where nv.idnotavenda = pg.idnotavenda
                         and nv.idfilial    = f.idfilial
                         and nv.idnotavenda = cl.idnotavenda
                         and nv.idvendedora = vend.idvendedora
                         and ( :P481_IDPAIS is null or f.ididioma  = :P481_IDPAIS)
                         and ( :P481_IDFILIAL is null or nv.idfilial = :P481_IDFILIAL )
                         and ( :P481_IDREPRESENTANTE is null or nv.idrepresentante = :P481_IDREPRESENTANTE )
                         and pg.origem not in ('C','P')
                         and pg.valorpago > 0
                         and trunc(pg.datapagamento) > trunc(nv.dataenviadocobranca)
                         and nv.enviadocobranca = 'S'
                         --and trunc(nv.dataenviadocobranca) between to_date(:P481_DATAINICIO) and to_date(:P481_DATAFIM)
                         and trunc(pg.datapagamento) between to_date(:P481_DATAINICIO) and to_date(:P481_DATAFIM)
                         and :P481_FILTRAR = 'S'
                        /* and not exists ( select 1
                                          from classificacoesnotasvendas cl
                                          where cl.idnotavenda = nv.idnotavenda 
                                            and cl.idcaracteristicanotavenda = 11 )*/ ) x
                group by x.saldo
                       , x.idnotavenda
                       , x.dataenviadocobranca
                       , x.nome
                       , x.dist
                       , x.franquia
                       , x.numeronota
                       , x.responsavelcobranca
                       , x.cpf_vendedora
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P481_TIPODATA
            value: T
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
