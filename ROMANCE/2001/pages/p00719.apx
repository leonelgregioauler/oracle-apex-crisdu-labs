    process gerar-tarefa-cobrança-especial-ativo (
        name: Gerar Tarefa Cobrança Especial Ativo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidtarefa             number;
                  vdatainclusao         date          := sysdate;
                  vidsituacao           number        := 50; -- Situação da tarefa, 50 -Tarefa enviada ao Bee.
                  vobservacao           varchar2(500);
                  vidusuario            number        := :P719_RESPCOBRANCA;
                  vidtipotarefa         number        := 44; -- Tarefa de retenção
                  vidpessoa             number;
                  vidgrupoatendimento   number        := 3; -- Grupo de atendimento cobrança.
                  vtelefone             varchar2(30);
                  vidpais               number;
                  vidvendedora          number;  
                  --
                  vnumber               number;
                  vvarchar              varchar2(5);
                  vdata                 date;
                  vexiste               varchar2(1);
                  --
                begin
                  --
                  if APEX_APPLICATION.G_F02.COUNT > 0 then 
                  --
                    FOR i in 1..APEX_APPLICATION.G_F02.COUNT 
                    LOOP
                      --
                      --raise_application_error(-20001, 'xxxxx'||APEX_APPLICATION.G_F02(i));
                      vidvendedora := to_number(APEX_APPLICATION.G_F02(i));
                      --
                      select idpessoa
                        into vidpessoa
                      from vendedoras
                      where idvendedora = vidvendedora;
                      --
                      select idpais
                        into vidpais
                      from pessoas 
                      where idpessoa = vidpessoa;
                      --
                      vobservacao := roman.pck_romance.fnc_retornatelefones(vidvendedora);
                      --
                      begin
                        --
                        select telefone
                          into vtelefone
                        from telefonespessoas t
                        where t.idpessoa = vidpessoa
                          and rownum = 1;
                        --
                        exception 
                          when NO_DATA_FOUND then
                            vtelefone := null;
                       end;
                    --
                      if vidusuario is null then
                        --
                        vidsituacao := 0;
                        --
                      else
                        --
                        vidsituacao := 50;
                        --
                      end if;
                      --
                      favorita.pck_tarefas_fav.prc_tarefas ( pidtarefa                 => vidtarefa,
                                                             pidtipotarefa             => vidtipotarefa,
                                                             pidticketcallcenter       => vnumber,
                                                             ptelefone                 => vtelefone,
                                                             pdatainclusao             => vdatainclusao,
                                                             pprioridade               => vnumber,
                                                             pidsituacao               => vidsituacao,
                                                             pobservacao               => vobservacao,
                                                             pidusuario                => vidusuario,
                                                             pidpessoa                 => vidpessoa,
                                                             pidgrupoatendimento       => vidgrupoatendimento,
                                                             pdatainicio               => vdata,
                                                             pdataconclusao            => vdata,
                                                             pnumeroposicaoatendimento => vvarchar,
                                                             pidpedido                 => vnumber,
                                                             pcodigoarea               => vnumber,
                                                             pidpais                   => vidpais,
                                                             pmd5                      => vvarchar,
                                                             poperacao_dml             => 'I' );
                      --
                      end loop;
                      --
                    end if;
                    --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 2119788818059286411
        }
        serverSideCondition {
            type: never
        }
    )

    process gerar-tarefa-retencao-acordos-quebrados (
        name: Gerar Tarefa Retencao Acordos Quebrados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidtarefa             number;
                  vdatainclusao         date          := sysdate;
                  vidsituacao           number        := 0;   --50;  -- Situação da tarefa, 50 -Tarefa enviada ao Bee. Alexandre solicitou passar situação 0.
                  vidtipotarefa         number        := 44;  -- Tarefa de retenção
                  vidgrupoatendimento   number        := 3; -- Grupo de atendimento cobrança.
                  vidusuario            number;       -- := :P719_RESPCOBRANCA; Alexandre solcitou enviar sem usuário.
                  vidpessoa             number;
                  vtelefone             varchar2(30);
                  vidpais               number;
                  vidvendedora          number;  
                  vnumber               number;
                  vvarchar              varchar2(5);
                  vdata                 date;
                  vexiste               varchar2(1);
                  vidnegociacao         number;
                  vobservacao           varchar2(500); 
                  --
                begin
                  --
                  if APEX_APPLICATION.G_F02.COUNT > 0 then 
                  --
                    FOR i in 1..APEX_APPLICATION.G_F02.COUNT 
                    LOOP
                      --
                      vidvendedora := to_number(APEX_APPLICATION.G_F02(i));
                      --
                      select favorita.seq_idtarefa.nextval
                        into vidtarefa
                      from dual;
                      --
                      select idpessoa 
                        into vidpessoa 
                      from vendedoras
                      where idvendedora = vidvendedora;
                      --
                      select idpais
                        into vidpais
                      from pessoas 
                      where idpessoa = vidpessoa;
                      --
                      select max (n.idnegociacaoparceiro )
                        into vidnegociacao
                      from roman.negociacoesparceiros n
                      where n.idvendedora = vidvendedora
                       and n.dataquebraacordo is not null;
                      --
                      vobservacao := roman.pck_romance.fnc_retornatelefones(vidvendedora);
                      --
                      begin
                        --
                        select telefone
                          into vtelefone
                        from telefonespessoas t
                        where t.idpessoa = vidpessoa
                          and rownum = 1;
                        --
                        exception 
                          when NO_DATA_FOUND then
                            vtelefone := null;
                       end;
                      
                      --
                     -- if vidusuario is null then
                        --
                     --   vidsituacao := 0;
                        --
                    --  else
                        --
                    --    vidsituacao := 50;
                        --
                    --  end if;
                      --
                      insert into favorita.tarefas ( idtarefa      , idtipotarefa              , idticketcallcenter
                                                   , telefone      , datainclusao              , prioridade
                                                   , idsituacao    , observacao                , idusuario
                                                   , idpessoa      , idgrupoatendimento        , datainicio
                                                   , dataconclusao , numeroposicaoatendimento  , idpedido     
                                                   , codigoarea    , idpais                    , datainserida
                                                   , idnegociacaoparceiro )
                      values ( vidtarefa     , vidtipotarefa       , vnumber
                             , vtelefone     , vdatainclusao       , vnumber
                             , vidsituacao   , vobservacao         , vidusuario 
                             , vidpessoa     , vidgrupoatendimento , vdata
                             , vdata         , vnumber             , vnumber  
                             , vnumber       , vidpais             , vdata
                             , vidnegociacao );
                      --
                      end loop;
                      --
                    end if;
                    --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Tarefa(s) Gerada(s) com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 2119788308714286406
        }
        serverSideCondition {
            whenButtonPressed: @gerartarefa
            type: item=value
            item: P719_TIPOBUSCA
            value: Q
        }
    )

