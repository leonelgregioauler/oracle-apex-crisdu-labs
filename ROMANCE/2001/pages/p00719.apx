    pageItem P719_CONSULTORA (
        type: popupLov
        label {
            label: <b>Empreendedora</b>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' CPF: '||p.cpf d
                     , v.idvendedora r
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and ( :P719_DISTRIBUIDOR is null or v.idrepresentante = :P719_DISTRIBUIDOR  )
                  and ( :P719_FRANQUIA is null or v.idfilial = :P719_FRANQUIA )
                  and ( :P719_IDPAIS = 1)
                union
                select initcap(p.nomepessoa)||' Doc. Estran.: '||p.documentoestrangeiro d
                     , v.idvendedora r
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and ( :P719_DISTRIBUIDOR is null or v.idrepresentante = :P719_DISTRIBUIDOR  )
                  and ( :P719_FRANQUIA is null or v.idfilial = :P719_FRANQUIA )
                  and ( :P719_IDPAIS != 1)
                order by 1
                
                ```
        }
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

