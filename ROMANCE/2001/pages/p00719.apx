    region quebra-de-acordos (
        name: Quebra de Acordos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select y.idnegociacao id
                     , y.*
                     , apex_item.CHECKBOX2(2,y.idvendedora, null)CHECK1 --Aqui defino qual campo da linha irá trazer. 
                from (
                select distinct(n.idnegociacaoparceiro) idnegociacao
                     , roman.pck_romance.fnc_nomefilial(n.idfilial) Franquia
                     , roman.pck_romance.fnc_nomevendedora(n.idvendedora) Consultora
                     , n.datanegociacao
                     , n.valornegociacao
                     , n.dataquebraacordo 
                     , x.idvendedora
                     , decode(n.formapagamento,'B','Boleto', 'C','Cartão Crédito','D','Depósito','G','Giro de Pago','P','Pix','T','Giro de Tigo') formapagamento
                     --
                     , ( select nvl(p.cpf,p.documentoestrangeiro) 
                         from catal.pessoas p 
                            , catal.vendedoras v                                                                                                                                                                                            
                         where p.idpessoa = v.idpessoa
                           and v.idvendedora = n.idvendedora ) Documento
                     --
                     , ( select min(pg.datavencimento)
                                from roman.pagamentosnegociacoesparceiros pg
                                where pg.idnegociacaoparceiro = n.idnegociacaoparceiro
                                  and pg.situacao = 'C' ) vencimento
                     --
                     , nvl( ( select sum(p.valorparcela)  -- Total pago na negociação dentro do período filtrado
                              from roman.pagamentosnegociacoesparceiros p
                              where p.idnegociacaoparceiro = n.idnegociacaoparceiro
                                and p.situacao = 'Q' 
                                and (trunc(p.datapagamento) between to_date(:P719_DATAINI,'DD/MM/RRRR') and to_date(:P719_DATAFIM,'DD/MM/RRRR') 
                                    or  p.datapagamento is null and trunc(p.databaixa) between to_date(:P719_DATAINI,'DD/MM/RRRR') and to_date(:P719_DATAFIM,'DD/MM/RRRR'))),0) valorpagovigente  
                     --                 
                     , nvl( ( select sum(p.valorparcela)  -- Total pago na negociação
                              from roman.pagamentosnegociacoesparceiros p
                              where p.idnegociacaoparceiro = n.idnegociacaoparceiro
                                and p.situacao = 'Q' ),0) valorpago
                     --
                     , ( select min(pg.numeroparcela) 
                         from roman.pagamentosnegociacoesparceiros pg
                         where pg.idnegociacaoparceiro = n.idnegociacaoparceiro
                           and pg.situacao = 'C' ) numeroparcela
                     --
                     , ( select decode (y.situacao, 'A','Aberto','Q','Quitado', 'V','Vencido','C','Cancelado')
                         from ( select min(pg.numeroparcela)
                                         , pg.situacao
                                from roman.pagamentosnegociacoesparceiros pg
                                where pg.idnegociacaoparceiro = n.idnegociacaoparceiro
                                  and pg.situacao = 'C' 
                                group by pg.situacao )y ) situacao
                     --
                     , case
                         when 'S' = ( select v.spc 
                                      from catal.vendedoras v
                                      where v.idvendedora = n.idvendedora
                                        and v.spc = 'S' ) then 'Sim'
                         else 'Não'
                       end SPC 
                from roman.negociacoesparceiros n 
                   , ( select max(np.idnegociacaoparceiro) idnegociacao
                                , np.idvendedora
                       from roman.negociacoesparceiros np
                       where np.dataquebraacordo is not null 
                         and trunc(np.dataquebraacordo) between to_date(:P719_DATAINI,'DD/MM/RRRR') and to_date(:P719_DATAFIM,'DD/MM/RRRR')
                       group by np.idvendedora  ) x
                where x.idnegociacao  = n.idnegociacaoparceiro
                 and not exists ( select 1
                                  from favorita.tarefas t
                                     , catal.vendedoras v
                                  where t.idpessoa = v.idpessoa
                                    and v.idvendedora = n.idvendedora
                                    and t.idtipotarefa = 44 )  --Se existe uma (44) - tarefa de retenção não retorna na consulta.
                 and ( exists( select 1
                               from roman.documentosnegociacao d
                               where d.idnegociacaoparceiro = n.idnegociacaoparceiro
                                 and d.idnotavenda is not null 
                                 and exists ( select 1
                                              from roman.notasvendas nv 
                                              where nv.idnotavenda = d.idnotavenda
                                                and nv.saldo > 0 ) )
                              or exists ( select 1
                                          from roman.documentosnegociacao d
                                          where d.idnegociacaoparceiro = n.idnegociacaoparceiro
                                            and d.idpedido is not null 
                                            and exists ( select 1 
                                                         from favorita.pedidos pd
                                                            , favorita.vencimentospedidos vc 
                                                         where vc.idpedido = pd.idpedido
                                                           and pd.idpedido = d.idpedido
                                                           and vc.datavencimento < trunc(sysdate)
                                                           and vc.valorpago < vc.valorpagar
                                                           and vc.situacaovencimento = 'V'
                                                           and not exists ( select 1
                                                                            from favorita.classificacoespedidos c
                                                                            where c.idpedido = pd.idpedido
                                                                              and c.idcaracteristicapedido = 46 )
                                                           and not exists ( select 1
                                                                            from favorita.classificacoespedidos c
                                                                            where c.idpedido = pd.idpedido
                                                                              and c.idcaracteristicapedido = 25 ) ) )
                              or exists ( select 1 
                                          from roman.documentosnegociacao d
                                          where d.idnegociacaoparceiro = n.idnegociacaoparceiro
                                            and d.idpedido is not null 
                                            and exists ( select 1 
                                                         from catal.boletos b
                                                         where b.idboleto = d.idboleto
                                                           and b.situacao in ('V','G','S','M','K','E')) )
                              or exists ( select 1 
                                          from roman.documentosnegociacao d
                                          where d.idnegociacaoparceiro = n.idnegociacaoparceiro
                                            and d.idpedido is not null 
                                            and exists ( select 1 
                                                         from roman.pepinosrepresentantes pr
                                                         where pr.idpepinosrepresentante = d.idpepinorepres 
                                                           and pr.valorsaldo > 0 ) ) )
                  and ( :P719_FILTRAR = 'S')
                  and :P719_TIPOBUSCA = 'Q'
                  and ( :P719_FRANQUIA is null or n.idfilial = :P719_FRANQUIA )
                  and ( :P719_DISTRIBUIDOR is null or n.idrepresentante = :P719_DISTRIBUIDOR )
                  and ( :P719_CONSULTORA is null or n.idvendedora = :P719_CONSULTORA )
                  and ( :P719_IDRESPONSAVEL is null or n.idusuarioresponsavel = :P719_IDRESPONSAVEL )
                  and ( :P719_IDPAIS is null or n.idpais = :P719_IDPAIS)
                  and ( :P719_FORMA_PGTO = 'A' or n.formapagamento = :P719_FORMA_PGTO )
                  and ( :P719_CANAL is null or n.origem = :P719_CANAL) 
                  and ( :P719_SITUACAO = 'T'
                          or ( :P719_SITUACAO = 'Q' and nvl( ( select sum(p.valorparcela)
                                                               from pagamentosnegociacoesparceiros p
                                                               where p.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                 and p.situacao  = 'Q'
                                                                 and p.baixarealizada  = 'S' ),0) > 0 )
                          or ( :P719_SITUACAO = 'A' and n.valornegociacao > n.saldo ) )
                 ) y
                where ( :P719_SPC  = 'T'
                         or ( :P719_SPC = 'S' and y.spc = 'Sim')
                         or ( :P719_SPC = 'N' and y.spc = 'Não') ) 
                  
                ```
        }
