                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region colchão-de-acordos (
        name: Colchão de Acordos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select y.idnegociacao id
                     , y.*
                    -- , apex_item.CHECKBOX2(2,y.idvendedora, null)CHECK1
                from (
                select distinct(n.idnegociacaoparceiro) idnegociacao
                     , roman.pck_romance.fnc_nomefilial(n.idfilial) Franquia
                     , roman.pck_romance.fnc_nomevendedora(n.idvendedora) Consultora
                     , n.datanegociacao
                     , n.valornegociacao
                     , n.idvendedora
                     , decode(n.formapagamento,'B','Boleto', 'C','Cartão Crédito','D','Depósito','G','Giro de Pago','P','Pix','T','Giro de Tigo') formapagamento
                     --
                     , ( select nvl(p.cpf,p.documentoestrangeiro) 
                         from catal.pessoas p 
                            , catal.vendedoras v                                                                                                                                                                                            
                         where p.idpessoa = v.idpessoa
                           and v.idvendedora = n.idvendedora ) Documento
                     --
                     , ( select min(pg.datavencimento)
                         from roman.pagamentosnegociacoesparceiros pg
                         where pg.idnegociacaoparceiro = n.idnegociacaoparceiro
                           and pg.situacao = 'A' ) vencimento
                     --
                     , nvl( ( select sum(p.valorparcela)  -- Total pago na negociação dentro do período filtrado
                              from roman.pagamentosnegociacoesparceiros p
                              where p.idnegociacaoparceiro = n.idnegociacaoparceiro
                                and p.situacao = 'Q' 
                                and (trunc(p.datapagamento) between to_date(:P719_DATAINI,'DD/MM/RRRR') and to_date(:P719_DATAFIM,'DD/MM/RRRR')
                                    or  p.datapagamento is null and trunc(p.databaixa) between to_date(:P719_DATAINI,'DD/MM/RRRR') and to_date(:P719_DATAFIM,'DD/MM/RRRR'))),0) valorpagovigente  
                     --                           
                     , nvl( ( select sum(p.valorparcela)  -- Total pago na negociação
                              from roman.pagamentosnegociacoesparceiros p
                              where p.idnegociacaoparceiro = n.idnegociacaoparceiro
                                and p.situacao = 'Q' ),0) valorpago
                     --
                     , ( select decode (y.situacao, 'A','Aberto','Q','Quitado', 'V','Vencido','C','Cancelado')
                         from ( select min(pg.numeroparcela)
                                     , pg.situacao
                                from roman.pagamentosnegociacoesparceiros pg
                                where pg.idnegociacaoparceiro = n.idnegociacaoparceiro
                                  and pg.situacao = 'A' 
                                group by pg.situacao ) y ) situacao
                     --
                    , ( select count(pp.idpagamentonegociacaoparceiro)
                        from roman.pagamentosnegociacoesparceiros pp 
                        where pp.idnegociacaoparceiro = n.idnegociacaoparceiro) Total
                    --
                    , ( select count(pp.idpagamentonegociacaoparceiro)
                        from roman.pagamentosnegociacoesparceiros pp 
                        where pp.idnegociacaoparceiro = n.idnegociacaoparceiro
                          and pp.situacao = 'Q') TotalQuitadas
                    --
                    , ( select count(pp.idpagamentonegociacaoparceiro)
                        from roman.pagamentosnegociacoesparceiros pp 
                        where pp.idnegociacaoparceiro = n.idnegociacaoparceiro
                          and pp.situacao = 'A') TotalAbertas
                    --
                    , ( select count(pp.idpagamentonegociacaoparceiro)
                        from roman.pagamentosnegociacoesparceiros pp 
                        where pp.idnegociacaoparceiro = n.idnegociacaoparceiro
                          and pp.situacao = 'V') TotalVencidas
                    --
                    , case
                         when 'S' = ( select v.spc 
                                      from catal.vendedoras v
                                      where v.idvendedora = n.idvendedora
                                        and v.spc = 'S' ) then 'Sim'
                         else 'Não'
                       end SPC  
                    --
                from roman.negociacoesparceiros n 
                where trunc(n.datanegociacao) between to_date(:P719_DATAINI,'DD/MM/RRRR') and to_date(:P719_DATAFIM,'DD/MM/RRRR')
                  and n.dataquebraacordo is null
                  and exists ( select 1 
                               from roman.pagamentosnegociacoesparceiros pg
                               where pg.idnegociacaoparceiro = n.idnegociacaoparceiro  -- Busca somente negociações com parcela em aberto.
                                 and pg.situacao = 'A' )
                  --and not exists ( select 1
                                   --from favorita.tarefas t
                                      --, catal.vendedoras v
                                   --where t.idpessoa = v.idpessoa
                                     --and v.idvendedora = n.idvendedora
                                     --and t.idtipotarefa = 44 )  --Se existe uma (44) - tarefa de retenção não retorna na consulta. -- Comentado pois a principio não será gerado tarefas para as negociações ativas em andamento.
                  and ( :P719_FILTRAR = 'S')
                  and   :P719_TIPOBUSCA = 'C'
                  and ( :P719_FRANQUIA is null or n.idfilial = :P719_FRANQUIA )
                  and ( :P719_DISTRIBUIDOR is null or n.idrepresentante = :P719_DISTRIBUIDOR )
                  and ( :P719_CONSULTORA is null or n.idvendedora = :P719_CONSULTORA )
                  and ( :P719_IDRESPONSAVEL is null or n.idusuarioresponsavel = :P719_IDRESPONSAVEL )
                  and ( :P719_IDPAIS is null or n.idpais = :P719_IDPAIS)
                  and ( :P719_FORMA_PGTO = 'A' or n.formapagamento = :P719_FORMA_PGTO )
                  and ( :P719_CANAL is null or n.origem = :P719_CANAL) 
                  and ( :P719_SITUACAO = 'T'
                          or ( :P719_SITUACAO = 'Q' and nvl( ( select sum(p.valorparcela)
                                                               from pagamentosnegociacoesparceiros p
                                                               where p.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                 and p.situacao  = 'Q'
                                                                 and p.baixarealizada  = 'S' ),0) > 0 )
                          or ( :P719_SITUACAO = 'A' and n.valornegociacao > n.saldo ) )
                ) y
                where ( :P719_SPC  = 'T'
                         or ( :P719_SPC = 'S' and y.spc = 'Sim')
                         or ( :P719_SPC = 'N' and y.spc = 'Não') ) 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color="blue">Documento = Traz o CPF das consultoras do Brasil e documento extrangeiro das consultoras dos demais países.</font><br>
                <font color="red">Data Vencimento = Data de vencimento da primeira parcela em aberto na negociação.</font><br>
                <font color="blue">Valor Pago = Soma das parcelas quitadas na negociação.</font><br>
                <font color="red">Valor Pago Vigente = Soma das parcelas quitadas na negociação dentro do período do filtro.</font><br>
                <font color="blue">Situação = Situação em que se encontra a parcela da negociação.</font><br>
                <font color="red">SPC = Se o cliente esta negativado ou não.</font><br><br>
                <b>Observação: Este relatório traz os acordos que estão em andamento, ou seja que possuem parcelas em aberto.</b>
                ```
        }
        serverSideCondition {
            type: item=value
            item: P719_TIPOBUSCA
            value: C
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2119620947768290424
        }

