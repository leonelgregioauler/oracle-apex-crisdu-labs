page 454 (
    name: Atualização de Promossórias
    title: Atualização de Promossórias
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region consultoras-para-atualizar (
        name: Consultoras para Atualizar
        type: tabform
        source {
            sqlQuery:
                ```sql
                select v.idvendedora
                     , initcap(p.nomepessoa) nome
                     , NVL(( select listagg(n.numeronota|| ' - ' ||n.saldo|| ' - '||pck_romance.fnc_nomerepresentante(n.idrepresentante),' ') within group (order by 1)
                             from notasvendas n
                             where n.idvendedora = v.idvendedora
                               and ( ( n.idsituacaonotavenda = 4 and n.saldo > 0 )
                                  or ( n.idsituacaonotavenda = 3 ) ) ),'Não possui notas!') notas
                     , nvl(( select listagg(n.numeronota|| ' - Promissória: ' ||s.descricao,' ') within group (order by 1)
                             from roman.notasvendas n
                                , catal.situacoespromissorias s
                             where n.idvendedora = v.idvendedora
                               and s.idsituacaopromis = n.idsituacaopromissoria
                               and ( ( n.idsituacaonotavenda = 4 and n.saldo > 0 )
                                 or ( n.idsituacaonotavenda = 3 ) )
                               and n.idsituacaopromissoria is not null),'Não possui promissórias!') promissorias
                     , null confirmar
                     , null RECUPERARPROMISSORIA
                from vendedoras v
                   , pessoas p
                   , filtrosdocumentos f
                where f.usuario = v('APP_USER')
                  and replace(replace(replace(f.documento,'.',''),'-',''),' ','') = p.documentoestrangeiro
                  and v.idpessoa = p.idpessoa
                  and v.idfilial = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P454_SITUACAOPROMISSORIA
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Nenhuma informação encontrada. Verifique os documentos informados.
        }

        column CONFIRMAR (
            reportColumnQueryId: 5
            derivedColumn: N
            type: simpleCheckbox
            heading {
                heading: Confirmar
                alignment: center
            }
            lov {
                checkboxValues: S
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
        )

        column IDVENDEDORA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column NOME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

        column NOTAS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Notas
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column PROMISSORIAS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Promissórias
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column RECUPERARPROMISSORIA (
            reportColumnQueryId: 6
            derivedColumn: N
            type: simpleCheckbox
            heading {
                heading: Recuperar Promissória
                alignment: center
            }
            lov {
                checkboxValues: S
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
        )

    )

    region situação-promissória (
        name: Situação Promissória
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P454_SITUACAOPROMISSORIA (
        type: selectList
        label {
            label: Situação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.descricao display_value
                  , s.idsituacaopromis return_value
                from catal.situacoespromissorias s
                ```
        }
        layout {
            sequence: 10
            region: @situação-promissória
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button adicionar-ci (
        buttonName: ADICIONAR_CI
        label: Adicionar Documentos
        layout {
            sequence: 30
            region: @situação-promissória
            slot: regionBody
            startNewRow: false
            column: 9
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 455
                items: {
                    P455_PAGINA: 454
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button iniciar (
        buttonName: INICIAR
        label: Iniciar Atualização
        layout {
            sequence: 20
            region: @situação-promissória
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar Promossória
        layout {
            sequence: 10
            region: @consultoras-para-atualizar
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process atualiza-promissórias (
        name: Atualiza Promissórias
        type: executeCode
        editableRegion: @consultoras-para-atualizar
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidnota        number;
                  vcpf           varchar2(15);
                  vidvendedora   number := :IDVENDEDORA;
                  i              integer;
                  verro          varchar2(2000);
                  vidpromissoria number := to_number(:P454_SITUACAOPROMISSORIA);
                  vatualiza      varchar2(1) := :CONFIRMAR;
                  vpromissoria   varchar2(300);
                  --
                begin
                  --
                  select s.descricao
                  into vpromissoria
                  from catal.situacoespromissorias s
                  where s.idsituacaopromis = vidpromissoria;
                  --
                  if :IDVENDEDORA is not null then
                      --
                      for i in ( select n.idnotavenda
                                 from notasvendas n
                                 where n.idvendedora = vidvendedora 
                                   and ( ( n.idsituacaonotavenda = 4 and n.saldo > 0 )
                                      or ( n.idsituacaonotavenda = 3 ) ) )
                      loop  
                        --
                        if vatualiza = 'S' then
                          --
                          begin
                            --
                            update notasvendas
                            set IDSITUACAOPROMISSORIA = vidpromissoria
                              , recuperarpromissoria  = nvl(:RECUPERARPROMISSORIA,'N')
                              , usuariopromissoriarec = v('APP_USER')
                              , dataatualizacaopromissoria = sysdate
                              , promissoriarecuperada = 'S'
                            where idnotavenda  = i.idnotavenda;
                            --
                            insert into observacoesnotasvendas
                            values (seq_idobsnotavenda.nextval, i.idnotavenda, sysdate, 'Promissória Atualizada - '||vpromissoria||'.', v('APP_USER'));
                            --
                          exception
                            when others then
                              insert into teste values ('erro ao atualizar promissoria da nota',i.idnotavenda);
                          --
                          end;
                          --
                        else
                          --
                          update notasvendas
                            set recuperarpromissoria  = nvl(:RECUPERARPROMISSORIA,'N')
                              , usuariopromissoriarec = v('APP_USER')
                              , dataatualizacaopromissoria = sysdate
                              , IDSITUACAOPROMISSORIA = vidpromissoria
                              , promissoriarecuperada = 'S'
                           where idnotavenda  = i.idnotavenda
                             and IDSITUACAOPROMISSORIA is null;
                            --
                            insert into observacoesnotasvendas
                            values (seq_idobsnotavenda.nextval, i.idnotavenda, sysdate, 'Promissória Atualizada - '||vpromissoria||'.', v('APP_USER'));
                            --
                        end if;
                      --
                      end loop;
                    --
                  end if;
                  --
                  delete filtrosdocumentos ft
                  where ft.pagina = 454
                    and ft.usuario = v('APP_USER');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: "Promissórias atualizadas! "
        }
        advanced {
            executionMappingIdentifier: 1514641507003713539
        }
        serverSideCondition {
            whenButtonPressed: @salvar
            executionScope: allSubmittedRows
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 454
                items: {
                    P454_SITUACAOPROMISSORIA: &P454_SITUACAOPROMISSORIA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @iniciar
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 454
                items: {
                    P454_SITUACAOPROMISSORIA:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

)

