    pageItem P535_AVISO_EXPIRADO (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 10
            region: @contato-do-site
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText:
                ```html
                <font color="red"><h2>
                    Esta indicacion Caducou. Por favor, reenviar de nuevo para el mismo o otro Distribuidor Independiente!
                    </h2></font>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from controleexpiracaoindicacoes ci
                               where ci.idcontrolecontatossite = :P535_IDCONTROLECONTATOSSITE
                                 and ci.expirado = 'S' )
                  and not exists ( select 1
                                   from controleexpiracaoindicacoes ci
                                   where ci.idcontrolecontatossite = :P535_IDCONTROLECONTATOSSITE
                                     and ci.expirado = 'N' )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

