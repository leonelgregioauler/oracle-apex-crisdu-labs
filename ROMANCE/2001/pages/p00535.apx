    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDCTRLCONTATOSITE.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
