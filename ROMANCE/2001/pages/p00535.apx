    pageItem P535_IDCIDADE (
        type: popupLov
        label {
            label: Ciudad
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomecidade(idcidade)  display_value
                     , c.IDCIDADE return_value 
                from CIDADES c
                   , filiaisregioesvenda f
                   , estados e
                where f.idfilial = :P0_IDFILIAL
                  and f.idestado = e.idestado
                  and e.idestado = c.idestado
                  and exists ( select 1
                               from vw_filiais ff
                               where ff.ididioma = e.idpais
                                 and ff.idfilial = :P0_IDFILIAL )
                order by 1
                ```
        }
        layout {
            sequence: 240
            region: @contato-do-site
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        source {
            type: databaseColumn
            databaseColumn: IDCIDADE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

