    pageItem P535_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(idfilial) display_value
                     , idfilial return_Value
                from filiais F
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and (:P0_IDFILIAL is null or f.idfilial = :P0_IDFILIAL)
                order by 1 
                ```
        }
        layout {
            sequence: 50
            region: @contato-do-site
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        default {
            type: expression
            plsqlExpression: v('P0_IDFILIAL')
        }
        readOnly {
            type: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P535_IDFILIAL_DESTINO (
        type: selectList
        label {
            label: Sucursal de destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ididioma = ( select ididioma
                                     from vw_filiais ff
                                     where ff.idfilial = :P0_IDFILIAL )
                  and f.idfilial != :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 10
            region: @encaminar-para-sucursal
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
