    process encaminhar-para-distribuidor (
        name: encaminhar para distribuidor
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidclassificacaosac     number;
                  vidcontrolecontatossite number := :P535_IDCONTROLECONTATOSSITE;
                  vidcaracteristicasac    number := 18;
                  vdataclassificado       date := sysdate;
                  vidusuario              number;
                  vidvalorclassificacao   number;
                  vobservacao             varchar2(1000);
                  vmd5                    varchar2(1000);
                  --
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  update controlecontatossite c
                  set situacao = 'E'
                    , idrepresentante = :P535_IDREPRESENTANTE
                  where c.idcontrolecontatossite = :P535_IDCONTROLECONTATOSSITE;
                  --
                  commit;
                  --
                  pck_cadastros_rmc.prc_controleexpiracaoindicacao( pidcontrolecontatossite => vidcontrolecontatossite,
                                                                    pidrepresentante => :P535_IDREPRESENTANTE,
                                                                    pusuario => v('APP_USER'));
                  --
                  pck_cadastros_rmc.prc_classificacoessac( pidclassificacaosac     => vidclassificacaosac,
                                                           pidcontrolecontatossite => vidcontrolecontatossite,
                                                           pidcaracteristicasac    => vidcaracteristicasac,
                                                           pdataclassificado       => vdataclassificado,
                                                           pidusuario              => vidusuario,
                                                           pidvalorclassificacao   => vidvalorclassificacao,
                                                           pobservacao             => vobservacao,
                                                           pmd5                    => vmd5,
                                                           poperacao_dml           => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: Indicação encaminhada com Sucesso!
        }
        error {
            errorMessage: Entre em contato com o Administrador!
        }
        advanced {
            executionMappingIdentifier: 6107149642242341
        }
        serverSideCondition {
            type: request=Value
            value: ENCAMINHAR
        }
    )

    process encaminhar-para-outra-filial (
        name: Encaminhar para outra Filial
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidclassificacaosac     number;
                  vidcontrolecontatossite number := :P535_IDCONTROLECONTATOSSITE;
                  vidcaracteristicasac    number := 32;
                  vdataclassificado       date := sysdate;
                  vidusuario              number;
                  vidvalorclassificacao   number := :P535_IDFILIAL_DESTINO;
                  vobservacao             varchar2(1000);
                  vmd5                    varchar2(1000);
                  --
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  update controlecontatossite c
                  set situacao = 'P'
                    , idfilial = :P535_IDFILIAL_DESTINO
                    , dataliberadofilial = sysdate
                  where c.idcontrolecontatossite = :P535_IDCONTROLECONTATOSSITE;
                  --
                  commit;
                  --
                  pck_cadastros_rmc.prc_classificacoessac( pidclassificacaosac     => vidclassificacaosac,
                                                           pidcontrolecontatossite => vidcontrolecontatossite,
                                                           pidcaracteristicasac    => vidcaracteristicasac,
                                                           pdataclassificado       => vdataclassificado,
                                                           pidusuario              => vidusuario,
                                                           pidvalorclassificacao   => vidvalorclassificacao,
                                                           pobservacao             => vobservacao,
                                                           pmd5                    => vmd5,
                                                           poperacao_dml           => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 80
        }
        successMessage {
            successMessage: Registro enviado con éxito!
        }
        advanced {
            executionMappingIdentifier: 62412321260363709
        }
        serverSideCondition {
            type: request=Value
            value: ENCAMINHAR_FINAL
        }
    )

