    region itens-vendidos-mes (
        name: Itens Vendidos Mes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with filiais_escopo as (
                  -- Mesma regra de escopo de filial usada em query_estoquefilial_filtro_p0_idfilial.sql
                  -- (Comercial Romance / regional / America Latina / todas / uma especifica).
                  select f.idfilial
                  from roman.vw_filiais_filtro f
                  where f.ref_filial =  :P0_IDFILIAL
                )
                select pck_romance.fnc_nomerepresentante(idrepresentante) distibuidor
                     , produto
                     , ( select  m.mes
                         from meses m
                         where m.numero = t.mes ) mes
                     , sum(distribuido) distribuido
                     , sum(vendido) vendido
                     , decode( (sum(distribuido)-sum(qtddevolvida) ), 0 , 0
                                                                       , round(( (  sum(distribuido) - sum(qtddevolvida)) * 100  /  sum(distribuido) ),2)) percvenda
                     , sum(t.valordistribuido) valordistribuido
                     , sum(t.valorvendido) valorvendido
                from vw_percvendaprodutos t
                   , filiais_escopo       fe
                where ( :P231_IDREPRESENTANTE = -1 or idrepresentante  = :P231_IDREPRESENTANTE )
                  and t.idfilial = fe.idfilial
                  and mes between to_number(:P231_MES_INI) and to_number(:P231_MES_FIM)
                  and ano = :P231_ANO
                group by idrepresentante
                       , produto
                       , mes
                ```
        }
        layout {
            sequence: 40
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P231_TIPO
            value: M
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 288071692546920905
        }

