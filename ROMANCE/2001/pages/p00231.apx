    pageItem P231_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                with filiais_escopo as (
                  -- Mesma regra de escopo de filial usada em query_estoquefilial_filtro_p0_idfilial.sql
                  -- (Comercial Romance / regional / America Latina / todas / uma especifica).
                  select f.idfilial
                  from roman.vw_filiais_filtro f
                  where f.ref_filial =  :P0_IDFILIAL
                )
                select '- Todos -' display_value
                     , -1 return_value
                from dual
                union
                select pck_romance.fnc_nomepessoa(r.idpessoa) display_value
                     , r.idrepresentante
                from representantes r
                   , gerentes        g
                   , filiais_escopo  fe
                where r.idgerente = g.idgerente  -- regra de negocio: filial do representante e definida via gerente
                  and g.idfilial  = fe.idfilial
                order by 1
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @itens-vendidos-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

