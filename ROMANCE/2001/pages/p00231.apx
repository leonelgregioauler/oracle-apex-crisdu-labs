        label: Filtrar
        layout {
            sequence: 100
            region: @itens-vendidos-2
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: P231_FILTRAR
        }
    )

    dynamicAction filtrar (
        name: filtrar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @p231-filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction tipo-mes (
        name: Tipo Mes
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P231_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P231_TIPO
            value: M
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P231_MES_INI
                    P231_MES_FIM
                    P231_ANO
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P231_MES_INI
                    P231_MES_FIM
                    P231_ANO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-periodo (
        name: Tipo Periodo
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P231_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P231_TIPO
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P231_DATAINICIO
                    P231_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P231_DATAINICIO
                    P231_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-semana (
        name: Tipo Semana
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P231_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P231_TIPO
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P231_SEMANAINI
                    P231_SEMANAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P231_SEMANAINI
                    P231_SEMANAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 231
                items: {
                    P231_IDREPRESENTANTE: &P231_IDREPRESENTANTE.
                    P231_SEMANAINI: &P231_SEMANAINI.
                    P231_SEMANAFIM: &P231_SEMANAFIM.
                    P231_TIPO: &P231_TIPO.
                    P231_MES_INI: &P231_MES_INI.
                    P231_MES_FIM: &P231_MES_FIM.
                    P231_ANO: &P231_ANO.
                    P231_DATAINICIO: &P231_DATAINICIO.
                    P231_DATAFIM: &P231_DATAFIM.
                }
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @p231-filtrar
        }
    )

)

