    region itens-vendidos-por-período (
        name: Itens Vendidos por Período
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with filiais_escopo as (
                  -- Mesma regra de escopo de filial usada em query_estoquefilial_filtro_p0_idfilial.sql
                  -- (Comercial Romance / regional / America Latina / todas / uma especifica).
                  select f.idfilial
                  from roman.vw_filiais_filtro f
                  where f.ref_filial =  :P0_IDFILIAL
                )
                select pck_romance.fnc_nomerepresentante(idrepresentante) represente
                     , produto
                     , sum(distribuido) distribuido
                     , sum(vendido) vendido
                     , decode( (sum(distribuido)-sum(qtddevolvida) ), 0 , 0
                                                                       , round(( (  sum(distribuido) - sum(qtddevolvida)) * 100  /  sum(distribuido) ),2)) percvenda
                     , sum(t.valordistribuido) valordistribuido
                     , sum(t.valorvendido) valorvendido
                from vw_percvendaprodutos_2 t
                   , filiais_escopo         fe
                where ( :P231_IDREPRESENTANTE = -1 or idrepresentante  = :P231_IDREPRESENTANTE )
                  and t.idfilial = fe.idfilial
                  and t.dataacerto between to_date(:P231_DATAINICIO) and to_date(:P231_DATAFIM)
                group by idrepresentante
                       , produto
                
                ```
