    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 30
            region: @telefones-consulta-spc
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconRight
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Salvar Telefone
        layout {
            sequence: 20
            region: @telefones-consulta-spc
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 10
            region: @telefones-consulta-spc
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reutilizar (
        buttonName: REUTILIZAR
        label: Reutilizar Cadastro
        layout {
            sequence: 210
            region: @histórico-de-conuslta-ao-spc
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from historicosconsultasdoc h
                where h.idhistoricoconsultadoc = :P375_IDHISTORICOCONSULTADOC
                  and ( trunc(sysdate) - trunc(h.dataconsulta) ) between 5 and 21
                  and h.liberado = 'S'
                  and not exists ( select 1
                                   from pessoas p
                                   where p.cpf = replace(replace(h.documento,'.',''),'-','') )
                ```
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Gravar
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    button trocar-distribuidor (
        buttonName: TROCAR_DISTRIBUIDOR
        label: Trocar Distribuidor
        layout {
            sequence: 180
            region: @histórico-de-conuslta-ao-spc
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from historicosconsultasdoc h
                where h.idhistoricoconsultadoc = :P375_IDHISTORICOCONSULTADOC
                  and trunc(sysdate) - trunc(h.dataconsulta) > 5
                  and not exists ( select 1
                                   from pessoas p
                                      , vendedoras v
                                   where p.cpf = replace(replace(h.documento,'.',''),'-','')
                                     and p.idpessoa = v.idpessoa 
                                     and v.ativo = 'S' )
                ```
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction novo-distribuidor (
        name: Novo Distribuidor
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P375_TROCAR_IDREPRES
        }
        clientSideCondition {
            type: item=value
            item: P375_TROCAR_IDREPRES
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P375_IDREPRESENTANTE_NOVO
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: button
                button: @trocar-distribuidor
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P375_IDREPRESENTANTE_NOVO
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: button
                button: @trocar-distribuidor
            }
            execution {
                sequence: 20
            }
        )

    )

    validation valida-uso-de-nr-consulta (
        name: Valida uso de NR Consulta
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P375_NROCONSULTASPC
        }
        error {
            errorMessage: Informe o numero de Consulta ao SPC.
            associatedItem: @P375_NROCONSULTASPC
        }
        serverSideCondition {
            type: item=value
            item: P375_LIBERADO
            value: S
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @telefones-consulta-spc
        target {
            tableName: TELEFONESHISTORICOSCONSULTAS
            pkColumn: IDTELEFONEHISTORICO
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: #MRD_COUNT# row(s) deleted.
        }
        advanced {
            executionMappingIdentifier: 1432924454734513317
        }
        serverSideCondition {
            whenButtonPressed: @multi-row-delete
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @telefones-consulta-spc
        target {
            tableName: TELEFONESHISTORICOSCONSULTAS
            pkColumn: IDTELEFONEHISTORICO
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 1432924302792513316
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process consulta (
        name: Consulta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdataconsulta date;
                  --
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_HISTORICOSCONSULTASDOC( PIDHISTORICOCONSULTADOC => :P375_IDHISTORICOCONSULTADOC,
                                                                PDATACONSULTA => vdataconsulta,
                                                                PDOCUMENTO => :P375_DOCUMENTO,
                                                                PLIBERADO => :P375_LIBERADO,
                                                                PUSADO => :P375_USADO,
                                                                PCODIGOLIBERACAO => :P375_CODIGOLIBERACAO,
                                                                PNROCONSULTASPC => :P375_NROCONSULTASPC,
                                                                PIDREPRESENTANTE => :P375_IDREPRESENTANTE,
                                                                PIDSEMANA => :P375_IDSEMANA,
                                                                PUSUARIO => :P375_USUARIO,
                                                                PIDPAIS => :P375_IDPAIS,
                                                                PIDFILIAL => :P375_IDFILIAL,
                                                                POBSERVACAO => :P375_OBSERVACAO,
                                                                PMD5 => :P375_MD5,
                                                                POPERACAO_DML => 'S');
                  --
                  :P375_DATACONSULTA := to_char(vdataconsulta,'DD/MM/RRRR HH24:MI:SS');
                  --
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1411803987092104236
        }
    )

    process processo-dml-em-historicos-consultas-spc (
        name: Processo DML em Historicos Consultas SPC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  voperacao_dml varchar2(1) := 'U';
                  vdataconsulta date := to_date(:P375_DATACONSULTA,'DD/MM/RRRR HH24:MI:SS');
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_HISTORICOSCONSULTASDOC( PIDHISTORICOCONSULTADOC => :P375_IDHISTORICOCONSULTADOC,
                                                                PDATACONSULTA => vdataconsulta,
                                                                PDOCUMENTO => :P375_DOCUMENTO,
                                                                PLIBERADO => :P375_LIBERADO,
                                                                PUSADO => :P375_USADO,
                                                                PCODIGOLIBERACAO => :P375_CODIGOLIBERACAO,
                                                                PNROCONSULTASPC => :P375_NROCONSULTASPC,
                                                                PIDREPRESENTANTE => :P375_IDREPRESENTANTE,
                                                                PIDSEMANA => :P375_IDSEMANA,
                                                                PUSUARIO => :P375_USUARIO,
                                                                PIDPAIS => :P375_IDPAIS,
                                                                PIDFILIAL => :P0_IDFILIAL,
                                                                POBSERVACAO => :P375_OBSERVACAO,
                                                                PMD5 => :P375_MD5,
                                                                POPERACAO_DML => voperacao_dml);
                  --
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1411977549646457650
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process reutilizar-cadastro (
        name: Reutilizar Cadastro
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_cadastros_rmc.prc_reutilizaconsulta( pidhistoricoconsultadoc => :P375_IDHISTORICOCONSULTADOC
                                                         , pusuario => v('APP_USER') );
