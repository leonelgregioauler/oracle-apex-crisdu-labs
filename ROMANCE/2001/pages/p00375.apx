page 375 (
    name: Cadastro de Histórico de Consultas SPC
    title: Cadastro de Histórico de Consultas SPC
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region histórico-de-conuslta-ao-spc (
        name: Histórico de Conuslta ao SPC
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        headerAndFooter {
            headerText: Para reutilizar o código, a última consulta deve estar entre 5 e 21 dias passados.
        }
        settings {
            outputAs: text
        }
    )

    region telefones-consulta-spc (
        name: Telefones Consulta SPC
        type: tabform
        source {
            sqlQuery:
                ```sql
                select t.IDTELEFONEHISTORICO
                     , IDHISTORICOCONSULTADOC
                     , TELEFONE
                     , OBSERVACAO
                from telefoneshistoricosconsultas t
                where t.idhistoricoconsultadoc = :P375_IDHISTORICOCONSULTADOC
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CHECK$01 (
            reportColumnQueryId: 5
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
        )

        column IDHISTORICOCONSULTADOC (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: item
                item: P375_IDHISTORICOCONSULTADOC
            }
        )

        column IDTELEFONEHISTORICO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDTELEFONEHISTORICO
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textField
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 50
            }
        )

        column TELEFONE (
            reportColumnQueryId: 3
            derivedColumn: N
            type: textField
            heading {
                heading: Telefone
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 20
            }
        )

    )

    pageItem P375_AVISO_CADASTRO (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 10
            region: @histórico-de-conuslta-ao-spc
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText:
                ```html
                <font color="RED"><h3>
                    Este documento já está cadastrado no sistema, não sendo possível Reutilizar ou enviar para outro Distribuidor utilizar o código!
                    </h3></font>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from historicosconsultasdoc h
                where h.idhistoricoconsultadoc = :P375_IDHISTORICOCONSULTADOC
                  and trunc(sysdate) - trunc(h.dataconsulta) > 5
                  and exists ( select 1
                               from pessoas p
                                  , vendedoras v
                               where p.cpf = replace(replace(h.documento,'.',''),'-','')
                                 and p.idpessoa = v.idpessoa 
                                 and v.ativo = 'S' )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P375_CODIGOLIBERACAO (
        type: textField
        label {
            label: Código Liberação
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 80
            region: @histórico-de-conuslta-ao-spc
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

