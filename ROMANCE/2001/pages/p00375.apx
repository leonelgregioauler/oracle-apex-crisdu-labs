    pageItem P375_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) d
                     , idrepresentante r
                from representantes r
                where r.ativo = 'S'
                  and r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P375_IDFILIAL )
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P375_IDFILIAL
        }
        layout {
            sequence: 100
            region: @histórico-de-conuslta-ao-spc
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P375_IDREPRESENTANTE_NOVO (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) d
                     , idrepresentante r
                from representantes r
                where r.ativo = 'S'
                  and r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 170
            region: @histórico-de-conuslta-ao-spc
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from historicosconsultasdoc h
                where h.idhistoricoconsultadoc = :P375_IDHISTORICOCONSULTADOC
                  and trunc(sysdate) - trunc(h.dataconsulta) > 5
                  and not exists ( select 1
                                   from pessoas p
                                   where p.cpf = replace(replace(h.documento,'.',''),'-','') )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

