    region débitos-sacolas-por-franquia (
        name: Débitos Sacolas Por Franquia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select y.filial
                     , y.Sacola
                     , y.QTD
                     , y.saldo
                     , ' % Qtd: '||' '|| to_char( ( y.QTD/t.total_qtd )*100 ,'999G999G999G999G999G990D00')  percqtd
                     , ' % Saldo: '||' '|| to_char( ( y.saldo/t.total_saldo )*100 ,'999G999G999G999G999G990D00')  percsaldo
                     , media
                     , t.total_qtd
                     , to_char( (t.total_saldo),'999G999G999G999G999G990D00')  tsaldo
                from (select filial
                           , Sacola
                           , QTD
                           , saldo 
                           , media
                      from ( select ROW_NUMBER() OVER(PARTITION BY idfilial ORDER BY QTD desc) idfilial
                                 , filial
                                 , Sacola
                                 , QTD
                                 , saldo
                                 , media
                             from ( select nv.idfilial, roman.pck_romance.fnc_nomefilial(nv.idfilial) filial
                                        , 'Sacola ' ||lpad(cn.idvalorcaracteristica,2,'0')  Sacola
                                        , count (nv.idnotavenda) QTD
                                        , sum(nv.saldo)saldo
                                       , (sum(nv.saldo) / count (nv.idnotavenda) ) media
                                    from roman.notasvendas nv
                                       , roman.classificacoesnotasvendas cn
                                       , catal.vendedoras v
                                       , roman.vw_filiais f
                                    where cn.idnotavenda = nv.idnotavenda
                                      and nv.idvendedora = v.idvendedora
                                      and nv.idfilial = f.idfilial
                                      and cn.idcaracteristicanotavenda = 52               
                                      and nv.idsituacaonotavenda = 4               
                                      and nv.saldo > 0               
                                      and nv.idsemanacobranca between :P667_IDSEMANAINI and :P667_IDSEMANAFIM            
                                      and :P667_VISAO = 'N'
                                      --and (:P667_FRANQUIA is null or nv.idfilial = :P667_FRANQUIA)
                                      and nv.idfilial = :P667_FRANQUIA
                                     --and (:P667_ATIVO = 'A' and v.ativo in ('S','N') or :P667_ATIVO = 'S' and v.ativo = 'S' or :P667_ATIVO = 'N' and v.ativo = 'N')
                                      and f.ididioma = :P667_PAIS 
                                      and :P667_FILTRAR = 'S'       
                                    group by nv.idfilial,cn.idvalorcaracteristica
                                    order by 3 desc ) x )
                                    where idfilial <= :P667_RANKING ) y
                         , ( select filial
                                   , sum(QTD) total_qtd
                                   , sum (saldo) total_saldo
                             from ( select ROW_NUMBER() OVER(PARTITION BY idfilial ORDER BY QTD desc) idfilial
                                         , filial
                                         , Sacola
                                         , QTD
                                         , saldo
                                    from ( select nv.idfilial, roman.pck_romance.fnc_nomefilial(nv.idfilial) filial
                                                , 'Sacola ' ||lpad(cn.idvalorcaracteristica,2,'0')  Sacola
                                                , count (nv.idnotavenda) QTD
                                                , sum(nv.saldo)saldo
                                           from roman.notasvendas nv
                                              , roman.classificacoesnotasvendas cn
                                              , catal.vendedoras v
                                              , roman.vw_filiais f
                                           where cn.idnotavenda = nv.idnotavenda
                                             and nv.idvendedora = v.idvendedora
                                             and nv.idfilial = f.idfilial
                                             and cn.idcaracteristicanotavenda = 52               
                                             and nv.idsituacaonotavenda = 4               
                                             and nv.saldo > 0               
                                             and nv.idsemanacobranca between :P667_IDSEMANAINI and :P667_IDSEMANAFIM             
                                             and :P667_VISAO = 'N'
                                            -- and (:P667_FRANQUIA is null or nv.idfilial = :P667_FRANQUIA)
                                            and nv.idfilial = :P667_FRANQUIA
                                             and (:P667_ATIVO = 'A' and v.ativo in ('S','N') or :P667_ATIVO = 'S' and v.ativo = 'S' or :P667_ATIVO = 'N' and v.ativo = 'N')
                                             and f.ididioma = :P667_PAIS 
                                             and :P667_FILTRAR = 'S'       
                                           group by nv.idfilial,cn.idvalorcaracteristica
                                           order by 3 desc )x )
                                           where idfilial <= :P667_RANKING
                             group by filial ) t
                where y.filial = t.filial
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P667_VISAO = 'N'
                  and :P667_FRANQUIA != -1
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 101883780695862402
        }

