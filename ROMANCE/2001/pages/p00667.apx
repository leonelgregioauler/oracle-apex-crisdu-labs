    }
    security {
        pageAccessProtection: unrestricted
    }

    region débitos-sacola-detalhado (
        name: "Débitos Sacola Detalhado "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda ID
                     , roman.pck_romance.fnc_nomefilial(nv.idfilial) Filial
                     , roman.pck_romance.fnc_nomerepresentante (nv.idrepresentante) Distribuidor
                     , nvl(p.documentoestrangeiro,cpf)documento
                     , roman.pck_romance.fnc_nomevendedora(nv.idvendedora)Consultora
                     , cn.idvalorcaracteristica Sacola
                     , nv.numeronota
                     , nv.semanadistribuicao Distribuição
                     , nv.semanacobranca Cobrana
                     , nv.valortotalvenda
                     , nv.valorpago
                     , nv.saldo
                     , nv.valortotaldevolucao --16336744
                     , nvl( ( select vw.descsituacao
                              from vw_assinaturas_eletronicas vw
                              where vw.idnotavenda = nv.idnotavenda
                                and vw.status = 'C'
                                and vw.idassinaturaeletronica = ( select max(aa.idassinaturaeletronica)
                                                                  from assinaturaseletronicas aa
                                                                  where aa.idnotavenda = nv.idnotavenda
                                                                    and aa.status = 'C' ) ),'Assinatura Eletronica não localizada!' ) situacao_assinatura --15769425
                from roman.notasvendas nv
                   , roman.classificacoesnotasvendas cn
                   , catal.vendedoras v
                   , roman.vw_filiais f
                   , catal.pessoas p
                where cn.idnotavenda = nv.idnotavenda
                  and nv.idvendedora = v.idvendedora
                  and nv.idfilial = f.idfilial
                  and p.idpessoa = v.idpessoa
                  and cn.idcaracteristicanotavenda = 52
                  and nv.idsituacaonotavenda = 4
                  and nv.saldo > 0
                  and nv.idsemanacobranca between :P667_IDSEMANAINI and :P667_IDSEMANAFIM
                  and (:P667_FRANQUIA is null or nv.idfilial = :P667_FRANQUIA)
                  and (:P667_DISTRIBUIDOR is null or nv.idrepresentante = :P667_DISTRIBUIDOR)
                  and (:P667_ATIVO = 'A' and v.ativo in ('S','N') or :P667_ATIVO = 'S' and v.ativo = 'S' or :P667_ATIVO = 'N' and v.ativo = 'N')
                  and f.ididioma = :P667_PAIS
                  and :P667_VISAO = 'S'
                  and :P667_DEBITO = 'N'
                union
                select minnf.ID
                     , minnf.Filial
                     , minnf.Distribuidor
                     , minnf.Documento
                     , minnf.Consultora
                     , cn2.idvalorcaracteristica Sacola
                     , nv2.numeronota
                     , nv2.semanadistribuicao Distribuição
                     , nv2.semanacobranca Cobranca
                     , nv2.valortotalvenda
                     , nv2.valorpago
                     , nv2.saldo
                     , nv2.valortotaldevolucao --16336744
                     , nvl( ( select vw.descsituacao
                              from vw_assinaturas_eletronicas vw
                              where vw.idnotavenda = nv2.idnotavenda
                                and vw.status = 'C'
                                and vw.idassinaturaeletronica = ( select max(aa.idassinaturaeletronica)
                                                                  from assinaturaseletronicas aa
                                                                  where aa.idnotavenda = nv2.idnotavenda
                                                                    and aa.status = 'C' ) ),'Assinatura Eletronica não localizada!' ) situacao_assinatura --15769425
                from roman.notasvendas nv2
                   , roman.classificacoesnotasvendas cn2
                   , catal.vendedoras v2
                   , roman.vw_filiais f2
                   , (select min(nv.idnotavenda) ID
                             , roman.pck_romance.fnc_nomefilial(nv.idfilial) Filial
                             , roman.pck_romance.fnc_nomerepresentante (nv.idrepresentante) Distribuidor
                             , nvl(p.documentoestrangeiro,p.cpf)Documento
                             , roman.pck_romance.fnc_nomevendedora(nv.idvendedora)Consultora
                        from roman.notasvendas nv
                           , roman.classificacoesnotasvendas cn
                           , catal.vendedoras v
                           , roman.vw_filiais f
                           , catal.pessoas p
                        where cn.idnotavenda = nv.idnotavenda
                          and nv.idvendedora = v.idvendedora
                          and nv.idfilial = f.idfilial
                          and p.idpessoa = v.idpessoa
                          and cn.idcaracteristicanotavenda = 52
                          and nv.idsituacaonotavenda = 4
                          and nv.saldo > 0
                          and nv.idsemanacobranca between :P667_IDSEMANAINI and :P667_IDSEMANAFIM
                          and (:P667_FRANQUIA is null or nv.idfilial = :P667_FRANQUIA)
                          and (:P667_DISTRIBUIDOR is null or nv.idrepresentante = :P667_DISTRIBUIDOR)
                          and (:P667_ATIVO = 'A' and v.ativo in ('S','N') or :P667_ATIVO = 'S' and v.ativo = 'S' or :P667_ATIVO = 'N' and v.ativo = 'N')
                          and f.ididioma = :P667_PAIS
                          and :P667_VISAO = 'S'
                          and :P667_DEBITO = 'S'
                        group by nv.idvendedora,nv.idrepresentante,nv.idfilial,p.documentoestrangeiro,p.cpf) minnf
                where cn2.idnotavenda = nv2.idnotavenda
                  and nv2.idvendedora = v2.idvendedora
                  and nv2.idfilial = f2.idfilial
                  and nv2.idnotavenda = minnf.ID
                  and cn2.idcaracteristicanotavenda = 52
                  and :P667_FILTRAR = 'S'
                  order by 2,3,5
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P667_VISAO
            value: S
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 101785836357418710
        }

