                ```
        }
        title {
            title: Sacolas Com Débitos Por Franquia
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        multiSeriesChartData {
            sortOrder: valueDesc
        }
        legend {
            hideAndShowBehavior: none
        }

        series sacola (
            name: sacola
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT filial
                         , Sacola
                         , QTD
                         , saldo 
                    FROM (SELECT ROW_NUMBER() OVER(PARTITION BY idfilial ORDER BY QTD desc) idfilial
                               , filial
                               , Sacola
                               , QTD
                               , saldo
                          FROM ( select nv.idfilial, roman.pck_romance.fnc_nomefilial(nv.idfilial) filial
                                      , 'Sacola ' ||lpad(cn.idvalorcaracteristica,2,'0')  Sacola
                                      , count (nv.idnotavenda) QTD
                                      , sum(nv.saldo)saldo
                                 from roman.notasvendas nv
                                    , roman.classificacoesnotasvendas cn
                                    , catal.vendedoras v
                                    , roman.vw_filiais f
                                 where cn.idnotavenda = nv.idnotavenda
                                   and nv.idvendedora = v.idvendedora
                                   and nv.idfilial = f.idfilial
                                   and cn.idcaracteristicanotavenda = 52               
                                   and nv.idsituacaonotavenda = 4               
                                   and nv.saldo > 0               
                                   and nv.idsemanacobranca between :P667_IDSEMANAINI and :P667_IDSEMANAFIM               
                                   and :P667_VISAO = 'N'
                                   --and (:P667_FRANQUIA is null or nv.idfilial = :P667_FRANQUIA)
                                   and nv.idfilial = :P667_FRANQUIA
                                   and (:P667_ATIVO = 'A' and v.ativo in ('S','N') or :P667_ATIVO = 'S' and v.ativo = 'S' or :P667_ATIVO = 'N' and v.ativo = 'N')
                                   and f.ididioma = :P667_PAIS 
                                   and :P667_FILTRAR = 'S'   
                                   group by nv.idfilial,cn.idvalorcaracteristica
                                 order by 3 desc ) x )
                    WHERE IDFILIAL <= :P667_RANKING
                    
                    ```
            }
            columnMapping {
                seriesName: SACOLA
                label: FILIAL
                value: QTD
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
            tickLabel {
                show: false
            }
        )

        axis y-1 (
            name: y2
            showAxis: false
            minorTicks {
                show: false
            }
        )

    )

    region débitos-sacolas-por-distribuidor (
        name: Débitos Sacolas Por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT Distribuidor
                     , Sacola
                     , QTD
                     , saldo 
                FROM (SELECT ROW_NUMBER() OVER(PARTITION BY idrepresentante ORDER BY QTD desc) idrepresentante
                           , Distribuidor
                           , Sacola
                           , QTD
                           , saldo
                      FROM ( select nv.idrepresentante
                                  , roman.pck_romance.fnc_nomerepresentante (nv.idrepresentante) Distribuidor
                                  , 'Sacola ' ||lpad(cn.idvalorcaracteristica,2,'0')  Sacola
                                  , count (nv.idnotavenda) QTD
                                  , sum(nv.saldo)saldo
                             from roman.notasvendas nv
                                , roman.classificacoesnotasvendas cn
                                , catal.vendedoras v
                                , roman.vw_filiais f
                             where cn.idnotavenda = nv.idnotavenda
                               and nv.idvendedora = v.idvendedora
                               and nv.idfilial = f.idfilial
                               and cn.idcaracteristicanotavenda = 52               
                               and nv.idsituacaonotavenda = 4               
                               and nv.saldo > 0               
                               and nv.idsemanacobranca between :P667_IDSEMANAINI and :P667_IDSEMANAFIM                
                               and :P667_VISAO = 'N'               
                              -- and (:P667_FRANQUIA is null or nv.idfilial = :P667_FRANQUIA) 
                               and nv.idfilial = :P667_FRANQUIA --or :P667_FRANQUIA = -1
                               and (:P667_DISTRIBUIDOR is null or nv.idrepresentante = :P667_DISTRIBUIDOR)
                               and (:P667_ATIVO = 'A' and v.ativo in ('S','N') or :P667_ATIVO = 'S' and v.ativo = 'S' or :P667_ATIVO = 'N' and v.ativo = 'N')               
                               and f.ididioma = :P667_PAIS                
                               and :P667_FILTRAR = 'S'            
                               group by nv.idrepresentante,cn.idvalorcaracteristica
                             order by 3 desc ) x )
                where idrepresentante <= :P667_RANKING
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P667_VISAO = 'N'
                  and :P667_FRANQUIA != -1
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
