    dynamicAction mostra-primeiro-débito (
        name: Mostra primeiro débito
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P667_VISAO
        }
        clientSideCondition {
            type: item=value
            item: P667_VISAO
            value: S
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P667_DEBITO
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: region
                region: @débitos-sacola-detalhado
            }
            execution {
                sequence: 20
            }
        )

    )

