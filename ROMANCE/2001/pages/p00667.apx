    region débitos-sacolas-por-todas-franquias (
        name: Débitos Sacolas Por Todas Franquias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.filial
                     , r.Sacola
                     , r.QTD
                     , r.saldo
                     , to_char( round( r.media,2 ) ,'999G999G999G999G999G990D00')  media
                     , to_char( ( r.QTD/rt.total_qtd )*100 ,'999G999G999G999G999G990D00') percqtd
                     , to_char( ( r.saldo/rt.total_saldo )*100 ,'999G999G999G999G999G990D00') percsaldo
                     , xy.qtdtg  Qtd_geral
                     , to_char( ( xy.saldotg ),'999G999G999G999G999G990D00') Saldo_Geral
                     , round ( ( rt.total_qtd/xy.qtdtg  )*100 ,2)  perc_qtd_geral
                     , round ( ( rt.total_saldo/xy.saldotg  )*100 ,2 ) perc_saldo_geral
                from ( select x.filial
                            , x.Sacola
                            , x.QTD
                            , x.saldo 
                            , x.media
                       from ( select ROW_NUMBER() OVER(PARTITION BY a.idfilial ORDER BY a.QTD desc) idfilial
                                   , a.filial
                                   , a.Sacola
                                   , a.QTD
                                   , a.saldo
                                   , a.media
                             from ( select nv.idfilial, roman.pck_romance.fnc_nomefilial(nv.idfilial) filial
                                         , 'Sacola ' ||lpad(cn.idvalorcaracteristica,2,'0')  Sacola
                                         , count (nv.idnotavenda) QTD
                                         , sum(nv.saldo)saldo
                                         ,(sum(nv.saldo) / count (nv.idnotavenda) ) media
                                    from roman.notasvendas nv
                                       , roman.classificacoesnotasvendas cn
                                       , catal.vendedoras v
                                       , roman.vw_filiais f
                                    where cn.idnotavenda = nv.idnotavenda
                                      and nv.idvendedora = v.idvendedora
                                      and nv.idfilial = f.idfilial
                                      and cn.idcaracteristicanotavenda = 52               
                                      and nv.idsituacaonotavenda = 4               
                                      and nv.saldo > 0               
                                      and nv.idsemanacobranca between :P667_IDSEMANAINI and :P667_IDSEMANAFIM     
                                      and :P667_FRANQUIA = -1
                                      and :P667_VISAO = 'N'
                                      and (:P667_ATIVO = 'A' and v.ativo in ('S','N') or :P667_ATIVO = 'S' and v.ativo = 'S' or :P667_ATIVO = 'N' and v.ativo = 'N')
                                      and f.ididioma = :P667_PAIS
                                      and :P667_FILTRAR = 'S'       
                                    group by nv.idfilial,cn.idvalorcaracteristica
                                    order by 3 desc ) a ) x
                                    where idfilial <= :P667_RANKING) r  --Ranking por filial 
                -------------------------------------------------//--------------------------------------------------------------------------
                            , ( select filial
                                   , sum(y.QTD) total_qtd
                                   , sum (y.saldo) total_saldo
                             from ( select ROW_NUMBER() OVER(PARTITION BY b.idfilial ORDER BY b.QTD desc) idfilial
                                         , b.filial
                                         , b.Sacola
                                         , b.QTD
                                         , b.saldo
                                    from ( select nv.idfilial, roman.pck_romance.fnc_nomefilial(nv.idfilial) filial
                                                , 'Sacola ' ||lpad(cn.idvalorcaracteristica,2,'0')  Sacola
                                                , count (nv.idnotavenda) QTD
                                                , sum(nv.saldo)saldo
                                           from roman.notasvendas nv
                                              , roman.classificacoesnotasvendas cn
                                              , catal.vendedoras v
                                              , roman.vw_filiais f
                                           where cn.idnotavenda = nv.idnotavenda
                                             and nv.idvendedora = v.idvendedora
                                             and nv.idfilial = f.idfilial
                                             and cn.idcaracteristicanotavenda = 52               
                                             and nv.idsituacaonotavenda = 4               
                                             and nv.saldo > 0               
                                             and nv.idsemanacobranca between :P667_IDSEMANAINI and :P667_IDSEMANAFIM
                                             and :P667_FRANQUIA = -1
                                             and :P667_VISAO = 'N'
                                             and (:P667_ATIVO = 'A' and v.ativo in ('S','N') or :P667_ATIVO = 'S' and v.ativo = 'S' or :P667_ATIVO = 'N' and v.ativo = 'N')
                                             and f.ididioma = :P667_PAIS
                                             and :P667_FILTRAR = 'S'       
                                           group by nv.idfilial,cn.idvalorcaracteristica
                                           order by 3 desc )b ) y
                             where idfilial <= :P667_RANKING
                             group by filial ) rt  -- Total do ranking
                  -----------------------------------------------------------------//-------------------------------------------------------           
                      , ( select sum(rtt.totalqtd) qtdtg
                               , sum(rtt.totalsaldo) saldotg
                             from ( select z.filial
                                     , sum (z.QTD) totalqtd
                                     , sum (z.saldo) totalsaldo
                                    from ( select ROW_NUMBER() OVER(PARTITION BY c.idfilial ORDER BY c.QTD desc) idfilial
                                                , c.filial
                                                , c.Sacola
                                                , c.QTD
                                                , c.saldo
                                            from ( select nv.idfilial, roman.pck_romance.fnc_nomefilial(nv.idfilial) filial
                                                        , 'Sacola ' ||lpad(cn.idvalorcaracteristica,2,'0')  Sacola
                                                        , count (nv.idnotavenda) QTD
                                                        , sum(nv.saldo)saldo
                                                   from roman.notasvendas nv
                                                      , roman.classificacoesnotasvendas cn
                                                      , catal.vendedoras v
                                                      , roman.vw_filiais f
                                                   where cn.idnotavenda = nv.idnotavenda
                                                     and nv.idvendedora = v.idvendedora
                                                     and nv.idfilial = f.idfilial
                                                     and cn.idcaracteristicanotavenda = 52               
                                                     and nv.idsituacaonotavenda = 4               
                                                     and nv.saldo > 0               
                                                     and nv.idsemanacobranca between :P667_IDSEMANAINI and :P667_IDSEMANAFIM  
                                                     and :P667_FRANQUIA = -1
                                                     and :P667_VISAO = 'N'
                                                     and (:P667_ATIVO = 'A' and v.ativo in ('S','N') or :P667_ATIVO = 'S' and v.ativo = 'S' or :P667_ATIVO = 'N' and v.ativo = 'N')
                                                     and f.ididioma = :P667_PAIS 
                                                     and :P667_FILTRAR = 'S'       
                                                   group by nv.idfilial,cn.idvalorcaracteristica
                                                   order by 3 desc ) c ) z
                             where idfilial <= :P667_RANKING
                             group by filial ) rtt ) xy  -- ranking total dos totais
                where r.filial = rt.filial
                  --and :P667_FRANQUIA = -1
                  --and :P667_FILTRAR = 'S'
                 -- and :P667_FRANQUIA is null
                order by 1, 3 desc
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P667_VISAO = 'N'
                  and :P667_FRANQUIA = -1
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 566460819454628002
        }

