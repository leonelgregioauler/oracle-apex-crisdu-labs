                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P667_DISTRIBUIDOR (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||decode(r.ativo,'S','Ativo','N','Inativo') d
                     , r.idrepresentante r
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente
                  and ( :P667_FRANQUIA is null or g.idfilial = :P667_FRANQUIA)
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P667_FRANQUIA
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P667_FILTRAR (
        type: hidden
        layout {
            sequence: 140
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P667_FRANQUIA (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome, idfilial
                from (
                    select ' - Todas - ' as nome
                         , -1            as idfilial
                    from dual
                    union all
                    select f.nome
                         , f.idfilial
                    from roman.vw_filiais f
                    where f.ativo = 'S'
                      and f.tipofilial = 'D'
                      and f.idfilial != 1063
                      and ( :P667_PAIS is null or f.ididioma = :P667_PAIS )
                )
                order by case when idfilial = -1 then 0 else 1 end
                       , nome
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P667_PAIS
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

