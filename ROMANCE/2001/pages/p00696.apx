page 696 (
    name: Inserir Débito Diverso
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1280
        height: 720
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region inserir-débito-diverso (
        name: Inserir Débito Diverso
        type: staticContent
        layout {
            sequence: 40
            slot: dialogHeader
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P696_DATAVENCIMENTO (
        type: datePickerJquery
        label {
            label: Data de Vencimento
            alignment: left
        }
        layout {
            sequence: 20
            region: @inserir-débito-diverso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: DATAVENCIMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P696_IDDEBITODIVERSO (
        type: hidden
        layout {
            sequence: 50
            region: @inserir-débito-diverso
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P696_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
            initialFetch: onUserRequest
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomepessoa)||' - '||replace(replace(nvl(cpf,documentoestrangeiro),'-',''),'.','') ||' ('||idvendedora||')' display_value
                     , v.idvendedora return_value
                from vendedoras v
                   , pessoas p
                where v.idpessoa = p.idpessoa
                  /*and v.idrepresentante in (select idrepresentante
                                            from representantes
                                            where idgerente in ( select idgerente
                                                                 from gerentes
                                                                 where idfilial = :P0_IDFILIAL))*/
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @inserir-débito-diverso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDVENDEDORA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P696_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 40
            region: @inserir-débito-diverso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
            height: 10
        }
        validation {
            maxLength: 1000
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P696_VALORTOTAL (
        type: numberField
        label {
            label: Valor Total
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @inserir-débito-diverso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        source {
            type: databaseColumn
            databaseColumn: VALORTOTAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 20
            region: @inserir-débito-diverso
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P696_IDDEBITODIVERSO
        }
    )

    process insere-débito-diverso (
        name: Insere Débito Diverso
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  
                  viddebitodiverso number := :P696_IDDEBITODIVERSO;
                  vidvendedora number := :P696_IDVENDEDORA;
                  vdescricao varchar2(4000) := :P696_OBSERVACAO;
                  vdataemissao date;
                  vdatavencimento date := :P696_DATAVENCIMENTO;
                  vvalortotal number := :P696_VALORTOTAL;
                  vvalorpago number;
                  vsaldo number;
                  vmd5 varchar2(4000);
                  voperacao_dml varchar2(1);
                  
                begin
                
                  /*if v('REQUEST') = 'SALVAR' then 
                   voperacao_dml := 'U';
                  end if;*/
                  if v('REQUEST') = 'CREATE' then 
                   voperacao_dml := 'I';
                  end if;
                  /*if v('REQUEST') = 'DELETE' then 
                   voperacao_dml := 'D';
                  end if;*/
                
                  roman.pck_gestaoderisco_rmc.prc_debitosdiversos(piddebitodiverso => viddebitodiverso,
                                                                  pidvendedora     => vidvendedora,
                                                                  pdescricao       => vdescricao,
                                                                  pdataemissao     => vdataemissao,
                                                                  pdatavencimento  => vdatavencimento,
                                                                  pvalortotal      => vvalortotal,
                                                                  pvalorpago       => vvalorpago,
                                                                  psaldo           => vsaldo,
                                                                  pmd5             => vmd5,
                                                                  poperacao_dml    => voperacao_dml);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1501056008145311008
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 695
                action: resetPagination
            }
        }
    )

)

