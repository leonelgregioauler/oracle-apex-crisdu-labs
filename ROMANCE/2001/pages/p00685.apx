page 685 (
    name: Campanhas da Cobrança
    title: Campanhas da Cobrança
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region campanhas-cadastradas (
        name: Campanhas Cadastradas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcampanhacobranca
                     , c.nome
                     , c.datainicio
                     , c.datafim
                     , ( select listagg( decode(r.column_value,'I','Negociação Interna','D','Débito Romance','C','Cobraki'),', ') within group (order by 1)
                         from table(pck_financeiro_rmc.fnc_array_to_table(c.canal_negociacao)) r ) canal_negociacao
                     , ( select listagg( pck_romance.fnc_nomefilial(r.column_value),', ') within group (order by 1)
                         from table(pck_financeiro_rmc.fnc_array_to_table(c.franquias)) r ) franquias
                     , decode(c.liberacomissao,'S','Sim','N','Não') liberacomissao
                     , c.percentualcomissao
                     , nvl(d.valornegociado,0) valornegociado
                     , nvl(d.valorpago,0) valorpago
                     , nvl(d.saldo,0) saldo
                     , nvl(d.qtd,0) qtd
                     , nvl(comissao_repres,0) comissao_repres
                     , nvl(comissao_gerente,0) comissao_gerente
                from campanhascobrancas c
                   , ( select np.idcampanhacobranca
                            , sum(np.valornegociacao*np.fatorconversao) valornegociado
                            , sum(np.valorpago*np.fatorconversao) valorpago
                            , sum(np.saldo*np.fatorconversao) saldo
                            , count(1) qtd
                            , sum(( select sum(pgn.valorpago)
                                    from pagamentoscomissoesnegociacoes pgn
                                    where pgn.idnegociacaoparceiro = np.idnegociacaoparceiro
                                      and pgn.tipopagamento = 'R' )*np.fatorconversao) comissao_repres
                            , sum(( select sum(pgn.valorpago)
                                    from pagamentoscomissoesnegociacoes pgn
                                    where pgn.idnegociacaoparceiro = np.idnegociacaoparceiro
                                      and pgn.tipopagamento = 'G' )*np.fatorconversao) comissao_gerente
                       from negociacoesparceiros np
                       where np.idcampanhacobranca is not null
                       group by idcampanhacobranca ) d
                where c.idcampanhacobranca = d.idcampanhacobranca(+)
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
