page 456 (
    name: Fotos Compartilhadas
    title: Fotos Compartilhadas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-700x
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region fotos-compartilhadas (
        name: Fotos Compartilhadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist
                     , p.nomeproduto
                     , r.nomefoto
                     , r.datacompartilhamento
                from registroscompartilhafotos r
                   , produtos p
                where r.idvendedora = :P456_IDVENDEDORA
                  and r.idproduto   = p.idproduto
                  and r.datacompartilhamento between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum compartilhamento encontrado.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 2816109799088251016
        }

        column CODIGOSISDIST (
            type: plainText
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column DATACOMPARTILHAMENTO (
            type: plainText
            heading {
                heading: Data Compartilhado
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
        )

        column NOMEFOTO (
            type: plainText
            heading {
                heading: Nome da Foto
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column NOMEPRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        savedReport 28178548 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CODIGOSISDIST (
                sequence: 1
            )

            displayColumn DATACOMPARTILHAMENTO (
                sequence: 3
            )

            displayColumn NOMEPRODUTO (
                sequence: 2
            )

            sort (
                column: DATACOMPARTILHAMENTO
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    pageItem P456_DATAFIM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @fotos-compartilhadas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P456_DATAINICIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @fotos-compartilhadas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P456_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @fotos-compartilhadas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P456_IDVENDEDORA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @fotos-compartilhadas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

