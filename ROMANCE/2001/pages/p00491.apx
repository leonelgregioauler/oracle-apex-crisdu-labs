    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function listanotas(pidrepres,pidsemana) 
            {
            javascript:window.open('f?p=&APP_ID.:165:&SESSION.::NO:165:P165_IDREPRESENTANTE,P165_SEMANA:'+pidrepres+','
                                                                                                         +pidsemana
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1400,height=800,screenX=50,screenY =100');void(0);
            }
            
            function listanotasnovas(pidrepres,pidsemana) 
            {
            javascript:window.open('f?p=&APP_ID.:161:&SESSION.::NO:161:P161_IDREPRESENTANTE,P161_SEMANA:'+pidrepres+','
                                                                                                         +pidsemana
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=1300,screenX=50,screenY =100');void(0);
            }
            
            function listanotasacertar(pidrepres,pidsemana) 
            {
            javascript:window.open('f?p=&APP_ID.:170:&SESSION.::NO:170:P170_IDREPRESENTANTE,P170_SEMANA:'+pidrepres+','
                                                                                                         +pidsemana
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=1300,screenX=50,screenY =100');void(0);
            }
            
            function liberar(pidrepres,pidsemana) 
            {
              document.getElementById('P74_IDREPRESENTANTE').value = pidrepres;
              document.getElementById('P74_SEMANALIBERAR').value   = pidsemana;
              apex.submit('LIBERAR');
            }
            ```
