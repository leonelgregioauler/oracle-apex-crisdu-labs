    region lista-de-fechamentos-efetuados (
        name: Lista de Fechamentos Efetuados
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                
                p_where1 varchar2(4000);
                p_where2 varchar2(4000);
                
                begin
                
                p_where1 := 
                  'select fr.idfechamentorepres
                     , pck_romance.fnc_nomerepresentante(pidrepresentante => fr.idrepresentante) Representante
                     , to_number(trim(substr(fr.semana,4,4))) ano
                     , to_number(trim(substr(fr.semana,1,2))) semanan
                     , pck_romance.fnc_nomefilial(pidfilial => fr.idfilial) Filial
                     , fr.setor
                     , ( select rv.descricao 
                         from regioesvenda rv
                         where rv.idregiaovenda    = fr.idregiaovenda ) "Região"
                     , fr.semana
                     , fr.qtdnotasnovas + nvl(fr.qtdnotasnovasoutrareg,0) qtdnotasnovas
                     , fr.qtdnotaslevou
                     , fr.qtdnotasfechou
                     , fr.vlralvo
                     , fr.totalgeral 
                     , fr.totalcobranca 
                     , fr.vlrespecie
                     , fr.vlrcheque
                     , fr.idcomissao
                     , nvl(fr.vlrcomissao,0) "Vlr Comissão"
                     , fr.observacao
                     , ( select semana from fechamentossemanais ff where ff.idfechamento = fr.idfechamentopontuacao ) "Referente a"
                     , decode(nvl(fr.vlralvo,0), 0, 0, ((fr.totalgeral/(fr.vlralvo*2))*100) ) "Perc Venda"
                     , fr.vlralvo "Alvo"
                     , (select sum(valor) from perdas pp where pp.idfechamentorepres = fr.idfechamentorepres) "Total Resgate"
                     , fr.totalgeral
                     - nvl(fr.vlrespecie,0)
                     - nvl(fr.vlrcheque,0)
                     - ( select NVL(sum(d.valordeposito),0) valor
                         from depositosdiarios_orig d
                         where d.tipo            = ''DD''
                           and d.idfechamentorepres = fr.idfechamentorepres) 
                     - ( select NVL(sum(d.valordeposito),0) valor
                         from depositosdiarios_orig d
                         where d.tipo            = ''CC''
                           and d.idfechamentorepres = fr.idfechamentorepres) 
                     - ( select nvl(sum(r.valor),0) valor
                         from despesas r
                         where r.idfechamentorepres = fr.idfechamentorepres )
                     - nvl(fr.vlrcomissao,0)
                     - nvl(fr.totalcomissoesfavoritarepres,0)    
                     - nvl( (select sum(valorpago)
                            from pagamentocomissoes p
                            where p.fechamento = fr.semana
                              and p.idgerente = ( select idgerente
                                                  from gerentes
                                                  where idpessoa = ( select idpessoa
                                                                     from representantes u
                                                                     where u.idrepresentante = fr.idrepresentante ) )  ),0) Saldoapagar
                     , nvl(fr.totalpepinosrecebidos,0) "Débitos Recebidos"
                     , nvl(fr.totaldebitosnovos,0) "Débitos Novos"
                     , nvl(fr.TOTALCOMISSOESFAVORITAREPRES,0) "Com. Paga Fav."
                     , ( select count(1)
                         from favorita.pedidos pf
                         where pf.idrepresentante = fr.idrepresentante
                           and pf.idsituacaoentrega >= 20000
                           and pck_util.fnc_semanaid(pf.idsemanaemissao) = fr.semana
                           and pf.datacancelamento is null ) "Qtd Pedidos"
                     , nvl( ( select sum(pgd.valorpago)
                              from vw_pagamentos_dist_rmc pgd
                              where pgd.idrepresentante = fr.idrepresentante
                                and pgd.semana          = fr.semana ),0 ) "Pgto Pedidos"     
                     , nvl( ( select pgd.qtdpedidos
                              from vw_pagamentos_dist_rmc pgd
                              where pgd.idrepresentante = fr.idrepresentante
                                and pgd.semana          = fr.semana ),0 ) "QTD Pedidos Pagos"     
                     , fr.totaldebitosfavorita
                     , fr.totalqtddebitosfavorita
                     , case
                         when fr.totalcobranca > 0 and fr.qtdnotaslevou > 0 then 
                           round(fr.totalcobranca/fr.qtdnotaslevou,2)
                         else
                           0
                       end ticket_medio ';
                  
                p_where2 := 
                     ' , ( select count(1)
                                 from notasvendas n
                                 where nvl(n.idrepresentanteatende,n.idrepresentante)   = fr.idrepresentante
                                   and n.semanacobranca        = (select pck_romance.fnc_proximasemana(SEMANA) 
                                                                  from fechamentossemanais
                                                                  where idfechamento = fr.idfechamentopontuacao )
                                   and n.idsituacaonotavenda   = 3
                                   and pck_util.fnc_idsemana(n.semanacobranca) - pck_util.fnc_idsemana(n.semanadistribuicao) > 6 ) notasemaberto
                             , QTDNOTASATENDER
                        from fechamentorepresentantes fr
                           , fechamentossemanais fs
                        where fr.idfechamento = fs.idfechamento
                                  --
                                  and fs.idsemana between to_number(V(''P491_IDFECHAMENTOINI'')) and to_number(V(''P491_IDFECHAMENTOFIM''))
                                  --
                                  and ( V(''P0_IDFILIAL'') is null 
                                            or ( V(''P0_IDFILIAL'') = 1135 and fr.idfilial in (1089,1090,1106,1132,124,122,320,221,1070,1072,1071,1082,1083 ) )
                                            or ( V(''P0_IDFILIAL'') != 1135 and fr.idfilial  = V(''P0_IDFILIAL'') ) )
                                  --
                                  and ( V(''P491_PESQUISARPOR'') is null
                                       or ( V(''P491_PESQUISARPOR'') = ''D'' and ( V(''P491_IDREPRESENTANTE'') is null or fr.idrepresentante = V(''P491_IDREPRESENTANTE'') ) )
                                       or ( V(''P491_PESQUISARPOR'') = ''G'' and exists ( select 1
                                                                                  from filtrosrepresentantes fil
                                                                                  where fil.usuario = V(''P0_USUARIO'')
                                                                                    and fil.idrepresentante = fr.idrepresentante ) ) ) ';
                                
                
                
                return p_where1 || p_where2 ;
                
                end;
                ```
        }
