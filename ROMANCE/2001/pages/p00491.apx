    region fechamentos-efetuados (
        name: "Fechamentos Efetuados "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(pidfilial => fr.idfilial) Filial
                     , pck_romance.fnc_nomerepresentante(fr.idrepresentante) Distribuidor
                     , sum(fr.qtdnotasnovas + nvl(fr.qtdnotasnovasoutrareg,0)) qtdnotasnovas
                     , sum(fr.qtdnotaslevou) qtdnotaslevou
                     , sum(fr.qtdnotasfechou) qtdnotasfechou
                     , sum(fr.totalgeral) totalgeral
                     , sum(fr.totalcobranca) totalcobranca
                     , sum(nvl(fr.vlrcomissao,0)) "Vlr Comissão"
                     , sum((select sum(valor) from perdas pp where pp.idfechamentorepres = fr.idfechamentorepres)) "Total Resgate"
                     /*, sum(fr.totalgeral)
                     - nvl(fr.vlrespecie,0)
                     - nvl(fr.vlrcheque,0)
                     - ( select NVL(sum(d.valordeposito),0) valor
                         from depositosdiarios_orig d
                         where d.tipo            = 'DD' 
                           and d.idfechamentorepres = fr.idfechamentorepres) 
                     - ( select NVL(sum(d.valordeposito),0) valor
                         from depositosdiarios_orig d
                         where d.tipo            = 'CC' 
                           and d.idfechamentorepres = fr.idfechamentorepres) 
                     - ( select nvl(sum(r.valor),0) valor
                         from despesas r
                         where r.idfechamentorepres = fr.idfechamentorepres )
                     - nvl(fr.vlrcomissao,0)
                     - nvl(fr.totalcomissoesfavoritarepres,0)    
                     - nvl( (select sum(valorpago)
                            from pagamentocomissoes p
                            where p.fechamento = fr.semana
                              and p.idgerente = ( select idgerente
                                                  from gerentes
                                                  where idpessoa = ( select idpessoa
                                                                     from representantes u
                                                                     where u.idrepresentante = fr.idrepresentante ) )  ),0) Saldoapagar*/
                     , sum(nvl(fr.totalpepinosrecebidos,0)) "Débitos Recebidos"
                     , sum(nvl(fr.totaldebitosnovos,0)) "Débitos Novos"
                     , Sum(nvl(fr.TOTALCOMISSOESFAVORITAREPRES,0)) "Com. Paga Fav."
                     , sum(( select count(1)
                             from favorita.pedidos pf
                             where pf.idrepresentante = fr.idrepresentante
                               and pf.idsituacaoentrega >= 20000
                               and pf.idsemanaemissao = pck_util.fnc_idsemana(fr.semana)
                               and pf.datacancelamento is null )) "Qtd Pedidos"
                     , sum(nvl( ( select sum(pgd.valorpago)
                                  from vw_pagamentos_dist_rmc pgd
                                  where pgd.idrepresentante = fr.idrepresentante
                                    and pgd.semana          = fr.semana ),0 )) "Pgto Pedidos"     
                     , sum(fr.totaldebitosfavorita) totaldebitosfavorita
                     , case
                         when sum(fr.totalcobranca) > 0 and sum(fr.qtdnotaslevou) > 0 then
                           round(sum(fr.totalcobranca)/sum(fr.qtdnotaslevou),2)
                         else
                           0
                       end ticket_medio
                     , sum( nvl(( select sum(pf.valorapagar)
                                  from favorita.pedidos pf
                                  where pf.idrepresentante = fr.idrepresentante
                                    and pf.idsituacaoentrega >= 20000
                                    and pf.idsemanaemissao = pck_util.fnc_idsemana(fr.semana)
                                    and pf.datacancelamento is null ),0)) "Total Pedidos"
                     , count(fr.idfechamentorepres) "Qtd acertos"
                from fechamentorepresentantes fr
                    , fechamentossemanais fs
                where ( :P0_IDFILIAL is null 
                            or ( :P0_IDFILIAL = 1135 and fr.idfilial in (1089,1090,1132,124,122,320,221,1070,1072,1071,1082,1083,1210,1106,1227,1223,1243) )
                            or ( :P0_IDFILIAL != 1135 and fr.idfilial  = :P0_IDFILIAL ) )
                  and fr.idfechamento = fs.idfechamento
                  and fs.idsemana between to_number(:P491_IDFECHAMENTOINI) and to_number(:P491_IDFECHAMENTOFIM)
                  and ( :P491_PESQUISARPOR is null
                       or ( :P491_PESQUISARPOR = 'D' and ( :P491_IDREPRESENTANTE is null or fr.idrepresentante = :P491_IDREPRESENTANTE ) )
                       or ( :P491_PESQUISARPOR = 'G' and exists ( select 1
                                                                  from filtrosrepresentantes fil
                                                                  where fil.usuario = v('APP_USER')
                                                                    and fil.idrepresentante = fr.idrepresentante ) ) )
                group by fr.idfilial, fr.idrepresentante
                order by 3 desc, 2,1 desc
                ```
        }
