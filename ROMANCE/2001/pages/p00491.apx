            )

            highlight ir-condition-2 (
                name: % Boa
                condition {
                    column: "Perc Venda"
                    operator: >=
                    value: 35
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #006300
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-3 (
                name: Notas Baixas
                condition {
                    column: QTDNOTASNOVAS
                    operator: <
                    value: 30
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #FC0000
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-4 (
                name: Notas Boas
                condition {
                    column: QTDNOTASNOVAS
                    operator: >=
                    value: 30
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #006300
                }
                execution {
                    sequence: 10
                }
            )

            groupByColumn (
                column: "Região"
                layout {
                    sequence: 1
                }
            )

            groupByAggregate (
                heading: QTD Acertos
                aggregate {
                    function: count
                    column: SEMANA
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 1
                }
            )

            groupByAggregate (
                heading: Total Cobrado
                aggregate {
                    column: TOTALGERAL
                }
                appearance {
                    formatMask: 999G999G999G999G990D00
                }
                layout {
                    sequence: 2
                }
            )

            groupByAggregate (
                heading: Média Cobrado
                aggregate {
                    function: average
                    column: TOTALGERAL
                }
                appearance {
                    formatMask: 999G999G999G999G990D00
                }
                layout {
                    sequence: 3
                }
            )

        )

    )

    region lista-de-fechamentos-efetuados-2 (
        name: Lista de Fechamentos Efetuados
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                
                p_where1 varchar2(4000);
                p_where2 varchar2(4000);
                p_where3 varchar2(4000);
                
                begin
                
                p_where1 := 
                  'select idfechamentorepres
                     , pck_romance.fnc_nomerepresentante(xx.idrepresentante) Representante
                     , xx.idrepresentante
                     , to_number(trim(substr(xx.semana,4,4))) ano
                     , to_number(trim(substr(xx.semana,1,2))) semanan
                     , semana
                     , pck_romance.fnc_nomefilial(pidfilial => xx.idfilial) Filial
                     , setor
                     , ( select descricao 
                         from regioesvenda 
                         where idregiaovenda = xx.idregiaovenda ) "Região"
                     , qtdnotasnovas
                     , qtdnotaslevou
                     , qtdnotasfechou
                     , totalgeral
                     , totalcobranca
                     , vlrespecie
                     , vlrcheque
                     , nvl(vlrcomissao,0) "Vlr Comissão"
                     , idcomissao
                     , observacao
                     , ( select semana from fechamentossemanais ff where ff.idfechamento = xx.idfechamentopontuacao ) "Referente a"
                     , decode(nvl(xx.vlralvo,0), 0, 0, ((xx.totalgeral/(xx.vlralvo*2))*100) )  "Perc Venda"
                     , vlralvo "Alvo"
                     , (select sum(valor) from perdas where idfechamentorepres = xx.idfechamentorepres) "Total Resgate"
                     , totalpepinosrecebidos "Débitos Recebidos"
                     , totaldebitosnovos "Débitos Novos"
                     , totalcomissoesfavoritarepres "Com. Paga Fav."
                     , totaldebitosfavorita
                     , totalqtddebitosfavorita
                     , qtdnotasatender
                     , (nvl(xx.totalgeral,0)
                          - nvl(xx.vlrespecie,0)
                          - nvl(xx.vlrcheque,0)
                          - nvl((xx.valordep),0)
                          - nvl(xx.vlrcomissao,0)
                          - nvl(xx.totalcomissoesfavoritarepres,0)
                          - sum(nvl(xx.vlrgerente,0)) 
                          - ( select nvl(sum(r.valor),0) valor
                                from despesas r
                               where r.idfechamentorepres = xx.idfechamentorepres )
                        ) saldoapagar
                     --
                     , sum(xx.qtdped) "Qtd Pedidos"
                     , sum(xx.valorpago) "Pgto Pedidos"
                     , sum(xx.qtdpedidos) "QTD Pedidos Pagos"
                     , case
                         when xx.totalcobranca > 0 and xx.qtdnotaslevou > 0 then 
                           round(xx.totalcobranca/xx.qtdnotaslevou,2)
                         else
                           0
                       end ticket_medio
                     --
                     , sum(qtde) notasemaberto
                  from (
                        select fr.idfechamentorepres
                             , fr.idrepresentante
                             , fr.idfilial
                             , fr.setor
                             , fr.idregiaovenda
                             , fr.semana
                             , fr.idcomissao
                             , fr.idfechamentopontuacao
                             , fr.observacao
                             , fr.qtdnotasnovas + nvl(fr.qtdnotasnovasoutrareg,0) qtdnotasnovas
                             , fr.qtdnotaslevou
                             , fr.qtdnotasfechou
                             , fr.totalgeral 
                             , fr.totalcobranca 
                             , fr.vlrespecie
                             , fr.vlrcheque
                             , fr.vlrcomissao --"Vlr Comissão"
                             , fr.vlralvo --"Alvo"
                             , fr.totalpepinosrecebidos --"Débitos Recebidos"
                             , fr.totaldebitosnovos --"Débitos Novos"
                             , fr.totalcomissoesfavoritarepres --"Com. Paga Fav."
                             , fr.totaldebitosfavorita
                             , fr.totalqtddebitosfavorita
                             , fr.qtdnotasatender 
                             , (select sum(valorpago)
                                  from pagamentocomissoes p
                                 where p.fechamento = fr.semana
                                   and p.idgerente  = ( select idgerente
                                                          from gerentes
                                                         where idpessoa = ( select idpessoa
                                                                           from representantes u
                                                                          where u.idrepresentante = fr.idrepresentante ) ) ) vlrgerente';
                  
                p_where2 := 
                            ', dd.valor valorDep
                             , qtdnotas.qtde 
                             , pd.valorpago
                             , pd.qtdpedidos
                             , ( select count(1)
                                   from favorita.pedidos pf
                                   where pf.idrepresentante = fr.idrepresentante
                                     and pck_util.fnc_semanaid(pf.idsemanaemissao) = fr.semana
                                     and pf.idsituacaoentrega >= 20000
                                     and pf.datacancelamento is null ) qtdped --"Qtd Pedidos"
                             --
                        from fechamentorepresentantes fr
                           , fechamentossemanais      fs
                           , vw_pagamentos_dist_rmc   pd
                           --
                           , (select d.idfechamentorepres, 
                                     sum(d.valordeposito) valor
                                from depositosdiarios_orig d
                                where d.tipo in (''DD'',''CC'')
                                group by d.idfechamentorepres) dd
                           --
                           , ( select nvl(n.idrepresentanteatende,n.idrepresentante) idrep,
                                      f.idfechamentorepres,
                                      count(1) qtde
                                 from notasvendas n
                                    , fechamentorepresentantes f
                                    , fechamentossemanais      s
                                 where f.idfechamento = s.idfechamento
                                   and s.idsemana between to_number((select V(''P491_IDFECHAMENTOINI'') from dual)) and to_number( (select V(''P491_IDFECHAMENTOFIM'') from dual) )
                                   and ( (select V(''P0_IDFILIAL'') from dual) is null 
                                         or ( (select V(''P0_IDFILIAL'') from dual)  = 1135 and f.idfilial in (1089,1090,1132,124,122,320,221,1070,1072,1071,1082,1083,1210,1106,1227,1223,1243) )
                                         or ( (select V(''P0_IDFILIAL'') from dual) != 1135 and f.idfilial  = (select V(''P0_IDFILIAL'') from dual)  ) )
                                   and ( (select V(''P491_PESQUISARPOR'') from dual) is null
                                         or ( (select V(''P491_PESQUISARPOR'') from dual) = ''D'' and ( (select V(''P491_IDREPRESENTANTE'') from dual) is null or 
                                                                                                        f.idrepresentante = (select V(''P491_IDREPRESENTANTE'') from dual)  ) )
                                         or ( (select V(''P491_PESQUISARPOR'') from dual) = ''G'' and exists ( select 1
                                                                                  from filtrosrepresentantes fil
                                                                                  where fil.usuario = (select V(''P0_USUARIO'') from dual)
                                                                                    and fil.idrepresentante = f.idrepresentante ) ) )    
                                 
                                   and nvl(n.idrepresentanteatende,n.idrepresentante)   = f.idrepresentante
                                   and n.semanacobranca        = (select pck_romance.fnc_proximasemana(f.SEMANA) 
                                                                    from fechamentossemanais
                                                                   where idfechamento = f.idfechamentopontuacao )
                                   and n.idsituacaonotavenda   = 3
                                   and pck_util.fnc_idsemana(n.semanacobranca) - pck_util.fnc_idsemana(n.semanadistribuicao) > 6 
                              
                                 group by nvl(n.idrepresentanteatende,n.idrepresentante), f.idfechamentorepres    ) qtdnotas';
                           --
                                
                p_where3 := 
                     '  where fr.idfechamento = fs.idfechamento
                          and fs.idsemana between to_number((select V(''P491_IDFECHAMENTOINI'') from dual) ) and to_number((select V(''P491_IDFECHAMENTOFIM'') from dual) )
                          --
                          and fr.idrepresentante    = qtdnotas.idrep(+)
                          and fr.idfechamentorepres = qtdnotas.idfechamentorepres(+)
                          and fr.idrepresentante    = pd.idrepresentante(+)
                          and fr.semana             = pd.semana(+)
                          and fr.idfechamentorepres = dd.idfechamentorepres(+)
                          and ( (select V(''P0_IDFILIAL'') from dual) is null 
                                    or ( (select V(''P0_IDFILIAL'') from dual)  = 1135 and fr.idfilial in (1089,1090,1132,124,122,320,221,1070,1072,1071,1082,1083,1210,1106,1227,1223,1243) )
                                    or ( (select V(''P0_IDFILIAL'') from dual) != 1135 and fr.idfilial  = (select V(''P0_IDFILIAL'') from dual) ) )
                    ) xx 
                     group by 
                       xx.idfechamentorepres
                     , xx.idrepresentante
                     , xx.semana
                     , xx.idfilial
                     , xx.setor
                     , xx.idregiaovenda 
                     , xx.idfechamentopontuacao
                     , xx.qtdnotasnovas 
                     , xx.qtdnotaslevou
                     , xx.qtdnotasfechou
                     , xx.vlralvo
                     , xx.totalgeral 
                     , xx.totalcobranca 
                     , xx.vlrespecie
                     , xx.vlrcheque
                     , xx.idcomissao
                     , xx.vlrcomissao
                     , xx.valordep
                     , xx.observacao
                     , xx.totalpepinosrecebidos 
                     , xx.totaldebitosnovos
                     , xx.TOTALCOMISSOESFAVORITAREPRES
                     , xx.totaldebitosfavorita
                     , xx.totalqtddebitosfavorita
                     , xx.QTDNOTASATENDER';
                
                return p_where1 || p_where2 || p_where3;
                
                end;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
