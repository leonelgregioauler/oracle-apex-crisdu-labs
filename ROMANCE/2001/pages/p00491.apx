    process libera-proxima-semana (
        name: libera proxima semana
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  insert into LIBERACOESSEMANAIS
                  values (seq_idliberacoessemanais.nextval , :P491_SEMANALIBERAR , 'S', v('APP_USER'), :P491_IDREPRESENTANTE  );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Próxima semana liberada.
        }
        error {
            errorMessage: A próxima semana já foi liberada para este representante.
        }
        advanced {
            executionMappingIdentifier: 34141200082113472
        }
        serverSideCondition {
            type: request=Value
            value: LIBERAR
        }
    )

    branch (
        name: Go To Page 188
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 491
                items: {
                    P491_IDFECHAMENTO: &P491_IDFECHAMENTO.
                    P491_IDFECHAMENTOINI: &P491_IDFECHAMENTOINI.
