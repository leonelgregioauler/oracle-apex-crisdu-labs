        }
    )

    pageItem P491_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||decode(r.ativo,'S','Ativo','N','Inativo')||' - '|| (select min(nv.semanadistribuicao)
                                                                                                                                              from roman.notasvendas nv
                                                                                                                                              where nv.idrepresentante = r.idrepresentante)  display_value
                   , r.idrepresentante return_value
                from catal.representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: "- Todos - "
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

