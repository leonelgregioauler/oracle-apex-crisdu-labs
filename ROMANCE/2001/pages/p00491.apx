        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: button
                button: @grupo-distribuidores
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P491_IDREPRESENTANTE
            }
            execution {
                sequence: 10
            }
        )

