            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P491_IDFECHAMENTOFIM (
        type: selectList
        label {
            label: até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semanacompleta display_value
                     , idsemana return_value
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-3 and to_char(sysdate,'RRRR')
                order by s.idsemana desc
                ```
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P491_IDFECHAMENTOINI (
        type: selectList
        label {
            label: De
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semanacompleta display_value
                     , idsemana return_value
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-3 and to_char(sysdate,'RRRR')
                order by s.idsemana desc
                ```
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
