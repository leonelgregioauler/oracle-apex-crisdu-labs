page 509 (
    name: Conferência de Cargas de Distribuidores
    title: Conferência de Cargas de Distribuidores
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cargas-para-conferir (
        name: Cargas para Conferir
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcargarepresentante
                     , c.idcargarepresentante idcarga
                     , pck_romance.fnc_nomerepresentante(c.idrepresentante) distribuidor
                     , sum( nvl(ic.qtd_pp_sugerida,0)
                          + nvl(ic.qtd_p_sugerida,0)
                          + nvl(ic.qtd_m_sugerida,0)
                          + nvl(ic.qtd_g_sugerida,0)
                          + nvl(ic.qtd_gg_sugerida,0)
                          + nvl(ic.qtd_egg_sugerida,0)
                          + nvl(ic.qtd_exgg_sugerida,0)
                          + nvl(ic.qtd_u_sugerida,0) ) sugerido
                     , sum( nvl(ic.qtd_dist_pp,0)
                          + nvl(ic.qtd_dist_p,0)
                          + nvl(ic.qtd_dist_m,0)
                          + nvl(ic.qtd_dist_g,0)
                          + nvl(ic.qtd_dist_gg,0)
                          + nvl(ic.qtd_dist_egg,0)
                          + nvl(ic.qtd_dist_exgg,0)
                          + nvl(ic.qtd_dist_u,0) ) distribuido
                from cargasrepresentantes c
                   , itenscargarepresentante ic
                where ic.idcargarepresentante = c.idcargarepresentante
                  and c.idsemana              = :P509_IDSEMANA
                  and c.idfilial              = :P0_IDFILIAL
                  and ( :P509_IDPOSTOAVANCADO is null or exists ( select 1
                                                                  from representantes r
                                                                  where r.idrepresentante = c.idrepresentante
                                                                    and r.idpostoavancado = :P509_IDPOSTOAVANCADO ) )
                group by c.idcargarepresentante, c.idrepresentante
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 1568222361681374634
        }

        column DISTRIBUIDO (
            type: plainText
            heading {
                heading: Distribuido
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDCARGA (
            type: plainText
            heading {
                heading: Idcarga
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDCARGAREPRESENTANTE (
            type: link
            heading {
                heading: Ver Itens
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: javascript:void(0)
                }
                linkText: <span class="fa fa-chevron-down"></span><span class="IDCARGA" style="display:none">#IDCARGA#</span>
                linkAttributes: class="listaitenscarga"
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column SUGERIDO (
            type: plainText
            heading {
                heading: Sugerido
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            fontWeight: bold
            backgroundColor: #efefef
        }

        savedReport 15755271 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DISTRIBUIDO (
                sequence: 4
            )

            displayColumn DISTRIBUIDOR (
                sequence: 2
            )

            displayColumn IDCARGAREPRESENTANTE (
                sequence: 1
            )

            displayColumn SUGERIDO (
                sequence: 3
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P509_IDPOSTOAVANCADO (
        type: radioGroup
        label {
            label: Posto Avançado
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome
                     , p.idpostoavancado
                from postoavancado p
                where p.idfilial = :P0_IDFILIAL
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P509_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.semana
                     , c.idsemana
                from (
                select distinct semana
                     , idsemana
                from cargasrepresentantes c
                where c.idfilial = :P0_IDFILIAL 
                order by idsemana desc ) c
                where rownum <= 30
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction lista-de-itens (
        name: Lista de Itens
        execution {
            sequence: 10
            eventScope: dynamic
            staticContainer: body
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .listaitenscarga
        }

        action plugin-pretius-apex-nested-reports (
            action: plugin/pretiusApexNestedReports
            settings {
                defaultCallbackOptions: [
                    cacheResults
                    collapseExpanded
                    addAnimation
                    loadingIndicator
                ]
                defaultTemplateOptions: strechReport
                detailsQuery:
                    ```sql
                    select ( select codigosisdist
                             from produtos p
                             where p.idproduto = ic.idproduto ) "Código"
                         , pck_romance.fnc_nomeproduto(ic.idproduto) "Produto"
                         , decode(ic.cargaamais,'S','Sim','N','Não') "Carga Mais?"
                         , nvl(ic.qtd_dist_pp,0) "QTD PP"
                         , nvl(ic.qtd_dist_p,0) "QTD P"
                         , nvl(ic.qtd_dist_m,0) "QTD M"
                         , nvl(ic.qtd_dist_g,0) "QTD G"
                         , nvl(ic.qtd_dist_gg,0) "QTD GG"
                         , nvl(ic.qtd_dist_egg,0) "QTD EGG"
                         , nvl(ic.qtd_dist_exgg,0) "QTD EXGG"
                         , nvl(ic.qtd_dist_u,0) "QTD U"
                         , nvl(ic.qtd_dist_pp,0)
                         + nvl(ic.qtd_dist_p,0)
                         + nvl(ic.qtd_dist_m,0)
                         + nvl(ic.qtd_dist_g,0)
                         + nvl(ic.qtd_dist_gg,0)
                         + nvl(ic.qtd_dist_egg,0)
                         + nvl(ic.qtd_dist_exgg,0) 
                         + nvl(ic.qtd_dist_u,0) "Total Distribuidor"
                         , ic.quantidade "Sugerido"
                    from itenscargarepresentante ic
                    where ic.idcargarepresentante = '#IDCARGA#'
                    order by 2
                    ```
                whenNoDataFound: Nenhum item encontrado!
            }
            affectedElements {
                selectionType: region
                region: @cargas-para-conferir
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go To Page 509
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 509
                items: {
                    P509_IDSEMANA: &P509_IDSEMANA.
                    P509_IDPOSTOAVANCADO: &P509_IDPOSTOAVANCADO.
                }
                action: resetPagination
            }
        }
    )

)

