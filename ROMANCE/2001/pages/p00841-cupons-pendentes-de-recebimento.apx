page 841 (
    name: Cupons Pendentes de Recebimento
    alias: CUPONS-PENDENTES-DE-RECEBIMENTO
    title: Cupons Pendentes de Recebimento
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region filtros (
        name: "Filtros "
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region itens-pendentes-de-recebimento (
        name: Itens Pendentes de Recebimento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ccl.nomecampanha "Campanha"
                     , clc.idconquistoulevoucupom "Código Cupom"
                     , roman.pck_romance.fnc_nomevendedora(clc.idvendedora) "Vendedora"
                     , icq.qtditem "Qtd. Pendente"
                     , fil.nomefilial "Filial Retira"
                     , (select descricao from table(catal.pck_util.fnc_siglasistema('TIPO_SITUACAO_CONQ_LEVOU_CUPONS',clc.situacao)) ) AS situacao_cupom
                  from roman.campanhasconquistoulevou ccl
                     , roman.conquistoulevoucupons clc
                     , roman.itensconqlevcupons icq
                     , roman.vw_franquia_loja_conquistou_levou fil
                 where ccl.idconquistoulevou = clc.idconquistoulevou
                   and clc.idconquistoulevoucupom = icq.idconquistoulevoucupom
                   and clc.idfilialretira = fil.idfilial
                    and icq.pend_remessa = 'S' -- descomentar para produção
                
                   and (
                         (
                           :P841_IDCAMPANHA = '-1'
                           and ccl.status = :P841_ATIVA
                         )
                         or
                         (
                           :P841_IDCAMPANHA <> '-1'
                           and ccl.idconquistoulevou = to_number(:P841_IDCAMPANHA)
                         )
                       )
                
                   and (
                         :P841_IDLOJA = '-1'
                         or clc.idfilialretira = to_number(:P841_IDLOJA)
                       )
                
                   and :P841_FILTRAR = 'S'
                 order by ccl.nomecampanha, clc.idconquistoulevoucupom
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1843216696798864944
        }

        column Campanha (
            type: plainText
            heading {
                heading: Campanha
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: R
            }
        )

        column "Código Cupom" (
            type: plainText
            heading {
                heading: Código Cupom
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: M
            }
        )

        column "Filial Retira" (
            type: plainText
            heading {
                heading: Filial Retira
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: P
            }
        )

        column "Qtd. Pendente" (
            type: plainText
            heading {
                heading: Qtd. Pendente
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: O
            }
        )

        column SITUACAO_CUPOM (
            type: plainText
            heading {
                heading: Situação Cupom
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: S
            }
        )

        column Vendedora (
            type: plainText
            heading {
                heading: Vendedora
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: N
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 18069880 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Campanha" (
                sequence: 1
            )

            displayColumn "Código Cupom" (
                sequence: 2
            )

            displayColumn "Filial Retira" (
                sequence: 3
            )

            displayColumn "Qtd. Pendente" (
                sequence: 5
            )

            displayColumn "Vendedora" (
                sequence: 4
            )

            controlBreak (
                column: "Campanha"
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P841_ATIVA (
        type: radioGroup
        label {
            label: Campanha Ativa:
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: S
        }
    )

    pageItem P841_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P841_IDCAMPANHA (
        type: selectList
        label {
            label: "Campanha : "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecampanha
                     , c.idconquistoulevou
                from roman.campanhasconquistoulevou c
                where c.status = :P841_ATIVA
                
                ```
            nullDisplayValue: --Todas--
            nullReturnValue: -1
        }
        cascadingLov {
            parentItems: P841_ATIVA
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
    )

    pageItem P841_IDLOJA (
        type: selectList
        label {
            label: Franquia / Loja :
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select lj.nomefilial d
                     , lj.idfilial r
                  from roman.vw_franquia_loja_conquistou_levou lj
                 where lj.idpais = ( select cp.idpais
                                       from roman.campanhasconquistoulevou cp 
                                      where cp.idconquistoulevou = :P841_IDCAMPANHA ) 
                ```
            nullDisplayValue: --Todas--
            nullReturnValue: -1
        }
        cascadingLov {
            parentItems: P841_IDCAMPANHA
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 841
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 841
                items: {
                    P841_IDCAMPANHA: &P841_IDCAMPANHA.
                    P841_IDLOJA: &P841_IDLOJA.
                    P841_FILTRAR: S
                    P841_ATIVA: &P841_ATIVA.
                }
                clearCache: 841
            }
        }
    )

)

