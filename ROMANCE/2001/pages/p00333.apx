page 333 (
    name: Impressão de Resgates
    title: Impressão de Resgates
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão-de-resgates (
        name: Impressão de Resgates
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_imprime.prc_imprimelistaresgate(pidrepresentante => :P333_IDREPRESENTANTE,
                                                      pidfechamentorepres => :P333_IDFECHAMENTOREPRES);
                end;
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P333_IDFECHAMENTOREPRES (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @impressão-de-resgates
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P333_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @impressão-de-resgates
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vtipo varchar2(1);
                begin
                  --
                  begin
                    --
                    select 'V'
                    into vtipo
                    from catal.pedidos
                    where idpedido = :P333_IDPEDIDO;
                    --
                  exception
                    when others then
                      vtipo := 'N';
                  end;
                  --
                  return vtipo;
                  --
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

