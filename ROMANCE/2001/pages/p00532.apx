page 532 (
    name: Transferir P/ Reembalagem Cód. Barras
    title: Transferir P/ Reembalagem Cód. Barras
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 80%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline: ".t-Region-body { background-color: Beige !important;},"
    }
    security {
        pageAccessProtection: unrestricted
    }

    region itensbipados (
        name: itensbipados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*( select initcap( pr.codigosisdist ) 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Código"      
                     , ( select initcap( pr.nomeproduto ) 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Produto"  */
                         
                       initcap( pr.codigosisdist ) "Código"
                     , initcap( pr.nomeproduto )   "Produto"
                     
                     , me.datamovimento "Data Movimento"
                     
                     --, e.idestoquefilial
                     --, e.idproduto
                     --, me.qtd_u 
                     , nvl(me.qtd_pp,0)   +
                       nvl(me.qtd_p,0)    +
                       nvl(me.qtd_m,0)    +
                       nvl(me.qtd_g,0)    +
                       nvl(me.qtd_gg,0)   +
                       nvl(me.qtd_egg,0)  +
                       nvl(me.qtd_exgg,0) +
                       nvl(me.qtd_u,0) "Quantidade"
                     
                     , embaladopor
                     
                from estoquefilial           e
                   , movimentosestoquereemb me
                   , produtos               pr
                where e.idestoquefilial = me.idestoquefil
                  and e.idfilial = :P0_IDFILIAL
                  and e.idproduto = pr.idproduto
                  and me.datamovimento between to_date(trunc(sysdate)||' 00:00:01','dd/mm/rrrr hh24:mi:ss')
                                           and to_date(trunc(sysdate)||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                order by me.datamovimento desc
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }

        column Código (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Código
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column "Data Movimento" (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data Movimento
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column EMBALADOPOR (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Embaladopor
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column Produto (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Produto
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column Quantidade (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Quantidade
                alignment: end
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

    )

    region realizar-movimentação (
        name: Realizar Movimentação
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P532_AVISO (
        type: textField
        label {
            label: Atenção:  Tente de novo, movimentação não realizada.
            alignment: left
        }
        layout {
            sequence: 60
            region: @realizar-movimentação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: item=value
            item: P532_SUCESSO
            value: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P532_CODIGOBARRAS (
        type: textField
        label {
            label: Bipe Aqui >
            alignment: left
        }
        layout {
            sequence: 40
            region: @realizar-movimentação
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 13
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P532_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @realizar-movimentação
            slot: regionBody
        }
        source {
            type: item
            item: P0_IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P532_SUCESSO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @realizar-movimentação
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P532_USUARIO (
        type: selectList
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ' DUPLA' d
                     , 'DUPLA' r
                from dual
                where exists ( select 1
                               from parametros p
                               where p.idfilial = :P0_IDFILIAL 
                                 and p.nome = 'REEMBALAGEMPOREQUIPE'
                                 and p.valor = 'S' )
                union
                select ' TRIO' d
                     , 'TRIO' r
                from dual
                where exists ( select 1
                               from parametros p
                               where p.idfilial = :P0_IDFILIAL 
                                 and p.nome = 'REEMBALAGEMPOREQUIPE'
                                 and p.valor = 'S' )
                union
                select ' EQUIPE' d
                     , 'EQUIPE' r
                from dual
                where exists ( select 1
                               from parametros p
                               where p.idfilial = :P0_IDFILIAL 
                                 and p.nome = 'REEMBALAGEMPOREQUIPE'
                                 and p.valor = 'S' )
                union
                select ' FREELANCER' d
                     , 'FREELANCER' r
                from dual
                union
                select ' FREELANCER2' d
                     , 'FREELANCER2' r
                from dual
                union
                select ' FREELANCER3' d
                     , 'FREELANCER3' r
                from dual
                union
                select ' PEÇAS PRONTAS' d
                     , 'PEÇASPRONTRAS' r
                from dual
                union
                select pck_romance.fnc_nomepessoa(f.idpessoa) nome
                     , f.identificacao
                from funcionarios f
                where f.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                  and f.idcargo in (0,7)
                  and f.ativo     = 'S' 
                  and f.identificacao is not null
                order by 1
                ```
        }
        layout {
            sequence: 30
            region: @realizar-movimentação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: expression
            plsqlExpression: nvl(:P532_USUARIO,'CESAR')
        }
        security {
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar e Atualizar
        layout {
            sequence: 10
            region: @realizar-movimentação
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 102
                items: {
                    P102_IDFILIAL: &P532_IDFILIAL.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction movimenta-reembalagem (
        name: Movimenta Reembalagem
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P532_CODIGOBARRAS
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P532_CODIGOBARRAS
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: MOVTOREEMBALAGEM
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-focus (
        name: Set Focus
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P532_CODIGOBARRAS
            }
            execution {
                sequence: 10
            }
        )

    )

    process movimenta-reemlagem (
        name: Movimenta Reemlagem
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vsucesso varchar2(1); 
                begin
                  -- Call the procedure
                  pck_estoque_v2.prc_movimentareembalagem(pcodigobarras => :P532_CODIGOBARRAS,
                                                          pidfilial => :P532_IDFILIAL,
                                                          pusuario => :P532_USUARIO,
                                                          psucesso => vsucesso);
                  --
                  :P532_SUCESSO := vsucesso;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Movimentação realizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1603196201549180220
        }
        serverSideCondition {
            type: request=Value
            value: MOVTOREEMBALAGEM
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 532
                items: {
                    P532_CODIGOBARRAS:
                    P532_SUCESSO:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'MOVTOREEMBALAGEM'
                  and :P532_SUCESSO = 'S'
                ```
        }
    )

    branch (
        name: Go To Page 532
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 532
                items: {
                    P532_CODIGOBARRAS: &P532_CODIGOBARRAS.
                    P532_SUCESSO: &P532_SUCESSO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'MOVTOREEMBALAGEM'
                  and :P532_SUCESSO = 'N'
                ```
        }
    )

)

