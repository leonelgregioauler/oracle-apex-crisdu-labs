page 549 (
    name: Distribuidores que atendem a Cidade
    title: Distribuidores que atendem a Cidade
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cidades-que-são-atendidas (
        name: Cidades que são Atendidas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) distribuidor
                     , ( select count(distinct idpessoa)
                         from pessoas p
                         where p.idcidade = :P549_IDCIDADE
                           and exists ( select 1
                                        from vendedoras v
                                        where v.idpessoa = p.idpessoa
                                          and v.idrepresentante = r.idrepresentante
                                          and v.ativo    = 'S'
                                          and v.idfilial = :P549_IDFILIAL
                                          and exists ( select 1
                                                       from notasvendas nv
                                                       where nv.idvendedora = v.idvendedora 
                                                          and nv.datanota between to_date(:P549_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P549_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) ) ) qtdconsultoras
                from representantes r
                where pck_romance.fnc_filialrepresentante(r.idrepresentante) = :P549_IDFILIAL
                 and r.ativo = 'S'
                 and exists ( select 1 
                              from notasvendas nv
                                 , vendedoras v
                                 , pessoas p
                              where nv.idrepresentante = r.idrepresentante
                                and v.idvendedora      = nv.idvendedora
                                and p.idpessoa         = v.idpessoa
                                and p.idcidade         = :P549_IDCIDADE
                                and nv.idfilial        = :P549_IDFILIAL
                                and nv.datanota between to_date(:P549_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P549_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')  ) 
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DISTRIBUIDOR (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                defaultSequence: 1
            }
        )

        column QTDCONSULTORAS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Quantidade de Cosultoras
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            advanced {
                computeSum: true
            }
        )

    )

    pageItem P549_DATAFIM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @cidades-que-são-atendidas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P549_DATAINICIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @cidades-que-são-atendidas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P549_IDCIDADE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cidades-que-são-atendidas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P549_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @cidades-que-são-atendidas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

