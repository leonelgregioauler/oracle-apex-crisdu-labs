page 507 (
    name: Anexos Pagamentos Negociações de Balanços
    title: Anexos Pagamentos Negociações de Balanços
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-700x
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P328_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos-balanços (
        name: Anexos Balanços
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            footerText: <font color="green"> Você pode anexar mais de um arquivo.</font>
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     --, '<a href="javascript: fnc_verimg('''||iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' 
                     , idpagamentobalanco||idanexopgtobalanco||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     , '<a href="javascript: fnc_removeanexo('||idanexopgtobalanco||','''||t.nomearquivo||''');">Remover</a>' remover
                from ANEXOSPGTOSBALANCOS t
                where idpagamentobalanco = :P507_IDPAGAMENTOBALANCO
                order by t.data
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from ANEXOSPGTOSBALANCOS t
                where idpagamentobalanco = :P507_IDPAGAMENTOBALANCO
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column LINK (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Link
                alignment: center
            }
            layout {
                sequence: 2
            }
            link {
                target: {
                    page: 383
                    items: {
                        P383_ARQUIVO: #LINK#
                    }
                    action: resetPagination
                }
                linkText: Ver Anexo
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column REMOVER (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Usuario
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P507_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            filenameColumn: NOMEARQUIVO
            fileTypes: image/png,image/jpeg,application/pdf
        }
        layout {
            sequence: 20
            region: @anexos-balanços
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P507_DATA (
        type: hidden
        layout {
            sequence: 60
            region: @anexos-balanços
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P507_IDANEXODELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @anexos-balanços
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P507_IDANEXOPGTOBALANCO (
        type: hidden
        layout {
            sequence: 10
            region: @anexos-balanços
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXOPGTOBALANCO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P507_IDPAGAMENTOBALANCO (
        type: textField
        label {
            label: ID Pagamento
            alignment: left
        }
        layout {
            sequence: 10
            region: @anexos-balanços
            slot: regionBody
            alignment: left
            columnAttributes: readonly
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        advanced {
            customAttributes: readonly
        }
        source {
            type: databaseColumn
            databaseColumn: IDPAGAMENTOBALANCO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P507_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @anexos-balanços
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                begin
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  return vidusuario;
                  --
                end;
                  
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P507_NOMEARQUIVO (
        type: hidden
        layout {
            sequence: 30
            region: @anexos-balanços
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 30
            region: @anexos-balanços
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 20
            region: @anexos-balanços
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P507_IDANEXOPGTOBALANCO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar para Negociação
        layout {
            sequence: 10
            region: @anexos-balanços
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 501
                items: {
                    P501_IDPAGAMENTONEGOCIACAO: &P507_IDPAGAMENTOBALANCO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation informar-arquivo (
        name: Informar arquivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P507_ARQUIVOTEMP
        }
        error {
            errorMessage: Selecione o arquivo!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_pgtobalancos(pidpagamentobalanco => :P507_IDPAGAMENTOBALANCO);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1568102345686918861
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P507_IDANEXOBALANCO := null;
                  pck_anexos.prc_apagaanexo_pgtobalancos(pidanexopgtobalanco => :P507_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Arquivo anexado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1568103932437918862
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexosdespesas (
        name: Fetch Row from ANEXOSDESPESAS
        type: autoRowFetch
        source {
            tableName: ANEXOSDESPESAS
            pkColumn: IDANEXODESPESA
            pkItem: P507_IDANEXOPGTOBALANCO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1568102726225918862
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P507_IDANEXOPGTOALANCO is null then
                        select "#OWNER#"."SEQ_IDANEXOPGTOBALANCO".nextval
                          into :P507_IDANEXOPGTOBALANCO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1568103179498918862
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexospgtosbalancos (
        name: Process Row of ANEXOSPGTOSBALANCOS
        type: autoRowProcessing
        target {
            tableName: ANEXOSPGTOSBALANCOS
            pkColumn: IDANEXOPGTOBALANCO
            pkItem: P507_IDANEXOPGTOBALANCO
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Arquivo Anexado
        }
        advanced {
            executionMappingIdentifier: 1568103556845918862
        }
    )

    branch (
        name: Go To Page 499
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 507
                items: {
                    P507_IDANEXOPGTOBALANCO:
                    P507_IDPAGAMENTOBALANCO: &P507_IDPAGAMENTOBALANCO.
                }
                action: resetPagination
            }
        }
    )

)

