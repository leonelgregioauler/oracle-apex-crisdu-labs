page 429 (
    name: Consulta de SPC Realizada
    title: Consulta de SPC Realizada
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-de-consultas-realizadas (
        name: Relatório de Consultas Realizadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idconsultaspc
                     , c.dataconsulta
                     , c.protocolo
                     , c.numero||'-'||c.digito
                     , c.cpf
                     , c.regiaocpf
                     , c.situacaocpf
                     , c.nome
                     , c.datanascimento
                     , c.spc_quantidade
                     , c.spc_valortotal
                     , c.usuario
                     , c.semana
                from vw_consultaspc c
                where ( :P429_CPF is null or c.cpf = replace(replace(replace(:P429_CPF,'.',''),'-',''),' ','') )
                  and ( :P429_DATAINICIO is null or trunc(c.dataconsulta) between to_date(:P429_DATAINICIO) and to_date(:P429_DATAFIM) )
                  and c.idfilial = :P0_IDFILIAL
                order by 2 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 430
                items: {
                    P430_IDCONSULTASPC: #IDCONSULTASPC#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1492567934888879920
        }

        column C.NUMERO||'-'||C.DIGITO (
            type: plainText
            heading {
                heading: Protocolo
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column CPF (
            type: plainText
            heading {
                heading: Cpf
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column DATACONSULTA (
            type: plainText
            heading {
                heading: Consultado Em
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column DATANASCIMENTO (
            type: plainText
            heading {
                heading: Data de Nascimento
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            appearance {
                formatMask: DDMM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        column IDCONSULTASPC (
            type: hidden
            heading {
                heading: Idconsultaspc
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column PROTOCOLO (
            type: plainText
            heading {
                heading: "Nr Consulta "
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column REGIAOCPF (
            type: plainText
            heading {
                heading: Região do CPF
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: M
            }
        )

        column SITUACAOCPF (
            type: plainText
            heading {
                heading: Situação do CPF
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column SPC_QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade de Registros
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column SPC_VALORTOTAL (
            type: plainText
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Consultado Por
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 14927820 (
            visibility: primaryDefault
            view {
                groupBy: true
                rowsPerPage: 50
            }

            displayColumn C.NUMERO||'-'||C.DIGITO (
                sequence: 2
            )

            displayColumn CPF (
                sequence: 3
            )

            displayColumn DATACONSULTA (
                sequence: 1
            )

            displayColumn DATANASCIMENTO (
                sequence: 7
            )

            displayColumn NOME (
                sequence: 6
            )

            displayColumn REGIAOCPF (
                sequence: 4
            )

            displayColumn SEMANA (
                sequence: 11
            )

            displayColumn SITUACAOCPF (
                sequence: 5
            )

            displayColumn SPC_QUANTIDADE (
                sequence: 8
            )

            displayColumn SPC_VALORTOTAL (
                sequence: 9
            )

            displayColumn USUARIO (
                sequence: 10
            )

            groupByColumn (
                column: USUARIO
                layout {
                    sequence: 1
                }
            )

            groupByAggregate (
                heading: Total de Consultas
                aggregate {
                    function: count
                    column: C.NUMERO||'-'||C.DIGITO
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P429_CPF (
        type: textField
        label {
            label: CPF
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P429_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P429_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 429
                items: {
                    P429_CPF: &P429_CPF.
                    P429_DATAINICIO: &P429_DATAINICIO.
                    P429_DATAFIM: &P429_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

