    region débitos-romance-2 (
        name: Débitos Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(nv.idvendedora) vendedora
                     , nv.numeronota
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.valortotalnota
                     , nv.valortotalvendalqd
                     , nv.valorpago
                     , nv.saldo
                     , pck_util.fnc_calculajuros_v2( p_valor_debito => nv.saldo,
                                                      p_data_venc    => nv.dataretornoorig,
                                                      p_data_calc    => sysdate,
                                                      p_idpais       => catal.pck_util.fnc_paisvendedora(pidvendedora => nv.idvendedora)) valoratualizado
                from notasvendas nv
                where nv.idsituacaocobranca = 70
                  and nv.idsituacaonotavenda = 4
                  and nv.saldo > 0
                  and nv.idfilial = :P458_IDFILIAL
                  and nv.idrepresentante = :P458_IDREPRESENTANTE
                  and :P458_TIPORELATORIO = 'D'
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
