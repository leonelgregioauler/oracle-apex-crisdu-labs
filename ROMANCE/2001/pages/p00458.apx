    region débitos-romance (
        name: Débitos Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor
                     , count(1) qtd
                     , sum(nv.saldo) valordebito
                     , sum(pck_util.fnc_calculajuros_v2( p_valor_debito => nv.saldo,
                                                          p_data_venc    => nv.dataretornoorig,
                                                          p_data_calc    => sysdate,
                                                          p_idpais       => catal.pck_util.fnc_paisvendedora(pidvendedora => nv.idvendedora))) valoratualizado
                from notasvendas nv
                where nv.enviadocobranca = 'S'
                  and nv.saldo > 0
                  and nv.idsituacaocobranca = 70
                  and nv.idfilial = :P458_IDFILIAL
                  and :P458_TIPORELATORIO = 'R'
                group by nv.idrepresentante
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
