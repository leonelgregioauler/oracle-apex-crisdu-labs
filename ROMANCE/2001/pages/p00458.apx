    region débitos-favorita (
        name: Débitos Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.representante
                     , count(1) qtd
                     , sum(v.ValorTotal) total
                     , sum(v.valoratualizado) totalatualizado
                from vw_debitosrepresfavorita v
                where v.idfilial = :P458_IDFILIAL
                  and :P458_TIPORELATORIO = 'R'
                group by v.Representante
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P458_TIPORELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum dado encontrado, verifique os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 1520015995478224221
