    validation valida-total (
        name: Valida Total
        execution {
            sequence: 100
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  v_total_D NUMBER;
                  v_total_C number;
                  v_existe  number;
                BEGIN
                  -- So validar se for 'S'
                  IF :P86_TEMCNPJ = 'S' THEN
                    -- Verifica se existe registro na tabela despesasformaspag
                    select sum(C006)
                      into v_total_C
                      from apex_collections ac
                     where collection_name = 'COL_'||v('APP_USER');
                
                    select sum(valor)
                      into v_total_D
                      from despesasformaspag
                     where idsaida = :P86_IDSAIDA;
                    
                    begin
                      select 1
                        into v_existe
                        from dual
                       where to_number(replace(:P86_VALORTOTAL,'.','')) <> nvl(v_total_C, v_total_D);
                           
                           /*  (SELECT sum(valor)
                                FROM despesasformaspag
                               WHERE idsaida = :P86_IDSAIDA);*/
                    exception
                      when others then null;
                    end;
                    --
                    IF v_existe = 1 THEN
                      RETURN FALSE;
                    END IF;
                  END IF;
                  RETURN TRUE;
                END;
                ```
        }
        error {
            errorMessage: O valor lançado em "Formas Pagamentos" deve ser igual ao "Valor Total" da despesa.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process atualizadespformaspag (
        name: AtualizaDespFormasPag
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  v_nomecol varchar2(50);
                  --
                begin
                  --
                  v_nomecol := 'COL_'||v('APP_USER');
                  --
                  --
                  if :P86_TEMCNPJ = 'S' then
                    MERGE INTO despesasformaspag dfp
                        USING (
                          SELECT
                            c002 AS idsaida,
                            c003 AS tipolancamento,
                            c004 AS tipopagamento,
                            c005 AS idformapagamento,
                            TO_NUMBER(c006) AS valor,
                            c007 AS idcontacorrente,
                            c008 AS iddespesaformapag
                          FROM apex_collections
                          WHERE collection_name = v_nomecol  ) col
                        ON (
                          dfp.idsaida = col.idsaida AND
                          dfp.iddespesaformapag = col.iddespesaformapag  )
                        WHEN MATCHED THEN
                          UPDATE SET
                            dfp.valor            = col.valor,
                            dfp.idcontacorrente  = col.idcontacorrente,
                            dfp.tipolancamento   = col.tipolancamento,
                            dfp.tipopagamento    = col.tipopagamento,
                            dfp.idformapagamento = col.idformapagamento
                        WHEN NOT MATCHED THEN
                          INSERT (
                            idsaida,
                            tipolancamento,
                            tipopagamento,
                            idformapagamento,
                            valor,
                            idcontacorrente,
                            iddespesaformapag   )
                          VALUES (
                            :P86_IDSAIDA,
                            col.tipolancamento,
                            col.tipopagamento,
                            col.idformapagamento,
                            col.valor,
                            col.idcontacorrente,
                            seq_iddespesaformapag.NEXTVAL );
                
