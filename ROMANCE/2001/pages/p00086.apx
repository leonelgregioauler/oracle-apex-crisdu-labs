    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='Confirma a exclusão da Saída?';
            
            
            
            function  confirmasaida(event)
            { 
            var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            
            if (tecla==13) 
              {
            var answer = confirm("Confirma inclusão da saida?")
            	if (answer){            
            		apex.submit('CREATE');
            	}
              }
            }
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                    -- , '<a href="javascript: fnc_verimg('''||idsaida||idanexosaida||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' link
                     , idsaida||idanexosaida||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) id
                     , dataanexo data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario) usuario
                     , url_bucket link
                from anexossaidas t
                where idsaida = :P86_IDSAIDA
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P86_IDSAIDA
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 767067522075495616
        }

