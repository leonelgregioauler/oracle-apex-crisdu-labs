    pageItem P86_IDFILIALDEST (
        type: popupLov
        label {
            label: Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                where f.idpessoa  = p.idpessoa
                  and f.ativo = 'S'
                  and ( ( :P0_IDFILIAL in (123,1132,1084,1070,100,121) and f.idfilial not in ( 240,1073,1074,1069,341 ) )
                    or ( :P0_IDFILIAL not in (123,1132,1084,1070,100) and f.idfilial not in ( 240,1073,1074,220,1069,421,341,220 ) ) )
                  and f.idfilial != :P0_IDFILIAL
                  and f.idfilial not in (1188)
                  and ( :P86_IDFILIALDEST is null or f.idfilial = :P86_IDFILIALDEST )
                union
                select distinct initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                where f.idpessoa  = p.idpessoa
                  and f.ativo = 'S'
                  and f.idfilial = 200
                  and :P0_IDFILIAL = 100
                order by 1
                ```
        }
        layout {
            sequence: 100
            region: @nova-saida
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALDEST
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P86_IDSAIDA
        }
        security {
            encryptSessionState: false
        }
    )

