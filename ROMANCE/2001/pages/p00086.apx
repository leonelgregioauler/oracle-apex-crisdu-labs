    button anexar-arquivo (
        buttonName: ANEXAR_ARQUIVO
        label: Anexar arquivo
        layout {
            sequence: 30
            region: @nova-saida
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 339
                items: {
                    P339_IDANEXOSAIDA:
                    P339_IDSAIDA: &P86_IDSAIDA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P86_IDSAIDA is not null
                  and exists ( select 1
                               from fechamentossemanais f
                               where f.idfilial = :P0_IDFILIAL 
                                 and f.idfechamento = :P0_IDFECHAMENTO
                                 and f.concluido = 'N')
                ```
        }
    )

