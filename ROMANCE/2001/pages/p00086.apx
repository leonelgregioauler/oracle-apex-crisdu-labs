    process popula-valortotal (
        name: Popula_ValorTotal
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P86_IDSAIDA IS NOT NULL then
                    select valortotal
                         , lancamentodespesa
                         , idrazaosocialdestino
                      into :P86_VALORTOTAL
                         , :P86_LANCAMENTODESPESA
                         , :P86_IDRAZAOSOCIALDESTINO
                      from saidasdiversas
                     where idsaida = :P86_IDSAIDA;
                  end if;
                end;
