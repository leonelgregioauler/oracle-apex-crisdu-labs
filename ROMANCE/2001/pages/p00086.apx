    dynamicAction fator-conversao (
        name: Fator Conversao
        execution {
            sequence: 130
        }
        when {
            selectionType: items
            items: P86_IDFILIALDEST
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                      vfatorconversao number;
                      vidgrupo        number := 1;
                      vidgrupodestino number := 1;
                      vididioma       number := 1;
                      vididiomadest   number := 1;
                    begin
                      --
                      if :P86_IDFILIALDEST is not null then
                      begin
                        select idgrupo
                             , f.ididioma
                        into vidgrupo
                           , vididioma
                        from filiais f
                        where f.idfilial = :P0_IDFILIAL;
                      exception
                        when others then
                          vidgrupo := 1;
                      end;
                      --
                      begin
                        select idgrupo
                             , f.ididioma
                        into vidgrupodestino
                           , vididiomadest
                        from filiais f
                        where f.idfilial = :P86_IDFILIALDEST
                          and f.tipofilial = 'D';
                      exception
                        when others then
                          begin
                            --
                            select case
                                     when ididioma in (2,4) then
                                       5 
                                     else 
                                       1
                                   end idgrupo
                                 , f.ididioma
                            into vidgrupodestino
                               , vididiomadest
                            from filiais f
                            where f.idfilial = :P86_IDFILIALDEST
                              and f.tipofilial != 'D';
                            --
                          exception
                            when others then
                              vidgrupo := 1;
                          end;
                      end;
                      --
                      if vididioma != 1 and vididiomadest != 1 and vididiomadest != vididioma then
                        --
                        select fatorconversao
                        into vfatorconversao
                        from fechamentossemanais f
                        where f.idfechamento = ( select max(idfechamento)
                                                 from fechamentossemanais ff
                                                 where ff.idfilial = :P86_IDFILIALDEST );
                        --
                      elsif vidgrupo = 5 and nvl(vidgrupodestino,1) = 5 then
                        --
                        vfatorconversao := 1;
                        --    
                      elsif vidgrupo = 5 and nvl(vidgrupodestino,1) != 5 then
                        --
                        select fatorconversao
                        into vfatorconversao
                        from vw_filiais f
                        where f.idfilial = :P0_IDFILIAL;
                        --
                      elsif vididioma = vididiomadest then
                        --
                        vfatorconversao := 1;
                        --
                      else 
                        --
                        select fatorconversao
                        into vfatorconversao
                        from fechamentossemanais f
                        where f.idfechamento = ( select max(idfechamento)
                                                 from fechamentossemanais ff
                                                 where ff.idfilial = :P86_IDFILIALDEST );
                        --
                      end if;
                      --
                      --raise_application_error(-20001,nvl(vfatorconversao,1));
                      return  nvl(vfatorconversao,1);
                      --
                      end if;
                    end;
                    ```
                itemsToSubmit: P86_IDFILIALDEST
            }
            affectedElements {
                selectionType: items
                items: P86_FATORCONVERSAO
            }
            execution {
                sequence: 10
            }
        )

    )

