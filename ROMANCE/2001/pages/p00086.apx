    pageItem P86_IDCONTACONTABIL (
        type: selectList
        label {
            label: Conta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idcontafinan  return_value
                from contasfinanceiras c
                where exists ( select 1
                               from matrizclassificacoesdespesas m
                               where m.idmatrizclassificacao = :P86_IDMATRIZCLASSIFICACAO
                                 and m.idcontafinan          = c.idcontafinan )
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P86_IDMATRIZCLASSIFICACAO
        }
        layout {
            sequence: 170
            region: @nova-saida
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
