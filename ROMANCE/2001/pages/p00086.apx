                        select sum(C006)
                          into v_valor
                          from apex_collections
                         where collection_name = 'COL_'||v('APP_USER');
                      else
                        v_valor := :P86_VALORTOTAL;
                      end if;
                      --
                      return v_valor;
                      --
                    end;
                    ```
