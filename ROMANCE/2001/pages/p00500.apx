            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region lista-de-pagamentos (
        name: Lista de Pagamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idemprestimo
                     , e.nome
                	 , e.qtdparcelas
                	 , e.idrepresentante
                     , pck_romance.fnc_nomerepresentante(e.idrepresentante) representante
                     , t.idpagamento
                     , t.data
                     , t.valorpago
                     , t.observacao
                     , ( select semana
                         from fechamentossemanais
                         where idfechamento = t.idfechamento) "Fechamento"
                     , t.identificacao
                     , decode(t.emmaos,'S','Sim','N','Não') "Em Mãos"
                     , decode(t.semfundo,'S','Sim','N','Não')  semfundo
                from pagamentosemprestimos t
                   , emprestimos e
                where e.idfilial     = :P0_IDFILIAL
                  and e.idemprestimo = t.idemprestimo
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
