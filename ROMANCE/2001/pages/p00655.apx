page 655 (
    name: Notas em Aberto
    title: Notas em Aberto
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region notas-em-atraso (
        name: "Notas em Atraso "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select      roman.pck_romance.fnc_nomevendedora(b.idvendedora) Nome
                          , roman.pck_romance.fnc_cpfvendedora(b.idvendedora) CPF
                          , b.numeronota nota
                          , b.valortotalnota Valor_total
                          , b.semanadistribuicao
                          , b.semanacobranca
                          , b.semanacobrancaorig 
                          , b.qtdsemanas
                          , roman.pck_romance.fnc_nomefilial(b.idfilial) Franquia
                          , b.dataretorno
                          , b.idnotavenda
                          , b.telefone
                          , b.endereco
                     from(select n.idsemanacobranca - n.idsemanadistribuicao qtdsemanas
                               , n.idnotavenda
                               , g.idfilial
                               , n.idrepresentante
                               , g.idgerente
                               , n.idvendedora
                               , n.numeronota
                               , n.valortotalnota
                               , n.semanadistribuicao
                               , n.semanacobranca
                               , n.semanacobrancaorig 
                               , n.dataretorno
                               , ( select listagg( '(' || substr(t.telefonelimpo, 1, 2) || ') ' ||
                                                          substr(t.telefonelimpo, 3, 1) || ' ' ||
                                                          substr(t.telefonelimpo, 4, 4) || '-' ||
                                                          substr(t.telefonelimpo, 8, 4),' / '
                                           ) within group (order by t.telefonelimpo) as telefone
                                     from catal.telefonespessoas t
                                    where t.idpessoa = p.idpessoa) as telefone
                               , (p.enderecoprincipal||', '||p.numero||' - '||c.nomecidade||'/'||e.sigla) endereco
                          from roman.notasvendas n
                             , catal.gerentes g
                             , catal.filiais f
                             , catal.vendedoras v
                             , catal.pessoas p
                             , catal.cidades c
                             , roman.estados e
                          where n.idfilial = g.idfilial
                            and n.idfilial = f.idfilial
                            and n.idvendedora = v.idvendedora
                            and v.idpessoa = p.idpessoa
                            and p.idcidade = c.idcidade(+)
                            and c.idestado = e.idestado(+)
                            and n.idsituacaonotavenda = 3
                            and g.ativo = 'S'
                            and f.ativo = 'S'            
                            and g.idfilial != 1063 
                            and (:P655_DATAINI is null or trunc(n.datanota) between to_date(:P655_DATAINI, 'dd/mm/rrrr') and to_date(:P655_DATAFIM, 'dd/mm/rrrr'))
                         ) b
                     where b.qtdsemanas > 6
                       and (b.idfilial = :P655_FRANQUIA)
                       and (b.idrepresentante = :P655_DISTRIBUIDOR)
                     order by 1 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 32919152262076728
        }

