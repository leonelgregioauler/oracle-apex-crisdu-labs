        buttonName: CRIAR
        label: Criar e Continuar
        layout {
            sequence: 10
            region: @cadastro-de-endereço-de-entrega
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P462_IDENDERECOENTREGA
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @endereço-do-destinatário
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button proximo-passo-com (
        buttonName: PROXIMO_PASSO_COM
        label: Continuar
        layout {
            sequence: 20
            region: @endereço-do-destinatário
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 463
                items: {
                    P463_IDENDERECODESTINATARIO: &P462_IDENDERECOENTREGA.
                    P463_IDENDERECOREMETENTE: &P462_IDENDERECOREMETENTE.
                    P463_IDLOGISTICAREVERSA:
                    P463_IDNOTAVENDA: &P462_IDNOTAVENDA.
                    P463_IDOBJETOLOGISTICA:
                    P463_DESCRICAO:
                    P463_ENTREGA:
                    P463_NUMERO:
                    P463_QUANTIDADE:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                                   from favorita.enderecosentrega ee
                                   where ee.idpessoa = :P462_IDPESSOA )
                ```
        }
    )

    validation valida-cep-do-endereço (
        name: Valida Cep do Endereço_1
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P462_IDENDERECOENTREGA
        }
        error {
            errorMessage: É necessário selecionar um endereço de Entrega da mercadoria.
            displayLocation: onErrorPage
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('PROXIMO_PASSO_COM','CONTINUAR')
                ```
        }
    )

    validation valida-cep-do-endereço-2 (
        name: Valida Cep do Endereço
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from favorita.enderecosentrega a
                where a.idenderecoentrega = :P462_IDENDERECOENTREGA
                  and a.cep is null
                ```
        }
        error {
            errorMessage: É necessário que o CEP esteja informado para continuar a Logística.
            displayLocation: onErrorPage
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('PROXIMO_PASSO_COM','CONTINUAR')
                ```
        }
    )

    validation valida-cep-do-endereço-ao-atualizar (
        name: Valida Cep do Endereço ao Atualizar
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P462_CEP
        }
        error {
            errorMessage: É necessário que o CEP esteja informado para continuar a Logística.
            displayLocation: onErrorPage
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('ATUALIZAR_C','CRIAR')
                ```
        }
    )

    validation valida-endereço-destinatario (
        name: Valida Endereço Destinatario
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P462_IDENDERECOENTREGA
            alwaysExecute: true
        }
        error {
            errorMessage: É necessário escolher um endereço do Destinatário!
            associatedItem: @P462_IDENDERECOENTREGA
        }
        serverSideCondition {
            type: request=Value
            value: PROXIMO_PASSO_COM
        }
    )

    process consulta-endereço-de-entrega (
        name: Consulta Endereço de Entrega
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- 
                  favorita.pck_cadastros_fav.prc_enderecosentrega(pidenderecoentrega => :P462_IDENDERECOENTREGA,
                                                                  pidpessoa => :P462_IDPESSOA_C,
                                                                  prua => :P462_RUA,
                                                                  pnumero => :P462_NUMERO,
                                                                  pcomplemento => :P462_COMPLEMENTO,
                                                                  pbairro => :P462_BAIRRO,
                                                                  pcep => :P462_CEP,
                                                                  pidcidade => :P462_IDCIDADE,
                                                                  pobservacao => :P462_OBSERVACAO,
                                                                  preferencia => :P462_REFERENCIA,
                                                                  pmd5 => :P462_MD5,
                                                                  poperacao_dml => 'S');
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1522730918767796906
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P462_IDENDERECOENTREGA
        }
    )

    process operação-dml-em-endereços-de-entrega (
        name: Operação DML em Endereços de Entrega
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'ATUALIZAR_C' then
                    --
                    voperacao_dml := 'U';
                    --
                  end if;
                  --
                  FAVORITA.PCK_CADASTROS_FAV.PRC_ENDERECOSENTREGA( PIDENDERECOENTREGA => :P462_IDENDERECOENTREGA_C,
                                                                   PIDPESSOA => :P462_IDPESSOA_C,
                                                                   PRUA => :P462_RUA,
                                                                   PNUMERO => :P462_NUMERO,
                                                                   PCOMPLEMENTO => :P462_COMPLEMENTO,
                                                                   PBAIRRO => :P462_BAIRRO,
                                                                   PCEP => :P462_CEP,
                                                                   PIDCIDADE => :P462_IDCIDADE,
                                                                   POBSERVACAO => :P462_OBSERVACAO,
                                                                   PREFERENCIA => :P462_REFERENCIA,
                                                                   PMD5 => :P462_MD5,
                                                                   POPERACAO_DML => voperacao_dml);
                  --
                  :P462_IDENDERECOENTREGA := :P462_IDENDERECOENTREGA_C;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1522730781403796904
        }
    )

    branch (
        name: Go To Page 462
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 462
                items: {
                    P462_IDNOTAVENDA: &P462_IDNOTAVENDA.
                    P462_IDENDERECOREMETENTE: &P462_IDENDERECOREMETENTE.
                    P462_IDPESSOA: &P462_IDPESSOA.
                    P462_IDENDERECOENTREGA: &P462_IDENDERECOENTREGA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

    branch (
        name: Go To Page 462
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 462
                items: {
                    P462_CADASTRAR: S
                    P462_IDNOTAVENDA: &P462_IDNOTAVENDA.
                    P462_IDENDERECOREMETENTE: &P462_IDENDERECOREMETENTE.
                    P462_IDENDERECOENTREGA_C:
                    P462_IDENDERECOENTREGA:
                    P462_IDPESSOA: &P462_IDPESSOA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    branch (
        name: Go To Page 463
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 463
                items: {
                    P463_IDENDERECOREMETENTE: &P462_IDENDERECOREMETENTE.
                    P463_IDNOTAVENDA: &P462_IDNOTAVENDA.
                    P463_IDOBJETOLOGISTICA:
                    P463_IDLOGISTICAREVERSA:
                    P463_IDENDERECODESTINATARIO: &P462_IDENDERECOENTREGA.
                    P463_DESCRICAO:
                    P463_NUMERO:
                    P463_QUANTIDADE:
                    P463_CODIGOCORREIO:
                    P463_DATA:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CRIAR','ATUALIZAR_C','CONTINUAR')
                ```
        }
    )

)

