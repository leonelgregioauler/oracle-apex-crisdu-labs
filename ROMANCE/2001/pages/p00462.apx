page 462 (
    name: Endereço do Destinatário
    title: Endereço do Destinatário
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-endereço-de-entrega (
        name: Cadastro de Endereço de Entrega
        type: staticContent
        layout {
            sequence: 31
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P462_IDENDERECOENTREGA is not null
                   or :P462_CADASTRAR = 'S'
                ```
        }
        settings {
            outputAs: text
        }
    )

    region endereço-do-destinatário (
        name: Endereço do Destinatário
        type: staticContent
        layout {
            sequence: 21
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNull
            item: P462_IDENDERECOENTREGA
        }
    )

    region nova-logística-revesa (
        name: Nova Logística Revesa
        type: list
        source {
            list: @logistica-reversa
        }
        layout {
            sequence: 1
            slot: contentBody
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: t-WizardSteps--displayLabels
        }
    )

    pageItem P462_BAIRRO (
        type: textField
        label {
