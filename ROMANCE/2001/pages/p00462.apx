            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @cadastro-de-endereço-de-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P462_CADASTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
