        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P462_COMPLEMENTO (
        type: textField
        label {
            label: Complemento
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 70
            region: @cadastro-de-endereço-de-entrega
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P462_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecidade||' - '||c.sigla display_value
                     , c.idcidade  return_value
                from favorita.vw_cidades_fav c
                order by 1 
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @cadastro-de-endereço-de-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P462_IDENDERECOENTREGA (
        type: selectList
        label {
            label: Endereço de Entrega
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.rua||' n° '||e.numero||', '||e.bairro||' - '||roman.pck_romance.fnc_nomecidade(e.idcidade) display_value
                     , e.idenderecoentrega return_value
                from favorita.enderecosentrega e
                where e.idpessoa = :P462_IDPESSOA
                union
                select 'Nenhum Endereço de Entrega cadastrado.' 
                     , null
                from dual
                where not exists ( select 1
                                   from favorita.enderecosentrega ee
                                   where ee.idpessoa = :P462_IDPESSOA )
                ```
            nullDisplayValue: - Selecione o Endereço -
        }
        layout {
            sequence: 40
            region: @endereço-do-destinatário
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P462_IDENDERECOENTREGA_C (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-endereço-de-entrega
            slot: regionBody
        }
        source {
            type: item
            item: P462_IDENDERECOENTREGA
            used: always
        }
        security {
