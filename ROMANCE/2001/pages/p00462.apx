    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 30
            region: @endereço-do-destinatário
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button atualizar-c (
        buttonName: ATUALIZAR_C
        label: Atualizar e Continuar
        layout {
            sequence: 30
            region: @cadastro-de-endereço-de-entrega
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P462_IDENDERECOENTREGA_C
        }
    )

    button continuar (
        buttonName: CONTINUAR
        label: Continuar
        layout {
