            region: @endereço-do-destinatário
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P462_CEP (
        type: textField
        label {
            label: Cep
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
