    pageItem P462_IDPESSOA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @endereço-do-destinatário
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select f.idpessoa
                from notasvendas nv
                   , filiais f
                where nv.idnotavenda = :P462_IDNOTAVENDA
                  and f.idfilial     = nv.idfilial
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

