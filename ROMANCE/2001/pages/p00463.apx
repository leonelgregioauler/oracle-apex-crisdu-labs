page 463 (
    name: Objeto para Postar
    title: Objeto para Postar
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        fileUrls: https://websocket.romancemoda.com.br/romance_correios.js
    }
    security {
        pageAccessProtection: unrestricted
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region logistica-reversa (
        name: Logistica Reversa
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        settings {
            outputAs: text
        }
    )

    region nova-logistica-reversa (
        name: Nova Logistica Reversa
        type: list
        source {
            list: @logistica-reversa
        }
        layout {
            sequence: 1
            slot: contentBody
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: t-WizardSteps--displayLabels
        }
    )

    region objeto-para-postar (
        name: Objeto para Postar
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P463_CODIGOCORREIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @logistica-reversa
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P463_DATA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @logistica-reversa
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P463_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @objeto-para-postar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P463_ENTREGA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @objeto-para-postar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P463_IDENDERECODESTINATARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @objeto-para-postar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P463_IDENDERECOREMETENTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @objeto-para-postar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P463_IDLOGISTICA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 110
            region: @objeto-para-postar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P463_IDLOGISTICAREVERSA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @logistica-reversa
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P463_IDNOTAVENDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @objeto-para-postar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P463_IDOBJETOCORREIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @objeto-para-postar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P463_IDOBJETOLOGISTICA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @objeto-para-postar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P463_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @logistica-reversa
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P463_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @objeto-para-postar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P463_NUMERO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @objeto-para-postar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P463_QUANTIDADE (
        type: numberField
        label {
            label: Quantidade de Caixas
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @objeto-para-postar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    button concluir (
        buttonName: CONCLUIR
        label: Concluir
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P463_IDOBJETOLOGISTICA
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Criar Objeto
        layout {
            sequence: 30
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P463_IDOBJETOLOGISTICA
        }
    )

    button update (
        buttonName: UPDATE
        label: Atualizar
        layout {
            sequence: 20
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P463_IDOBJETOLOGISTICA
        }
    )

    dynamicAction registra-logistica (
        name: Registra Logistica
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @concluir
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P463_IDLOGISTICA
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: PROXIMOPASSO
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action native-submit-page-2 (
            action: submitPage
            settings {
                requestButtonName: CONCLUIR
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    process consulta-de-objeto (
        name: Consulta de Objeto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  PCK_LOGISTICAREVERSA.PRC_OBJETOSLOGISTICA( PIDOBJETOLOGISTICA => :P463_IDOBJETOLOGISTICA,
                                                             PIDOBJETOCORREIO => :P463_IDOBJETOCORREIO,
                                                             PQUANTIDADE => :P463_QUANTIDADE,
                                                             PDESCRICAO => :P463_DESCRICAO,
                                                             PENTREGA => :P463_ENTREGA,
                                                             PNUMERO => :P463_NUMERO,
                                                             PMD5 => :P463_MD5,
                                                             POPERACAO_DML => 'S' );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1522732019924796917
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P463_IDOBJETOLOGISTICA
        }
    )

    process operação-dml-em-logistica-reversa (
        name: Operação DML em Logistica Reversa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  PCK_LOGISTICAREVERSA.PRC_LOGISTICAREVERSA( PIDLOGISTICAREVERSA => :P463_IDLOGISTICAREVERSA,
                                                             PIDOBJETOLOGISTICA => :P463_IDOBJETOLOGISTICA,
                                                             PIDENDERECOREMETENTE => :P463_IDENDERECOREMETENTE,
                                                             PIDENDERECODESTINATARIO => :P463_IDENDERECODESTINATARIO,
                                                             PCODIGOCORREIO => :P463_CODIGOCORREIO,
                                                             PDATA => :P463_DATA,
                                                             PIDUSUARIO => :P0_IDUSUARIO,
                                                             PIDNOTAVENDA => :P463_IDNOTAVENDA,
                                                             PIDPEDIDO => :P463_IDPEDIDO,
                                                             PMD5 => :P463_MD5,
                                                             POPERACAO_DML => 'I');
                  --
                  :P463_IDLOGISTICA := :P463_IDLOGISTICAREVERSA;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1522768578052612983
        }
        serverSideCondition {
            type: request=Value
            value: CONCLUIR
        }
    )

    process operação-dml-em-objetos-logistica (
        name: Operação DML em Objetos Logistica
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'SUBMIT' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'UPDATE' then
                    --
                    voperacao_dml := 'U';
                    --
                  end if;
                  --
                  PCK_LOGISTICAREVERSA.PRC_OBJETOSLOGISTICA( PIDOBJETOLOGISTICA => :P463_IDOBJETOLOGISTICA,
                                                             PIDOBJETOCORREIO => :P463_IDOBJETOCORREIO,
                                                             PQUANTIDADE => :P463_QUANTIDADE,
                                                             PDESCRICAO => :P463_DESCRICAO,
                                                             PENTREGA => :P463_ENTREGA,
                                                             PNUMERO => :P463_NUMERO,
                                                             PMD5 => :P463_MD5,
                                                             POPERACAO_DML => voperacao_dml );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1522753313166250097
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 463
                items: {
                    P463_IDNOTAVENDA: &P463_IDNOTAVENDA.
                    P463_IDENDERECOREMETENTE: &P463_IDENDERECOREMETENTE.
                    P463_IDENDERECODESTINATARIO: &P463_IDENDERECODESTINATARIO.
                    P463_IDOBJETOLOGISTICA: &P463_IDOBJETOLOGISTICA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('UPDATE','SUBMIT')
                ```
        }
    )

    branch (
        name: Go To Page 464
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 464
                items: {
                    P464_IDLOGISTICAREVERSA: &P463_IDLOGISTICAREVERSA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: CONCLUIR
        }
    )

)

