                target: {
                    page: 171
                    items: {
                        P171_CPF: #CPF#
                        P171_TIPO: T
                    }
                    action: resetPagination
                }
                linkText: #CPF#
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

