            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Crédito;C,S.A.C.;S
        }
        layout {
            sequence: 10
            region: @protocolos-pendentes
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
