page 724 (
    name: Protocolos Pendentes
    title: Protocolos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 50%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region protocolos-expirados (
        name: Protocolos Expirados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idcontrolecontatossite
                     , nomecompleto
                     , cpf
                     , roman.pck_romance.fnc_nomecidade(idcidade) "Cidade"
                     , ec.fone
                     , mensagem
                     , observacao
                     , ec.datacadastro
                     , horarioatendimento
                     , (select nome
                          from roman.setores
                         where idsetor = ec.idsetor) Setor
                
                from roman.controlecontatossite ec
                where idfilial = :P0_IDFILIAL
                  and ec.situacao in ('Q') 
                  and ec.tipo = 3
                  and (:P724_TIPOPROTOCOLO is null or ec.tipoprotocolo = :P724_TIPOPROTOCOLO)
                ```
            pageItemsToSubmit: P724_TIPOPROTOCOLO
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        headerAndFooter {
            headerText: <b>--------------- Protocolos Expirados --------------- </b>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Nenhum registro localizado!
            whenMoreDataFound: O máximo de registros para este relatório é de #MAX_ROW_COUNT# . Favor reveja os filtros para melhorar o desempenho.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 2435321279864423130
        }

        column CPF (
            type: link
