    dynamicAction atualiza (
        name: Atualiza
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P724_TIPOPROTOCOLO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @protocolos-expirados
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @protocolos-pendentes
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

