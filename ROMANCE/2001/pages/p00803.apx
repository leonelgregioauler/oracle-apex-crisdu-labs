    region brindes-por-categoria (
        name: "Brindes Por Categoria "
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.*
                     , case when x.qtdeestoque = x.saldoestoque + x.resgatados then 'Ok'
                            else 'Diferença: ' || (x.qtdeestoque - x.saldoestoque - x.resgatados) end confere
                from (
                select ct.idcampanhacategoria
                     , ct.idbrindeclube
                     , ct.idcategoriabrinde
                     , ct.idclassifbrindeclub
                     , ct.pontosresgate
                     , ct.qtdeestoque
                     , ct.saldoestoque
                     , (select nvl(sum(i.qtditem), 0)
                          from roman.itensconqlevcupons i
                             , roman.classificacoesbrindesclub cb
                         where cb.idclassifbrindeclub         = ct.idclassifbrindeclub
                           and i.idcampanhacategoria          = ct.idcampanhacategoria
                           and i.idbrindeclube                = ct.idbrindeclube
                           and i.idbrindeclube                = cb.idbrindeclube
                           and nvl(i.idclassificacao, 0)      = nvl(cb.idclassificacao, 0)
                           and nvl(i.idcaracteristica, 0)     = nvl(cb.idcaracteristica, 0)) resgatados
                     , (select decode(b.recompensa,'S','Sim','Não')
                        from roman.brindesclub b 
                        where b.idbrindeclube = ct.idbrindeclube) recompensa
                from roman.categoriasbrindes ct
                where ct.idcampanhacategoria = :P803_IDCAMPANHACATEGORIA
                ) x
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1801185382929015832
        }

