    dynamicAction verifica-de-para (
        name: Verifica DE/PARA
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @brindes-por-categoria
            columns: IDCLASSIFBRINDECLUB
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      --
                      v_verifica number := 0;
                      --
                    begin
                      --
                      select count(c.idclassifbrindeclub)
                        into v_verifica
                        from roman.brindesclub  b
                           , roman.classificacoesbrindesclub c 
                        where b.idbrindeclube = c.idbrindeclube
                          and b.tipoproduto   = 'E'
                          and c.idbrindeclube = :IDBRINDECLUBE
                          and c.idclassifbrindeclub = :IDCLASSIFBRINDECLUB
                          and c.idproddetal_fav is null;
                      --
                      if v_verifica > 0 then
                        --
                        raise_application_error(-20001,'Cadastro do Brinde está incompleto. O Brinde do tipo "Estoque CD" preciso ter Produto Favorita/Produto RMC cadastrado na classificação. Revise o cadastro do Brinde');
                        --
                      end if;
                      --
                    end;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation new (
