            column: IDCLASSIFBRINDECLUB
        }
        error {
            errorMessage: teste diego
            associatedColumn: IDCLASSIFBRINDECLUB
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select count(c.idclassifbrindeclub)
                    from roman.brindesclub  b
                       , roman.classificacoesbrindesclub c 
                    where b.idbrindeclube = c.idbrindeclube
                      and b.tipoproduto   = 'E'
                      and c.idbrindeclube = :IDBRINDECLUBE
                      and c.idclassifbrindeclub = :IDCLASSIFBRINDECLUB
                      and c.idproddetal_fav is null
                ```
        }
    )

    process busca-dados (
        name: "Busca Dados "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  --
                  vativabrinde  VARCHAR2(5);
                  vidcateg      VARCHAR2(50);
                  vidcampanha    number;
                  --
                BEGIN
                  --
                  BEGIN
                    SELECT c.nomecategoria,
                           DECODE(ct.ativabrinde, 'S', 'Sim', 'Não'),
                           ct.idconquistoulevou
                      INTO vidcateg,
                           vativabrinde,
                           vidcampanha
                      FROM roman.campanhascategorias ct
                           JOIN roman.categoriasclubes c
                             ON c.idcategoriaclube = ct.idcategoriaclube
                     WHERE ct.idcampanhacategoria = :P803_IDCAMPANHACATEGORIA;
                
                  EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                      vidcateg     := NULL;
                      vativabrinde := NULL;
                  END;
                  --
                
                  :P803_CATEGORIACLUBE := vidcateg;
                  :P803_ATIVABRINDE    := vativabrinde;
                  :P803_IDCAMPANHA     := vidcampanha;
                  --
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1801735935080211108
        }
    )

    process new-save-interactive-grid-data (
        name: New - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @brindes-por-categoria
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1801186225400015841
        }
        serverSideCondition {
            type: never
        }
    )

    process processo-grid (
        name: Processo grid
        type: executeCode
        editableRegion: @brindes-por-categoria
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  vseqgrid      NUMBER;
                  vdataini      DATE;
                  vrecompensa   VARCHAR2(1);
                  v_verifica    NUMBER := 0;
                  v_nome_brinde VARCHAR2(500);
                  v_atual       roman.categoriasbrindes%ROWTYPE;
                  v_resgatados  NUMBER := 0;
                BEGIN
                  /*
                   * Verifica se o brinde é recompensa.
                   */
                  BEGIN
                    SELECT bd.recompensa
                      INTO vrecompensa
                      FROM roman.brindesclub bd
                     WHERE bd.idbrindeclube = :IDBRINDECLUBE;
                  EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                      raise_application_error(
                        -20001,
                        'O brinde informado não foi encontrado.'
                      );
                  END;
                
                  /*
                   * Linha NOVA (Create)
                   */
                  IF :APEX$ROW_STATUS = 'C' THEN
                
                    /*
                     * Valida o cadastro do brinde do tipo Estoque CD.
                     *
                     * Como a consulta possui GROUP BY, ela pode gerar
                     * NO_DATA_FOUND mesmo utilizando COUNT.
                     */
                    BEGIN
                      SELECT COUNT(c.idclassifbrindeclub),
                             b.nomebrinde
                        INTO v_verifica,
                             v_nome_brinde
                        FROM roman.brindesclub b,
                             roman.classificacoesbrindesclub c
                       WHERE b.idbrindeclube = c.idbrindeclube
                         AND b.tipoproduto = 'E'
                         AND c.idbrindeclube = :IDBRINDECLUBE
                         AND c.idclassifbrindeclub = :IDCLASSIFBRINDECLUB
                         AND c.idproddetal_fav IS NULL
                       GROUP BY b.nomebrinde;
                    EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                        v_verifica    := 0;
                        v_nome_brinde := NULL;
                    END;
                
                    IF v_verifica > 0 THEN
                      raise_application_error(
                        -20001,
                        'Cadastro do Brinde "' || v_nome_brinde ||
                        '" está incompleto. O Brinde do tipo "Estoque CD" precisa ter ' ||
                        'Produto Favorita/Produto RMC cadastrado na classificação. ' ||
                        'Revise o cadastro do Brinde.'
                      );
                    END IF;
                
                    /*
                     * O mesmo brinde e classificação só pode estar uma vez na categoria:
                     * o resgate e o cancelamento de cupom localizam a linha por esta chave.
                     */
                    SELECT COUNT(*)
                      INTO v_verifica
                      FROM roman.categoriasbrindes ct
                     WHERE ct.idcampanhacategoria = :P803_IDCAMPANHACATEGORIA
                       AND ct.idbrindeclube       = :IDBRINDECLUBE
                       AND ct.idclassifbrindeclub = :IDCLASSIFBRINDECLUB;
                
                    IF v_verifica > 0 THEN
                      raise_application_error(
                        -20001,
                        'Este brinde, com esta classificação, já está cadastrado na categoria. Altere o estoque inicial da linha existente.'
                      );
                    END IF;
                
                    /*
                     * Gera o identificador da categoria.
                     */
                    BEGIN
                      SELECT roman.seq_idcategoriabrinde.NEXTVAL
                        INTO vseqgrid
                        FROM dual;
                    EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                        raise_application_error(
                          -20001,
                          'Não foi possível gerar o identificador da categoria do brinde.'
                        );
                    END;
                
                    IF vrecompensa = 'N' THEN
                
                      INSERT INTO roman.categoriasbrindes
                             (
                               idcategoriabrinde,
                               idcampanhacategoria,
                               idbrindeclube,
                               pontosresgate,
                               qtdeestoque,
                               saldoestoque,
                               idclassifbrindeclub
                             )
                      VALUES (
                               vseqgrid,
                               :P803_IDCAMPANHACATEGORIA,
                               :IDBRINDECLUBE,
                               :PONTOSRESGATE,
                               :QTDEESTOQUE,
                               :QTDEESTOQUE,
                               :IDCLASSIFBRINDECLUB
                             )
                      RETURNING idcategoriabrinde
                           INTO :IDCATEGORIABRINDE;
                
                    ELSIF vrecompensa = 'S' THEN
                
                      /*
                       * Se o brinde for recompensa, garante que
                       * a pontuação seja inserida zerada.
                       */
                      INSERT INTO roman.categoriasbrindes
                             (
                               idcategoriabrinde,
                               idcampanhacategoria,
                               idbrindeclube,
                               pontosresgate,
                               qtdeestoque,
                               saldoestoque,
                               idclassifbrindeclub
                             )
                      VALUES (
                               vseqgrid,
                               :P803_IDCAMPANHACATEGORIA,
                               :IDBRINDECLUBE,
                               0,
                               :QTDEESTOQUE,
                               :QTDEESTOQUE,
                               :IDCLASSIFBRINDECLUB
                             )
                      RETURNING idcategoriabrinde
                           INTO :IDCATEGORIABRINDE;
                
                    ELSE
                      raise_application_error(
                        -20001,
                        'A configuração de recompensa do brinde é inválida.'
                      );
                    END IF;
                
                  /*
                   * Linha ALTERADA (Update) ou EXCLUÍDA (Delete)
                   */
                  ELSIF :APEX$ROW_STATUS IN ('U', 'D') THEN
                
                    /*
                     * Campanha iniciada: a troca abre à 0h da data de início.
                     */
                    BEGIN
                      SELECT cp.datainicio
                        INTO vdataini
                        FROM roman.campanhasconquistoulevou cp,
                             roman.campanhascategorias cpt
                       WHERE cpt.idconquistoulevou = cp.idconquistoulevou
                         AND cpt.idcampanhacategoria = :P803_IDCAMPANHACATEGORIA;
                    EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                        raise_application_error(
                          -20001,
                          'A campanha ou a categoria da campanha informada não foi encontrada.'
                        );
                    END;
                
                    /*
                     * Trava a linha e le os valores gravados no banco (o app pode ter resgatado
                     * enquanto a tela estava aberta). Um resgate ao mesmo tempo espera esta gravacao.
                     */
                    BEGIN
                      SELECT *
                        INTO v_atual
                        FROM roman.categoriasbrindes ct
                       WHERE ct.idcategoriabrinde = :IDCATEGORIABRINDE
                         FOR UPDATE;
                    EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                        raise_application_error(
                          -20001,
                          'O brinde da categoria não foi encontrado. Atualize a página.'
                        );
                    END;
                
                    /*
                     * Quantidade ja resgatada nos cupons para esta linha (cupom cancelado e excluido).
                     */
                    SELECT NVL(SUM(i.qtditem), 0)
                      INTO v_resgatados
                      FROM roman.itensconqlevcupons i,
                           roman.classificacoesbrindesclub cb
                     WHERE cb.idclassifbrindeclub     = v_atual.idclassifbrindeclub
                       AND i.idcampanhacategoria      = v_atual.idcampanhacategoria
                       AND i.idbrindeclube            = v_atual.idbrindeclube
                       AND i.idbrindeclube            = cb.idbrindeclube
                       AND NVL(i.idclassificacao, 0)  = NVL(cb.idclassificacao, 0)
                       AND NVL(i.idcaracteristica, 0) = NVL(cb.idcaracteristica, 0);
                
                    IF :APEX$ROW_STATUS = 'D' THEN
                
                      /*
                       * Linha EXCLUÍDA (Delete): só antes do início e sem resgate.
                       */
                      IF vdataini <= SYSDATE THEN
                        raise_application_error(
                          -20001,
                          'Campanha iniciada: o brinde não pode ser excluído. Para tirar o brinde do resgate, altere o estoque inicial para a quantidade já resgatada (' || v_resgatados || ').'
                        );
                      END IF;
                
                      IF v_resgatados > 0 THEN
                        raise_application_error(
                          -20001,
                          'O brinde já tem ' || v_resgatados || ' resgatado(s) em cupons e não pode ser excluído.'
                        );
                      END IF;
                
                      DELETE FROM roman.categoriasbrindes ct
                       WHERE ct.idcategoriabrinde = :IDCATEGORIABRINDE;
                
                    ELSE
                
                      /*
                       * Linha ALTERADA (Update)
                       */
                      IF :IDBRINDECLUBE != v_atual.idbrindeclube
                         OR NVL(:IDCLASSIFBRINDECLUB, -1) != NVL(v_atual.idclassifbrindeclub, -1) THEN
                        raise_application_error(
                          -20001,
                          'O brinde e a classificação de uma linha já gravada não podem ser trocados. Antes do início da campanha, exclua a linha e inclua de novo.'
                        );
                      END IF;
                
                      IF vdataini <= SYSDATE
                         AND vrecompensa = 'N'
                         AND NVL(TO_NUMBER(:PONTOSRESGATE), -1) != NVL(v_atual.pontosresgate, -1) THEN
                        raise_application_error(
                          -20001,
                          'Campanha iniciada: os pontos do brinde não podem ser alterados. Durante a campanha só o estoque inicial pode ser alterado.'
                        );
                      END IF;
                
                      IF TO_NUMBER(:QTDEESTOQUE) < v_resgatados THEN
                        raise_application_error(
                          -20001,
                          'Estoque inicial (' || :QTDEESTOQUE || ') menor que a quantidade já resgatada (' || v_resgatados || '). Informe um estoque inicial de pelo menos ' || v_resgatados || '.'
                        );
                      END IF;
                
                      /*
                       * Saldo = estoque inicial - resgatados (antes do inicio, resgatados = 0 e o saldo fica igual ao estoque).
                       */
                      UPDATE roman.categoriasbrindes ct
                         SET ct.pontosresgate = CASE WHEN vrecompensa = 'S' THEN 0
                                                     WHEN vdataini <= SYSDATE THEN ct.pontosresgate
                                                     ELSE TO_NUMBER(:PONTOSRESGATE) END,
                             ct.qtdeestoque   = TO_NUMBER(:QTDEESTOQUE),
                             ct.saldoestoque  = TO_NUMBER(:QTDEESTOQUE) - v_resgatados
                       WHERE ct.idcategoriabrinde = :IDCATEGORIABRINDE;
                
                    END IF;
                
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1801735517314211104
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

