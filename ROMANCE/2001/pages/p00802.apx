    process set-sequencia (
        name: SET_SEQUENCIA_802
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_ids apex_t_varchar2 := apex_string.split(apex_application.g_x01, ':');
                begin
                  for i in 1..l_ids.count loop
                    update roman.fotosbrindesconqlev
                       set sequencia = i
                     where idanexofoto = to_number(l_ids(i));
                  end loop;
                  commit;
                  htp.p('{"s":"ok"}');
                end;
                ```
        }
        execution {
            sequence: 30
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 9901802000000013
        }
    )

