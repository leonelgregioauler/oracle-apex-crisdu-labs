        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  roman.pck_anexos.prc_apagaanexo_fotosbrindesconqlev(Pidanexofoto => :P802_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1801182708522015806
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process deletar-mídia-bucket (
        name: Deletar Mídia Bucket
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    roman.pck_bucket.sp_delete_midia_brinde(
                        p_idanexofoto => :P802_IDMIDIADELETAR
                    );
                    commit;
                    :P802_IDMIDIADELETAR := null;
                end;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 7701802000000031
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR_BUCKET
        }
    )

    process get-midias (
        name: GET_MIDIAS_802
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_brinde number := to_number(apex_application.g_x01);
                begin
                  apex_json.initialize_clob_output;
                  apex_json.open_object;
                  apex_json.open_array('midias');
                  for r in (
                    select idanexofoto, url_bucket, nomearquivo, sequencia, principal, tipomidia
                      from roman.fotosbrindesconqlev
                     where idbrindeclube = l_brinde
                       and url_bucket is not null
                       and tipomidia = 'I'
                     order by sequencia
                  ) loop
                    apex_json.open_object;
                    apex_json.write('id',        r.idanexofoto);
                    apex_json.write('url',       r.url_bucket);
                    apex_json.write('nome',      r.nomearquivo);
                    apex_json.write('seq',       r.sequencia);
                    apex_json.write('principal', r.principal);
                    apex_json.write('tipomidia', r.tipomidia);
                    apex_json.close_object;
                  end loop;
                  apex_json.close_array;
                  apex_json.close_object;
                  htp.p(apex_json.get_clob_output);
                  apex_json.free_output;
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 9901802000000011
        }
    )

