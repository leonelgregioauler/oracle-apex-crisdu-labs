    region galeria-de-fotos (
        name: Galeria de Fotos
        type: staticContent
        source {
            htmlCode:
                ```html
                <style>
                .gm-grid{display:flex;flex-wrap:wrap;gap:12px;padding:8px;}
                .gm-card{position:relative;width:200px;background:#fff;border:2px solid #ddd;border-radius:8px;overflow:hidden;cursor:grab;transition:box-shadow .2s,border-color .2s;user-select:none;}
                .gm-card.gm-principal{border-color:#f8a000;}
                .gm-card.gm-dragging{opacity:.4;border-color:#2d7be5;border-style:dashed;}
                .gm-card.gm-over{border-color:#f8a000;box-shadow:0 0 0 3px rgba(248,160,0,.25);}
                .gm-card .gm-media img,.gm-card .gm-media video{width:200px;height:150px;object-fit:cover;display:block;cursor:pointer;}
                .gm-seq{position:absolute;top:6px;left:8px;background:rgba(0,0,0,.55);color:#fff;font-size:11px;font-weight:700;padding:2px 6px;border-radius:4px;pointer-events:none;}
                .gm-badge{position:absolute;bottom:40px;left:0;right:0;background:rgba(248,160,0,.85);color:#fff;font-size:11px;font-weight:700;text-align:center;padding:2px 0;pointer-events:none;}
                .gm-actions{display:flex;justify-content:space-between;padding:4px 8px;background:#f5f5f5;border-top:1px solid #eee;}
                .gm-btn{background:none;border:none;cursor:pointer;padding:4px 8px;border-radius:4px;font-size:16px;transition:background .15s;}
                .gm-btn-star{color:#bbb;}.gm-btn-star.on{color:#f8a000;}.gm-btn-star:hover{background:#fff3cd;}
                .gm-btn-del{color:#e53935;}.gm-btn-del:hover{background:#fde8e8;}
                #galeria-spin{text-align:center;padding:20px;color:#888;}
                </style>
                <div id="galeria-spin" style="display:none"><span class="fa fa-spinner fa-spin fa-2x" aria-hidden="true"></span></div>
                <div class="gm-grid" id="galeria-grid"></div>
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from ROMAN.FOTOSBRINDESCONQLEV f
                 where f.idbrindeclube = :P802_IDBRINDE
                   and f.tipomidia = 'I'
                ```
        }
    )

    region galeria-de-vídeos (
        name: Galeria de Vídeos
        type: staticContent
        source {
            htmlCode:
                ```html
                <style>
                .gv-grid{display:flex;flex-wrap:wrap;gap:16px;padding:8px;}
                .gv-card{position:relative;width:340px;background:#fff;border:2px solid #ddd;border-radius:8px;overflow:hidden;}
                .gv-media video{width:100%;max-height:210px;display:block;background:#000;}
                .gv-seq{position:absolute;top:6px;left:8px;background:rgba(0,0,0,.55);color:#fff;font-size:11px;font-weight:700;padding:2px 6px;border-radius:4px;pointer-events:none;z-index:1;}
                .gv-info{padding:6px 10px;font-size:11px;color:#666;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;border-top:1px solid #eee;}
                .gv-actions{display:flex;justify-content:flex-end;padding:4px 8px;background:#f5f5f5;border-top:1px solid #eee;}
                #galeria-video-spin{text-align:center;padding:20px;color:#888;}
                </style>
                <div id="galeria-video-spin" style="display:none"><span class="fa fa-spinner fa-spin fa-2x" aria-hidden="true"></span></div>
                <div class="gv-grid" id="galeria-video-grid"></div>
                ```
        }
        layout {
            sequence: 45
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from ROMAN.FOTOSBRINDESCONQLEV f
                 where f.idbrindeclube = :P802_IDBRINDE
                   and f.tipomidia = 'V'
                ```
        }
    )

