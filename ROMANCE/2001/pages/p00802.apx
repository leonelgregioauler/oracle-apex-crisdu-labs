page 802 (
    name: Fotos Brindes Conquistou Levou
    title: Fotos Brindes Conquistou Levou
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P802_IDANEXODELETAR":pidanexo}
              });
            }
            
            function fnc_removeanexobucket(pidmidia,pnomemidia)
            {
                apex.confirm("Deseja realmente remover a mídia "+pnomemidia+"? Esta ação também remove o arquivo do bucket.", {
              request:"DELETAR_BUCKET",
              set:{"P802_IDMIDIADELETAR":pidmidia}
              });
            }
            
            // ---- Galeria de Mídias ----
            (function(){
            function el(id){return document.getElementById(id);}
            function gmLoad(){
              var b=$v("P802_IDBRINDE");
              var g=el("galeria-grid");
              if(!g)return;
              if(!b){g.innerHTML="";return;}
              el("galeria-spin").style.display="block";
              apex.server.process("GET_MIDIAS_802",{x01:b},{
                success:function(d){el("galeria-spin").style.display="none";gmRender(d.midias||[]);},
                error:function(){el("galeria-spin").style.display="none";}
              });
            }
            function gmRender(list){
              var g=el("galeria-grid");g.innerHTML="";
              if(!list.length){g.innerHTML="<p style=\"padding:16px;color:#888;\">Nenhuma mídia cadastrada.</p>";return;}
              list.forEach(function(m){g.appendChild(gmCard(m));});
              gmDrag(g);
            }
            function gmCard(m){
              var isImg=/\.(jpg|jpeg|png|gif|webp|bmp)$/i.test(m.url||"");
              var d=document.createElement("div");
              d.className="gm-card"+(m.principal==="S"?" gm-principal":"");
              d.draggable=true;d.dataset.id=m.id;
              var med=isImg
                ?"<img src=\""+m.url+"\" title=\"Duplo clique para abrir\" />"
                :"<video src=\""+m.url+"\" preload=\"metadata\" title=\"Duplo clique para abrir\"></video>";
              d.innerHTML=
                "<div class=\"gm-seq\">#"+(m.seq||1)+"</div>"+
                (m.principal==="S"?"<div class=\"gm-badge\">Principal</div>":"")+
                "<div class=\"gm-media\">"+med+"</div>"+
                "<div class=\"gm-actions\">"+
                  "<button type=\"button\" class=\"gm-btn gm-btn-star"+(m.principal==="S"?" on":"")+"\" title=\"Marcar como principal\"><span class=\"fa fa-star\"></span></button>"+
                  "<button type=\"button\" class=\"gm-btn gm-btn-del\" title=\"Excluir\"><span class=\"fa fa-trash-o\"></span></button>"+
                "</div>";
              d.querySelector(".gm-media").addEventListener("dblclick",function(){
                var w=window.open("","_blank");
                w.document.write("<html><body style=\"margin:0;background:#111;display:flex;align-items:center;justify-content:center;min-height:100vh\"><img src=\""+m.url+"\" style=\"max-width:100%;max-height:100vh\"></body></html>");
                w.document.close();
              });
              d.querySelector(".gm-btn-star").addEventListener("click",function(){gmSetPrincipal(m.id);});
              d.querySelector(".gm-btn-del").addEventListener("click",function(){fnc_removeanexobucket(m.id,m.nome);});
              return d;
            }
            function gmSetPrincipal(id){
              apex.server.process("SET_PRINCIPAL_802",{x01:id,x02:$v("P802_IDBRINDE")},{success:function(){gmLoad();}});
            }
            function gmSaveSeq(g){
              var ids=[].slice.call(g.querySelectorAll(".gm-card")).map(function(c){return c.dataset.id;});
              apex.server.process("SET_SEQUENCIA_802",{x01:ids.join(":"),x02:$v("P802_IDBRINDE")},{success:function(){gmLoad();}});
            }
            function gmDrag(g){
              var src=null,moved=false;
              [].forEach.call(g.querySelectorAll(".gm-card"),function(c){
                c.addEventListener("dragstart",function(){src=this;moved=false;setTimeout(function(){if(src)src.classList.add("gm-dragging");},0);});
                c.addEventListener("dragend",function(){
                  this.classList.remove("gm-dragging");
                  [].forEach.call(g.querySelectorAll(".gm-card"),function(x){x.classList.remove("gm-over");});
                  if(moved)gmSaveSeq(g);
                  src=null;
                });
                c.addEventListener("dragover",function(e){
                  e.preventDefault();
                  if(src&&src!==this){
                    [].forEach.call(g.querySelectorAll(".gm-card"),function(x){x.classList.remove("gm-over");});
                    this.classList.add("gm-over");
                    var r=this.getBoundingClientRect();
                    g.insertBefore(src,e.clientX<r.left+r.width/2?this:this.nextSibling);
                    moved=true;
                  }
                });
                c.addEventListener("drop",function(e){e.preventDefault();this.classList.remove("gm-over");});
              });
            }
            window.GaleriaMidia={load:gmLoad};
            apex.jQuery(document).ready(function(){gmLoad();});
            }());
            // ---- Galeria de Vídeos ----
            (function(){
            function el(id){return document.getElementById(id);}
            function gvLoad(){
              var b=$v("P802_IDBRINDE");
              var g=el("galeria-video-grid");
              if(!g)return;
              if(!b){g.innerHTML="";return;}
              el("galeria-video-spin").style.display="block";
              apex.server.process("GET_VIDEOS_802",{x01:b},{
                success:function(d){el("galeria-video-spin").style.display="none";gvRender(d.midias||[]);},
                error:function(){el("galeria-video-spin").style.display="none";}
              });
            }
            function gvRender(list){
              var g=el("galeria-video-grid");g.innerHTML="";
              if(!list.length){g.innerHTML="<p style=\"padding:16px;color:#888;\">Nenhum vídeo cadastrado.</p>";return;}
              list.forEach(function(m){g.appendChild(gvCard(m));});
            }
            function gvCard(m){
              var d=document.createElement("div");
              d.className="gv-card";
              d.dataset.id=m.id;
              d.innerHTML=
                "<div class=\"gv-seq\">#"+(m.seq||1)+"</div>"+
                "<div class=\"gv-media\"><video src=\""+m.url+"\" controls preload=\"metadata\"></video></div>"+
                "<div class=\"gv-info\">"+m.nome+"</div>"+
                "<div class=\"gv-actions\">"+
                  "<button type=\"button\" class=\"gm-btn gm-btn-del\" title=\"Excluir\"><span class=\"fa fa-trash-o\"></span></button>"+
                "</div>";
              d.querySelector(".gm-btn-del").addEventListener("click",function(){fnc_removeanexobucket(m.id,m.nome);});
              d.querySelector("video").addEventListener("ended",function(){this.load();});
              return d;
            }
            window.GaleriaVideo={load:gvLoad};
            apex.jQuery(document).ready(function(){gvLoad();});
            }());
            
            ```
    }

    region arquivo-anexado (
        name: Arquivo Anexado
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.nomearquivo
                     ,  '<a href="javascript:void(0)" '||
                            'onclick="window.open('''||
                              'https://e.romancemoda.com.br/apex/romance/webapp/climagem/?idbrinde='||t.idbrindeclube||
                              ''',''_blank'');" '||
                            'title="Ver foto" class="t-Button t-Button--noUI t-Button--icon">'||
                              '<span class="fa fa-search" aria-hidden="true" style="color:#1E88E5;"></span>'||
                            '</a>' as linkfoto
                    , '<a href="javascript: fnc_removeanexo('||idanexofoto||','''||t.nomearquivo||''');">Remover</a>' remover
                  from roman.fotosbrindesconqlev t
                     , roman.brindesclub r
                 where r.idbrindeclube = t.idbrindeclube
                   and t.idbrindeclube = :P802_IDBRINDE ;
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.fotosbrindesconqlev fb
                where fb.idbrindeclube = :P802_IDBRINDE
                  and 1 = 2
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }

        column LINKFOTO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Foto
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: "Nome "
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
        )

        column REMOVER (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region arquivos-em-anexo (
        name: Arquivos em Anexo
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.idanexofoto,
                       f.idbrindeclube,
                       f.tipomidia,
                       sig.descricao                                        desc_tipomidia,
                       f.nomearquivo,
                       f.url_bucket,
                       f.sequencia,
                       f.principal,
                       f.datacriacao,
                       '<a href="javascript: fnc_removeanexobucket('||f.idanexofoto||','''||f.nomearquivo||''');">Remover</a>' remover
                  from ROMAN.FOTOSBRINDESCONQLEV f
                     , table(catal.pck_util.fnc_siglasistema('TIPO_MIDIA_BRINDE_CONQUISTOU_LEVOU', f.tipomidia)) sig
                 where f.idbrindeclube = :P802_IDBRINDE
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }

        column DATACRIACAO (
            reportColumnQueryId: 9
            derivedColumn: N
