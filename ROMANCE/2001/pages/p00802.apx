    process salvar-mídia-brinde (
        name: Salvar Mídia Brinde
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_files    apex_t_varchar2;
                  l_filename varchar2(200);
                  l_blob     blob;
                  l_pk       number;
                  l_seq_base number;
                  l_url      varchar2(1000);
                  l_nomeobj  varchar2(300);
                  l_ext      varchar2(20);
                  l_base     varchar2(50);
                  l_prefixo  varchar2(60);
                  l_par_read varchar2(1000);
                begin
                  -- Prefixo de pasta: vazio em PROD, nome da base nas demais (dev/homolog)
                  select sys_context('USERENV', 'DB_NAME') into l_base from sys.dual;
                  l_prefixo := case when upper(l_base) = 'PROD' then '' else l_base || '/' end;
                
                  -- PAR URL de leitura: usada como url_bucket para exibicao no browser
                  select valor into l_par_read
                    from roman.parametros_bucket
                   where nomeparametro = 'URL_PAR_MIDIASBRINDE_LEITURA';
                
                  -- Sequencia base: proximo apos o maior existente para este brinde
                  select nvl(max(sequencia), 0) + 1
                    into l_seq_base
                    from roman.fotosbrindesconqlev
                   where idbrindeclube = :P802_IDBRINDE;
                
                  -- Split de nomes de arquivos separados por ":" (multiplos uploads)
                  l_files := apex_string.split(:P802_MIDIA_ARQUIVO, ':');
                
                  for i in 1 .. l_files.count loop
                    begin
                      select filename, blob_content
                        into l_filename, l_blob
                        from apex_application_temp_files
                       where name           = l_files(i)
                         and application_id = :APP_ID
                         and rownum         = 1;
                    exception
                      when no_data_found then
                        continue;
                    end;
                
                    select roman.seq_idanexofotoconqlev.nextval into l_pk from sys.dual;
                
                    -- Extrai extensao do arquivo incluindo o ponto (.jpg, .mp4, etc.)
                    l_ext := lower(substr(l_filename, instr(l_filename, '.', -1)));
                
                    -- Chave do objeto no bucket: midiasbrinde/[base/]{idbrinde}/{pk}_{idbrinde}.ext
                    l_nomeobj := 'midiasbrinde/' || l_prefixo || :P802_IDBRINDE || '/' || l_pk || '_' || :P802_IDBRINDE || l_ext;
                
                    -- Insere com nomearquivo (chave bucket) e url_bucket null (preenchido apos upload)
                    insert into roman.fotosbrindesconqlev (
                        idanexofoto,
                        idbrindeclube,
                        tipomidia,
                        nomearquivo,
                        url_bucket,
                        sequencia,
                        datacriacao
                    ) values (
                        l_pk,
                        :P802_IDBRINDE,
                        :P802_MIDIA_TIPOMIDIA,
                        l_nomeobj,
                        null,
                        l_seq_base + (i - 1),
                        sysdate
                    );
                
                    -- Upload para o Oracle Object Storage; retorna URL de leitura em l_url
                    begin
                      roman.pck_bucket.sp_upload_geral(
                          p_entidade => 'midiasbrinde/' || l_prefixo || :P802_IDBRINDE,
                          p_id_pai   => l_pk,
                          p_id_anexo => :P802_IDBRINDE,
                          p_filename => l_filename,
                          p_bucket   => 'bucket-conqlev-brinde',
                          p_blob     => l_blob,
                          p_url_out  => l_url
                      );
                    exception
                      when others then
                        -- Remove registro orfao para nao deixar registro sem arquivo no bucket
                        delete from roman.fotosbrindesconqlev where idanexofoto = l_pk;
                        raise;
                    end;
                
                    -- Atualiza url_bucket com PAR URL de leitura publica (l_par_read + l_nomeobj)
                    update roman.fotosbrindesconqlev
                       set url_bucket = l_par_read || l_nomeobj
                     where idanexofoto = l_pk;
                
                  end loop;
                  commit;
                  :P802_IDMIDIABRIDECONQLEV := null;
                  :P802_MIDIA_TIPOMIDIA     := null;
                  :P802_MIDIA_SEQUENCIA     := null;
                  :P802_MIDIA_ARQUIVO       := null;
                end;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 7701802000000011
        }
        serverSideCondition {
            whenButtonPressed: @salvar-midia
            type: itemIsNotNull
            item: P802_MIDIA_ARQUIVO
        }
    )

    process set-principal (
        name: SET_PRINCIPAL_802
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update roman.fotosbrindesconqlev
                     set principal = 'N'
                   where idbrindeclube = to_number(apex_application.g_x02);
                  update roman.fotosbrindesconqlev
                     set principal = 'S'
                   where idanexofoto = to_number(apex_application.g_x01);
                  commit;
                  htp.p('{"s":"ok"}');
                end;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
