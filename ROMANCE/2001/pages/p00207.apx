page 207 (
    name: Estoque Reservado PA
    title: Estoque Reservado PA
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region estoque-reservado-pa (
        name: Estoque Reservado PA
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Carga '||cc.idcargarepresentante "Carga"
                     , pck_romance.fnc_nomerepresentante(idrepresentante)||'('||cc.semana||', '||decode(cc.situacao,1,'Aberta'
                                                                                                                   ,2,'Aguardando Conclusão'
                                                                                                                   ,3,'Concluida'
                                                                                                                     , 'Cancelado' )||')'  "Situação"
                     , i.qtd_DIST_u "QTD_U"
                from itenscargarepresentante i
                  , cargasrepresentantes cc
                where i.idestoquefil         = :P207_IDESTOQUEFIL
                  and i.idcargarepresentante = cc.idcargarepresentante
                  and i.idpostoavancado = :P207_IDPOSTOAVANCADO
                  and i.estoquemovto = 'P'
                  and cc.situacao            in (1, 2)           
                  AND cc.idfilial = :P0_IDFILIAL
                  and i.cargaamais = 'N'
                order by 1, 2
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: -
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 594869212291331053
        }

        column Carga (
            type: plainText
            heading {
                heading: Carga
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Carga
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column QTD_U (
            type: plainText
            heading {
                heading: Qtd U
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: QTD_U
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Situação (
            type: plainText
            heading {
                heading: Situação
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Situação
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 5948703 (
            visibility: primaryDefault
            view {
                rowsPerPage: 1000
            }

            displayColumn "Carga" (
                sequence: 1
            )

            displayColumn QTD_U (
                sequence: 3
            )

            displayColumn "Situação" (
                sequence: 2
            )

            aggregate (
                column: QTD_EPP
            )

            aggregate (
                column: QTD_P
            )

            aggregate (
                column: QTD_M
            )

            aggregate (
                column: QTD_G
            )

            aggregate (
                column: QTD_GG
            )

            aggregate (
                column: QTD_EGG
            )

            aggregate (
                column: QTD_U
            )

            aggregate (
                column: QTD_PP
            )

            aggregate (
                column: QTD_SUGEST_U
            )

        )

    )

    pageItem P207_IDESTOQUEFIL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @estoque-reservado-pa
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P207_IDPOSTOAVANCADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @estoque-reservado-pa
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

