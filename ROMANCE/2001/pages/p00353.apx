page 353 (
    name: Mapear Valores Romaneio
    title: Mapear Valores Romaneio
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        inline: ".rc-content-main {height: 400px; overflow: auto !important;}"
    }
    security {
        pageAccessProtection: unrestricted
    }

    region data-load-wizard-progress (
        name: Data Load Wizard Progress
        type: list
        source {
            list: @data-load-wizard-progress-importar-romaneio-2
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            excludeTitleFromTranslation: true
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    region mapear-valores-romaneio (
        name: Mapear Valores Romaneio
        type: dataUploadColMapping
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: style="width:100%;max-width:none;"
        }
        settings {
            dataLoadDefinition: @importar-romaneio
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 20
            region: @mapear-valores-romaneio
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 352
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Próximo
        layout {
            sequence: 30
            region: @mapear-valores-romaneio
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS
        label: Voltar
        layout {
            sequence: 10
            region: @mapear-valores-romaneio
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 352
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process prepare-uploaded-data (
        name: Prepare Uploaded Data
        type: prepareUploadedData
        dataLoading {
            dataLoadDefinition: @importar-romaneio
        }
        processingResult {
            insertCountItem: P355_INSERT_COUNT
            updateCountItem: P355_UPDATE_COUNT
            errorCountItem: P355_ERROR_COUNT
            reviewCountItem: P355_REVIEW_COUNT
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1384586792803724119
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 354
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                                   begin
                                            for c1 in (select skip_validation
                                                      from apex_appl_load_tables
                                                      where name = 'Importar Romaneio' and application_id = apex_application.g_flow_id )
                                            loop
                                                if c1.skip_validation = 'N' then return true;
                                                else return false;
                                                end if;
                                            end loop;
                                        end;
                ```
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 355
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                                   begin
                                            for c1 in (select skip_validation
                                                      from apex_appl_load_tables
                                                      where name = 'Importar Romaneio' and application_id = apex_application.g_flow_id )
                                            loop
                                                if c1.skip_validation = 'Y' then return true;
                                                else return false;
                                                end if;
                                            end loop;
                                        end;
                ```
        }
    )

)

