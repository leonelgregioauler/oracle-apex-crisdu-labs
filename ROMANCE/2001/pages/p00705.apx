        behavior {
            target: {
                page: 705
                items: {
                    P705_DATAINICIO: &P705_DATAINICIO.
                    P705_DATAFIM: &P705_DATAFIM.
                    P705_FILTRAR: S
                    P705_SALDO: &P705_SALDO.
