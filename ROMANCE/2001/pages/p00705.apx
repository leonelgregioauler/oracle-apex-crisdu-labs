    pageItem P705_IDVENDEDORA (
        type: popupLov
        label {
            label: Vendedora
            alignment: left
        }
        settings {
            displayAs: modalDialog
            initialFetch: autoCurrentValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select '- Todos -' display_value
                     , -1 return_value
                from dual
                union
                select pck_romance.fnc_nomepessoa(v.idpessoa) display_value
                     , v.idvendedora
                from representantes r
                   , vendedoras v
                where r.idrepresentante = v.idrepresentante
                  and r.idgerente = ( select idgerente
                                      from gerentes f
                                      where f.idfilial = :P0_IDFILIAL)
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

