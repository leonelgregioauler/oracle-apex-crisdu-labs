page 705 (
    name: Notas com 40% Comissão
    title: Notas com 40% Comissão
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
    )

    region notas-com-40-de-comissão (
        name: Notas Com 40% de Comissão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) "Representante"
                     , roman.pck_romance.fnc_nomevendedora(nv.idvendedora)         "Vendedora" 
                     , translate(to_char((roman.pck_romance.fnc_cpfvendedora(nv.idvendedora))/100, '000,000,000.00'), ',.', '.-') "CPF" 
                     , nv.numeronota                                               "Numero Nota"
                     , nv.datanota                                                 "Data Nota" 
                     , nv.valortotalnota                                           "Valor Nota"
                     , nv.perccomissao
                     , nv.saldo
                     , nv.idnotavenda
                     , snv.descricao situacao
                     , ( select p.idpedido
                         from favorita.pedidos p
                         where p.idnotavenda = nv.idnotavenda
                           and rownum <= 1 ) nrpedido
                from roman.notasvendas nv
                   , situacoesnotavenda snv
                where nv.idsituacaonotavenda = snv.idsituacaonotavenda
                  and nv.perccomissao = 40
                  and (:P705_SALDO is null or nv.saldo > :P705_SALDO)
                  and (:P705_DATAINICIO is null or trunc(nv.datanota) between :P705_DATAINICIO and :P705_DATAFIM)
                  and (:P705_IDVENDEDORA = -1 or :P705_IDVENDEDORA is null or nv.idvendedora = :P705_IDVENDEDORA)
                  and nv.idfilial = :P0_IDFILIAL
                  and nv.idsituacaonotavenda in (3,4)
                  and :P705_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Por favor, verifique os filtros informados!
        }
        advanced {
            savedReportMappingIdentifier: 1792528434275838963
        }

