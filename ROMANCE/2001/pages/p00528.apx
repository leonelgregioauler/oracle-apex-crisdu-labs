            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

