    pageItem P528_AVISO_CONTAGEM_FINALIZADA (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 20
            region: @avisos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText:
                ```html
                <font color="BLUE"><h2>
                    Contagem finalizada pelo Distribuidor, confira para autorizar a mesma e liberar o Distribuidor.
                    </h2></font>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from contagemcargasrepresentantes c
                where c.idcargarepresentante = :P528_IDCARGAREPRESENTANTE
                  and nvl(aprovada,'N') = 'N'
                  and datafim is not null
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P528_AVISO_EM_CONTAGEM (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 10
            region: @avisos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText:
                ```html
                <font color="red"><h2>
                    Contagem sendo realizada pelo Distribuidor, aguarde mais um momento!
                    </h2></font>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from contagemcargasrepresentantes c
                where c.idcargarepresentante = :P528_IDCARGAREPRESENTANTE
                  and nvl(aprovada,'N') = 'N'
                  and datafim is null
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P528_CODIGOLIBERACAO (
        type: displayOnly
        label {
            label: Código de Liberação
            alignment: left
        }
        layout {
            sequence: 20
            region: @contagem-realizada-da-carga
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select codigoliberacao
                from liberacoescontagenscargas l
                where exists ( select 1
                               from contagemcargasrepresentantes c
                               where c.idcontagemcargarepres = l.idcontagemcargarepres
                                 and c.idcargarepresentante  = :P528_IDCARGAREPRESENTANTE )
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from contagemcargasrepresentantes c
                where c.idcargarepresentante = :P528_IDCARGAREPRESENTANTE
                  and c.aprovada             = 'S'
                  and c.dataaprovada         is not null
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P528_IDCARGAREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @contagem-realizada-da-carga
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button aprovar-contagem (
        buttonName: APROVAR_CONTAGEM
        label: Aprovar Contagem
        layout {
            sequence: 20
            region: @contagem-realizada-da-carga
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: apex.confirm('Deseja realmente aprovar a contagem?','APROVAR_CONTAGEM');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from contagemcargasrepresentantes c
                where c.idcargarepresentante = :P528_IDCARGAREPRESENTANTE
                  and nvl(aprovada,'N') = 'N'
                  and datafim is not null
                ```
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @contagem-realizada-da-carga
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
                items: {
                    P13_IDCARGAREPRESENTANTE: &P528_IDCARGAREPRESENTANTE.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process aprova-contagem-de-carga (
        name: Aprova Contagem de Carga
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_vendas_rmc.prc_aprovacontagemcarga ( pidcargarepresentante => :P528_IDCARGAREPRESENTANTE,
                                                           pusuario => :P0_USUARIO);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Contagem aprovada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1600543897667226216
        }
        serverSideCondition {
            type: request=Value
            value: APROVAR_CONTAGEM
        }
    )

    branch (
        name: Go To Page 528
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 528
                items: {
                    P528_IDCARGAREPRESENTANTE: &P528_IDCARGAREPRESENTANTE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: APROVAR_CONTAGEM
        }
    )

)

