page 528 (
    name: Controle de Contagem de Carga
    title: Controle de Contagem de Carga
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region avisos (
        name: Avisos
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region contagem-realizada-da-carga (
        name: Contagem Realizada da Carga
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case
                         when icc.qtd_pp != icr.qtd_dist_pp 
                            or icc.qtd_p != icr.qtd_dist_p
                            or icc.qtd_m != icr.qtd_dist_m
                            or icc.qtd_g != icr.qtd_dist_g
                            or icc.qtd_gg != icr.qtd_dist_gg
                            or icc.qtd_egg != icr.qtd_dist_egg
                            or icc.qtd_exgg != icr.qtd_dist_exgg
                            or icc.qtd_u != icr.qtd_dist_u then
                            '<font color="red"><b>'||( select p.codigosisdist||' - '||p.nomeproduto
                                                       from produtos p
                                                       where exists ( select 1
                                                                      from estoquefilial e
                                                                      where e.idestoquefilial = icr.idestoquefil
                                                                        and e.idproduto       = p.idproduto ) )||'</font>'
                         else
                           '<font color="green"><b>'||( select p.codigosisdist||' - '||p.nomeproduto
                                                        from produtos p
                                                        where exists ( select 1
                                                                       from estoquefilial e
                                                                       where e.idestoquefilial = icr.idestoquefil
                                                                         and e.idproduto       = p.idproduto ) )||'</font>'
                       end produto
                     , icr.qtd_dist_pp 
                     , case
                         when icc.qtd_pp != icr.qtd_dist_pp then
                           '<font color="red"><b>'||icc.qtd_pp||'</font>'
                         else
                           '<font color="green">'||icc.qtd_pp||'</font>'
                       end qtd_pp
                     , icr.qtd_dist_p
                     , case
                         when icc.qtd_p != icr.qtd_dist_p then
                           '<font color="red"><b>'||icc.qtd_p||'</font>'
                         else
                           '<font color="green">'||icc.qtd_p||'</font>'
                       end qtd_p
                     , icr.qtd_dist_m
                     , case
                         when icc.qtd_m != icr.qtd_dist_m then
                           '<font color="red"><b>'||icc.qtd_m||'</font>'
                         else
                           '<font color="green">'||icc.qtd_m||'</font>'
                       end qtd_m
                     , icr.qtd_dist_g
                     , case
                         when icc.qtd_g != icr.qtd_dist_g then
                           '<font color="red"><b>'||icc.qtd_g||'</font>'
                         else
                           '<font color="green">'||icc.qtd_g||'</font>'
                       end qtd_g
                     , icr.qtd_dist_gg
                     , case
                         when icc.qtd_gg != icr.qtd_dist_gg then
                           '<font color="red"><b>'||icc.qtd_gg||'</font>'
                         else
                           '<font color="green">'||icc.qtd_gg||'</font>'
                       end qtd_gg
                     , icr.qtd_dist_egg
                     , case
                         when icc.qtd_egg != icr.qtd_dist_egg then
                           '<font color="red"><b>'||icc.qtd_egg||'</font>'
                         else
                           '<font color="green">'||icc.qtd_egg||'</font>'
                       end qtd_egg
                     , icr.qtd_dist_exgg
                     , case
                         when icc.qtd_exgg != icr.qtd_dist_exgg then
                           '<font color="red"><b>'||icc.qtd_exgg||'</font>'
                         else
                           '<font color="green">'||icc.qtd_exgg||'</font>'
                       end qtd_exgg
                     , icr.qtd_dist_u
                     , case
                         when icc.qtd_u != icr.qtd_dist_u then
                           '<font color="red"><b>'||icc.qtd_u||'</font>'
                         else
                           '<font color="green">'||icc.qtd_u||'</font>'
                       end qtd_u
                from itenscargarepresentante icr
                   , itenscontagenscargasrepres icc
                where icc.iditemcargarepres      = icr.iditemcargarepres
                  and icr.idcargarepresentante   = :P528_IDCARGAREPRESENTANTE
                order by pck_romance.fnc_nomeprodutoestoque(icr.idestoquefil)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color="green">* VERDE = Quantidades Corretas</font><br>
                <font color="red">* VERMELHO = Quantidades Sugerida diferente da Contada</font>
                ```
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

