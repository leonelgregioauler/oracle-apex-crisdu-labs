page 825 (
    name: Imprimi Termo Recebimento
    title: Imprimi Termo Recebimento
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }

    region impressão-termo (
        name: Impressão Termo
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vidcupom  number := :P825_CUPOM;
                  vresponsavel varchar2(50) := :P825_NOMEUSUARIO;
                  vretiradopor varchar2(1);
                  --
                begin
                  --
                  select c.retiradopor
                    into vretiradopor
                  from roman.conquistoulevoucupons c 
                  where c.idconquistoulevoucupom = :P825_CUPOM;
                  --
                  if vretiradopor = 'E' then 
                    --
                    favorita.pck_imprime_fav.prc_termo_conquistou_levou_emp(pidcupom => vidcupom,
                                                                            presponsavel => vresponsavel);
                  elsif vretiradopor = 'D' then
                    --                                                    
                    favorita.pck_imprime_fav.prc_termo_conquistou_levou_dist(pidcupom => vidcupom,
                                                                             presponsavel => vresponsavel);
                  end if;    
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P825_CAMPANHA (
        type: hidden
        layout {
            sequence: 20
            region: @impressão-termo
            slot: regionBody
        }
    )

    pageItem P825_CUPOM (
        type: hidden
        layout {
            sequence: 30
            region: @impressão-termo
            slot: regionBody
        }
    )

    pageItem P825_DOCUMENTO (
        type: hidden
        layout {
            sequence: 20
            region: @impressão-termo
            slot: regionBody
        }
    )

    pageItem P825_NOMEUSUARIO (
        type: hidden
        layout {
            sequence: 30
            region: @impressão-termo
            slot: regionBody
        }
    )

)

