page 635 (
    name: Risco/Crédito
    title: Risco/Crédito
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region início (
        name: Início
        type: list
        source {
            list: @risco-credito
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--3cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

    dynamicAction notifca-a-troca-de-senha (
        name: Notifca a troca de senha
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from controletrocasenha c
                where c.ativo = 'S'
                And 2 = 1
                and dataalteracao is null
                and idusuario = (select idusuario
                                from usuarios
                                where upper (usuario) = v('APP_USER'))
                ```
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    <html>
                    <head>       
                       <!--IMPORTAÇÕES NECESSÁRIAS-->
                        <link rel="stylesheet" href="http://code.jquery.com/ui/1.9.2/themes/redmond/jquery-ui.css" />
                        <script src="http://code.jquery.com/jquery-1.8.3.js"></script>
                        <script src="http://code.jquery.com/ui/1.9.2/jquery-ui.js"></script>         
                    </head>
                    <body>
                    <div id="dialog" title="Controle de autenticação">
                        <p>Você precisa redefinir a sua senha! Verifique seu email.<br> Seu acesso será bloqueado meia hora após o login.</p>
                    </div>
                    <script>
                    $( "#dialog" ).dialog();
                    </script>
                    </body>
                    </html>
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    process busca-id-filial (
        name: Busca id filial
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P0_IDFILIAL is null then
                 :P0_IDFILIAL := pck_romance.fnc_filialusuario(v('APP_USER'));
                end if;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 6120843048197113614
        }
    )

    process troca-idioma (
        name: troca idioma
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                APEX_UTIL.SET_SESSION_LANG(nvl(:P635_IDIOMA,'pt-br'));
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 6120843427326113615
        }
    )

)

