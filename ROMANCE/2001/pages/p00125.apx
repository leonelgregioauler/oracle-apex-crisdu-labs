    validation p125-qtd-egg (
        name: P125_QTD_EGG
        execution {
            sequence: 80
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from estoquepostoavancado e
                where nvl(e.qtd_egg,0) >= nvl(to_number(:P125_QTD_EGG),0)
                  and e.idestoquefil = nvl(:P125_IDESTOQUEFIL,:P125_IDPRODUTO2)
                ```
        }
        error {
            errorMessage: Quantidade Insuficiente
        }
    )

