        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante) display_value
                     , r.idrepresentante
                from representantes r
                where r.idgerente = ( select idgerente from gerentes where idfilial = :P0_IDFILIAL)
                order by 1
                ```
            nullDisplayValue: "- Selecione o Representante - "
