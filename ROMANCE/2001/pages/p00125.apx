    pageItem P125_IDESTOQUEFIL (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto) display_value
                     , e.idestoquefilial
                from estoquefilial e
                   , produtos      p
                where e.idfilial = :P0_IDFILIAL
                  and e.idproduto = p.idproduto
                  and p.codigosisdist = SUBSTR(:P125_CODIGO,1,5)
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P125_CODIGO
