    validation quantidade-movimentada (
        name: Quantidade movimentada >= 50
        execution {
            sequence: 120
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where  nvl(to_number(:P125_QTD_PP),0)
                     + nvl(to_number(:P125_QTD_P),0)
                     + nvl(to_number(:P125_QTD_M),0) 
                     + nvl(to_number(:P125_QTD_G),0) 
                     + nvl(to_number(:P125_QTD_GG),0) 
                     + nvl(to_number(:P125_QTD_EGG),0) 
                     + nvl(to_number(:P125_QTD_EXGG),0) 
                     + nvl(to_number(:P125_QTD_U),0) >= 50
                ```
        }
        error {
            errorMessage: Quantidade não permitida para movimentar o estoque! Registre um evento explicando o motivo dessa quantidade e solicitando liberação!
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2401,v('APP_USER')) = 'N'
                ```
        }
    )

    validation valida-quantidade (
        name: Valida quantidade
        execution {
            sequence: 110
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(:P125_QTD_PP) >= 0
                  or to_number(:P125_QTD_P) >= 0
                  or to_number(:P125_QTD_M) >= 0
                  or to_number(:P125_QTD_G) >= 0
                  or to_number(:P125_QTD_GG) >= 0
                  or to_number(:P125_QTD_EGG) >= 0
                  or to_number(:P125_QTD_EXGG) >= 0
                  or to_number(:P125_QTD_U) >= 0
                ```
        }
        error {
            errorMessage: Informe uma quantidade válida!
        }
    )

    process fetch-row-from-movimentosestoquepostoavan (
        name: Fetch Row from MOVIMENTOSESTOQUEPOSTOAVAN
        type: autoRowFetch
        source {
            tableName: MOVIMENTOSESTOQUEPOSTOAVAN
            pkColumn: IDMOVTOESTPOSTOAVAN
            pkItem: P125_IDMOVTOESTPOSTOAVAN
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 26659093134245769
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P125_IDMOVTOESTPOSTOAVAN is null then
                        select "SEQ_IDMOVTOESTPOSTOAVANCADO".nextval
                          into :P125_IDMOVTOESTPOSTOAVAN
                          from dual;
                    end if;
                    --
                    if :P125_OPCAO = 'P' then
                      :P125_IDESTOQUEFIL := :P125_IDPRODUTO2;
                    end if;
                    --    
                    :P125_QTD_PP  := to_number(:P125_QTD_PP )*-1;
                    :P125_QTD_P   := to_number(:P125_QTD_P  )*-1;
                    :P125_QTD_M   := to_number(:P125_QTD_M  )*-1;       
                    :P125_QTD_G   := to_number(:P125_QTD_G  )*-1;
                    :P125_QTD_GG  := to_number(:P125_QTD_GG )*-1;
                    :P125_QTD_EGG := to_number(:P125_QTD_EGG)*-1;       
                    :P125_QTD_U   := to_number(:P125_QTD_U  )*-1;
                    --
                    :P125_OBSERVACAO := 'Saída Manual. '||:P125_OBSERVACAO;
                    --
                    begin
                        select e.idestpostoavancado
                        into :P125_IDESTOQUEPOSTOAVANCADO
                        from estoquepostoavancado e
                        where e.idpostoavancado  = :P125_IDPOSTOAVANCADO
                          and idestoquefil       = :P125_IDESTOQUEFIL;
                    exception
                      when others then
                         SELECT seq_idestoquepostoavan.nextval
                         INTO :P125_IDESTOQUEPOSTOAVANCADO
                         from dual;
                         --
                         insert into estoquepostoavancado ( idestpostoavancado    , idpostoavancado    , idestoquefil
                                                          , qtd_pp             , qtd_p
                                                          , qtd_m                 , qtd_g              , qtd_gg
                                                          , qtd_egg               , qtd_u )
                         values ( :PP125_IDESTOQUEPOSTOAVANCADO     , :P125_IDPOSTOAVANCADO     , :P125_IDESTOQUEFIL
                                , 0              , 0
                                , 0                         , 0               , 0
                                , 0                       , 0 );
                    END;
                
                    --
                EXCEPTION
                  when others then
                     null;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 26659479194245769
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

