page 125 (
    name: Saída de Estoque
    title: Saída de Estoque
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function confirmaitem(event)
            { var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            if (tecla==13) 
            { var answer = confirm("Confirma saída do item no estoque?")
              if (answer)
              {apex.submit('CREATE');}}}
            ```
    }
    css {
        inline: ".t-Region-body { background-color: Beige !important;}"
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region relatório-de-movimentos-do-dia (
        name: Relatório de Movimentos do Dia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(e.idfilial) "Filial"
                     , pck_romance.fnc_nomepostoavancado( ep.idpostoavancado ) "Posto Avançado"
                     , ( select ca.nome
                         from categorias ca
                         where ca.idcategoria = ( select pr.idcategoria 
                                                 from produtos    pr
                                                 where pr.idproduto = e.idproduto ) ) "Categoria"
                     , ( select initcap( pr.codigosisdist ) 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Código"      
                     , ( select initcap( pr.nomeproduto ) 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Produto"         
                     , ( select c.descricao 
                         from cores c
                         where c.idcor = e.idcor ) "Cor"
                     , e.idestoquefilial
                     , e.idfilial
                     , e.idproduto
                     , e.idcor
                     , me.observacao    "Observação"
                     , me.usuario       "Usuário"
                     , me.datamovimento "Data Movimento"
                     , trunc(me.datamovimento) "Dia"
                     , (nvl(me.qtd_pp,0)
                     + nvl(me.qtd_p,0)
                     + nvl(me.qtd_m,0)
                     + nvl(me.qtd_g,0)
                     + nvl(me.qtd_gg,0)
                     + nvl(me.qtd_egg,0)
                     + nvl(me.qtd_u,0)) "Quantidade"
                from estoquefilial           e
                   , estoquepostoavancado  ep
                   , movimentosestoquepostoavan me
                where e.idestoquefilial = me.idestoquefil
                  and e.idestoquefilial = ep.idestoquefil
                  and ep.idpostoavancado = me.idpostoavancado
                  and e.idfilial = :P0_IDFILIAL
                  and trunc(me.datamovimento) = trunc(sysdate)
                  and (nvl(me.qtd_pp,0)
                     + nvl(me.qtd_p,0)
                     + nvl(me.qtd_m,0)
                     + nvl(me.qtd_g,0)
                     + nvl(me.qtd_gg,0)
                     + nvl(me.qtd_egg,0)
                     + nvl(me.qtd_u,0)) < 0
                order by me.datamovimento desc
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhum movimento efetuado hoje.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
