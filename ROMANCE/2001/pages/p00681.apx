page 681 (
    name: Anexos Requisições Pagamento
    title: Anexos Requisições Pagamento
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 700
        height: 500
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P681_IDANEXODELETAR":pidanexo}
              });
            }
            
            
            ```
    }

    region anexos-requisições-pagamento (
        name: Anexos Requisições Pagamento
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <font color="green"> Você pode anexar mais de um arquivo.</font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where exists (select 1
                                 from roman.requisicoespagamentos r
                                where r.idrequisicaopgto = :P681_IDREQUISICAO
                                  and r.idsituacao in (1,4));
                ```
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.nomearquivo
                     , idrequisicaopgto||t.idanexorequisicaopgto||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) ID
                     , url_bucket link
                     --, '<a href="javascript: fnc_verimg('''||idrequisicaopgto||idanexorequisicaopgto||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' link
                     , dataanexo data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario
                     , '<a href="javascript: fnc_removeanexo('||idanexorequisicaopgto||','''||t.nomearquivo||''');">Remover</a>' remover
                     , decode(t.comprovantepgto,'S','Sim','Não' ) Comprovante 
                from roman.anexosrequisicoes t
                where t.idrequisicaopgto = :P681_IDREQUISICAO
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from ANEXOSREQUISICOES a
                where a.idrequisicaopgto = :P681_IDREQUISICAO
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }

        column COMPROVANTE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Comprovante
                alignment: center
            }
            layout {
                sequence: 42
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column DATA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 22
            }
        )

        column LINK (
            reportColumnQueryId: 3
            derivedColumn: N
            type: link
            heading {
                heading: Link
                alignment: center
            }
            layout {
                sequence: 12
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: #LINK#
                }
                linkText: Ver Anexo
                linkAttributes: target="_blank"
            }
            sorting {
                sortable: false
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column REMOVER (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 52
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 32
            }
            sorting {
                sortable: false
            }
        )

    )

    region aviso (
        name: Aviso
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #3b82f6; text-align: center; padding: 10px; padding-bottom: 20px; border: 1px solid #bfdbfe; background-color: #eff6ff;">
                  <br>
                  Você só pode adicionar ou remover anexos em requisições de pagamento com situação <b>Pendente</b> ou <b>Ajuste Lançamento</b>.
                </div>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where exists (select 1
                                 from roman.requisicoespagamentos r
                                where r.idrequisicaopgto = :P681_IDREQUISICAO
                                  and r.idsituacao not in (1,4));
                ```
        }
    )

    pageItem P681_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            filenameColumn: NOMEARQUIVO
        }
        layout {
            sequence: 40
            region: @anexos-requisições-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P681_COMPROVANTEPGTO (
        type: plugin/simpleCheckbox
        label {
            label: Comprovante Pagamento
            alignment: left
        }
        settings {
            checkedValue: S
        }
        layout {
            sequence: 50
            region: @anexos-requisições-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: COMPROVANTEPGTO
            used: always
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P681_DATAANEXO (
        type: hidden
        layout {
            sequence: 80
            region: @anexos-requisições-pagamento
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATAANEXO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P681_IDANEXODELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @anexos-requisições-pagamento
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P681_IDANEXOREQUISICAOPGTO (
        type: hidden
        layout {
            sequence: 10
            region: @anexos-requisições-pagamento
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXOREQUISICAOPGTO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredAppLevel
            encryptSessionState: false
        }
    )

    pageItem P681_IDREQUISICAO (
        type: textField
        label {
            label: Requisição
            alignment: left
        }
        layout {
            sequence: 20
            region: @anexos-requisições-pagamento
            slot: regionBody
            alignment: left
            columnAttributes: readonly
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: IDREQUISICAOPGTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P681_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @anexos-requisições-pagamento
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                BEGIN
                  select idusuario
                  into vidusuario
                  from usuarios 
                  where usuario = v('APP_USER');
                  return vidusuario;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P681_NOMEARQUIVO (
        type: hidden
        layout {
            sequence: 30
            region: @anexos-requisições-pagamento
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 60
            region: @anexos-requisições-pagamento
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P681_IDANEXOREQUISICAOPGTO
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 20
            region: @anexos-requisições-pagamento
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P681_IDANEXOREQUISICAOPGTO
        }
    )

    validation selecione-o-arquivo (
        name: Selecione o Arquivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P681_ARQUIVOTEMP
        }
        error {
            errorMessage: Selecione o arquivo para anexar!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_requisicoespgto( pidrequisicao => :P681_IDREQUISICAO
                                                          ,pidanexo => :P681_IDANEXOREQUISICAOPGTO);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 563716811845965424
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P681_ARQUIVOTEMP
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_anexos.prc_apagaanexo_requisicaoespgto(pidanexorequisicao => :P681_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 563716943442965425
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexosrequisicoes (
        name: Fetch Row from ANEXOSREQUISICOES
        type: autoRowFetch
        source {
            tableName: ANEXOSREQUISICOES
            pkColumn: IDANEXOREQUISICAOPGTO
            pkItem: P681_IDANEXOREQUISICAOPGTO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 563869659890867402
        }
    )

    process get-pk (
        name: GET PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P681_IDANEXOREQUISICAOPGTO is null then
                        select roman.seq_idanexorequisicaopgto.nextval
                          into :P681_IDANEXOREQUISICAOPGTO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 563716598857965421
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: itemIsNotNull
            item: P681_ARQUIVOTEMP
        }
    )

    process process-row-of-anexosrequisicoespgto (
        name: Process Row of ANEXOSREQUISICOESPGTO
        type: autoRowProcessing
        target {
            tableName: ANEXOSREQUISICOES
            pkColumn: IDANEXOREQUISICAOPGTO
            pkItem: P681_IDANEXOREQUISICAOPGTO
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 563716620954965422
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P681_ARQUIVOTEMP
        }
    )

    branch (
        name: Anexar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 681
                items: {
                    P681_IDANEXOREQUISICAOPGTO:
                    P681_IDREQUISICAO: &P681_IDREQUISICAO.
                }
                action: resetPagination
            }
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 681
                items: {
                    P681_IDANEXOREQUISICAOPGTO:
                    P681_IDREQUISICAO: &P681_IDREQUISICAO.
                    P681_IDANEXODELETAR:
                }
                action: resetPagination
            }
        }
    )

)

