            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P409_FORNECEDOR
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 409
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 409
                items: {
                    P409_DATAINICIO: &P409_DATAINICIO.
                    P409_DATAFIM: &P409_DATAFIM.
                    P409_TIPOEMITENTE: &P409_TIPOEMITENTE.
                    P409_FORNECEDOR: &P409_FORNECEDOR.
                    P409_FILIALROMANCE: &P409_FILIALROMANCE.
                    P409_TIPORELATORIO: &P409_TIPORELATORIO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

