    pageItem P409_FILIALROMANCE (
        type: selectList
        label {
            label: Empresa Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where exists ( select 1
                               from notasfiscais nf
                               where nf.tipoemitente = 'FIL' 
                                 and nf.idfilialdestino = :P0_IDFILIAL
                                 and nf.idfilialemitente = f.idfilial )
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P409_FORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(f.idfornecedor) d
                     , f.idfornecedor r
                from fornecedores f
                where exists ( select 1
                               from notasfiscais nf
                               where nf.tipoemitente = 'FOR' 
                                 and nf.idfilialdestino = :P0_IDFILIAL
                                 and nf.idfornemitente = f.idfornecedor )
                order by 1
                ```
            nullDisplayValue: "- Todos - "
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

