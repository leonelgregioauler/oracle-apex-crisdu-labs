    dynamicAction ambos (
        name: Ambos
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P409_TIPOEMITENTE
        }
        clientSideCondition {
            type: item=value
            item: P409_TIPOEMITENTE
            value: AMB
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P409_FORNECEDOR
                    P409_FILIALROMANCE
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction empresa-romance (
        name: Empresa Romance
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P409_TIPOEMITENTE
        }
        clientSideCondition {
            type: item=value
            item: P409_TIPOEMITENTE
            value: FIL
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P409_FORNECEDOR
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P409_FILIALROMANCE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction fornecedor (
        name: Fornecedor
        execution {
            sequence: 10
        }
        when {
            selectionType: items
