    region produtos-recebidos-resumido (
        name: Produtos Recebidos Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeproduto(it.idproduto) produto
                     , sum(nvl(it.qtd_pp_chegou,0)) qtd_pp
                     , sum(nvl(it.qtd_p_chegou,0)) qtd_p
                     , sum(nvl(it.qtd_m_chegou,0)) qtd_m
                     , sum(nvl(it.qtd_g_chegou,0)) qtd_g
                     , sum(nvl(it.qtd_gg_chegou,0)) qtd_gg
                     , sum(nvl(it.qtd_egg_chegou,0)) qtd_egg
                     , sum(nvl(it.qtd_exgg_chegou,0)) qtd_exgg
                     , sum(nvl(it.qtd_u_chegou,0)) qtd_u
                     , sum(( nvl(it.qtd_pp_chegou,0)
                           + nvl(it.qtd_p_chegou,0) 
                           + nvl(it.qtd_m_chegou,0) 
                           + nvl(it.qtd_g_chegou,0) 
                           + nvl(it.qtd_gg_chegou,0)
                           + nvl(it.qtd_egg_chegou,0)
                           + nvl(it.qtd_exgg_chegou,0)
                           + nvl(it.qtd_u_chegou,0) )) total
                from itemnf it
                   , notasfiscais nf
                where it.idnotafiscal = nf.idnotafiscal
                  and trunc(nf.datarecebimento) between to_date(:P409_DATAINICIO) and to_date(:P409_DATAFIM)
                  and ( :P409_TIPOEMITENTE is null
                     or ( :P409_TIPOEMITENTE = 'FOR' and nf.tipoemitente = 'FOR' 
                                                     and ( :P409_FORNECEDOR is null or nf.idfornemitente = :P409_FORNECEDOR ) )
                     or ( :P409_TIPOEMITENTE = 'FIL' and nf.tipoemitente = 'FIL'
                                                     and ( :P409_FILIALROMANCE is null or nf.idfilialemitente = :P409_FILIALROMANCE ) ) )
                  and nf.idfilialdestino = :P0_IDFILIAL
                  and nf.situacaofilial = 'R'
                  and :P409_TIPORELATORIO = 'R'
                group by it.idproduto
                order by 1
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P409_TIPORELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
