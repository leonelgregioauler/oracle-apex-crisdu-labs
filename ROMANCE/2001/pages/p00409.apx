    region produtos-recebidos-detalhado (
        name: Produtos Recebidos Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.idnotafiscal
                     , nf.documento
                     , case 
                         when nf.idfornemitente is not null then
                           pck_romance.fnc_nomefornecedor(nf.idfornemitente)
                         when nf.idfilialemitente is not null then
                           pck_romance.fnc_nomefilial(nf.idfilialemitente)
                       end emitente
                     , nf.datarecebimento
                     , pck_romance.fnc_nomeproduto(it.idproduto) produto
                     , nvl(it.qtd_pp_chegou,0) qtd_pp
                     , nvl(it.qtd_p_chegou,0) qtd_p
                     , nvl(it.qtd_m_chegou,0) qtd_m
                     , nvl(it.qtd_g_chegou,0) qtd_g
                     , nvl(it.qtd_gg_chegou,0) qtd_gg
                     , nvl(it.qtd_egg_chegou,0) qtd_egg
                     , nvl(it.qtd_exgg_chegou,0) qtd_exgg
                     , nvl(it.qtd_u_chegou,0) qtd_u
                     , ( nvl(it.qtd_pp_chegou,0)
                       + nvl(it.qtd_p_chegou,0) 
                       + nvl(it.qtd_m_chegou,0) 
                       + nvl(it.qtd_g_chegou,0) 
                       + nvl(it.qtd_gg_chegou,0)
                       + nvl(it.qtd_egg_chegou,0)
                       + nvl(it.qtd_exgg_chegou,0)
                       + nvl(it.qtd_u_chegou,0) ) total
                from itemnf it
                   , notasfiscais nf
                where it.idnotafiscal = nf.idnotafiscal
                  and trunc(nf.datarecebimento) between to_date(:P409_DATAINICIO) and to_date(:P409_DATAFIM)
                  and ( :P409_TIPOEMITENTE is null
                     or ( :P409_TIPOEMITENTE = 'FOR' and nf.tipoemitente = 'FOR' 
                                                     and ( :P409_FORNECEDOR is null or nf.idfornemitente = :P409_FORNECEDOR ) )
                     or ( :P409_TIPOEMITENTE = 'FIL' and nf.tipoemitente = 'FIL'
                                                     and ( :P409_FILIALROMANCE is null or nf.idfilialemitente = :P409_FILIALROMANCE ) ) )
                  and nf.idfilialdestino = :P0_IDFILIAL
                  and nf.situacaofilial = 'R'
                  and :P409_TIPORELATORIO = 'D'
                order by nf.idnotafiscal desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P409_TIPORELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado. Verifique os filtros escolhidos.
        }
        advanced {
            savedReportMappingIdentifier: 1466798353023027739
        }

