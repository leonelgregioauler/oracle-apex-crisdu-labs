page 11 (
    name: Cadastro de Produtos
    title: Cadastro de Produtos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region cadastro-de-produtos (
        name: Cadastro de Produtos
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region produto-detalhado (
        name: Produto Detalhado
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDPRODUTODETALHADO",
                "IDPRODUTODETALHADO" IDPRODUTODETALHADO_DISPLAY,
                "IDPRODUTO",
                "IDCOR",
                "IDGRADE",
                "ATIVO"
                from "#OWNER#"."PRODUTOSDETALHADOS"
                where idproduto = :P11_IDPRODUTO
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (nulo)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhuma ramificação cadastrada.
        }
        componentAdvanced {
            stripHtml: true
        }

        column ATIVO (
            reportColumnQueryId: 6
            derivedColumn: N
            type: selectList
            heading {
                heading: Ativo
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Sim;S,Não;N
                displayNullValue: false
            }
            layout {
                sequence: 6
            }
        )

        column IDCOR (
            reportColumnQueryId: 4
            derivedColumn: N
            type: selectList
            heading {
                heading: Cor
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(descricao) display_value
                         , idcor return_value
                    from cores
                    order by 1
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 5
            }
        )

        column IDGRADE (
            reportColumnQueryId: 5
            derivedColumn: N
            type: selectList
            heading {
                heading: Grade
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select upper(sigla) display_value
                         , idgrade return_value
                    from grades 
                    order by ordem
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 4
            }
        )

        column IDPRODUTO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
        )

        column IDPRODUTODETALHADO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 1
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDPRODUTODETALHADO
            }
        )

        column IDPRODUTODETALHADO_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

    )

    pageItem P11_ATIVO (
        type: selectList
        label {
            label: Ativo
            alignment: right
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @cadastro-de-produtos
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: ATIVO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P11_CODIGOSISDIST (
        type: textField
        label {
            label: Código
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 35
            region: @cadastro-de-produtos
            slot: regionBody
            startNewRow: false
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        validation {
            maxLength: 5
        }
        advanced {
            customAttributes: readonly style="text-align: right;"
        }
        source {
            type: databaseColumn
            databaseColumn: CODIGOSISDIST
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P11_DESCRPRODUTO (
        type: textarea
