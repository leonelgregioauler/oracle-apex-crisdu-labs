        }
        layout {
            sequence: 100
            region: @cadastro-de-produtos
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 2000
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRPRODUTO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P11_DTATUALIZACAO (
        type: hidden
        layout {
            sequence: 110
            region: @cadastro-de-produtos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DTATUALIZACAO
            used: always
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P11_DTINCLUSAO (
        type: hidden
        layout {
