        source {
            type: databaseColumn
            databaseColumn: DTINCLUSAO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P11_IDCATEGORIA (
        type: selectList
        label {
            label: Categoria
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select NOME display_value, IDCATEGORIA return_value 
                from CATEGORIAS
                where ativo = 'S'
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @cadastro-de-produtos
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCATEGORIA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P11_IDFORNECEDOR (
        type: selectList
        label {
            label: Fornecedor
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(NVL(p.apelido,p.nomepessoa )||' ('||c.nomecidade)||'-'||e.sigla||')' display_value
                     , f.idfornecedor return_value
                from fornecedores f
                   , pessoas p
                   , cidades c
                   , estados e 
                where f.idpessoa  = p.idpessoa
                  and p.idcidade  = c.idcidade  
                  and c.idestado  = e.idestado
                  and ((:P11_IDFORNECEDOR IS NOT NULL and f.idfornecedor = :P11_IDFORNECEDOR) OR :P11_IDFORNECEDOR  IS NULL)
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-produtos
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFORNECEDOR
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P11_IDPRODUTO (
