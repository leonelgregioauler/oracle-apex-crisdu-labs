    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 40
            region: @produto-detalhado
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @produto-detalhado
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button cancel-2 (
        buttonName: CANCEL_2
        label: Voltar
        layout {
            sequence: 10
            region: @cadastro-de-produtos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @cadastro-de-produtos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P11_IDPRODUTO
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @cadastro-de-produtos
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_IDPRODUTO
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @cadastro-de-produtos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_IDPRODUTO
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @produto-detalhado
            slot: CHANGE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idcor-must-be-numeric (
        name: IDCOR must be numeric
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @produto-detalhado
            type: columnIsNumeric
            column: IDCOR
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: IDCOR
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idgrade-must-be-numeric (
        name: IDGRADE must be numeric
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @produto-detalhado
            type: columnIsNumeric
            column: IDGRADE
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: IDGRADE
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idproduto-must-be-numeric (
        name: IDPRODUTO must be numeric
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @produto-detalhado
            type: columnIsNumeric
            column: IDPRODUTO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: IDPRODUTO
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @produto-detalhado
        target {
            tableName: PRODUTOSDETALHADOS
            pkColumn: IDPRODUTODETALHADO
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Linha(s) #MRU_COUNT# atualizada(s); linha(s) #MRI_COUNT# inserida(s).
        }
        error {
            errorMessage: Não foi possível processar a atualização.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 11582780083749346
        }
        serverSideCondition {
            type: never
        }
    )

    process fetch-row-from-produtos (
        name: Fetch Row from PRODUTOS
        type: autoRowFetch
        source {
            tableName: PRODUTOS
            pkColumn: IDPRODUTO
            pkItem: P11_IDPRODUTO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 11582578137749346
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDPRODUTO.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P11_DTINCLUSAO := sysdate;
                  :P11_IDPRODUTO := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 11582977070749348
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-produtos (
        name: Process Row of PRODUTOS
        type: autoRowProcessing
        target {
            tableName: PRODUTOS
            pkColumn: IDPRODUTO
            pkItem: P11_IDPRODUTO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table PRODUTOS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 11583177201749348
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 11583385993749348
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 11
            }
            saveStateBeforeBranching: true
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 10
            }
            saveStateBeforeBranching: true
        }
    )

)

