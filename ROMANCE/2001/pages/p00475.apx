page 475 (
    name: Cadastro de Envio ao Informconf
    title: Cadastro de Envio ao Informconf
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-envio-ao-informconf (
        name: Cadastro de Envio ao Informconf
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P475_DATAENVIO (
        type: datePickerJquery
        label {
            label: Data do Envio
            alignment: left
        }
        layout {
            sequence: 60
            region: @cadastro-de-envio-ao-informconf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 15
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P475_DATAVENCIMENTO (
        type: datePickerJquery
        label {
            label: Vencimento
            alignment: left
        }
        layout {
            sequence: 70
            region: @cadastro-de-envio-ao-informconf
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 15
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P475_IDENTIFICACAO (
        type: textField
        label {
            label: Nro Identificação
            alignment: left
        }
        layout {
            sequence: 50
            region: @cadastro-de-envio-ao-informconf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P475_IDENVIOCOBRANCA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-envio-ao-informconf
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P475_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(u.idfilial) display_value
                     , u.idfilial return_value
                from usuariosfiliais u
                where u.usuario = v('APP_USER')
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @cadastro-de-envio-ao-informconf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P475_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' ('||decode(ativo,'S','Ativo','N','Inativo')||')' display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P475_IDFILIAL)
                order by 1  
                ```
        }
        cascadingLov {
            parentItems: P475_IDFILIAL
        }
        layout {
            sequence: 30
            region: @cadastro-de-envio-ao-informconf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P475_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' - '||nvl(documentoestrangeiro,cpf) display_value
                     , idvendedora return_value
                from pessoas p
                   , vendedoras v
                where v.idpessoa = p.idpessoa
                  and ( :P475_IDFILIAL is null or v.idfilial = :P475_IDFILIAL )
                  and ( :P475_IDREPRESENTANTE is null or v.idrepresentante = :P475_IDREPRESENTANTE )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: [
                P475_IDREPRESENTANTE
                P475_IDFILIAL
            ]
        }
        layout {
            sequence: 40
            region: @cadastro-de-envio-ao-informconf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P475_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 110
            region: @cadastro-de-envio-ao-informconf
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P475_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 80
            region: @cadastro-de-envio-ao-informconf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
            height: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P475_TIPO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @cadastro-de-envio-ao-informconf
            slot: regionBody
        }
        default {
            type: static
            staticValue: I
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P475_USUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @cadastro-de-envio-ao-informconf
            slot: regionBody
        }
        source {
            used: always
        }
        default {
            type: expression
            plsqlExpression: v('APP_USER')
        }
        security {
            encryptSessionState: false
        }
    )

    button close (
        buttonName: CLOSE
        label: Fechar
        layout {
            sequence: 10
            region: @cadastro-de-envio-ao-informconf
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 474
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @cadastro-de-envio-ao-informconf
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P475_IDENVIOCOBRANCA
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 20
            region: @cadastro-de-envio-ao-informconf
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P475_IDENVIOCOBRANCA
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 30
            region: @cadastro-de-envio-ao-informconf
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P475_IDENVIOCOBRANCA
        }
    )

    process processo-dml-em-envio-ao-informconf (
        name: Processo DML em Envio ao Informconf
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vmd5          varchar2(1000);
                  --
                begin
                  --
                  if v('REQUEST') = 'CREATE' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'S';
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  PCK_CADASTROS_RMC.PRC_ENVIOSCOBRANCAS( PIDENVIOCOBRANCA => :P475_IDENVIOCOBRANCA
                                                       , PIDFILIAL => :P475_IDFILIAL
                                                       , PIDREPRESENTANTE => :P475_IDREPRESENTANTE
                                                       , PIDVENDEDORA => :P475_IDVENDEDORA
                                                       , PIDENTIFICACAO => :P475_IDENTIFICACAO
                                                       , PDATAENVIO => :P475_DATAENVIO
                                                       , PDATAVENCIMENTO => :P475_DATAVENCIMENTO
                                                       , PTIPO => :P475_TIPO
                                                       , PUSUARIO => :P475_USUARIO
                                                       , POBSERVACAO => :P475_OBSERVACAO
                                                       , PMD5 => vmd5
                                                       , POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo Executado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 1539036266886976887
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('CREATE','SALVAR','DELETAR')
                ```
        }
    )

    process processo-dml-em-envio-cobrança (
        name: Processo DML em Envio Cobrança
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdataenvio      date;
                  vdatavencimento date;
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_ENVIOSCOBRANCAS( PIDENVIOCOBRANCA => :P475_IDENVIOCOBRANCA
                                                       , PIDFILIAL => :P475_IDFILIAL
                                                       , PIDREPRESENTANTE => :P475_IDREPRESENTANTE
                                                       , PIDVENDEDORA => :P475_IDVENDEDORA
                                                       , PIDENTIFICACAO => :P475_IDENTIFICACAO
                                                       , PDATAENVIO => vdataenvio
                                                       , PDATAVENCIMENTO => vdatavencimento
                                                       , PTIPO => :P475_TIPO
                                                       , PUSUARIO => :P475_USUARIO
                                                       , POBSERVACAO => :P475_OBSERVACAO
                                                       , PMD5 => :P475_MD5
                                                       , POPERACAO_DML => 'S');
                  --
                  :P475_DATAENVIO := to_date(vdataenvio,'DD/MM/RRRR');
                  :P475_DATAVENCIMENTO := to_date(vdatavencimento,'DD/MM/RRRR');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1534781860448038019
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 475
                items: {
                    P475_IDENVIOCOBRANCA:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 475
                items: {
                    P475_IDENVIOCOBRANCA: &P475_IDENVIOCOBRANCA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where v('REQUEST') in ('CREATE','SALVAR')
                ```
        }
    )

)

