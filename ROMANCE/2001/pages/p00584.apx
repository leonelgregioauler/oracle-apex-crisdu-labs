    region ranking-de-engajamento (
        name: Ranking de Engajamento
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante )  "Representante"
                     , nvl(ped.valorapagar,0) "Valor Total"
                     , nvl(ped.qtd,0) "Qtd Pedidos"
                     , nvl(paris.valorapagar,0) "Valor Total Paris"
                     , nvl(paris.qtd,0) "Qtd Paris"
                     , nvl(ped.valorapagar,0) + nvl(paris.valorapagar,0) "Total"
                     , nvl(ped.qtd,0) + nvl(paris.qtd,0) "QTD Total"
                     , '=' s1
                     , '|' s2
                     , '|' s3
                     , '+' s4
                     , nvl(notas.qtd,0) "Atendimentos RMC Realizados"
                     , case 
                         when notas.qtd > 0 then
                           round( ( nvl(ped.qtd,0) / nullif(notas.qtd,0) ) * 100 ) 
                         else
                           0
                       end engajamento
                from representantes r
                   , ( select idrepresentante
                            , count(distinct idvendedora) qtd
                       from notasvendas nv
                       where nv.idfilial = :P0_IDFILIAL
                         and nv.idsituacaonotavenda = 4 
                         and nv.idsemanacobranca between :P584_IDSEMANA and :P584_IDSEMANA_FIM
                       group by idrepresentante ) notas
                   , ( select pp.idrepresentante
                            , sum(pp.valorapagar) valorapagar
                            , sum(pp.valortotal) valortotal
                            , count(distinct pp.idvendedora) qtd
                       from favorita.pedidos pp
                          , notasvendas nv
                       where nv.idvendedora = pp.idvendedora
                         and pp.idsituacaoentrega >= 20000
                         and pp.tipopedido in ('P', 'T', 'V')
                         and pp.valorapagar > 0
                         and pp.idnotavenda = nv.idnotavenda
                         and not exists ( select 1
                                          from favorita.classificacoespedidos cf
                                          where cf.idcaracteristicapedido = 25
                                            and cf.idpedido               = pp.idpedido )
                         and pp.idfilialromance  = :P0_IDFILIAL
                         and nv.idsituacaonotavenda = 4 
                         and nv.idsemanacobranca between :P584_IDSEMANA and :P584_IDSEMANA_FIM
                       group by pp.idrepresentante ) ped
                    , ( select pp.idrepresentante
                            , sum(pp.valorapagar) valorapagar
                            , count(distinct pp.idvendedora) qtd
                       from favorita.pedidos pp
                          , notasvendas nv
                       where nv.idvendedora = pp.idvendedora
                         and pp.idsituacaoentrega >= 20000
                         and pp.tipopedido = 'F'
                         and pp.valorapagar > 0
                         and pp.idnotavenda = nv.idnotavenda
                         and not exists ( select 1
                                          from favorita.classificacoespedidos cf
                                          where cf.idcaracteristicapedido = 25
                                            and cf.idpedido               = pp.idpedido )
                         and pp.idfilialromance  = :P0_IDFILIAL
                         and nv.idsituacaonotavenda = 4 
                         and nv.idsemanacobranca between :P584_IDSEMANA and :P584_IDSEMANA_FIM
                       group by pp.idrepresentante ) paris
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                  and r.ativo = 'S'
                  and r.idrepresentante = ped.idrepresentante(+)
                  and r.idrepresentante = paris.idrepresentante(+)
                  and r.idrepresentante = notas.idrepresentante(+)
                ```
        }
