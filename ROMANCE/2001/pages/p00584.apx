    pageItem P584_DTFIM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @engajamento-favorita
            slot: regionBody
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v number;
                  d date;
                begin
                
                  select idsemana+1
                  into v
                  from semana_dias
                  where semana = to_number(substr( :P584_SEMANA,1,2))
                    and ano    = substr( :P584_SEMANA,4,4);
                
                  select dt_fim
                  into d
                  from semana_dias
                  where idsemana = v;
                  return d;
                exception
                  when others then
                    return null;
                end;
                
                ```
        }
        security {
            encryptSessionState: false
        }
    )

