page 767 (
    name: Modulos Inforboard
    alias: REL-MODULOS-INFOBOARD
    title: Modulos Infoboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region rel-modulos-infoboard (
        name: Rel Modulos Infoboard
        type: interactiveReport
        source {
            location: localDatabase
            tableName: MODULOSINFOBOARD
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 768
                items: {
                    P768_IDMODINFOBOARD: #IDMODINFOBOARD#
                }
                clearCache: 768
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 377213218850835044
        }

        column IDMODINFOBOARD (
            type: hidden
            heading {
                heading: Idmodinfoboard
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMEINFOBOARD (
            type: plainText
            heading {
                heading: Nome Infoboard
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Rel Modulos Infoboard
        }

        savedReport 3772502 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IDMODINFOBOARD (
                sequence: 1
            )

            displayColumn NOMEINFOBOARD (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Módulo
        layout {
            sequence: 10
            region: @rel-modulos-infoboard
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 768
                clearCache: 768
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @rel-modulos-infoboard
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @rel-modulos-infoboard
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

