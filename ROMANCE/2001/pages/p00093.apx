page 93 (
    name: Perfil
    title: Perfil
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region perfil (
        name: Perfil
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "IDPERFIL", 
                "DESCRICAO"
                from "#OWNER#"."PERFIL" 
                where idsistema = 2001
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 105
                items: {
                    P105_IDPERFIL: #IDPERFIL#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#e2.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 80461148546908889
        }

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descricao
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDPERFIL (
            type: hidden
            heading {
                heading: Idperfil
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 804633 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn IDPERFIL (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Cadastrar
        layout {
            sequence: 20
            region: @perfil
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 105
                clearCache: 105
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button liberar (
        buttonName: LIBERAR
        label: Liberar Perfil p/ Usuário
        layout {
            sequence: 10
            region: @perfil
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 26
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

