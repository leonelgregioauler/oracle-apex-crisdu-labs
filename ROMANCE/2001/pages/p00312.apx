        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeusuario(usuario) display_value
                 , usuario
                from usuarios 
                where idgerente = 80
                  and ativo = 'S'
                order by 1
