    region rendimento-favorita-antiga (
        name: Rendimento Favorita Antiga
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(1) "Qtd"
                 , b.usuariopromissoriarec "Documentadora"
                 , trunc(b.dataatualizacaoprom) "Data Recebimento"
                from boletos b
                where trunc(b.dataatualizacaoprom) between to_date(:P312_DATAINI,'DD/MM/RRRR') and to_date(:P312_DATAFIM,'DD/MM/RRRR') 
                  and ( :P312_USUARIO is null or usuariopromissoriarec = :P312_USUARIO )
                  and ( :P312_TIPOPROMISSORIA is null or b.idsituacaopromissoria = :P312_TIPOPROMISSORIA )
                  and idsituacaopromissoria is not null
                  and usuariopromissoriarec is not null
                group by trunc(b.dataatualizacaoprom)
                       , b.usuariopromissoriarec
                order by 2, 3
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
