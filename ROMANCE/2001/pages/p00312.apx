    region rendimento-romance (
        name: Rendimento Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(1) "Qtd"
                     , n.usuariopromissoriarec "Documentadora"
                     , trunc(n.dataatualizacaopromissoria) "Data Recebimento"
                from notasvendas n
                where trunc(n.dataatualizacaopromissoria) between to_date(:P312_DATAINI,'DD/MM/RRRR') and to_date(:P312_DATAFIM,'DD/MM/RRRR')
                  and ( :P312_USUARIO is null or usuariopromissoriarec = :P312_USUARIO )
                  and ( :P312_TIPOPROMISSORIA is null or n.idsituacaopromissoria = :P312_TIPOPROMISSORIA )
                  and exists ( select 1
                               from classificacoesnotasvendas c
                               where c.idnotavenda = n.idnotavenda
                                 and c.idcaracteristicanotavenda = 4 )
                group by trunc(n.dataatualizacaopromissoria)
                 , usuariopromissoriarec
                order by 2, 3
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
