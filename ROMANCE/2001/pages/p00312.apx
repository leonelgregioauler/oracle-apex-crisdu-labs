    region rendimento-favorita (
        name: Rendimento Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count( distinct idpedido) qtd
                     , ( select usuario
                         from usuarios u
                         where u.idusuario = cp.idusuario ) "Documentadora"
                     , trunc(cp.dataclassificado) "Data"
                from favorita.classificacoespedidos cp
                where cp.idcaracteristicapedido = 71
                  and trunc(cp.dataclassificado) between to_date(:P312_DATAINI,'DD/MM/RRRR') and to_date(:P312_DATAFIM,'DD/MM/RRRR')
                  and ( :P312_TIPOPROMISSORIA is null or cp.idvalorcaracteristica = :P312_TIPOPROMISSORIA )
                  and exists ( select 1
                               from usuarios u
                                  , usuariosgruposatendimento ug
                               where u.usuario = ug.usuario
                                 and u.idusuario = cp.idusuario
                                 and ( :P312_USUARIO is null or u.usuario = :P312_USUARIO )
                                 and ug.idgrupoatendimento = 35 )
                group by cp.idusuario
                       , trunc(cp.dataclassificado) 
                order by 2, 3
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum dado encontrado!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1585506049524206433
        }

