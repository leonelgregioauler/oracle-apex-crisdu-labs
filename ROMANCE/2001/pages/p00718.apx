    dynamicAction mostra-data (
        name: MOSTRA_DATA
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P718_PERIODO_POR
        }
        clientSideCondition {
            type: item=value
            item: P718_PERIODO_POR
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P718_DATA_INICIAL
                    P718_DATA_FINAL
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
