    security {
        pageAccessProtection: unrestricted
    }

    region distribuidor (
        name: Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(nv.idfilial) "Franquia"
                     , roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) "Distribuidor"
                     , (select trunc(r.datainclusao)
                        from   catal.representantes r
                        where  r.idrepresentante = nv.idrepresentante) "Inclusão"
                     , sum(nv.valortotalnota) "Valor Distribuido"
                     , sum(nv.valortotaldevolucao) "Valor Devolução"
                     , sum(nv.valortotalvenda) "Valor Venda"
                     , to_char(round((sum(nv.valortotalvenda)/sum(nv.valortotalnota)) * 100)) || '%'  "Percentual venda"
                 from roman.notasvendas nv
                    , roman.semana_dias sd
                where nv.semanacobranca = sd.semanacompleta
                  and :P718_VENDA_POR = 'D'
                  and nv.idsituacaonotavenda = 4
                  and (( :P718_PERIODO_POR = 'S' and  sd.idsemana between :P718_SEMANA_INICIAL and :P718_SEMANA_FINAL) or
                       ( :P718_PERIODO_POR = 'D' and  nv.dataacerto between :P718_DATA_INICIAL and :P718_DATA_FINAL))
                  and (:P0_IDFILIAL = -1 or nv.idfilial = :P0_IDFILIAL)
                Group by nv.idfilial
                       , nv.idrepresentante
                order by 1,2;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2118196475726750309
        }

