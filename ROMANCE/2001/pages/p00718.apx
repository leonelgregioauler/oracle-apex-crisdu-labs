    validation validacao-data-final (
        name: Validacao Data Final
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                begin
                    if :P718_DATA_FINAL is null and :P718_PERIODO_POR = 'D' then
                        return false;
                    else
                        return true;
                    end if;
                end;
                ```
        }
        error {
            errorMessage: Data final deve ser informada!
            associatedItem: @P718_DATA_FINAL
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

