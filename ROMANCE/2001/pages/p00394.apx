            function fnc_popup_consulta()
            {
              window.open('f?p=&APP_ID.:156:&SESSION.::NO::','CONSULTAR', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=250,left=250,top=100','_blank'); void(0);
            }
            
            function fnc_popup()
            {
            window.open('f?p=&APP_ID.:147:&SESSION.::NO::','LIMPAR', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=180,left=250,top=100','_blank'); void(0);
            }
            
            function fnc_popup_remarca()
            {
            window.open('f?p=&APP_ID.:169:&SESSION.::NO::','remarca', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=900,height=600,left=250,top=100','_blank'); void(0);
            }
            
            function fotosdocumento(vidpessoa)
            {
              pjanela = window.open('f?p=&APP_ID.:373:&SESSION.::NO:373:P373_IDPESSOA:'+vidpessoa,'DOCUMENTOS','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=600,height=600,screenX=50,screenY =100');
              pjanela.focus();
            }
            
            function formatar_mascara(src,mascara,evt){
            var tecla;  
            if(evt.which){tecla = evt.which}
            else if(evt.keyCode){ tecla = evt.keyCode;}  
             if( tecla != 8 ){
             var campo = src.value.length;
             var saida = mascara.substring(0,1);
             var texto = mascara.substring(campo);
             if(texto.substring(0,1) != saida) {
             src.value+=texto.substring(0,1);}}
            }
            
            
            ```
