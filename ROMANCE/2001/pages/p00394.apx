    region notas-de-venda (
        name: Notas de Venda
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , to_number(nv.numeronota)                                     numeronota
                     , pck_romance.fnc_nomerepresentante(pidrepresentante => nv.idrepresentante) "Representante"
                     , nv.datanota
                     , nv.semanadistribuicao                                        "Semana Distribuição"
                     , nv.semanacobranca                                            "Semana Cobrança"
                     , pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) "Vendedora"
                     , pck_romance.fnc_enderecovendedora(pidvendedora => nv.idvendedora) "Endereço"
                     , pck_romance.fnc_nomeregiaovenda(nv.idregiaovenda)            "Região de Venda"
                     , nv.idregiaovenda
                     , nv.valortotalnota
                     , nv.valortotaldevolucao
                     , nv.idrepresentante
                     , nv.idvendedora
                     , nv.valortotalvenda
                     , nv.valortotalvendalqd
                     , nv.basecomissao
                     , nv.perccomissao
                     , nv.valorcomissao
                     , nv.valorpago                                                 valorpago
                     , nvl(( select sum(p.valorpago)
                               from pagamentosnotasvendas p
                              where p.idnotavenda      = nv.idnotavenda
                                and p.idsemanacobranca = nv.idsemanacobranca ), 0)   pagonasemana
                     , nv.saldo
                     , nvl(pp.documentoestrangeiro, pp.cpf)                         "CPF. Vend."
                     , pck_romance.fnc_nomecidade(pp.idcidade)                      "Cidade. Vend."
                     , sn.descricao                                                 "Situação"
                     , decode(nv.quitadapepino,'Q','Quitado','P','Débito','R','Remarcada') "Quitado/Débito"
                     , nv.dataretorno
                     , pck_romance.fnc_nomerepresentante(nv.idrepresentanteatende)  "Repres. Atende"
                     , decode(nv.enviadocobranca,'S','Sim','Não')                   "Enviado para Cobrança"
                     , decode(v.ativo,'S','Sim','Não')                              "Situação Vendedora"
                     , ( select count(1) from notasvendas n
                          where n.idvendedora = nv.idvendedora )                    "Qtd Notas"
                     , pck_romance.fnc_retornatelefones(nv.idvendedora)             "Telefones"
                     , nvl(itn.qtd_dist, 0)                                         "Qtd Dist"
                     , case when nv.idsituacaonotavenda = 4
                            then nvl(itn.qtd_vendida, 0) else 0 end                 "Qtd Vendida"
                     , pck_romance.fnc_verificadebito(nv.idvendedora)               "Qtd Débito"
                     , nv.dataacerto
                     , nvl( ( select vw.descsituacao                                               
                              from vw_assinaturas_eletronicas vw
                              where vw.idnotavenda = nv.idnotavenda 
                                and vw.status = 'C' 
                                and vw.idassinaturaeletronica = ( select max(aa.idassinaturaeletronica)
                                                                  from assinaturaseletronicas aa
                                                                  where aa.idnotavenda = nv.idnotavenda
                                                                    and aa.status = 'C' ) ),'Assinatura Eletronica não localizada!' ) situacao_assinatura --15411421
                  from notasvendas nv
                  join vendedoras  v  on v.idvendedora = nv.idvendedora
                  join pessoas     pp on pp.idpessoa   = v.idpessoa
                  left join situacoesnotavenda sn on sn.idsituacaonotavenda = nv.idsituacaonotavenda
                  outer apply ( select sum(i.quantidade)                         qtd_dist
                                     , sum(i.quantidade - nvl(i.qtddevolvida,0))  qtd_vendida
                                  from itensnotavenda i
                                 where i.idnotavenda = nv.idnotavenda )           itn
                 where nv.idfilial = :P394_IDFILIAL
                   and ( :P394_NRNOTA          is null or nv.numeronota          = :P394_NRNOTA )
                   and ( :P394_IDREPRESENTANTE is null or nv.idrepresentante     = :P394_IDREPRESENTANTE
                                                       or nv.idrepresentanteatende = :P394_IDREPRESENTANTE )
                   and ( :P394_IDVENDEDORA     is null or nv.idvendedora         = :P394_IDVENDEDORA )
                   and ( :P394_REGIAOVENDA     is null or nv.idregiaovenda       = :P394_REGIAOVENDA )
                   and ( :P394_TIPO = 'Z'
                      or (:P394_TIPO = 'D' and (:P394_SEMANA is null or nv.semanadistribuicao = :P394_SEMANA))
                      or (:P394_TIPO = 'C' and (:P394_SEMANA is null or nv.semanacobranca     = :P394_SEMANA)) )
                ```
        }
