    pageItem P394_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select nome
                     , idfilial
                from vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and pck_util.fnc_verificaacesso(2514,v('APP_USER')) = 'S'
                union
                select nome
                     , idfilial
                from vw_filiais f
                where exists ( select 1
                               from usuariosfiliais u
                               where u.idfilial = f.idfilial
                                 and u.usuario  = v('APP_USER') )
                  and pck_util.fnc_verificaacesso(2514,v('APP_USER')) = 'N'
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P394_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||r.idrepresentante||')' || decode(r.ativo,'S','','Inativo') display_value
                     , r.idrepresentante
                from representantes r
                where idgerente in ( select idgerente
                                     from gerentes
                                     where idfilial = :P394_IDFILIAL)
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P394_IDFILIAL
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P394_IDVENDEDORA (
        type: popupLov
        label {
            label: Cliente
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomepessoa)||' - '||replace(replace(nvl(cpf,documentoestrangeiro),'-',''),'.','') ||' ('||idvendedora||')' display_value
                     , v.idvendedora return_value
                from vendedoras v
                   , pessoas p
                where v.idpessoa = p.idpessoa
                  and ( :P394_IDREPRESENTANTE is null  or v.idrepresentante = :P394_IDREPRESENTANTE ) 
                  and v.idrepresentante in (select idrepresentante
                                            from representantes
                                            where idgerente in ( select idgerente
                                                                 from gerentes
                                                                 where idfilial = :P0_IDFILIAL))
                order by 1
                ```
            nullDisplayValue: %
        }
        cascadingLov {
            parentItems: P394_IDREPRESENTANTE
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P394_NRNOTA (
        type: textField
        label {
            label: Nr Nota
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P394_REGIAOVENDA (
        type: selectList
        label {
            label: Região de Venda
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(idregiaovenda) display_value
                  , idregiaovenda return_value 
                from regioesrepresentantes
                where idrepresentante = :P394_IDREPRESENTANTE
                ```
        }
        cascadingLov {
            parentItems: P394_IDREPRESENTANTE
            itemsToSubmit: P394_IDREPRESENTANTE
        }
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P394_SEMANA (
        type: textField
        label {
            label: Semana
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 7
        }
        advanced {
            customAttributes: "onkeyPress=\"javascript:{formatar_mascara(this, '##/###',event); }\""
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P394_TIPO (
        type: radioGroup
        label {
            label: " Semana"
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Distribuição;D,Cobrança;C,Sem Filtro;Z
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: D
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: FILTRAR
        layout {
            sequence: 80
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction set-value (
        name: set value
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P394_IDREPRESENTANTE
        }
        serverSideCondition {
            type: never
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 394
                items: {
                    P394_IDREPRESENTANTE: &P394_IDREPRESENTANTE.
                    P394_IDVENDEDORA: &P394_IDVENDEDORA.
                    P394_NRNOTA: &P394_NRNOTA.
                    P394_TIPO: &P394_TIPO.
                    P394_SEMANA: &P394_SEMANA.
                    P394_REGIAOVENDA: &P394_REGIAOVENDA.
                }
                action: resetPagination
            }
        }
    )

)

