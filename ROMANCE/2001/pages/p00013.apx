    region itens-da-carga-2 (
        name: Itens da Carga
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDITEMCARGAREPRES
                     , IDITEMCARGAREPRES IDITEMCARGAREPRESdisplay
                     , IDCARGAREPRESENTANTE
                     , ( select codigosisdist from produtos p where p.idproduto = E.IDPRODUTO) CODIGO
                     , (select initcap(p.nomeproduto) from produtos p where idproduto = ( select idproduto from estoquefilial e where e.idestoquefilial = e.IDESTOQUEFIL)) PRODUTO
                     , QUANTIDADE
                     , decode(comissao,'S','Sim','Não') comissao
                     , VALORVENDA
                     --
                     , qtd_dist_pp 
                     , qtd_dist_p  
                     , qtd_dist_m  
                     , qtd_dist_g  
                     , qtd_dist_gg 
                     , qtd_dist_egg
                     , qtd_dist_exgg
                     , qtd_dist_u                             
                     --
                     , nvl(qtd_dist_pp ,0) 
                      + nvl(qtd_dist_p ,0)  
                      + nvl(qtd_dist_m ,0)  
                      + nvl(qtd_dist_g ,0)
                      + nvl(qtd_dist_gg,0)  
                      + nvl(qtd_dist_egg,0) 
                      + nvl(qtd_dist_exgg,0) 
                      + nvl(qtd_dist_u,0)   qtd_dist_TOTAL
                     --
                     , case 
                         when e.estoquemovto = 'D' then
                           'Distribuição'
                         when e.estoquemovto = 'P' then
                           pck_romance.fnc_nomepostoavancado(idpostoavancado)
                         when e.estoquemovto = 'R' then
                           'Reembalagem'
                       else 
                         ' - '
                       end estoquemovimentado
                     , (nvl(qtd_dist_pp ,0) 
                      + nvl(qtd_dist_p ,0)  
                      + nvl(qtd_dist_m ,0)  
                      + nvl(qtd_dist_g ,0)
                      + nvl(qtd_dist_gg,0)  
                      + nvl(qtd_dist_egg,0) 
                      + nvl(qtd_dist_exgg,0) 
                      + nvl(qtd_dist_u,0)) * e.valorvenda "Total"
                     , e.idestoquefil
                from ITENSCARGAREPRESENTANTE E
                Where idcargarepresentante = :P13_IDCARGAREPRESENTANTE
                  and e.cargaamais = 'N'
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P13_IDCARGAREPRESENTANTE is not null and :P0_ESTOQUECONGELADO = 'S'
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

