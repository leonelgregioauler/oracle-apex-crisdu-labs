page 13 (
    name: Carga Clientes
    title: Carga Clientes
    appearance {
        pageTemplate: @/marquee
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='Deseja realmente excluir a carga do Cliente?';
            var htmldb_delete_message2='Deseja realmente cancelar a carga do Cliente?? Este Cancelamento irá devolver as peças ao estoque!';
            
            function abrepopprod()
            {
              if (document.getElementById('P13_SITUACAO_HIDDENVALUE').value == 1)
              {
                fnc_popup_produto('N');
              }
            }
            function formatar_mascara(src,mascara,evt){
              var tecla;  
              if(evt.which)
                {
                  tecla = evt.which
                }
              else 
                if(evt.keyCode)
                  { 
                    tecla = evt.keyCode;
                  }
              if ( tecla != 8 && tecla!=13 && tecla!=47 && tecla!=59) 
                {
                  var campo = src.value.length;
                  var saida = mascara.substring(0,1);
                  var texto = mascara.substring(campo);
                  if(texto.substring(0,1) != saida) 
                    { 
                      src.value+=texto.substring(0,1);
                    }
                }
              
            }
            
            function fnc_popup_produto(pmais)
            {
              vidcarga= document.getElementById("P13_IDCARGAREPRESENTANTE").value;
              window.open( 'f?p=&APP_ID.:14:&SESSION.::NO::P14_IDCARGAREPRESENTANTE,P14_IDITEMCARGAREPRES,P14_CARGAAMAIS:'+vidcarga+',,'+pmais
                         , 'CADITEMCARGA', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=300,left=250,top=100','_blank'); void(0);
            }
            
            
            function fnc_popup_carga()
            {
              vidfilial = document.getElementById('P13_IDFILIAL').value;
              vidrepresentante = document.getElementById('P13_IDREPRESENTANTE').value;
              vsemana = document.getElementById('P13_SEMANA').value;
              window.open('f?p=&APP_ID.:20:&SESSION.::NO::P20_IDFILIAL,P20_IDREPRESENTANTE,P20_SEMANA:'+vidfilial+','+vidrepresentante+','+vsemana,'CARGA', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=700,height=800,left=600,top=100','_blank'); void(0);
            }
            
            function fnc_popup_edita_produto(piditcarga)
            {window.open('f?p=&APP_ID.:15:&SESSION.::NO::P15_IDITEMCARGAREPRES:'+piditcarga,'EDITAITEMCARGA', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=700,height=180,left=250,top=100','_blank'); void(0);
            }
            
            function  confirmacarga(event)
            { var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            if (tecla==13) 
            { var answer = confirm("Confirma inclusão da carga?")
              if (answer)
              {apex.submit('CREATE');}}}
            
            
            function fnc_popup_correcao(pitem)
            {
              window.open( 'f?p=&APP_ID.:143:&SESSION.::NO::P143_IDCORRECAOCARGAREPRES,P143_IDITEMCARGAREPRES:,'+pitem, 'CORRECAO', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=400,left=250,top=100','_blank'); void(0);
            }
            
            ```
