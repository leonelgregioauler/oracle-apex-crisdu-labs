            action: redirectThisApp
            target: {
                page: 14
                items: {
                    P14_CARGAAMAIS: S
                    P14_IDCARGAREPRESENTANTE: &P13_IDCARGAREPRESENTANTE.
                    P14_IDITEMCARGAREPRES:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                -- (NEW)11266459 - Maicon Aimi - 10/10/2025
                select 1
                  from roman.cargasrepresentantes c
                 where c.idcargarepresentante = :P13_IDCARGAREPRESENTANTE
                   and roman.pck_estoque.fnc_verificadispcargamais(:P13_IDCARGAREPRESENTANTE) = 'S' 
                   and c.situacao != 0
                   and nvl(c.dtemite,'N') = 'N'
                   and :P0_ESTOQUECONGELADO = 'N'
                
                union
                
                -- libera usuários fixos
                select 1
                  from dual
                 where v('APP_USER') in ('FERNANDO')
                
                union
                
                -- libera time T.I
                select 1
                  from roman.usuariosgruposatendimento g
                 where g.idgrupoatendimento = 0
                   and g.usuario = v('APP_USER')
                
                /*
                -- (OLD)11266459 - Maicon Aimi - 10/10/2025
                select 1
                from dual
                where ( v('APP_USER') in ('FERNANDO','THIAGOSOUZA')
                   or pck_estoque.fnc_verificadispcargamais(:P13_IDCARGAREPRESENTANTE) = 'S' )
                  and :P13_SITUACAO != 0
                  and :P0_ESTOQUECONGELADO = 'N'
                  and nvl(:P13_DTEMITE,'N') = 'N'
                
                  */
                ```
        }
    )

