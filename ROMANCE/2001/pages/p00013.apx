                ```sql
                select 1
                from dual
                where :P13_IDCARGAREPRESENTANTE is not null
                  and :P13_SITUACAO in (1,2)
                  and not exists ( select 1
                                   from usuariosgruposatendimento ug
                                   where ug.usuario = v('APP_USER')
                                     and ug.idgrupoatendimento in (0,1) )
                union
                select 1
                from dual
                where :P13_IDCARGAREPRESENTANTE is not null
                  and :P13_SITUACAO in (1,2,3)
                  and exists ( select 1
                               from usuariosgruposatendimento ug
                               where ug.usuario = v('APP_USER')
                                 and ug.idgrupoatendimento in (0,1) )
                ```
