    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P13_IDCARGAREPRESENTANTE is null then
                        select "SEQ_IDCARGAREPRES".nextval
                          into :P13_IDCARGAREPRESENTANTE
                          from dual;
                       BEGIN
                         select idregiaovenda
                         into :P13_IDREGIAOVENDA
                         from regioesrepresentantes
                         where idrepresentante = :P13_IDREPRESENTANTE
                           and semana          = :P13_SEMANA;
                       exception
                         when others then
                           null;
                       end;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 28388111320111101
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process integrar-dtemite (
        name: Integrar_dtemite
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  v_retorno varchar2(1000);
                  v_existe  number;
                begin
                  --
                  begin
                    --
                    select 1
                      into v_existe
                      from roman.mei 
                     where idpessoa = (select idpessoa
                                         from representantes 
                                        where idrepresentante = :P13_IDREPRESENTANTE);
                  exception
                    when no_data_found then 
                      apex_error.add_error ( p_message          => 'DISTRIBUIDOR NAO TEM MEI CADASTRADO!',
                                             p_display_location => APEX_ERROR.C_INLINE_IN_NOTIFICATION );  
                  --
                  end;
                  --
                  if nvl(v_existe,0) = 1 then
                
                    pck_integracao_ecommerceva.prc_dtemite_guiadespacho(p_idcarga  => :P13_IDCARGAREPRESENTANTE,
                                                                        p_mensagem => v_retorno);
                    commit;
                    --
                    if substr(v_retorno,1,12) = 'Ocorreu erro' then
                      apex_error.add_error ( p_message          => v_retorno,
                                             p_display_location => APEX_ERROR.C_INLINE_IN_NOTIFICATION
                                           );  
                    else
                      apex_application.g_print_success_message := TRIM (v_retorno);
                    end if;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 130
        }
        advanced {
            executionMappingIdentifier: 1075505057047812338
        }
        serverSideCondition {
            type: request=Value
            value: INTEGRAR_DTEMITE
        }
    )

    process libera-correção (
        name: Libera Correção
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  IF :P13_NUMEROEVENTO IS NULL THEN
                    APEX_ERROR.ADD_ERROR( p_message => 'Obrigatório informar numero do evento para liberar correção!',
                                          p_display_location => apex_error.c_inline_in_notification);
                  ELSE
                    update cargasrepresentantes c
                       set c.dataconclusao = sysdate
                         , c.usuarioultimaalteracao  = v('APP_USER')
                         , c.dataultimaalteracao     = sysdate
                     where idcargarepresentante = :P13_IDCARGAREPRESENTANTE;
                      --
                    insert into correcoescargas(idcorrecaocarga,datacorrecao,usuario,motivo,idcargarepresentante)
                    values (seq_idcorrecaocargarepres.nextval,sysdate,'OPTIMUS','Carga liberada para realizar Correção - Evento '||:P13_NUMEROEVENTO,:P13_IDCARGAREPRESENTANTE);
                      --
                  END IF;
                end;
                
                
                ```
        }
        execution {
            sequence: 110
        }
        advanced {
            executionMappingIdentifier: 35175999872148449
        }
        serverSideCondition {
            whenButtonPressed: @confirmacorrecao
        }
    )

