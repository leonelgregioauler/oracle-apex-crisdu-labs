    region itens-carga-a-mais (
        name: Itens Carga a Mais
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDITEMCARGAREPRES
                     , IDITEMCARGAREPRES IDITEMCARGAREPRESdisplay
                     , IDCARGAREPRESENTANTE
                     , null
                     , ( select codigosisdist from produtos p where p.idproduto = E.IDPRODUTO) CODIGO
                     , (select initcap(p.nomeproduto) from produtos p where idproduto = ( select idproduto from estoquefilial e where e.idestoquefilial = e.IDESTOQUEFIL)) PRODUTO
                     , QUANTIDADE
                     , decode(comissao,'S','Sim','Não')  comissao
                     , VALORVENDA
                     , decode(CARGAAMAIS,'S','Sim','Não') CARGAAMAIS
                     --         
                     , qtd_dist_pp
                     , qtd_dist_p
                     , qtd_dist_m
                     , qtd_dist_g
                     , qtd_dist_gg
                     , qtd_dist_egg
                     , qtd_dist_exgg
                     , qtd_dist_u
                     --                  
                     , case 
                         when e.estoquemovto = 'D' then
                           'Distribuição'
                         when e.estoquemovto = 'P' then
                           pck_romance.fnc_nomepostoavancado(idpostoavancado)
                         when e.estoquemovto = 'R' then
                           'Reembalagem'
                       else 
                         ' - '
                       end estoquemovimentado
                     , ( nvl(qtd_dist_pp ,0) 
                       + nvl(qtd_dist_p ,0)  
                       + nvl(qtd_dist_m ,0)  
                       + nvl(qtd_dist_g ,0)
                       + nvl(qtd_dist_gg,0)  
                       + nvl(qtd_dist_egg,0) 
                       + nvl(qtd_dist_exgg,0) 
                       + nvl(qtd_dist_u,0)) "Qtd Total"
                    ,  (nvl(qtd_dist_pp ,0) 
                       + nvl(qtd_dist_p ,0)  
                       + nvl(qtd_dist_m ,0)  
                       + nvl(qtd_dist_g ,0)
                       + nvl(qtd_dist_gg,0)  
                       + nvl(qtd_dist_egg,0) 
                       + nvl(qtd_dist_exgg,0) 
                       + nvl(qtd_dist_u,0)) * e.valorvenda "Total"
                from ITENSCARGAREPRESENTANTE E
                Where idcargarepresentante = :P13_IDCARGAREPRESENTANTE
                  and e.cargaamais = 'S'
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P13_IDCARGAREPRESENTANTE
        }
        readOnly {
            type: item=value
            item: P13_SITUACAO
            value: 3
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--staticRowColors
                t-Report--rowHighlightOff
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Não há produtos carga + na carga.
        }
        componentAdvanced {
            stripHtml: true
        }

