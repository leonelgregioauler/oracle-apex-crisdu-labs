    validation valida-quantidade (
        name: Valida Quantidade
        execution {
            sequence: 90
        }
        validation {
            editableRegion: @itens-da-carga
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(:QTD_DIST_PP) >= 0
                  or to_number(:QTD_DIST_P) >= 0
                  or to_number(:QTD_DIST_M) >= 0
                  or to_number(:QTD_DIST_G) >= 0
                  or to_number(:QTD_DIST_GG) >= 0
                  or to_number(:QTD_DIST_EGG) >= 0
                  or to_number(:QTD_DIST_EXGG) >= 0
                  or to_number(:QTD_DIST_U) >= 0
                ```
        }
        error {
            errorMessage: Informe uma quantidade válida
        }
        serverSideCondition {
            executionScope: allSubmittedRows
        }
    )

