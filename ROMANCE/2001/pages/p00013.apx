    region ações-especiais (
        name: Ações Especiais
        type: staticContent
        layout {
            sequence: 20
            slot: rightSideColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('APP_USER') in ('GUILHERME','FERNANDO','THIAGOSOUZA','JACKSONM')
                ```
        }
    )

    region cancelamento (
        name: Cancelamento
        type: staticContent
        layout {
            sequence: 30
            slot: rightSideColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P13_IDCARGAREPRESENTANTE is not null
                  and :P13_SITUACAO in (1,2)
                  and not exists ( select 1
                                   from usuariosgruposatendimento ug
                                   where ug.usuario = v('APP_USER')
                                     and ug.idgrupoatendimento in (0,1) )
                union
                select 1
                from dual
                where :P13_IDCARGAREPRESENTANTE is not null
                  and :P13_SITUACAO in (1,2,3)
                  and exists ( select 1
                               from usuariosgruposatendimento ug
                               where ug.usuario = v('APP_USER')
                                 and ug.idgrupoatendimento in (0,1) )
                ```
        }
    )

