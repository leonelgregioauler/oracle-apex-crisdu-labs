    process atualiza (
        name: Atualiza
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                update itenscargarepresentante i
                set i.valorvenda =  ( select e.vlrvenda
                                      from estoquefilial e
                                      where e.idestoquefilial = i.idestoquefil )
                where nvl(i.valorvenda,0) = 0
                  and i.idcargarepresentante = :P13_IDCARGAREPRESENTANTE;
                end;
                ```
        }
        execution {
            sequence: 80
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 28387728249111101
        }
        serverSideCondition {
            type: never
        }
    )

    process atualiza-carga (
        name: Atualiza Carga
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update cargasrepresentantes c
                  set ( c.totaldistribuido 
                      , c.totalsugerido ) = ( select sum(( nvl(qtd_dist_pp,0)
                                                         + nvl(qtd_dist_p,0)
                                                         + nvl(qtd_dist_m,0)
                                                         + nvl(qtd_dist_g,0)
                                                         + nvl(qtd_dist_gg,0)
                                                         + nvl(qtd_dist_egg,0)
                                                         + nvl(qtd_dist_exgg,0)
                                                         + nvl(qtd_dist_u,0) )) distribuido
                                                   , sum(( nvl(qtd_pp_sugerida,0)
                                                         + nvl(qtd_p_sugerida,0)
                                                         + nvl(qtd_m_sugerida,0)
                                                         + nvl(qtd_g_sugerida,0)
                                                         + nvl(qtd_gg_sugerida,0)
                                                         + nvl(qtd_egg_sugerida,0)
                                                         + nvl(qtd_exgg_sugerida,0)
                                                         + nvl(qtd_u_sugerida,0) )) sugerido
                                              from itenscargarepresentante ic
                                              where ic.idcargarepresentante = c.idcargarepresentante
                                                and ic.cargaamais = 'N' )
                  where c.idcargarepresentante = :P13_IDCARGAREPRESENTANTE;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 90
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 4800950205039773026
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P13_IDCARGAREPRESENTANTE
        }
    )

