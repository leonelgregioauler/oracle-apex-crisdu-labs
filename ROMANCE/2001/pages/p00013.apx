    button inclui-item-2 (
        buttonName: INCLUI_ITEM2
        label: Incluir Produto +
        layout {
            sequence: 60
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
                t-Button--stretch
            ]
        }
