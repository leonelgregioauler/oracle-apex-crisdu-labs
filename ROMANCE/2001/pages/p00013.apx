        column LINK$01 (
            reportColumnQueryId: 21
            derivedColumn: Y
            type: link
            heading {
                heading: Corrigir Distribuição
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            link {
                target: {
                    page: 143
                    items: {
                        P143_IDITEMCARGAREPRES: #IDITEMCARGAREPRES#
                        P143_IDCORRECAOCARGAREPRES:
                        P143_QTD_DIST_PP: #QTD_DIST_PP#
                        P143_QTD_DIST_P: #QTD_DIST_P#
                        P143_QTD_DIST_M: #QTD_DIST_M#
                        P143_QTD_DIST_G: #QTD_DIST_G#
                        P143_QTD_DIST_GG: #QTD_DIST_GG#
                        P143_QTD_DIST_EGG: #QTD_DIST_EGG#
                        P143_QTD_DIST_EXGG: #QTD_DIST_EXGG#
                        P143_QTD_DIST_U: #QTD_DIST_U#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#e2.gif" alt="">
            }
            exportPrinting {
                printWidth: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from dual
                    where :P13_SITUACAO = 3
                      --and trunc(sysdate) - trunc(to_date(:P13_DATACONCLUSAO,'dd/mm/rrrr hh24:mi:ss')) <= 2
                      and exists ( select 1
                                   from correcoescargas c
                                   where c.idcargarepresentante = :P13_IDCARGAREPRESENTANTE 
                                     and trunc(sysdate) - trunc(datacorrecao) <= 1
                                     and ( usuario = 'OPTIMUS' 
                                         or usuario = v('APP_USER') ) )
                      and :P0_ESTOQUECONGELADO = 'N'
                    ```
            }
            security {
                escapeSpecialChars: false
            }
        )

