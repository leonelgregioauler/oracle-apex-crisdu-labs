    dynamicAction integrar-dtemite (
        name: Integrar_DTEMITE
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @integrar-dtemite
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma integrar DTEMITE? &P13_IDREPRESENTANTE.
                style: warning
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P13_URL_GUIA
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @opções
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: INTEGRAR_DTEMITE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction valida (
        name: Valida
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @save-2
        }

        action confirm (
            name: Confirm
            action: confirm
            settings {
                title: Atenção
                message: Você realmente deseja concluir?
                style: warning
                confirmLabel: Sim
                cancelLabel: Não
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SAVE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation p13-idrepresentante (
        name: P13_IDREPRESENTANTE
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P13_IDREPRESENTANTE
        }
        error {
            errorMessage: Representante deve ser informado!
            associatedItem: @P13_IDREPRESENTANTE
        }
    )

    validation p13-semana (
        name: P13_SEMANA
        execution {
            sequence: 50
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_idsemana(:P13_SEMANA) is not null
                  and :P13_SEMANA like '%'||trim(to_char(sysdate,'RRRR'))||'%'
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: #LABEL# deve ser informada corretamente!
            associatedItem: @P13_SEMANA
        }
        serverSideCondition {
            type: never
        }
    )

    validation valida-carga-duplicada (
        name: valida Carga duplicada
        execution {
            sequence: 40
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from cargasrepresentantes c
                where c.idrepresentante = :P13_IDREPRESENTANTE
                  and c.semana          = :P13_SEMANA
                  and c.situacao       != 0
                  and c.idrepresentante != 2202
                ```
        }
        error {
            errorMessage: Já existe uma carga para este representante na semana informada!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: request=Value
            value: CREATE
        }
    )

    validation valida-carga-sem-distribuição (
        name: Valida carga sem distribuição!
        execution {
            sequence: 60
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from itenscargarepresentante i
                where (nvl(i.qtd_dist_pp ,0) > 0
                   or nvl(i.qtd_dist_p ,0) > 0
                   or nvl(i.qtd_dist_m ,0) > 0
                   or nvl(i.qtd_dist_g ,0) > 0
                   or nvl(i.qtd_dist_gg ,0) > 0
                   or nvl(i.qtd_dist_egg ,0) > 0
                   or nvl(i.qtd_dist_exgg ,0) > 0
                   or nvl(i.qtd_dist_u ,0) > 0)
                  and i.idcargarepresentante = :P13_IDCARGAREPRESENTANTE
                ```
        }
        error {
            errorMessage: Não é possível concluir a carga sem distribuição!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @save-2
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_number(:P13_SITUACAO) + 1 = 3
                ```
        }
    )

    validation valida-distribuição-estoque-negativo-distribuicao (
        name: Valida distribuição estoque negativo DISTRIBUICAO
        execution {
            sequence: 70
        }
        validation {
            editableRegion: @itens-da-carga
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where (nvl(:QTD_PP ,0)   > pck_estoque.fnc_estoquedisponivel(pidestoquefil => :IDESTOQUEFIL,ptamanho => 'PP') 
                    or nvl(:QTD_P ,0)    > pck_estoque.fnc_estoquedisponivel(pidestoquefil => :IDESTOQUEFIL,ptamanho => 'P')    
                    or nvl(:QTD_M ,0)    > pck_estoque.fnc_estoquedisponivel(pidestoquefil => :IDESTOQUEFIL,ptamanho => 'M') 
                    or nvl(:QTD_G ,0)    > pck_estoque.fnc_estoquedisponivel(pidestoquefil => :IDESTOQUEFIL,ptamanho => 'G') 
                    or nvl(:QTD_GG ,0)   > pck_estoque.fnc_estoquedisponivel(pidestoquefil => :IDESTOQUEFIL,ptamanho => 'GG') 
                    or nvl(:QTD_EGG ,0)  > pck_estoque.fnc_estoquedisponivel(pidestoquefil => :IDESTOQUEFIL,ptamanho => 'EGG') 
                    or nvl(:QTD_EXGG ,0) > pck_estoque.fnc_estoquedisponivel(pidestoquefil => :IDESTOQUEFIL,ptamanho => 'EXGG') 
                    or nvl(:QTD_U ,0)    > pck_estoque.fnc_estoquedisponivel(pidestoquefil => :IDESTOQUEFIL,ptamanho => 'U') )
                ```
        }
        error {
            errorMessage: Quantidade da carga não pode ser maior que a quantidade em estoque de distribuição!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @save
            executionScope: allSubmittedRows
            type: never
        }
    )

    validation valida-estoque-disponivel-postoavancado (
        name: valida estoque disponivel POSTOAVANCADO
        execution {
            sequence: 80
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from itenscargarepresentante i
                where nvl(i.qtd_dist_u ,0)  > ( select nvl(ee.qtd_u ,0)-pck_estoque.fnc_estoquereserva_pa(pidestoquefil => i.idestoquefil,ptamanho => 'U',pidpostoavancado => ee.idpostoavancado)
                                                from estoquepostoavancado ee 
                                                where ee.idestoquefil    = i.idestoquefil 
                                                  and ee.idpostoavancado = i.idpostoavancado )
                  and i.idcargarepresentante = :P13_IDCARGAREPRESENTANTE
                  and i.estoquemovto = 'P'
                ```
        }
        error {
            errorMessage: Quantidade da carga não pode ser maior que a quantidade em estoque de Posto Avançado!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @save-2
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_number(:P13_SITUACAO) + 1 = 3
                  and :P0_IDFILIAL in (121,1063,1079,401,1041)
                  and 1 =2
                ```
        }
    )

