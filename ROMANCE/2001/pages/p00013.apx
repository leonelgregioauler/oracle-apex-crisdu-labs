    pageItem P13_IDREGIAOVENDANOVA (
        type: popupLov
        label {
            label: Região de Venda Nova
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(r.idregiaovenda) display_value
                     , r.idregiaovenda return_value
                from regioesvenda r
                where exists ( select 1
                               from filiaisregioesvenda f
                               where f.idfilial = :P0_IDFILIAL
                                 and f.idestado = r.idestado )
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @alterar-região
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P13_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' - '||r.idrepresentante display_value
                     , r.idrepresentante
                from pessoas p
                   , representantes r
                where p.idpessoa   = r.idpessoa
                  and r.ativo      = 'S'
                  and r.idgerente = ( select idgerente
                					  from gerentes
                					  where idfilial = :P0_IDFILIAL )
                order by 1 
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o Representante -
        }
        cascadingLov {
            parentItems: P13_IDFILIAL
        }
        layout {
            sequence: 70
            region: @carga-clientes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P13_IDCARGAREPRESENTANTE
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P13_MONTADAPOR (
        type: selectList
        label {
            label: Montada Por
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomepessoa(f.idpessoa) nome
                     , f.identificacao
                from funcionarios f
                where f.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                  and f.idcargo in (0,7)
                  and f.ativo     = 'S' 
                  and f.identificacao is not null
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @carga-clientes
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: MONTADAPOR
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P13_MONTADAPOR
        }
        security {
            encryptSessionState: false
        }
    )

