    button confirmar-valores (
        buttonName: CONFIRMAR_VALORES
        label: Confirmar Valores
        layout {
            sequence: 20
            region: @negociação-de-parceiro
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from pagamentosnegociacoesparceiros pg
                         where pg.idnegociacaoparceiro = :P562_IDNEGOCIACAOPARCEIRO
                           and nvl(pg.baixarealizada,'N') = 'N' )
                ```
        }
    )

    button remover-negociacao (
        buttonName: REMOVER_NEGOCIACAO
        label: Remover Negociação
        layout {
            sequence: 10
            region: @negociação-de-parceiro
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P562_IDNEGOCIACAOPARCEIRO is not null and v('APP_USER') in ('GUILHERME','BRUNOB','RICIERYS','DARLANSANTOS')
        }
    )

    button ver-comprovantes (
        buttonName: VER_COMPROVANTES
        label: Ver Comprovantes
        layout {
            sequence: 30
            region: @negociação-de-parceiro
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 566
                items: {
                    P566_IDNEGOCIACAOPARCEIRO: &P562_IDNEGOCIACAOPARCEIRO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P562_FORMAPAGAMENTO = 'D' and exists ( select 1
                                                        from DEPOSITOSNEGOCIACOESPARC dp
                                                        where dp.idnegociacaoparceiro = :P562_IDNEGOCIACAOPARCEIRO )
                ```
        }
    )

    process confirma-valor-recebido (
        name: Confirma Valor Recebido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_negociacoes_rmc.prc_realizabaixapagamento(pidnegociacaoparceiro => :P562_IDNEGOCIACAOPARCEIRO);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Valores confirmados com sucesso!
        }
        advanced {
            executionMappingIdentifier: 29214646389076523
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR_VALORES
        }
    )

    process consulta-em-negociações-parceiros (
        name: Consulta em Negociações Parceiros
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalor number;
                  vdata  date;
                  vdatalimite date;
                  vvalorabat number;
                  vvalorjuros  number;
                begin
                  --
                  pck_negociacoes_rmc.prc_negociacoesparceiros(pidnegociacaoparceiro => :P562_IDNEGOCIACAOPARCEIRO,
                                                               pidvendedora => :P562_IDVENDEDORA,
                                                               pdatanegociacao => vdata,
                                                               pvalornegociacao => vvalor,
                                                               pformapagamento => :P562_FORMAPAGAMENTO,
                                                               ptid => :P562_TID,
                                                               pnsu => :P562_NSU,
                                                               pqtdparcelas => :P562_QTDPARCELAS,
                                                               parquivoenvio_operadora => null,
                                                               parquivoretorno_operadora => null,
                                                               pdatalimitedeposito => vdatalimite,
                                                               pidcontabancaria => :P562_IDCONTABANCARIA,
                                                               pvalorabatido => vvalorabat,
                                                               pvalorjuros => vvalorjuros,
                                                               pmd5 => :P562_MD5,
                                                               poperacao_dml => 'S');
                  --
                  :P562_DATANEGOCIACAO     := to_char(vdata,'DD/MM/RRRR HH24:MI:SS'); 
                  :P562_DATALIMITEDEPOSITO := to_char(vdatalimite,'DD/MM/RRRR'); 
                  :P562_VALORNEGOCIACAO    := to_char(vvalor,'999G999G999G999G990D00');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 29213576364076512
        }
    )

    process remover-negociação (
        name: "Remover negociação "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdatanegociacao date;
                  vvalor number;
                  vvforma varchar2(1);
                  vtid varchar2(100);
                  vnsu varchar2(100);
                  vqtdparcelas number;
                  vvalorabat number;
                  vvalorjuros number;
                  
                begin
                  -- 
                  pck_negociacoes_rmc.prc_negociacoesparceiros(pidnegociacaoparceiro => :P562_IDNEGOCIACAOPARCEIRO,
                                                               pidvendedora => :P562_IDVENDEDORA,
                                                               pdatanegociacao => :pdatanegociacao,
                                                               pvalornegociacao => :pvalornegociacao,
                                                               pformapagamento => :pformapagamento,
                                                               ptid => :ptid,
                                                               pnsu => :pnsu,
                                                               pqtdparcelas => :pqtdparcelas,
                                                               parquivoenvio_operadora => null,
                                                               parquivoretorno_operadora => null,
                                                               pdatalimitedeposito => :pdatalimitedeposito,
                                                               pidcontabancaria => :pidcontabancaria,
                                                               pvalorabatido => vvalorabat,
                                                               pvalorjuros => vvalorjuros,
                                                               pmd5 => :pmd5,
                                                               poperacao_dml => 'D');
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Removida com sucesso!
        }
        advanced {
            executionMappingIdentifier: 4509696112266037511
        }
        serverSideCondition {
            whenButtonPressed: @remover-negociacao
        }
    )

    branch (
        name: Go To Page 562
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 562
                items: {
                    P562_IDEDITAR:
                    P562_IDNEGOCIACAOPARCEIRO: &P562_IDNEGOCIACAOPARCEIRO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request!=Value
            value: REMOVER_NEGOCIACAO
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 561
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @remover-negociacao
        }
    )

)

