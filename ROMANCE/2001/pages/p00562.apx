    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_quitar(pid)
            {
              document.getElementById("P562_IDEDITAR").value = pid;
              apex.submit('QUITAR');
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region débito-s-que-foi-utilizado-valores (
        name: Débito(s) que foi utilizado valores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.tipo
                     , d.numeronota
                     , d.valorapagar
                     , d.databaixa
                from vw_detalhes_negociacoes d
                where d.idnegociacaoparceiro = :P562_IDNEGOCIACAOPARCEIRO
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: "Nenhum valor utilizado! "
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 4904221045797652904
        }

