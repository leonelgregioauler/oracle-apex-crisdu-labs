page 547 (
    name: Incluir Etiqueta de Contgem
    title: Incluir Etiqueta de Contgem
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function mudacampo()
            { 
              campo = document.getElementById('P547_CODIGO');
              var length = campo.value.length;
              if (eval(campo.value.length) == "5")
               {
                 document.getElementById('P547_QUANTIDADE').focus();
               }
            }
            
            function mudacampo_t()
            { 
              campo = document.getElementById('P547_TAMANHO');
              var length = campo.value.length;
              if (eval(campo.value.length) == "1")
               {
                 document.getElementById('P547_CODIGO').focus();
               }
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region incluir-etiqueta-de-contgem (
        name: Incluir Etiqueta de Contgem
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P547_CODIGO (
        type: numberField
        label {
            label: Código Produto
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @incluir-etiqueta-de-contgem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        advanced {
            customAttributes: onkeyup ='mudacampo();'
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P547_IDNOTAFISCAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @incluir-etiqueta-de-contgem
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P547_PRODUTO_DESC (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomeproduto
                     , idproduto
                from produtos p
                where p.codigosisdist = :P547_CODIGO
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P547_CODIGO
        }
        layout {
            sequence: 60
            region: @incluir-etiqueta-de-contgem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P547_QUANTIDADE (
        type: numberField
        label {
            label: Quantidade
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 70
            region: @incluir-etiqueta-de-contgem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P547_RETORNO (
        type: displayOnly
        label {
            label: Retorno
            alignment: left
        }
        layout {
            sequence: 80
            region: @incluir-etiqueta-de-contgem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P547_TAMANHO (
        type: numberField
        label {
            label: Tamanho
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @incluir-etiqueta-de-contgem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        advanced {
            customAttributes: onkeyup ='mudacampo_t();'
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P547_TAMANHO_DESC (
        type: selectList
        label {
            label: Descrição do Tamanho
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.tamanho
                     , t.numero
                from tamanhos t
                where t.numero = :P547_TAMANHO
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P547_TAMANHO
        }
        layout {
            sequence: 40
            region: @incluir-etiqueta-de-contgem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P547_USUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @incluir-etiqueta-de-contgem
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: v('APP_USER')
        }
        security {
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 10
            region: @incluir-etiqueta-de-contgem
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 25
                items: {
                    P25_IDNOTAFISCAL: &P547_IDNOTAFISCAL.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Incluir Etiqueta
        layout {
            sequence: 20
            region: @incluir-etiqueta-de-contgem
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction posiciona-cursor (
        name: Posiciona Cursor
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P547_TAMANHO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction pula-para-quantidade (
        name: Pula para quantidade
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P547_CODIGO
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P547_CODIGO
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P547_QUANTIDADE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction pula-proximo-campo (
        name: Pula proximo campo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P547_TAMANHO
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P547_TAMANHO
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P547_CODIGO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P547_TAMANHO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P547_TAMANHO_DESC
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-codigo (
        name: Valida Codigo
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNumeric
            item: P547_CODIGO
        }
        error {
            errorMessage: Somente permitido números!
            associatedItem: @P547_CODIGO
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation valida-quantidade (
        name: Valida Quantidade
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNumeric
            item: P547_QUANTIDADE
        }
        error {
            errorMessage: Somente permitido números!
            associatedItem: @P547_QUANTIDADE
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation valida-tamanho (
        name: Valida Tamanho
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNumeric
            item: P547_TAMANHO
        }
        error {
            errorMessage: Somente permitido números!
            associatedItem: @P547_TAMANHO
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process processo-dml-em-etiqueta-manual (
        name: Processo DML em Etiqueta Manual
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vretorno varchar2(1000);
                begin
                  --
                  PCK_ESTOQUE_V2.PRC_ETIQUETAMANUALRECEBIMENTO( PIDNOTAFISCAL => :P547_IDNOTAFISCAL,
                                                                PUSUARIO => :P547_USUARIO,
                                                                PTAMANHO => :P547_TAMANHO,
                                                                PCODIGO => :P547_CODIGO,
                                                                PQUANTIDADE => :P547_QUANTIDADE,
                                                                PRETORNO => vretorno);
                  --
                  :P547_RETORNO := vretorno;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Etiqueta incluída com sucesso!
        }
        advanced {
            executionMappingIdentifier: 17996058531906493
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process valida-produto-previsto (
        name: Valida Produto previsto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  v_verifica number := 0;
                  --
                begin
                --
                if :P547_CODIGO is not null and :P547_IDNOTAFISCAL is not null then
                  --
                  select  1
                    into v_verifica
                    from produtos p
                   where p.codigosisdist = :P547_CODIGO
                     and exists( select 1
                                   from roman.itemnf i
                                  where i.idnotafiscal = :P547_IDNOTAFISCAL
                                    and i.idproduto = p.idproduto );
                  --
                  /*if v_verifica > 0 then
                    raise_application_error(-20001,'Atenção!!! Item não previsto na Nota. Verifique o codigo digitado.');
                  end if;*/
                  --
                end if;
                --
                exception when no_data_found then
                    raise_application_error(-20001,'Atenção!!! Item não previsto na Nota. Verifique o codigo digitado.');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 25007453422374438
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 485
                items: {
                    P485_IDNOTAFISCAL: &P547_IDNOTAFISCAL.
                    P485_RETORNO:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

)

