    button anexar-documento (
        buttonName: ANEXAR_DOCUMENTO
        label: Anexar Documento
        layout {
            sequence: 10
            region: @negociação-realizada
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 653
                items: {
                    P653_IDANEXODELETAR:
                    P653_IDANEXONEGOCIACAO:
                    P653_IDNEGOCIACAO: &P650_IDNEGOCIACAOPARCEIRO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: Remover Negociação
        layout {
            sequence: 30
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                  where :P650_IDNEGOCIACAOPARCEIRO is not null
                    and favorita.pck_util_fav.fnc_verificagrupoatendimento(73, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'N' -- 73 Prevenção de Perdas
                ```
        }
    )

    button negociacao-cruzeiro (
        buttonName: NEGOCIACAO_CRUZEIRO
        label: Negociação para o Cruzeiro
        layout {
            sequence: 20
            region: @negociação-realizada
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                not exists ( select 1
                             from classificacoesnegociacoesparc c
                             where c.idcaracteristicanegociacao = 5
                               and c.idnegociacaoparceiro = :P650_IDNEGOCIACAOPARCEIRO )
                ```
        }
    )

