            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' CPF: '||p.cpf nomeconsultora
                from catal.vendedoras v
                   , catal.pessoas p
                where p.idpessoa = v.idpessoa
                  and v.idvendedora = :P650_IDVENDEDORA
                  and exists ( select 1
                               from roman.negociacoesparceiros np
                               where np.idvendedora = v.idvendedora
                                 and np.idnegociacaoparceiro = :P650_IDNEGOCIACAOPARCEIRO )
                ```
        }
        readOnly {
            type: always
