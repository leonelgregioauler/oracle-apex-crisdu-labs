page 650 (
    name: Negociação de Perdas
    title: Negociação de Perdas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 70%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_quitar(pid)
            {
              document.getElementById("P650_IDEDITAR").value = pid;
              apex.submit('QUITAR');
            }
            
            function fnc_emespera(pid)
            {
              document.getElementById("P650_IDEDITAR").value = pid;
              apex.submit('EMESPERA');
            }
            
            function fnc_vencido(pid)
            {
              document.getElementById("P650_IDEDITAR").value = pid;
              apex.submit('VENCIDO');
            }
            
            function fnc_remover(pid)
            {
              document.getElementById("P650_IDREMOVER").value = pid;
              apex.submit('REMOVER');
            }
            
            function imprimeboleto(vidpagamento,vidvendedora)
            {   
              vurl = 'https://boleto.romancemoda.com.br/caixa/boleto.php?cod1='+vidpagamento+'&cod2='+vidvendedora;
              pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            
            function imprimeboleto_bb(vidpagamento,vidvendedora)
            {   
              vurl = 'https://boleto.romancemoda.com.br/bb/boleto_qrcode.php?cod1='+vidpagamento+'&cod2='+vidvendedora;
              pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region classificações-da-negociação (
        name: Classificações da Negociação
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idclassificacaonegociacaoparc
                     , c.idcaracteristicanegociacao
                     , cc.descricao classificacao
                     , c.idnegociacaoparceiro
                     , c.dataclassificacao
                     , c.idusuario
                     , ( select initcap(p.nomepessoa)
                         from pessoas p
                            , usuarios u
                         where u.idpessoa = p.idpessoa
                           and u.idusuario = c.idusuario ) usuario
                     , c.observacao
                     , '<a href="javascript: fnc_remover('||idclassificacaonegociacaoparc||');">Remover</a>' remover
                from classificacoesnegociacoesparc c
                   , caracteristicasnegociacoes cc
                where c.idnegociacaoparceiro = :P650_IDNEGOCIACAOPARCEIRO
                  and c.idcaracteristicanegociacao = cc.idcaracteristicanegociacao
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from classificacoesnegociacoesparc c
                   , caracteristicasnegociacoes cc
                where c.idnegociacaoparceiro = :P650_IDNEGOCIACAOPARCEIRO
                  and c.idcaracteristicanegociacao = cc.idcaracteristicanegociacao )
                ```
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 50131486209900642
        }

