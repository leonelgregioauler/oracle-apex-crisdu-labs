    region documentos-sinalizados (
        name: Documentos Sinalizados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select apex_item.CHECKBOX2(2,d.iddocumentonegociacao, null)CHECK1
                     , roman.pck_romance.fnc_nomevendedora(d.idvendedora) vendedora
                     , d.cpf
                     , case
                         when idnotavenda is not null then
                           'Nota Romance'
                         when idpedido is not null then
                           'Pedido Favorita'
                         when iddiverso is not null then 
                           'Débito Diverso'
                       end origem
                     , d.documento 
                     , case
                         when exists ( select 1
                                         from favorita.pedidos p
                                        where p.idvendedora = d.idvendedora
                                          and to_char(p.idpedido) = d.documento
                                          and exists ( select 1
                                                         from roman.pagamentosnegociacoesparceiros pp
                                                        where pp.idnegociacaoparceiro = :P650_IDNEGOCIACAOPARCEIRO
                                                          and pp.situacao             in ('E','Q') ) ) then
                                  favorita.pck_pedidos_fav.fnc_retornacodigoliberacao(to_number(d.documento))
                         else
                           null
                       end codigoliberacao
                     , valor
                     , d.valororiginal 
                     , d.valoratualizado
                     , d.valordesconto
                     , (valoratualizado - d.valororiginal) juros   
                  from roman.documentosnegociacao d
                 where d.idnegociacaoparceiro = :P650_IDNEGOCIACAOPARCEIRO;
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            htmlDomId: partnerslRR
            regionDisplaySelector: true
        }
