    dynamicAction selectunselectall (
        name: selectUnselectAll
        execution {
            sequence: 10
            eventScope: dynamic
            staticContainer: #partnerslRR
        }
        when {
            selectionType: jQuerySelector
            jquerySelector: #selectUnselectAll
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if ( $( '#selectUnselectAll' ).is(':checked')){
                        $('input[type=checkbox][name=f02]').attr('checked',true);
                    }
                    else {
                        $('input[type=checkbox][name=f02]').attr('checked',false);
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process atualiza-parcela-de-negociação (
        name: Atualiza Parcela de Negociação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /*declare
                  --
                  vsituacao   varchar2(1);
                  vidusuario  number;
                  vvalorpago  number;
                  vvalorsaldo number;
                  vidneg      number := :P650_IDNEGOCIACAOPARCEIRO;
                  --
                begin
                  --  
                  select idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  if v('REQUEST') = 'QUITAR' then
                    vsituacao := 'Q';
                  elsif v('REQUEST') = 'EMESPERA' then
                    vsituacao := 'E';
                  elsif v('REQUEST') = 'VENCIDO' then
                    vsituacao := 'V';
                  end if;
                  --
                  roman.pck_gestaoderisco_rmc.PRC_CONFIRMAPAGAMENTO(pidpagamentonegociacao => :P650_IDEDITAR,
                                                                    psituacao              => vsituacao,
                                                                    pidusuario             => vidusuario);
                  --
                  select sum(p.valorparcela) valorpago
                  into vvalorpago
                  from roman.pagamentosnegociacoesparceiros p
                  where p.idnegociacaoparceiro = vidneg
                    and p.situacao  = 'Q'
                    and p.baixarealizada = 'S';
                  --
                  select sum(pp.valorparcela) valorsaldo
                  into vvalorsaldo
                  from roman.pagamentosnegociacoesparceiros pp
                  where pp.idnegociacaoparceiro = vidneg
                    and pp.situacao  = 'A'
                    and pp.baixarealizada is null;
                  --  
                  update roman.negociacoesparceiros np
                  set np.valorpago = vvalorpago
                    , np.saldo = vvalorsaldo
                  where np.idnegociacaoparceiro = vidneg;
                  --
                end;*/
                
                
                declare
                  --
                  vsituacao   varchar2(1);
                  vidusuario  number;
                  vvalorpago  number;
                  vvalorsaldo number;
                  vidneg      number := :P650_IDNEGOCIACAOPARCEIRO;
                  --
                begin
                  --  
                  select idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  if v('REQUEST') = 'QUITAR' then
                    vsituacao := 'Q';
                  elsif v('REQUEST') = 'EMESPERA' then
                    vsituacao := 'E';
                  elsif v('REQUEST') = 'VENCIDO' then
                    vsituacao := 'V';
                  end if;
                  --
                  roman.pck_gestaoderisco_rmc.PRC_CONFIRMAPAGAMENTO(pidpagamentonegociacao => :P650_IDEDITAR,
                                                                    psituacao              => vsituacao,
                                                                    pidusuario             => vidusuario);
                  --
                  if vsituacao = 'Q' then
                    select sum(p.valorparcela) valorpago
                    into vvalorpago
                    from roman.pagamentosnegociacoesparceiros p
                    where p.idnegociacaoparceiro = vidneg
                      and p.situacao  = 'Q'
                      and p.baixarealizada = 'S';
                    --
                    select sum(pp.valorparcela) valorsaldo
                    into vvalorsaldo
                    from roman.pagamentosnegociacoesparceiros pp
                    where pp.idnegociacaoparceiro = vidneg
                      and pp.situacao  = 'A'
                      and pp.baixarealizada is null;
                    --  
                    update roman.negociacoesparceiros np
                    set np.valorpago = vvalorpago
                      , np.saldo = vvalorsaldo
                    where np.idnegociacaoparceiro = vidneg;
                  end if;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Parcela quitada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 33115876147152206
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('QUITAR','EMESPERA','VENCIDO')
        }
    )

    process atualiza-valores-pago (
        name: Atualiza Valores Pago
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update negociacoesparceiros p
                  set p.valorpago = ( select sum(pn.valorparcela)
                                      from pagamentosnegociacoesparceiros pn
                                      where pn.idnegociacaoparceiro = p.idnegociacaoparceiro
                                        and pn.situacao = 'Q' )
                    , p.saldo = p.valornegociacao - nvl(( select sum(pn.valorparcela)
                                                          from pagamentosnegociacoesparceiros pn
                                                          where pn.idnegociacaoparceiro = p.idnegociacaoparceiro
                                                            and pn.situacao = 'Q' ),0 )
                  where p.idnegociacaoparceiro = :P650_IDNEGOCIACAOPARCEIRO;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 2095272199060133812
        }
    )

    process classifica-negociação (
        name: Classifica Negociação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidclassificacaonegociacaoparc number;
                  vidusuario number;
                  vidcaracteristicanegociacao number;
                  vdataclassificacao date := sysdate;
                  vobservacao varchar2(1000);
                  vmd5 varchar2(1000);
                  --
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios 
                  where usuario = v('APP_USER');
                  --
                  if v('REQUEST') = 'NEGOCIACAO_CRUZEIRO' then
                    --
                    vidcaracteristicanegociacao := 5;
                    --
                  elsif v('REQUEST') = 'NEGOCIACAO_DISTRIBUIDOR' then
                    --
                    vidcaracteristicanegociacao := 4;
                    --
                  end if;
                  --
                  pck_cadastros_rmc.prc_classificacoesnegociacoesparc(pidclassificacaonegociacaoparc => vidclassificacaonegociacaoparc,
                                                                      pidcaracteristicanegociacao => vidcaracteristicanegociacao,
                                                                      pidnegociacaoparceiro => :P650_IDNEGOCIACAOPARCEIRO,
                                                                      pdataclassificacao => vdataclassificacao,
                                                                      pidusuario => vidusuario,
                                                                      pobservacao => vobservacao,
                                                                      pmd5 => vmd5,
                                                                      poperacao_dml => 'I');
                end;
                
                ```
        }
        execution {
            sequence: 100
        }
        successMessage {
            successMessage: Negociação classificada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 50131259217900640
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('NEGOCIACAO_CRUZEIRO','NEGOCIACAO_DISTRIBUIDOR')
        }
    )

    process deleta-documento (
        name: "Deleta Documento "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidnegociacao number := :P650_IDNEGOCIACAOPARCEIRO;
                  vcpf          varchar2(30);
                  vdocumento    varchar2(30);
                  vvalor        number;
                  viddocumento number;
                  --
                begin
                  --
                  if APEX_APPLICATION.G_F02.COUNT > 0 then 
                  --
                    FOR i in 1..APEX_APPLICATION.G_F02.COUNT 
                    LOOP
                      --
                      viddocumento := to_number(APEX_APPLICATION.G_F02(i));
                      
                      pck_negociacoes_rmc.prc_documentos_negociacao(pidnegociacao => vidnegociacao,
                                                                    pcpf => vcpf,
                                                                    pdocumento => vdocumento,
                                                                    pvalor => vvalor,
                                                                    piddocumento => viddocumento,
                                                                    poperacao_dml => 'D');
                  
                    end loop;
                    --
                  end if;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 3629676451953515411
        }
        serverSideCondition {
            whenButtonPressed: @remove-doc
        }
    )

