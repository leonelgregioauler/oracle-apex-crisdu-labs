    region itens (
        name: Itens
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select inv.idlog "Id Log"
                     , inv.usuarioalteracao "Usuário Alteração"
                     , decode(inv.tipoalteracao,'INSERT','Inclusão','UPDATE','Alteração','DELETE','Exclusão') "Tipo Alt."
                     , (select p.codigosisdist||' '||initcap(p.nomeproduto) 
                        from estoquefilial e
                           , produtos      p
                       where e.idproduto   = p.idproduto
                         and e.idestoquefilial = inv.idestoquefil) "Produto"
                     , inv.dataalteracao "Data Alteração"
                     , inv.iditemnotavenda "Id Item Nota Venda"
                     , inv.idnotavenda "Id Nota Venda"
                     , nv.numeronota "Número Nota Venda"
                     , inv.idestoquefil "Id Estoque Filial"
                     , inv.comissao "Comissão"
                     , inv.valorvenda "Valor Venda"
                     , inv.quantidade "Quantidade"
                     , inv.qtddevolvida "Quantidade Devolvida"
                     , inv.ultimaalteracao "Última Alteração"
                     , inv.precocusto "Preço Custo"
                     , inv.dataintegracao "Data Integração"
                     , inv.idtablet "Id Tablet"
                     , inv.iditemtablet "Id Item Tablet"
                from roman.notasvendas nv
                   , logroman.log_itensnotavenda inv
                where nv.idnotavenda = inv.idnotavenda
                  and (:P740_IDNOTAVENDA is not null and nv.idnotavenda = :P740_IDNOTAVENDA)
                  and (:P0_IDFILIAL = -1 and nv.IDFILIAL = nv.IDFILIAL-- todos
                   or (:P0_IDFILIAL = -2 and nv.IDFILIAL in (select v.idfilial
                                                               from filiais v
                                                              where v.ididioma = 1)) -- brasil
                   or (:P0_IDFILIAL = -3 and nv.IDFILIAL in (select v.idfilial
                                                               from filiais v
                                                              where v.ididioma <> 1))-- america latina
                   or (:P0_IDFILIAL = nv.IDFILIAL))
                order by 4 asc, 5 asc
                  
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
