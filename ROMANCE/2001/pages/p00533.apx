    pageItem P533_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante)||' ('||decode(r.ativo,'S','Ativo','N','Inativo')||')' diplay_value,
                       r.idrepresentante return_value
                  from catal.representantes r
                 where (    (:P0_IDFILIAL = -1)-- Todos
                         or (:P0_IDFILIAL = -2 and exists (select 1
                                                             from roman.vw_filiais f
                                                            where f.ididioma = 1
                                                              and f.idfilial = r.idfilial))-- Todos Brasil
                         or (:P0_IDFILIAL = -3 and exists (select 1
                                                             from roman.vw_filiais f
                                                            where f.ididioma != 1
                                                              and f.idfilial = r.idfilial))-- Todos fora do brasil
                         or (r.idgerente  in ( select g.idgerente
                                                 from catal.gerentes g
                                                where g.idfilial = :P0_IDFILIAL)))-- Todos da filial selecioanda
                   and r.ativo = 'S'  
                order by 1;
                ```
            nullDisplayValue: - Mostrar Todos -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P533_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano semana
                     , idsemana 
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-2 and to_char(sysdate,'RRRR')
                order by idsemana desc
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

