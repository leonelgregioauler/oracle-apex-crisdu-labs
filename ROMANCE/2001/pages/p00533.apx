page 533 (
    name: Lucratividade de Distribuidores
    title: Lucratividade de Distribuidores
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region lucratividade (
        name: Lucratividade
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select luc.idrepresentante
                     , luc.idsemana
                     , luc.idfilial
                     , pck_util.fnc_semanaid(luc.idsemana) "Semana"
                     , pck_romance.fnc_nomerepresentante(luc.idrepresentante)||' ('||decode(luc.ativo,'S','Ativo','N','Inativo')||')' "Distribuidor"
                     , '|' s0
                     , luc.vendabruto "Valor Vendido"
                     , '-' s1
                     , round((luc.custovendido/luc.fatorconversao),2) "Custo Vendido"
                     , '-' s2
                     , luc.debitos "Inadimplencia"
                     , luc.perc_inad "Perc Inad"
                     , '-' s3      
                     , luc.comissaovend "Com. Consultora"
                     , '-' s4
                     , luc.comissaorepres "Com. Distribuidor"
                     , '=' s5
                     , ( luc.vendabruto
                       - round((luc.custovendido/luc.fatorconversao),2)
                       - luc.debitos
                       - luc.comissaovend
                       - luc.comissaorepres ) "Contribuição"
                     , case
                         when luc.vendabruto > 0 then
                           round(( ( luc.vendabruto
                                   - round((luc.custovendido/luc.fatorconversao),2)
                                   - luc.debitos
                                   - luc.comissaovend
                                   - luc.comissaorepres ) / luc.vendabruto ) * 100,2)
                         else
                           0
                       end "% Contribuição"
                     , '|' s6
                     , round((luc.custodevolvido/luc.fatorconversao),2) "Custo Devolvido"
                     , '=' s7
                     , case
                         when luc.vendabruto > 0 and luc.custodevolvido != 0 then
                           round( ((luc.custovendido / (luc.custovendido+luc.custodevolvido))/luc.fatorconversao)*100,2)
                         else 
                           0
                       end "% Energia Usada"
                     , luc.totalcobrado "Total Cobrado"
                     , luc.totalgeral
                from ( select s.idsemana
                            , r.idrepresentante
                            , r.ativo
                            , g.idfilial
                            , ( select f.fatorconversao
                                from filiais f
                                where f.idfilial = g.idfilial ) fatorconversao
                            , nvl( ( select sum(nv.valortotalvenda)
                                     from notasvendas nv
                                     where nv.idrepresentante     = r.idrepresentante
                                       and nv.idsemanacobranca    = s.idsemana
                                       and nv.idsituacaonotavenda = 4
                                       and nv.idfilial            = g.idfilial ), 0 ) vendabruto
                            , nvl( ( select sum((it.quantidade - it.qtddevolvida)*pck_estoque.fnc_retornaprecocusto(it.idestoquefil))
                                     from itensnotavenda it
                                     where it.idnotavenda in ( select nv.idnotavenda
                                                               from notasvendas nv
                                                               where nv.idrepresentante     = r.idrepresentante
                                                                 and nv.idsemanacobranca    = s.idsemana
                                                                 and nv.idfilial            = g.idfilial
                                                                 and nv.idsituacaonotavenda = 4 )
                                       and it.quantidade - it.qtddevolvida > 0 ), 0 ) custovendido
                            , nvl( ( select sum(nv.saldo)
                                     from notasvendas nv
                                     where nv.idrepresentante     = r.idrepresentante
                                       and nv.idsemanacobranca    = s.idsemana
                                       and nv.idsituacaonotavenda = 4
                                       and nv.idfilial            = g.idfilial ), 0 ) debitos
                            , nvl( ( select sum(nv.valorcomissao)
                                     from notasvendas nv
                                     where nv.idrepresentante     = r.idrepresentante
                                       and nv.idsemanacobranca    = s.idsemana
                                       and nv.idsituacaonotavenda = 4
                                       and nv.idfilial            = g.idfilial ), 0 ) comissaovend
                            , nvl( ( select sum(f.totalcobranca * c.percpromotor / 100)
                                     from fechamentorepresentantes f
                                        , comissoesfiliais c
                                     where f.idrepresentante  = r.idrepresentante
                                       and c.idcomissaofilial = f.idcomissao
                                       and exists ( select 1
                                                    from fechamentossemanais ff
                                                    where ff.idfechamento = f.idfechamentopontuacao
                                                      and ff.idfilial     = g.idfilial
                                                      and ff.idsemana     = s.idsemana ) ), 0 ) comissaorepres
                            , nvl( ( select sum( it.qtddevolvida*pck_estoque.fnc_retornaprecocusto(it.idestoquefil))
                                     from itensnotavenda it
                                     where it.idnotavenda in ( select nv.idnotavenda
                                                               from notasvendas nv
                                                               where nv.idrepresentante     = r.idrepresentante
                                                                 and nv.idsemanacobranca    = s.idsemana
                                                                 and nv.idfilial            = g.idfilial
                                                                 and nv.idsituacaonotavenda = 4 )
                                       and it.qtddevolvida > 0 ), 0 ) custodevolvido
                            , nvl( ( select sum(f.totalcobranca)
                                     from fechamentorepresentantes f
                                        , comissoesfiliais c
                                     where f.idrepresentante  = r.idrepresentante
                                       and c.idcomissaofilial = f.idcomissao
                                       and exists ( select 1
                                                    from fechamentossemanais ff
                                                    where ff.idfechamento = f.idfechamentopontuacao
                                                      and ff.idfilial     = g.idfilial
                                                      and ff.idsemana     = s.idsemana ) ), 0 ) totalcobrado
                            , nvl( ( select sum(f.totalgeral)
                                     from fechamentorepresentantes f
                                        , comissoesfiliais c
                                     where f.idrepresentante  = r.idrepresentante
                                       and c.idcomissaofilial = f.idcomissao
                                       and exists ( select 1
                                                    from fechamentossemanais ff
                                                    where ff.idfechamento = f.idfechamentopontuacao
                                                      and ff.idfilial     = g.idfilial
                                                      and ff.idsemana     = s.idsemana ) ), 0 ) totalgeral
                            ,(select sum(case
                                         when totaldebitosnovos > 0 then
                                           round( ( totaldebitosnovos / ( totalgeral + totaldebitosnovos ) ) * 100, 2)
                                         else
                                           0
                                         end )
                             from fechamentorepresentantes fr
                                , fechamentossemanais   ff
                             where ff.idfechamento    = fr.idfechamento
                               and fr.idrepresentante = r.idrepresentante
                               and trim(ff.semana)    = trim(s.semanacompleta)) perc_inad
                        from semana_dias s
                           , representantes r
                           , gerentes g
                        where r.idgerente = g.idgerente 
                          and r.ativo     = 'S'
                         -- and g.idfilial = :P0_IDFILIAL 
                      and (   ( :P0_IDFILIAL is null)
                               or ( :P0_IDFILIAL != 1135 and g.idfilial  = :P0_IDFILIAL ) 
                               or ( :P0_IDFILIAL  = 1135 and exists (select pc.idfilial
                                                                           from catal.filiais pc --pc->Pertence Comercial
                                                                          where pc.pertencecomercialromance = 'S'
                                                                            and pc.idfilial = g.idfilial )))
                              
                          and :P533_TIPO_RELATORIO = 'D'
                          and ( :P533_IDREPRESENTANTE is null or r.idrepresentante = :P533_IDREPRESENTANTE )
                          and ( :P533_TIPOPERIODO is null
                              or ( :P533_TIPOPERIODO = 'S' and s.idsemana = :P533_IDSEMANA )
                              or ( :P533_TIPOPERIODO = 'P' and s.idsemana between :P533_IDSEMANAINI and :P533_IDSEMANAFIM ) ) ) luc
                order by 2,5
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P533_TIPO_RELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma informação encontrada, verifique os filtros utilizados.
        }
        advanced {
            savedReportMappingIdentifier: 1603198429111180242
        }

