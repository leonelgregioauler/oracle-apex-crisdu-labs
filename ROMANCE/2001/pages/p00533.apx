    region lucratividade-geral-distribuidores (
        name: Lucratividade Geral Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select luc.idrepresentante
                     , pck_romance.fnc_nomerepresentante(idrepresentante) "Distribuidor"
                     , '|' s0
                     , sum(luc.vendabruto) "Valor Vendido"
                     , '-' s1
                     , sum(luc.custovendido/luc.fatorconversao) "Custo Vendido"
                     , '-' s2
                     , sum(luc.debitos) "Inadimplencia"
                     --, round(sum(luc.totdebnovos)/decode(sum(luc.totdebnovosger),0,1,sum(luc.totdebnovosger)) *100,2) "Perc Inad"
                     , case
                         when sum(luc.debitos) > 0 then
                           round( sum( luc.totdebnovos) / sum( luc.totalgeral + luc.totdebnovos  ) * 100, 2)
                         else
                           0
                       end "Perc Inad"
                     , '-' s3      
                     , sum(luc.comissaovend) "Com. Consultora"
                     , '-' s4
                     , sum(luc.comissaorepres) "Com. Distribuidor"
                     , '|' s5
                     , sum(luc.custodevolvido/luc.fatorconversao) "Custo Devolvido"
                     , '=' s6
                     , ( sum(luc.vendabruto)
                       - sum(luc.custovendido/luc.fatorconversao)
                       - sum(luc.debitos)
                       - sum(luc.comissaovend)
                       - sum(luc.comissaorepres) ) "Contribuição"
                     , decode(sum(luc.vendabruto),0,0,(round(( ( sum(luc.vendabruto)
                               - sum(luc.custovendido/luc.fatorconversao)
                               - sum(luc.debitos)
                               - sum(luc.comissaovend)
                               - sum(luc.comissaorepres) ) / sum(luc.vendabruto) ) * 100,2))) "% Contribuição"
                     , sum(luc.totalcobrado) "Total Cobrado"
                     , sum(luc.totalgeral) "Total Geral Cobrado"
                from ( select r.idrepresentante
                            , g.idfilial
                            , ( select f.fatorconversao
                                from filiais f
                                where f.idfilial = g.idfilial ) fatorconversao
                            , nvl( ( select sum(nv.valortotalvenda)
                                     from notasvendas nv
                                     where nv.idrepresentante     = r.idrepresentante
                                       and nv.idsemanacobranca    = s.idsemana
                                       and nv.idsituacaonotavenda = 4
                                       and nv.idfilial            = g.idfilial ), 0 ) vendabruto
                            , nvl( ( select sum((it.quantidade - it.qtddevolvida)*pck_estoque.fnc_retornaprecocusto(it.idestoquefil))
                                     from itensnotavenda it
                                     where it.idnotavenda in ( select nv.idnotavenda
                                                               from notasvendas nv
                                                               where nv.idrepresentante     = r.idrepresentante
                                                                 and nv.idsemanacobranca    = s.idsemana
                                                                 and nv.idfilial            = g.idfilial
                                                                 and nv.idsituacaonotavenda = 4 )
                                       and it.quantidade - it.qtddevolvida > 0 ), 0 ) custovendido
                            , nvl( ( select sum(nv.saldo)
                                     from notasvendas nv
                                     where nv.idrepresentante     = r.idrepresentante
                                       and nv.idsemanacobranca    = s.idsemana
                                       and nv.idsituacaonotavenda = 4
                                       and nv.idfilial            = g.idfilial 
                                       and nv.saldo > 0), 0 ) debitos
                            , nvl( ( select sum(nv.valorcomissao)
                                     from notasvendas nv
                                     where nv.idrepresentante     = r.idrepresentante
                                       and nv.idsemanacobranca    = s.idsemana
                                       and nv.idsituacaonotavenda = 4
                                       and nv.idfilial            = g.idfilial ), 0 ) comissaovend
                            , nvl( ( select sum(f.vlrcomissao)
                                     from fechamentorepresentantes f
                                        , comissoesfiliais c
                                     where f.idrepresentante  = r.idrepresentante
                                       and c.idcomissaofilial = f.idcomissao
                                       and exists ( select 1
                                                    from fechamentossemanais ff
                                                    where ff.idfechamento = f.idfechamentopontuacao
                                                      and ff.idfilial     = g.idfilial
                                                      and ff.idsemana     = s.idsemana ) ), 0 ) comissaorepres
                            , nvl( ( select sum(it.qtddevolvida*pck_estoque.fnc_retornaprecocusto(it.idestoquefil))
                                     from itensnotavenda it
                                     where it.idnotavenda in ( select nv.idnotavenda
                                                               from notasvendas nv
                                                               where nv.idrepresentante     = r.idrepresentante
                                                                 and nv.idsemanacobranca    = s.idsemana
                                                                 and nv.idfilial            = g.idfilial
                                                                 and nv.idsituacaonotavenda = 4 )
                                       and it.qtddevolvida > 0 ), 0 ) custodevolvido
                            , nvl( ( select sum(nv.valorpago)
                                     from notasvendas nv
                                     where nv.idrepresentante     = r.idrepresentante
                                       and nv.idsemanacobranca    = s.idsemana
                                       and nv.idsituacaonotavenda = 4
                                       and nv.idfilial            = g.idfilial ), 0 ) totalcobrado
                            , nvl( ( select sum(f.totalgeral)
                                     from fechamentorepresentantes f
                                     where f.idrepresentante  = r.idrepresentante
                                       and exists ( select 1
                                                    from fechamentossemanais ff
                                                    where ff.idfechamento = f.idfechamentopontuacao
                                                      --and ff.idfilial     = g.idfilial
                                                      and ff.idsemana     = s.idsemana ) ), 0 ) totalgeral
                            ,(select sum(case
                                         when totaldebitosnovos > 0 then
                                           totaldebitosnovos
                                         else
                                           0
                                         end )
                             from fechamentorepresentantes fr
                                , fechamentossemanais   ff
                             where ff.idfechamento    = fr.idfechamento
                               and fr.idrepresentante = r.idrepresentante
                               and trim(ff.semana)    = trim(s.semanacompleta)) totdebnovos
                            ,(select sum(case
                                         when totaldebitosnovos > 0 then
                                           ( totalgeral + totaldebitosnovos  ) 
                                         else
                                           0
                                         end )
                             from fechamentorepresentantes fr
                                , fechamentossemanais   ff
                             where ff.idfechamento    = fr.idfechamento
                               and fr.idrepresentante = r.idrepresentante
                               and trim(ff.semana)    = trim(s.semanacompleta)) totdebnovosger
                        from semana_dias s
                           , representantes r
                           , gerentes g
                        where r.idgerente = g.idgerente 
                          and (   ( :P0_IDFILIAL is null)
                               or ( :P0_IDFILIAL != 1135 and g.idfilial  = :P0_IDFILIAL ) 
                               or ( :P0_IDFILIAL  = 1135 and exists (select pc.idfilial
                                                                       from catal.filiais pc --pc->Pertence Comercial
                                                                      where pc.pertencecomercialromance = 'S'
                                                                        and pc.idfilial = g.idfilial )))
                            
                          and r.ativo = 'S'
                          and :P533_TIPO_RELATORIO = 'A'
                          and ( :P533_IDREPRESENTANTE is null or r.idrepresentante = :P533_IDREPRESENTANTE )
                          and ( :P533_TIPOPERIODO is null
                              or ( :P533_TIPOPERIODO = 'S' and s.idsemana = :P533_IDSEMANA )
                              or ( :P533_TIPOPERIODO = 'P' and s.idsemana between :P533_IDSEMANAINI and :P533_IDSEMANAFIM ) ) ) luc
                group by idrepresentante
                order by 2
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
