    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction escolha-de-tipo-de-semana (
        name: Escolha de Tipo de Semana
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P533_TIPOPERIODO
        }
        clientSideCondition {
            type: item=value
            item: P533_TIPOPERIODO
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P533_IDSEMANAINI
                    P533_IDSEMANAFIM
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P533_IDSEMANA
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P533_IDSEMANAINI
                    P533_IDSEMANAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P533_IDSEMANA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        name: Go To Page 533
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 533
                items: {
                    P533_IDREPRESENTANTE: &P533_IDREPRESENTANTE.
                    P533_TIPOPERIODO: &P533_TIPOPERIODO.
                    P533_IDSEMANA: &P533_IDSEMANA.
                    P533_IDSEMANAINI: &P533_IDSEMANAINI.
                    P533_IDSEMANAFIM: &P533_IDSEMANAFIM.
                    P533_TIPO_RELATORIO: &P533_TIPO_RELATORIO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

