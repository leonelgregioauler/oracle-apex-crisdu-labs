page 158 (
    name: Lista de Cliente V
    title: Lista de Cliente V
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_imprime()
              {
                window.open('f?p=&APP_ID.:157:&SESSION.::NO::P157_IDREPRESENTANTE,P157_IDREGIAOVENDA:'+document.getElementById('P158_IDREPRESENTANTE').value +','+document.getElementById('P158_IDREGIAOVENDA').value ,'imprime', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1200,height=800,left=250,top=100','_blank'); void(0);
              }
            
            function fnc_atender(pid)
            {
              document.getElementById("P158_IDEDITAR").value = pid;
                
              var answer = confirm("Confirma o atendimento da Nota?")
              if (answer)
              {
                apex.submit('ATENDER');
              }  
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region lista-de-clientes (
        name: Lista de Clientes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct p.idpessoa
                     , n.dataretorno dataretorno
                     , n.dataretornoorig dataretornoorig
                     , n.semanadistribuicao
                     , initcap(p.nomepessoa)||' - '||p.cpf||' (cod. site: '||v.idvendedora||')' nomepessoa
                     , n.numeronota
                     , pck_romance.fnc_retornatelefones(v.idvendedora)telefone
                     , initcap(p.enderecoprincipal) ||', '|| p.numero||', '||p.bairro endereco
                     , pck_romance.fnc_nomecidade(p.idcidade) nomecidade
                     , ( select rv.descricao from regioesvenda rv where rv.idregiaovenda = ( select vv.idregiaovenda from vendedoras vv where vv.idpessoa = p.idpessoa)) "Regiao Vendedora"
                     , p.observacao observacao
                     , p.bairro
                     , p.datanascimento
                     , nvl((select 'Sim'
                            from dual
                            where exists ( select 1
                                           from fotosdocumentos f
                                           where f.idpessoa = p.idpessoa
                                             and f.recebida = 'S' )),'Não') fotosdocumentos
                     , nvl((select 'Sim'
                            from dual
                            where exists ( select 1
                                           from classificacoesnotasvendas c
                                           where c.idnotavenda = n.idnotavenda
                                             and c.idcaracteristicanotavenda = 3 )),'Não') promissoriarecebida
                     , nroconsultaspc
                     , n.valortotalnota
                     , n.idnotavenda
                     , null detalhar
                     , ( select min(r.idsemana)
                         from roman.regioesrepresentantes r
                         where r.idrepresentante = :P158_IDREPRESENTANTE) - pck_util.fnc_idsemanadata(n.dataretornoorig) semanasatender
                     , r.ordem
                     , case
                         when not exists( select 1
                                          from classificacoesnotasvendas cn
                                          where cn.idnotavenda = n.idnotavenda
                                            and cn.idcaracteristicanotavenda = 23 ) then
                           '<a href="javascript: fnc_atender('|| n.idnotavenda ||')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         else
                           'Atendimento Realizado'
                       end confirmaatendimento
                     , nvl((select 'S'
                            from dual
                            where exists ( select 1
                                           from classificacoesnotasvendas cn
                                           where cn.idnotavenda = n.idnotavenda
                                             and cn.idcaracteristicanotavenda = 23)),'N') atendimentosup
                     , nvl( (select 'Sim'
                             from dual
                             where exists ( select 1
                                            from registrosloginminhasacola rr
                                            where rr.idvendedora = v.idvendedora)),'Não') app
                     , round(( select avg(valorpago)
                               from notasvendas nn
                               where nn.idvendedora = n.idvendedora
                                 and dataacerto > sysdate - 126 ),2) mediapgto3ciclos
                     , nvl( ( select 'Sim'
                              from dual
                              where exists ( select 1
                                             from favorita.vw_pedidostablet_fav pf
                                             where pf.idvendedora = v.idvendedora )), 'Não') possuipedido
                     , nvl( ( select a.descsituacao
                              from vw_assinaturas_eletronicas a
                              where a.idassinaturaeletronica = ( select max(ad.idassinaturaeletronica)
                                                                 from assinaturaseletronicas ad
                                                                 where ad.idnotavenda = n.idnotavenda
                                                                   and ad.status = 'C' ) ),'Nao Encontrada' ) assinatura
                     , p.email
                     , nvl( ( select 'Sim'
                              from dual
                              where ( select count(1)
                                      from notasvendas nv
                                      where nv.idvendedora = v.idvendedora 
                                        and nv.idsituacaonotavenda in (3,4) ) >= 4 ),'Não') romance_casa
                     , nvl( ( select ct.nomecategoria -- 16593086
                              from roman.pontuacoesclubedesucesso pp
                                 , roman.categoriasclubes ct
                              where pp.idcategoriaclube = ct.idcategoriaclube
                                and pp.idpontuacaoclube = ( select max(pc.idpontuacaoclube)
                                                            from vendedoras vv
                                                               , roman.pontuacoesclubedesucesso pc
                                                            where pc.idvendedora = vv.idvendedora
                                                              and vv.idpessoa = p.idpessoa ) ), 'Não participa') categoria_estrelas
                
                from pessoas p
                   , vendedoras v
                   , notasvendas n
                   , reimpressaolistavend r
                where v.idpessoa        = p.idpessoa
                  and r.idnotavenda     = n.idnotavenda
                  and n.semanacobranca  = ( select semana
                                            from regioesrepresentantes r
                                            where idrepresentante = :P158_IDREPRESENTANTE
                                              and idregiaovenda   = :P158_IDREGIAOVENDA)-- v.idregiaovenda = pidregiaovenda                            
                  and v.idvendedora     = n.idvendedora
                  and nvl(n.idrepresentanteatende, n.idrepresentante) = :P158_IDREPRESENTANTE
                  and n.idsituacaonotavenda = 3
                  and r.usuario = v('APP_USER')
                order by r.ordem
                ```
        }
