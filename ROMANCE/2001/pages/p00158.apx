    process atender-nota-supervisor (
        name: Atender Nota Supervisor
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidclassificacaonotavenda  number := null;
                  vidnotavenda               number := :P158_IDEDITAR;
                  vidcaracteristicanotavenda number := 23;
                  vdataclassificado          date := sysdate;
                  vidusuario                 number;
                  vidvalorcaracteristica     number;
                  vobservacao                varchar2(1000);
                  --
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda  => vidclassificacaonotavenda,
                                                                  pidnotavenda               => vidnotavenda,
                                                                  pidcaracteristicanotavenda => vidcaracteristicanotavenda,
                                                                  pdataclassificado          => vdataclassificado,
                                                                  pidusuario                 => vidusuario,
                                                                  pidvalorcaracteristica     => vidvalorcaracteristica,
                                                                  pobservacao                => vobservacao,
                                                                  poperacao_dml              => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1504176942928062950
        }
        serverSideCondition {
            type: request=Value
            value: ATENDER
        }
    )

    process insert (
        name: insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  type cur_typ is ref cursor;
                  --
                  c cur_typ;
                  --
                  query_str       varchar2(2000);
                  --
                  vidpessoa       number;
                  vdataretorno    date;
                  vnomepessoa     varchar2(200);
                  vnumeronota     varchar2(15);
                  vtelefone       varchar2(2000);
                  vendereco       varchar2(1000);
                  vnomecidade     varchar2(150);
                  vregiaovenda    varchar2(50);
                  vobsercacao     varchar2(2000);
                  vbairro         varchar2(100);
                  vdatanascimento date;
                  vdocreb         varchar2(10);
                  vidnotavenda    number;
                  vsemana         varchar2(10);
                  vmedia          number(15,2);
                  vorderby          varchar2(100);
                  --
                  vordem          number := 0;
                  --
                begin
                  --
                  delete reimpressaolistavend
                  where usuario = v('APP_USER');
                  --
                  select semana
                  into vsemana
                  from regioesrepresentantes r
                  where r.idrepresentante = :P158_IDREPRESENTANTE
                    and r.idregiaovenda   = :P158_IDREGIAOVENDA;
                  --
                  --STATIC2:Consultora;3,Cidade;7,Bairro;10,Nr Nota;4,Dt Retorno;2
                  --STATIC2:Consultora;3,Cidade;7,Bairro;10,Nr Nota;4,Dt Retorno;2,Média de Pgto (126 dias);14
                  query_str := 'select distinct p.idpessoa'||
                  			   '     , n.dataretorno'||
                			   ' 	 , initcap(p.nomepessoa) nomepessoa'||
                			   '     , n.numeronota'||
                			   '     , pck_romance.fnc_retornatelefones(v.idvendedora) telefone '||
                			   '     , pck_romance.fnc_enderecovendedora(v.idvendedora) '||
                			   '     , pck_romance.fnc_nomecidade(p.idcidade) nomecidade '||
                			   '     , ( select rv.descricao from regioesvenda rv where rv.idregiaovenda = ( select vv.idregiaovenda from vendedoras vv where vv.idpessoa = p.idpessoa)) RegiaoVendedora'||
                			   '     , p.observacao observacao'||
                			   '     , p.bairro'||
                			   '     , p.datanascimento'||
                			   '     , null docreb '||
                               '     , idnotavenda '||
                               '     , nvl(round(( select avg(valorpago) from notasvendas nn where nn.idvendedora = n.idvendedora and dataacerto > sysdate - 126 ),2),0) MEDIA '||
                			   'from pessoas p '||
                			   '   , vendedoras v '||
                			   '   , notasvendas n '||
                			   'where v.idpessoa        = p.idpessoa '||
                			   '   and v.idvendedora     = n.idvendedora '||
                			   '   and n.idsituacaonotavenda = 3';
                  --
                  query_str := query_str ||' and n.semanacobranca  = '''||vsemana||'''';
                  query_str := query_str ||' and nvl(n.idrepresentanteatende, n.idrepresentante) = '||:P158_IDREPRESENTANTE;
                  --
                  vorderby := :P158_TIPOORDENACAO;
                  --
                  if :P158_TIPOORDENACAO = 14 then
                    vorderby := vorderby||' desc';
                  end if;
                  query_str := query_str ||' order by '||vorderby;
                  --		 
                  --insert into teste values ( query_str,'reimpressao');
                  --
                  OPEN c FOR query_str;
                  LOOP
                      FETCH c INTO   vidpessoa,  vdataretorno, vnomepessoa, vnumeronota, vtelefone, vendereco, vnomecidade, vregiaovenda, vobsercacao, vbairro, vdatanascimento, vdocreb, vidnotavenda, vmedia;
                      EXIT WHEN c%NOTFOUND;
                      -- process row here
                      insert into reimpressaolistavend (usuario,idnotavenda, reimprimir , ordem, data, origem)
                      values ( v('APP_USER'),vidnotavenda,'S', vordem , sysdate,'D');
                      --
                      vordem := vordem+1;
                      --
                  END LOOP;
                  CLOSE c;
                  --
                  --exception
                  -- when others then  
                  --  insert into teste values ( query_str,'reimpressao');
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 300941907128094806
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    branch (
        name: filtrar
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 158
                items: {
                    P158_IDREPRESENTANTE: &P158_IDREPRESENTANTE.
                    P158_IDREGIAOVENDA: &P158_IDREGIAOVENDA.
                    P158_TIPOORDENACAO: &P158_TIPOORDENACAO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('ATENDER','FILTRAR')
                ```
        }
    )

)

