    region lista-de-débitos (
        name: Lista de Débitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct p.idpessoa
                     , n.dataretorno
                     , n.dataretornoorig
                     , initcap(p.nomepessoa) nomepessoa
                     , n.numeronota
                     , null detalhar
                     , n.idnotavenda
                     , pck_romance.fnc_retornatelefones(v.idvendedora) telefone
                     , initcap(p.enderecoprincipal) ||', '|| p.numero||'<br>'||p.bairro endereco
                     , ( select initcap(c.nomecidade)||' - '||e.sigla
                         from cidades c
                            , estados e
                         where p.idcidade = c.idcidade
                           and c.idestado = e.idestado ) nomecidade
                     , ( select rv.descricao from regioesvenda rv where rv.idregiaovenda = ( select vv.idregiaovenda from vendedoras vv where vv.idpessoa = p.idpessoa)) "Regiao Vendedora"
                     , v.observacao||', '||p.observacao observacao
                     , n.saldo SALDO
                     , p.nroconsultaspc
                     , n.valortotalnota
                     , ( select min(r.idsemana)
                         from roman.regioesrepresentantes r
                         where r.idrepresentante = :P158_IDREPRESENTANTE) - n.idsemanacobranca semanasatender
                     , n.semanadistribuicao
                     , case
                         when not exists( select 1
                                          from classificacoesnotasvendas cn
                                          where cn.idnotavenda = n.idnotavenda
                                            and cn.idcaracteristicanotavenda = 23 ) then
                           '<a href="javascript: fnc_atender('|| n.idnotavenda ||')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         else
                           'Atendimento Realizado'
                       end confirmaatendimento
                     , nvl((select 'S'
                            from classificacoesnotasvendas cn
                            where cn.idnotavenda = n.idnotavenda
                              and cn.idcaracteristicanotavenda = 23),'N') atendimentosup
                     , nvl( (select 'Sim'
                             from dual
                             where exists ( select 1
                                            from registrosloginminhasacola rr
                                            where rr.idvendedora = v.idvendedora)),'Não') app
                     , round(( select avg(valorpago)
                               from notasvendas nn
                               where nn.idvendedora = n.idvendedora
                                 and dataacerto > sysdate - 126 ),2) mediapgto3ciclos
                from pessoas p
                   , vendedoras v
                   , notasvendas n
                 where v.idpessoa        = p.idpessoa
                   and nvl(n.enviadocobranca,'N') = 'N'
                   and n.semanacobranca  != ( select semana
                                              from regioesrepresentantes r
                                              where r.idrepresentante = :P158_IDREPRESENTANTE
                                                and r.idregiaovenda = :P158_IDREGIAOVENDA )
                   and n.idregiaovenda   = :P158_IDREGIAOVENDA
                   and ( n.idrepresentante = :P158_IDREPRESENTANTE
                      or n.idrepresentanteatende = :P158_IDREPRESENTANTE )
                   and v.idvendedora     = n.idvendedora
                   and n.idrepresentante = v.idrepresentante
                   AND N.SALDO > 0
                order by 1
                ```
        }
        layout {
            sequence: 30
            slot: body-3
            startNewRow: false
            newColumn: false
        }
