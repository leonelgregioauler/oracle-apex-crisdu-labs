    pageItem P158_IDREGIAOVENDA (
        type: selectList
        label {
            label: Região de Venda
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.descricao||' - '||rr.semana display_value
                     , r.idregiaovenda return_value
                from regioesvenda r
                   , regioesrepresentantes rr
                where r.idregiaovenda = rr.idregiaovenda
                  and rr.idrepresentante = :P158_IDREPRESENTANTE
                order by rr.idsemana
                ```
            nullDisplayValue: - Selecione a Região -
        }
        cascadingLov {
            parentItems: P158_IDREPRESENTANTE
        }
        layout {
            sequence: 30
            region: @lista-de-clientes-v
            slot: regionBody
            alignment: left
