            encryptSessionState: false
        }
    )

    pageItem P158_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||decode(r.ativo,'S','Ativo','N','Inativo')||') - '||r.idrepresentante display_value
                     , r.idrepresentante
                from representantes r
                where pck_romance.fnc_filialgerente(pidgerente => r.idgerente) = :P0_IDFILIAL
                  and ( :P158_ATIVO = 'A' and r.ativo in ('S','N') 
                       or :P158_ATIVO = 'S' and r.ativo  = 'S'
                       or :P158_ATIVO = 'N' and r.ativo  = 'N')
                order by 1 
                ```
            nullDisplayValue: - Selecione o Distribuidor -
        }
        cascadingLov {
            parentItems: P158_ATIVO
            itemsToSubmit: P158_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            region: @lista-de-clientes-v
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

