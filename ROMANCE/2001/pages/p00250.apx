    region saídas-pendentes (
        name: Saídas Pendentes
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial (f.idfilial) Franquia
                     , count (s.idsaida) Qtd
                     , f.idfilial
                from roman.saidasdiversas s
                   , roman.fechamentossemanais f
                where s.idfechamento = f.idfechamento
                  and nvl(s.emmaos,'N') = 'N'
                  and f.idsemana >= 909
                  and exists ( select 1
                               from catal.filiais ff
                               where ff.idfilial = f.idfilial
                                 and ff.tipofilial = 'D')
                having count(1) > 0
                group by f.idfilial
                order by 1;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: FRANQUIA
            valueColumn: QTD
            linkTarget: {
                page: 250
                items: {
                    P0_IDFILIAL: &IDFILIAL.
                    P0_IDFECHAMENTO:
                }
                action: resetPagination
            }
            layout: 5Columns
            color: yes
        }
    )

