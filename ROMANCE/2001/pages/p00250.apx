page 250 (
    name: Revisar Saídas Diversas
    title: Revisar Saídas Diversas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    help {
        helpText: No help is available for this page.
    }

    region revisar-saídas (
        name: Revisar Saídas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDSAIDA
                     , IDSAIDA IDSAIDA_DISPLAY
                     , DATA
                     , VALORTOTAL
                     , DESCRICAO
                     , IDFECHAMENTO
                     , EMMAOS
                     , DECODE(s.tipo,'D','Dinheiro','O','Pagamento de Conta') TIPO
                     , IDCONTACONTABIL
                     , IDSUBCONTACONTABIL
                     , IDFILIALDEST
                     , null anexos
                     , ( select count(1)
                         from anexossaidas a
                         where a.idsaida = s.idsaida ) qtdanexos
                     , case
                         when exists ( select 1
                                       from subcontasfinanceiras ss
                                       where ss.idsubcontafinan = ( select sd.idsubcontacontabil
                                                                    from saidasdiversas sd
                                                                    where sd.idsaida = s.idsaida ) 
                                         and ss.tipo is not null ) and s.idsubcontacontabil is not null then
                           ( select decode(s.tipo,'F','Fixa','V','Variável')
                             from subcontasfinanceiras sf
                             where sf.idsubcontafinan = ( select sd.idsubcontacontabil
                                                          from saidasdiversas sd
                                                          where sd.idsaida = s.idsaida ) )
                         else
                           ( select decode(c.tipo,'F','Fixa','V','Variável')
                             from contasfinanceiras c
                             where c.idcontafinan = ( select se.idcontacontabil
                                                      from saidasdiversas se
                                                      where se.idsaida = s.idsaida )
                               and c.tipo is not null )
                        end tiposaida
                   , null questionamento
                   , replace(replace(replace(DESCRICAO,',',' ')||' - '||replace(VALORTOTAL,',','.') ,'+',''),'-','.') questionar 
                   , OBSERVACAOCONTROLE
                   , idmatrizclassificacao
                  -- , ( select m.classificacaodespesa
                  --     from matrizclassificacoesdespesas m
                  --     where m.idmatrizclassificacao = s.idmatrizclassificacao ) matrizclassificacao
                from SAIDASDIVERSAS s
                where idfechamento = :P0_IDFECHAMENTO
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            show: false
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 890571091621295501
        }

