    button apagar-registros (
        buttonName: APAGAR_REGISTROS
        label: Apagar Informações
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--danger
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button importar-arquivo (
        buttonName: IMPORTAR_ARQUIVO
        label: Importar Arquivo
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 352
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process apagar-informações (
        name: Apagar Informações
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                delete CONTROLEPRODUTOSROMANEIRO r
                where r.usuario = v('APP_USER')
                  and trunc(r.datacontrole) = trunc(sysdate);
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registros apagados!
        }
        advanced {
            executionMappingIdentifier: 1384662906642232216
        }
    )

)

