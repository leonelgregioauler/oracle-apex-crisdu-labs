page 356 (
    name: Controle de Romaneios para Exportação
    title: Controle de Romaneios para Exportação
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region controle-de-produtos (
        name: Controle de Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist codigo
                     , initcap(p.nomeproduto) produto
                     , nvl(c.qtd_pp,0) qtd_pp
                     , nvl(c.qtd_p,0) qtd_p
                     , nvl(c.qtd_m,0) qtd_m
                     , nvl(c.qtd_g,0) qtd_g
                     , nvl(c.qtd_gg,0) qtd_gg
                     , nvl(c.qtd_egg,0) qtd_egg
                     , nvl(c.qtd_exgg,0) qtd_exgg
                     , nvl(c.qtd_u,0) qtd_u
                     , ( nvl(c.qtd_pp,0)
                       + nvl(c.qtd_p,0)
                       + nvl(c.qtd_m,0)
                       + nvl(c.qtd_g,0)
                       + nvl(c.qtd_gg,0)
                       + nvl(c.qtd_egg,0)
                       + nvl(c.qtd_exgg,0)
                       + nvl(c.qtd_u,0) ) total
                from CONTROLEPRODUTOSROMANEIRO c 
                   , produtos p
                where c.idproduto = p.idproduto
                  and c.usuario = v('APP_USER')
                  and trunc(datacontrole) = trunc(sysdate)
                ORDER BY 2
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum registro encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 1381902597349304350
        }

