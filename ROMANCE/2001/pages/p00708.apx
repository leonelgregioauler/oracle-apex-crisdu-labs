page 708 (
    name: Cadastro de Estrelas Romance
    title: Cadastro de Estrelas Romance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"Confirma exclusão do registro?"';
    }

    region cadastro-de-estrelas-romance (
        name: Cadastro de Estrelas Romance
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P708_DATAVIGENCIAFINAL (
        type: datePickerJquery
        label {
            label: Vigência Final
            alignment: left
        }
        settings {
            maxDate: 31/12/2050
        }
        layout {
            sequence: 40
            region: @cadastro-de-estrelas-romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        source {
            type: databaseColumn
            databaseColumn: DATAVIGENCIAFINAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P708_DATAVIGENCIAINICIAL (
        type: displayOnly
        label {
            label: Vigência Inicial
            alignment: left
        }
        layout {
            sequence: 30
            region: @cadastro-de-estrelas-romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: DATAVIGENCIAINICIAL
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vdata date;
                begin
                  select dt_ini
                    into vdata
                    from semana_dias
                   where trunc(sysdate) between dt_ini and dt_fim;
                  --
                  return nvl(:P708_DATAVIGENCIAINICIAL,to_char(vdata,'dd/mm/rrrr') ) ;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText:
                ```html
                Vigência inicial deve ser o primeiro dia da semana Inicial que deseja configurar.
                Ex: Se a semana inicial for a 14/2024 então a Vigência Inicial deve ser 31/03/2024.
                
                ```
        }
    )

    pageItem P708_IDCLUBEDESUCESSO (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-estrelas-romance
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCLUBEDESUCESSO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P708_NOMECLUBE (
        type: textField
        label {
            label: Nome do Programa
            alignment: left
        }
        layout {
            sequence: 20
            region: @cadastro-de-estrelas-romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: NOMECLUBE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button agendar (
        buttonName: AGENDAR
        label: Agendar Início
        layout {
            sequence: 50
            region: @cadastro-de-estrelas-romance
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from clubedesucesso c
                     , filiaisclubedesucesso f
                 where c.idclubedesucesso = f.idclubedesucesso
                   and c.idclubedesucesso = :P708_IDCLUBEDESUCESSO
                   and not exists ( select 1
                                      from DBA_SCHEDULER_JOBS
                                     where owner = 'ROMAN'
                                       and job_name = 'INICIA_CLUBEDESUCESSO_'||:P708_IDCLUBEDESUCESSO )
                ```
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar/Voltar
        layout {
            sequence: 10
            region: @cadastro-de-estrelas-romance
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 707
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @cadastro-de-estrelas-romance
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P708_IDCLUBEDESUCESSO
        }
    )

    button desagendar (
        buttonName: DESAGENDAR
        label: Cancelar Agendamento
        layout {
            sequence: 60
            region: @cadastro-de-estrelas-romance
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from clubedesucesso c
                     , filiaisclubedesucesso f
                 where c.idclubedesucesso = f.idclubedesucesso
                   and c.idclubedesucesso = :P708_IDCLUBEDESUCESSO
                   and exists ( select 1
                                      from DBA_SCHEDULER_JOBS
                                     where owner = 'ROMAN'
                                       and job_name = 'INICIA_CLUBEDESUCESSO_'||:P708_IDCLUBEDESUCESSO )
                ```
        }
    )

    button insert (
        buttonName: INSERT
        label: Incluir
        layout {
            sequence: 40
            region: @cadastro-de-estrelas-romance
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P708_IDCLUBEDESUCESSO
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @cadastro-de-estrelas-romance
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P708_IDCLUBEDESUCESSO
        }
    )

    dynamicAction confirmaagendar (
        name: confirmaAgendar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @agendar
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirmar Agendamento de Início?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: AGENDAR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction confirmadesagendar (
        name: ConfirmaDesagendar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @desagendar
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma Cancelar o agendamento de início?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DESAGENDAR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process agendar-job (
        name: Agendar Job
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 vdatainicio date;
                begin
                  select datavigenciainicial
                    into vdatainicio
                    from clubedesucesso
                   where idclubedesucesso = :P708_IDCLUBEDESUCESSO;
                           
                  sys.dbms_scheduler.create_job(job_name            => 'ROMAN.INICIA_CLUBEDESUCESSO_'||:P708_IDCLUBEDESUCESSO,
                                                job_type            => 'PLSQL_BLOCK',
                                                job_action          => 'begin
                                                                          pck_clubedesucesso.prc_gerahistoricoclube(
                                                                            ptipo => ''X'',
                                                                            pidvendedora => null,
                                                                            pidnota => null,
                                                                            pidpedido => null);
                                                                          commit;
                                                                        end;',
                                                start_date          => to_date(trunc(vdatainicio) || ' 02:00:00', 'dd-mm-yyyy hh24:mi:ss'),
                                                job_class           => 'DEFAULT_JOB_CLASS',
                                                enabled             => true,
                                                comments            => 'Criado pela pagina 708 - APP 2001');
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Agendamento realizado com sucesso!
        }
        error {
            errorMessage:
                ```
                Erro no processo de agendamento. 
                Informe a T.I.
                ```
        }
        advanced {
            executionMappingIdentifier: 1110697291318299741
        }
        serverSideCondition {
            type: request=Value
            value: AGENDAR
        }
    )

    process cancelar-agendamento (
        name: Cancelar Agendamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                           
                  DBMS_SCHEDULER.drop_job (job_name=>'INICIA_CLUBEDESUCESSO_'||:P708_IDCLUBEDESUCESSO);
                
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Agendamento cancelado com sucesso!
        }
        error {
            errorMessage:
                ```
                Erro no processo de cancelamento do agendamento. 
                Informe a T.I.
                ```
        }
        advanced {
            executionMappingIdentifier: 1110697318068299742
        }
        serverSideCondition {
            type: request=Value
            value: DESAGENDAR
        }
    )

    process fetch-row-from-clubedesucesso (
        name: Fetch Row from CLUBEDESUCESSO
        type: autoRowFetch
        source {
            tableName: CLUBEDESUCESSO
            pkColumn: IDCLUBEDESUCESSO
            pkItem: P708_IDCLUBEDESUCESSO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1505239554298149511
        }
    )

    process process-row-of-clubedesucesso (
        name: Process Row of CLUBEDESUCESSO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 v_operacao_dml varchar2(1);
                 v_md5 varchar2(4000);
                begin
                
                if v('REQUEST') = 'INSERT' then
                  v_operacao_dml := 'I';
                elsif v('REQUEST') = 'SAVE' then
                  v_operacao_dml := 'U';
                elsif v('REQUEST') = 'DELETE' then
                  v_operacao_dml := 'D';
                end if;
                
                pck_clubedesucesso.prc_clubedesucesso (:P708_IDCLUBEDESUCESSO,
                                                       :P708_NOMECLUBE,
                                                       :P708_DATAVIGENCIAINICIAL,
                                                       :P708_DATAVIGENCIAFINAL,
                                                       v_md5,
                                                      v_operacao_dml);
                
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 1505240315056149511
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 1505240779410149511
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 707
            }
        }
    )

)

