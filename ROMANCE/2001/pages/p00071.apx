    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @entradas-pendentes-de-confirmação
        target {
            tableName: ENTRADASDIVERSAS
            pkColumn: IDENTRADA
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Linha(s) #MRU_COUNT# atualizada(s).
        }
        error {
            errorMessage: Não foi possível processar a atualização.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 156843479165539879
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 71
                items: {
                    P71_IDFECHAMENTO: &P71_IDFECHAMENTO.
                    P71_SEMANA: &P71_SEMANA.
                }
            }
        }
    )

)

