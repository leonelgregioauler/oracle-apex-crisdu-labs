        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @entradas-pendentes-de-confirmação
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 70
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Nova Entrada
        layout {
            sequence: 30
            region: @entradas-confirmadas-neste-fechamento
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 64
                items: {
                    P64_IDFECHAMENTO: &P71_IDFECHAMENTO.
                }
                clearCache: 64
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @entradas-pendentes-de-confirmação
            slot: CHANGE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation data-must-be-a-valid-date (
        name: DATA must be a valid date
        execution {
            sequence: 60
        }
        validation {
            editableRegion: @entradas-pendentes-de-confirmação
            type: columnIsAValidDate
            column: DATA
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser uma data válida.
            associatedColumn: DATA
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

