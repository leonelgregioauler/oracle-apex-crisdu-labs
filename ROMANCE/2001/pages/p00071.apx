    region entradas-pendentes-de-confirmação (
        name: Entradas Pendentes de Confirmação
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDENTRADA",
                "IDENTRADA" IDENTRADA_DISPLAY,
                "IDFILIAL",
                "IDFILIALORIG",
                "SEMANA",
                "DATA",
                "FECHAMENTOORIG",
                "VALORTOTAL",
                "DESCRICAO",
                "IDSAIDADIVERSA",
                "IDFECHAMENTO",
                TIPO,
                DESCRICAOORIGEM
                from "#OWNER#"."ENTRADASDIVERSAS"
                WHERE IDFECHAMENTO is null
                and ( (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S')
                       or idfilial = ( select  f.idfilial 
                                        from filiais    f
                                           , usuarios   u
                                           , gerentes   g
                                        where g.idfilial  = f.idfilial
                                          and u.idgerente = g.idgerente
                                          and u.usuario   = v('APP_USER')))
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: " -"
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhuma entrada para confirmar!
        }
        componentAdvanced {
            stripHtml: true
        }

        column DATA (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Data
            }
            layout {
                sequence: 8
            }
            sorting {
                defaultSequence: 1
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Descrição
            }
            layout {
                sequence: 9
            }
        )

        column DESCRICAOORIGEM (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Descrição da Origem
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column FECHAMENTOORIG (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
        )

        column IDENTRADA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingTrigger
            }
        )

        column IDENTRADA_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column IDFECHAMENTO (
            reportColumnQueryId: 11
            derivedColumn: N
            type: selectList
            heading {
                heading: Confirmar
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select fs.semana DISPLAY_VALUE
                    , fs.idfechamento RETURN_VALUE
                    from fechamentossemanais fs
                    where fs.idfilial = ( select  f.idfilial 
                                            from filiais    f
                                               , usuarios   u
                                               , gerentes   g
                                            where g.idfilial  = f.idfilial
                                              and u.idgerente = g.idgerente
                                              and u.usuario   = v('APP_USER'))
                    AND fs.concluido = 'N'
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 13
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 3
            derivedColumn: N
            type: selectList
            heading {
                heading: Filial Destino
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                    , f.idfilial return_value
                    from filiais          f
                       , pessoas          p
                    where f.idpessoa    = p.idpessoa
                    order by 1 
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 6
            }
            sorting {
                defaultSequence: 2
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from dual
                    where pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S'
                    ```
            }
        )

        column IDFILIALORIG (
            reportColumnQueryId: 4
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Filial Origem
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                    , f.idfilial return_value
                    from filiais          f
                       , pessoas          p
                    where f.idpessoa    = p.idpessoa
                    order by 1 desc
                    ```
            }
            layout {
                sequence: 5
            }
        )

        column IDSAIDADIVERSA (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 1
            }
        )

        column SEMANA (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 7
            }
        )

        column TIPO (
            reportColumnQueryId: 12
            derivedColumn: N
            type: selectList
            heading {
                heading: Tipo
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Outros;O,Fatura;F,Investimento;I
                displayNullValue: false
            }
            layout {
                sequence: 12
            }
        )

        column VALORTOTAL (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Valor Total
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
        )

    )

