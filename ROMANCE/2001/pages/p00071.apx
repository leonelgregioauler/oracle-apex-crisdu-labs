page 71 (
    name: Entradas Diversas
    title: Entradas Diversas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region entradas-confirmadas-neste-fechamento (
        name: Entradas Confirmadas neste Fechamento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.identrada
                     , e.idfilial
                     , initcap(nvl(p.apelido,p.nomepessoa)) "Filial Origem"
                     , initcap(nvl(ps.apelido,ps.nomepessoa)) "Filial Destino"
                     , e.semana
                     , e.data
                     , e.fechamentoorig
                     , e.valortotal
                     , e.descricao
                     , e.idfechamento
                     , (select c.nomeconta
                        from contasfinanceiras c
                        where c.idcontafinan = e.idcontacontabil) conta
                     , (select c.nomeconta
                        from subcontasfinanceiras c
                        where c.idsubcontafinan = e.idsubcontacontabil) subconta
                     , decode(e.tipo,'F','Fatura','I','Investimento','O','Outros') Tipo
                from entradasdiversas e
                   , filiais          f
                   , pessoas          p
                   , filiais          fs
                   , pessoas          ps
                where e.idfilialorig = f.idfilial(+)
                  and f.idpessoa     = p.idpessoa(+)
                  and e.idfilial     = fs.idfilial(+)
                  and fs.idpessoa    = ps.idpessoa(+)
                  and e.idfechamento = :P71_IDFECHAMENTO
                  and ( (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S')
                       or E.idfilial = ( select  f.idfilial 
                                        from filiais    f
                                           , usuarios   u
                                           , gerentes   g
                                        where g.idfilial  = f.idfilial
                                          and u.idgerente = g.idgerente
                                          and u.usuario   = v('APP_USER')))
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        link {
            linkColumn: customTarget
            target: {
                page: 64
                items: {
                    P64_IDENTRADA: #IDENTRADA#
                    P64_IDFECHAMENTO: #IDFECHAMENTO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt="" />
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma entrada incluída.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

