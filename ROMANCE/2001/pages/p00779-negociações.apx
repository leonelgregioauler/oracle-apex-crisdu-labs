        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function deletadebito(pid){ 
            
              document.getElementById('P779_ID').value = pid;
                
              var answer = confirm("Deseja Remover essa Negociação?")
              if (answer)
                {
                  apex.submit('EXCLUIR');
                }
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
