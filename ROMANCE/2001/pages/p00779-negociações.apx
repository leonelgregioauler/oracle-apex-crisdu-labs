    pageItem P779_IDVENDEDORA (
        type: popupLov
        label {
            label: Pessoa
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' CPF: '||p.cpf d
                     , v.idvendedora r
                from pessoas p
                   , vendedoras v
                where v.idpessoa = p.idpessoa 
                 -- and ( :P779_IDFILIAL is null or v.idfilial = :P779_IDFILIAL )
                 -- and ( :P779_IDREPRESENTANTE is null or v.idrepresentante = :P779_IDREPRESENTANTE )
                order by 1
                ```
            nullDisplayValue: " - Todos -"
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
