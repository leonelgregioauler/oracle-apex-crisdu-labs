    pageItem P779_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome
                     , p.idpais
                  from catal.paises p
                 where exists (
                         select 1
                           from roman.notasvendas n
                           join catal.representantes r on r.idrepresentante = n.idrepresentante
                           join catal.pessoas pe on pe.idpessoa = r.idpessoa
                          where pe.idpais = p.idpais
                            and n.idsituacaonotavenda = 3
                       )
                 order by 1
                ```
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
    )

    pageItem P779_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) nome
                     , idrepresentante
                from representantes r
                where r.ativo = 'S'
                  and r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P779_IDFILIAL )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P779_IDFILIAL
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
