    process excluir-negociacao (
        name: EXCLUIR NEGOCIACAO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdatanegociacao   date;
                  vvforma           varchar2(1);
                  vtid              varchar2(100);
                  vnsu              varchar2(100);
                  Vcampanhaespecial varchar2(1);
                  vvalor            number;
