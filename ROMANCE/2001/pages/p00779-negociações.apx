        }
    )

    pageItem P779_ORIGEM (
        type: selectList
        label {
            label: Origem
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT O.DESCRICAO
                      ,O.ORIGEMCOBRANCA
                  FROM ROMAN.ORIGENSCOBRANCA O
                     , ROMAN.FILIAISORIGCOB T
                     , CATAL.USUARIOS U
                     , CATAL.GERENTES G
                 WHERE O.ORIGEMCOBRANCA = T.ORIGEMCOBRANCA
                   AND T.IDFILIAL = G.IDFILIAL
                   AND G.IDGERENTE = U.IDGERENTE
                   AND U.USUARIO = V('APP_USER');
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 120
            region: @filtros
            slot: regionBody
            alignment: left
