                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region negociações (
        name: Negociações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select np.idnegociacaoparceiro
                     , pck_romance.fnc_filialrepresentante(np.idrepresentante) idfilial
                     , pck_romance.fnc_nomefilial(np.idfilial) filial
                     , np.idrepresentante
                     , pck_romance.fnc_nomerepresentante(np.idrepresentante) representante
                     , np.idvendedora
                     , pck_romance.fnc_nomevendedora(np.idvendedora) vendedora
                     , nvl(pck_romance.fnc_cpfvendedora(np.idvendedora),( select documentoestrangeiro
                                                                          from pessoas p
                                                                             , vendedoras v
                                                                          where v.idvendedora = np.idvendedora
                                                                            and v.idpessoa    = p.idpessoa )) cpf
                     , np.datanegociacao
                     , nvl(np.valornegociacao,0) valornegociacao
                     , nvl(np.valorpago,0) valorpago
                     , nvl(np.saldo,0) saldo
                     , np.formapagamento charformapgto
                     , DECODE(np.formapagamento,'C','Cartão de Crédito','D','Depósito','B', 'Boleto','P', 'PIX','G', 'Giro de Pago','T', 'Giro de Tigo') formapagamento
                     , (select o.descricao
                          from roman.origenscobranca o
                         where o.origemcobranca = np.origem) origem
                     , observacao
                     , decode( nvl(np.valorpago,0), 0,
                         '<a href=javascript:deletadebito('||np.idnegociacaoparceiro||');><img src="#APP_IMAGES#excluir.png" alt=""/></a>' ,
                         null
                      ) deletanegociacao
                     , np.linknegociacao
                     , np.tid
                     , np.nsu
                from roman.negociacoesparceiros np
                where trunc(np.datanegociacao) between nvl(to_date(:P779_DATAINICIO),trunc(np.datanegociacao)) and nvl(to_date(:P779_DATAFIM),trunc(np.datanegociacao) )
                  and ( :P779_IDVENDEDORA is null or np.idvendedora = :P779_IDVENDEDORA )
                  --and (:P779_ORIGEM is null or np.origem = :P779_ORIGEM)
                  and np.origem = :P779_ORIGEM
                  and :P779_FILTRAR = 'S'
                  and (:P779_SITUACAO = 'T' or exists (select 1
                                                         from roman.pagamentosnegociacoesparceiros pn
                                                        where pn.idnegociacaoparceiro = np.idnegociacaoparceiro
                                                          and pn.situacao = :P779_SITUACAO))
                  and ( :P779_IDPAIS is null or np.idpais = :P779_IDPAIS )                                            
                  
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
