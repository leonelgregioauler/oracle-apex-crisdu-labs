    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @botões
            slot: previous
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Próximo Passo
        layout {
            sequence: 20
            region: @botões
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P85_IDCHAMADO is null and ( :P85_ATENDIMENTOVIASENSRIT = 'N' or  (:P85_IDGRUPOATENDIMENTO != 0 and :P85_ATENDIMENTOVIASENSRIT = 'S') )
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction escolha-do-grupo (
        name: Escolha do Grupo
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P85_IDGRUPOATENDIMENTO
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ESCOLHA_DESTINO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P85_IDGRUPOATENDIMENTO
        }
        clientSideCondition {
            type: item=value
            item: P85_IDGRUPOATENDIMENTO
            value: 2
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P85_MENSAGEMORCAMENTO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P85_MENSAGEMORCAMENTO
            }
            execution {
                sequence: 10
            }
        )

    )

    validation valida-descrição (
        name: Valida Descrição
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P85_DESCRICAO
        }
        error {
            errorMessage: Por favor, informe alguma descrição para nós.
        }
        serverSideCondition {
            type: request!=Value
            value: ESCOLHA_DESTINO
        }
    )

    validation valida-telefone (
        name: Valida telefone
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P85_TELEFONECONTATO
        }
        error {
            errorMessage: Por favor, informe seu telefone.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P85_IDGRUPOATENDIMENTO in ('0','116', '2')  AND :REQUEST != 'ESCOLHA_DESTINO'
        }
    )

    process fetch-row-from-chamados (
        name: Fetch Row from CHAMADOS
        type: autoRowFetch
        source {
            tableName: CHAMADOS
            pkColumn: IDCHAMADO
            pkItem: P85_IDCHAMADO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 16301240069316264
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P85_IDCHAMADO is null then
                        select "#OWNER#"."SEQ_IDCHAMADO".nextval
                          into :P85_IDCHAMADO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 16301653412316264
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-chamados (
        name: Process Row of CHAMADOS
        type: autoRowProcessing
        target {
            tableName: CHAMADOS
            pkColumn: IDCHAMADO
            pkItem: P85_IDCHAMADO
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 16302014843316265
        }
    )

    branch (
        name: Go To Page 98
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 98
                items: {
                    P98_IDCHAMADO: &P85_IDCHAMADO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request!=Value
            value: ESCOLHA_DESTINO
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 85
                items: {
                    P85_IDGRUPOATENDIMENTO: &P85_IDGRUPOATENDIMENTO.
                    P85_DESTINO: &P85_IDGRUPOATENDIMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: ESCOLHA_DESTINO
        }
    )

)

