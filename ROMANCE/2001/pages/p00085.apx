            sequence: 80
            region: @novo-evento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
            height: 8
            valuePlaceholder: Nos conte aqui o seu problema/solicitação
        }
        validation {
            maxLength: 3000
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

