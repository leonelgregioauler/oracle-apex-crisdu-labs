page 85 (
    name: Novo Ticket
    title: Novo Ticket
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutStart
            js-dialog-class-t-Drawer--md
        ]
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region botões (
        name: Botões
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region novo-evento (
        name: Novo Evento
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <font color="blue">Agora você pode direcionar sua solicitação direto as pessoas responsáveis, selecione abaixo!</font>
        }
        settings {
            outputAs: text
        }
    )

    region passo-a-passo (
        name: Passo a Passo
        type: list
        source {
            list: @registrar-evento
        }
        layout {
            sequence: 10
            slot: dialogHeader
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    pageItem P85_ATENDIMENTOVIASENSRIT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 340
            region: @novo-evento
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

