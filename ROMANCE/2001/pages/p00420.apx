    pageItem P420_IDREPRESENTANTE (
        type: selectList
        label {
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.idrepresentante||' - '||pck_romance.fnc_nomerepresentante(r.idrepresentante) display_value
                     , r.idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                  and r.ativo = 'S'
                  and (:P0_IDPOSTOAVANCADO is null or r.idpostoavancado = :P0_IDPOSTOAVANCADO ) 
                order by pck_romance.fnc_nomerepresentante(r.idrepresentante)
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--xlarge
            ]
            height: 1
        }
        security {
            encryptSessionState: false
