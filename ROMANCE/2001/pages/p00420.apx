    region lista-de-consultoras (
        name: Lista de Consultoras
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Consultoras Possiveis' descricao
                     , trim(to_char(count(1),'999G999G990'))  quantidade
                from vendedoras v
                where v.ativo = 'S'
                  and liberaappminhasacola = 'S'
                  and v.idrepresentante = :P420_IDREPRESENTANTE
                union
                select 'Consultoras com App' descricao
                     , trim(to_char(count(1),'999G999G990'))  quantidade
                from registrosloginminhasacola e
                where e.primeirologin = 'S'
                  and exists ( select 1
                               from vendedoras     v
                               where v.idvendedora     = e.idvendedora
                                 and v.idrepresentante = :P420_IDREPRESENTANTE ) 
                union
                select 'Fotos Compartilhadas' descricao
                     , trim(to_char(count(1),'999G999G990'))  quantidade
                from registroscompartilhafotos r
                where exists ( select 1
                               from vendedoras     v
                               where v.idvendedora     = r.idvendedora
                                 and v.idrepresentante = :P420_IDREPRESENTANTE ) 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DESCRICAO
            valueColumn: QUANTIDADE
        }
    )

    region produtos-mais-compartilhados (
        name: Produtos mais Compartilhados
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                -- Created on 11/10/2018 by ÉVERTON PASSOS 
                declare 
                  -- Local variables here
                  vqtdcolunas number := 0;
                  --
                begin
                  -- 
                  htp.p('  <style type="text/css">
                .img_produto {
                    position: relative;
                    max-width: 210px;
                    width: 60%;
                }
                </style>');
                  htp.p('<table border=0>');
                  htp.p('  <tr align="center">');
                  -- 
                  for a in ( select idfotoproduto
                                  , codigosisdist
                                  , nome
                                  , imagem
                                  , qtd
                             from ( select f.idfotoproduto
                                         , p.codigosisdist
                                         , initcap(nomeproduto) nome
                                         , '<a href="'||url||'" target="_blank"> <img src="'||urlreduzida||'" class="img_produto"><a>' imagem
                                         , count(1) qtd
                                    from fotosprodutos             f
                                       , produtos                  p
                                       , registroscompartilhafotos r
                                       , vendedoras                v
                                       , representantes            r
                                    where f.idproduto     = p.idproduto
                                      and r.idfotoproduto = f.idfotoproduto
                                      and r.idvendedora   = v.idvendedora
                                      and v.idrepresentante = r.idrepresentante
                                      and v.idrepresentante = :P420_IDREPRESENTANTE
                                    group by f.idfotoproduto
                                           , p.codigosisdist
                                           , initcap(p.nomeproduto)
                                           , urlreduzida
                                           , url
                                    order by 5 desc )
                               where rownum <= 24 )
                  loop
                    --
                    htp.p('  <td align="center">');
                    htp.p(       a.imagem );
                    htp.p('    <br>');
                    htp.p(       a.codigosisdist||' <br> '||a.nome ||'<br>'||a.qtd);
                    htp.p('  </td>');
                    --
                    vqtdcolunas := vqtdcolunas + 1;
                    --
                    if  vqtdcolunas = 3 then
                      vqtdcolunas := 0;
                      --
                      htp.p('  </tr>');
                      htp.p('  <tr>');
                    end if;
                    --
                  end loop;
                  --
                  htp.p('  </tr>');
                  htp.p('<table>');
                  --
                end;
                ```
        }
        layout {
            sequence: 120
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region utilização-por-consultora (
        name: Utilização por Consultora
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomepessoa(idpessoa) consultora
                     , r.datalogin
                     , ( select count(1)
                         from registrosloginminhasacola rr
                         where rr.idvendedora = r.idvendedora ) qtdlogin
                     , ( select max(rr.datalogin)
                         from registrosloginminhasacola rr
                         where rr.idvendedora = r.idvendedora ) ultimologin
                     , ( select count(1) qtd
                         from registroscompartilhafotos f
                         where f.idvendedora = r.idvendedora ) qtdcompartilhamento
                from registrosloginminhasacola r
                   , vendedoras                v
                where primeirologin     = 'S'
                  and v.idvendedora     = r.idvendedora
                  and v.idrepresentante = :P420_IDREPRESENTANTE 
                order by 1
                ```
