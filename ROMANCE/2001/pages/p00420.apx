page 420 (
    name: B.I. Minha Sacola Distribuidores
    title: B.I. Minha Sacola Distribuidores
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region adesão (
        name: Adesão
        type: chart
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: lineWithArea
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        legend {
            show: false
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomecidade(p.idcidade) cidade
                         , to_number(trim(to_char(trunc(r.datalogin),'RRRRMMDD'))) sequencia 
                         , count(1) qtd
                    from registrosloginminhasacola r
                       , vendedoras v
                       , pessoas p
                    where primeirologin = 'S'
                      and v.idvendedora = r.idvendedora
                      and v.idpessoa    = p.idpessoa
                      and v.idrepresentante = :P420_IDREPRESENTANTE
                    group by trunc(datalogin) , pck_romance.fnc_nomecidade(idcidade)
                    ORDER BY 1, trunc(datalogin) 
                    ```
            }
            columnMapping {
                seriesName: CIDADE
                label: SEQUENCIA
                value: QTD
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

