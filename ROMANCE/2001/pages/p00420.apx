    region compartilhamento-por-dia-e-hora (
        name: Compartilhamento por Dia e Hora
        type: chart
        layout {
            sequence: 90
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent12
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        legend {
            show: false
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(f.datacompartilhamento,'DAY') dia 
                         , to_number(trim(to_char(f.datacompartilhamento,'HH24'))) hora 
                         , count(1) qtd
                    from registroscompartilhafotos f
                       , vendedoras v
                    where v.idvendedora = f.idvendedora
                      and v.idrepresentante = :P420_IDREPRESENTANTE
                    group by to_char(f.datacompartilhamento,'D') 
                           , to_char(f.datacompartilhamento,'DAY') 
                           , to_number(trim(to_char(f.datacompartilhamento,'HH24'))) 
                    order by to_char(f.datacompartilhamento,'D') , 2
                    ```
            }
            columnMapping {
                seriesName: DIA
                label: HORA
                value: QTD
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region consultoras-sem-app-minha-sacola (
        name: Consultoras sem APP Minha Sacola
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) consultora
                     , p.cpf 
                     , pck_util.fnc_retornatelefones(p.idpessoa) telefones
                     , ( select datanota
                         from notasvendas n
                         where n.idnotavenda = ( select max(idnotavenda)
                                                 from notasvendas nv
                                                 where nv.idvendedora = v.idvendedora ) ) ultimanota
                from vendedoras v
                   , pessoas p
                where v.ativo = 'S'
                  and v.idrepresentante = :P420_IDREPRESENTANTE
                  and v.idpessoa = p.idpessoa
                  and exists ( select 1
                               from notasvendas nv
                               where nv.idvendedora = v.idvendedora )
                  and not exists ( select 1
                                   from registrosloginminhasacola r
                                   where r.idvendedora = v.idvendedora )
                order by 1
                ```
        }
        layout {
            sequence: 110
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent7
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2637855373471104442
        }

