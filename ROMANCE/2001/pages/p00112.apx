page 112 (
    name: Setor de Reembalagem
    title: Setor de Reembalagem
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region setor-de-reembalagem (
        name: Setor de Reembalagem
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial( e.idfilial  ) "Filial" 
                     , ( select c.nome
                         from categorias c
                         where c.idcategoria = ( select pr.idcategoria
                                                 from produtos pr
                                                 where pr.idproduto = e.idproduto ) ) "Categoria"
                     , ( select pr.codigosisdist
                         from produtos pr
                         where pr.idproduto = e.idproduto )  "Código"
                     , ( select initcap( pr.nomeproduto )
                         from produtos pr
                         where pr.idproduto = e.idproduto )  "Produto"
                     , ( select c.descricao
                         from cores c
                         where c.idcor = e.idcor)  "Cor"
                     , er.quantidade
                     , decode(e.ativo,'S','Sim','Não') ativo
                     , e.idestoquefilial
                     , e.idfilial
                     , e.idproduto
                     , e.idcor
                     , decode(e.comissao, 'S', 'Sim','N','Não') comissao
                     , e.vlrvenda
                     , er.qtd_pp   
                     , er.qtd_p    
                     , er.qtd_m    
                     , er.qtd_g    
                     , er.qtd_gg   
                     , er.qtd_egg  
                     , er.qtd_exgg
                     , er.qtd_u   
                from estoquereembalagem er
                   , estoquefilial     e
                where e.idestoquefilial = er.idestoquefil
                  and e.ativo           = 'S'
                  and ( :P0_IDFILIAL is null or e.idfilial = :P0_IDFILIAL)
                order by 4
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Não há registros de estoque.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

