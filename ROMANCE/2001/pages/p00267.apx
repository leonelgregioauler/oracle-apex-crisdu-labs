    region balanço-de-carga-em-valores (
        name: Balanço de Carga em Valores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idrepresentante
                     , idfilial
                     , idsemanabalanco
                     , idsemana
                     , semana
                     , valorinicialbalanco
                     , cargacomdesconto
                     , cargamaissemdesconto + (cargamaissemdesconto * 0.45) cargamaissemdesconto
                     , cargamaiscomdesconto
                     , cargasemdesconto     + (cargasemdesconto * 0.45) cargasemdesconto
                     , devolucaocomdesconto 
                     , devolucaosemdesconto + (devolucaosemdesconto * 0.45) devolucaosemdesconto
                     , devdefeitocomdesconto
                     , devdefeitosemdesconto+ (devdefeitosemdesconto * 0.45) devdefeitosemdesconto
                     , nvl(cobranca,0)  cobranca
                     , '|' s1
                     , t.valorinicialbalanco
                      + ( select sum(cargacomdesconto
                                   + ( cargamaissemdesconto + (cargamaissemdesconto * 0.45))
                                   + cargamaiscomdesconto
                                   + (cargasemdesconto     + (cargasemdesconto * 0.45))
                                   - devolucaocomdesconto
                                   - ( devolucaosemdesconto + (devolucaosemdesconto * 0.45))
                                   - devdefeitocomdesconto
                                   - ( devdefeitosemdesconto+ (devdefeitosemdesconto * 0.45) )
                                   - nvl(cobranca,0) )
                         from vw_balanco_cargas bc
                         where bc.idrepresentante = t.idrepresentante
                           and bc.idsemana        < t.idsemana )  saldoanterior
                     , cargacomdesconto
                     + ( cargamaissemdesconto + (cargamaissemdesconto * 0.45))
                     + cargamaiscomdesconto
                     + (cargasemdesconto     + (cargasemdesconto * 0.45))
                     - devolucaocomdesconto
                     - (devolucaosemdesconto + (devolucaosemdesconto * 0.45))
                     - devdefeitocomdesconto
                     - ( devdefeitosemdesconto+ (devdefeitosemdesconto * 0.45) )
                     - nvl(cobranca,0) resultadodasemana
                     
                     , t.valorinicialbalanco
                      + ( select sum(cargacomdesconto
                                   + ( cargamaissemdesconto + (cargamaissemdesconto * 0.45))
                                   + cargamaiscomdesconto
                                   + (cargasemdesconto     + (cargasemdesconto * 0.45))
                                   - devolucaocomdesconto
                                   - (devolucaosemdesconto + (devolucaosemdesconto * 0.45))
                                   - devdefeitocomdesconto
                                   - ( devdefeitosemdesconto+ (devdefeitosemdesconto * 0.45) )
                                   - nvl(cobranca,0) )
                         from vw_balanco_cargas bc
                         where bc.idrepresentante = t.idrepresentante
                           and bc.idsemana        < t.idsemana ) 
                           +cargacomdesconto
                           + ( cargamaissemdesconto + (cargamaissemdesconto * 0.45))
                           + cargamaiscomdesconto
                           + (cargasemdesconto     + (cargasemdesconto * 0.45))
                           - devolucaocomdesconto
                           - (devolucaosemdesconto + (devolucaosemdesconto * 0.45))
                           - devdefeitocomdesconto
                           - ( devdefeitosemdesconto+ (devdefeitosemdesconto * 0.45) )
                           - nvl(cobranca,0)  saldofinaldasemana
                    , ( select pck_romance.fnc_nomeregiaovenda(f.idregiaovenda)
                        from fechamentorepresentantes f
                        where f.idrepresentante = t.idrepresentante
                          and f.idfechamentopontuacao = (select ff.idfechamento
                                                         from fechamentossemanais ff
                                                         where ff.idfilial = :P0_IDFILIAL
                                                           and ff.semana = t.semana ) )regiaovenda
                from vw_balanco_cargas t
                where idfilial = :P0_IDFILIAL
                  and idrepresentante = :P267_IDREPRESENTANTE
                order by idsemana
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
