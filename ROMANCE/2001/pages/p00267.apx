        }
    )

    pageItem P267_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomepessoa(idpessoa) ||' - Semana Balanço: '|| pck_util.fnc_semanaid(r.idsemanabalanco) display_value
                     , idrepresentante return_value
                from representantes r
                where pck_romance.fnc_filialrepresentante(idrepresentante) = :P0_IDFILIAL
                  and ativo = 'S'
                order by 1 
                ```
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

