    dynamicAction periodo (
        name: Periodo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P758_PESQUISA_POR
        }
        clientSideCondition {
            type: item=value
            item: P758_PESQUISA_POR
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P758_IDSEMANA_INICIO
                    P758_IDSEMANA_FIM
