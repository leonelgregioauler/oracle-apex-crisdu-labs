page 758 (
    name: Notas com Redução de Comissão
    title: Notas com Redução de Comissão
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region lista-de-notas-com-redução-de-comissão (
        name: Lista de Notas com redução de Comissão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , nv.numeronota
                     , nv.datanota
                     , nv.perccomissao
                     , cn.dataclassificado
                     , pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(nv.idvendedora) consultora
                     , nv.valortotalnota
                     , nv.valortotaldevolucao
                     , nv.valortotalvenda
                     , nv.valorpago
                     , nv.saldo
                from notasvendas nv
                   , classificacoesnotasvendas cn
                where cn.idnotavenda = nv.idnotavenda
                  and cn.idcaracteristicanotavenda = 36
                  and nv.valorpago > 0 
                  and nv.saldo > 0 
                  and nv.perccomissao = 30
                  and nv.idfilial = :P0_IDFILIAL
                  and ( :P758_IDREPRESENTANTE is null or nv.idrepresentante = :P758_IDREPRESENTANTE )
                  and ( :P758_PESQUISA_POR is null
                     or ( :P758_PESQUISA_POR = 'S' and nv.idsemanacobranca = :P758_IDSEMANA )
                     or ( :P758_PESQUISA_POR = 'P' and nv.idsemanacobranca between :P758_IDSEMANA_INICIO and :P758_IDSEMANA_FIM ) )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P758_FILTRAR
            value: S
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros
        }
        advanced {
            savedReportMappingIdentifier: 3076126902813249838
        }

