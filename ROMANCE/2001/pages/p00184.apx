    region lista-de-produtos (
        name: Lista de Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select initcap(cc.nome) 
                         from categorias cc
                         where cc.idcategoria = p.idcategoria) Categoria
                     , p.idproduto
                     , initcap(p.nomeproduto) nomeproduto
                     , initcap(p.descrproduto) descrproduto
                     , p.codigosisdist "Referência"
                     , decode(p.ativo,'S','Sim','Não') "Ativo"
                     , decode(p.venda,'S','Sim','Não') "Venda"
                     , decode(p.comissao,'S','Sim','Não') "Comissão"
                     , ( select count(1)
                         from estoquefilial e
                         where e.idproduto = p.idproduto 
                           and ativo = 'S') utilizado
                     , ( select distinct listagg(pck_romance.fnc_nomefilial(idfilial)||' ( '||trim(to_char(e.vlrvenda,'999G990D00'))||' )',' ') within group ( order by 1 )
                         from estoquefilial e 
                         where e.idproduto = p.idproduto 
                           and ativo = 'S') empresas 
                     , initcap(usuariocadastrou) as "Usuário Cadastrou"
                     , p.dtinclusao datacadastro
                   /*  , ( select sum(it.quantidade)
                         from itensnotavenda it
                            , estoquefilial e
                         where it.idestoquefil = e.idestoquefilial 
                           and e.idproduto     = p.idproduto
                           and exists ( select 1
                                        from notasvendas n
                                        where n.idnotavenda = it.idnotavenda
                                          and n.idsituacaonotavenda = 3 ) ) totalnarua/*/
                from produtos p
                   , estoquefilial e
                where p.idcategoria != 141
                  and p.idproduto    = e.idproduto
                  and e.idfilial     = :P0_IDFILIAL
                 --  and exists ( select 1
                  ---              from estoquefilial e
                     --           where e.idproduto = p.idproduto )
                order by 1,3
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento in ( 0,1,2,6,20,19 )
                  and ug.usuario            = v('APP_USER')
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 186
                items: {
                    P186_IDPRODUTO: #IDPRODUTO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than 10,000 rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 84067823405400853
        }

