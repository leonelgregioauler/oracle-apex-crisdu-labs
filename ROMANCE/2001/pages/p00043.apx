    validation p43-idestoquefil (
        name: P43_IDESTOQUEFIL
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P43_IDESTOQUEFIL is not null or :P43_IDPRODUTO2 is not null
                ```
        }
        error {
            errorMessage: Informe o produto a ser movimentado.
            displayLocation: inlineInNotification
            associatedItem: @P43_IDESTOQUEFIL
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation valida-produto-ativo (
        name: valida produto ativo
        execution {
            sequence: 110
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from estoquefilial e
                where e.idestoquefilial = nvl(:P43_IDESTOQUEFIL,:P43_IDPRODUTO2)
                  and e.ativo = 'S'
                ```
        }
        error {
            errorMessage: Produto não pode ser Movimentado por estar INATIVO!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation valida-quantidade (
        name: Valida Quantidade >= 15
        execution {
            sequence: 120
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where  nvl(to_number(:P43_QTD_PP),0)
                     + nvl(to_number(:P43_QTD_P),0)
                     + nvl(to_number(:P43_QTD_M),0) 
                     + nvl(to_number(:P43_QTD_G),0) 
                     + nvl(to_number(:P43_QTD_GG),0) 
                     + nvl(to_number(:P43_QTD_EGG),0) 
                     + nvl(to_number(:P43_QTD_EXGG),0) 
                     + nvl(to_number(:P43_QTD_U),0) >= 15
                ```
        }
        error {
            errorMessage: Quantidade não permitida para movimentar o estoque! Registre um evento explicando o motivo dessa quantidade e solicitando liberação!
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2401,v('APP_USER')) = 'N'
                ```
        }
    )

    validation validar-quanitdade (
        name: Validar Quanitdade
        execution {
            sequence: 100
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(:P43_QTD_PP) >= 0
                  or to_number(:P43_QTD_P) >= 0
                  or to_number(:P43_QTD_M) >= 0
                  or to_number(:P43_QTD_G) >= 0
                  or to_number(:P43_QTD_GG) >= 0
                  or to_number(:P43_QTD_EGG) >= 0
                  or to_number(:P43_QTD_EXGG) >= 0
                  or to_number(:P43_QTD_U) >= 0
                ```
        }
        error {
            errorMessage: Informe uma quantidade Válida
            displayLocation: inlineInNotification
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P43_OPCAO = 'P' then
                      :P43_IDESTOQUEFIL := :P43_IDPRODUTO2;
                    end if;
                
                    if :P43_IDMOVTOESTOQUEFILIAL is null then
                      :P43_OBSERVACAO := 'Entrada manual. '||:P43_OBSERVACAO ;
                        select "SEQ_IDMOVTOESTOQUEFILIAL".nextval
                          into :P43_IDMOVTOESTOQUEFILIAL
                          from dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 19514686368932160
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

