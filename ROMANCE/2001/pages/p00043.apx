            errorMessage: Limite de entrada diária atingiu 50 unidades.
            associatedItem: @P43_QTD_M
        }
    )

    validation limiteentrada-qtd-p (
        name: LIMITEENTRADA_QTD_P
        execution {
            sequence: 40
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from movimentosestoquefilial m
                where m.idestoquefil = :P43_IDESTOQUEFIL
                and trunc(m.datamovimento) = to_date(sysdate,'dd/mm/rrrr')
                and m.qtd_p > 0
                and pck_romance.fnc_retornaparametro(parametro => 'LIMITEDECORRECAOESTOQUE',pidfilial => :P0_IDFILIAL) = 'S'
                having sum ( nvl(m.qtd_p,0) + nvl(to_number(:P43_QTD_PP),0) ) >= 50
                ```
        }
        error {
            errorMessage: Limite de entrada diária atingiu 50 unidades.
            associatedItem: @P43_QTD_P
        }
    )

