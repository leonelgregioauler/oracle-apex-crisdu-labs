    pageItem P43_IDPRODUTO2 (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select P.CODIGOSISDIST ||' - '|| initcap(p.nomeproduto) display_value
                     , e.idestoquefilial return_value
                from produtos      p
                   , estoquefilial e
                where e.idproduto = p.idproduto
                  and e.idfilial = :P0_IDFILIAL
                  and e.ativo = 'S'
                order by p.nomeproduto
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @entrada-de-estoque-da-filial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 10
        }
        security {
            encryptSessionState: false
        }
    )

