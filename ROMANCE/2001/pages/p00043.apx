    dynamicAction focus (
        name: focus
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P43_CODIGOSISDIST
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo (
        name: Tipo
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P43_OPCAO
        }
        clientSideCondition {
            type: item=value
            item: P43_OPCAO
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P43_CODIGOSISDIST
                    P43_IDESTOQUEFIL
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P43_IDPRODUTO2
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: P43_IDPRODUTO2
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value-2 (
            action: setValue
            affectedElements {
                selectionType: items
                items: [
                    P43_CODIGOSISDIST
                    P43_IDESTOQUEFIL
                ]
            }
            execution {
                sequence: 40
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P43_CODIGOSISDIST
                    P43_IDESTOQUEFIL
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P43_IDPRODUTO2
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

    )

    validation limiteentrada-qtd-egg (
        name: LIMITEENTRADA_QTD_EGG
        execution {
            sequence: 80
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from movimentosestoquefilial m
                where m.idestoquefil = :P43_IDESTOQUEFIL
                and trunc(m.datamovimento) = to_date(sysdate,'dd/mm/rrrr')
                and m.qtd_egg > 0
                and pck_romance.fnc_retornaparametro(parametro => 'LIMITEDECORRECAOESTOQUE',pidfilial => :P0_IDFILIAL) = 'S'
                having sum ( nvl(m.qtd_egg,0) + nvl(to_number(:P43_QTD_EGG),0) ) >= 50
                ```
        }
        error {
            errorMessage: Limite de entrada diária atingiu 50 unidades.
            associatedItem: @P43_QTD_EGG
        }
    )

