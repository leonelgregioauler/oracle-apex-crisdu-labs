page 43 (
    name: Entrada de Estoque da Filial
    title: Entrada de Estoque da Filial
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 70%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function confirmaitem(event)
            {
             var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
             console.log (tecla);
             if (tecla==13) 
             { 
              var answer = confirm("Confirma inclusão do item no estoque?")
              if (answer)
              {
                apex.submit('CREATE');
              }
             } 
              else 
              { if([190,188,110,194].indexOf(tecla) !=-1) 
                {
                 alert('Informe uma Quantidade Válida!'); 
                 return false;
                }
              }
            }
            
            function confirmaitem_br()
            {
              var answer = confirm("Confirma inclusão do item no estoque?")
              if (answer)
              {
                apex.submit('CREATE');
              }
            }
            
            function mudacampo()
            { 
              campo = document.getElementById('P43_CODIGOSISDIST');
              var length = campo.value.length;
              if (  (eval(campo.value.length) == "5") || (eval(campo.value.length) == "13") )
               {
                 document.getElementById('P43_QTD_U').focus();
               }
            }
            
            function tem_casas_decimais(valor)
            {
             if (typeof(valor) != 'String')
              valor = valor.toString();
            
             return valor.match(/[.,]/) != null;
            }
            ```
        executeWhenPageLoads: document.getElementById('P43_CODIGOSISDIST').focus;
    }
    css {
        inline: ".t-Region-body { background-color: Beige !important;}"
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region entrada-de-estoque-da-filial (
        name: Entrada de Estoque da Filial
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P43_CODIGOSISDIST (
        type: textField
        label {
            label: Produto
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @entrada-de-estoque-da-filial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 13
        }
        validation {
            maxLength: 4000
        }
        advanced {
            customAttributes: style="text-align:right" onkeyup ="mudacampo();"
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P43_DATAMOVIMENTO (
        type: hidden
        layout {
            sequence: 250
            region: @entrada-de-estoque-da-filial
            slot: regionBody
        }
        source {
            type: databaseColumn
