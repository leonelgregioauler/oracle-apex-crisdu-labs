    region ranking-de-novas-consultoras-no-período-por-empresa (
        name: Ranking de Novas Consultoras no Período por Empresa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.empresa
                     , e.distribuidor
                     , sum(e.qtd) qtd
                  from vw_biroman382rankingnovasconsulempresa_m e
                 where e.datalogin between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                   and ((:P0_IDFILIAL = -1 and e.idgrupo in (1,2,3,4,5)) -- TODAS AS FILIAIS
                    or  (:P0_IDFILIAL = -2 and e.idgrupo in(1,2,3,4)) -- FILIAIS DO BRASIL
                    or  (:P0_IDFILIAL = -3 and e.idgrupo = 5) -- FILIAIS DA AMÉRICA LATINA
                    or (e.idfilial = :P0_IDFILIAL )) -- POR FILIAL
                 group by e.empresa
                        , e.distribuidor
                 order by e.distribuidor desc
                
                
                
                
                /* OLD
                
                select pck_romance.fnc_nomefilial(e.idfilial) empresa
                     , pck_romance.fnc_nomerepresentante(v.idrepresentante) distribuidor
                     , count( distinct v.idvendedora) qtd
                from registrosloginminhasacola e
                   , vendedoras                v
                where v.idvendedora      = e.idvendedora 
                  and e.primeirologin    = 'S'
                  and v.ativo = 'S'
                  and e.datalogin between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and ((:P0_IDFILIAL = -1 and e.idgrupo in (1,2,3,4,5)) -- TODAS AS FILIAIS
                    or (:P0_IDFILIAL = -2 and e.idgrupo in(1,2,3,4)) -- FILIAIS DO BRASIL
                    or (:P0_IDFILIAL = -3 and e.idgrupo = 5) -- FILIAIS DA AMÉRICA LATINA
                    or (e.idfilial = :P0_IDFILIAL )) -- POR FILIAL
                group by v.idrepresentante
                       , e.idfilial
                order by 2 desc
                */
                ```
            pageItemsToSubmit: [
                P382_DATAINICIO
                P382_DATAFIM
            ]
        }
        layout {
            sequence: 150
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
