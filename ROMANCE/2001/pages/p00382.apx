    pageItem P382_RECORDE35DIAS (
        type: displayOnly
        label {
            label: Recorde 35 dias
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @evolução-da-adesão-35-dias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(sequencia,'DD/MM/RRRR')||' - '|| qtd||' consultoras' valor
                from (
                select trunc(datalogin) sequencia 
                     , count(1) qtd
                from registrosloginminhasacola r
                where primeirologin = 'S'
                  and datalogin >= trunc(sysdate) - 35
                  and (:P0_IDFILIAL = -1 or r.idfilial = :P0_IDFILIAL)
                group by trunc(datalogin) 
                ORDER BY 2 desc )
                where rownum=1
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

