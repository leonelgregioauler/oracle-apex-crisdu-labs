    region lista (
        name: Lista
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select descricao
                     , trim(to_char(sum(quantidade),'999G999G990'))  quantidade
                     , ordem
                from vw_biroman382usabilidade_m r
                where ((:P0_IDFILIAL = -1 and r.idgrupo in (1,2,3,4,5)) -- TODAS AS FILIAIS
                    or (:P0_IDFILIAL = -2 and r.idgrupo in(1,2,3,4)) -- FILIAIS DO BRASIL
                    or (:P0_IDFILIAL = -3 and r.idgrupo = 5) -- FILIAIS DA AMÉRICA LATINA
                    or (r.idfilial = :P0_IDFILIAL )) -- POR FILIAL
                group by descricao,
                         ordem
                order by ordem
                
                
                
                
                /* OLD
                select descricao
                    , quantidade
                from (    
                        select 'Consultoras Possiveis' descricao
                             , trim(to_char(count(distinct idvendedora),'999G999G990'))  quantidade
                            , 1 ordem
                        from notasvendas r 
                        where r.idsituacaonotavenda = 3 
                          and ( :P0_IDFILIAL = -1 
                             or ( :P0_IDFILIAL > 0 and r.idfilial = :P0_IDFILIAL ) )
                        union all
                        select 'Compartilharam nos últimos 42 dias' descricao
                             , trim(to_char(count(distinct e.idvendedora),'999G999G990'))  quantidade
                            , 2
                        from registroscompartilhafotos e
                        where e.datacompartilhamento > sysdate- 42   
                          and ( :P0_IDFILIAL = -1 
                             or ( :P0_IDFILIAL > 0 and e.idfilial = :P0_IDFILIAL ) )
                        union all    
                        select 'Logaram nos últimos 42 dias' descricao
                             , trim(to_char(count(distinct e.idvendedora),'999G999G990'))  quantidade
                            , 3
                        from registrosloginminhasacola e
                        where e.datalogin > sysdate- 42   
                          and ( :P0_IDFILIAL = -1 
                             or ( :P0_IDFILIAL > 0 and e.idfilial = :P0_IDFILIAL ) )
                        union all                     
                        select 'Fotos Compartilhadas' descricao
                             , trim(to_char(count(1),'999G999G990'))  quantidade
                            , 4
                        from registroscompartilhafotos rr
                        where ( :P0_IDFILIAL = -1 
                             or ( :P0_IDFILIAL > 0 and rr.idfilial = :P0_IDFILIAL ) )
                        union all
                        select 'Uso do Vendas nos últimos 42 dias' descricao
                             , trim(to_char(count(distinct nv.idvendedora),'999G999G990'))  quantidade
                             , 5
                        from notasvendasapp nv 
                      where nv.dataatualizacao  > sysdate- 42  
                          and ( :P0_IDFILIAL = -1 
                             or ( :P0_IDFILIAL > 0 and nv.idfilial = :P0_IDFILIAL ) )
                         )
                order by ordem
                */
                ```
            pageItemsToSubmit: P0_IDFILIAL
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DESCRICAO
            valueColumn: QUANTIDADE
            layout: 5Columns
        }
    )

    region lista-2 (
        name: Lista
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select descricao, 
                       trim(to_char(sum(quantidade),'999G999G990'))  quantidade
                  from roman.VW_BIROMAN382ATENDIMENTOS_M r
                 where ((:P0_IDFILIAL = -1 and r.idgrupo in (1,2,3,4,5)) -- TODAS AS FILIAIS
                    or  (:P0_IDFILIAL = -2 and r.idgrupo in(1,2,3,4)) -- FILIAIS DO BRASIL
                    or  (:P0_IDFILIAL = -3 and r.idgrupo = 5) -- FILIAIS DA AMÉRICA LATINA
                    or  (r.idfilial = :P0_IDFILIAL )) -- POR FILIAL
                 group by descricao
                 order by descricao
                
                
                
                
                /* OLD
                select '0 - Atendimento Em Dia' descricao
                     , trim(to_char(count(distinct idvendedora),'999G999G990'))  quantidade
                from notasvendas n
                   , filiais  f
                where n.dataretornoorig     > sysdate-7 
                  and n.idsituacaonotavenda = 3      
                  and f.idfilial = n.idfilial
                  and f.ativo    = 'S'                      
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = n.idrepresentante
                                 and r.ativo           = 'S' )
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and f.idgrupo != 5 ) 
                     or ( :P0_IDFILIAL = -3 and f.idgrupo  = 5 ) 
                     or ( :P0_IDFILIAL > 0 and f.idfilial = :P0_IDFILIAL ) )
                union all
                select '1 - Atrasadas a MENOS de 42 dias' descricao
                     , trim(to_char(count(distinct idvendedora),'999G999G990'))  quantidade
                from notasvendas n
                   , filiais  f
                where n.dataretornoorig     between sysdate-41 and sysdate-7
                  and n.idsituacaonotavenda = 3        
                  and f.idfilial = n.idfilial
                  and f.ativo    = 'S'               
                  and n.idsemanacobranca - n.idsemanadistribuicao > 6                    
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = n.idrepresentante
                                 and r.ativo           = 'S' )
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and f.idgrupo != 5 ) 
                     or ( :P0_IDFILIAL = -3 and f.idgrupo  = 5 ) 
                     or ( :P0_IDFILIAL > 0 and f.idfilial = :P0_IDFILIAL ) )
                union all
                select '2 - Atrasados ENTRE 42 e 90 dias' descricao
                     , trim(to_char(count(distinct idvendedora),'999G999G990'))  quantidade
                from notasvendas n
                   , filiais  f
                where n.dataretornoorig     between sysdate-90 AND sysdate-42 
                  and n.idsituacaonotavenda = 3    
                  and f.idfilial = n.idfilial
                  and f.ativo    = 'S'                      
                  and n.idsemanacobranca - n.idsemanadistribuicao > 6               
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = n.idrepresentante
                                 and r.ativo           = 'S' )
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and f.idgrupo != 5 ) 
                     or ( :P0_IDFILIAL = -3 and f.idgrupo  = 5 ) 
                     or ( :P0_IDFILIAL > 0 and f.idfilial = :P0_IDFILIAL ) )
                union all
                select '3 - Atrasados a MAIS de 90 dias' descricao
                     , trim(to_char(count(distinct idvendedora),'999G999G990'))  quantidade
                from notasvendas n
                   , filiais  f
                where n.dataretornoorig     <= sysdate-90
                  and n.idsituacaonotavenda = 3   
                  and f.idfilial = n.idfilial
                  and f.ativo    = 'S'                          
                  and n.idsemanacobranca - n.idsemanadistribuicao > 6
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = n.idrepresentante
                                 and r.ativo           = 'S' )
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and f.idgrupo != 5 ) 
                     or ( :P0_IDFILIAL = -3 and f.idgrupo  = 5 ) 
                     or ( :P0_IDFILIAL > 0 and f.idfilial = :P0_IDFILIAL ) )
                union all
                select '4 - Sem programação de atendimento' descricao
                     , trim(to_char(count(distinct idvendedora),'999G999G990'))  quantidade
                from notasvendas n
                   , filiais  f
                where n.idsituacaonotavenda = 3     
                  and f.idfilial = n.idfilial
                  and f.ativo    = 'S'                     
                  and n.idrepresentanteatende is null    
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = n.idrepresentante
                                 and r.ativo           = 'N' )
                  and ( :P0_IDFILIAL = -1 
                     or ( :P0_IDFILIAL = -2 and f.idgrupo != 5 ) 
                     or ( :P0_IDFILIAL = -3 and f.idgrupo  = 5 ) 
                     or ( :P0_IDFILIAL > 0 and f.idfilial = :P0_IDFILIAL ) )
                     
                     
                */
                ```
            pageItemsToSubmit: P0_IDFILIAL
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DESCRICAO
            valueColumn: QUANTIDADE
            layout: 5Columns
        }
    )

    region logins-no-período (
        name: Logins no Período
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.consultora
                     , r.distribuidor
                     , sum(qtdcompartilhamento) qtdcompartilhamento
                     , ( select nvl(cpf,documentoestrangeiro) from pessoas p  where p.idpessoa = r.idpessoa) cpf
                  from vw_biroman382loginsperiodo_m r
                 where r.datalogin between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                   and r.idfilial = :P0_IDFILIAL 
                 group by r.consultora
                        , r.distribuidor
                        , r.idpessoa
                 order by qtdcompartilhamento desc
                
                
                
                
                
                /* OLD
                select pck_romance.fnc_nomevendedora(r.idvendedora)  consultora
                     , pck_romance.fnc_nomerepresentante(v.idrepresentante)  distribuidor
                     , count(1) qtdcompartilhamento    
                     , ( select nvl(cpf,documentoestrangeiro) from pessoas p  where p.idpessoa = v.idpessoa) cpf
                from registrosloginminhasacola r
                   , vendedoras                v    
                where v.idvendedora     = r.idvendedora
                  and v.ativo           = 'S'
                  and datalogin between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and r.idfilial = :P0_IDFILIAL 
                group by r.idvendedora 
                       , v.idrepresentante
                       , v.idpessoa
                order by 3 desc
                */
                ```
            pageItemsToSubmit: [
                P382_DATAINICIO
                P382_DATAFIM
                P0_IDFILIAL
            ]
        }
