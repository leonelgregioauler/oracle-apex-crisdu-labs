    region utilização-por-distribuidor-suelen (
        name: Utilização por Distribuidor (SUELEN)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  p.empresa  "EMPRESA"
                      , p.representante "DISTRIBUIDOR"
                      , p.total "QTD EMPREENDEDORAS"
                      , p.acesso "QTD ACESSOS"
                      , p.perc "PERCENTUAL"
                from ( select x.empresa 
                            , x.representante 
                            , x.total 
                            , a.acesso 
                            , round((( a.acesso / x.total)*100),2) perc
                        from ( select roman.pck_romance.fnc_nomefilial(v.idfilial) empresa
                                    , roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) representante
                                    , count ( v.idvendedora)total
                                    , v.idrepresentante
                               from catal.vendedoras v
                                  , catal.representantes r
                               where r.idrepresentante = v.idrepresentante
                                 and v.idfilial = :P0_IDFILIAL
                                 and v.ativo = 'S'
                                 and r.ativo = 'S'
                                 and not exists ( select 1
                                                  from catal.funcionarios f
                                                  where f.idpessoa = v.idpessoa )
                               group by  v.idrepresentante,v.idfilial ) x
                            ,( select roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) representante
                                    , count (distinct l.idvendedora) acesso
                                    , v.idrepresentante
                               from roman.registrosloginminhasacola l
                                  , catal.vendedoras v
                               where v.idvendedora = l.idvendedora
                                 and l.datalogin between to_date(:P382_DATAINICIO||' 00:00:00', 'DD/MM/RRRR HH24:MI:SS') and to_date(:P382_DATAFIM||' 23:59:59', 'DD/MM/RRRR HH24:MI:SS')
                                -- and l.datalogin between to_date ('01/01/2025 00:00:00','dd/mm/yyyy hh24:mi:ss') and to_date ('31/12/2025 23:59:59','dd/mm/yyyy hh24:mi:ss')
                                 and l.idfilial = :P0_IDFILIAL
                                 and v.ativo  = 'S'
                                 and not exists ( select 1
                                                  from catal.representantes rp
                                                  where rp.idpessoa = v.idpessoa )
                                 and not exists ( select 1 
                                                  from catal.gerentes g
                                                  where g.idpessoa = v.idpessoa )
                               group by  v.idrepresentante )a
                       where x.idrepresentante = a.idrepresentante
                       group by x.representante,x.empresa,x.total, a.acesso) p
                --where p.perc >= 80
                --order by 2, 5 desc
                ```
            pageItemsToSubmit: [
                P382_DATAINICIO
                P382_DATAFIM
                P0_IDFILIAL
            ]
        }
        layout {
            sequence: 180
            slot: body
            startNewRow: false
        }
