    region por-empresa-compartilhamento-brasil-42-dias (
        name: "% por Empresa - Compartilhamento [Brasil] - 42 dias"
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select 'Esperado - '||consultoras||' - 100%' empresa
                     , consultoras
                     , consultoras consultorasapp
                     , 100 perc
                from ( select  count(distinct idvendedora) consultoras
                        from notasvendas n
                        where n.idsituacaonotavenda = 3
                          and exists ( select 1
                                       from filiais f
                                       where f.idfilial = n.idfilial
                                         and f.ididioma = 1 )  )
                union all
                select pck_romance.fnc_nomefilial(nota.idfilial)||' - '||consultoras||'/'||consultorasapp||' - '|| case 
                                                                                 when consultorasapp > 0 then
                                                                                   round(( consultorasapp * 100 ) / consultoras ,2)
                                                                                 else 
                                                                                   0
                                                                                 end||'%'   empresa
                     , consultoras
                     , consultorasapp
                     , case 
                         when consultorasapp > 0 then
                           round(( consultorasapp * 100 ) / consultoras )
                         else 
                           0
                         end perc
                from ( select n.idfilial   
                           , count(distinct n.idvendedora) consultoras
                        from notasvendas n
                        where n.idsituacaonotavenda = 3  
                          and exists ( select 1
                                       from filiais f
                                       where f.idfilial = n.idfilial
                                         and f.ididioma = 1 ) 
                        group by n.idfilial )    nota
                   , ( select r.idfilial   
                           , count(distinct r.idvendedora ) consultorasapp
                        from registroscompartilhafotos r
                        where r.datacompartilhamento   >= sysdate -42 
                          and exists ( select 1 
                                       from vendedoras v 
                                       where v.idvendedora = r.idvendedora 
                                       and v.ativo = 'S' )
                        group by r.idfilial ) comp
                where nota.idfilial = comp.idfilial                
                union all
                select 'Geral - '||consultoras||'/'||consultorasapp||' - '|| case 
                                                                                 when consultorasapp > 0 then
                                                                                   round(( consultorasapp * 100 ) / consultoras ,2)
                                                                                 else 
                                                                                   0
                                                                                 end||'%'   empresa
                     , consultoras
                     , consultorasapp
                     , case 
                         when consultorasapp > 0 then
                           round(( consultorasapp * 100 ) / consultoras )
                         else 
                           0
                         end perc
                from ( select count(distinct n.idvendedora) consultoras
                        from notasvendas n
                        where n.idsituacaonotavenda = 3 
                          and exists ( select 1
                                       from filiais f
                                       where f.idfilial = n.idfilial
                                         and f.ididioma = 1 )  )    nota
                   , ( select  count(distinct r.idvendedora ) consultorasapp
                        from registroscompartilhafotos r
                        where r.datacompartilhamento   >= sysdate -42 
                          and exists ( select 1 
                                       from vendedoras v 
                                          , filiais    f
                                       where v.idvendedora = r.idvendedora  
                                         and v.idfilial    = f.idfilial
                                         and f.ididioma    = 1
                                         and v.ativo = 'S' )  ) comp       
                order by 4 desc        
                
                ```
        }
        layout {
            sequence: 80
            slot: body
            columnSpan: 3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: PERC
            colorScheme: modern2
            maximumRows: 50
        }
    )

    region por-empresa-compartilhamento-exterior-42-dias (
