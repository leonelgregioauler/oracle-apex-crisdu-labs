    region compartilhamento-de-fotos-no-período (
        name: Compartilhamento de Fotos no Período
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(r.idvendedora)  consultora
                     , pck_romance.fnc_nomerepresentante(v.idrepresentante)  distribuidor
                     , count(1) qtdcompartilhamento             
                from registroscompartilhafotos r
                   , vendedoras                v    
                where v.idvendedora     = r.idvendedora
                  and v.ativo           = 'S'
                  and r.datacompartilhamento between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and r.idfilial = :P0_IDFILIAL 
                group by r.idvendedora 
                       , v.idrepresentante 
                order by 3 desc
                ```
            pageItemsToSubmit: [
                P382_DATAINICIO
                P382_DATAFIM
                P0_IDFILIAL
            ]
        }
        layout {
            sequence: 200
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 11778099780574885568
        }

