    region por-empresa-login-brasil-42-dias (
        name: "% por Empresa - Login [Brasil] - 42 dias"
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                 select empresa
                      , consultoras
                      , consultoras consultorasapp
                      , perc
                 from vw_biroman382loginempresa_m
                order by perc desc
                
                
                
                
                
                /* old
                select 'Esperado - '||consultoras||' - 100%' empresa
                     , consultoras
                     , consultoras consultorasapp
                     , 100 perc
                from (select sum(consultoras) consultoras 
                      from (select v.idfilial, count(1) consultoras
                            from vendedoras v
                                ,representantes r
                            where v.idrepresentante = r.idrepresentante
                              and v.ativo           = 'S'
                              and r.ativo           = 'S'
                              and v.idfilial       != 1217
                              and exists ( select 1
                                          from filiais f
                                          where f.idfilial = v.idfilial
                                            and f.ididioma = 1
                                            and f.ativo = 'S' )                   
                             and not exists ( select 1
                                              from representantes rr
                                              where rr.idpessoa = v.idpessoa )
                             and not exists ( select 1
                                              from gerentes g
                                              where g.idpessoa = v.idpessoa )
                             and not exists ( select 1
                                              from funcionarios f
                                              where f.idpessoa = v.idpessoa )
                             group by v.idfilial 
                             union
                             select  n.idfilial, count(distinct n.idvendedora) consultoras
                              from roman.notasvendas n
                              where  n.idsituacaonotavenda = 3
                                and  n.idfilial            = 1217
                                and exists ( select 1
                                             from catal.filiais f
                                             where f.idfilial = n.idfilial
                                               and f.ididioma = 1
                                               and f.ativo = 'S' )
                              group by n.idfilial))
                union
                select roman.pck_romance.fnc_nomefilial(nota.idfilial)||' - '||nota.consultoras||'/'||consultorasapp||' - '|| case 
                                                                                 when consultorasapp > 0 then
                                                                                   round(( consultorasapp * 100 ) / consultoras ,2)
                                                                                 else 
                                                                                   0
                                                                                 end||'%'   empresa
                     , nota.consultoras
                     , consultorasapp
                     , case 
                         when consultorasapp > 0 then
                           round(( consultorasapp * 100 ) / consultoras )
                         else 
                           0
                         end perc
                from (select v.idfilial, count(1) consultoras
                      from vendedoras v
                          ,representantes r
                      where v.idrepresentante = r.idrepresentante
                        and v.ativo           = 'S'
                        and r.ativo           = 'S'
                        and v.idfilial       != 1217
                        and exists ( select 1
                                    from filiais f
                                    where f.idfilial = v.idfilial
                                      and f.ididioma = 1
                                      and f.ativo = 'S' )                   
                       and not exists ( select 1
                                        from representantes rr
                                        where rr.idpessoa = v.idpessoa )
                       and not exists ( select 1
                                        from gerentes g
                                        where g.idpessoa = v.idpessoa )
                       and not exists ( select 1
                                        from funcionarios f
                                        where f.idpessoa = v.idpessoa )
                       group by v.idfilial 
                       union
                       select  n.idfilial, count(distinct n.idvendedora) consultoras
                        from roman.notasvendas n
                        where  n.idsituacaonotavenda = 3
                          and  n.idfilial            = 1217
                          and exists ( select 1
                                       from catal.filiais f
                                       where f.idfilial = n.idfilial
                                         and f.ididioma = 1
                                         and f.ativo = 'S' )
                        group by n.idfilial) nota
                    ,( select e.idfilial, count( distinct v.idvendedora) consultorasapp
                                 from registrosloginminhasacola e
                                    , vendedoras                v
                                    , representantes            r
                                 where v.idrepresentante = r.idrepresentante
                                   and v.idvendedora     = e.idvendedora 
                                   and v.ativo           = 'S'
                                   and r.ativo           = 'S'
                                   and e.idfilial       != 1217
                                   and e.datalogin >= sysdate- 42
                                    and exists ( select 1
                                                from filiais f
                                                where f.idfilial = v.idfilial
                                                  and f.ididioma = 1
                                                  and f.ativo = 'S' )                   
                                   and not exists ( select 1
                                                    from representantes rr
                                                    where rr.idpessoa = v.idpessoa ) 
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa )
                          Group by e.idfilial
                          union
                          select r.idfilial   
                               , count(distinct r.idvendedora ) consultorasapp
                            from roman.registrosloginminhasacola  r
                            where r.datalogin   >= sysdate -42
                              and r.idfilial    = 1217
                              and exists ( select 1
                                           from vendedoras v 
                                              , filiais    f
                                           where v.idvendedora = r.idvendedora  
                                             and v.idfilial    = f.idfilial
                                             and f.ididioma    = 1
                                             and v.ativo = 'S'
                                             and f.ativo = 'S' )
                                       and not exists ( select 1
                                                        from representantes rr
                                                        where rr.idpessoa = ( select idpessoa
                                                                            from   vendedoras
                                                                            where  idvendedora = r.idvendedora) ) 
                                       and not exists ( select 1
                                                        from gerentes g
                                                        where g.idpessoa = ( select idpessoa
                                                                            from   vendedoras
                                                                            where  idvendedora = r.idvendedora) )
                                       and not exists ( select 1
                                                        from funcionarios f
                                                        where f.idpessoa = ( select idpessoa
                                                                            from   vendedoras
                                                                            where  idvendedora = r.idvendedora) )
                            group by r.idfilial ) comp
                where nota.idfilial = comp.idfilial                
                union
                select 'Geral - '||consultoras||'/'||consultorasapp||' - '|| case 
                                                                                 when consultorasapp > 0 then
                                                                                   round(( consultorasapp * 100 ) / consultoras ,2)
                                                                                 else 
                                                                                   0
                                                                                 end||'%'   empresa
                     , consultoras
                     , consultorasapp
                     , case 
                         when consultorasapp > 0 then
                           round(( consultorasapp * 100 ) / consultoras )
                         else 
                           0
                         end perc
                from (select sum(consultoras1) consultoras, sum(consultorasapp1) consultorasapp
                from (select v.idfilial, count(1) consultoras1
                      from vendedoras v
                          ,representantes r
                      where v.idrepresentante = r.idrepresentante
                        and v.ativo           = 'S'
                        and r.ativo           = 'S'
                        and v.idfilial       != 1217
                        and exists ( select 1
                                    from filiais f
                                    where f.idfilial = v.idfilial
                                      and f.ididioma = 1
                                      and f.ativo = 'S' )                   
                       and not exists ( select 1
                                        from representantes rr
                                        where rr.idpessoa = v.idpessoa )
                       and not exists ( select 1
                                        from gerentes g
                                        where g.idpessoa = v.idpessoa )
                       and not exists ( select 1
                                        from funcionarios f
                                        where f.idpessoa = v.idpessoa )
                       group by v.idfilial 
                       union
                       select  n.idfilial, count(distinct n.idvendedora) consultoras
                        from roman.notasvendas n
                        where  n.idsituacaonotavenda = 3
                          and  n.idfilial            = 1217
                          and exists ( select 1
                                       from catal.filiais f
                                       where f.idfilial = n.idfilial
                                         and f.ididioma = 1
                                         and f.ativo = 'S' )
                        group by n.idfilial) nota
                    ,( select e.idfilial, count( distinct v.idvendedora) consultorasapp1
                                 from registrosloginminhasacola e
                                    , vendedoras                v
                                    , representantes            r
                                 where v.idrepresentante = r.idrepresentante
                                   and v.idvendedora     = e.idvendedora 
                                   and v.ativo           = 'S'
                                   and r.ativo           = 'S'
                                   and v.idfilial       != 1217
                                   and e.datalogin >= sysdate- 42
                                    and exists ( select 1
                                                from filiais f
                                                where f.idfilial = v.idfilial
                                                  and f.ididioma = 1
                                                  and f.ativo = 'S' )                   
                                   and not exists ( select 1
                                                    from representantes rr
                                                    where rr.idpessoa = v.idpessoa ) 
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa )
                          Group by e.idfilial
                          union
                          select r.idfilial, count(distinct r.idvendedora ) consultorasapp1
                          from roman.registrosloginminhasacola  r
                          where r.datalogin   >= sysdate -42
                            and r.idfilial     = 1217
                            and exists ( select 1
                                         from catal.vendedoras v 
                                            , catal.filiais    f
                                         where v.idvendedora = r.idvendedora  
                                           and v.idfilial    = f.idfilial
                                           and f.ididioma    = 1
                                           and v.ativo = 'S' 
                                           and f.ativo = 'S')
                                     and not exists ( select 1
                                                      from representantes rr
                                                      where rr.idpessoa = ( select idpessoa
                                                                          from   vendedoras
                                                                          where  idvendedora = r.idvendedora) ) 
                                     and not exists ( select 1
                                                      from gerentes g
                                                      where g.idpessoa = ( select idpessoa
                                                                          from   vendedoras
                                                                          where  idvendedora = r.idvendedora) )
                                     and not exists ( select 1
                                                      from funcionarios f
                                                      where f.idpessoa = ( select idpessoa
                                                                          from   vendedoras
                                                                          where  idvendedora = r.idvendedora) )
                        group by r.idfilial)   comp   
                        where nota.idfilial = comp.idfilial(+) )
                order by 4 desc
                
                */
                ```
        }
        layout {
            sequence: 100
            slot: body
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: PERC
            colorScheme: modern2
            maximumRows: 50
        }
    )

