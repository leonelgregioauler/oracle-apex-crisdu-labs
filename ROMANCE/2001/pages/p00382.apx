    region compartilhamentos-e-logins-por-semana-90-dias (
        name: Compartilhamentos e Logins por Semana - 90 dias
        type: chart
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: lineWithArea
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        legend {
            show: false
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select informacao
                         , semana 
                         , sum(quantidade) quantidade
                         , idsemana
                    from vw_biroman382loginsemana_m r
                    where   ((:P0_IDFILIAL = -1 and r.idgrupo in (1,2,3,4,5)) -- TODAS AS FILIAIS
                        or (:P0_IDFILIAL = -2 and r.idgrupo in(1,2,3,4)) -- FILIAIS DO BRASIL
                        or (:P0_IDFILIAL = -3 and r.idgrupo = 5) -- FILIAIS DA AMÉRICA LATINA
                        or (r.idfilial = :P0_IDFILIAL )) -- POR FILIAL
                    group by informacao,
                             semana,
                             r.idsemana  
                             
                             
                             
                             
                             
                    /* OLD         
                    select 'Total de Compartilhamentos'  informacao
                         , to_number(substr(pck_util.fnc_semanaid(r.idsemana   ),4,4)||substr(pck_util.fnc_semanaid(r.idsemana   ),1,2)) semana 
                         , count(1) quantidade 
                         , r.idsemana
                    from registroscompartilhafotos r
                       , vw_filiais                f
                    where r.datacompartilhamento > sysdate-90
                      and f.idfilial             = r.idfilial
                      and f.ativo                = 'S'    
                      and ( :P0_IDFILIAL = -1 
                         or ( :P0_IDFILIAL = -2 and f.idgrupo != 5  )
                         or ( :P0_IDFILIAL = -3 and f.idgrupo  = 5  )
                         or ( :P0_IDFILIAL >  0 and r.idfilial = :P0_IDFILIAL ) ) 
                    group by r.idsemana  
                    union all
                    select 'Consultoras que Compartilharam'  informacao
                         , to_number(substr(pck_util.fnc_semanaid(r.idsemana   ),4,4)||substr(pck_util.fnc_semanaid(r.idsemana   ),1,2)) semana 
                         , count(distinct r.idvendedora) qtdunico 
                         , r.idsemana
                    from registroscompartilhafotos r  
                       , vw_filiais f
                    where f.idfilial             = r.idfilial    
                      and f.ativo                = 'S'
                      and r.datacompartilhamento > sysdate-90    
                      and ( :P0_IDFILIAL = -1 
                         or ( :P0_IDFILIAL = -2 and f.idgrupo != 5  )
                         or ( :P0_IDFILIAL = -3 and f.idgrupo  = 5  )
                         or ( :P0_IDFILIAL > 0  and r.idfilial = :P0_IDFILIAL ) )  
                    group by r.idsemana  
                    union all
                    select 'Total de Logins '  informacao
                         , to_number(substr(pck_util.fnc_semanaid(r.idsemana   ),4,4)||substr(pck_util.fnc_semanaid(r.idsemana   ),1,2)) semana 
                         , count( 1) qtdunico 
                         , r.idsemana
                    from registrosloginminhasacola r
                       , vw_filiais                f
                    where f.idfilial = r.idfilial
                      and r.datalogin > sysdate-90  
                      and f.ativo    = 'S'           
                      and ( :P0_IDFILIAL = -1 
                         or ( :P0_IDFILIAL = -2 and f.idgrupo != 5  )
                         or ( :P0_IDFILIAL = -3 and f.idgrupo  = 5  )
                         or ( :P0_IDFILIAL > 0 and r.idfilial = :P0_IDFILIAL ) ) 
                    group by r.idsemana  
                    union all
                    select 'Logins únicos'  informacao
                         , to_number(substr(pck_util.fnc_semanaid(r.idsemana   ),4,4)||substr(pck_util.fnc_semanaid(r.idsemana   ),1,2)) semana 
                         , count(distinct r.idvendedora) qtdunico 
                         , r.idsemana
                    from registrosloginminhasacola r
                       , vw_filiais                f
                    where r.datalogin > sysdate-90      
                      and f.idfilial = r.idfilial
                      and f.ativo    = 'S'
                      and ( :P0_IDFILIAL = -1 
                         or ( :P0_IDFILIAL = -2 and f.idgrupo != 5 ) 
                         or ( :P0_IDFILIAL = -3 and f.idgrupo  = 5 )
                         or ( :P0_IDFILIAL > 0 and r.idfilial = :P0_IDFILIAL ) ) 
                    group by r.idsemana
                    */
                    ```
            }
            columnMapping {
                seriesName: INFORMACAO
                label: SEMANA
                value: QUANTIDADE
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
