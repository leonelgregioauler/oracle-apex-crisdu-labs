        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region consultoras-que-entraram-pela-primeira-vez-no-período (
        name: Consultoras que Entraram pela Primeira vez no Período
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(r.idvendedora)  consultora
                     , pck_romance.fnc_nomerepresentante(v.idrepresentante)  distribuidor
                     , r.datalogin
                     , ( select count(1) qtd
                         from registroscompartilhafotos f
                         where f.idvendedora = r.idvendedora
                           and f.datacompartilhamento between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')) qtdcompartilhamento
                     , v.idvendedora
                     , r.versaoaplicativo
                from registrosloginminhasacola r
                   , vendedoras                v 
                where v.idvendedora     = r.idvendedora 
                  and primeirologin     = 'S' 
                  and r.datalogin  between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and r.idfilial =  :P0_IDFILIAL  
                order by 3 desc
                ```
            pageItemsToSubmit: [
                P382_DATAINICIO
                P382_DATAFIM
            ]
        }
        layout {
