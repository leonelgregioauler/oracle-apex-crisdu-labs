    region distribuidor-que-não-baixaram (
        name: Distribuidor que não baixaram
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(g.idfilial) empresa
                     , pck_romance.fnc_nomepessoa(r.idpessoa) distribuidor
                from representantes            r
                   , gerentes g
                where r.ativo = 'S'
                  and r.idgerente = g.idgerente
                  and not exists ( select 1 from gerentes gg where gg.idpessoa = r.idpessoa )
                  and g.idfilial = :P0_IDFILIAL 
                  and not exists ( select 1
                                   from registrosloginminhasacola e
                                      , vendedoras                v
                                   where e.idvendedora = v.idvendedora
                                     and v.idrepresentante = r.idrepresentante
                                     and e.primeirologin    = 'S' 
                                     and e.datalogin between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                order by 1,2
                ```
            pageItemsToSubmit: P0_IDFILIAL
        }
        layout {
            sequence: 160
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 11545268889470547762
        }

