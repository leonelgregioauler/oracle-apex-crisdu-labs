    dynamicAction tipo-de-filtro (
        name: Tipo de Filtro
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P382_FILTRAR
        }
        clientSideCondition {
            type: item=value
            item: P382_FILTRAR
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P382_DATAINICIO
                    P382_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @utilização-por-distribuidor
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
                fireOnInit: false
