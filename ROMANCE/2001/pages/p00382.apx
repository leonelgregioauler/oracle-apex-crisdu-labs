    region utilização-por-distribuidor (
        name: Utilização por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select empresa
                     , distribuidor
                     , consultoras
                     , consultorasapp
                     /* Maicon Aimi - 9211254 - 09/07/2024
                     , case
                         when consultorasapp > 0 and consultoras > 0 then
                           (consultorasapp*100/consultoras)
                         else 
                           0
                       end  perc
                       */
                     , consultorasacesso
                     , case
                         when consultorasacesso > 0 and consultoras > 0 then
                           round((consultorasacesso*100/consultoras))--||'%'
                         else 
                           0--||'%'
                       end  perc_acc
                     , qtdcompartilhamento
                     , consultorasappfiltrodata
                     , idrepresentante
                     , qtdnotasvendas 
                     , case
                         when qtdnotasvendas > 0 and consultoras > 0 then
                           (qtdnotasvendas*100/consultoras)
                         else 
                           0
                       end  percnotasvendas
                from (  select pck_romance.fnc_nomefilial(g.idfilial) empresa
                             , pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                             , r.idrepresentante
                             , ( select count(1)
                                 from catal.vendedoras v
                                    , roman.notasvendas n
                                 where v.idvendedora = n.idvendedora
                                   and v.idrepresentante = r.idrepresentante
                                   and n.idsituacaonotavenda = 3
                                   and v.ativo           = 'S'
                                   and not exists ( select 1
                                                    from representantes rr
                                                    where rr.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa ) 
                                    /*
                                        Maicon Aimi - 9488317 - 03/10/2024
                                        Este EXISTS garante que somente vendedoras ativas sejam retornadas. 
                                        Em alguns casos, a vendedora pode estar com "Ativo = 'S'", mas não possui notas aguardando acerto (idsituacaonotavenda = 3). 
                                        Nessas situações, a vendedora não deve ser considerada ativa.
                                    */
                                   and exists ( select 1
                                                  from roman.notasvendas n
                                                     , roman.regioesrepresentantes rg -- Adicionado região T9661343
                                                 where n.idrepresentante = rg.idrepresentante
                                                   and n.idsituacaonotavenda = 3
                                                   and n.idvendedora = v.idvendedora
                                                   and rg.idregiaovenda  = n.idregiaovenda) ) consultoras
                             , ( select count( distinct v.idvendedora)
                                 from registrosloginminhasacola e
                                    , vendedoras                v
                                 where e.primeirologin = 'S'
                                   and v.ativo           = 'S'
                                   and v.idvendedora   = e.idvendedora 
                                   and v.idrepresentante = r.idrepresentante
                                   and e.datalogin between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                   and not exists ( select 1
                                                    from representantes rr
                                                    where rr.idpessoa = v.idpessoa ) 
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa ) ) consultorasapp  
                             , (select count( distinct v.idvendedora)
                                 from registrosloginminhasacola e
                                    , vendedoras                v
                                 where v.ativo           = 'S'
                                   and v.idvendedora     = e.idvendedora 
                                   and v.idrepresentante = r.idrepresentante
                                   and e.datalogin between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                   --and e.datalogin >= sysdate- 42
                                   and not exists ( select 1
                                                    from representantes rr
                                                    where rr.idpessoa = v.idpessoa ) 
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa ) 
                                   -- Adicionado nota e região T9661343
                                   and exists (select 1
                                                  from roman.notasvendas n
                                                     , roman.regioesrepresentantes rg 
                                                 where n.idrepresentante = rg.idrepresentante
                                                   and n.idsituacaonotavenda = 3
                                                   and n.idvendedora = v.idvendedora
                                                   and rg.idregiaovenda  = n.idregiaovenda)) consultorasacesso
                             , ( select count( distinct v.idvendedora)
                                 from registrosloginminhasacola e
                                    , vendedoras                v
                                 where v.ativo           = 'S'
                                   and v.idvendedora   = e.idvendedora 
                                   and e.datalogin between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                   and v.idrepresentante = r.idrepresentante
                                   and not exists ( select 1
                                                    from representantes rr
                                                    where rr.idpessoa = v.idpessoa ) 
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa ) ) consultorasappfiltrodata 
                             , (select sum(aux.qtdcompartilhamento)
                                  from registroscompartilhafotos_aux382 aux
                                 where aux.idrepresentante = r.idrepresentante
                                   and aux.datacompartilhamento between to_date(trim(:P382_DATAINICIO)) and 
                                                                        to_date(trim(:P382_DATAFIM))) qtdcompartilhamento
                             , (  select count(distinct n.idnotavendaapp)
                                  from notasvendasapp n
                                     , vendedoras v      
                                  where v.idvendedora     = n.idvendedora  
                                    and v.ativo           = 'S'      
                                    and v.idrepresentante = r.idrepresentante
                                    and n.dataatualizacao between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS') 
                                    and n.idnotavendaapp  = ( select max(n2.idnotavendaapp)
                                                              from notasvendasapp n2      
                                                              where n2.idvendedora = n.idvendedora  ) ) qtdnotasvendas  
                        from representantes r
                           , gerentes g
                           , filiais f
                        where r.ativo     = 'S'
                          and g.idgerente = r.idgerente
                          and g.idfilial = f.idfilial
                          and exists ( select 1
                                       from vendedoras v
                                       where v.idrepresentante = r.idrepresentante
                                         and v.ativo           = 'S' ) 
                          and not exists ( select 1
                                           from gerentes g
                                           where g.idpessoa = r.idpessoa )
                          and g.idfilial  = :P0_IDFILIAL )
                where :P382_UTILIZADITRIB42DIAS = 'S'
                order by 1, 2
                
                
                
                
                
                
                /*   OLD
                select empresa
                     , distribuidor
                     , consultoras
                     , consultorasapp
                     , case
                         when consultorasapp > 0 and consultoras > 0 then
                           (consultorasapp*100/consultoras)
                         else 
                           0
                       end  perc
                     , consultorasacesso
                     , case
                         when consultorasacesso > 0 and consultoras > 0 then
                           (consultorasacesso*100/consultoras)
                         else 
                           0
                       end  perc_acc
                     , qtdcompartilhamento
                     , consultorasappfiltrodata
                     , idrepresentante
                     , qtdnotasvendas 
                     , case
                         when qtdnotasvendas > 0 and consultoras > 0 then
                           (qtdnotasvendas*100/consultoras)
                         else 
                           0
                       end  percnotasvendas
                from (
                        select pck_romance.fnc_nomefilial(g.idfilial) empresa
                             , pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                             , r.idrepresentante
                             , ( select count(1)
                                 from vendedoras v
                                 where v.idrepresentante = r.idrepresentante
                                   and v.ativo           = 'S'
                                   and not exists ( select 1
                                                    from representantes rr
                                                    where rr.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa ) ) consultoras
                             , ( select count( distinct v.idvendedora)
                                 from registrosloginminhasacola e
                                    , vendedoras                v
                                 where e.primeirologin = 'S'
                                   and v.ativo           = 'S'
                                   and v.idvendedora   = e.idvendedora 
                                   and v.idrepresentante = r.idrepresentante
                                  -- and e.datalogin between to_date(trim(:P45_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P45_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                   and exists ( select 1
                                                from registroscompartilhafotos rg
                                                where rg.idvendedora = v.idvendedora
                                                having max(rg.datacompartilhamento) > sysdate- 42 ) 
                                   and not exists ( select 1
                                                    from representantes rr
                                                    where rr.idpessoa = v.idpessoa ) 
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa ) ) consultorasapp  
                             ---
                             , ( select count( distinct v.idvendedora)
                                 from registrosloginminhasacola e
                                    , vendedoras                v
                                 where v.ativo           = 'S'
                                   and v.idvendedora     = e.idvendedora 
                                   and v.idrepresentante = r.idrepresentante
                                   and e.datalogin >= sysdate- 42
                                   and not exists ( select 1
                                                    from representantes rr
                                                    where rr.idpessoa = v.idpessoa ) 
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa ) ) consultorasacesso
                             ---
                             , ( select count( distinct v.idvendedora)
                                 from registrosloginminhasacola e
                                    , vendedoras                v
                                 where v.ativo           = 'S'
                                   and v.idvendedora   = e.idvendedora 
                                   and e.datalogin between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                  -- and e.datalogin >= trunc(sysdate)-14
                                   and v.idrepresentante = r.idrepresentante
                                   and not exists ( select 1
                                                    from representantes rr
                                                    where rr.idpessoa = v.idpessoa ) 
                                   and not exists ( select 1
                                                    from gerentes g
                                                    where g.idpessoa = v.idpessoa )
                                   and not exists ( select 1
                                                    from funcionarios f
                                                    where f.idpessoa = v.idpessoa ) ) consultorasappfiltrodata 
                             , ( select count(1)
                                 from registroscompartilhafotos f
                                    , vendedoras                v
                                 where f.idvendedora      = v.idvendedora 
                                   and v.idrepresentante  = r.idrepresentante
                                   and f.datacompartilhamento between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )  qtdcompartilhamento
                             , (  select count(distinct n.idnotavendaapp)
                                  from notasvendasapp n
                                     , vendedoras v      
                                  where v.idvendedora     = n.idvendedora  
                                    and v.ativo           = 'S'      
                                    and v.idrepresentante = r.idrepresentante
                                    and n.dataatualizacao between to_date(trim(:P382_DATAINICIO)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(trim(:P382_DATAFIM)||' 23:59:59','DD/MM/RRRR HH24:MI:SS') 
                                    and n.idnotavendaapp  = ( select max(n2.idnotavendaapp)
                                                              from notasvendasapp n2      
                                                              where n2.idvendedora = n.idvendedora  ) ) qtdnotasvendas  
                        from representantes r
                           , gerentes g
                           , filiais f
                        where r.ativo     = 'S'
                          and g.idgerente = r.idgerente
                          and g.idfilial = f.idfilial
                          and exists ( select 1
                                       from vendedoras v
                                       where v.idrepresentante = r.idrepresentante
                                         and v.ativo           = 'S' ) 
                          and not exists ( select 1
                                           from gerentes g
                                           where g.idpessoa = r.idpessoa )
                          and g.idfilial  = :P0_IDFILIAL )
                          --and ( :P0_IDFILIAL = -1 
                          --   or ( :P0_IDFILIAL > 0 and g.idfilial  = :P0_IDFILIAL ) ) ) 
                where :P382_UTILIZADITRIB42DIAS = 'S'
                order by 1, 2
                
                */
                ```
            pageItemsToSubmit: [
                P382_DATAINICIO
                P382_DATAFIM
                P0_IDFILIAL
            ]
        }
