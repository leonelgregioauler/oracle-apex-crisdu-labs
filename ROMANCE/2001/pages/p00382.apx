    region consultoras-que-usaram-o-app-35-dias (
        name: Consultoras que usaram o App - 35 dias
        type: chart
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: lineWithArea
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        legend {
            show: false
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select serie
                         , sequencia
                         , sum(qtd) qtd
                         , data
                    from vw_biroman382consultorausoapp_m f
                    where ((:P0_IDFILIAL = -1 and f.idgrupo in (1,2,3,4,5)) -- TODAS AS FILIAIS
                        or (:P0_IDFILIAL = -2 and f.idgrupo in(1,2,3,4)) -- FILIAIS DO BRASIL
                        or (:P0_IDFILIAL = -3 and f.idgrupo = 5) -- FILIAIS DA AMÉRICA LATINA
                        or (f.idfilial = :P0_IDFILIAL )) -- POR FILIAL
                    group by serie
                           , sequencia
                           , data
                    
                    
                    
                    /*  OLD
                    select 'Geral' serie
                         , trunc(datalogin) sequencia 
                         , count(1) qtd
                         , trunc(datalogin) ||' - '|| initcap(to_char(datalogin,'DAY')) DATA
                    from registrosloginminhasacola r
                    where datalogin >= sysdate - 35
                      and ( :P0_IDFILIAL = -1 
                         or ( :P0_IDFILIAL > 0 and r.idfilial = :P0_IDFILIAL ) )
                    group by trunc(datalogin) 
                           , trunc(datalogin) ||' - '||initcap( to_char(datalogin,'DAY'))
                    union all
                    select 'Até '||trunc(sysdate-1) serie
                         , trunc(datalogin) sequencia 
                         , count(1) qtd
                         , trunc(datalogin) ||' - '|| initcap(to_char(datalogin,'DAY')) data 
                    from registrosloginminhasacola r
                    where datalogin >= sysdate - 35
                      and datalogin <= to_date(TRUNC(datalogin)||' '||to_char(sysdate,'HH24:MI:SS' ),'DD/MM/RRRR HH24:MI:SS')
                      and ( :P0_IDFILIAL = -1 
                         or ( :P0_IDFILIAL > 0 and r.idfilial = :P0_IDFILIAL ) )
                    group by trunc(datalogin) 
                           , trunc(datalogin) ||' - '||initcap( to_char(datalogin,'DAY'))
                    ORDER BY 2
                    */
                    ```
            }
            columnMapping {
                seriesName: SERIE
                label: SEQUENCIA
                value: QTD
            }
        )

