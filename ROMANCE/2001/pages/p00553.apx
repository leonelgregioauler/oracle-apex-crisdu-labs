page 553 (
    name: Saldo de Produtos de Balanço
    title: Saldo de Produtos de Balanço
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region produtos (
        name: Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vw.semana
                     , vw.codigo
                     , vw.nomeproduto
                     , vw.comissao
                     , vw.valorvenda
                     , vw.quantidade saldo
                     , vw.quantidade*vw.valorvenda totalsaldo
                from vw_balancocongeladoprodutos vw
                where vw.idrepresentante = :P553_IDREPRESENTANTE
                  and vw.idsemana        between (:P553_IDSEMANA-1) and :P553_IDSEMANA
                  and vw.idfilial        = :P0_IDFILIAL
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 22128986783995833
        }

        column CODIGO (
            type: plainText
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column COMISSAO (
            type: plainText
            heading {
                heading: Possui Comissão?
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column NOMEPRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column SALDO (
            type: plainText
            heading {
                heading: Saldo
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column TOTALSALDO (
            type: plainText
            heading {
                heading: Total Saldo
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALORVENDA (
            type: plainText
            heading {
                heading: Valor de Venda
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 46705970 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn CODIGO (
                sequence: 2
            )

            displayColumn COMISSAO (
                sequence: 4
            )

            displayColumn NOMEPRODUTO (
                sequence: 3
            )

            displayColumn SALDO (
                sequence: 6
            )

            displayColumn SEMANA (
                sequence: 1
            )

            displayColumn TOTALSALDO (
                sequence: 7
            )

            displayColumn VALORVENDA (
                sequence: 5
            )

            sort (
                column: NOMEPRODUTO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: SALDO
            )

            aggregate (
                column: TOTALSALDO
            )

            filter ir-condition (
                column: SALDO
                operator: !=
                value: 0
            )

        )

    )

    pageItem P553_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @produtos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P553_IDSEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @produtos
            slot: regionBody
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidsemana number;
                begin
                  --
                  select idsemanabalanco
                  into vidsemana
                  from representantes r
                  where r.idrepresentante = :P553_IDREPRESENTANTE;
                  --
                  return vidsemana;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

)

