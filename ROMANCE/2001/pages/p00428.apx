    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            
            function abrewhatsapp()
            {
              ptelefone = document.getElementById('P428_TELEFONEWHATSAPP').value;
              pjanela = window.open('https://api.whatsapp.com/send?phone=55'+ptelefone+'&text=&source=&data=','whatsapp','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=1200,height=800,screenX=50,screenY =100');
              pjanela.focus();
            }
            
            ```
    }
