    region produtos-de-nota-adicional (
        name: Produtos de Nota Adicional
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nd.data
                     , nd.semana
                     , ( select p.codigosisdist
                         from estoquefilial e
                            , produtos p
                         where e.idestoquefilial = it.idestoquefil
                           and p.idproduto       = e.idproduto ) referencia
                     , pck_romance.fnc_nomeprodutoestoque(it.idestoquefil) produto
                     , it.quantidade distribuido
                     , nvl(( select 'Sim'
                             from dual
                             where exists ( select 1
                                            from fotosprodutos fp
                                               , estoquefilial e
                                            where fp.idproduto = e.idproduto
                                              and e.idestoquefilial = it.idestoquefil )),'Não') possuifotos
                from biroman.notasadicionais nd 
                   , biroman.itesnotaadicional it
                where it.idnotaadicional = nd.idnotaadicional
                  and nd.idvendedora = :P428_IDVENDEDORA 
                  and nd.idtablet = :P428_IDTABLET
                  and nd.situacao = 'C'
                order by 4
                ```
        }
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from biroman.notasadicionais nd
                where nd.idvendedora = :P428_IDVENDEDORA 
                 and nd.idtablet = :P428_IDTABLET
                 and nd.situacao = 'C'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
