    region compartilhamento-por-dia (
        name: Compartilhamento por Dia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select trunc(s.datacompartilhamento) dia
                     , count(1) qtd
                from registroscompartilhafotos s
                where s.idvendedora = :P428_IDVENDEDORA
                group by trunc(s.datacompartilhamento) 
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5137256161936945907
        }

