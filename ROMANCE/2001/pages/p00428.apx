    region smartphones-logados (
        name: Smartphones Logados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select device_name
                     , device_serial
                     , max(datalogin) data
                     , versaoaplicativo
                     , ( select max(s.datacompartilhamento)
                         from registroscompartilhafotos s
                         where s.idvendedora   = r.idvendedora
                           and s.device_serial = r.device_serial ) ultimocompart
                     , ( select count(1)
                         from notificacoes_pessoas_tokens_ms nn
                            , vendedoras v
                         where nn.idpessoa = v.idpessoa
                           and v.idvendedora = r.idvendedora
                           and nn.versaoapp  = r.versaoaplicativo ) tokens         
                from registrosloginminhasacola r
                where r.idvendedora = :P428_IDVENDEDORA
                group by device_name
                       , device_serial
                       , r.idvendedora
                       , versaoaplicativo
                ```
            pageItemsToSubmit: P428_IDVENDEDORA
        }
