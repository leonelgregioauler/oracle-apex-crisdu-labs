        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 'Primeiro Login: '|| to_char(min(r.datalogin),'DD/MM/RRRR hh24:mi:ss')||'<br>'
                     ||'Último Login: '|| to_char(max(r.datalogin),'DD/MM/RRRR hh24:mi:ss')||'<br>'
