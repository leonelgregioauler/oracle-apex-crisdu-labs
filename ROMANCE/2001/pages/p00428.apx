    region ultimo-acerto-realizado (
        name: Ultimo Acerto Realizado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select referencia
                     , produto
                     , distribuido_tablet
                     , vendido_tablet
                     , '|' 
                     , distribuido_app
                     , vendido_app
                     , case
                         when vendido_app != vendido_tablet then
                           'S'
                         else
                           'N'
                       end diferenca
                from ( select p.codigosisdist referencia
                           , initcap(p.nomeproduto) produto
                           , it.quantidade distribuido_tablet
                           , (it.quantidade - it.qtddevolvida) vendido_tablet
                           , venda_app.quantidaderecebida distribuido_app
                           , venda_app.quantidadevendida vendido_app
                      from notasvendas nv
                         , itensnotavenda it 
                         , estoquefilial e
                         , produtos p
                         , ( select ia.iditemnotavenda
                                  , ia.quantidaderecebida
                                  , ia.quantidadevendida
                             from itensnotasvendasapp ia
                                , notasvendasapp na
                             where na.idnotavendaapp = ia.idnotavendaapp
                               and na.idrepresentante = :P428_IDREPRESENTANTE
                               and na.idvendedora = :P428_IDVENDEDORA ) venda_app
                      where it.idnotavenda = nv.idnotavenda
                        and e.idestoquefilial = it.idestoquefil
                        and p.idproduto = e.idproduto
                        and nv.idrepresentante = :P428_IDREPRESENTANTE
                        and nv.idvendedora = :P428_IDVENDEDORA
                        and nv.idsituacaonotavenda = 4
                        and it.iditemnotavenda = venda_app.iditemnotavenda(+)
                        and nv.idnotavenda = ( select max(idnotavenda)
                                               from notasvendas n
                                               where n.idrepresentante = :P428_IDREPRESENTANTE
                                                 and n.idvendedora = :P428_IDVENDEDORA
                                                 and n.idsituacaonotavenda = 4 )
                      order by 2 ) d
                ```
        }
        layout {
            sequence: 90
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P428_CPF
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: "Nenhuma informação encontrada. "
        }
        searchBar {
            rowsPerPageSelector: true
        }
        advanced {
            savedReportMappingIdentifier: 5332171139467464606
        }

