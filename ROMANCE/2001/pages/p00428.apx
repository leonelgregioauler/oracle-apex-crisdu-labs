    process deletar-nota-dupla (
        name: Deletar Nota Dupla
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidnotavenda number;
                begin
                  --
                  select min(idnotavenda) 
                  into vidnotavenda
                  from biroman.notasvendas nv
                  where nv.idvendedora = :P428_IDVENDEDORA
                    and nv.idsituacaonotavenda = 3
                    and nv.idnotavenda < 0;
                  --
                  if vidnotavenda < 0 then
                    --
                    delete biroman.itensnotavenda it
                    where it.idnotavenda = vidnotavenda;
                    --
                    delete biroman.notasvendas nv
                    where nv.idnotavenda = vidnotavenda;
                    --
                    commit;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 2575156773160387114
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR_NOTA_DUPLA
        }
    )

