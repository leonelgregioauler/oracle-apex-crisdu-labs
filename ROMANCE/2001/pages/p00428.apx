    region produtos-nota-atual (
        name: Produtos Nota Atual
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist referencia
                     , initcap(p.nomeproduto) produto
                     , it.quantidade distribuido
                     , it.valorvenda
                     , it.quantidade * it.valorvenda valortotal
                     , nvl((select 'Sim'
                            from dual
                            where exists (select 1
                                          from fotosprodutos f
                                          where f.idproduto = p.idproduto)),'Não') possuifotos
                     , '|' s1
                     , venda_app.quantidaderecebida distribuido_app
                     , venda_app.quantidadevendida vendido_app
                from notasvendas nv
                   , itensnotavenda it 
                   , estoquefilial e
                   , produtos p
                   , ( select ia.iditemnotavenda
                            , ia.quantidaderecebida
                            , ia.quantidadevendida
                       from itensnotasvendasapp ia
                          , notasvendasapp na
                       where na.idnotavendaapp = ia.idnotavendaapp
                         and na.idrepresentante = :P428_IDREPRESENTANTE
                         and na.idvendedora = :P428_IDVENDEDORA ) venda_app
                where it.idnotavenda = nv.idnotavenda
                  and e.idestoquefilial = it.idestoquefil
                  and p.idproduto = e.idproduto
                  and nv.idrepresentante = :P428_IDREPRESENTANTE
                  and nv.idvendedora = :P428_IDVENDEDORA
                  and nv.idsituacaonotavenda = 3
                  and it.iditemnotavenda = venda_app.iditemnotavenda(+)
                order by 2
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P428_CPF
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma nota aguardando acerto encontrada!
        }
        searchBar {
