    pageItem P428_DATA_PEDIDO_MAIOR (
        type: displayOnly
        label {
            label: Data Maior Pedido
            alignment: left
        }
        layout {
            sequence: 60
            region: @informações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vdata varchar2(50);
                begin
                  --
                  begin
                    --
                    select to_char(max(p.dataemissao),'DD/MM/RRRR')
                    into vdata
                    from favorita.pedidos p
                    where not exists ( select 1
                                       from favorita.classificacoespedidos cf
                                       where cf.idpedido = p.idpedido
                                         and cf.idcaracteristicapedido = 25 )
                      and p.idvendedora = :P428_IDVENDEDORA;
                    --
                  exception
                    when others then
                      --
                      select to_char(max(p.dtemissao),'DD/MM/RRRR')
                      into vdata
                      from pedidos p
                      where p.situacao != 'Z'
                        and p.idvendedora = :P428_IDVENDEDORA;
                      --
                  end;
                  --
                  return vdata;
                  --
                exception
                  when others then
                    return 'Nenhum pedido encontrado.';
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

