    pageItem P428_IDTABLET (
        type: selectList
        label {
            label: Tablet
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
            executeValidations: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nome  ||' (' || e.chaveativacao||')' ||' - '|| case
                                                                          when s.datatablet is null then
                                                                            ' ainda não recebido'
                                                                          else
                                                                              trim(to_char(s.datatablet,'dd/mm/rrrr hh24:mi:ss') )
                                                                        end recebidoem  
                     , s.idtablet
                from roman.equipamentos   e
                   , catal.usuarios       u
                   , catal.representantes r
                   , biroman.sincronizar  s
                   , vendedoras v
                where e.usuario             = u.usuario
                  and u.idpessoa            = r.idpessoa 
                  and e.chaveativacao       = s.idtablet (+)
                  and e.idtipoequipamento   = 0
                  and e.situacao            = 'U'
                  and v.idpessoa            = :P428_IDPESSOA
                  and r.idrepresentante     = v.idrepresentante  
                ```
        }
        layout {
            sequence: 120
            region: @informações-consultora
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

