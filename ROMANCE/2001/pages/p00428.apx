    process ajusta-parametros (
        name: Ajusta Parametros
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidfilial number;
                begin
                  --
                  begin
                    --
                    select idfilial
                    into vidfilial
                    from notasvendas nv 
                    where nv.idnotavenda = ( select max(idnotavenda)
                                             from notasvendas n
                                              where n.idvendedora = :P428_IDVENDEDORA );
                    --
                  exception
                    when others then 
                      vidfilial := null;
                  end;
                  --
                  update vendedoras v
                  set v.idfilial = vidfilial
                    , v.ativo    = 'N'
                  where v.idvendedora = :P428_IDVENDEDORA;
                  --
                  commit;
                  --
                  delete parametrosvendedoras pv
                  where pv.idvendedora = :P428_IDVENDEDORA;
                  --
                  commit;
                  --
                  update vendedoras v
                  set v.ativo = 'S'
                  where v.idvendedora = :P428_IDVENDEDORA;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: Processo atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 4769453338187185207
        }
        serverSideCondition {
            type: request=Value
            value: AJUSTAR_PARAMETROS
        }
    )

