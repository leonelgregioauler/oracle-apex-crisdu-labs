    pageItem P428_TELEFONES_VENDEDORA (
        type: textField
        label {
            label: Telefones Vend.
            alignment: left
        }
        layout {
            sequence: 60
            region: @informações-consultora
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vtelefones varchar2(1000);
                  vexiste varchar2(1);
                  vidpessoa number;
                begin
                  --
                  begin
                    select idpessoa
                    into vidpessoa
                    from vendedoras v
                    where v.idvendedora = :P428_IDVENDEDORA;
                  exception
                    when others then
                      vidpessoa := null;
                  end;
                  --
                  if vidpessoa is not null then 
                    --
                    begin
                      select 'S'
                      into vexiste 
                      from dual
                      where exists ( select 1
                                     from telefonespessoas tp
                                     where tp.idpessoa = vidpessoa );
                    exception
                      when others then
                        vexiste := 'N';
                    end;
                    --
                    if vexiste = 'S' then
                      --
                      select listagg(o.nome||'-'||telefone||' - '||t.observacao,' / ') within group (order by 1)
                      into vtelefones
                      from telefonespessoas t
                         , operadorastelefonia o
                      where t.idpessoa = vidpessoa
                        and t.idoperadoratel = o.idoperadoratel(+);
                      --
                    else
                      --
                      select listagg(o.nome||'-'||telefone,' / ') within group (order by 1)
                      into vtelefones
                      from biroman.telefonespessoas t
                         , operadorastelefonia o
                      where t.idpessoa = vidpessoa
                        and t.idoperadoratel = o.idoperadoratel(+);
                      --
                    end if;
                    --
                    return vtelefones;
                    --
                  end if;
                  --
                exception
                  when others then
                    return null;
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P428_IDPESSOA
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

