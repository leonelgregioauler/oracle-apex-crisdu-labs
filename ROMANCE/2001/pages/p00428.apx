    region notificações-enviadas (
        name: Notificações enviadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.titulo
                     , n.mensagem
                     , n.datainclusao
                     , n.dataenvio
                     , n.datarecebimento
                     , p.nomeprocesso
                from notificacoesconsultoras  n
                   , processosnotificavendedoras p
                where n.idprocessonotificavendedora = p.idprocessonotificavendedora (+)   
                  and n.idpessoa                    = :P428_IDPESSOA
                order by n.idnotificacao desc
                ```
            pageItemsToSubmit: P428_IDPESSOA
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
