                ```sql
                select 1
                from dual
                where ( select count(1)
                        from notasvendas nv
                        where nv.idvendedora = :P428_IDVENDEDORA
                          and nv.idsituacaonotavenda = 3 ) > 1
                   or exists ( select 1
                               from biroman.notasadicionais nd
                               where nd.idvendedora = :P428_IDVENDEDORA 
                                 and nd.idtablet = :P428_IDTABLET
                                 and nd.situacao = 'C' )
                ```
        }
