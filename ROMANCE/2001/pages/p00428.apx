                  --
                  update pessoas p
                  set p.datanascimento = :P428_DATANASCIMENTO
                    , p.situacaointegracao = null
                    , p.dataintegracao = null
                    , p.ultimaatualizacao = sysdate
                  where p.idpessoa = :P428_IDPESSOA;
                  --
                  commit;
                  --
                end;
                ```
