page 832 (
    name: Detalhamento Item Sacola
    alias: DETALHAMENTO-ITEM-SACOLA2
    title: Detalhamento Item Sacola
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }

    region distribuidos (
        name: DISTRIBUIDOS
        title: Distribuidos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) Distribuidor
                     , sum(it.quantidade) qtd_distribuida
                  from notasvendas nv
                     , itensnotavenda it
                 where nv.idnotavenda = it.idnotavenda
                   and nv.idfilial    = nvl(:P832_IDFILIAL, nv.idfilial)
                   and nv.idsemanacobranca between :P832_IDSEMANAINICIO AND :P832_IDSEMANAFIM
                   and nv.idsituacaonotavenda = 4
                   and it.idestoquefil = :P832_IDESTOQUEFIL
                group by nv.idrepresentante
                order by 1 asc;
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <div style="border:1px solid #333; padding:15px; background-color:#f9f9f9; border-radius:5px; width:100%;">
                    <h4 style="font-size:14px; margin:0;">
                        <strong>Dados respeitam o filtro por Empresa, período de Semana Cobrança e Produto</strong><br>
                        * <strong>Qtd. Distribuída</strong> = Total do item deixado em notas do Distribuidor.<br>
                    </h4>
                </div>
                
                ```
        }
        serverSideCondition {
            type: item=value
            item: P832_TP_RELATORIO
            value: DISTRIBUIDO
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        download {
            csvExportEnabled: true
        }

        column DISTRIBUIDOR (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Distribuidor
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column QTD_DISTRIBUIDA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Qtd Distribuida
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

    )

    region minha-sacola (
        name: MINHA SACOLA
        title: Média p/ Sacola
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    roman.pck_romance.fnc_nomerepresentante(nota.idrepresentante) as Distribuidor,
                    --COUNT(DISTINCT nota.idnotavenda)                                         AS qtd_sacolas,
                    --SUM(it.quantidade)                                                       AS distribuidos,
                    --SUM(it.quantidade - it.qtddevolvida)                                     AS vendido,
                    ROUND(
                        SUM(it.quantidade) / NULLIF(COUNT(DISTINCT nota.idnotavenda), 0)
                    , 2)                                                                     AS media_sacola
                FROM roman.notasvendas    nota
                JOIN roman.itensnotavenda it ON it.idnotavenda = nota.idnotavenda
                WHERE nota.idfilial            = nvl(:P832_IDFILIAL, nota.idfilial)
                  AND nota.idsituacaonotavenda = 4
                  AND nota.idsemanacobranca    BETWEEN :P832_IDSEMANAINICIO AND :P832_IDSEMANAFIM
                  AND it.idestoquefil          = :P832_IDESTOQUEFIL
                GROUP BY nota.idrepresentante
                ORDER BY 1 asc;
                ```
        }
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <div style="border:1px solid #333; padding:15px; background-color:#f9f9f9; border-radius:5px; width:100%;">
                    <h4 style="font-size:14px; margin:0;">
                        <strong>Dados respeitam o filtro por Empresa, período de Semana Cobrança e Produto</strong><br>
                        * <strong>Média Sacola</strong> = Contagem total de notas do Distribuidor com o produto dividido pelo total de produtos distribuídos.<br>
                    </h4>
                </div>
                
                ```
        }
        serverSideCondition {
            type: item=value
            item: P832_TP_RELATORIO
            value: MEDIA
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        download {
            csvExportEnabled: true
        }

        column DISTRIBUIDOR (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Distribuidor
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column MEDIA_SACOLA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Média Sacola
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

    )

    region parametros (
        name: Parametros
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="text-align: center; font-family: Arial; font-size: 30px; color: #333; margin-bottom: 20px;">
                  <strong>&P832_NOMEPRODUTO.</strong>
                </div>
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region qtd-notas (
        name: QTD_NOTAS
        title: Notas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- QTD NOTAS: exibir o nome do distribuidor, número de consultoras ativas, quantas ficaram com o produto  e em quantas notas o produto foi incluído.
                select roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) Distribuidor
                     , vendedoras.qtd_vendedoras Vendedoras_ativas
                     , sum (it.quantidade - it.qtddevolvida) qtd_vendida -- quantas ficaram com o produto
                     , count(nv.idnotavenda) qtd_notas_produto -- quantas notas o produto foi incluído
                --   nv.idsituacaonotavenda, nv.idsemanacobranca, it.quantidade, it.qtddevolvida, it.idestoquefil, nv.idfilial, it.idproduto
                  from notasvendas nv
                     , itensnotavenda it
                     , (select count(v.idvendedora) qtd_vendedoras
                             , v.idrepresentante
                          from catal.vendedoras v
                         where v.ativo = 'S'
                         group by v.idrepresentante) vendedoras -- vendedoras ativas do distribuidor
                 where nv.idnotavenda = it.idnotavenda
                   and nv.idrepresentante = vendedoras.idrepresentante
                   and nv.idfilial    = nvl(:P832_IDFILIAL, nv.idfilial)
                   and nv.idsemanacobranca between :P832_IDSEMANAINICIO AND :P832_IDSEMANAFIM
                   and nv.idsituacaonotavenda = 4
                   and it.idestoquefil = :P832_IDESTOQUEFIL
                group by nv.idrepresentante, vendedoras.qtd_vendedoras;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                t-IRR-region--noBorders
                js-showMaximizeButton
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
                t-Form--stretchInputs
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <div style="border:1px solid #333; padding:15px; background-color:#f9f9f9; border-radius:5px; width:100%;">
                    <h4 style="font-size:14px; margin:0;">
                        <strong>Dados respeitam o filtro por Empresa, período de Semana Cobrança e Produto</strong><br>
                        * <strong>Vendedoras Ativas</strong> = Total de Vendedoras ativas do Distribuidor.<br>
                        * <strong>Qtd. Vendida</strong> = Cálculo de quantidade distribuída menos a quantidade devolvida.<br>
                        * <strong>Qtd.Notas</strong> = Quantidade de notas do Distribuidor que contém o produto.
                    </h4>
                </div>
                
                ```
        }
        serverSideCondition {
            type: item=value
            item: P832_TP_RELATORIO
            value: QTD_NOTAS
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        download {
            csvExportEnabled: true
        }

        column DISTRIBUIDOR (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Distribuidor
            }
            layout {
                sequence: 10
            }
        )

        column QTD_NOTAS_PRODUTO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Qtd Notas Produto
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

        column QTD_VENDIDA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Qtd Vendida
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column VENDEDORAS_ATIVAS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Vendedoras Ativas
                alignment: end
