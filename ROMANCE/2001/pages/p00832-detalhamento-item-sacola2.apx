    pageItem P832_NOMEPRODUTO (
        type: hidden
        layout {
            sequence: 50
            region: @parametros
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select p.nomeproduto
                  from roman.estoquefilial e
                     , roman.produtos p
                 where e.idproduto = p.idproduto
                   and e.idestoquefilial = :P832_IDESTOQUEFIL;
                ```
        }
    )

