    validation valida-cliente (
        name: Valida cliente
        execution {
            sequence: 60
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from vendedoras v
                   , pessoas p
                where v.idrepresentante = :P220_IDREPRESENTANTE
                  and p.idpessoa = v.idpessoa
                  and p.cpf = :P220_CPFVENDEDORA
                ```
        }
        error {
            errorMessage: Cliente V não cadastrada, ou não vende para este Cliente R!
        }
    )

