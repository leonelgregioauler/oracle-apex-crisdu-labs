                ```sql
                select initcap(nomepessoa) display_value
                     , v.idvendedora return_value
                from vendedoras v
                   , pessoas p
                where v.idrepresentante = :P220_IDREPRESENTANTE
                  and p.idpessoa = v.idpessoa
                  and p.cpf = :P220_CPFVENDEDORA
                ```
            displayNullValue: false
