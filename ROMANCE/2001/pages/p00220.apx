        }
    )

    process concluir (
        name: concluir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update VENDADIRETAFAVORITA
                  set situacao = 'A'
                  where IDVENDADIRETA = :P220_IDVENDADIRETA;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Concluido com sucesso!
        }
        advanced {
            executionMappingIdentifier: 423015867343080738
        }
        serverSideCondition {
            whenButtonPressed: @concluir
        }
    )

