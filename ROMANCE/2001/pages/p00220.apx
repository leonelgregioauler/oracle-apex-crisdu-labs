page 220 (
    name: Venda Direta
    title: Venda Direta
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function imprimeboleto() {
                    window.open('http://boletos.romancemoda.com.br:7777/boleto/boleto_bb_multi.php?idpedido='+document.getElementById('P220_IDPEDIDO').value,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); void(0);  
            }
            
            
            function fnc_imprimepedido() {
            window.open('f?p=&APP_ID.:228:&SESSION.::NO::P228_IDPEDIDO:'+document.getElementById('P220_IDPEDIDO').value ,'pedido','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0); 
            }
            
            function formatar_mascara(src,mascara,evt)
            {
                var tecla;  
                if(evt.which){tecla = evt.which}
                else if(evt.keyCode){ tecla = evt.keyCode;}  
                 if( tecla != 8 ){
                 var campo = src.value.length;
                 var saida = mascara.substring(0,1);
                 var texto = mascara.substring(campo);
                 if(texto.substring(0,1) != saida) {
                 src.value+=texto.substring(0,1);}}
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region itens (
        name: Itens
        type: tabform
        source {
            sqlQuery:
                ```sql
                select IDITEMVENDADIRETAFAV
                     , IDVENDADIRETA
                     , REFERENCIA
                     , ( select p.nomeproduto from catal.produtos p where replace(p.referencia,'.','') = replace(c.REFERENCIA,'.','') ) Produto
                     , ( select k.descricao from catal.kitvendas k where replace(k.referencia,'.','') = replace(c.REFERENCIA,'.','') ) "Produto Kit"
                     , QUANTIDADE 
                from ITENSVENDASDIRETASFAV c
                where idvendadireta = :P220_IDVENDADIRETA
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P220_IDVENDADIRETA
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: - Clique em Salvar -
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Clique em "Adcionar Produtos"!
        }
        componentAdvanced {
            stripHtml: true
        }

