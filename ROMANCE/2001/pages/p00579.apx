page 579 (
    name: Assinatura Eletrônica da Cliente
    title: Assinatura Eletrônica da Cliente
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region assinaturas-realizadas (
        name: Assinaturas Realizadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select decode(w.tipo,'A','Nota Adicional'
                                    ,'N','Nota Nova') tipo
                     , decode(w.aprovado,'S','Sim'
                                        ,'N','Não') aprovado
                     , decode(w.reprovado,'S','Sim'
                                         ,'N','Não') reprovado
                     , w.link
                from vw_assinaturas_eletronicas w
                where w.idnotavenda = :P579_IDNOTAVENDA
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4721640790856044920
        }

        column APROVADO (
            type: plainText
            heading {
                heading: Aprovado
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column LINK (
            type: plainText
            heading {
                heading: Ver Assinatura
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column REPROVADO (
            type: plainText
            heading {
                heading: Reprovado
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 47309026 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn APROVADO (
                sequence: 2
            )

            displayColumn LINK (
                sequence: 4
            )

            displayColumn REPROVADO (
                sequence: 3
            )

            displayColumn TIPO (
                sequence: 1
            )

        )

    )

    pageItem P579_IDNOTAVENDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @assinaturas-realizadas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

