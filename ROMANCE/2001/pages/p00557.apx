    button convencao (
        buttonName: CONVENCAO
        label: Convenção 05/12
        layout {
            sequence: 40
            region: @lista-de-participantes-da-convenção
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 759
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: v('APP_USER') in ('GUILHERME','SUELENBAUER','RAFAELK','JESSICAMATTOS')
        }
    )

    button novo (
        buttonName: NOVO
