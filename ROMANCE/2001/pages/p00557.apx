    region lista-de-participantes-da-convenção (
        name: Lista de Participantes da Convenção
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDPESSOACONVENCAO 
                     , pck_romance.FNC_NOMEFILIAL(IDFILIAL) empresa
                     , pck_romance.FNC_NOMEREPRESENTANTE(IDREPRESENTANTE)  distribuidor
                     , NOMECOMPLETO
                     , SEXO
                     , DATANASCIMENTO   
                     , NACIONALIDADE  
                     , DOCUMENTO
                     , CPF 
                     , DATAEMISSAODOCUMENTO    
                     , ( SELECT   p.nome
                         FROM paises  p
                         WHERE p.idpais =  pp.IDPAISEMISSAODOCUMENTO ) paisemissaodocuennto
                     , DATAVENCIMENTODOCUMENTO 
                     , (
                      SELECT c.NOMECIDADE ||' - '||e.SIGLA || ' - '||p.SIGLA 
                      FROM cidades c
                         , estados e
                         , paises p
                      WHERE c.idestado = e.IDESTADO 
                        AND e.IDPAIS   = p.IDPAIS 
                        AND c.idcidade  = pp.IDCIDADENASCIMENTO ) cidade_nascimento
                     ,  TELEFONE 
                     , EMAIL 
                     , RUA
                     , NUMERO  
                     , CEP 
                     , (
                      SELECT c.NOMECIDADE ||' - '||e.SIGLA || ' - '||p.SIGLA 
                      FROM cidades c
                         , estados e
                         , paises p
                      WHERE c.idestado = e.IDESTADO 
                        AND e.IDPAIS   = p.IDPAIS 
                        AND c.idcidade  = pp.IDCIDADEENDERECO ) cidade_endereco 
                     , PARENTESCO
                     , ( SELECT count(1)
                         FROM anexospessoasconvencao a
                         WHERE a.IDPESSOACONVENCAO = pp.IDPESSOACONVENCAO ) anexos
                     , CABINE
                     , decode(PP.REVISADO,'N','Não','S','Sim') REVISADO
                     , PP.DATAREVISAO
                     , PP.RG
                     , PP.CNH
                     , PP.DATAVENCIMENTOCNH
                     , PP.DOCUMENTOAPRESENTACAO
                     , ( SELECT G.SIGLA
                         FROM GRADES G
                         WHERE G.IDGRADE = PP.IDGRADECAMISETA ) TAMANHO_CAMISETA
                     ,( SELECT c.NOMECIDADE ||' - '||e.SIGLA || ' - '||p.SIGLA 
                          FROM cidades c
                             , estados e
                             , paises p
                          WHERE c.idestado = e.IDESTADO 
                            AND e.IDPAIS   = p.IDPAIS 
                            AND c.idcidade  = pp.origem )  origem_partida
                     , decode(vaiparticipardoevento,'S','Sim','N','Não') convencao_0512
                     , CODIGORESERVA
                     , case 
                         when vaiparticipardoevento = 'S' then
                           'https://showdepremios.crisdulabs.com.br/cruzeiro2024/cdd'||pp.idrepresentante||'.html' 
                         else 
                           '-'
                       end link
                from PESSOASCONVENCAO pp
                where idfilial = :P0_IDFILIAL
                ```
            pageItemsToSubmit: P0_IDFILIAL
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <h3>Para realização de novos cadastros, será necessário solicitar acesso!</h3>
        }
        link {
            linkColumn: customTarget
            target: {
                page: 558
                items: {
                    P558_IDPESSOACONVENCAO: #IDPESSOACONVENCAO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Não há participantes cadastrados.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 2436230837657726121
        }

