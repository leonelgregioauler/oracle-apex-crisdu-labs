    region lista-das-passagens (
        name: Lista das Passagens
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(p.idfilial) franquia
                     , p.nomecompleto
                     , p.sexo
                     , p.datanascimento
                     , '-' ida
                     , ida.aeroporto_origem aeroporto_partida_ida
                     , ida.aeroporto_destino aeroporto_chegada_ida
                     , ida.companhia companhia_ida
                     , ida.numero_voo numero_voo_ida
                     , ida.localizador localizador_ida
                     , ida.data data_ida
                     , ida.hora_partida hora_partida_ida
                     , ida.hora_chegada hora_chegada_ida
                     , '-' volta
                     , volta.aeroporto_origem
                     , volta.aeroporto_destino
                     , volta.companhia
                     , volta.numero_voo
                     , volta.localizador
                     , volta.data
                     , volta.hora_partida
                     , volta.hora_chegada 
                from pessoasconvencao p
                   , ( select pa.aeroporto_origem
                            , pa.aeroporto_destino
                            , pa.companhia
                            , pa.numero_voo
                            , pa.localizador
                            , pa.data
                            , pa.hora_partida
                            , pa.hora_chegada 
                            , pp.idpessoaconvencao
                       from passagensconvencao pa
                          , pessoaspassagensconvencao pp
                       where pp.idpassagemconvencao = pa.idpassagemconvencao
                         and pa.tipo_passagem = 1 ) ida
                   , ( select pa.aeroporto_origem
                            , pa.aeroporto_destino
                            , pa.companhia
                            , pa.numero_voo
                            , pa.localizador
                            , pa.data
                            , pa.hora_partida
                            , pa.hora_chegada 
                            , pp.idpessoaconvencao
                       from passagensconvencao pa
                          , pessoaspassagensconvencao pp
                       where pp.idpassagemconvencao = pa.idpassagemconvencao
                         and pa.tipo_passagem = 2 ) volta
                where p.idpessoaconvencao = ida.idpessoaconvencao(+)
                  and p.idpessoaconvencao = volta.idpessoaconvencao(+)
                  and p.idfilial = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 108304637379987641
        }

