    region histórico-de-comissões-favorita (
        name: Histórico de Comissões Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pp.idrepresentante) representante
                     , trunc(datapagamento) "Data"
                     , 'Valor Pago' "Descrição"
                     , sum(comissao) *-1 "Valor"
                     , pp.fechamento "Fechamento"
                from vw_comissoes_pagar t
                   ,  pagamentocomissoes pp
                where pp.idrepresentante = :P212_IDREPRESENTANTE
                  and :P212_TIPO = 'R' 
                  and trunc(t.databaixa) >= to_date(:P212_DATA,'DD/MM/RRRR')
                  and pp.idpedido  = t.idpedido 
                group by pp.idrepresentante
                      , trunc(datapagamento)
                      , pp.fechamento
                union
                select pck_romance.fnc_nomerepresentante(t.idrepresentante) representante
                     , trunc(t.databaixa)  data
                     , 'Valor Receber: '||t.vendedora
                     , sum(comissao) 
                     , null fechamento
                from vw_comissoes_pagar t
                where idrepresentante = :P212_IDREPRESENTANTE
                  and :P212_TIPO = 'R' 
                  and trunc(t.databaixa) >= to_date(:P212_DATA,'DD/MM/RRRR')
                group by t.idrepresentante
                       , trunc(t.databaixa) 
                       , t.vendedora
                union
                select pagar.representante
                     , pagar.DataPgto
                     , 'Saldo Anterior'
                     , round(pagar.valor - pago.valor,2) saldo
                     , null fechamento
                from (select pck_romance.fnc_nomerepresentante(pp.idrepresentante) representante
                           , to_date(:P212_DATA,'DD/MM/RRRR') DataPgto
                           ,  sum(comissao) Valor
                      from vw_comissoes_pagar t
                         ,  pagamentocomissoes pp
                      where pp.idrepresentante = :P212_IDREPRESENTANTE
                        and :P212_TIPO = 'R' 
                        and trunc(t.databaixa) < to_date(:P212_DATA,'DD/MM/RRRR')
                        and pp.idpedido  = t.idpedido 
                      group by pp.idrepresentante ) pago
                      , ( select pck_romance.fnc_nomerepresentante(t.idrepresentante) representante
                           , to_date(:P212_DATA,'DD/MM/RRRR') DataPgto
                           , sum(comissao) valor
                      from vw_comissoes_pagar t
                      where idrepresentante = :P212_IDREPRESENTANTE
                        and :P212_TIPO = 'R' 
                        and trunc(t.databaixa) < to_date(:P212_DATA,'DD/MM/RRRR')
                      group by t.idrepresentante) pagar
                union ----------------
                select pck_romance.fnc_nomegerente(t.idgerente) representante
                     , trunc(datapagamento) "Data"
                     , 'Valor Pago' "Descrição"
                     , sum(t.comissaogerente) *-1 "Valor"
                     , pp.fechamento "Fechamento"
                from vw_comissoes_pagar t
                   ,  pagamentocomissoes pp
                where :P212_TIPO = 'G' 
                  and PP.idgerente = ( select idgerente from gerentes where idfilial = :P0_IDFILIAL)
                  and trunc(t.databaixa) >= to_date(:P212_DATA,'DD/MM/RRRR')
                  and pp.idpedido  = t.idpedido 
                group by t.idgerente
                      , trunc(datapagamento)
                      , pp.fechamento
                union
                select pck_romance.fnc_nomegerente(t.idgerente) representante
                     , trunc(t.databaixa)  data
                     , 'Valor Receber: '
                     , sum(comissaogerente) 
                     , null fechamento
                from vw_comissoes_pagar t
                where :P212_TIPO = 'G' 
                  and t.idgerente = ( select idgerente from gerentes where idfilial = :P0_IDFILIAL)
                  and trunc(t.databaixa) >= to_date(:P212_DATA,'DD/MM/RRRR')
                group by t.idgerente
                       , trunc(t.databaixa)
                union
                select case 
                         when pp.idrepresentante is not null then
                            pck_romance.fnc_nomerepresentante(pp.idrepresentante) 
                         when pp.idgerente is not null then
                           pck_romance.fnc_nomegerente(pp.idgerente)
                         end representante
                     , trunc(datapagamento) "Data"
                     , 'Valor Pago' "Descrição"
                     , sum(valorpago) *-1 "Valor"
                     , pp.fechamento "Fechamento"
                from  pagamentocomissoes pp
                   --, vw_comissoes_pagar t
                   , fechamentorepresentantes ff
                where ff.idfechamentorepres = pp.idfechamentorepres
                  and ff.idfilial = :P0_IDFILIAL
                  and :P212_TIPO = 'S' 
                  --and trunc(t.databaixa) >= to_date(:P212_DATA,'DD/MM/RRRR')
                 -- and pp.idpedido  = t.idpedido 
                  and ff.semana = :P212_SEMANA
                group by pp.idrepresentante
                      , pp.idgerente
                      , trunc(datapagamento)
                      , pp.fechamento
                union
                select pagar.representante
                     , pagar.DataPgto
                     , 'Saldo Anterior'
                     , round(pagar.valor - pago.valor,2) saldo
                     , null fechamento
                from (select pck_romance.fnc_nomegerente(pp.idgerente) representante
                           , to_date(:P212_DATA,'DD/MM/RRRR') DataPgto
                           ,  sum(comissaogerente) Valor
                      from vw_comissoes_pagar t
                         ,  pagamentocomissoes pp
                      where :P212_TIPO = 'G' 
                        and PP.idgerente = ( select idgerente from gerentes where idfilial = :P0_IDFILIAL)
                        and trunc(t.databaixa) < to_date(:P212_DATA,'DD/MM/RRRR')
                        and pp.idpedido  = t.idpedido 
                        and pp.idgerente = t.idgerente
                      group by pp.idgerente ) pago
                      , ( select pck_romance.fnc_nomegerente(t.idgerente) representante
                           , to_date(:P212_DATA,'DD/MM/RRRR') DataPgto
                           , sum(comissaogerente) valor
                      from vw_comissoes_pagar t
                      where :P212_TIPO = 'G' 
                        and t.idgerente = ( select idgerente from gerentes where idfilial = :P0_IDFILIAL)
                        and trunc(t.databaixa) < to_date(:P212_DATA,'DD/MM/RRRR')
                      group by t.idgerente) pagar
                order by 2
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
