    region histórico-comissão-gerente (
        name: Histórico Comissão Gerente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomegerente(pg.idgerente) representante
                     , trunc(pg.datapagamento) "Data"
                     , 'Valor Pago' "Descrição"
                     , sum(pg.valorpago) *-1 "Valor"
                     , pg.fechamento "Fechamento"
                     -- Bônus Adimplência: composição da comissão paga (só exibição)
                     , (sum(pg.valorpago) - sum(nvl(b.valorbonus,0))) *-1 comissaofixa
                     , sum(nvl(b.valorbonus,0)) *-1 comissaobonus
                     , round( sum(b.perc_inad * b.comissaooriginal)
                            / nullif(sum(case when b.perc_inad is not null then b.comissaooriginal end),0), 2) inadmedia
                from pagamentocomissoes pg
                   , comger_bonus b
                where b.idpgtocomissao(+) = pg.idpgtocomissao
                  and b.tipolancamento(+) = 'C'
                  and b.situacao(+)       = 'G'
                  and pg.idgerente = ( select idgerente from gerentes where idfilial = :P0_IDFILIAL)
                  and trunc(pg.datapagamento) >= to_date(:P212_DATA,'DD/MM/RRRR')
                  and pg.tipopedido in ('V','P')
                  and :P212_TIPO = 'G' 
                group by pg.idgerente
                      , trunc(pg.datapagamento)
                      , pg.fechamento;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P212_TIPO = 'G'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 321779115955663919
        }

