    pageItem P212_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' ('||decode(r.ativo,'S','Ativo','N','Inativo')||')' display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @histórico-de-comissões
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P212_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano d
                     , s.idsemana
                from semana_dias s
                where s.ano >= 2017
                order by s.idsemana
                ```
        }
        layout {
            sequence: 40
            region: @histórico-de-comissões
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P212_SEMANAFIM (
        type: selectList
        label {
            label: até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano d
                     , s.idsemana r
                from semana_dias s
                where s.ano >= 2017
                order by s.idsemana
                ```
        }
        layout {
            sequence: 50
            region: @histórico-de-comissões
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P212_TIPO (
        type: radioGroup
        label {
            label: " "
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC:Distribuidor;R,Gerente;G,Semana;S
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @histórico-de-comissões
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @histórico-de-comissões
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction filtro (
        name: filtro
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction tipo (
        name: tipo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P212_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P212_TIPO
            value: G
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P212_IDREPRESENTANTE
                    P212_SEMANA
                    P212_SEMANAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P212_IDREPRESENTANTE
                    P212_SEMANA
                    P212_SEMANAFIM
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction tipo-semana (
        name: tipo semana
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P212_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P212_TIPO
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P212_SEMANA
                    P212_SEMANAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P212_IDREPRESENTANTE
                    P212_DATA
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P212_SEMANA
                    P212_SEMANAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 212
                items: {
                    P212_IDREPRESENTANTE: &P212_IDREPRESENTANTE.
                    P212_DATA: &P212_DATA.
                    P212_TIPO: &P212_TIPO.
                    P212_SEMANA: &P212_SEMANA.
                    P212_SEMANAFIM: &P212_SEMANAFIM.
                }
                successMessage: false
            }
        }
    )

)

