    region histórico-de-comissões-por-semana (
        name: Histórico de Comissões Por Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case 
                         when pp.idrepresentante is not null then
                            pck_romance.fnc_nomerepresentante(pp.idrepresentante) 
                         when pp.idgerente is not null then
                           pck_romance.fnc_nomegerente(pp.idgerente)
                         end representante
                     , trunc(datapagamento) "Data"
                     , 'Valor Pago' "Descrição"
                     , sum(valorpago) *-1 "Valor"
                     , pp.fechamento "Fechamento"
                from  pagamentocomissoes pp
                   , fechamentorepresentantes ff
                where ff.idfechamentorepres = pp.idfechamentorepres
                  and ff.idfilial = :P0_IDFILIAL
                  and pp.tipopedido = 'P'
                  and :P212_TIPO = 'S' 
                  and exists ( select 1
                               from fechamentossemanais f
                               where f.idfechamento = ff.idfechamento
                                 and f.idsemana between :P212_SEMANA and :P212_SEMANAFIM )
                group by pp.idrepresentante
                      , pp.idgerente
                      , trunc(datapagamento)
                      , pp.fechamento
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
