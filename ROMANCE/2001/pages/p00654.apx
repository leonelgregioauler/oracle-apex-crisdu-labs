    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function listanotasemaberto(pidrepres,pidsemana) 
            {
            javascript:window.open('f?p=&APP_ID.:655:&SESSION.::NO:655:P655_DISTRIBUIDOR,P655_FILIAL:'+pidrepres+','
                                                                                                         +pidsemana
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=1300,screenX=50,screenY =100');void(0);
            }
            
            ```
    }
