    region notas-em-atraso-dist-qtd (
        name: Notas em Atraso Dist. - Qtd
        type: chart
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P654_DETALHADO
            value: S
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                     select count(b.idnotavenda) total
                          , roman.pck_romance.fnc_nomerepresentante (b.idrepresentante) Distribuidor
                      from(select n.idsemanacobranca - n.idsemanadistribuicao qtdsemanas
                                , n.idnotavenda
                                , n.idrepresentante
                           from roman.notasvendas n
                              , catal.gerentes g
                              , catal.filiais f
                              , catal.representantes r
                           where n.idfilial = g.idfilial
                             and n.idfilial = f.idfilial
                             and n.idrepresentante = r.idrepresentante
                             and n.idsituacaonotavenda = 3
                             and g.ativo = 'S'
                             and f.ativo = 'S'            
                             and g.idfilial != 1063 
                             and (:P654_ATIVO = 'A' and r.ativo in ('S','N') or :P654_ATIVO = 'S' and r.ativo = 'S' or :P654_ATIVO = 'N' and r.ativo = 'N')
                             and (:P654_DATAINI is null or trunc(n.datanota) between to_date(:P654_DATAINI, 'dd/mm/rrrr') and to_date(:P654_DATAFIM, 'dd/mm/rrrr'))
                             and (:P654_FRANQUIA is null or g.idgerente = :P654_FRANQUIA)
                             and (:P654_FILTRAR = 'S')
                             and (f.ididioma = :P654_PAIS )
                          ) b
                     where b.qtdsemanas > 6
                     group by  b.idrepresentante
                     order by 2
                    ```
            }
            columnMapping {
                label: DISTRIBUIDOR
                value: TOTAL
            }
            label {
                show: true
            }
        )

    )

