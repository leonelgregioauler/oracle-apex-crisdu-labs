    region placar-do-momento (
        name: Placar do Momento
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P654_ATIVO (
        type: radioGroup
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N,Ambos;A
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: A
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P654_DATAFIM (
        type: datePickerJquery
        label {
            label: Data Fim:
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P654_DATAINI (
        type: datePickerJquery
        label {
            label: Data Inicial:
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P654_DETALHADO (
        type: radioGroup
        label {
            label: Detalhado?
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P654_DISTRIBUIDOR (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap (p.nomepessoa) display_value
                     , r.idrepresentante return_value
                from pessoas p
                   , representantes r
                where r.idpessoa = p.idpessoa 
                  and r.ativo = 'S'
                  and r.idgerente = :P654_FRANQUIA
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P654_FRANQUIA
            itemsToSubmit: P654_DISTRIBUIDOR
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P654_FILTRAR (
        type: hidden
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P654_FRANQUIA (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idgerente
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.idfilial != 1063
                  and f.ididioma = :P654_PAIS
                  and exists (select 1
                              from roman.notasvendas nv
                              where nv.idfilial = f.idfilial
                                and nv.idsituacaonotavenda = 3);
                ```
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: P654_PAIS
        }
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P654_PAIS (
        type: selectList
        label {
            label: Pais
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Brasil;1,Paraguay;4,Uruguay;2,Chile;6,México;12,Portugal;11,Peru;8,Panamá;13
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        default {
            type: static
            staticValue: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: "FILTRAR "
        layout {
            sequence: 10
            region: @filtros
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction mostra-dist (
        name: mostra dist
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P654_DETALHADO
        }
        clientSideCondition {
            type: item=value
            item: P654_DETALHADO
            value: S
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P654_DISTRIBUIDOR
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction oculta-dist (
        name: oculta dist
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P654_DETALHADO
        }
        clientSideCondition {
            type: item=value
            item: P654_DETALHADO
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P654_DISTRIBUIDOR
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 654
                items: {
                    P654_DATAINI: &P654_DATAINI.
                    P654_DATAFIM: &P654_DATAFIM.
                    P654_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

