    region em-atraso-por-franquia (
        name: "Em Atraso por Franquia "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select aa.nome
                     , aa.total em_dia_qtd
                     , aa.vlr em_dia_valor
                     , nvl(bb.total,0) em_atraso_qtd
                     , bb.vlr em_atraso_valor
                     , nvl(bb.total,0) + nvl(aa.total,0) total_geral_qtd
                     , nvl(bb.vlr,0) + nvl(aa.vlr,0) total_geral_valor
                from(select nvl(count(a.idnotavenda),0)  total
                          , a.idfilial
                          , a.nome
                          , a.idgerente
                          , a.ididioma
                          , sum(a.valortotalnota) vlr
                     from(select n.idsemanacobranca - n.idsemanadistribuicao qtdsemanas
                               , n.idnotavenda
                               , g.idfilial
                               , roman.pck_romance.fnc_nomefilial(g.idfilial) nome
                               , g.idgerente
                               , f.ididioma
                               , n.valortotalnota
                           from roman.notasvendas n
                              , catal.gerentes g
                              , catal.filiais  f
                              , catal.representantes r
                           where n.idfilial = g.idfilial
                             and n.idfilial = f.idfilial
                             and n.idrepresentante = r.idrepresentante
                             and n.idsituacaonotavenda = 3
                             and g.ativo = 'S'
                             and f.ativo = 'S'
                             and g.idfilial != 1063
                             and (:P654_ATIVO = 'A' and r.ativo in ('S','N') or :P654_ATIVO = 'S' and r.ativo = 'S' or :P654_ATIVO = 'N' and r.ativo = 'N')
                             and (:P654_DATAINI is null or trunc(n.datanota) between to_date(:P654_DATAINI, 'dd/mm/rrrr') and to_date(:P654_DATAFIM, 'dd/mm/rrrr'))
                         ) a
                      where a.qtdsemanas <= 6
                      group by a.idfilial, a.nome, a.idgerente, a.ididioma)aa
                  , (select nvl(count(b.idnotavenda),0)  total
                          , b.idfilial
                          , sum(b.valortotalnota) vlr
                     from(select n.idsemanacobranca - n.idsemanadistribuicao qtdsemanas
                               , n.idnotavenda
                               , g.idfilial
                               , n.valortotalnota 
                          from roman.notasvendas n
                             , catal.gerentes    g
                             , catal.filiais     f
                             , catal.representantes r
                          where n.idfilial = g.idfilial
                            and n.idfilial = f.idfilial
                            and n.idrepresentante = r.idrepresentante
                            and n.idsituacaonotavenda = 3
                            and g.ativo = 'S'
                            and f.ativo = 'S'
                            and g.idfilial != 1063 
                            and (:P654_ATIVO = 'A' and r.ativo in ('S','N') or :P654_ATIVO = 'S' and r.ativo = 'S' or :P654_ATIVO = 'N' and r.ativo = 'N')
                            and (:P654_DATAINI is null or trunc(n.datanota) between to_date(:P654_DATAINI, 'dd/mm/rrrr') and to_date(:P654_DATAFIM, 'dd/mm/rrrr'))
                         ) b
                     where b.qtdsemanas > 6
                     group by b.idfilial)bb
                where :P654_FILTRAR = 'S'
                  and bb.idfilial(+) = aa.idfilial
                  and (:P654_FRANQUIA is null or aa.idgerente = :P654_FRANQUIA)
                  and (aa.ididioma = :P654_PAIS )
                order by 1
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
