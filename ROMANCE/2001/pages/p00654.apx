    region notas-em-atraso-qtd (
        name: Notas em Atraso - Qtd
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Notas em Atraso - Qtd' situacao
                     , to_char(count(a.idnotavenda),'999G999G999G999G990') total
                from(select n.idsemanacobranca - n.idsemanadistribuicao qtdsemanas
                          , n.idnotavenda
                          , f.ididioma
                          , g.idgerente
                          , n.datanota
                          , r.ativo
                     from roman.notasvendas n
                        , catal.filiais f
                        , catal.gerentes g
                        , catal.representantes r
                     where n.idfilial = f.idfilial
                       and n.idfilial = g.idfilial
                       and n.idrepresentante = r.idrepresentante
                       and n.idsituacaonotavenda = 3
                       and f.ativo = 'S'
                       and f.idfilial != 1063 ) a
                where a.qtdsemanas > 6
                  and (a.ididioma = :P654_PAIS )
                  and (:P654_FRANQUIA is null or a.idgerente = :P654_FRANQUIA)
                  and (:P654_DATAINI is null or trunc(a.datanota) between to_date(:P654_DATAINI, 'dd/mm/rrrr') and to_date(:P654_DATAFIM, 'dd/mm/rrrr'))
                  and (:P654_ATIVO = 'A' and a.ativo in ('S','N') or :P654_ATIVO = 'S' and a.ativo = 'S' or :P654_ATIVO = 'N' and a.ativo = 'N')
                ```
        }
        layout {
            sequence: 20
            parentRegion: @placar-do-momento
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            labelColumn: SITUACAO
            valueColumn: TOTAL
        }
    )

    region notas-em-atraso-qtd-2 (
        name: Notas em Atraso - Qtd
        type: chart
        source {
            pageItemsToSubmit: P654_DATAINI
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P654_DETALHADO
            value: N
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select roman.pck_romance.fnc_nomefilial(a.idfilial) franquia
                         , nvl(count(a.idnotavenda),0) total
                    from(select n.idsemanacobranca - n.idsemanadistribuicao qtdsemanas
                              , g.idfilial
                              , n.idnotavenda
                              , g.idgerente
                              , f.ididioma
                              , r.ativo
                         from roman.notasvendas n
                            , catal.gerentes g
                            , catal.filiais f
                            , catal.representantes r
                         where n.idfilial = g.idfilial
                           and n.idfilial = f.idfilial
                           and n.idrepresentante = r.idrepresentante
                           and n.idsituacaonotavenda = 3
                           and g.ativo = 'S'
                           and f.ativo = 'S'
                           and g.idfilial != 1063 
                           and (:P654_DATAINI is null or trunc(n.datanota) between to_date(:P654_DATAINI, 'dd/mm/rrrr') and to_date(:P654_DATAFIM, 'dd/mm/rrrr'))
                        ) a
                    where a.qtdsemanas > 6
                      and (:P654_FRANQUIA is null or a.idgerente = :P654_FRANQUIA)
                      and (:P654_FILTRAR = 'S')
                      and (a.ididioma = :P654_PAIS )
                      and (:P654_ATIVO = 'A' and a.ativo in ('S','N') or :P654_ATIVO = 'S' and a.ativo = 'S' or :P654_ATIVO = 'N' and a.ativo = 'N')
                    group by a.idfilial
                    order by 1 
                    ```
            }
            columnMapping {
                label: FRANQUIA
                value: TOTAL
            }
            label {
                show: true
            }
        )

    )

    region notas-em-atraso-valor (
        name: Notas em Atraso - Valor
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Notas em Atraso - Valor' situacao
                     , to_char(sum(a.valortotalnota),'999G999G999G999G990D00') total
                from(select n.idsemanacobranca - n.idsemanadistribuicao qtdsemanas
                          , n.idnotavenda
                          , n.valortotalnota
                          , f.ididioma
                          , g.idgerente 
                          , n.datanota
                          , r.ativo
                     from roman.notasvendas n
                        , catal.filiais f
                        , catal.gerentes g
                        , catal.representantes r
                     where n.idfilial = f.idfilial
                       and n.idfilial = g.idfilial
                       and n.idrepresentante = r.idrepresentante
                       and n.idsituacaonotavenda = 3
                       and f.ativo = 'S'
                       and f.idfilial != 1063 ) a
                where a.qtdsemanas > 6
                  and (a.ididioma = :P654_PAIS )
                  and (:P654_FRANQUIA is null or a.idgerente = :P654_FRANQUIA)
                  and (:P654_DATAINI is null or trunc(a.datanota) between to_date(:P654_DATAINI, 'dd/mm/rrrr') and to_date(:P654_DATAFIM, 'dd/mm/rrrr'))
                  and (:P654_ATIVO = 'A' and a.ativo in ('S','N') or :P654_ATIVO = 'S' and a.ativo = 'S' or :P654_ATIVO = 'N' and a.ativo = 'N')
                ```
        }
        layout {
            sequence: 40
            parentRegion: @placar-do-momento
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            labelColumn: SITUACAO
            valueColumn: TOTAL
        }
    )

