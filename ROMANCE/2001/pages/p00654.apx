        pageAccessProtection: unrestricted
    }

    region em-atraso-por-distribuidor (
        name: Em atraso por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante (bb.idrepresentante) nome
                     , sum(case when situacao=1 then bb.total else 0 end) em_dia_qtd
                     , sum(case when situacao=1 then bb.vlr else 0 end) em_dia_valor
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:655:'||v('APP_SESSION')||'::NO::P655_DISTRIBUIDOR,P655_FRANQUIA:'||idrepresentante||','||idfilial,'SESSION')||''',''_blank''); void(0)">'||sum(case when situacao=2 then bb.total else 0 end)||'</a>'"Em atraso"
                     , sum(case when situacao=2 then bb.vlr else 0 end) em_atraso_valor
                     , sum(bb.total) total_geral_qtd
                     , sum(bb.vlr) total_geral_valor
                from(select count(a.idnotavenda) total
                          , a.idfilial
                          , a.idgerente
                          , a.idrepresentante 
                          , sum(a.valortotalnota) vlr
                          , 1  situacao
                          , a.ativo
                     from(select n.idsemanacobranca - n.idsemanadistribuicao qtdsemanas
                               , n.idnotavenda
                               , g.idfilial
                               , g.idgerente
                               , n.idrepresentante
                               , n.valortotalnota
                               , r.ativo
                           from roman.notasvendas n
                              , catal.gerentes g
                              , catal.filiais f
                              , catal.representantes r
                           where n.idfilial = g.idfilial
                             and n.idfilial = f.idfilial
                             and n.idrepresentante = r.idrepresentante 
                             and n.idsituacaonotavenda = 3
                             and g.ativo = 'S'
                             and f.ativo = 'S'
                             and g.idfilial != 1063
                             --and (:P654_ATIVO is null or r.ativo = :P654_ATIVO)
                             and (:P654_DATAINI is null or trunc(n.datanota) between to_date(:P654_DATAINI, 'dd/mm/rrrr') and to_date(:P654_DATAFIM, 'dd/mm/rrrr'))
                         ) a
                      where a.qtdsemanas <= 6
                      group by a.idfilial, a.idgerente, a.idrepresentante, a.ativo
                
                      union all
                
                
                     select count(b.idnotavenda) total
                          , b.idfilial
                          , b.idgerente
                          , b.idrepresentante
                          , sum(b.valortotalnota) vlr
                          , 2 situacao
                          , b.ativo
                     from(select n.idsemanacobranca - n.idsemanadistribuicao qtdsemanas
                               , n.idnotavenda
                               , g.idfilial
                               , n.idrepresentante
                               , g.idgerente
                               , valortotalnota
                               , r.ativo
                          from roman.notasvendas n
                             , catal.gerentes g
                             , catal.filiais f
                             , catal.representantes r
                          where n.idfilial = g.idfilial
                            and n.idfilial = f.idfilial
                            and n.idrepresentante = r.idrepresentante
                            and n.idsituacaonotavenda = 3
                            and g.ativo = 'S'
                            and f.ativo = 'S'            
                            and g.idfilial != 1063 
                            --and (:P654_ATIVO is null or r.ativo = :P654_ATIVO)
                            and (:P654_DATAINI is null or trunc(n.datanota) between to_date(:P654_DATAINI, 'dd/mm/rrrr') and to_date(:P654_DATAFIM, 'dd/mm/rrrr'))
                         ) b
                     where b.qtdsemanas > 6
                     group by b.idfilial, b.idrepresentante, b.idgerente, b.ativo)bb
                 where (:P654_FILTRAR = 'S')
                   and (:P654_FRANQUIA is null or bb.idgerente = :P654_FRANQUIA)
                   and (:P654_DISTRIBUIDOR is null or bb.idrepresentante = :P654_DISTRIBUIDOR )
                   and (:P654_ATIVO = 'A' and bb.ativo in ('S','N') or :P654_ATIVO = 'S' and bb.ativo = 'S' or :P654_ATIVO = 'N' and bb.ativo = 'N')
                  group by bb.idfilial
                         , bb.idrepresentante
                order by 1
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
