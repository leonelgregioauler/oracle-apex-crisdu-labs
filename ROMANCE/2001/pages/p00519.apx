    pageItem P519_ENTREGA_CONFIRMADA (
        type: radioGroup
        label {
            label: Entrega Confirmada?
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N,Ambos;A
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: A
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P519_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distruibuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||decode(r.ativo,'S','Ativo','N','Inativo') d
                     , r.idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: - Selecione o Distribuidor -
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P519_IDVENDEDORA (
        type: selectList
        label {
            label: Consultora
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomepessoa||' - '||decode(v.ativo,'S','Ativa','N','Inativa') d
                     , v.idvendedora r
                from vendedoras v
                   , pessoas p
                where v.idrepresentante = :P519_IDREPRESENTANTE
                  and p.idpessoa        = v.idpessoa
                order by 1
                ```
            nullDisplayValue: - Selecione a Consultora -
        }
        cascadingLov {
            parentItems: P519_IDREPRESENTANTE
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P519_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano d
                     , s.idsemana r
                from semana_dias s
                where s.idsemana between pck_util.fnc_idsemanadata(sysdate)-30 and pck_util.fnc_idsemanadata(sysdate)
                order by s.idsemana desc
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P519_TIPOPESQUISA (
