            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-pesquisa (
        name: Tipo Pesquisa
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P519_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P519_TIPOPESQUISA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P519_DATAINICIO
                    P519_DATAFIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P519_SEMANA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P519_SEMANA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P519_DATAINICIO
                    P519_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        name: Go To Page 519
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 519
                items: {
                    P519_TIPOPESQUISA: &P519_TIPOPESQUISA.
                    P519_SEMANA: &P519_SEMANA.
                    P519_IDREPRESENTANTE: &P519_IDREPRESENTANTE.
                    P519_IDVENDEDORA: &P519_IDVENDEDORA.
                    P519_ENTREGA_CONFIRMADA: &P519_ENTREGA_CONFIRMADA.
                    P519_DATAINICIO: &P519_DATAINICIO.
                    P519_DATAFIM: &P519_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

