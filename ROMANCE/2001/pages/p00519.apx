page 519 (
    name: Controle de Pedidos da Favorita
    title: Controle de Pedidos da Favorita
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region controle-de-pedidos (
        name: Controle de Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pf.idpedido
                     , pf.edicaorevista
                     , pf.desctipopedido tipopedido
                     , pf.vendedora 
                     , pf.dataemissao
                     , pf.dataentrega
                     , pf.datavencimentomenor
                     , pf.valortotal
                     , pf.valorapagar
                     , pf.valorpago
                     , case
                         when cpf.idcaracteristicapedido = 75 then
                           'Não'
                         when cpf.idcaracteristicapedido = 76 then
                           'Sim'
                       end entregue
                     , pf.pedidocancelado
                     , cpf.dataclassificado 
                     , pf.representante 
                from favorita.vw_pedidos_fav pf
                   , favorita.classificacoespedidos cpf
                where pf.ididioma  = 1
                  and cpf.idpedido = pf.idpedido
                  and ( :P519_ENTREGA_CONFIRMADA is null
                    or ( :P519_ENTREGA_CONFIRMADA = 'A' and cpf.idcaracteristicapedido in (75,76) )
                    or ( :P519_ENTREGA_CONFIRMADA = 'S' and cpf.idcaracteristicapedido = 76 )
                    or ( :P519_ENTREGA_CONFIRMADA = 'N' and cpf.idcaracteristicapedido = 75 ) )
                  and pf.idfilialromance = :P0_IDFILIAL
                  and ( :P519_IDREPRESENTANTE is null or pf.idrepresentante = :P519_IDREPRESENTANTE )
                  and ( :P519_IDVENDEDORA is null or pf.idvendedora = :P519_IDVENDEDORA )
                  and ( :P519_TIPOPESQUISA is null 
                      or ( :P519_TIPOPESQUISA = 'S' and pck_util.fnc_idsemanadata(cpf.dataclassificado) = :P519_SEMANA )
                      or ( :P519_TIPOPESQUISA = 'D' and trunc(cpf.dataclassificado) between to_date(:P519_DATAINICIO) and to_date(:P519_DATAFIM) ) )
                  and ( :P519_TIPOPESQUISA is not null
                     or :P519_DATAINICIO is not null
                     or :P519_SEMANA is not null )
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum pedido localizado, verifique os filtros!
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 1585503947520206412
        }

