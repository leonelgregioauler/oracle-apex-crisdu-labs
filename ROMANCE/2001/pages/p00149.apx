    region observações-de-débitos (
        name: Observações de Débitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select odc.idobservacaodebitocliente, 
                       odc.idpessoa, 
                       odc.observacao, 
                       odc.datacadastro, 
                       odc.usuariocadastro
                  from pepinosrepresentantes pep
                     , representantes rep
                     , observacoesdebitocliente odc
                 where pep.idrepresentante = rep.idrepresentante
                   and rep.idpessoa = odc.idpessoa
                   and pep.idpepinosrepresentante = :P149_IDPEPINOSREPRESENTANTE
                 order by datacadastro desc
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                   from pepinosrepresentantes pep
                      , representantes rep
                      , observacoesdebitocliente odc
                  where pep.idrepresentante = rep.idrepresentante
                    and rep.idpessoa = odc.idpessoa
                    and pep.idpepinosrepresentante = :P149_IDPEPINOSREPRESENTANTE
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
