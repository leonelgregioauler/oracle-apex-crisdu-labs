    pageItem P149_CODIGOLIBERACAO (
        type: displayOnly
        label {
            label: Cód. Liberação
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 30
            region: @atualizar-débito
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  --
                  vcod number;
                  vdebito number;
                  --
                begin
                  --
                  vdebito := :P149_IDPEPINOSREPRESENTANTE+10000000;
                  --
                  select pck_romance.fnc_retornacodigoliberacao(piddebito => vdebito) 
                  into vcod
                  from dual;
                  --
                  return(vcod);
                  --
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where (select valor - nvl(( select sum(valor)
                                 from pepinosrepresentantes
                                 where nrpedido = P.NRPEDIDO
                                   and idrepresentante = P.IDREPRESENTANTE
                                   and situacao = 'P' ),0)
                from pepinosrepresentantes P
                where idpepinosrepresentante = :P149_IDPEPINOSREPRESENTANTE) = 0
                ```
        }
        security {
            encryptSessionState: false
        }
    )

