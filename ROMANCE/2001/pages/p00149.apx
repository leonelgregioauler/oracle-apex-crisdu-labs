    region pagamentos (
        name: Pagamentos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDPEPINOSREPRESENTANTE",
                "IDPEPINOSREPRESENTANTE" IDPEPINOSREPRESENTANTE_DISPLAY,
                "IDFECHAMENTOREPRES",
                "NRPEDIDO",
                "VALOR",
                "ANO",
                "SEMANA",
                "SITUACAO",
                "SEMANAPAGO",
                "ANOPAGO",
                "OBSERVACAO",
                "IDFILIAL",
                "IDFECHAMENTOREPRESPAGO",
                "IDREPRESENTANTE",
                "DATAENVIOCOBRANCA",
                "NOMEVENDEDORA",
                "IDNOTAVENDA",
                "DATAINCLUSAO",
                "CPF",
                ( select lp.dataalteracao data
                   from logroman.log_pepinosrepresentantes lp
                   where lp.tipoalteracao = 'INSERT'
                     and lp.IDPEPINOSREPRESENTANTE = pp.IDPEPINOSREPRESENTANTE ) datainclusaoantigo,
                 ( select lp.usuarioalteracao data
                   from logroman.log_pepinosrepresentantes lp
                   where lp.tipoalteracao = 'INSERT'
                     and lp.IDPEPINOSREPRESENTANTE = pp.IDPEPINOSREPRESENTANTE ) usuarioincluiu
                from "PEPINOSREPRESENTANTES" pp
                where NRPEDIDO = :P149_NRPEDIDO
                  AND IDREPRESENTANTE = :P149_IDREPRESENTANTE
                  AND SITUACAO = 'P'
                ```
        }
        layout {
            sequence: 40
            slot: body-3
        }
