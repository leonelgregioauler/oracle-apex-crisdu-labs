page 12 (
    name: Transferência de Produtos entre Clientes R
    title: Transferência de Produtos entre Clientes R
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region transf-de-produtos-entre-distribuidores (
        name: Transf. de Produtos entre Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idtransfprodrepres
                     , ( select initcap( nvl(p.apelido,p.nomepessoa ) ) 
                         from representantes r
                            , pessoas        p
                         where r.idpessoa        = p.idpessoa
                           and r.idrepresentante = t.idrepresentanteorig ) "Representante Origem"
                     , ( select initcap( nvl(p.apelido,p.nomepessoa ) ) 
                         from representantes r
                            , pessoas        p
                         where r.idpessoa        = p.idpessoa
                           and r.idrepresentante = t.idrepresentantedest ) "Representante Destino"
                     , datamovto "Data Transferência"
                     , idestoquefilial
                     , quantidade "Quantidade"
                from transfprodrepres t
                where exists ( select 1
                               from representantes r
                               where r.idrepresentante = t.idrepresentanteorig
                                 and r.idgerente = ( select idgerente
                                                     from gerentes g
                                                     where g.idfilial = :P0_IDFILIAL ) )
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 17
                items: {
                    P17_IDTRANSFPRODREPRES: #IDTRANSFPRODREPRES#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhuma tranferência efetuada.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column "Data Transferência" (
            type: plainText
            heading {
                heading: Data Transferência
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: Data_Transferencia
                endUserAlias: H
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDESTOQUEFILIAL (
            type: plainText
            heading {
                heading: Idestoquefilial
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDESTOQUEFILIAL
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDTRANSFPRODREPRES (
            type: plainText
            heading {
                heading: Idtransfprodrepres
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDTRANSFPRODREPRES
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Quantidade (
            type: plainText
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: Quantidade
                endUserAlias: I
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Representante Destino" (
            type: plainText
            heading {
                heading: Distribuidor Destino
                alignment: center
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Representante_Destino
                endUserAlias: G
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Representante Origem" (
            type: plainText
            heading {
                heading: Distribuidor Origem
                alignment: center
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Representante_Origem
                endUserAlias: F
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 1168204 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn "Data Transferência" (
                sequence: 3
            )

            displayColumn "Quantidade" (
                sequence: 4
            )

            displayColumn "Representante Destino" (
                sequence: 2
            )

            displayColumn "Representante Origem" (
                sequence: 1
            )

            controlBreak (
                column: "Representante Origem"
                layout {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Nova Transferência
        layout {
            sequence: 30
            region: @transf-de-produtos-entre-distribuidores
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 17
                clearCache: 17
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

