            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column VALORTOTALDEVOLUCAO (
            type: plainText
            heading {
                heading: Total Devolução
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALORTOTALNOTA (
            type: plainText
            heading {
                heading: Total Nota
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column VALORTOTALVENDA (
            type: plainText
            heading {
