        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 13994458 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IMPRIMIR (
                sequence: 13
            )

            displayColumn IMPRIMIR_VENDA (
                sequence: 14
            )

            displayColumn NUMERONOTA (
                sequence: 1
            )

            displayColumn REGIAOVENDA (
                sequence: 5
            )

            displayColumn SALDO (
                sequence: 12
            )

            displayColumn SEMANACOBRANCA (
                sequence: 4
            )

            displayColumn SEMANADISTRIBUICAO (
                sequence: 3
            )

            displayColumn VALORCOMISSAO (
                sequence: 9
            )

            displayColumn VALORPAGO (
                sequence: 11
            )

            displayColumn VALORTOTALDEVOLUCAO (
                sequence: 7
            )

            displayColumn VALORTOTALNOTA (
                sequence: 6
            )

            displayColumn VALORTOTALVENDA (
                sequence: 8
            )

            displayColumn VALORTOTALVENDALQD (
                sequence: 10
            )

            displayColumn VENDEDORA (
                sequence: 2
            )

            aggregate (
                column: VALORPAGO
            )

        )

    )

    pageItem P362_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' ('||decode(r.ativo,'S','Ativo','N','Inativo')||')' display_value
                     , r.idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes 
                                      where idfilial = :P0_IDFILIAL )
                order by 1 
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P362_SEMANA (
        type: textField
        label {
            label: Semana de Cobrança
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar-notas (
        buttonName: BUSCAR_NOTAS
        label: Buscar Notas
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 362
                items: {
                    P362_IDREPRESENTANTE: &P362_IDREPRESENTANTE.
                    P362_SEMANA: &P362_SEMANA.
                }
                action: resetPagination
            }
        }
    )

)

