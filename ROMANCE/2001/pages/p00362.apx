page 362 (
    name: Notas para Digitação Fiscal
    title: Notas para Digitação Fiscal
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region notas-cobradas (
        name: Notas Cobradas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.numeronota
                     , pck_romance.fnc_nomevendedora(n.idvendedora) vendedora
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota 
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valortotalvenda
                     , n.valorcomissao
                     , n.valorpago
                     , n.saldo
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':363:'||v('APP_SESSION')||'::NO::P363_IDNOTAVENDA,P363_TIPO:'||n.idnotavenda||',N,','SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' imprimir
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':363:'||v('APP_SESSION')||'::NO::P363_IDNOTAVENDA,P363_TIPO:'||n.idnotavenda||',V,','SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' imprimir_venda
                from notasvendas n
                where n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P362_IDREPRESENTANTE
                  and n.semanacobranca  = :P362_SEMANA
                order by 2
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma nota encontrada, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 1396675837496177047
        }

        column IMPRIMIR (
            type: plainText
            heading {
                heading: Imprimir
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: M
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IMPRIMIR_VENDA (
            type: plainText
            heading {
                heading: Imprimir Venda
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: N
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NUMERONOTA (
            type: plainText
            heading {
                heading: Nr Nota
