page 63 (
    name: Lucratividade Cliente R
    title: Lucratividade Cliente R
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region semanas (
        name: Semanas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(pidfilial => f.idfilial) Filial
                     , f.semana||' '||pck_romance.fnc_semanadias(psemana =>  f.semana ) semana
                     , f.idfechamento
                     , substr(f.semana,4,4) "Ano"
                from fechamentossemanais f
                where pck_romance.fnc_tipofilial(pidfilial => f.idfilial  ) = 'D' -- Distribuidora
                  and ( (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S')
                       or f.idfilial =  pck_romance.fnc_filialusuario(v('APP_USER')))
                order by 1 , 3 desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        link {
            linkColumn: customTarget
            target: {
                page: 65
                items: {
                    P65_SEMANA: #SEMANA#
                    P65_IDFECHAMENTO: #IDFECHAMENTO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum acerto incluído.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column Ano (
            type: plainText
            heading {
                heading: Ano
                alignment: center
            }
            layout {
                sequence: 24
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Ano
                endUserAlias: X
            }
            enableUsersTo {
                pivot: false
            }
        )

        column FILIAL (
            type: plainText
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 23
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: FILIAL
                endUserAlias: W
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDFECHAMENTO (
            type: plainText
            heading {
                heading: Idfechamento
                alignment: center
            }
            layout {
                sequence: 22
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDFECHAMENTO
                endUserAlias: V
            }
            enableUsersTo {
                pivot: false
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 21
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: SEMANA
                endUserAlias: U
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 1460825 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn FILIAL (
                sequence: 1
            )

            displayColumn SEMANA (
                sequence: 2
            )

            sort (
                column: IDFECHAMENTO
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            controlBreak (
                column: FILIAL
                layout {
                    sequence: 1
                }
            )

        )

    )

)

