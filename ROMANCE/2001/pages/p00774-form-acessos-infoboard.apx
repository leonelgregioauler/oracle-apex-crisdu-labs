page 774 (
    name: Form Acessos Infoboard
    alias: FORM-ACESSOS-INFOBOARD
    title: Acessos Infoboard
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-700x
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-acessos-infoboard (
        name: Form Acessos Infoboard
        type: form
        source {
            location: localDatabase
            tableName: ACESSOSINFOBOARD
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P774_IDACESSOINFOBOARD (
        type: hidden
        layout {
            sequence: 10
            region: @form-acessos-infoboard
            slot: regionBody
        }
        source {
            formRegion: @form-acessos-infoboard
            column: IDACESSOINFOBOARD
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: SEQ_IDACESSOINFOBOARD
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P774_IDMODINFOBOARD (
        type: selectList
        label {
            label: Modulo Infoboard
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomeinfoboard d
                     , idmodinfoboard r
                  from modulosinfoboard
                 order by 1
                ```
        }
        layout {
            sequence: 20
            region: @form-acessos-infoboard
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P774_IDPERFILINFOBOARD (
        type: selectList
        label {
            label: Perfil infoboard
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomeperfil d 
                     , idperfilinfoboard r
                  from perfisinfoboard
                 where (:P774_IDMODINFOBOARD is null or idmodinfoboard = :P774_IDMODINFOBOARD)
                 order by 1
                ```
        }
        cascadingLov {
            parentItems: P774_IDMODINFOBOARD
        }
        layout {
            sequence: 30
            region: @form-acessos-infoboard
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form-acessos-infoboard
            column: IDPERFILINFOBOARD
            dataType: number
        }
    )

    pageItem P774_IDUSUARIO (
        type: selectList
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT (INITCAP(P.NOMEPESSOA)||' - '||u.usuario) D
                     , U.IDUSUARIO R
                  FROM USUARIOS U
                     , PESSOAS  P
                 WHERE U.IDPESSOA = P.IDPESSOA
                   AND U.ATIVO = 'S'
                 ORDER BY 1
                ```
        }
        layout {
            sequence: 40
            region: @form-acessos-infoboard
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form-acessos-infoboard
            column: IDUSUARIO
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P774_IDACESSOINFOBOARD
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P774_IDACESSOINFOBOARD
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P774_IDACESSOINFOBOARD
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 377478353151149724
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-form-acessos-infoboard (
        name: Initialize form Form Acessos Infoboard
        type: formInitialization
        formRegion: @form-acessos-infoboard
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 377477554623149723
        }
    )

    process process-form-form-acessos-infoboard (
        name: Process form Form Acessos Infoboard
        type: formAutoRowProcessing
        formRegion: @form-acessos-infoboard
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 377477969235149723
        }
    )

)

