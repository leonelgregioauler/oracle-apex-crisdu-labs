page 796 (
    name: Acompanhamento de Despesas de Veículos
    alias: ACOMPANHAMENTO-DE-DESPESAS-DE-VEÍCULOS
    title: Acompanhamento de Despesas de Veículos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }

    region acompanhar-despesas-veículos (
        name: Acompanhar Despesas Veículos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rp.documento
                     , rp.datainclusao
                     , rp.dataemissao
                     , rp.vencimento 
                     , rp.valortotal total_requisicao
                     , f.nome unidadedenegocio
                     , prr.placa
                     , prr.valor
                     , prr.observacao
                     , rr.valor valor_rateio
                     , round( (prr.valor/rr.valor)*100,2) perc_sob_rateio
                from placasrateiosrequisicoes prr
                inner join rateiosrequisicoes rr on rr.idrateiorequisicao = prr.idrateiorequisicao
                inner join requisicoespagamentos rp on rp.idrequisicaopgto = rr.idrequisicaopgto
                                                    and ( :P796_TIPODATA = 'Z'
                                                       or ( :P796_TIPODATA = 'I' and trunc(rp.datainclusao) between to_date(:P796_DATAINICIO,'DD/MM/RRRR')
                                                                                                                and to_date(:P796_DATAFIM,'DD/MM/RRRR') )
                                                       or ( :P796_TIPODATA = 'V' and rp.vencimento between to_date(:P796_DATAINICIO,'DD/MM/RRRR')
                                                                                                       and to_date(:P796_DATAFIM,'DD/MM/RRRR') ) )                                      
                inner join vw_filiais f on f.idfilial = rr.idfilial
                where :P796_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado. Por favor, utilize os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 3600804482837963334
        }

