page 324 (
    name: Impressão de Pedido
    title: Impressão de Pedido
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão-de-pedido (
        name: Impressão de Pedido
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  vidusuario number;
                  vididioma  number;
                begin
                  --
                  select idusuario 
                       , nvl(ididioma,1)
                  into vidusuario
                     , vididioma
                  from usuarios 
                  where usuario = v('APP_USER');
                  --
                  if :P324_TIPO = 'N' then
                    --
                    favorita.pck_imprime_fav.prc_pedidos(pidpedido    => :P324_IDPEDIDO,
                                                         ppromissoria => 1,
                                                         pboleto      => 2,
                                                         pididioma    => vididioma,
                                                         pidusuario   => vidusuario );
                    --
                  else
                    --
                    catal.pck_imprime_fav.prc_imprimepedido27(vpedido => :P324_IDPEDIDO, vpromissoria => 'S');
                    --
                  end if;
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P324_IDPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @impressão-de-pedido
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P324_TIPO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @impressão-de-pedido
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vtipo varchar2(1);
                begin
                  --
                  begin
                    --
                    select 'V'
                    into vtipo
                    from catal.pedidos
                    where idpedido = :P324_IDPEDIDO;
                    --
                  exception
                    when others then
                      vtipo := 'N';
                  end;
                  --
                  return vtipo;
                  --
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

