page 486 (
    name: Relatório de Débitos Pagos
    title: Relatório de Débitos Pagos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region débitos-pagos (
        name: Débitos Pagos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(n.idvendedora) consultora 
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) representante
                     , p.datapagamento
                     , p.valorpago
                     , p.semanacobranca
                     , n.numeronota     
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||p.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' url
                from pagamentosnotasvendas p
                   , notasvendas n 
                where p.idsemanacobranca between :P486_SEMANA and :P486_SEMANAFIM
                  and p.idnotavenda    = n.idnotavenda
                  and n.idsemanacobranca != p.idsemanacobranca
                  and p.origem = 'R'
                  and n.idfilial = :P0_IDFILIAL
                  and exists (select 1
                              from catal.representantes r
                              where r.ativo = 'S'
                                and r.idrepresentante = n.idrepresentante
                                and ( :P486_IDREPRESENTANTE is null or r.idrepresentante = :P486_IDREPRESENTANTE  ))
                  and :P486_TIPORELATORIO = 'D'              
                order by 1    
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent12
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P486_TIPORELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1547935355992922128
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

