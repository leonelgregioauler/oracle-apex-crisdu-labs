                    sequence: 1
                }
            )

        )

    )

    region débitos-pagos-resumido (
        name: Débitos Pagos Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(n.idrepresentante) representante
                     , sum(p.valorpago) Total
                from pagamentosnotasvendas p
                   , notasvendas n 
                where p.idsemanacobranca between :P486_SEMANA and :P486_SEMANAFIM
                  and p.idnotavenda    = n.idnotavenda
                  and n.idsemanacobranca != p.idsemanacobranca
                  and p.origem = 'R'
                  and n.idfilial = :P0_IDFILIAL
                  and exists (select 1
                              from catal.representantes r
                              where r.ativo = 'S'
                                and r.idrepresentante = n.idrepresentante)
                               -- and ( :P486_IDREPRESENTANTE is null or r.idrepresentante = :P486_IDREPRESENTANTE  ))
                  and :P486_TIPORELATORIO = 'R'
                group by n.idrepresentante
                order by 1    
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent12
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P486_TIPORELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1560992328071981316
        }

        column REPRESENTANTE (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column TOTAL (
            type: plainText
            heading {
                heading: Total
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
