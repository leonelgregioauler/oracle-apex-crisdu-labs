    pageItem P812_ATIVA (
        type: radioGroup
        label {
            label: Campanha Ativa:
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: S
        }
    )

    pageItem P812_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P812_IDCAMPANHA (
        type: selectList
        label {
            label: "Campanha : "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecampanha
                     , c.idconquistoulevou
                from roman.campanhasconquistoulevou c
                where c.status = nvl(:P812_ATIVA,'N')
                  and c.idpais = :P812_IDPAIS
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P812_ATIVA
                P812_IDPAIS
            ]
            itemsToSubmit: P812_IDCAMPANHA
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P812_IDLOJA (
        type: selectList
        label {
            label: Franquia / Loja :
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomefilial
                     , idfilial
                 from roman.vw_franquia_loja_conquistou_levou
                where idpais = ( select cp.idpais
                                    from roman.campanhasconquistoulevou cp 
                                    where cp.idconquistoulevou = :P812_IDCAMPANHA )
                order by 1
                ```
            nullDisplayValue: --Todas--
            nullReturnValue: -1
        }
        cascadingLov {
            parentItems: P812_IDCAMPANHA
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
    )

    pageItem P812_IDPAIS (
        type: selectList
        label {
            label: "País : "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome
                     , p.idpais
                from catal.paises p
                ```
            displayNullValue: false
        }
        layout {
            sequence: 5
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
    )

    button filtrar (
