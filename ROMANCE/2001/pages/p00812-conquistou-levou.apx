                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 812
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 812
                items: {
                    P812_IDCAMPANHA: &P812_IDCAMPANHA.
                    P812_IDLOJA: &P812_IDLOJA.
                    P812_FILTRAR: S
                    P812_ATIVA: &P812_ATIVA.
                }
            }
        }
