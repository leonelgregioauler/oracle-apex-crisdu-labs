page 812 (
    name: Conquistou Levou
    alias: CONQUISTOU-LEVOU
    title: Conquistou Levou
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region conquistou-levou (
        name: "Conquistou Levou "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT roman.pck_romance.fnc_nomefilial(v.idfilial) Franquia,
                      (SELECT ct.nomecategoria
                         FROM roman.campanhascategorias cct,
                              roman.categoriasclubes ct
                        WHERE ct.idcategoriaclube = cct.idcategoriaclube
                          AND cct.idcampanhacategoria = i.idcampanhacategoria) AS  Categoria,
                       roman.pck_romance.fnc_nomevendedora(v.idvendedora) AS Empreendedora,
                      (select nvl(p.cpf,p.documentoestrangeiro) 
                          from catal.pessoas p 
                         where p.idpessoa = v.idpessoa) documento,
                       b.nomebrinde Premio,
                       CASE
                           WHEN i.idclassificacao IS NOT NULL
                                AND i.idclassificacao <> 0
                               THEN clsc.nomeclassif
                       END                                                AS classificação,
                
                       CASE
                           WHEN i.idclassificacao IS NOT NULL
                                AND i.idclassificacao <> 0
                               THEN carc.nomecaracteristica
                       END                                                AS caracteristica,
                       --camp.nomecampanha                                  AS campanha,
                       cc.idconquistoulevoucupom                          AS cupom,
                       ff.nomefilialfavorita                              AS Loja,
                      (select t.telefonelimpo
                       from catal.telefonespessoas t 
                       where t.idtelefonepessoa = (select max(t.idtelefonepessoa)
                                                   from catal.telefonespessoas t 
                                                   where t.idpessoa = v.idpessoa)) Telefone,
                      roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) Distribuidor,
                      trunc(cc.dataresgate) "Data Resgate",
                      cc.pontosusados as "Pontos Usados",
                      nvl((select d.pontosdepositados
                       from roman.depositosconquistoulevou d
                       where d.idconquistoulevou = cc.idconquistoulevou
                         and d.idvendedora = v.idvendedora
                         and d.ativo = 'A'),0) "Pontos guardados",
                      --v.pontosconquistoulevou  "Pontos guardados", 
                       case when cc.dataretirada is not null then 'Cupom Entregue' 
                            when cc.datarecebfilial is not null then 'Recebido Filial'
                            when cc.dataenviofilial is not null then 'Enviado Filial'
                            else 'Pendente Separação' end as "Situacao Cupom" ,
                      trunc(cc.dataenviofilial) "Data Envio Filial",
                      trunc(cc.datarecebfilial) "Data Receb Filial",
                      trunc(cc.dataretirada) "Data Retirada",
                      trunc(cc.dataentrega) "Data Entrega"
                
                  FROM catal.vendedoras                           v,
                       roman.conquistoulevoucupons                cc,
                       roman.campanhasconquistoulevou             camp,
                       favorita.filiaisfavorita                   ff,
                       roman.itensconqlevcupons                   i,
                       roman.brindesclub                          b,
                       roman.conquistoulevouclassificacoes        clsc,
                       roman.conquistoulevoucaracteristicas       carc
                
                 WHERE cc.idvendedora = v.idvendedora
                
                   AND camp.idconquistoulevou = cc.idconquistoulevou
                
                   AND ff.idfilialfavorita(+) = cc.idfilialretira
                
                   AND i.idconquistoulevoucupom(+) =
                       cc.idconquistoulevoucupom
                
                   AND b.idbrindeclube(+) = i.idbrindeclube
                
                   AND clsc.idclassificacao(+) = i.idclassificacao
                
                   AND carc.idclassificacao(+) = i.idclassificacao
                
                   AND carc.idcaracteristica(+) = i.idcaracteristica
                   --
                   and camp.idconquistoulevou= :P812_IDCAMPANHA
                   --
                   -- and (:P812_IDCAMPANHA = -1 or camp.idconquistoulevou= :P812_IDCAMPANHA ) 
                   -- campanha precisa ser obrigatorio para nao gerar erro TOO_MANY_ROWS na subquery da tabela roman.depositosconquistoulevou
                   --
                   and (:P812_IDLOJA = -1 or cc.idfilialretira = :P812_IDLOJA)
                   and :P812_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
