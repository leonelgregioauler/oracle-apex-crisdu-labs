page 308 (
    name: Logout
    title: Logout
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    dynamicAction logout (
        name: Logout
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      -- Call the procedure
                      catal.pck_util.prc_registraexpediente(pidsistema => 2001,
                                                            pprocesso => 'O'  );
                    
                    end;
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SAVE
            }
            execution {
                sequence: 20
            }
        )

    )

    branch (
        name: Logout
        execution {
            sequence: 10
        }
        behavior {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
    )

)

