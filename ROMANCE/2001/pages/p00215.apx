page 215 (
    name: Cadastro de Itens
    title: Cadastro de Itens
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function  confirma(event)
            { 
            var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            
            if (tecla==13) {
               apex.submit('CREATE');
             }
            }
            
            ```
    }
    css {
        fileUrls: ".t-Region-body { background-color: Blue !important;},"
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-itens (
        name: Cadastro de Itens
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P215_CUSTOUND (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 150
            region: @cadastro-de-itens
            slot: regionBody
        }
    )

