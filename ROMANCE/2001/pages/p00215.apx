    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @cadastro-de-itens
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 214
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 20
            region: @cadastro-de-itens
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P215_IDITNF
        }
    )

    dynamicAction carregar (
        name: carregar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @create
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CREATE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation valida-egg (
        name: Valida EGG
        execution {
            sequence: 90
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_estoque.fnc_estoquedisponivel(:P215_IDESTOQUEFIL,'EGG') >= nvl(to_number(:P215_QTD_EGG),0)
                ```
        }
        error {
            errorMessage: Lançamento é maior que a quantidade disponível em estoque!
        }
    )

