    validation valida-se-já-existe-produto-distribuido (
        name: Valida se já existe produto distribuido
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                
                  select 1 
                  from itemnf i
                  where i.idnotafiscal = :P215_IDNOTAFISCAL
                    and i.idproduto = :P215_IDPRODUTO;
                ```
        }
        error {
            errorMessage: Produto já Distribuído!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation valida-u (
