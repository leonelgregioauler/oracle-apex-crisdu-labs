    validation validar-quanitdade (
        name: Validar Quanitdade
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                Select 1 
                from dual
                where to_number(:P215_QTD_PP) > 0
                or to_number(:P215_QTD_P) > 0
                or to_number(:P215_QTD_M) > 0
                or to_number(:P215_QTD_G) > 0
                or to_number(:P215_QTD_GG) > 0
                or to_number(:P215_QTD_EGG) > 0
                or to_number(:P215_QTD_U) > 0
                ```
        }
        error {
            errorMessage: Informe uma quantidade Válida!
            displayLocation: inlineInNotification
        }
    )

    process busca-idestoque (
        name: BUSCA IDESTOQUE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  --
                  select idestoquefilial
                  into :P215_IDESTOQUEFIL
                  from estoquefilial e
                  where e.idfilial  = :P0_IDFILIAL
                    and e.idproduto = :P215_IDPRODUTO;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 36842950894313427
        }
    )

    process fetch-row-from-itemnf (
        name: Fetch Row from ITEMNF
        type: autoRowFetch
        source {
            tableName: ITEMNF
            pkColumn: IDITNF
            pkItem: P215_IDITNF
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 422559380649536830
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                  --
                  if :P215_IDITNF is null then
                    select "SEQ_IDTEMNF".nextval
                    into :P215_IDITNF
                    from dual;
                  end if;
                  --
                  begin
                    --
                    for i in ( select fp.precocusto
                               from fornecedoresprodutos fp
                               where fp.idproduto = :P215_IDPRODUTO
                               order by fp.dataultimaatualizacao desc )
                    loop
                      --
                      :P215_CUSTOUND := i.precocusto;
                      --
                      exit;
                      --
                    end loop;
                    --
                  exception
                    when others then
                      :P215_CUSTOUND := 1;
                  end;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 422559571251536831
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-itemnf (
        name: Process Row of ITEMNF
        type: autoRowProcessing
        target {
            tableName: ITEMNF
            pkColumn: IDITNF
            pkItem: P215_IDITNF
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 422559757818536832
        }
    )

    branch (
        name: Go To Page 215
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 215
                items: {
                    P215_IDNOTAFISCAL: &P215_IDNOTAFISCAL.
                    P215_IDITNF:
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)

