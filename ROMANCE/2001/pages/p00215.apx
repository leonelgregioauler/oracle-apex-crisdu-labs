        advanced {
            customAttributes: onKeyUp="javascript: confirma(event)"; style="text-align: right;"
        }
        source {
            type: databaseColumn
            databaseColumn: QTD_EGG
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_romance.fnc_retornaparametro('ESTOQUEPORGRADE',:P0_IDFILIAL) = 'S'
