    pageItem P215_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select CODIGOSISDIST||' - '||initcap(p.nomeproduto) display_value
                     , p.idproduto return_value
                from produtos p
                   , estoquefilial e
                where p.idproduto = e.idproduto
                  and e.idfilial  = :P0_IDFILIAL
                order by p.nomeproduto
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o Produto -
        }
        layout {
            sequence: 30
            region: @cadastro-de-itens
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: IDPRODUTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

