page 784 (
    name: Notas Acertadas Automaticamente
    title: Notas Acertadas Automaticamente
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_irparanota(pid,psemana)
            {
              window.open('f?p=&APP_ID.:37:&SESSION.::NO::P37_IDNOTAVENDA:'+pid); 
              void(0);
            }
            
            ```
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
    )

    region lista-notas-acertadas-automaticamente (
        name: Lista Notas Acertadas Automaticamente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , nv.numeronota
                     , pck_romance.fnc_cpfvendedora(nv.idvendedora) cpf
                     , pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) vendedora
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.valortotalnota
                     , nv.saldo --15292010
                     --, nv.idnotavenda
                     --, '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' url
                from roman.notasvendas nv 
                where nv.idrepresentante = :P784_IDREPRESENTANTE 
                  and nv.idfilial        = :P0_IDFILIAL
                  and nv.semanacobranca = :P784_SEMANA
                  and exists ( select 1  
                               from roman.classificacoesnotasvendas c 
                               where c.idnotavenda = nv.idnotavenda 
                                 and c.idcaracteristicanotavenda = 66)
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
