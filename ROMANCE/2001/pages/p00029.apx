page 29 (
    name: Cadastro de Região de Venda
    title: Cadastro de Região de Venda
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region cadastro-de-região-de-venda (
        name: Cadastro de Região de Venda
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region cidades (
        name: Cidades
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDCIDADEREGIAOVENDA",
                "IDCIDADEREGIAOVENDA" IDCIDADEREGIAOVENDA_DISPLAY,
                "IDREGIAOVENDA",
                "IDCIDADE"
                from "#OWNER#"."CIDADESREGIOESVENDA"
                where idregiaovenda = :P29_IDREGIAOVENDA
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P29_IDREGIAOVENDA
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (nulo)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Dados não encontrados.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Selecionar Linha
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDCIDADE (
            reportColumnQueryId: 5
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Cidade
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select c.nomecidade||' - '|| e.sigla display_value
                    , c.idcidade return_value
                    from filiaisregioesvenda f
                       , estados e
                       , cidades c
                    where f.idestado = e.idestado
                      and c.idestado = e.idestado
                      and f.idfilial = :P0_IDFILIAL
                    order by 1
                    ```
                nullDisplayValue: - Selecione a Cidade -
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 50
            }
        )

        column IDCIDADEREGIAOVENDA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDCIDREGVENDA
            }
        )

        column IDCIDADEREGIAOVENDA_DISPLAY (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column IDREGIAOVENDA (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
            default {
                type: item
                item: P29_IDREGIAOVENDA
            }
        )

    )

    pageItem P29_ATIVO (
        type: radioGroup
        label {
            label: Ativo
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @cadastro-de-região-de-venda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: ATIVO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P29_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @cadastro-de-região-de-venda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 40
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P29_IDESTADO (
        type: selectList
        label {
            label: Estado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nome||' - '||e.sigla display_value
                     , e.idestado  return_value
                from estados e
                where e.idestado in ( select f.idestado
                                      from filiaisregioesvenda f
                                      where f.idfilial = :P0_IDFILIAL)
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @cadastro-de-região-de-venda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDESTADO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P29_IDREGIAOVENDA (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-região-de-venda
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDREGIAOVENDA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar Linhas
        layout {
            sequence: 40
            region: @cidades
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @cadastro-de-região-de-venda
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 18
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @cadastro-de-região-de-venda
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P29_IDREGIAOVENDA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @cadastro-de-região-de-venda
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente excluir a região de venda?','DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where not exists ( select 1
                                   from regioesrepresentantes r
                                   where r.idregiaovenda = :P29_IDREGIAOVENDA )
                ```
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @cidades
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @cadastro-de-região-de-venda
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: never
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @cidades
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idcidade-must-be-numeric (
        name: IDCIDADE must be numeric
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @cidades
            type: columnIsNumeric
            column: IDCIDADE
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: IDCIDADE
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idregiaovenda-must-be-numeric (
        name: IDREGIAOVENDA must be numeric
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @cidades
            type: columnIsNumeric
            column: IDREGIAOVENDA
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: IDREGIAOVENDA
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation p29-descricao (
        name: P29_DESCRICAO
        execution {
            sequence: 50
        }
        validation {
            type: itemIsNotNull
            item: P29_DESCRICAO
        }
        error {
            errorMessage: Deve ser informado!
            associatedItem: @P29_DESCRICAO
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @cidades
        target {
            tableName: CIDADESREGIOESVENDA
            pkColumn: IDCIDADEREGIAOVENDA
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Linha(s) #MRD_COUNT# deletadas.
        }
        advanced {
            executionMappingIdentifier: 455952484704748291
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @cidades
        target {
            tableName: CIDADESREGIOESVENDA
            pkColumn: IDCIDADEREGIAOVENDA
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Linha(s) #MRU_COUNT# atualizada(s); linha(s) #MRI_COUNT# inserida(s).
        }
        advanced {
            executionMappingIdentifier: 455952269945748288
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process fetch-row-from-regioesvenda (
        name: Fetch Row from REGIOESVENDA
        type: autoRowFetch
        source {
            tableName: REGIOESVENDA
            pkColumn: IDREGIAOVENDA
            pkItem: P29_IDREGIAOVENDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 131680887070144742
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P29_IDREGIAOVENDA is null then
                        select "SEQ_IDREGIOESVENDA".nextval
                          into :P29_IDREGIAOVENDA
                          from dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 131681076882144745
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-regioesvenda (
        name: Process Row of REGIOESVENDA
        type: autoRowProcessing
        target {
            tableName: REGIOESVENDA
            pkColumn: IDREGIAOVENDA
            pkItem: P29_IDREGIAOVENDA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 131681281405144745
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 131681481218144745
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 18
            }
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 29
            }
        }
    )

)

