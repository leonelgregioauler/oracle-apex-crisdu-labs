    region análise-de-uso-app-romance-por-empresa (
        name: Análise de Uso APP Romance Por Empresa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                       -- Filial e mês
                select geral_2.mes, 
                       roman.pck_romance.fnc_nomefilial(geral_2.filial) filial,
                       
                       -- Dados Ano Atual 
                       geral_2.consultoras_Atual,
                       geral_2.login_Atual,
                       round ( ( favorita.pck_util_fav.FNC_DIVISOR_ZERO( geral_2.Login_Atual , geral_2.Consultoras_Atual)) * 100 ,2) percatual,
                
                       -- Dados Ano Anterior
                       geral_2.consultoras_Anterior,
                       geral_2.login_Anterior,
                       round ( ( favorita.pck_util_fav.FNC_DIVISOR_ZERO( geral_2.Login_Anterior , geral_2.Consultoras_Anterior)) * 100 ,2) percanterior,
                       
                       -- percentual Crescimento Login 
                       case
                         when geral_2.Login_Anterior > geral_2.Login_Atual then
                           round( favorita.pck_util_fav.FNC_DIVISOR_ZERO((geral_2.Login_Anterior-geral_2.Login_Atual),geral_2.Login_Atual ) * 100 ,2) *-1
                         when geral_2.Login_Anterior < geral_2.Login_Atual then
                           round(( favorita.pck_util_fav.FNC_DIVISOR_ZERO((geral_2.Login_Atual-geral_2.Login_Anterior),geral_2.Login_Anterior) ) * 100 ,2) 
                         else
                           0
                       end PercLogin,
                         
                       -- percentual Crescimento Consultora
                       case
                         when geral_2.Consultoras_Anterior > geral_2.Consultoras_Atual then
                           round( favorita.pck_util_fav.FNC_DIVISOR_ZERO((geral_2.Consultoras_Anterior-geral_2.Consultoras_Atual),geral_2.Consultoras_Atual ) * 100 ,2) *-1
                         when geral_2.Consultoras_Anterior < geral_2.Consultoras_Atual then
                           round(( favorita.pck_util_fav.FNC_DIVISOR_ZERO((geral_2.Consultoras_Atual-geral_2.Consultoras_Anterior),geral_2.Consultoras_Anterior) ) * 100 ,2) 
                         else
                           0
                       end Percconsultora
                
                  from (        -- Filial e mês
                         select geral.mes,
                                geral.filial,
                                
                                -- Dados Ano Atual
                                sum(geral.consultoras_Atual) consultoras_Atual,
                                sum(geral.login_Atual) login_Atual,
                                
                                -- Dados Ano Anterior
                                sum(geral.consultoras_Anterior) consultoras_Anterior,
                                sum(geral.login_Anterior) login_Anterior
                
                           from ( -- dados ano atual(selecionado no filtro do relatório)
                                  select extract (month from n.datanota ) mes,
                                         n.idfilial Filial,
                                         count( distinct n.idvendedora) consultoras_Atual,
                                         count( t.idvendedora) login_Atual,
                                         0 consultoras_Anterior,
                                         0 login_Anterior
                                    from roman.notasvendas n,
                                         roman.tab_aux_roman_apk2001_691 t
                                   where n.datanota between to_date('01/'||:P691_MESINI||'/'||:P691_ANO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and 
                                                            to_date(extract(day from(last_day('01/'||:P691_MESFIM||'/'||:P691_ANO)))||'/'||:P691_MESFIM||'/'||:P691_ANO||' 23:59:59','DD/MM/RRRR HH24:MI:SS') 
                                     and n.idsituacaonotavenda in (3,4)
                                     and t.idvendedora(+) = n.idvendedora
                                     and t.ano(+) = :P691_ANO
                                     and t.mes(+) between :P691_MESINI and :P691_MESFIM
                                     and ( :P691_IDFILIAL is null /*todas*/or 
                                          (:P691_IDFILIAL = -1 /*somente brasil*/and exists( select 1 
                                                                                               from catal.filiais ff
                                                                                              where ff.idgrupo in (1,2,3,4)
                                                                                                and ff.idfilial = n.idfilial)) or 
                                         n.idfilial = :P691_IDFILIAL/*somente uma filail*/)
                                   group by extract (month from n.datanota ),
                                            n.idfilial
                                 
                                   union all -- esse union jontas os dados do ano atual e ano anterior
                                   
                                  -- dados ano anterior
                                  select extract (month from n.datanota ) mes,
                                         n.idfilial Filial,
                                         0 consultoras_Atual,
                                         0 login_Atual,
                                         count( distinct n.idvendedora) consultoras_Anterior,
                                         count( t.idvendedora) login_Anterior
                                    from roman.notasvendas n,
                                         roman.tab_aux_roman_apk2001_691 t
                                   where n.datanota between to_date('01/'||:P691_MESINI||'/'||(:P691_ANO - 1)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and 
                                                            to_date(extract (day from last_day(('01/'||&P691_MESFIM||'/'|| (&P691_ANO - 1))))||'/'||&P691_MESFIM||'/'||(&P691_ANO-1)||' 00:00:00','DD/MM/RRRR HH24:MI:SS')
                                     and n.idsituacaonotavenda in (3,4)
                                     and t.idvendedora(+) = n.idvendedora
                                     and t.ano(+) = :P691_ANO - 1
                                     and t.mes(+) between :P691_MESINI and :P691_MESFIM
                                     and ( :P691_IDFILIAL is null /*todas*/or 
                                          (:P691_IDFILIAL = -1 /*somente brasil*/and exists( select 1 
                                                                                               from catal.filiais ff
                                                                                              where ff.idgrupo in (1,2,3,4)
                                                                                                and ff.idfilial = n.idfilial)) or 
                                         n.idfilial = :P691_IDFILIAL/*somente uma filail*/)
                                   group by extract (month from n.datanota ),
                                         n.idfilial
                                ) geral
                            group by mes,
                                     filial
                     ) geral_2
                 where :P691_TIPOREL = 'R'
                 order by 1,2;
                
                
                       
                       
                       
                       
                       
                       
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
