    region análise-de-uso-app-romance-por-distribuidor (
        name: Análise de Uso APP Romance  Por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select geral_2.mes,
                       roman.pck_romance.fnc_nomefilial(geral_2.filial) Filial,
                       roman.pck_romance.fnc_nomerepresentante(geral_2.representante) representante,
                               
                       geral_2.Consultoras_Atual,
                       geral_2.Login_Atual,
                               
                       geral_2.Login_Anterior,
                       geral_2.Consultoras_Anterior,
                
                       round ( ( favorita.pck_util_fav.FNC_DIVISOR_ZERO( geral_2.Login_Atual , geral_2.Consultoras_Atual)) * 100 ,2) percatual,
                       round ( ( favorita.pck_util_fav.FNC_DIVISOR_ZERO( geral_2.Login_Anterior , geral_2.Consultoras_Anterior)) * 100 ,2) percanterior,
                       
                       case
                         when geral_2.Login_Anterior > geral_2.Login_Atual then
                           round( favorita.pck_util_fav.FNC_DIVISOR_ZERO((geral_2.Login_Anterior-geral_2.Login_Atual),geral_2.Login_Atual ) * 100 ,2) *-1
                         when geral_2.Login_Anterior < geral_2.Login_Atual then
                           round(( favorita.pck_util_fav.FNC_DIVISOR_ZERO((geral_2.Login_Atual-geral_2.Login_Anterior),geral_2.Login_Anterior) ) * 100 ,2) 
                         else
                           0
                       end PercLogin,
                       case
                         when geral_2.Consultoras_Anterior > geral_2.Consultoras_Atual then
                           round( favorita.pck_util_fav.FNC_DIVISOR_ZERO((geral_2.Consultoras_Anterior-geral_2.Consultoras_Atual),geral_2.Consultoras_Atual ) * 100 ,2) * -1
                         when geral_2.Consultoras_Anterior < geral_2.Consultoras_Atual then
                           round(( favorita.pck_util_fav.FNC_DIVISOR_ZERO((geral_2.Consultoras_Atual-geral_2.Consultoras_Anterior),geral_2.Consultoras_Anterior) ) * 100 ,2) 
                         else
                           0
                       end Percconsultora
                
                  from (select geral_1.mes,
                               geral_1.filial,
                               geral_1.representante,
                               
                               sum(geral_1.Consultoras_Atual) Consultoras_Atual,
                               sum(geral_1.Login_Atual) Login_Atual,
                               
                               sum(geral_1.Login_Anterior) Login_Anterior,
                               sum(geral_1.Consultoras_Anterior) Consultoras_Anterior
                               
                          from (-- dados ano atual(selecionado no filtro do relatório)
                                select extract(month from n.datanota) mes,
                                       n.idfilial filial,
                                       n.idrepresentante representante,
                                       
                                       count(n.idvendedora) Consultoras_Atual,
                                       count(t.qtd_acessos) Login_Atual,
                                       
                                       0 Login_Anterior,
                                       0 Consultoras_Anterior
                                  from roman.notasvendas n,
                                       roman.tab_aux_roman_apk2001_691 t
                                 where n.datanota between to_date('01/'||:P691_MESINI||'/'||:P691_ANO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                                      and to_date(extract(day from(last_day('01/'||:P691_MESFIM||'/'||:P691_ANO)))||'/'||:P691_MESFIM||'/'||:P691_ANO||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                   and t.idvendedora(+) = n.idvendedora
                                   and t.ano(+) = :P691_ANO
                                   and t.mes(+) between :P691_MESINI and :P691_MESFIM
                                   and ( :P691_IDFILIAL is null /*todas*/or 
                                        (:P691_IDFILIAL = -1 /*somente brasil*/and exists( select 1 
                                                                                             from catal.filiais ff
                                                                                            where ff.idgrupo in (1,2,3,4)
                                                                                              and ff.idfilial = n.idfilial)) or 
                                       n.idfilial = :P691_IDFILIAL/*somente uma filail*/)
                                 group by extract(month from n.datanota),
                                          n.idfilial,
                                          n.idrepresentante
                
                                union all -- esse union juntas os dados do ano atual e ano anterior
                
                                -- dados ano anterior
                                select extract(month from n.datanota) mes,
                                       n.idfilial,
                                       n.idrepresentante,
                                       
                                       0 Consultoras_Atual,
                                       0 Login_Atual,
                                       
                                       count(t.qtd_acessos) Login_Anterior,
                                       count(n.idvendedora) Consultoras_Anterior
                                  from roman.notasvendas n,
                                       roman.tab_aux_roman_apk2001_691 t
                                 where n.datanota between to_date('01/'||:P691_MESINI||'/'|| (:P691_ANO - 1) ||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                                      and to_date(extract(day from(last_day('01/'||:P691_MESFIM||'/'|| (:P691_ANO - 1) )))||'/'||:P691_MESFIM||'/'||(:P691_ANO - 1)||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                   and t.idvendedora(+) = n.idvendedora
                                   and t.ano(+) = :P691_ANO - 1
                                   and t.mes(+) between :P691_MESINI and :P691_MESFIM
                                   and ( :P691_IDFILIAL is null /*todas*/or 
                                        (:P691_IDFILIAL = -1 /*somente brasil*/and exists( select 1 
                                                                                             from catal.filiais ff
                                                                                            where ff.idgrupo in (1,2,3,4)
                                                                                              and ff.idfilial = n.idfilial)) or 
                                       n.idfilial = :P691_IDFILIAL/*somente uma filail*/)
                                 group by extract(month from n.datanota),
                                          n.idfilial,
                                          n.idrepresentante) geral_1
                         group by geral_1.mes,
                                  geral_1.filial,
                                  geral_1.representante ) geral_2
                 order by 1,2,3
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
