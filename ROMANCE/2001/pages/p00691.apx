    pageItem P691_ANO (
        type: selectList
        label {
            label: Ano
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.ano display_value
                     , x.ano return_value
                from ( select distinct(dt.ano) 
                       from roman.datasperiodos dt
                       where dt.ano <= extract(year from sysdate)
                       order by 1 desc) x
                where rownum <= 5
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P691_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P691_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                
                union 
                
                select '- Brasil -' as nome
                     , -1 as filial
                from dual
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P691_MESFIM (
        type: selectList
        label {
            label: Mês Final
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(dt.mes) || ' - ' || to_char(to_date(dt.mes,'MM'), 'Month', 'NLS_DATE_LANGUAGE=Portuguese') display_value
                     , dt.mes return_value
                from roman.datasperiodos dt
                where dt.ano = :P691_ANO
                order by 2;
                ```
        }
        cascadingLov {
            parentItems: P691_ANO
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P691_MESINI (
        type: selectList
        label {
            label: Mês Inicial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(dt.mes) || ' - ' || to_char(to_date(dt.mes,'MM'), 'Month', 'NLS_DATE_LANGUAGE=Portuguese') display_value
                     , dt.mes return_value
                from roman.datasperiodos dt
                where dt.ano = :P691_ANO
                order by 2;
                ```
        }
        cascadingLov {
            parentItems: P691_ANO
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P691_TIPOREL (
        type: radioGroup
        label {
            label: Tipo Relatório
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Resumido/Empresa;R,Detalhado/Distribuidor;D
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 691
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 691
                items: {
                    P691_ANO: &P691_ANO.
                    P691_MESINI: &P691_MESINI.
                    P691_MESFIM: &P691_MESFIM.
                    P691_IDFILIAL: &P691_IDFILIAL.
                    P691_FILTRAR: S
                    P691_TIPOREL: &P691_TIPOREL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

