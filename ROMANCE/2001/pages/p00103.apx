page 103 (
    name: Cadastro de Funcionário
    title: Cadastro de Funcionário
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 65%
        height: 65%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    headerAndFooter {
        footerText:
            ```html
            <script javascript>
             window.resizeTo(screen.width*.46,screen.height*.46);  
                window.moveTo(screen.width*.26, screen.height*.20);  
            </script>
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-funcionário (
        name: Cadastro de Funcionário
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    pageItem P103_ATIVO (
        type: radioGroup
        label {
            label: Ativo
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @cadastro-de-funcionário
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: ATIVO
            used: always
        }
        default {
            type: static
            staticValue: S
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P103_IDCARGO (
        type: selectList
        label {
            label: Cargo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nome    display_value
                     , c.idcargo return_value
                from cargos c
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o Cargo -
        }
        layout {
            sequence: 30
            region: @cadastro-de-funcionário
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCARGO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P103_IDENTIFICACAO (
        type: textField
        label {
            label: Identificação Interna ( Usuário )
            alignment: left
        }
        layout {
            sequence: 70
            region: @cadastro-de-funcionário
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 50
        }
        source {
            type: databaseColumn
            databaseColumn: IDENTIFICACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P103_IDFUNCIONARIO (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-funcionário
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFUNCIONARIO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P103_IDGERENTE (
        type: selectList
        label {
            label: Gerente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomepessoa display_value
                     , g.idgerente return_value
                from pessoas      p
                   , gerentes     g
                where g.idpessoa = p.idpessoa
                  and g.ativo  = 'S'
                  and g.idfilial = :P0_IDFILIAL
                order by 1
                ```
            nullDisplayValue: - Selecione o Gerente -
        }
        layout {
            sequence: 60
            region: @cadastro-de-funcionário
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDGERENTE
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P103_IDPESSOA (
        type: hidden
        layout {
            sequence: 20
            region: @cadastro-de-funcionário
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPESSOA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P103_IDUSUARIO (
        type: selectList
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.usuario    display_value
                     , u.idusuario  return_value
                from usuarios u
                   , usuariossistemas s
                where u.usuario = s.usuario
                  and u.ativo   = 'S'
                  and s.idsistema = 1000
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o Usuário -
        }
        layout {
            sequence: 50
            region: @cadastro-de-funcionário
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P103_LIMITE (
        type: numberField
        label {
            label: Limite Compra RMC
            alignment: left
        }
        layout {
            sequence: 80
            region: @cadastro-de-funcionário
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 10
        }
        source {
            type: databaseColumn
            databaseColumn: LIMITE
            used: always
        }
        readOnly {
            type: expression
            language: sql
            sqlExpression: pck_util.fnc_verificaacesso(351,v('APP_USER')) = 'N'
        }
    )

    pageItem P103_LIMITEDISPONIVEL (
        type: numberField
        label {
            label: Limite Disponivel RMC
            alignment: left
        }
        layout {
            sequence: 90
            region: @cadastro-de-funcionário
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 10
        }
        source {
            type: databaseColumn
            databaseColumn: LIMITEDISPONIVEL
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vrealizado number;
                  vdisponivel number;
                begin
                  --
                  begin
                    --
                    select sum(nv.valorpago)
                    into vrealizado
                    from notasvendas nv
                       , vendedoras v
                    where nv.idfilial = 1098
                      and to_char(nv.datanota,'MM/RRRR') = to_char(sysdate,'MM/RRRR')
                      and nv.idvendedora = v.idvendedora
                      and v.idpessoa = :P103_IDPESSOA;
                    --
                  exception
                    when others then
                      vrealizado := 0;
                  end;
                  --
                  vdisponivel := :P103_LIMITE - vrealizado;
                  --
                  return vdisponivel;
                  --
                end;
                ```
        }
        readOnly {
            type: always
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @cadastro-de-funcionário
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 8
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @cadastro-de-funcionário
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P103_IDFUNCIONARIO
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @cadastro-de-funcionário
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: 103
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P103_IDFUNCIONARIO
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @cadastro-de-funcionário
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P103_IDFUNCIONARIO
        }
    )

    process atualiza-limites-funcionarios (
        name: Atualiza Limites Funcionarios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  vrealizado number;
                  vdisponivel number;
                begin
                  --
                  begin
                    --
                    select sum(nv.valorpago)
                    into vrealizado
                    from notasvendas nv
                       , vendedoras v
                    where nv.idfilial = 1098
                      and to_char(nv.datanota,'MM/RRRR') = to_char(sysdate,'MM/RRRR')
                      and nv.idvendedora = v.idvendedora
                      and v.idpessoa = :P103_IDPESSOA;
                    --
                  exception
                    when others then
                      vrealizado := 0;
                  end;
                  --
                  vdisponivel := :P103_LIMITE - nvl(vrealizado,0);
                  --
                  update funcionarios f
                  set f.limitedisponivel = vdisponivel
                  where f.idfuncionario = :P103_IDFUNCIONARIO;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 148058340116351543
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process fetch-row-from-funcionarios (
        name: Fetch Row from FUNCIONARIOS
        type: autoRowFetch
        source {
            tableOwner: CATAL
            tableName: FUNCIONARIOS
            pkColumn: IDFUNCIONARIO
            pkItem: P103_IDFUNCIONARIO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 161879661942763685
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P103_IDFUNCIONARIO is null then
                        select "SEQ_IDFUNCIONARIOS".nextval
                          into :P103_IDFUNCIONARIO
                          from dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 161879882431763687
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process limite-disponível (
        name: Limite Disponível
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  vrealizado number;
                begin
                  --
                  begin
                    --
                    select sum(nv.valorpago)
                    into vrealizado
                    from notasvendas nv
                       , vendedoras v
                    where nv.idfilial = 1098
                      and to_char(nv.datanota,'MM/RRRR') = to_char(sysdate,'MM/RRRR')
                      and nv.idvendedora = v.idvendedora
                      and v.idpessoa = :P103_IDPESSOA;
                    --
                  exception
                    when others then
                      vrealizado := 0;
                  end;
                  --
                  :P103_LIMITEDISPONIVEL := :P103_LIMITE - vrealizado;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 148058094567351540
        }
    )

    process process-row-of-funcionarios (
        name: Process Row of FUNCIONARIOS
        type: autoRowProcessing
        target {
            tableOwner: CATAL
            tableName: FUNCIONARIOS
            pkColumn: IDFUNCIONARIO
            pkItem: P103_IDFUNCIONARIO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 161880081086763687
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 161880286555763687
        }
        serverSideCondition {
            whenButtonPressed: @delete
