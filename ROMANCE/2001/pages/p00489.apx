page 489 (
    name: Log de Fotos de Documentos
    title: Log de Fotos de Documentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region controle-de-logs (
        name: Controle de Logs
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ft.idlog
                     , ft.dataalteracao
                     , ft.usuarioalteracao
                     , decode(ft.tipoalteracao,'UPDATE','Atualização'
                                              ,'INSERT','Inclusão'
                                              ,'DELETE','Exclusão') tipoalteracao
                     , ft.documento
                     , ft.tipofoto
                     , ft.nomearquivo
                     , pck_romance.fnc_nomerepresentante(ft.idrepresentante) distribuidor
                     , decode(ft.recebida,'S','Sim','N','Não') recebida
                     , ft.idtablet
                     , pck_util.fnc_semanaid(ft.idsemana) semana
                     , decode(ft.aprovado,'S','Sim','N','Não') aprovado
                     , decode(ft.revisado,'S','Sim','N','Não') revisado
                     , ft.datarevisao
                     , ft.usuariorevisao
                from logroman.log_fotosdocumentos ft
                where ft.documento = :P489_CPF 
                order by ft.dataalteracao desc
                ```
            pageItemsToSubmit: P489_CPF
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado. Verifique o CPF informado.
        }
        advanced {
            savedReportMappingIdentifier: 3269525850734565411
        }

        column APROVADO (
            type: plainText
            heading {
                heading: Aprovado
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column DATAALTERACAO (
            type: plainText
            heading {
                heading: Data Alteração
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
