    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P489_CPF (
        type: textField
        label {
            label: CPF
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 15
            valuePlaceholder: Informe o CPF
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P489_CPF
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @controle-de-logs
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

