    button salvar (
        buttonName: SALVAR
        label: Salvar e Enviar Novamente
        layout {
            sequence: 20
            region: @negativação
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.negativacoesspc n
                where n.idnegativacaospc = :P619_IDNEGATIVACAOSPC 
                  and n.status = 'E'
                ```
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @negativação
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 618
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-em-negativações-spc (
        name: Consulta em Negativações SPC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Declare
                  --
                  vdata date;
                  --
                Begin
                  --
                  PCK_CADASTROS_RMC.PRC_NEGATIVACOESSPC( PIDNEGATIVACAOSPC => :P619_IDNEGATIVACAOSPC,
                                                        PDATA => vdata,
                                                        PDATAPROCESSADO => :P619_DATAPROCESSADO,
                                                        PUSUARIO => :P619_USUARIO,
                                                        PIDPESSOA => :P619_IDPESSOA,
                                                        PIDVENDEDORA => :P619_IDVENDEDORA,
                                                        PCPF => :P619_CPF,
                                                        PNOME => :P619_NOME,
                                                        PDATANASCIMENTO => :P619_DATANASCIMENTO,
                                                        PDDD => :P619_DDD,
                                                        PTELEFONE => :P619_TELEFONE,
                                                        PDATACOMPRA => :P619_DATACOMPRA,
                                                        PDATAVENCIMENTO => :P619_DATAVENCIMENTO,
                                                        PNUMEROCONTRATO => :P619_NUMEROCONTRATO,
                                                        PVALORDEBITO => :P619_VALORDEBITO,
                                                        PIDNATUREZAINCLUSAO => :P619_IDNATUREZAINCLUSAO,
                                                        PCEP => :P619_CEP,
                                                        PENDERECO => :P619_ENDERECO,
                                                        PBAIRRO => :P619_BAIRRO,
                                                        PNUMERO => :P619_NUMERO,
                                                        PMD5 => :P619_MD5,
                                                        POPERACAO_DML => 'S');
                  --
                  :P619_DATA := to_char(vdata,'DD/MM/RRRR HH24:MI:SS'); 
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 113670054094439042
        }
    )

    process processo-dml-em-negativações-spc (
        name: Processo DML em Negativações SPC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Declare
                  --
                  vdata date;
                  --
                Begin
                  --
                  vdata := to_date(:P619_DATA,'DD/MM/RRRR HH24:MI:SS');
                  --
                  PCK_CADASTROS_RMC.PRC_NEGATIVACOESSPC( PIDNEGATIVACAOSPC => :P619_IDNEGATIVACAOSPC,
                                                        PDATA => vdata,
                                                        PDATAPROCESSADO => :P619_DATAPROCESSADO,
                                                        PUSUARIO => :P619_USUARIO,
                                                        PIDPESSOA => :P619_IDPESSOA,
                                                        PIDVENDEDORA => :P619_IDVENDEDORA,
                                                        PCPF => :P619_CPF,
                                                        PNOME => :P619_NOME,
                                                        PDATANASCIMENTO => :P619_DATANASCIMENTO,
                                                        PDDD => :P619_DDD,
                                                        PTELEFONE => :P619_TELEFONE,
                                                        PDATACOMPRA => :P619_DATACOMPRA,
                                                        PDATAVENCIMENTO => :P619_DATAVENCIMENTO,
                                                        PNUMEROCONTRATO => :P619_NUMEROCONTRATO,
                                                        PVALORDEBITO => :P619_VALORDEBITO,
                                                        PIDNATUREZAINCLUSAO => :P619_IDNATUREZAINCLUSAO,
                                                        PCEP => :P619_CEP,
                                                        PENDERECO => :P619_ENDERECO,
                                                        PBAIRRO => :P619_BAIRRO,
                                                        PNUMERO => :P619_NUMERO,
                                                        PMD5 => :P619_MD5,
                                                        POPERACAO_DML => 'U');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 113716565791452408
        }
        serverSideCondition {
            type: request=Value
            value: SALVAR
        }
    )

)

