page 395 (
    name: Acompanhamento de Fotos de Documentos
    title: Acompanhamento de Fotos de Documentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_aprovar(pid)
            {
              document.getElementById("P395_IDEDITAR").value = pid;
              apex.submit('APROVAR');
            }
            
            function fnc_reprovar(pid)
            {
              document.getElementById("P395_IDEDITAR").value = pid;
              apex.submit('REPROVAR');
            }
            
            function fnc_remover(pid)
            {
              document.getElementById("P395_IDEDITAR").value = pid;
              apex.submit('REMOVER');
            }
            ```
    }
    css {
        inline:
            ```css
            .img_documento {
                position: relative;
                max-width: 360px;
                width: 60%;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region fotos-detalhadas (
        name: Fotos Detalhadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.documento
                     , nvl(initcap(p.nomepessoa),'Cadastrada Somente no Tablet') nomepessoa
                     , f.tipofoto
                     , f.data 
                     , decode(f.recebida,'S','Sim','Não') recebida
                     , decode(f.revisado,'S','Sim','Não') revisada
                     , case 
                         when nvl(f.revisado,'N') = 'N' and f.aprovado is null then 
                           '<a href="javascript:fnc_aprovar('||f.idfotodocumento||')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         when f.aprovado = 'S' then
                           'Foto Aprovada!'
                       end aprovar
                     , case 
                         when nvl(f.revisado,'N') = 'N' and f.aprovado is null then 
                           '<a href="javascript:fnc_reprovar('||f.idfotodocumento||')" ><img src="#APP_IMAGES#Deslike.png"  border="0"></a>'
                         when f.aprovado = 'N' then
                           'Foto Reprovada!'
                       end reprovar
                     , pck_romance.fnc_nomerepresentante(f.idrepresentante) representante
                     , pck_util.fnc_semanaid(f.idsemana) semana
                     , nomearquivo
                     , '<a href=javascript:fnc_remover('||f.idfotodocumento||');><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt=""></a>' remover
                     , '<a href="http://fotos_documentos.romancemoda.com.br/'||f.nomearquivo||'" target="_blank"> <img src="http://fotos_documentos.romancemoda.com.br/'||f.nomearquivo||'" class="img_documento"><a>' foto
                from fotosdocumentos f
                   , pessoas p
                where p.cpf(+) = f.documento
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = f.idrepresentante
                                 and r.idgerente       = ( select idgerente 
                                                           from gerentes g 
                                                           where g.idfilial = :P0_IDFILIAL ) )
                  and ( :P395_IDREPRESENTANTE = -1 or f.idrepresentante = :P395_IDREPRESENTANTE )
                  and ( :P395_SITUACAO = 'T'
                       or ( :P395_SITUACAO = 'A' and aprovado = 'S' )
                       or ( :P395_SITUACAO = 'R' and aprovado = 'N' ) )
                  and ( :P395_TIPOPESQUISA is not null and
                      ( :P395_TIPOPESQUISA = 'S' and f.idsemana = :P395_SEMANA ) or
                      ( :P395_TIPOPESQUISA = 'D' and trunc(f.data) between to_date(:P395_DATAINICIO) and to_date(:P395_DATAFIM) ) )
                order by 1 desc; 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <font color="green"><h2> Ao REPROVAR a foto, será necessário tirar uma nova quando o distribuidor realizar o próximo atendimento com a cliente!</h2></font>
        }
        componentAppearance {
            showNullValuesAs: -
