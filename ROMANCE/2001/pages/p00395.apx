    process aprovar-foto (
        name: Aprovar Foto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update fotosdocumentos f
                  set f.revisado = 'S'
                    , f.aprovado = 'S'
                    , datarevisao = sysdate
                    , usuariorevisao = v('APP_USER')
                  where f.idfotodocumento = :P395_IDEDITAR;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Foto Aprovada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1436349415955288750
        }
        serverSideCondition {
            type: request=Value
            value: APROVAR
        }
    )

    process remover-marcação (
        name: Remover Marcação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update fotosdocumentos f
                  set f.revisado = null
                    , f.aprovado = null
                    , datarevisao = null
                    , usuariorevisao = null
                  where f.idfotodocumento = :P395_IDEDITAR;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Marcação removida com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1444529582324760525
        }
        serverSideCondition {
            type: request=Value
            value: REMOVER
        }
    )

    process reprovar (
        name: Reprovar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update fotosdocumentos f
                  set f.revisado = 'S'
                    , f.aprovado = 'N'
                    , datarevisao = sysdate
                    , usuariorevisao = v('APP_USER')
                  where f.idfotodocumento = :P395_IDEDITAR;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Foto reprovada com sucesso! Vai ser necessário tirar novamente.
        }
        advanced {
            executionMappingIdentifier: 1438871156613602101
        }
        serverSideCondition {
            type: request=Value
            value: REPROVAR
        }
    )

    branch (
        name: Go To Page 395
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 395
                items: {
                    P395_IDREPRESENTANTE: &P395_IDREPRESENTANTE.
                    P395_TIPOPESQUISA: &P395_TIPOPESQUISA.
                    P395_SEMANA: &P395_SEMANA.
                    P395_DATAFIM: &P395_DATAFIM.
                    P395_DATAINICIO: &P395_DATAINICIO.
                    P395_SITUACAO: &P395_SITUACAO.
                    P395_FOTO: &P395_FOTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

