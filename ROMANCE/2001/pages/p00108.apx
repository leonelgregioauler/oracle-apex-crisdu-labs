    htmlHeader {
        htmlHeader:
            ```html
            <script language="javascript">
            function  confirmapgto(event)
            { 
            var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            
            if (tecla==13) {
            var answer = confirm("Confirma pagamento do cheque?")
            	if (answer){            
            		apex.submit('CREATE');
            	}
            }
            }
            </script>
            ```
    }
    security {
        formAutoComplete: true
    }
