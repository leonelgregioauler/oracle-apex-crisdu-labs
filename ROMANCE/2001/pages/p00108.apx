    region efetuar-pagamento-do-cheque (
        name: Efetuar pagamento do cheque
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentorepresentantes r
                   , fechamentossemanais s
                where r.idfechamento = s.idfechamento
                  and nvl(s.concluido,'N') = 'N'
                  and r.idfechamentorepres = :P108_IDFECHAMENTOREPRES
                ```
        }
    )

    region lista-de-cheques-sem-fundo-do-distribuidor (
        name: Lista de Cheques sem fundo do Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.IDCHEQUE
                     , v('P108_IDFECHAMENTOREPRES') idfechamento
                     , initcap(bb.nomebanco) Banco
                     , c.AGENCIA
                     , c.CONTA
                     , c.NRCHEQUE
                     , c.DATAINCLUSAO
                     , initcap(nvl(pr.apelido,pr.nomepessoa)||' ( '||nvl(pf.apelido,pf.nomepessoa)||' ) ') Representante
                     , initcap(cc.nomecidade)||' - '||upper(ee.sigla) cidade
                     , c.VALOR
                     , c.PREDATADO
                     , c.OBSERVACAO
                     , c.DESTINO
                     , decode(c.semfundo, 'S','Sim', 'Não') Semfundo
                     , decode(c.pago, 'S','Sim', 'Não') Pago
                     , ( select nvl(sum(p.valor),0) from cheques2pgto p where p.idcheque = c.idcheque ) valorpago
                     , c.VALOR - ( select nvl(sum(p.valor),0) from cheques2pgto p where p.idcheque = c.idcheque ) sALDO
                from CHEQUES2 c
                   , bancos   bb
                   , representantes r
                   , gerentes g
                   , pessoas  pr
                   , filiais    f
                   , pessoas    pf
                   , cidades cc
                   , estados ee
                where c.idbanco         = bb.idbanco   (+)
                  and c.idrepresentante = r.idrepresentante(+)
                  and r.idpessoa        = pr.idpessoa(+)
                  and r.idgerente       = g.idgerente
                  and g.idfilial        = f.idfilial(+)
                  and f.idpessoa        = pf.idpessoa(+)
                  and c.idcidade        = cc.idcidade(+)
                  and cc.idestado       = ee.idestado(+)
                  and c.semfundo = 'S'
                  and c.idcheque = :P108_IDCHEQUE
                group by c.IDCHEQUE
                     , bb.nomebanco 
                     , c.AGENCIA
                     , c.CONTA
                     , c.NRCHEQUE
                     , c.DATAINCLUSAO
                     , pr.apelido
                     , pr.nomepessoa
                     , pf.apelido
                     , pf.nomepessoa
                     , cc.nomecidade
                     , ee.sigla
                     , c.VALOR
                     , c.PREDATADO
                     , c.OBSERVACAO
                     , c.DESTINO
                     , c.semfundo
                     , c.pago
                     , c.valor
                ```
        }
        layout {
            sequence: 5
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
