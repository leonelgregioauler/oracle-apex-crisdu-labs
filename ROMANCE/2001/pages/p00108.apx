    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDCHQ2PGTO.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P108_IDCHEQUEPGTO := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 166779458180138883
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process paga-cheque (
        name: paga cheque
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vcheque  number := :P108_IDCHEQUE;
                  vsoma    number(15,2);
                  vvlrchq  number(15,2);
                  --
                begin
                  --
                  select sum(c.valor)
                  into vsoma
                  from cheques2pgto c
                  where c.idcheque = vcheque;
                  --
                  select cc.valor
                  into vvlrchq
                  from cheques2 cc
                  where cc.idcheque = vcheque;
                  --
