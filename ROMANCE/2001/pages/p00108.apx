    validation p108-valor (
        name: P108_VALOR
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from cheques2 c
                   , cheques2pgto p
                where c.idcheque = :P108_IDCHEQUE
                  and c.idcheque = p.idcheque(+)
                  HAVING c.valor-nvl(sum(p.valor),0)-to_number(:P108_VALOR) >= 0
                group by c.valor
                ```
        }
        error {
            errorMessage: O valor total pago deve ser menor ou igual ao valor do cheque.
            associatedItem: @P108_VALOR
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

