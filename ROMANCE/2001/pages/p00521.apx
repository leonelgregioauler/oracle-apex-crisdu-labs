page 521 (
    name: Parcelamentos de Emprestimo
    title: Parcelamentos de Emprestimo
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region parcelamento (
        name: Parcelamento
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region parcelamentos-realizados (
        name: Parcelamentos Realizados
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "IDPARCEMPRESTIMO",
                "IDEMPRESTIMO",
                "DATAVENCIMENTO",
                "VALORAPAGAR",
                "SITUACAO"
                from "#OWNER#"."PARCELAMENTOSEMPRESTIMOS"
                where IDEMPRESTIMO = :P521_IDEMPRESTIMO
                order by DATAVENCIMENTO 
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from parcelamentosemprestimos
                where idemprestimo = :P521_IDEMPRESTIMO
                ```
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }

        column CHECK$01 (
            reportColumnQueryId: 7
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
            serverSideCondition {
                type: never
            }
        )

        column DATAVENCIMENTO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: datePicker
            heading {
                heading: Data de Vencimento
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: DD/MM/RRRR
                width: 10
            }
            sorting {
                sortable: false
            }
        )

        column IDEMPRESTIMO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column IDPARCEMPRESTIMO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
            security {
                escapeSpecialChars: false
            }
        )

        column SITUACAO (
            reportColumnQueryId: 6
            derivedColumn: N
            type: selectList
            heading {
                heading: Situação
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC: Quitado;Q,Vencido;V,Aberto;A,Em Espera;E
                displayNullValue: false
            }
            layout {
                sequence: 7
            }
            sorting {
                sortable: false
            }
        )

        column VALORAPAGAR (
            reportColumnQueryId: 5
            derivedColumn: N
            type: textField
            heading {
                heading: Valor A Pagar
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
                width: 5
            }
            sorting {
                sortable: false
            }
            advanced {
                customAttributes: style="text-align:right"
            }
        )

    )

    pageItem P521_IDEMPRESTIMO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @parcelamento
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P521_QTDPARCELAMENTO (
        type: selectList
        label {
            label: "+ "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value
                     , return_value 
                from( select '1 Parcela' display_value
                     , 1 return_value
                from dual
                union
                select '2 Parcelas' 
                     , 2 return_value
                from dual
                union
                select '3 Parcelas' 
                     , 3 return_value
                from dual
                union
                select '4 Parcelas' 
                     , 4 return_value
                from dual
                union
                select '5 Parcelas' 
                     , 5 return_value
                from dual
                union
                select '6 Parcelas' 
                     , 6 return_value
                from dual
                union
                select '7 Parcelas' 
                     , 7 return_value
                from dual
                union
                select '8 Parcelas' 
                     , 8 return_value
                from dual
                union
                select '9 Parcelas' 
                     , 9 return_value
                from dual
                union
                select '10 Parcelas' 
                     , 10 return_value
                from dual
                union
                select '11 Parcelas' 
                     , 11 return_value
                from dual
                union
                select '12 Parcelas' 
                     , 12 return_value
                from dual
                union
                select '13 Parcelas' 
                     , 13 return_value
                from dual
                union
                select '14 Parcelas' 
                     , 14 return_value
                from dual
                union
                select '15 Parcelas' 
                     , 15 return_value
                from dual
                union
                select '16 Parcelas' 
                     , 16 return_value
                from dual
                union
                select '17 Parcelas' 
                     , 17 return_value
                from dual
                union
                select '18 Parcelas' 
                     , 18 return_value
                from dual
                union
                select '19 Parcelas' 
                     , 19 return_value
                from dual
                union
                select '20 Parcelas' 
                     , 20 return_value
                from dual
                union
                select '21 Parcelas' 
                     , 21 return_value
                from dual
                union
                select '22 Parcelas' 
                     , 22 return_value
                from dual
                union
                select '23 Parcelas' 
                     , 23 return_value
                from dual
                union
                select '24 Parcelas' 
                     , 24 return_value
                from dual)
                order by 2
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @parcelamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P521_TIPOPARCELAMENTO (
        type: radioGroup
        label {
            label: "Tipo de Parcelamento "
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Com Entrada;E,Sem Entrada;S
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @parcelamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P521_VALORENTRADA (
        type: numberField
        label {
            label: Valor Entrada
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @parcelamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P521_VENCIMENTOENTRADA (
        type: datePickerJquery
        label {
            label: Vencimento Entrada
            alignment: left
        }
        layout {
            sequence: 30
            region: @parcelamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 20
            region: @parcelamentos-realizados
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 204
                items: {
                    P204_IDEMPRESTIMO: &P521_IDEMPRESTIMO.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button desfazer (
        buttonName: DESFAZER
        label: Desfazer Parcelamento
        layout {
            sequence: 10
            region: @parcelamentos-realizados
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button parcelar (
        buttonName: PARCELAR
        label: Parcelar
        layout {
            sequence: 60
            region: @parcelamento
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @parcelamentos-realizados
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-parcelamento (
        name: Tipo Parcelamento
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P521_TIPOPARCELAMENTO
        }
        clientSideCondition {
            type: item=value
            item: P521_TIPOPARCELAMENTO
            value: E
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P521_VALORENTRADA
                    P521_VENCIMENTOENTRADA
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P521_VALORENTRADA
                    P521_VENCIMENTOENTRADA
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    validation valida-parcelamento-existente (
        name: Valida Parcelamento Existente
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from parcelamentosemprestimos p
                where p.idemprestimo = :P521_IDEMPRESTIMO
                  and p.situacao     = 'A'
                ```
        }
        error {
            errorMessage: Parcelamento existente, verifique a informação ou entre em contato com o Suporte.
        }
        serverSideCondition {
            type: request=Value
            value: PARCELAR
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @parcelamentos-realizados
        target {
            tableName: PARCELAMENTOSEMPRESTIMOS
            pkColumn: ROWID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: #MRU_COUNT# linha(s) atualizada(s), #MRI_COUNT# linha(s) inserida(s).
        }
        advanced {
            executionMappingIdentifier: 1585700736885339310
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

    process desfaz-parcelamento-realizado (
        name: Desfaz parcelamento realizado
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_acertos_rmc.prc_desfazparcemprestimos( pidemprestimo => :P521_IDEMPRESTIMO );
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Parcelamento desfeito com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1585700590336339308
        }
        serverSideCondition {
            type: request=Value
            value: DESFAZER
        }
    )

    process realiza-parcelamento (
        name: Realiza parcelamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                  -- Call the procedure
                  pck_acertos_rmc.prc_realizaparcelamento(ptipoparcelamento => :P521_TIPOPARCELAMENTO,
                                                          pvalorentrada => :P521_VALORENTRADA,
                                                          pvencimentoentrada => :P521_VENCIMENTOENTRADA,
                                                          pqtdparcelamento => :P521_QTDPARCELAMENTO,
                                                          pidemprestimo => :P521_IDEMPRESTIMO);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Parcelamento realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1585636476548790141
        }
        serverSideCondition {
            type: request=Value
            value: PARCELAR
        }
    )

)

