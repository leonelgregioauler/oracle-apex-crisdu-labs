            }
        )

    )

    pageItem P450_AVISO (
        type: displayOnly
        label {
            label: " "
            alignment: left
        }
        layout {
            sequence: 20
            region: @iniciar-balanço
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        advanced {
            preText: <b>Selecionar a última semana que irá receber a cobrança. Ex: Se parou na semana 20/2018, ele vai receber até a semana 26, então selecione a semana 26/2018.</b>
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P450_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P450_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' - Ult. Balanço: '||pck_util.fnc_semanaid( r.idsemanabalanco ) ||' Semana Atual Atendimento: '||( select trim(to_char(semana,'00'))||'/'||ano
                                                                                                                                                                                from semana_dias s
                                                                                                                                                                                where s.idsemana = ( select min(idsemana)
                                                                                                                                                                                                     from regioesrepresentantes
                                                                                                                                                                                                     where idrepresentante = r.idrepresentante ) ) display_value
                     , r.idrepresentante return_value
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente
                  and g.idfilial = :P0_IDFILIAL
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P450_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00'))||'/'||ano||' - ( '||to_char(dt_ini,'DD/MM/RRRR')||' - '||to_char(dt_fim,'DD/MM/RRRR')||' ) ' display_value
                     , idsemana return_value
                from semana_dias
                where sysdate between dt_ini-21 and dt_fim + 21 
                order by idsemana
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione -
        }
        layout {
            sequence: 30
            region: @iniciar-balanço
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P450_QTD_VALOR (
        type: radioGroup
        label {
            label: Colunas
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Quantidade;Q,Valor;V,Ambos;A
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: V
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P450_TIPO (
        type: radioGroup
