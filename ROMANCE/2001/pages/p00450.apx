            label: Tipo
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Resumido;R,Produto;D,Categoria;C
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

    button confirmar (
        buttonName: CONFIRMAR
        label: Confirmar Balanço
        layout {
            sequence: 40
            region: @iniciar-balanço
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button p450-filtrar (
        buttonName: P450_FILTRAR
        label: Filtrar
        layout {
            sequence: 20
            region: @filtro
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: P209_FILTRAR
        }
    )

    button p450-iniciarnovobalanco (
        buttonName: P450_INICIARNOVOBALANCO
        label: Iniciar Novo Balanço
        layout {
            sequence: 10
            region: @filtro
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: openModal('INICIARBALANCO');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P450_IDREPRESENTANTE
        }
    )

    button p450-verbalancoatual (
        buttonName: P450_VERBALANCOATUAL
        label: Ver Balanço Inicial Atual
        layout {
            sequence: 30
            region: @filtro
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 403
                items: {
                    P403_IDREPRESENTANTE: &P450_IDREPRESENTANTE.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P450_IDREPRESENTANTE
        }
    )

    button p450-vercadastro (
        buttonName: P450_VERCADASTRO
        label: Ver Cadastro
        layout {
            sequence: 40
            region: @filtro
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 135
                items: {
                    P135_IDREPRESENTANTE: &P450_IDREPRESENTANTE.
                    P135_PAGINA: 330
                }
                clearCache: 135
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P450_IDREPRESENTANTE
        }
    )

    dynamicAction confirma (
        name: Confirma
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @confirmar
        }

        action native-confirm (
            action: confirm
            settings {
                message:
                    ```html
                    Confirma o Balanço deste distribuidor?
                    
                    Isto pode demorar alguns minutos.
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CONFIRMABALANCO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction filtrar (
        name: filtrar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @p450-filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction filtro (
        name: filtro
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P450_FILTRO
        }
        clientSideCondition {
            type: item=value
            item: P450_FILTRO
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P450_IDREPRESENTANTE
                    P450_TIPO
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P450_IDREPRESENTANTE
                    P450_TIPO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction mudar-distribuidor (
        name: Mudar Distribuidor
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P450_IDREPRESENTANTE
        }

        action native-set-value (
            action: setValue
            settings {
                value: N
            }
            affectedElements {
                selectionType: items
                items: P450_FILTRAR
            }
            execution {
                sequence: 20
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: MUDADISTRIBUIDOR
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    validation valida-inicio-de-balanço (
        name: Valida Inicio de Balanço
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where not exists ( select 1
                                   from fechamentorepresentantes fr
                                      , fechamentossemanais f
                                   where f.idfechamento     = fr.idfechamento
                                     and fr.idrepresentante = :P450_IDREPRESENTANTE
                                     and f.idsemana         = :P450_IDSEMANA )
                ```
        }
        error {
            errorMessage: "Não é possível realizar o balanço, não existe um acerto para essa semana. "
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMABALANCO
        }
    )

    validation valida-semana (
        name: Valida Semana
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P450_IDSEMANA
        }
        error {
            errorMessage: Informe a Semana!
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMABALANCO
        }
    )

    process confirma-balanço (
        name: Confirma Balanço
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_balanco_rmc.prc_iniciabalanco(pidrepresentante => :P450_IDREPRESENTANTE,
                                                pidsemana => :P450_IDSEMANA);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 856758961118418022
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMABALANCO
        }
    )

    branch (
        name: filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 450
                items: {
                    P450_IDREPRESENTANTE: &P450_IDREPRESENTANTE.
                    P450_TIPO: &P450_TIPO.
                    P450_QTD_VALOR: &P450_QTD_VALOR.
                    P450_FILTRAR: N
                }
                successMessage: false
            }
        }
        serverSideCondition {
            type: request=Value
            value: MUDADISTRIBUIDOR
        }
    )

    branch (
        name: filtro
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 450
                items: {
                    P450_IDREPRESENTANTE: &P450_IDREPRESENTANTE.
                    P450_TIPO: &P450_TIPO.
                    P450_QTD_VALOR: &P450_QTD_VALOR.
                    P450_FILTRAR: S
                }
                successMessage: false
            }
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

)

