    region categoria (
        name: Categoria
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomecategoria(c.idcategoria) categoria
                     , '|' separador
                     , sum(nvl(prod.qtdbalancoinicial,0)) qtdbalancoinicial
                     , sum(nvl(prod.valorbalancoinicial,0)) valorbalancoinicial
                     , '+' seq_balanco
                     , sum(nvl(prod.carga,0)) carga
                     , sum(nvl(prod.vlrcarga,0)) vlrcarga
                     , '-' sep_devol
                     , sum(nvl(prod.devolucao,0)) devolucao
                     , sum(nvl(prod.vlrdevolucao,0)) vlrdevolucao
                     , '-' sep_vend
                     , sum(nvl(prod.vendido,0)) vendido
                     , sum(nvl(prod.vlrvendido,0)) vlrvendido
                     , '-' sep_foiparaoutro
                     , sum(nvl(prod.qtddevolveufoioutro,0)) qtddevolveufoioutro
                     , sum(nvl(prod.valordevolveufoioutro,0)) valordevolveufoioutro
                     , '+' sep_veiodeoutro
                     , sum(nvl(prod.qtddevolveuveiooutros,0)) qtddevolveuveiooutros
                     , sum(nvl(prod.valordevolveuveiooutros,0)) valordevolveuveiooutros
                     , '-' sep_aberto
                     , sum(nvl(prod.acobrar,0)) acobrar
                     , sum(nvl(prod.vlrcobrar,0)) vlrcobrar
                     , '=' sep_resultado
                     , sum(nvl(prod.qtdresultado,0)) qtdresultado
                     , sum(nvl(prod.vlrresultado,0)) vlrresultado
                     , sum(nvl(prod.vlrresultadosem35,0)) vlrresultadosem35
                from categorias c
                   , ( select idcategoria
                            , qtdbalancoinicial
                            , case
                                when charcomissao = 'S' then
                                  valorbalancoinicial
                                when charcomissao = 'N' then
                                  ( valorbalancoinicial * 1.45 )
                              end valorbalancoinicial
                            , carga
                            , case
                                when charcomissao = 'S' then
                                  vlrcarga
                                when charcomissao = 'N' then
                                  ( vlrcarga * 1.45 )
                              end vlrcarga
                            , devolucao
                            , case
                                when charcomissao = 'S' then
                                  vlrdevolucao
                                when charcomissao = 'N' then
                                  ( vlrdevolucao * 1.45 )
                              end vlrdevolucao
                            , vendido
                            , case
                                when charcomissao = 'S' then
                                  vlrvendido
                                when charcomissao = 'N' then
                                  ( vlrvendido * 1.45 )
                              end vlrvendido
                            , qtddevolveufoioutro 
                            , case
                                when charcomissao = 'S' then
                                  valordevolveufoioutro
                                when charcomissao = 'N' then
                                  ( valordevolveufoioutro * 1.45 )
                              end valordevolveufoioutro
                            , qtddevolveuveiooutros 
                            , case
                                when charcomissao = 'S' then
                                  valordevolveuveiooutros
                                when charcomissao = 'N' then
                                  ( valordevolveuveiooutros * 1.45 )
                              end valordevolveuveiooutros
                            , acobrar
                            , case
                                when charcomissao = 'S' then
                                  vlracobrar
                                when charcomissao = 'N' then
                                  ( vlracobrar * 1.45 )
                              end vlrcobrar
                            , ( qtdbalancoinicial
                              + carga
                              - devolucao
                              - vendido
                              - qtddevolveufoioutro
                              + qtddevolveuveiooutros
                              - acobrar ) qtdresultado
                            , case
                                when charcomissao = 'S' then
                                  ( nvl(valorbalancoinicial,0)
                                  + nvl(vlrcarga,0)
                                  - nvl(vlrdevolucao,0)
                                  - nvl(vlrvendido,0)
                                  - nvl(valordevolveufoioutro,0)
                                  + nvl(valordevolveuveiooutros,0)
                                  - nvl(vlracobrar,0) ) 
                                when charcomissao = 'N' then
                                  ( nvl(valorbalancoinicial*1.45,0)
                                  + nvl(vlrcarga*1.45,0)
                                  - nvl(vlrdevolucao*1.45,0)
                                  - nvl(vlrvendido*1.45,0)
                                  - nvl(valordevolveufoioutro*1.45,0)
                                  + nvl(valordevolveuveiooutros*1.45,0)
                                  - nvl(vlracobrar*1.45,0) ) 
                              end vlrresultado
                            , case
                                when charcomissao = 'S' then
                                  ( ( nvl(valorbalancoinicial,0)
                                    + nvl(vlrcarga,0)
                                    - nvl(vlrdevolucao,0)
                                    - nvl(vlrvendido,0)
                                    - nvl(valordevolveufoioutro,0)
                                    + nvl(valordevolveuveiooutros,0)
                                    - nvl(vlracobrar,0) ) * 0.65 ) 
                                when charcomissao = 'N' then
                                  ( ( nvl(valorbalancoinicial*1.45,0)
                                    + nvl(vlrcarga*1.45,0)
                                    - nvl(vlrdevolucao*1.45,0)
                                    - nvl(vlrvendido*1.45,0)
                                    - nvl(valordevolveufoioutro*1.45,0)
                                    + nvl(valordevolveuveiooutros*1.45,0)
                                    - nvl(vlracobrar*1.45,0) ) * 0.65 )
                              end vlrresultadosem35
                       from vw_balancoprodutos_repres w
                       where w.idrepresentante = :P450_IDREPRESENTANTE ) prod
                where prod.idcategoria(+) = c.idcategoria
                group by c.idcategoria 
                order by 1
                ```
        }
        layout {
            sequence: 60
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent6
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P450_TIPO
            value: C
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        download {
            csvExportEnabled: true
            linkText: Baixar CSV
        }

