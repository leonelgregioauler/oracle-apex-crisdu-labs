    region balanço-por-semana (
        name: "Balanço por Semana "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distribuidor
                   , semana
                 --  , QTDINICIALBALANCO        qtdbalancoinicial
                 --  , nvl(valorinicialbalanco,0) balancoinicial
                   , carga        
                   , valorcarga     valorcarga
                   , '-' s1
                   , devolucao
                   , valordevolucao    valordevolucao
                   , '-' s2
                   , vendeu
                   , valorvendeu      valorvendeu
                   , '-' s3
                   , emaberto
                   , valoremaberto      valoremaberto
                --   , '-' s9
                -- , valoremabertooutrareg
                   , '-' s7
                   , w.qtddevolveufoioutro
                   , w.valordevolveufoioutro
                   , '+' s8
                   , w.qtddevolveuveiooutros
                   , w.valordevolveuveiooutros
                   , '=' s4
                   , faltadevolver
                   , w.valorfaltadevolver valorfaltadevolver
                   , w.valorfaltadevolversem35 valorfaltadevolversem35
                 --   , '|' s5
                 --   , debitos
                 --  , debitoscobranca
                   , '|' s5
                   , ( select sum(w1.faltadevolver)
                       from vw_balanco_representantes_rmc w1
                       where w1.idrepresentante = w.idrepresentante
                         and w1.idsemana       <= w.idsemana ) qtdsaldoparcial
                   , ( select sum(w1.valorfaltadevolver)
                       from vw_balanco_representantes_rmc w1
                       where w1.idrepresentante = w.idrepresentante
                         and w1.idsemana       <= w.idsemana ) valorsaldoparcial
                   , '|' s6
                   , nvl(w.debitos,0) debitos
                   , nvl(w.debitoscobrados,0) debitoscobrados
                   , nvl(w.debitossetorcobranca,0) debitossetorcobranca
                
                from vw_balanco_representantes_rmc w
                where idrepresentante = :P450_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P450_TIPO = 'R' AND :P450_FILTRAR = 'S'
        }
        componentAppearance {
            showNullValuesAs: -
        }
