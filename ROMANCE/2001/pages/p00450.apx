    region produto (
        name: Produto
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ first_rows (50) */ produto
                     , ativo
                     , comissao
                     , vlrvenda
                     , '|' separador
                     , qtdbalancoinicial
                     , case
                         when charcomissao = 'S' then
                           valorbalancoinicial
                         when charcomissao = 'N' then
                           ( valorbalancoinicial * 1.45 )
                       end valorbalancoinicial
                     , '+' sep_balancoinicial
                     , carga
                     , case
                         when charcomissao = 'S' then
                           vlrcarga
                         when charcomissao = 'N' then
                           ( vlrcarga * 1.45 )
                       end vlrcarga
                     , '-' sep_devol
                     , devolucao
                     , case
                         when charcomissao = 'S' then
                           vlrdevolucao
                         when charcomissao = 'N' then
                           ( vlrdevolucao * 1.45 )
                       end vlrdevolucao
                     , '-' sep_vend
                     , vendido
                     , case
                         when charcomissao = 'S' then
                           vlrvendido
                         when charcomissao = 'N' then
                           ( vlrvendido * 1.45 )
                       end vlrvendido
                     , '-' sep_foiparaoutro
                     , qtddevolveufoioutro
                     , case
                         when charcomissao = 'S' then
                           valordevolveufoioutro
                         when charcomissao = 'N' then
                           ( valordevolveufoioutro * 1.45 )
                       end valordevolveufoioutro
                     , '+' sep_veiodeoutro
                     , qtddevolveuveiooutros
                     , case
                         when charcomissao = 'S' then
                           valordevolveuveiooutros
                         when charcomissao = 'N' then
                           ( valordevolveuveiooutros * 1.45 )
                       end valordevolveuveiooutros
                     , '-' sep_aberto
                     , acobrar
                     , case
                         when charcomissao = 'S' then
                           vlracobrar
                         when charcomissao = 'N' then
                           ( vlracobrar * 1.45 )
                       end vlracobrar
                     , '=' sep_result
                     , ( qtdbalancoinicial
                       + carga
                       - devolucao
                       - vendido
                       - qtddevolveufoioutro
                       + qtddevolveuveiooutros
                       - acobrar ) qtdresultado
                     , case
                         when charcomissao = 'S' then
                           ( nvl(vlrcarga,0)
                           - nvl(vlrdevolucao,0)
                           - nvl(vlrvendido,0)
                           - nvl(valordevolveufoioutro,0)
                           + nvl(valordevolveuveiooutros,0)
                           - nvl(vlracobrar,0) ) 
                         when charcomissao = 'N' then
                           ( nvl(vlrcarga*1.45,0)
                           - nvl(vlrdevolucao*1.45,0)
                           - nvl(vlrvendido*1.45,0)
                           - nvl(valordevolveufoioutro*1.45,0)
                           + nvl(valordevolveuveiooutros*1.45,0)
                           - nvl(vlracobrar*1.45,0) ) 
                       end vlrresultado
                     , case
                         when charcomissao = 'S' then
                           ( ( nvl(vlrcarga,0)
                             - nvl(vlrdevolucao,0)
                             - nvl(vlrvendido,0)
                             - nvl(valordevolveufoioutro,0)
                             + nvl(valordevolveuveiooutros,0)
                             - nvl(vlracobrar,0) ) * 0.65 ) 
                         when charcomissao = 'N' then
                           ( ( nvl(vlrcarga*1.45,0)
                             - nvl(vlrdevolucao*1.45,0)
                             - nvl(vlrvendido*1.45,0)
                             - nvl(valordevolveufoioutro*1.45,0)
                             + nvl(valordevolveuveiooutros*1.45,0)
                             - nvl(vlracobrar*1.45,0) ) * 0.65 )
                       end vlrresultadosem35
                from vw_balancoprodutos_repres w
                where idrepresentante = :P450_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 50
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P450_TIPO
            value: D
        }
        reportLayout {
            numberOfRows: 400
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        messages {
            whenNoDataFound: no data found
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
            linkText: Baixar CSV
        }

