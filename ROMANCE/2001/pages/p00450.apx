    region balanço-total (
        name: "Balanço TOTAL "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distribuidor
                     , w.idrepresentante
                     , pck_util.fnc_semanaid(w.idsemanabalanco) semana
                     , sum(nvl(QTDINICIALBALANCO  ,0)) qtdbalancoinicial
                     , sum(nvl(valorinicialbalanco,0)) balancoinicial
                     , '+' s0
                     , sum(carga                ) carga
                     , sum(valorcarga           ) valorcarga
                     , '-' s1               
                     , sum(devolucao            ) devolucao
                     , sum(valordevolucao       ) valordevolucao
                     , '-' s2               
                     , sum(vendeu               ) vendeu
                     , sum(valorvendeu          ) valorvendeu
                     , '-' s3               
                     , sum(emaberto             ) emaberto
                     , sum(valoremaberto/*+valoremabertooutrareg*/        ) valoremaberto
                     , '+' s6
                   , sum(qtddevolveuveiooutros)   qtddevolveuveiooutros
                   , sum(valordevolveuveiooutros) valordevolveuveiooutros
                     , '-' s7
                    , sum(qtddevolveufoioutro)    qtddevolveufoioutro
                    , sum(valordevolveufoioutro)  valordevolveufoioutro
                     , '=' s4               
                     , sum(faltadevolver        ) faltadevolver
                     , sum(w.valorfaltadevolver ) valorfaltadevolver
                     , sum(w.valorfaltadevolversem35 ) valorfaltadevolversem35
                     , '|' s5               
                     , sum(w.debitos) debitos
                     , sum(w.debitoscobrados) debitoscobrados
                     , sum(w.debitossetorcobranca) debitossetorcobranca
                from vw_balanco_representantes_rmc2 w
                where w.idrepresentante = :P450_IDREPRESENTANTE 
                group by distribuidor, w.idsemanabalanco
                     , w.idrepresentante
                
                ```
            pageItemsToSubmit: P450_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P450_TIPO = 'R' AND :P450_FILTRAR = 'S'
        }
