page 345 (
    name: Pedidos Não Aprovados
    title: Pedidos Não Aprovados
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region pedidos-detalhado (
        name: Pedidos Detalhado
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.numeropedido
                     , p.representante
                     , p.vendedora
                     , p.dataemissao
                     , p.dataentrega
                     , p.datacancelamento
                     , p.valortotal
                     , ( select ( select c.nomecidade ||' - '|| e.sigla from cidades c , estados e where c.idestado = e.idestado and c.idcidade = pv.idcidade )
                         from pessoas pv 
                         where pv.idpessoa = ( select idpessoa 
                                               from vendedoras     v
                                               where v.idvendedora = p.idvendedora) ) cidadevendedora
                     , p.tipopedido
                     , p.regiaocliente
                from favorita.vw_pedidos_fav p
                where exists ( select 1
                               from favorita.classificacoespedidos c
                               where c.idpedido = p.idpedido
                                 and c.idcaracteristicapedido = 25 )
                  and p.ididioma = 1
                  and p.idsituacaoentrega = 20000
                  and p.idfilialromance = :P0_IDFILIAL
                  and ( :P345_IDREPRESENTANTE is null or p.idrepresentante = :P345_IDREPRESENTANTE)
                  and ( :P345_TIPODATA = 'E' and trunc(dataemissao) between to_date(:P345_DTINI,'DD/MM/RRRR') and to_date(:P345_DTFIM,'DD/MM/RRRR')
                     or :P345_TIPODATA = 'A' and trunc(dataentrega) between to_date(:P345_DTINI,'DD/MM/RRRR') and to_date(:P345_DTFIM,'DD/MM/RRRR') )
                ORDER BY 1,4
                ```
        }
        layout {
            sequence: 50
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 5000
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--staticRowColors
                t-Report--rowHighlightOff
            ]
            showNullValuesAs: " - "
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: Não há pedidos não aprovados
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
            csvSeparator: ;
            linkText: <font size="18">Clique aqui para baixar para Excel</font>
            filename: pedidos_nao_aprovados
        }

        column CIDADEVENDEDORA (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Cidade Consultora
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column DATACANCELAMENTO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Cancelamento
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column DATAEMISSAO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Emissão
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column DATAENTREGA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Entrega
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            sorting {
                sortable: false
            }
        )

        column NUMEROPEDIDO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nr Pedido
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column REGIAOCLIENTE (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Região Consultora
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column REPRESENTANTE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column TIPOPEDIDO (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column VALORTOTAL (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 9
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

        column VENDEDORA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

    )

    region pedidos-não-aprovados (
        name: Pedidos Não Aprovados
        type: staticContent
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
    )

    region pedidos-resumido (
        name: Pedidos resumido
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(p.idrepresentante )  "Representante"
                     , Sum(valortotal) "Valor Total"
                     , count(1) "Qtd Pedidos"
                from favorita.vw_pedidos_fav p
                where exists ( select 1
                               from favorita.classificacoespedidos c
                               where c.idpedido = p.idpedido
                                 and c.idcaracteristicapedido = 25 )
                  and p.ididioma = 1
                  and p.idsituacaoentrega = 20000
                  and p.idfilialromance = :P0_IDFILIAL
                  and ( :P345_TIPODATA = 'E' and trunc(dataemissao) between to_date(:P345_DTINI,'DD/MM/RRRR') and to_date(:P345_DTFIM,'DD/MM/RRRR')
                     or :P345_TIPODATA = 'A' and trunc(dataentrega) between to_date(:P345_DTINI,'DD/MM/RRRR') and to_date(:P345_DTFIM,'DD/MM/RRRR') )
                group by p.idrepresentante
                ORDER BY 1
                ```
        }
        layout {
            sequence: 60
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 300
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--staticRowColors
                t-Report--rowHighlightOff
            ]
            showNullValuesAs: " - "
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: Não há pedidos não aprovados
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
            csvSeparator: ;
            linkText: <font size="18">Clique aqui para baixar para Excel</font>
            filename: pedidos_nao_aprovados
        }

        column "Qtd Pedidos" (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Qtd Pedidos
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

        column Representante (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column "Valor Total" (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Valor Total
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

    )

    pageItem P345_DTFIM (
        type: datePickerJquery
        label {
            label: até
            alignment: left
        }
        layout {
            sequence: 40
            region: @pedidos-não-aprovados
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        validation {
            maxLength: 4000
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v number;
                  d date;
                begin
                
                  select idsemana+1
                  into v
                  from semana_dias
                  where semana = to_number(substr( :P345_SEMANA,1,2))
                    and ano    = substr( :P345_SEMANA,4,4);
                
                  select dt_fim
                  into d
                  from semana_dias
                  where idsemana = v;
                  return d;
                exception
                  when others then
                    return null;
                end;
                
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P345_DTINI (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 30
            region: @pedidos-não-aprovados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        validation {
            maxLength: 4000
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v number;
                  d date;
                begin
                
                  select idsemana+1
                  into v
                  from semana_dias
                  where semana = to_number(substr( :P345_SEMANA,1,2))
                    and ano    = substr( :P345_SEMANA,4,4);
                
                  select dt_ini
                  into d
                  from semana_dias
                  where idsemana = v;
                  return d;
                exception
                  when others then
                    return null;
                end;
                
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P345_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @representantes
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 60
            region: @pedidos-não-aprovados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P345_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @pedidos-não-aprovados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P345_TIPO (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Detalhado;D,Resumido;R
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @pedidos-não-aprovados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: D
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P345_TIPODATA (
        type: radioGroup
        label {
            label: Filtar
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Emissão;E,Entrega;A
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @pedidos-não-aprovados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: E
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @pedidos-não-aprovados
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo (
        name: tipo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P345_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P345_TIPO
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @pedidos-detalhado
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: region
                region: @pedidos-resumido
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @pedidos-detalhado
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: region
                region: @pedidos-resumido
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 345
                items: {
                    P345_TIPO: &P345_TIPO.
                    P345_DTINI: &P345_DTINI.
                    P345_DTFIM: &P345_DTFIM.
                    P345_IDREPRESENTANTE: &P345_IDREPRESENTANTE.
                }
                successMessage: false
            }
        }
    )

)

