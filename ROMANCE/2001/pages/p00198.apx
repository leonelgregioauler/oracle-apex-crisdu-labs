    process deleta-cargas-selecionadas (
        name: deleta cargas selecionadas
        type: executeCode
        editableRegion: @cargas-da-semana
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  delete from itenscargarepresentante ic
                  where ic.idcargarepresentante = :IDCARGAREPRESENTANTE;
                  
                  delete from cargasrepresentantes c
                  where c.idcargarepresentante = :IDCARGAREPRESENTANTE;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Carga(s) Deletada(s) com sucesso!
        }
        advanced {
            executionMappingIdentifier: 23268441536092442
        }
        serverSideCondition {
            whenButtonPressed: @multi-row-delete
        }
    )

    branch (
        name: Go To Page 198
        execution {
            sequence: 21
        }
        behavior {
            target: {
                page: 198
                items: {
                    P198_SEMANA: &P198_SEMANA.
                }
                action: resetPagination
            }
