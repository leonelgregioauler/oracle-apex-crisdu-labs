page 198 (
    name: Apagar Cargas Seleção
    title: Apagar Cargas Seleção
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region cargas-da-semana (
        name: Cargas da Semana
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                IDCARGAREPRESENTANTE,
                pck_romance.fnc_nomerepresentante(idrepresentante) "Representante",
                SEMANA,
                ( select sum(nvl((nvl(qtd_dist_pp ,0) 
                                    + nvl(qtd_dist_p ,0)  
                                    + nvl(qtd_dist_m ,0)  
                                    + nvl(qtd_dist_g ,0)
                                    + nvl(qtd_dist_gg,0)  
                                    + nvl(qtd_dist_egg,0) 
                                    + nvl(qtd_dist_exgg,0) 
                                    + nvl(qtd_dist_u,0))*i.valorvenda,0)) 
                         from itenscargarepresentante i 
                         where i.idcargarepresentante = c.idcargarepresentante ) "Valor Carregado",
                decode( situacao, 1 , 'Aberto'
                                         , 2 , 'Aguardando Conclusão'
                                         , 3 , 'Concluído'
                                         , 0 , 'Cancelada') "Situação"
                , ( select max(cc.dataalteracao)
                    from logroman.log_cargasrepresentantes cc
                    where cc.idcargarepresentante = c.idcargarepresentante
                      and cc.tipoalteracao = 'INSERT' ) "Data Inclusão"
                from cargasrepresentantes c
                where semana = :P198_SEMANA
                  and idfilial = :P0_IDFILIAL
                order by 6 desc
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P198_SEMANA
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 7
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column "Data Inclusão" (
