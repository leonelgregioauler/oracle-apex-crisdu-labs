    region pedidos-detalhado (
        name: Pedidos Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pf.representante "Representante"
                     , pf.idpedido
                     , pf.numeropedido
                     , pf.situacaoentregainterno
                     , pf.situacaofinanceirointerno
                     , pf.vendedora "Consultora"
                     , trunc(dataemissao)  "Data Emissão"
                     , dataentrega "Data Entrega"
                     , pf.datavencimentomenor "Data Vencimento"
                     , pf.valortotal "Valor Total"
                     , pf.valorapagar_orig "Valor a Pagar"
                     , ( select ( select c.nomecidade ||' - '|| e.sigla from cidades c , estados e where c.idestado = e.idestado and c.idcidade = pv.idcidade )
                         from pessoas        pv 
                         where pv.idpessoa = ( select idpessoa 
                                               from vendedoras     v
                                               where v.idvendedora = pf.idvendedora) ) "Cidade Vendedora"
                     , pf.desctipopedido "Pedido - Ret. Pontos"
                     , pf.regiaocliente "Região de Venda"
                     , ( select listagg(h.datahistorico|| '-' ||h.descricao,' / ') within group ( order by 1 desc )
                         from favorita.historicospedidos h
                         where h.idpedido = pf.idpedido ) historicos
                     ,( select  LISTAGG(( select u.usuario
                                          from usuarios u
                                  where u.idusuario = cp.idusuario)||'-'||favorita.pck_util_fav.fnc_nomecaracteristicapedido(cp.idcaracteristicapedido,1)||'-'||to_char(cp.dataclassificado,'dd/mm/rrrr hh:mm:ss') , '; ') WITHIN GROUP (ORDER BY 1 desc) as Caracteristicas
                        from favorita.classificacoespedidos cp
                        where cp.idpedido = pf.idpedido
                          and cp.idcaracteristicapedido in (9,25,26) ) as Caracteristicas
                     , datacancelamento
                     , case
                         when idempresavirtualage > 199 then
                           'Novo'
                         else 
                           'Antigo'
                       end cnpj
                from favorita.vw_pedidos_fav pf
                where pf.ididioma        = 1
                  and pf.idfilialromance = :P0_IDFILIAL
                  and pf.datacancelamento is not null
                  and ( :P252_PERIODO_CANCELAMENTO = 4
                     or ( :P252_PERIODO_CANCELAMENTO = 1 and pf.idsituacaoentrega < 20000 )
                     or ( :P252_PERIODO_CANCELAMENTO = 2 and pf.idsituacaoentrega = 20000 )
                     or ( :P252_PERIODO_CANCELAMENTO = 3 and pf.idsituacaoentrega > 20000 ) )
                  and ( :P252_IDREPRESENTANTE is null or pf.idrepresentante = :P252_IDREPRESENTANTE)
                  and ( ( :P252_TIPODATA = 'E' and trunc(pf.dataemissao) between to_date(:P252_DTINI,'DD/MM/RRRR') and to_date(:P252_DTFIM,'DD/MM/RRRR') )
                     or ( :P252_TIPODATA = 'A' and trunc(pf.dataentrega) between to_date(:P252_DTINI,'DD/MM/RRRR') and to_date(:P252_DTFIM,'DD/MM/RRRR') )
                     or ( :P252_TIPODATA = 'C' and trunc(pf.datacancelamento) between to_date(:P252_DTINI,'DD/MM/RRRR') and to_date(:P252_DTFIM,'DD/MM/RRRR') ) )
                ORDER BY 1,4
                ```
        }
        layout {
            sequence: 60
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P252_TIPO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 562688845489185803
        }

