    pageItem P252_DTFIM (
        type: datePickerJquery
        label {
            label: até
            alignment: left
        }
        layout {
            sequence: 40
            region: @pedidos-cancelados
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        validation {
            maxLength: 4000
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v number;
                  d date;
                begin
                
                  select idsemana+1
                  into v
                  from semana_dias
                  where semana = to_number(substr( :P252_SEMANA,1,2))
                    and ano    = substr( :P252_SEMANA,4,4);
                
                  select dt_fim
                  into d
                  from semana_dias
                  where idsemana = v;
                  return d;
                exception
                  when others then
                    return null;
                end;
                
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P252_DTINI (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 30
            region: @pedidos-cancelados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        validation {
            maxLength: 4000
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v number;
                  d date;
                begin
                
                  select idsemana+1
                  into v
                  from semana_dias
                  where semana = to_number(substr( :P252_SEMANA,1,2))
                    and ano    = substr( :P252_SEMANA,4,4);
                
                  select dt_ini
                  into d
                  from semana_dias
                  where idsemana = v;
                  return d;
                exception
                  when others then
                    return null;
                end;
                
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P252_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' - '||decode(ativo,'S','Ativo','N','Inativo') d
                     , idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 60
            region: @pedidos-cancelados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P252_PERIODO_CANCELAMENTO (
        type: radioGroup
        label {
            label: Período de Cancelamento
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Antes da Análise;1,Durante Análise;2,Pós Análise;3,Todos;4
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @pedidos-cancelados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 4
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P252_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @pedidos-cancelados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P252_TIPO (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select tipo
                     , retorno
                from ( select 'Detalhado' tipo
                            , 'D' retorno
                       from dual
                       union
                       select 'Resumido'
                            , 'R'
                       from dual
                       union
                       select 'ADM'
                            , 'A'
                       from dual
                       where v('APP_USER') in ('GUILHERME','EZEQUIAS','BRUNOMULLER','GRACIELEWATHIER') )
                ```
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @pedidos-cancelados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: D
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P252_TIPODATA (
        type: radioGroup
        label {
            label: Filtar
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Emissão;E,Entrega;A,Cancelado;C
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @pedidos-cancelados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: E
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @pedidos-cancelados
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo (
        name: tipo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P252_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P252_TIPO
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @pedidos-detalhado
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: region
                region: @pedidos-resumido
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @pedidos-detalhado
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: region
                region: @pedidos-resumido
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        name: Go To Page 252
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 252
                items: {
                    P252_TIPO: &P252_TIPO.
                    P252_DTINI: &P252_DTINI.
                    P252_DTFIM: &P252_DTFIM.
                    P252_IDREPRESENTANTE: &P252_IDREPRESENTANTE.
                    P252_PERIODO_CANCELAMENTO: &P252_PERIODO_CANCELAMENTO.
                }
                successMessage: false
            }
        }
    )

)

