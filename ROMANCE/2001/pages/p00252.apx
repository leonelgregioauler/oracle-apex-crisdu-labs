    region pedidos-resumido (
        name: Pedidos resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*select pck_romance.fnc_nomerepresentante(p.idrepresentante )  "Representante"
                     , Sum(valortotal) "Valor Total"
                     , sum(valorapagar_orig) "Valor A Pagar"
                     , count(1) "Qtd Pedidos"
                from favorita.vw_pedidos_fav p
                where p.idfilialromance  = :P0_IDFILIAL
                  and p.datacancelamento is not null
                  and ( :P252_PERIODO_CANCELAMENTO = 4
                     or ( :P252_PERIODO_CANCELAMENTO = 1 and p.idsituacaoentrega < 20000 )
                     or ( :P252_PERIODO_CANCELAMENTO = 2 and p.idsituacaoentrega = 20000 )
                     or ( :P252_PERIODO_CANCELAMENTO = 3 and p.idsituacaoentrega > 20000 ) )
                  and ( :P252_TIPODATA = 'E' and trunc(dataemissao) between to_date(:P252_DTINI,'DD/MM/RRRR') and to_date(:P252_DTFIM,'DD/MM/RRRR')
                     or :P252_TIPODATA = 'A' and trunc(p.dataentrega) between to_date(:P252_DTINI,'DD/MM/RRRR') and to_date(:P252_DTFIM,'DD/MM/RRRR') 
                     or :P252_TIPODATA = 'C' and trunc(p.datacancelamento) between to_date(:P252_DTINI,'DD/MM/RRRR') and to_date(:P252_DTFIM,'DD/MM/RRRR') )
                group by p.idrepresentante
                ORDER BY 1*/
                
                select pck_romance.fnc_nomerepresentante(idrepresentante)  "Representante"
                     , Sum(valortotal) "Valor Total"
                     , sum(valorapagar_orig) "Valor A Pagar"
                     , count(idpedido) "Qtd Pedidos"
                     , sum(site) "Canal Site"
                     , sum(callcenter) "Canal Call Center"
                     , sum(lojas) "Canal Lojas"
                from ( 
                      select p.idrepresentante
                           , valortotal
                           , valorapagar_orig
                           , idpedido
                           , case
                               when p.idfilialfavorita = 8 then
                                 1
                               else 0
                             end site
                           , case
                               when p.idfilialfavorita = 1 then
                                 1
                               else 0
                             end callcenter
                           , case
                               when exists (select 1
                                            from favorita.filiaisfavorita ff
                                            where ff.idfilialfavorita = p.idfilialfavorita
                                              and ff.tipofilial = 'L' ) then
                                 1
                               else 0
                             end lojas
                      from favorita.vw_pedidos_fav_new p
                      where p.idfilialromance  = :P0_IDFILIAL
                        and p.datacancelamento is not null
                        and ( :P252_PERIODO_CANCELAMENTO = 4
                           or ( :P252_PERIODO_CANCELAMENTO = 1 and p.idsituacaoentrega < 20000 )
                           or ( :P252_PERIODO_CANCELAMENTO = 2 and p.idsituacaoentrega = 20000 )
                           or ( :P252_PERIODO_CANCELAMENTO = 3 and p.idsituacaoentrega > 20000 ) )
                        and ( :P252_TIPODATA = 'E' and trunc(dataemissao) between to_date(:P252_DTINI,'DD/MM/RRRR') and to_date(:P252_DTFIM,'DD/MM/RRRR')
                           or :P252_TIPODATA = 'A' and trunc(p.dataentrega) between to_date(:P252_DTINI,'DD/MM/RRRR') and to_date(:P252_DTFIM,'DD/MM/RRRR') 
                           or :P252_TIPODATA = 'C' and trunc(p.datacancelamento) between to_date(:P252_DTINI,'DD/MM/RRRR') and to_date(:P252_DTFIM,'DD/MM/RRRR') ) ) t
                group by t.idrepresentante
                ORDER BY 1
                ```
        }
        layout {
            sequence: 70
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
