    dynamicAction atualizarelatorio (
        name: AtualizaRelatorio
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @fotos-enviadas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @fotos-enviadas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction reprovar (
        name: Reprovar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @reprovar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: REPROVA_DOCUMENTO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process informa-valores (
        name: Informa Valores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                  --
                  if :P815_DATAINICIO is null then
                    --
                    select trunc(SYSDATE,'MM')
                    into :P815_DATAINICIO
                    from dual;
                    --
                  end if;
                  --
                  if :P815_DATAFIM is null then
                    --
                    select trunc(sysdate) 
                    into :P815_DATAFIM
                    from dual;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 10912723251990423
        }
    )

    process realiza-procedimento (
        name: Realiza procedimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  v_id number := :P815_ID;
                  --
                  v_idusuario  number;
                  v_numnull    number;
                  v_datanull   date;
                  v_data       date;
                  v_datanalise date;
                  v_situacao   varchar2(1);
                  v_md5        varchar2(4000);
                  v_charnull   varchar2(1);
                  --
                begin 
                  --
                  select idusuario
                    into v_idusuario
                    from usuarios
                   where usuario = v('APP_USER');
                  --
                  
                  if v('REQUEST') = 'APROVA_DOCUMENTO' then
                     v_situacao := 'A';
                  elsif v('REQUEST') = 'REPROVA_DOCUMENTO' then
                     v_situacao := 'R';
                  end if;
                  --
                  v_datanalise := sysdate;    -- agora a data vai pra DATANALISE
                  --
                  pck_vendasonline.prc_fotosanalisecreditopy( pidfotosanalisecreditopy => v_id,
                                                              pidrepresentante         => v_numnull,
                                                              pdocestrangeiro          => v_charnull,
                                                              pfotosdiretorio          => v_charnull,
                                                              psituacao                => v_situacao,
                                                              pmotivo                  => :P815_MOTIVO,
                                                              pobservacao              => v_charnull,
                                                              pdatacriacao             => v_datanull,
                                                              pdatacorrecao            => v_datanull,   -- null = preserva (era v_data)
                                                              pdatanalise              => v_datanalise, -- NOVO
                                                              pmd5                     => v_md5,
                                                              poperacao_dml            => 'U');
                  --
                  --
                  commit;
                  --
                  :P815_MOTIVO := '';
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Documento atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 10913196563990423
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('APROVA_DOCUMENTO','REPROVA_DOCUMENTO')
        }
    )

    branch (
        name: Go To Page 815
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 815
                items: {
                    P815_IDREPRESENTANTE: &P815_IDREPRESENTANTE.
                    P815_SITUACAO: &P815_SITUACAO.
                    P815_IDFILIAL: &P815_IDFILIAL.
                    P815_DATAINICIO: &P815_DATAINICIO.
                    P815_DATAFIM: &P815_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

