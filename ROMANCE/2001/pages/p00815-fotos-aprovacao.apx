    region fotos-enviadas (
        name: Fotos Enviadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                --Alterado para trazer somente registros com consulta spc vinculada
                --Solicitado pela Sanny 17/04
                --Gabriel Andriola
                select favorita.pck_util_fav.fnc_nomerepresentante(f.idrepresentante) nomerepres
                     , nvl(Trim(c.nome),'Nome não retornado pela consulta Equifax PY.') nomevend
                     , f.situacao
                     , decode(f.situacao,'R', nvl(f.motivo,'Motivo não informado'))  motivo
                     , f.datacorrecao
                     , f.datacriacao
                     , f.datanalise 
                     , f.idfotosanalisecreditopy
                     , f.idfotosanalisecreditopy linkteste
                     , null sem_nome
                
                     , case when f.situacao in ('A','P') then
                            '<a href="'||f.fotosdiretorio||'" target="_blank" title="Abrir Imagem"> <span class="fa fa-image fa-lg"></span></a>' 
                            else   null
                       end verfoto
                
                     , case 
                         when f.situacao = 'P' then
                            '<a href="#" onclick="aprovardocumento('||f.idfotosanalisecreditopy||'); return false;">
                                <span class="fa fa-check-circle u-color-4-text" style="margin-right:5px;"></span> </a>'
                         else ''
                       end Aprovar
                
                     , case 
                         when f.situacao = 'P' then
                            '<a href="#" onclick="reprovardocumento('||f.idfotosanalisecreditopy||'); return false;">
                                <span class="fa fa-times-circle u-color-9-text" style="margin-left:15px;"></span> </a>'
                         else ''
                       end Reprovar
                
                     , case
                         when f.situacao = 'A' then
                           '<font color="green"><b>Aprovada!</b></font>'
                         when f.situacao = 'R' then
                           '<font color="red"><b>Reprovada!</b></font>'
                         else
                           '<font color="blue"><b>Pendente!</b></font>'
                       end  Acao
                
                     , c.idconsultaspc as consultaspc
                     , c.SITUACAOCPF as situacaoconsultaspc
                     , c.documentoestrangeiro
                       --
                from fotosanalisecreditopy f
                   , catal.representantes  r
                
                -- CONSULTA SPC TEM Q EXISTIR
                cross apply (
                    select c.*
                    from consultaspc c
                    where c.documentoestrangeiro = f.docestrangeiro
                      and c.idfilial = r.idfilial
                      and c.dataconsulta >= f.datacriacao - 21
                    order by c.dataconsulta desc
                    fetch first 1 row only
                ) c
                
                where f.idrepresentante = r.idrepresentante
                
                  and (:P815_IDFILIAL        is null or r.idfilial = :P815_IDFILIAL)
                  and (:P815_IDREPRESENTANTE is null or f.idrepresentante = :P815_IDREPRESENTANTE)
                
                  and trunc(f.datacriacao) between to_date(:P815_DATAINICIO,'DD/MM/RRRR') 
                                               and to_date(:P815_DATAFIM,'DD/MM/RRRR')
                
                  and (
                        :P815_SITUACAO = 'X'
                     or ( :P815_SITUACAO = 'A' and f.situacao = 'A' )
                     or ( :P815_SITUACAO = 'R' and f.situacao = 'R' )
                     or ( :P815_SITUACAO = 'P' and f.situacao = 'P' ) 
                      )
                ```
            pageItemsToSubmit: [
                P815_DATAINICIO
                P815_DATAFIM
                P815_IDREPRESENTANTE
                P815_SITUACAO
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
