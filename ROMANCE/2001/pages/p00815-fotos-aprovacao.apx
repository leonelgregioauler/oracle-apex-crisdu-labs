page 815 (
    name: Fotos Aprovação
    alias: FOTOS-APROVACAO
    title: Fotos Aprovação
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function aprovardocumento(pid){ 
            
              document.getElementById('P815_ID').value = pid;
                
              var answer = confirm("Confirma Aprovar o documento?")
              if (answer)
                {
                  apex.submit('APROVA_DOCUMENTO');
                }
            }
            
            //function reprovardocumento(pid){ 
            //  document.getElementById('P815_ID').value = pid;
            //  var answer = confirm("Confirma Reprovar o documento?")
            //  if (answer)
            //    {
            //      apex.submit('REPROVA_DOCUMENTO');
            //    }
            //}
            
            function reprovardocumento(pid){ 
            
              document.getElementById('P815_ID').value = pid;
              openModal('ACAODOCUMENTO');
              
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

