    region acompanhamento-de-campanha (
        name: Acompanhamento de Campanha
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rownum posicao
                     , pck_romance.fnc_nomerepresentante(idrepresentante) "Distribuidor"
                     , t.idrepresentante "IdRepresentante"
                     , t.idfilial "IdFilial"
                     , pck_romance.fnc_nomefilial(t.idfilial) "Filial"
                     , t.contacertos "Contagem de Acertos"
                     , mediageral
                     , mediaromance
                     , mediafavorita
                     , vendaecommerce
                     , t.contagemfaltante "Contagem Faltante"
                     , t.mediageral * contacertos "Valor Atingido"
                     , t.valoratingir "Valor Precisa Atingir"
                     , ( t.valoratingir - ( mediageral * contacertos ) ) "Diferença"
                     , valorminimo "Valor Mínimo Prox. Semanas"
                     , ( valorminimo + ( t.valoratingir - ( mediageral * nvl(contacertos,1) ) ) ) "Faltante"
                     , ( valorminimo + ( t.valoratingir - ( mediageral * nvl(contacertos,1) ) ) ) / contagemfaltante  "Média Faltante"
                     , pck_rankingpontuacao.fnc_retornapremiocampanha(idrepresentante,mediageral) "Prêmio Atingido"
                from ( 
                       select t.*
                       from (  
                           select idrepresentante
                                , idfilial
                                , pontromance
                                , pontfavorita
                                , contacertos
                                , qtdsemanas
                                , mediageral  mediageral
                                , pontromance        mediaromance
                                , pontfavorita       mediafavorita
                                , pontfavorita / pontromance *100 percfavorita
                                , vendaecommerce
                                , nvl(contagemfaltante,1) contagemfaltante
                                , contacertos * :P536_IDPREMIO valoratingir
                                , nvl(contagemfaltante,1) * :P536_IDPREMIO valorminimo
                           from (
                                    select r.idrepresentante
                                         , g.idfilial
                                         , p.mediaromance pontromance
                                         --
                                         , p.mediafavorita pontfavorita
                                         --
                                         , p.mediageral
                                         --
                                         , p.contagemacertos contacertos
                                         , cf.idsemanafim - cf.idsemanainicio+1 qtdsemanas
                                         , pck_rankingpontuacao.fnc_contagemfaltante( psemanaini => cf.semanainicio
                                                                                    , psemanafim => cf.semanafim
                                                                                    , pidrepresentante => r.idrepresentante ) contagemfaltante
                                         , p.vendaecommerce vendaecommerce
                                    from representantes r
                                       , gerentes g
                                       , campanhasfiliais cf
                                       , vw_pontuacaogeral_rmc p
                                       , campanhas c
                                    where r.idgerente = g.idgerente
                                      and g.idfilial = cf.idfilial
                                      and p.idrepresentante = r.idrepresentante
                                      and cf.idcampanha = c.idcampanha
                                      and c.ativa = 'S'
                                      and r.ativo = 'S'
                                      and ( :P536_IDREPRESENTANTE = 99999999999999 or r.idrepresentante = :P536_IDREPRESENTANTE )
                                      
                                      and cf.idcampanhafilial = nvl(:P536_IDCAMPANHAFILIAL,cf.idcampanhafilial)
                                      and ( :P0_IDFILIAL = -1 --Todos
                                         --  Regionais
                                         or (:P0_IDFILIAL in (1,2,3,4,5) and exists ( select 1
                                                                                      from gerentes g
                                                                                     where g.idgerente = r.idgerente
                                                                                       and g.idfilial in (select f.idfilial
                                                                                                            from catal.filiais f
                                                                                                           where f.regional = :P0_IDFILIAL) ) )
                                         -- Brasil
                                         or (:P0_IDFILIAL = -2 and exists ( select 1
                                                                              from gerentes g
                                                                             where g.idgerente = r.idgerente
                                                                               and g.idfilial in (select f.idfilial
                                                                                                    from catal.filiais f
                                                                                                   where f.ididioma = 1) ) )
                                         -- America Latina
                                         or (:P0_IDFILIAL = -3 and exists ( select 1
                                                                              from gerentes g
                                                                             where g.idgerente = r.idgerente
                                                                               and g.idfilial in (select f.idfilial
                                                                                                    from catal.filiais f
                                                                                                   where f.ididioma in (2,3,4,6,7,8,13,14,15,16)) ) )
                                         -- Comercial Romance
                                         or (:P0_IDFILIAL = 1135 and exists ( select 1
                                                                              from gerentes g
                                                                             where g.idgerente = r.idgerente
                                                                               and g.idfilial in (select f.idfilial
                                                                                                    from catal.filiais f
                                                                                                   where f.pertencecomercialromance = 'S')))
                                        or (exists ( select 1
                                                      from gerentes g
                                                     where g.idgerente = r.idgerente
                                                       and g.idfilial = :P0_IDFILIAL )) ) 
                                    )  a
                              where a.contacertos > 0  ) t
                              order by mediageral desc ) t
                
                ```
            pageItemsToSubmit: [
                P536_IDREPRESENTANTE
                P536_IDPREMIO
                P536_IDCAMPANHAFILIAL
            ]
        }
