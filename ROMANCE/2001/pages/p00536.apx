        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 536
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 536
                items: {
                    P536_IDREPRESENTANTE: &P536_IDREPRESENTANTE.
                    P536_IDPREMIO: &P536_IDPREMIO.
                    P536_IDCAMPANHAFILIAL: &P536_IDCAMPANHAFILIAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
            type: never
        }
    )

)

