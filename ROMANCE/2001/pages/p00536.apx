    pageItem P536_IDCAMPANHAFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidcampanhafilial number;
                begin
                  --
                  select c.idcampanhafilial
                  into vidcampanhafilial
                  from campanhasfiliais c
                  where c.idcampanha = 14
                     and ( :P0_IDFILIAL = -1 --Todos
                                         --  Regionais
                                         or (:P0_IDFILIAL in (1,2,3,4,5) and exists (select 1
                                                                                       from catal.filiais f
                                                                                       where f.idfilial = c.idfilial
                                                                                         and f.regional = :P0_IDFILIAL) )
                                         -- Brasil
                                         or (:P0_IDFILIAL = -2 and exists (select 1
                                                                             from catal.filiais f
                                                                            where f.idfilial = c.idfilial
                                                                              and f.ididioma = 1))
                                         -- America Latina
                                         or (:P0_IDFILIAL = -3 and exists (select 1
                                                                             from catal.filiais f
                                                                            where f.idfilial = c.idfilial
                                                                              and f.ididioma in (2,3,4,6,7,8,13,14,15,16)) ) 
                                         -- Comercial Romance
                                         or (:P0_IDFILIAL = 1135 and exists (select 1
                                                                               from catal.filiais f
                                                                              where f.idfilial = c.idfilial
                                                                                and f.pertencecomercialromance = 'S') )
                                        or (c.idfilial = :P0_IDFILIAL) ) ;
                  --
                  return vidcampanhafilial;
                  --
                exception
                  when others then
                    null;
                end;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidcampanhafilial number;
                begin
                  --
                  select c.idcampanhafilial
                  into vidcampanhafilial
                  from campanhasfiliais c
                  where c.idcampanha = 9
                    and ( :P0_IDFILIAL = -1 --Todos
                                         --  Regionais
                                         or (:P0_IDFILIAL in (1,2,3,4,5) and exists (select 1
                                                                                       from catal.filiais f
                                                                                       where f.idfilial = c.idfilial
                                                                                         and f.regional = :P0_IDFILIAL) )
                                         -- Brasil
                                         or (:P0_IDFILIAL = -2 and exists (select 1
                                                                             from catal.filiais f
                                                                            where f.idfilial = c.idfilial
                                                                              and f.ididioma = 1))
                                         -- America Latina
                                         or (:P0_IDFILIAL = -3 and exists (select 1
                                                                             from catal.filiais f
                                                                            where f.idfilial = c.idfilial
                                                                              and f.ididioma in (2,3,4,6,7,8,13,14,15,16)) ) 
                                         -- Comercial Romance
                                         or (:P0_IDFILIAL = 1135 and exists (select 1
                                                                               from catal.filiais f
                                                                              where f.idfilial = c.idfilial
                                                                                and f.pertencecomercialromance = 'S') )
                                        or (c.idfilial = :P0_IDFILIAL) ) ;
                  --
                  return vidcampanhafilial;
                  --
                exception
                  when others then
                    null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P536_IDPREMIO (
        type: selectList
        label {
            label: Prêmio
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.valor1
                     , t.valor
                  from(
                select p.posicao||' - '||p.premio||' (Média de Venda: R$ '||case 
                                                                              when f.idgrupo = 1 then
                                                                                p.valorpremios1
                                                                              when f.idgrupo = 2 then
                                                                                p.valorpremios2
                                                                              when f.idgrupo = 3 then
                                                                                p.valorpremion1
                                                                              when f.idgrupo = 4 then
                                                                                p.valorpremion2                                         
                                                                            end||')'  valor1 
                     , case 
                         when f.idgrupo = 1 then
                           p.valorpremios1
                         when f.idgrupo = 2 then
                           p.valorpremios2
                         when f.idgrupo = 3 then
                           p.valorpremion1
                         when f.idgrupo = 4 then
                           p.valorpremion2                                         
                       end valor
                     , p.posicao
                from premiacoescampanhas p
                   , vw_filiais f
                where f.idfilial = :P0_IDFILIAL
                  AND P.ATIVO = 'S'
                  and p.idcampanha = 14
                  and f.ididioma = 1
                  
                union
                select pp.posicao||' - '||pp.premio||' (Média de Venda: '||pp.valorpremio||')' valor1
                     , pp.valorpremio valor
                     , pp.posicao
                from premiacoescampanhas_ext pp
                   , vw_filiais f
                where f.idfilial = :P0_IDFILIAL
                  AND Pp.ATIVO = 'S'
                  and pp.idcampanha = 14
                  and pp.idpais = f.ididioma
                  and f.ididioma != 1
                ) t
                order by t.posicao
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P536_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) d
                     , idrepresentante r
                from representantes r 
                where ( :P0_IDFILIAL = -1 --Todos
                                         --  Regionais
                                         or (:P0_IDFILIAL in (1,2,3,4,5) and exists ( select 1
                                                                                      from gerentes g
                                                                                     where g.idgerente = r.idgerente
                                                                                       and g.idfilial in (select f.idfilial
                                                                                                            from catal.filiais f
                                                                                                           where f.regional = :P0_IDFILIAL) ) )
                                         -- Brasil
                                         or (:P0_IDFILIAL = -2 and exists ( select 1
                                                                              from gerentes g
                                                                             where g.idgerente = r.idgerente
                                                                               and g.idfilial in (select f.idfilial
                                                                                                    from catal.filiais f
                                                                                                   where f.ididioma = 1) ) )
                                         -- America Latina
                                         or (:P0_IDFILIAL = -3 and exists ( select 1
                                                                              from gerentes g
                                                                             where g.idgerente = r.idgerente
                                                                               and g.idfilial in (select f.idfilial
                                                                                                    from catal.filiais f
                                                                                                   where f.ididioma in (2,3,4,6,7,8,13,14,15,16)) ) )
                                         -- Comercial Romance
                                         or (:P0_IDFILIAL = 1135 and exists ( select 1
                                                                              from gerentes g
                                                                             where g.idgerente = r.idgerente
                                                                               and g.idfilial in (select f.idfilial
                                                                                                    from catal.filiais f
                                                                                                   where f.pertencecomercialromance = 'S')))
                                        or (exists ( select 1
                                                      from gerentes g
                                                     where g.idgerente = r.idgerente
                                                       and g.idfilial = :P0_IDFILIAL )) ) 
                
                
                
                /*r.idgerente = ( select idgerente
                                      from gerentes 
                                      where idfilial = :P0_IDFILIAL )*/
                  and r.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: "- Mostrar Todos - "
            nullReturnValue: 99999999999999
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

