    process destino-da-postagem-save-interactive-grid-data (
        name: Destino da Postagem - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @destino-da-postagem
        lockRow {
            lockRow: false
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 101571202614286003
        }
    )

    process gerar-para-todas-empresas (
        name: Gerar Para todas Empresas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  for a in ( select idfilial
                             from vw_filiais w
                             where ( tipofilial = 'D' or idfilial = 200)
                               and not exists ( select 1
                                                from destinospostagensmarketing
                                                where idfilial            = w.idfilial
                                                  and idpostagemmarketing = :P665_IDPOSTAGEMMARKETING ) )
                  loop
                    --
                    insert into destinospostagensmarketing (iddestinopostagemmarketing, idpostagemmarketing, idfilial, idrepresentante, idvendedora, datainicio, datafim)
                    values ( seq_iddestpostagemmarketing.nextval, :P665_IDPOSTAGEMMARKETING, a.idfilial, null, null, to_date(trim(:P665_DATAINICIO),'DD/MM/RRRR HH24:MI:SS'), to_date(trim(:P665_DATAFIM),'DD/MM/RRRR HH24:MI:SS') );
                    --
                  end loop;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 101573989913286015
        }
        serverSideCondition {
            type: request=Value
            value: GERARTODASEMPRESAS
        }
    )

    process get-row (
        name: Get Row
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdata date;
                begin
                  -- 
                  pck_marketing_rmc.prc_postagensmarketing( pidpostagemmarketing => :P665_IDPOSTAGEMMARKETING
                                                          , pdata                => vdata
                                                          , pusuario             => :P665_USUARIO
                                                          , pnome                => :P665_NOME
                                                          , ptipo                => :P665_TIPO
                                                          , pendereco            => :P665_ENDERECO
                                                          , plink                => :P665_LINK
                                                          , pappdestino          => :P665_APPDESTINO
                                                          , pordem               => :P665_ORDEM
                                                          , pmd5                 => :P665_MD5
                                                          , poperacao_dml        => 'S');
                  :P665_DATA := to_char(vdata, 'DD/MM/RRRR HH24:MI:SS');
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 101573185133286015
        }
    )

    process process-row (
        name: Process Row
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdata date;
                begin
                  -- 
                  if :P665_IDPOSTAGEMMARKETING is null then
                    :P665_OPERACAO_DML := 'I';
                    vdata := sysdate;
                  else
                    :P665_OPERACAO_DML := 'U';
                  end if;
                  --
                  pck_marketing_rmc.prc_postagensmarketing( pidpostagemmarketing => :P665_IDPOSTAGEMMARKETING
                                                          , pdata                => vdata
                                                          , pusuario             => :P665_USUARIO
                                                          , pnome                => :P665_NOME
                                                          , ptipo                => :P665_TIPO
                                                          , pendereco            => :P665_ENDERECO
                                                          , plink                => :P665_LINK
                                                          , pappdestino          => :P665_APPDESTINO
                                                          , pordem               => :P665_ORDEM
                                                          , pmd5                 => :P665_MD5
                                                          , poperacao_dml        => :P665_OPERACAO_DML);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 101573589263286015
        }
        serverSideCondition {
            type: request=Value
            value: SALVAR
        }
    )

    branch (
        name: Go To Page 665
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 665
            }
        }
    )

)

