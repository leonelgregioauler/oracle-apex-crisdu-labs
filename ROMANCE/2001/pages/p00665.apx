page 665 (
    name: Criar Postagem Vendas Plus
    title: Postagens Vendas Plus
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region destino-da-postagem (
        name: Destino da Postagem
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iddestinopostagemmarketing
                     , idpostagemmarketing
                     , idfilial
                     , idrepresentante
                     --, idvendedora
                     , datainicio
                     , datafim 
                   /*  , case 
                        when sysdate between datainicio and datafim then
                            '<font color="green">Ativo</a>' 
                        else
                           '-'
                       end ativo*/
                from destinospostagensmarketing
                where idpostagemmarketing = :p665_idpostagemmarketing
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P665_IDPOSTAGEMMARKETING
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1677209742465508974
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDDESTINOPOSTAGEMMARKETING
