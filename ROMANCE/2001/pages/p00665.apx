            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                databaseColumn: DATAFIM
                dataType: date
            }
        )

        column DATAINICIO (
            type: datePickerJquery
            heading {
                heading: De
                alignment: center
            }
            settings {
                navigationListFor: month
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                databaseColumn: DATAINICIO
                dataType: date
            }
        )

        column IDDESTINOPOSTAGEMMARKETING (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDDESTINOPOSTAGEMMARKETING
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDDESTPOSTAGEMMARKETING
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDFILIAL (
            type: selectList
            heading {
                heading: Empresa
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome      display_value
                         , idfilial  return_value
                    from vw_filiais
                    where tipofilial = 'D'
                      or idfilial = 200
                    order by 1
                    ```
                displayExtraValues: false
                nullDisplayValue: "- Todas - "
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDPOSTAGEMMARKETING (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDPOSTAGEMMARKETING
                dataType: number
            }
            default {
                type: item
                item: P665_IDPOSTAGEMMARKETING
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDREPRESENTANTE (
            type: selectList
            heading {
                heading: Distribuidor
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select w.nome            display_value
                         , w.idrepresentante return_value
                    from vw_repres_filial_rmc w
                    where idfilial = :IDFILIAL
                    ```
                displayExtraValues: false
                nullDisplayValue: "- Todas - "
            }
            cascadingLov {
                parentColumns: IDFILIAL
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: IDREPRESENTANTE
                dataType: number
            }
        )

    )

