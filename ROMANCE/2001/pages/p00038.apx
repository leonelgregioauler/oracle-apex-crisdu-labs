    validation p38-codigo (
        name: P38_CODIGO
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from itensnotavenda i
                where i.idnotavenda  = :P38_IDNOTAVENDA
                   and i.idestoquefil = ( select f.idestoquefilial
                                           from estoquefilial f
                                           where f.idfilial = :P0_IDFILIAL
                                             and f.ativo = 'S'
                                             and f.idproduto = ( select idproduto
                                                                 from produtos
                                                                 where codigosisdist  = :P38_CODIGO ) );
                ```
        }
        error {
            errorMessage: Este item já está incluído na nota!
            displayLocation: inlineInNotification
            associatedItem: @P38_CODIGO
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation p38-idproduto (
        name: P38_IDPRODUTO
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from produtos
                where codigosisdist  = :P38_CODIGO;
                ```
        }
        error {
            errorMessage: Informe o produto!
            displayLocation: inlineInNotification
        }
    )

    validation valida-estoque-da-representante (
        name: Valida estoque da Representante
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from estoquerepresentante e
                where e.idestoquefil = ( select f.idestoquefilial
                                         from estoquefilial f
                                         where f.ativo = 'S'
                                           and f.idfilial  = ( select idfilial
                                                               from notasvendas 
                                                               where idnotavenda = :P38_IDNOTAVENDA ) 
                                           and f.idproduto = :P38_IDPRODUTO )
                  and e.idrepresentante = ( select idrepresentante
                                            from notasvendas 
                                            where idnotavenda = :P38_IDNOTAVENDA ) 
                  and e.qtd_u >= to_number(:P38_QUANTIDADE)
                ```
        }
        error {
            errorMessage: Quantidade não disponível na carga do(a) Representante.
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: never
        }
    )

    process fetch-row-from-itensnotavenda (
        name: Fetch Row from ITENSNOTAVENDA
        type: autoRowFetch
        source {
            tableName: ITENSNOTAVENDA
            pkColumn: IDITEMNOTAVENDA
            pkItem: P38_IDITEMNOTAVENDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 13285764463916588
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidproduto  number;
                  vvaloragregado number := 0;
                  --
                begin 
                  --
                  if :P38_IDITEMNOTAVENDA is null then
                    --
                    select "SEQ_ITEMNOTAVENDA".nextval
                    into :P38_IDITEMNOTAVENDA
                    from dual;
                    --
                    select idproduto
                    into vidproduto
                    from produtos
                    where codigosisdist  = :P38_CODIGO;
                    --
                    begin
                      select r.valoragregado
                      into vvaloragregado
                      from regioesrepresentantes r 
                      where r.idrepresentante = :P38_IDREPRESENTANTE
                        and r.idregiaovenda   = :P38_IDREGIAOVENDA;
                    EXCEPTION
                      when others then
                        vvaloragregado := 0;
                    end;
                    --
                    select ee.idestoquefilial
                         , ee.vlrvenda + vvaloragregado
                         , ee.comissao
                    into :P38_IDESTOQUEFIL
                       , :P38_VALORVENDA
                       , :P38_COMISSAO
                    from estoquefilial ee
                    where idfilial  = ( select idfilial from notasvendas n where n.idnotavenda = :P38_IDNOTAVENDA)
                      and idproduto = vidproduto
                      and ativo = 'S';
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13285964545916590
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

