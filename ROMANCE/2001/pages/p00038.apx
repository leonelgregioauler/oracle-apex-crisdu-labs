    pageItem P38_IDPRODUTO (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto) display_value
                     , p.idproduto return_value
                from produtos      p
                where p.codigosisdist = trim(:P38_CODIGO)
                  and exists ( select 1 
                               from estoquefilial e 
                               where e.idproduto = p.idproduto
                                 and e.idfilial  = :P0_IDFILIAL )
                union
                select :P38_CODIGO
                , 1
                from dual
                order by 1;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P38_CODIGO
        }
        layout {
            sequence: 75
            region: @inclui-atualizar-item-da-nota
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

