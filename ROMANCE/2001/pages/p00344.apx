page 344 (
    name: Liberação de Encerramento de Fechamentos
    title: Liberação de Encerramento de Fechamentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region liberação-de-encerramento-de-fechamentos (
        name: Liberação de Encerramento de Fechamentos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P344_DATACORRECAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @liberação-de-encerramento-de-fechamentos
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATACORRECAO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P344_IDCORRECAOFECHAMENTOSEMAN (
        type: hidden
        layout {
            sequence: 10
            region: @liberação-de-encerramento-de-fechamentos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCORRECAOFECHAMENTOSEMANAL
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P344_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @liberação-de-encerramento-de-fechamentos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P344_MOTIVO (
        type: textarea
        label {
            label: Motivo
            alignment: left
        }
        settings {
            autoHeight: true
            charCounter: true
        }
        layout {
            sequence: 40
            region: @liberação-de-encerramento-de-fechamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: MOTIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P344_USUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @liberação-de-encerramento-de-fechamentos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return v('APP_USER');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 40
            region: @liberação-de-encerramento-de-fechamentos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: never
        }
    )

    button create (
        buttonName: CREATE
        label: Liberar Fechamento
        layout {
            sequence: 10
            region: @liberação-de-encerramento-de-fechamentos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P344_IDCORRECAOFECHAMENTOSEMAN
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 30
            region: @liberação-de-encerramento-de-fechamentos
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 20
            region: @liberação-de-encerramento-de-fechamentos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: never
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-motivo (
        name: Valida Motivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P344_MOTIVO
            alwaysExecute: true
        }
        error {
            errorMessage: É necessário informar um motivo!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process fetch-row-from-correcoesfechamentossemanais (
        name: Fetch Row from CORRECOESFECHAMENTOSSEMANAIS
        type: autoRowFetch
        source {
            tableName: CORRECOESFECHAMENTOSSEMANAIS
            pkColumn: IDCORRECAOFECHAMENTOSEMANAL
            pkItem: P344_IDCORRECAOFECHAMENTOSEMAN
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 780325218009262114
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P344_IDCORRECAOFECHAMENTOSEMAN is null then
                        select "#OWNER#"."SEQ_IDCORRECAOFECHAMENTO".nextval
                          into :P344_IDCORRECAOFECHAMENTOSEMAN
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 780325619374262115
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process libera-conclusão-da-semana (
        name: Libera conclusão da Semana
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update fechamentossemanais f
                  set f.liberarconclusao = 'S'
                  where f.idfechamento = :P344_IDFECHAMENTO;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Liberação realizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 779757502091840848
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-correcoesfechamentossemanais (
        name: Process Row of CORRECOESFECHAMENTOSSEMANAIS
        type: autoRowProcessing
        target {
            tableName: CORRECOESFECHAMENTOSSEMANAIS
            pkColumn: IDCORRECAOFECHAMENTOSEMANAL
            pkItem: P344_IDCORRECAOFECHAMENTOSEMAN
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 780326012768262115
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 92
                items: {
                    P92_IDFECHAMENTO: &P344_IDFECHAMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)

