    region pedidos-à-vencer (
        name: Pedidos à Vencer
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido
                     , nvl(p.pedidotag,pp.nrpedido) "Nr Pedido"
                     , pck_romance.fnc_nomevendedora(pidvendedora => p.idvendedora) "Vendedora"
                     , pck_romance.fnc_retornatelefones(p.idvendedora) "Telefones"
                     , pp.dtemissao  "Data Emissão"
                     , pp.dataentrega "Data Entrega"
                     , p.datavencimento "Data Venc Boleto"
                     , pp.datavencimento "Data Venc Pedido"
                     , p.valorcobrado "Valor Total Boleto"
                     , pp.vlrtotalsemcomissao "Valor Total Pedido"
                    -- , ( select decode(b.databaixa,null,'Não','Sim') from boletos b where b.idpedido = p.idpedido ) Pago
                     , ( select ( select c.nomecidade ||' - '|| e.sigla from cidades c , estados e where c.idestado = e.idestado and c.idcidade = pv.idcidade )
                        from pessoas        pv 
                       where pv.idpessoa = ( select idpessoa 
                                             from vendedoras     v
                                             where v.idvendedora = pp.idvendedora) ) "Cidade Vendedora"
                     , ( select pck_romance.fnc_nomeregiaovenda(r.idregiaovenda) 
                         from regioesvenda r
                         where r.idregiaovenda = (select idregiaovenda 
                                                  from vendedoras v
                                                  where v.idvendedora = pp.idvendedora)) "Região de Venda"
                from boletos        p
                   , pedidos        pp
                where p.idpedido        = pp.idpedido(+)
                  /*and nvl(p.pedidorepresentante,'N') = 'N'*/
                  and trunc(p.datavencimento)  >= trunc(sysdate)
                  and p.databaixa is null
                  and p.situacao != 'Z'
                  and p.idrepresentante  = :P199_IDREPRESENTANTE
                union
                select pf.idpedido
                     , pf.numeropedido
                     , pf.vendedora
                     , pck_romance.fnc_retornatelefones(pf.idvendedora) 
                     , pf.dataemissao
                     , pf.dataentrega
                     , pf.datavencimentomenor
                     , pf.datavencimentomenor
                     , pf.valorapagar
                     , pf.valorapagar
                     , ( select ( select c.nomecidade ||' - '|| e.sigla from cidades c , estados e where c.idestado = e.idestado and c.idcidade = pv.idcidade )
                         from pessoas        pv 
                         where pv.idpessoa = ( select idpessoa 
                                               from vendedoras     v
                                               where v.idvendedora = pf.idvendedora) )
                     , pf.regiaocliente
                from favorita.vw_pedidos_fav pf
                where pf.idrepresentante = :P199_IDREPRESENTANTE
                  and pf.ididioma        = 1
                  and exists ( select 1
                               from favorita.vencimentospedidos vp
                               where vp.situacaovencimento    = 'V'
                                 and vp.idpedido              = pf.idpedido
                                 and trunc(vp.datavencimento) >= trunc(sysdate)       
                                 and nvl(vp.valorpago,0)      < vp.valorpagar )    
                  and not exists ( select 1
                                   from favorita.classificacoespedidos c
                                   where c.idcaracteristicapedido = 25
                                     and c.idpedido               = pf.idpedido )
                  and not exists ( select 1
                                   from favorita.parcelamentospedidos pc
                                   where pc.idpedido              = pf.idpedido )
                ```
            pageItemsToSubmit: P199_IDREPRESENTANTE
        }
