    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 10
            region: @lista-de-pedidos
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: imprimelista();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction submit-pagina (
        name: Submit Pagina
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P199_IDREPRESENTANTE
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: imprime
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 256
                items: {
                    P256_IDREPRESENTANTE: &P199_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

    branch (
        name: Go To Page 199
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 199
                items: {
                    P199_IDREPRESENTANTE: &P199_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
    )

)

