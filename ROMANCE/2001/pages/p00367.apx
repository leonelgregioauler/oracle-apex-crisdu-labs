    pageItem P367_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P367_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) d
                     , idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P367_IDFILIAL )
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P367_IDFILIAL
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
