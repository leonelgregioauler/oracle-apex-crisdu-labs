                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 367
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 367
                items: {
                    P367_IDFILIAL: &P367_IDFILIAL.
                    P367_IDREPRESENTANTE: &P367_IDREPRESENTANTE.
                    P367_SITUACAO: &P367_SITUACAO.
                    P367_ENVIADACOBRANCA: &P367_ENVIADACOBRANCA.
                    P367_PROMISSORIARECEBIDA: &P367_PROMISSORIARECEBIDA.
                    P367_SITUACAOPROMISSORIA: &P367_SITUACAOPROMISSORIA.
                    P367_SITUACAOCOBRANCA: &P367_SITUACAOCOBRANCA.
                    P367_MERCADORIA_NAO_ENTREGUE: &P367_MERCADORIA_NAO_ENTREGUE.
                    P367_PAGOU_AO_DISTRIBUIDOR: &P367_PAGOU_AO_DISTRIBUIDOR.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

