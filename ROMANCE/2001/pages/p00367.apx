    region notas-de-venda-adm-cobrança (
        name: Notas de Venda - ADM Cobrança
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.idnotavenda
                     , n.numeronota
                     , n.idvendedora
                     , pck_romance.fnc_nomevendedora(n.idvendedora) vendedora
                     , n.idrepresentante
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) representante
                     , n.idregiaovenda
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , n.datanota
                     , n.dataretorno
                     , n.dataretornoorig
                     , decode(n.enviadocobranca,'S','Sim','Não') enviadocobranca
                     , n.dataenviadocobranca
                     , n.idsituacaonotavenda
                     , ( select s.descricao
                         from situacoesnotavenda s
                         where s.idsituacaonotavenda = n.idsituacaonotavenda ) situacaonota
                     , n.idsituacaocobranca
                     , ( select sc.situacao
                         from situacoescobranca sc
                         where sc.idsituacao = n.idsituacaocobranca ) situacaocobranca
                     , n.valortotalnota
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , decode(n.promissoriarecuperada,'S','Sim','Não') promissoriarecuperada
                     , decode(n.quitadapepino,'Q','Quitada','P','Inadimplente','R','Remarcada') quitadapepino
                     , n.idsituacaopromissoria
                     , ( select sp.descricao
                         from catal.situacoespromissorias sp
                         where sp.idsituacaopromis = n.idsituacaopromissoria ) situacaopromissoria
                     , n.dataatualizacaopromissoria
                     , n.responsavelcobranca
                     , ( select LISTAGG(pg.datapagamento||' - '||pg.valorpago||' Origem: '||decode(pg.origem,'P','Perda','R','Distribuidor','C','Cobrança'),' / ')
                         within group (order by pg.idnotavenda)
                         from pagamentosnotasvendas pg
                         where pg.idnotavenda = n.idnotavenda ) pagamentos
                     , pck_romance.fnc_cpfvendedora(n.idvendedora) cpfconsultora
                     , nvl(( select 'Sim'
                             from dual
                             where exists ( select 1 
                                            from correcoesnotasvendas c
                                            where c.idnotavenda = n.idnotavenda
                                              and c.usuario = 'OPTIMUS'
                                              and c.motivo like '%Nota enviada para o departamento de cobrança%')),'Não') envioautomatico
                from notasvendas n
                where n.idsituacaonotavenda <> 5
                  and n.idfilial = :P367_IDFILIAL
                  and ( :P367_IDREPRESENTANTE is null or n.idrepresentante = :P367_IDREPRESENTANTE )
                  and ( :P367_SITUACAO is null or n.quitadapepino = :P367_SITUACAO )
                  and ( :P367_ENVIADACOBRANCA is null or n.enviadocobranca = :P367_ENVIADACOBRANCA )
                  and ( :P367_PROMISSORIARECEBIDA is null or n.promissoriarecuperada = :P367_PROMISSORIARECEBIDA )
                  and ( :P367_SITUACAOPROMISSORIA is null or n.idsituacaopromissoria = :P367_SITUACAOPROMISSORIA )
                  and ( :P367_SITUACAOCOBRANCA is null or n.idsituacaocobranca = :P367_SITUACAOCOBRANCA )
                  and ( :P367_PAGOU_AO_DISTRIBUIDOR is null or exists ( select 1
                                                                        from classificacoesnotasvendas cn
                                                                        where cn.idnotavenda = n.idnotavenda
                                                                          and cn.idcaracteristicanotavenda = 2 ) )
                  and ( :P367_MERCADORIA_NAO_ENTREGUE is null or exists ( select 1
                                                                          from classificacoesnotasvendas cn
                                                                          where cn.idnotavenda = n.idnotavenda
                                                                            and cn.idcaracteristicanotavenda = 1 ) )                                           
                order by 4
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1405439197314756644
        }

