    region acertos-pendentes (
        name: Acertos Pendentes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  '<a href="javascript: iniciaracerto('||idrepresentante||','''||semana||''','||nvl(idregiaovenda,0)||');"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""></a>' "Iniciar"
                     , representante "Representante"
                     , idrepresentante
                     , semana
                     , regiao "Região"
                     , idregiaovenda
                /*     , cobranca "Cobrança Notas da Semana"
                     , debitos  "Débitos Recebidos"
                     , cobranca + debitos "Total Cobrança"
                     , notascobrar "Notas a Cobrar"
                     , notasnovas  "Notas Novas"
                     , notascobrarproxsem "Próx. Sem."
                     , idrepresentante
                     , proximasemana
                     , ( select round(sum(comissao),2) comissao
                          from vw_comissoes_pagar t
                          where idrepresentante = a.idrepresentante
                            and not exists ( select 1 
                                             from pagamentocomissoes pp
                                             where pp.idpedido  = t.idpedido 
                                               and pp.idrepresentante is not null)) "Comis. Favorita"*/
                     , '<font color="red">'||represatendeu ||'</font>' represatendeu
                from ( select pck_romance.fnc_nomerepresentante(idrepresentante) representante
                           , semana
                           , ( select s.idsemana
                               from semana_dias s
                               where s.semana =  to_number(substr(i.semana,1,2))
                                  and s.ano =  to_number(substr(i.semana,4,4)) ) idsemana
                           , ( select pck_romance.fnc_nomeregiaovenda(idregiaovenda)
                               from regioesrepresentantes rr
                               where  ( rr.idrepresentante = i.idrepresentante )
                                 and--(
                                     rr.semana          = i.semana
                                   --or rr.semana          = pck_romance.fnc_semanacobranca(i.semana) )
                                   ) regiao
                            , idrepresentante
                           , ( select idregiaovenda
                               from regioesrepresentantes rr
                               where  ( rr.idrepresentante = i.idrepresentante )
                                 and--( 
                                    rr.semana          = i.semana
                                   --or rr.semana          = pck_romance.fnc_semanacobranca(i.semana) )
                                   ) idregiaovenda
                 /*          , ( select sum(p.valorpago)
                               from pagamentosnotasvendas p
                               where p.semanacobranca = i.semana
                                 and p.idnotavenda in ( select n.idnotavenda
                                                        from notasvendas n 
                                                        where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                                          and n.semanacobranca  = i.semana ) ) cobranca
                                                          
                                                          
                           , nvl(( select sum(p.valorpago)
                                   from pagamentosnotasvendas p
                                   where p.semanacobranca =  i.semana
                                     and p.idnotavenda in ( select n.idnotavenda
                                                            from notasvendas n 
                                                            where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                                              and n.semanacobranca != i.semana ) ),0) debitos
                           , ( select count(1)
                               from notasvendas n 
                               where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                 and n.semanacobranca  = i.semana ) notascobrar
                            , ( select count(1)
                                from notasvendas n 
                                where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                  and n.semanadistribuicao = i.semana  ) notasnovas
                            , ( select count(1)
                                from notasvendas n 
                                where n.idrepresentante = i.idrepresentante --( n.idrepresentante = i.idrepresentante or n.idrepresentanteatende = i.idrepresentante )
                                  and n.semanacobranca  = pck_romance_2.fnc_proximasemana(i.semana) ) notascobrarproxsem
                            , pck_romance_2.fnc_proximasemana(i.semana) proximasemana*/
                           , ( select listagg(pck_romance.fnc_nomerepresentante(idrepresentanteatende),' ') within group ( order by 1 desc )
                               from notasvendas n
                               where n.semanacobranca  = i.semana
                                 and n.idrepresentante = i.idrepresentante)  represatendeu
                      from impnettoservidor i
                      where i.idfilial = :P0_IDFILIAL 
                        and i.idsemana >= 615
                        --and i.idrepresentanteatende is null
                        and pck_util.fnc_idsemana(i.semana) <= ( select max(pck_util.fnc_idsemana(a.semana))
                                                                from fechamentossemanais a
                                                                where idfechamento = :P0_IDFECHAMENTO--a.idfilial = i.idfilial
                                                                  and a.concluido = 'N' )
                        and not exists ( select 1
                                         from fechamentorepresentantes f
                                            , fechamentossemanais ff
                                         where f.idfechamentopontuacao = ff.idfechamento
                                           and f.idrepresentante       = i.idrepresentante 
                                           and ff.semana               = i.semana )         ) a
                where  (:P0_IDPOSTOAVANCADO is null or exists ( select 1  
                                                                     from representantes r
                                                                     where r.idrepresentante = a.idrepresentante
                                                                       and r.idpostoavancado = :P0_IDPOSTOAVANCADO ) )
                order by a.idsemana
                       , representante
                ```
        }
