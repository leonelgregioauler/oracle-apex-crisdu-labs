        behavior {
            action: redirectThisApp
            target: {
                page: 75
                items: {
                    P75_IDFECHAMENTO: &P0_IDFECHAMENTO.
                }
                clearCache: 75
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where nvl(f.concluido,'N') = 'N'
                  and f.idfechamento = :P0_IDFECHAMENTO
                ```
        }
    )

    process inicia-acerto (
        name: inicia acerto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  vsemana              varchar2(10);
                  vidfechamentopont    number;
                  vidregiaovenda       number := :P74_IDREGIAOVENDA;
                begin
                  -- 
                  select seq_idfechamentorepres.nextval
                  into :P74_IDFECHAMENTOREPRES
                  from dual;
                  --
                  select semana
                  into vsemana
                  from fechamentossemanais f
                  where f.idfechamento = :P74_IDFECHAMENTO;
                  --
                  select f.idfechamento
                  into vidfechamentopont
                  from fechamentossemanais f
                  where f.semana   = trim(:P74_SEMANALIBERAR)
                    and f.idfilial = :P0_IDFILIAL;
                  --
                  if vidregiaovenda = 0 then
                      begin 
                        select idregiaovenda
                        into vidregiaovenda
                        from logroman.log_regioesrepresentantes
                        where idrepresentante = :P74_IDREPRESENTANTE
                          and semana          = vsemana
                          and rownum          = 1;
                      exception
                        when others then
                          select max(idregiaovenda)
                          into vidregiaovenda
                          from regioesrepresentantes
                          where idrepresentante = :P74_IDREPRESENTANTE;
                      end; 
                  end if;
                  --
                  insert into fechamentorepresentantes( idfechamentorepres , idrepresentante , idfilial
                                                      , semana             , idfechamento    , idfechamentopontuacao
                                                      ,  idregiaovenda)
                  values( :P74_IDFECHAMENTOREPRES  , :P74_IDREPRESENTANTE   , :P0_IDFILIAL
                        , vsemana                  , :P74_IDFECHAMENTO      , vidfechamentopont 
                        , decode(vidregiaovenda,0,null,vidregiaovenda) );
                  --
                  pck_acertosfechamento.prc_buscacobranca( :P74_IDFECHAMENTOREPRES );
                  pck_acertosfechamento.prc_atualiza_acerto ( :P74_IDFECHAMENTOREPRES );
                  --
                  pck_acertosfechamento.prc_atualiza_gavetas ( :P74_IDFECHAMENTO );
                  --
                  commit;
                  --  
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3687250631888049293
        }
        serverSideCondition {
            type: request=Value
            value: INICIAACERTO
        }
    )

    process libera-proxima-semana (
        name: libera proxima semana
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  insert into LIBERACOESSEMANAIS
                  values (seq_idliberacoessemanais.nextval , :P74_SEMANALIBERAR , 'S', v('APP_USER'), :P74_IDREPRESENTANTE  );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Próxima semana liberada.
        }
        error {
            errorMessage: A próxima semana já foi liberada para este representante.
        }
        advanced {
            executionMappingIdentifier: 3687250225215049293
        }
        serverSideCondition {
            type: request=Value
            value: LIBERAR
        }
    )

