page 74 (
    name: Lista de Acertos Efetuados
    title: Lista de Acertos Efetuados
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_liberasemana(IDREPRESENTANTE,SEMANA)
            {
            javascript:window.open('f?p=220:2:::NO:2:P2_IDREPRESENTANTE,P2_SEMANACOBRANCA,P2_PROCESSAR:'+IDREPRESENTANTE+','+SEMANA+',S'
            ,'popup','toolbar=no,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width=800,height=400,screenX=100,screenY =100');void(0);
            }
            
            function listanotas(pidrepres,pidsemana) 
            {
            javascript:window.open('f?p=&APP_ID.:165:&SESSION.::NO:165:P165_IDREPRESENTANTE,P165_SEMANA:'+pidrepres+','
                                                                                                         +pidsemana
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1400,height=800,screenX=50,screenY =100');void(0);
            }
            
            function listanotasnovas(pidrepres,pidsemana) 
            {
            javascript:window.open('f?p=&APP_ID.:161:&SESSION.::NO:161:P161_IDREPRESENTANTE,P161_SEMANA:'+pidrepres+','
                                                                                                         +pidsemana
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=1300,screenX=50,screenY =100');void(0);
            }
            
            function listanotasacertar(pidrepres,pidsemana) 
            {
            javascript:window.open('f?p=&APP_ID.:170:&SESSION.::NO:170:P170_IDREPRESENTANTE,P170_SEMANA:'+pidrepres+','
                                                                                                         +pidsemana
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=800,screenX=50,screenY =100');void(0);
            }
            
            function verpgto(pidrepres,pidsemana) 
            {
            javascript:window.open('f?p=&APP_ID.:189:&SESSION.::NO:189:P189_IDREPRESENTANTE,P189_SEMANA:'+pidrepres+','
                                                                                                         +pidsemana
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1400,height=800,screenX=50,screenY =100');void(0);
            }
            
            function liberar(pidrepres,pidsemana) 
            {
              document.getElementById('P74_IDREPRESENTANTE').value = pidrepres;
              document.getElementById('P74_SEMANALIBERAR').value   = pidsemana;
              apex.submit('LIBERAR');
            }
            
            
            
            function iniciaracerto(pidrepres,pidsemana,pidregiao) 
            {
              document.getElementById('P74_IDREPRESENTANTE').value = pidrepres;
              document.getElementById('P74_SEMANALIBERAR').value   = pidsemana;
              document.getElementById('P74_IDREGIAOVENDA').value   = pidregiao;
              document.getElementById('P74_IDFECHAMENTO').value   =  document.getElementById('P0_IDFECHAMENTO').value;
              apex.submit('INICIAACERTO');
            }
            ```
    }
    security {
        authorizationScheme: @acesso-acertos
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region acertos-efetuados (
        name: Acertos Efetuados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfechamentorepres, 
                       idfechamentoreps_disp, 
                       ano, 
                       semana, 
                       fechamento, 
                       representante, 
                       filial, 
                       setor, 
                       regiao "Região", 
                       qtdnotasnovas, 
                       qtdnotaslevou, 
                       qtdnotasfechou, 
                       vlralvo, 
                       totalgeral, 
                       totalcobranca, 
                       vlrespecie, 
                       vlrcheque, 
                       idcomissao, 
                       vlr_comissao "Vlr Comissão", 
                       alterou_comissao "Alterou Comissão", 
                       observacao, 
                       referente_a "Referente a", 
                       perc_venda "Perc Venda", 
                       total_resgate "Total Resgate", 
                       percentual_sacola "Percentual Sacola", 
                       saldoapagar, 
                       saldototal, 
                       debitos_recebidos "Débitos Recebidos", 
                       debitos_novos "Débitos Novos", 
                       idrepresentante, 
                       idfechamentopontuacao, 
                       idregiaovenda, 
                       com_paga_fav "Com. Paga Fav.", 
                       chequesemfundopago, 
                       total_dep "Total Dep.", 
                       total_dep_chq "Total Dep. Chq", 
                       correçoes_pendentes "Correçôes Pendentes", 
                       valordevolvidoaorepres, 
                       qtdnotasemaberto, 
                       percdebitosnovos, 
                       saldoacumuladopositivo, 
                       totalcomissaocobrakirepres, 
                       usuariofinalizou, 
                       decode(usuarioacerto,'ROMAN','Sistema Automático',usuarioacerto) "Iniciado Por", --14837446
                       datafinalizado, 
                       datarevisao, 
                       usuariorevisou, 
                       totalcomissaoacordoakirepres, 
                       total_venda, 
                       perc_inad, 
                       valor_inicial, 
                       diferenca, 
                       notas_saldo_negativo, 
                       qtd_resgate "Qtd. Resgate", 
                       distribuido_semana "Distribuído na Semana",
                       -- notas de outros distribuidores cobradas neste acerto
                       case when qtd_notas_outros > 0 then 'Sim' else 'Não' end "Cobrou Notas de Outros",
                       qtd_notas_outros "Qtd. Notas Outros",
                       vlr_notas_outros "Vlr. Notas Outros",
                       distrib_notas_outros "Notas Pertencem a",
                
                       --ass_reprovada,
                       case 
                         when ass_reprovadas > 0 then
                           --'<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:626:'||v('APP_SESSION')||'::NO::P626_IDREPRESENTANTE,P626_SEMANA:'||idrepresentante||','||referente_a,'SESSION')||''',''_blank''); void(0);">'||ass_reprovadas||'</a>'
                             '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2001:626:'||v('APP_SESSION')||'::NO::P626_IDREPRESENTANTE,P626_SEMANA:'||idrepresentante||','||referente_a,'SESSION')||''',''_blank'',''popup''); void(0);">'||ass_reprovadas||'</a>'
                           else
                           '-'
                       end ass_reprovada,
                       consultoras_nao_renovadas
                  from (
                select fr.idfechamentorepres
                     , fr.idfechamentorepres idfechamentoreps_disp
                     , substr(ff.semana,4,4) ano
                     , substr(ff.semana,1,2) semana
                     , ff.semana  fechamento
                     , pck_romance.fnc_nomerepresentante(pidrepresentante => fr.idrepresentante) Representante
                     , pck_romance.fnc_nomefilial(pidfilial => fr.idfilial) Filial
                     , fr.setor
                     , pck_romance.fnc_nomeregiaovenda( fr.idregiaovenda ) Regiao
                     , (fr.qtdnotasnovas + fr.QTDNOTASNOVASOUTRAREG) qtdnotasnovas
                     , fr.qtdnotaslevou
                     , fr.qtdnotasfechou
                     , fr.vlralvo
                     , fr.totalgeral 
                     , fr.totalcobranca 
                     , fr.vlrespecie
                     , fr.vlrcheque
                     , fr.idcomissao
                     , nvl(fr.vlrcomissao,0) Vlr_Comissao
                     , decode(fr.confirmaalteracomissao,'S','Sim','Não') Alterou_Comissao
                     , fr.observacao
                     , ( select semana from fechamentossemanais ff where ff.idfechamento = fr.idfechamentopontuacao ) Referente_a
                     , decode(nvl(fr.vlralvo,0), 0, 0, ((fr.totalgeral/(fr.vlralvo*2))*100) ) Perc_Venda
                     , fr.totalperdas  Total_Resgate
                     , (select nvl(round( (sum(nv.valortotalvenda) / sum(nv.valortotalnota)) * 100),0)
                          from roman.notasvendas nv
                         where  nv.semanacobranca = ff.semana
                           and  nv.idsituacaonotavenda = 4
                           and  nv.idrepresentante = fr.idrepresentante) Percentual_Sacola
                     , fr.totalgeral
                     - nvl(fr.vlrespecie,0)
                     - nvl(fr.vlrcheque,0)
                     - nvl(fr.totaldepositos,0)
                     - nvl(fr.totaldepositoschq,0)+ nvl(fr.valordevolvidoaorepres,0)
                     - ( select nvl(sum(r.valor),0) valor
                         from despesas r
                         where r.idfechamentorepres = fr.idfechamentorepres )
                     - nvl(fr.vlrcomissao,0)Saldoapagar
                     , fr.saldo saldototal
                     , nvl(fr.totalpepinosrecebidos,0) Debitos_Recebidos
                     , nvl(fr.totaldebitosnovos,0) Debitos_Novos
                     , fr.idrepresentante
                     , FR.IDFECHAMENTOPONTUACAO
                     , fr.idregiaovenda 
                     , nvl(fr.TOTALCOMISSOESFAVORITAREPRES,0) Com_Paga_Fav
                     , nvl( ( select sum(c.valor)
                              from cheques2pgto c
                              where c.idfechamentorepres = fr.idfechamentorepres ),0) chequesemfundopago
                     , nvl(fr.totaldepositos,0) Total_Dep
                     , nvl(fr.totaldepositoschq,0) Total_Dep_Chq
                     , ( select count(1)
                         from roman.correcoesnotasvendas c
                         where c.idrepresentante = fr.idrepresentante
                           and c.situacao = 'P' ) Correçoes_Pendentes
                     , nvl(fr.valordevolvidoaorepres,0) valordevolvidoaorepres
                     , nvl(fr.notasemaberto,0) qtdnotasemaberto
                     , decode(fr.totalgeral,0,0,(round((fr.totaldebitosnovos/fr.totalgeral)*100,2))) percdebitosnovos
                     , case
                         when fr.saldo > 0 then
                           fr.saldo
                         else
                           0
                       end saldoacumuladopositivo
                     , nvl(fr.totalcomissaocobrakirepres,0) totalcomissaocobrakirepres  
                     , fr.usuariofinalizou
                     , fr.usuarioacerto --14837446
                     , fr.datafinalizado
                     , fr.datarevisao
                     , fr.usuariorevisou
                     , nvl(fr.totalcomissaoacordoakirepres,0) totalcomissaoacordoakirepres
                     , fr.totalgeral + totaldebitosnovos total_venda
                     , case
                         when totaldebitosnovos > 0 then
                           round( ( totaldebitosnovos / ( totalgeral + totaldebitosnovos ) ) * 100, 2)
                         else
                           0
                       end perc_inad
                     , valor_inicial
                     , totalgeral - valor_inicial diferenca
                     , case
                         when :P0_IDFECHAMENTO != 999999999999 then
                           (select count(1)
                            from notasvendas nv
                            where nv.idrepresentante = fr.idrepresentante --:P75_IDREPRESENTANTE
                              and exists ( select 1
                                           from classificacoesnotasvendas cf
                                           where cf.idnotavenda = nv.idnotavenda
                                             and cf.idcaracteristicanotavenda = 47 )
                              and ( nv.semanacobranca = ff.semana --:P75_SEMANA
                                 or exists ( select 1
                                             from pagamentosnotasvendas pg
                                             where pg.idnotavenda = nv.idnotavenda
                                               and pg.semanacobranca = ff.semana --:P75_SEMANA
                                               and pg.origem = 'R' ) )) 
                         else
                           null
                       end NOTAS_SALDO_NEGATIVO
                     , nvl(( select count(w.pecas)
                             from vw_resgates_distribuidores w
                             where w.idrepresentante = fr.idrepresentante ),0) Qtd_Resgate
                     , ( select nvl(sum(nv.valortotalnota),0)
                           from roman.notasvendas nv
                          where nv.semanadistribuicao = ff.semana
                            and nv.idsituacaonotavenda = 3
                            and nv.idrepresentante = fr.idrepresentante ) Distribuido_Semana
                            -- notas de outros distribuidores pagas neste acerto
                     , ( select count(distinct n.idnotavenda)
                           from roman.pagamentosnotasvendas p
                              , roman.notasvendas n
                          where p.idfechamentorepres = fr.idfechamentorepres
                            and n.idnotavenda        = p.idnotavenda
                            and n.idrepresentante   != fr.idrepresentante ) qtd_notas_outros
                     , ( select nvl(sum(p.valorpago),0)
                           from roman.pagamentosnotasvendas p
                              , roman.notasvendas n
                          where p.idfechamentorepres = fr.idfechamentorepres
                            and n.idnotavenda        = p.idnotavenda
                            and n.idrepresentante   != fr.idrepresentante ) vlr_notas_outros
                     , ( select listagg(distinct pck_romance.fnc_nomerepresentante(n.idrepresentante), ', ')
                                  within group (order by 1)
                           from roman.pagamentosnotasvendas p
                              , roman.notasvendas n
                          where p.idfechamentorepres = fr.idfechamentorepres
                            and n.idnotavenda        = p.idnotavenda
                            and n.idrepresentante   != fr.idrepresentante ) distrib_notas_outros
                  
                     --
                     , nvl(qtdconsultorasnaorenovadas,0) consultoras_nao_renovadas
                     , case when ( select distinct 1
                                   from parametrosrepresentantes pr
                                  where pr.parametro = 'UTILIZAASSINATURAELETRONICA'
                                    and pr.idrepresentante = fr.idrepresentante
                                    and pr.valor in ('S','Z') ) = 1 then
                          ( select sum(quantidadeassinaturasreprovadas)
                            from (
                                select nvl(count(1),0) quantidadeassinaturasreprovadas
                                  from notasvendas nv
                                     , assinaturaseletronicas a
                                 where nv.idnotavenda = a.idnotavenda
                                   and a.status = 'C'
                                   and a.tiponota = 'N'
                                   and a.situacao = 'R'
                                   and nv.idrepresentante = fr.idrepresentante
                                   and nv.semanadistribuicao = ff.semana
                                union
                                select nvl(count(1),0) quantidadeassinaturasreprovadas
                                from notasadicionais na
                                   , notasvendas nv
                                   , assinaturaseletronicas a
                                where nv.idnotavenda = a.idnotavenda
                                  and na.idnotavenda = nv.idnotavenda
                                  and a.status = 'C'
                                  and a.tiponota = 'A'
                                  and a.situacao = 'R'
                                  and nv.idrepresentante = fr.idrepresentante
                                  and na.semana = ff.semana
                            )
                          )
                        else
                            null
                        end ass_reprovadas -- mesma regra da tela 75 (T10750657)
                from fechamentorepresentantes fr
                   , fechamentossemanais   ff
                where ff.idfechamento  = fr.idfechamento
                  and ( :P0_IDFECHAMENTO = 999999999999 or fr.idfechamento = :P0_IDFECHAMENTO)
                  and fr.idfilial     = :P0_IDFILIAL
                 -- and ff.idsemana >= 1057 -- Esse trecho foi add por Leonel, mas depois comentado por Diego no suporte, usuario quer ver registros de mais anos atras.
                  and (:P0_IDPOSTOAVANCADO is null or exists ( select 1  
                                                               from representantes r
                                                               where r.idrepresentante = fr.idrepresentante
                                                                 and r.idpostoavancado = :P0_IDPOSTOAVANCADO ) )
                )
                ```
        }
        layout {
            sequence: 21
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <h3><b>Para verificar a comissão da Favorita é necessário entrar no acerto e clicar no botão Pagar Favorita.</b></h3>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2332,v('APP_USER')) = 'N'
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 75
                items: {
                    P75_IDFECHAMENTOREPRES: #IDFECHAMENTOREPRES#
                    P75_IDREPRESENTANTE: #IDREPRESENTANTE#
                    P75_IDREGIAOVENDA: #IDREGIAOVENDA#
                    P75_IDFECHAMENTOPONTUACAO: #IDFECHAMENTOPONTUACAO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Nenhum acerto efetuado.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 7382089746203250293
        }

