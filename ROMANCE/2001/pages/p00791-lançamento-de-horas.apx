    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            // Impede edição nos campos de total (horas e minutos)
            apex.jQuery(document).on(
              "focus mousedown keydown",
              "input.js-total-readonly",
              function (e) {
                e.preventDefault();   // não deixa digitar / focar
                this.blur();          // tira o foco se conseguir
              }
            );
            
            ```
    }

