    region lançamento-de-horas-estoque (
        name: Lançamento de Horas Estoque
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT e.idestfuncaocolab
                     , e.idesthorafuncao
                     , e.horainicio
                     , e.horafinal
                     , e.totalminutos
                     , e.totalhoras
                     , es.idfilial
                     , es.elaboradopor
                     , es.funcao
                     , es.dataregistro
                FROM roman.estfuncaocolabs e
                   , roman.estoquehorasfuncoes es
                WHERE es.idesthorafuncao = e.idesthorafuncao
                  AND es.idfilial = :P0_IDFILIAL
                  AND ( :P791_ELABORADOPOR is null or es.elaboradopor = :P791_ELABORADOPOR )
                  AND ( :P791_FUNCAO is null or es.funcao = :P791_FUNCAO)
                  AND ( :P791_DATAREGISTRO is null or TRUNC(es.DATAREGISTRO) = TO_DATE(:P791_DATAREGISTRO, 'DD/MM/RRRR'))
                  AND :P791_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
