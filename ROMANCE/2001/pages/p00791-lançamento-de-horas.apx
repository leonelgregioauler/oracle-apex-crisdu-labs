        column DATAREGISTRO (
            type: selectList
            heading {
                heading: Data de Registro
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    WITH cfg AS (
                      SELECT TO_NUMBER(p.valor) AS dias
                      FROM   roman.parametros p
                      JOIN   catal.gerentes  g ON g.idfilial = p.idfilial
                      JOIN   catal.usuarios  u ON u.idgerente = g.idgerente
                      WHERE  p.nome = 'DIASLANCAHORASFUNCAO'
                      AND    u.usuario = v('APP_USER')
                    )
                    SELECT
                      TO_CHAR(TRUNC(SYSDATE) - (LEVEL - 1), 'DD/MM/YYYY') AS display_value,  -- o que aparece na tela
                      TRUNC(SYSDATE) - (LEVEL - 1)                        AS return_value    -- retorna DATE real
                    FROM dual
                    CONNECT BY LEVEL <= NVL((SELECT dias FROM cfg), 0) + 1
                    ORDER BY 2 DESC;
                    
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: DATAREGISTRO
                dataType: date
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ELABORADOPOR (
            type: selectList
            heading {
                heading: Elaborado por
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ' DUPLA' d
                         , 'DUPLA' r
                    from dual
                    where exists ( select 1
                                   from parametros p
                                   where p.idfilial = :P0_IDFILIAL 
                                     and p.nome = 'REEMBALAGEMPOREQUIPE'
                                     and p.valor = 'S' )
                    union
                    select ' TRIO' d
                         , 'TRIO' r
                    from dual
                    where exists ( select 1
                                   from parametros p
                                   where p.idfilial = :P0_IDFILIAL
                                     and p.nome = 'REEMBALAGEMPOREQUIPE'
                                     and p.valor = 'S' )
                    union
                    select ' EQUIPE' d
                         , 'EQUIPE' r
                    from dual
                    where exists ( select 1
                                   from parametros p
                                   where p.idfilial = :P0_IDFILIAL
                                     and p.nome = 'REEMBALAGEMPOREQUIPE'
                                     and p.valor = 'S' )
                    union
                    select ' FREELANCER' d
                         , 'FREELANCER' r
                    from dual
                    union
                    select ' FREELANCER2' d
                         , 'FREELANCER2' r
                    from dual
                    union
                    select ' FREELANCER3' d
                         , 'FREELANCER3' r
                    from dual
                    union
                    select ' PEÇAS PRONTAS' d
                         , 'PEÇASPRONTRAS' r
                    from dual
                    union
                    select pck_romance.fnc_nomepessoa(f.idpessoa) nome
                         , f.identificacao
                    from funcionarios f
                    where f.idgerente = ( select idgerente
                                          from gerentes g
                                          where g.idfilial = :P0_IDFILIAL )
                      and f.idcargo in (0,7)
                      and f.ativo     = 'S' 
                      and f.identificacao is not null
                    order by 1
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ELABORADOPOR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

