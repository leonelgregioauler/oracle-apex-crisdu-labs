    dynamicAction new (
        name: New_2
        execution {
            sequence: 30
            eventScope: dynamic
        }
        when {
            selectionType: columns
            interactiveGrid: @lançamento-de-horas-estoque
            columns: HORAINICIO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                      CASE
                        WHEN :HORAINICIO IS NULL OR :HORAFINAL IS NULL THEN NULL
                        ELSE MOD(
                          (CASE
                             WHEN REGEXP_LIKE(:HORAFINAL, '^[0-9]{1,2}:[0-9]{2}$') THEN
                               TO_NUMBER(SUBSTR(:HORAFINAL, 1, INSTR(:HORAFINAL, ':') - 1)) * 60
                               + TO_NUMBER(SUBSTR(:HORAFINAL, INSTR(:HORAFINAL, ':') + 1))
                             WHEN REGEXP_LIKE(:HORAFINAL, '^[0-9]{3,4}$') THEN
                               TO_NUMBER(SUBSTR(:HORAFINAL, 1, LENGTH(:HORAFINAL) - 2)) * 60
                               + TO_NUMBER(SUBSTR(:HORAFINAL, -2))
                             ELSE NULL
                           END)
                          -
                          (CASE
                             WHEN REGEXP_LIKE(:HORAINICIO, '^[0-9]{1,2}:[0-9]{2}$') THEN
                               TO_NUMBER(SUBSTR(:HORAINICIO, 1, INSTR(:HORAINICIO, ':') - 1)) * 60
                               + TO_NUMBER(SUBSTR(:HORAINICIO, INSTR(:HORAINICIO, ':') + 1))
                             WHEN REGEXP_LIKE(:HORAINICIO, '^[0-9]{3,4}$') THEN
                               TO_NUMBER(SUBSTR(:HORAINICIO, 1, LENGTH(:HORAINICIO) - 2)) * 60
                               + TO_NUMBER(SUBSTR(:HORAINICIO, -2))
                             ELSE NULL
                           END)
                          + 1440, 1440)
                      END AS VAL
                    FROM DUAL
                    
                    ```
                itemsToSubmit: [
                    HORAINICIO
                    HORAFINAL
                ]
            }
            affectedElements {
                selectionType: columns
                columns: TOTALMINUTOS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                      CASE
                        WHEN :TOTALMINUTOS IS NULL THEN NULL
                        ELSE ROUND(:TOTALMINUTOS / 60, 2)
                      END AS VAL
                    FROM DUAL
                    
                    ```
                itemsToSubmit: TOTALMINUTOS
            }
            affectedElements {
                selectionType: columns
                columns: TOTALHORAS
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

