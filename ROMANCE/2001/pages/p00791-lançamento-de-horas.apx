    dynamicAction new-3 (
        name: New_1
        execution {
            sequence: 50
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    /*********************
                     * 1) Impede edição manual nos campos TOTALHORAS e TOTALMINUTOS
                     *********************/
                    $(document).on(
                      "focus mousedown keydown",
                      "input.js-total-readonly",
                      function (e) {
                        e.preventDefault();   // não deixa digitar / focar
                        this.blur();          // tira o foco
                      }
                    );
                    
                    
                    /*********************
                     * 2) Proteger o ":" nos campos de hora (js-time-mask)
                     *    - NÃO deixa apagar o ":" com Backspace/Delete
                     *    - Permite apagar e trocar os números normalmente
                     *********************/
                    
                    // Bloqueia apagar o ":" com Backspace/Delete
                    $(document).on("keydown", ".js-time-mask input", function (e) {
                        var input = this;
                        var val   = input.value || "";
                        var pos   = input.selectionStart || 0;
                    
                        // BACKSPACE: apaga o caractere anterior ao cursor
                        if (e.key === "Backspace" && pos > 0) {
                            var prevChar = val.charAt(pos - 1);
                            if (prevChar === ":") {
                                e.preventDefault(); // não permite apagar o ":"
                                return;
                            }
                        }
                    
                        // DELETE: apaga o caractere na posição atual do cursor
                        if (e.key === "Delete" && pos < val.length) {
                            var curChar = val.charAt(pos);
                            if (curChar === ":") {
                                e.preventDefault(); // não permite apagar o ":"
                                return;
                            }
                        }
                    
                        // Bloqueia letras e símbolos; deixa números, ":" e teclas de controle
                        if (e.key.length === 1 && !/[0-9:]/.test(e.key)) {
                            e.preventDefault();
                            return;
                        }
                    });
                    
                    
                    /*********************
                     * 3) Filtro simples no input:
                     *    - Só permite dígitos e ":"
                     *    - Limita o tamanho máximo a 5 caracteres (HH:MM)
                     *    (Não mexe na posição do ":" nem reconstrói o valor)
                     *********************/
                    $(document).on("input", ".js-time-mask input", function () {
                        var input = this;
                        var v = input.value || "";
                    
                        // Mantém apenas dígitos e ":" (não altera a ordem)
                        v = v.replace(/[^0-9:]/g, "");
                    
                        // Limita a 5 caracteres
                        if (v.length > 5) {
                            v = v.substring(0, 5);
                        }
                    
                        input.value = v;
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    process lançamento-de-horas-estoque-save-interactive-grid-data (
        name: Lançamento de Horas Estoque - Save Interactive Grid Data
        type: executeCode
        editableRegion: @lançamento-de-horas-estoque
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_status VARCHAR2(10) := NVL(:APEX$ROW_STATUS, 'N'); -- 'C','U','D','N'
                  v_ehf    NUMBER;
                
                  -- Cabeçalho vindos da LINHA do IG (hidden columns)
                  v_idfilial      NUMBER := :IDFILIAL;
                  v_funcao        NUMBER := :FUNCAO;
                  v_elaboradopor  VARCHAR2(100) := :ELABORADOPOR;
                  v_dataregistro  DATE;
                  v_idsemana      NUMBER;
                
                  -- Detalhe vindos da LINHA
                  v_hora_inicio   VARCHAR2(10);
                  v_hora_final    VARCHAR2(10);
                
                  -- Para validação de horários
                  v_hora_inicio_dt  DATE;
                  v_hora_final_dt   DATE;
                  v_qtd_sobreposto  NUMBER;
                BEGIN
                  -------------------------------------------------------------------
                  -- Conversões explícitas para evitar ORA-01861
                  -------------------------------------------------------------------
                  v_dataregistro := CASE
                                      WHEN :DATAREGISTRO IS NULL THEN NULL
                                      WHEN REGEXP_LIKE(:DATAREGISTRO,'^\d{2}/\d{2}/\d{4}$')
                                        THEN TO_DATE(:DATAREGISTRO,'DD/MM/YYYY')
                                      WHEN REGEXP_LIKE(:DATAREGISTRO,'^\d{4}-\d{2}-\d{2}$')
                                        THEN TO_DATE(:DATAREGISTRO,'YYYY-MM-DD')
                                      ELSE TO_DATE(:DATAREGISTRO) -- último recurso
                                    END;
                
                  v_hora_inicio := :HORAINICIO;
                  v_hora_final  := :HORAFINAL;
                
                  -------------------------------------------------------------------
                  -- Validação de formato HH24:MI (ex: 09:05, 18:30)
                  -- - exige exatamente 2 dígitos, ":", 2 dígitos
                  -- - valida faixa 00-23 / 00-59
                  -------------------------------------------------------------------
                  IF v_hora_inicio IS NULL OR v_hora_final IS NULL THEN
                    RAISE_APPLICATION_ERROR(-20001,
                      'Hora inicial e hora final devem ser informadas.');
                  END IF;
                
                  IF NOT REGEXP_LIKE(v_hora_inicio, '^\d{2}:\d{2}$')
                     OR NOT REGEXP_LIKE(v_hora_final,  '^\d{2}:\d{2}$')
                  THEN
                    RAISE_APPLICATION_ERROR(-20010,
                      'Horários inválidos. Use o formato do exemplo: 08:30');
                  END IF;
                
                  IF NOT REGEXP_LIKE(v_hora_inicio, '^([01]\d|2[0-3]):([0-5]\d)$') THEN
                    RAISE_APPLICATION_ERROR(-20011,
                      'Hora inicial inválida. Use HH24:MI (00:00 a 23:59).');
                  END IF;
                
                  IF NOT REGEXP_LIKE(v_hora_final, '^([01]\d|2[0-3]):([0-5]\d)$') THEN
                    RAISE_APPLICATION_ERROR(-20012,
                      'Hora final inválida. Use HH24:MI (00:00 a 23:59).');
                  END IF;
                
                  -- converte as horas para DATE para facilitar comparação
                  v_hora_inicio_dt := TO_DATE(v_hora_inicio, 'HH24:MI');
                  v_hora_final_dt  := TO_DATE(v_hora_final,  'HH24:MI');
                
                  -------------------------------------------------------------------
                  -- Validações básicas de horário
                  -------------------------------------------------------------------
                  IF v_hora_inicio_dt >= v_hora_final_dt THEN
                    RAISE_APPLICATION_ERROR(-20002,
                      'Hora inicial deve ser menor que a hora final.');
                  END IF;
                
                  -------------------------------------------------------------------
                  -- Verifica qual idsemana deve buscar através da data de registro
                  -------------------------------------------------------------------
                  SELECT s.idsemana
                    INTO v_idsemana
                    FROM roman.semana_dias s
                   WHERE v_dataregistro BETWEEN s.dt_ini AND s.dt_fim;
                
                  -------------------------------------------------------------------
                  -- Validação de sobreposição de horários
                  -------------------------------------------------------------------
                  SELECT COUNT(*)
                    INTO v_qtd_sobreposto
                    FROM ROMAN.ESTFUNCAOCOLABS c
                    JOIN ROMAN.ESTOQUEHORASFUNCOES h
                      ON h.IDESTHORAFUNCAO = c.IDESTHORAFUNCAO
                   WHERE h.IDFILIAL     = v_idfilial
                     AND h.ELABORADOPOR = v_elaboradopor
                     AND h.IDSEMANA     = v_idsemana
                     AND ( :IDESTFUNCAOCOLAB IS NULL
                           OR c.IDESTFUNCAOCOLAB <> :IDESTFUNCAOCOLAB )
                     AND TO_DATE(c.HORAINICIO,'HH24:MI') < v_hora_final_dt
                     AND TO_DATE(c.HORAFINAL,  'HH24:MI') > v_hora_inicio_dt;
                
                  IF v_qtd_sobreposto > 0 THEN
                    RAISE_APPLICATION_ERROR(-20003,
                      'Já existe horário lançado para '||v_elaboradopor||
                      ' nesse intervalo. Ajuste os horários.');
                  END IF;
                
                  -------------------------------------------------------------------
                  -- A partir daqui, só entra se passou pelas validações
                  -------------------------------------------------------------------
                  IF v_status = 'C' THEN
                    v_ehf := :IDESTHORAFUNCAO;
                
                    IF v_ehf IS NULL THEN
                      INSERT INTO ROMAN.ESTOQUEHORASFUNCOES
                        (IDFILIAL, FUNCAO, ELABORADOPOR, IDSEMANA, DATAREGISTRO, DATAINCLUSAO)
                      VALUES
                        (v_idfilial, v_funcao, v_elaboradopor, v_idsemana, v_dataregistro, SYSDATE)
                      RETURNING IDESTHORAFUNCAO INTO v_ehf;
                
                      :IDESTHORAFUNCAO := v_ehf;
                    END IF;
                
                    INSERT INTO ROMAN.ESTFUNCAOCOLABS
                      (IDESTFUNCAOCOLAB,
                       IDESTHORAFUNCAO,
                       HORAINICIO,
                       HORAFINAL,
                       TOTALMINUTOS,
                       TOTALHORAS)
                    VALUES
                      (NULL,
                       v_ehf,
                       v_hora_inicio,
                       v_hora_final,
                       :TOTALMINUTOS,
                       :TOTALHORAS)
                    RETURNING IDESTFUNCAOCOLAB INTO :IDESTFUNCAOCOLAB;
                
                  ELSIF v_status = 'U' THEN
                    UPDATE ROMAN.ESTFUNCAOCOLABS
                       SET HORAINICIO   = v_hora_inicio,
                           HORAFINAL    = v_hora_final,
                           TOTALMINUTOS = :TOTALMINUTOS,
                           TOTALHORAS   = :TOTALHORAS
                     WHERE IDESTFUNCAOCOLAB = :IDESTFUNCAOCOLAB;
                
                  ELSIF v_status = 'D' THEN
                    DELETE FROM ROMAN.ESTFUNCAOCOLABS
                     WHERE IDESTFUNCAOCOLAB = :IDESTFUNCAOCOLAB;
                  END IF;
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1792654270635117714
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 791
                items: {
                    P791_FILTRAR: S
                }
            }
        }
    )

)

