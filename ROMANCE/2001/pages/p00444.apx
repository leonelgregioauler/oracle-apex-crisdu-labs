    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region despesas-fixas (
        name: Despesas Fixas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(d.idfilial) empresa
                     , pck_romance.fnc_nomecontafinan(d.idcontacontabil) conta
                     , pck_romance.fnc_nomesubcontafinan(d.idsubcontacontabil) subcont
                     , d.valor valor
                     , round((d.valor*nvl(f.fatorconversao,1)),2) valorconversao
                     , d.observacao
                     , datalancamento
                     , d.valordiferenca diferenca
                from despesas d
                   , vw_filiais f
                   , contasfinanceiras c
                   , subcontasfinanceiras sc
                where c.idcontafinan        = d.idcontacontabil
                  and sc.idsubcontafinan(+) = d.idsubcontacontabil
                  and f.idfilial            = d.idfilial
                  and nvl(sc.tipo,c.tipo)   = 'F'
                  and d.idfilial            is not null
                  and extract( year from d.datalancamento)  = :P444_ANO
                  and :P444_TIPO_RELATORIO  = 'D'
                  and ( :P444_IDFILIAl is null or d.idfilial = :P444_IDFILIAL )
                  and ( :P444_MES is null or extract( month from d.datalancamento) = :P444_MES )
                  and ( :P444_GRUPO_EMPRESAS is null
                     or ( :P444_GRUPO_EMPRESAS = 'R' and exists ( select 1
                                                                  from notasvendas nv
                                                                  where nv.idfilial = f.idfilial )
                                                     and ( f.tipofilial = 'D' and f.ativo = 'S' ) )
                     or ( :P444_GRUPO_EMPRESAS = 'G' and ( f.tipofilial != 'D' and f.ativo = 'S' ) ) )
                order by iddespesa
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P444_TIPO_RELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1504174791142062928
        }

