            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        default {
            type: expression
            plsqlExpression: to_number(to_char(sysdate,'RRRR'))
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P444_GRUPO_EMPRESAS (
        type: radioGroup
        label {
            label: Grupo
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Distribuidoras Romance;R,Grupo Crisdu;G
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: D
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P444_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and ( :P444_GRUPO_EMPRESAS is null
                     or ( :P444_GRUPO_EMPRESAS = 'R' and exists ( select 1
                                                                  from notasvendas nv
                                                                  where nv.idfilial = f.idfilial )
                                                     and f.tipofilial = 'D' )
                     or ( :P444_GRUPO_EMPRESAS = 'G' and f.tipofilial != 'D' ) )
                ```
            nullDisplayValue: - Selecione a Empresa -
        }
        cascadingLov {
            parentItems: P444_GRUPO_EMPRESAS
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P444_MES (
        type: selectList
        label {
            label: Mês
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.mes
                     , m.numero
                from meses m
                order by 2
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P444_TIPO_RELATORIO (
        type: radioGroup
        label {
            label: Relatório
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Detalhado;D,Resumido;R
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: FILTRAR
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 444
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 444
                items: {
                    P444_TIPO_RELATORIO: &P444_TIPO_RELATORIO.
                    P444_IDFILIAL: &P444_IDFILIAL.
                    P444_ANO: &P444_ANO.
                    P444_MES: &P444_MES.
                    P444_GRUPO_EMPRESAS: &P444_GRUPO_EMPRESAS.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

