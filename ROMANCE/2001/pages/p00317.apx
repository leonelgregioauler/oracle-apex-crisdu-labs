page 317 (
    name: Efetuar Distribuição PA
    title: Efetuar Distribuição PA
    appearance {
        pageTemplate: @/marquee
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatar_mascara(src,mascara,evt)
            {
              var tecla;  
              if(evt.which)
                {
            	  tecla = evt.which
            	}
              else
                {
            	  if (evt.keyCode)
                  { 
            	    tecla = evt.keyCode;
            	  }  
            	  if( tecla != 8 )
                  { 
            	    var campo = src.value.length;
            	    var saida = mascara.substring(0,1);
            	    var texto = mascara.substring(campo);
            	    if (texto.substring(0,1) != saida) 
            	    {
            	      src.value+=texto.substring(0,1);
            	    }
            	  }
              }
            }
            
            function getMoney( str )
            {
              return parseInt( str.replace(/[\D]+/g,'') );
            }
            
            function iniciar(pidestoquepa, pidestoque, pdisponivel, pdistribuido, psaldo, psemana)
            {
              document.getElementById('P317_IDESTOQUEPA').value = pidestoquepa;
              document.getElementById('P317_IDESTOQUE').value   = pidestoque;
              document.getElementById('P317_DISPONIVEL').value  = pdisponivel;
              document.getElementById('P317_DISTRIBUIDO').value = pdistribuido;
              document.getElementById('P317_SALDO').value       = psaldo;
              document.getElementById('P317_SEMANA').value      = psemana;
              apex.submit('FILTRAR');
            }
            
            function fnc_soma()
            {
              if (document.getElementById('P317_DISPONIVEL').value != '')
                {
                  document.getElementById('P317_DISTRIBUIDO').value = 0;
                  document.getElementById('P317_DISTRIBUIR').value = 0;
                  vsaldo = document.getElementById('P317_SALDO').value ;
                  document.getElementById('P317_SALDO').value = document.getElementById('P317_DISPONIVEL').value ; 
                  vvalor = 0;
                  for(i=0;i<document.wwv_flow.length;i++)
                  {
                    if ( isNaN(parseFloat(document.wwv_flow.f01[i].value) ))
                    {
                      void(0);
                    }
                    else
                    { 
                     //  valor = document.wwv_flow.f01[i].value;
                     //  valor = valor.replace(".","");
                     //  valor = valor.replace(",","");
                     //  valor = parseFloat(valor);
                       valor = getMoney( document.wwv_flow.f01[i].value);
                       vvalor = parseFloat(vvalor)+parseFloat(valor);  
            
                       document.getElementById('P317_DISTRIBUIDO').value = vvalor;
                       document.getElementById('P317_SALDO').value       = document.getElementById('P317_DISPONIVEL').value - vvalor;       
                       document.getElementById('P317_DISTRIBUIR').value  = document.getElementById('P317_SALDO').value;
            
                       if (parseFloat(document.getElementById('P317_SALDO').value) < 0 )
                       {
                           alert('Quantidade não disponível! Saldo atual: '+document.getElementById('P317_SALDO').value);
                       }
                    }
                  }
                }
            } 
            
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            
            
            function redirecionar(pidestoquefilial,pquantidade,pdistribuido,psaldo,psemana)
            {
              document.getElementById('P317_IDESTOQUE').value   = pidestoquefilial;
                alert('oi');
              document.getElementById('P317_DISPONIVEL').value  = pquantidade;
              document.getElementById('P317_DISTRIBUIDO').value = pdistribuido;
              document.getElementById('P317_SALDO').value       = psaldo;
              document.getElementById('P317_DISTRIBUIR').value       = psaldo;
              
              apex.submit('FILTRAR');
            }
            
            function gerarcargas(event)
            {
              var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
             //console.log (tecla);
              var answer = confirm("Deseja realmente gerar as Cargas?");
              void(0);
              if (answer)
              {
                apex.submit('GERARCARGAS');
              }
            }
            ```
        executeWhenPageLoads: fnc_soma();
    }
