    pageItem P317_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00'))||'/'||ano||' - Cargas Geradas: '||( select count(1)
                                                                      from cargasrepresentantes c
                                                                      where c.idsemana = s.idsemana
                                                                        and c.idfilial = :P0_IDFILIAL ) display_value
                     , trim(to_char(semana,'00'))||'/'||ano return_value
                from semana_dias s 
                where idsemana  between  pck_util.fnc_idsemanadata(sysdate)-2  and   pck_util.fnc_idsemanadata(sysdate)+4
                order by idsemana desc
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 20
            region: @selecionar-semana-e-posto-avançado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            customAttributes: "onkeyPress=\"javascript:{formatar_mascara(this, '##/###',event); }\" "
        }
        security {
            encryptSessionState: false
        }
    )

