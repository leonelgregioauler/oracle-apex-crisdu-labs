    region disponivel (
        name: Disponivel
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '<a href="javascript:iniciar('||e.idestpostoavancado||','||e.idestoquefilial||','||e.quantidade||','||distribuido||','|| to_char(quantidade - distribuido)||','''||e.semana||''')"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                        editar 
                     , idestoquefilial
                     , idfilial
                     , idestpostoavancado
                     , idpostoavancado
                     , semana
                     , classificacao1
                     , classificacao2
                     , categoria
                     , produto
                     , quantidade
                     , vlrvenda
                     , comissao
                     , distribuido
                     , quantidade - distribuido saldo
                from ( select e.idestoquefilial
                           , e.idfilial
                           , e.semana
                           , ep.idestpostoavancado
                           , ep.idpostoavancado
                           , ee.classificacao1
                           , ee.classificacao2
                           , ( select c.nome
                               from categorias c
                               where c.idcategoria = ( select idcategoria
                                                       from produtos p
                                                       where p.idproduto = ee.idproduto ) ) categoria
                           , pck_romance.fnc_nomeproduto(ee.idproduto)||' - '||p.codigosisdist produto
                           , pck_estoque.fnc_estoquedisponivel_pa(e.idestoquefilial,'U',ep.idpostoavancado) quantidade
                           , ee.vlrvenda
                           , DECODE(ee.comissao,'S','Sim','Não') comissao
                           , nvl(( select sum(g.quantidade)
                                   from roman.gerarcargaspa_temp g
                                   where g.idestoquepostoavancado = ep.idestpostoavancado
                                     and g.idestoquefil           = ep.idestoquefil
                                     and g.semana                 = e.semana ),0) distribuido
                      from roman.estoqueplanilhadistribpa e
                         , roman.estoquefilial ee
                         , roman.estoquepostoavancado ep
                         , roman.produtos p
                      where e.idestoquefilial        = ee.idestoquefilial
                        and e.idestoquepostoavancado = ep.idestpostoavancado
                        and p.idproduto              = ee.idproduto
                        and ee.idfilial              = :P0_IDFILIAL
                        and e.idfilial               = ee.idfilial
                        and ee.idestoquefilial       = ep.idestoquefil
                        and ep.idpostoavancado       = :P317_IDPOSTOAVANCADO
                        and e.semana                 = :P317_SEMANA
                        and ( :P317_CLASSIFICACAO1 = 'T' 
                                 OR ( :P317_CLASSIFICACAO1 = 'Z' and ee.classificacao1 is null )
                                 or ( :P317_CLASSIFICACAO1 not in ('T','Z') and ee.classificacao1 = :P317_CLASSIFICACAO1 ) )
                        and ( :P317_CLASSIFICACAO2 = 'T' 
                                 OR ( :P317_CLASSIFICACAO2 = 'Z' and ee.classificacao2 is null )
                                 or ( :P317_CLASSIFICACAO2 not in ('T','Z') and ee.classificacao2 = :P317_CLASSIFICACAO2 ) )
                        and ( :P317_QUANTIDADE is null or e.quantidade       > :P317_QUANTIDADE)
                        and (:P317_IDCATEGORIA = -1 or ( exists ( select 1 
                                                                  from produtos p 
                                                                  where p.idproduto = ee.idproduto
                                                                    and p.idcategoria = :P317_IDCATEGORIA)) ) ) e
                ```
