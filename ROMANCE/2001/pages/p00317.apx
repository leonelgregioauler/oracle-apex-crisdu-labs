    dynamicAction alterar (
        name: Alterar
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P317_SEMANA
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CATEGORIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction distribuir-igual (
        name: Distribuir Igual
        execution {
            sequence: 80
        }
        when {
            event: click
            selectionType: button
            button: @distribuir-igual
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: IGUAL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

