    region distribuir (
        name: Distribuir
        type: tabform
        source {
            sqlQuery:
                ```sql
                select ROWID
                     , IDREPRESENTANTE
                     , QUANTIDADE
                     , pck_romance.fnc_nomerepresentante(g.IDREPRESENTANTE ) ||' <br> <i> '|| ( select pck_romance.fnc_nomeregiaovenda(idregiaovenda) 
                                                                                      from regioesrepresentantes
                                                                                      where semana           = g.SEMANA
                                                                                        and idrepresentante  = g.IDREPRESENTANTE )||'</i>' representante
                     , (select sum(gg.quantidade) ||' / <i> '||trim(to_char(sum(gg.quantidade * e.vlrvenda),'999G999G999G999G990D00'))||'</i>'
                                     ||' / <b> '
                           
                        from roman.gerarcargaspa_temp gg
                           , roman.estoquefilial e
                           , roman.estoquepostoavancado ep
                        where ep.idestoquefil           = e.idestoquefilial
                          and e.idfilial                = g.idfilial
                          and gg.idpostoavancado        = ep.idpostoavancado
                          and gg.idestoquefil           = ep.idestoquefil
                          and gg.idestoquepostoavancado = ep.idestpostoavancado
                          and gg.semana                 = g.SEMANA
                          and gg.idrepresentante        = g.IDREPRESENTANTE
                          and gg.quantidade             > 0) ||
                   case 
                            when ( select count(1) 
                                   from notasvendas n
                                   where ( ( idrepresentante  = g.IDREPRESENTANTE and idrepresentanteatende is null ) or idrepresentanteatende  = g.IDREPRESENTANTE ) 
                                     and n.idregiaovenda   = ( select idregiaovenda 
                                                                from regioesrepresentantes
                                                                where semana           = g.SEMANA
                                                                  and idrepresentante  = g.IDREPRESENTANTE ) 
                                     and trim(n.semanacobranca) = g.semana 
                                     and n.idsituacaonotavenda != 5
                                     and n.idsituacaonotavenda > 1 ) <= 0 then
                                  '0'
                             else
                                  trim(to_char(  (select sum(gg.quantidade)            
                                                  from roman.gerarcargaspa_temp gg
                                                     , roman.estoquefilial e
                                                     , roman.estoquepostoavancado ep
                                                  where ep.idestoquefil           = e.idestoquefilial
                                                    and e.idfilial                = g.idfilial
                                                    and gg.idpostoavancado        = ep.idpostoavancado
                                                    and gg.idestoquefil           = ep.idestoquefil
                                                    and gg.idestoquepostoavancado = ep.idestpostoavancado
                                                    and gg.semana                 = g.SEMANA
                                                    and gg.idrepresentante        = g.IDREPRESENTANTE
                                                    and gg.quantidade      > 0)/
                                                 ( select count(1) 
                                                   from notasvendas n
                                                   where ( ( idrepresentante  = g.IDREPRESENTANTE and idrepresentanteatende is null ) or idrepresentanteatende  = g.IDREPRESENTANTE ) 
                                                     and n.idregiaovenda   = ( select idregiaovenda 
                                                                                from regioesrepresentantes
                                                                                where semana           = g.SEMANA
                                                                                  and idrepresentante  = g.IDREPRESENTANTE ) 
                                                     and trim(n.semanacobranca) = g.semana 
                                                     and n.idsituacaonotavenda != 5
                                                                   and n.idsituacaonotavenda > 1 ) ,'999G999G999G999G990'))||'  </b> '
                                                                   end       qtddistribuido
                
                     , ( select count(1) ||' <br> <i> '||trim(to_char(sum(n.valortotalnota)* 0.675/2 ,'999G999G999G999G990D00'))||'</i>'
                         from notasvendas n
                         where ( ( idrepresentante  = g.IDREPRESENTANTE and idrepresentanteatende is null ) or idrepresentanteatende  = g.IDREPRESENTANTE ) 
                           and n.idregiaovenda   = ( select idregiaovenda 
                                                      from regioesrepresentantes
                                                      where semana           = g.SEMANA
                                                        and idrepresentante  = g.IDREPRESENTANTE ) 
                           and trim(n.semanacobranca) = g.semana 
                           and n.idsituacaonotavenda != 5
                           and n.idsituacaonotavenda > 1 )  qtdnotas
                
                     , ( select count(1)||' <br> <i> '||trim(to_char( sum(n.valortotalnota)* 0.675/2 ,'999G999G999G999G990D00'))||'</i>'
                         from notasvendas n
                         where ( ( idrepresentante  = g.IDREPRESENTANTE and idrepresentanteatende is null ) or idrepresentanteatende  = g.IDREPRESENTANTE ) 
                           and n.idregiaovenda   != ( select idregiaovenda 
                                                       from regioesrepresentantes
                                                       where semana           = g.SEMANA
                                                        and idrepresentante  = g.IDREPRESENTANTE )
                           and n.idsituacaonotavenda != 5
                           and trim(n.semanacobranca) = g.semana 
                          -- and n.semanadistribuicao   = pck_romance.fnc_semanaciclo(g.semana)--trim(n.semanacobranca) = psemana
                           and n.idsituacaonotavenda > 1 )  notasemaberto
                     
                       , nvl( ( select sum(nvl(i.quantidade,0))||'/'||sum(nvl(i.quantidade,0) - nvl(i.qtddevolvida,0))
                                                             ||'/'||case 
                                                                       when sum(nvl(i.quantidade,0)) = 0 then
                                                                        '0%' 
                                                                     else 
                                                                        trim(to_char((sum(nvl(i.quantidade,0))-sum(nvl(i.qtddevolvida,0)))*100/sum(nvl(i.quantidade,0)),'999G990'))||'%'
                                                                     end
                              from itensnotavenda i
                              where i.idestoquefil = g.idestoquefil
                                and exists ( select 1
                                              from notasvendas n
                                              where ( ( idrepresentante  = g.IDREPRESENTANTE and idrepresentanteatende is null ) or idrepresentanteatende  = g.IDREPRESENTANTE ) 
                                                and n.idregiaovenda   = ( select idregiaovenda 
                                                                           from regioesrepresentantes r
                                                                           where semana           = g.SEMANA
                                                                             and idrepresentante  = g.IDREPRESENTANTE ) 
                                                and n.semanacobranca       = pck_util.fnc_semanaid( pck_util.fnc_idsemanaciclo(pck_util.fnc_idsemana( g.semana )))
                                                and n.idsituacaonotavenda  = 4
                                                and n.idnotavenda          = i.idnotavenda ) ),0) vendido
                                                
                     , ( select sum(ic.valorvenda* ( nvl(ic.qtd_dist_pp,0) 
                                                   + nvl(ic.qtd_dist_p,0) 
                                                   + nvl(ic.qtd_dist_m,0) 
                                                   + nvl(ic.qtd_dist_g,0) 
                                                   + nvl(ic.qtd_dist_gg,0) 
                                                   + nvl(ic.qtd_dist_egg,0) 
                                                   + nvl(ic.qtd_dist_exgg,0) 
                                                   + nvl(ic.qtd_dist_u,0) ) )
                         from itenscargarepresentante ic
                            , cargasrepresentantes c
                          where c.idcargarepresentante = ic.idcargarepresentante
                            and c.idrepresentante      = g.idrepresentante
                            and c.semana               = g.semana )  carga
                     , ( select c.idcargarepresentante
                          from cargasrepresentantes c
                          where c.idrepresentante      = g.idrepresentante
                            and c.semana               = g.semana ) idcarga
                from roman.gerarcargaspa_temp g
                where g.idfilial               = :P0_IDFILIAL
                  and g.semana                 = :P317_SEMANA
                  and g.idestoquefil           = :P317_IDESTOQUE
                  and g.idestoquepostoavancado = :P317_IDESTOQUEPA
                  and g.idpostoavancado        = :P317_IDPOSTOAVANCADO
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = g.idrepresentante
                                 and r.idpostoavancado = g.idpostoavancado)
                  and not exists( select 1
                                  from cargasrepresentantes c
                                  where c.idrepresentante = g.idrepresentante 
                                    and c.semana          = g.semana )
                ```
        }
