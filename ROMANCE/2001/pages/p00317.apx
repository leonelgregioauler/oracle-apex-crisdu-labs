    validation distribuir (
        name: Distribuir
        execution {
            sequence: 50
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_number(:P317_DISTRIBUIR) <= to_number(:P317_SALDO)
                ```
        }
        error {
            errorMessage: Quantidade não pode ser maior que o saldo!
            associatedItem: @P317_DISTRIBUIR
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: PROPORCIONAL,IGUAL
        }
    )

    validation quantidade-negativa (
        name: Quantidade Negativa
        execution {
            sequence: 40
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_number(:P317_SALDO) >= 0
                ```
        }
        error {
            errorMessage: Quantidade distribuída é maior que a disponível! Verifique!
            associatedItem: @P317_SALDO
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

