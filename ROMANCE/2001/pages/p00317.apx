                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from produtos p
                where idproduto = ( select idproduto 
                                    from estoquefilial e 
                                    where e.idestoquefilial = :P317_IDESTOQUE )
                  and  p.linkfoto is not null
                ```
        }
    )

