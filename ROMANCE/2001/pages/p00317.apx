    region erros (
        name: Erros
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DATAERRO
                     , substr(observacao,0,instr(observacao,' User-Defined')) observacao
                from erroimportacarga t
                where idfilial = :P0_IDFILIAL
                  and sysdate - dataerro < 0.006
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from erroimportacarga t
                where idfilial = :P0_IDFILIAL
                  and sysdate - dataerro < 0.006
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATAERRO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 1
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
