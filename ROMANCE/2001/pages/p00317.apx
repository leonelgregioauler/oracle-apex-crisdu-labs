                ```plsql
                begin
                  --
                  update roman.GERARCARGASPA_TEMP g
                  set g.quantidade = null
                  where g.idfilial       = :P0_IDFILIAL
                    and g.idestoquefil      = :P317_IDESTOQUE
                    and g.idestoquepostoavancado = :P317_IDESTOQUEPA
                    and g.semana         = :P317_SEMANA;
                  --
                end;
                
                ```
        }
