            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from estoqueplanilhadistribpa e
                where e.idfilial = :P0_IDFILIAL
                  and e.semana = :P317_SEMANA
                  and e.idpostoavancado = :P317_IDPOSTOAVANCADO
                ```
        }
    )

