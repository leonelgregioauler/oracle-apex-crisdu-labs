    process gerar-temp (
        name: gerar_temp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  INSERT into roman.gerarcargaspa_temp (idpostoavancado,
                                                        idrepresentante,
                                                        referencia,
                                                        semana,
                                                        idestoquepostoavancado,
                                                        idestoquefil,
                                                        idfilial)
                  select :P317_IDPOSTOAVANCADO
                       , r.idrepresentante
                       , '-'
                       , :P317_SEMANA
                       , ep.idestoquepostoavancado
                       , ep.idestoquefilial
                       , :P0_IDFILIAL
                  from representantes r
                     , roman.estoqueplanilhadistribpa ep
                  where idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = ep.idfilial )
                    and ativo = 'S' 
                    and ep.idfilial = :P0_IDFILIAL
                    and ep.semana     = :P317_SEMANA
                    and r.idpostoavancado = :P317_IDPOSTOAVANCADO
                    and not exists ( select 1
                                     from roman.gerarcargaspa_temp gp
                                     where gp.idfilial               = ep.idfilial
                                       and gp.idestoquefil           = ep.idestoquefilial
                                       and gp.idestoquepostoavancado = ep.idestoquepostoavancado
                                       and gp.semana                 = :P317_SEMANA
                                       and gp.idpostoavancado        = :P317_IDPOSTOAVANCADO
                                       and gp.idrepresentante        = r.idrepresentante  );
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 3520625680033713
        }
        serverSideCondition {
            type: request=Value
            value: INICIAR
        }
    )

    process iniciar-atualizar (
        name: Iniciar/atualizar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    --
                    insert into roman.estoqueplanilhadistribpa (idestoquepostoavancado,idestoquefilial,idpostoavancado,idfilial,semana,quantidade)
                    select ep.idestpostoavancado
                         , ep.idestoquefil
                         , ep.idpostoavancado
                         , :P0_IDFILIAL
                         , :P317_SEMANA
                         , ((nvl(ep.qtd_pp ,0) - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'PP', pidpostoavancado => ep.idpostoavancado)  )
                         + (nvl(ep.qtd_p  ,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'P', pidpostoavancado => ep.idpostoavancado)   )   
                         + (nvl(ep.qtd_m  ,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'M', pidpostoavancado => ep.idpostoavancado)   )
                         + (nvl(ep.qtd_g  ,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'G', pidpostoavancado => ep.idpostoavancado)   )
                         + (nvl(ep.qtd_gg ,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'GG', pidpostoavancado => ep.idpostoavancado)  )
                         + (nvl(ep.qtd_egg,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'EGG', pidpostoavancado => ep.idpostoavancado) )
                         + (nvl(ep.qtd_exgg,0) - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'EXGG', pidpostoavancado => ep.idpostoavancado))
                         + (nvl(ep.qtd_u  ,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'U', pidpostoavancado => ep.idpostoavancado)  ))  estoque
                    from roman.estoquefilial e
                       , roman.estoquepostoavancado ep
                    where e.idfilial = :P0_IDFILIAL
                      and ep.idestoquefil = e.idestoquefilial
                      and ep.idpostoavancado = :P317_IDPOSTOAVANCADO
                      and e.ativo = 'S'
                      and comissao is not null
                      and vlrvenda is not null
                      and ((nvl(ep.qtd_pp ,0) - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'PP', pidpostoavancado => ep.idpostoavancado)  ) > 0 
                        or (nvl(ep.qtd_p  ,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'P', pidpostoavancado => ep.idpostoavancado)  ) > 0 
                        or (nvl(ep.qtd_m  ,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'M', pidpostoavancado => ep.idpostoavancado)   )> 0
                        or (nvl(ep.qtd_g  ,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'G', pidpostoavancado => ep.idpostoavancado)   )> 0
                        or (nvl(ep.qtd_gg ,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'GG', pidpostoavancado => ep.idpostoavancado)  )> 0
                        or (nvl(ep.qtd_egg,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'EGG', pidpostoavancado => ep.idpostoavancado) )> 0
                        or (nvl(ep.qtd_exgg,0) - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'EXGG', pidpostoavancado => ep.idpostoavancado))> 0
                        or (nvl(ep.qtd_u  ,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'U', pidpostoavancado => ep.idpostoavancado)  ) > 0 )
                      and not exists ( select 1
                                       from roman.estoqueplanilhadistribpa eep
                                       where eep.idestoquepostoavancado = ep.idestpostoavancado
                                         and eep.idestoquefilial        = ep.idestoquefil
                                         and eep.semana                 = :P317_SEMANA );
                    --
                    update roman.estoqueplanilhadistribpa eep
                    set (eep.quantidade)  = ( select (nvl(ep.qtd_pp ,0) - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'PP', pidpostoavancado => ep.idpostoavancado)  
                                                   + (nvl(ep.qtd_p  ,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'P', pidpostoavancado => ep.idpostoavancado)   )   
                                                   + (nvl(ep.qtd_m  ,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'M', pidpostoavancado => ep.idpostoavancado)   )
                                                   + (nvl(ep.qtd_g  ,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'G', pidpostoavancado => ep.idpostoavancado)   )
                                                   + (nvl(ep.qtd_gg ,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'GG', pidpostoavancado => ep.idpostoavancado)  )
                                                   + (nvl(ep.qtd_egg,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'EGG', pidpostoavancado => ep.idpostoavancado) )
                                                   + (nvl(ep.qtd_exgg,0) - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'EXGG', pidpostoavancado => ep.idpostoavancado))
                                                   + (nvl(ep.qtd_u  ,0)  - roman.pck_estoque.fnc_estoquereserva_pa(pidestoquefil => ep.idestoquefil, ptamanho => 'U', pidpostoavancado => ep.idpostoavancado)  ))
                                            from roman.estoquepostoavancado ep
                                            where ep.idestpostoavancado = eep.idestoquepostoavancado
                                              and ep.idestoquefil       = eep.idestoquefilial )
                    where eep.idfilial        = :P0_IDFILIAL
                      and eep.semana          = :P317_SEMANA
                      and eep.idpostoavancado = :P317_IDPOSTOAVANCADO;
                    --
                    commit;
                    --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 3520285171033713
        }
        serverSideCondition {
            type: request=Value
            value: INICIAR
        }
    )

    process zerar-produto (
