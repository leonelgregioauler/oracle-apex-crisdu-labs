    validation qtd-semanas-necessário (
        name: QTD Semanas Necessário
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P603_QTDSEMANASEMABERTO
        }
        error {
            errorMessage: Informe a quantidade de semanas em aberto
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'BUSCAR'
                  and :P603_FILTROS = 'NA'
                ```
        }
    )

    branch (
        name: Go To Page 603
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 603
                items: {
                    P603_IDREPRESENTANTE: &P603_IDREPRESENTANTE.
                    P603_TIPOSEMANA: &P603_TIPOSEMANA.
                    P603_SEMANA: &P603_SEMANA.
                    P603_FILTROS: &P603_FILTROS.
                    P603_VALORPAGO: &P603_VALORPAGO.
                    P603_QTDSEMANASEMABERTO: &P603_QTDSEMANASEMABERTO.
                    P603_VALORSALDO: &P603_VALORSALDO.
                    P603_QTD_ATE: &P603_QTD_ATE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

