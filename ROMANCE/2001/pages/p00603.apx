        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P603_FILTROS (
        type: selectList
        label {
            label: Filtrar Por
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Correção Realizada;CR,Correção de Valores;CV,Notas com Devolução Total;DV,Débitos Deixados na Semana;DS,Valores Baixos de Pagamento;BP,Notas em Aberto;NA,Notas com Débitos;SA,Clientes Inativas da Semana;CA,Notas com 1 Item;NI,Clientes Novas (Acertadas);CN,Acerto Efetuado;AE,Aguardando Atendimento;AA,Aberturas;AB
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P603_IDFILIALROMANCE (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select nome
                     , idfilial
                from vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and pck_util.fnc_verificaacesso(2514,v('APP_USER')) = 'S'
                union
                select nome
                     , idfilial
                from vw_filiais f
                where exists ( select 1
                               from usuariosfiliais u
                               where u.idfilial = f.idfilial
                                 and u.usuario  = v('APP_USER') )
                  and pck_util.fnc_verificaacesso(2514,v('APP_USER')) = 'N'
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P603_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' ('||decode(ativo,'S','ATIVO','INATIVO')||')' display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P603_IDFILIALROMANCE )
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P603_IDFILIALROMANCE
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

