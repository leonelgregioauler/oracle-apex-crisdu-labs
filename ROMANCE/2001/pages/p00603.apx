    dynamicAction correção-realizada (
        name: Correção Realizada
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P603_FILTROS
        }
        clientSideCondition {
            type: item=value
            item: P603_FILTROS
            value: CR
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P603_DATAINICIO
                    P603_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P603_DATAINICIO
                    P603_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

