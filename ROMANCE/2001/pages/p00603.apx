page 603 (
    name: Análise de Atendimento
    title: Análise de Atendimento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region análise-dos-atendimentos (
        name: Análise dos Atendimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , ''||nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = n.semanacobranca ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , n.idnotavenda
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda in (3,4,5)
                  and n.idrepresentante = :P603_IDREPRESENTANTE
                  and :P603_FILTROS = 'CV'
                  and exists ( select 1
                               from correcoesnotasvendas cn
                               where cn.usuario is not null
                                 and cn.idnotavenda = n.idnotavenda
                                 and trunc(cn.datacorrecao) between to_date(:P603_DATAINICIO) and to_date(:P603_DATAFIM)
                                 and cn.usuario != 'OPTIMUS'
                                 and not exists ( select 1
                                                  from usuarios u
                                                  where u.usuario = cn.usuario
                                                    and u.idgerente = 80 ) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , 'Pago Dist.: '||nvl(( select sum(pn.valorpago)
                                             from logroman.log_pagamentosnotasvendas pn
                                             where pn.idnotavenda = n.idnotavenda
                                               and pn.tipoalteracao = 'INSERT'
                                               and pn.usuarioalteracao = 'ROMAN' ),0)||' / Valor atual: '||n.valorpago valorsemana
                     , n.saldo
                     , v.idpessoa
                     , n.idnotavenda
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda in (3,4,5)
                  and n.idrepresentante = :P603_IDREPRESENTANTE
                  and :P603_FILTROS = 'CV' -- correacao de valor
                  and exists ( select 1
                               from logroman.log_pagamentosnotasvendas pn
                               where pn.idnotavenda = n.idnotavenda
                                 and pn.tipoalteracao = 'INSERT'
                                 and pn.usuarioalteracao != 'ROMAN' )
                  and exists ( select 1
                               from correcoesnotasvendas cn
                               where cn.usuario is not null
                                 and cn.idnotavenda = n.idnotavenda
                                 and trunc(cn.datacorrecao) between to_date(:P603_DATAINICIO) and to_date(:P603_DATAFIM)
                                 and cn.usuario != 'OPTIMUS'
                                 and not exists ( select 1
                                                  from usuarios u
                                                  where u.usuario = cn.usuario
                                                    and u.idgerente = 80 ) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , ''||nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P603_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , n.idnotavenda
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 3
                  and n.idrepresentante = :P603_IDREPRESENTANTE
                  and (n.idsemanacobranca - n.idsemanadistribuicao) between :P603_QTDSEMANASEMABERTO + 6 and :P603_QTD_ATE+ 6
                  and :P603_FILTROS = 'NA'
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , ''||nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P603_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , n.idnotavenda
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P603_IDREPRESENTANTE
                  and ( ( :P603_TIPOSEMANA = 'D' and n.semanadistribuicao = :P603_SEMANA )
                     or ( :P603_TIPOSEMANA = 'C' and n.semanacobranca     = :P603_SEMANA ) )
                  and n.valorpago = 0
                  and n.saldo = 0
                  and :P603_FILTROS = 'DV'
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , ''||nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P603_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , n.idnotavenda
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P603_IDREPRESENTANTE
                  and ( ( :P603_TIPOSEMANA = 'D' and n.semanadistribuicao = :P603_SEMANA
                                                 and n.valorpago between 0.01 and to_number(:P603_VALORPAGO) )
                     or ( :P603_TIPOSEMANA = 'C' and n.semanacobranca     = :P603_SEMANA
                                                 and n.valorpago between 0.01 and to_number(:P603_VALORPAGO) )
                     or ( :P603_TIPOSEMANA = 'P' and exists ( select 1
                                                              from pagamentosnotasvendas pg
                                                              where pg.idnotavenda = n.idnotavenda
                                                                and pg.semanacobranca = :P603_SEMANA
                                                                and pg.valorpago between 0.01 and to_number(:P603_VALORPAGO) )))
                  and :P603_FILTROS = 'BP'
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , ''||nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P603_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , n.idnotavenda
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P603_IDREPRESENTANTE
                  and ( ( :P603_TIPOSEMANA = 'D' and n.semanadistribuicao = :P603_SEMANA )
                     or ( :P603_TIPOSEMANA = 'C' and n.semanacobranca     = :P603_SEMANA ) )
                  and n.saldo > 0
                  and :P603_FILTROS = 'DS'
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , ''||nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P603_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , n.idnotavenda
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P603_IDREPRESENTANTE
                  and ( ( :P603_TIPOSEMANA = 'D' and n.semanadistribuicao = :P603_SEMANA )
                     or ( :P603_TIPOSEMANA = 'C' and n.semanacobranca     = :P603_SEMANA ) )
                  and n.saldo > 0
                  and n.saldo <= to_number(:P603_VALORSALDO)
                  and :P603_FILTROS = 'SA'
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , ''||nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P603_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , n.idnotavenda
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P603_IDREPRESENTANTE
                  and ( ( :P603_TIPOSEMANA = 'D' and n.semanadistribuicao = :P603_SEMANA )
                     or ( :P603_TIPOSEMANA = 'C' and n.semanacobranca     = :P603_SEMANA ) )
                  and :P603_FILTROS = 'CA'
                  and v.ativo = 'N'
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , ''||nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P603_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , n.idnotavenda
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda in ( 3 , 4 )
                  and n.idrepresentante = :P603_IDREPRESENTANTE
                  and ( ( :P603_TIPOSEMANA = 'D' and n.semanadistribuicao = :P603_SEMANA )
                     or ( :P603_TIPOSEMANA = 'C' and n.semanacobranca     = :P603_SEMANA ) )
                  and :P603_FILTROS = 'NI'
                  and ( select count(1)
                        from itensnotavenda it
                        where it.idnotavenda = n.idnotavenda ) = 1
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , ''||nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P603_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , n.idnotavenda
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P603_IDREPRESENTANTE
                  and ( ( :P603_TIPOSEMANA = 'D' and n.semanadistribuicao = :P603_SEMANA )
                     or ( :P603_TIPOSEMANA = 'C' and n.semanacobranca     = :P603_SEMANA ) )
                  and :P603_FILTROS = 'CN'
                  and ( select count(1)
                        from notasvendas nv
                        where nv.idvendedora = v.idvendedora
                          and nv.idsituacaonotavenda = 4 ) = 1
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , ''||nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P603_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , n.idnotavenda
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P603_IDREPRESENTANTE
                  and ( ( :P603_TIPOSEMANA = 'D' and n.semanadistribuicao = :P603_SEMANA )
                     or ( :P603_TIPOSEMANA = 'C' and n.semanacobranca     = :P603_SEMANA ) )
                  and :P603_FILTROS = 'AE'
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , ''||nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P603_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , n.idnotavenda
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 3
                  and n.idrepresentante = :P603_IDREPRESENTANTE
                  and ( ( :P603_TIPOSEMANA = 'D' and n.semanadistribuicao = :P603_SEMANA )
                     or ( :P603_TIPOSEMANA = 'C' and n.semanacobranca     = :P603_SEMANA ) )
                  and :P603_FILTROS = 'AA'
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , ''||nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P603_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , n.idnotavenda
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 3
                  and n.idrepresentante = :P603_IDREPRESENTANTE
                  and ( ( :P603_TIPOSEMANA = 'D' and n.semanadistribuicao = :P603_SEMANA )
                     or ( :P603_TIPOSEMANA = 'C' and n.semanacobranca     = :P603_SEMANA ) )
                  and :P603_FILTROS = 'AB'
                  and ( select count(1)
                        from notasvendas nv
                        where nv.idvendedora = v.idvendedora ) = 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5359520418438047121
        }

        column CLIENTE (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column CPF (
            type: plainText
            heading {
                heading: Cpf
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column DATANOTA (
            type: plainText
            heading {
                heading: Data da Nota
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDNOTAVENDA (
            type: link
            heading {
                heading: Ir p/ Nota
                alignment: center
            }
            layout {
                sequence: 170
                columnAlignment: center
            }
            link {
                target: {
                    page: 37
                    items: {
                        P37_IDNOTAVENDA: #IDNOTAVENDA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
