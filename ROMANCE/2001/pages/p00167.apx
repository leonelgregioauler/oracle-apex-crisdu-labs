page 167 (
    name: Baixar Arquivo para Netbook
    title: Baixar Arquivo para Netbook
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region baixar-arquivo-para-netbook (
        name: Baixar Arquivo para Netbook
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P167_ARQUIVO (
        type: fileUpload
        label {
            label: Arquivo
            alignment: right
        }
        display {
            displayAs: nativeFileBrowse
        }
        layout {
            sequence: 30
            region: @baixar-arquivo-para-netbook
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P167_IDEXPORTREPRES (
        type: hidden
        layout {
            sequence: 10
            region: @baixar-arquivo-para-netbook
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDEXPORTREPRES
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P167_IDREPRESENTANTE (
        type: selectList
        label {
            label: Cliente R
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                , idrepresentante return_value
                from representantes
                where idrepresentante = :P167_IDREPRESENTANTE
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @baixar-arquivo-para-netbook
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P167_SEMANACOBRANCA (
        type: displayOnly
        label {
            label: Semanacobranca
            alignment: right
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 40
            region: @baixar-arquivo-para-netbook
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: SEMANACOBRANCA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @baixar-arquivo-para-netbook
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 166
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process fetch-row-from-exportrepresentantes (
        name: Fetch Row from EXPORTREPRESENTANTES
        type: autoRowFetch
        source {
            tableName: EXPORTREPRESENTANTES
            pkColumn: IDEXPORTREPRES
            pkItem: P167_IDEXPORTREPRES
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 540734161178937903
        }
    )

    process process-row-of-exportrepresentantes (
        name: Process Row of EXPORTREPRESENTANTES
        type: autoRowProcessing
        target {
            tableName: EXPORTREPRESENTANTES
            pkColumn: IDEXPORTREPRES
            pkItem: P167_IDEXPORTREPRES
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 540734382519937904
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 540734584827937904
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 167
            }
        }
    )

)

