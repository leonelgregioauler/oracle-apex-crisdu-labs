page 730 (
    name: Relatório de Anotações
    title: Relatório de Anotações
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region anotações-realizadas-distribuidores (
        name: Anotações Realizadas - Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idcorrecaonotavenda
                     , t.idnotavenda
                     , t.datacorrecao "Data Correção"
                     , t.usuario "Usuário"
                     , ( select vw.nome_vendedora
                           from roman.vw_vendedoras vw
                           join notasvendas n on vw.idvendedora = n.idvendedora
                          where n.idnotavenda = t.idnotavenda
                            and rownum = 1 ) "Nome Vendedora"
                     , ( select coalesce(vw.cpf_vendedora, vw.docestrangeiro_vendedora)
                           from roman.vw_vendedoras vw
                           join notasvendas n on vw.idvendedora = n.idvendedora
                          where n.idnotavenda = t.idnotavenda
                            and rownum = 1 ) "Documento Vendedora"
                     , t.motivo  "Motivo"
                     , case t.situacao
                            when 'P' then 'Pendente'
                            when 'R' then 'Rejeitado'
                            when 'C' then 'Corrigido'
                       end "Situação"
                     , pck_romance.fnc_nomerepresentante(t.idrepresentante) "Representante"
                     , ( select n.numeronota 
                           from notasvendas n 
                          where n.idnotavenda = t.idnotavenda ) "Nr Nota"
                 from correcoesnotasvendas t
                where t.usuario in ( select u.usuario
                                       from catal.representantes r
                                          , catal.gerentes g
                                          , catal.usuarios u
                                      where r.idgerente = g.idgerente
                                        and r.idpessoa = u.idpessoa 
                                        and r.idrepresentante = t.idrepresentante
                                        and g.idfilial = :P730_IDFILIAL )
                  and extract(year from t.datacorrecao ) >= 2018
                  and ( :P730_DE is null or trunc(t.datacorrecao) between to_date(:P730_DE,'dd/mm/rrrr') and to_date(:P730_ATE,'dd/mm/rrrr'))
                  and ( :P730_SITUACAO is null or t.situacao = :P730_SITUACAO )
                  and ( :P730_IDREPRESENTANTE is null or t.idrepresentante = :P730_IDREPRESENTANTE)
                  and ( :P730_NOTA is null or :P730_NOTA = ( select n.numeronota 
                                                               from notasvendas n 
                                                              where n.idnotavenda = t.idnotavenda ))
                  and  :P730_ORIGEM = 'D'
                  and :P730_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P730_ORIGEM
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2434307475062208114
        }

