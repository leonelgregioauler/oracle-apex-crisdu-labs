    dynamicAction mostra-dist (
        name: mostra Dist
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: items
            items: P730_ORIGEM
        }
        clientSideCondition {
            type: item=value
            item: P730_ORIGEM
            value: D
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P730_IDREPRESENTANTE
            }
            execution {
