    pageItem P730_FILTRAR (
        type: hidden
        layout {
            sequence: 120
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P730_IDFILIAL (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select fl.nome
                     , fl.idfilial
                from vw_filiais fl
                where fl.tipofilial = 'D'
                  and fl.idfilial in ( select uf.idfilial
                                       from usuariosfiliais uf
                                       where uf.usuario = v('APP_USER'))
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P730_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||decode(r.ativo,'S','Ativo','N','Inativo')||') - '||r.idrepresentante display_value
                     , r.idrepresentante
                from representantes r
                where pck_romance.fnc_filialgerente(pidgerente => r.idgerente) = :P730_IDFILIAL
                 -- and r.ativo  = 'S'
                order by 1 
                ```
            displayExtraValues: false
            nullDisplayValue: "- Todos - "
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

