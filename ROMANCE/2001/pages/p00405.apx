page 405 (
    name: Análise de Indicação
    title: Análise de Indicação
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }

    region análise-de-indicação (
        name: Análise de Indicação
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "IDCONTROLECONTATOSSITE"
                     , "DATACADASTRO"
                     , "NOMECOMPLETO"
                     , "CPF"
                     , "FONE"
                     , situacao
                     , origem
                     , idfilial
                     , "IDREPRESENTANTE"
                     , "DATALIBERADOFILIAL"
                     , "DATAPASSADOREPRES"
                     , "USUARIOLIBEROUREPRES"
                     , "DATAULTIMAATUALIZACAO"
                from controlecontatossite c
                where replace(replace(replace(c.cpf,'.',''),'-',''),' ','') = replace(replace(replace(:P405_DOCUMENTO,'.',''),'-',''),' ','')
                  and c.idfilial is not null
                  and c.idrepresentante is not null
                  and c.situacao not in ('G','R')
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 300
        }
        advanced {
            savedReportMappingIdentifier: 8643600097387672112
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    show: false
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDCONTROLECONTATOSSITE
                layout {
                    width: 104
                    sequence: 3
                }
            )

            displayColumn (
                column: @DATACADASTRO
                layout {
                    width: 135
                    sequence: 4
                }
            )

            displayColumn (
                column: @NOMECOMPLETO
                layout {
                    width: 151
                    sequence: 5
                }
            )

            displayColumn (
                column: @CPF
                layout {
                    width: 106
                    sequence: 6
                }
            )

            displayColumn (
                column: @FONE
                layout {
                    show: false
                    sequence: 6
                }
            )

            displayColumn (
                column: @SITUACAO
                layout {
                    width: 92
                    sequence: 10
                }
            )

            displayColumn (
                column: @ORIGEM
                layout {
                    width: 110
                    sequence: 11
                }
            )

            displayColumn (
                column: @IDFILIAL
                layout {
                    width: 101
                    sequence: 12
                }
            )

            displayColumn (
                column: @IDREPRESENTANTE
                layout {
                    width: 180
                    sequence: 13
                }
            )

            displayColumn (
                column: @DATALIBERADOFILIAL
                layout {
                    width: 138
                    sequence: 14
                }
            )

            displayColumn (
                column: @DATAPASSADOREPRES
                layout {
                    width: 162
                    sequence: 15
                }
            )

            displayColumn (
                column: @USUARIOLIBEROUREPRES
                layout {
                    sequence: 15
                }
            )

            displayColumn (
                column: @DATAULTIMAATUALIZACAO
                layout {
                    sequence: 16
                }
            )

            sort (
                column: @IDCONTROLECONTATOSSITE
                sort {
                    nulls: last
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CPF (
            type: textField
            heading {
                heading: CPF
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            validation {
                maxLength: 15
            }
            source {
                databaseColumn: CPF
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DATACADASTRO (
            type: datePickerJquery
            heading {
                heading: Cadastrado
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
                width: 15
            }
            source {
                databaseColumn: DATACADASTRO
                dataType: date
                queryOnly: true
            }
        )

        column DATALIBERADOFILIAL (
            type: datePickerJquery
            heading {
                heading: Liberado em
                alignment: center
            }
            layout {
                sequence: 150
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
                width: 15
            }
            source {
                databaseColumn: DATALIBERADOFILIAL
                dataType: date
                queryOnly: true
            }
        )

        column DATAPASSADOREPRES (
            type: datePickerJquery
            heading {
                heading: Passado ao Dist.
                alignment: center
            }
            layout {
                sequence: 160
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
                width: 15
            }
            source {
                databaseColumn: DATAPASSADOREPRES
                dataType: date
                queryOnly: true
            }
        )

        column DATAULTIMAATUALIZACAO (
            type: datePickerJquery
            heading {
                heading: Ultima Atualização
                alignment: center
            }
            layout {
                sequence: 180
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR hh24:MI:SS
                width: 15
            }
            source {
                databaseColumn: DATAULTIMAATUALIZACAO
                dataType: date
                queryOnly: true
            }
        )

        column FONE (
            type: textField
            heading {
                heading: Fone
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            appearance {
                width: 10
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: FONE
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDCONTROLECONTATOSSITE (
            type: numberField
            heading {
                heading: Protocolo
            }
            settings {
                virtualKeyboard: text
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                width: 6
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDCONTROLECONTATOSSITE
                dataType: number
                queryOnly: true
            }
            columnFilter {
                lovType: none
            }
        )

        column IDFILIAL (
            type: selectList
            heading {
                heading: Empresa
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome
                         , idfilial
                    from vw_filiais f
                    where f.tipofilial = 'D'
                      and f.ativo = 'S'
                    ```
            }
            layout {
                sequence: 130
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDREPRESENTANTE (
            type: selectList
            heading {
                heading: Distribuidor
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomerepresentante(idrepresentante)||' ('||decode(r.ativo,'S','Ativo','N','Inativo')||')'  display_value
                         , idrepresentante return_value
                    from representantes r
                    where r.idgerente = ( select idgerente
                                          from gerentes g
                                          where g.idfilial = :IDFILIAL )
                    order by 1
                    ```
                nullDisplayValue: - Selecione o Distribuidor -
            }
            cascadingLov {
                parentColumns: IDFILIAL
            }
            layout {
                sequence: 140
                columnAlignment: end
            }
            source {
                databaseColumn: IDREPRESENTANTE
                dataType: number
            }
        )

        column NOMECOMPLETO (
            type: textarea
            heading {
                heading: Nome
            }
            layout {
                sequence: 60
            }
            appearance {
                width: 30
            }
            validation {
                maxLength: 200
            }
            source {
                databaseColumn: NOMECOMPLETO
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column ORIGEM (
            type: selectList
            heading {
                heading: Origem
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select origem
                         , idorigemsac
                    from origemsac
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 120
            }
            source {
                databaseColumn: ORIGEM
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SITUACAO (
            type: selectList
            heading {
                heading: Situação
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select descricao
                         , s.idsituacao
                    from situacoessac s
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 110
            }
            source {
                databaseColumn: SITUACAO
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            readOnly {
                type: always
            }
        )

        column USUARIOLIBEROUREPRES (
            type: textField
            heading {
                heading: Liberado Por
                alignment: center
            }
            layout {
                sequence: 170
            }
            appearance {
                width: 15
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: USUARIOLIBEROUREPRES
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

    )

    pageItem P405_DOCUMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @análise-de-indicação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P405_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @análise-de-indicação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button confirmar-envio (
        buttonName: CONFIRMAR_ENVIO
        label: Confirmar Envio
        layout {
            sequence: 10
            region: @análise-de-indicação
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process confirma-envio (
        name: Confirma Envio
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidprotocolo  number;
                  vidrepresentante number;
                  vidusuario number;
                  --
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  select c.idcontrolecontatossite
                       , c.idrepresentante
                  into vidprotocolo
                     , vidrepresentante
                  from controlecontatossite c
                  where replace(replace(replace(c.cpf,'.',''),'-',''),' ','') = replace(replace(replace(:P405_DOCUMENTO,'.',''),'-',''),' ','')
                    and c.idfilial is not null
                    and c.idrepresentante is not null
                    and rownum = 1;
                  --
                  favorita.pck_sac_fav.prc_encaminhaindicacaoauto( pidcontrolecontatossite => vidprotocolo,
                                                                   pidrepresentante => vidrepresentante,
                                                                   pidusuario => vidusuario );
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Envio Confirmado!
        }
        advanced {
            executionMappingIdentifier: 5197227891618429533
        }
        serverSideCondition {
            whenButtonPressed: @confirmar-envio
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @análise-de-indicação
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3576930397839056592
        }
    )

    branch (
        name: Go To Page 405
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 405
                items: {
                    P405_DOCUMENTO: &P405_DOCUMENTO.
                    P405_IDFILIAL: &P405_IDFILIAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @confirmar-envio
        }
    )

)

