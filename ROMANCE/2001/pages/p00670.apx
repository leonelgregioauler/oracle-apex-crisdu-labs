page 670 (
    name: Aproveitamento Detalhado
    title: Aproveitamento Detalhado
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region aproveitamento-detalhado (
        name: Aproveitamento Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomevendedora(nv.idvendedora) Consultora
                      ,decode((select v.ativo
                              from catal.vendedoras v
                              where nv.idvendedora = v.idvendedora),'S','Ativo','Inativo') SITUACAO
                      ,nv.numeronota
                      ,nv.datanota
                      ,nv.dataacerto
                      ,nv.semanadistribuicao
                      ,nv.semanacobranca
                      ,nv.valortotalnota
                      ,nv.valortotaldevolucao
                      ,nv.valortotalvenda
                      ,round( ((nv.valortotalvenda) / (nv.valortotalnota)) * 100,2) perc_Sacola
                      , nv.saldo
                      , nv.valorpago
                from roman.notasvendas nv
                where nv.semanacobranca = :P670_SEMANA
                  and nv.idsituacaonotavenda = 4
                  and nv.idrepresentante = :P670_IDREPRESENTANTE
                order by 4
                ```
        }
        layout {
            sequence: 10
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 102843675516747403
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

