    process gerar-produtos-nos-estoques (
        name: Gerar produtos nos estoques
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  for a in ( select *
                             from vw_filiais w
                             where tipofilial = 'D' 
                               and ativo = 'S') 
                  loop
                    --
                    begin
                      insert into estoquefilial ( idestoquefilial, idfilial, idproduto, ativo, comissao,vlrvenda)
                      values ( seq_idestoquefil.nextval,a.idfilial, :P186_IDPRODUTO,'N',:P186_COMISSAO, to_number(:P186_PRECOVENDA,'999G999G990D00'));
                    exception
                      when others then
                        null;
                    end;
                    --
                  end loop;
                  --
                end;
                
                begin
                  -- Call the procedure
                  pck_estoque.prc_geraprodutosestoques(pidproduto => :P186_IDPRODUTO,
                                                       pcomissao => :P186_COMISSAO,
                                                       pvlrvenda => to_number(:P186_PRECOVENDA,'999G999G990D00'))  ;
                end;
                
                ```
        }
        execution {
            sequence: 110
        }
        successMessage {
            successMessage: Registros gerados com sucesso!
        }
        advanced {
            executionMappingIdentifier: 32683655179979550
        }
        serverSideCondition {
            type: never
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vcodcategoria  varchar2(10);
                  vidcategoria   number := :P186_IDCATEGORIA;
                  vcont          number := 0;
                  --
                begin 
                  --
                  select SEQ_IDPRODUTO.nextval 
                  into :P186_IDPRODUTO
                  from dual;
                  --
                  :P186_DTINCLUSAO := sysdate;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 32681168488979549
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process nome-produto (
        name: nome produto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                  --
                  select pck_romance.TiraAcento(
                                              decode(:P186_KIT,'S','Kit ') 
                                           ||  pck_romance_2.fnc_nomecategoria(:P186_IDCATEGORIA) ||' '
                                           || decode(:P186_IDCARACTERISTICADETALHE, null, null
                                                                                    , pck_romance_2.fnc_nomecaracteristica(:P186_IDCARACTERISTICADETALHE)||' ')
                                           || decode(:P186_ADULTOINFANTIL,'I','Infantil ') 
                                           || :P186_NOMEPROPRIO||' '
                                           || pck_romance_2.fnc_nomecaracteristica(:P186_IDCARACTERISTICACATEGMAT))
                  into :P186_NOMEPRODUTO
                  from dual;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 32681995017979549
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P186_NOMEPRODUTO is null
                  and :P186_VENDA = 'S'
                ```
        }
    )

