    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 40
            region: @fornecedores
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 20
            region: @cadastro-de-produtos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 184
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 50
            region: @cadastro-de-produtos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P186_IDPRODUTO
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 30
            region: @cadastro-de-produtos
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button gerarprecosparafiliais (
        buttonName: GERARPRECOSPARAFILIAIS
        label: Gerar Preços Para Filais
        layout {
            sequence: 70
            region: @cadastro-de-produtos
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P186_IDPRODUTO is not null
                and :P186_PRECOVENDA is not null
                and :P186_COMISSAO is not null
                ```
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @fornecedores
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
