    validation p186-nomeproduto (
        name: P186_NOMEPRODUTO
        execution {
            sequence: 70
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from produtos
                where NOMEPRODUTO = :P186_NOMEPRODUTO
                ```
        }
        error {
            errorMessage: Este produto já está cadastrado!
            displayLocation: inlineInNotification
            associatedItem: @P186_NOMEPRODUTO
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

