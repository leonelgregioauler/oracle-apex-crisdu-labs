    process referencia (
        name: referencia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 16/03/2012 by EVERTON 
                declare 
                  -- Local variables here
                  i integer;
                  vcodcategoria  varchar2(10);
                  vcodproduto    varchar2(10);
                  vidcategoria   number := v('P186_IDCATEGORIA');
                begin
                  -- Test statements here
                  select c.referencia
                  into vcodcategoria
                  from categorias c
                  where c.idcategoria  = vidcategoria;
                  --
                  select max( to_number(p.codigosisdist) )+1
                  into vcodproduto
                  from produtos p
                  where substr(codigosisdist,1,2) = vcodcategoria;-- idcategoria = vidcategoria;
                  --
                  :P186_CODIGOSISDIST := vcodproduto;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 32681594023979549
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P186_CODIGOSISDIST IS NULL
                  and :P186_IDCATEGORIA IS NOT NULL
                ```
        }
    )

