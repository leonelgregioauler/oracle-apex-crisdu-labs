page 186 (
    name: Cadastro de Produtos
    title: Cadastro de Produtos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_popup_prod()
            {vid = document.getElementById("P11_IDPRODUTO").value;
            vjanela = window.open('f?p=&APP_ID.:289:&SESSION.::NO::P289_IDPRODUTO:'+vid ,'PRECOS', 'toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=600,height=800,left=150,top=100','_blank');
            vjanela.focus();
             void(0);
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region cadastro-de-produtos (
        name: Cadastro de Produtos
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    region fornecedores (
        name: Fornecedores
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDFORNECEDORPRODUTO",
                "IDFORNECEDORPRODUTO" IDFORNECEDORPRODUTO_DISPLAY,
                "IDFORNECEDOR",
                "IDPRODUTO",
                precocusto
                , observacao
                from "#OWNER#"."FORNECEDORESPRODUTOS"
                where idproduto = :P186_IDPRODUTO
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (nulo)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Dados não encontrados.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Selecionar Linha
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDFORNECEDOR (
            reportColumnQueryId: 4
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Fornecedor
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomepessoa(f.idpessoa) display_value
                         , f.idfornecedor return_value
                    from fornecedores f
                    where f.ativo = 'S'
                    order by 1
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 30
            }
        )

        column IDFORNECEDORPRODUTO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDFORNECPRODUTOS
            }
        )

        column IDFORNECEDORPRODUTO_DISPLAY (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column IDPRODUTO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 5
            }
            default {
                type: item
                item: P11_IDPRODUTO
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 7
            derivedColumn: N
            type: textField
            heading {
                heading: Observação
            }
            layout {
                sequence: 7
            }
            appearance {
                width: 100
            }
        )

        column PRECOCUSTO (
            reportColumnQueryId: 6
            derivedColumn: N
            type: textField
            heading {
                heading: Preço Custo
                alignment: center
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: 999G999G999G999G990D00
                width: 8
            }
            advanced {
                customAttributes: style="text-align: right;"
            }
        )

    )

