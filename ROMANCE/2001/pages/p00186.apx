    pageItem P186_SUGESTÃO (
        type: displayOnly
        label {
            label: Sugestão
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 180
            region: @cadastro-de-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select decode(p.kit,'S','Kit ') 
                     ||/* decode(p.idcaracteristicadetalhe, null, pck_romance_2.fnc_nomecategoria(idcategoria) ||' '
                                                              , pck_romance_2.fnc_nomecaracteristica(pidcaracteristicacateg => p.idcaracteristicadetalhe)||' ')*/
                        pck_romance.fnc_nomecategoria(idcategoria)                                              ||' '
                     || decode(p.IDCARACTERISTICADETALHE, null, null
                                                            , pck_romance.fnc_nomecaracteristica(pidcaracteristicacateg => p.IDCARACTERISTICADETALHE)||' ')
                     || decode(p.adultoinfantil,'I','Infantil ') 
                     || p.nomeproprio||' '
                     || pck_romance.fnc_nomecaracteristica(pidcaracteristicacateg => p.idcaracteristicacategmat) sugestao
                from produtos p
                where idproduto = :P186_IDPRODUTO
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

