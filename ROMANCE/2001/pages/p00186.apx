    dynamicAction venda-sim-ou-não (
        name: Venda sim ou não
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P186_VENDA
        }
        clientSideCondition {
            type: item=value
            item: P186_VENDA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P186_KIT
                    P186_IDCATEGORIA
                    P186_IDCARACTERISTICADETALHE
                    P186_IDCARACTERISTICACATEG
                    P186_ADULTOINFANTIL
                    P186_NOMEPROPRIO
                    P186_IDCARACTERISTICACATEGMAT
                    P186_SUGESTÃO
                    P186_CODIGOSISDIST
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P186_KIT
                    P186_IDCATEGORIA
                    P186_IDCARACTERISTICADETALHE
                    P186_IDCARACTERISTICACATEG
                    P186_ADULTOINFANTIL
                    P186_NOMEPROPRIO
                    P186_IDCARACTERISTICACATEGMAT
                    P186_SUGESTÃO
                    P186_CODIGOSISDIST
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    validation idfornecedor-must-be-numeric (
