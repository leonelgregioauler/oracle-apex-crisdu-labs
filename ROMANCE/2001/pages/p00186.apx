    button precosvenda (
        buttonName: PRECOSVENDA
        label: Ver Preços de Venda
        layout {
            sequence: 60
            region: @cadastro-de-produtos
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 193
                items: {
                    P193_IDPRODUTO: &P186_IDPRODUTO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from estoquefilial
                where idproduto = :P186_IDPRODUTO
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 40
            region: @cadastro-de-produtos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P186_IDPRODUTO
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @fornecedores
