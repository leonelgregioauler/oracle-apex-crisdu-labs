    pageItem P186_IDCARACTERISTICACATEG (
        type: selectList
        label {
            label: Característica
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , c.idcaracteristicacateg
                from caracteristicascategorias c
                where idcategoria = :P186_IDCATEGORIA
                  and tipo = 'C'
                ORDER BY NOME
                
                ```
