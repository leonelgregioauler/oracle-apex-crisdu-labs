page 487 (
    name: Devolução Veio de Outros Detalhada
    title: Devolução Veio de Outros Detalhada
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region itens-devolvidos (
        name: Itens Devolvidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeprodutoestoque(it.idestoquefil) produto
                     , sum(it.qtddevolvida)
                     , it.valorvenda
                     , sum(it.qtddevolvida*it.valorvenda) total
                     , pck_romance.fnc_nomerepresentante(nv.idrepresentante) origem
                from notasvendas nv
                   , itensnotavenda it
                   , representantes r
                where r.idrepresentante         = :P487_IDREPRESENTANTE
                  and nv.idsemanacobranca      >= r.idsemanabalanco
                  and it.idnotavenda            = nv.idnotavenda
                  and nv.idrepresentante       != r.idrepresentante
                  and nv.idrepresentanteacertou = r.idrepresentante
                  and it.comissao               = :P487_COMISSAO
                  and it.qtddevolvida           > 0
                group by idestoquefil, it.valorvenda, nv.idrepresentante
                order by 1
                ```
            pageItemsToSubmit: [
                P487_IDREPRESENTANTE
                P487_COMISSAO
            ]
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma informação encontrada.
        }
        advanced {
            savedReportMappingIdentifier: 3122923069645380541
        }

        column ORIGEM (
            type: plainText
            heading {
                heading: Origem
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

