    region relação-de-notas (
        name: Relação de Notas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.numeronota
                     , nv.datanota
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.dataacerto
                     , pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor_origem
                from notasvendas nv
                   , itensnotavenda it
                   , representantes r
                where r.idrepresentante         = :P487_IDREPRESENTANTE
                  and nv.idsemanacobranca      >= r.idsemanabalanco
                  and it.idnotavenda            = nv.idnotavenda
                  and nv.idrepresentante       != r.idrepresentante
                  and nv.idrepresentanteacertou = r.idrepresentante
                  and it.comissao               = :P487_COMISSAO
                  and it.qtddevolvida           > 0
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
