    process deleta-débito-diverso (
        name: Deleta Débito Diverso
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  
                  viddebitodiverso number := :P695_ID;
                  vidvendedora number;
                  vdescricao varchar2(4000);
                  vdataemissao date;
                  vdatavencimento date;
                  vvalortotal number;
                  vvalorpago number;
                  vsaldo number;
                  vmd5 varchar2(4000);
                  voperacao_dml varchar2(1);
                  
                begin
                
                  if v('REQUEST') = 'REPROVAR' then 
                   voperacao_dml := 'D';
                  end if;
                
                  roman.pck_gestaoderisco_rmc.prc_debitosdiversos(piddebitodiverso => viddebitodiverso,
                                                                  pidvendedora     => vidvendedora,
                                                                  pdescricao       => vdescricao,
                                                                  pdataemissao     => vdataemissao,
                                                                  pdatavencimento  => vdatavencimento,
                                                                  pvalortotal      => vvalortotal,
                                                                  pvalorpago       => vvalorpago,
                                                                  psaldo           => vsaldo,
                                                                  pmd5             => vmd5,
                                                                  poperacao_dml    => voperacao_dml);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1506880501618806917
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('REPROVAR')
        }
    )

)

