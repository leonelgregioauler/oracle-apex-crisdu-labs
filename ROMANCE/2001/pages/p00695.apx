page 695 (
    name: Relatório de Débitos Diversos
    title: Inclusão de Débitos Diversos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            
            function deletadebito(pid){ 
            
              document.getElementById('P695_ID').value = pid;
                
              var answer = confirm("Deseja Remover esse Débito?")
              if (answer)
                {
                  apex.submit('REPROVAR');
                }
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-de-débitos-diversos (
        name: Relatório de Débitos Diversos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomevendedora(dd.idvendedora) nomecliente
                     , roman.pck_romance.fnc_cpfvendedora(dd.idvendedora) cpf
                     , dd.dataemissao datainserido
                     , dd.datavencimento datavencimento
                     , nvl(dd.valortotal,0) valortotal
                     , nvl(dd.valorpago,0) valorpago
                     , nvl(dd.saldo,0) saldo
                     , dd.descricao observacao
                     , dd.iddebitodiverso
                     , '<a href=javascript:deletadebito('||dd.iddebitodiverso||');><img src="#APP_IMAGES#excluir.png" alt=""/></a>' deletadebito
                from roman.debitosdiversos dd
                where (:P695_IDVENDEDORA is null or dd.idvendedora = :P695_IDVENDEDORA)
                  and (:P695_TIPODATA = 'D' and trunc(dd.dataemissao) between :P695_DATAINICIO and :P695_DATAFIM
                    or :P695_TIPODATA = 'V' and dd.datavencimento between :P695_DATAINICIO and :P695_DATAFIM)
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
