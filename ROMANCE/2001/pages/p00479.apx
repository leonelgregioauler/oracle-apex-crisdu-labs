page 479 (
    name: Cadastro de Judicialização de Promissórias
    title: Cadastro de Judicialização de Promissórias
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-judicialização-de-promissórias (
        name: Cadastro de Judicialização de Promissórias
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P479_DATAINICIO (
        type: datePickerJquery
        label {
            label: Data de Início
            alignment: left
        }
        layout {
            sequence: 50
            region: @cadastro-de-judicialização-de-promissórias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P479_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(u.idfilial) display_value
                     , u.idfilial return_value
                from usuariosfiliais u
                where u.usuario = v('APP_USER')
                order by 1
                
                ```
        }
        layout {
            sequence: 20
            region: @cadastro-de-judicialização-de-promissórias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P479_IDPROMISSORIAJUDICIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-judicialização-de-promissórias
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P479_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' ('||decode(ativo,'S','Ativo','N','Inativo')||')' display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P479_IDFILIAL)
                order by 1  
                ```
        }
        cascadingLov {
            parentItems: P479_IDFILIAL
        }
        layout {
            sequence: 30
            region: @cadastro-de-judicialização-de-promissórias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P479_IDSITUACAOJUDICIAL (
        type: selectList
        label {
            label: Situação Jud.
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao d
                     , idsituacaojudicial r
                from situacoesjudiciais 
                ```
        }
        layout {
            sequence: 60
            region: @cadastro-de-judicialização-de-promissórias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P479_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' - '||nvl(documentoestrangeiro,cpf) display_value
                     , idvendedora return_value
                from pessoas p
                   , vendedoras v
                where v.idpessoa = p.idpessoa
                  and ( :P479_IDFILIAL is null or v.idfilial = :P479_IDFILIAL )
                  and ( :P479_IDREPRESENTANTE is null or v.idrepresentante = :P479_IDREPRESENTANTE )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: [
                P479_IDFILIAL
                P479_IDREPRESENTANTE
            ]
        }
        layout {
            sequence: 40
            region: @cadastro-de-judicialização-de-promissórias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P479_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @cadastro-de-judicialização-de-promissórias
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @cadastro-de-judicialização-de-promissórias
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P479_IDPROMISSORIAJUDICIAL
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @cadastro-de-judicialização-de-promissórias
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P479_IDPROMISSORIAJUDICIAL
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 10
            region: @cadastro-de-judicialização-de-promissórias
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P479_IDPROMISSORIAJUDICIAL
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @cadastro-de-judicialização-de-promissórias
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 478
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-em-promissorias-judiciais (
        name: Consulta em Promissorias Judiciais
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_PROMISSORIASJUDICIAIS( PIDPROMISSORIAJUDICIAL => :P479_IDPROMISSORIAJUDICIAL,
                                                               PIDFILIAL => :P479_IDFILIAL,
                                                               PIDREPRESENTANTE => :P479_IDREPRESENTANTE,
                                                               PIDVENDEDORA => :P479_IDVENDEDORA,
                                                               PDATAINICIO => :P479_DATAINICIO,
                                                               PIDSITUACAOJUDICIAL => :P479_IDSITUACAOJUDICIAL,
                                                               PMD5 => :P479_MD5,
                                                               POPERACAO_DML => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1539416517344078418
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CREATE','SAVE','DELETE')
                ```
        }
    )

    process processo-dml-em-promissorias-judiciais (
        name: Processo DML em Promissorias Judiciais
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'CREATE' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SAVE' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETE' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  PCK_CADASTROS_RMC.PRC_PROMISSORIASJUDICIAIS( PIDPROMISSORIAJUDICIAL => :P479_IDPROMISSORIAJUDICIAL,
                                                               PIDFILIAL => :P479_IDFILIAL,
                                                               PIDREPRESENTANTE => :P479_IDREPRESENTANTE,
                                                               PIDVENDEDORA => :P479_IDVENDEDORA,
                                                               PDATAINICIO => :P479_DATAINICIO,
                                                               PIDSITUACAOJUDICIAL => :P479_IDSITUACAOJUDICIAL,
                                                               PMD5 => :P479_MD5,
                                                               POPERACAO_DML => VOPERACAO_DML);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1539441308879201268
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 479
                items: {
                    P479_IDPROMISSORIAJUDICIAL:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETE
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 479
                items: {
                    P479_IDPROMISSORIAJUDICIAL: &P479_IDPROMISSORIAJUDICIAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where v('REQUEST') in ('SAVE','CREATE')
                ```
        }
    )

)

