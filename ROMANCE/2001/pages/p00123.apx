page 123 (
    name: Entrada de Estoque
    title: Entrada de Estoque
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            
            function  confirmaproduto(event)
            { 
              var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            
              if (tecla==13)
                {
            		apex.submit('CREATE');
                }
            }
            
            ```
    }
    css {
        inline: ".t-Region-body { background-color: Beige !important;}"
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

