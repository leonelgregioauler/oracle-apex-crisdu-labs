    pageItem P123_IDESTOQUEFIL (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto) display_value
                     , e.idestoquefilial
                from estoquefilial e
                   , produtos      p
                where e.idfilial = :P0_IDFILIAL
                  and e.idproduto = p.idproduto
                  and p.codigosisdist = SUBSTR(:P123_CODIGO,1,5)
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P123_CODIGO
        }
        layout {
            sequence: 50
            region: @entrada-de-estoque
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDESTOQUEFIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

