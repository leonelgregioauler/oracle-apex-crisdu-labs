        }
    )

    dynamicAction foco (
        name: Foco
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P123_CODIGO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-pesquisa (
        name: Tipo Pesquisa
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P123_OPCAO
        }
        clientSideCondition {
            type: item=value
            item: P123_OPCAO
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P123_CODIGO
                    P123_IDESTOQUEFIL
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P123_IDPRODUTO2
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: P123_IDPRODUTO2
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value-2 (
            action: setValue
            affectedElements {
                selectionType: items
                items: [
                    P123_IDESTOQUEFIL
                    P123_CODIGO
                ]
            }
            execution {
                sequence: 40
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P123_CODIGO
                    P123_IDESTOQUEFIL
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P123_IDPRODUTO2
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

    )

    validation quantidade-movimentada (
        name: Quantidade movimentada >= 50
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where  nvl(to_number(:P123_QTD_PP),0)
                     + nvl(to_number(:P123_QTD_P),0)
                     + nvl(to_number(:P123_QTD_M),0) 
                     + nvl(to_number(:P123_QTD_G),0) 
                     + nvl(to_number(:P123_QTD_GG),0) 
                     + nvl(to_number(:P123_QTD_EGG),0) 
                     + nvl(to_number(:P123_QTD_EXGG),0) 
                     + nvl(to_number(:P123_QTD_U),0) >= 50
                ```
        }
        error {
            errorMessage: Quantidade não permitida para movimentar o estoque! Registre um evento explicando o motivo dessa quantidade e solicitando liberação!
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2401,v('APP_USER')) = 'N'
                ```
        }
    )

    validation valida-quantidade (
        name: Valida quantidade
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(:P123_QTD_PP) >= 0
                  or to_number(:P123_QTD_P) >= 0
                  or to_number(:P123_QTD_M) >= 0
                  or to_number(:P123_QTD_G) >= 0
                  or to_number(:P123_QTD_GG) >= 0
                  or to_number(:P123_QTD_EGG) >= 0
                  or to_number(:P123_QTD_EXGG) >= 0
                  or to_number(:P123_QTD_U) >= 0
                ```
        }
        error {
            errorMessage: Informe uma quantidade válida!
        }
    )

    process fetch-row-from-movimentosestoquepostoavan (
        name: Fetch Row from MOVIMENTOSESTOQUEPOSTOAVAN
        type: autoRowFetch
        source {
            tableName: MOVIMENTOSESTOQUEPOSTOAVAN
            pkColumn: IDMOVTOESTPOSTOAVAN
            pkItem: P123_IDMOVTOESTPOSTOAVAN
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 228939285432755232
        }
        serverSideCondition {
            type: never
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P123_IDMOVTOESTPOSTOAVAN is null then
                        select "SEQ_IDMOVTOESTPOSTOAVANCADO".nextval
                          into :P123_IDMOVTOESTPOSTOAVAN
                          from dual;
                    end if;
                    --    
                    if :P123_OPCAO = 'P' then
                      :P123_IDESTOQUEFIL := :P123_IDPRODUTO2;
                    end if;
                    --
                    begin
                        select e.idestpostoavancado
                        into :P123_IDESTOQUEPOSTOAVANCADO
                        from estoquepostoavancado e
                        where e.idpostoavancado  = :P123_IDPOSTOAVANCADO
                          and idestoquefil       = :P123_IDESTOQUEFIL;
                    exception
                      when others then
                         SELECT seq_idestoquepostoavan.nextval
                         INTO :P123_IDESTOQUEPOSTOAVANCADO
                         from dual;
                         --
                         insert into estoquepostoavancado ( idestpostoavancado    , idpostoavancado    , idestoquefil
                                                          , qtd_pp             , qtd_p
                                                          , qtd_m                 , qtd_g              , qtd_gg
                                                          , qtd_egg               , qtd_u )
                         values ( :P123_IDESTOQUEPOSTOAVANCADO     , :P123_IDPOSTOAVANCADO     , :P123_IDESTOQUEFIL
                                , 0                                , 0             
                                , 0                         , 0               , 0
                                , 0                       , 0 );
                    END;
                    --
                    :P123_OBSERVACAO := 'Entrada Manual. '||:P123_OBSERVACAO;
                    --
                EXCEPTION
                  when others then
                     null;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 228939455529755237
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-movimentosestoquepostoavan (
        name: Process Row of MOVIMENTOSESTOQUEPOSTOAVAN
        type: autoRowProcessing
        target {
            tableName: MOVIMENTOSESTOQUEPOSTOAVAN
            pkColumn: IDMOVTOESTPOSTOAVAN
            pkItem: P123_IDMOVTOESTPOSTOAVAN
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 228939664071755237
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 228939874510755237
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 123
                items: {
                    P123_IDPOSTOAVANCADO: &P123_IDPOSTOAVANCADO.
                }
            }
        }
    )

)

