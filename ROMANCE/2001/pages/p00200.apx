page 200 (
    name: Itens Vendidos na Semana
    title: Itens Vendidos na Semana
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 80%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region itens-vendidos-na-semana (
        name: Itens Vendidos na Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) represente
                     , t.semanacobranca
                     , produto
                     , sum(distribuido) distribuido
                     , sum(vendido) vendido
                     , decode( (sum(distribuido)-sum(qtddevolvida) ), 0 , 0
                                                                       , round(( (  sum(distribuido) - sum(qtddevolvida)) * 100  /  sum(distribuido) ),2)) percvenda
                     , sum(t.valordistribuido) valordistribuido
                     , sum(t.valorvendido) valorvendido 
                     , t.desconto
                     , ( select p.codigosisdist
                         from produtos p
                            , estoquefilial e
                         where e.idestoquefilial = t.idestoquefil
                           and e.idproduto = p.idproduto ) referencia
                from vw_percvendaprodutos t
                where idrepresentante  = :P200_IDREPRESENTANTE
                  and t.semanacobranca = :P200_SEMANACOBRANCA
                group by idrepresentante
                       , t.semanacobranca
                       , produto
                       , idestoquefil
                       , t.desconto
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 350018612229045098
        }

