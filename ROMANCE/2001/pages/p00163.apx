page 163 (
    name: Importar Arquivo
    title: Importar Arquivo
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function executar()
            {
             document.getElementById('loading').style.display="block";
              apex.submit('SYNC');
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region importar-arquivo (
        name: Importar Arquivo
        type: staticContent
        source {
            htmlCode:
                ```html
                <div id="loading" style="position:absolute; width:100%; text-align:center; top:300px; display:none;" >
                  <img src="http://romance.dyndns.tv:8888/apex/wwv_flow_file_mgr.get_file?p_security_group_id=1000002&p_fname=m2brloading3.gif" border=0>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
    )

    region page_plug (
        name: " "
        type: staticContent
        source {
            htmlCode: "<a href=\"http://romance.dyndns.tv:8888/apex/f?p=110\">Clique aqui</a> para acessar a versão nova de integração. "
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
    )

    pageItem P163_ARQUIVO (
        type: fileUpload
        label {
            label: Arquivo
            alignment: right
        }
        display {
            displayAs: nativeFileBrowse
        }
        layout {
            sequence: 20
            region: @importar-arquivo
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVO
            used: always
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from netsys.sincronizar
                where idfilial = :P0_IDFILIAL
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P163_CONTROLE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @importar-arquivo
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P163_IDFILIAL (
        type: hidden
        layout {
            sequence: 50
            region: @importar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return :P0_IDFILIAL;
                end;
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P163_MSG (
        type: displayOnly
        label {
            label: Aviso:
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 30
            region: @importar-arquivo
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: Há um arquivo sendo processado.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from netsys.sincronizar
                where idfilial = :P0_IDFILIAL
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P163_ROWID (
        type: hidden
        layout {
            sequence: 10
            region: @importar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ROWID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Importar Arquivo
        layout {
            sequence: 40
            region: @importar-arquivo
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM DUAL
                WHERE :P163_ROWID IS NULL
                AND :P163_CONTROLE IS NULL
                ```
        }
    )

    button processar (
        buttonName: PROCESSAR
        label: Processar
        layout {
            sequence: 50
            region: @importar-arquivo
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P163_CONTROLE
            value: P
        }
    )

    validation já-processado (
        name: Já processado
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from netsys.sincronizar n
                where n.idfilial = :P0_IDFILIAL
                  and not exists ( select 1
                                   from impnettoservidor t
                                   where t.idrepresentante = n.idrepresentante
                                     and t.semana          = n.semana )
                ```
        }
        error {
            errorMessage: Este representante já teve esta região processada!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @processar
        }
    )

    process executa-integração (
        name: executa integração
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  for i in ( select distinct idrepresentante
                                  , semana 
                             from netsys.sincronizar
                             where idfilial = :P0_IDFILIAL)
                  loop
                    PCK_INTEGRACAO.prc_integradados_roman ( i.idrepresentante , i.semana );
                    pck_integracao.prc_deleta_netsys_orcl(i.idrepresentante);
                  end loop;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Arquivo processado! Efetue o acerto!
        }
        advanced {
            executionMappingIdentifier: 562025075093085281
        }
        serverSideCondition {
            whenButtonPressed: @processar
        }
    )

    process fetch-row-from-importacoes (
        name: Fetch Row from IMPORTACOES
        type: autoRowFetch
        source {
            tableName: IMPORTACOES
            pkColumn: ROWID
            pkItem: P163_ROWID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 540345667295304023
        }
    )

    process importa-arquivo (
        name: importa Arquivo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_integracao.prc_importa(pidfilial => :P0_IDFILIAL);
                  commit;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Executado com sucesso! Clique em PROCESSAR!
        }
        advanced {
            executionMappingIdentifier: 540551577593947952
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-importacoes (
        name: Process Row of IMPORTACOES
        type: autoRowProcessing
        target {
            tableName: IMPORTACOES
            pkColumn: ROWID
            pkItem: P163_ROWID
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 540345869366304025
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 540346087531304026
        }
        serverSideCondition {
            whenButtonPressed: @processar
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 163
                items: {
                    P163_CONTROLE: P
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch (
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 163
                items: {
                    P163_CONTROLE: N
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @processar
        }
        comments {
            comments: Created 13-NOV-2012 14:29 by ROMAN
        }
    )

)

