    region rateios (
        name: Rateios
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ra.idrateiorequisicao
                     , ra.idrequisicaopgto
                     , ra.valor
                     , ra.idfilial
                    -- , ra.idrazaosocialfilial
                     , ra.idmatriz
                     , ra.observacao
                     , null informar_placas
                from roman.rateiosrequisicoes ra
                where ra.idrequisicaopgto = :P674_IDREQUISICAO
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P674_GRUPO is not null
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 563182974571862713
        }

