    process processo-dml-requisicoes (
        name: Processo DML Requisicoes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vsituacao varchar2(100);
                  vusuarioinclusao varchar2(50);
                  vdatainclusao date := sysdate ;
                  vvalor number;
                  vdesconto number;
                  vacrescimo number;
                  vvalortotal number;
                  vmoeda number;
                  v_validaMatriz NUMBER;
                  vlinhadigitavel varchar2(48) := regexp_replace(:P674_LINHADIGITAVEL,'[^0-9]'); -- Ticket 16244255
                  vantecipacao varchar2(1);
                  --
                begin
                  --
                   if v('REQUEST') in ('GERAR_REQUISICAO') then
                    --
                    if :P674_GRUPO is null and :P674_UNIDADENEGOCIO is null then
                      raise_application_error(-20001,'Obrigatorio informar Grupo ou Unidade');
                    end if;
                  --
                  end if;
                  --
                  if v('REQUEST') = 'GERAR_REQUISICAO' then
                    --
                    voperacao_dml := 'I';
                    vvalortotal :=  replace(nvl(:P674_VALOR,0),'.','')  + replace(nvl(:P674_ACRECIMO,0),'.','') - replace(nvl(:P674_DESCONTO,0),'.','') ; 
                    vvalor  := replace(:P674_VALOR,'.','');
                    vdesconto := replace(:P674_DESCONTO,'.','');
                    vacrescimo := replace(:P674_ACRECIMO,'.','');
                    --
                  elsif v('REQUEST') = 'SALVAR' then
                    --
                    --Criado novo bloco para validar se existem matrizes inativas
                    --Ao duplicar requisicao, estava permitindo salvar mesmo com matrizes inativas
                    --Situacoa não ocorre ao criar, pois ja existe validação na seleção de matriz
                    SELECT COUNT(*)
                        INTO v_validaMatriz
                        FROM roman.rateiosrequisicoes R
                        JOIN roman.matrizregrasdespesas M ON R.IDMATRIZ = M.IDMATRIZREGRA
                       WHERE R.IDREQUISICAOPGTO = :P674_IDREQUISICAO
                         AND M.ATIVO = 'N'
                         AND ROWNUM = 1;
                
                    IF (v_validaMatriz >= 1) THEN
                        RAISE_APPLICATION_ERROR(-20001, 'Existem Matrizes Inativas');
                    END IF;
                    
                    vvalortotal :=  replace(nvl(:P674_VALOR,0),'.','')  + replace(nvl(:P674_ACRECIMO,0),'.','') - replace(nvl(:P674_DESCONTO,0),'.','') ; 
                    voperacao_dml := 'U';
                    vvalor := replace(:P674_VALOR,'.','');
                    vdesconto  := replace(:P674_DESCONTO,'.','');
                    vacrescimo := replace(:P674_ACRECIMO,'.','');
                  
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                    
                  end if;
                  --
                  if :P674_IDREQUISICAO is null then
                    --
                    select u.usuario 
                      into vusuarioinclusao
                      from catal.usuarios u
                     where u.usuario = v('APP_USER');
                    --
                  end if;
                  --
                  -- trata o P674_IDMOEDA
                  vmoeda := :P674_IDMOEDA;
                  vantecipacao := nvl(:P674_ANTECIPACAO, 'N');
                
                  ROMAN.PCK_NOTASFISCAIS_RMC.PRC_REQUISICOESPAGAMENTOS(pidrequisicaopgto    => :P674_IDREQUISICAO
                                                                     , pidfilial            => :P674_FILIALORIGEM
                                                                     , pidformapagamento    => :P674_TIPODOC
                                                                     , pdocumento           => :P674_DOCUMENTO
                                                                     , pdatainclusao        => vdatainclusao
                                                                     , pdataemissao         => :P674_DATAEMISSAO
                                                                     , penvio               => :P674_ENVIO
                                                                     , pidsituacao          => :P674_SITUACAO 
                                                                     , pusuarioinclusao     => vusuarioinclusao
                                                                     , pusuarioaprovacao    => :P674_USUARIOAPROVACAO
                                                                     , pidfornecedor        => :P674_IDFORNECEDOR
                                                                     , pidfilialdestino     => :P674_UNIDADENEGOCIO
                                                                     , pidrazaosocialfornec => :P674_IDRAZAOFORNECEDOR
                                                                     , pidrazaosocialdest   => :P674_IDRAZAOSOCIALDESTINO
                                                                     , pidmatrizdespesa     => :P674_MATRIZ
                                                                     , pidgrupo             => :P674_GRUPO
                                                                     , pidrazaodestgrupo    => :P674_IDRAZAODESTGRUPO
                                                                     , pidcontabanc         => :P674_CONTADEPOSITO
                                                                     , pvalortotal          => vvalortotal
                                                                     , pvalor               => vvalor
                                                                     , pdesconto            => vdesconto 
                                                                     , pvencimento          => :P674_VENCIMENTO
                                                                     , pacrescimo           =>  vacrescimo
                                                                     , pantecipacao         => vantecipacao
                                                                     , pfiscal              => :P674_FISCAL
                                                                     , pcomprovantepgto     => :P674_COMPROVANTEPGTO
                                                                     , pmotivoatraso        => :P674_MOTIVOATRASO
                                                                     , pparcelas            => :P674_QTDEPARCELAS
                                                                     , pdias                => :P674_DIASPRAZO
                                                                     , pfixadata            => :P674_FIXADATA
                                                                     , pobservacao          => :P674_OBSERVACAO
                                                                     , pajuste              => :P674_AJUSTESAREALIZAR
                                                                     , pedicao              => :P674_EDICAOBLOQUEADA
                                                                     , pidmoeda             => vmoeda
                                                                     , pconversao           => :P674_CONVERSAO
                                                                     , plinhadigitavel      => vlinhadigitavel
                                                                     , pmd5                 => :P674_MD5
                                                                     , poperacao_dml        => voperacao_dml );
                  --
                    if voperacao_dml = 'I' then
                      --
                      apex_application.g_print_success_message := '<span style="color : white ">Requisição criada com sucesso! </span>';  
                      
                    elsif  voperacao_dml = 'U' then
                      --
                      apex_application.g_print_success_message := '<span style="color : white ">Alteração realizada com sucesso! </span>';
                    
                    elsif  voperacao_dml = 'D' then
                      --
                      apex_application.g_print_success_message := '<span style="color : white ">Exclusão realizada com sucesso! </span>';
                    end if;
                
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 562554118264972201
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SALVAR','DELETAR','GERAR_REQUISICAO')
                ```
        }
    )

