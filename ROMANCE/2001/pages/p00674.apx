    button duplicar-lancamento (
        buttonName: DUPLICAR_LANCAMENTO
        label: Duplicar Requisição
        layout {
            sequence: 80
            region: @lançamento-requisição-pagamento
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.requisicoespagamentos r
                where r.idrequisicaopgto = :P674_IDREQUISICAO
                 and not exists ( select 1 
                              from roman.situacoesrequisicoes s
                              where s.idsituacao = r.idsituacao
                                and s.idsituacao in (1,4,8) )
                ```
        }
    )

