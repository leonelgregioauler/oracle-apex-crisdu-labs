            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P674_EDICAOBLOQUEADA
            value: N
        }
    )

    button voltar (
        buttonName: VOLTAR
