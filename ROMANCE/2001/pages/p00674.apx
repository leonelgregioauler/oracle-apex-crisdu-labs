    pageItem P674_UNIDADENEGOCIO (
        type: selectList
        label {
            label: Unidade Negocio
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(f.idfilial)||'  - Unid. Neg.: '||( select un.nome
                                                                                from unidadesdenegocios un
                                                                                where un.idunidadedenegocio = f.idunidadedenegocio ) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.ativo = 'S'
                  and exists ( select 1
                               from matrizregrasdespesas m
                               where m.idfornecedor = :P674_IDFORNECEDOR
                                 and m.idfilial     = f.idfilial 
                                 and m.ativo = 'S' )
                  --and f.grupocrisdu =  'S' -- Debora solicitou remover a amarração.
                  --and f.idfilial not in 1186 -- Debora solicitou a Remoção da lista / Debora disse que nao fez a solicitação anterior (remoção) e pediu para liberar T9651853 
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P674_IDFORNECEDOR
        }
        layout {
            sequence: 200
            region: @lançamento-requisição-pagamento
