    dynamicAction desabilita-dias-prazo (
        name: Desabilita Dias Prazo
        execution {
            sequence: 190
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P674_DIASPRAZO
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P674_DIASPRAZO
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 
                    from roman.requisicoespagamentos r 
                    where r.idrequisicaopgto = :P674_IDREQUISICAO
                      and r.dias is not null
                      and exists( select 1 
                                  from roman.vencimentosrequisicoes vr 
                                  where vr.idrequisicaopgto = :P674_IDREQUISICAO)
                    ```
            }
        )

    )

