        behavior {
            action: redirectThisApp
            target: {
                page: 681
                items: {
                    P681_IDANEXOREQUISICAOPGTO:
                    P681_IDANEXODELETAR:
                    P681_IDREQUISICAO: &P674_IDREQUISICAO.
