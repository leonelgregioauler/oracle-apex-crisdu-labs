    validation exige-motivo-acrescimo (
        name: Exige Motivo Acrescimo
        execution {
            sequence: 70
        }
        validation {
            type: itemIsNotNullOrZero
            item: P674_MOTIVOATRASO
        }
        error {
            errorMessage: Por favor, informe o motivo dos acréscimos desta fatura.
            associatedItem: @P674_MOTIVOATRASO
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'GERAR_REQUISICAO' and to_date(:P674_VENCIMENTO) < trunc(sysdate)
        }
    )

    validation exige-valor-de-acrescimo (
        name: Exige Valor de Acrescimo
        execution {
            sequence: 80
        }
        validation {
            type: itemIsNotNull
            item: P674_ACRECIMO
        }
        error {
            errorMessage: Por favor, informe o valor dos acréscimos desta fatura.
            associatedItem: @P674_ACRECIMO
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'GERAR_REQUISICAO' and to_date(:P674_VENCIMENTO) < trunc(sysdate)
        }
    )

    validation permite-somente-números (
        name: Permite Somente Números
        execution {
            sequence: 190
        }
        validation {
            type: itemIsNumeric
            item: P674_DOCUMENTO
        }
        error {
            errorMessage: Permitido somente valores numéricos 0~9
            associatedItem: @P674_DOCUMENTO
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SALVAR','GERAR_REQUISICAO','ENVIAR_FINANCEIRO','INTEGRAR_FINANCEIRO')
                ```
        }
    )

    validation valida-anexo (
        name: Valida Anexo
        execution {
            sequence: 60
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.formaspagamentos fp
                where fp.idformapagamento = :P674_TIPODOC
                  and fp.anexoobrigatorio = 'S'
                  and not exists ( select 1 
                                   from roman.anexosrequisicoes a
                                   where a.idrequisicaopgto = :P674_IDREQUISICAO )
                ```
        }
        error {
            errorMessage: Anexar arquivo !
        }
        serverSideCondition {
            whenButtonPressed: @enviar-financeiro
        }
    )

    validation valida-chave-de-acesso-ao-enviar (
        name: Valida Chave de Acesso ao enviar
        execution {
            sequence: 65
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where exists ( select 1 
                               from roman.chavesacessorequisicoes c 
                               where c.idrequisicaopgto = :P674_IDREQUISICAO )
                ```
        }
        error {
            errorMessage: Cadastre ao menos uma Chave de Acesso antes de enviar a requisição para o Financeiro!
        }
        serverSideCondition {
            whenButtonPressed: @enviar-financeiro
            type: never
        }
    )

    validation valida-conta-bancaria (
        name: Valida Conta Bancaria
        execution {
            sequence: 100
        }
        validation {
            type: itemIsNotNull
            item: P674_CONTADEPOSITO
        }
        error {
            errorMessage: Informar conta bancaria!
            associatedItem: @P674_CONTADEPOSITO
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P674_TIPODOC in ('T','H','D') and v('REQUEST') in ('GERAR_REQUISICAO','SALVAR')
        }
    )

    validation valida-data-vencimento (
        name: Valida data vencimento
        execution {
            sequence: 140
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from ( select r.vencimento
                       from roman.requisicoespagamentos r
                       where r.idrequisicaopgto = :P674_IDREQUISICAO ) rp
                   , ( select min (v.vencimento) vencimento
                       from roman.vencimentosrequisicoes v
                       where v.idrequisicaopgto = :P674_IDREQUISICAO ) vp
                where trunc(rp.vencimento)  = trunc(vp.vencimento)
                ```
        }
        error {
            errorMessage: Atenção !! Verificar datas de vencimentos.
        }
        serverSideCondition {
            whenButtonPressed: @enviar-financeiro
        }
        comments {
            comments: Valida data de vencimento, caso a primeira parcela seja diferente da data de vencimento da requisição, houve alteração e não foi ajustado.
        }
    )

    validation valida-documento (
        name: Valida Documento
        execution {
            sequence: 130
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where exists ( select 1 
                               from roman.requisicoespagamentos rp 
                               where rp.documento = :P674_DOCUMENTO
                                 and rp.idfornecedor = :P674_IDFORNECEDOR
                                 and rp.idrequisicaopgto != :P674_IDREQUISICAO)
                   or exists ( select 1 
                               from roman.notasfiscais nf 
                               where nf.documento = :P674_DOCUMENTO
                                 and nf.idfornemitente = :P674_IDFORNECEDOR )
                ```
        }
        error {
            errorMessage: Número de documento já existente para este fornecedor!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SALVAR','GERAR_REQUISICAO','ENVIAR_FINANCEIRO')
                ```
        }
    )

    validation valida-fornecedor (
        name: Valida Fornecedor
        execution {
            sequence: 195
        }
        validation {
            type: itemIsNotNull
            item: P674_IDFORNECEDOR
        }
        error {
            errorMessage: Fornecedor precisa ser selecionado!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('ENVIAR_FINANCEIRO','GERAR_REQUISICAO')
                ```
        }
    )

    validation valida-informações-de-rateio (
        name: Valida Informações de Rateio
        execution {
            sequence: 110
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from roman.requisicoespagamentos r
                where r.idgrupo is not null 
                  and r.idrequisicaopgto = :P674_IDREQUISICAO
                  and not exists ( select 1 
                                   from roman.rateiosrequisicoes rt
                                   where rt.idrequisicaopgto = :P674_IDREQUISICAO )
                  or exists ( select 1 
                              from roman.rateiosrequisicoes rt
                              where rt.idrequisicaopgto = :P674_IDREQUISICAO
                                and (rt.valor is null 
                                   or rt.idmatriz is null 
                                   or rt.idfilial is null) )
                ```
        }
        error {
            errorMessage: Atenção !! Revisar Informações de Rateio.
        }
        serverSideCondition {
            whenButtonPressed: @enviar-financeiro
        }
    )

    validation valida-linha-digitável-guia (
        name: Valida Linha Digitável Guia
        execution {
            sequence: 256
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P674_TIPODOC = 'G'
                  and nvl(length(regexp_replace(:P674_LINHADIGITAVEL,'[^0-9]')),0) not in (47,48)
                ```
        }
        error {
            errorMessage: Informe a linha digitável da guia (47 ou 48 dígitos)!
            associatedItem: @P674_LINHADIGITAVEL
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SALVAR','GERAR_REQUISICAO','ENVIAR_FINANCEIRO')
                ```
        }
        comments {
            comments: Ticket 16244255
        }
    )

    validation valida-matriz-quando-unidade (
        name: Valida Matriz quando unidade
        execution {
            sequence: 180
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual 
                where :P674_MATRIZ is null and :P674_UNIDADENEGOCIO is not null
                ```
        }
        error {
            errorMessage: Matriz Classificação precisa ser selecionada!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('ENVIAR_FINANCEIRO','GERAR_REQUISICAO')
                ```
        }
    )

    validation valida-motivo-atraso (
        name: Valida Motivo Atraso
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P674_MOTIVOATRASO
        }
        error {
            errorMessage: Por favor informar o motivo do atraso!
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P674_ACRECIMO
        }
    )

    validation valida-prazo (
        name: Valida prazo
        execution {
            sequence: 160
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.requisicoespagamentos r
                where r.idrequisicaopgto = :P674_IDREQUISICAO
                  and r.parcelas > 1
                  and (nvl(r.dias,0) = 0 
                    or r.dias is null)
                  and  r.fixadataparc is null
                ```
        }
        error {
            errorMessage: Mais de 1 parcela informada, por favor informar dias de prazo entre as parcelas ou Data fixa e salvar !
        }
        serverSideCondition {
            whenButtonPressed: @gerar-vencimentos
        }
    )

    validation valida-qtd-parcelas (
        name: "Valida qtd parcelas "
        execution {
            sequence: 150
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from ( select r.parcelas 
                       from roman.requisicoespagamentos r
                       where r.idrequisicaopgto = :P674_IDREQUISICAO ) rp
                   , ( select count(v.idvencimentorequisicao) qtd
                       from roman.vencimentosrequisicoes v
                       where v.idrequisicaopgto = :P674_IDREQUISICAO ) vp
                where rp.parcelas  = vp.qtd
                ```
        }
        error {
            errorMessage: Atenção!! Ao corrigir quantidade de parcelas -- Remover vencimentos existentes -- Clicar botão Atualizar Página -- Gerar novamente os vencimentos.
        }
        serverSideCondition {
            whenButtonPressed: @enviar-financeiro
        }
    )

