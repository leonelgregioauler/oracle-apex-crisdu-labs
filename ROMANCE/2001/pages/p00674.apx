    process atualiza-situação (
        name: Atualiza Situação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 --
                 vvalida number ;
                 vtestep number ;
                 vtester number ;
                 --
                begin
                  --
                  if v('REQUEST') = 'FINALIZAR_FISCAL' then
                    --
                    update roman.requisicoespagamentos rp
                    set rp.idsituacao = 2
                    where rp.idrequisicaopgto = :P674_IDREQUISICAO;
                    --
                  elsif v('REQUEST') = 'ENVIAR_FINANCEIRO' and :P674_FISCAL = 'S' then
                    --
                    select vreq.vt - vparc.vp resultp , vreq.vt - vrat.vr resultrat
                      into vtestep , vtester
                    from ( select r.valortotal vt
                           from roman.requisicoespagamentos r
                           where r.idrequisicaopgto = :P674_IDREQUISICAO ) vreq
                           --
                       , ( select sum ( v.valor ) vp
                           from roman.vencimentosrequisicoes v
                           where v.idrequisicaopgto = :P674_IDREQUISICAO ) vparc
                           --
                       , ( select sum ( r.valor ) vr
                           from roman.rateiosrequisicoes r
                           where r.idrequisicaopgto = :P674_IDREQUISICAO ) vrat ;
                       --
                       update roman.requisicoespagamentos rq
                       set rq.dataenvio = sysdate
                         , rq.usuarioenvio = v('APP_USER')
                       where rq.idrequisicaopgto = :P674_IDREQUISICAO
                        and rq.dataenvio is null ; --Registra somente o primeiro envio.
                       --
                       update roman.requisicoespagamentos rq
                       set rq.edicaobloqueada = 'S'
                       where rq.idrequisicaopgto = :P674_IDREQUISICAO ; 
                       --
                           --
                           if nvl(vtestep,0 ) != 0 then
                             --
                             --apex_application.g_print_success_message := '<span style="color : Black ">Atenção !! Valor das Parcelas Diferente da Requisição.  </span>';
                              raise_application_error(-20001, 'Atenção !! Valor das Parcelas Diferente da Requisição.');
                             --
                           elsif nvl(vtester,0 ) != 0 then
                             --
                             --apex_application.g_print_success_message := '<span style="color : Black ">Atenção !! Valor dos Rateios Diferente da Requisição.  </span>';   
                             raise_application_error(-20001,'Atenção !! Valor dos Rateios Diferente da Requisição.' );
                             --
                           else
                             --
                             -- Projeto fluxo paralelo (Op¿¿o A): com ou sem fiscal, a requisi¿¿o
                             -- vai para 2 (Atendimento Financeiro). O fiscal v¿ em paralelo pela
                             -- query FISCAL='S' AND DATAFINALIZADOFISCAL IS NULL.
                             update roman.requisicoespagamentos rp
                             set rp.idsituacao = 2
                             where rp.idrequisicaopgto = :P674_IDREQUISICAO;
                             --
                           end if;
                           --
                  elsif v('REQUEST') = 'ENVIAR_FINANCEIRO' then
                    --
                    select vreq.vt - vparc.vp resultp , vreq.vt - vrat.vr resultrat
                      into vtestep , vtester
                    from ( select r.valortotal vt
                           from roman.requisicoespagamentos r
                           where r.idrequisicaopgto = :P674_IDREQUISICAO ) vreq
                           --
                       , ( select sum ( v.valor ) vp
                           from roman.vencimentosrequisicoes v
                           where v.idrequisicaopgto = :P674_IDREQUISICAO ) vparc
                           --
                       , ( select sum ( r.valor ) vr
                           from roman.rateiosrequisicoes r
                           where r.idrequisicaopgto = :P674_IDREQUISICAO ) vrat ;
                           --
                           update roman.requisicoespagamentos rq
                           set rq.dataenvio = sysdate
                             , rq.usuarioenvio = v('APP_USER')
                           where rq.idrequisicaopgto = :P674_IDREQUISICAO
                             and rq.dataenvio is null ; --Registra somente o primeiro envio.
                           --
                           update roman.requisicoespagamentos rq
                           set rq.edicaobloqueada = 'S'
                           where rq.idrequisicaopgto = :P674_IDREQUISICAO ; 
                           --
                           if nvl(vtestep,0 ) != 0 then
                             --raise_application_error(-20001,'qualquer coisa');
                             --apex_application.g_print_success_message := '<span style="color : Black ">Atenção !! Valor das Parcelas Diferente da Requisição.  </span>';
                             raise_application_error(-20001, 'Atenção !! Valor das Parcelas Diferente da Requisição.');
                             --
                           elsif nvl(vtester,0 ) != 0 then
                             --
                             --apex_application.g_print_success_message := '<span style="color : Black ">Atenção !! Valor dos Rateios Diferente da Requisição.  </span>';   
                             raise_application_error(-20001,'Atenção !! Valor dos Rateios Diferente da Requisição.' );
                             --
                           else
                             --
                             update roman.requisicoespagamentos rp
                             set rp.idsituacao = 2
                             where rp.idrequisicaopgto = :P674_IDREQUISICAO;
                             --
                           end if;
                           --
                  end if;
                 --
                 commit;
                 --
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Requisição enviada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 564669959167887603
        }
        serverSideCondition {
            whenButtonPressed: @enviar-financeiro
        }
    )

    process consulta-em-requisições (
        name: Consulta em requisições
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalor      number(15,2) := replace(:P674_VALOR ,'.','');
                  vacrecimo   number(15,2) := replace(:PP674_ACRECIMO,'.','');
                  vdesconto   number(15,2) := replace(:P674_DESCONTO ,'.','');
                  vvalortotal number(15,2) := replace(:P674_VALORTOTAL,'.','');
                  vconversao  number;
                  vdtinclusao date ;
                  vidsit number;
                  --vvencimento date;
                
                begin
                  --
                 ROMAN.PCK_NOTASFISCAIS_RMC.PRC_REQUISICOESPAGAMENTOS(pidrequisicaopgto    => :P674_IDREQUISICAO
                                                                    , pidfilial            => :P674_FILIALORIGEM
                                                                    , pidformapagamento    => :P674_TIPODOC
                                                                    , pdocumento           => :P674_DOCUMENTO
                                                                    , pdatainclusao        => vdtinclusao
                                                                    , pdataemissao         => :P674_DATAEMISSAO
                                                                    , penvio               => :P674_ENVIO
                                                                    , pidsituacao          => :P674_SITUACAO
                                                                    , pusuarioinclusao     => :P674_USUARIOINCLUSAO
                                                                    , pusuarioaprovacao    => :P674_USUARIOAPROVACAO
                                                                    , pidfornecedor        => :P674_IDFORNECEDOR
                                                                    , pidfilialdestino     => :P674_UNIDADENEGOCIO
                                                                    , pidrazaosocialfornec => :P674_IDRAZAOFORNECEDOR
                                                                    , pidrazaosocialdest   => :P674_IDRAZAOSOCIALDESTINO
                                                                    , pidmatrizdespesa     => :P674_MATRIZ
                                                                    , pidgrupo             => :P674_GRUPO
                                                                    , pidrazaodestgrupo    => :P674_IDRAZAODESTGRUPO
                                                                    , pidcontabanc         => :P674_CONTADEPOSITO
                                                                    , pvalortotal          => vvalortotal
                                                                    , pvalor               => vvalor
                                                                    , pdesconto            => vdesconto
                                                                    , pvencimento          => :P674_VENCIMENTO
                                                                    , pacrescimo           => vacrecimo 
                                                                    , pantecipacao         => :P674_ANTECIPACAO
                                                                    , pfiscal              => :P674_FISCAL
                                                                    , pcomprovantepgto     => :P674_COMPROVANTEPGTO
                                                                    , pmotivoatraso        => :P674_MOTIVOATRASO
                                                                    , pparcelas            => :P674_QTDEPARCELAS
                                                                    , pdias                => :P674_DIASPRAZO
                                                                    , pfixadata            => :P674_FIXADATA
                                                                    , pobservacao          => :P674_OBSERVACAO
                                                                    , pajuste              => :P674_AJUSTESAREALIZAR
                                                                    , pedicao              => :P674_EDICAOBLOQUEADA
                                                                    , pidmoeda             => :P674_IDMOEDA
                                                                    , pconversao           => vconversao
                                                                    , plinhadigitavel      => :P674_LINHADIGITAVEL
                                                                    , pmd5                 => :P674_MD5
                                                                    , poperacao_dml        => 'S' );
                  --
                  :P674_VALOR      := to_char(vvalor     ,'999G999G999G999G999G990D00'); 
                  :P674_ACRECIMO   := to_char(vacrecimo  ,'999G999G999G999G999G990D00'); 
                  :P674_DESCONTO   := to_char(vdesconto,'999G999G999G999G999G990D00'); 
                  :P674_DATAINCLUSAO := to_char(vdtinclusao,'DD/MM/RRRR HH24:MI:SS');
                  :P674_CONVERSAO    := nvl(vconversao, 1); -- Ticket 16244255
                  --:P674_VALORTOTAL := to_char(vvalortotal,'999G999G999G999G999G990D00');
                 -- :P674_VENCIMENTO := to_date(vvencimento,'DD/MM/RRRR HH24:MI:SS');
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 562577510272952707
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P674_IDREQUISICAO
        }
    )

