    pageItem P674_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                where f.idpessoa = p.idpessoa
                  and f.ativo    = 'S'
                  and exists ( select 1
                               from matrizregrasdespesas m
                               where m.idfornecedor = f.idfornecedor )
                order by 1
                
                ```
        }
        layout {
            sequence: 170
            region: @lançamento-requisição-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

