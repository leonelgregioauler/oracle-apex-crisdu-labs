page 653 (
    name: Anexos de Negociações de Perdas
    title: Anexos de Negociações de Perdas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P653_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos-de-acordos (
        name: Anexos de Acordos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     --, '<a href="javascript: fnc_verimg('''||iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' 
                     --, idnegociacao||idanexonegociacao||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , dataanexo
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     , '<a href="javascript: fnc_removeanexo('||t.idanexonegociacao||','''||t.nomearquivo||''');">Remover</a>' remover
                     , roman.pck_bucket.sp_abre_anexo(url_bucket) preview
                from anexosnegociacoes t
                where t.idnegociacao = :P653_IDNEGOCIACAO
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Nenhum arquivo localizado!
        }

        column DATAANEXO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Data Anexo
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                sortable: false
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column PREVIEW (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Preview
            }
            layout {
                sequence: 15
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column REMOVER (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Usuario
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P653_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            filenameColumn: NOMEARQUIVO
            fileTypes: image/png,image/jpeg,application/pdf
        }
        layout {
            sequence: 50
            region: @anexos-de-acordos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P653_DATAANEXO (
        type: hidden
        layout {
            sequence: 80
            region: @anexos-de-acordos
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATAANEXO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P653_IDANEXODELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @anexos-de-acordos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P653_IDANEXONEGOCIACAO (
        type: hidden
        layout {
            sequence: 10
            region: @anexos-de-acordos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXONEGOCIACAO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P653_IDNEGOCIACAO (
        type: displayOnly
        label {
            label: ID Acordo.
            alignment: left
        }
        layout {
            sequence: 20
            region: @anexos-de-acordos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: IDNEGOCIACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P653_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @anexos-de-acordos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                begin
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  return vidusuario;
                  --
                end;
                  
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P653_NOMEARQUIVO (
        type: hidden
        layout {
            sequence: 40
            region: @anexos-de-acordos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 10
            region: @anexos-de-acordos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P653_IDANEXONEGOCIACAO
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @anexos-de-acordos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P653_IDANEXONEGOCIACAO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @anexos-de-acordos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation informar-arquivo (
        name: Informar arquivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P653_ARQUIVOTEMP
        }
        error {
            errorMessage: Selecione o arquivo!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_negociacoes(pidnegociacao => :P653_IDNEGOCIACAO
                                                     ,pidanexo      => :P653_IDANEXONEGOCIACAO);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 33145929149671501
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P653_IDANEXONEGOCIACAO := null;
                  pck_anexos.prc_apagaanexo_negociacoes(pidanexonegociacao => :P653_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 33147569047671502
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexosnegociacoes (
        name: Fetch Row from ANEXOSNEGOCIACOES
        type: autoRowFetch
        source {
            tableName: ANEXOSNEGOCIACOES
            pkColumn: IDANEXONEGOCIACAO
            pkItem: P653_IDANEXONEGOCIACAO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 33146399981671502
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P653_IDANEXONEGOCIACAO is null then
                        select "#OWNER#"."SEQ_IDANEXONEGOCIACAO".nextval
                          into :P653_IDANEXONEGOCIACAO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 33146798255671502
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexosnegociacoes (
        name: Process Row of ANEXOSNEGOCIACOES
        type: autoRowProcessing
        target {
            tableName: ANEXOSNEGOCIACOES
            pkColumn: IDANEXONEGOCIACAO
            pkItem: P653_IDANEXONEGOCIACAO
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada
        }
        advanced {
            executionMappingIdentifier: 33147171862671502
        }
    )

    branch (
        name: Go To Page 650
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 650
                items: {
                    P650_IDNEGOCIACAOPARCEIRO: &P653_IDNEGOCIACAO.
                }
                action: resetPagination
            }
        }
    )

    branch (
        name: 653
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 653
                items: {
                    P653_IDANEXONEGOCIACAO:
                    P653_IDNEGOCIACAO: &P653_IDNEGOCIACAO.
                }
                clearCache: 328
                action: resetPagination
                successMessage: false
            }
        }
    )

)

