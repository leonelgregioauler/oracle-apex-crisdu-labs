page 307 (
    name: Controle de Produtividade
    title: Controle de Produtividade
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region produtividade (
        name: "Produtividade "
        type: tabform
        source {
            sqlQuery:
                ```sql
                select null idproduto
                 , null tempomesa
                 , null qtdpecas
                 , null resultado
                from dual
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }

        column CHECK$01 (
            reportColumnQueryId: 5
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDPRODUTO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Produto
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomeproduto(idproduto) display_value
                      , idproduto
                    from produtos 
                    order by 1
                    ```
            }
            layout {
                sequence: 2
            }
        )

        column QTDPECAS (
            reportColumnQueryId: 3
            derivedColumn: N
            type: textField
            heading {
                heading: Qtd de Peças
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 5
            }
        )

        column RESULTADO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Resultado
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column TEMPOMESA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: textField
            heading {
                heading: Tempo de Mesa
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                width: 5
            }
        )

    )

    region produtividade-reembalagem (
        name: Produtividade Reembalagem
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P307_COLABORADOR (
        type: selectList
        label {
            label: Colaborador
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pck_romance.fnc_nomepessoa(uu.idpessoa) display_value
                    , uu.idusuario return_value
                from usuariossistemas u
                    , usuarios uu
                where u.usuario = uu.usuario
                  and uu.ativo = 'S'  
                  and idsistema = 2001
                  and uu.idgerente = ( select idgerente
                                       from gerentes g
                                       where g.idfilial = :P0_IDFILIAL )   
                order by 1  
                ```
        }
        layout {
            sequence: 10
            region: @produtividade-reembalagem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 40
            region: @produtividade
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @produtividade
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 307
                items: {
                    P307_COLABORADOR:
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button iniciar (
        buttonName: INICIAR
        label: Iniciar
        layout {
            sequence: 20
            region: @produtividade-reembalagem
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @produtividade
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Calcular
        layout {
            sequence: 30
            region: @produtividade
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction mostra-produtividade (
        name: mostra produtividade
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P307_COLABORADOR
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P307_COLABORADOR
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @produtividade
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @produtividade
            }
            execution {
                sequence: 10
            }
        )

    )

    process mostra-resultado (
        name: Mostra Resultado
        type: executeCode
        editableRegion: @produtividade
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vtemporeembalagem number := 0;
                  vresultado        number := 0;
                  vqtdpecas         number := 0;
                  vtempomesa        number := 0;
                  --
                begin
                  --
                  vqtdpecas  := :QTDPECAS;
                  vtempomesa := :TEMPOMESA; 
                  --
                  select c.tempopadraoreembalagem
                  into vtemporeembalagem
                  from categorias c
                  where c.idcategoria = ( select idcategoria
                                          from produtos p
                                          where p.idproduto = :IDPRODUTO );
                  --
                  vresultado := (vqtdpecas * vtemporeembalagem) / vtempomesa;
                  --
                  :resultado := vresultado;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 343956179097805826
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 307
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

