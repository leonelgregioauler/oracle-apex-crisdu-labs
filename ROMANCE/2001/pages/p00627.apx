    pageItem P627_IDDELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @distribuições-em-andamento
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    process remove-distribuição (
        name: Remove Distribuição
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  delete distribuicaocargas d
                  where d.iddistribuicaocarga = :P627_IDDELETAR;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Removido com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5957749395140504502
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    branch (
        name: Go To Page 627
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 627
                items: {
                    P627_IDDELETAR:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
