page 627 (
    name: Distribuições em Andamento
    title: Distribuições em Andamento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_remove(piddist)
            {
                apex.confirm("Deseja realmente remover o registro aberto?", {
              request:"DELETAR",
              set:{"P627_IDDELETAR":piddist}
              });
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region distribuições-em-andamento (
        name: Distribuições em Andamento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(idfilial) empresa
                     , d.semana
                     , d.datainicio
                     , '<a href="javascript: fnc_remove('||iddistribuicaocarga||');">Remover</a>' remover
                from distribuicaocargas d
                where d.situacao = 'A'
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5934861166616787245
        }

        column DATAINICIO (
            type: plainText
            heading {
                heading: Iniciada em
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column EMPRESA (
