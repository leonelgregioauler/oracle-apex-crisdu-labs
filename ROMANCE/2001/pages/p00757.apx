    pageItem P757_FILTRAR (
        type: hidden
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P757_SEMANAFIM (
        type: selectList
        label {
            label: Semana Final
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(s.semana,'00')||'/'||s.ano) display_value
                     , s.idsemana return_value
                from roman.semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-2 and to_char(sysdate,'RRRR')
                  and s.idsemana >= :P757_SEMANAINI
                order by s.idsemana desc
                ```
        }
        cascadingLov {
            parentItems: P757_SEMANAINI
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P757_SEMANAINI (
        type: selectList
        label {
            label: Semana Inicial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(s.semana,'00')||'/'||s.ano) display_value
                     , s.idsemana return_value
                from roman.semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-2 and to_char(sysdate,'RRRR')
                order by s.idsemana desc
                
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @filtros
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 757
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 757
                items: {
                    P757_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

