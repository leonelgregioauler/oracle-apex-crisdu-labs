page 757 (
    name: Média Semanal de Cobrança  da Franquia
    title: Média Semanal de Cobrança  da Franquia
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region média-cobrança-franquia (
        name: Média Cobrança Franquia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select s.semanacompleta from roman.semana_dias s where s.idsemana = :P757_SEMANAINI  ) 
                         || ' à ' || 
                       ( select s.semanacompleta from roman.semana_dias s where s.idsemana = :P757_SEMANAFIM ) Período
                     , x.totalcobranca 
                     , x.comissoesromance
                     , x.comissoesfavoritarepres 
                     , x.totaldebitosemaberto 
                     , decode(nvl(x.totalcobranca,0), 0, 0, ( ( x.totalcomissoesrepresentantes + x.totalcomissaogerente + (x.totaldespesas)) / x.totalcobranca * 100 )) percdespesa
                     , case
                         when x.totaldebitosemaberto  > 0 then
                           round( ( x.totaldebitosemaberto  / ( nvl(x.totalcobranca,0) + nvl(x.totaldebitosemaberto ,0) ) ) * 100,2 )
                         else
                           0
                       end perc_inad
                from ( select nvl(sum(f.totalcobranca),0) totalcobranca
                            , nvl(sum(f.totalcomissoesrepresentantes + f.totalcomissaogerente ),0) comissoesromance
                            , nvl(sum(f.totalcomissoesfavoritarepres ),0) comissoesfavoritarepres 
                            , nvl(sum(f.totaldebitosemaberto ),0) totaldebitosemaberto 
                            , nvl(sum(f.totalcomissoesrepresentantes),0) totalcomissoesrepresentantes
                            , nvl(sum(f.totalcomissaogerente),0) totalcomissaogerente
                            , nvl(sum(f.totaldespesas + f.totaldespesacusto ),0) totaldespesas
                       from roman.fechamentossemanais f
                       where f.idfilial = :P0_IDFILIAL
                         and f.idsemana between :P757_SEMANAINI and :P757_SEMANAFIM
                         and :P757_FILTRAR = 'S' ) x
                --where :P757_FILTRAR = 'S' 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3494452426192529006
        }

        column COMISSOESFAVORITAREPRES (
