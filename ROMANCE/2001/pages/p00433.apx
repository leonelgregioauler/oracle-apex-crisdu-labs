    pageItem P433_DATAINCLUSAO (
        type: textField
        label {
            label: Data Inclusão
            alignment: left
        }
        layout {
            sequence: 30
            region: @ultima-carga-gerada
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(c.datainclusao,'DD/MM/RRRR') data
                from cargasrepresentantes c
                where c.idcargarepresentante = :P433_IDCARGAREPRES
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P433_IDCARGAREPRES
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P433_DATAINCLUSAO_D (
        type: textField
        label {
            label: Data Inclusão
            alignment: left
        }
        layout {
            sequence: 30
            region: @ultima-devolução-recebida
            slot: regionBody
            alignment: left
