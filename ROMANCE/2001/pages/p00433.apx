            item: P433_IDDEVOLUCAOREPRES
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P433_IDCARGAREPRES (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @ultima-carga-gerada
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vid number;
                begin
                  --
                  select max(c.idcargarepresentante)
                  into vid
                  from cargasrepresentantes c
                  where c.idrepresentante = :P433_IDREPRESENTANTE
                    and c.situacao != 0;
                  --
                  return vid;
                  --
                exception 
                  when others then
                    return null;
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

