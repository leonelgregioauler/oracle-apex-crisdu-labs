    region itens-da-devolução (
        name: Itens da Devolução
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist "Referência"
                     , initcap(p.nomeproduto) "Produto"
                     , ( nvl(it.qtd_pp,0)
                       + nvl(it.qtd_p,0)
                       + nvl(it.qtd_m,0)
                       + nvl(it.qtd_g,0)
                       + nvl(it.qtd_gg,0)
                       + nvl(it.qtd_egg,0)
                       + nvl(it.qtd_exgg,0)
                       + nvl(it.qtd_u,0) ) "Devolvido"
                     , ( nvl(it.qtd_pp,0)
                       + nvl(it.qtd_p,0)
                       + nvl(it.qtd_m,0)
                       + nvl(it.qtd_g,0)
                       + nvl(it.qtd_gg,0)
                       + nvl(it.qtd_egg,0)
                       + nvl(it.qtd_exgg,0)
                       + nvl(it.qtd_u,0) ) * it.valorproduto "Total Devolvido"
