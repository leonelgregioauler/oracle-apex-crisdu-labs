    region mercadorias-na-rua (
        name: Mercadorias na Rua
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist "Referência"
                     , initcap(p.nomeproduto) "Produto"
                     , sum(it.quantidade) "Quantidade"
                     , sum(it.valorvenda) "Valor Total"
                from itensnotavenda it
                   , produtos p
                   , estoquefilial e
                where p.idproduto = e.idproduto
                  and it.idestoquefil = e.idestoquefilial
                  and exists ( select 1
                               from notasvendas nv
                               where nv.idnotavenda = it.idnotavenda
                                 and nv.idsituacaonotavenda = 3
                                 and nv.idfilial = :P433_IDFILIAL
                                 and nv.idrepresentante = :P433_IDREPRESENTANTE )
                group by p.codigosisdist , p.nomeproduto
                order by 2
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
