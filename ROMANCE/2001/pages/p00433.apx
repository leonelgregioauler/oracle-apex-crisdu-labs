    dynamicAction buscar-informações (
        name: Buscar Informações
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P433_IDREPRESENTANTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ultima-carga-gerada
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ultima-devolução-recebida
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 433
                items: {
                    P433_IDFILIAL: &P433_IDFILIAL.
                    P433_IDREPRESENTANTE: &P433_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
    )

