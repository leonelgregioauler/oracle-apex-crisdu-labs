    region itens-da-carga (
        name: Itens da Carga
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist "Referência"
                     , initcap(p.nomeproduto) "Produto"
                     , ( nvl(it.qtd_dist_pp,0)
                       + nvl(it.qtd_dist_p,0)
                       + nvl(it.qtd_dist_m,0)
                       + nvl(it.qtd_dist_g,0)
                       + nvl(it.qtd_dist_gg,0)
                       + nvl(it.qtd_dist_egg,0)
                       + nvl(it.qtd_dist_exgg,0)
                       + nvl(it.qtd_dist_u,0) ) "Distribuído"
                     , ( nvl(it.qtd_dist_pp,0)
                       + nvl(it.qtd_dist_p,0)
                       + nvl(it.qtd_dist_m,0)
                       + nvl(it.qtd_dist_g,0)
                       + nvl(it.qtd_dist_gg,0)
                       + nvl(it.qtd_dist_egg,0)
                       + nvl(it.qtd_dist_exgg,0)
                       + nvl(it.qtd_dist_u,0) ) * it.valorvenda  "Total Distribuído"
                from itenscargarepresentante it
                   , produtos p
                where p.idproduto = it.idproduto
                  and it.idcargarepresentante = :P433_IDCARGAREPRES
                order by 2
                ```
        }
        layout {
            sequence: 10
            parentRegion: @ultima-carga-gerada
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma Carga encontrada!
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1497604915819790050
        }

        column Distribuído (
            type: plainText
            heading {
                heading: Distribuído
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

