    validation duplicidade-região-venda (
        name: Duplicidade Região Venda
        execution {
            sequence: 70
        }
        validation {
            editableRegion: @regiões-que-atende
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                    l_count                     number;
                    l_existe                    boolean;
                
                    l_idregiaovenda_registro    number;
                    l_valoragregado_registro    number(15,2);
                
                    l_idregiaovenda             number;
                    l_valoragregado             number(15,2);
                begin
                
                    if :APEX$ROW_STATUS = 'C' then
                        begin
                            select count(1)
                            into l_count
                            from roman.REGIOESREPRESENTANTES rg
                            where rg.idrepresentante = :P135_IDREPRESENTANTE
                              and rg.idregiaovenda = :IDREGIAOVENDA;
                        exception
                            when others then
                                l_count := 0;
                        end;
                    else 
                        begin
                            select idregiaovenda
                                 , valoragregado
                            into l_idregiaovenda_registro
                               , l_valoragregado_registro
                            from roman.REGIOESREPRESENTANTES rg
                            where rg.idregiaorepresentante = :IDREGIAOREPRESENTANTE;
                
                            begin
                                select idregiaovenda
                                     , valoragregado
                                into l_idregiaovenda
                                   , l_valoragregado
                                from roman.REGIOESREPRESENTANTES rg
                                where rg.idregiaorepresentante != :IDREGIAOREPRESENTANTE
                                  and rg.idrepresentante = :P135_IDREPRESENTANTE
                                  and rg.idregiaovenda = :IDREGIAOVENDA;
                            exception
                                when others then
                                    l_idregiaovenda := 9999999;
                                    l_valoragregado := null;
                            end;
                
                            if l_valoragregado_registro != regexp_replace(:VALORAGREGADO, '[.;]', '') and l_idregiaovenda_registro = :IDREGIAOVENDA then
                                l_count := 0;
                            elsif l_idregiaovenda_registro = :IDREGIAOVENDA then
                                l_count := 0;
                            elsif l_idregiaovenda = :IDREGIAOVENDA then
                                l_count := 1;
                            end if;
                        end;
                    end if;
                
                    l_existe := l_count > 0;
                
                    return not l_existe;
                
                end;
                ```
        }
        error {
            errorMessage: Região já cadastrada para este distribuidor. Verifique as regiões informadas.
            associatedColumn: IDREGIAOVENDA
        }
    )

    validation duplicidade-semana (
        name: Duplicidade Semana
        execution {
            sequence: 80
        }
        validation {
            editableRegion: @regiões-que-atende
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                    l_count                     number;
                    l_existe                    boolean;
                
                    l_semana_registro           varchar2(10);
                    l_valoragregado_registro    number(15,2);
                
                    l_semana                    varchar2(10);
                    l_valoragregado             number(15,2);
                begin
                
                    if :APEX$ROW_STATUS = 'C' then
                        begin
                            select count(1)
                            into l_count
                            from roman.REGIOESREPRESENTANTES rg
                            where rg.idrepresentante = :P135_IDREPRESENTANTE
                              and rg.semana = :SEMANA;
                        exception
                            when others then
                                l_count := 0;
                        end;
                    else 
                        begin
                            select semana
                                 , valoragregado
                            into l_semana_registro
                               , l_valoragregado_registro
                            from roman.REGIOESREPRESENTANTES rg
                            where rg.idregiaorepresentante = :IDREGIAOREPRESENTANTE;
                
                            begin
                                select semana
                                     , valoragregado
                                into l_semana
                                   , l_valoragregado
                                from roman.REGIOESREPRESENTANTES rg
                                where rg.idregiaorepresentante != :IDREGIAOREPRESENTANTE
                                  and rg.idrepresentante = :P135_IDREPRESENTANTE
                                  and rg.semana = :SEMANA;
                            exception
                                when others then
                                    l_semana := '99/2000';
                                    l_valoragregado := null;
                            end;
                
                            if l_valoragregado_registro != regexp_replace(:VALORAGREGADO, '[.;]', '') and l_semana_registro = :SEMANA then
                                l_count := 0;
                            elsif l_semana_registro = :SEMANA then
                                l_count := 0;
                            elsif l_semana = :SEMANA then
                                l_count := 1;
                            end if;
                        end;
                    end if;
                
                    l_existe := l_count > 0;
                
                    return not l_existe;
                
                end;
                ```
        }
        error {
            errorMessage: Semana já cadastrada para este distribuidor. Verifique as semanas informadas.
            associatedColumn: SEMANA
        }
    )

