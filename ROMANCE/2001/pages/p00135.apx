        column BLOQUEIOUSOTABLET (
            type: selectList
            heading {
                heading: Bloq. Tablet sem Enviar Dados
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            source {
                databaseColumn: BLOQUEIOUSOTABLET
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            serverSideCondition {
                type: expression
                plsqlExpression: :P0_IDFILIAL in (100,1082,1071,1089,1090,1106,1132,124,122,320,221)
            }
        )

        column CONFG_PRECIFICACAO (
            type: link
            heading {
                heading: Configurar Precificação
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            link {
                target: {
                    page: 834
                    items: {
                        P834_IDREGIAOREPRESENTANTE: &IDREGIAOREPRESENTANTE.
                        P834_IDREPRESENTANTE: &IDREPRESENTANTE.
                        P834_IDREGIAOVENDA: &IDREGIAOVENDA.
                        P834_ORIGEM: REPRESENTANTE
                    }
                    clearCache: 834
                    request: ATALHO
                }
                linkText: <img src="#APEX_FILES#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                type: none
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1
                    FROM ROMAN.PARAMETROS P
                    WHERE P.NOME = 'PRECIFICACAOCATEGORIAFILIAL'
                      AND P.VALOR = 'S'
                      AND P.IDFILIAL = :P0_IDFILIAL
                    
                    --select 1
                    --from dual
                    --where :P0_IDFILIAL in (221, 140) -- 140 Manaus / 221 Santarem
                    
                    -- 16184715
                    -- Ir adicionando aqui as filiais que aderirem a nova forma de precificação, 
                    -- essa validação garante que o cmpo nao apareça para quem ainda nao esta no novo esquema
                    ```
            }
        )

        column IDREGIAOREPRESENTANTE (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDREGIAOREPRESENTANTE
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDREGIAOREPRESENTANTE
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDREGIAOVENDA (
            type: popupLov
            heading {
                heading: Região de Venda
                alignment: center
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(r.descricao)||' - '||e.sigla||' ('|| r.idregiaovenda||')'     display_value
                         , r.idregiaovenda return_value
                    from regioesvenda r
                       , estados e
                    where r.ativo = 'S'
                      and r.idestado = e.idestado
                      and r.idestado in ( select f.idestado
                                          from filiaisregioesvenda f
                                             , catal.gerentes  g
                                             , catal.representantes rr
                                          where f.idfilial  = g.idfilial
                                            and g.idgerente = rr.idgerente
                                            and rr.idrepresentante = :P135_IDREPRESENTANTE )
                    order by 1
                    ```
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDREGIAOVENDA
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

