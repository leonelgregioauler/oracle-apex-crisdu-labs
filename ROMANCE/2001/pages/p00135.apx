    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDREPRESENTANTE.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end;
                  --
                  function get_idsemana return number is
                  begin
                    for c1 in ( select idsemana 
                                from fechamentossemanais f
                                where f.idfechamento = ( select max(idfechamento)
                                                         from fechamentossemanais fs
                                                         where fs.idfilial = :P0_IDFILIAL
                                                           and fs.concluido = 'N' ) )
                    loop
                      return c1.idsemana;
                    end loop;
                  end;
                  --
                begin 
                  :P135_IDREPRESENTANTE := get_pk; 
                  :P135_IDSEMANABALANCO := get_idsemana;
                  :P135_QTDINICIALBALANCO := 0;
                  :P135_VALORINICIALBALANCO := 0;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 11205586467707348
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process inativa-equipamentos-do-distribuidor (
        name: Inativa Equipamentos do Distribuidor
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P135_ATIVO = 'N' then
                    --
                    update equipamentos e
                    set e.situacao = 'I'
                    where e.usuario = ( select usuario
                                        from catal.representantes r
                                           , catal.usuarios u
                                        where r.idpessoa = u.idpessoa
                                          and r.idrepresentante = :P135_IDREPRESENTANTE );
                    --
                    commit;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1585703996103339342
        }
        serverSideCondition {
            type: never
        }
    )

