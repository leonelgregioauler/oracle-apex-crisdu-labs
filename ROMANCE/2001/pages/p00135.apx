    pageItem P135_SEMANAPAROU (
        type: selectList
        label {
            label: Semana Cobrança Parou
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                  from ( SELECT s.semanacompleta display_value
                              , s.idsemana return_value
                           FROM roman.semana_dias s
                          WHERE s.ano between extract(year from sysdate) - 2 and extract(year from sysdate) + 1
                            AND EXISTS ( select 1
                                           from roman.usuariosgruposatendimento u
                                          where upper(u.usuario) = upper(:APP_USER)
                                            and u.idgrupoatendimento in (0,2) )
                         UNION ALL
                         SELECT MAX(s.semanacompleta)
                              , MAX(s.idsemana)
                           FROM roman.semana_dias s
                              , roman.fechamentossemanais f
                          WHERE f.idsemana = s.idsemana
                            AND f.idfilial = :P135_IDFILIAL
                            AND f.concluido = 'N'
                            AND NOT EXISTS ( select 1
                                               from roman.usuariosgruposatendimento u
                                              where upper(u.usuario) = upper(:APP_USER)
                                                and u.idgrupoatendimento in (0,2) ) )
                 order by return_value
                ```
            displayNullValue: false
        }
        layout {
            sequence: 85
            region: @cadastro-de-distribuidor
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
