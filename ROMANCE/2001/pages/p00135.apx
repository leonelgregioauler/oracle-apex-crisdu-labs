page 135 (
    name: Cadastro de Distribuidor
    title: Cadastro de Distribuidor
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    headerAndFooter {
        footerText:
            ```html
            <script javascript>
             window.resizeTo(screen.width*.90,screen.height*.90);  
                window.moveTo(screen.width*.1, screen.height*.30);  
            </script>
            ```
    }
    security {
        formAutoComplete: true
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-distribuidor (
        name: Cadastro de Distribuidor
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region regiões-que-atende (
        name: Regiões que Atende
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDREGIAOREPRESENTANTE
                     , IDREPRESENTANTE
                     , IDREGIAOVENDA
                     , ORDEM
                     , SEMANA
                     , VALORAGREGADO
                     , LIBERACADASTROSEMCONSULTA
                     , BLOQUEIOUSOTABLET
                     , USAPRECIFICACAOCATEGORIA
                     , case 
                         when USAPRECIFICACAOCATEGORIA = 'S' then
                              '<a href="' ||
                              apex_page.get_url(
                                  p_page   => 834,
                                  p_items  => 'P834_IDREGIAOREPRESENTANTE',
                                  p_values => IDREGIAOREPRESENTANTE
                              ) ||
                              '">Configurar</a>'
                         else
                              null
                       end as CONFG_PRECIFICACAO
                from REGIOESREPRESENTANTES
                where idrepresentante = :P135_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 20
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <font color="RED" >Nunca altere a ordem ou a semana manualmente, altere o nome da região.<br>
                Automaticamente as notas e vendedoras da semana alterada mudarão para a nova região.<br>
                <h3>Ao excluir uma linha, os registros de precificação por categoria dessa região também serão apagados.</h3></font> 
                ```
            footerText:
                ```html
                <div style="margin-top:2%">
                <font color="GREEN" size="6">
                A troca de regiões só será possível quando o distribuidor estiver já feito o sync da semana atual!
                </font>
                </div> 
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P135_IDREPRESENTANTE
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 11987339892991817
        }

