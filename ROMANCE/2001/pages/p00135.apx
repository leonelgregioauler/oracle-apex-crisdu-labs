    validation valida-semana-do-distribuidor-liberada (
        name: Valida Semana do Distribuidor Liberada
        execution {
            sequence: 90
        }
        validation {
            editableRegion: @regiões-que-atende
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                    l_count                     number;
                    l_existe                    boolean;
                begin
                
                    begin
                        select count(1)
                        into l_count
                        from dual
                        where not exists (select 1
                                          from imptablettoservidor
                                          where idrepresentante = :P135_IDREPRESENTANTE)
                         or ( select processo
                                from ( select *
                                        from imptablettoservidor
                                        where idrepresentante = :P135_IDREPRESENTANTE
                                        order by 1 desc) a
                                where rownum = 1 ) = 'S';
                    exception
                        when others then
                            l_count := 0;
                    end;
                    
                    l_existe := l_count > 0;
                
                    return l_existe;
                
                end;
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Distribuidor com semana liberada. Alteração não pode ser realizada.
        }
    )

