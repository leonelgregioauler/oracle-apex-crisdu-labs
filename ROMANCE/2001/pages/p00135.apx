        column SEMANA (
            type: selectList
            heading {
                heading: Semana
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select trim(to_char(semana,'00')||'/'||ano) display_value
                         , trim(to_char(semana,'00')||'/'||ano) return_value
                    from semana_dias s
                    where idsemana >= ( select idsemana - 6
                                        from semana_dias ss
                                        where trunc(sysdate) between ss.dt_ini and ss.dt_fim )
                      and idsemana <= ( select idsemana + 12
                                        from semana_dias ss
                                        where trunc(sysdate) between ss.dt_ini and ss.dt_fim )
                    order by s.ano
                           , s.semana
                    ```
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                databaseColumn: SEMANA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

