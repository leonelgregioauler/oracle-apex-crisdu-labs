page 203 (
    name: REDEFINIR SENHA
    title: " Redefinir Senha"
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region redefinir-senha (
        name: Redefinir senha
        type: staticContent
        source {
            htmlCode:
                ```html
                <font color="red">Informe o seu usuário!<br>
                Será enviado um email com o link para a troca de senha.</font> 
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    pageItem P203_USUARIO (
        type: textField
        label {
            label: Usuário
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @redefinir-senha
            slot: regionBody
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 4000
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button p203-envia-email (
        buttonName: P203_ENVIA_EMAIL
        label: Enviar Email
        layout {
            sequence: 20
            region: @redefinir-senha
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: P203_ENVIA_EMAIL
        }
    )

    dynamicAction envia-email-para-trocar-senha (
        name: Envia email para trocar senha
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @p203-envia-email
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: P203_ENVIA_EMAIL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process envia-email-para-trocar-senha (
        name: Envia email para trocar senha
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                pck_auditoriaromance.prc_redefinesenha(pusuario => :P203_USUARIO);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 374363478117174018
        }
    )

)

