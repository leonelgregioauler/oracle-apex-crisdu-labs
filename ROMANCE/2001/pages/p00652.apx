page 652 (
    name: Acompanhamento SMS
    title: Acompanhamento SMS
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-sms (
        name: Acompanhamento SMS
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select distinct (n.idnegociacaoparceiro) Negociação
                      , roman.pck_romance.fnc_nomefilial(n.idfilial) Franquia
                      , roman.pck_romance.fnc_cpfvendedora(v.idvendedora) CPF
                      , roman.pck_romance.fnc_nomevendedora(v.idvendedora) Empreendedora
                      , roman.pck_romance.fnc_retornatelefones(v.idvendedora)Telefone
                      , n.valornegociacao Valor_Débito
                      , p.numeroparcela
                      , p.valorparcela 
                      ,('Enviada ' || max(m.dataenvio)) SMS
                      , decode(p.situacao,'E','Em Espera','A','Aberto','V','Vencido','Q','Quitado','C','Cancelado') Situação
                 from roman.negociacoesparceiros n
                    , catal.vendedoras v
                    , roman.mensagenssms m
                    , roman.pagamentosnegociacoesparceiros p 
                 where v.idvendedora = n.idvendedora
                   and m.idpessoa = v.idpessoa 
                   and p.idnegociacaoparceiro = n.idnegociacaoparceiro
                   and m.idprocessosistema = 40
                  -- and (n.datanegociacao is null or n.datanegociacao between to_date(:P652_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P652_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                   --and (n.datanegociacao is null or n.datanegociacao between to_date(:P652_DATAINICIO||'00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P652_DATAFIM||'23:59:59','DD/MM/RRRR HH24:MI:SS'))
                   --
                   and (:P652_TIPODATA = 'A' and m.dataenvio between to_date(:P652_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P652_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                             and n.datanegociacao between to_date(:P652_DATAINICIO||'00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P652_DATAFIM||'23:59:59','DD/MM/RRRR HH24:MI:SS')
                      or :P652_TIPODATA = 'E' and m.dataenvio between to_date(:P652_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P652_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                      or :P652_TIPODATA = 'N' and n.datanegociacao between to_date(:P652_DATAINICIO||'00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P652_DATAFIM||'23:59:59','DD/MM/RRRR HH24:MI:SS'))
                   --
                   and ( :P652_IDFILIAL is null or n.idfilial = :P652_IDFILIAL )
                   and ( :P652_IDREPRESENTANTE is null or v.idrepresentante = :P652_IDREPRESENTANTE )
                   and ( :P652_IDVENDEDORA is null or v.idvendedora = :P652_IDVENDEDORA )
                   and ( :P652_IDNEGOCIACAO is null or n.idnegociacaoparceiro = :P652_IDNEGOCIACAO)
                   and ( :P652_PARCELAS = 2 
                      or :P652_PARCELAS = 1 and p.numeroparcela = 1)
                   and :P652_FILTRAR = 'S'
                group by n.idnegociacaoparceiro,n.idfilial,v.idvendedora,n.valornegociacao,p.situacao,p.numeroparcela,p.valorparcela 
                order by 2,3,6
                 
                 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 32473145744541144
        }

        column CPF (
            type: plainText
            heading {
                heading: CPF
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column EMPREENDEDORA (
            type: plainText
