            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P652_TIPODATA (
        type: radioGroup
        label {
            label: Pesquisa Por
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Data Negociação;N,Data Envio SMS;E,Ambas;A
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @page_plug
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        source {
            type: staticValue
            staticValue: A
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 90
            region: @page_plug
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 652
                items: {
                    P652_IDFILIAL: &P652_IDFILIAL.
                    P652_IDREPRESENTANTE: &P652_IDREPRESENTANTE.
                    P652_IDVENDEDORA: &P652_IDVENDEDORA.
                    P652_FILTRAR: S
                }
                action: resetPagination
            }
        }
    )

)

