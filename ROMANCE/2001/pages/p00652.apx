            )

        )

    )

    region page_plug (
        name: --
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P652_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 30
            region: @page_plug
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P652_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 20
            region: @page_plug
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P652_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @page_plug
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P652_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and exists ( select 1
                               from usuariosfiliais uf
                               where uf.idfilial = f.idfilial
                                 and uf.usuario  = v('APP_USER') )
                ```
        }
        layout {
            sequence: 40
            region: @page_plug
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P652_IDNEGOCIACAO (
        type: textField
        label {
            label: Id Negociação
            alignment: left
        }
        layout {
            sequence: 70
            region: @page_plug
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P652_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||decode(r.ativo,'S','Ativo','N','Inativo') d
                     , r.idrepresentante r
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente
                  and ( :P652_IDFILIAL is null or g.idfilial = :P652_IDFILIAL)
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P652_IDFILIAL
        }
        layout {
            sequence: 50
            region: @page_plug
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P652_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' CPF: '||p.cpf d
                     , v.idvendedora r
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and ( :P652_IDREPRESENTANTE is null or v.idrepresentante = :P652_IDREPRESENTANTE )
                  and ( :P652_IDFILIAL is null or v.idfilial = :P652_IDFILIAL )
                order by 1
                ```
        }
        layout {
            sequence: 60
            region: @page_plug
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P652_PARCELAS (
        type: selectList
        label {
            label: Parcelas
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Parcela 1;1,Todas;2
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @page_plug
            slot: regionBody
            alignment: left
        }
        appearance {
