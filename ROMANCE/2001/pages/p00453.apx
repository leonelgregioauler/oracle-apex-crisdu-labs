        layout {
            sequence: 20
            region: @informações-do-distribuidor
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(max(i.data),'DD/MM/RRRR HH24:MI:SS') data
                from imptablettoservidor i
                where i.idrepresentante = :P453_IDREPRESENTANTE
                  and i.processo = 'S'
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P453_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||'('||decode(r.ativo,'S','Ativo','N','Inativo')||') - Ult. Balanço: '||pck_util.fnc_semanaid( r.idsemanabalanco ) display_value
                     , r.idrepresentante return_value
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente
                  and g.idfilial = :P0_IDFILIAL
                order by 1
                ```
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P453_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00'))||'/'||ano||' - ( '||to_char(dt_ini,'DD/MM/RRRR')||' - '||to_char(dt_fim,'DD/MM/RRRR')||' ) ' display_value
                     , idsemana return_value
                from semana_dias s
                where s.idsemana = ( select idsemana
                                     from regioesrepresentantes rr
                                     where rr.idrepresentante = :P453_IDREPRESENTANTE
                                       and rr.idsemana = ( select max(t.idsemana)
                                                           from imptablettoservidor t
                                                           where t.processo = 'S'
                                                             and t.idrepresentante = rr.idrepresentante ) + 1 )
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione -
        }
        cascadingLov {
            parentItems: P453_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            region: @iniciar-balanço
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P453_QTD_VALOR (
        type: radioGroup
        label {
            label: Colunas
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Quantidade'
                     , 'Q'
                from dual
                union 
                select 'Valor'
                     , 'V'
                from dual
                where pck_util.fnc_verificaacesso(2568,v('APP_USER')) = 'S'
                union
                select 'Ambos'
                     , 'A'
                from dual
                where pck_util.fnc_verificaacesso(2568,v('APP_USER')) = 'S'
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Q
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P453_SEMANA_ATUAL (
        type: displayOnly
        label {
            label: Semana Atual para Atendimento
            alignment: left
        }
        layout {
            sequence: 30
            region: @informações-do-distribuidor
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select pck_util.fnc_semanaid(min(rr.idsemana)) semana
                from regioesrepresentantes rr
                where rr.idrepresentante = :P453_IDREPRESENTANTE
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P453_SEMANA_INICIO_EMPRESA (
        type: displayOnly
        label {
            label: Semana que Iniciou na Empresa
            alignment: left
