            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P453_IDREPRESENTANTE is not null
                  and exists ( select *
                               from negociacoesbalanco nb
                               where nb.idrepresentante = :P453_IDREPRESENTANTE
                                 and nb.valor           > 0 )
                ```
        }
    )

    region produto-com-comissão (
        name: Produto Com Comissão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ first_rows (50) */ produto
                     , ativo
                     , comissao
                     , vlrvenda
                     , '|' separador
                     , qtdbalancoinicial
                     , valorbalancoinicial
                     , '+' sep_balancoinicial
                     , carga
                     , vlrcarga
                     , '-' sep_devol
                     , devolucao
                     , vlrdevolucao
                     , '-' sep_vend
                     , vendido
                     , vlrvendido
                     , '-' sep_foiparaoutro
                     , qtddevolveufoioutro
                     , valordevolveufoioutro
                     , '+' sep_veiodeoutro
                     , qtddevolveuveiooutros
                     , valordevolveuveiooutros
                     , '-' sep_aberto
                     , acobrar
                     , vlracobrar
                     , '=' sep_result
                     , ( qtdbalancoinicial
                       + carga
                       - devolucao
                       - vendido
                       - qtddevolveufoioutro
                       + qtddevolveuveiooutros
                       - acobrar ) qtdresultado
                     , ( nvl(valorbalancoinicial,0)
                       + nvl(vlrcarga,0)
                       - nvl(vlrdevolucao,0)
                       - nvl(vlrvendido,0)
                       - nvl(valordevolveufoioutro,0)
                       + nvl(valordevolveuveiooutros,0)
                       - nvl(vlracobrar,0) ) vlrresultado
                from vw_balancoprodutos_repres_com w
                where idrepresentante = :P453_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 90
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent13
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P453_TIPO = 'P' and ( :P453_COMISSAO = 'S' or :P453_COMISSAO = 'A' )
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
