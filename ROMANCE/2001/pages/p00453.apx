    pageItem P453_DATA_ULTIMA_IMPORTACAO (
        type: displayOnly
        label {
            label: Ultima Importação Realizada
            alignment: left
        }
        layout {
            sequence: 40
            region: @informações-do-distribuidor
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 'Semana: '||im.semana||' Liberado em '||to_char(im.data,'DD/MM/RRRR HH24:MI:SS') dado
                from imptablettoservidor im
                where im.idimp = ( select max(i.idimp)
                                   from imptablettoservidor i
                                   where i.idrepresentante = :P453_IDREPRESENTANTE
                                     and i.processo = 'L' );
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P453_DATA_ULTIMO_SYNC (
        type: displayOnly
        label {
            label: Ultima Sincronização Realizada
