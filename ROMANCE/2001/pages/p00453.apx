    region balanço-detalhado-v3-0-com-comissão (
        name: Balanço Detalhado v3.0 Com Comissão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distribuidor
                   , semana
                   , carga        
                   , valorcarga     valorcarga
                   , '-' s1
                   , devolucao
                   , valordevolucao    valordevolucao
                   , '-' s2
                   , vendeu
                   , valorvendeu      valorvendeu
                   , '-' s3
                   , emaberto
                   , valoremaberto      valoremaberto
                   , '-' s7
                   , w.qtddevolveufoioutro
                   , w.valordevolveufoioutro
                   , '+' s8
                   , w.qtddevolveuveiooutros
                   , w.valordevolveuveiooutros
                   , '=' s4
                   , faltadevolver
                   , w.valorfaltadevolver valorfaltadevolver
                   , '|' s5
                   , ( select sum(w1.faltadevolver)
                       from vw_balanco_romance_v3_com w1
                       where w1.idrepresentante = w.idrepresentante
                         and w1.idsemana       <= w.idsemana ) qtdsaldoparcial
                   , ( select sum(w1.valorfaltadevolver)
                       from vw_balanco_romance_v3_com w1
                       where w1.idrepresentante = w.idrepresentante
                         and w1.idsemana       <= w.idsemana ) valorsaldoparcial
                   , '|' s6
                   , '-' s9
                   , w.qtdnotafalsa qtdnotasfalas
                   , w.valornotafalsa valornotasfalsas
                from vw_balanco_romance_v3_com w
                where idrepresentante = :P453_IDREPRESENTANTE
                
                ```
        }
        layout {
            sequence: 70
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P453_TIPO = 'T'
                  and ( :P453_COMISSAO = 'S'
                      or :P453_COMISSAO = 'A' )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            sort: false
            controlBreak: false
            chart: false
            groupBy: false
            pivot: false
            flashback: false
        }
        advanced {
            savedReportMappingIdentifier: 5984253607287336197
        }

