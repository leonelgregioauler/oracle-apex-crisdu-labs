    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            
            function fnc_popup_representante(vidrepresentante)
            { njan =   window.open('f?p=&APP_ID.:135:&SESSION.::NO::P135_IDREPRESENTANTE:'+vidrepresentante ,'rep', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=500,left=250,top=100','_blank'); void(0);
            njan.focus();
            }
            ```
    }
    security {
