                            , valordevolveuveiooutros
                            , acobrar
                            , vlracobrar vlrcobrar
                            , ( qtdbalancoinicial
                              + carga
                              - devolucao
                              - vendido
                              - qtddevolveufoioutro
                              + qtddevolveuveiooutros
                              - acobrar ) qtdresultado
                            , ( nvl(valorbalancoinicial,0)
                              + nvl(vlrcarga,0)
                              - nvl(vlrdevolucao,0)
                              - nvl(vlrvendido,0)
                              - nvl(valordevolveufoioutro,0)
                              + nvl(valordevolveuveiooutros,0)
                              - nvl(vlracobrar,0) ) vlrresultado
                       from vw_balancoprodutos_repres_sem w
                       where w.idrepresentante = :P453_IDREPRESENTANTE ) prod
                where prod.idcategoria(+) = c.idcategoria
                group by c.idcategoria 
                order by 1
                ```
        }
        layout {
            sequence: 120
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
