        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

    button confirmar (
        buttonName: CONFIRMAR
        label: Confirmar
        layout {
            sequence: 30
            region: @iniciar-balanço
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button p453-balancosanteriores (
        buttonName: P453_BALANCOSANTERIORES
        label: Ver Balan. Anteriores
        layout {
            sequence: 50
            region: @filtro
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 506
                items: {
                    P506_IDREPRESENTANTE: &P453_IDREPRESENTANTE.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from balancocongelado b
                               where b.idrepresentante = :P453_IDREPRESENTANTE )
                  and pck_util.fnc_verificaacesso(2096,v('APP_USER')) = 'S'
                ```
        }
    )

    button p453-filtrar (
        buttonName: P453_FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtro
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: P209_FILTRAR
        }
    )

    button p453-iniciarnovobalanco (
        buttonName: P453_INICIARNOVOBALANCO
        label: Iniciar Novo Balanço
        layout {
            sequence: 10
            region: @filtro
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: openModal('INICIARBALANCO');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: pck_util.fnc_verificaacesso(2563,v('APP_USER')) = 'S' and :P453_IDREPRESENTANTE is not null
        }
    )

    button p453-verbalancoatual (
        buttonName: P453_VERBALANCOATUAL
        label: Ver Balanço Inicial Atual
        layout {
            sequence: 20
            region: @filtro
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 403
                items: {
                    P403_IDREPRESENTANTE: &P453_IDREPRESENTANTE.
                    P403_PAGINA: 453
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P453_IDREPRESENTANTE
        }
    )

    button p453-vercadastro (
        buttonName: P453_VERCADASTRO
        label: Ver Cadastro
        layout {
            sequence: 30
            region: @filtro
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 135
                items: {
                    P135_IDREPRESENTANTE: &P453_IDREPRESENTANTE.
                    P135_PAGINA: 381
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    dynamicAction confirma-balanço (
        name: Confirma Balanço
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @confirmar
        }

        action native-confirm (
            action: confirm
            settings {
                message:
                    ```html
                    Confirma o Balanço deste distribuidor?
                    
                    Isto pode demorar alguns minutos.
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CONFIRMABALANCO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction filtrar (
        name: filtrar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @p453-filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction filtro (
        name: filtro
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P453_FILTRO
        }
        clientSideCondition {
            type: item=value
            item: P453_FILTRO
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P453_IDREPRESENTANTE
                    P453_TIPO
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P453_IDREPRESENTANTE
                    P453_TIPO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    validation valida-semana (
        name: Valida Semana
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P453_IDSEMANA
        }
        error {
            errorMessage: Informe a Semana!
            associatedItem: @P453_IDSEMANA
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMABALANCO
        }
    )

    process confirma-balanço (
        name: Confirma Balanço
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidusuario    number;
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios 
                  where usuario = v('APP_USER');
                  --
                  pck_balanco_rmc.prc_novobalanco(pidrepresentante => :P453_IDREPRESENTANTE,
                                                  pidsemana => :P453_IDSEMANA,
                                                  pidusuario => vidusuario,
                                                  pidfilial => :P0_IDFILIAL);
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2808946170098033248
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMABALANCO
        }
    )

    branch (
        name: filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 453
                items: {
                    P453_FILTRO: &P453_FILTRO.
                    P453_IDREPRESENTANTE: &P453_IDREPRESENTANTE.
                    P453_TIPO: &P453_TIPO.
                    P453_QTD_VALOR: &P453_QTD_VALOR.
                    P453_COMISSAO: &P453_COMISSAO.
                }
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @p453-filtrar
        }
    )

)

