    region balanço-resumido-v3-0-com-comissão (
        name: Balanço Resumido v3.0 Com Comissão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distribuidor
                     , pck_util.fnc_semanaid(w.idsemanabalanco) semana
                     , sum(nvl(QTDINICIALBALANCO_COM,0)) qtdbalancoinicial
                     , sum(nvl(valorinicialbalanco,0)) balancoinicial
                     , '+' s0
                     , sum(carga                ) carga
                     , sum(valorcarga           ) valorcarga
                     , '-' s1               
                     , sum(devolucao            ) devolucao
                     , sum(valordevolucao       ) valordevolucao
                     , '-' s2               
                     , sum(vendeu               ) vendeu
                     , sum(valorvendeu          ) valorvendeu
                     , '-' s3               
                     , sum(emaberto             ) emaberto
                     , sum(valoremaberto        ) valoremaberto
                     , '+' s6
                     , sum(qtddevolveuveiooutros)   qtddevolveuveiooutros
                     , sum(valordevolveuveiooutros) valordevolveuveiooutros
                     , '-' s7
                     , sum(qtddevolveufoioutro)    qtddevolveufoioutro
                     , sum(valordevolveufoioutro)  valordevolveufoioutro
                     , '=' s4               
                     , sum(faltadevolver        ) faltadevolver
                     , case
                         when sum(faltadevolver) > 0 and sum(w.valorfaltadevolver) < 0 then
                           sum(w.valorfaltadevolver)*-1
                         else
                           sum(w.valorfaltadevolver )
                       end valorfaltadevolver
                     , '|' s5               
                     , '-' s8
                     , sum(w.qtdnotafalsa) qtdnotasfalas
                     , sum(w.valornotafalsa) valornotasfalsas
                from vw_balanco_romance_v3_com w
                where  w.idrepresentante = :P453_IDREPRESENTANTE 
                  and w.idgerente = ( select idgerente 
                                      from gerentes
                                      where idfilial = :P0_IDFILIAL )
                group by distribuidor, w.idsemanabalanco
                     , w.idrepresentante
                
                ```
        }
        layout {
            sequence: 50
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P453_TIPO = 'R' and ( :P453_COMISSAO = 'S' or :P453_COMISSAO = 'A' )
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            savePublicReport: true
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 5981176482285759774
        }

