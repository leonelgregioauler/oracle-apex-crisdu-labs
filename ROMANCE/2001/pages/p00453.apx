    region categoria-com-comissão (
        name: Categoria Com Comissão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomecategoria(c.idcategoria) categoria
                     , '|' separador
                     , sum(nvl(prod.qtdbalancoinicial,0)) qtdbalancoinicial
                     , sum(nvl(prod.valorbalancoinicial,0)) valorbalancoinicial
                     , '+' seq_balanco
                     , sum(nvl(prod.carga,0)) carga
                     , sum(nvl(prod.vlrcarga,0)) vlrcarga
                     , '-' sep_devol
                     , sum(nvl(prod.devolucao,0)) devolucao
                     , sum(nvl(prod.vlrdevolucao,0)) vlrdevolucao
                     , '-' sep_vend
                     , sum(nvl(prod.vendido,0)) vendido
                     , sum(nvl(prod.vlrvendido,0)) vlrvendido
                     , '-' sep_foiparaoutro
                     , sum(nvl(prod.qtddevolveufoioutro,0)) qtddevolveufoioutro
                     , sum(nvl(prod.valordevolveufoioutro,0)) valordevolveufoioutro
                     , '+' sep_veiodeoutro
                     , sum(nvl(prod.qtddevolveuveiooutros,0)) qtddevolveuveiooutros
                     , sum(nvl(prod.valordevolveuveiooutros,0)) valordevolveuveiooutros
                     , '-' sep_aberto
                     , sum(nvl(prod.acobrar,0)) acobrar
                     , sum(nvl(prod.vlracobrar,0)) vlrcobrar
                     , '=' sep_resultado
                     , sum(nvl(prod.qtdresultado,0)) qtdresultado
                     , sum(nvl(prod.vlrresultado,0)) vlrresultado
                from categorias c
                   , ( select idcategoria
                            , qtdbalancoinicial
                            , valorbalancoinicial
                            , carga
                            , vlrcarga
                            , devolucao
                            , vlrdevolucao
                            , vendido
                            , vlrvendido
                            , qtddevolveufoioutro 
                            , valordevolveufoioutro
                            , qtddevolveuveiooutros 
                            , valordevolveuveiooutros
                            , acobrar
                            , vlracobrar
                            , ( qtdbalancoinicial
                              + carga
                              - devolucao
                              - vendido
                              - qtddevolveufoioutro
                              + qtddevolveuveiooutros
                              - acobrar ) qtdresultado
                            , ( nvl(valorbalancoinicial,0)
                              + nvl(vlrcarga,0)
                              - nvl(vlrdevolucao,0)
                              - nvl(vlrvendido,0)
                              - nvl(valordevolveufoioutro,0)
                              + nvl(valordevolveuveiooutros,0)
                              - nvl(vlracobrar,0) ) vlrresultado
                       from vw_balancoprodutos_repres_com w
                       where w.idrepresentante = :P453_IDREPRESENTANTE ) prod
                where prod.idcategoria(+) = c.idcategoria
                group by c.idcategoria 
                order by 1
                ```
        }
        layout {
            sequence: 110
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent11
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P453_TIPO = 'C' and ( :P453_COMISSAO = 'S' or :P453_COMISSAO = 'A' )
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4313052926876090011
        }

