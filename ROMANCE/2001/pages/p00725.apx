    region vinculados (
        name: Vinculados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Ticket 16900980 - vinculo N para N: lista os vinculos do documento pesquisado (ativos primeiro, inativos como log)
                -- VE (Vinculante): vinculados do documento | VO (Vinculado): vinculantes do documento
                select (select p.idpessoa
                          from pessoas p
                         where p.cpf = v.cpfpessoavinculada)  as "ID Pessoa Vinculada", 
                       initcap(lower((select p.nomepessoa
                                        from pessoas p
                                       where p.cpf = v.cpfpessoavinculada))) as "Nome Pessoa Vinculada",
                       v.cpfpessoavinculada as "Documento",
                       v.cpfpessoavinculante as "Documento Vinculante",
                       initcap(lower((select p.nomepessoa
                                        from pessoas p
                                       where p.cpf = v.cpfpessoavinculante))) as "Nome Pessoa Vinculante",
                       v.datavinculacao  as "Data Vinculação",
                       v.datadesvinculacao  as "Data Desvinculação",
                       case when v.datadesvinculacao is null then 'Ativo' else 'Inativo' end as "Situação",
                       v.usuarioalterou as "Usuário Alteração"
                  from roman.vinculodebito v
                 where :P725_CPF is not null
                   and ( :P725_PESQUISA_POR = 'VE' and v.cpfpessoavinculante = :P725_CPF or 
                         :P725_PESQUISA_POR = 'VO' and v.cpfpessoavinculada  = :P725_CPF )
                 
                union all
                
                select (select p.idpessoa
                          from pessoas p
                         where p.documentoestrangeiro = v.docextpessoavinculada)  as "ID Pessoa Vinculada", 
                       initcap(lower((select p.nomepessoa
                                        from pessoas p
                                       where p.documentoestrangeiro = v.docextpessoavinculada))) as "Nome Pessoa Vinculada",
                       v.docextpessoavinculada as "Documento",
                       v.docextpessoavinculante as "Documento Vinculante",
                       initcap(lower((select p.nomepessoa
                                        from pessoas p
                                       where p.documentoestrangeiro = v.docextpessoavinculante))) as "Nome Pessoa Vinculante",
                       v.datavinculacao  as "Data Vinculação",
                       v.datadesvinculacao  as "Data Desvinculação",
                       case when v.datadesvinculacao is null then 'Ativo' else 'Inativo' end as "Situação",
                       v.usuarioalterou as "Usuário Alteração"
                  from roman.vinculodebito v
                 where :P725_RUT is not null
                   and ( :P725_PESQUISA_POR = 'VE' and v.docextpessoavinculante = :P725_RUT or 
                         :P725_PESQUISA_POR = 'VO' and v.docextpessoavinculada  = :P725_RUT )
                order by 7 desc nulls first, 6 desc
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
