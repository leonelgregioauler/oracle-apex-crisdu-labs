                ```sql
                -- Ticket 16900980 - regiao exibida apenas na pesquisa por Vinculante (VE)
                select case
                        when :P725_CPF is not null then
                        ( select initcap(lower(favorita.pck_util_fav.fnc_nomepessoa(p.idpessoa)))
                          from pessoas p
                         where p.cpf = :P725_CPF
                           and exists( select 1
                                       from roman.vinculodebito v
                                      where v.cpfpessoavinculante = :P725_CPF
                                        and v.datadesvinculacao is null))
                        when :P725_RUT is not null then
                        ( select initcap(lower(favorita.pck_util_fav.fnc_nomepessoa(p.idpessoa)))
                          from pessoas p
                         where p.documentoestrangeiro = :P725_RUT
                           and exists( select 1
                                       from roman.vinculodebito v
                                      where v.docextpessoavinculante = :P725_RUT
                                        and v.datadesvinculacao is null))
                         end "Nome Pessoa Vinculante"
                 from dual
                ```
            used: always
        }
