    process desnvincular-cpf (
        name: DESNVINCULAR CPF
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Ticket 16900980 - vinculo N para N: desvincula apenas o par informado e somente o vinculo ativo
                  if :P725_DOC_VINCULANTE_EDIT is null or :P725_DOC_VINCULADO_EDIT is null then
                    apex_error.add_error(
                        p_message => 'Atenção! Verifique os campos <span style="color : red ">DOC Vinculante</span> e <span style="color : red ">DOC Vinculado</span>, os dois precisam ser informados!',
                        p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  update roman.vinculodebito vd
                     set vd.datadesvinculacao = trunc(sysdate),
                         vd.usuarioalterou    = v('APP_USER')
                   where vd.datadesvinculacao is null
                     and ( (:P725_TIPODOC = 'C' and vd.cpfpessoavinculante    = :P725_DOC_VINCULANTE_EDIT
                                                and vd.cpfpessoavinculada     = :P725_DOC_VINCULADO_EDIT)
                        or (:P725_TIPODOC = 'D' and vd.docextpessoavinculante = :P725_DOC_VINCULANTE_EDIT
                                                and vd.docextpessoavinculada  = :P725_DOC_VINCULADO_EDIT) );
                
                  if sql%rowcount = 0 then
                    apex_error.add_error(
                        p_message => 'Nenhum vínculo ativo encontrado entre o DOC Vinculante e o DOC Vinculado informados.',
                        p_display_location => apex_error.c_inline_in_notification);
                  end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Documento foi desvinculado com sucesso.
        }
        error {
            errorMessage: OPS!  Ocorreu um erro ao tentar desvincular o Documento, Verifique e tente novamente.
        }
        advanced {
            executionMappingIdentifier: 2432630392478284714
        }
        serverSideCondition {
            whenButtonPressed: @desvincular-doc
        }
    )

    process vincular-cpf (
        name: VINCULAR CPF
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Maicon Aimi - 21/10/2025 - 11392416 (Os dois devem ser informados)
                  if :P725_DOC_VINCULANTE_EDIT is null or :P725_DOC_VINCULADO_EDIT is null then
                    apex_error.add_error(
                        p_message => 'Atenção! Verifique os campos <span style="color : red ">DOC Vinculante</span> e <span style="color : red ">DOC Vinculado</span>, os dois precisam ser informados!',
                        p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                 /* removido validação - ticket 17014389 - 03/11/2026 - Eduarda
                  -- Maicon Aimi - 21/10/2025 - 11392416 (Não permite vincular o próprio vinculante ao vinculado)
                  if :P725_DOC_VINCULANTE_EDIT = :P725_DOC_VINCULADO_EDIT then
                    apex_error.add_error(
                        p_message => 'Atenção! Verifique os campos <span style="color : red ">DOC Vinculante</span> e <span style="color : red ">DOC Vinculado</span>, os dois não podem ser iguais!',
                        p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;*/
                
                  if nvl(:P725_TIPODOC, 'X') not in ('C', 'D') then
                    apex_error.add_error(
                        p_message => 'Tipo de documento não identificado. Acesse esta tela pela Consulta Doc.',
                        p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  -- Ticket 16900980 - vinculo N para N: sempre grava um novo registro (mantem historico dos desvinculados).
                  -- A unicidade do par ativo e garantida pelo indice UK_VINCULODEBITO_ATIVO.
                  insert into roman.vinculodebito (idvinculodebito,
                                                   cpfpessoavinculante,
                                                   cpfpessoavinculada,
                                                   docextpessoavinculante,
                                                   docextpessoavinculada,
                                                   datavinculacao,
                                                   usuarioinseriu,
                                                   usuarioalterou)
                  values ( roman.vinculodebito_seq.nextval
                         , case when :P725_TIPODOC = 'C' then :P725_DOC_VINCULANTE_EDIT end
                         , case when :P725_TIPODOC = 'C' then :P725_DOC_VINCULADO_EDIT  end
                         , case when :P725_TIPODOC = 'D' then :P725_DOC_VINCULANTE_EDIT end
                         , case when :P725_TIPODOC = 'D' then :P725_DOC_VINCULADO_EDIT  end
                         , trunc(sysdate)
                         , v('APP_USER')
                         , v('APP_USER'));
                
                exception
                  when dup_val_on_index then
                    apex_error.add_error(
                        p_message => 'Atenção! O DOC Vinculado já está vinculado a este DOC Vinculante.',
                        p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Documento foi vinculado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 2432631066550284721
        }
        serverSideCondition {
            whenButtonPressed: @vincular-doc
        }
    )

)

