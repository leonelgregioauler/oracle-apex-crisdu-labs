page 305 (
    name: Parâmetros Netbook/Tablet
    title: Parâmetros Netbook/Tablet
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region parâmetros-netbook-tablet (
        name: Parâmetros Netbook/Tablet
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "NOME",
                "VALOR",
                "IDFILIAL"
                from "#OWNER#"."PARAMETROSNETBOOK"
                where idfilial = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum Parâmetro encontrado! Verifique a Filial escolhida!
        }
        componentAdvanced {
            stripHtml: true
        }

        column IDFILIAL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Idfilial
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column NOME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 2
            }
            columnFormatting {
                cssClasses: readonly
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
            security {
                escapeSpecialChars: false
            }
        )

        column VALOR (
            reportColumnQueryId: 3
            derivedColumn: N
            type: textField
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                width: 50
            }
            advanced {
                cellWidth: 300
            }
        )

    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @parâmetros-netbook-tablet
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-briefcase
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @parâmetros-netbook-tablet
        target {
            tableName: PARAMETROSNETBOOK
            pkColumn: ROWID
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 343035031348539326
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 305
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

