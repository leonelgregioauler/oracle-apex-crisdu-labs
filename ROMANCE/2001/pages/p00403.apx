page 403 (
    name: Balanço Inicial Detalhado
    title: Balanço Inicial Detalhado
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region detalhado (
        name: Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select codigosisdist ||' - '|| initcap(nomeproduto)
                         from produtos p
                            , estoquefilial e
                         where p.idproduto       = e.idproduto
                           and e.idestoquefilial = b.idestoquefil ) produto
                    , decode( comissao, 'S','Sim','Não') comissao
                    , b.valorvenda
                    , sum(quantidade) quantidade
                    , sum(quantidade*valorvenda ) valortotalreal
                    , sum(quantidade * case 
                                         when comissao = 'S' then
                                           valorvenda *0.65
                                         else 
                                           valorvenda 
                                         end) valortotal
                from balancoinicialrepresentantes b
                where idrepresentante = :P403_IDREPRESENTANTE
                  and idsemana        = ( select idsemanabalanco
                                          from representantes r
                                          where r.idrepresentante = b.idrepresentante )
                group by idestoquefil, comissao, b.valorvenda
                
                ```
            pageItemsToSubmit: P403_IDREPRESENTANTE
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: DETALHEBALANCOINICIAL
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2866658133394499477
        }

        column COMISSAO (
            type: plainText
            heading {
                heading: Comissão
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column PRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: 999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column VALORTOTAL (
            type: plainText
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column VALORTOTALREAL (
            type: plainText
            heading {
                heading: Valor Total Real
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
            serverSideCondition {
                type: item!=value
                item: P403_PAGINA
                value: 453
            }
        )

        column VALORVENDA (
            type: plainText
            heading {
                heading: Valor venda
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 14631427 (
            visibility: primaryDefault
            view {
                rowsPerPage: 1000
            }

            displayColumn COMISSAO (
                sequence: 2
            )

            displayColumn PRODUTO (
                sequence: 1
            )

            displayColumn QUANTIDADE (
                sequence: 3
            )

            displayColumn VALORTOTAL (
                sequence: 6
            )

            displayColumn VALORTOTALREAL (
                sequence: 5
            )

            displayColumn VALORVENDA (
                sequence: 4
            )

            sort (
                column: PRODUTO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: QUANTIDADE
            )

            aggregate (
                column: VALORTOTAL
            )

            aggregate (
                column: VALORTOTALREAL
            )

            controlBreak (
                column: COMISSAO
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P403_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(:P403_IDREPRESENTANTE) display_value
                     , :P403_IDREPRESENTANTE return_value
                from dual
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @detalhado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P403_PAGINA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @detalhado
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

