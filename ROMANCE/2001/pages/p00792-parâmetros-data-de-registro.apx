page 792 (
    name: Parâmetros Data de Registro
    alias: PARÂMETROS-DATA-DE-REGISTRO
    title: Parâmetros Data de Registro
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region parâmetros (
        name: Parâmetros
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: PARAMETROS
            includeRowidColumn: true
            whereClause: nome = 'DIASLANCAHORASFUNCAO'
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1801510904161439121
        }

        savedReport 18015636 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDFILIAL
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @NOME
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @VALOR
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDFILIAL (
            type: selectList
            heading {
                heading: Franquia
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select fl.nome 
                         , fl.idfilial
                    from vw_filiais fl
                    where fl.tipofilial = 'D'
                      and fl.gerente is not null
                      and fl.ativo = 'S'
                    ```
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
                primaryKey: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
            }
        )

        column NOME (
            type: textField
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                databaseColumn: NOME
                dataType: varchar2
            }
            default {
                type: static
                staticValue: DIASLANCAHORASFUNCAO
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 70
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column VALOR (
            type: textField
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                valueRequired: true
                maxLength: 100
            }
            source {
                databaseColumn: VALOR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    process processo-save-interactive-grid-data (
        name: Processo - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @parâmetros
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 1801511749688439129
        }
    )

)

