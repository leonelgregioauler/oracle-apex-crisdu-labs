page 42 (
    name: Movimentos de Estoque da Filial
    title: Movimentos de Estoque da Filial
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region fltros (
        name: Fltros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region movimentos-de-estoque-distribuição (
        name: Movimentos de Estoque Distribuição
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select ca.nome
                         from categorias ca
                         where ca.idcategoria = ( select pr.idcategoria 
                                                 from produtos    pr
                                                 where pr.idproduto = e.idproduto ) ) "Categoria"
                     , ( select initcap( pr.codigosisdist ) 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Código"      
                     , ( select initcap( pr.nomeproduto ) 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Produto"         
                     , ( select c.descricao 
                         from cores c
                         where c.idcor = e.idcor ) "Cor"
                     , e.idestoquefilial
                     , e.idfilial
                     , e.idproduto
                     , e.idcor
                     , me.qtd_pp   
                     , me.qtd_p    
                     , me.qtd_m    
                     , me.qtd_g    
                     , me.qtd_gg   
                     , me.qtd_egg  
                     , me.qtd_exgg
                     , me.qtd_u   
                     , me.observacao    "Observação"
                     , me.usuario       "Usuário"
                     , me.datamovimento "Data Movimento"
                     , trunc(me.datamovimento) "Dia"
                     , me.idmovtoestoquefilial
                     , APEX_ITEM.CHECKBOX2(1, 1) "Conferido"
                from estoquefilial           e
                   , movimentosestoquefilial me
                where e.idestoquefilial = me.idestoquefil
                  and e.idfilial = :P0_IDFILIAL
                  and me.datamovimento between to_date(:P42_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P42_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                order by me.idmovtoestoquefilial desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Utilize os filtros para obter resultados!
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

