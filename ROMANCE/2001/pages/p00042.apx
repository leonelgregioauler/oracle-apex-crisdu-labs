    pageItem P42_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @fltros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 15
        }
        default {
            type: expression
            plsqlExpression: trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P42_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @fltros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 15
        }
        default {
            type: expression
            plsqlExpression: trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 30
            region: @fltros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-data-fim-e-inicio (
        name: Valida data fim e inicio
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where to_date(:P42_DATAINICIO,'DD/MM/RRRR') > to_date(:P42_DATAFIM,'DD/MM/RRRR')
                ```
        }
        error {
            errorMessage: Filtro de Datas com problema, verifique as datas informadas!
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 42
                items: {
                    P42_DATAINICIO: &P42_DATAINICIO.
                    P42_DATAFIM: &P42_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

