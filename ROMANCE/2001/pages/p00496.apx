page 496 (
    name: Solicitar Depósito
    title: Solicitar Depósito
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formataMoeda(valor){
              v = valor.value;
              v=v.replace(/\D/g,"") // permite digitar apenas numero
              v=v.replace(/(\d{1})(\d{11})$/,"$1.$2") // coloca ponto antes dos ultimos digitos
              v=v.replace(/(\d{1})(\d{8})$/,"$1.$2") // coloca ponto antes dos ultimos 11 digitos
              v=v.replace(/(\d{1})(\d{5})$/,"$1.$2") // coloca ponto antes dos ultimos 8 digitos
              v=v.replace(/(\d{1})(\d{2})$/,"$1,$2") // coloca ponto antes dos ultimos 5 digitos
              valor.value = v;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region solicitar-depósito (
        name: Solicitar Depósito
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            outputAs: text
        }
    )

