    button fechar (
        buttonName: Fechar
        label: Fechar
        layout {
            sequence: 10
            region: @solicitar-depósito
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button novo (
        buttonName: NOVO
        label: Nova Solicitação
        layout {
            sequence: 30
            region: @solicitar-depósito
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Solicitar
        layout {
            sequence: 20
            region: @solicitar-depósito
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    button verdepositossolicitados (
        buttonName: verdepositossolicitados
        label: Ver depósitos solicitados
        layout {
            sequence: 40
            region: @solicitar-depósito
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 232
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @fechar
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction esconde-solicitação (
        name: Esconde solicitação
        execution {
            sequence: 30
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNull
            item: P496_CONTROLE
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @novo
            }
            execution {
                sequence: 40
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P496_VALOR
                    P496_IDREPRESENTANTE
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-3 (
            action: hide
            affectedElements {
                selectionType: button
                button: @submit
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-4 (
            action: hide
            affectedElements {
                selectionType: items
                items: P496_CONTROLE
            }
            execution {
                sequence: 30
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: button
                button: @novo
            }
            execution {
                sequence: 40
                fireWhenEventResultIs: false
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P496_VALOR
                    P496_IDREPRESENTANTE
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show-3 (
            action: show
            affectedElements {
                selectionType: items
                items: P496_CONTROLE
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

        action native-show-4 (
            action: show
            affectedElements {
                selectionType: button
                button: @submit
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @novo
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: NOVO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction solicitar (
        name: SOLICITAR
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @submit
        }
        serverSideCondition {
            type: never
        }

        action native-confirm (
            action: confirm
            settings {
                message: Você confirma o valor da solicitação?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SUBMIT
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation valida-banco (
        name: Valida Banco
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P496_IDBANCO
        }
        error {
            errorMessage: Por favor, informe o Banco para solicitar conta!
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation valida-limite-de-valor (
        name: Valida limite de valor
        execution {
            sequence: 40
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual 
                where to_number(replace(replace(:P496_VALOR,'.',''),',','.'),'999999999999999990.00') > 50000
                ```
        }
        error {
            errorMessage: Valor não pode ser superior a R$50.000,00
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation valida-representante (
        name: Valida Representante
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P496_IDREPRESENTANTE
        }
        error {
            errorMessage: Informe o distribuidor!
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

    validation valida-valor (
        name: Valida Valor
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P496_VALOR
        }
        error {
            errorMessage: Informe o valor!
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

    process monta-mensagem (
        name: Monta mensagem
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  :P496_CONTROLE := :P496_BENEFICIARIO||' - '||:P496_CNPJ||'<br>'||:P496_BANCO||'<BR> Ag: '||:P496_AGENCIA||' Cc: '||:P496_CONTA||'<br> Valor: R$ '||to_char(to_number(:P496_VALOR),'999G999G999G990');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 3355184014476181145
        }
        serverSideCondition {
            type: never
        }
    )

    process novo (
        name: NOVO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  :P496_IDREPRESENTANTE := NULL;
                  :P496_VALOR           := NULL;
                  :P496_CONTROLE        := NULL;
                  :P496_IDBANCO         := NULL;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3355183633223181144
        }
        serverSideCondition {
            type: request=Value
            value: NOVO
        }
    )

    process solicita-depósito (
        name: Solicita Depósito
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidrepresentante     number := :P496_IDREPRESENTANTE;
                  viddepositodiario    number;
                  vvalor               number := to_number(replace(replace(:P496_VALOR,'.',''),',','.'),'999999999999999990.00');
                  vtipopagamento       varchar2(1000);
                  vbanco               varchar2(1000);
                  vagencia             varchar2(1000);
                  vconta               varchar2(1000);
                  vbeneficiario        varchar2(1000);
                  vcnpj                varchar2(1000);
                  vstatus              varchar2(1000);
                  vidtablet            number;
                  vlatitude            varchar2(1000);
                  vlongitude           varchar2(1000);
                  --
                begin
                  -- 
                  pck_financeiro_rmc.prc_solicitadeposito_tablet_v2( pidrepresentante  => :P496_IDREPRESENTANTE
                                                                   , piddepositodiario => :P496_IDDEPOSITODIARIO
                                                                   , pvalor            => vvalor
                                                                   , ptipopagamento    => :P496_TIPOPAGAMENTO
                                                                   , pidbanco          => :P496_IDBANCO
                                                                   , pbanco            => :P496_BANCO
                                                                   , pagencia          => :P496_AGENCIA
                                                                   , pconta            => :P496_CONTA
                                                                   , pbeneficiario     => :P496_BENEFICIARIO
                                                                   , pcnpj             => :P496_CNPJ
                                                                   , pstatus           => :P496_STATUS
                                                                   , pidtablet         => :P496_IDTABLET
                                                                   , platitude         => :P496_LATITUDE
                                                                   , plongitude        => :P496_LONGITUDE );       
                  --
                  :P496_VALOR := vvalor;
                  --
                  --:P496_CONTROLE := 'X';
                  --
                  :P496_CONTROLE := :P496_STATUS;
                  --                                      
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3355183253239181144
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

    branch (
        name: Go To Page 496 Submit
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 496
            }
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

    branch (
        name: Go To Page 496
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 496
                items: {
                    P496_CONTROLE:
                }
                clearCache: 421
                action: resetPagination
            }
        }
    )

)

