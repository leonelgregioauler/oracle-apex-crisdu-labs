page 516 (
    name: Acompanhamento de Notas Integradas
    title: Acompanhamento de Notas Integradas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region notas-de-vendas-integradas (
        name: Notas de Vendas Integradas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , nv.numeronota
                     , nv.idpedidovirtualage
                     , consultora
                     , distribuidor
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.datanota
                     , nv.dataacerto
                     , nv.valortotalnota
                     , nv.valortotalvenda
                     , nv.perccomissao
                     , nv.valortotalvendalqd
                     , nv.valorpago
                     , nv.saldo
                from vw_notasvendas_faturadas nv
                where ( :P516_IDFILIAL is null or nv.idfilial = :P516_IDFILIAL )
                  and trunc(nv.dataclassificado) between to_date(:P516_DATAINICIO) and to_date(:P516_DATAFIM) 
                order by 1        
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma nota encontrada.
        }
        advanced {
            savedReportMappingIdentifier: 3537222137075058521
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column DATAACERTO (
            type: plainText
            heading {
                heading: Acertada em
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        column DATANOTA (
            type: plainText
            heading {
                heading: Data da Nota
