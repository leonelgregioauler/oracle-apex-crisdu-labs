    region análise-de-cidades-geral (
        name: Análise de Cidades - Geral
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select sessao
                     , ordem
                     , nomefilial
                     , to_char(populacao,'999G999G999G999G999G000') populacao
                     , pagoano1
                     , valorporhabitante1
                     , pagoano2
                     , valorporhabitante2
                     , pagoano3
                     , valorporhabitante3
                     , crescimento
                     , percentualcrescimento
                     , to_char(mediavalorpagoporpopulacao, '999G999G999G999G990D00') mediavalorpagoporpopulacao
                  from tmp_atendimentofiliais
                 where sessao = v('APP_SESSION') 
                   -- and ordem > 1 Maicon - ticket 9287178 - 20/08/2024
                 order by 3 asc;
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1792085785560534634
        }

