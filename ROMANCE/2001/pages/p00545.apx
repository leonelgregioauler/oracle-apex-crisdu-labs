    validation valida-3-anos (
        name: Valida 3 anos
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  v_valida number;
                  --
                begin
                  --
                  select extract(year from (to_date(:P545_DT_FIM,'dd/mm/yyyy)'))) - 
                         extract(year from (to_date(:P545_DT_INICIO,'dd/mm/yyyy)')))
                    into v_valida
                    from dual;
                  --
                  if v_valida <> 0 then
                    --
                    return(false);--raise_application_error(-20000,'Selecione um período entre 3(três) anos');
                    --
                  end if;
                  --
                end;
                ```
        }
        error {
            errorMessage: Selecione um período dentro do mesmo ano
            associatedItem: @P545_DT_FIM
        }
    )

    process relatório-anos-anteriores (
        name: Relatório Anos Anteriores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P545_DT_INICIO is null then
                    --
                    raise_application_error(-20000,'Informe a data incial do período da pesquisa');
                    --
                  end if;
                  --
                  if :P545_DT_FIM is null then
                    --
                    raise_application_error(-20000,'Informe a data final do período da pesquisa');
                    --
                  end if;
                  --
                  prc_tmp_atendimento_cidades(p_idsessao  => v('APP_SESSION')
                                            , p_dt_inicio => :P545_DT_INICIO
                                            , p_dt_fim    => :P545_DT_FIM
                                            , p_idfilial  => :P0_IDFILIAL
                                            , p_tp_filtro => :P545_TIPOFILTRO_2);
                  --
                  -- ALTERA O lABEL DAS COLUNAS AUTOMATICAMENTE CONFORME OS ANOS DA PESQUISA, PARA DAR UMA APARENCIA TIPO EXCEL
                  :P545_LABEL_PAGO_ANO1 := EXTRACT( YEAR FROM TO_DATE(:P545_DT_INICIO)) - 2;
                  :P545_LABEL_PAGO_ANO2 := EXTRACT( YEAR FROM TO_DATE(:P545_DT_INICIO)) - 1;
                  :P545_LABEL_PAGO_ANO3 := EXTRACT( YEAR FROM TO_DATE(:P545_DT_INICIO));
                  :P545_CRESCIMENTO_2_X_3 := ((EXTRACT( YEAR FROM TO_DATE(:P545_DT_INICIO))) - 1 ||' X '|| (EXTRACT( YEAR FROM TO_DATE(:P545_DT_INICIO))));
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2432408064594791407
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
            type: item=value
            item: P545_TIPORELATORIO
            value: 2
        }
    )

    process relatório-geral (
        name: Relatório Geral
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P545_DT_INICIO is null then
                    --
                    raise_application_error(-20000,'Informe a data incial do período da pesquisa');
                    --
                  end if;
                  --
                  if :P545_DT_FIM is null then
                    --
                    raise_application_error(-20000,'Informe a data final do período da pesquisa');
                    --
                  end if;
                  --
                  prc_tmp_atendimento_filiais(p_idsessao  => v('APP_SESSION')
                                            , p_dt_inicio => :P545_DT_INICIO
                                            , p_dt_fim    => :P545_DT_FIM
                                            , p_idfilial  => :P0_IDFILIAL
                                            , p_tp_filtro => :P545_TIPOFILTRO_2);
                  --
                  -- ALTERA O lABEL DAS COLUNAS AUTOMATICAMENTE CONFORME OS ANOS DA PESQUISA, PARA DAR UMA APARENCIA TIPO EXCEL
                  :P545_LABEL_PAGO_ANO1_GERAL := EXTRACT( YEAR FROM TO_DATE(:P545_DT_INICIO)) - 2;
                  :P545_LABEL_PAGO_ANO2_GERAL := EXTRACT( YEAR FROM TO_DATE(:P545_DT_INICIO)) - 1;
                  :P545_LABEL_PAGO_ANO3_GERAL := EXTRACT( YEAR FROM TO_DATE(:P545_DT_INICIO));
                  :P545_CRESCIMENTO_2_X_3_GERAL := ((EXTRACT( YEAR FROM TO_DATE(:P545_DT_INICIO))) - 1 ||' X '|| (EXTRACT( YEAR FROM TO_DATE(:P545_DT_INICIO))));
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1792087021312534647
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
            type: item=value
            item: P545_TIPORELATORIO
            value: 3
        }
    )

    branch (
        name: Go To Page 545
        execution {
            sequence: 10
