    region analise-de-cidades-crescimento (
        name: Analise de Cidades - Crescimento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select sessao
                     , ordem
                     , cidade
                     , to_char(populacao,'999G999G999G999G999G000') populacao
                     , pagoano1
                     , valorporhabitante1
                     , pagoano2
                     , valorporhabitante2
                     , pagoano3
                     , valorporhabitante3
                     , crescimento
                     , percentualcrescimento
                  from tmp_atendimentocidades
                 where sessao = v('APP_SESSION') 
                   -- and ordem > 1 Maicon - ticket 9287178 - 20/08/2024
                 order by 3 asc;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2432300305930911804
        }

