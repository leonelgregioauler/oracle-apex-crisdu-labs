    region análise-de-cidades (
        name: Análise de Cidades
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cid.nomecidade
                     , cid.populacao
                     , cid.pib
                     , cid.vendaliquida
                     , cid.pago
                     , case
                         when cid.vendaliquida > 0 then
                           round(( ( cid.vendaliquida-cid.pago ) / cid.vendaliquida )*100,2)
                         else
                           0
                       end inadimplencia
                     , cid.consultoras
                     , cid.totalatendem
                     , case
                         when cid.consultoras > 0 then
                           trunc((cid.populacao/cid.consultoras))
                         else
                           0
                       end mediahabitante
                     , case
                         when cid.totalatendem > 0 then
                           trunc((cid.populacao/cid.totalatendem))
                         else
                           0
                       end mediadistribuidor
                     , case
                         when cid.vendaliquida > 0 and cid.consultoras >0 then
                           round(( (cid.vendaliquida/cid.consultoras)/(cid.dias/42) ),2)
                         else
                           0
                       end mediafaturamento
                     , cid.dias
                     , ( cid.dias/42 ) ciclos
                     , cid.idcidade
                     , cid.UF
                from ( 
                      select c.nomecidade 
                           , c.idcidade
                           , c.populacao 
                           , c.pib 
                           , to_date(:P545_DATAFIM_B) - to_date(:P545_DATAINICIO) dias
                           , nvl(( select sum(nv.valortotalvendalqd)
                                   from notasvendas nv
                                      , vendedoras v
                                      , pessoas p
                                   where ((:P0_IDFILIAL = 1135 and nv.idfilial in (select f.idfilial
                                                                                     from catal.filiais f
                                                                                    where f.pertencecomercialromance = 'S'))  -- Comercial Romance
                                          or (:P0_IDFILIAL = -1 and nv.idfilial = nv.idfilial) -- Todos
                                          or (:P0_IDFILIAL = -2 and nv.idfilial in (select f.idfilial
                                                                                      from filiais f
                                                                                     where f.ididioma = 1)) -- Brasil
                                          or (:P0_IDFILIAL = -3 and nv.idfilial in (select f.idfilial
                                                                                      from filiais f
                                                                                     where f.ididioma <> 1)) -- America Latina
                                          or (nv.idfilial  = :P0_IDFILIAL))
                                     and v.idvendedora = nv.idvendedora
                                     and p.idpessoa    = v.idpessoa
                                     and nv.dataacerto between to_date(:P545_DATAINICIO_B||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P545_DATAFIM_B||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                     and nv.idsituacaonotavenda = 4
                                     and p.idcidade    = c.idcidade ),0) vendaliquida
                           , nvl(( select sum(nv.valorpago)
                                   from notasvendas nv
                                      , vendedoras v
                                      , pessoas p
                                   where ((:P0_IDFILIAL = 1135 and nv.idfilial in (select f.idfilial
                                                                                     from catal.filiais f
                                                                                    where f.pertencecomercialromance = 'S'))  -- Comercial Romance
                                          or (:P0_IDFILIAL = -1 and nv.idfilial = nv.idfilial) -- Todos
                                          or (:P0_IDFILIAL = -2 and nv.idfilial in (select f.idfilial
                                                                                      from filiais f
                                                                                     where f.ididioma = 1)) -- Brasil
                                          or (:P0_IDFILIAL = -3 and nv.idfilial in (select f.idfilial
                                                                                      from filiais f
                                                                                     where f.ididioma <> 1)) -- America Latina
                                           or (nv.idfilial  = :P0_IDFILIAL))
                                     and v.idvendedora = nv.idvendedora
                                     and p.idpessoa    = v.idpessoa
                                     and nv.dataacerto between to_date(:P545_DATAINICIO_B||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P545_DATAFIM_B||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                     and nv.idsituacaonotavenda = 4
                                     and p.idcidade    = c.idcidade ),0) pago
                           , nvl(( select count(distinct idpessoa)
                                   from pessoas p
                                   where p.idcidade = c.idcidade 
                                     and exists ( select 1
                                                  from vendedoras v
                                                  where v.idpessoa = p.idpessoa
                                                    and v.ativo    = 'S'
                                                    and ((:P0_IDFILIAL = 1135 and v.idfilial in (select f.idfilial
                                                                                     from catal.filiais f
                                                                                    where f.pertencecomercialromance = 'S'))  -- Comercial Romance
                                                         or (:P0_IDFILIAL = -1 and v.idfilial = v.idfilial) -- Todos
                                                         or (:P0_IDFILIAL = -2 and v.idfilial in (select f.idfilial
                                                                                                   from filiais f
                                                                                                  where f.ididioma = 1)) -- Brasil
                                                         or (:P0_IDFILIAL = -3 and v.idfilial in (select f.idfilial
                                                                                                   from filiais f
                                                                                                  where f.ididioma <> 1)) -- America Latina
                                                         or (v.idfilial  = :P0_IDFILIAL))
                                                    and exists ( select 1
                                                                 from notasvendas nv
                                                                 where nv.idvendedora = v.idvendedora 
                                                                   and nv.idsituacaonotavenda != 5
                                                                   and nv.datanota between to_date(:P545_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P545_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) ) ),0) consultoras
                           , nvl(( select count(1)
                                   from representantes r
                                   where pck_romance.fnc_filialrepresentante(r.idrepresentante) = :P0_IDFILIAL
                                     and r.ativo = 'S'
                                     and exists ( select 1 
                                                  from notasvendas nv
                                                     , vendedoras v
                                                     , pessoas p
                                                  where nv.idrepresentante = r.idrepresentante
                                                    and v.idvendedora      = nv.idvendedora
                                                    and p.idpessoa         = v.idpessoa
                                                    and ((:P0_IDFILIAL = 1135 and nv.idfilial in (select f.idfilial
                                                                                     from catal.filiais f
                                                                                    where f.pertencecomercialromance = 'S'))  -- Comercial Romance
                                                         or (:P0_IDFILIAL = -1 and nv.idfilial = nv.idfilial) -- Todos
                                                         or (:P0_IDFILIAL = -2 and nv.idfilial in (select f.idfilial
                                                                                                     from filiais f
                                                                                                    where f.ididioma = 1)) -- Brasil
                                                         or (:P0_IDFILIAL = -3 and nv.idfilial in (select f.idfilial
                                                                                                     from filiais f
                                                                                                    where f.ididioma <> 1)) -- America Latina
                                                         or (nv.idfilial  = :P0_IDFILIAL))
                                                    and nv.datanota between to_date(:P545_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P545_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                                    and p.idcidade         = c.idcidade )),0) totalatendem
                           , e.sigla "UF"
                      from cidades c
                         , estados e
                      where c.idestado = e.idestado
                        and ( :P545_TIPOFILTRO = 'X' or
                             (:P545_TIPOFILTRO = 'A' and exists ( select 1
                                                                   from cidadesatendidas cc
                                                                   where cc.idcidade = c.idcidade
                                                                     and ((:P0_IDFILIAL = 1135 and cc.idfilial in (select f.idfilial
                                                                                     from catal.filiais f
                                                                                    where f.pertencecomercialromance = 'S'))  -- Comercial Romance
                                                                          or (:P0_IDFILIAL = -1 and cc.idfilial = cc.idfilial) -- Todos
                                                                          or (:P0_IDFILIAL = -2 and cc.idfilial in (select f.idfilial
                                                                                                                      from filiais f
                                                                                                                     where f.ididioma = 1)) -- Brasil
                                                                          or (:P0_IDFILIAL = -3 and cc.idfilial in (select f.idfilial
                                                                                                                      from filiais f
                                                                                                                      where f.ididioma <> 1)) -- America Latina
                                                                          or (cc.idfilial  = :P0_IDFILIAL)) )
                                                      /*and exists ( select 1 
                                                                   from notasvendas nv
                                                                      , vendedoras v
                                                                      , pessoas p
                                                                   where v.idvendedora      = nv.idvendedora
                                                                     and p.idpessoa         = v.idpessoa
                                                                     and ((:P0_IDFILIAL = 1135 and nv.idfilial in (select f.idfilial
                                                                                     from catal.filiais f
                                                                                    where f.pertencecomercialromance = 'S'))  -- Comercial Romance
                                                                          or (:P0_IDFILIAL = -1 and nv.idfilial = nv.idfilial) -- Todos
                                                                          or (:P0_IDFILIAL = -2 and nv.idfilial in (select f.idfilial
                                                                                                                      from filiais f
                                                                                                                     where f.ididioma = 1)) -- Brasil
                                                                          or (:P0_IDFILIAL = -3 and nv.idfilial in (select f.idfilial
                                                                                                                      from filiais f
                                                                                                                     where f.ididioma <> 1)) -- America Latina
                                                                          or (nv.idfilial  = :P0_IDFILIAL))
                                                                     and nv.datanota between to_date(:P545_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P545_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                                                     and p.idcidade         = c.idcidade )*/ )
                          or ( :P545_TIPOFILTRO = 'G' and exists ( select 1 
                                                                   from notasvendas nv
                                                                      , vendedoras v
                                                                      , pessoas p
                                                                   where v.idvendedora      = nv.idvendedora
                                                                     and p.idpessoa         = v.idpessoa
                                                                     and ((:P0_IDFILIAL = 1135 and nv.idfilial in (select f.idfilial
                                                                                     from catal.filiais f
                                                                                    where f.pertencecomercialromance = 'S'))  -- Comercial Romance
                                                                          or (:P0_IDFILIAL = -1 and nv.idfilial = nv.idfilial) -- Todos
                                                                          or (:P0_IDFILIAL = -2 and nv.idfilial in (select f.idfilial
                                                                                                                      from filiais f
                                                                                                                     where f.ididioma = 1)) -- Brasil
                                                                          or (:P0_IDFILIAL = -3 and nv.idfilial in (select f.idfilial
                                                                                                                      from filiais f
                                                                                                                     where f.ididioma <> 1)) -- America Latina
                                                                          or (nv.idfilial  = :P0_IDFILIAL))
                                                                     and nv.datanota between to_date(:P545_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P545_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                                                     and p.idcidade         = c.idcidade ) ) ) ) cid
                order by 1 asc;
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <h4>
                    * Atedimento por Cidades = Cidades que foram passadas para o SAC, com intuito de marcar quais as cidades a empresa atende.<br>
                    * Geral = Pega como base cidades de clientes no período da Data Base informada ao lado.
                </h4>
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
