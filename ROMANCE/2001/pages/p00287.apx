page 287 (
    name: Documentos
    title: Documentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region documento (
        name: Documento
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P287_FILE (
        type: fileUpload
        label {
            label: File
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            type: appTempFiles
        }
        layout {
            sequence: 10
            region: @documento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
    )

    pageItem P287_IMAGEM (
        type: displayImage
        label {
            label: Imagem
            alignment: left
        }
        settings {
            basedOn: blobColSql
            sqlQuery: select blob_content from apex_application_temp_files where name = :P287_FILE
        }
        layout {
            sequence: 20
            region: @documento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 10
            region: @documento
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction image-croppe (
        name: image croppe
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P287_FILE
        }

        action plugin-ca-maximet-apexcropper (
            action: plugin/apexImageCropper
            settings {
                previewSelector: Preview
                mincontainerwidth: 200
                mincontainerheight: 100
                mincanvaswidth: 100
                mincanvasheight: 50
                mincropboxwidth: 100
                mincropboxheight: 50
                saveButtonJquerySelector: SAVE
                croppedImageMaximumWidth: 100
                croppedImageMaximumHeight: 50
            }
            affectedElements {
                selectionType: items
                items: P287_IMAGEM
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

