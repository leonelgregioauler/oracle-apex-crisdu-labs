page 264 (
    name: Lista de Notas de Venda de Outra Região
    title: Lista de Notas de Venda de Outra Região
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_popup_consulta()
            {
              window.open('f?p=&APP_ID.:156:&SESSION.::NO::','CONSULTAR', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=250,left=250,top=100','_blank'); void(0);
            }
            
            function fnc_popup()
            {
            window.open('f?p=&APP_ID.:147:&SESSION.::NO::','LIMPAR', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=180,left=250,top=100','_blank'); void(0);
            }
            function fnc_popup_vend()
            {
            window.open('f?p=&APP_ID.:152:&SESSION.::NO::','vendedora', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=900,height=600,left=250,top=100','_blank'); void(0);
            }
            
            function receberpromissoria(pid){ 
            
              document.getElementById('P264_IDRECEBIDO').value = pid;
                
              var answer = confirm("Confirma a Promissória Recebida ?")
              if (answer)
                {
                  apex.submit('PROMISSORIARECEBIDA');
                }
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region notas-novas-aberturas-reativação (
        name: Notas Novas Aberturas/Reativação
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'S' abertura
                     , nv.idnotavenda
                     , nv.numeronota
                     , nv.semanadistribuicao
                     , nv.semanacobranca 
                     , pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) vendedora
                     , nv.valortotalnota
                     , pck_util.fnc_idsemana(nv.semanacobranca) - pck_util.fnc_idsemana(nv.semanadistribuicao) intervalo
                     , ( select pck_romance.fnc_nomecidade(p.idcidade) from pessoas p where p.idpessoa = vv.idpessoa ) cidade
                     , nv.datanota
                     , pck_romance.fnc_nomeregiaovenda(nv.idregiaovenda) regiao
                     , ( select NROCONSULTASPC
                         from pessoas p
                         where p.idpessoa = vv.idpessoa ) "Nr Consulta SPC"
                     , pck_romance.fnc_retornatelefones(nv.idvendedora) telefones
                     , case
                        when nvl(nv.promissoriarecuperada,'N') = 'N' then
                          '<a href=javascript:receberpromissoria('||nv.idnotavenda||');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                        else 
                          'Recebida!'
                       end confirmarrecebimento
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' irparanota
                     , pck_romance.fnc_cpfvendedora(nv.idvendedora) cpf
                from notasvendas    nv
                   , vendedoras     vv
                where nv.idvendedora     = vv.idvendedora
                  and nv.idsituacaonotavenda = 3
                  and nv.idfilial        = :P0_IDFILIAL
                  and nv.idrepresentante = :P264_IDREPRESENTANTE
                  and nv.semanadistribuicao = :P264_SEMANA
                  and nv.idregiaovenda != :P264_IDREGIAOVENDA
                  and not exists ( select 1
                                   from notasvendas n
                                   where n.idvendedora = nv.idvendedora
                                     and n.idnotavenda < nv.idnotavenda
                                     and n.idsituacaonotavenda <> 5 )
                union
                select 'N' abertura
                     , nv.idnotavenda
                     , nv.numeronota
                     , nv.semanadistribuicao
                     , nv.semanacobranca 
                     , pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) vendedora
                     , nv.valortotalnota
                     , pck_util.fnc_idsemana(nv.semanacobranca) - pck_util.fnc_idsemana(nv.semanadistribuicao) intervalo
                     , ( select pck_romance.fnc_nomecidade(p.idcidade) from pessoas p where p.idpessoa = vv.idpessoa ) cidade
                     , nv.datanota
                     , pck_romance.fnc_nomeregiaovenda(nv.idregiaovenda) regiao
                     , ( select NROCONSULTASPC
                         from pessoas p
                         where p.idpessoa = vv.idpessoa ) "Nr Consulta SPC"
                     , pck_romance.fnc_retornatelefones(nv.idvendedora) telefones
                     , case
                        when nvl(nv.promissoriarecuperada,'N') = 'N' then
                          '<a href=javascript:receberpromissoria('||nv.idnotavenda||');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                        else 
                          'Recebida!'
                       end confirmarrecebimento
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' irparanota
                     , pck_romance.fnc_cpfvendedora(nv.idvendedora) cpf
                from notasvendas    nv
                   , vendedoras     vv
                where nv.idvendedora     = vv.idvendedora
                  and nv.idsituacaonotavenda = 3
                  and nv.idfilial        = :P0_IDFILIAL
                  and nv.idrepresentante = :P264_IDREPRESENTANTE
                  and nv.semanadistribuicao = :P264_SEMANA
                  and nv.idregiaovenda != :P264_IDREGIAOVENDA
                  and exists ( select 1
                               from notasvendas n
                               where n.idvendedora = nv.idvendedora
                                 and n.idsemanacobranca = ( select max(idsemanacobranca)
                                                            from notasvendas nn
                                                            where nn.idvendedora = n.idvendedora
                                                              and nn.idsituacaonotavenda = 4)
                                 and n.idsemanacobranca < pck_util.fnc_idsemana(:P264_SEMANA) ) 
                ```
        }
