    region page_plug (
        name: " "
        type: staticContent
        layout {
            sequence: 1
            slot: body-3
        }
    )

    pageItem P264_IDRECEBIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @page_plug
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P264_IDREGIAOVENDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @page_plug
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select idregiaovenda
                from regioesrepresentantes r
                where r.idrepresentante = :P264_IDREPRESENTANTE
                  and r.idsemana = pck_util.fnc_idsemana(:P264_SEMANA)+6
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P264_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @page_plug
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredAppLevel
            encryptSessionState: false
        }
    )

    pageItem P264_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @page_plug
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredAppLevel
            encryptSessionState: false
        }
    )

    process confirmar-promissoria (
        name: Confirmar Promissoria
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidcaracteristica number := 3;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);
                  vidnotavenda number := :P264_IDRECEBIDO;
                  --
                begin 
                  --
                  update notasvendas n
                  set n.promissoriarecuperada = 'S'
                  where n.idnotavenda = :P264_IDRECEBIDO;
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P264_IDRECEBIDO,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidvalorcaracteristica,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Promissória Recebida
        }
        advanced {
            executionMappingIdentifier: 1409219187719609773
        }
        serverSideCondition {
            type: request=Value
            value: PROMISSORIARECEBIDA
        }
    )

)

