    region notas-novas-de-clientes-antigas (
        name: Notas Novas de Clientes Antigas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'N' abertura
                     , nv.idnotavenda
                     , nv.numeronota
                     , nv.datanota
                     , nv.semanadistribuicao
                     , nv.semanacobranca 
                     , pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) vendedora
                     , ( select pck_romance.fnc_nomecidade(p.idcidade) from pessoas p where p.idpessoa = vv.idpessoa ) cidade
                     , pck_romance.fnc_nomeregiaovenda(nv.idregiaovenda) regiao
                     , nv.valortotalnota
                     , ( select NROCONSULTASPC
                         from pessoas p
                         where p.idpessoa = vv.idpessoa ) "Nr Consulta SPC"
                     , case
                        when nvl(nv.promissoriarecuperada,'N') = 'N' then
                          '<a href=javascript:receberpromissoria('||nv.idnotavenda||');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                        else 
                          'Recebida!'
                       end confirmarrecebimento
                     , acertada.numeronota notaacertada
                     , acertada.dataacerto dataacertada
                     , acertada.valortotalnota totalacertada
                     , acertada.valortotaldevolucao devolucaoacertada
                     , acertada.valortotalvendalqd totalvendaacertada
                     , acertada.valorpago pagoacertada
                     , acertada.saldo saldoacertada
                     , '|' s1
                     , '|' s2
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' irparanota
                     , pck_util.fnc_idsemana(nv.semanacobranca) - pck_util.fnc_idsemana(nv.semanadistribuicao) intervalo
                     , pck_romance.fnc_cpfvendedora(nv.idvendedora) cpf
                from notasvendas    nv
                   , vendedoras     vv
                   , ( select n.idnotavenda
                            , n.idvendedora
                            , n.numeronota
                            , n.dataacerto
                            , n.valortotalnota
                            , n.valortotaldevolucao
                            , n.valortotalvendalqd
                            , n.valorpago
                            , n.saldo
                       from notasvendas n
                       where n.idsituacaonotavenda = 4
                         and n.semanacobranca = :P264_SEMANA
                         and ( n.idrepresentante = :P264_IDREPRESENTANTE
                            or n.idrepresentanteatende = :P264_IDREPRESENTANTE ) ) acertada
                where nv.idvendedora = vv.idvendedora
                  and acertada.idvendedora = nv.idvendedora
                  and nv.idnotavenda > acertada.idnotavenda
                  and nv.idsituacaonotavenda = 3
                  and nv.idrepresentante = :P264_IDREPRESENTANTE
                  and nv.idregiaovenda != :P264_IDREGIAOVENDA
                  and nv.idsemanacobranca != pck_util.fnc_idsemana(:P264_SEMANA)
                ```
        }
