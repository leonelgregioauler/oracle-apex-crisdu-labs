    pageItem P204_SALDO (
        type: numberField
        label {
            label: Saldo
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 70
            region: @controle-de-empréstimos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 15
        }
        validation {
            maxLength: 4000
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select TO_CHAR(to_number(nvl(:P204_VALOR,0),'999G999G990D00')  
                     + to_number(nvl(:P204_VALORJUROS,0),'999G999G990D00')
                     - nvl(a.valorpago,0) ,'999G999G990D00') saldo
                from ( select sum(VALORPAGO) valorpago
                       from pagamentosemprestimos t
                        where idemprestimo = :P204_IDEMPRESTIMO
                          and trunc(t.data) <= trunc(sysdate) ) a
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

