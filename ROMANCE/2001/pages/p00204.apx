page 204 (
    name: Controle de Empréstimos
    title: Controle de Empréstimos
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1200%
        height: 900%
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='Deseja realmente excluir este empréstimo?';
            
            
            function fnc_valorpago(pidpago)
            {
              vid = document.getElementById("P204_IDEMPRESTIMO").value;
              window.open('f?p=&APP_ID.:211:&SESSION.::NO::P211_IDPAGAMENTO,P211_IDEMPRESTIMO:'+pidpago+','+vid,'VALORPAGO', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=400,left=250,top=100','_blank'); void(0);
            }
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region arquivos-anexados-do-empréstimo (
        name: Arquivos Anexados do Empréstimo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     --, '<a href="javascript: fnc_verimg('''||idemprestimo||idanexoemprestimo||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' link
                     , idemprestimo||idanexoemprestimo||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , dataanexo data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario) usuario
                from anexosemprestimos t
                where idemprestimo = :P204_IDEMPRESTIMO
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 40
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent13
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from anexosemprestimos a
                where a.idemprestimo = :P204_IDEMPRESTIMO
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 767070988475495650
        }

