    process deletar-classificacao (
        name: Deletar Classificacao
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  v_verifica varchar2(50);
                  --
                begin
                  --
                  FOR i IN 1..APEX_APPLICATION.G_F01.COUNT
                 loop
                   --
                   delete from classificacoesnegociacoes cl
                         where cl.idclassificacaonegociacao = APEX_APPLICATION.G_F01(i);
                   --
                   v_verifica := APEX_APPLICATION.G_F01(i);
                   --
                  END LOOP;
                  --
                  if v_verifica is null then
                    --
                    raise_application_error(-20001,'Selecione um ou mais registros.');
                    --
                  else
                    --
                    commit;
                    --
                    apex_application.g_print_success_message := '<span style="color : white ">Classificação Removida com Sucesso! </span>';
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 3494203702559455042
        }
        serverSideCondition {
            whenButtonPressed: @deletarclass
        }
    )

    process deletar-empréstimos-pagamentos (
        name: Deletar empréstimos/pagamentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_idemprestimo NUMBER := :P204_IDEMPRESTIMO; -- ID do empréstimo a ser excluído
                BEGIN
                
                  BEGIN
                  -- Exclui anexos relacionados
                  DELETE FROM anexosemprestimospgtos
                  WHERE idemprestimo = v_idemprestimo;
                  COMMIT;
                  END;
                
                  BEGIN
                  -- Exclui parcelamentos relacionados < T9560227 >
                  DELETE FROM parcelamentosemprestimos
                  WHERE idemprestimo = v_idemprestimo;
                  COMMIT;
                  END;
                
                  BEGIN
                  -- Exclui pagamentos relacionados
                  DELETE FROM pagamentosemprestimos
                  WHERE idemprestimo = v_idemprestimo;
                  COMMIT;
                  END;
                
                  BEGIN
                  -- Exclui o empréstimo principal
                  DELETE FROM emprestimos
                  WHERE idemprestimo = v_idemprestimo;
                  COMMIT;
                  END;
                
                  -- Confirma a exclusão
                  COMMIT;
                  --
                END;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 372587795002706701
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

