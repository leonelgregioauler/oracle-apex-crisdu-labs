    region classificaçãoes-da-negociação (
        name: Classificaçãoes da Negociação
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select cl.idclassificacaonegociacao
                     , cl.idcaracteristicanegociacao
                     , cl.idnegociacao
                     , cl.dataclassificacao
                     , (select u.usuario
                          from usuarios u
                         where u.idusuario = cl.idusuario) usuario
                     , cl.observacao
                     , ca.descricao
                     , APEX_ITEM.CHECKBOX2(1, cl.idclassificacaonegociacao , NULL )  deletar
                  from classificacoesnegociacoes cl
                     , caracteristicasnegociacoes ca
                 where cl.idcaracteristicanegociacao = ca.idcaracteristicanegociacao
                   and cl.idemprestimo = :P204_IDEMPRESTIMO
                   and cl.idnegociacao is null
                   and cl.idnegociacaobalanco is null
                   ORDER BY cl.dataclassificacao DESC
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from classificacoesnegociacoes cl
                 where cl.idemprestimo = :P204_IDEMPRESTIMO
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
