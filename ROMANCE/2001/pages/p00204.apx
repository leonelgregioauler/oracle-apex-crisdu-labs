    region lista-de-pagamentos (
        name: Lista de Pagamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idpagamento
                     , data
                     , valorpago
                     , observacao
                     , ( select semana
                         from fechamentossemanais
                         where idfechamento = t.idfechamento) "Fechamento"
                     , identificacao
                     , decode(emmaos,'S','Sim','N','Não') "Em Mãos"
                     , null link
                     , decode(semfundo,'S','Sim','N','Não')  semfundo
                     , ( select count(1)
                         from anexosemprestimospgtos a
                         where a.idpagamento = t.idpagamento ) qtdanexos
                from pagamentosemprestimos t
                where idemprestimo = :P204_IDEMPRESTIMO
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from pagamentosemprestimos t
                where idemprestimo = :P204_IDEMPRESTIMO
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhum pagamento efetuado.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
