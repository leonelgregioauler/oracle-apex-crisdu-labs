    region total (
        name: Total
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                    select 'TOTAL GERAL' nome
                         , case
                                when :P736_PERIODO = 'C' then
                                    sum(nvl(desafiocalculadoatual,0)) 
                                    
                                when :P736_PERIODO = 'S' then
                                    sum(nvl(desafiocalculadoatual_semanal,0))
                                    
                           end desafiocalculadoatual
                
                         , case
                                when :P736_PERIODO = 'C' then
                                    sum((nvl(desafiocalculadoatual,0) / case
                                                                            when :P736_PERIODO = 'C' then 
                                                                                (select count(*)
                                                                                  from roman.semana_dias s
                                                                                 where s.cicloromance = :P736_CICLOROMANCE)
                                                                            when :P736_PERIODO = 'S' then
                                                                                (select count(*)
                                                                                  from roman.semana_dias s
                                                                                 where s.cicloromance in (select cicloromance from semana_dias where idsemana between :P736_SEMANAINICIAL and :P736_SEMANAFINAL)
                                                                                 )
                                                                        end )
                                      * ( case
                                            when trunc(sysdate) > case
                                                                    when :P736_PERIODO = 'C' then
                                                                        (select max(dt_fim)
                                                                           from roman.semana_dias
                                                                          where cicloromance = :P736_CICLOROMANCE)
                                                                    when :P736_PERIODO = 'S' then
                                                                        (select max(dt_fim)
                                                                           from roman.semana_dias s
                                                                          where s.idsemana between :P736_SEMANAINICIAL and :P736_SEMANAFINAL)
                                                                  end
                                            then
                                                case
                                                    when :P736_PERIODO = 'C' then
                                                        (select count(*)
                                                          from roman.semana_dias
                                                         where cicloromance = :P736_CICLOROMANCE)
                                                    when :P736_PERIODO = 'S' then
                                                        (select count(*)
                                                           from roman.semana_dias s
                                                          where s.idsemana between :P736_SEMANAINICIAL and :P736_SEMANAFINAL)
                                                end
                                            else
                                                case
                                                    when :P736_PERIODO = 'C' then
                                                         (select greatest(count(1), 1)
                                                            from roman.semana_dias
                                                           where cicloromance = :P736_CICLOROMANCE
                                                             and dt_fim <= trunc(sysdate))
                                                    when :P736_PERIODO = 'S' then
                                                         (select greatest(count(1), 1)
                                                            from roman.semana_dias
                                                           where idsemana between :P736_SEMANAINICIAL and :P736_SEMANAFINAL
                                                             and dt_ini <= trunc(sysdate))
                                                end
                                            end))
                                when :P736_PERIODO = 'S' then
                                    sum(nvl(desafiocalculadoatual_semanal,0))
                                end idealateomomento
                         , sum(totalcobranca) totalcobranca
                         , case
                                when :P736_PERIODO = 'C' then
                                    round(favorita.pck_util_fav.fnc_divisor_zero(sum(totalcobranca), sum(nvl(desafiocalculadoatual,0))) * 100, 2)
                                when :P736_PERIODO = 'S' then
                                    round(favorita.pck_util_fav.fnc_divisor_zero(sum(totalcobranca), sum(nvl(desafiocalculadoatual_semanal,0))) * 100, 2)
                           end "%Realizado"
                         , sum(valorfaltanteporsemana) valorfaltanteporsemana
                         , case 
                              when :P736_PERIODO = 'C' and ( sum(REALIZADO) = 0 or
                                 min(SEMREST) = 5 and round(sum(totalcobranca) / sum(nvl(desafiocalculadoatual,0)) * 100,2) < 16.67 or
                                 min(SEMREST) = 4 and round(sum(totalcobranca) / sum(nvl(desafiocalculadoatual,0)) * 100,2) < 33.33 or
                                 min(SEMREST) = 3 and round(sum(totalcobranca) / sum(nvl(desafiocalculadoatual,0)) * 100,2) < 50 or
                                 min(SEMREST) = 2 and round(sum(totalcobranca) / sum(nvl(desafiocalculadoatual,0)) * 100,2) < 66.67 or
                                 min(SEMREST) = 1 and round(sum(totalcobranca) / sum(nvl(desafiocalculadoatual,0)) * 100,2) < 83.33 or
                                 min(SEMREST) = 0 and round(sum(totalcobranca) / sum(nvl(desafiocalculadoatual,0)) * 100,2) < 100 ) then
                                'RED'   -- 'u-color-7-bg'
                              when :P736_PERIODO = 'S' and ( sum(REALIZADO) = 0 or
                                 min(SEMREST) = 5 and round(sum(totalcobranca) / sum(nvl(desafiocalculadoatual_semanal,0)) * 100,2) < 16.67 or
                                 min(SEMREST) = 4 and round(sum(totalcobranca) / sum(nvl(desafiocalculadoatual_semanal,0)) * 100,2) < 33.33 or
                                 min(SEMREST) = 3 and round(sum(totalcobranca) / sum(nvl(desafiocalculadoatual_semanal,0)) * 100,2) < 50 or
                                 min(SEMREST) = 2 and round(sum(totalcobranca) / sum(nvl(desafiocalculadoatual_semanal,0)) * 100,2) < 66.67 or
                                 min(SEMREST) = 1 and round(sum(totalcobranca) / sum(nvl(desafiocalculadoatual_semanal,0)) * 100,2) < 83.33 or
                                 min(SEMREST) = 0 and round(sum(totalcobranca) / sum(nvl(desafiocalculadoatual_semanal,0)) * 100,2) < 100 ) then
                                'RED' -- 'u-color-7-bg'
                             else
                                'GREEN'--'u-color-20-bg'
                           end css_color
                      from (
                             select fi.nome
                                  , m.desafiocalculadoatual * fi.fatorconversao desafiocalculadoatual
                                  , 0 desafiocalculadoatual_semanal
                                  , nvl(tf.totalcobranca * fi.fatorconversao,0) totalcobranca
                                  , case when m.desafiocalculadoatual > 0
                                           then round((nvl(tf.totalcobranca * fi.fatorconversao,0) / (m.desafiocalculadoatual * fi.fatorconversao) ) * 100,2)
                                         when m.desafiocalculadoatual = 0 and tf.totalcobranca > 0 
                                           then round(nvl(tf.totalcobranca * fi.fatorconversao,0)  * 100,2)
                                         else 0
                                     end realizado
                                    --
                                  , CASE WHEN
                                           (select count(*)
                                              from semana_dias 
                                             where cicloromance = :P736_CICLOROMANCE
                                               and dt_fim > trunc(sysdate) ) = 0 THEN
                                           0
                                         ELSE
                                           ((m.desafiocalculadoatual - nvl(tf.totalcobranca,0)) * fi.fatorconversao)  / 
                                           (select count(*)
                                              from semana_dias 
                                             where cicloromance = :P736_CICLOROMANCE
                                               and dt_fim > trunc(sysdate) ) 
                                    END valorfaltanteporsemana
                                    --
                                  , :P736_SEMANASRESTANTES SEMREST
                               from metasdesafioromance m
                                  , ( select f.idfilial
                                           , f.fatorconversao
                                           , f.ididioma
                                           , f.nome
                                           , f.regional
                                           , f.pertencecomercialromance
                                           , case when f.tipofilial = 'D' and
                                                       f.regional is null and 
                                                       f.ididioma = 1     and 
                                                       f.idfilial not in (1217,1246,1063,1149) and 
                                                       f.idgerente is not null
                                                    then 5
                                                  else
                                                    null
                                              end regional_5
                                        from roman.vw_filiais f
                                       where f.ativo = 'S' ) fi
                                  , ( select f.idfilial
                                           , nvl(sum(fr.totalgeral),0) totalcobranca
                                        from fechamentossemanais f
                                           , fechamentorepresentantes fr
                                           , representantes re
                                           , vw_filiais fi
                                       where fr.idfechamento = f.idfechamento
                                         and f.idfilial = fi.idfilial
                                         and fr.idrepresentante = re.idrepresentante
                                         and fi.tipofilial = 'D'
                                         and f.idsemana in (select idsemana
                                                              from semana_dias 
                                                             where semanacompleta in (select semanacompleta anterior
                                                                                        from semana_dias s
                                                                                       where cicloromance = :P736_CICLOROMANCE) )
                                       group by f.idfilial ) tf
                              where m.cicloromance = :P736_CICLOROMANCE
                                and m.idfilial = fi.idfilial
                                and m.idfilial = tf.idfilial(+)
                                and m.idfilial = nvl(:P736_IDFILIAL, m.idfilial)
                                and exists (select 1
                                              from gerentes g
                                                 , usuarios u
                                              where g.idpessoa = u.idpessoa
                                              and g.idfilial = m.idfilial
                                              and u.usuario = v('APP_USER')
                                            UNION
                                            select 1
                                              from dual 
                                              where v('APP_USER') in ('RAFAELK')
                                            UNION
                                            select 1
                                            from gerentes g
                                               , usuarios u
                                            where g.idpessoa = u.idpessoa
                                            and :P736_REGIONAL = 7
                                            and u.usuario = v('APP_USER')
                                            UNION
                                            select 1
                                              from usuarios u
                                             where u.usuario = v('APP_USER')
                                             and not exists ( select 1 from gerentes g where g.idpessoa = u.idpessoa))
                                and :P736_PERIODO = 'C'
                                and ( :P736_REGIONAL = 5  and fi.regional_5 = :P736_REGIONAL or
                                      :P736_REGIONAL = 7 and exists ( select 1 from usuariosfiliais uf where uf.usuario = v('APP_USER') and uf.idfilial = fi.idfilial ) or
                                      :P736_REGIONAL = 10 and fi.ididioma = 1 or
                                      :P736_REGIONAL = 20 and fi.ididioma != 1 or
                                      :P736_REGIONAL = 99 and pertencecomercialromance = 'S' or
                                      fi.regional = :P736_REGIONAL) 
                            
                            union all
                
                            select fi.nome
                                 , m.desafiocalculadoatual * fi.fatorconversao desafiocalculadoatual
                                 , case
                                        when s.dt_ini <= trunc(sysdate) then 
                                            (m.desafiocalculadoatual / total_semanas) * fi.fatorconversao
                                        else
                                            0
                                   end desafiocalculadoatual_semanal
                                 , nvl(tf.totalcobranca * fi.fatorconversao,0) totalcobranca
                                 , case when m.desafiocalculadoatual > 0 then
                                            round(( favorita.pck_util_fav.fnc_divisor_zero( (tf.totalcobranca * fi.fatorconversao) , (m.desafiocalculadoatual * fi.fatorconversao) ) ) * 100,2)
                                        when m.desafiocalculadoatual = 0 and tf.totalcobranca > 0  then 
                                            round(nvl(tf.totalcobranca * fi.fatorconversao,0)  * 100,2)
                                        else 0
                                   end realizado
                                   --
                                 , case when
                                            (select count(*)
                                               from semana_dias S
                                              where s.idsemana between :P736_SEMANAINICIAL and :P736_SEMANAFINAL
                                                and S.dt_fim > trunc(sysdate) ) = 0 THEN
                                               0
                                        ELSE
                                            favorita.pck_util_fav.fnc_divisor_zero( (((m.desafiocalculadoatual / sc.total_semanas) - nvl(tf.totalcobranca,0)) * fi.fatorconversao),
                                                (select count(*)
                                                  from semana_dias s
                                                 where s.idsemana between :P736_SEMANAINICIAL and :P736_SEMANAFINAL
                                                   and s.dt_fim > trunc(sysdate) ) ) 
                                        END valorfaltanteporsemana
                                    --
                                 , :P736_SEMANASRESTANTES SEMREST
                               from metasdesafioromance m
                                  , semana_dias s
                                  , ( select cicloromance
                                             , count(*) total_semanas
                                        from roman.semana_dias
                                     group by cicloromance ) sc
                                  , ( select f.idfilial,
                                             f.fatorconversao,
                                             f.ididioma,
                                             f.nome,
                                             f.regional,
                                             f.pertencecomercialromance,
                                             case when f.tipofilial = 'D' and
                                                       f.regional is null and 
                                                       f.ididioma = 1     and 
                                                       f.idfilial not in (1217,1246,1063,1149) and 
                                                       f.idgerente is not null
                                                    then 5
                                                  else
                                                    null
                                              end regional_5
                                        from roman.vw_filiais f
                                       where f.ativo = 'S' ) fi
                                  , ( select f.idfilial
                                           , s.idsemana
                                           , nvl(sum(fr.totalgeral),0) totalcobranca
                                        from fechamentossemanais f
                                           , fechamentorepresentantes fr
                                           , representantes re
                                           , roman.semana_dias s
                                           , vw_filiais fi
                                       where fr.idfechamento = f.idfechamento
                                         and f.idfilial = fi.idfilial
                                         and fr.idrepresentante = re.idrepresentante
                                         and fi.tipofilial = 'D'
                                         and f.idsemana     = s.idsemana
                                         and s.idsemana between :P736_SEMANAINICIAL and :P736_SEMANAFINAL
                                       group by f.idfilial, s.idsemana ) tf
                              where m.cicloromance = s.cicloromance
                                and m.cicloromance = sc.cicloromance
                                and m.idfilial = fi.idfilial
                                and m.idfilial = tf.idfilial(+)
                                and s.idsemana = tf.idsemana(+)
                                and m.idfilial = nvl(:P736_IDFILIAL, m.idfilial)
                                and exists (select 1
                                              from gerentes g
                                                 , usuarios u
                                              where g.idpessoa = u.idpessoa
                                              and g.idfilial = m.idfilial
                                              and u.usuario = v('APP_USER')
                                            UNION
                                            select 1
                                              from dual 
                                              where v('APP_USER') in ('RAFAELK')
                                            UNION
                                            select 1
                                              from gerentes g
                                                 , usuarios u
                                             where g.idpessoa = u.idpessoa
                                             and :P736_REGIONAL = 7
                                            and u.usuario = v('APP_USER')
                                            UNION
                                            select 1
                                              from usuarios u
                                             where u.usuario = v('APP_USER')
                                             and not exists ( select 1 from gerentes g where g.idpessoa = u.idpessoa))
                                and :P736_PERIODO = 'S'
                                and s.idsemana between :P736_SEMANAINICIAL and :P736_SEMANAFINAL
                                and ( :P736_REGIONAL = 5  and fi.regional_5 = :P736_REGIONAL or
                                      :P736_REGIONAL = 7 and exists ( select 1 from usuariosfiliais uf where uf.usuario = v('APP_USER') and uf.idfilial = fi.idfilial ) or
                                      :P736_REGIONAL = 10 and fi.ididioma = 1 or
                                      :P736_REGIONAL = 20 and fi.ididioma != 1 or
                                      :P736_REGIONAL = 99 and pertencecomercialromance = 'S' or
                                      fi.regional = :P736_REGIONAL ) 
                      )
                ```
            pageItemsToSubmit: [
                P736_CICLOROMANCE
                P736_REGIONAL
                P736_SEMANAINICIAL
                P736_SEMANAFINAL
                P736_IDFILIAL
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
