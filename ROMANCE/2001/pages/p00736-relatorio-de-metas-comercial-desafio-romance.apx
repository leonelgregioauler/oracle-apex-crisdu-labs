    pageItem P736_ANO (
        type: selectList
        label {
            label: Ano
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ANO D
                     , ANO R
                  FROM ( 
                        SELECT EXTRACT(YEAR FROM SYSDATE)  ANO FROM DUAL 
                        UNION
                        SELECT EXTRACT(YEAR FROM SYSDATE)-1  ANO FROM DUAL 
                        UNION
                        SELECT EXTRACT(YEAR FROM SYSDATE) + 1
                          FROM DUAL
                         WHERE EXTRACT(MONTH FROM SYSDATE) > 10  )
                 ORDER BY 1
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P736_CICLOROMANCE (
        type: selectList
        label {
            label: Ciclo Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CICLOROMANCE || ' - De   ' ||
                       (select semanacompleta semanaini
                          from semana_dias 
                         where idsemana = (select min(idsemana)
                                             from semana_dias
                                            where cicloromance = sd.cicloromance)) 
                       || ' Até ' ||
                       (select semanacompleta semanaini
                          from semana_dias 
                         where idsemana = (select max(idsemana)
                                             from semana_dias
                                            where cicloromance = sd.cicloromance))   D
                     --
                     , CICLOROMANCE R
                  FROM (
                        SELECT distinct s.cicloromance
                          FROM semana_dias s
                             , metasdesafioromance m
                         WHERE s.cicloromance = m.cicloromance
                           AND s.ano = :P736_ANO
                           AND m.idfilial = nvl(:P736_IDFILIAL, m.idfilial)
                           AND s.cicloromance is not null
                           AND m.datacongelado is not null ) sd
                     
                 ORDER BY to_number(substr(cicloromance,4,4)), 
                           to_number(substr(cicloromance,1,2))
                ```
        }
        cascadingLov {
            parentItems: [
                P736_ANO
                P736_IDFILIAL
            ]
            parentRequired: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                margin-right-none
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P736_IDFILIAL (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido, p.nomepessoa)) display_value
                     , f.idfilial
                from pessoas p
                   , filiais f
                where p.idpessoa = f.idpessoa
                  and f.tipofilial = 'D' /*distribuidora*/
                  and f.ativo = 'S'
                  and ( f.regional = :P736_REGIONAL
                     or f.ididioma  = 1 and :P736_REGIONAL = 10   -- BRASIL
                     or nvl(f.ididioma, 0) != 1 and :P736_REGIONAL = 20   -- EXTERIOR
                     or :P736_REGIONAL = 99 and pertencecomercialromance = 'S' )
                  and exists (select 1
                              from gerentes g
                                 , usuarios u
                              where g.idpessoa = u.idpessoa
                              and g.idfilial = f.idfilial
                              and u.usuario = v('APP_USER')
                              UNION
                              select 1
                              from dual 
                              where v('APP_USER') in ('RAFAELK', 'MAIQUELLINDEN', 'RENATAF')
                              UNION
                              select 1
                              from usuarios u
                              where u.usuario = v('APP_USER')
                              and not exists ( select 1 
                                                 from gerentes g 
                                                where g.idpessoa = u.idpessoa ))
                UNION
                select initcap(nvl(p.apelido, p.nomepessoa)) display_value
                     , f.idfilial
                from pessoas p
                   , filiais f
                where p.idpessoa = f.idpessoa
                  and f.tipofilial = 'D' /*distribuidora*/
                  and f.ativo = 'S'
                  and :P736_REGIONAL = 7
                  and exists (select 1
                              from usuariosfiliais uf
                                 , gerentes g
                                 , usuarios u
                              where g.idpessoa = u.idpessoa
                              and uf.usuario = u.usuario
                              and uf.idfilial = f.idfilial
                              and u.usuario = v('APP_USER'))
                order by 1
                ```
            nullDisplayValue: -- Todas --
        }
        cascadingLov {
            parentItems: P736_REGIONAL
            parentRequired: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

