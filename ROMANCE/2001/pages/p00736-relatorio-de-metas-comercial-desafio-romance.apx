    region ideal-até-o-momento (
        name: Ideal até o momento
        type: chart
        layout {
            sequence: 10
            parentRegion: @totais
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chart {
            type: statusMeterGauge
        }
        title {
            title: Ideal até o momento
        }
        chartLayout {
            maxWidth: 600
        }
        performance {
            lazyLoading: true
        }
        gauge {
            orientation: horizontal
        }
        value {
            position: center
            format: decimal
            formatScaling: million
        }

        series ideal-até-o-momento (
            name: Ideal até o momento
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome
                         , totalcobranca atingido
                         , ideal
                         , 'Ideal: ' || to_char(ideal, '999G999G999G999G990D00') ideal_tooltip
                         , ideal - 1 ideal_abaixo
                         , ideal + 1 ideal_acima
                         , cor_ideal_abaixo
                         , cor_ideal_acima
                    from (
                        select 'Ideal até o momento' nome
                             , trunc(sum(ideal)) ideal
                             , trunc(sum(totalcobranca), 2) totalcobranca
                             , '#ff7755' cor_ideal_abaixo
                             , '#99ff99' cor_ideal_acima
                             
                          from (
                                 select m.desafiocalculadoatual * fi.fatorconversao desafiocalculadoatual
                                      , TRUNC(( nvl(m.desafiocalculadoatual * fi.fatorconversao,0) / (select count(*)
                                                                                                        from roman.semana_dias s
                                                                                                       where s.cicloromance = :P736_CICLOROMANCE))
                                          * ( case
                                                when trunc(sysdate) > (select max(dt_fim)
                                                                         from roman.semana_dias
                                                                        where cicloromance = :P736_CICLOROMANCE)
                                                then
                                                     (select count(*)
                                                        from roman.semana_dias
                                                       where cicloromance = :P736_CICLOROMANCE)
                                                else
                                                     (select greatest(count(1), 1)
                                                        from roman.semana_dias
                                                       where cicloromance = :P736_CICLOROMANCE
                                                         and dt_fim <= trunc(sysdate))
                                              end)) ideal
                                      , nvl(tf.totalcobranca * fi.fatorconversao,0) totalcobranca
                                   from metasdesafioromance m
                                      , ( select f.idfilial
                                               , f.fatorconversao
                                               , f.ididioma
                                               , f.nome
                                               , f.regional
                                               , f.pertencecomercialromance
                                               , case when f.tipofilial = 'D' and
                                                           f.regional is null and 
                                                           f.ididioma = 1     and 
                                                           f.idfilial not in (1217,1246,1063,1149) and 
                                                           f.idgerente is not null
                                                        then 5
                                                      else
                                                        null
                                                  end regional_5
                                            from roman.vw_filiais f
                                           where f.ativo = 'S' ) fi
                                      , ( select f.idfilial
                                               , nvl(sum(fr.totalgeral),0) totalcobranca
                                            from fechamentossemanais f
                                               , fechamentorepresentantes fr
                                               , representantes re
                                               , vw_filiais fi
                                           where fr.idfechamento = f.idfechamento
                                             and f.idfilial = fi.idfilial
                                             and fr.idrepresentante = re.idrepresentante
                                             and fi.tipofilial = 'D'
                                             and f.idsemana in (select idsemana
                                                                  from semana_dias 
                                                                 where semanacompleta in (select semanacompleta anterior
                                                                                            from semana_dias s
                                                                                           where cicloromance = :P736_CICLOROMANCE) )
                                           group by f.idfilial ) tf
                                  where m.cicloromance = :P736_CICLOROMANCE
                                    and m.idfilial = fi.idfilial
                                    and m.idfilial = tf.idfilial(+)
                                    and m.idfilial = nvl(:P736_IDFILIAL, m.idfilial)
                                    and exists (select 1
                                                  from gerentes g
                                                     , usuarios u
                                                 where g.idpessoa = u.idpessoa
                                                   and g.idfilial = m.idfilial
                                                   and u.usuario = v('APP_USER')
                                                UNION
                                                select 1
                                                  from dual
                                                 where v('APP_USER') in ('RAFAELK')
                                                UNION
                                                select 1
                                                  from gerentes g
                                                     , usuarios u
                                                 where g.idpessoa = u.idpessoa
                                                   and :P736_REGIONAL = 7
                                                   and u.usuario = v('APP_USER')
                                                UNION
                                                select 1
                                                  from usuarios u
                                                 where u.usuario = v('APP_USER')
                                                   and not exists ( select 1 from gerentes g where g.idpessoa = u.idpessoa))
                                    and :P736_PERIODO = 'C'
                                    and ( :P736_REGIONAL = 5  and fi.regional_5 = :P736_REGIONAL or
                                          :P736_REGIONAL = 7  and exists ( select 1 from usuariosfiliais uf where uf.usuario = v('APP_USER') and uf.idfilial = fi.idfilial ) or
                                          :P736_REGIONAL = 10 and fi.ididioma = 1 or
                                          :P736_REGIONAL = 20 and fi.ididioma != 1 or
                                          :P736_REGIONAL = 99 and pertencecomercialromance = 'S' or
                                          fi.regional = :P736_REGIONAL) )
                    
                        union all
                    
                        select 'Ideal até o momento' nome
                             , trunc(sum(ideal)) ideal
                             , trunc(sum(totalcobranca), 2) totalcobranca
                             , '#FF7755' cor_ideal_abaixo
                             , '#99FF99' cor_ideal_acima
                          from (
                               select case
                                        when s.dt_ini <= trunc(sysdate) then 
                                            (m.desafiocalculadoatual / sc.total_semanas) * fi.fatorconversao
                                        else 0
                                      end ideal
                                    , nvl(tf.totalcobranca, 0) * fi.fatorconversao totalcobranca
                                 from roman.metasdesafioromance m
                                    , roman.semana_dias s
                                    , ( select cicloromance
                                             , count(*) total_semanas
                                          from roman.semana_dias
                                         group by cicloromance ) sc
                                    , ( select f.idfilial
                                             , f.ididioma
                                             , f.fatorconversao
                                             , f.nome
                                             , f.regional
                                             , f.pertencecomercialromance
                                          from roman.vw_filiais f
                                         where f.ativo = 'S' ) fi
                                    , ( select f.idfilial
                                             , s.idsemana
                                             , sum(fr.totalgeral) totalcobranca
                                          from roman.fechamentossemanais f
                                             , roman.fechamentorepresentantes fr
                                             , catal.representantes re
                                             , roman.semana_dias s
                                             , roman.vw_filiais fi
                                         where fr.idfechamento = f.idfechamento
                                           and f.idfilial     = fi.idfilial
                                           and fr.idrepresentante = re.idrepresentante
                                           and fi.tipofilial  = 'D'
                                           and f.idsemana     = s.idsemana
                                           and s.idsemana between :P736_SEMANAINICIAL and :P736_SEMANAFINAL
                                         group by f.idfilial, s.idsemana ) tf
                                where m.cicloromance = s.cicloromance
                                  and m.cicloromance = sc.cicloromance
                                  and m.idfilial     = fi.idfilial
                                  and m.idfilial     = tf.idfilial(+)
                                  and s.idsemana     = tf.idsemana(+)
                                  and m.idfilial     = nvl(:P736_IDFILIAL, m.idfilial)
                                  and exists (select 1
                                                from gerentes g
                                                   , usuarios u
                                               where g.idpessoa = u.idpessoa
                                                 and g.idfilial = m.idfilial
                                                 and u.usuario = v('APP_USER')
                                              UNION
                                              select 1
                                                from dual
                                                where v('APP_USER') in ('RAFAELK')
                                              UNION
                                              select 1
                                                from gerentes g
                                                   , usuarios u
                                               where g.idpessoa = u.idpessoa
                                                 and :P736_REGIONAL = 7
                                                 and u.usuario = v('APP_USER')
                                              UNION
                                              select 1
                                                from usuarios u
                                               where u.usuario = v('APP_USER')
                                                 and not exists ( select 1 from gerentes g where g.idpessoa = u.idpessoa))
                                  and :P736_PERIODO = 'S'
                                  and s.idsemana between :P736_SEMANAINICIAL and :P736_SEMANAFINAL
                                  and ( :P736_REGIONAL = 7 and exists ( select 1 from usuariosfiliais uf where uf.usuario = v('APP_USER') and uf.idfilial = fi.idfilial ) or
                                        :P736_REGIONAL in (1,2,3,4,5) and fi.regional = :P736_REGIONAL or
                                        :P736_REGIONAL = 10 and fi.ididioma = 1 or
                                        :P736_REGIONAL = 20 and fi.ididioma != 1 or
                                        :P736_REGIONAL = 99 and fi.pertencecomercialromance = 'S' )
                        )
                    )
                    where totalcobranca is not null
                    ```
                pageItemsToSubmit: [
                    P736_CICLOROMANCE
                    P736_REGIONAL
                    P736_SEMANASRESTANTES
                    P736_IDFILIAL
                ]
            }
            columnMapping {
                label: ATINGIDO
                value: ATINGIDO
                maxValue: IDEAL
                customTooltip: IDEAL_TOOLTIP
            }
            thresholds {
                values: &IDEAL_ABAIXO.,&IDEAL_ACIMA.
                colors: &COR_IDEAL_ABAIXO.,&COR_IDEAL_ACIMA.
                display: onIndicator
            }
        )

    )

    region relatorio-de-metas-comercial-desafio-romance (
        name: Relatorio de Metas Comercial - Desafio Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 1 tipo
                     , nome 
                     , nvl(desafiocalculadoatual,0) desafiocalculadoatual
                     , idealateomomento
                     , totalcobranca
                     , case when desafiocalculadoatual = 0
                              then 0
                            else realizado 
                        end "%Realizado"
                     , case when valorfaltanteporsemana > 0
                            then valorfaltanteporsemana
                            else 0
                        end valorfaltanteporsemana
                     , case when REALIZADO = 0 or
                                 SEMREST = 5 and realizado < 16.67 or
                                 SEMREST = 4 and realizado < 33.33 or
                                 SEMREST = 3 and realizado < 50 or
                                 SEMREST = 2 and realizado < 66.67 or
                                 SEMREST = 1 and realizado < 83.33 or
                                 SEMREST = 0 and realizado < 100 then
                               'RED'   -- 'u-color-7-bg'
                             else
                               'GREEN'--'u-color-20-bg'
                        end css_color
                from (
                    select  fi.nome
                          , m.desafiocalculadoatual * /*fi.fatorconversao*/ 1 desafiocalculadoatual
                          , (nvl(m.desafiocalculadoatual * /*fi.fatorconversao*/ 1,0) / (select count(*)
                                                                                     from roman.semana_dias s
                                                                                    where s.cicloromance = :P736_CICLOROMANCE))
                              * ( case
                                    when trunc(sysdate) > (select max(dt_fim)
                                                             from roman.semana_dias
                                                            where cicloromance = :P736_CICLOROMANCE)
                                    then
                                         (select count(*)
                                            from roman.semana_dias
                                           where cicloromance = :P736_CICLOROMANCE)
                                    else
                                         (select greatest(count(1), 1)
                                            from roman.semana_dias
                                           where cicloromance = :P736_CICLOROMANCE
                                             and dt_fim <= trunc(sysdate))
                                  end) idealateomomento
                          , nvl(tf.totalcobranca * /*fi.fatorconversao*/ 1,0) totalcobranca
                          , case when m.desafiocalculadoatual > 0 
                                   then round((nvl(tf.totalcobranca * /*fi.fatorconversao*/ 1,0) / (m.desafiocalculadoatual * /*fi.fatorconversao*/ 1) ) * 100,2)
                                 when m.desafiocalculadoatual = 0 and tf.totalcobranca > 0 
                                   then round(nvl(tf.totalcobranca * /*fi.fatorconversao*/ 1,0)  * 100,2)
                                 else 0
                             end realizado
                            --
                          , case when
                                   (select count(*)
                                      from semana_dias 
                                     where cicloromance = :P736_CICLOROMANCE
                                       and dt_fim > trunc(sysdate) ) = 0 THEN
                                   0
                                 ELSE
                                   ((m.desafiocalculadoatual - nvl(tf.totalcobranca,0)) * /*fi.fatorconversao*/ 1)  / 
                                   (select count(*)
                                      from semana_dias 
                                     where cicloromance = :P736_CICLOROMANCE
                                       and dt_fim > trunc(sysdate) ) 
                            END valorfaltanteporsemana
                            --
                          , (select count(*)
                               from semana_dias 
                              where cicloromance = :P736_CICLOROMANCE
                                and dt_fim > trunc(sysdate)) SEMREST
                       from metasdesafioromance m
                          , ( select f.idfilial,
                                     f.ididioma,
                                     f.fatorconversao,
                                     f.nome,
                                     f.regional,
                                     f.pertencecomercialromance,
                                     case when f.tipofilial = 'D' and
                                               f.regional is null and 
                                               f.ididioma = 1     and 
                                               f.idfilial not in (1217,1246,1063,1149) and 
                                               f.idgerente is not null
                                            then 5
                                          else
                                            null
                                      end regional_5
                                from roman.vw_filiais f
                               where f.ativo = 'S' ) fi
                          , ( select f.idfilial
                                   , nvl(sum(fr.totalgeral),0) totalcobranca
                                from fechamentossemanais f
                                   , fechamentorepresentantes fr
                                   , representantes re
                                   , vw_filiais fi
                               where fr.idfechamento = f.idfechamento
                                 and f.idfilial = fi.idfilial
                                 and fr.idrepresentante = re.idrepresentante
                                 and fi.tipofilial = 'D'
                                 and f.idsemana in (select idsemana
                                                      from semana_dias 
                                                     where semanacompleta in (select semanacompleta anterior
                                                                                from semana_dias s
                                                                               where cicloromance = :P736_CICLOROMANCE) )
                               group by f.idfilial ) tf
                      where m.cicloromance = :P736_CICLOROMANCE
                        and m.idfilial = fi.idfilial
                        and m.idfilial = tf.idfilial(+)
                        and m.idfilial = nvl(:P736_IDFILIAL, m.idfilial)
                        and exists (select 1
                                      from gerentes g
                                         , usuarios u
                                      where g.idpessoa = u.idpessoa
                                      and g.idfilial = m.idfilial
                                      and u.usuario = v('APP_USER')
                                    UNION
                                    select 1
                                    from dual 
                                    where v('APP_USER') in ('RAFAELK')
                                    UNION
                                    select 1
                                      from gerentes g
                                         , usuarios u
                                      where g.idpessoa = u.idpessoa
                                      and :P736_REGIONAL = 7
                                      and u.usuario = v('APP_USER')
                                    UNION
                                    select 1
                                      from usuarios u
                                     where u.usuario = v('APP_USER')
                                     and not exists ( select 1 from gerentes g where g.idpessoa = u.idpessoa))
                        and :P736_PERIODO = 'C'
                        and ( :P736_REGIONAL = 7 and exists ( select 1 from usuariosfiliais uf where uf.usuario = v('APP_USER') and uf.idfilial = fi.idfilial ) or
                              :P736_REGIONAL in (1,2,3,4,5) and fi.regional = :P736_REGIONAL or
                              :P736_REGIONAL = 10 and fi.ididioma = 1 or
                              :P736_REGIONAL = 20 and fi.ididioma != 1 or
                              :P736_REGIONAL = 99 and fi.pertencecomercialromance = 'S' )
                    )
                
                    union all
                
                    select 1 tipo
                         , nome
                         , sum(desafiosemanal)                        desafiocalculadoatual
                         , sum(idealateomomento)                      idealateomomento
                         , sum(totalcobranca)                         totalcobranca
                         , case
                             when sum(desafiosemanal) > 0
                             then round((sum(totalcobranca) / sum(desafiosemanal)) * 100, 2)
                             else 0
                           end "%Realizado"
                         , case
                             when sum(semanas_restantes) > 0
                             then (sum(desafiosemanal) - sum(totalcobranca))
                                  / sum(semanas_restantes)
                             else 0
                           end valorfaltanteporsemana
                         , case
                             when sum(totalcobranca) = 0 then 'RED'
                             when sum(semanas_restantes) = 5 and
                                  (sum(totalcobranca) / sum(desafiosemanal)) * 100 < 16.67 then 'RED'
                             when sum(semanas_restantes) = 4 and
                                  (sum(totalcobranca) / sum(desafiosemanal)) * 100 < 33.33 then 'RED'
                             when sum(semanas_restantes) = 3 and
                                  (sum(totalcobranca) / sum(desafiosemanal)) * 100 < 50    then 'RED'
                             when sum(semanas_restantes) = 2 and
                                  (sum(totalcobranca) / sum(desafiosemanal)) * 100 < 66.67 then 'RED'
                             when sum(semanas_restantes) = 1 and
                                  (sum(totalcobranca) / sum(desafiosemanal)) * 100 < 83.33 then 'RED'
                             when sum(semanas_restantes) = 0 and
                                  (sum(totalcobranca) / sum(desafiosemanal)) * 100 < 100   then 'RED'
                             else 'GREEN'
                           end css_color
                    from (
                           select fi.nome
                                , fi.idfilial
                                , (m.desafiocalculadoatual / sc.total_semanas) * /*fi.fatorconversao*/ 1 desafiosemanal
                                , case
                                    when s.dt_ini <= trunc(sysdate) then 
                                        (m.desafiocalculadoatual / sc.total_semanas) * /*fi.fatorconversao*/ 1
                                    else 0
                                  end idealateomomento
                                , nvl(tf.totalcobranca, 0) * /*fi.fatorconversao*/ 1 totalcobranca
                                , case
                                    when s.dt_fim > trunc(sysdate) then 1
                                    else 0
                                  end semanas_restantes
                             from roman.metasdesafioromance m
                                , roman.semana_dias s
                                , ( select cicloromance
                                         , count(*) total_semanas
                                      from roman.semana_dias
                                     group by cicloromance ) sc
                                , ( select f.idfilial
                                         , f.ididioma
                                         , f.fatorconversao
                                         , f.nome
                                         , f.regional
                                         , f.pertencecomercialromance
                                      from roman.vw_filiais f
                                     where f.ativo = 'S' ) fi
                                , ( select f.idfilial
                                         , s.idsemana
                                         , sum(fr.totalgeral) totalcobranca
                                      from roman.fechamentossemanais f
                                         , roman.fechamentorepresentantes fr
                                         , catal.representantes re
                                         , roman.semana_dias s
                                         , roman.vw_filiais fi
                                     where fr.idfechamento = f.idfechamento
                                       and f.idfilial = fi.idfilial
                                       and fr.idrepresentante = re.idrepresentante
                                       and fi.tipofilial  = 'D'
                                       and f.idsemana = s.idsemana
                                       and s.idsemana between :P736_SEMANAINICIAL and :P736_SEMANAFINAL
                                     group by f.idfilial, s.idsemana ) tf
                            where m.cicloromance = s.cicloromance
                              and m.cicloromance = sc.cicloromance
                              and m.idfilial     = fi.idfilial
                              and m.idfilial     = tf.idfilial(+)
                              and s.idsemana     = tf.idsemana(+)
                              and m.idfilial     = nvl(:P736_IDFILIAL, m.idfilial)
                              and exists (select 1
                                            from gerentes g
                                               , usuarios u
                                           where g.idpessoa = u.idpessoa
                                             and g.idfilial = m.idfilial
                                             and u.usuario = v('APP_USER')
                                          UNION
                                          select 1
                                            from dual 
                                           where v('APP_USER') in ('RAFAELK')
                                          UNION
                                          select 1
                                            from gerentes g
                                               , usuarios u
                                           where g.idpessoa = u.idpessoa
                                             and :P736_REGIONAL = 7
                                             and u.usuario = v('APP_USER')
                                          UNION
                                          select 1
                                            from usuarios u
                                           where u.usuario = v('APP_USER')
                                           and not exists ( select 1 from gerentes g where g.idpessoa = u.idpessoa))
                              and :P736_PERIODO = 'S'
                              and s.idsemana between :P736_SEMANAINICIAL and :P736_SEMANAFINAL
                              and ( :P736_REGIONAL = 7 and exists ( select 1 from usuariosfiliais uf where uf.usuario = v('APP_USER') and uf.idfilial = fi.idfilial ) or
                                    :P736_REGIONAL in (1,2,3,4,5) and fi.regional = :P736_REGIONAL or
                                    :P736_REGIONAL = 10 and fi.ididioma = 1 or
                                    :P736_REGIONAL = 20 and fi.ididioma != 1 or
                                    :P736_REGIONAL = 99 and fi.pertencecomercialromance = 'S' )
                    )    
                group by nome
                order by 2
                /*            
                ---------
                UNION ALL
                ---------
                
                select 2 tipo
                   --  , '<b> TOTAL GERAL ---------------------- </b>'
                     , 'TOTAL GERAL'
                     , sum(nvl(desafiocalculadoatual,0)) desafiocalculadoatual
                     , sum(totalcobranca) totalcobranca
                     , round(sum(totalcobranca) / sum(nvl(desafiocalculadoatual,0)) * 100,2)  "%Realizado"
                     , sum(case when valorfaltanteporsemana > 0
                                then valorfaltanteporsemana
                                else 0
                           end) valorfaltanteporsemana
                     , case when sum(totalcobranca) >= sum(nvl(desafiocalculadoatual,0)) then
                               'GREEN' 
                             else
                               'RED'
                        end css_color
                  from (
                         select fi.nome,
                                m.desafiocalculadoatual * fi.fatorconversao desafiocalculadoatual ,
                                nvl(tf.totalcobranca * fi.fatorconversao,0) totalcobranca,
                                case when m.desafiocalculadoatual > 0 
                                       then round((nvl(tf.totalcobranca * fi.fatorconversao,0) / (m.desafiocalculadoatual * fi.fatorconversao) ) * 100,2)
                                     when m.desafiocalculadoatual = 0 and tf.totalcobranca > 0 
                                       then round(nvl(tf.totalcobranca * fi.fatorconversao,0)  * 100,2)
                                     else 0
                                 end realizado,
                                --
                                CASE WHEN
                                       (select count(*)
                                          from semana_dias 
                                         where cicloromance = :P736_CICLOROMANCE
                                           and dt_fim > trunc(sysdate) ) = 0 THEN
                                       0
                                     ELSE
                                       ((m.desafiocalculadoatual - nvl(tf.totalcobranca,0)) * fi.fatorconversao)  / 
                                       (select count(*)
                                          from semana_dias 
                                         where cicloromance = :P736_CICLOROMANCE
                                           and dt_fim > trunc(sysdate) ) 
                                END valorfaltanteporsemana
                                --
                              , :P736_SEMANASRESTANTES SEMREST
                           from metasdesafioromance m
                              , ( select f.idfilial,
                                         f.fatorconversao,
                                         f.ididioma,
                                         f.nome,
                                         f.regional,
                                         f.pertencecomercialromance,
                                         case when f.tipofilial = 'D' and
                                                   f.regional is null and 
                                                   f.ididioma = 1     and 
                                                   f.idfilial not in (1217,1246,1063,1149) and 
                                                   f.idgerente is not null
                                                then 5
                                              else
                                                null
                                          end regional_5
                                    from roman.vw_filiais f
                                   where f.ativo = 'S' ) fi
                              , ( select f.idfilial
                                       , nvl(sum(fr.totalgeral),0) totalcobranca
                                    from fechamentossemanais f
                                       , fechamentorepresentantes fr
                                       , representantes re
                                       , vw_filiais fi
                                   where fr.idfechamento = f.idfechamento
                                     and f.idfilial = fi.idfilial
                                     and fr.idrepresentante = re.idrepresentante
                                     --and re.ativo  = 'S' -- Comentado para buscar representantes que tiveram vendas no periodo, mas forma inativados no mesmo periodo
                                     and fi.tipofilial = 'D'
                                     and f.idsemana in (select idsemana
                                                          from semana_dias 
                                                         where semanacompleta in (select substr(semanacompleta,1,3)||
                                                                                         to_char(substr(:P736_CICLOROMANCE,4,4) ) anterior
                                                                                    from semana_dias s
                                                                                   where cicloromance = :P736_CICLOROMANCE) ) 
                                   group by f.idfilial ) tf
                          where m.cicloromance = :P736_CICLOROMANCE
                            and m.idfilial = fi.idfilial
                            and m.idfilial = tf.idfilial(+)
                            and ( :P736_REGIONAL = -1 or 
                                  :P736_REGIONAL = 5  and fi.regional_5 = :P736_REGIONAL or
                                  :P736_REGIONAL = 10 and fi.ididioma = 1 or
                                  :P736_REGIONAL = 20 and fi.ididioma != 1 or
                                  :P736_REGIONAL = 99 and pertencecomercialromance = 'S' or
                                  fi.regional = :P736_REGIONAL) ) */
                
                ```
            pageItemsToSubmit: [
                P736_CICLOROMANCE
                P736_REGIONAL
                P736_SEMANAINICIAL
                P736_SEMANAFINAL
                P736_IDFILIAL
            ]
        }
