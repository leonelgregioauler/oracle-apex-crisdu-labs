    pageItem P736_REGIONAL (
        type: selectList
        label {
            label: Regional
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Brasil' display_value
                     , 10
                  from dual
                 where (v('APP_USER') in ('MAIQUELLINDEN', 'RAFAELK', 'RENATAF') -- T12854750
                    or favorita.pck_util_fav.fnc_verificagrupoatendimento(0, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S') -- labs
                --
                UNION
                --
                select 'Exterior' display_value
                     , 20
                from dual
                where (v('APP_USER') in ('MAIQUELLINDEN', 'RAFAELK', 'RENATAF', 'JULIASOUZA','MARIAFLORES','KELLYABREU','ERNESTODELGADO','MARAB','VALQUIRIAS','RENATAFERNANDES') -- T12854750
                   or favorita.pck_util_fav.fnc_verificagrupoatendimento(0, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S') -- labs
                --
                UNION
                --
                select 'Comercial Romance' display_value
                     , 99
                  from dual
                 where (favorita.pck_util_fav.fnc_verificagrupoatendimento(58, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                    or favorita.pck_util_fav.fnc_verificagrupoatendimento(0, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S') -- labs
                --
                UNION
                -- regional 1
                select 'Regional 1' display_value
                     , 1
                  from dual
                 where (favorita.pck_util_fav.fnc_verificagrupoatendimento(90, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                    or favorita.pck_util_fav.fnc_verificagrupoatendimento(0, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S') -- labs
                --
                UNION
                -- regional 2
                select 'Regional 2' display_value
                     , 2
                  from dual
                 where (favorita.pck_util_fav.fnc_verificagrupoatendimento(91, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                    or favorita.pck_util_fav.fnc_verificagrupoatendimento(0, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S') -- labs
                --
                UNION
                -- regional 3
                select 'Regional 3' display_value
                     , 3
                  from dual
                 where (favorita.pck_util_fav.fnc_verificagrupoatendimento(92, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                    or favorita.pck_util_fav.fnc_verificagrupoatendimento(0, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S') -- labs
                --
                UNION
                -- regional 4
                select 'Regional 4' display_value
                     , 4
                  from dual
                 where (favorita.pck_util_fav.fnc_verificagrupoatendimento(93, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                    or favorita.pck_util_fav.fnc_verificagrupoatendimento(0, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S') -- labs
                --
                UNION
                -- regional 4
                select 'Regional 5' display_value
                     , 5
                from dual
                where (favorita.pck_util_fav.fnc_verificagrupoatendimento(94, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                   or favorita.pck_util_fav.fnc_verificagrupoatendimento(0, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S') -- labs
                --v('APP_USER') in ('NATHALIAKINAST', 'RAFAELK')
                --
                UNION
                -- Regional do Gerente da Franquia
                select 'Regional ' || f.regional display_value
                     , f.regional read_value
                  from filiais f
                     , gerentes g
                     , usuarios u
                  where g.idpessoa = u.idpessoa
                  and f.idfilial = g.idfilial
                  and u.usuario = v('APP_USER')
                --
                order by 1;
                ```
            nullDisplayValue: -- Selecionar --
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Liberações de Regionais por Grupo de Atendimento (TQG Usuários)
        }
    )

    pageItem P736_SEMANAFINAL (
        type: selectList
        label {
            label: Semana Final
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT SEMANACOMPLETA D
                     , IDSEMANA R
                  FROM (
                        SELECT distinct s.semanacompleta
                                      , s.idsemana
                          FROM semana_dias s
                             , metasdesafioromance m
                         WHERE s.cicloromance = m.cicloromance
                           AND s.ano = :P736_ANO
                           AND m.idfilial = nvl(:P736_IDFILIAL, m.idfilial)
                           AND s.idsemana between (SELECT idsemana FROM semana_dias WHERE idsemana = :P736_SEMANAINICIAL) and (SELECT max(idsemana) FROM semana_dias WHERE dt_ini < trunc(sysdate))
                           AND s.cicloromance is not null
                           AND m.datacongelado is not null ) sd
                 ORDER BY idsemana
                ```
        }
        cascadingLov {
            parentItems: [
                P736_ANO
                P736_IDFILIAL
                P736_SEMANAINICIAL
            ]
            parentRequired: false
