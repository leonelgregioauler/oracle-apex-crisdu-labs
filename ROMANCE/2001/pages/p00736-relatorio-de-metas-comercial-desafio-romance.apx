    dynamicAction seta-valores (
        name: Seta Valores
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P736_CICLOROMANCE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: NULL;
                itemsToSubmit: P736_SEMANASRESTANTES
            }
            execution {
                sequence: 80
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ideal-até-o-momento
            }
            execution {
                sequence: 110
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @relatorio-de-metas-comercial-desafio-romance
            }
            execution {
                sequence: 90
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @total
            }
            execution {
                sequence: 100
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                     select to_char(sum(m.desafiocalculadoatual * fi.fatorconversao),'999G999G999G999G990D00')  totaldesafio
                          , case when sum(m.desafiocalculadoatual) > 0 
                                 then to_char(round(( nvl( sum(tf.totalcobranca * fi.fatorconversao),0) / 
                                                           sum(m.desafiocalculadoatual * fi.fatorconversao)) * 100,2),'999G990D00') 
                                 else to_char(0,'999G990D00')
                            end percrealizado
                            --
                          , to_char(sum(m.desafiocalculadoatual * fi.fatorconversao) - nvl(sum(tf.totalcobranca * fi.fatorconversao),0),'999G999G999G999G990D00')  valorfaltante
                            --
                          , to_char(nvl(sum(tf.totalcobranca*fi.fatorconversao),0),'999G999G999G999G990D00')  totalrealizado
                            --
                       from metasdesafioromance m
                          , ( select f.idfilial
                                   , f.fatorconversao
                                   , f.nome
                                   , f.regional
                                   , f.ididioma
                                   , f.pertencecomercialromance
                                   , case when f.tipofilial = 'D' and
                                               f.regional is null and 
                                               f.ididioma = 1     and 
                                               f.idfilial not in (1217,1246,1063,1149) and 
                                               f.idgerente is not null
                                            then 5
                                          else
                                            null
                                      end regional_5
                                from roman.vw_filiais f
                               where f.ativo = 'S' ) fi
                          , ( select f.idfilial
                                   , nvl(sum(fr.totalgeral),0) totalcobranca
                                from fechamentossemanais f
                                   , fechamentorepresentantes fr
                                   , representantes re
                               where fr.idfechamento = f.idfechamento
                                 and fr.idrepresentante = re.idrepresentante
                                 and f.idsemana in (select idsemana
                                                      from semana_dias 
                                                     where semanacompleta in (select semanacompleta anterior
                                                                                from semana_dias s
                                                                               where cicloromance = :P736_CICLOROMANCE) ) 
                               group by f.idfilial ) tf
                      where m.cicloromance = :P736_CICLOROMANCE
                        and m.idfilial = fi.idfilial
                        and m.idfilial = tf.idfilial(+)
                        and m.idfilial = nvl(:P736_IDFILIAL, m.idfilial)
                        and exists (select 1
                                      from gerentes g
                                         , usuarios u
                                      where g.idpessoa = u.idpessoa
                                      and g.idfilial = m.idfilial
                                      and u.usuario = v('APP_USER')
                                    UNION
                                    select 1 from dual where v('APP_USER') in ('RAFAELK')
                                    UNION    
                                    select 1
                                      from gerentes g
                                         , usuarios u
                                     where g.idpessoa = u.idpessoa
                                     and :P736_REGIONAL = 7
                                     and u.usuario = v('APP_USER')
                                    UNION
                                    select 1
                                      from usuarios u
                                     where u.usuario = v('APP_USER')
                                     and not exists ( select 1 from gerentes g where g.idpessoa = u.idpessoa))
                        and ( :P736_REGIONAL = 5  and fi.regional_5 = :P736_REGIONAL or
                              :P736_REGIONAL = 7  and exists ( select 1 from usuariosfiliais uf where uf.usuario = v('APP_USER') and uf.idfilial = fi.idfilial ) or
                              :P736_REGIONAL = 10 and fi.ididioma = 1 or
                              :P736_REGIONAL = 20 and fi.ididioma != 1 or
                              :P736_REGIONAL = 99 and pertencecomercialromance = 'S' or
                              fi.regional = :P736_REGIONAL)
                        
                    ```
                itemsToSubmit: P736_CICLOROMANCE
            }
            affectedElements {
                selectionType: items
                items: [
                    P736_TOTALDESAFIO
                    P736_PERCREALIZADO
                    P736_VALORFALTANTE
                    P736_REALIZADO
                ]
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select count(*)
                      from semana_dias 
                     where cicloromance = :P736_CICLOROMANCE
                       and dt_fim > trunc(sysdate) 
                    
                    ```
                itemsToSubmit: P736_CICLOROMANCE
            }
            affectedElements {
                selectionType: items
                items: P736_SEMANASRESTANTES
            }
            execution {
                sequence: 50
            }
        )

    )

    dynamicAction seta-valores-2 (
        name: "Seta Valores "
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P736_SEMANAFINAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: P736_SEMANAFINAL
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode: NULL;
                itemsToSubmit: P736_SEMANASRESTANTES
            }
            execution {
                sequence: 50
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @relatorio-de-metas-comercial-desafio-romance
            }
            execution {
                sequence: 60
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @total
            }
            execution {
                sequence: 80
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ideal-até-o-momento
            }
            execution {
                sequence: 90
            }
        )

        action set-value (
            name: Set Value
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(totaldesafio,'999G999G999G999G990D00') totaldesafio
                         , to_char((totalrealizado / totaldesafio) * 100,'999G990D00') percrealizado
                         , to_char(valorfaltante, '999G999G999G999G990D00') valorfaltante
                         , to_char(totalrealizado,'999G999G999G999G990D00') totalrealizado
                    from (
                    select sum(totaldesafio) totaldesafio
                         , sum(valorfaltante) valorfaltante
                         , sum(totalrealizado) totalrealizado
                    from (
                        select sum(m.desafiocalculadoatual * fi.fatorconversao) / sc.total_semanas totaldesafio
                             , case when sum(m.desafiocalculadoatual) > 0
                                     then round((nvl(sum(tf.totalcobranca * fi.fatorconversao),0) / sum(m.desafiocalculadoatual * fi.fatorconversao)) * sc.total_semanas * 100,2)
                                     else 0
                                end percrealizado
                              , (sum(m.desafiocalculadoatual * fi.fatorconversao) / sc.total_semanas) - nvl(sum(tf.totalcobranca * fi.fatorconversao),0) valorfaltante
                              , nvl(sum(tf.totalcobranca * fi.fatorconversao),0) totalrealizado
                           from metasdesafioromance m
                              , roman.semana_dias s
                              , ( select cicloromance
                                       , count(*) total_semanas
                                    from roman.semana_dias
                                 group by cicloromance ) sc
                              , ( select f.idfilial
                                       , f.fatorconversao
                                       , f.nome
                                       , f.regional
                                       , f.ididioma
                                       , f.pertencecomercialromance
                                       , case when f.tipofilial = 'D' and f.regional is null and f.ididioma = 1 and f.idfilial not in (1217,1246,1063,1149) and f.idgerente is not null then 5 else null end regional_5
                                    from roman.vw_filiais f
                                   where f.ativo = 'S' ) fi
                              , ( select f.idfilial
                                       , s.idsemana
                                       , nvl(sum(fr.totalgeral),0) totalcobranca
                                    from fechamentossemanais f
                                       , fechamentorepresentantes fr
                                       , representantes re
                                       , roman.semana_dias s
                                       , vw_filiais fi
                                   where fr.idfechamento = f.idfechamento
                                     and f.idfilial = fi.idfilial
                                     and fr.idrepresentante = re.idrepresentante
                                     and fi.tipofilial = 'D'
                                     and f.idsemana     = s.idsemana
                                     and f.idsemana in (select idsemana from semana_dias where semanacompleta in (select semanacompleta anterior from semana_dias s where s.idsemana between :P736_SEMANAINICIAL and :P736_SEMANAFINAL))
                                   group by f.idfilial
                                          , s.idsemana ) tf
                          where m.cicloromance = s.cicloromance
                            and m.cicloromance = sc.cicloromance
                            and m.idfilial = fi.idfilial
                            and m.idfilial = tf.idfilial(+)
                            and s.idsemana = tf.idsemana(+)
                            and m.idfilial = nvl(:P736_IDFILIAL, m.idfilial)
                            and s.idsemana between :P736_SEMANAINICIAL and :P736_SEMANAFINAL
                            and exists (select 1 from gerentes g , usuarios u where g.idpessoa = u.idpessoa and g.idfilial = m.idfilial and u.usuario = v('APP_USER')
                                        UNION
                                        select 1 from dual where v('APP_USER') in ('RAFAELK')
                                        UNION
                                        select 1 from gerentes g , usuarios u where g.idpessoa = u.idpessoa and :P736_REGIONAL = 7 and u.usuario = v('APP_USER')
                                        UNION
                                        select 1 from usuarios u where u.usuario = v('APP_USER') and not exists ( select 1 from gerentes g where g.idpessoa = u.idpessoa))
                            and ( :P736_REGIONAL = 5  and fi.regional_5 = :P736_REGIONAL or
                                  :P736_REGIONAL = 7  and exists ( select 1 from usuariosfiliais uf where uf.usuario = v('APP_USER') and uf.idfilial = fi.idfilial ) or
                                  :P736_REGIONAL = 10 and fi.ididioma = 1 or
                                  :P736_REGIONAL = 20 and fi.ididioma != 1 or
                                  :P736_REGIONAL = 99 and pertencecomercialromance = 'S' or
                                  fi.regional = :P736_REGIONAL)
                          group by sc.total_semanas
                    ))
                    ```
                itemsToSubmit: [
                    P736_SEMANAINICIAL
                    P736_SEMANAFINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: [
                    P736_TOTALDESAFIO
                    P736_PERCREALIZADO
                    P736_VALORFALTANTE
                    P736_REALIZADO
                ]
            }
            execution {
                sequence: 30
            }
        )

        action set-value-2 (
            name: Set Value
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select count(*)
                      from semana_dias 
                     where idsemana between :P736_SEMANAINICIAL and :P736_SEMANAFINAL
                       and dt_fim > trunc(sysdate)
                    ```
                itemsToSubmit: [
                    P736_SEMANAINICIAL
                    P736_SEMANAFINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P736_SEMANASRESTANTES
            }
            execution {
                sequence: 40
            }
        )

    )

    branch (
        name: GoTo Page 736
        execution {
            sequence: 10
            point: processing
        }
        behavior {
            target: {
                page: 736
                items: {
                    P736_ANO: &P736_ANO.
                    P736_REGIONAL: &P736_REGIONAL.
                    P736_IDFILIAL: &P736_IDFILIAL.
                    P736_PERIODO: &P736_PERIODO.
                    P736_SEMANAINICIAL: &P736_SEMANAINICIAL.
                    P736_SEMANAFINAL: &P736_SEMANAFINAL.
                    P736_CICLOROMANCE: &P736_CICLOROMANCE.
                }
            }
        }
    )

)

