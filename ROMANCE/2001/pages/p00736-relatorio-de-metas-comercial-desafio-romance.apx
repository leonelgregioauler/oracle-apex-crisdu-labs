page 736 (
    name: Relatorio de Metas Comercial - Desafio Romance
    alias: RELATORIO-DE-METAS-COMERCIAL-DESAFIO-ROMANCE
    title: Relatorio de Metas Comercial - Desafio Romance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
