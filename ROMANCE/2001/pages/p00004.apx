    pageItem P4_IDESTOQUEFIL (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select codigosisdist ||' - '|| p.nomeproduto display_value
                     , ef.idestoquefilial return_value
                from produtos      p
                   , estoquefilial ef
                where p.idproduto        = ef.idproduto
                  and ef.idestoquefilial = :P4_IDESTOQUEFIL
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @atualizar-item-da-nota
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDESTOQUEFIL
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
