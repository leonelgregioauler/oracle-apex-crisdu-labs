    validation p4-qtddevolvida (
        name: P4_QTDDEVOLVIDA
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_number(nvl(:P4_QTDDEVOLVIDA,'0')) <= to_number(nvl(:P4_QUANTIDADE,'0'))
                ```
        }
        error {
            errorMessage: Quantidade Devolvida não pode ser maior que a quantidade distribuida!
            displayLocation: inlineInNotification
        }
    )

    validation validaitensmenorquezero (
        name: VALIDAITENSMENORQUEZERO
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                 vtotalnotaccom  NUMBER;
                 vtotalnotascom  NUMBER;
                 vtotalnota      NUMBER;
                 vtotaldevolvido NUMBER;
                 vcomissao       NUMBER;
                 vvalorpago      NUMBER;
                 vprodtotal      NUMBER;
                 vproddev        NUMBER;
                 vtotal          NUMBER;
                 vidnotavenda    number  := :P4_IDNOTAVENDA; 
                 viditemnotavenda number := :P4_IDITEMNOTAVENDA;
                 --
                BEGIN
                  --Repassa a comissão
                  select nvl(rn.perccomissao , 0)
                  into   vcomissao
                  from   roman.notasvendas rn
                  where  rn.idnotavenda = vidnotavenda;
                  --
                  --Soma sem comissão
                  select sum(ri.quantidade * ri.valorvenda)
                       , sum(ri.qtddevolvida * ri.valorvenda)
                  into vtotalnotascom
                     , vtotaldevolvido
                  from roman.itensnotavenda ri
                  where ri.idnotavenda  = vidnotavenda
                    and nvl(ri.comissao, 'N')= 'N'
                    and ri.iditemnotavenda != viditemnotavenda;
                    
                  vtotalnotascom:= vtotalnotascom - vtotaldevolvido;
                  --
                  --Soma com comissão
                  select sum(ri.quantidade * ri.valorvenda)
                       , sum(ri.qtddevolvida * ri.valorvenda)
                  into vtotalnotaccom
                     , vtotaldevolvido
                  from roman.itensnotavenda ri
                  where ri.idnotavenda  = vidnotavenda
                    and ri.comissao = 'S'
                    and ri.iditemnotavenda != viditemnotavenda;
                
                  vtotalnotaccom:= vtotalnotaccom - vtotaldevolvido;
                  vtotalnotaccom:= vtotalnotaccom * (1-(vcomissao/100));
                  --
                  --Total da nota
                  vtotal := vtotalnotaccom + vtotalnotascom;
                  --
                  --Total dos Pagamentos
                  select sum(pnv.valorpago)
                  into vvalorpago
                  from roman.pagamentosnotasvendas pnv
                  where pnv.idnotavenda = vidnotavenda;
                  --
                  --insert into teste values ('teste luiz',vvalorpago||' > '||vtotal);
                  --commit;
                  --Erro
                  if (vvalorpago > vtotal) then
                    Return ('Pedido ficara com valor pago maior que devido, favor ajustar valor pago ou retirar o pagamento');
                  end if;
                 
                
                END;
                ```
            alwaysExecute: true
        }
        serverSideCondition {
            type: request=Value
            value: DELETE
        }
    )

    process fetch-row-from-itensnotavenda (
        name: Fetch Row from ITENSNOTAVENDA
        type: autoRowFetch
        source {
            tableName: ITENSNOTAVENDA
            pkColumn: IDITEMNOTAVENDA
            pkItem: P4_IDITEMNOTAVENDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 63239986569387289
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidproduto  number;
                  --
                begin 
                  --
                  if :P4_IDITEMNOTAVENDA is null then
                    --
                    select "SEQ_ITEMNOTAVENDA".nextval
                    into :P4_IDITEMNOTAVENDA
                    from dual;
                    --
                    select precovenda
                         , comissao
                         , idproduto
                    into :P4_VALORVENDA
                       , :P4_COMISSAO
                       , vidproduto
                    from produtos
                    where codigosisdist  = :P4_CODIGO;
                    --
                    select ee.idestoquefilial
                    into :P4_IDESTOQUEFIL
                    from estoquefilial ee
                    where idfilial  = ( select idfilial from notasvendas n where n.idnotavenda = :P4_IDNOTAVENDA)
                      and idproduto = vidproduto;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 63239377098387284
        }
    )

