page 710 (
    name: Cadastro Franquias Estrelas Romance
    title: Cadastro Franquias Estrelas Romance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"Confirma exclusão do registro?"';
    }

    region cadastro-filiais-estrelas-romance (
        name: Cadastro Filiais Estrelas Romance
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P710_IDCLUBEDESUCESSO (
        type: selectList
        label {
            label: Estrelas Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomeclube d
                     , idclubedesucesso r
                  from clubedesucesso
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @cadastro-filiais-estrelas-romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P710_IDFILIAL (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido, p.nomepessoa)) display_value
                     , f.idfilial
                from pessoas p
                   , filiais f
                where p.idpessoa = f.idpessoa
                  and f.tipofilial = 'D' /*distribuidora*/ 
                  and f.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @cadastro-filiais-estrelas-romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P710_IDFILIALCLUBEDESUCESSO (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-filiais-estrelas-romance
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALCLUBEDESUCESSO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P710_IDSEMANADISPARO (
        type: selectList
        label {
            label: "Semana Início Disparo "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana || '-' || dt_ini || ' a ' || dt_fim d
                     , idsemana r
                  from roman.semana_dias s
                 where idsemana >= ( select idsemana -2  --- 52 retirado por solicitação da Jennifer para não trazer semanas passadas.
                                     from roman.semana_dias 
                                    where trunc(sysdate) between dt_ini and dt_fim) 
                   and idsemana <=  (select idsemana + 12
                                     from roman.semana_dias 
                                    where trunc(sysdate) between dt_ini and dt_fim) 
                order by idsemana desc
                
                ```
        }
        layout {
            sequence: 70
            region: @cadastro-filiais-estrelas-romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P710_IDSEMANAINICIO (
        type: selectList
        label {
            label: Semana Início
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana || '-' || dt_ini || ' a ' || dt_fim d
                     , idsemana r
                  from semana_dias s
                 where idsemana >= (select idsemana  --- 52 retirado por solicitação da Jennifer para não trazer semanas passadas.
                                     from semana_dias 
                                    where trunc(sysdate) between dt_ini and dt_fim) 
                   and idsemana <=  (select idsemana + 12
                                     from semana_dias 
                                    where trunc(sysdate) between dt_ini and dt_fim) 
                order by idsemana desc
                
                ```
        }
        layout {
            sequence: 30
            region: @cadastro-filiais-estrelas-romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P710_QUANTIDADECICLOS (
        type: numberField
        label {
            label: Quantidade Semanas
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @cadastro-filiais-estrelas-romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G999G999G990
            width: 15
        }
        validation {
            maxLength: 255
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P710_QUANTIDADENOTAS (
        type: numberField
        label {
            label: Quantidade Notas
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @cadastro-filiais-estrelas-romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G999G999G990
            width: 15
        }
        validation {
            maxLength: 255
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @cadastro-filiais-estrelas-romance
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 709
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @cadastro-filiais-estrelas-romance
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P710_IDFILIALCLUBEDESUCESSO
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @cadastro-filiais-estrelas-romance
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P710_IDFILIALCLUBEDESUCESSO
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @cadastro-filiais-estrelas-romance
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P710_IDFILIALCLUBEDESUCESSO
        }
    )

    dynamicAction buscaperiodo (
        name: BuscaPeriodo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P710_IDCLUBEDESUCESSO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select datavigenciainicial
                         , datavigenciafinal
                      from clubedesucesso
                     where idclubedesucesso = :P710_IDCLUBEDESUCESSO;
                    ```
                itemsToSubmit: P710_IDCLUBEDESUCESSO
            }
            affectedElements {
                selectionType: items
                items: [
                    P710_DATAINI
                    P710_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    process fetch-row-from-filiaisclubedesucesso (
        name: Fetch Row from FILIAISCLUBEDESUCESSO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                vid        number := :P710_IDFILIALCLUBEDESUCESSO;
                vidclube   number;
                vidsemana  number;
                vqtdnotas  number;
                vqtdciclos number;
                vidfilial  number;
                vmd5       varchar2(4000);
                begin
                
                  pck_clubedesucesso.prc_filiaisclubedesucesso ( vid,
                                              :P710_IDCLUBEDESUCESSO, --vidclube  ,  
                                              :P710_IDSEMANAINICIO, --vidsemana ,  
                                              :P710_QUANTIDADENOTAS, --vqtdnotas , 
                                              :P710_QUANTIDADECICLOS, --vqtdciclos,  
                                              :P710_IDFILIAL, --vidfilial ,  
                                              :P710_IDSEMANADISPARO,
                                              vmd5      ,  
                                              'S'  );
                                            
                  
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1505287966413370535
        }
    )

    process process-row-of-filiaisclubedesucesso (
        name: Process Row of FILIAISCLUBEDESUCESSO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 v_operacao_dml varchar2(1);
                 v_md5 varchar2(4000);
                 vexiste number;
                begin
                
                  if v('REQUEST') = 'CREATE' then
                    v_operacao_dml := 'I';
                    --
                    begin
                      select 1 
                        into vexiste
                        from clubedesucesso c
                           , filiaisclubedesucesso f
                       where c.idclubedesucesso = f.idclubedesucesso
                         and c.idclubedesucesso = :P710_IDCLUBEDESUCESSO
                         and f.idfilial = :P710_IDFILIAL;
                      if nvl(vexiste,0) = 1 then
                        raise_application_error(-20001,'Filial já cadastrada para este clube');
                      end if;
                    exception 
                      when no_data_found then null;
                    end;
                    --
                  elsif v('REQUEST') = 'SAVE' then
                    v_operacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETE' then
                    v_operacao_dml := 'D';
                  end if;
                
                  pck_clubedesucesso.prc_filiaisclubedesucesso(pidfilialclubedesucesso => :P710_IDFILIALCLUBEDESUCESSO,
                                                               pidclubedesucesso       => :P710_IDCLUBEDESUCESSO,
                                                               pidsemanainicio         => :P710_IDSEMANAINICIO,
                                                               pquantidadenotas        => :P710_QUANTIDADENOTAS,
                                                               pquantidadeciclos       => :P710_QUANTIDADECICLOS,
                                                               pidfilial               => :P710_IDFILIAL,
                                                               pidsemanadisparo        => :P710_IDSEMANADISPARO,
                                                               pmd5                    => v_md5,
                                                               poperacao_dml           => v_operacao_dml);  
                  
                end; 
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação processada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1505288711596370535
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1505289101583370535
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 709
            }
        }
    )

)

