page 793 (
    name: Menu Conquistou Levou
    title: Conquistou Levou
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    advanced {
        reloadOnSubmit: always
    }

    region início (
        name: Início
        type: list
        source {
            list: @conquistou-levou
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                u-colors
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--3cols
                t-Cards--animColorFill
            ]
        }
    )

    process busca-id-filial (
        name: Busca id filial
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P0_IDFILIAL is null then
                 :P0_IDFILIAL := pck_romance.fnc_filialusuario(v('APP_USER'));
                end if;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1800462952677415603
        }
    )

    process troca-idioma (
        name: troca idioma
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                APEX_UTIL.SET_SESSION_LANG(nvl(:P612_IDIOMA,'pt-br'));
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1800463054281415604
        }
    )

)

