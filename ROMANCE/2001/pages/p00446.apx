    pageItem P446_ANO (
        type: numberField
        label {
            label: Ano
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        default {
            type: expression
            plsqlExpression: to_number(to_char(sysdate,'RRRR'))
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P446_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                ```
            nullDisplayValue: "- Selecione a Empresa - "
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P446_TIPO_FILIAL (
        type: radioGroup
        label {
            label: Empresa
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Origem;O,Destino;D
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: O
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P446_TIPO_RELATORIO (
        type: radioGroup
        label {
            label: Relatório
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Detalhado;D,Resumido;R
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: D
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: FILTRAR
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction detalhado (
        name: Detalhado
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P446_TIPO_RELATORIO
        }
        clientSideCondition {
            type: item=value
            item: P446_TIPO_RELATORIO
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P446_IDFILIAL
                    P446_TIPO_FILIAL
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P446_IDFILIAL
                    P446_TIPO_FILIAL
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 446
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 446
                items: {
                    P446_TIPO_RELATORIO: &P446_TIPO_RELATORIO.
                    P446_IDFILIAL: &P446_IDFILIAL.
                    P446_ANO: &P446_ANO.
                    P446_TIPO_FILIAL: &P446_TIPO_FILIAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

