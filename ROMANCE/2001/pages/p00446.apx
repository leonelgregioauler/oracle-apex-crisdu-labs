page 446 (
    name: Controle de Saídas
    title: Controle de Saídas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region saídas (
        name: Saídas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(s.idfilial) empresa
                     , pck_romance.fnc_nomecontafinan(s.idcontacontabil) conta
                     , pck_romance.fnc_nomesubcontafinan(s.idsubcontacontabil) subconta
                     , count(1) quantidade
                     , sum(nvl(s.valortotal,0)*f.fatorconversao) valortotal
                from saidasdiversas s
                   , contasfinanceiras c
                   , subcontasfinanceiras sc
                   , vw_filiais f
                where c.idcontafinan(+)     = s.idcontacontabil
                  and sc.idsubcontafinan(+) = s.idsubcontacontabil
                  and f.idfilial            = s.idfilial
                  and extract ( year from s.data ) = :P446_ANO
                  and ( :P446_IDFILIAL is null or s.idfilial = :P446_IDFILIAL )
                  and :P446_TIPO_RELATORIO  = 'D'
                  and :P446_TIPO_FILIAL     = 'O'
                group by s.idfilial
                       , s.idcontacontabil
                       , s.idsubcontacontabil
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P446_TIPO_RELATORIO = 'D'
                  and :P446_TIPO_FILIAL = 'O'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2671546358954939144
        }

        column CONTA (
            type: plainText
            heading {
                heading: Conta
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column SUBCONTA (
            type: plainText
            heading {
                heading: Sub Conta
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column VALORTOTAL (
            type: plainText
            heading {
                heading: Total
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 26742250 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONTA (
                sequence: 2
            )

            displayColumn EMPRESA (
                sequence: 1
            )

            displayColumn QUANTIDADE (
                sequence: 4
            )

            displayColumn SUBCONTA (
                sequence: 3
            )

            displayColumn VALORTOTAL (
                sequence: 5
            )

            aggregate (
                column: QUANTIDADE
            )

            aggregate (
                column: VALORTOTAL
            )

            controlBreak (
                column: EMPRESA
                layout {
                    sequence: 1
                }
            )

        )

    )

    region saídas-2 (
