        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(( nvl( ( select sum(pnp.valorcomissao)
                                 from vw_comissoes_pagar_neg pnp
                                  where idrepresentante = :P564_IDREPRESENTANTE
                                   and tipo = 'r'
                                   and ( :P564_TIPO = 'A' and pnp.origem in ('B','A')
                                     or ( :P564_TIPO = 'C' and pnp.origem = 'C' ) )   ),0)),'999G999G999G990D00') comissaodistribuidor
                from dual
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0,00
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P564_IDREPRESENTANTE is not null and :P564_IDGERENTE is null
        }
        security {
            encryptSessionState: false
        }
    )

