    process pagar-gestor (
        name: Pagar Gestor
        type: executeCode
        editableRegion: @pagamento-de-comissões
        source {
            plsqlCode:
                ```plsql
                declare 
                  vsemana varchar2(10);
                  vidsemana number;
                begin
                  --
                  select semana
                       , pck_util.fnc_idsemana(semana)
                  into vsemana
                     , vidsemana
                  from fechamentorepresentantes fr
                  where fr.idfechamentorepres = :P564_IDFECHAMENTOREPRES;
                  --
                  insert into pagamentoscomissoesnegociacoes ( idpagamentocomissao
                                                             , idrepresentante
                                                             , idgerente
                                                             , datapagamento
                                                             , valorpago
                                                             , semana
                                                             , idsemana
                                                             , idfechamentorepres
                                                             , idnegociacaoparceiro
                                                             , idpagamentonegociacaoparceiro
                                                             , tipopagamento )
                  select seq_idpagamentocomissao.nextval
                       , :P564_IDREPRESENTANTE
                       , :P564_IDGERENTE
                       , sysdate
                       , cp.valorcomissao
                       , vsemana
                       , vidsemana
                       , :P564_IDFECHAMENTOREPRES
                       , cp.idnegociacaoparceiro
                       , cp.idpagamentonegociacaoparceiro
                       , 'G'
                  from vw_comissoes_pagar_neg cp
                  where cp.idpagamentonegociacaoparceiro = :IDPAGAMENTONEGOCIACAOPARCEIRO
                    and cp.tipo = 'g';
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Pagamento efetuado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5293547395891909821
        }
        serverSideCondition {
            whenButtonPressed: @submit-gestor
        }
    )

