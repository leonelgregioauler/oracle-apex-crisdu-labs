page 564 (
    name: Pagamento de Comissões das Negociações
    title: Pagamento de Comissões das Negociações
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function somavalor() {
               var theForm = document.wwv_flow;
               var vTemp = 0;
               var vNum = 0;
                
               for(i=0;i<theForm.f01.length;i++){
                    if(theForm.f01[i].checked){
                        vNum = $(theForm.f06[i]).val();
                        vNum = vNum.replace(',','.');
                        vTemp = parseFloat(vTemp) + parseFloat(vNum);
                    }
               }
                
              document.getElementById('P564_VALORSELECIONADO').value = vTemp;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region pagamento-de-comissões (
        name: Pagamento de Comissões
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idpagamentonegociacaoparceiro 
                     , vendedora
                     , databaixa
                     , valornegociacao
                     , valorparcela
                     , valorcomissao
                     , idrepresentante
                     , descformapagamento
                     , decode(origem,'A','Debito Romance','B','Cobrança Interna','C','Cobraki') origem
                     , t.documentos 
                from vw_comissoes_pagar_neg t
                where idrepresentante = :P564_IDREPRESENTANTE
                  and :P564_IDREPRESENTANTE is not null
                  and :P564_IDGERENTE is null
                  and (  ( :P564_TIPO = 'A' and t.origem in ('B','A') )
                       or ( :P564_TIPO = 'C' and t.origem = 'C' ) )
                  and t.tipo = 'r'
                union
                select idpagamentonegociacaoparceiro 
                     , vendedora
                     , databaixa
                     , valornegociacao
                     , valorparcela
                     , valorcomissao
                     , idrepresentante
                     , descformapagamento
                     , decode(origem,'A','Debito Romance','B','Cobrança Interna','C','Cobraki') origem
                     , t.documentos
                from vw_comissoes_pagar_neg t
                where idgerente = :P564_IDGERENTE
                  and :P564_IDGERENTE is not null
                  and (  ( :P564_TIPO = 'A' and t.origem in ('B','A') )
                       or ( :P564_TIPO = 'C' and t.origem = 'C' ) )
                  and t.tipo = 'g'
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: onClick="javascript:somavalor();"
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhuma negociação confirmada foi encontrada.
        }
        componentAdvanced {
            stripHtml: true
        }

