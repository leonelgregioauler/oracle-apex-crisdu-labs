    pageItem P558_IDCIDADEENDERECO (
        type: popupLov
        label {
            label: Cidade Endereço
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT c.NOMECIDADE ||' - '||e.SIGLA || ' - '||p.SIGLA   display_value
                     , c.IDCIDADE return_value
                FROM cidades c
                   , estados e
                   , paises p
                WHERE c.idestado = e.IDESTADO 
                  AND e.IDPAIS   = p.IDPAIS 
                ORDER BY 1
                ```
        }
        layout {
            sequence: 40
            region: @endereço
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDCIDADEENDERECO
            used: always
        }
        readOnly {
            type: item=value
            item: P558_REVISADO
            value: S
        }
        security {
            encryptSessionState: false
        }
    )

