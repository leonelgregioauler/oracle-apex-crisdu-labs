    dynamicAction valida-mascara-de-telefone (
        name: Valida Mascara de Telefone
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P558_TELEFONE
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var telefone = $x('P558_TELEFONE').value;
                    var regex = /^\(\d{2}\) \d{4,5}-\d{4}$/;
                    if (!regex.test(telefone)) {
                        apex.message.alert("Por favor, insira um número de telefone válido com DDD.");
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

