    process remove-cadastro (
        name: Remove Cadastro
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  for i in ( select *
                             from anexospessoasconvencao ap
                             where ap.idpessoaconvencao = :P558_IDPESSOACONVENCAO )
                  loop
                    --
                    begin
                      pck_anexos.prc_apagaanexo_convencao(pidanexopessoasconvencao => i.idanexopessoasconvencao);
                    exception
                      when others then
                        null;
                    end;
                    --
                  end loop;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3355705786268088907
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

