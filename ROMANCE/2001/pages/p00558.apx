    dynamicAction popula-mascara (
        name: Popula Mascara
        execution {
            sequence: 1
        }
        when {
            event: keyup
            selectionType: items
            items: P558_TELEFONE
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function formatarTelefone(input) {
                        // Remove todos os caracteres não numéricos
                        const numeroLimpo = input.value.replace(/\D/g, '');
                    
                        // Se o número estiver vazio, saia
                        if (numeroLimpo.length === 0) {
                            input.value = '';
                            return;
                        }
                    
                        // Adiciona a máscara de telefone
                        let telefoneFormatado = '(' + numeroLimpo.slice(0, 2) + ') ' + numeroLimpo.slice(2, 7) + '-' + numeroLimpo.slice(7, 11);
                        
                        // Define o valor do campo de entrada para o número formatado
                        input.value = telefoneFormatado;
                    }
                    
                    // Obtém o campo de entrada de texto pelo ID
                    const campoTelefone = document.getElementById('P558_TELEFONE');
                    
                    // Adiciona o evento onkeyup para chamar a função formatarTelefone
                    campoTelefone.addEventListener('keyup', function() {
                        formatarTelefone(this);
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

