    process atualiza-como-revisado (
        name: Atualiza como Revisado
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update pessoasconvencao p
                  set p.revisado = 'S'
                    , p.datarevisao = sysdate
                    , p.usuariorevisao = v('APP_USER')
                  where p.idpessoaconvencao = :P558_IDPESSOACONVENCAO;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Revisado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 2215937278626169940
        }
        serverSideCondition {
            whenButtonPressed: @revisado
        }
    )

