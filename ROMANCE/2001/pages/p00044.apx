            label: Cliente
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomepessoa)||' - '||nvl(p.cpf,p.documentoestrangeiro) display_value
                     , idvendedora return_value
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa 
                  and (:P44_IDREPRESENTANTE is null or v.idrepresentante = :P44_IDREPRESENTANTE)
                order by 1
