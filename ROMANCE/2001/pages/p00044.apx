    region negociações-notas-novas (
        name: Negociações Notas Novas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.numeronota "Nota"
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) "Distribuidor"
                     , pck_romance.fnc_nomevendedora(n.idvendedora) "Vendedora"
                     , pck_romance.fnc_nomefilial(n.idfilial) "Filial"
                     , (select c.beneficiario||' - '||c.agencia
                        from contasbancarias c
                        where c.idcontabanc = p.idcontabancariafilial) "Conta"
                     , p.comprovante "Comprovante"
                     , p.valorapagar "Valor a Pagar"
                     , p.valororiginal "Valor Original"
                     , ( select decode(nvl(v.spc,'N'),'S','Sim','N','Não')
                         from vendedoras v
                         where v.idvendedora = n.idvendedora ) "Enviada SPC"
                     , p.datavencimento "Vencimento"
                     , p.databaixa "Data Baixa"
                     , null "Ir P/ Nota"
                     , n.idfilial
                     , n.idnotavenda
                     , decode(p.situacao,'A','Aberta','E','Em Espera','V','Vencida','Q','Quitada') "Situação Parcela"
                     , (select l.dataalteracao
                        from logroman.log_parcelamentosnotasvend l
                        where l.idparcnotavenda = p.idparcnotavenda
                          and l.tipoalteracao = 'INSERT') "Data Inclusão"
                     , n.responsavelcobranca "Responsável Cobrança"
                     , ( select nvl(cpf,documentoestrangeiro)
                         from pessoas p
                         where p.idpessoa = (select idpessoa
                                             from vendedoras v
                                             where v.idvendedora = n.idvendedora)) "Cpf"
                     , decode(p.bonificacaopaga,'S','Sim','Não') "Bonificação Paga"
                     , pck_romance.fnc_retornatelefones(n.idvendedora) "Telefones"
                from notasvendas n
                   , parcelamentosnotasvendas p
                where p.idnotavenda = n.idnotavenda
                  and p.idnegociacaoparceiro is null
                  and n.responsavelcobranca is not null
                  and exists ( select 1
                               from vw_filiais f
                               where f.idfilial = n.idfilial
                                 and f.idgrupo != 5 )
                  and ( :P44_IDFILIAL is null or n.idfilial = :P44_IDFILIAL )
                  and ( :P44_DISTRIBUIDOR is null or n.idrepresentante = :P44_DISTRIBUIDOR )
                  and ( :P44_IDVENDEDORA is null or n.idvendedora = :P44_IDVENDEDORA )
                  and ( :P44_SITUACAO is null or p.situacao = :P44_SITUACAO )
                  and ( :P44_BONIFICACAO is null or nvl(p.bonificacaopaga,'N') = :P44_BONIFICACAO )
                  and ( :P44_RESPONSAVELCOBRANCA is null or n.responsavelcobranca = :P44_RESPONSAVELCOBRANCA )
                  and ( :P44_CPF is null or exists ( select 1
                                                     from pessoas pes 
                                                        , vendedoras vend
                                                     where pes.idpessoa = vend.idpessoa
                                                       and vend.idvendedora = n.idvendedora
                                                       and ( pes.cpf = :P44_CPF 
                                                          or pes.documentoestrangeiro = :P44_CPF ) ) )
                  and ( :P44_NRDOCUMENTO is null or p.comprovante like '%'||:P44_NRDOCUMENTO||'%' )
                  and ( :P44_DATAINI is null  or ( :P44_TIPODATA = 'B' and trunc(p.databaixa )   between :P44_DATAINI and :P44_DATAFIM )
                                              or ( :P44_TIPODATA = 'V' and trunc(p.datavencimento) between :P44_DATAINI and :P44_DATAFIM ) )
                  and ( :P44_DATAINI is not null 
                      or :P44_TIPODATA is not null )
                                              
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P44_TIPOPARCELAMENTO
            value: N
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado obtido. Verifique os Filtros!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 203767615082759268
        }

