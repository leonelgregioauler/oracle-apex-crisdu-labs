    pageItem P44_DISTRIBUIDOR (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante return_value
                from representantes
                where (:P44_IDFILIAL is null or
                    ( :P44_IDFILIAL is not null and idgerente in ( select idgerente from gerentes where idfilial = :P44_IDFILIAL) ))
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P44_IDFILIAL
        }
        layout {
