    button pagarbonificacao (
        buttonName: PAGARBONIFICACAO
        label: Pagar Bonificação
        layout {
            sequence: 160
            region: @filtros
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    process pagar-bonificação (
        name: Pagar bonificação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P44_TIPOPARCELAMENTO = 'P' then
                    --
                    update parcelamentospepinosrepres p
                    set p.bonificacaopaga = 'S'
                    where exists ( select 1
                                   from pepinosrepresentantes pp
                                   where pp.idpepinosrepresentante = p.idpepinorepresentante
                                     and ( :P44_IDFILIAL is null or pp.idfilial = :P44_IDFILIAL )
                                     and ( :P44_DISTRIBUIDOR is null or pp.idrepresentante = :P44_DISTRIBUIDOR ) 
                                     and ( :P44_CPF is null or pp.cpf = :P44_CPF )
                                     and ( :P44_RESPONSAVELCOBRANCA is null or pp.responsavelcobranca = :P44_RESPONSAVELCOBRANCA ) )
                      and ( :P44_SITUACAO is null or p.situacao = :P44_SITUACAO )
                      and ( :P44_BONIFICACAO is null or nvl(p.bonificacaopaga,'N') = :P44_BONIFICACAO)
                      and ( :P44_DATAINI is null  or ( :P44_TIPODATA = 'B' and trunc(p.databaixa )   between :P44_DATAINI and :P44_DATAFIM )
                                                  or ( :P44_TIPODATA = 'V' and trunc(p.datavencimento) between :P44_DATAINI and :P44_DATAFIM ) );
                      --
                  elsif :P44_TIPOPARCELAMENTO = 'N' then
                    --
                    update parcelamentosnotasvendas p
                    set p.bonificacaopaga = 'S'
                    where exists ( select 1
                                   from notasvendas n
                                   where n.idnotavenda = p.idnotavenda
                                     and ( :P44_IDFILIAL is null or n.idfilial = :P44_IDFILIAL )
                                     and ( :P44_DISTRIBUIDOR is null or n.idrepresentante = :P44_DISTRIBUIDOR )
                                     and ( :P44_IDVENDEDORA is null or n.idvendedora = :P44_IDVENDEDORA )
                                     and ( :P44_RESPONSAVELCOBRANCA is null or n.responsavelcobranca = :P44_RESPONSAVELCOBRANCA ) )
                      and ( :P44_SITUACAO is null or p.situacao = :P44_SITUACAO )
                      and ( :P44_BONIFICACAO is null or nvl(p.bonificacaopaga,'N') = :P44_BONIFICACAO )
                      and ( :P44_DATAINI is null  or ( :P44_TIPODATA = 'B' and trunc(p.databaixa )   between :P44_DATAINI and :P44_DATAFIM )
                                                  or ( :P44_TIPODATA = 'V' and trunc(p.datavencimento) between :P44_DATAINI and :P44_DATAFIM ) );
                    --
                  end if;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Bonificação Paga
        }
        advanced {
            executionMappingIdentifier: 231222649064716545
        }
        serverSideCondition {
            whenButtonPressed: @pagarbonificacao
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('APP_USER') = 'ADINA'
                ```
        }
    )

    branch (
        name: Go To Page 44
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 44
                items: {
                    P44_IDFILIAL: &P44_IDFILIAL.
                    P44_DISTRIBUIDOR: &P44_DISTRIBUIDOR.
                    P44_IDVENDEDORA: &P44_IDVENDEDORA.
                    P44_SITUACAO: &P44_SITUACAO.
                    P44_TIPODATA: &P44_TIPODATA.
                    P44_DATAINI: &P44_DATAINI.
                    P44_DATAFIM: &P44_DATAFIM.
                    P44_RESPONSAVELCOBRANCA: &P44_RESPONSAVELCOBRANCA.
                    P44_TIPOPARCELAMENTO: &P44_TIPOPARCELAMENTO.
                    P44_BONIFICACAO: &P44_BONIFICACAO.
                    P44_CPF: &P44_CPF.
                    P44_NRDOCUMENTO: &P44_NRDOCUMENTO.
                }
                action: resetPagination
            }
        }
    )

)

