    region negociações-pepinos-antigos (
        name: Negociações Pepinos Antigos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nrpedido "Número"
                  , pck_romance.fnc_nomerepresentante(p.idrepresentante) "Distribuidor"
                  , ( select initcap(nomepessoa)
                      from pessoas 
                      where cpf = p.cpf ) "Cliente"
                  , pck_romance.fnc_nomefilial(p.idfilial) "Filial"
                  , ( select c.beneficiario||' - '||c.agencia
                      from contasbancarias c
                      where c.idcontabanc = pp.idcontabancariafilial ) "Conta"
                  , pp.comprovante "Comprovante"
                  , pp.valorapagar "Valor a Pagar"
                  , pp.valororiginal "Valor Original"
                  , pp.datavencimento "Vencimento"
                  , pp.databaixa "Data Baixa"
                  , null "Ir P/ Débito"
                  , decode(p.situacao,'S','SPC','C','Cobrança','N','Novo','P','Pago') "Situação Pepino"
                  , decode(pp.situacao,'A','Aberta','E','Em Espera','V','Vencida','Q','Quitada') "Situação Parcela"
                  , ( select lp.dataalteracao
                      from logroman.log_parcelamentospepinosre lp
                      where lp.idparcpepinosrepres = pp.idparcpepinosrepres
                        and lp.tipoalteracao = 'INSERT' ) "Data Inclusão"
                  , p.responsavelcobranca "Resp. Cobrança"
                  , p.idpepinosrepresentante
                  , p.cpf "Cpf"
                  , decode(pp.bonificacaopaga,'S','Sim','Não') "Bonificação Paga"
                from pepinosrepresentantes p
                   , PARCELAMENTOSPEPINOSREPRES pp
                where p.idpepinosrepresentante = pp.idpepinorepresentante
                  and ( :P44_IDFILIAL is null or p.idfilial = :P44_IDFILIAL )
                  and ( :P44_DISTRIBUIDOR is null or p.idrepresentante = :P44_DISTRIBUIDOR )
                 -- and ( :P44_IDVENDEDORA is null or n.idvendedora = :P44_IDVENDEDORA )
                  and ( :P44_SITUACAO is null or pp.situacao = :P44_SITUACAO )
                  and ( :P44_BONIFIcaCAO is null or nvl(pp.bonificacaopaga,'N') = :P44_BONIFICACAO)
                  and ( :P44_CPF is null or p.cpf = replace(replace(:P44_CPF,'-',''),'.','') )
                  and ( :P44_NRDOCUMENTO is null or pp.comprovante like '%'||:P44_NRDOCUMENTO||'%')
                  and ( :P44_RESPONSAVELCOBRANCA is null or p.responsavelcobranca = :P44_RESPONSAVELCOBRANCA )
                  and ( :P44_DATAINI is null  or ( :P44_TIPODATA = 'B' and trunc(pp.databaixa )   between :P44_DATAINI and :P44_DATAFIM )
                                              or ( :P44_TIPODATA = 'V' and trunc(pp.datavencimento) between :P44_DATAINI and :P44_DATAFIM ) )
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
