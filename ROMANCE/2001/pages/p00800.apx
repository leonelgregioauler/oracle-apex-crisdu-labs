page 800 (
    name: Lista Campanhas
    title: Lista Campanhas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region campanhas-conquistou-levou (
        name: Campanhas Conquistou Levou
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idconquistoulevou
                     , c.nomecampanha
                     , c.datainicio
                     , c.datafinal
                     , c.datadivulgacao
                     , c.datafimdivulgacao
                     , decode(c.status, 'S','ATIVA','INATIVA')  status
                     , c.idpais
                     , ( select pa.nome
                         from catal.paises pa
                         where pa.idpais = c.idpais) pais
                from roman.campanhasconquistoulevou c
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1800850424025802802
        }

        column DATADIVULGACAO (
            type: plainText
            heading {
                heading: Data Inicio Divulgação
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DATAFIMDIVULGACAO (
            type: plainText
            heading {
                heading: Data Fim Divulgação
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        column DATAFINAL (
            type: plainText
            heading {
                heading: Data Fim Seleção Brinde
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column DATAINICIO (
            type: plainText
            heading {
                heading: Data Inicio Seleção Brinde
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDCONQUISTOULEVOU (
            type: link
            heading {
                heading: Ver/Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 801
                    items: {
                        P801_IDCONQUISTOULEVOU: #IDCONQUISTOULEVOU#
                        P801_CAMPANHA: #NOMECAMPANHA#
                        P801_DATAINICIO: #DATAINICIO#
                        P801_DATAFINAL: #DATAFINAL#
                        P801_DATADIVULGACAO: #DATADIVULGACAO#
                        P801_IDPAIS: #IDPAIS#
                        P801_DATAFIMDIVULGACAO: #DATAFIMDIVULGACAO#
                    }
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column IDPAIS (
            type: plainText
            heading {
                heading: Idpais
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column NOMECAMPANHA (
            type: plainText
            heading {
                heading: Campanhas
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column PAIS (
            type: plainText
            heading {
                heading: País
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 18008601 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATADIVULGACAO (
                sequence: 4
            )

            displayColumn DATAFIMDIVULGACAO (
                sequence: 7
            )

            displayColumn DATAFINAL (
                sequence: 6
            )

            displayColumn DATAINICIO (
                sequence: 5
            )

            displayColumn IDCONQUISTOULEVOU (
                sequence: 1
            )

            displayColumn NOMECAMPANHA (
                sequence: 3
            )

            displayColumn PAIS (
                sequence: 2
            )

            displayColumn STATUS (
                sequence: 8
            )

        )

    )

    button novo (
        buttonName: novo
        label: Nova Campanha
        layout {
            sequence: 20
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 801
                clearCache: 801
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 793
                clearCache: 793
            }
        }
    )

)

