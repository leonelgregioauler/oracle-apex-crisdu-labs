page 600 (
    name: Pagamentos Indiretos
    title: Pagamentos Indiretos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pagamentos-indiretos (
        name: Pagamentos Indiretos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.tipo
                     , p.numero 
                     , pck_romance.fnc_nomefilial(p.idfilial) empresa
                     , pck_romance.fnc_nomerepresentante(p.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(p.idvendedora) consultora
                     , pck_romance.fnc_cpfvendedora(p.idvendedora) cpf
                     , p.valortotalvendalqd apagar
                     , p.valorpago pago
                     , p.saldo
                     , p.pagoindireto
                     , p.dataretirada
                from vw_pagamentos_indiretos p
                where p.dataretirada between to_date(:P600_DATAINICIO) and to_date(:P600_DATAFIM)
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5178708014843121507
        }

        column APAGAR (
            type: plainText
            heading {
                heading: A Pagar
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column CPF (
            type: plainText
            heading {
                heading: CPF
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column DATARETIRADA (
            type: plainText
            heading {
                heading: Data da Retirada
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: K
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column NUMERO (
            type: plainText
            heading {
                heading: Nr Débito
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column PAGO (
            type: plainText
            heading {
                heading: Pago
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column PAGOINDIRETO (
            type: plainText
            heading {
                heading: Pago Após Retirada
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column SALDO (
            type: plainText
            heading {
                heading: Saldo
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo Débito
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 51831167 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn APAGAR (
                sequence: 7
            )

            displayColumn CONSULTORA (
                sequence: 5
            )

            displayColumn CPF (
                sequence: 6
            )

            displayColumn DATARETIRADA (
                sequence: 11
            )

            displayColumn DISTRIBUIDOR (
                sequence: 4
            )

            displayColumn EMPRESA (
                sequence: 3
            )

            displayColumn NUMERO (
                sequence: 2
            )

            displayColumn PAGO (
                sequence: 8
            )

            displayColumn PAGOINDIRETO (
                sequence: 10
            )

            displayColumn SALDO (
                sequence: 9
            )

            displayColumn TIPO (
                sequence: 1
            )

            sort (
                column: DATARETIRADA
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: APAGAR
            )

            aggregate (
                column: PAGO
            )

            aggregate (
                column: SALDO
            )

            aggregate (
                column: PAGOINDIRETO
            )

            controlBreak (
                column: TIPO
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P600_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P600_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 600
                items: {
                    P600_DATAINICIO: &P600_DATAINICIO.
                    P600_DATAFIM: &P600_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

