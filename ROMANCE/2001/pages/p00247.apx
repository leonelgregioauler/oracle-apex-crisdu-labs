    help {
        helpText: No help is available for this page.
    }

    region rel-mov-est-posto-avançado (
        name: Rel Mov. Est. Posto Avançado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ RULE*/( select ca.nome
                         from categorias ca
                         where ca.idcategoria = ( select pr.idcategoria 
                                                 from produtos    pr
                                                 where pr.idproduto = e.idproduto ) ) "Categoria"
                     , ( select initcap( pr.codigosisdist ) 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Código"      
                     , ( select initcap( pr.nomeproduto ) 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Produto"   
                     , e.idestoquefilial
                     , e.idfilial
                     , e.idproduto
                     , me.qtd_pp   
                     , me.qtd_p    
                     , me.qtd_m    
                     , me.qtd_g    
                     , me.qtd_gg   
                     , me.qtd_egg  
                     , me.qtd_exgg
                     , me.qtd_u   
                     , me.observacao    "Observação"
                     , me.usuario       "Usuário"
                     , me.datamovimento "Data Movimento"
                     , trunc(me.datamovimento) "Dia"
                     , me.idmovtoestpostoavan
                     , (select nome from postoavancado where idpostoavancado = ep.idpostoavancado) "Posto Avançado"
                from estoquefilial              e
                   , estoquepostoavancado       ep
                   , movimentosestoquepostoavan me
                where e.idestoquefilial = me.idestoquefil
                  and e.idestoquefilial = ep.idestoquefil
                  and ep.idpostoavancado = me.idpostoavancado
                  and e.idfilial = :P0_IDFILIAL
                  and me.idpostoavancado = :P247_IDPOSTOAVANCADO
                  and trunc(me.datamovimento) between to_date(:P247_DATAINICIO) and to_date(:P247_DATAFIM)
                order by me.idmovtoestpostoavan desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
