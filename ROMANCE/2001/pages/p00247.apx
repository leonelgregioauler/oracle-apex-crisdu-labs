                items: {
                    P247_IDPOSTOAVANCADO: &P247_IDPOSTOAVANCADO.
                    P247_DATAINICIO: &P247_DATAINICIO.
                    P247_DATAFIM: &P247_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
