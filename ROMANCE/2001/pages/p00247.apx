    pageItem P247_IDPOSTOAVANCADO (
        type: radioGroup
        label {
            label: Posto Avançado
            alignment: left
        }
        settings {
            noOfCols: 5
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nome) display_value
                     , idpostoavancado return_value
                from postoavancado 
                where idfilial = :P0_IDFILIAL
                  and ativo = 'S'
                  and ( ( :P0_IDPOSTOAVANCADO is not null and idpostoavancado = :P0_IDPOSTOAVANCADO )
                       or (:P0_IDPOSTOAVANCADO is null ) )
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @rel-mov-est-posto-avançado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
