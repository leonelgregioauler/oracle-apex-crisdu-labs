    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P435_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' - '||decode(ativo,'S','Ativo','N','Inativo') d
                     , idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: - Mostrar Todos -
        }
        cascadingLov {
            parentItems: P0_IDFILIAL
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P435_IDSEMANA_FIM (
        type: selectList
        label {
            label: Até Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(s.semana,'00')||'/'||s.ano) display_value
                     , s.idsemana return_value
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-1 and to_char(sysdate,'RRRR')
                order by s.idsemana
                ```
            nullDisplayValue: - Selecione -
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidsemana number;
                begin
                  --
                  select pck_util.fnc_idsemanadata(sysdate)
                  into vidsemana
                  from dual;
                  --
                  return vidsemana;
                  --
                exception
                  when others then
                    return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P435_IDSEMANA_INI (
        type: selectList
        label {
            label: De Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(s.semana,'00')||'/'||s.ano) display_value
                     , s.idsemana return_value
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-2 and to_char(sysdate,'RRRR')
                order by s.idsemana
                ```
            nullDisplayValue: - Selecione -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: FILTRAR
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 435
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 435
                items: {
                    P435_IDSEMANA_INI: &P435_IDSEMANA_INI.
                    P435_IDSEMANA_FIM: &P435_IDSEMANA_FIM.
                    P435_IDREPRESENTANTE: &P435_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

