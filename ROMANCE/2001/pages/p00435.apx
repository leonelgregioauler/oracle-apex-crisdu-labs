page 435 (
    name: Acompanhamento das Peças
    title: Acompanhamento das Peças
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-de-peças (
        name: Acompanhamento de Peças
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util.fnc_semanaid(rlt.idsemana) "Semana"
                     , nvl(rlt.carga,0) "Qtd em Cargas"
                     , nvl(rlt.nota,0) "Qtd em Notas"
                     , (nvl(rlt.nota,0)-nvl(rlt.carga,0)) "Dist. a mais da carga"
                     , nvl(rlt.devolucao,0) "Qtd Devolução Consultora"
                     , (nvl(rlt.devolucao,0)-(nvl(rlt.nota,0)-nvl(rlt.carga,0))) "Saldo Não Vendidas - Distr."
                     , nvl(rlt.devolucaofil,0) "Qtd Devolução Empresa"
                     , ((nvl(rlt.devolucao,0)-(nvl(rlt.nota,0)-nvl(rlt.carga,0)))-nvl(rlt.devolucaofil,0)) "Ficou com Distribuidor"
                from ( select s.idsemana
                            , notas.qtd nota
                            , cargas.qtd carga
                            , devolucao.qtd devolucao
                            , devolucaofil.qtd devolucaofil
                       from semana_dias s
                          , ( select sum(nvl(it.quantidade,0)) qtd
                                   , idsemanadistribuicao idsemana
                              from itensnotavenda it
                                 , notasvendas nv
                              where nv.idnotavenda = it.idnotavenda
                                and nv.idfilial    = :P0_IDFILIAL
                                and ( :P435_IDREPRESENTANTE is null or nv.idrepresentante = :P435_IDREPRESENTANTE ) 
                                and nv.idsemanadistribuicao between :P435_IDSEMANA_INI and :P435_IDSEMANA_FIM
                              group by nv.idsemanadistribuicao ) notas
                          , ( select sum( nvl(ic.qtd_dist_pp,0)
                                          + nvl(ic.qtd_dist_p,0)
                                          + nvl(ic.qtd_dist_m,0)
                                          + nvl(ic.qtd_dist_g,0)
                                          + nvl(ic.qtd_dist_gg,0)
                                          + nvl(ic.qtd_dist_egg,0)
                                          + nvl(ic.qtd_dist_exgg,0)
                                          + nvl(ic.qtd_dist_u,0)) qtd
                                   , c.idsemana
                                from itenscargarepresentante ic
                                   , cargasrepresentantes c
                                where c.idcargarepresentante = ic.idcargarepresentante
                                  and c.idfilial             = :P0_IDFILIAL
                                  and ( :P435_IDREPRESENTANTE is null or c.idrepresentante = :P435_IDREPRESENTANTE ) 
                                  and c.idsemana between :P435_IDSEMANA_INI and :P435_IDSEMANA_FIM
                                group by c.idsemana ) cargas
                          , ( select sum(nvl(it.qtddevolvida,0)) qtd
                                   , nv.idsemanacobranca idsemana
                              from itensnotavenda it
                                 , notasvendas nv
                              where nv.idnotavenda = it.idnotavenda
                                and nv.idfilial    = :P0_IDFILIAL
                                and ( :P435_IDREPRESENTANTE is null or nv.idrepresentante = :P435_IDREPRESENTANTE ) 
                                and nv.idsemanacobranca between :P435_IDSEMANA_INI and :P435_IDSEMANA_FIM
                                and nv.idsituacaonotavenda = 4
                              group by nv.idsemanacobranca ) devolucao
                          , ( select sum( nvl(ide.qtd_pp,0)
                                        + nvl(ide.qtd_p,0)
                                        + nvl(ide.qtd_m,0)
                                        + nvl(ide.qtd_g,0)
                                        + nvl(ide.qtd_gg,0)
                                        + nvl(ide.qtd_egg,0)
                                        + nvl(ide.qtd_exgg,0)
                                        + nvl(ide.qtd_u,0) ) qtd
                                   , dev.idsemana idsemana
                              from itensdevolucaorepres ide
                                 , devolucoesrepresentantes dev
                              where ide.iddevolucaorepres = dev.iddevolucaorepres
                                and dev.idfilial    = :P0_IDFILIAL
                                and ( :P435_IDREPRESENTANTE is null or dev.idrepresentante = :P435_IDREPRESENTANTE ) 
                                and dev.idsemana between :P435_IDSEMANA_INI and :P435_IDSEMANA_FIM
                                and dev.situacao != 0
                              group by dev.idsemana ) devolucaofil
                       where s.idsemana between :P435_IDSEMANA_INI and :P435_IDSEMANA_FIM
                         and notas.idsemana(+) = s.idsemana
                         and cargas.idsemana(+) = s.idsemana
                         and devolucao.idsemana(+) = s.idsemana
                         and devolucaofil.idsemana(+) = s.idsemana ) rlt
                order by rlt.idsemana;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent7
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <h3>
                    Legenda:
                </h3>
                <font color="blue">Em Cargas = Cargas Distribuídas na semana.</font><br>
                <font color="red">Distribuídas em Sacolas = Peças deixadas para as consultoras.</font><br>
                <font color="green">Reaproveitamento de Devolução = Peças deixadas para as consultoras a mais do que recebido na carga da semana.</font><br>
                <font color="blue">Devolvidas pela Consultora = Peças não vendidas pelas consultoras.</font><br>
                <font color="red">Saldo Devolvídas - Distribuídas = Relação entre o que foi devolvido pelas consultoras na semana, menos o que foi reaproveitado pelos distribuidores na mesma semana.</font><br>
                <font color="green">Devoluções = Devoluções recebidas na Empresa.</font><br>
                <font color="blue">Saldo Geral = Relação entre o Saldo Devolvido - Distribuidor, menos a devolução da semana.</font><br><br>
                <b>Observação: Caso o Saldo Geral fique POSITIVO, significa que a quantidade está somando às peças que os distribuidores possuem em casa. Se o Valor ficar NEGATIVO, foi utilizado toda a devolução das consultoras mais as peças que já possuíam em casa.</b>
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum Dado encontrado. Verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 1500561352728488042
        }

