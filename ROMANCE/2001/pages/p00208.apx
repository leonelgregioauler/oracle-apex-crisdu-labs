page 208 (
    name: Incluir Correção
    title: Incluir Correção
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fechajanela()
            {
              if (document.getElementById("P208_IDCORRECAODEVOLUCAO").value != '')
                 {
                   window.opener.location.reload();
                   window.close();
                 }
            }
            ```
    }
    css {
        inline: ".t-Region-body { background-color: Beige !important;},"
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region incluir-correção (
        name: Incluir Correção
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P208_IDCORRECAODEVOLUCAO (
        type: hidden
        layout {
            sequence: 10
            region: @incluir-correção
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCORRECAODEVOLUCAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P208_IDDEVOLUCAOREPRES (
        type: hidden
        layout {
            sequence: 30
            region: @incluir-correção
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDDEVOLUCAOREPRES
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P208_IDREPRESENTANTE (
        type: hidden
        layout {
            sequence: 40
            region: @incluir-correção
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                --
                  vidrepresentante  Number;
                --
                begin 
                --
                  select idrepresentante 
                  into vidrepresentante
                  from devolucoesrepresentantes
                  where iddevolucaorepres = :P208_IDDEVOLUCAOREPRES;
                --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P208_MOTIVO (
        type: textarea
        label {
            label: Motivo
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @incluir-correção
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
            height: 7
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: MOTIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P208_PAGINA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @incluir-correção
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P208_USUARIO (
        type: hidden
        layout {
            sequence: 20
            region: @incluir-correção
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return v('APP_USER');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P26_MD5 (
        type: hidden
        layout {
            sequence: 70
            region: @incluir-correção
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: MD5
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 20
            region: @incluir-correção
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 208
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Salvar
        layout {
            sequence: 10
            region: @incluir-correção
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P208_IDCORRECAODEVOLUCAO
        }
    )

    dynamicAction mostramsg (
        name: MostraMSG
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @create
        }

        action native-alert (
            action: alert
            settings {
                message: Após efetuar as correção, é necessário concluir a devolução, para gerar a movimentação do estoque!
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CREATE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation not-null (
        name: Not null
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P208_MOTIVO
        }
        error {
            errorMessage: Por favor, informe um motivo!
            associatedItem: @P208_MOTIVO
        }
    )

    validation valida-motivo (
        name: valida motivo
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where lower(:P208_MOTIVO) like '%correção%'
                union
                select 1
                from dual
                where lower(:P208_MOTIVO) like '%correcao%'
                ```
        }
        error {
            errorMessage: Explique com detalhes a alteração que fará, sem utilizar a palavra "correção" !
        }
    )

    process altera-situação-da-devolução (
        name: altera situação da devolução
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                vData date := sysdate;
                Begin
                  --
                  update devolucoesrepresentantes
                  set situacao = 1
                  where iddevolucaorepres = :P208_IDDEVOLUCAOREPRES;
                  --
                  -- Call the procedure
                  pck_cadastros_rmc.prc_correcaodevolucao(pidcorrecaodevolucao => :P208_IDCORRECAODEVOLUCAO,
                                                          pdatacorrecao => vData,
                                                          pusuario => :P208_usuario,
                                                          pmotivo => :P208_motivo,
                                                          piddevolucaorepres => :P208_IDDEVOLUCAOREPRES,
                                                          pidrepresentante => :P208_idrepresentante,
                                                          pmd5 => :P26_MD5,
                                                          poperacao_dml => 'I');
                
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Após efetuar as correção, é necessário concluir a devolução, para gerar a movimentação do estoque!
        }
        advanced {
            executionMappingIdentifier: 422657865220951439
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process envia-email (
        name: envia email
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_util.prc_enviaemail(ppara => 'fernando@romancemoda.com.br'
                                         , pcopia => 'edimilson@romancemoda.com.br'
                                         , passunto => '[CORRECAO DE DEVOLUÇÃO] '||' - '||pck_romance.fnc_nomefilial(:P0_IDFILIAL)
                                         , ptexto => 'O usuário '||v('APP_USER')||' está efetuando uma correcao de devolução de mercadoria do Rep: '||pck_romance.fnc_nomerepresentante(:P115_IDREPRESENTANTE)||' da semana: '||:P115_SEMANA||'<br>Motivo:'||:P208_MOTIVO );
                exception
                  when others then
                   null;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 578593258000572372
        }
        serverSideCondition {
            type: never
        }
    )

    process fetch-row-from-correcaodevolucao (
        name: Fetch Row from CORRECAODEVOLUCAO
        type: autoRowFetch
        source {
            tableName: CORRECAODEVOLUCAO
            pkColumn: IDCORRECAODEVOLUCAO
            pkItem: P208_IDCORRECAODEVOLUCAO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 422052779169692826
        }
    )

    process process-row-of-correcaodevolucao (
        name: Process Row of CORRECAODEVOLUCAO
        type: autoRowProcessing
        target {
            tableName: CORRECAODEVOLUCAO
            pkColumn: IDCORRECAODEVOLUCAO
            pkItem: P208_IDCORRECAODEVOLUCAO
            supportedOperations: insert
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Devolução atualizada!
        }
        advanced {
            executionMappingIdentifier: 422053182781692832
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        name: go to page 319
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 319
                items: {
                    P319_IDDEVOLUCAOREPRES: &P208_IDDEVOLUCAOREPRES.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: item=value
            item: P208_PAGINA
            value: 319
        }
    )

    branch (
        name: Go To Page 208
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 115
                items: {
                    P115_IDDEVOLUCAOREPRES: &P208_IDDEVOLUCAOREPRES.
                }
                successMessage: false
            }
        }
        serverSideCondition {
            type: item=value
            item: P208_PAGINA
            value: 115
        }
    )

)

