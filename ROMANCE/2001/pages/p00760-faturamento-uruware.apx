        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from parametros p
                where nome = 'SITUACAOFATURAMENTOURUWARE'
                  and idfilial = :P0_IDFILIAL
                  and valor = 'N'
                ```
        }
    )

    process muda-status-da-integração (
        name: Muda Status da integração
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 30/10/2024 by GUILHERME.DREHMER 
                declare 
                  --
                  vstatus varchar2(1);
                  --
                begin
                  -- Test statements here
                  if v('REQUEST') = 'LIGAR_FATURAMENTO' then
                    --
                    vstatus := 'S';
                    --
                  elsif v('REQUEST') = 'DESLIGAR_FATURAMENTO' then
                    --
                    vstatus := 'N';
                    --
                  end if;
                  --
                  update parametros p
                  set p.valor = vstatus
                  where p.nome = 'SITUACAOFATURAMENTOURUWARE'
                    and p.idfilial = :P0_IDFILIAL;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 52597328711184307
        }
        serverSideCondition {
            type: expression
            plsqlExpression: v('REQUEST') in ('LIGAR_FATURAMENTO','DESLIGAR_FATURAMENTO')
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 760
                items: {
                    P760_DATAINICIO: &P760_DATAINICIO.
                    P760_DATAFIM: &P760_DATAFIM.
                    P760_SITUACAO: &P760_SITUACAO.
                    P760_IDREPRESENTANTE: &P760_IDREPRESENTANTE.
                    P760_FILTRAR: S
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

