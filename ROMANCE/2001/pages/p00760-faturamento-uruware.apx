    region lista-de-notas (
        name: "Lista de Notas "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , nv.datanota
                     , nv.dataacerto
                     , nv.numeronota
                     , pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(nv.idvendedora) consultora
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.valortotalnota
                     , nv.valortotaldevolucao
                     , nv.valortotalvendalqd
                     , nv.valorpago
                     , nv.saldo
                from notasvendas nv
                where nv.idfilial = :P0_IDFILIAL
                  and ( :P760_IDREPRESENTANTE is null or nv.idrepresentante = :P760_IDREPRESENTANTE )
                  and ( :P760_SITUACAO is null
                     or ( :P760_SITUACAO = 'E' and exists ( select 1
                                                            from classificacoesnotasvendas cn
                                                            where cn.idnotavenda = nv.idnotavenda
                                                              and cn.idcaracteristicanotavenda = 72 
                                                              and trunc(cn.dataclassificado) between to_date(:P760_DATAINICIO,'DD/MM/RRRR') and to_date(:P760_DATAFIM,'DD/MM/RRRR') ) )
                     or ( :P760_SITUACAO = 'R' and exists ( select 1
                                                            from classificacoesnotasvendas cn
                                                            where cn.idnotavenda = nv.idnotavenda
                                                              and cn.idcaracteristicanotavenda = 73
                                                              and trunc(cn.dataclassificado) between to_date(:P760_DATAINICIO,'DD/MM/RRRR') and to_date(:P760_DATAFIM,'DD/MM/RRRR') ) )
                     or ( :P760_SITUACAO = 'C' and exists ( select 1
                                                            from classificacoesnotasvendas cn
                                                            where cn.idnotavenda = nv.idnotavenda
                                                              and cn.idcaracteristicanotavenda = 72 
                                                              and trunc(cn.dataclassificado) between to_date(:P760_DATAINICIO,'DD/MM/RRRR') and to_date(:P760_DATAFIM,'DD/MM/RRRR') )
                                               and exists ( select 1
                                                            from classificacoesnotasvendas cn
                                                            where cn.idnotavenda = nv.idnotavenda
                                                              and cn.idcaracteristicanotavenda = 73
                                                              and trunc(cn.dataclassificado) between to_date(:P760_DATAINICIO,'DD/MM/RRRR') and to_date(:P760_DATAFIM,'DD/MM/RRRR') ) ) )
                  and :P760_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado! Verifique novamente.
        }
        advanced {
            savedReportMappingIdentifier: 50430077062161941
        }

