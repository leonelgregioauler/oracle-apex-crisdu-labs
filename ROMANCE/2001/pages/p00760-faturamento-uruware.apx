    pageItem P760_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P760_IDREPRESENTANTE (
        type: selectOne
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , r.idrepresentante return_value
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente 
                  and r.ativo = 'S'
                  and g.idfilial = :P0_IDFILIAL
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P760_SITUACAO (
        type: radioGroup
        label {
            label: Situação
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Enviado ao Uruware;E,Retornado do Uruware;R,Envio Completo;C
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: C
        }
    )

    pageItem P760_STATUS (
        type: displayOnly
        label {
            label: STATUS
            alignment: left
        }
        layout {
            sequence: 10
            region: @ações-especiais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
                t-Form-fieldContainer--boldDisplay
            ]
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select decode(p.valor,'S','Ligado','N','Desligado') valor
                from parametros p
                where nome = 'SITUACAOFATURAMENTOURUWARE'
                  and idfilial = :P0_IDFILIAL
                ```
        }
    )

    button desligar-faturamento (
        buttonName: DESLIGAR_FATURAMENTO
        label: Desligar Faturamento
        layout {
            sequence: 30
            region: @ações-especiais
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from parametros p
                where nome = 'SITUACAOFATURAMENTOURUWARE'
                  and idfilial = :P0_IDFILIAL
                  and valor = 'S'
                ```
        }
    )

