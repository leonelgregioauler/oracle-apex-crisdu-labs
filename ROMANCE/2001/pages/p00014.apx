        }
    )

    pageItem P14_IDPRODUTO_1 (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto)||' (Qtd Disp: '||(pck_estoque.fnc_estoquedisponivel_pa(e.idestoquefilial,'U',:P14_IDPOSTOAVANCADO))||')' display_value
                     , p.idproduto return_value
                from produtos      p
                   , estoquefilial e
                where p.codigosisdist = :P14_CODIGO
                  and e.idfilial      = :P0_IDFILIAL
                  and e.idproduto = p.idproduto
                  and e.ativo = 'S'
                  and e.comissao is not null
                  and nvl(e.vlrvenda,0) > 0
                  and :P14_IDPOSTOAVANCADO is not null
                order by 1;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P14_CODIGO
                P14_IDPOSTOAVANCADO
            ]
        }
        layout {
            sequence: 120
            region: @itens-da-carga
