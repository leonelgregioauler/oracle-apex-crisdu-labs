    pageItem P14_IDPAREPRES (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @itens-da-carga
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select idpostoavancado
                from REPRESENTANTES
                where idrepresentante = ( select idrepresentante
                                          from cargasrepresentantes C
                                          where c.idcargarepresentante = :P14_IDCARGAREPRESENTANTE )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P14_IDPOSTOAVANCADO (
        type: selectList
        label {
            label: Posto Avançado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome
                     , p.idpostoavancado
                from postoavancado p
                where idfilial = :P0_IDFILIAL
                order by 1
                ```
        }
        layout {
            sequence: 80
            region: @itens-da-carga
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDPOSTOAVANCADO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return :P14_IDPAREPRES;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P14_IDPRODUTO (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto)||' (Qtd Disp: '||( pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'PP')
                                                              + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'P')
                                                              + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'M')
                                                              + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'G')
                                                              + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'GG')
                                                              + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'EGG')
                                                              + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'EXGG')
                                                              + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'U'))||')' display_value
                     , p.idproduto return_value
                from produtos      p
                   , estoquefilial e
                where p.codigosisdist = :P14_CODIGO
                  and e.idfilial      = :P0_IDFILIAL
                  and e.idproduto = p.idproduto
                  and e.ativo = 'S'
                  and e.comissao is not null
                  and nvl(e.vlrvenda,0) > 0
                order by 1;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P14_CODIGO
        }
        layout {
            sequence: 110
            region: @itens-da-carga
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDPRODUTO
            used: always
        }
        serverSideCondition {
            type: item!=value
            item: P14_ESTOQUE
            value: P
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P14_IDPRODUTO2 (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto)||' (Qtd Disp: '||( pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'PP')
                                                              + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'P')
                                                              + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'M')
                                                              + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'G')
                                                              + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'GG')
                                                              + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'EGG')
                                                              + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'EXGG')
                                                              + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'U'))||')'  display_value
                     , p.idproduto return_value
                from produtos      p
                   , estoquefilial e
                where e.idfilial      = :P0_IDFILIAL
                  and e.idproduto = p.idproduto
                  and e.ativo = 'S'
                  and e.comissao is not null
                  and nvl(e.vlrvenda,0) > 0
                order by p.nomeproduto
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 130
            region: @itens-da-carga
            slot: regionBody
            alignment: left
        }
        appearance {
