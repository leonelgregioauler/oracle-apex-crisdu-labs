    dynamicAction carga-não (
        name: Carga + = Não
        execution {
            sequence: 260
        }
        when {
            selectionType: items
            items: P14_CARGAAMAIS
        }
        clientSideCondition {
            type: item=value
            item: P14_CARGAAMAIS
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P14_QUANTIDADE
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P14_QTD_PP
                    P14_QTD_P
                    P14_QTD_M
                    P14_QTD_G
                    P14_QTD_GG
                    P14_QTD_EGG
                    P14_QTD_U
                    P14_QTD_EXGG
                    P14_IDPOSTOAVANCADO
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P14_QUANTIDADE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction carga-não-estoque-pa (
        name: Carga + = Não, Estoque PA
        execution {
            sequence: 290
        }
        when {
            selectionType: items
            items: P14_CARGAAMAIS
        }
        clientSideCondition {
            type: item=value
            item: P14_CARGAAMAIS
            value: N
        }
        serverSideCondition {
            type: item=value
            item: P14_ESTOQUE
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P14_QUANTIDADED
            }
            execution {
                sequence: 40
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                      vid number;
                    begin
                      select r.idpostoavancado
                      into vid
                      from representantes r
                         , cargasrepresentantes d
                      where r.idrepresentante = d.idrepresentante
                      and d.idcargarepresentante= :P14_IDCARGAREPRESENTANTE;
                      --
                      return vid;
                    end;
                    ```
            }
            affectedElements {
                selectionType: items
                items: P14_IDPOSTOAVANCADO
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P14_IDPOSTOAVANCADO
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P14_QUANTIDADE
            }
            execution {
                sequence: 30
            }
        )

    )

