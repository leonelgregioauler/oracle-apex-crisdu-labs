    pageItem P14_ESTOQUE (
        type: radioGroup
        label {
            label: Estoque
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Reembalagem' display_value
                     , 'R'   return_value
                from dual
                where pck_romance.fnc_retornaparametro(parametro => 'USAESTOQUEREEMB',pidfilial => :P0_IDFILIAL) = 'S'
                  and 1 =2
                union
                select 'Distribuição' display_value
                     , 'D'   return_value
                from dual
                union
                select 'Posto Avançado' display_value
                     , 'P'   return_value
                from dual
                where exists ( select 1 
                               from postoavancado p
                               where p.idfilial = :P0_IDFILIAL )
                ```
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @itens-da-carga
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: ESTOQUEMOVTO
            used: always
        }
        default {
            type: static
            staticValue: D
        }
        security {
            encryptSessionState: false
        }
    )

