    button close (
        buttonName: CLOSE
        label: Fechar e Atualizar Carga
        layout {
            sequence: 30
            region: @itens-da-carga
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 20
            region: @itens-da-carga
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P14_IDITEMCARGAREPRESENTANTE
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 40
            region: @itens-da-carga
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P14_IDITEMCARGAREPRESENTANTE
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 10
            region: @itens-da-carga
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P14_IDITEMCARGAREPRESENTANTE
        }
    )

