        execution {
            sequence: 250
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P14_ESTOQUE = 'D'
                  and pck_estoque.fnc_estoquedisponivel(:P14_IDESTOQUEFIL,'U') >= nvl(to_number(:P14_QTD_U),0)
                ```
        }
        error {
            errorMessage: Lançamento é maior que a quantidade disponível em estoque!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual 
                where :P14_ESTOQUE = 'D'
                  and :P14_CARGAAMAIS = 'S'
                  and :P14_QTD_U is not null
                  and v('REQUEST') != 'TROCAESTOQUE'
                ```
        }
    )

    validation valida-produto-sem-comissão-america-latina (
        name: Valida Produto sem Comissão America Latina
        execution {
            sequence: 260
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from estoquefilial e
                where e.idproduto = nvl(:P14_IDPRODUTO,:P14_IDPRODUTO2)
                  and e.comissao  = 'S'
                  and e.idfilial  = :P0_IDFILIAL
                ```
        }
        error {
            errorMessage: Não é possível adicionar produtos SEM COMISSÃO, entre em contato com o Suporte ao Estoque.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                v('REQUEST') in ('SAVE','CREATE') and exists ( select 1
                                                               from vw_filiais f
                                                               where f.idfilial = :P0_IDFILIAL
                                                                 and f.idgrupo  = 5 ) and :P14_ESTOQUE = 'D'
                ```
        }
    )

    validation valida-produto-sem-comissão-america-latina-pa (
        name: Valida Produto sem Comissão America Latina PA
