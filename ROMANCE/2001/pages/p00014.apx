    pageItem P14_CARGAAMAIS (
        type: radioGroup
        label {
            label: Carga a mais?
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 150
            region: @itens-da-carga
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: CARGAAMAIS
            used: always
        }
        default {
            type: static
            staticValue: N
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where ( select 1
                        from cargasrepresentantes 
                        where idcargarepresentante = :P14_IDCARGAREPRESENTANTE
                          and situacao = 3 ) = 1
                   or :P14_CARGAAMAIS = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

