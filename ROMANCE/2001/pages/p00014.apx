            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 10
        }
        serverSideCondition {
            type: item!=value
            item: P14_ESTOQUE
            value: P
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P14_IDPRODUTO2_1 (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto)display_value
                     , p.idproduto return_value
                from produtos      p
                   , estoquefilial e
                where e.idfilial      = :P0_IDFILIAL
                  and e.idproduto = p.idproduto
                  and e.ativo = 'S'
                  and e.comissao is not null
                  and nvl(e.vlrvenda,0) > 0
                  and :P14_IDPOSTOAVANCADO is not null
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
