page 14 (
    name: Itens da Carga
    title: Itens da Carga
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            
            function confirmaitem(event)
            {
             var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
             //console.log (tecla);
             if (tecla==13) 
             { 
              var answer = confirm("Confirma inclusão do item na carga?")
              if (answer)
              {
                apex.submit('CREATE');
              }
             } 
              else 
              { if([190,188,110,194].indexOf(tecla) !=-1) 
                {
                 alert('Informe uma Quantidade Válida!'); 
                 return false;
                }
              }
            }
            
            
            function tem_casas_decimais(valor)
            {
             if (typeof(valor) != 'String')
              valor = valor.toString();
            
             return valor.match(/[.,]/) != null;
            }
            
            function fnc_validapa()
            {
              if (document.getElementById('P14_IDPOSTOAVANCADO').value != document.getElementById('P14_IDPAREPRES').value)
              {
                 alert('Posto avançado selecionado é diferente do Posto Avançado do cliente!')   
              }
            }
            ```
        executeWhenPageLoads: document.getElementById('P14_CODIGO').focus();
    }
    security {
        formAutoComplete: true
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

