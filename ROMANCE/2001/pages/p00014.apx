    validation obrigatório-selecionar-posto-avançado (
        name: Obrigatório selecionar Posto Avançado
        execution {
            sequence: 160
        }
        validation {
            type: itemIsNotNull
            item: P14_IDPOSTOAVANCADO
        }
        error {
            errorMessage: Selecione um Posto Avançado
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where :P14_ESTOQUE = 'P'
                and v('REQUEST')!='TROCAESTOQUE'
                ```
        }
    )

    validation p14-idestoquefil (
        name: P14_IDESTOQUEFIL
        execution {
            sequence: 50
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from itenscargarepresentante
                where cargaamais           = :P14_CARGAAMAIS
                  and idcargarepresentante = :P14_IDCARGAREPRESENTANTE
                  and idestoquefil         = ( select ee.idestoquefilial
                                               from estoquefilial ee
                                               where idfilial  = :P0_IDFILIAL
                                                 and idproduto = :P14_IDPRODUTO)
                ```
        }
        error {
            errorMessage: Este produto já foi incluído na carga!
            displayLocation: inlineInNotification
            associatedItem: @P14_IDESTOQUEFIL
        }
        serverSideCondition {
            type: never
        }
    )

    validation p14-idestoquefil-2 (
        name: P14_IDESTOQUEFIL2
        execution {
            sequence: 60
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from itenscargarepresentante
                where cargaamais           = :P14_CARGAAMAIS
                  and idcargarepresentante = :P14_IDCARGAREPRESENTANTE
                  and idestoquefil         = ( select ee.idestoquefilial
                                               from estoquefilial ee
                                               where idfilial  = :P0_IDFILIAL
                                                 and idproduto = :P14_IDPRODUTO2)
                ```
        }
        error {
            errorMessage: Este produto já foi incluído na carga!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: never
        }
    )

    validation p14-idproduto (
        name: P14_IDPRODUTO
        execution {
            sequence: 30
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P14_IDPRODUTO is not null
                or :P14_IDPRODUTO2 is not null
                OR :P14_IDPRODUTO_1 is not null
                or :P14_IDPRODUTO2_1 is not null
                ```
        }
        error {
            errorMessage: Informe o produto!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: request!=Value
            value: TROCAESTOQUE
        }
    )

    validation p14-qtd-u (
        name: P14_QTD_U
        execution {
            sequence: 70
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(:P14_QTD_U) > 0
                ```
        }
        error {
            errorMessage: Informe uma quantidade Válida!
            associatedItem: @P14_QTD_U
        }
        serverSideCondition {
            type: never
        }
    )

    validation valida-estoque-da-filial (
        name: Valida estoque da Filial
        execution {
            sequence: 40
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from estoquefilial e
                where e.idproduto  = ( select p.idproduto from produtos p where p.codigosisdist = :P14_CODIGO )
                  and e.idfilial   = ( select c.idfilial from cargasrepresentantes c where c.idcargarepresentante =:P14_IDCARGAREPRESENTANTE )
                  and e.quantidade >= to_number(:P14_QUANTIDADE)
                ```
        }
        error {
            errorMessage: Quantidade não disponível no estoque da Filial.
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: never
        }
    )

    validation valida-estoque-disponivel-postoavancado (
        name: valida estoque disponivel POSTOAVANCADO
        execution {
            sequence: 170
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from estoquepostoavancado ep
                   , estoquefilial e
                where  e.idfilial = :P0_IDFILIAL
                  and ep.idestoquefil = e.idestoquefilial
                  and (  e.idproduto = :P14_IDPRODUTO_1
                      or e.idproduto = :P14_IDPRODUTO2_1)    
                  and :P14_ESTOQUE = 'P'
                  and (nvl(to_number(:P14_QTD_U),0)) <= (nvl(ep.qtd_u,0)-pck_estoque.fnc_estoquereserva_pa(ep.idestoquefil,'U',ep.idpostoavancado))
                ```
        }
        error {
            errorMessage: "Quantidade distribuída não pode ser maior que o estoque! "
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual 
                where :P14_ESTOQUE = 'P'
                  and v('REQUEST')!='TROCAESTOQUE'
                ```
        }
    )

    validation valida-p14-qtd-egg (
        name: Valida P14_QTD_EGG
        execution {
            sequence: 230
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P14_ESTOQUE = 'D'
                  and pck_estoque.fnc_estoquedisponivel(:P14_IDESTOQUEFIL,'EGG') >= nvl(to_number(:P14_QTD_EGG),0)
                ```
        }
        error {
            errorMessage: Lançamento é maior que a quantidade disponível em estoque!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual 
                where :P14_ESTOQUE = 'D'
                  and :P14_CARGAAMAIS = 'S'
                  and :P14_QTD_EGG is not null
                  and v('REQUEST') != 'TROCAESTOQUE'
                ```
        }
    )

