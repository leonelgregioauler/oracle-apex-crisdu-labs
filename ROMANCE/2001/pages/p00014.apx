    validation valida-quantidade (
        name: Valida Quantidade
        execution {
            sequence: 120
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(:P14_QTD_PP) > 0
                   or to_number(:P14_QTD_P) > 0
                   or to_number(:P14_QTD_M) > 0
                   or to_number(:P14_QTD_G) > 0
                   or to_number(:P14_QTD_GG) > 0
                   or to_number(:P14_QTD_EGG) > 0
                   or to_number(:P14_QTD_EXGG) > 0
                   or to_number(:P14_QTD_U) > 0
                   or to_number(:P14_QUANTIDADE) > 0
                ```
        }
        error {
            errorMessage: Informe uma quantidade Válida!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: request!=Value
            value: TROCAESTOQUE
        }
    )

    validation validar-estoque-distribuicao (
        name: Validar estoque Distribuicao
        execution {
            sequence: 80
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from estoquefilial  e
                where  idfilial = :P0_IDFILIAL
                  and (  idproduto = :P14_IDPRODUTO
                      or idproduto = :P14_IDPRODUTO2)    
                  and :P14_ESTOQUE = 'D'
                  and ( nvl(to_number(:P14_QTD_P),0)
                      + nvl(to_number(:P14_QTD_PP),0)
                      + nvl(to_number(:P14_QTD_M),0)
                      + nvl(to_number(:P14_QTD_G),0)
                      + nvl(to_number(:P14_QTD_GG),0)
                      + nvl(to_number(:P14_QTD_EGG),0)
                      + nvl(to_number(:P14_QTD_EXGG),0)
                      + nvl(to_number(:P14_QTD_U),0)
                      + nvl(to_number(:P14_QUANTIDADE),0)) <= ( nvl(qtd_pp ,0) 
                                                              + nvl(qtd_p ,0)  
                                                              + nvl(qtd_m ,0)  
                                                              + nvl(qtd_g ,0)
                                                              + nvl(qtd_gg,0)  
                                                              + nvl(qtd_egg,0) 
                                                              + nvl(qtd_exgg,0) 
                                                              + nvl(qtd_u,0))
                ```
        }
        error {
            errorMessage: Lançamento é maior que a quantidade disponível em estoque!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: never
        }
    )

    process busca-idestoquefil (
        name: Busca IDESTOQUEFIL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                select idestoquefilial
                into :P14_IDESTOQUEFIL
                from estoquefilial e
                where ( e.idproduto = :P14_IDPRODUTO
                   or e.idproduto = :P14_IDPRODUTO2 )
                 and e.idfilial = :P0_IDFILIAL
