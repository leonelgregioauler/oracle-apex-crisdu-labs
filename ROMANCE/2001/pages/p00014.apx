    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidproduto  number;
                  --
                begin 
                  --
                  if :P14_ESTOQUE = 'D' and :P14_IDPRODUTO is null then
                    :P14_IDPRODUTO := :P14_IDPRODUTO2;
                  elsif :P14_ESTOQUE = 'P' and :P14_IDPRODUTO_1 is null then
                    :P14_IDPRODUTO_1 := :P14_IDPRODUTO2_1;
                  end if;
                  --
                  select SEQ_IDITCARGAREPRES.nextval
                  into :P14_IDITEMCARGAREPRES
                  from dual;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 28504226589219819
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

