page 270 (
    name: Imprime Devolução Completa
    title: Imprime Devolução Completa
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region imprime-devolução (
        name: Imprime Devolução
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_imprime.prc_imprimedevolucao_comp( vidrepresentante => :P270_IDREPRESENTANTE
                                                       , vsemana          => :P270_SEMANA 
                                                       , viddevolucaorepres => :P270_IDDEVOLUCAOREPRES );
                end;  
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            column: 1
        }
    )

    pageItem P270_IDDEVOLUCAOREPRES (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @imprime-devolução
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P270_IDREPRESENTANTE (
        type: hidden
        layout {
            sequence: 20
            region: @imprime-devolução
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P270_SEMANA (
        type: hidden
        layout {
            sequence: 30
            region: @imprime-devolução
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

