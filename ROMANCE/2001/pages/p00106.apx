    process fetch-row-from-itensprodutosembalados (
        name: Fetch Row from ITENSPRODUTOSEMBALADOS
        type: autoRowFetch
        source {
            tableName: ITENSPRODUTOSEMBALADOS
            pkColumn: IDITEMPRODEMBALADO
            pkItem: P106_IDITEMPRODEMBALADO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 162320063163453555
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P106_IDITEMPRODEMBALADO is null then
                        select "SEQ_IDITEMPRODEMBALADOS".nextval
                          into :P106_IDITEMPRODEMBALADO
                          from dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 162320268502453555
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-itensprodutosembalados (
        name: Process Row of ITENSPRODUTOSEMBALADOS
        type: autoRowProcessing
        target {
            tableName: ITENSPRODUTOSEMBALADOS
            pkColumn: IDITEMPRODEMBALADO
            pkItem: P106_IDITEMPRODEMBALADO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 162320458791453556
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
