            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 162320684579453556
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 106
                items: {
