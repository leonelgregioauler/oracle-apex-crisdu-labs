page 106 (
    name: Inclusão de Produto
    title: Inclusão de Produto
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function  confirmaproduto(event)
             { 
               var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            
               vidcontrole = document.getElementById('P106_IDITEMPRODEMBALADO').value;
            
               if (tecla==13) {
                   if (vidcontrole == '')
                     {
            	   apex.submit('CREATE');
                     }
                   else
                     {
                       apex.submit('SAVE');
                     }
                 }
            }
            
            function fnc_deletou ()
             {
                vidcontrole = document.getElementById('P106_IDPRODUTOEMBALADO').value;
                if (vidcontrole == '')
                 {
                  window.close();
                 }
              }
               
              
            
            ```
        executeWhenPageLoads:
            ```javascript-browser
            window.opener.location.reload(); 
            
            fnc_deletou();
               
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region inclusão-de-produto (
        name: Inclusão de Produto
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P106_IDCATEGORIA (
        type: selectList
        label {
            label: Categoria
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select cc.nome   display_value
                     , cc.idcategoria return_value
                from categorias cc
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 35
            region: @inclusão-de-produto
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCATEGORIA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P106_IDITEMPRODEMBALADO (
        type: hidden
