page 349 (
    name: Integração de Cadastros Romance / Virtual Age
    title: Integração de Cadastros Romance / Virtual Age
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
    }
    sessionManagement {
        rejoinSessions: false
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    region integração-de-cadastro-romance-virtual-age (
        name: Integração de Cadastro Romance / Virtual Age
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  cursor c1 is
                    select cvt.codigopessoa
                         , cvt.cpfcnpj
                    from pessoas p
                       , favorita.codigospessoasvirtualage cvt
                    where cvt.cpfcnpj = :P349_DOCUMENTO
                      and ( p.cpf = cvt.cpfcnpj
                          or p.cnpj = cvt.cpfcnpj );
                  --
                  cursor c2 is
                    select ipv.data
                         , ipv.mensagem
                         , ipv.idpessoa
                         , ipv.cpfcnpj
                    from pessoas p
                       , favorita.INTEGRACAOPESSOASVIRUTALAGE ipv
                    where ( ipv.idpessoa = p.idpessoa
                         or ipv.cpfcnpj = p.cpf )
                      and ipv.cpfcnpj = :P349_DOCUMENTO 
                    order by data desc;
                  --
                  r1 c1%rowtype;
                  --
                  r2 c2%rowtype;
                  --
                begin
                  --
                  htp.p('<style>');  
                  htp.p('th, td {');
                  htp.p('    padding: 10px;');
                  htp.p('}');
                  --
                  htp.p('table tr:nth-child(even) {');
                  htp.p('    background-color: #eee;');
                  htp.p('}');
                  htp.p('table tr:nth-child(odd) {');
                  htp.p('   background-color:#fff;');
                  htp.p('}');
                  htp.p('table th {');
                  htp.p('    background-color: gray;');
                  htp.p('    color: white;');
                  htp.p('}');
                  htp.p('</style>');
                  --
                  open c1;
                  fetch c1 into r1;
                    --
                    if r1.codigopessoa is not null then
                      htp.p('<table style="width:100%">');
                      htp.p('<tr  align="center">');
                      htp.p('  <th><h4>Informações</h4></th>');
                      htp.p('</tr>');
                       
                      htp.p('<tr>');
                      htp.p('  <td align="center"><h3><font color="green">Cadastro do documento '|| r1.cpfcnpj ||' integrado com sucesso ao Virtual Age. <br> Código do Cliente: '|| r1.codigopessoa ||'</font></h3></td>');
                      htp.p('</tr>');
                      --
                      htp.p('</table>');
                      --
                    end if;
                    --
                  close c1;
                  --
                  htp.p('<table style="width:100%">');
                  htp.p('<tr  align="center">');
                  htp.p('  <th><h4>Data da Integração</h4></th>');
                  htp.p('  <th colspan=7><h4>Mensagem Integração</h4></th>');
                  htp.p('<br>');
                  htp.p('</tr>');
                  --
                  open c2;
                  loop
                    fetch c2 into r2;
                    --
                    if c2%notfound then
                      --
                      htp.p('<tr>');
                      htp.p('  <td align="center">'|| to_char(sysdate, 'dd/mm/yyyy hh24:mi:ss') ||'</td>');
                      htp.p('  <td colspan=7> Erro localizado na Integração! Verifique o cadastro realizado. </td>');
                      --
                    end if;
                    --
                    exit when c2%notfound;
                      --
                      htp.p('<tr>');
                      htp.p('  <td align="center">'|| to_char(r2.data, 'dd/mm/yyyy hh24:mi:ss') ||'</td>');
                      htp.p('  <td colspan=7> Mensagem: '||r2.mensagem||'. </td>');
                      --
                    end loop;
                  close c2;
                  --
                  htp.p('</tr>');
                  htp.p('</table>');
                  --
                end;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P349_DOCUMENTO (
        type: textField
        label {
            label: DOCUMENTO
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

