page 156 (
    name: Consultar Nota
    title: Consultar Nota
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_popup_redireciona()
            {
              vidnotavenda = document.getElementById('P156_IDNOTAVENDA').value;
              window.opener.location.href = 'f?p=&APP_ID.:37:&SESSION.::NO::P37_IDNOTAVENDA:'+vidnotavenda;
              window.self.close();
              void(0);
            }
            
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region consultar (
        name: Consultar
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P156_IDNOTA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @consultar
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P156_IDNOTAVENDA (
        type: selectList
        label {
            label: Vendedora
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(idvendedora) display_value
                     , n.idvendedora  return_value
                from notasvendas n
                where n.idrepresentante = :P156_IDREPRESENTANTE
                  and n.numeronota      = :P156_NUMERONOTA
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P156_IDREPRESENTANTE
                P156_NUMERONOTA
            ]
        }
        layout {
            sequence: 30
            region: @consultar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 3
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P156_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @representantes-2
            nullDisplayValue: - Selecione o Distribuidor -
        }
        layout {
            sequence: 10
            region: @consultar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P156_NUMERONOTA (
        type: numberField
        label {
            label: Nr. Nota
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @consultar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 15
        }
        validation {
            maxLength: 4000
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button consultar (
        buttonName: CONSULTAR
        label: Consultar
        layout {
            sequence: 10
            region: @consultar
            slot: topAndBottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process atualiza-idnota (
        name: "Atualiza idnota "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  select idnotavenda
                  into :P156_IDNOTA
                  from notasvendas
                  where idrepresentante = :P156_IDREPRESENTANTE
                    and numeronota = :P156_NUMERONOTA
                    and idvendedora = :P156_IDNOTAVENDA;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 20617071469026905
        }
    )

    branch (
        name: Redireciona
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 37
                items: {
                    P37_IDREPRESENTANTE: &P156_IDREPRESENTANTE.
                    P37_IDNOTAVENDA: &P156_IDNOTA.
                }
                action: resetPagination
            }
        }
    )

)

