    pageItem P92_QUESTIONARIO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @avisos-importantes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="Blue"><h2> Você possui '||count(1)||' questionamento(s) pendente(s) de leitura! </font></h2>' display_value
                from questionamentoscontroladoria q
                where q.confirmacaoleitura = 'N'
                  and ( ( q.idpessoa = ( select idpessoa
                                         from usuarios u
                                         where u.usuario = v('APP_USER') ) )
                     or ( q.idfilial = :P0_IDFILIAL and exists ( select 1
                                                                 from usuarios u
                                                                    , gerentes g
                                                                 where u.idpessoa = g.idpessoa 
                                                                   and u.usuario = v('APP_USER') ) ) )
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

