    region observações-da-controladoria (
        name: Observações da Controladoria
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.datacorrecao
                     , c.motivo
                     , pck_romance.fnc_nomeusuario(c.usuario) usuario
                from CORRECOESFECHAMENTOSSEMANAIS c
                where c.idfechamento = :P92_IDFECHAMENTO
                order by 1
                ```
        }
        layout {
            sequence: 10
            parentRegion: @limites-para-gaveta
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from CORRECOESFECHAMENTOSSEMANAIS c
                where c.idfechamento = :P92_IDFECHAMENTO
                ```
        }
