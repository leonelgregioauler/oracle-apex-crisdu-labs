    pageItem P92_TOTALCOMISSAOGERENTE (
        type: numberField
        label {
            label: Comissão Gerente
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 240
            region: @fechamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 15
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: databaseColumn
            databaseColumn: TOTALCOMISSAOGERENTE
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vvalor    number(15,2);
                  vcomissao number(15,2);
                  --
                begin
                  --
                  select g.perccomissao
                  into vcomissao
                  from gerentes g
                  where g.idfilial = :P92_IDFILIAL;
                  ---
                  select sum(totalgeral)*vcomissao/100
                  into vvalor
                  from fechamentorepresentantes f
                  where f.semana = :P92_SEMANA
                    and f.idfilial = :P92_IDFILIAL;
                  --
                  return to_char(nvl(vvalor,0),'999G999G999G990D00') ;
                  --
                end;
                ```
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: pck_util.fnc_verificaacesso(2818,v('APP_USER')) = 'N'
        }
        readOnly {
            type: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

