    region acompanhamento-de-gavetas (
        name: Acompanhamento de Gavetas
        type: chart
        layout {
            sequence: 60
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--xlarge
                t-Form--stretchInputs
            ]
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        legend {
            show: false
        }

        series fechamentos (
            name: Fechamentos
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select link
                         , label
                         , value "Total Gaveta"
                    from ( select f.idfechamento link
                                , f.semana label
                                , f.totalgaveta value
                           from fechamentossemanais f
                           where f.idfilial = :P0_IDFILIAL
                           order by 1 desc )
                    where rownum <= 10
                    order by 1
                    ```
            }
            columnMapping {
                label: LABEL
                value: "Total Gaveta"
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region avisos-importantes (
        name: Avisos Importantes
        type: staticContent
        layout {
            sequence: 10
            slot: fullWidthContent
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from questionamentoscontroladoria q
                where q.confirmacaoleitura = 'N'
                  and ( ( q.idpessoa = ( select idpessoa
                                         from usuarios u
                                         where u.usuario = v('APP_USER') ) )
                     or ( q.idfilial = :P0_IDFILIAL and exists ( select 1
                                                                 from usuarios u
                                                                    , gerentes g
                                                                 where u.idpessoa = g.idpessoa 
                                                                   and u.usuario = v('APP_USER') ) ) )
                ```
        }
    )

    region avisos-importantes-2 (
        name: Avisos Importantes
        type: staticContent
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where f.idsemana = ( select ff.idsemana
                                     from fechamentossemanais ff
                                     where ff.idfechamento = :P92_IDFECHAMENTO) -1
                  and f.valorsaldoanteriorcongelado is not null
                  and f.idfilial = :P0_IDFILIAL
                ```
        }
    )

    region concluir (
        name: Concluir
        type: staticContent
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
            renderComponents: belowContent
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P92_IDFECHAMENTO IS NOT NULL
                and nvl(:P92_CONCLUIDO,'N') = 'N'
                and ( exists ( select 1
                               from gerentes g
                               where idfilial = :P0_IDFILIAL
                                 and idpessoa = ( select idpessoa 
                                                  FROM USUARIOS 
                                                  where usuario = v('APP_USER') ) )
                    or v('APP_USER') = 'GUILHERME' )
                and ( ( select tipofilial 
                        from vw_filiais f
                        where f.idfilial = :P0_IDFILIAL ) = 'D' and :P92_LIBERARCONCLUSAO = 'S' 
                    or ( select tipofilial 
                        from vw_filiais f
                        where f.idfilial = :P0_IDFILIAL ) != 'D' 
                    or ( v('APP_USER') = 'GUILHERME' ) )
                ```
        }
    )

