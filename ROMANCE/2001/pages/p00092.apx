    process atualzia-saldo-gaveta (
        name: atualzia saldo gaveta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update fechamentossemanais f
                  set f.saldoanteriorgaveta = ( select s.totalgaveta
                                                from fechamentossemanais s
                                                where s.idfilial = f.idfilial
                                                  and s.semana   = to_char(to_number(substr(f.semana,1,2))-1)||'/'||substr(f.semana,4,4) )
                  where f.idfechamento = :P92_IDFECHAMENTO;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Gaveta atualizada com sucesso!
        }
        error {
            errorMessage: Erro ao buscar saldo anterior de gaveta.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 26835337840432990
        }
    )

    process confirma-fechamento (
        name: confirma fechamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vsubtotal number := TO_NUMBER(:P92_SUBTOTALDASEMANA,'99999999999999999D00');
                begin
                  --
                  --
                  -- Se o usuário não for controladoria com autorização de fechamento de caixa -  liberação acesso 2309 - Controladoria Financeira
                  --
                  if pck_util.fnc_verificaacesso(pidaplicacao => 2309,pusuario => v('APP_USER'))  = 'N' then
                    --
                    -- Se o usuario que está concluindo o caixa é da própria empresa(gerente)
                    --
                    if upper(TRIM(:P92_ASSINATURA)) = v('APP_USER') and pck_romance.fnc_filialusuario(v('APP_USER')) = :P0_IDFILIAL then
                      --
                      :P92_CONCLUIDO := 'S';
                      --
                      --raise_application_error(-20001,'IDFECHAMENTO - '||:P92_IDFECHAMENTO);
                      --
                      pck_acertosfechamento.prc_enviaemailfechamento(pidfechamento => :P92_IDFECHAMENTO,
                                                                     pusuario      => v('APP_USER'));
                      --
                      -- Se o usuário não tiver liberação controladoria e não for gerente e tiver somente liberação de fechamento dos caixas - liberação de acesso 3564 - Encerrar Caixa
                      --
                    elsif pck_util.fnc_verificaacesso(pidaplicacao => 3565,pusuario => v('APP_USER'))  = 'S' then 
                      --
                      :P92_CONCLUIDO := 'S';
                      --
                    else
                      --
                      :P92_CONCLUIDO := 'N';
                      --
                    end if;
                    --
                  end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Fechamento concluído!
        }
        advanced {
            executionMappingIdentifier: 26833722644432989
        }
    )

