    pageItem P92_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                where f.idpessoa  = p.idpessoa
                  and f.idfilial  = pck_romance.fnc_filialusuario(V('APP_USER'))
                  and :P92_IDFILIAL is null
                union
                select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                where f.idpessoa  = p.idpessoa
                  and :P92_IDFILIAL is not null 
                  and f.idfilial  = :P92_IDFILIAL
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @fechamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vfilial number;
                begin
                  select pck_romance.fnc_filialusuario( v('APP_USER') )
                  into vfilial
                  from dual;
                  ---
                  return vfilial;
                EXCEPTION  
                  WHEN OTHERS THEN 
                    NULL;
                end;
                ```
        }
        readOnly {
            type: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P92_INFO_DESPESAS (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 20
            region: @fechamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText:
                ```html
                <font color="GREEN"><h3>
                    Existem lançamentos de despesas sem anexos.
                    </h3></font>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from despesas d
                where idfechamento = :P92_IDFECHAMENTO
                 and d.idmovimentotogeral is null
                 and not exists ( select 1
                                  from anexosdespesas a
                                  where a.iddespesa = d.iddespesa )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

