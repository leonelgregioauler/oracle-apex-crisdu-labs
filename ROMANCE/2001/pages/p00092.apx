    pageItem P92_TOTALVENDASDIRETAS (
        type: numberField
        label {
            label: Vendas Diretas (Já somado ao lado)
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 140
            region: @fechamento
            slot: regionBody
            alignment: left
            startNewRow: false
            columnAttributes: [
                onclick="javascript:vendadiretaromance()"
                readonly
            ]
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 15
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: databaseColumn
            databaseColumn: TOTALVENDASDIRETAS
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vvalor number(15,2);
                  vvalor2 number(15,2);
                  vtotal number(15,2);
                  --
                begin
                  --
                 /* select sum(valortotal)
                  into vvalor
                  from vendasdiretas f
                  where f.semana = :P69_SEMANA
                    and f.idfilial = :P69_IDFILIAL;    */
                 --
                  select sum(valorpago)
                  into vvalor2
                  from pagamentosvendasdiretas pg
                  where pg.idfechamento = :P92_IDFECHAMENTO;
                  --
                  vtotal := nvl(vvalor,0) + nvl(vvalor2,0);
                  --
                  return to_char(nvl(vtotal,0),'999G999G999G990D00') ;
                  --
                end;
                ```
        }
        readOnly {
            type: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

