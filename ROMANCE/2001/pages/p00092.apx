    validation valida-despesas-sem-anexo-gerente (
        name: Valida despesas sem anexo gerente
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from despesas d
                where idfechamento = :P92_IDFECHAMENTO
                  and d.identradadiversa is null
                  and d.idmovimentotogeral is null
                  and not exists ( select 1
                                   from anexosdespesas a
                                   where a.iddespesa = d.iddespesa )
                ```
        }
        error {
            errorMessage: Existem despesas lançadas sem anexo vinculado! Verifique e anexe as despesas antes de encerrar a semana. 01
        }
        serverSideCondition {
            whenButtonPressed: @confirmar
            type: itemIsNotNull
            item: P92_ASSINATURA
        }
        comments {
            comments: Valida existência de despesas sem anexo não permitindo finalizar o caixa caso exista.Validação aplicada para usuário gerente.
        }
    )

    validation valida-despesas-sem-anexo-não-gerente (
        name: Valida despesas sem anexo não gerente
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from despesas d
                where idfechamento = :P92_IDFECHAMENTO
                  and d.identradadiversa is null
                  and d.idmovimentotogeral is null
                  and not exists ( select 1
                                   from anexosdespesas a
                                   where a.iddespesa = d.iddespesa )
                  and not exists ( select 1
                                   from usuarios u
                                   where u.usuario = v('APP_USER') 
                                     and u.idgerente in (239,257) )
                  -- Pra nao trancar quando estiver reabrindo o fechamento
                  and (:P92_CONCLUIDO = 'S' and 'N' = (select nvl(fs.concluido,'N')
                                                         from roman.fechamentossemanais fs
                                                        where fs.idfechamento = :P92_IDFECHAMENTO))
                ```
        }
        error {
            errorMessage: Existem despesas lançadas sem anexo vinculado! Verifique e anexe as despesas antes de encerrar a semana. 02
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
        comments {
            comments: Valida existência de despesas sem anexo não permitindo finalizar o caixa caso exista.Validação aplicada para usuários de controladoria e com permissão especial para fechamento do caixa.
        }
    )

