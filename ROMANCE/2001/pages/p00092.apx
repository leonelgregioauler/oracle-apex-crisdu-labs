    validation impedir-fechamento-de-semana-se-tiver-comprovante-pendente-de-envio (
        name: Impedir Fechamento de Semana se tiver comprovante Pendente de Envio
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from depositosdiarios_orig d
                   , fechamentossemanais fs
                   , representantes r
                   , gerentes g
                where r.idpessoa = g.idpessoa
                and fs.idfilial = g.idfilial
                and d.idrepresentante = r.idrepresentante
                and d.idstatus = 1
                and fs.idfechamento = :P92_IDFECHAMENTO
                and d.idsemana <= fs.idsemana
                and :P92_CONCLUIDO = 'S'
                ```
        }
        error {
            errorMessage: Fechamento não pode ser realizado. Existe solicitação "Pendente de Envio"
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

