    region pgto-de-manut-recebidos (
        name: Pgto de Manut. Recebidos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idpgtomanutencao
                     , pck_romance.fnc_nomerepresentante(m.idrepresentante) representante
                     , t.datapagamento
                     , t.valorpago
                from pagamentosmanutencoes t
                   , manutencoesrealizadas m
                where t.idmanutencao = m.idmanutencao
                  and t.idfechamentorepres in ( select f.idfechamentorepres 
                                                from fechamentorepresentantes F
                                                where idfechamento = :P92_IDFECHAMENTO )
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: Valores recebidos deve ser enviados em envelope separado junto com o fechamento.
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        messages {
            whenNoDataFound: -
        }
        componentAdvanced {
            stripHtml: true
        }

        column DATAPAGAMENTO (
            reportColumnQueryId: 3
            derivedColumn: N
