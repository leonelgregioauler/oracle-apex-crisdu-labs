    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @fechamento
            slot: previous
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 91
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button confirmar (
        buttonName: CONFIRMAR
        label: CONFIRMAR
        layout {
            sequence: 10
            region: @conclusão-da-semana
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            executeValidations: false
            showProcessing: true
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P92_IDFECHAMENTO
        }
    )

    button criar-questionamento (
        buttonName: CRIAR_QUESTIONAMENTO
        label: Novo Questionamento
        layout {
            sequence: 10
            region: @fechamento
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 389
                items: {
                    P389_IDFECHAMENTO: &P92_IDFECHAMENTO.
                    P389_IDQUESTIONAMENTO:
                    P389_PAGINA: 92
                    P389_DESTINO: E
                    P389_IDFILIAL: &P0_IDFILIAL.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select *
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento in ( 2 , 0 )
                  and ug.usuario = v('APP_USER')
                ```
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 40
            region: @fechamento
            slot: delete
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button encerrar-semana (
        buttonName: ENCERRAR_SEMANA
        label: Encerrar Semana
        layout {
            sequence: 10
            region: @concluir
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: openModal('CONCLUSAO');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button liberar-fechamento (
        buttonName: LIBERAR_FECHAMENTO
        label: Liberar Fechamento
        layout {
            sequence: 10
            region: @limites-para-gaveta
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 344
                items: {
                    P344_IDFECHAMENTO: &P92_IDFECHAMENTO.
                    P344_IDCORRECAOFECHAMENTOSEMAN:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P92_LIBERARCONCLUSAO = 'N'
                  and exists ( select 1
                               from usuariosgruposatendimento u
                               where u.usuario = v('APP_USER')
                                 and u.idgrupoatendimento in (0,2) )
                ```
        }
    )

    button p92-depositos (
        buttonName: P92_DEPOSITOS
        label: Detalhar Depósitos
        layout {
            sequence: 460
            region: @fechamento
            slot: regionBody
        }
        appearance {
