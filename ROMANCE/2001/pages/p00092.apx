    pageItem P92_TOTALCHQSEMFUNDORECEBIDOS (
        type: numberField
        label {
            label: Chq S/ Fundo Receb.
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 150
            region: @fechamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 15
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: TOTALCHQSEMFUNDORECEBIDOS
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vvalor number(15,2);
                  --
                begin
                  --
                    select SUM(cp.valor)
                    into vvalor 
                    from cheques2pgto cp
                       , cheques2     c
                       , representantes r
                       , gerentes g
                    where cp.idcheque = c.idcheque
                      and c.semfundo  = 'S'
                      and c.Idrepresentante = r.idrepresentante
                      and r.idgerente       = g.idgerente
                      and g.idfilial        = :P69_IDFILIAL
                      and to_char(cp.datapgto,'IW/RRRR') = :P69_SEMANA;
                  --
                  return replace(to_char(NVL(vvalor,0),'999G999G999G990D00'),' ','') ;
                  --
                exception
                  when others then
                    return replace(to_char(0,'999G999G999G990D00'),' ','') ;
                end;
                ```
        }
        readOnly {
            type: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

