    pageItem P92_MENSAGEM_DEPOSITOS_PENDENTES (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 30
            region: @concluir
            slot: regionBody
            alignment: left
            columnAttributes: onClick="javascript:openModal('DEPOSITOS');"
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color=''red''>Constam '||to_char(sum(d.valordeposito),'999G999G999G999G990D00')||' em depósito aberto.</font> Clique aqui para visualizar. ' d
                from depositosdiarios_orig d
                where trunc(sysdate) - trunc(d.datacriacao) >= 20
                  and d.nrocomprovante is null
                  and d.datacriacao is not null
                  and d.idfechamentorepres is null
                  and d.comprovado = 'S'
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = d.idrepresentante
                                 and r.idgerente       = ( select idgerente
                                                           from gerentes g
                                                           where g.idfilial = :P0_IDFILIAL ) 
                                 and exists ( select 1
                                              from regioesrepresentantes rr
                                              where rr.idrepresentante = d.idrepresentante ) );
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from depositosdiarios_orig d
                where trunc(sysdate) - trunc(d.datacriacao) >= 20
                  and d.nrocomprovante is null
                  and d.datacriacao is not null
                  and d.idfechamentorepres is null
                  and d.comprovado = 'S'
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = d.idrepresentante
                                 and r.idgerente       = ( select idgerente
                                                           from gerentes g
                                                           where g.idfilial = :P0_IDFILIAL ) 
                                 and exists ( select 1
                                              from regioesrepresentantes rr
                                              where rr.idrepresentante = d.idrepresentante ) );
                ```
        }
        security {
            encryptSessionState: false
        }
    )

