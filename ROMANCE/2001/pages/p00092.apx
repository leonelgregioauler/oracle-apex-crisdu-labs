    region relatório (
        name: Relatório
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(d.idrepresentante) nome
                     , d.data
                     , d.valordeposito
                from depositosdiarios_orig d
                where trunc(sysdate) - trunc(d.datacriacao) >= 20
                  and d.datacriacao is not null
                  and d.idfechamentorepres is null
                  and d.comprovado = 'S'
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = d.idrepresentante
                                 and r.idgerente       = ( select idgerente
                                                           from gerentes g
                                                           where g.idfilial = :P0_IDFILIAL )
                                 and exists ( select 1
                                              from regioesrepresentantes rr
                                              where rr.idrepresentante = d.idrepresentante ) )
                ```
            pageItemsToSubmit: P0_IDFILIAL
        }
        layout {
            sequence: 10
            parentRegion: @depósitos-pendentes-de-confirmação-a-mais-de-20-dias
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Nenhum registro encontrado!
        }

        column DATA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            sorting {
                sortable: false
            }
        )

        column NOME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column VALORDEPOSITO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Valor Depósito
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

    )

