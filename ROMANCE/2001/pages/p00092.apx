page 92 (
    name: Fechamento Semanal
    title: Fechamento Semanal
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function pgtofavorita()
            {
              vfechamento = document.getElementById('P92_IDFECHAMENTO').value
              
               window.open('f?p=&APP_ID.:178:&SESSION.::NO:178:P178_IDFECHAMENTO:'+vfechamento  ,'PGTO','toolbar=no,location=no,status=no,menubar=yes,scrollbars=no,resizable=no,width=550,height=700,left=400,top=400','_blank'); void(0);  		
               
            }
            
            function depositos()
            {
              vfechamento = document.getElementById('P92_IDFECHAMENTO').value
              
               window.open('f?p=&APP_ID.:206:&SESSION.::NO:206:P206_IDFECHAMENTO:'+vfechamento  ,'DEPOSITOS','toolbar=no,location=no,status=no,menubar=yes,scrollbars=no,resizable=no,width=550,height=700,left=400,top=400','_blank'); void(0);  		
               
            }
            
            function vendadireta()
            {
              vfechamento = document.getElementById('P92_IDFECHAMENTO').value
              
              window.open('f?p=&APP_ID.:512:&SESSION.::NO:512:P512_IDFECHAMENTO:'+vfechamento  ,'Venda Direta','toolbar=no,location=no,status=no,menubar=yes,scrollbars=no,resizable=no,width=550,height=700,left=400,top=400','_blank'); void(0);  		
               
            }
            
            function vendadiretaromance() 
            {
              vurl = document.getElementById("P92_SESSION_VENDADIRETA").value;
              pjan = window.open(vurl,'popup','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=800,height=600,screenX=50,screenY =100');
              pjan.focus();
            }
            
            function resgates() 
            {
              vurl = document.getElementById("P92_SESSION_RESGATES").value;
              pjan = window.open(vurl,'popup','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=800,height=600,screenX=50,screenY =100');
              pjan.focus();
            }
            ```
    }
    security {
        authorizationScheme: @acesso-fechamentos
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
