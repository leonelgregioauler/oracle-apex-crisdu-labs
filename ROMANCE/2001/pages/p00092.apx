    pageItem P92_SESSION_RESGATES (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 820
            region: @fechamento
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2001;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':534:'||l_session||'::NO::P534_IDFECHAMENTO:'||:P92_IDFECHAMENTO,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

