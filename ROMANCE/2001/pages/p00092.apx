        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select  
                replace(TO_CHAR(
                 to_number(nvl(:P92_SUBTOTAL01,0),'999G999G999G999G999G990D00') --entradas
                - to_number(nvl(:P92_SUBTOTAL02,0),'999G999G999G999G999G990D00')  --despesas
                - to_number(nvl(:P92_SUBTOTAL03,0),'999G999G999G999G999G990D00') -- favorita,'999G999G999G990D00') -- favorita
                - to_number(nvl(:P92_TOTALSAIDASDIVERSAS,0),'999G999G999G999G999G990D00')
                - to_number(nvl(:P92_TOTALEMPRESTIMOS,0),'999G999G999G999G999G990D00')   
                + to_number(nvl(:P92_TOTALVENDADIRETAFAVORITA,0),'999G999G999G999G999G990D00')       
                ,'999G999G999G999G999G990D00'),' ','') depositosefavorita
                FROM DUAL
