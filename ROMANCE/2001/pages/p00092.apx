    pageItem P92_TOTALCOBRANCA_TERCEIRIZADA (
        type: numberField
        label {
            label: Cobrança Terceirizada (Já somada na Cobrança)
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 120
            region: @fechamento
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 15
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare  
                  --
                  vvalor varchar2(30);
                  --
                begin
                  --
                  select trim(to_char(sum(p.valorpago),'999G999G999G999G990D00')) valor
                  into vvalor
                  from pagamentosnotasvendas p
                  where origem = 'T' -- cobranca terceirizada
                    and semanacobranca = :P92_SEMANA
                    and exists ( select 1
                                 from notasvendas n
                                 where n.idnotavenda = p.idnotavenda
                                   and n.idfilial    = :P0_IDFILIAL );
                  --
                  return vvalor;
                  --
                exception
                  when others then
                    return 0;
                end;
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0,00
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from vw_filiais f
                where f.idfilial = :P0_IDFILIAL
                  and f.idgrupo  = 5
                ```
        }
        readOnly {
            type: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

