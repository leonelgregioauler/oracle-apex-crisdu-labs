        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vvalor number(15,2);
                  --
                begin
                  --
                  select sum(f.valordeposito)
                  into vvalor
                  from depositosdiarios_orig f
                     , representantes r
                     , gerentes g
                     , filiais f
                  where f.idrepresentante = r.idrepresentante
                    and r.idgerente   = g.idgerente
                    and g.idfilial  = f.idfilial
                    and g.idfilial   = :P69_IDFILIAL
                    and f.fechamento = :P69_SEMANA
                    and f.tipo = 'CC';
                  --
                  return to_char(NVL(vvalor,0),'999G999G999G990D00') ;
                  --
                end;
                ```
