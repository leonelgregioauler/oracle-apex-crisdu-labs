        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color=blue><h3>Fechamento anterior finalizado com R$ '||trim(to_char(f.valorsaldoanteriorcongelado,'999G999G999G999G999G999G990D00'))||' no dia '||to_date(f.datasaldoanteriorcongelado,'DD/MM/RRRR HH24:MI:SS')||'</font></h3>' display
                from fechamentossemanais f
                where f.idsemana = ( select ff.idsemana
                                     from fechamentossemanais ff
                                     where ff.idfechamento = :P92_IDFECHAMENTO) -1
                  and f.valorsaldoanteriorcongelado is not null
                  and f.idfilial = :P0_IDFILIAL
                ```
            used: always
