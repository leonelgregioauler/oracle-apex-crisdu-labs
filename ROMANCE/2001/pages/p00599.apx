            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P599_TIPO_DATA (
        type: radioGroup
        label {
            label: Pesquisar Por
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Vencimento;V,Pagamento;P,Negociação;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
