    pageItem P599_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and ( :P599_IDPAIS is null or f.ididioma = :P599_IDPAIS)
                ```
        }
        cascadingLov {
            parentItems: P599_IDPAIS
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P599_IDPAIS (
        type: radioGroup
        label {
            label: País
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Brasil;1,Paraguai;4,Uruguay;2,Chile;6,Portugal ;11
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P599_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||decode(r.ativo,'S','Ativo','N','Inativo') d
                     , r.idrepresentante r
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente
                  and ( :P599_IDFILIAL is null or g.idfilial = :P599_IDFILIAL )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P599_IDFILIAL
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P599_IDRESPONSAVEL (
        type: selectList
        label {
            label: Resp. Cobrança
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomepessoa) d
                     , u.idusuario r
                from pessoas p
                   , usuarios u
                where p.idpessoa = u.idpessoa
                  and u.idgerente = 80
                  and u.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        serverSideCondition {
            type: item=value
            item: P599_VISUALIZAR_TODOS
            value: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P599_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' CPF: '||p.cpf d
                     , v.idvendedora r
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and ( :P599_IDREPRESENTANTE is null or v.idrepresentante = :P599_IDREPRESENTANTE )
                  and ( :P599_IDFILIAL is null or v.idfilial = :P599_IDFILIAL )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: [
                P599_IDREPRESENTANTE
                P599_IDFILIAL
            ]
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

