    region parcelas-2 (
        name: Parcelas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pb.idnegociacaoparceiro
                     , pb.filial
                     , pb.representante
                     , pb.vendedora
                     , pb.datanegociacao
                     , pb.formapgto
                     , pb.numeroparcela
                     , pb.valorparcela
                     , round(pb.valorparcela*pb.fatorconversao,2) Parcela2
                     , pb.datavencimento
                     , decode(pb.situacao,'A','Aberto','E','Em Espera','V','Vencido','Q','Quitado') situacao
                     , trunc(pb.datapagamento) datapagamento
                     , pb.cpf
                     , case
                         when exists ( select 1
                                       from documentosnegociacao d
                                       where d.idnegociacaoparceiro = pb.idnegociacaoparceiro
                                         and d.idnotavenda is not null ) then
                           nvl(( select 'Sim'
                                 from dual
                                 where exists ( select 1
                                                from assinaturaseletronicas a
                                                   , documentosnegociacao d
                                                where pb.idnegociacaoparceiro = d.idnegociacaoparceiro
                                                  and d.idnotavenda = a.idnotavenda
                                                  and a.status = 'C' )),'Não')
                         else
                           'Não'
                         end assinatura
                      , pb.origem_negociacao
                from vw_parcelas_acordos_bee pb
                where ( :P599_TIPO_DATA is null
                     or ( :P599_TIPO_DATA = 'V' and pb.datavencimento between to_date(:P599_DATAINICIO,'DD/MM/RRRR') and to_date(:P599_DATAFIM,'DD/MM/RRRR') )
                     or ( :P599_TIPO_DATA = 'P' and trunc(pb.datapagamento) between to_date(:P599_DATAINICIO,'DD/MM/RRRR') and to_date(:P599_DATAFIM,'DD/MM/RRRR') )
                     or ( :P599_TIPO_DATA = 'N' and trunc(pb.datanegociacao) between to_date(:P599_DATAINICIO,'DD/MM/RRRR') and to_date(:P599_DATAFIM,'DD/MM/RRRR') ) )
                  and ( :P599_SITUACAO = 'T' and pb.situacao != 'C' 
                         or pb.situacao = :P599_SITUACAO )
                  and ( :P599_FORMAPGTO = 'X' or pb.idformapagamento = :P599_FORMAPGTO )
                  and ( :P599_IDPAIS is null or pb.idpais = :P599_IDPAIS)
                  and ( :P599_IDFILIAL is null or pb.idfilial = :P599_IDFILIAL )
                  and ( :P599_IDREPRESENTANTE is null or pb.idrepresentante = :P599_IDREPRESENTANTE )
                  and ( :P599_IDVENDEDORA is null or pb.idvendedora = :P599_IDVENDEDORA )
                  and ( :P599_IDRESPONSAVEL is null or pb.idusuarioresponsavel = :P599_IDRESPONSAVEL )
                  and exists ( select 1
                               from usuarios u
                               where u.usuario = v('APP_USER') 
                                 and u.idusuario = pb.idusuarioresponsavel )
                  and ( :P599_ORIGEM_NEGOCIACAO = 'A' and pb.origem_negociacao = pb.origem_negociacao
                    or (:P599_ORIGEM_NEGOCIACAO = 'C' and pb.origem_negociacao = 'Consultora')
                    or (:P599_ORIGEM_NEGOCIACAO = 'D' and pb.origem_negociacao = 'Distribuidor'))
                ```
