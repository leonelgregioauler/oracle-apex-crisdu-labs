    pageItem P599_VISUALIZAR_TODOS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @parcelas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process verifica-visualizar-todos (
        name: Verifica Visualizar Todos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vacesso varchar2(1);
                begin
                  --
                  vacesso := pck_util.fnc_verificaacesso(2577,v('APP_USER'));
                  --
                  :P599_VISUALIZAR_TODOS := vacesso;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5040234036424423840
        }
    )

    branch (
        name: Go To Page 599
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 599
                items: {
                    P599_TIPO_DATA: &P599_TIPO_DATA.
                    P599_SITUACAO: &P599_SITUACAO.
                    P599_FORMAPGTO: &P599_FORMAPGTO.
                    P599_IDFILIAL: &P599_IDFILIAL.
                    P599_IDREPRESENTANTE: &P599_IDREPRESENTANTE.
                    P599_IDVENDEDORA: &P599_IDVENDEDORA.
                    P599_IDRESPONSAVEL: &P599_IDRESPONSAVEL.
                    P599_DATAINICIO: &P599_DATAINICIO.
                    P599_DATAFIM: &P599_DATAFIM.
                    P599_IDPAIS: &P599_IDPAIS.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

