page 218 (
    name: Protocolo de Cancelamento/Prorrogação
    title: Protocolo de Cancelamento/Prorrogação
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region protocolo-de-cancelamento (
        name: Protocolo de Cancelamento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDPROTOCOLO, 
                USUARIO,
                DATA,
                NUMEROPEDIDO,
                JUSTIFICATIVA,
                decode(SITUACAO,'P','Pendente','C','Concluido','R','Rejeitado') SITUACAO,
                DATAATENDIMENTO,
                OBSERVACAOFAVORITA,
                ( select descricao 
                  from catal.motivoscancelamentos m
                  where m.idmotivo = v.IDMOTIVOCANCELAMENTO ) motivo
                     , CPF
                     , ( select initcap(nomepessoa)
                         from pessoas p
                         where cpf = v.cpf ) Consultora
                     , decode(v.tipo,'C','Cancelamento','P','Prorrogação') Tipo
                ,( select pck_romance.fnc_nomerepresentante(IDREPRESENTANTE)
                  from vendedoras
                  where idpessoa = ( select idpessoa
                                     from pessoas 
                                     where cpf = v.cpf ) ) "Representante"
                from VW_PROTOCOLOSCANCELAMENTOS v
                where idfilial = :P0_IDFILIAL
                  and :P218_IDREPRESENTANTE is null or exists ( select idrepresentante
                                                         from vendedoras 
                                                        where idpessoa = ( select idpessoa
                                                                            from pessoas 
                                                                            where cpf = v.cpf )
                                                          and idrepresentante = :P218_IDREPRESENTANTE )  
                ```
            pageItemsToSubmit: P218_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 219
                items: {
                    P219_IDPROTOCOLO: #IDPROTOCOLO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: -
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
