page 457 (
    name: Indicações Pendentes do Distribuidor
    title: Indicações Pendentes do Distribuidor
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region indicações-pendentes (
        name: Indicações Pendentes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select it.idcontrolecontatossite
                     , it.nomecompleto
                     , it.cpf
                     , it.datanascimento
                     , it.datacadastro
                     , it.datapassadorepres
                     , it.rua||' - '||it.nr endereco
                     , it.bairro
                     , it.cidade
                     , it.fone
                     , it.descricaosituacao situacao
                from vw_indicacoes_tablet it
                where it.idrepresentante = :P457_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1519811557693093149
        }

        column BAIRRO (
            type: plainText
            heading {
                heading: Bairro
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column CIDADE (
            type: plainText
            heading {
                heading: Cidade
                alignment: center
            }
