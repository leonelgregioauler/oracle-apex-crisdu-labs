                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column CPF (
            type: plainText
            heading {
                heading: Cpf
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column DATACADASTRO (
