    pageItem P577_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' ('||decode(ativo,'S','Ativo','N','Inativo')||')' display_value
                     , idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from vw_filiais f
                                      where f.idfilial = :P0_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
        }
        security {
            encryptSessionState: false
        }
