            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction mostra-datas (
        name: Mostra Datas
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P577_ENVIADO_COBRANCA_TER
        }
        clientSideCondition {
            type: item=value
            item: P577_ENVIADO_COBRANCA_TER
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P577_DATAINICIO
                    P577_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P577_DATAINICIO
                    P577_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    process envia-notas-para-terceirizada (
        name: Envia notas para Terceirizada
        type: executeCode
        editableRegion: @notas-para-enviar
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidclassificacaonotavenda  number := null;
                  vidnotavenda               number := :IDNOTAVENDA;
                  vidcaracteristicanotavenda number := 41;
                  vdataclassificado          date := sysdate;    
                  vidusuario                 number := :P0_IDUSUARIO;
                  vidvalorcaracteristica     number;
                  vobservacao                varchar2(1000);
                  --       
                begin
                  --
                  update notasvendas n
                  set n.enviocobrancaterceirizada = 'S'
                    , n.dataenviocobrancaterc = sysdate
                  where n.idnotavenda = :IDNOTAVENDA;
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas( pidclassificacaonotavenda  => vidclassificacaonotavenda,
                                                                   pidnotavenda               => vidnotavenda,
                                                                   pidcaracteristicanotavenda => vidcaracteristicanotavenda,
                                                                   pdataclassificado          => vdataclassificado,
                                                                   pidusuario                 => vidusuario,
                                                                   pidvalorcaracteristica     => vidvalorcaracteristica,
                                                                   pobservacao                => vobservacao,
                                                                   poperacao_dml              => 'I');
                  --
                  insert into correcoesnotasvendas ( idcorrecaonotavenda,
                                                     datacorrecao,
                                                     usuario,
                                                     motivo,
                                                     idnotavenda,
                                                     situacao )
                  values ( seq_idcorrecaonotavenda.nextval
                         , sysdate
                         , v('APP_USER')
                         , 'Nota enviada ao CARSA para reaizar a cobrança do débito.'
                         , :IDNOTAVENDA
                         , 'C' );
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Notas enviadas com sucesso!
        }
        advanced {
            executionMappingIdentifier: 57386745670370805
        }
        serverSideCondition {
            whenButtonPressed: @enviar-notas
        }
    )

    branch (
        name: Go To Page 577
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 577
                items: {
                    P577_IDREPRESENTANTE: &P577_IDREPRESENTANTE.
                    P577_ENVIADO_COBRANCA_TER: &P577_ENVIADO_COBRANCA_TER.
                    P577_DATAINICIO: &P577_DATAINICIO.
                    P577_DATAFIM: &P577_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar-notas
        }
    )

)

