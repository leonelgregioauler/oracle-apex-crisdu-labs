    region notas-enviadas (
        name: Notas Enviadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(nv.idvendedora) vendedora
                     , nv.numeronota
                     , nv.semanadistribuicao distribuicao
                     , nv.semanacobranca cobranca
                     , nv.dataacerto 
                     , nv.valortotalnota
                     , nv.valortotalvenda
                     , nv.valorpago
                     , nv.saldo
                     , cn.dataclassificado
                     , favorita.pck_util_fav.fnc_nomeusuario(cn.idusuario) usuario
                from notasvendas nv
                   , classificacoesnotasvendas cn
                where ( :P577_IDREPRESENTANTE is null or nv.idrepresentante = :P577_IDREPRESENTANTE )
                  and ( :P577_DATAINICIO is null
                     or ( cn.dataclassificado between to_date(:P577_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P577_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) )
                  and cn.idnotavenda = nv.idnotavenda
                  and cn.idcaracteristicanotavenda = 41
                  and nv.idfilial        = :P0_IDFILIAL
                  and nv.saldo           > 0
                  and nv.enviadocobranca = 'S'
                order by 2, 1
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P577_ENVIADO_COBRANCA_TER
            value: S
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 57387454447370812
        }

