page 720 (
    name: Tombamento de Notas
    title: Tombamento de Notas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region lista-de-notas-tombadas (
        name: Lista de Notas Tombadas
        title: Lista de Notas Não Cobradas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , nv.idnotavenda id_nota
                     , nv.numeronota
                     , pck_romance.fnc_nomefilial(nv.idfilial) franquia
                     , pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor
                     , initcap(p.nomepessoa) consultora
                     , nvl(p.cpf, p.documentoestrangeiro) documento
                     , nv.datanota
                     , cn.dataclassificado datatombamento
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.valortotalnota
                     , nv.valortotaldevolucao
                     , nv.valortotalvendalqd
                     , nv.valorpago
                     , nv.saldo
                from notasvendas nv
                   , vendedoras v
                   , pessoas p
                   , classificacoesnotasvendas cn
                where cn.idnotavenda               = nv.idnotavenda
                  and cn.idcaracteristicanotavenda = 66
                  and v.idvendedora                = nv.idvendedora
                  and p.idpessoa                   = v.idpessoa
                  and ( :P720_DATAINICIO is null or cn.dataclassificado          between to_date(:P720_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P720_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS'))
                  and ( :P720_IDFILIAL is null or nv.idfilial = :P720_IDFILIAL )
                  and ( :P720_IDREPRESENTANTE is null or nv.idrepresentante = :P720_IDREPRESENTANTE )
                  and ( :P720_DESTINO = 'T'
                      or ( :P720_DESTINO = 'C' and nv.enviadocobranca = 'S' )
                      or ( :P720_DESTINO = 'P' and exists ( select 1
                                                            from classificacoesnotasvendas cc
                                                            where cc.idcaracteristicanotavenda = 50
                                                              and cc.idnotavenda = nv.idnotavenda ) ) )
                  and ( :P720_IDVENDEDORA is null or v.idvendedora = :P720_IDVENDEDORA )
                  and ( :P720_SITUACAOVEND is null or v.ativo = :P720_SITUACAOVEND)
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, utilize os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 2118950422970156315
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

