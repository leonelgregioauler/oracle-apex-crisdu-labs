    pageItem P720_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P720_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P720_DESTINO (
        type: radioGroup
        label {
            label: Destino
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:PAP;P,Cobrança;C,Todos;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P720_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P720_IDFILIAL (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P720_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' ('||decode(r.ativo,'S','Ativo','N','Inativo')||')' distribuidor
                     , r.idrepresentante
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P720_IDFILIAL )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P720_IDFILIAL
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P720_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            initialFetch: onUserRequest
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) || ' - Doc: ' || nvl(p.cpf, p.documentoestrangeiro) as documento,
                       v.idvendedora idvendedora
                  from catal.vendedoras v,
                       catal.pessoas p
                 where p.idpessoa = v.idpessoa
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            language: sql
            sqlExpression: null
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P720_SITUACAOVEND (
        type: selectList
        label {
            label: Situação Consultora
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Ativa;S,Inativa;N
            nullDisplayValue: Ambos
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 720
                items: {
                    P720_DATAINICIO: &P720_DATAINICIO.
                    P720_DATAFIM: &P720_DATAFIM.
                    P720_IDFILIAL: &P720_IDFILIAL.
                    P720_IDREPRESENTANTE: &P720_IDREPRESENTANTE.
                    P720_DESTINO: &P720_DESTINO.
                    P720_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

