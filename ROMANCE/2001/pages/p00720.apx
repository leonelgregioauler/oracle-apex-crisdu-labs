        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Lista de Notas Não Cobradas
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 21199749 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONSULTORA (
                sequence: 5
            )

            displayColumn DATANOTA (
                sequence: 7
            )

            displayColumn DATATOMBAMENTO (
                sequence: 8
