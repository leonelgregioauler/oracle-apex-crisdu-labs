                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios u
                where u.usuario = v('APP_USER')
                  and u.idgerente in ( 280, 143 )
                
                union -- para o time da T.I
                select 1
                  from roman.usuariosgruposatendimento u
                 where u.idgrupoatendimento = 0
                   and u.usuario = v('APP_USER')
                ```
