    pageItem P764_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and exists ( select 1
                               from usuariosfiliais u
                               where u.idfilial  = f.idfilial
                                 and u.usuario   = v('APP_USER') )
                union
                Select f.nome
                     , f.idfilial
                from vw_filiais f
                where idfilial = pck_romance.fnc_filialusuario(v('APP_USER'))
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
