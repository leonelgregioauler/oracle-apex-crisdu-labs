    region geral-performance (
        name: Geral Performance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select franquia
                     , pontos_realizados
                     , pontos_extras
                     , pontos_possiveis
                     , pontos_totais
                     , aproveitamento
                     , categoria
                     , ROMAN.PCK_CAMPANHAS.fnc_pontos_prox_categoria(pontos_totais, pontos_possiveis, categoria) pontos_prox_cat
                  from(
                select pck_romance.fnc_nomefilial(t.idfilial) franquia
                     , sum(t.pontos_realizados) pontos_realizados
                     , sum(t.pontos_extras) pontos_extras
                     , sum(pontos_realizados+pontos_extras) pontos_totais
                     , sum(t.pontos_possiveis) pontos_possiveis
                     , round( ( sum(pontos_realizados+pontos_extras) / sum(pontos_possiveis) ) * 100,2 ) aproveitamento
                     , pck_campanhas.fnc_retornacategoria_calendario(t.idfilial
                                                                    ,sum(t.pontos_realizados + t.pontos_extras)
                                                                    ,sum(pontos_possiveis)
                                                                    ,:P764_TIPO_PESQUISA 
                                                                    ,:P764_IDSEMANA
                                                                    ,:P764_IDCAMPANHA
                                                                    ,:P764_IDSEMANA_INI
                                                                    ,:P764_IDSEMANA_FIM) categoria
                from ( select pc.idfilial 
                            , sum(pc.pontos) pontos_realizados
                            , ( select cc.pontuacaopossivel
                                from calendariomotivoulevou cc
                                where cc.idsemana = pc.idsemana
                                  and cc.idpais = f.ididioma ) pontos_possiveis
                            , sum(pc.pontuacaoextra) pontos_extras
                       from pontuacoescampanhas pc
                          , filiais f
                       where pc.idcampanha = :P764_IDCAMPANHA_PRINCIPAL
                         and f.idfilial = pc.idfilial
                         and ( :P764_TIPO_PESQUISA is null 
                            or ( :P764_TIPO_PESQUISA = 'S' and pc.idsemana = :P764_IDSEMANA )
                            or ( :P764_TIPO_PESQUISA = 'P' and pc.idsemana between :P764_IDSEMANA_INI and :P764_IDSEMANA_FIM )
                            or ( :P764_TIPO_PESQUISA = 'C' and pc.idcampanha = :P764_IDCAMPANHA ) )
                         and ( :P764_PESQUISAR_POR is null
                            or ( :P764_PESQUISAR_POR = 'F' and ( pc.idfilial = :P764_IDFILIAL or :P764_IDFILIAL is null ) )
                            or ( :P764_PESQUISAR_POR = 'R' and exists ( select 1
                                                                        from vw_filiais f
                                                                        where f.idfilial = pc.idfilial
                                                                          and f.regional = :P764_REGIONAL ) )
                            or ( :P764_PESQUISAR_POR = 'N' and exists ( select 1
                                                                        from vw_filiais f
                                                                        where f.idfilial = pc.idfilial
                                                                          and f.idgrupo = :P764_GRUPO ) ) )
                         and exists ( select 1
                                      from usuariosfiliais uf
                                      where uf.idfilial = pc.idfilial
                                        and uf.usuario  = v('APP_USER') )
                       group by pc.idfilial, idsemana, f.ididioma ) t
                group by idfilial
                  );
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P764_TIPO_RELATORIO
            value: F
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 373650346125372103
        }

