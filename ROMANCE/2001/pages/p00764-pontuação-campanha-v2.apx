    region indicadores-2 (
        name: Indicadores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*select w.distribuidor
                     , w.metrica indicador
                     , w.idmetricacampanha
                     , w.idrepresentante
                     , median(w.valor) media
                from vw_pontuacao_representantes_v2 w
                where ( :P764_IDMETRICACAMPANHA is null or w.idmetricacampanha = :P764_IDMETRICACAMPANHA )
                  --and ( :P764_IDCATEGORIA is null or pck_campanhas.fnc_retornacategoria(w.pontos,w.pontos_possiveis) = :P764_IDCATEGORIA )
                  and ( :P764_IDREPRESENTANTE is null or w.idrepresentante = :P764_IDREPRESENTANTE )
                  and ( :P764_TIPO_PESQUISA is null 
                     or ( :P764_TIPO_PESQUISA = 'S' and w.idsemana = :P764_IDSEMANA )
                     or ( :P764_TIPO_PESQUISA = 'P' and w.idsemana between :P764_IDSEMANA_INI and :P764_IDSEMANA_FIM )
                     or ( :P764_TIPO_PESQUISA = 'C' and w.idcampanha = :P764_IDCAMPANHA ) )
                  and ( :P764_PESQUISAR_POR is null
                     or ( :P764_PESQUISAR_POR = 'F' and w.idfilial = :P764_IDFILIAL )
                     or ( :P764_PESQUISAR_POR = 'R' and exists ( select 1
                                                                 from vw_filiais f
                                                                 where f.idfilial = w.idfilial
                                                                   and f.regional = :P764_REGIONAL ) )
                     or ( :P764_PESQUISAR_POR = 'N' and exists ( select 1
                                                                 from vw_filiais f
                                                                 where f.idfilial = w.idfilial
                                                                   and f.idgrupo = :P764_GRUPO ) ) )
                group by w.distribuidor
                       , w.metrica
                       , w.idmetricacampanha
                       , w.idrepresentante*/
                select distribuidor
                     , indicador
                     , idmetricacampanha
                     , idrepresentante
                     , media
                     , pck_campanhas.fnc_retornacategoriapormedia(idmetricacampanha,idfilial,media) categoria
                from ( 
                      select w.distribuidor
                           , w.idfilial
                           , w.metrica indicador
                           , w.idmetricacampanha
                           , w.idrepresentante
                           --, round((sum(w.valor)/ count(idsemana))) media 
                           , (sum(w.valor)/ count(idsemana)) media 
                           , sum(w.pontos) pontos_realizados
                           , ( select vc.pontos
                                from valoresmetricascampanhas vc
                                where vc.idfilial = w.idfilial
                                  and vc.idmetricacampanha = w.idmetricacampanha
                                  and vc.idcampanha = :P764_IDCAMPANHA_PRINCIPAL
                                  and vc.nivel = '5' ) pontos_possiveis
                           , count(w.idsemana) qtd_semanas
                      from vw_pontuacao_representantes_v2 w
                      where w.idcampanha = :P764_IDCAMPANHA_PRINCIPAL
                        and ( :P764_IDMETRICACAMPANHA is null or w.idmetricacampanha = :P764_IDMETRICACAMPANHA )
                        --and ( :P764_IDCATEGORIA is null or pck_campanhas.fnc_retornacategoria(w.pontos,w.pontos_possiveis) = :P764_IDCATEGORIA )
                        and ( :P764_IDREPRESENTANTE is null or w.idrepresentante = :P764_IDREPRESENTANTE )
                        and ( :P764_TIPO_PESQUISA is null 
                           or ( :P764_TIPO_PESQUISA = 'S' and w.idsemana = :P764_IDSEMANA )
                           or ( :P764_TIPO_PESQUISA = 'P' and w.idsemana between :P764_IDSEMANA_INI and :P764_IDSEMANA_FIM )
                           or ( :P764_TIPO_PESQUISA = 'C' and w.idcampanha = :P764_IDCAMPANHA ) )
                        and ( :P764_PESQUISAR_POR is null
                           or ( :P764_PESQUISAR_POR = 'F' and w.idfilial = :P764_IDFILIAL )
                           or ( :P764_PESQUISAR_POR = 'R' and exists ( select 1
                                                                       from vw_filiais f
