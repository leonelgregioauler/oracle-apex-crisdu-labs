    dynamicAction new (
        name: New
        execution {
            sequence: 70
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.jQuery("span[data-style]").each(
                      function()
                      { 
                        apex.jQuery(this).parent().attr('style', apex.jQuery(this).attr('data-style')); 
                      }
                    );
                    ```
            }
            affectedElements {
                selectionType: eventSource
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction recebe-valor (
        name: Recebe Valor
        execution {
            sequence: 150
        }
        when {
            selectionType: items
            items: P764_IDCAMPANHA_PRINCIPAL
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                      vano number;
                    begin
                      --
                      if :P764_IDCAMPANHA_PRINCIPAL = 15 then
                        vano := 2025;
                      elsif :P764_IDCAMPANHA_PRINCIPAL = 16 then
                        vano := 2026;
                      end if;
                      --
                      return vano;
                      --
                    end;
                    ```
                itemsToSubmit: P764_ANO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P764_ANO
            }
            execution {
                sequence: 10
            }
        )

    )

