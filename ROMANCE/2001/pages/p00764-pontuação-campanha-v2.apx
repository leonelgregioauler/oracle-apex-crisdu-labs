    pageItem P764_IDCAMPANHA_PRINCIPAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 130
            region: @filtros
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vidcampanha number;
                  --
                begin
                  --
                  if :P764_TIPO_PESQUISA = 'S' then
                    --
                    select c.idcampanha
                    into vidcampanha
                    from campanhas c
                    where c.tipocampanha = 'M'
                      and :P764_IDSEMANA between c.idsemanaini and c.idsemanafim; 
                    --
                  elsif :P764_TIPO_PESQUISA = 'C' then
                    --
                    vidcampanha := :P764_IDCAMPANHA;
                    --
                  end if;
                  --
                  return vidcampanha;
                  --
                exception
                when others then
                  return 16;
                end;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vidcampanha number;
                  --
                begin
                  --
                  if :P764_TIPO_PESQUISA = 'S' then
                    --
                    select c.idcampanha
                    into vidcampanha
                    from campanhas c
                    where c.tipocampanha = 'M'
                      and :P764_IDSEMANA between c.idsemanaini and c.idsemanafim; 
                    --
                  elsif :P764_TIPO_PESQUISA = 'C' then
                    --
                    vidcampanha := :P764_IDCAMPANHA;
                    --
                  end if;
                  --
                  return vidcampanha;
                  --
                exception
                when others then
                return 16;
                end;
                ```
        }
    )

