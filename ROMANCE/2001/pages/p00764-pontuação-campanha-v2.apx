    process gera-a-pontuação-da-semana-regional (
        name: Gera a Pontuação da Semana Regional
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vusuario varchar2(100) := v('APP_USER');
                begin
                  --
                  if :P764_IDREGIONAL_PONTUACAO = 6 then
                    --
                    pck_campanhas.prc_gerapontuacaosemana_comercial(pidsemana => :P764_IDSEMANA_PONTUACAO_REG,
                                                                    pusuario => vusuario);
                    --
