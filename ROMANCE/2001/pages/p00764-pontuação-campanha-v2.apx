    pageItem P764_IDREPRESENTANTE (
        type: selectOne
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) distribuidor
                     , r.idrepresentante
                from representantes r
                   , gerentes g
                where g.idgerente = r.idgerente
                  and r.ativo     = 'S'
                  and ( :P764_PESQUISAR_POR is null
                    or ( :P764_PESQUISAR_POR = 'F' and g.idfilial = :P764_IDFILIAL )
                    or ( :P764_PESQUISAR_POR = 'R' and exists ( select 1
                                                                from vw_filiais f
                                                                where f.idfilial = g.idfilial
                                                                  and f.regional = :P764_REGIONAL ) )
                    or ( :P764_PESQUISAR_POR = 'N' and exists ( select 1
                                                                from vw_filiais f
                                                                where f.idfilial = g.idfilial
                                                                  and f.idgrupo = :P764_GRUPO ) ) )
                order by 1
                ```
        }
        layout {
            sequence: 30
            region: @visualização-de-distribuidores
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
    )

