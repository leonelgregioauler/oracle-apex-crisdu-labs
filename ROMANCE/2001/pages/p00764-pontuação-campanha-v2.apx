    region performance-regionais (
        name: Performance Regionais
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case
                         when regional = 1 then
                           'Regional 1'
                         when regional = 2 then
                           'Regional 2' 
                         when regional = 3 then
                           'Regional 3'
                         when regional = 4 then
                           'Regional 4' 
                         when regional = 5 then
                           'Regional Eduardo'
                       end regional
                     , sum(t.pontos_realizados) pontos_realizados
                     , sum(t.pontos_extras) pontos_extras
                     , sum(pontos_realizados+pontos_extras) pontuacao_total
                     , sum(t.pontos_possiveis) pontos_possiveis
                     , round( ( sum(pontos_realizados+pontos_extras)  / sum(pontos_possiveis) ) * 100,2 ) aproveitamento
                     , pck_campanhas.fnc_retornacategoria(sum(pontos_realizados+pontos_extras) ,sum(pontos_possiveis)) categoria
                from ( select f.regional
                            , sum(pc.pontos) pontos_realizados
                            , sum(pc.pontuacaoextra) pontos_extras
                            , ( select cc.pontuacaopossivel
                                from calendariomotivoulevou cc
                                where cc.idsemana = pc.idsemana
                                  and cc.idpais = 1 )* count(distinct f.idfilial) pontos_possiveis
                       from pontuacoescampanhas pc
                          , vw_filiais f
                       where pc.idcampanha = :P764_IDCAMPANHA_PRINCIPAL
                         and pc.idfilial = f.idfilial
                         and f.idgrupo < 5
                         and ( :P764_TIPO_PESQUISA is null 
                            or ( :P764_TIPO_PESQUISA = 'S' and pc.idsemana = :P764_IDSEMANA )
                            or ( :P764_TIPO_PESQUISA = 'P' and pc.idsemana between :P764_IDSEMANA_INI and :P764_IDSEMANA_FIM )
                            or ( :P764_TIPO_PESQUISA = 'C' and pc.idcampanha = :P764_IDCAMPANHA ) )
                         and ( :P764_PESQUISAR_POR is null
                            or ( :P764_PESQUISAR_POR = 'F' and ( pc.idfilial = :P764_IDFILIAL or :P764_IDFILIAL is null ) )
                            or ( :P764_PESQUISAR_POR = 'R' and exists ( select 1
                                                                        from vw_filiais f
                                                                        where f.idfilial = pc.idfilial
                                                                          and f.regional = :P764_REGIONAL ) )
                            or ( :P764_PESQUISAR_POR = 'N' and exists ( select 1
                                                                        from vw_filiais f
                                                                        where f.idfilial = pc.idfilial
                                                                          and f.idgrupo = :P764_GRUPO ) ) )
                       group by f.regional, idsemana ) t
                group by regional;
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
