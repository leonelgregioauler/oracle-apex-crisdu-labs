                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region evolução-no-programa (
        name: Evolução no Programa
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(t.idfilial) franquia
                     , pck_util.fnc_semanaid(t.idsemana) semana
                     , sum(t.pontos_realizados) pontos_realizados
                     , sum(t.pontos_extras) pontos_extras
                     , sum(pontos_realizados+pontos_extras) pontuacao_total
                     , sum(t.pontos_possiveis) pontos_possiveis
                     , round( ( sum(pontos_realizados+pontos_extras) / sum(pontos_possiveis) ) * 100,2 ) aproveitamento
                     , pck_campanhas.fnc_retornacategoria_calendario(t.idfilial
                                                                    ,sum(pontos_realizados+pontos_extras)
                                                                    ,sum(pontos_possiveis)
                                                                    ,:P764_TIPO_PESQUISA 
                                                                    ,:P764_IDSEMANA
                                                                    ,:P764_IDCAMPANHA
                                                                    ,:P764_IDSEMANA_INI
                                                                    ,:P764_IDSEMANA_FIM) categoria
                from ( select pc.idfilial                           
                            , pc.idsemana
                            , sum(pc.pontos) pontos_realizados
                            , sum(pc.pontuacaoextra) pontos_extras
                            , ( select cc.pontuacaopossivel
                                from calendariomotivoulevou cc
                                where cc.idsemana = pc.idsemana
                                  and cc.idpais = f.ididioma ) pontos_possiveis
                       from pontuacoescampanhas pc
                          , filiais f
                       where pc.idcampanha = nvl(:P764_IDCAMPANHA,16)
                         and f.idfilial = pc.idfilial
                         and pc.idcampanha = :P764_IDCAMPANHA 
                         and ( :P764_PESQUISAR_POR is null
                            or ( :P764_PESQUISAR_POR = 'F' and ( pc.idfilial = :P764_IDFILIAL or :P764_IDFILIAL is null ) )
                            or ( :P764_PESQUISAR_POR = 'R' and exists ( select 1
                                                                        from vw_filiais f
                                                                        where f.idfilial = pc.idfilial
                                                                          and f.regional = :P764_REGIONAL ) )
                            or ( :P764_PESQUISAR_POR = 'N' and exists ( select 1
                                                                        from vw_filiais f
                                                                        where f.idfilial = pc.idfilial
                                                                          and f.idgrupo = :P764_GRUPO ) ) )
                         and exists ( select 1
                                      from usuariosfiliais uf
                                      where uf.idfilial = pc.idfilial
                                        and uf.usuario  = v('APP_USER') )
                       group by pc.idfilial, idsemana, f.ididioma ) t
                group by idfilial, idsemana
                order by 1,2;
                ```
        }
        layout {
            sequence: 120
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P764_TIPO_PESQUISA = 'C' and :P764_TIPO_RELATORIO != 'R'
        }
        reportLayout {
