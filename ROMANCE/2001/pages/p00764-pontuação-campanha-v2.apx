    region evolução-do-indicador (
        name: Evolução do Indicador
        type: chart
        layout {
            sequence: 30
            parentRegion: @detalhado-por-indicador
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chart {
            type: line
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        legend {
            show: false
        }

        series evolução (
            name: Evolução
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select t.semana
                         , t.media
                    from ( select pck_util.fnc_semanaid(pc.idsemana) semana
                                , mc.descricao indicador
                                , pc.media
                                , pc.pontos pontos_realizados
                                , ( select vc.pontos
                                    from valoresmetricascampanhas vc
                                    where vc.idmetricacampanha = mc.idmetricacampanha
                                      and vc.idfilial          = pc.idfilial
                                      and vc.nivel             = 5
                                      and vc.idcampanha        = :P764_IDCAMPANHA /*15*/ ) pontos_possiveis
                           from pontuacoescampanhas pc
                              , metricascampanhas mc
                           where pc.idfilial = :P764_IDFILIAL_DET
                             and mc.idmetricacampanha = :P764_IDMETRICA
                             and mc.idmetricacampanha = pc.idmetricacampanha
                             and pc.idcampanha = :P764_IDCAMPANHA --15
                           order by pc.idsemana ) t
                             
                    ```
            }
            columnMapping {
                label: SEMANA
                value: MEDIA
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

