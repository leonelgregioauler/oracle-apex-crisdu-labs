    region evolução-dos-indicadores-gerais (
        name: Evolução dos Indicadores Gerais
        type: chart
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P764_EXIBIR = 'N' and :P764_TIPO_RELATORIO = 'F' and :P764_IDFILIAL is null
        }
        chart {
            type: line
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        legend {
            show: false
        }

        series evolução (
            name: Evolução
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select t.semana
                         , avg(media) pontos_realizados
                         , t.idsemana
                    from ( select pck_util.fnc_semanaid(pc.idsemana) semana
                                , pc.idsemana
                                , mc.descricao indicador
                                , pc.media
                                , pc.pontos pontos_realizados
                                , ( select vc.pontos
                                    from valoresmetricascampanhas vc
                                    where vc.idmetricacampanha = mc.idmetricacampanha
                                      and vc.idfilial          = pc.idfilial
                                      and vc.nivel             = 5
                                      and vc.idcampanha        = nvl(:P764_IDCAMPANHA,16) ) pontos_possiveis
                           from pontuacoescampanhas pc
                              , metricascampanhas mc
                           where ( :P764_IDMETRICA_INDICADORES is null or mc.idmetricacampanha = :P764_IDMETRICA_INDICADORES )
                             and mc.idmetricacampanha = pc.idmetricacampanha
                             and pc.idcampanha = nvl(:P764_IDCAMPANHA,16)
                             and exists ( select 1
                                          from usuariosfiliais uf
                                          where uf.idfilial = pc.idfilial
                                            and uf.usuario  = v('APP_USER') )
                           order by pc.idsemana ) t
                    group by semana, idsemana
                    order by idsemana
                    ```
                pageItemsToSubmit: P764_IDMETRICA_INDICADORES
            }
            columnMapping {
                label: SEMANA
                value: PONTOS_REALIZADOS
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

