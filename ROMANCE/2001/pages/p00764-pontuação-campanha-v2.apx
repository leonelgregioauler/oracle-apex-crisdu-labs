    region indicadores-regionais (
        name: Indicadores Regionais
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select r.nome
                         from regionaisfiliais r
                         where r.idregionalfilial = t.idregionalfilial ) regional
                     , t.indicador
                     , t.pontos_realizados
                     , t.pontos_extras
                     , t.pontos_realizados + t.pontos_extras pontos_totais
                     , t.pontos_possiveis*qtd_semanas pontos_possiveis 
                     --, round( ( pontos_realizados / (t.pontos_possiveis*qtd_semanas) ) * 100,2 ) 
                     , categoria aproveitamento
                     , t.idmetricacampanha
                     --, pck_campanhas.fnc_retornacategoria(pontos_realizados,pontos_possiveis) categoria
                     , t.categoria categoria
                     , idregionalfilial
                     , case
                         when t.categoria = '1 Estrela' then
                           'data-style="background-color:#ee0202"'
                         when t.categoria = '2 Estrelas' then
                           'data-style="background-color:#fe6416"'
                         when t.categoria = '3 Estrelas' then
                           'data-style="background-color:#fcdb55"'
                         when t.categoria = '4 Estrelas' then
                           'data-style="background-color:#18bd08"'
                         when t.categoria = '5 Estrelas' then
                           'data-style="background-color:#033dfb"'
                         when t.categoria = 'SUPERSTAR' then
                           'data-style="background-color:#eebe01"'
                       end css_color
                     , media
                from ( select pc.idregionalfilial 
                            , mc.idmetricacampanha
                            , mc.descricao indicador
                            , sum(pc.pontos) pontos_realizados
                            , sum(pc.pontuacaoextra) pontos_extras
                            , ( select vc.pontos
                                from valoresmetricascampanhas vc
                                where vc.idfilial = 1089
                                  and vc.idmetricacampanha = mc.idmetricacampanha
                                  and vc.idcampanha = nvl(:P764_IDCAMPANHA,16)
                                  and vc.nivel = '5' ) pontos_possiveis
                            , count(idsemana) qtd_semanas
                            , round((sum(pc.media)/ count(idsemana)),2) media
                            , pck_campanhas.fnc_retornacategoriapormedia( pidmetrica => mc.idmetricacampanha,
                                                                          pidfilial  => 1089,
                                                                          pmedia     => round((sum(pc.media)/ count(idsemana)),2)) categoria
                       from metricascampanhas mc
                          , pontuacoescampanhasregionais pc
                       where mc.idmetricacampanha = pc.idmetricacampanha
                         and pc.idcampanha = nvl(:P764_IDCAMPANHA,16)
                         and ( :P764_IDMETRICA_INDICADORES_REGIONAL is null or mc.idmetricacampanha = :P764_IDMETRICA_INDICADORES_REGIONAL )
                         and ( :P764_TIPO_PESQUISA is null 
                            or ( :P764_TIPO_PESQUISA = 'S' and pc.idsemana = :P764_IDSEMANA )
                            or ( :P764_TIPO_PESQUISA = 'P' and pc.idsemana between :P764_IDSEMANA_INI and :P764_IDSEMANA_FIM )
                            or ( :P764_TIPO_PESQUISA = 'C' and pc.idcampanha = :P764_IDCAMPANHA ) )
                         and ( :P764_REGIONAL_FILTRO = -1 or pc.idregionalfilial = :P764_REGIONAL_FILTRO )
                       /*  and ( :P764_PESQUISAR_POR is null
                            or ( :P764_PESQUISAR_POR = 'R' and pc.idregionalfilial = :P764_REGIONAL ) ) */
                       group by mc.descricao
                              , mc.ordem
                              , pc.idregionalfilial
                              , mc.idmetricacampanha
                       order by mc.ordem ) t
                ```
