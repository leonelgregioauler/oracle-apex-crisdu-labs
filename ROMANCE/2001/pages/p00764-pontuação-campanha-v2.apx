                   , campanhas c
                where c.tipocampanha = 'M'
                  and c.idcampanha = 16
                  and s.idsemana between pck_util.fnc_idsemana(c.semanaini) and pck_util.fnc_idsemana(c.semanafim) 
                order by 2
                ```
        }
        layout {
            sequence: 50
            region: @gerar-pontuação-da-empresa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

