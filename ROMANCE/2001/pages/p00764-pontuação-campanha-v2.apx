    region indicadores (
        name: Indicadores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(t.idfilial) franquia
                     , t.indicador
                     , t.pontos_realizados
                     , t.pontos_possiveis*qtd_semanas pontos_possiveis 
                     --, round( ( pontos_realizados / (t.pontos_possiveis*qtd_semanas) ) * 100,2 ) 
                     , categoria aproveitamento
                     , t.idmetricacampanha
                     --, pck_campanhas.fnc_retornacategoria(pontos_realizados,pontos_possiveis) categoria
                     , t.categoria categoria
                     , idfilial
                     , case
                         when t.categoria = '1 Estrela' then
                           'data-style="background-color:#ee0202"'
                         when t.categoria = '2 Estrelas' then
                           'data-style="background-color:#fe6416"'
                         when t.categoria = '3 Estrelas' then
                           'data-style="background-color:#fcdb55"'
                         when t.categoria = '4 Estrelas' then
                           'data-style="background-color:#18bd08"'
                         when t.categoria = '5 Estrelas' then
                           'data-style="background-color:#033dfb"'
                         when t.categoria = 'SUPERSTAR' then
                           'data-style="background-color:#eebe01"'
                         else 
                           'data-style="background-color: none;"'
                       end css_color
                     , media
                     , pontosextras
                     , pontosextras + pontos_realizados pontos_totais
                from ( select pc.idfilial 
                            , mc.idmetricacampanha
                            , mc.descricao indicador
                            , sum(pc.pontos) pontos_realizados
                            , ( select vc.pontos
                                from valoresmetricascampanhas vc
                                where vc.idfilial = pc.idfilial
                                  and vc.idmetricacampanha = mc.idmetricacampanha
                                  and vc.idcampanha = :P764_IDCAMPANHA_PRINCIPAL
                                  and vc.nivel = '5' ) pontos_possiveis
                            , count(idsemana) qtd_semanas
                            , round((sum(pc.media)/ count(idsemana)),2) media
                            , pck_campanhas.fnc_retornacategoriapormedia( pidmetrica => mc.idmetricacampanha,
                                                                          pidfilial  => pc.idfilial,
                                                                          pmedia     => round((sum(pc.media)/ count(idsemana)),2),
                                                                          pidcampanha => :P764_IDCAMPANHA_PRINCIPAL ) categoria
                            , sum(pc.pontuacaoextra) pontosextras
                       from metricascampanhas mc
                          , pontuacoescampanhas pc
                       where mc.idmetricacampanha = pc.idmetricacampanha
                         and pc.idcampanha = :P764_IDCAMPANHA_PRINCIPAL
                         and ( :P764_IDMETRICA_INDICADORES is null or mc.idmetricacampanha = :P764_IDMETRICA_INDICADORES )
                         and ( :P764_TIPO_PESQUISA is null 
                            or ( :P764_TIPO_PESQUISA = 'S' and pc.idsemana = :P764_IDSEMANA )
                            or ( :P764_TIPO_PESQUISA = 'P' and pc.idsemana between :P764_IDSEMANA_INI and :P764_IDSEMANA_FIM )
                            or ( :P764_TIPO_PESQUISA = 'C' and pc.idcampanha = :P764_IDCAMPANHA ) )
                         and ( :P764_PESQUISAR_POR is null
                            or ( :P764_PESQUISAR_POR = 'F' and ( pc.idfilial = :P764_IDFILIAL or :P764_IDFILIAL is null ) )
                            or ( :P764_PESQUISAR_POR = 'R' and exists ( select 1
                                                                        from vw_filiais f
                                                                        where f.idfilial = pc.idfilial
                                                                          and f.regional = :P764_REGIONAL ) )
                            or ( :P764_PESQUISAR_POR = 'N' and exists ( select 1
                                                                        from vw_filiais f
                                                                        where f.idfilial = pc.idfilial
                                                                          and f.idgrupo = :P764_GRUPO ) ) )
                         and exists ( select 1
                                      from usuariosfiliais uf
                                      where uf.idfilial = pc.idfilial
                                        and uf.usuario  = v('APP_USER') )
                       group by mc.descricao
                              , mc.ordem
                              , pc.idfilial
                              , mc.idmetricacampanha
                       order by mc.ordem ) t
                ```
            pageItemsToSubmit: P764_IDMETRICA_INDICADORES
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: IND
        }
        headerAndFooter {
            headerText: <h3>Clique no indicador para visualizar detalhado!</h3>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P764_TIPO_RELATORIO in ('F')
                ```
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 52600709213184341
        }

