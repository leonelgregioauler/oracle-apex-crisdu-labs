    region métrica-detalhada-2 (
        name: Métrica Detalhada
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.semana
                     , t.indicador
                     , t.nivel
                     , t.media
                     , t.pontos_realizados
                     , t.pontos_possiveis
                     , round( ( pontos_realizados / pontos_possiveis ) * 100 , 2 ) aproveitamento
                from ( select pck_util.fnc_semanaid(pc.idsemana) semana
                            , mc.descricao indicador
                            , nvl(( select decode(vc.nivel,'1','1 Estrela','2','2 Estrelas','3','3 Estrelas','4','4 Estrelas','5','5 Estrelas')
                                     from valoresmetricascampanhas vc
                                     where vc.idvalormetricacampanha = pc.idvalormetricacampanha ),'Nenhum') nivel
                            , pc.media
                            , pc.pontos pontos_realizados
                            , ( select vc.pontos
                                from valoresmetricascampanhas vc
                                where vc.idmetricacampanha = mc.idmetricacampanha
                                  and vc.idfilial          = 1089
                                  and vc.nivel             = '5'
                                  and vc.idcampanha        = :P764_IDCAMPANHA /*15*/ ) pontos_possiveis
                       from pontuacoescampanhasregionais pc
                          , metricascampanhas mc
                       where pc.idregionalfilial = :P764_IDREGIONAL_DET
                         and mc.idmetricacampanha = :P764_IDMETRICA_DET
                         and mc.idmetricacampanha = pc.idmetricacampanha
                         and pc.idcampanha = :P764_IDCAMPANHA --15
                       order by pc.idsemana ) t
                         
                ```
        }
