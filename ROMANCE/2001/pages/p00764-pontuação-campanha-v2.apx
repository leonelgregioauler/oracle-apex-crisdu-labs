    pageItem P764_REGIONAL (
        type: selectList
        label {
            label: Regional
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Todas' 
                     , -1
                from dual
                where v('APP_USER') in ('RAFAELK','GUILHERME','RENATAF','NATHALIAKINAST','JOSIELEDIAS')
                union
                select 'Regional 1'
                     , 1
                from dual
                where v('APP_USER') in ('RAFAELK','DANIELEPACHECO','NATHALIAKINAST','GUILHERME','RENATAF','JOSIELEDIAS')
                union
                select 'Regional 2'
                     , 2
                from dual
                where v('APP_USER') in ('RAFAELK','NATHALIAKINAST','RENATAF','GUILHERME','NAYARAMUNIZ','JOSIELEDIAS')
                union
                select 'Regional 3'
                     , 3
                from dual
                where v('APP_USER') in ('RAFAELK','NATHALIAKINAST','RENATAF','GUILHERME','BETHANIASOUTO','JOSIELEDIAS')
                union
                select 'Regional 4'
                     , 4
                from dual
                where v('APP_USER') in ('RAFAELK','NATHALIAKINAST','RENATAF','GUILHERME','JOSIELEDIAS')
                union
                select 'Regional 5' 
                     , 5
                from dual
                where v('APP_USER') in ('RAFAELK','GUILHERME','RENATAF','NATHALIAKINAST','JOSIELEDIAS')
                union
                select 'Regional Igrejinha'
                     , 7
                from dual
                where v('APP_USER') in ('RAFAELK','NATHALIAKINAST','RENATAF','GUILHERME','JOSIELEDIAS')
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P764_REGIONAL_FILTRO (
        type: selectList
        label {
            label: Regional
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Todas' 
                     , -1
                from dual
                where v('APP_USER') in ('RAFAELK','GUILHERME','RENATAF','NATHALIAKINAST','JOSIELEDIAS','LUCASSOUZA','MAICONAIMI')
                union
                select 'Regional 1'
                     , 1
                from dual
                where v('APP_USER') in ('RAFAELK','DANIELEPACHECO','NATHALIAKINAST','GUILHERME','RENATAF','JOSIELEDIAS','LUCASSOUZA')
                union
                select 'Regional 2'
                     , 2
                from dual
                where v('APP_USER') in ('RAFAELK','NATHALIAKINAST','RENATAF','GUILHERME','NAYARAMUNIZ','JOSIELEDIAS','LUCASSOUZA')
                union
                select 'Regional 3'
                     , 3
                from dual
                where v('APP_USER') in ('RAFAELK','NATHALIAKINAST','RENATAF','GUILHERME','BETHANIASOUTO','JOSIELEDIAS','LUCASSOUZA')
                union
                select 'Regional 4'
                     , 4
                from dual
                where v('APP_USER') in ('RAFAELK','NATHALIAKINAST','RENATAF','GUILHERME','JOSIELEDIAS','LUCASSOUZA')
                union
                select 'Regional 5' 
                     , 5
                from dual
                where v('APP_USER') in ('RAFAELK','GUILHERME','RENATAF','NATHALIAKINAST','JOSIELEDIAS','LUCASSOUZA')
                union 
                select 'Regional Comercial(1,2,3,4,7)' 
                     , 6
                from dual
                where v('APP_USER') in ('RAFAELK','GUILHERME','RENATAF','NATHALIAKINAST','JOSIELEDIAS','LUCASSOUZA')
                union
                select 'Regional Igrejinha'
                     , 7
                from dual 
                where v('APP_USER') in ('RAFAELK','GUILHERME','RENATAF','NATHALIAKINAST','JOSIELEDIAS','LUCASSOUZA')
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

