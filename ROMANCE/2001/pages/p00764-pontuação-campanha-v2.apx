    region evolução-no-programa-regional (
        name: Evolução no Programa Regional
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select regional
                     , pck_util.fnc_semanaid(t.idsemana) semana
                     , sum(t.pontos_realizados) pontos_realizados
                     , sum(t.pontos_extras) pontos_extras
                     , sum(t.pontos_realizados + t.pontos_extras) pontos_totais
                     , sum(t.pontos_possiveis) pontos_possiveis
                     , round( ( sum(t.pontos_realizados + t.pontos_extras)  / sum(pontos_possiveis) ) * 100,2 ) aproveitamento
                     , pck_campanhas.fnc_retornacategoria_calendario(1089
                                                                    ,sum(t.pontos_realizados + t.pontos_extras) 
                                                                    ,sum(pontos_possiveis)
                                                                    ,:P764_TIPO_PESQUISA 
                                                                    ,:P764_IDSEMANA
                                                                    ,:P764_IDCAMPANHA
                                                                    ,:P764_IDSEMANA_INI
                                                                    ,:P764_IDSEMANA_FIM) categoria
                from ( select pc.idregionalfilial
                            , rg.nome regional                     
                            , pc.idsemana
                            , sum(pc.pontos) pontos_realizados
                            , sum(pc.pontuacaoextra) pontos_extras
                            , ( select cc.pontuacaopossivel
                                from calendariomotivoulevou cc
                                where cc.idsemana = pc.idsemana
                                  and cc.idpais = 1 ) pontos_possiveis
                       from pontuacoescampanhasregionais pc
                          , regionaisfiliais rg
                       where pc.idcampanha = nvl(:P764_IDCAMPANHA,16)
                         and rg.idregionalfilial = pc.idregionalfilial
                         and pc.idcampanha = :P764_IDCAMPANHA 
                         and ( :P764_REGIONAL_FILTRO = -1 or rg.numero = :P764_REGIONAL_FILTRO )
                       group by pc.idregionalfilial, rg.nome, idsemana ) t
                group by regional, idsemana
                order by 1,2;
                ```
        }
        layout {
            sequence: 130
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P764_TIPO_PESQUISA = 'C' and :P764_TIPO_RELATORIO = 'R'
        }
        reportLayout {
            numberOfRows: 100000
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: showAll
            partialPageRefresh: false
        }
        breakFormatting {
            breakColumns: col1
        }

