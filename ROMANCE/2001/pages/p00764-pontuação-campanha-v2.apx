    region detalhamento-dos-indicadores-por-distribuidor (
        name: Detalhamento dos Indicadores por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.distribuidor
                     , w.semana
                     , w.metrica
                     , w.nivel
                     , w.valor
                     , w.pontos
                     , w.pontos_possiveis
                from vw_pontuacao_representantes_v2 w
                where w.idrepresentante = :P764_IDREPRESENTANTE_INDICADOR
                  and w.idmetricacampanha = :P764_IDMETRICA_INDICADOR
                  and w.idcampanha = :P764_IDCAMPANHA_PRINCIPAL
                order by w.idsemana
                ```
        }
        layout {
            sequence: 20
            parentRegion: @visualização-de-distribuidores
