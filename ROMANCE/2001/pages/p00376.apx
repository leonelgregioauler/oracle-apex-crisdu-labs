page 376 (
    name: Fechamento Semanal
    title: Fechamento Semanal
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region alterações-de-fechamento (
        name: Alterações de Fechamento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.usuarioalteracao 
                     , decode(f.tipoalteracao,'INSERT','Inclusão','UPDATE','Atualização','DELETE','Exclusão') tipoalteracao
                     , f.dataalteracao
                     , f.idfechamento 
                     , pck_romance.fnc_nomefilial(idfilial) filial
                     , f.saldoanteriorgaveta 
                     , f.totalcobranca
                     , f.totalvendasdiretas
                     , f.totalchqsemfundorecebidos
                     , f.totalboletosfavorita
                     , f.totaldespesas
                     , f.totalcomissoesrepresentantes
                     , f.totalcomissaogerente
                     , f.totaldepositosespecie
                     , f.totaldepsitoscheques
                     , f.totalcomissoesfavoritarepres
                     , f.totalcomissoesfavoritagerente
                     , f.saldofinalespecie
                     , f.saldofinalcheque
                     , f.subtotalgaveta
                     , f.totalsaidasdiversas
                     , f.totalresgate
                     , f.totalentradasdiversas
                     , f.totalfaturas
                     , f.totaldepositospendentes
                     , f.comissaogerente
                     , f.totalemprestimos
                     , f.totalemprestimospagos
                     , f.saldodebitos
                     , f.valornobanco
                     , f.mesvalornobanco
                     , decode(f.concluido,'S','Sim','N','Não') concluido
                     , f.totalgaveta
                     , f.totalvendadiretafavorita
                     , ( ( nvl(f.totalcobranca,0) + nvl(f.totalchqsemfundorecebidos,0) + nvl(f.totalboletosfavorita,0) + nvl(f.totalentradasdiversas,0) )
                       - ( nvl(f.totaldespesas,0) + nvl(f.totalcomissaogerente,0) + nvl(f.totalcomissoesrepresentantes,0) ) 
                       - ( nvl(f.totaldepositosespecie,0) + nvl(f.totaldepsitoscheques,0) + nvl(f.totalcomissoesfavoritagerente,0) + nvl(f.totalcomissoesfavoritarepres,0) )
                       -  nvl(f.totalsaidasdiversas,0) 
                       -  nvl(f.totalemprestimos,0)
                       +  nvl(f.totalvendadiretafavorita,0) ) saldodasemana
                     , f.totalcomissaobalanco
                from logroman.log_fechamentossemanais f
                where f.idfechamento = :P376_IDFECHAMENTO
                order by f.dataalteracao desc
                ```
            pageItemsToSubmit: P376_IDFECHAMENTO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1826681946255342335
        }

