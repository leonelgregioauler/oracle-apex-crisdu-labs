    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P376_IDFECHAMENTO (
        type: selectList
        label {
            label: Fechamento Semanal
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
            executeValidations: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.semana||' - '||decode(f.concluido,'S','Fechada','N','Aberta') display_value
                     , f.idfechamento return_value
                from fechamentossemanais f
                where f.idfilial = :P376_IDFILIAL
                order by f.idfechamento desc
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P376_IDFILIAL
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P376_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 376
                items: {
                    P376_IDFECHAMENTO: &P376_IDFECHAMENTO.
                }
                action: resetPagination
            }
        }
    )

)

