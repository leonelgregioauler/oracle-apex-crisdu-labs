page 266 (
    name: Imprime Lista Distribuição
    title: Imprime Lista Distribuição
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region font-color-white-font (
        name: <font color="white"></font>
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_imprime.prc_imprimedistribuicaocarga( :P266_IDFILIAL, :P266_SEMANA, :P266_TIPO );
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P266_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @font-color-white-font
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P266_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @font-color-white-font
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P266_TIPO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @font-color-white-font
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

