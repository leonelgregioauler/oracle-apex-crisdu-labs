    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: P620_FILTRAR
        }
    )

    dynamicAction ano (
        name: Ano
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P620_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P620_PESQUISA
            value: A
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P620_ANO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P620_ANO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction periodo (
        name: Periodo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P620_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P620_PESQUISA
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P620_DATAINICIO
                    P620_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P620_DATAINICIO
                    P620_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction romance (
        name: Romance
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P620_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P620_TIPO
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P620_SITUACAO_ASSINATURA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P620_SITUACAO_ASSINATURA
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 620
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 620
                items: {
                    P620_IDFILIAL: &P620_IDFILIAL.
                    P620_PESQUISA: &P620_PESQUISA.
                    P620_DATAINICIO: &P620_DATAINICIO.
                    P620_DATAFIM: &P620_DATAFIM.
                    P620_ANO: &P620_ANO.
                    P620_TIPO: &P620_TIPO.
                    P620_IDPAIS: &P620_IDPAIS.
                    P620_SITUACAO_ASSINATURA: &P620_SITUACAO_ASSINATURA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

