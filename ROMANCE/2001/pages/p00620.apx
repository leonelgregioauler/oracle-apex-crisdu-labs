page 620 (
    name: Carteira Atrasada
    title: Carteira Atrasada
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region carteira-atrasada-fav (
        name: Carteira Atrasada FAV
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(p.cpf,p.documentoestrangeiro) "CPF"
                     , p.rg "RG"
                     , initcap(p.nomepessoa) "Consultora"
                     , p.enderecoprincipal "Endereço"
                     , p.numero "Numero"
                     , p.bairro "Bairro"
                     , p.cep "Cep"
                     , roman.pck_romance.fnc_nomecidade(p.idcidade) "Cidade"
                     , p.email
                     , ( select t.telefone
                         from telefonespessoas t
                         where t.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                      from telefonespessoas tt
                                                      where tt.idpessoa = p.idpessoa ) ) "Telefones"
                     , p.datanascimento "Data de Nascimento"
                     , decode(p.sexo,'M','Masculino','F','Feminino') "Sexo"
                     , pp.filialromance "Empresa"
                     , pp.representante "Distribuidor"
                     , pp.numeropedido "Nr Pedido"
                     , pp.dataemissao "Data de Emissão"
                     , pp.dataentrega "Data de Entrega"
                     , pp.datavencimentomenor "Vencimento"
                     , nvl(pp.valortotal*nvl(pp.fatorconversao,1),0) "Total Pedido"
                     , nvl(pp.valordesconto*nvl(pp.fatorconversao,1),0) "Valor Desconto"
                     , nvl(pp.valorapagar*nvl(pp.fatorconversao,1),0) "Valor a Pagar"
                     , nvl(pp.valorpago*nvl(pp.fatorconversao,1),0) "Pago"
                     , nvl(pp.saldodevedor*nvl(pp.fatorconversao,1),0) "Saldo"
                     , decode(v.spc, 'S', 'Sim','Não') "Enviado ao SPC"
                     , nvl( ( select 'Sim'
                              from dual
                              where exists ( select 1
                                             from negociacoesparceiros np
                                             where np.idvendedora = v.idvendedora
                                               and np.origem      = 'B' ) ),'Não') acordo_vigente
                     , ( select max(m.datainclusao)
                         from mensagenssms m
                         where m.idpessoa = p.idpessoa
                           and m.idprocessosistema = 40 ) ultimo_acionamento
                from favorita.vw_pedidos_fav pp
                   , catal.vendedoras v
                   , catal.pessoas p
                where pp.idvendedora = v.idvendedora
                  and v.idpessoa     = p.idpessoa
                  and pp.datacancelamento is null
                  and pp.saldodevedor > 0
                  and p.idpais       = :P620_IDPAIS
                  and ( :P620_PESQUISA is null
                    or ( :P620_PESQUISA = 'A' and extract (year from pp.dataemissao) = :P620_ANO )
                    or ( :P620_PESQUISA = 'P' and pp.dataemissao between to_date(:P620_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P620_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) )
                  and ( :P620_IDFILIAL is null or pp.idfilialromance = :P620_IDFILIAL)
                  and ( :P620_DATAINICIO is not null or :P620_IDFILIAL is not null or :P620_ANO is not null )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P620_TIPO
            value: F
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma informação encontrada!
        }
        advanced {
            savedReportMappingIdentifier: 116473128207608002
        }

