    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P620_ANO (
        type: textField
        label {
            label: Ano
            alignment: left
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        default {
            type: expression
            plsqlExpression: to_char(sysdate,'RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P620_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P620_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P620_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and f.idgrupo is not null
                  and f.ididioma = :P620_IDPAIS
                ```
            nullDisplayValue: "- Todas - "
        }
        cascadingLov {
            parentItems: P620_IDPAIS
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P620_IDPAIS (
        type: radioGroup
        label {
            label: País
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: staticValues
            staticValues: STATIC:Brasil;1,Uruguay;2,Paraguay;4,Chile;6,Portugal;11,México;12,Panamá;13,Peru;8
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 1
        }
        security {
            encryptSessionState: false
        }
    )

