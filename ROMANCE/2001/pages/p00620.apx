    region carteira-atrasada-rmc (
        name: Carteira Atrasada RMC
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(p.cpf,p.documentoestrangeiro) "CPF"
                     , p.rg "RG"
                     , initcap(p.nomepessoa) "Consultora"
                     , p.enderecoprincipal "Endereço"
                     , p.numero "Numero"
                     , p.bairro "Bairro"
                     , p.cep "Cep"
                     , roman.pck_romance.fnc_nomecidade(p.idcidade) "Cidade"
                     , p.email
                     , ( select t.telefone
                         from telefonespessoas t
                         where t.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                      from telefonespessoas tt
                                                      where tt.idpessoa = p.idpessoa ) ) "Telefones"
                     , p.datanascimento "Data de Nascimento"
                     , decode(p.sexo,'M','Masculino','F','Feminino') "Sexo"
                     , roman.pck_romance.fnc_nomefilial(nv.idfilial) "Empresa"
                     , roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) "Distribuidor"
                     , nv.numeronota "Nr Pedido"
                     , trunc(nv.datanota) "Data do Nota"
                     , trunc(nv.dataretorno) "Data do Retorno"
                     , trunc(nvl(nv.dataretornoorig,(nv.datanota+42))) "Data do Retorno Orig."
                     , trunc(nv.dataacerto) "Data do Acerto"
                     , nvl(nv.valortotalnota*nvl(nv.fatorconversao,1),0) "Total Nota"
                     , nvl(nv.valortotaldevolucao*nvl(nv.fatorconversao,1),0) "Total Devolução"
                     , nvl(nv.valortotalvenda*nvl(nv.fatorconversao,1),0) "Total Venda"
                     , nvl(nv.valortotalvendalqd*nvl(nv.fatorconversao,1),0) "Total Venda Liquida"
                     , nvl(nv.valorcomissao*nvl(nv.fatorconversao,1),0) "Comissão Consultora"
                     , nvl(nv.valorpago*nvl(nv.fatorconversao,1),0) "Pago"
                     , nvl(nv.saldo*nvl(nv.fatorconversao,1),0) "Saldo"
                     , nvl(nv.enviadocobranca,'N') "Enviado Cobrança"
                     , nv.dataenviadocobranca "Data de envio p/ Cobrança"
                     , decode(v.spc, 'S', 'Sim','Não') "Enviado ao SPC"
                     , ( select decode(aa.situacao,'R','Reprovada','A','Aprovada')
                         from assinaturaseletronicas aa
                         where aa.idassinaturaeletronica = ( select max(a.idassinaturaeletronica)
                                                             from assinaturaseletronicas a 
                                                             where a.idnotavenda = nv.idnotavenda
                                                               and a.status = 'C' ) ) situacao_assinatura
                     , nvl( ( select 'Sim'
                              from dual
                              where exists ( select 1
                                             from negociacoesparceiros np
                                             where np.idvendedora = nv.idvendedora
                                               and np.origem      = 'B' ) ),'Não') acordo_vigente
                     , ( select max(ob.data)
                         from observacoesnotasvendas ob
                         where ob.idnotavenda = nv.idnotavenda ) ultimo_acionamento
                from roman.notasvendas nv
                   , catal.pessoas p
                   , catal.vendedoras v
                where v.idvendedora = nv.idvendedora
                  and p.idpessoa = v.idpessoa
                  and nv.idsituacaonotavenda = 4
                  and nv.saldo > 0
                  and p.idpais       = :P620_IDPAIS
                  and ( :P620_PESQUISA is null
                    or ( :P620_PESQUISA = 'A' and extract (year from nv.datanota) = :P620_ANO )
                    or ( :P620_PESQUISA = 'P' and nv.datanota between to_date(:P620_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P620_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) )
                  and ( :P620_IDFILIAL is null or nv.idfilial = :P620_IDFILIAL)
                  and ( :P620_DATAINICIO is not null or :P620_IDFILIAL is not null or :P620_ANO is not null )
                  and ( :P620_SITUACAO_ASSINATURA = 'X' or exists ( select 1
                                                                    from assinaturaseletronicas a
                                                                    where a.idnotavenda = nv.idnotavenda
                                                                      and a.status = 'C'
                                                                      and a.situacao = :P620_SITUACAO_ASSINATURA ) )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P620_TIPO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma informação encontrada! Verifique os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 116421786614642217
        }

