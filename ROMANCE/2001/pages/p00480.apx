page 480 (
    name: Situações Judiciais
    title: Situações Judiciais
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region situações-judiciais (
        name: Situações Judiciais
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region situações-judiciais-existentes (
        name: Situações Judiciais Existentes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idsituacaojudicial
                     , descricao
                from situacoesjudiciais 
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 480
                items: {
                    P480_IDSITUACAOJUDICIAL: #IDSITUACAOJUDICIAL#
                    P480_DESCRICAO: #DESCRICAO#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1539419184580078444
        }

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDSITUACAOJUDICIAL (
            type: plainText
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 15394926 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn IDSITUACAOJUDICIAL (
                sequence: 1
            )

        )

    )

    pageItem P480_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        layout {
            sequence: 20
            region: @situações-judiciais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
        }
        validation {
            maxLength: 1000
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P480_IDSITUACAOJUDICIAL (
        type: hidden
        layout {
            sequence: 10
            region: @situações-judiciais
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDSITUACAOJUDICIAL
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 30
            region: @situações-judiciais
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P480_IDSITUACAOJUDICIAL
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 50
            region: @situações-judiciais
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P480_IDSITUACAOJUDICIAL
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 20
            region: @situações-judiciais
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 478
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button nova (
        buttonName: NOVA
        label: Nova
        layout {
            sequence: 10
            region: @situações-judiciais
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 40
            region: @situações-judiciais
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P480_IDSITUACAOJUDICIAL
        }
    )

    process fetch-row-from-situacoesjudiciais (
        name: Fetch Row from SITUACOESJUDICIAIS
        type: autoRowFetch
        source {
            tableName: SITUACOESJUDICIAIS
            pkColumn: IDSITUACAOJUDICIAL
            pkItem: P480_IDSITUACAOJUDICIAL
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1539483294433028389
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P480_IDSITUACAOJUDICIAL is null then
                        select "#OWNER#"."SEQ_IDSITUACAOJUDICIAL".nextval
                          into :P480_IDSITUACAOJUDICIAL
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1539483607355028389
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process limpa-dados (
        name: Limpa Dados
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 905798222068181411
        }
    )

    process process-row-of-situacoesjudiciais (
        name: Process Row of SITUACOESJUDICIAIS
        type: autoRowProcessing
        target {
            tableName: SITUACOESJUDICIAIS
            pkColumn: IDSITUACAOJUDICIAL
            pkItem: P480_IDSITUACAOJUDICIAL
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Processo Executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1539484010495028389
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 480
                items: {
                    P480_IDSITUACAOJUDICIAL: &P480_IDSITUACAOJUDICIAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SAVE','CREATE')
                ```
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 480
                items: {
                    P480_IDSITUACAOJUDICIAL:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETE
        }
    )

)

