page 827 (
    name: Imprimi Termo Distribuidor em Lote
    title: Imprimi Termo Distribuidor em Lote
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            /* REMOVE HEADER VITA */
            .t-Header,
            #t_Header {
              display: none !important;
            }
            
            /* REMOVE NAVIGATION BAR */
            .t-Body-nav,
            #t_Body_nav {
              display: none !important;
            }
            
            /* REMOVE SIDE BAR */
            .t-Body-side,
            #t_Body_side {
              display: none !important;
            }
            
            /* REMOVE FOOTER */
            .t-Footer,
            #t_Footer {
              display: none !important;
            }
            
            /* REMOVE ESPAÇO SUPERIOR */
            .t-Body-main {
              margin-top: 0 !important;
              padding-top: 0 !important;
            }
            /* Remove toolbar flutuante do APEX */
            .a-DevToolbar,
            .t-Body-actions,
            .t-ButtonRegion,
            .apex-rds-container,
            .js-maximizeButtonContainer {
                display: none !important;
            }
            /* Numeração da Página */
            @media print {
            
                .folha {
                    position: relative;
                    page-break-after: always;
                }
            
                .folha:last-child {
                    page-break-after: auto;
                }
            
                .numero-pagina {
                    position: absolute;
                    bottom: 10mm;
                    right: 15mm;
                    font-size: 10pt;
                }
            
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão-termo-distribuidor-em-lote (
        name: Impressão Termo Distribuidor  em Lote
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidrepresentante number       := :P827_IDREPRESENTANTE;
                  vresponsavel     varchar2(50) := :P827_RESPONSAVEL;
                  vidioma          number;
                  --
                begin
                  --
                  -- ==============================
                    -- CSS + REGRAS DE IMPRESSÃO
                  --  ============================== 
                  htp.p(q'[<style>
                            html, body{
                              margin: 0;
                              padding: 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 12pt;
                            }
                
                            .titulo{
                              text-align: center;
                              font-size: 18pt;
                              font-weight: bold;
                              margin-bottom: 25px;
                            }
                
                            .subtitulo{
                              font-size: 14pt;
                              font-weight: bold;
                              margin-top: 20px;
                              margin-bottom: 10px;
                            }
                
                            table{
                              width: 100%;
                              border-collapse: collapse;
                            }
                
                            .tabela-brinde th,
                            .tabela-brinde td{
                              border: 1px solid #000;
                              padding: 6px;
                            }
                
                            /* ¿ CADA CUPOM NÃO PODE QUEBRAR NO MEIO */
                            .bloco-cupom{
                              break-inside: avoid;
                              page-break-inside: avoid;
                              margin-bottom: 14px;
                            }
                
                            @media print{
                              @page { margin: 25mm 15mm 25mm 15mm; }
                            }
                          </style> ]');
                
                  -- Verifica o idioma do representante. 
                  select f.ididioma
                    into vidioma
                  from catal.representantes r
                     , catal.filiais f
                  where f.idfilial = r.idfilial
                    and r.idrepresentante = vidrepresentante;
                  --  
                  if vidioma in (1,11) then 
                    -- Chama procedure com termo em Portugues Brasil e Portugal. 
                    favorita.pck_imprime_fav.prc_termo_conquistou_lote(pidrepresentante => vidrepresentante, presponsavel => vresponsavel);
                    --
                  elsif vidioma in (2,6,12,13) then 
                    -- Chama procedure com termo em espanhol. 
                    favorita.pck_imprime_fav.prc_termo_conquistou_lote_espanhol(pidrepresentante => vidrepresentante, presponsavel => vresponsavel);
                    --
                  elsif vidioma  = 4 then 
                    -- Chama procedure com termo em espanhol. 
                    favorita.pck_imprime_fav.prc_termo_conquistou_lote_paraguai(pidrepresentante => vidrepresentante, presponsavel => vresponsavel);
                  end if;
                
                  -- footer fixo
                  --htp.p('<div class="footer-fixo"></div>');
                  -- imprime
                  
                  htp.p('<script>window.print();</script>');
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P827_IDREPRESENTANTE (
        type: hidden
        layout {
            sequence: 10
            region: @impressão-termo-distribuidor-em-lote
            slot: regionBody
        }
    )

    pageItem P827_RESPONSAVEL (
        type: hidden
        layout {
            sequence: 20
            region: @impressão-termo-distribuidor-em-lote
            slot: regionBody
        }
    )

)

