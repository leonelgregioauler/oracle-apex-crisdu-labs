page 346 (
    name: "Alterações de Pagamentos "
    title: "Alterações de Pagamentos "
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 70%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region alterações-de-pagamentos (
        name: Alterações de Pagamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , nv.numeronota
                     , pck_romance.fnc_nomevendedora(nv.idvendedora) vendedora
                     , pg.datapagamento
                     , pg.valorpago valorpagoatual
                     , '|' alteracao
                     , lpagalt.usuarioalteracao
                     , lpagalt.dataalteracao
                     , lpagalt.valorpago 
                from pagamentosnotasvendas pg
                   , notasvendas nv
                   , ( select lpg.idpagtonotavenda
                            , lpg.idnotavenda
                            , lpg.dataalteracao
                            , decode(lpg.usuarioalteracao,'ROMAN','TABLET',usuarioalteracao) usuarioalteracao
                            , lpg.valorpago
                            , lpg.semanacobranca
                       from logroman.log_pagamentosnotasvendas lpg
                       where lpg.idlog = ( select max(idlog)
                                           from logroman.log_pagamentosnotasvendas lp
                                           where lp.idpagtonotavenda = lpg.idpagtonotavenda
                                             and lp.valorpago        = lpg.valorpago ) ) lpagalt
                where ( pg.idfechamentorepres  = :P346_IDFECHAMENTOREPRES
                     or pg.semanacobranca      = :P346_SEMANA )
                  and nv.idnotavenda           = pg.idnotavenda
                  and nv.idrepresentante       = :P346_IDREPRESENTANTE
                  and lpagalt.idpagtonotavenda = pg.idpagtonotavenda
                  and lpagalt.valorpago        != pg.valorpago
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 784852572603259131
        }

        column ALTERACAO (
            type: plainText
            heading {
                heading: Dados da Alteração
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column DATAALTERACAO (
            type: plainText
            heading {
                heading: Data Alteração
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH:24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        column DATAPAGAMENTO (
            type: plainText
            heading {
                heading: Data do Pagamento
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH:24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDNOTAVENDA (
            type: hidden
            heading {
                heading: Idnotavenda
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NUMERONOTA (
            type: plainText
            heading {
                heading: Nr Nota
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column USUARIOALTERACAO (
            type: plainText
            heading {
                heading: Alterado Por
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALORPAGO (
            type: plainText
            heading {
                heading: "Valor Pago "
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column VALORPAGOATUAL (
            type: plainText
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column VENDEDORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 7849519 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ALTERACAO (
                sequence: 6
            )

            displayColumn DATAALTERACAO (
                sequence: 8
            )

            displayColumn DATAPAGAMENTO (
                sequence: 4
            )

            displayColumn IDNOTAVENDA (
                sequence: 1
            )

            displayColumn NUMERONOTA (
                sequence: 2
            )

            displayColumn USUARIOALTERACAO (
                sequence: 7
            )

            displayColumn VALORPAGO (
                sequence: 9
            )

            displayColumn VALORPAGOATUAL (
                sequence: 5
            )

            displayColumn VENDEDORA (
                sequence: 3
            )

        )

    )

    pageItem P346_IDFECHAMENTOREPRES (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @alterações-de-pagamentos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P346_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @alterações-de-pagamentos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P346_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @alterações-de-pagamentos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

