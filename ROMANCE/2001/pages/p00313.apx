page 313 (
    name: Fotos de Documentos Tiradas
    title: Fotos de Documentos Tiradas
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_popup_consulta()
            {
              window.open('f?p=&APP_ID.:156:&SESSION.::NO::','CONSULTAR', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=250,left=250,top=100','_blank'); void(0);
            }
            
            function fnc_popup()
            {
            window.open('f?p=&APP_ID.:147:&SESSION.::NO::','LIMPAR', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=180,left=250,top=100','_blank'); void(0);
            }
            function fnc_popup_vend()
            {
            window.open('f?p=&APP_ID.:152:&SESSION.::NO::','vendedora', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=900,height=600,left=250,top=100','_blank'); void(0);
            }
            
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region fotos-de-documentos (
        name: Fotos de Documentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.documento||' - '||( select initcap(nomepessoa)
                                             from pessoas p
                                             where p.cpf = f.documento ) documento
                     , f.tipofoto
                     , f.nomearquivo
                     , f.data
                     , decode(f.recebida,'S','Sim','Não') recebida
                     , f.datarecebida
                     , f.datadadosrecebido
                     , null verfoto
                from roman.fotosdocumentos f
                where f.idrepresentante = :P313_IDREPRESENTANTE
                  and f.idsemana        = pck_util.fnc_idsemana(:P313_SEMANA)
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhuma foto encontrada!
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            savePublicReport: true
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 575710040345990018
        }

