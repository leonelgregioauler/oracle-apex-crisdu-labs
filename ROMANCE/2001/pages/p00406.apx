page 406 (
    name: Insumos
    title: Insumos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region insumos (
        name: Insumos
        type: list
        source {
            list: @insumos
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--3cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

)

