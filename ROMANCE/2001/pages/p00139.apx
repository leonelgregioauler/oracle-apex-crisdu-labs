    region parcelamentos-realizados (
        name: Parcelamentos Realizados
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "IDPARCNOTAVENDA",
                "IDNOTAVENDA",
                "DATAVENCIMENTO",
                "VALORORIGINAL",
                "JUROS",
                "VALORAPAGAR",
                "SITUACAO",
                "COMPROVANTE",
                "IDCONTABANCARIAFILIAL"
                from "#OWNER#"."PARCELAMENTOSNOTASVENDAS"
                where idnotavenda = :P139_IDNOTAVENDA
                order by DATAVENCIMENTO 
                ```
        }
        layout {
            sequence: 15
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from parcelamentosnotasvendas
                where idnotavenda = :P139_IDNOTAVENDA
                ```
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }

