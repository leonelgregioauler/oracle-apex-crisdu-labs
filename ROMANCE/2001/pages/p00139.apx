    process desfazer-parcelamento (
        name: desfazer parcelamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  vexiste varchar2(1);
                begin
                  --
                  delete parcelamentosnotasvendas
                  where idnotavenda = :P139_IDNOTAVENDA
                    and situacao = 'A';
                  --
                  insert into observacoesnotasvendas
                  values (seq_idobsnotavenda.nextval, :P139_IDNOTAVENDA, sysdate, 'Parcelamento desfeito.', v('APP_USER'));
                  --
                  begin
                    select 'S'
                    into vexiste
                    from parcelamentosnotasvendas p
                    where p.idnotavenda = :P139_IDNOTAVENDA
                      and p.situacao = 'Q';
                  exception
                    when others then
                      vexiste := 'N';
                  end;
                  --
                  if vexiste = 'S' then
                    update notasvendas n
                    set n.idsituacaocobranca = 0
                      , n.responsavelcobranca = null
                    where n.idnotavenda = :P139_IDNOTAVENDA;
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Parcelamento Desfeito com sucesso!
        }
        advanced {
            executionMappingIdentifier: 201638401256991021
        }
        serverSideCondition {
            whenButtonPressed: @desfazer
        }
    )

    process efetuar-parcelamento (
        name: efetuar parcelamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 --
                 vidnotavenda    number := :P139_IDNOTAVENDA;
                 vqtdparcelas    number;
                 vvalortotal     number(15,2);
                 vvalorparcela   number(15,2);
                 vjuros          number(15,2) := 1;
                 vvalorapagar    number(15,2);
                 vdatavencimento date;
                 vvalororiginal  number(15,2);
                 vvalorentrada   number(15,2);
                 verro           varchar2(2000);
                 vtarefa         number;
                 vidconta        number := trim(to_number(:P139_IDCONTABANCARIA,'999G999G999G999D00'));
                 vtipoparcelamento varchar2(1) := :P139_TIPOPARCELAMENTO;
                 vidusuario      number;
                 --
                 vidsituacaoatual number;
                 --
                begin
                  --
                
                  vqtdparcelas     := trim(to_number(:P139_QTDPARCELAMENTO,'999G999G999G999D00'));
                  vvalorentrada    := :P139_VALORENTRADA + 0;
                --  vvalorentrada    := to_number(:P139_VALORENTRADA,'999G999G999G999D00');
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  select n.saldo
                       , n.idsituacaocobranca
                  into vvalortotal
                     , vidsituacaoatual
                  from notasvendas n
                  where n.idnotavenda = vidnotavenda;
                  --
                  begin
                    --
                    select idtarefa
                    into vtarefa
                    from favorita.tarefas t
                    where t.idsituacao = 10
                      and t.idusuario = vidusuario;
                    --
                  exception
                    when others then
                      null;
                    --
                  end;
                  --
                  if vtipoparcelamento = 'E' then
                    --
                    vdatavencimento := to_date(:P139_VENCIMENTOENTRADA,'DD/MM/RRRR');
                    vvalororiginal := trim( (vvalortotal-vvalorentrada)  / vqtdparcelas);
                    vvalorapagar := trim( (vvalortotal-vvalorentrada)/ vqtdparcelas);
                    --
                    insert into parcelamentosnotasvendas ( idparcnotavenda , idnotavenda , datavencimento , valororiginal , juros , valorapagar , situacao , comprovante , idcontabancariafilial
                                                         , databaixa , bonificacaopaga , idnegociacaoparceiro , usuarioresponsavel )
                    values (SEQ_IDPARCELAMENTONOTA.nextval, vidnotavenda, vdatavencimento, vvalorentrada, vjuros, vvalorentrada, 'A', null, vidconta, null, null, null,v('APP_USER'));
                    --values (SEQ_IDPARCELAMENTONOTA.nextval, vidnotavenda, vdatavencimento, trim(to_number(:P139_VALORENTRADA,'999G999G999G999D00')), vjuros, trim(to_number(:P139_VALORENTRADA,'999G999G999G999D00')), 'A', null, vidconta, null, null, null,v('APP_USER'));
                    --
                  elsif vtipoparcelamento = 'S' then
                    --
                    vvalororiginal := trim(vvalortotal/vqtdparcelas);
                    vvalorapagar := trim(vvalortotal/vqtdparcelas);
                    vdatavencimento := sysdate;
                    --
                  end if;
                  --
                  for i in 1..vqtdparcelas
                  loop
                    --
                    vdatavencimento := vdatavencimento + 30;
                    -- vvalorapagar    := vvalorapagar + (vvalorapagar * 0,01);
                    --
                    insert into parcelamentosnotasvendas ( idparcnotavenda , idnotavenda , datavencimento , valororiginal , juros , valorapagar , situacao , comprovante , idcontabancariafilial
                                                         , databaixa , bonificacaopaga , idnegociacaoparceiro , usuarioresponsavel )
                    values (SEQ_IDPARCELAMENTONOTA.nextval, vidnotavenda, vdatavencimento, vvalororiginal, vjuros, vvalorapagar, 'A', null, vidconta, null, null, null, v('APP_USER'));
                    --
                  end loop;
                  --
                  if vidsituacaoatual != 70 then 
                    --
                    update notasvendas n
                    set n.idsituacaocobranca = 20
                      , n.responsavelcobranca = v('APP_USER')
                    where n.idnotavenda = vidnotavenda;
                    --
                  elsif vidsituacaoatual = 70 then
                    --
                    update notasvendas n
                    set n.responsavelcobranca = v('APP_USER')
                    where n.idnotavenda = vidnotavenda;
                    --
                  end if;
                  --
                  insert into observacoesnotasvendas
                  values (seq_idobsnotavenda.nextval, vidnotavenda, sysdate, 'Parcelamento da negociação realizado.', v('APP_USER'));
                  --
                  begin
                    insert into favorita.tarefasnegociacoes
                    values ( favorita.seq_idtarefanegociacao.nextval , sysdate , vtarefa , null , vidusuario , vidnotavenda );
                  exception
                    when others then
                      null;
                  end;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Parcelamento realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 201638390063991020
        }
        serverSideCondition {
            whenButtonPressed: @parcelar
        }
    )

    branch (
        name: volta para a nota
        execution {
            sequence: 11
        }
        behavior {
            target: {
