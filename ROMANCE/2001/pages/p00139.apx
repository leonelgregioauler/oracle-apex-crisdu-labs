        column IDCONTABANCARIAFILIAL (
            reportColumnQueryId: 10
            derivedColumn: N
            type: selectList
            heading {
                heading: Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select c.beneficiario||' ('||b.nomebanco||' - Ag: '||c.agencia||'- CC: '||c.conta||')' d
                         , c.idcontabanc r
                    from roman.contasbancarias c
                       , roman.bancos b
                    where b.idbanco = c.idbanco
                      and c.ativo = 'S'
                      and c.usosetorcobranca = 'S'
                    ```
            }
            layout {
                sequence: 11
            }
            sorting {
                sortable: false
            }
        )

