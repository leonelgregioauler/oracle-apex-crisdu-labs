    validation valor-pago-zero (
        name: Valor Pago Zero
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                  where nvl(:P36_VALOR_PAGO_ZERO_SEMANA,'N') = 'S' and :P36_SEMANA is null
                ```
        }
        error {
            errorMessage: Atenção: ao marcar a opção "Com pagamento zero na semana?", o preenchimento da semana se torna obrigatório!
        }
        serverSideCondition {
            whenButtonPressed: @p36-filtrar
        }
    )

    process confirmar-promissoria (
        name: Confirmar Promissoria
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidcaracteristica number := 3;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);
                  vidnotavenda number := :P36_IDRECEBIDO;
                  --
                begin 
                  --
                  update notasvendas n
                  set n.promissoriarecuperada = 'S'
                  where n.idnotavenda = :P36_IDRECEBIDO;
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P36_IDRECEBIDO,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidvalorcaracteristica,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1737223123343236724
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        name: buscar nota ti
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 37
                items: {
                    P37_IDNOTAVENDA: &P36_IDNOTAVENDA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscarnota
        }
    )

    branch (
        name: filtrar
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 36
                items: {
                    P36_IDREPRESENTANTE: &P36_IDREPRESENTANTE.
                    P36_IDVENDEDORA: &P36_IDVENDEDORA.
                    P36_SEMANA: &P36_SEMANA.
                    P36_TIPO: &P36_TIPO.
                    P36_IDCIDADE: &P36_IDCIDADE.
                    P36_ENVIADOCOBRANCA: &P36_ENVIADOCOBRANCA.
                    P36_REGIAOVENDA: &P36_REGIAOVENDA.
                    P36_HISTORICO: &P36_HISTORICO.
                    P36_DOCRECEBIDO: &P36_DOCRECEBIDO.
                    P36_NRDOCUMENTO: &P36_NRDOCUMENTO.
                    P36_DISTRECEBEU_RESPON: &P36_DISTRECEBEU_RESPON.
                    P36_TELEFONE: &P36_TELEFONE.
                }
                successMessage: false
            }
        }
    )

)

