    pageItem P36_HISTORICO (
        type: textField
        label {
            label: Histórico
            alignment: left
        }
        layout {
            sequence: 190
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        source {
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2314,v('APP_USER'))='S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P36_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecidade ||' - '|| e.sigla display_value
                     , c.idcidade return_value
                  from cidades c
                     , estados e
                     , filiaisregioesvenda f
                where c.idestado = e.idestado 
                  and f.idestado = e.idestado
                  and f.idfilial = :P0_IDFILIAL
                order by 1
                ```
            nullDisplayValue: Todos
        }
        layout {
            sequence: 170
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P36_IDNOTAVENDA (
        type: textField
        label {
            label: IDNOTAVENDA
            alignment: left
        }
        layout {
            sequence: 230
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios u
                where u.usuario = v('APP_USER') 
                  and u.idgerente in (143,280)
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P36_IDRECEBIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 250
            region: @filtro
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P36_IDREPRESENTANTE (
        type: selectOne
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
            useCache: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||r.idrepresentante||')' || decode(r.ativo,'S','','Inativo') display_value
                     , r.idrepresentante
                from representantes r
                where idgerente in ( select idgerente
                                     from gerentes
                                     where idfilial = :P0_IDFILIAL)
                  and ( :P36_REPREATIVO = 'A' 
                     or :P36_REPREATIVO = 'S' and r.ativo = 'S'
                     or :P36_REPREATIVO = 'N' and r.ativo = 'N' )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P36_REPREATIVO
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P36_IDSITUACAONOTAVENDA (
        type: selectList
        label {
            label: Situação da Nota
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.descricao as display_value
                     , s.idsituacaonotavenda as return_value
                  from roman.situacoesnotavenda s
                 order by s.ordem
                ```
        }
        layout {
            sequence: 260
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P36_IDVENDEDORA (
        type: popupLov
        label {
            label: Cliente
            alignment: left
        }
        settings {
            displayAs: modalDialog
            initialFetch: onUserRequest
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomepessoa)||' - '||replace(replace(nvl(cpf,documentoestrangeiro),'-',''),'.','') ||' ('||idvendedora||')' display_value
                     , v.idvendedora return_value
                from vendedoras v
                   , pessoas p
                where v.idpessoa = p.idpessoa
                  and ( :P36_IDREPRESENTANTE is null  or v.idrepresentante = :P36_IDREPRESENTANTE ) 
                  and v.idrepresentante in (select idrepresentante
                                            from representantes
                                            where idgerente in ( select idgerente
                                                                 from gerentes
                                                                 where idfilial = :P0_IDFILIAL))
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P36_IDREPRESENTANTE
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P36_LIMITE_SACOLA_EXCEDIDO (
        type: selectList
        label {
            label: Limite Sacola Excedido
            alignment: left
        }
        lov {
