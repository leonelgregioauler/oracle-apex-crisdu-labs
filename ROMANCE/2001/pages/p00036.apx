            }
            
            function fotosdocumento(vidpessoa,vidnotavenda)
            {
              pjanela = window.open('f?p=&APP_ID.:373:&SESSION.::NO:373:P373_IDPESSOA,P373_IDNOTAVENDA:'+vidpessoa+','+vidnotavenda,'DOCUMENTOS','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=600,height=600,screenX=50,screenY =100');
              pjanela.focus();
            }
            
            function formatar_mascara(src,mascara,evt){
            var tecla;  
            if(evt.which){tecla = evt.which}
            else if(evt.keyCode){ tecla = evt.keyCode;}  
             if( tecla != 8 ){
             var campo = src.value.length;
             var saida = mascara.substring(0,1);
             var texto = mascara.substring(campo);
             if(texto.substring(0,1) != saida) {
             src.value+=texto.substring(0,1);}}
            }
            
            
            ```
