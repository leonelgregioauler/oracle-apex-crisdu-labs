    region notas-de-venda (
        name: Notas de Venda
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                	-- Variáveis de controle
                    v_select_1 varchar2(32767);
                    v_select_2 varchar2(32767);
                    v_select_3 varchar2(32767);
                    v_from_1   varchar2(32767);
                    v_where_1  varchar2(32767);
                    v_where_2  varchar2(32767);
                begin
                	-- Monta o Select
                	v_select_1 := ' select nv.idnotavenda
                                         , to_number(nv.numeronota) numeronota
                                         , pck_romance.fnc_nomerepresentante(pidrepresentante => nv.idrepresentante) "Representante"
                                         , nv.datanota
                                         , nv.semanadistribuicao "Semana Distribuição"
                                         , nv.semanacobranca "Semana Cobrança"
                                         , pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) "Vendedora"
                                         , pck_romance.fnc_enderecovendedora(pidvendedora => nv.idvendedora) "Endereço"   
                                         , pck_romance.fnc_nomeregiaovenda( nv.idregiaovenda ) "Região de Venda"
                                         , nv.idregiaovenda
                                         , nv.valortotalnota
                                         , nv.valortotaldevolucao
                                         , nv.idrepresentante
                                         , nv.idvendedora
                                         , nv.valortotalvenda
                                         , nv.valortotalvendalqd
                                         , nv.basecomissao
                                         , nv.perccomissao
                                         , nv.valorcomissao
                                         , nv.valorpago  valorpago
                                         , nvl(( select sum(p.valorpago)
                                                 from pagamentosnotasvendas p
                                                 where p.idnotavenda = nv.idnotavenda
                                                   and ( ( :P36_TIPO = ''Z'' )
                                                      or ( :P36_TIPO in (''C'',''P'') and p.semanacobranca = :P36_SEMANA )
                                                      or ( :P36_TIPO = ''D'' and p.idsemanacobranca = nv.idsemanacobranca ) ) ),0) pagonasemana
                                         , nv.saldo
                                         , substr(cpf,1,3)||''.''||substr(pp.cpf,4,3)||''.''||substr(pp.cpf,7,3)||''-''||substr(pp.cpf,10) "CPF. Vend."
                                         , pp.documentoestrangeiro "Doc Estrangeiro"
                                         , pck_romance.fnc_nomecidade(pp.idcidade) "Cidade. Vend."
                                         , ( select sn.descricao from situacoesnotavenda sn where sn.idsituacaonotavenda = nv.idsituacaonotavenda ) "Situação"
                                          , pck_romance.fnc_ticketmedioconsultora(nv.idvendedora) ticketmedio
                                         , decode(nv.quitadapepino,''Q'',''Quitado'',''P'',''Débito'',''R'',''Remarcada'') "Quitado/Débito"
                                         , nv.dataretorno
                                         , to_number(substr(nv.semanacobranca,1,2)) semanacobranca
                                         , to_number(substr(nv.semanacobranca,4,4)) anocobranca
                                         , pck_romance.fnc_nomerepresentante(idrepresentanteatende) "Repres. Atende"
                                         , decode(nv.enviadocobranca,''S'', ''Sim'',''Não'') "Enviado para Cobrança"
                                         , idrepresentanteatende "ID Repres Atende"
                                         , decode(nv.recuperarpromissoria,''S'',''Sim'',''Não'') recuperarpromissoria
                                         , decode(nv.promissoriarecuperada,''S'',''Sim'',''Não'') promissoriarecuperada';
                    v_select_2 := '      , case decode(promissoriarecuperada,''S'',''N'',decode(nv.recuperarpromissoria,''S'',''S'',''N''))
                                             when ''S'' THEN  ''Recup Promissória'' 
                                             else ( select ''Enviar SPC'' a 
                                                    from dual
                                                    where nv.saldo > 0
                                                      and pck_util.fnc_idsemana(trim(to_char(sysdate,''IW/RRRR''))) - nv.idsemanacobranca >=12-- > trunc(nvl(n.dataretorno,n.datanota+42))+60
                                                      and not exists ( select 1
                                                                       from pagamentosnotasvendas p
                                                                       where p.idsemanacobranca - nv.idsemanacobranca>=12 
                                                                         and p.idnotavenda = nv.idnotavenda ) )
                                                 end     cobranca
                                         , decode(v.ativo,''S'',''Ativo'',''N'',''Inativo'') "Situação Vendedora"
                                         , nv.idsemanacobranca
                                         , pck_util.fnc_idsemana(psemana => to_char(sysdate,''IW/RRRR'')) as "Idsemana Atual"
                                         , (select count(1)
                                              from notasvendas n
                                              where n.idvendedora = nv.idvendedora ) "Qtd Notas"
                                         , ( select substr(listagg(o.nome || ''-'' || t.telefone || '' - '' || t.observacao, ''/'')
                                              within group (order by t.idtelefonepessoa asc), 1, 2000)
                                              from telefonespessoas t, operadorastelefonia o
                                              where t.idpessoa = pp.idpessoa
                                               and t.idoperadoratel = o.idoperadoratel(+)
                                               and t.telefone is not null ) "Telefones"
                                         , (select sum(ii.quantidade)
                                            from itensnotavenda ii
                                            where ii.idnotavenda = nv.idnotavenda) "Qtd Dist"
                                         , (select sum(i.quantidade - nvl(i.qtddevolvida,0))
                                            from itensnotavenda i
                                            where i.idnotavenda = nv.idnotavenda
                                              and nv.idsituacaonotavenda = 4) "Qtd Vendida"
                                         , pp.nroconsultaspc "Nro Consulta SPC"
                                         , (
                                            SELECT RTRIM(
                                                     XMLAGG(
                                                       XMLELEMENT(e, oo.data||''-''||oo.observacao||'' '')
                                                       ORDER BY 1
                                                     ).EXTRACT(''//text()'').getclobval(),
                                                     '' ''
                                                   )
                                              FROM observacoesnotasvendas oo
                                             WHERE oo.idnotavenda = nv.idnotavenda
                                          ) "Histórico Cobrança"
                                         , pck_romance.fnc_nomefilial(nv.idfilial) "Filial"
                                    	 , ( select ''<a href="javascript:window.open('|| '''''''||APEX_UTIL.PREPARE_URL('||''||''''||'f?p='||''''|| ' || 2001 || '||''''||':8:'||''''||'||' ||
                                                 'v(''APP_SESSION'')||''::NO::P8_IDPESSOA:''||p.idpessoa ,''SESSION'')||' || ''''''',' || ''''''||'_blank' || '''''); ' || 
                                                 'void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" class="apex-edit-pencil" alt=""></a>''
                                             from pessoas p
                                             where p.idpessoa = ( select idpessoa                                      
                                                                  from vendedoras v
                                                                  where v.idvendedora = nv.idvendedora ) ) "Ver Cadastro"
                                         , pck_romance.fnc_verificadebito(nv.idvendedora) "Qtd Débito"
                                         , dataacerto
                                         , extract( month from nv.dataacerto) mesacerto
                                         , case
                                             when exists ( select 1
                                                           from classificacoesnotasvendas cn
                                                           where cn.idnotavenda = nv.idnotavenda
                                                             and cn.IDCARACTERISTICANOTAVENDA = 3 ) then
                                               ''Sim''
                                             else
                                               ''Não''
                                           end promissoriarecebida ';
                
                    v_select_3 := '      , decode(nv.enviocobrancaterceirizada,''S'',''Sim'',''Não'') cobrancaterceirizada
                                         , case
                                            when nv.semanacobranca = :P36_SEMANA then
                                              ''Cobrança da Semana''
                                            when nv.semanacobranca != :P36_SEMANA then
                                              ''Débito Recebido''
                                            else
                                              ''Não Acertada''
                                           end identificacao  
                                         , pck_util.fnc_idsemana(nv.semanacobranca) - nv.idsemanadistribuicao qtdsemanas
                                         , pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(nv.idrepresentante)) filial_repres
                                         , pp.email
                                         , (select count(nvv.idnotavenda)
                                              from roman.notasvendas nvv
                                             where nvl(nvv.valorpago,0) > 0
                                               and nvv.idvendedora      = nv.idvendedora
                                               and nvv.idsituacaonotavenda = 4 /*Acerto Efetuado*/) qtd_notas_acertadas
                                         , ( select tf.telefonelimpo
                                             from telefonespessoas tf
                                             where tf.idtelefonepessoa = ( select max(idtelefonepessoa)
                                                                           from telefonespessoas tt
                                                                           where tt.idpessoa = pp.idpessoa
                                                                             and tt.telefonelimpo is not null ) ) ultimo_telefone
                                          -- Maicon Aimi - 06/02/2025 - 8625972: Exibe o valor exedido do limite sacola romance
                                          , ( select c.idvalorcaracteristica
                                                from roman.classificacoesnotasvendas c
                                               where c.idcaracteristicanotavenda = 74
                                                 and c.idnotavenda = nv.idnotavenda ) as "Vlr. Exced. Sacola"
                                          , (select
                                                    case ass.situacao
                                                      when ''A'' then ''Aprovada''
                                                      when ''R'' then ''Reprovada''
                                                      else '' ''
                                                   end
                                               from roman.assinaturaseletronicas ass
                                               where ass.idnotavenda = nv.idnotavenda
                                               and rownum=1) as "Assinatura" ';
                
                
                	-- Monta o From
                	v_from_1 := ' from notasvendas nv
                                     , vendedoras v
                                     , pessoas pp';
                
                	-- Monta o Where
                	v_where_1 := ' where nv.idfilial = :P0_IDFILIAL
                                     and v.idvendedora = nv.idvendedora
                                     and pp.idpessoa = v.idpessoa
                                     
                                     ';
                    
                    -- Número da Nota
                    if :P36_NRNOTA is not null then
                        v_where_1 := v_where_1 || ' and nv.numeronota = :P36_NRNOTA';
                    end if;
                    
                    -- Representante
                    if :P36_IDREPRESENTANTE is not null then
                        v_where_1 := v_where_1 || ' and ( nv.idrepresentante = :P36_IDREPRESENTANTE or nv.idrepresentanteatende = :P36_IDREPRESENTANTE  )';
                    end if;
                
                    -- Vendedora
                    if :P36_IDVENDEDORA is not null then
                        v_where_1 := v_where_1 || ' and nv.idvendedora = :P36_IDVENDEDORA';
                    end if;
                
                    -- Região Venda
                    if :P36_REGIAOVENDA is not null then
                        v_where_1 := v_where_1 || ' and nv.idregiaovenda = :P36_REGIAOVENDA';
                    end if;
                
                    -- Histórico
                    if :P36_HISTORICO is not null then
                        v_where_1 := v_where_1 || ' and exists ( select 1
                                                               from observacoesnotasvendas o
                                                              where o.idnotavenda = nv.idnotavenda
                                                                and lower(o.observacao) like ''%'' || lower(:P36_HISTORICO) || ''%'')';
                    end if;
                
                    -- Telefone
                    if :P36_TELEFONE is not null then
                        :P36_TELEFONE := replace(replace(replace(replace(replace(:P36_TELEFONE, '(', ' '), ')', ''), '.', ''), '-', ''), ' ');
                        v_where_1 := v_where_1 || ' and exists ( select 1
                                                               from catal.telefonespessoas t
                                                              where t.idpessoa = pp.idpessoa               
                                                                and t.telefonelimpo = :P36_TELEFONE)';
                    end if;
                
                    -- Semana (Distribuição, Cobrança ou Pagamento)
                    if :P36_SEMANA is not null and :P36_TIPO in ('D','C','P') then
                
                        if :P36_TIPO = 'D' then
                            -- Semana de Distribuição
                            v_where_1 := v_where_1 || ' and nv.semanadistribuicao = :P36_SEMANA';
                
                        elsif :P36_TIPO = 'C' then
                            -- Semana de Cobrança
                            v_where_1 := v_where_1 || ' and nv.semanacobranca = :P36_SEMANA';
                
                        elsif :P36_TIPO = 'P' then
                            -- Semana de Pagamento (busca por semana de cobrança nos pagamentos)
                            v_where_1 := v_where_1 || ' and exists ( select 1 
                                                                   from pagamentosnotasvendas pg
                                                                  where pg.idnotavenda = nv.idnotavenda 
                                                                    and pg.semanacobranca = :P36_SEMANA)
                                                        and nv.idsituacaonotavenda = 4';
                        end if;
                
                    end if;
                
                    -- Débito
                    if :P36_DEBITO is not null then
                        v_where_2 := v_where_2 || ' and (    nv.saldo > 0 and nv.idsituacaonotavenda = 4 )';
                    end if;
                
                    -- Distribuidor Receb/Respons.
                    if :P36_DISTRECEBEU_RESPON is not null then
                        v_where_2 := v_where_2 || ' and nv.idsituacaocobranca = 70 ';
                    end if;
                
                    -- Número do documento
                    if :P36_NRDOCUMENTO is not null then
                        v_where_2 := v_where_2 || ' and exists ( select 1
                                                                   from parcelamentosnotasvendas p
                                                                  where p.comprovante = :P36_NRDOCUMENTO
                                                                    and p.idnotavenda = nv.idnotavenda)';
                    end if;
                
                    -- Enviado Cobrança
                    if :P36_ENVIADOCOBRANCA = 'S' then
                        v_where_2 := v_where_2 || ' and nv.enviadocobranca = ''S'' ';
                    elsif :P36_ENVIADOCOBRANCA = 'N' then
                        v_where_2 := v_where_2 || ' and nvl(nv.enviadocobranca,''N'') = ''N'' ';
                    end if;
                
                    -- Situação Cliente
                    if :P36_SITUACAOCLIENTE is not null then
                        v_where_2 := v_where_2 || ' and exists ( select 1
                                                                   from vendedoras v
                                                                  where v.idvendedora = nv.idvendedora
                                                                    and v.ativo       = :P36_SITUACAOCLIENTE )';
                    end if;
                
                    -- Possui Parcelamento
                    if :P36_PARCELAMENTO is not null then
                        v_where_2 := v_where_2 || ' and exists ( select 1
                                                                   from parcelamentosnotasvendas p
                                                                  where p.idnotavenda = nv.idnotavenda )';
                    end if;
                
                    -- Doc. Recebido
                    if :P36_DOCRECEBIDO is not null then
                        v_where_2 := v_where_2 || ' and exists ( select 1
                                                                   from pessoas pv
                                                                  where pv.documentosrecebidos = :P36_DOCRECEBIDO
                                                                    and pv.idpessoa in ( select idpessoa
                                                                                           from vendedoras v
                                                                                          where v.idvendedora = nv.idvendedora ))';
                    end if;
                
                    -- Cidade
                    if :P36_IDCIDADE is not null then
                        v_where_2 := v_where_2 || ' and exists (( select 1
                                                                    from pessoas pv 
                                                                           where pv.idcidade = :P36_IDCIDADE
                                                                             and pv.idpessoa IN ( select idpessoa 
                                                                                                    from vendedoras  v
                                                                                                   where v.idvendedora = nv.idvendedora)))';
                    end if;
                
                    -- Limite Sacola Excedido -- Maicon Aimi - 06/02/2025 - 8625972: Filtra por nota com limite sacola excedido
                    if :P36_LIMITE_SACOLA_EXCEDIDO = 'S' then
                        v_where_2 := v_where_2 || ' and exists ( select 1
                                                                   from roman.classificacoesnotasvendas c
                                                                  where c.idcaracteristicanotavenda = 74
                                                                    and c.idnotavenda = nv.idnotavenda)';
                    elsif :P36_LIMITE_SACOLA_EXCEDIDO = 'N' then
                        v_where_2 := v_where_2 || ' and not exists ( select 1
                                                                       from roman.classificacoesnotasvendas c
                                                                      where c.idcaracteristicanotavenda = 74
                                                                        and c.idnotavenda = nv.idnotavenda)';
                    end if;
                
                    -- Com pagamento zero na semana? -- T10108832 - Notas com valor pago zero na semana
                    if :P36_VALOR_PAGO_ZERO_SEMANA = 'S' then
                        v_where_2 := v_where_2 || ' and exists ( select 1 
                                                                   from roman.notasvendas nvv
                                                                      , roman.pagamentosnotasvendas pnv
                                                                  where nvv.idnotavenda = pnv.idnotavenda
                                                                    and nvv.idnotavenda = nv.idnotavenda
                                                                    and nvv.idsituacaonotavenda = 4 -- Acerto Efetuado
                                                                    and nvl(pnv.valorpago,0)    = 0
                                                                    and pnv.semanacobranca      = :P36_SEMANA)
                                                    and not exists ( select 1 
                                                                   from roman.notasvendas nvv
                                                                      , roman.pagamentosnotasvendas pnv
                                                                  where nvv.idnotavenda = pnv.idnotavenda
                                                                    and nvv.idnotavenda = nv.idnotavenda
                                                                    and nvv.idsituacaonotavenda = 4 -- Acerto Efetuado
                                                                    and nvl(pnv.valorpago,0)    > 0
                                                                    and pnv.semanacobranca      = :P36_SEMANA) ';
                    end if;
                
                    -- (Maicon) Não entendi essa bagaça, mas já existie então mantive. acho que é para não executar a query sem informar aomenos um filtro importante
                    if :P36_RELATORIOPRONTO != 'S' then
                		if :P36_IDREPRESENTANTE is null and :P36_IDVENDEDORA is null and :P36_DISTRECEBEU_RESPON is null and :P36_IDCIDADE is null then
                            if :P36_SEMANA is null or :P36_TIPO not in ('D','C','P') then
                			    v_where_2 := v_where_2 || ' and 1 = 2';
                            end if;
                		end if;
                    end if;
                
                    -- (Maicon Aimi) - 11063686 - 17/09/2025
                    if :P36_IDSITUACAONOTAVENDA is not null then
                        v_where_2 := v_where_2 || ' and nv.idsituacaonotavenda = :P36_IDSITUACAONOTAVENDA';
                    end if;
                
                    -- Para debug é só descomentar(Dúvidas, ablar com o Maicon)
                    --if v('APP_USER') in ('MAICONAIMI','DIEGOPIECHO') then
                     --   roman.prc_grava_log_debug_desenvolvedores(v_select_1,v_select_2, v_select_3, v_from_1, v_where_1, v_where_2,'xxxxxx');
                   -- end if;
                
                    -- Retona uma consulta SQL completa
                	return v_select_1 || v_select_2 || v_select_3 || v_from_1 || v_where_1 || v_where_2;
                	
                end;
                ```
            pageItemsToSubmit: [
                P0_IDFILIAL
                P36_NRNOTA
                P36_IDREPRESENTANTE
                P36_IDVENDEDORA
                P36_REGIAOVENDA
                P36_HISTORICO
                P36_TIPO
                P36_SEMANA
                P36_RELATORIOPRONTO
                P36_ENVIADOCOBRANCA
                P36_PARCELAMENTO
                P36_DOCRECEBIDO
                P36_IDCIDADE
                P36_NRDOCUMENTO
                P36_DISTRECEBEU_RESPON
            ]
        }
        layout {
            sequence: 21
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 37
                items: {
                    P37_IDNOTAVENDA: #IDNOTAVENDA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: Utilize o filtro acima.
            whenMoreDataFound: "Esta consulta retornou mais de 10000 registros. "
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column ANOCOBRANCA (
            type: plainText
            heading {
                heading: Anocobranca
                alignment: center
            }
            layout {
                sequence: 93
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: ANOCOBRANCA
                endUserAlias: AE
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Assinatura (
            type: plainText
            heading {
                heading: Assinatura
            }
            layout {
                sequence: 483
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: CF
            }
        )

        column BASECOMISSAO (
            type: plainText
            heading {
                heading: Base Comissão
                alignment: center
            }
            layout {
                sequence: 11
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: BASECOMISSAO
                endUserAlias: K
            }
            enableUsersTo {
                pivot: false
            }
        )

        column COBRANCA (
            type: plainText
            heading {
                heading: Cobranca
                alignment: center
            }
            layout {
                sequence: 233
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: COBRANCA
                endUserAlias: AW
            }
            enableUsersTo {
                pivot: false
            }
        )

        column COBRANCATERCEIRIZADA (
            type: plainText
