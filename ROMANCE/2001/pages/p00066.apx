    pageItem P66_IDFECHAMENTO (
        type: selectList
        label {
            label: Semana
            alignment: right
            tableCellAttributes: readonly
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.semana       display_value
                     , f.idfechamento return_value
                from fechamentossemanais f
                where f.idfilial =  pck_romance.fnc_filialusuario(pusuario => v('APP_USER') )
                  and ( ( :P66_IDFECHAMENTO is null 
                      /*   and nvl(f.concluido,'N') = 'N' */)
                      or f.idfechamento = :P66_IDFECHAMENTO )
                order by f.idfechamento desc
                ```
            displayNullValue: false
        }
        layout {
            sequence: 15
            region: @lucratividade
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

