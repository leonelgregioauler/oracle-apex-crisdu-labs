    pageItem P66_IDREPRESENTANTE (
        type: selectList
        label {
            label: ClienteR (*)
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) display_value
                     , r.idrepresentante return_value
                from representantes   r
                   , pessoas          p
                   , gerentes         g
                where r.idpessoa  = p.idpessoa
                  and r.idgerente = g.idgerente
                  and p.ativo     = 'S'
                  and r.ativo     = 'S'
                  and ( pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S'  or g.idfilial = pck_romance.fnc_filialusuario(pusuario => v('APP_USER') ))
                  and ( (:P66_IDREPRESENTANTE is null
                     and not exists ( select 1 
                                      from lucratividade f
                                      where f.idrepresentante = r.idrepresentante
                                        and f.idfechamento    = :P66_IDFECHAMENTO ))
                 or r.idrepresentante  = :P66_IDREPRESENTANTE)
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P66_IDFECHAMENTO
        }
        layout {
            sequence: 18
            region: @lucratividade
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P66_TOTALPEPINOSABERTOS (
        type: hidden
        layout {
            sequence: 180
            region: @lucratividade
            slot: regionBody
        }
        appearance {
            formatMask: 999G999G999G990D00
        }
        source {
            type: databaseColumn
            databaseColumn: ACUMULADOPEPINOSABERTOS
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vpepinoaberto number(15,2);
                  --
                begin
                  --
                  select nvl(sum(valor),0)
                  into vpepinoaberto
                  from pepinosrepresentantes pa
                  where pa.idfechamentorepres in ( select idfechamentorepres
                                                   from fechamentorepresentantes f
                                                   where idrepresentante = ( select idrepresentante
                                                                             from fechamentorepresentantes ff
                                                                             where ff.idfechamentorepres = :P120_IDFECHAMENTOREPRES ) )
                    and pa.situacao = 'N';
                  --
                  return vpepinoaberto;
                  --
                end;
                
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

