page 66 (
    name: Lucratividade
    title: Lucratividade
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
        executeWhenPageLoads: calculatotalliquido();
    }
    htmlHeader {
        htmlHeader:
            ```html
            <script language="JavaScript" type="text/javascript"> 
            function formatar_mascara(src,mascara,evt){
            var tecla;  
            if(evt.which){tecla = evt.which}
            else if(evt.keyCode){ tecla = evt.keyCode;}  
             if( tecla != 8 ){
             var campo = src.value.length;
             var saida = mascara.substring(0,1);
             var texto = mascara.substring(campo);
             if(texto.substring(0,1) != saida) {
             src.value+=texto.substring(0,1);}}
            }
             
            function calculatotalliquido()
            {
            
              vvlrcarga    = document.getElementById("P120_VLRCARGA").value.replace('.','');
              vvlrcarga    = vvlrcarga.replace(',','.');
              vvlrcargaad  = document.getElementById("P120_VLRCARGAADICIONAL").value.replace('.','');
              vvlrcargaad  = vvlrcargaad.replace(',','.');
              vvlrdevoucao = document.getElementById("P120_VLRDEVOLUCAO").value.replace('.','');
              vvlrdevoucao = vvlrdevoucao.replace(',','.');
            
              document.getElementById("P120_VLRTOTALLIQUIDO").value =  (eval(vvlrcarga/3.5 ) + eval(vvlrcargaad/3.5 ) - eval(vvlrdevoucao /3.5 )).toFixed(2);
              document.getElementById("P120_VLRTOTALLIQUIDO").value = document.getElementById("P120_VLRTOTALLIQUIDO").value.replace('.',',');
            }
            
            function calculacobranca()
            {
            
              vvlrcarga = document.getElementById("P120_VLRCOBRANCA").value;
              vvlrcargaad = document.getElementById("P120_VLRDEVOLUCAO").value;
            
              document.getElementById("P120_TOTALDEVOLUCAO").value =  eval(vvlrcarga ) + eval(vvlrcargaad ); 
            }
             
            
            </script>
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
