    process fetch-row-from-lucratividade (
        name: Fetch Row from LUCRATIVIDADE
        type: autoRowFetch
        source {
            tableName: LUCRATIVIDADE
            pkColumn: IDLUCRATIVIDADE
            pkItem: P66_IDLUCRATIVIDADE
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 152543764001589647
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDLUCRATIVIDADE.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P66_IDLUCRATIVIDADE := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 152543966680589648
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

