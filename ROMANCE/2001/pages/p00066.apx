    process update (
        name: "UPDATE "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidfechamentorepres  number;
                  vacumuladoant        number(15,2);
                  vidfechant           number;
                  vidrepres            number;
                  --
                begin
                  --
                  begin
                    select idrepresentante, idfechamentorepres 
                    into vidrepres, vidfechamentorepres
                    from fechamentorepresentantes
                    where idfechamentorepres = ( select idfechamentorepres from lucratividade where idlucratividade = :P66_IDLUCRATIVIDADE);
                  end;
                  --
                  begin
                    for i in (
                               select idfechamentorepres
                               from fechamentorepresentantes
                               where idrepresentante    = vidrepres
                                 and idfechamentorepres < vidfechamentorepres
                    order by 1 desc)
                    loop
                       vidfechant := i.idfechamentorepres;
                       exit;
                     end loop;
                  exception
                    when others then
                      null;
                  end;
                  --
                  begin
                    select vlracumulado
                    into vacumuladoant
                    from lucratividade
                    where idfechamentorepres = vidfechant;
                  exception
                    when others then
                      vacumuladoant := 0;
                  end;
                  --
                  update lucratividade l
                  set vlrtotal          = vlrcobranca - vlrtotalliquido
                    , vlracumulado      = nvl(vacumuladoant,0) + (vlrcobranca - vlrtotalliquido)
                    , vlrpepinosabertos = ( select nvl(sum(valor),0)
                                            from pepinosrepresentantes pa
                                            where pa.idfechamentorepres = l.idfechamentorepres
                                              and pa.situacao = 'N') 
                    , vlrpepinospagos   = ( select nvl(sum(valor),0)
                                            from pepinosrepresentantes pa
                                            where pa.idfechamentorepres = l.idfechamentorepres
                                              and pa.situacao = 'P') 
                    , acumuladopepinosabertos = ( select nvl(sum(valor),0)
                                                  from pepinosrepresentantes pa
                                                  where pa.idfechamentorepres in ( select idfechamentorepres
                                                                                   from fechamentorepresentantes f
                                                                                   where f.idfechamentorepres < :P66_IDFECHAMENTOREPRES
                                                                                     and idrepresentante = ( select idrepresentante
                                                                                                             from fechamentorepresentantes ff
                                                                                                             where ff.idfechamentorepres = :P66_IDFECHAMENTOREPRES ) )
                                                    and pa.situacao = 'N')
                    , acumuladopepinospagos  = ( select nvl(sum(valor),0)
                                                 from pepinosrepresentantes pa
                                                 where pa.idfechamentorepres in ( select idfechamentorepres
                                                                                  from fechamentorepresentantes f
                                                                                  where f.idfechamentorepres < :P66_IDFECHAMENTOREPRES
                                                                                    and idrepresentante = ( select idrepresentante
