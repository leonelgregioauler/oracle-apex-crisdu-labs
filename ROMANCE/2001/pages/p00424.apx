    pageItem P424_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecidade||' - '||e.nome||'/'||e.sigla display_value
                     , c.idcidade return_value
                from estados e
                   , cidades c
                where c.idestado = e.idestado
                  and e.idpais   = 1
                order by e.nome, c.nomecidade
                ```
