page 424 (
    name: Cadastro de Processo
    title: Cadastro de Processo
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function deletaagendamento(pid)
            {
              document.getElementById('P424_DELETAR').value = pid;
                
              var answer = confirm("Confirma o cancelamento da notificação?");
              if (answer)
                {
                  apex.submit('REMOVER');
                }
            }
            ```
    }

    region agendamentos-realizados (
        name: Agendamentos Realizados
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select a.idagendamentonotificacao
                     , decode(a.tipo,'A','Envio Geral','C','Por Cidade','F','Por Empresa') tipo
                     , a.agendadopor 
                     , a.dataagendamento
                     , case
                         when tipo = 'A' then
                           'Pais Selecionado'
                         when tipo = 'C' then
                           pck_romance.fnc_nomecidade(a.idcidade)
                         when tipo = 'F' then
                           pck_romance.fnc_nomefilial(a.idfilial)
                       end destino
                     , '<a href="javascript: deletaagendamento('||idagendamentonotificacao||')"> Cancelar </a>' cancelar 
                from agendamentonotificacoes a
                where a.idprocessonotificacao = :P424_IDPROCESSONOTIFICAVENDEDO
                ~';
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from agendamentonotificacoes a
                where a.idprocessonotificacao = :P424_IDPROCESSONOTIFICAVENDEDO
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum agendamento localizado.
        }
        advanced {
            savedReportMappingIdentifier: 122979967297616248
        }

