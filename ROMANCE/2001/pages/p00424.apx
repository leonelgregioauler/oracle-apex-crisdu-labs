    region notificações-consultoras (
        name: Notificações Consultoras
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select n.titulo
                     , n.mensagem
                     , n.datainclusao
                     , n.dataenvio
                     , n.datarecebimento
                     , initcap(pe.nomepessoa) nomepessoa
                    -- , fi.nome filial
                     , roman.pck_romance.fnc_nomefilial(n.idfilial) filial
                from notificacoesconsultoras  n
                   , processosnotificavendedoras p
                   , catal.pessoas pe
                  -- , roman.vw_filiais fi
                where n.idprocessonotificavendedora = p.idprocessonotificavendedora
                  and n.idpessoa = pe.idpessoa
                  --and n.idfilial = fi.idfilial
                  and n.idprocessonotificavendedora = :P424_IDPROCESSONOTIFICAVENDEDO
                --order by n.idnotificacao desc -- este order deixa o relatorio muito lento
                ~';
                ```
            pageItemsToSubmit: P424_IDPESSOA
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from notificacoesconsultoras  n
                where n.idprocessonotificavendedora = :P424_IDPROCESSONOTIFICAVENDEDO
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        advanced {
            savedReportMappingIdentifier: 28392076326677215
        }

