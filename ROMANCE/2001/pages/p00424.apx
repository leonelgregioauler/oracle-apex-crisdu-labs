    region notificações-enviadas (
        name: Notificações enviadas
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select n.titulo
                     , n.mensagem
                     , n.datainclusao
                     , n.dataenvio
                     , n.datarecebimento
                     , p.nomeprocesso
                from notificacoesconsultoras  n
                   , processosnotificavendedoras p
                where n.idprocessonotificavendedora = p.idprocessonotificavendedora (+)   
                  and n.idpessoa                    = 369697
                  and n.idprocessonotificavendedora = :P424_IDPROCESSONOTIFICAVENDEDO
                ~';
                ```
