    process agenda-notificações (
        name: Agenda Notificações
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vagendamento date;
                  vjob number := null;
                  vidprocesso number := :P424_IDPROCESSONOTIFICAVENDEDO;
                  vtipo varchar2(1);
                  vidagendamento number;
                  vidfilial number;
                  vidcidade number;
                  vgrupofilial varchar2(50) := null;
                  --
                begin
                  --
                  select seq_idagendamentonotificacao.nextval
                  into vidagendamento 
                  from dual;
                  --
                  if v('REQUEST') = 'DISPARAR_CIDADE' then
                    --
                    vtipo := 'C';
                    vagendamento := to_date(:P424_DATA_DISPARO,'DD/MM/RRRR HH24:MI:SS');
                    vidfilial := null;
                    vidcidade := :P424_IDCIDADE;
                    --
                  elsif v('REQUEST') = 'DISPARAR_FILIAL' then
                    --
                    vtipo := 'F';
                    vagendamento := to_date(:P424_DATA_DISPARO_FILIAL,'DD/MM/RRRR HH24:MI:SS');
                    vidfilial := :P424_IDFILIAL;
                    vidcidade := null;
                    vgrupofilial := :P424_GRUPO_FILIAL;
                    --
                  elsif v('REQUEST') = 'DISPARAR_AGENDAR' then
                    --
                    vtipo := 'A';
                    vagendamento := to_date(:P424_DATA_DISPARO_AGENDAR,'DD/MM/RRRR HH24:MI:SS');
                    vidfilial    := null;
                    vidcidade    := null;
                    --
                  end if;
                  --
                  if vtipo in ('C','F') then
                    --
                    pck_appminhasacola.prc_agendanotificacao_nova( pidprocesso => vidprocesso,
                                                                   ptipo       => vtipo,
                                                                   pidcidade   => vidcidade,
                                                                   pidfilial   => vidfilial,
                                                                   pdata       => vagendamento,
                                                                   pidagendamento => vidagendamento,
                                                                   pgrupofilial => vgrupofilial);
                    --
                  elsif vtipo = 'A' then
                    --
                    dbms_job.submit( job       => vjob,
                                     what      => 'begin prc_geranotificacao_ecomm('||vidprocesso||'); end;',
                                     next_date => vagendamento);
                    --
                  end if;
                  --
                  insert into agendamentonotificacoes ( idagendamentonotificacao , idprocessonotificacao
                                                      , tipo                     , agendadopor
                                                      , dataagendamento          , idcidade
                                                      , idfilial                 , nrjob 
                                                      , grupofilial)
                  values ( vidagendamento , vidprocesso
                         , vtipo          , v('APP_USER')
                         , vagendamento   , vidcidade
                         , vidfilial      , vjob 
                         , vgrupofilial);
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 7208783408177666
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('DISPARAR_CIDADE','DISPARAR_FILIAL','DISPARAR_AGENDAR')
        }
    )

