page 225 (
    name: Itens Distribuidos na Semana
    title: Itens Distribuidos na Semana
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 80%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region itens-distribuidos-na-semana (
        name: Itens Distribuidos na Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) represente
                     , t.semanadistribuicao
                     , produto
                     , t.idestoquefil
                     , (select sum(nvl(qtd_dist_pp ,0) 
                             + nvl(qtd_dist_p ,0)  
                             + nvl(qtd_dist_m ,0)  
                             + nvl(qtd_dist_g ,0)
                             + nvl(qtd_dist_gg,0)  
                             + nvl(qtd_dist_egg,0) 
                             + nvl(qtd_dist_exgg,0) 
                             + nvl(qtd_dist_u,0) )  qtd_dist_TOTAL
                        from itenscargarepresentante i
                        where i.idestoquefil = t.idestoquefil
                          and i.idcargarepresentante = (select c.idcargarepresentante
                                                        from cargasrepresentantes c
                                                        where c.idrepresentante = :P225_IDREPRESENTANTE
                                                          and c.situacao != 0
                                                          and c.semana = :P225_SEMANACOBRANCA)) "Qtd na Carga"
                     , sum(distribuido) distribuido
                     , sum(t.valordistribuido) valordistribuido
                from vw_produtosdistribuidos t
                where idrepresentante  = :P225_IDREPRESENTANTE
                  and t.semanadistribuicao = :P225_SEMANACOBRANCA
                group by pck_romance.fnc_nomerepresentante(idrepresentante) 
                     , t.semanadistribuicao
                     , produto  
                     , t.idestoquefil
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 47345381440387118
        }

        column DISTRIBUIDO (
            type: plainText
            heading {
