page 722 (
    name: Acessos Assinatura Eletrônica
    title: Acessos Assinatura Eletrônica
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acessos-assinatura-eletrônica (
        name: Acessos Assinatura Eletrônica
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pr.IDPARAMETROREPRES,
                      pr.IDCADASTROPARAMETRO,
                      pr.IDREPRESENTANTE,
                      initcap(pe.nomepessoa) representante,
                      pr.PARAMETRO,
                      --decode(pr.VALOR,'Z','Permitido','Não Permitido') Permitido,
                      pr.VALOR
                from ROMAN.PARAMETROSREPRESENTANTES PR
                    ,catal.representantes re
                    ,catal.pessoas pe
                where pr.idrepresentante = re.idrepresentante
                  and re.idpessoa = pe.idpessoa
                  and pr.idcadastroparametro = 432
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 2120624703782665602
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDPARAMETROREPRES
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDCADASTROPARAMETRO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDREPRESENTANTE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @REPRESENTANTE
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @PARAMETRO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @VALOR
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDCADASTROPARAMETRO (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDCADASTROPARAMETRO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDPARAMETROREPRES (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDPARAMETROREPRES
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDREPRESENTANTE (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDREPRESENTANTE
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column PARAMETRO (
            type: hidden
            layout {
                sequence: 70
            }
            source {
                databaseColumn: PARAMETRO
                dataType: varchar2
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column REPRESENTANTE (
            type: displayOnly
            heading {
                heading: Representante
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: REPRESENTANTE
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column VALOR (
            type: selectList
            heading {
                heading: Acesso
            }
            lov {
                type: staticValues
                staticValues: STATIC:Permitido;Z,Não Permitido;N
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: VALOR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            enableUsersTo {
                sort: false
            }
        )

    )

    process acessos-assinatura-eletrônica-save-interactive-grid-data (
        name: Acessos Assinatura Eletrônica - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @acessos-assinatura-eletrônica
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2120625716618665612
        }
    )

)

