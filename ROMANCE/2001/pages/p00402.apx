    region reembalagem-por-produto (
        name: Reembalagem por Produto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select initcap( nvl(p.apelido,p.nomepessoa ) ) 
                         from filiais f
                            , pessoas p
                         where f.idpessoa = p.idpessoa
                           and f.idfilial = e.idfilial ) "Filial"
                     , ( select ca.nome
                         from categorias ca
                         where ca.idcategoria = ( select pr.idcategoria 
                                                 from produtos    pr
                                                 where pr.idproduto = e.idproduto ) ) "Categoria"
                     , ( select codigosisdist 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Código"   
                     , ( select initcap( pr.nomeproduto ) 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Produto"         
                     , ( select c.descricao 
                         from cores c
                         where c.idcor = e.idcor ) "Cor"
                     , e.idestoquefilial
                     , e.idfilial
                     , e.idproduto
                     , e.idcor
                     , me.qtd_pp   
                     , me.qtd_p    
                     , me.qtd_m    
                     , me.qtd_g    
                     , me.qtd_gg   
                     , me.qtd_egg  
                     , me.qtd_exgg
                     , me.qtd_u    
                     , me.observacao    "Observação"
                     , me.usuario       "Usuário"
                     , me.datamovimento "Data Movimento"
                     , me.embaladopor
                     , me.idmovtoestreemb
                     , pck_util.fnc_semanaid(pck_util.fnc_idsemanadata(trunc(me.datamovimento))) semana
                from estoquefilial           e
                   , estoquereembalagem    er
                   , movimentosestoquereemb me
                where e.idestoquefilial  = er.idestoquefil
                  and e.idestoquefilial  = me.idestoquefil
                  and e.idfilial = :P0_IDFILIAL
                  and ( :P402_EMBALADOPOR is null or me.embaladopor = :P402_EMBAPADOPOR )
                  and me.TRANSFEREPARAESTOQUE = 'D'
                  and :P402_TIPORELATORIO = 'P'
                  and ( :P402_TIPODATA is null 
                      or ( :P402_TIPODATA = 'S' and me.idsemana between :P402_SEMANAINICIO and :P402_SEMANAFIM )
                      or ( :P402_TIPODATA = 'D' and trunc(me.datamovimento) between to_date(:P402_DATAINICIO) and to_date(:P402_DATAFIM) ) )
                order by me.datamovimento desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P402_TIPORELATORIO
            value: P
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhuma movimentação encontrada!
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
