    region reembalagem-resumido-por-data (
        name: Reembalagem Resumido Por Data
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select mr.embaladopor
                     , trunc(mr.datamovimento) datamovimento
                     , sum( nvl(mr.qtd_pp,0)
                          + nvl(mr.qtd_p,0)
                          + nvl(mr.qtd_m,0)
                          + nvl(mr.qtd_g,0)
                          + nvl(mr.qtd_gg,0)
                          + nvl(mr.qtd_egg,0)
                          + nvl(mr.qtd_exgg,0)
                          + nvl(mr.qtd_u,0) )*-1 qtdmovimentada
                from movimentosestoquereemb mr
                   , produtos p
                   , estoquefilial e
                where e.idestoquefilial = mr.idestoquefil
                  and e.idfilial        = :P0_IDFILIAL
                  and p.idproduto       = e.idproduto
                  and trunc(mr.datamovimento) between to_date(:P402_DATAINICIO) and to_date(:P402_DATAFIM)
                  and :P402_TIPORELATORIO = 'R'
                  and mr.TRANSFEREPARAESTOQUE = 'D'
                  and ( :P402_EMBALADOPOR is null or mr.embaladopor = :P402_EMBALADOPOR )
                group by mr.embaladopor , trunc(mr.datamovimento)
                order by 1, 2
                ```
        }
        layout {
            sequence: 40
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
