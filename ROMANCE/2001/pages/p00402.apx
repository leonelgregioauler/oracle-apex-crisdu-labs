    region reembalagem-categoria-por-semana (
        name: Reembalagem Categoria Por Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select mr.embaladopor
                     , pck_romance.fnc_nomecategoria(p.idcategoria) categoria
                     , pck_util.fnc_semanaid(mr.idsemana) semana
                     , sum( nvl(mr.qtd_pp,0)
                          + nvl(mr.qtd_p,0)
                          + nvl(mr.qtd_m,0)
                          + nvl(mr.qtd_g,0)
                          + nvl(mr.qtd_gg,0)
                          + nvl(mr.qtd_egg,0)
                          + nvl(mr.qtd_exgg,0)
                          + nvl(mr.qtd_u,0) )*-1 qtdmovimentada
                from movimentosestoquereemb mr
                   , produtos p
                   , estoquefilial e
                where e.idestoquefilial = mr.idestoquefil
                  and e.idfilial        = :P0_IDFILIAL
                  and p.idproduto       = e.idproduto
                  and :P402_TIPORELATORIO = 'D'
                  and mr.TRANSFEREPARAESTOQUE = 'D'
                  and ( :P402_EMBALADOPOR is null or mr.embaladopor = :P402_EMBALADOPOR )
                  and mr.idsemana between :P402_SEMANAINICIO and :P402_SEMANAFIM
                group by mr.embaladopor , p.idcategoria , mr.idsemana
                order by 1, 2
                ```
        }
        layout {
            sequence: 50
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P402_TIPORELATORIO = 'D' 
                  and :P402_TIPODATA = 'S'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
