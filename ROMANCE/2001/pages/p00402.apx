    region resumo (
        name: Resumo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util.fnc_semanaid(s.idsemana) semana
                     , nvl(dev.qtd,0) devolucao
                     , nvl(emb.qtd,0) embalagem
                     , nvl(dev.qtd,0) - nvl(emb.qtd,0) saldo
                from semana_dias s
                   , ( select d.idsemana
                            , sum( nvl(it.qtd_pp,0)
                                 + nvl(it.qtd_p,0)
                                 + nvl(it.qtd_m,0)
                                 + nvl(it.qtd_g,0)
                                 + nvl(it.qtd_gg,0)
                                 + nvl(it.qtd_egg,0)
                                 + nvl(it.qtd_exgg,0)
                                 + nvl(it.qtd_u,0)) qtd
                       from devolucoesrepresentantes d
                          , itensdevolucaorepres it
                       where it.iddevolucaorepres = d.iddevolucaorepres
                         and it.estoquedestino    = 'R'
                         and d.idfilial           = :P0_IDFILIAL
                       group by d.idsemana ) dev
                   , ( select mr.idsemana 
                            , sum( nvl(mr.qtd_pp,0)
                                 + nvl(mr.qtd_p,0)
                                 + nvl(mr.qtd_m,0)
                                 + nvl(mr.qtd_g,0)
                                 + nvl(mr.qtd_gg,0)
                                 + nvl(mr.qtd_egg,0)
                                 + nvl(mr.qtd_exgg,0)
                                 + nvl(mr.qtd_u,0) )*-1 qtd
                       from movimentosestoquereemb mr
                       where mr.idfilial = :P0_IDFILIAL
                         and mr.transfereparaestoque = 'D'
                       group by mr.idsemana ) emb
                where s.idsemana between pck_util.fnc_idsemanadata(sysdate)-4 and pck_util.fnc_idsemanadata(sysdate)
                  and emb.idsemana(+) = s.idsemana
                  and dev.idsemana(+) = s.idsemana
                order by s.idsemana desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h240
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
