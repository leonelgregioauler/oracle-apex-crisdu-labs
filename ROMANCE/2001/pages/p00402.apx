    pageItem P402_EMBALADOPOR (
        type: selectList
        label {
            label: Embalado Por
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ' DUPLA' d
                     , 'DUPLA' r
                from dual
                where exists ( select 1
                               from parametros p
                               where p.idfilial = :P0_IDFILIAL 
                                 and p.nome = 'REEMBALAGEMPOREQUIPE'
                                 and p.valor = 'S' )
                union
                select ' TRIO' d
                     , 'TRIO' r
                from dual
                where exists ( select 1
                               from parametros p
                               where p.idfilial = :P0_IDFILIAL 
                                 and p.nome = 'REEMBALAGEMPOREQUIPE'
                                 and p.valor = 'S' )
                union
                select ' EQUIPE' d
                     , 'EQUIPE' r
                from dual
                where exists ( select 1
                               from parametros p
                               where p.idfilial = :P0_IDFILIAL 
                                 and p.nome = 'REEMBALAGEMPOREQUIPE'
                                 and p.valor = 'S' )
                union
                select ' FREELANCER' d
                     , 'FREELANCER' r
                from dual
                union
                select ' FREELANCER2' d
                     , 'FREELANCER2' r
                from dual
                union
                select ' FREELANCER3' d
                     , 'FREELANCER3' r
                from dual
                union
                select ' PEÇAS PRONTAS' d
                     , 'PEÇASPRONTRAS' r
                from dual
                union
                select pck_romance.fnc_nomepessoa(f.idpessoa) nome
                     , f.identificacao
                from funcionarios f
                where f.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                  and f.idcargo in (0,7)
                  and f.ativo     = 'S' 
                  and f.identificacao is not null
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

