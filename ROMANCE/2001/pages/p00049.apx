page 49 (
    name: Lista de Pedidos para Entrega
    title: Lista de Pedidos para Entrega
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region impressão (
        name: Impressão
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_imprime.prc_imprimepedidosfeitos ( :P49_TIPODATA
                                                       , :P49_DATAINI
                                                       , :P49_DATAFIM
                                                       , :P49_IDREPRESENTANTE );
                end;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P49_DATAFIM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @impressão
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P49_DATAINI (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @impressão
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P49_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @impressão
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P49_TIPODATA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @impressão
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

