page 126 (
    name: Reembalagem PA
    title: Reembalagem PA
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region por-categoria (
        name: Por Categoria
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select id
                    , display_value
                    , return_value
                from (
                      select null id
                           , ( select c.nome
                               from categorias c 
                               where c.idcategoria = p.idcategoria) display_value
                            , sum(nvl(ep.qtd_pp,0)+nvl(ep.qtd_p,0)+nvl(ep.qtd_m,0)+nvl(ep.qtd_g,0)+nvl(ep.qtd_gg,0)+nvl(ep.qtd_egg,0)+nvl(ep.qtd_exgg,0)+nvl(ep.qtd_u,0)) return_value
                      from estoquefilial e
                         , produtos p
                          , estoquepostoavancadoreemb ep
                      where e.idproduto = p.idproduto
                        and e.idfilial = :P0_IDFILIAL
                         and ep.idpostoavancado = :P126_IDPOSTOAVANCADO 
                      group by p.idcategoria
                      order by 3 desc)
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DISPLAY_VALUE
            valueColumn: RETURN_VALUE
        }
    )

    region posto-avançado (
        name: Posto Avançado
        type: list
        source {
            list: @estoque-pa-reemb-d
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

    region posto-avançado-2 (
        name: Posto Avançado
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region top-5-produto-em-estoque (
        name: Top 5 Produto em Estoque
        type: plugin/d3BarChart
        source {
            sqlQuery:
                ```sql
                select id
                    , display_value
                    , return_value
                from ( select null id
                            , pck_romance.fnc_nomeproduto(idproduto) display_value
                            , sum(nvl(ep.qtd_pp,0)+nvl(ep.qtd_p,0)+nvl(ep.qtd_m,0)+nvl(ep.qtd_g,0)+nvl(ep.qtd_gg,0)+nvl(ep.qtd_egg,0)+nvl(ep.qtd_exgg,0)+nvl(ep.qtd_u,0)) return_value
                       from estoquefilial e
                          , estoquepostoavancadoreemb ep
                       where e.idestoquefilial  = ep.idestoquefil
                         and e.idfilial         = :P0_IDFILIAL
                         and ep.idpostoavancado = :P126_IDPOSTOAVANCADO 
                       group by idproduto
                       order by 3 desc )
                where rownum <=5
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            xValuesColumn: DISPLAY_VALUE
            yValuesColumn: RETURN_VALUE
            seriesName: Top 5
            valueFormatMask: attributeValue
            tooltips: showYValue
            colorScheme: modern2
        }
    )

    pageItem P126_IDPOSTOAVANCADO (
        type: radioGroup
        label {
            label: P.A.
            alignment: left
        }
        settings {
            noOfCols: 3
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nome) display_value
                     , idpostoavancado return_value
                from postoavancado 
                where idfilial = :P0_IDFILIAL
                  and ativo = 'S'
                  and ( ( :P0_IDPOSTOAVANCADO is not null and idpostoavancado = :P0_IDPOSTOAVANCADO )
                       or (:P0_IDPOSTOAVANCADO is null ) )
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @posto-avançado-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: item
            item: P126_IDPOSTOAVANCADO
        }
        security {
            encryptSessionState: false
        }
    )

    branch (
        name: 3
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 126
                items: {
                    P126_IDPOSTOAVANCADO: &P126_IDPOSTOAVANCADO.
                    P0_IDFILIAL: &P0_IDFILIAL.
                }
                action: resetPagination
            }
        }
    )

)

