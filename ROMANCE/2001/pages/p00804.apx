page 804 (
    name: Relatório de Brindes Por Campanha
    title: Relatório de Brindes Por Campanha
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region relatório-brindes-por-campanha (
        name: "Relatório Brindes Por Campanha "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select (select cp.nomecampanha
                        from roman.campanhasconquistoulevou cp
                        where cp.idconquistoulevou = gb.idconquistoulevou) campanha
                     , b.nomebrinde
                     , ( select cl.nomeclassif
                         from roman.conquistoulevouclassificacoes cl 
                         where cl.idclassificacao = ic.idclassificacao) classificação 
                     , ( select cc.nomecaracteristica
                         from roman.conquistoulevoucaracteristicas cc
                         where cc.idcaracteristica = ic.idcaracteristica) caracteristica
                     , count(b.idbrindeclube) QTD
                from roman.guiasentregasbrindes gb 
                   , roman.guiasentregascupons gc
                   , roman.itensconqlevcupons ic
                   , roman.brindesclub b 
                where gb.idguiaentregabrinde = gc.idguiaentregabrinde
                  and gc.idconquistoulevoucupom = ic.idconquistoulevoucupom
                  and b.idbrindeclube = ic.idbrindeclube
                  and gb.dataemissao is not null
                /*  and exists ( select 1 
                               from roman.campanhasconquistoulevou cp 
                               where cp.idconquistoulevou = gb.idconquistoulevou
                                 and cp.status = 'S')*/
                group by gb.idconquistoulevou ,b.nomebrinde, ic.idclassificacao ,ic.idcaracteristica
                order by 2,3,4
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        comments {
            comments: "Lista de todos os brindes por campanha, para acompanhamento da quantidade total de brindes resgatados na campanha. "
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1803379087776160904
        }

        column CAMPANHA (
            type: plainText
            heading {
                heading: Campanha
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column CARACTERISTICA (
            type: plainText
            heading {
                heading: Caracteristica
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column CLASSIFICAÇÃO (
            type: plainText
            heading {
                heading: Classificação
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column NOMEBRINDE (
            type: plainText
            heading {
                heading: Brinde
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column QTD (
            type: plainText
            heading {
                heading: Qtd
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 18034073 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CAMPANHA (
                sequence: 1
            )

            displayColumn CARACTERISTICA (
                sequence: 4
            )

            displayColumn CLASSIFICAÇÃO (
                sequence: 3
            )

            displayColumn NOMEBRINDE (
                sequence: 2
            )

            displayColumn QTD (
                sequence: 5
            )

            controlBreak (
                column: CAMPANHA
                layout {
                    sequence: 1
                }
            )

        )

    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 806
                clearCache: 806
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

