page 642 (
    name: Detalhes da Categoria
    title: Vendedores(as) do Distribuidor
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 60%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region itens (
        name: Itens
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    region vendedores (
        name: Vendedores
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vendedora, cpf, pontos, data_minimo, data_maximo
                  from (
                         select p.nomepessoa vendedora 
                              , p.cpf CPF
                              , v.idvendedora 
                              , sum(h.pontos) pontos
                              , case when trunc(sum(h.pontos)) > 9999 then '4'
                                     when trunc(sum(h.pontos)) between 3000 and 4999 then '2'
                                     when trunc(sum(h.pontos)) between 5000 and 9999 then '3'
                                else
                                     '1'
                                end idcategoria
                       , ( select nvl(to_char ( min(rg.datalogin),'dd/mm/rrrr hh24:mi:ss'),'Sem login')
                           from roman.registrosloginminhasacola rg
                           where v.idvendedora = rg.idvendedora) data_minimo
                       , ( select nvl(to_char ( max(rg.datalogin),'dd/mm/rrrr hh24:mi:ss'),'Sem login')   
                           from roman.registrosloginminhasacola rg
                           where v.idvendedora = rg.idvendedora) data_maximo
                                  from historicospontospremios h
                                     , catal.vendedoras        v
                                     , catal.pessoas           p
                                     , roman.mei               m
                                     , representantes          r
                                     , catal.pessoas           pr
                                 where h.idvendedora     = v.idvendedora
                                   and v.idrepresentante = r.idrepresentante
                                   and v.idpessoa        = p.idpessoa     
                                   and v.idfilial        = :P0_IDFILIAL
                                   and v.ativo = 'S'
                                   and ( :P641_IDCIDADE is null or p.idcidade = :P641_IDCIDADE )
                
                                   and r.idpessoa = pr.idpessoa
                                   and r.idpessoa = m.idpessoa (+)
                                   and r.idrepresentante = :P642_IDREPRESENTANTE
                
                                   and h.data between (select to_date(dt_ini||' 00:00:01','dd/mm/rrrr hh24:mi:ss')  
                                                         from semana_dias where idsemana = :P641_IDSEMANAINI)
                                                  and (select to_date(dt_fim||' 23:59:59','dd/mm/rrrr hh24:mi:ss') 
                                                         from semana_dias where idsemana = :P641_IDSEMANAFIM)
                                   and nvl(h.pontos,0) > 0
                                  group by p.nomepessoa, v.idvendedora ,p.cpf) xx
                  where xx.idcategoria = :P642_CATEGORIA
                
                ```
            pageItemsToSubmit: [
                P642_CATEGORIA
                P642_IDREPRESENTANTE
                P642_IDSEMANAINI
                P642_IDSEMANAFIM
            ]
        }
        layout {
            sequence: 20
            slot: contentBody
            column: 2
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: showAll
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
        }

        column CPF (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: CPF
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column DATA_MAXIMO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Último Login
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column DATA_MINIMO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Primeiro Login
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column PONTOS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Pontos
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column VENDEDORA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Vendedora
            }
            layout {
                sequence: 1
            }
            sorting {
                defaultSequence: 1
            }
        )

    )

    pageItem P642_CATEGORIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @itens
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P642_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @itens
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P642_IDSEMANAFIM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @itens
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P642_IDSEMANAINI (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @itens
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P642_REPRESENTANTE (
        type: displayOnly
        label {
            label: Distribuidor
            alignment: left
        }
        layout {
            sequence: 40
            region: @itens
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

)

