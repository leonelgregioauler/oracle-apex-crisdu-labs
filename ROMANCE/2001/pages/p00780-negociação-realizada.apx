                begin
                  --
                  if v('REQUEST') = 'QUITAR' then
                    vsituacao := 'Q';
                  elsif v('REQUEST') = 'VENCIDO' then
                    vsituacao := 'V';
                  end if;
                  --
                  pck_negociacoes_rmc.prc_atualizaparcela_acordo( pidpagamentonegociacao => :P780_IDEDITAR,
                                                                  psituacao              => vsituacao,
                                                                  pidusuario             => :P0_IDUSUARIO);
