    region negociação-parceiro (
        name: Negociação Parceiro
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.idnegociacaoparceiro
                     , n.idfilial
                     , pck_romance.fnc_nomefilial(n.idfilial) nomefilial
                     , n.idvendedora
                     , pck_romance.fnc_nomevendedora(n.idvendedora)||' (CPF: '||roman.pck_romance.fnc_cpfvendedora(N.idvendedora)||')' consultora
                     , n.valornegociacao
                     , nvl(n.valorpago,0) valorpago
                     , n.idusuarioresponsavel
                     , favorita.pck_util_fav.fnc_nomeusuario(n.idusuarioresponsavel) usuarioresponsavel
                     , n.idrepresentante
                     , pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                     , n.datanegociacao
                     , n.qtdparcelas
                     , n.formapagamento
                     , decode(n.formapagamento, 'D', 'Deposito', 'C', 'Cartao de Credito','B','BOLETO','P','PIX','Outro') formapagamentodescr
                     , n.observacao
                     , n.tid
                     , n.nsu
                  from roman.negociacoesparceiros n
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        readOnly {
            type: item=value
            item: P780_IDNEGOCIACAOPARCEIRO
            value: -1
        }
    )

    region pagamentos-da-negociação (
        name: Pagamentos da Negociação
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT P.IDPAGAMENTONEGOCIACAOPARCEIRO
                     , P.IDNEGOCIACAOPARCEIRO
                     , P.NUMEROPARCELA
                     , P.DATAVENCIMENTO
                     , P.VALORPARCELA
                     , DECODE(P.SITUACAO,'E','EM ESPERA','A','ABERTO','V','VENCIDO','Q','QUITADO', 'C','CANCELADO') SITUACAO
                     , P.COMPROVANTE
                     , P.DATABAIXA
                     , P.DATAPAGAMENTO
                     , case 
                         when situacao in ('A','E','V') then -- Maicon Aimi - 12/03/2025 - 9924583 (removido do IN a situação 'C')
                           '<a href="javascript:fnc_quitar('|| IDPAGAMENTONEGOCIACAOPARCEIRO ||')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         else 
                           null
                       end QUITAR
                     , case 
                         when situacao in ('A','E') then 
                           '<a href="javascript:fnc_vencido('|| IDPAGAMENTONEGOCIACAOPARCEIRO ||')" ><img src="#APP_IMAGES#Deslike.png"  border="0"></a>'
                         else
                           null
                       end VENCIDO
                FROM PAGAMENTOSNEGOCIACOESPARCEIROS P
                WHERE P.IDNEGOCIACAOPARCEIRO = :P780_IDNEGOCIACAOPARCEIRO
                ORDER BY 3
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
