page 780 (
    name: Negociação Realizada
    alias: NEGOCIAÇÃO-REALIZADA
    title: Negociação Realizada
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1000
        height: 800
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_quitar(pid)
            {
              document.getElementById("P780_IDEDITAR").value = pid;
              apex.submit('QUITAR');
            }
            
            function fnc_vencido(pid)
            {
              document.getElementById("P780_IDEDITAR").value = pid;
              apex.submit('VENCIDO');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region documento-negociação (
        name: Documento Negociação
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomevendedora(dn.idvendedora) Pessoa
                     , dn.cpf
                     , case
                         when dn.idnotavenda is not null then
                           'Sacola Romance'
                         when dn.idpedido is not null then
                           'Pedido Favorita'
                         when dn.idboleto is not null then
                           'Pedido Catalogo'
                         when dn.idpepinorepres is not null then
                           'Pepino Antigo'
                           else
                             (select o.descricao
                                from roman.origenscobranca o
                               where o.origemcobranca = np.origem)
                       end origem
                     , dn.valor
                  from roman.negociacoesparceiros np
                     , roman.documentosnegociacao dn
                     , roman.debitosdiversos dd
                 where np.idnegociacaoparceiro = dn.idnegociacaoparceiro
                   and dn.iddiverso = dd.iddebitodiverso
                   and dn.idnegociacaoparceiro = :P780_IDNEGOCIACAOPARCEIRO
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1072908739981467232
        }

