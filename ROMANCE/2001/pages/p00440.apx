page 440 (
    name: Notas Enviadas Automaticamente
    title: Notas Enviadas Automaticamente
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region notas-enviadas-automaticamente (
        name: Notas Enviadas Automaticamente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , pck_romance.fnc_nomefilial(nv.idfilial) empresa
                     , pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(nv.idvendedora) consultora
                     , ( select p.documentoestrangeiro
                         from pessoas p
                            , vendedoras v
                         where v.idvendedora = nv.idvendedora 
                           and v.idpessoa    = p.idpessoa ) documento
                     , pck_romance.fnc_retornatelefones(nv.idvendedora) telefones
                     , nv.numeronota
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.valortotalnota
                     , nv.valortotaldevolucao
                     , nv.valortotalvendalqd
                     , nv.valorpago
                     , nv.saldo
                     , nv.dataenviocobrancaterc
                     , case 
                         when not exists ( select 1
                                           from favorita.tarefas t
                                              , vendedoras v
                                           where t.idpessoa = v.idpessoa
                                             and v.idvendedora = nv.idvendedora
                                             and t.idtipotarefa = 28
                                             and t.idsituacao in (0,10,20) ) then   
                           '<a href="javascript:apex.confirm(''Deseja gerar Tarefa da nota '||nv.numeronota||'?'', { request:''GERARTAREFA'',set:{''P440_IDEDITAR'':'||nv.idnotavenda||'}})";><img src=/i/menu/pencil16x16.gif alt=Excluir Caract. border=0 width=16 height=16></a>'  
                         else
                           'Tarefa Já Gerada'
                       end gerartarefa
                from notasvendas nv
                where nv.enviocobrancaterceirizada = 'S'
                  and nv.envioautomatico           = 'S'
                  and nv.idfilial = :P440_IDFILIAL 
                  and ( :P440_IDREPRESENTANTE is null or nv.idrepresentante = :P440_IDREPRESENTANTE )
                  and ( :P440_IDVENDEDORA is null or nv.idvendedora = :P440_IDVENDEDORA )
                  and ( :P440_DATAINICIO is null or trunc(nv.dataenviocobrancaterc) between to_date(:P440_DATAINICIO) and to_date(:P440_DATAFIM) )
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
