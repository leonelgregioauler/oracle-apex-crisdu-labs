    pageItem P440_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where exists ( select 1
                               from usuariosfiliais u
                               where u.idfilial = f.idfilial
                                 and u.usuario  = v('APP_USER') )
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' - '||decode(r.ativo,'S','Ativo','N','Inativo') d
                     , idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P440_IDFILIAL )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P440_IDFILIAL
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_IDVENDEDORA (
        type: selectList
        label {
            label: Consultora
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' (CI: '||p.documentoestrangeiro||')' r
                     , v.idvendedora d
                from vendedoras v
                   , pessoas p
                where v.idpessoa = p.idpessoa
                  and v.idrepresentante = :P440_IDREPRESENTANTE
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P440_IDREPRESENTANTE
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
