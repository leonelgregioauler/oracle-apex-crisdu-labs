    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process gerar-tarefa (
        name: Gerar Tarefa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidnotavenda number;
                  vidpessoa    number;
                  vtelefone    varchar2(30);
                  vidgrupoatendimento number;
                begin 
                  --
                  if :P440_IDFILIAL = 1095 then
                    vidgrupoatendimento := 26;
                  elsif :P440_IDFILIAL = 1111 then
                    vidgrupoatendimento := 27;
                  elsif :P440_IDFILIAL = 1081 then
                    vidgrupoatendimento := 28;
                  end if;
                  --
                  select v.idpessoa
                  into vidpessoa
                  from vendedoras v
                     , notasvendas nv 
                  where v.idvendedora = nv.idvendedora
                    and nv.idnotavenda = :P440_IDEDITAR;
                  --
                  begin
                    --
                    select translate(t.telefone,'0123456789AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvXxYyWwZz_-,.  !@#$%?&*()/??','0123456789') telefone
                    into vtelefone
                    from telefonespessoas t
                    where t.idpessoa = vidpessoa
                      and rownum = 1;
                    --
                  exception 
                    when NO_DATA_FOUND then
                      vtelefone := null;
                  end;
                  --
                  insert into favorita.tarefas ( idtarefa            , datainclusao    , idsituacao
                                               , observacao          , idtipotarefa    , idpessoa
                                               , idgrupoatendimento  , telefone        , idusuario )
                  values ( favorita.seq_idtarefa.nextval ,   sysdate ,  0
                         , pck_util.fnc_retornatelefones(vidpessoa) , 28 , vidpessoa
                         , vidgrupoatendimento , vtelefone , null ); 
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1501358849276848344
        }
        serverSideCondition {
            type: request=Value
            value: GERARTAREFA
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 440
                items: {
                    P440_IDFILIAL: &P440_IDFILIAL.
                    P440_IDREPRESENTANTE: &P440_IDREPRESENTANTE.
                    P440_IDVENDEDORA: &P440_IDVENDEDORA.
                    P440_DATAINICIO: &P440_DATAINICIO.
                    P440_DATAFIM: &P440_DATAFIM.
                }
                action: resetPagination
            }
        }
    )

)

