page 701 (
    name: Edição Motivo Painel Leads
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region edição-motivo-painel-leads (
        name: Edição Motivo Painel Leads
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P701_IDMOTIVOPAINELLEADS (
        type: hidden
        layout {
            sequence: 10
            region: @edição-motivo-painel-leads
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P701_MOTIVO (
        type: textField
        label {
            label: Motivo
            alignment: left
        }
        layout {
            sequence: 20
            region: @edição-motivo-painel-leads
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: MOTIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P701_TIPO (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Conclusão;C,Devolução ;D
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @edição-motivo-painel-leads
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: TIPO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 10
            region: @edição-motivo-painel-leads
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @edição-motivo-painel-leads
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process atualiza-motivo (
        name: Atualiza Motivo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 
                 vidmotivopainelleads number := :P701_IDMOTIVOPAINELLEADS;
                 vmotivo              varchar2(100) := :P701_MOTIVO;
                 vtipo                varchar2(1) := :P701_TIPO;
                 voperacao_dml        varchar2(1) := 'U';
                 vmd5                 varchar2(32767) := null;
                
                
                begin
                
                pck_cadastros_rmc.prc_motivospainelleads(pidmotivopainelleads => vidmotivopainelleads,
                                                           pmotivo => vmotivo,
                                                           ptipo => vtipo,
                                                           pmd5 => :pmd5,
                                                           poperacao_dml => voperacao_dml);
                                                               
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Alterações realizadas com sucesso!
        }
        error {
            errorMessage: Problemas ao tentar atualizar!
        }
        advanced {
            executionMappingIdentifier: 1503264871249338316
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

    process new (
        name: New
        type: autoRowFetch
        source {
            tableName: MOTIVOSPAINELLEADS
            pkColumn: IDMOTIVOPAINELLEADS
            pkItem: P701_IDMOTIVOPAINELLEADS
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1503264488006338312
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 700
                action: resetPagination
            }
        }
    )

)

