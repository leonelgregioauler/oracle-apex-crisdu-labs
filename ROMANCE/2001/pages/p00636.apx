page 636 (
    name: Atualizar Cadastro
    title: Atualizar Cadastro
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region atualizar-cadastro (
        name: Atualizar Cadastro
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P636_CPF (
        type: textField
        label {
            label: CPF
            alignment: left
        }
        layout {
            sequence: 10
            region: @atualizar-cadastro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P636_IDPESSOA (
        type: selectList
        label {
            label: Cliente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomepessoa
                     , p.idpessoa
                from pessoas p
                where p.cpf = :P636_CPF
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P636_CPF
        }
        layout {
            sequence: 20
            region: @atualizar-cadastro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button confirmar (
        buttonName: CONFIRMAR
        label: Confirmar Atualização
        layout {
            sequence: 10
            region: @atualizar-cadastro
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P636_CPF
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P636_IDPESSOA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process atualiza-cadastro-de-vendedora (
        name: Atualiza Cadastro de Vendedora
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update vendedoras v
                  set ativo = 'S'
                    , idrepresentante = 52131
                  where v.idpessoa = :P636_IDPESSOA
                    and v.idrepresentante = 2179;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cadastro atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5983352489866539943
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 636
                items: {
                    P636_CPF:
                    P636_IDPESSOA:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @confirmar
        }
    )

)

