    region recebimento-de-compras (
        name: Recebimento de Compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*first_rows(50)*/nf.idnotafiscal
                     , nf.dtnf
                     , nf.datainclusao
                     , nf.dataconfirmacao
                     , nf.documento
                     , nvl(pck_romance.fnc_nomefornecedor(nf.idfornemitente),pck_romance.fnc_nomefilial(nf.idfilialemitente))"Emitente"
                     , nvl(pck_romance.fnc_nomefornecedor(nf.idfornecedordestino),pck_romance.fnc_nomefilial(nf.idfilialdestino))"Destino"
                     --, pck_romance.fnc_nomeproduto(i.idproduto) "Produto"
                     , p.codigosisdist referencia
                     , initcap(p.nomeproduto) "Produto"
                     , pck_romance.fnc_nomecategoria(p.idcategoria) categoria
                     , i.qtd_total "Total Enviada"
                     , i.qtd_total_chegou "Total Recebida"
                     , i.qtd_total_chegou - i.qtd_total "Diferença"  
                     --, i.custound custo
                     , i.OBSERVACAOFILIAL
                     , nf.volumes
                     , nf.volumesrecebidos
                     , nf.volumesviolados
                     , (select i.custound 
                          from roman.itemnf it
                         where it.idproduto = i.idproduto
                           and it.iditnf = (select max(ii.iditnf)
                                              from roman.notasfiscais nf
                                                 , roman.itemnf ii
                                             where nf.idnotafiscal = ii.idnotafiscal
                                               and nf.situacao     <> 'C'
                                               and ii.idproduto    = it.idproduto)) custo
                     , favorita.pck_util_fav.fnc_nomefornecedor(fp.idfornecedor) Fornecedor 
                     , 1 ObsEstoque
                     , i.iditnf
                     -- Maicon Aimi - 27/01/2024 - 9768548: Exibe o usuário que fez o recebimento da nota fiscal.
                     , (select log.usuarioalteracao
                          from logroman.log_notasfiscais log
                         where log.idlog = ( select min(l.idlog)
                                               from logroman.log_notasfiscais l
                                              where l.idnotafiscal   = nf.idnotafiscal
                                                and l.situacaofilial = 'R')) as "Usuário Recebimento"
                from roman.notasfiscais nf
                   , roman.itemnf i             
                   , roman.produtos p
                   , roman.fornecedoresprodutos fp
                where nf.idnotafiscal = i.idnotafiscal
                  and i.idproduto = p.idproduto
                  and p.idfornecedor = fp.idfornecedor(+)
                  and p.idproduto    = fp.idproduto(+)
                  and nf.situacaofilial = 'R'
                  and nf.emailrecebimento = 'S'
                  and ( :P145_FRANQUIA = -1 or nf.idfilialdestino = :P145_FRANQUIA )
                  and ( :P145_IDFORNECEDOR is null or fp.idfornecedor = :P145_IDFORNECEDOR )
                  and ( :P145_IDFORNECEDOR is null or nf.idfornemitente = :P145_IDFORNECEDOR )
                  and ( :P145_DTINI is null  or ( :P145_TIPODATA = 'E' and trunc(nf.datainclusao) between to_date(:P145_DTINI,'dd/mm/rrrr') and to_date(:P145_DTFIM,'dd/mm/rrrr') )
                                             or ( :P145_TIPODATA = 'R' and trunc(nf.datarecebimento) between to_date(:P145_DTINI,'dd/mm/rrrr') and to_date(:P145_DTFIM,'dd/mm/rrrr') )
                                             or ( :P145_TIPODATA = 'C' and trunc(nf.dataconfirmacao) between to_date(:P145_DTINI,'dd/mm/rrrr') and to_date(:P145_DTFIM,'dd/mm/rrrr') ) )
                  and ( :P145_CATEGORIA is null or p.idcategoria = :P145_CATEGORIA )
                  and :P145_RELATORIO = 'C'
                /*group by nf.idnotafiscal
                 , nf.dtnf
                 , nf.datainclusao
                 , nf.dataconfirmacao
                 , nf.documento
                 , nf.idfornemitente
                 , nf.idfornecedordestino
                 , nf.idfilialemitente
                 , nf.idfilialdestino
                 , i.idproduto
                 , i.qtd_total
                 , i.qtd_total_chegou
                 , i.iditnf    
                 , p.codigosisdist 
                 , p.nomeproduto
                 , i.custound 
                 , p.idcategoria
                 , i.OBSERVACAOFILIAL
                 , nf.volumes
                 , nf.volumesrecebidos
                 , nf.volumesviolados
                 , favorita.pck_util_fav.fnc_nomefornecedor(fp.idfornecedor)  */
                order by 1 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P145_RELATORIO
            value: C
        }
