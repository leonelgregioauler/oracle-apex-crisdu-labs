    region recebimento-com-itens-manual (
        name: Recebimento Com Itens Manual
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.datainclusao as "Data de Inclusão", 
                       n.dataconfirmacao as "Data de Confirmação", 
                       n.nrnf as "Número da Nota",
                       nvl(pck_romance.fnc_nomefornecedor(n.idfornemitente),pck_romance.fnc_nomefilial(n.idfilialemitente)) as "Emitente",
                       nvl(pck_romance.fnc_nomefornecedor(n.idfornecedordestino),pck_romance.fnc_nomefilial(n.idfilialdestino)) as "Destino",
                       pck_romance.fnc_nomecategoria(p.idcategoria) as "Categoria",
                       p.codigosisdist as "Referência",
                       p.nomeproduto as "Produto",
                       i.qtd_total_chegou as "Qtd Inclusa Manualmente",
                       i.usuario_inclusao as "Login de Quem Incluiu"
                       -- Maicon Aimi - 27/01/2024 - 9768548: Exibe o usuário que fez o recebimento da nota fiscal.
                       , (select log.usuarioalteracao
                            from logroman.log_notasfiscais log
                           where log.idlog = ( select min(l.idlog)
                                                 from logroman.log_notasfiscais l
                                                where l.idnotafiscal   = n.idnotafiscal
                                                  and l.situacaofilial = 'R')) as "Usuário Recebimento"
                 from roman.notasfiscais n,
                      roman.itemnf i,
                      produtos p
                 where i.idnotafiscal = n.idnotafiscal
                   and p.idproduto = i.idproduto
                   and i.incluido_manualmente = 'S'
                   and (:P145_FRANQUIA = -1 or n.idfilialdestino = :P145_FRANQUIA)
                   and ( :P145_IDFORNECEDOR is null or n.idfornemitente = :P145_IDFORNECEDOR )
                   and :P145_RELATORIO = 'M'
                   and ( :P145_CATEGORIA is null or p.idcategoria = :P145_CATEGORIA )
                   and ( :P145_DTINI is null  or ( :P145_TIPODATA = 'E' and trunc(n.datainclusao) between to_date(:P145_DTINI,'dd/mm/rrrr') and to_date(:P145_DTFIM,'dd/mm/rrrr') )
                                              or ( :P145_TIPODATA = 'R' and trunc(n.datarecebimento) between to_date(:P145_DTINI,'dd/mm/rrrr') and to_date(:P145_DTFIM,'dd/mm/rrrr') )
                                              or ( :P145_TIPODATA = 'C' and trunc(n.dataconfirmacao) between to_date(:P145_DTINI,'dd/mm/rrrr') and to_date(:P145_DTFIM,'dd/mm/rrrr') ) );
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P145_RELATORIO
            value: M
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1987285020087079728
        }

