    pageItem P145_CATEGORIA (
        type: selectList
        label {
            label: Categoria
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nome
                     , c.idcategoria 
                from roman.categorias c
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 80
            region: @filtros-recb-de-compras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P145_DTFIM (
        type: datePickerJquery
        label {
            label: "até "
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros-recb-de-compras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P145_DTINI (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros-recb-de-compras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P145_FRANQUIA (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ' - Todas - '
                    , -1
                from dual
                union
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @filtros-recb-de-compras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P145_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.idfornecedor||' - '||p.nomepessoa display_value
                 , f.idfornecedor return_value
                from fornecedores f
                   , pessoas p
                where f.idpessoa = p.idpessoa
                ```
        }
        layout {
            sequence: 70
            region: @filtros-recb-de-compras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 40
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P145_RELATORIO (
        type: selectList
        label {
            label: Tipo Relatório
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Recebimento de Compras	;C,Recebimento Com Itens Manual;M
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @filtros-recb-de-compras
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P145_TIPODATA (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Emissão;E,Recebimento;R,Confirmação;C
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros-recb-de-compras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 100
            region: @filtros-recb-de-compras
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 145
                items: {
                    P145_TIPODATA: &P145_TIPODATA.
                    P145_DTINI: &P145_DTINI.
                    P145_DTFIM: &P145_DTFIM.
                    P145_IDFORNECEDOR: &P145_IDFORNECEDOR.
                }
            }
        }
    )

)

