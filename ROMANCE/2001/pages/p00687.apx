    region parâmetros (
        name: "Parâmetros "
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pp.idparametrorepres
                     , pp.idcadastroparametro
                     , pp.idrepresentante
                     , pp.parametro
                     , pp.valor
                from parametrosrepresentantes pp
                where ( :P687_IDREPRESENTANTE is null or pp.idrepresentante = :P687_IDREPRESENTANTE )
                  and pck_romance.fnc_filialrepresentante(pp.idrepresentante) = :P687_IDFILIAL 
                  and ( :P687_PARAMETRO is null or idcadastroparametro = :P687_PARAMETRO )
                  and ( exists ( select 1
                                   from catal.gerentes g
                                      , catal.usuarios u
                                   where g.idgerente = u.idgerente
                                     and u.idgerente = 143
                                     and u.usuario = v('APP_USER')  ) OR
                
                        (exists (select 1 
                                   from roman.usuariosgruposatendimento ug
                                  where ug.idgrupoatendimento = 73 -- PREVENÇÃO A PERDAS.
                                    and ug.usuario = v('APP_USER')) AND pp.parametro IN ('PERCDEBITOBLOQUEIA','LIMITEABERTURA','VLRMINIMOPGTOANTESCOBRANCA','VLRMINIMOPGTODEPOISCOBRANCA',
                                                    'QTDDEBITOBLOQUEIA','QTDCOBRANCASBLOQUEIA','QTDDEBITOSFAVORITABLOQUEIA','QTDDEBITOSROMANCEBLOQUEIA',
                                                    'FLUXOBLOQUEIOSACOLAADICIONAL','VALORLIMITEBLOQUEIASACOLA','MARGEMBLOQUEIASACOLA','BLOQUEIASACOLA',
                                                    'FLUXOBLOQUEIOSACOLA','FLUXONOTASAGUARDANDOACERTO')) OR
                       
                        (exists (select 1 
                                   from roman.usuariosgruposatendimento ug
                                  where ug.idgrupoatendimento = 9 -- ANÁLISE DE CRÉDITO FAVORITA.
                                    and ug.usuario = v('APP_USER')) AND pp.parametro IN ('LIBERACONSULTACPF', 'LIBERAPAINELLEADS',
                                                    'USACODIGODELIBERACAOSPC', 'UTILIZAASSINATURAELETRONICA',
                                                    'LIBERAUSORASCUNHO', 'PERMITEFAZERREASSINATURAELETRONICA',
                                                    'LIBERACLIENTESINATIVAS', 'QTDDIASRESEINATIVAS', 'QTDDIASMAXINATIVASFIL', 'LIBERAAGENDAMENTOLEADSDISTRIBUIDOR')) OR -- 9978342
                
                        (exists (select 1 
                                   from roman.usuariosgruposatendimento ug
                                  where ug.idgrupoatendimento = 58 -- COMERCIAL ROMANCE.
                                    and ug.usuario = v('APP_USER')) AND pp.parametro IN ('LIBERACATALOGOPERSONALIZADO'))
                      )
                
                
                
                /* old
                
                select pp.idparametrorepres
                     , pp.idcadastroparametro
                     , pp.idrepresentante
                     , pp.parametro
                     , pp.valor
                from parametrosrepresentantes pp
                where ( :P687_IDREPRESENTANTE is null or pp.idrepresentante = :P687_IDREPRESENTANTE )
                  and pck_romance.fnc_filialrepresentante(pp.idrepresentante) = :P687_IDFILIAL 
                  and ( :P687_PARAMETRO is null or idcadastroparametro = :P687_PARAMETRO )
                  and pp.parametro in ('PERCDEBITOBLOQUEIA','LIMITEABERTURA','VLRMINIMOPGTOANTESCOBRANCA','VLRMINIMOPGTODEPOISCOBRANCA','QTDDEBITOBLOQUEIA'
                                      ,'QTDCOBRANCASBLOQUEIA','QTDDEBITOSFAVORITABLOQUEIA','QTDDEBITOSROMANCEBLOQUEIA','FLUXOBLOQUEIOSACOLAADICIONAL','VALORLIMITEBLOQUEIASACOLA'
                                      ,'MARGEMBLOQUEIASACOLA','BLOQUEIASACOLA','FLUXOBLOQUEIOSACOLA','QTDDEBITOBLOQUEIA','QTDDEBITOSROMANCEBLOQUEIA','QTDDEBITOSFAVORITABLOQUEIA'
                                      ,'QTDCOBRANCASBLOQUEIA','PERCDEBITOBLOQUEIA')
                                      
                */
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 890346448569251223
        }

