    pageItem P687_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) d
                     , r.idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P687_IDFILIAL )
                  and r.ativo = 'S'
                order by 1
                
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P687_IDFILIAL
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

