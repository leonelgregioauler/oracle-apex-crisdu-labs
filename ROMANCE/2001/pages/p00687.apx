        }
    )

    pageItem P687_IDFILIAL (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo is not null
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione a Franquia -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
