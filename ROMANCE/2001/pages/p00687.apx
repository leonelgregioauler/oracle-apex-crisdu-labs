            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process atualiza-parametros-em-massa (
        name: Atualiza Parametros em Massa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update cadastrosparametrosrepres cp
                  set cp.valor = :P687_VALOR
                  where cp.idcadastroparametro = :P687_IDCADASTRO_PARAMETRO;
                  --
                  update parametrosrepresentantes pr
                  set pr.valor = :P687_VALOR
                  where pr.idcadastroparametro = :P687_IDCADASTRO_PARAMETRO;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Parâmetro atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 890349018905251249
        }
        serverSideCondition {
            type: request=Value
            value: APLICAR
        }
    )

    process parâmetros-save-interactive-grid-data (
        name: Parâmetros  - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @parâmetros
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 890347251751251231
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 687
                items: {
                    P687_IDFILIAL: &P687_IDFILIAL.
                    P687_IDREPRESENTANTE: &P687_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

