                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

    )

    pageItem P687_IDCADASTRO_PARAMETRO (
        type: selectList
        label {
            label: Parâmetro
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select cp.parametro
                     , cp.idcadastroparametro
                 from cadastrosparametrosrepres cp
                where cp.idfilial = :P687_IDFILIAL_ATUALIZAR
                  and ( exists ( select 1
                                   from catal.gerentes g
                                      , catal.usuarios u
                                   where g.idgerente = u.idgerente
                                     and u.idgerente = 143
                                     and u.usuario = v('APP_USER')  ) OR
                
                        (exists (select 1 
                                   from roman.usuariosgruposatendimento ug
                                  where ug.idgrupoatendimento = 73 -- PREVENÇÃO A PERDAS.
                                    and ug.usuario = v('APP_USER')) AND cp.parametro IN ('PERCDEBITOBLOQUEIA','LIMITEABERTURA','VLRMINIMOPGTOANTESCOBRANCA','VLRMINIMOPGTODEPOISCOBRANCA',
                                                    'QTDDEBITOBLOQUEIA','QTDCOBRANCASBLOQUEIA','QTDDEBITOSFAVORITABLOQUEIA','QTDDEBITOSROMANCEBLOQUEIA',
                                                    'FLUXOBLOQUEIOSACOLAADICIONAL','VALORLIMITEBLOQUEIASACOLA','MARGEMBLOQUEIASACOLA','BLOQUEIASACOLA',
                                                    'FLUXOBLOQUEIOSACOLA','FLUXONOTASAGUARDANDOACERTO')) OR
                       
                        (exists (select 1 
                                   from roman.usuariosgruposatendimento ug
                                  where ug.idgrupoatendimento = 9 -- ANÁLISE DE CRÉDITO FAVORITA.
                                    and ug.usuario = v('APP_USER')) AND cp.parametro IN ('LIBERACONSULTACPF', 'LIBERAPAINELLEADS',
                                                    'USACODIGODELIBERACAOSPC', 'UTILIZAASSINATURAELETRONICA',
                                                    'LIBERAUSORASCUNHO', 'PERMITEFAZERREASSINATURAELETRONICA',
                                                    'LIBERACLIENTESINATIVAS', 'QTDDIASRESEINATIVAS', 'QTDDIASMAXINATIVASFIL','LIBERAAGENDAMENTOLEADSDISTRIBUIDOR')) OR -- 9978342
                
                        (exists (select 1 
                                   from roman.usuariosgruposatendimento ug
                                  where ug.idgrupoatendimento = 58 -- COMERCIAL ROMANCE.
                                    and ug.usuario = v('APP_USER')) AND cp.parametro IN ('LIBERACATALOGOPERSONALIZADO'))
                )
                order by 1
                
                
                
                
                /*select cp.parametro
                     , cp.idcadastroparametro
                 from cadastrosparametrosrepres cp
                where cp.idfilial = :P687_IDFILIAL_ATUALIZAR
                  and ( exists ( select 1
                                   from catal.gerentes g
                                      , catal.usuarios u
                                  where g.idgerente = u.idgerente
                                    and u.idgerente = 143
                                    and u.usuario = v('APP_USER')  ) OR
                      ( cp.parametro in ('PERCDEBITOBLOQUEIA','LIMITEABERTURA','VLRMINIMOPGTOANTESCOBRANCA','VLRMINIMOPGTODEPOISCOBRANCA','QTDDEBITOBLOQUEIA',
                                           'QTDCOBRANCASBLOQUEIA','QTDDEBITOSFAVORITABLOQUEIA','QTDDEBITOSROMANCEBLOQUEIA','FLUXOBLOQUEIOSACOLAADICIONAL','VALORLIMITEBLOQUEIASACOLA',
                                           'MARGEMBLOQUEIASACOLA','BLOQUEIASACOLA','FLUXOBLOQUEIOSACOLA','QTDDEBITOBLOQUEIA','QTDDEBITOSROMANCEBLOQUEIA','QTDDEBITOSFAVORITABLOQUEIA',
                                           'QTDCOBRANCASBLOQUEIA','PERCDEBITOBLOQUEIA')) )
                order by 1*/
                
                
                
                
                
                /* OLD
                select cp.parametro
                     , cp.idcadastroparametro
                from cadastrosparametrosrepres cp
                where cp.idfilial = :P687_IDFILIAL_ATUALIZAR
                  and cp.parametro in ('PERCDEBITOBLOQUEIA','LIMITEABERTURA','VLRMINIMOPGTOANTESCOBRANCA','VLRMINIMOPGTODEPOISCOBRANCA','QTDDEBITOBLOQUEIA'
                                      ,'QTDCOBRANCASBLOQUEIA','QTDDEBITOSFAVORITABLOQUEIA','QTDDEBITOSROMANCEBLOQUEIA','FLUXOBLOQUEIOSACOLAADICIONAL','VALORLIMITEBLOQUEIASACOLA'
                                      ,'MARGEMBLOQUEIASACOLA','BLOQUEIASACOLA','FLUXOBLOQUEIOSACOLA','QTDDEBITOBLOQUEIA','QTDDEBITOSROMANCEBLOQUEIA','QTDDEBITOSFAVORITABLOQUEIA'
                                      ,'QTDCOBRANCASBLOQUEIA','PERCDEBITOBLOQUEIA')
                order by 2
                
                */
                ```
        }
        cascadingLov {
            parentItems: P687_IDFILIAL_ATUALIZAR
        }
        layout {
            sequence: 20
            region: @atualizar-em-massa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
