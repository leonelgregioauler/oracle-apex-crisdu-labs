    region logs-de-notas-de-venda (
        name: Logs de Notas de Venda
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v_sql clob;
                begin
                  v_sql := q'~
                    select usuarioalteracao
                         , dataalteracao
                         , decode(tipoalteracao,'INSERT','Inclusão','UPDATE','Alteração','DELETE','Exclusão') "Tipo Alt."
                         , idnotavenda
                         , idfilial
                         , pck_romance.fnc_nomegerente(idgerente) "Gerente"
                         , pck_romance.fnc_nomerepresentante(idrepresentante) "Representante"
                         , pck_romance.fnc_nomevendedora(idvendedora) "Vendedora"
                         , datanota
                         , semanadistribuicao
                         , semanacobranca
                         , idregiaovenda
                         , valortotalnota
                         , valortotaldevolucao
                         , valortotalvenda
                         , basecomissao
                         , perccomissao
                         , valorcomissao
                         , valorpago
                         , saldo
                         , valortotalvendalqd
                         , numeronota
                         , decode(idsituacaonotavenda,'3','Aguardando Acerto','4','Acerto Efetuado','5','Cancelado') "Situação"
                         , dataretorno
                         , perccomissaocorreta
                         , enviadocobranca
                         , pck_romance.fnc_nomerepresentante(idrepresentanteatende) "Rep, Atende"
                         , idlog
                         , idtablet
                      from logroman.log_notasvendas
                     where idfilial = :p0_idfilial
                       and :p227_filtrar = 'S'
                  ~';
                
                  if :p227_filtrorepres is not null then
                     v_sql := v_sql || ' and idrepresentante = :p227_filtrorepres';
                  end if;
                
                  if :p227_idnotavenda is not null then
                     v_sql := v_sql || ' and idnotavenda = :p227_idnotavenda';
                  end if;
                
                  if :p227_filtrovend is not null then
                     v_sql := v_sql || ' and idvendedora = :p227_filtrovend';
                  end if;
                
                  if :p227_filtronota is not null then
                     v_sql := v_sql || ' and numeronota = :p227_filtronota';
                  end if;
                
                  -- exibe a query final (opcional para debug)
                  -- dbms_output.put_line(v_sql);
                
                  return v_sql;
                end;
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
