    pageItem P227_FILTROREPRES (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante) || decode(r.ativo,'S','','Inativo') display_value
                     , r.idrepresentante
                from representantes r
                where idgerente in ( select idgerente
                                     from gerentes
                                     where idfilial = :P0_IDFILIAL)
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @logs-de-notas-de-venda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 4000
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P227_FILTROVEND (
        type: popupLov
        label {
            label: Cliente
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomepessoa)||' - '||nvl(cpf,replace(replace(documentoestrangeiro,'-',''),'.','')) display_value
                     , v.idvendedora return_value
                from vendedoras v
                   , pessoas p
                where v.idpessoa = p.idpessoa
                  and ( :P227_FILTROREPRES is null  or v.idrepresentante = :P227_FILTROREPRES ) 
                  and v.idrepresentante in (select idrepresentante
                                            from representantes
                                            where idgerente in ( select idgerente
                                                                 from gerentes
                                                                 where idfilial = :P0_IDFILIAL))
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P227_FILTROREPRES
        }
        layout {
            sequence: 20
            region: @logs-de-notas-de-venda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 4000
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

