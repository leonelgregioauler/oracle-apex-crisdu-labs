page 466 (
    name: Impressão de Venda Direta
    title: Impressão de Venda Direta
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region venda-direta (
        name: Venda Direta
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_imprime.prc_imprimevendadireta(pidvendadireta => :P466_IDVENDADIRETA);
                end;
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P466_IDVENDADIRETA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @venda-direta
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

