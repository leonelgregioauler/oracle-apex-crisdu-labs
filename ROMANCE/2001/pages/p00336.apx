    region pedidos-pagos-resumidos (
        name: Pedidos Pagos Resumidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select representante  "Distribuidor"
                     , sum(valorapagar) "Valor Total"
                     , sum(valoraabater) "Valor á Abater"
                     , count(1) "Qtd Pedidos"
                from (select pf.idpedido
                           , pf.numeropedido
                           , pf.representante
                           , pf.vendedora
                           , pf.databaixa
                           , pf.datavencimentomenor
                           , pf.valorapagar 
                           , pf.valoraabater
                           , pf.comissaodistribuidor
                      from favorita.vw_comissoes_descontar_fav pf
                      where (  :P336_DISTRIBUIDOR is null or pf.idrepresentante = :P336_DISTRIBUIDOR )
                        and pf.idfilialromance = :P0_IDFILIAL
                        and ( :P336_DTINI is null 
                            or ( :P336_TIPODATA = 'E' and trunc(pf.dataemissao) between to_date(:P336_DTINI,'dd/mm/yyyy') and to_date(:P336_DTFIM,'dd/mm/yyyy') )
                            or ( :P336_TIPODATA = 'B' and trunc(pf.databaixa) between to_date(:P336_DTINI,'dd/mm/yyyy') and to_date(:P336_DTFIM,'dd/mm/yyyy') )
                            or ( :P336_TIPODATA = 'V' and trunc(pf.datavencimentomenor) between to_date(:P336_DTINI,'dd/mm/yyyy') and to_date(:P336_DTFIM,'dd/mm/yyyy') ) 
                            or ( :P336_TIPODATA = 'P' and exists ( select 1
                                                                   from controleabatimentoscomissoes c
                                                                   where c.idpedido = pf.idpedido
                                                                     and trunc(c.data) between to_date(:P336_DTINI,'dd/mm/yyyy') and to_date(:P336_DTFIM,'dd/mm/yyyy') ) ) )
                      order by 5 desc )    
                group by representante 
                order by 1
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Use os Filtros
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 803531464268860024
        }

