    process confirmar-recebimento-do-valor (
        name: Confirmar Recebimento do Valor
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_acertosfechamento.prc_confirmavendadireta_fav( pidpedido => :P336_IDEDITAR
                                                                   , pusuario  => v('APP_USER') );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Valor recebido com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1433220549391698503
        }
        serverSideCondition {
            type: request=Value
            value: RECEBER
        }
    )

