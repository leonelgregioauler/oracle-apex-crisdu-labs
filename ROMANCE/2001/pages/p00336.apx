    region pedidos-venda-direta-detalhado (
        name: Pedidos Venda Direta Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pp.idpedido
                     , pp.numeropedido
                     , pp.distribuidor
                     , pp.vendedora
                     , pp.dataemissao
                     , pp.datavencimentomenor
                     , pp.valorapagar
                     , '-' null1
                     , pp.valorcomissaodistribuidor
                     , '-' null2
                     , pp.valorcomissaogerente
                     , '=' igual
                     , (pp.valorapagar-valorcomissaodistribuidor) valorserabatido
                     , '=' igual2
                     , valorentrarcaixa
                     ,  '<a href="javascript:fnc_receber('|| IDPEDIDO ||')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>' confirmarvalorrecebido
                from (         
                
                        select pf.idpedido
                             , numeropedido
                             , vendedora
                             , dataemissao
                             , pf.valorapagar
                             , pf.valorapagar*-1 comissaodistribuidor
                             , pf.valorapagar*-1 comissaogerente
                             , idrepresentante
                             , pf.representante distribuidor
                             , idvendedora
                             , idgerente
                             , pf.gerente
                             , idfilialromance
                             , pf.datavencimentomenor
                             , ( select sum(i.valorcomissaodistribuidor) 
                                 from favorita.itenspedidos i
                                 where i.idpedido = pf.idpedido ) valorcomissaodistribuidor
                             , ( pf.valorapagar * 0.05 ) valorcomissaogerente
                             , ( pf.valorapagar-( pf.valorapagar * 0.05 ) -( select sum(i.valorcomissaodistribuidor) 
                                                                           from favorita.itenspedidos i
                                                                           where i.idpedido = pf.idpedido )) valorentrarcaixa
                             , pf.idfilialfavorita
                             , pf.filialfavorita
                             , case
                                 when pf.idusuario is null and not exists ( select 1
                                                                           from favorita.classificacoespedidos c
                                                                           where c.idpedido = pf.idpedido
                                                                             and c.idcaracteristicapedido = 2 ) then
                                   'Cliente Emitiu'
                                 when pf.idusuario is null and exists ( select 1
                                                                       from favorita.classificacoespedidos c
                                                                       where c.idpedido = pf.idpedido
                                                                         and c.idcaracteristicapedido = 2 ) then
                                   'Distribuidor(a) Emitiu'
                                 when pf.idusuario is not null and exists ( select 1
                                                                           from favorita.classificacoespedidos c
                                                                           where c.idpedido = pf.idpedido
                                                                             and c.idcaracteristicapedido = 2 ) then
                                   'Distribuidor(a) Emitiu'
                                 when pf.idusuario is not null and not exists ( select 1
                                                                               from favorita.classificacoespedidos c
                                                                               where c.idpedido = pf.idpedido
                                                                                 and c.idcaracteristicapedido = 2 ) then
                                   'Cliente Emitiu'
                               end emissao
                        from favorita.vw_pedidos_fav pf
                        where pf.ididioma = 1
                          and pf.idfilialromance = :P0_IDFILIAL
                          and (  :P336_DISTRIBUIDOR = -1 or pf.idrepresentante = :P336_DISTRIBUIDOR )
                          and ( :P336_DTINI is null 
                            or ( :P336_TIPODATA = 'E' and pf.dataemissao         between to_date(:P336_DTINI||' 00:00:00','dd/mm/yyyy hh24:mi:ss') and to_date(:P336_DTFIM||' 23:59:59','dd/mm/yyyy hh24:mi:ss') )
                           -- or ( :P336_TIPODATA = 'B' and pf.databaixa           between to_date(:P336_DTINI||' 00:00:00','dd/mm/yyyy hh24:mi:ss') and to_date(:P336_DTFIM||' 23:59:59','dd/mm/yyyy hh24:mi:ss') )
                            or ( :P336_TIPODATA = 'V' and pf.datavencimentomenor between to_date(:P336_DTINI||' 00:00:00','dd/mm/yyyy hh24:mi:ss') and to_date(:P336_DTFIM||' 23:59:59','dd/mm/yyyy hh24:mi:ss') ) 
                            or ( :P336_TIPODATA = 'P' and exists ( select 1
                                                                   from controleabatimentoscomissoes c
                                                                   where c.idpedido = pf.idpedido
                                                                     and trunc(c.data) between to_date(:P336_DTINI||' 00:00:00','dd/mm/yyyy hh24:mi:ss') and to_date(:P336_DTFIM||' 23:59:59','dd/mm/yyyy hh24:mi:ss') ) ) )
                          and  exists ( select 1
                                           from favorita.vencimentospedidos v      
                                             , favorita.pagamentospedidos pgf
                                           where v.idpedido           = pf.idpedido
                                             and v.valorpagar         > 0
                                             and v.situacaovencimento = 'V'
                                             and pgf.idsituacao in (10,30)
                                             and pgf.idvencimentopedido = v.idvencimentopedido   
                                             and pgf.idfechamento is null
                                             and pgf.idformapagamento   = 9 ) 
                          and pf.tipopedido = 'V' --venda direta
                          and not exists ( select 1
                                           from favorita.classificacoespedidos c
                                           where c.idpedido = pf.idpedido
                                             and c.idcaracteristicapedido = 25 )
                         and not exists ( select 1
                                          from controleabatimentoscomissoes c
                                          where c.idpedido = pf.idpedido )
                        ) pp
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Use os Filtros
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 803527821029830594
        }

