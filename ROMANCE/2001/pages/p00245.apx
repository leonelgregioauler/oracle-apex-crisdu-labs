page 245 (
    name: Notas de Cliente V em mais de uma Filial
    title: Notas de Cliente V em mais de uma Filial
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region notas-de-cliente-em-mais-de-uma-filial (
        name: Notas de Cliente em mais de uma Filial
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(n.idvendedora) Cliente
                     , listagg('<br>'||pck_romance.fnc_nomefilial(n.idfilial)||' - Nota: ' || n.numeronota||', Data: '||to_char(n.datanota,'dd/mm/rrrr') ||', Saldo: '|| n.saldo,'.') within group (order by 1) "INFO"
                from notasvendas n
                where ( n.idsituacaonotavenda = 3 or saldo > 0) 
                  and exists ( select 1
                                   from notasvendas v
                                   where v.idrepresentante = :P245_IDREPRESENTANTE
                                     and v.idvendedora     = n.idvendedora
                                     and ( v.idsituacaonotavenda = 3 or saldo > 0) )
                 and exists ( select 1 
                              from notasvendas nv 
                              where nv.idvendedora = n.idvendedora 
                                and nv.idrepresentante != n.idrepresentante
                                and nv.idfilial != n.idfilial
                                and ( idsituacaonotavenda = 3 or saldo > 0) )
                group by n.idvendedora
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 589027500270269102
        }

        column CLIENTE (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: CLIENTE
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column INFO (
            type: plainText
            heading {
                heading: Info
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: INFO
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        savedReport 5890306 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn CLIENTE (
                sequence: 1
            )

            displayColumn INFO (
                sequence: 2
            )

        )

    )

    pageItem P245_IDREPRESENTANTE (
        type: hidden
        layout {
            sequence: 10
            region: @notas-de-cliente-em-mais-de-uma-filial
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

