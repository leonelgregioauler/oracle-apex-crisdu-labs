page 840 (
    name: Depósitos Conquistou Levou
    alias: DEPÓSITOS-CONQUISTOU-LEVOU
    title: Depósitos Conquistou Levou
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region cancelar-depósito (
        name: Cancelar Depósito
        type: staticContent
        layout {
            sequence: 30
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size800x600
            ]
        }
        advanced {
            htmlDomId: CANCELAR_DEPOSITO
            regionDisplaySelector: true
        }
    )

    region depósitos-conquistou-levou (
        name: Depósitos Conquistou Levou
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with depositos as (
                  select d.iddepositoconquistoulevou
                       , d.idvendedora
                       , roman.pck_romance.fnc_nomevendedora(d.idvendedora) nome_vendedora
                       , d.idconquistoulevou
                       , d.pontosdepositados
                       , d.datadeposito
                       , d.tipodeposito
                       , d.ativo
                       , d.datacancelamento
                       , d.idusuariocancelou
                       , d.motivocancelamento
                       , case when d.tipodeposito = 'M'
                               and d.ativo        = 'A'
                               -- 04/11/2026: so com a troca da campanha aberta (antes: maior campanha ativa do pais,
                               -- que deixava cancelar depositos de campanha encerrada, como a 8)
                               and exists (
                                     select 1
                                       from roman.campanhasconquistoulevou c2
                                      where c2.idconquistoulevou = d.idconquistoulevou
                                        and trunc(sysdate) between trunc(c2.datainicio) and trunc(c2.datafinal))
                               and not exists (
                                     select 1
                                       from roman.conquistoulevoucupons cp
                                      where cp.idvendedora      = d.idvendedora
                                        and cp.idconquistoulevou = d.idconquistoulevou)
                              then 'S' else 'N' end pode_cancelar
                    from roman.depositosconquistoulevou d
                   where d.idconquistoulevou = :P840_IDCONQUISTOULEVOU
                )
                select d.iddepositoconquistoulevou
                     , d.idvendedora
                     , d.nome_vendedora
                     , d.idconquistoulevou
                     , d.pontosdepositados
                     , d.datadeposito
                     , d.tipodeposito
                     , d.ativo
                     , d.datacancelamento
                     , d.idusuariocancelou
                     , d.motivocancelamento
                     , d.pode_cancelar
                     , case when d.pode_cancelar = 'S'
                            then '<span class="fa fa-pencil-square-o" title="Cancelar" aria-hidden="true"></span>'
                            else ''
                       end btn_cancelar
                  from depositos d
                 order by case when d.tipodeposito = 'M' then 1 else 2 end
                         , d.datadeposito desc
                ```
            pageItemsToSubmit: P840_IDCONQUISTOULEVOU
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: IG_DEPOSITOS
        }
        componentAppearance {
            selectFirstRow: false
        }
        toolbar {
            controls: actionsMenu
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 84001000000000081
        }

        savedReport 840igr (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @BTN_CANCELAR
                layout {
                    width: 50
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDVENDEDORA
                layout {
                    width: 80
                    sequence: 2
                }
            )

            displayColumn (
                column: @PONTOSDEPOSITADOS
                layout {
                    width: 100
                    sequence: 4
                }
            )

            displayColumn (
                column: @DATADEPOSITO
                layout {
                    width: 120
                    sequence: 5
                }
            )

            displayColumn (
                column: @TIPODEPOSITO
                layout {
                    width: 110
                    sequence: 6
                }
            )

            displayColumn (
                column: @ATIVO
                layout {
                    width: 100
                    sequence: 7
                }
            )

            displayColumn (
                column: @DATACANCELAMENTO
                layout {
                    width: 140
                    sequence: 8
                }
            )

            displayColumn (
                column: @IDUSUARIOCANCELOU
                layout {
                    width: 160
                    sequence: 9
                }
            )

            displayColumn (
                column: @MOTIVOCANCELAMENTO
                layout {
                    width: 200
                    sequence: 10
                }
            )

            displayColumn (
                column: @NOME_VENDEDORA
                layout {
                    width: 200
                    sequence: 3
                }
            )

        )

        column ATIVO (
            type: selectList
            heading {
                heading: Ativo
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Ativo;A,Cancelado;C,Utilizado;U
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                databaseColumn: ATIVO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            readOnly {
                type: always
            }
        )

        column BTN_CANCELAR (
            type: link
            heading {
                heading: Cancelar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: javascript:apex.item('P840_IDDEP_CANCELAR').setValue('&IDDEPOSITOCONQUISTOULEVOU.');apex.jQuery('#CANCELAR_DEPOSITO').dialog('open')
                }
                linkText: &BTN_CANCELAR.
            }
            source {
                databaseColumn: BTN_CANCELAR
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                enabled: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
                hide: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column DATACANCELAMENTO (
            type: datePicker
            heading {
                heading: Data Cancelamento
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/yyyy
            }
            source {
                databaseColumn: DATACANCELAMENTO
                dataType: date
            }
            enableUsersTo {
                controlBreakAggregate: false
            }
            readOnly {
                type: always
            }
        )

        column DATADEPOSITO (
            type: datePicker
            heading {
                heading: Data Depósito
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
