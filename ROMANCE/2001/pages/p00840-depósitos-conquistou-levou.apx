                heading: Motivo Cancelamento
            }
            layout {
                sequence: 100
            }
            validation {
                maxLength: 500
            }
            source {
                databaseColumn: MOTIVOCANCELAMENTO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
            readOnly {
                type: always
            }
        )

        column NOME_VENDEDORA (
            type: textField
            heading {
                heading: Vendedora
            }
            layout {
                sequence: 35
            }
            source {
                databaseColumn: NOME_VENDEDORA
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            readOnly {
                type: always
            }
        )

        column PODE_CANCELAR (
            type: hidden
            layout {
                sequence: 110
            }
            source {
                databaseColumn: PODE_CANCELAR
                dataType: varchar2
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column PONTOSDEPOSITADOS (
            type: numberField
            heading {
                heading: Pontos
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                databaseColumn: PONTOSDEPOSITADOS
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            readOnly {
                type: always
            }
        )

        column TIPODEPOSITO (
            type: selectList
            heading {
                heading: Tipo Deposito
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select descricao d
                         , sigla r
                      from table(catal.pck_util.fnc_siglasistema('TIPO_DEPOSITO_CONQUISTOU_LEVOU',null))
                    order by descricao
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: TIPODEPOSITO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            readOnly {
                type: always
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--paddingMd
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P840_IDCONQUISTOULEVOU (
        type: selectList
        label {
            label: Campanha
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecampanha      d
                     , c.idconquistoulevou r
                  from roman.campanhasconquistoulevou c
                 where c.idpais = :P840_IDPAIS
                 order by c.nomecampanha
                ```
            nullDisplayValue: -- Selecione a Campanha --
        }
        cascadingLov {
            parentItems: P840_IDPAIS
            itemsToSubmit: P840_IDPAIS
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P840_IDDEP_CANCELAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P840_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select Decode(f.tipofilial,'L','Loja - ','Franquia - ')||f.nome d
                     , f.idfilial                                                      r
                  from roman.vw_filiais f
                 where f.ididioma    = :P840_IDPAIS
                   and f.tipofilial in ('L','D')
                 order by 1
                ```
            nullDisplayValue: -- Selecione a Empresa --
        }
        cascadingLov {
            parentItems: P840_IDPAIS
            itemsToSubmit: P840_IDPAIS
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P840_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome   d
                     , p.idpais r
                  from catal.paises p
                 order by p.nome
                ```
            nullDisplayValue: -- Selecione o País --
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P840_MOTIVO_CANCELAMENTO (
        type: textarea
        label {
            label: Motivo Cancelamento
            alignment: left
        }
        layout {
            sequence: 10
            region: @cancelar-depósito
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 5
        }
        validation {
            maxLength: 500
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--hot
                t-Button--stretch
                t-Button--gapTop
            ]
            icon: fa-search
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button confirmar-cancelamento (
        buttonName: CONFIRMAR_CANCELAMENTO
        label: Confirmar Cancelamento
        layout {
            sequence: 20
            region: @cancelar-depósito
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--hot
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button fechar-modal (
        buttonName: FECHAR_MODAL
        label: Fechar
        layout {
            sequence: 10
            region: @cancelar-depósito
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction buscar-depositos (
        name: Buscar Depositos
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @buscar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @depósitos-conquistou-levou
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction confirmar-cancelamento (
        name: Confirmar Cancelamento
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @confirmar-cancelamento
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    -- Cancelamento de deposito manual - 04/11/2026 (fase 2, item 2.5): a regra esta em
                    -- PCK_CONQUISTOULEVOU.PRC_CANCELA_DEPOSITO_MANUAL (devolve o saldo da campanha e reativa o deposito
                    -- anterior consumido). O codigo de uma acao dinamica tem limite de 4000 caracteres no APEX.
                    BEGIN
                      roman.pck_conquistoulevou.prc_cancela_deposito_manual( p_iddeposito => :P840_IDDEP_CANCELAR
                                                                           , p_idusuario  => :P0_IDUSUARIO
                                                                           , p_motivo     => :P840_MOTIVO_CANCELAMENTO );
                      COMMIT;
                    
                      :P840_MOTIVO_CANCELAMENTO := NULL;
                      :P840_IDDEP_CANCELAR      := NULL;
                    EXCEPTION
                      WHEN OTHERS THEN
                        ROLLBACK; -- nada fica pela metade: deposito, anterior, saldo e historico juntos
                        RAISE;
                    END;
                    ```
                itemsToSubmit: [
                    P840_IDDEP_CANCELAR
                    P840_MOTIVO_CANCELAMENTO
                ]
                itemsToReturn: [
                    P840_IDDEP_CANCELAR
                    P840_MOTIVO_CANCELAMENTO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.jQuery('#CANCELAR_DEPOSITO').dialog('close');
                    apex.message.showPageSuccess(unistr('Dep\00F3sito cancelado com sucesso!'));
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @depósitos-conquistou-levou
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction fechar-modal-cancelar (
        name: Fechar Modal Cancelar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @fechar-modal
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.jQuery('#CANCELAR_DEPOSITO').dialog('close')
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

