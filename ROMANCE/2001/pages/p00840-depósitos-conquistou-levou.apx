                type: always
            }
        )

        column IDDEPOSITOCONQUISTOULEVOU (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                databaseColumn: IDDEPOSITOCONQUISTOULEVOU
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDUSUARIOCANCELOU (
            type: selectList
