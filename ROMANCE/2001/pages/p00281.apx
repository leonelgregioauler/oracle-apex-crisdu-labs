page 281 (
    name: Atualiza horários de acesso
    title: Atualiza horários de acesso
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region atualiza-horários-de-acesso (
        name: Atualiza horários de acesso
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDHORARIOACESSO",
                "IDHORARIOACESSO" IDHORARIOACESSO_DISPLAY,
                "IDUSUARIO",
                "HORAINICIO",
                "HORAFIM",
                "DIA",
                "IDSISTEMA"
                from "CATAL"."HORARIOSACESSO"
                where idusuario = :P281_USUARIO
                AND IDSISTEMA = 2001
                ORDER BY 1
                
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <font color="red" size="6"> É muito importante manter o padrão na forma de colocar o horário!</font>
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: showAll
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column DIA (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Dia
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column HORAFIM (
            reportColumnQueryId: 5
            derivedColumn: N
            type: textField
            heading {
                heading: Até
                alignment: center
            }
            layout {
                sequence: 6
            }
            appearance {
                width: 12
            }
            sorting {
                sortable: false
            }
            advanced {
                customAttributes: style="text-align:center"
            }
        )

        column HORAINICIO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textField
            heading {
                heading: De
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 12
            }
            sorting {
                sortable: false
            }
            advanced {
                customAttributes: " style=\"text-align:center\""
            }
        )

        column IDHORARIOACESSO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 1
            }
            primaryKeySource {
                type: existingTrigger
            }
            sorting {
                sortable: false
            }
        )

        column IDHORARIOACESSO_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column IDSISTEMA (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 7
            }
        )

        column IDUSUARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

    )

    pageItem P281_USUARIO (
        type: selectList
        label {
            label: Colaborador
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pck_romance.fnc_nomepessoa(uu.idpessoa) display_value
                    , uu.idusuario return_value
                from usuariossistemas u
                    , usuarios uu
                where u.usuario = uu.usuario
                  and uu.ativo = 'S'  
                  and idsistema = 2001
                  and uu.idgerente = ( select idgerente
                                       from gerentes g
                                       where g.idfilial = :P0_IDFILIAL
                                         and g.ativo = 'S' )   
                order by 1  
                ```
        }
        layout {
            sequence: 10
            region: @atualiza-horários-de-acesso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @atualiza-horários-de-acesso
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idusuario-must-be-numeric (
        name: IDUSUARIO must be numeric
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @atualiza-horários-de-acesso
            type: columnIsNumeric
            column: IDUSUARIO
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDUSUARIO
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @atualiza-horários-de-acesso
        target {
            tableOwner: CATAL
            tableName: HORARIOSACESSO
            pkColumn: IDHORARIOACESSO
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 223932593655611003
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process gera-horarios (
        name: Gera horarios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                    begin
                      insert into catal.horariosacesso (idhorarioacesso,idusuario,horainicio,horafim,dia,idsistema)
                      select catal.seq_idhorariosacesso.nextval
                           , :P281_USUARIO
                           , horainicio
                           , horafim
                           , dia
                           , 2001
                      from catal.horariosacesso h
                      where sysdate between to_date(to_char(sysdate,'DD/MM/RRRR')||' '||h.horainicio,'DD/MM/RRRR HH24:MI:SS')
                                        and to_date(to_char(sysdate,'DD/MM/RRRR')||' '||h.horafim,'DD/MM/RRRR HH24:MI:SS')
                        and idsistema = 2001
                        and idusuario = ( select idusuario from usuarios where usuario = upper('everton'));
                    exception
                        when others then
                          null;
                    end;
                
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 221372373819003507
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 281
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

