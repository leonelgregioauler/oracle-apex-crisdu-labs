    pageItem P592_TELEFONE (
        type: textField
        label {
            label: Telefone
            alignment: left
        }
        layout {
            sequence: 50
            region: @envio-sms-boleto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  VTELEFONE VARCHAR2(30);
                BEGIN
                  --
                  SELECT TELEFONE
                  INTO VTELEFONE
                  FROM FAVORITA.TAREFAS T
                  WHERE EXISTS ( SELECT 1
                                 FROM NEGOCIACOESPARCEIROS NP
                                 WHERE NP.IDNEGOCIACAOPARCEIRO = :P592_IDNEGOCIACAOPARCEIRO
                                   AND NP.IDTAREFA             = T.IDTAREFA );
                  --
                  RETURN VTELEFONE;
                  --
                EXCEPTION
                  WHEN OTHERS THEN
                    NULL;
                END;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P592_TELEFONE_C (
        type: textField
        label {
            label: Telefone
            alignment: left
