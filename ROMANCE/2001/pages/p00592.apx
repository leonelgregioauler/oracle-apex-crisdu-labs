                ```plsql
                DECLARE
                  VTELEFONE VARCHAR2(30);
                BEGIN
                  --
                  SELECT TELEFONE
                  INTO VTELEFONE
                  FROM FAVORITA.TAREFAS T
                  WHERE EXISTS ( SELECT 1
                                 FROM NEGOCIACOESPARCEIROS NP
                                 WHERE NP.IDNEGOCIACAOPARCEIRO = :P592_IDNEGOCIACAOPARCEIRO
                                   AND NP.IDTAREFA             = T.IDTAREFA );
                  --
                  RETURN VTELEFONE;
                  --
                EXCEPTION
                  WHEN OTHERS THEN 
                    RETURN NULL;
                END;
                ```
        }
        security {
            encryptSessionState: false
        }
