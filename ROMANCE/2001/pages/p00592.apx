    process alterar-conta-bancaria (
        name: Alterar Conta Bancaria
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update negociacoesparceiros np
                  set np.idcontabancaria = :P592_IDCONTA_NOVA
                  where np.idnegociacaoparceiro = :P592_IDNEGOCIACAOPARCEIRO;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Conta Alterada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 4954355353666263926
        }
        serverSideCondition {
            whenButtonPressed: @alterar-conta
        }
    )

    process envia-sms (
        name: Envia SMS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare  
                  --
                  vidpagamento number := :P592_IDPAGAMENTO;
                  --
                begin
                  --
                  if vidpagamento < 0 then 
                    --
                    for i in ( select pp.idpagamentonegociacaoparceiro 
                               from roman.pagamentosnegociacoesparceiros pp
                               where pp.idnegociacaoparceiro = :P592_IDNEGOCIACAOPARCEIRO
                               order by 1 )
                    loop
                      --
                      pck_negociacoes_rmc.prc_envia_sms_boleto(pidpagamentonegociacao => i.idpagamentonegociacaoparceiro,
                                                               ptelefone => :P592_TELEFONE);
                      --
                    end loop;
                    --                                                
                  else
                    --
                       pck_negociacoes_rmc.prc_envia_sms_boleto(pidpagamentonegociacao => :P592_IDPAGAMENTO,
                                                                ptelefone => :P592_TELEFONE);
                    --  
                  end if;
                  -- 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Envio realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 4932740723554481340
        }
        serverSideCondition {
            type: request=Value
            value: ENVIAR_SMS
        }
    )

