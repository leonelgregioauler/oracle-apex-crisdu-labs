    pageItem P592_IDCONTA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @itens
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P592_IDCONTA_NOVA (
        type: selectList
        label {
            label: Conta Bancária
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.beneficiario||' ('||b.nomebanco||' - Ag: '||c.agencia||'- CC: '||c.conta||')' d
                     , c.idcontabanc r
                from roman.contasbancarias c
                   , roman.bancos b
                where b.idbanco = c.idbanco
                  and c.usosetorcobranca = 'S'
                  and c.idcontabanc != :P592_IDCONTA
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @mudar-conta-da-negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P592_IDMENSAGEMSMS (
        type: selectList
        label {
            label: Mensagem
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.mensagem
                     , m.idmensagemsms
                from roman.mensagenssms m
                where idpessoa is not null
                  and m.idprocessosistema = 10  
                  and exists ( select 1
                               from roman.negociacoesparceiros n
                                  , catal.vendedoras v
                               where v.idvendedora = n.idvendedora
                                 and v.idpessoa = m.idpessoa
                                 and n.idnegociacaoparceiro = :P592_IDNEGOCIACAOPARCEIRO )
                order by datainclusao desc
                ```
        }
        layout {
            sequence: 10
            region: @reenviar-sms
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P592_IDNEGOCIACAOPARCEIRO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @itens
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P592_IDPAGAMENTO (
        type: selectList
        label {
            label: Parcela
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 'Parcela: '||pp.numeroparcela||' de valor R$ '||trim(to_char(pp.valorparcela,'999G999G999G999G999G990D00')) d
                     , PP.IDPAGAMENTONEGOCIACAOPARCEIRO
                FROM PAGAMENTOSNEGOCIACOESPARCEIROS PP
                WHERE PP.IDNEGOCIACAOPARCEIRO = :P592_IDNEGOCIACAOPARCEIRO
                  AND PP.SITUACAO != 'Q'
                  AND EXISTS ( SELECT 1
                               FROM CONTROLEARQUIVOCAIXA CA
                               WHERE CA.IDPAGAMENTONEGOCIACAO = PP.IDPAGAMENTONEGOCIACAOPARCEIRO
                                 AND CA.DATAPROCESSADO        IS NOT NULL )
                union
                SELECT 'Parcela: '||pp.numeroparcela||' de valor R$ '||trim(to_char(pp.valorparcela,'999G999G999G999G999G990D00')) d
                     , PP.IDPAGAMENTONEGOCIACAOPARCEIRO
                FROM PAGAMENTOSNEGOCIACOESPARCEIROS PP
                WHERE PP.IDNEGOCIACAOPARCEIRO = :P592_IDNEGOCIACAOPARCEIRO
                  AND PP.SITUACAO != 'Q'
                  AND EXISTS ( SELECT 1
                               FROM FAVORITA.CONTROLEARQUIVOSBANCO CA
                               WHERE CA.IDPAGAMENTONEGOCIACAO = PP.IDPAGAMENTONEGOCIACAOPARCEIRO
                                 AND CA.DATAPROCESSADO        IS NOT NULL )
                ORDER BY 1
                ```
            nullDisplayValue: - Todos -
            nullReturnValue: -1
        }
        cascadingLov {
            parentItems: P592_IDNEGOCIACAOPARCEIRO
        }
        layout {
            sequence: 20
            region: @envio-sms-boleto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P592_IDPAGAMENTO_EMAIL (
        type: selectList
        label {
            label: Parcela
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 'Parcela: '||pp.numeroparcela||' de valor R$ '||trim(to_char(pp.valorparcela,'999G999G999G999G999G990D00')) d
                     , PP.IDPAGAMENTONEGOCIACAOPARCEIRO
                FROM PAGAMENTOSNEGOCIACOESPARCEIROS PP
                WHERE PP.IDNEGOCIACAOPARCEIRO = :P592_IDNEGOCIACAOPARCEIRO
                  AND PP.SITUACAO != 'Q'
                ORDER BY PP.NUMEROPARCELA
                ```
            nullDisplayValue: - Todos -
            nullReturnValue: -1
        }
        cascadingLov {
            parentItems: P592_IDNEGOCIACAOPARCEIRO
        }
        layout {
            sequence: 10
            region: @envio-email-boleto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P592_IDPAGAMENTO_PIX (
        type: selectList
        label {
            label: "Parcela "
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 'Parcela: '||pp.numeroparcela||' de valor R$ '||trim(to_char(pp.valorparcela,'999G999G999G999G999G990D00')) d
                     , PP.IDPAGAMENTONEGOCIACAOPARCEIRO
                FROM PAGAMENTOSNEGOCIACOESPARCEIROS PP
                WHERE PP.IDNEGOCIACAOPARCEIRO = :P592_IDNEGOCIACAOPARCEIRO
                  AND PP.SITUACAO != 'Q'
                  and pp.chavepix is not null
                  AND EXISTS ( SELECT 1
                               FROM FAVORITA.CONTROLEARQUIVOSBANCO CA
                               WHERE CA.IDPAGAMENTONEGOCIACAO = PP.IDPAGAMENTONEGOCIACAOPARCEIRO
                                 AND CA.DATAPROCESSADO        IS NOT NULL )
                ORDER BY numeroparcela
                ```
        }
        layout {
            sequence: 10
            region: @chave-pix-boleto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P592_IDUSUARIO (
        type: selectList
        label {
            label: Negociadora Nova
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) d
                     , u.idusuario r
                from usuarios u
                   , pessoas p
                where u.idpessoa = p.idpessoa
                  and u.ativo = 'S'
                  and u.idgerente = 80
                  and ( :P592_IDUSUARIONEGOCIACAO is null or u.idusuario != :P592_IDUSUARIONEGOCIACAO )
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @mudar-negociadora
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

