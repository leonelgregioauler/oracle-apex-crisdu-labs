page 592 (
    name: Manutenção Negociações
    title: Manutenção Negociações
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region chave-pix-boleto (
        name: Chave Pix Boleto
        type: staticContent
        layout {
            sequence: 80
            slot: contentBody
