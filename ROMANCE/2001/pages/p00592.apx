        }
    )

    process envio-email-boleto (
        name: Envio Email Boleto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare  
                  --
                  vidpagamento number := :P592_IDPAGAMENTO_EMAIL;
                  --
                begin
                  --
                  if vidpagamento < 0 then 
                    --
                    for i in ( select pp.idpagamentonegociacaoparceiro 
                               from roman.pagamentosnegociacoesparceiros pp
                               where pp.idnegociacaoparceiro = :P592_IDNEGOCIACAOPARCEIRO
                               order by 1 )
                    loop
                      --
                      pck_negociacoes_rmc.prc_confirma_envio_email(pidpagamentonegociacao => i.idpagamentonegociacaoparceiro,
                                                                   pemail => :P592_EMAIL);
                      --
                    end loop;
                    --                                                
                  else
                    --
                    pck_negociacoes_rmc.prc_confirma_envio_email(pidpagamentonegociacao => :P592_IDPAGAMENTO_EMAIL,
                                                                 pemail => :P592_EMAIL);
                    --  
                  end if;
                  -- 
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: "Confirmação de Email com sucesso! "
        }
        advanced {
            executionMappingIdentifier: 4954352951133263902
        }
        serverSideCondition {
            whenButtonPressed: @confirmar-email
        }
    )

    process renviar-sms (
        name: Renviar SMS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  cursor c1 is
                    select *
                    from roman.mensagenssms m 
                    where m.idmensagemsms = :P592_IDMENSAGEMSMS;
                  --
                  r1 c1%rowtype;
                  --
                  vidmensagemsms number;
                  vdatainclusao  date := sysdate;
                  vdataenvio     date;
                  vretorno       varchar2(1000) := null;
                  ventregue      varchar2(1);
                  --
                begin
                  --
                  open c1;
                  fetch c1 into r1;
                  close c1;
                  --
                  roman.pck_integracao_mob.prc_mensagenssms(pidmensagemsms          => vidmensagemsms,
                                                            ptelefone               => :P592_TELEFONE_R,
                                                            pmensagem               => :P592_MENSAGEM,
                                                            pdatainclusao           => vdatainclusao,
                                                            pdataenvio              => vdataenvio,
                                                            pretorno                => vretorno,
                                                            pidpessoa               => r1.idpessoa,
                                                            pidprocessosistema      => r1.idprocessosistema,
                                                            pentregue               => ventregue,
                                                            pidcontrolecontatossite => r1.idcontrolecontatossite,
                                                            pididioma               => r1.ididioma,
                                                            poperacaodml            => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: Envio realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 116720908185069317
        }
        serverSideCondition {
            type: request=Value
            value: REENVIAR_SMS
        }
    )

    process troca-negociadora (
        name: Troca Negociadora
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidusuario number;
                begin
                  --
                  if v('REQUEST') = 'REMOVER_NEGOCIADORA' then
                    vidusuario := null;
                  else
                    vidusuario := :P592_IDUSUARIO;
                  end if;
                  --
                  pck_negociacoes_rmc.prc_troca_negociadora(pidnegociacao => :P592_IDNEGOCIACAOPARCEIRO,
                                                            pidusuario => :P592_IDUSUARIO);
                  --
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Negociadora trocada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 4954354430993263917
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('REMOVER_NEGOCIADORA','TROCAR_NEGOCIADORA')
        }
    )

