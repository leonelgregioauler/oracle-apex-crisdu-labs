    pageItem P592_CHAVEPIX (
        type: textarea
        label {
            label: Chave PIX
            alignment: left
        }
        layout {
            sequence: 20
            region: @chave-pix-boleto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 5
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT PP.CHAVEPIX
                FROM PAGAMENTOSNEGOCIACOESPARCEIROS PP
                WHERE PP.IDPAGAMENTONEGOCIACAOPARCEIRO = :P592_IDPAGAMENTO_PIX
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

