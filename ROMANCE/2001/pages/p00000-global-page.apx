    pageItem P0_IDGRUPO (
        type: hidden
        layout {
            sequence: 40
            region: @default
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select listagg(idgrupoatendimento,',') within group ( order by 1 desc) a
                from usuariosgruposatendimento
                where usuario = v('APP_USER')
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_IDIDIOMA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @default
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select u.ididioma
                    from usuarios u
                    where u.usuario = v('APP_USER')
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vididioma number;
                begin
                  --
                  select u.ididioma
                  into vididioma
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  return(vididioma);
                  --
                end;
                ```
        }
        serverSideCondition {
            type: currentPage!=page
            page: 9999
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_IDPOSTOAVANCADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @regiao
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select u.idpostoavancado
                from usuarios u
                where u.usuario   = v('APP_USER');
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @default
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select idusuario
                from usuarios
                where usuario = v('APP_USER')
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_LIBERAR40COMPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @regiao
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select p.valor
                from parametros p
                where p.nome = 'LIBERAR40%COMPEDIDO'
                  and p.idfilial = :P0_IDFILIAL
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_NOMEFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @regiao
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select initcap(p.apelido)
                from pessoas p
                where p.idpessoa = ( select idpessoa
                                     from filiais f
                                     where idfilial = pck_romance.fnc_filialusuario(v('APP_USER')))
                ```
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P0_URLBOLETOBASE (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery: select favorita.fnc_base_url_boleto from dual
        }
    )

    pageItem P0_USUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @default
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select v('APP_USER')
                from dual
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button assistente-ia (
        buttonName: ASSISTENTE_IA
        label: Assistente Ia
        layout {
            sequence: 10
            region: @default
            slot: previous
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: chatbot
            icon: fa-chatbot
        }
        behavior {
            action: redirectOtherApp
            target: {
                app: 1234
                page: 1234
                items: {
                    P1234_PAGE_ID: &APP_PAGE_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosfiliais u
                where u.usuario = v('APP_USER')
                and u.idfilial in (1132, 1210, 290)
                and exists ( select *
                             from assistentes a,
                                  table(apex_string.split(a.idpagina, ':')) t
                             where t.column_value = v('APP_PAGE_ID') )
                union
                select 1
                from usuarios u
                where usuario = v('APP_USER')
                and exists ( select 1 
                             from usuariosgruposatendimento ug where ug.usuario = u.usuario
                             and idgrupoatendimento = 0 )
                 
                 /*select 1
                from usuariosfiliais u
                where u.usuario = v('APP_USER')
                and u.idfilial in (1132, 1210, 290)
                and v('APP_PAGE_ID') in (1, 7, 8, 32, 36, 37, 64, 89, 90, 232, 280, 292, 293, 404)
                union
                select 1
                from usuarios u
                where usuario = v('APP_USER')
                and exists ( select 1 
                             from usuariosgruposatendimento ug where ug.usuario = u.usuario
                             and idgrupoatendimento = 0 )*/
                ```
        }
    )

    dynamicAction ajusta-modal (
        name: Ajusta Modal
        execution {
            sequence: 40
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: currentPageNotInList
            pages: [
                375
                371
                397
                416
                4
                470
                249
            ]
        }

        action plugin-pretius-apex-enhanced-modal-dialog (
            action: plugin/pretiusApexEnhancedModalDialog
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction busca-semana (
        name: Busca Semana
        execution {
            sequence: 60
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :SEMANAATUAL is null
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      select trim(to_char(semana,'00')||'/'||to_char(ano))
                      into :SEMANAATUAL
                      from semana_dias
                      where sysdate between dt_ini and dt_fim+1;
                    exception
                      when others then
                        null;
                    end;
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction esconde-menu (
        name: Esconde Menu
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(window).on("theme42ready", function() {
                    
                       if ($("body").hasClass("js-navExpanded")) {
                    
                       $("#t_Button_navControl").click();
                    
                      }
                    
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction insere-expediente (
        name: Insere expediente
        execution {
            sequence: 50
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      -- Call the procedure
                      catal.pck_util.prc_registraexpediente(pidsistema => 2001,pprocesso=>'I');
                    end;
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction notificationlist (
        name: notificationList
        execution {
            sequence: 1
        }
        when {
            event: ready
        }

        action plugin-apex-notification (
            action: plugin/apexNotificationMenu
            settings {
                sqlSource:
                    ```sql
                    SELECT NOTE_ICON        AS  NOTE_ICON
                         , NOTE_ICON_COLOR  AS  NOTE_ICON_COLOR
                         , NOTE_HEADER      AS  NOTE_HEADER
                         , NOTE_TEXT        AS  NOTE_TEXT
                         , NOTE_LINK        AS  NOTE_LINK
                         , NOTE_COLOR       AS  NOTE_COLOR
                    FROM ( select t.idnotificacaointerna
                                      , case
                                          when t.type = 'SUCCESS' then-- t.tiponotificacao = 'P' then
                                            'fa-commenting'
                                          when t.type = 'WARNING' then --t.tiponotificacao = 'G' then
                                            'fa-exclamation-triangle'
                                          when t.type = 'DANGER' then
                                            'fa-exclamation'
                                          end                    NOTE_ICON
                                      , case
                                          when t.type = 'SUCCESS' then-- t.tiponotificacao = 'P' then
                                            '#26a043'
                                          when t.type = 'WARNING' then --t.tiponotificacao = 'G' then
                                            'rgb(180,180,100)'--'#3e6ebc'
                                          when t.type = 'DANGER' then
                                            'rgb(192,0,15)'
                                          end                    NOTE_ICON_COLOR
                    
                                     , t.titulo                  NOTE_HEADER
                                     , trim(to_char(t.datanotificacao,'hh24:mi:ss'))||'<br>'|| t.descricao               NOTE_TEXT
                                     , t.url                     NOTE_LINK
                                      , case
                                          when t.type = 'SUCCESS' then-- t.tiponotificacao = 'P' then
                                            '#26a043'
                                          when t.type = 'WARNING' then --t.tiponotificacao = 'G' then
                                            'rgb(180,180,100)'--'#3e6ebc'
                                          when t.type = 'DANGER' then
                                            'rgb(192,0,15)'
                                          end     NOTE_COLOR
                                     , t.dataleitura
                                from NOTIFICACOESINTERNAS t
                                where t.dataenviado is null
                                  and t.dataleitura is null
                                  and t.datanotificacao >= sysdate-0.04
                                        and ( ( t.tiponotificacao = 'P' and iddestino = :P0_IDUSUARIO )
                                             or ( t.tiponotificacao = 'G' and ( exists ( select 1 
                                                                                         from usuariosgruposatendimento u
                                                                                         where u.usuario            = v('APP_USER')
                                                                                           and u.idgrupoatendimento = iddestino ) 
                                                                               or t.iddestino = v('APP_ID')))
                                             or ( t.tiponotificacao = 'Z' ) )    
                            ORDER BY 1 DESC )
                    WHERE ROWNUM <= 100   
                    ```
                itemsToSubmit: P0_IDUSUARIO
            }
            execution {
                sequence: 10
            }
        )

    )

)

