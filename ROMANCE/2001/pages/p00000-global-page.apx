    pageItem P0_AVISO_NORMAL (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 10
            region: @questionamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText:
                ```html
                <font color="BLUE">    Você possui um Questionamento pendente de leitura! Por favor verifique a informação ou entre em contato com a Controladoria!
                    </font>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from questionamentoscontroladoria q
                               where ( nvl(q.confirmacaoleitura,'N') = 'N'
                                     or ( confirmacaoleitura = 'S' and resposta is null ) )
                                 and confirmarenvio = 'S'
                                 and trunc(sysdate) - trunc(q.datainclusao) < 7
                                 and ( q.idfilial = pck_romance.fnc_filialusuario(v('APP_USER'))
                                    or q.idpessoa = ( select idpessoa
                                                      from usuarios u
                                                      where u.usuario = v('APP_USER') ) ) )
                  and exists ( select 1
                               from usuarios u
                               where u.usuario = v('APP_USER')
                                 and ( exists ( select 1
                                                from gerentes g
                                                where g.idpessoa = u.idpessoa )
