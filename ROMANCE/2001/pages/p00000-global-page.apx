        }
    )

    pageItem P0_COMISSAOFAVORITAGERENTE (
        type: displayOnly
        label {
            label: Sua Comissão Favorita
            alignment: left
        }
        layout {
            sequence: 80
            region: @regiao
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vvalor   number(15,2);
                  vvalor2  number(15,2);
                  vtotal  number(15,2);
                begin  
                  --
                 /* select round(sum(comissao),2)
                  into vvalor
                  from vw_comissoes_pagar t
                  where idgerente = ( select idgerente
                                      from gerentes
                                      where idfilial = :P0_IDFILIAL)
                    and not exists ( select 1 
                                     from pagamentocomissoes pp
                                     where pp.idpedido  = t.idpedido 
                                       and pp.idgerente is not null
                                       and pp.idgerente = ( select idgerente
                                                            from gerentes
                                                            where idfilial = :P0_IDFILIAL) );*/
                  --
                  select round(sum(comissaogerente),2)
                  into vvalor2
                  from favorita.vw_comissoes_pagar_fav tf
                  where idgerente = ( select idgerente
                                      from gerentes
                                      where idfilial = :P0_IDFILIAL)
                    and not exists ( select 1 
                                     from pagamentocomissoes pp
                                     where pp.idpedido  = tf.idpedido 
                                       and pp.idgerente is not null
                                       and pp.idgerente = ( select idgerente
                                                            from gerentes
                                                            where idfilial = :P0_IDFILIAL) );
                  --
                  vtotal := nvl(vvalor,0) + nvl(vvalor2,0);
                  --
                  return to_char(vtotal,'999G999G999G990D00');
                  --
                end;
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from gerentes G
                   , usuarios u
                where g.idfilial = :P0_IDFILIAL
                  and g.idpessoa = u.idpessoa
                  and (V('APP_USER') = 'EVERTON' or u.usuario = V('APP_USER') )
                  and v('APP_PAGE_ID') in (74)
                  and 1 =2
                ```
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments: iria colocar esse campo, mas a tela ficou muito lenta
        }
    )

    pageItem P0_ESTOQUECONGELADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @regiao
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vdistribuicao varchar2(1) := 'N';
                begin
                  --
                  select 'S'
                  into vdistribuicao
                  from dual 
                  where exists ( select 1
                                 from distribuicaocargas d
                                 where d.idfilial = :P0_IDFILIAL
                                   and d.situacao = 'A'
                                   and trunc(d.datainicio) between trunc(sysdate)-4 and trunc(sysdate)+1 );
                  --
                  return vdistribuicao;
                  --
                exception
                  when others then
                    return 'N';
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_ESTOQUEPORGRADE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @regiao
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select p.valor
                from parametros p
                where p.nome = 'ESTOQUEPORGRADE'
                  and p.idfilial = :P0_IDFILIAL
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_IDFECHAMENTO (
        type: selectList
        label {
            label: Fechamento
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select '- Ver Tudo -' display_value
                     , 999999999999   return_value
                from dual
                union
                select semana||' - '|| decode(f.concluido ,'S','Concluído','Aberto') display_value
                     , idfechamento return_value
                from fechamentossemanais f
                where idfilial = :P0_IDFILIAL
                  and f.idfilialfavorita is null
                order by 2 desc
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 70
            region: @regiao
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: select
            height: 1
        }
        serverSideCondition {
            type: currentPageInList
            pages: [
                70
                81
                84
                74
                89
                162
                250
                173
                91
                340
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select (select initcap(nvl(apelido,nomepessoa))
                        from pessoas 
                        where idpessoa = f.idpessoa)|| CASE when v('APP_USER') in ('EVERTON','GUILHERME','LUIZV','FERNANDO','CESARH','KELVISD','THIAGOSOUZA','JACKSONM','BRUNOB','OSIELF','DIEGOPIECHO') then ' - '||f.idfilial end display_value , f.idfilial
                from filiais f
                where ( f.tipofilial = 'D' or f.tipofilial = 'O' and idfilial in (1085,1088,1153,1150) or f.tipofilial = 'F' and idfilial in (1075, 1150) or f.tipofilial = 'R' and idfilial = 240 or f.tipofilial = 'A')
                  and f.ativo = 'S'and f.idfilial != 1217 and exists ( select 1 from usuariosfiliais u where u.idfilial  = f.idfilial and u.usuario   = v('APP_USER'))
                union
                select (select initcap(nvl(apelido,nomepessoa)) from pessoas where idpessoa = f.idpessoa)|| CASE when v('APP_USER') in ('EVERTON','GUILHERME','CESARH','FERNANDO','OSIELF','DIEGOPIECHO') then ' - '||f.idfilial end display_value , f.idfilial
                from filiais f
                where idfilial = pck_romance.fnc_filialusuario(v('APP_USER')) and f.idgrupo != 6
                union
                select '- Todas - ' display_value , -1 return_value
                from dual
                where v('APP_USER') IN ('EVERTON','EDUARDO','GUILHERME','CESARH','RAFAELK','PAULOSARAIVA','OSIELF','DIEGOPIECHO','FERNANDO','RENATAF','KEIZIH','KELVISD','RAIMUNDOROB','EDUARDAZOTTI')
                UNION all
                select f.nome, f.idfilial
                from vw_filiais f
                where f.idfilial in (160,1088) and v('APP_USER') in ('GUILHERME','FERNANDO','OSIELF','CESARH','DIEGOPIECHO','KELVISD','EMERSONF','ALFREDFILHO','KEIZIH')
                union all
                select '- Brasil - ' display_value , -2 return_value
                from dual
                where v('APP_USER') IN ('GUILHERME','OSIELF','CESARH', 'DIEGOPIECHO','RAFAELK','SUELENBAUER', 'VINICIUSO','MAIQUELLINDEN')
                union all
                select '- América Latina - ' display_value , -3 return_value
                from dual
                where v('APP_USER') IN ('GUILHERME','CESARH','OSIELF','DIEGOPIECHO','RAFAELK', 'EDUARDAZOTTI', 'JULIASOUZA')
                union all
                select f.nome, f.idfilial
                from vw_filiais f
                where f.idfilial = 1217
                  and v('APP_USER') IN ('FERNANDO','KEIZIH','GUILHERME','EVERTON','MYCON','OSIELF','CESARH','FERNANDAS','LILIANCOSTA','LEDIELEPERES','LUCASSOUZA','CAMILABARTH','EDUARDAZOTTI','JOSIELEDIAS', 'PAULINENAUMANN','BRUNOMATHEUS','RAIMUNDOROB', 'DANIELATHEWES','TIESSAMASOTTI')
                union all
                select f.nome, f.idfilial
                from vw_filiais f
                where f.idfilial in (1067)
                  and v('APP_USER') IN ('BRUNOB','FERNANDO','OSIELF','DIEGOPIECHO') 
                union all
                select distinct 'Regional '||f.regional nome , f.regional idfilial
                  from catal.filiais f
                 where f.regional is not null
                   and f.regional = 1 
                   and v('APP_USER') in ('RAFAELK','DANIELEPACHECO','GUILHERME','DIEGOPIECHO','CESARH','MAIQUELLINDEN','VINICIUSO')
                union all
                select distinct 'Regional '||f.regional nome, f.regional idfilial
                  from catal.filiais f
                 where f.regional is not null
                   and f.regional = 2 
                   and v('APP_USER') in ('RAFAELK','GUILHERME','DIEGOPIECHO','CESARH','MAIQUELLINDEN','NAYARAMUNIZ','VINICIUSO')
                union all
                select distinct 'Regional '||f.regional nome , f.regional idfilial
                  from catal.filiais f
                 where f.regional is not null
                   and f.regional = 3 
                   and v('APP_USER') in ('RAFAELK','BETHANIASOUTO','GUILHERME','DIEGOPIECHO','CESARH','MAIQUELLINDEN','VINICIUSO')
                union all
                select distinct 'Regional '||f.regional nome , f.regional idfilial
                  from catal.filiais f
                 where f.regional is not null
                   and f.regional = 4
                   and v('APP_USER') in ('RAFAELK','GUILHERME','DIEGOPIECHO','CESARH','MAIQUELLINDEN','LIVIAROSARIO','OSIELF','VINICIUSO')
                union all
                select distinct 'Regional '||f.regional nome, f.regional idfilial
                  from catal.filiais f
                 where f.regional is not null
                   and f.regional = 7
                   and v('APP_USER') in ('RAFAELK','GUILHERME','DIEGOPIECHO','CESARH','MAIQUELLINDEN','OSIELF','VINICIUSO')
                union
                select f.nome , f.idfilial
                from vw_filiais f
                where f.idfilial = 1135 -- Comercial Romance
                  and v('APP_USER') IN ('RAFAELK','SUELENBAUER','MAIQUELLINDEN','VINICIUSO', 'EDUARDAZOTTI') 
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @regiao
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: select
            height: 1
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return pck_romance.fnc_filialusuario(v('APP_USER'));
                end;
                ```
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidfilial number;
                begin
                  if :P0_IDFILIAL is null then
                    vidfilial := pck_romance.fnc_filialusuario(v('APP_USER'));
                    if vidfilial = 1135 and v('APP_USER') != 'RAFAELK' then
                      return null;
                    else
                      return vidfilial;
                    end if;
                    --
                  else 
                    return :P0_IDFILIAL;
                  end if;
                end;
                ```
        }
