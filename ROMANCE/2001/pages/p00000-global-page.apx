page 0 (
    name: 0
    appearance {
        templateOptions: #DEFAULT#
    }

    region aviso-distribuicao-em-andamento (
        name: Aviso Distribuicao em Andamento
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where exists ( select 1
                               from distribuicaocargas d
                               where d.idfilial = :P0_IDFILIAL
                                 and d.situacao = 'A'
                                 and trunc(d.datainicio) between trunc(sysdate)-4 and trunc(sysdate)+1 )
                  and v('APP_PAGE_ID') in (1,2,41,47,16,13,113,115,112,741)
                ```
        }
    )

    region default (
        name: default
        type: staticContent
        source {
            htmlCode:
                ```html
                <script src="https://code.jquery.com/jquery-1.10.2.js"></script>
                
                <style>
                .js-navCollapsed .t-TreeNav .a-TreeView-node--topLevel>.a-TreeView-content.is-hover .a-TreeView-label {
                	visibility: visible;
                	left: 48px;
                	padding: 0 16px;
                	width: auto; 
                	background-color: #0459a1; /* This would be your primary color */
                }
                
                .apex-side-nav.js-navCollapsed .t-Body-nav
                , .apex-side-nav.js-navCollapsed .t-Body-nav .t-TreeNav {
                    z-index: 999; /* Make it appear on top of the page content */
                }
                
                </style>
                ```
        }
        layout {
            sequence: 10
            slot: footer
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
    )

    region questionamento (
        name: Questionamento
        type: staticContent
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from questionamentoscontroladoria q
                               where ( nvl(q.confirmacaoleitura,'N') = 'N'
                                     or ( confirmacaoleitura = 'S' and resposta is null ) )
                                 and confirmarenvio = 'S'
                                 and ( q.idpessoa = ( select idpessoa
                                                        from usuarios u
                                                        where u.usuario = v('APP_USER') ) ) 
                                    or v('APP_USER')= 'EVERTON'
                                    or exists ( select 1
                                                from usuarios u
                                                where u.usuario = v('APP_USER')
                                                  and pck_romance.fnc_filialusuario(v('APP_USER')) = q.idfilial
                                                  and ( exists ( select 1
                                                                 from gerentes g
                                                                 where g.idpessoa = u.idpessoa )
                                                     or exists ( select 1
                                                                 from secretarias s
                                                                 where s.idpessoa = u.idpessoa ) ) ) )
                  and exists ( select 1
                               from acessos a
                               where a.usuario = v('APP_USER') 
                                 and a.idaplicacao = 2550 )
                  and v('APP_PAGE_ID') not in (749,389,157,20,49,128,153,168,175,228,237,242,246,251,256,26,270,285,324,333,338,363,431,449,455,454,453,457,483,484,284,85,497,498,82,86,77,666,501,529,699,741,545,716,575,573,602)
                  and v('APP_PAGE_ID') not in (690,293,161,680,790)
                ```
        }
    )

    region regiao (
        name: REGIAO
        type: staticContent
        source {
            htmlCode:
                ```html
                <script language="javascript">
                
                
                function fnc_imprimelistapreco()
                {
                  window.open('f?p=&APP_ID.:154:&SESSION.::NO::','listapreco', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=700,height=800,left=600,top=100','_blank'); void(0);
                }
                
                function ExibeAguarde() {
                 window.aguarde = {posicao:$(document).scrollTop(),
                       $aguarde: $("<div>").css({"position":"absolute", 
                        "top":"0px",
                        "left":"0px",
                        "right":"0px",
                        "bottom":"0px",
                        "background":"white",
                        "text-align":"center",
                        "font-size":"20px",
                        "padding-top":"25%",
                        "cursor":"progress",
                        "z-index":10000})
                       .text("Aguarde... Pedido está sendo Integrado!")
                       .appendTo($("body"))
                      };
                
                 $(document).scrollTop(0);
                 window.aguarde.$aguarde.show();
                }
                
                function OcultaAguarde() {
                 window.aguarde.$aguarde.remove();
                 $(document).scrollTop(window.aguarde.posicao);
                
                }
                
                </script>
                
                <!-- Global site tag (gtag.js) - Google Analytics -->
                <script async src="https://www.googletagmanager.com/gtag/js?id=UA-105581092-1"></script>
                <script>
                  window.dataLayer = window.dataLayer || [];
                  function gtag(){dataLayer.push(arguments);}
                  gtag('js', new Date());
                
                  gtag('config', 'UA-105581092-1');
                </script>
                
                ```
        }
        layout {
            sequence: 30
            slot: breadcrumbBar
        }
        appearance {
            renderComponents: belowContent
        }
        serverSideCondition {
            type: currentPageNotInList
            pages: [
                271
                357
                358
                359
                360
                109
                370
                385
                393
                455
                496
                422
                510
                511
                424
                423
                625
                624
                626
                627
                628
                636
                699
                682
                741
                790
            ]
        }
    )

    pageItem P0_AVISO_ATRASADA (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 20
            region: @questionamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText: <font color="RED">    Você possui um Questionamento pendente de leitura a mais de 7 dias! Por favor verifique a informação ou entre em contato com a Controladoria!</font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from questionamentoscontroladoria q
                               where ( nvl(q.confirmacaoleitura,'N') = 'N'
                                     or ( confirmacaoleitura = 'S' and resposta is null ) )
                                 and confirmarenvio = 'S'
                                 and trunc(sysdate) - trunc(q.datainclusao) >= 7
                                 and ( q.idfilial = pck_romance.fnc_filialusuario(v('APP_USER'))
                                    or q.idpessoa = ( select idpessoa
                                                      from usuarios u
                                                      where u.usuario = v('APP_USER') ) ) )
                  and exists ( select 1
                               from usuarios u
                               where u.usuario = v('APP_USER')
                                 and ( exists ( select 1
                                                from gerentes g
                                                where g.idpessoa = u.idpessoa )
                                    or exists ( select 1
                                                from secretarias s
                                                where s.idpessoa = u.idpessoa ) ) )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

