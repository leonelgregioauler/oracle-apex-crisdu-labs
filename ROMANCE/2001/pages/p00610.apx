            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @log-devoluções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh-relatorio (
        name: Refresh Relatorio
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P610_IDDEVOLUCAOREPRESENTANTE
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P610_IDDEVOLUCAOREPRESENTANTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @log-devoluções
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

