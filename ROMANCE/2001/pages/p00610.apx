page 610 (
    name: Log Devoluções Representantes
    title: Log Devoluções Representantes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region log-devoluções (
        name: Log Devoluções
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ld.usuarioalteracao
                     , decode(TIPOALTERACAO,'INSERT','Inclusão','UPDATE','Alteração','DELETE','Exclusão') "Tipo Alt."
                     , ld.dataalteracao
                     , ld.iddevolucaorepres
                     , roman.pck_romance.fnc_nomerepresentante(ld.idrepresentante) "Distribuidor"
                     , ld.semana
                     , ld.valortotal
                     , ld.idfilial
                     , decode(situacao, 1,'Aberta', 2,'Aguardando Conclusão', 3, 'Concluída',0, 'Cancelada') "Situação"  
                     , ld.observacao
                     , ld.dataconclusao
                     , ld.idsemana
                     , ld.datainclusao
                     , ld.usuario
                     , ld.idpostoavancado
                from logroman.log_devolucoesrepresentant ld
                where iddevolucaorepres = :P610_IDDEVOLUCAOREPRESENTANTE
                order by 3 desc
                ```
            pageItemsToSubmit: P610_IDDEVOLUCAOREPRESENTANTE
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma informação encontrada
        }
        advanced {
            savedReportMappingIdentifier: 110418662952270405
        }

        column DATAALTERACAO (
            type: plainText
            heading {
                heading: Data de  Alteração
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

