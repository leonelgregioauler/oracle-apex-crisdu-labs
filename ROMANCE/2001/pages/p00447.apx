page 447 (
    name: Acompanhamento dos Atendimentos
    title: Acompanhamento dos Atendimentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-dos-atencimentos (
        name: Acompanhamento dos Atencimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(idvendedora) consultora
                     , pck_romance.fnc_cpfvendedora(nv.idvendedora) cpf
                     , nv.numeronota
                     , pck_romance.fnc_nomeregiaovenda(nv.idregiaovenda) regiaovenda
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.dataretorno
                     , nv.dataretornoorig
                     , nv.valortotalnota
                     , pck_romance.fnc_retornatelefones(nv.idvendedora) telefones
                     , idnotavenda
                     , nv.idsemanacobranca - nv.idsemanadistribuicao qtdsemanas
                from notasvendas nv
                where nv.idsituacaonotavenda = 3
                  and ( :P447_TIPOATENDIMENTO = 'T'
                      or ( :P447_TIPOATENDIMENTO = 'N' and nv.idsemanacobranca - nv.idsemanadistribuicao <= 6 )
                      or ( :P447_TIPOATENDIMENTO = 'A' and nv.idsemanacobranca - nv.idsemanadistribuicao > 6 ) )
                  and nv.idrepresentante = :P447_IDREPRESENTANTE 
                  and :P447_TIPORELATORIO = 'D'
                order by 1
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P447_TIPORELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1507104536752630834
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

