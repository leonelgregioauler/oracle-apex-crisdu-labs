        }

        savedReport 15082206 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn DISTRIBUIDOR (
                sequence: 1
            )

            displayColumn QUANTIDADE (
                sequence: 2
            )

            sort (
                column: QUANTIDADE
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            aggregate (
                column: QUANTIDADE
            )

        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P447_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||decode(r.ativo,'S','Ativo','N','Inativo') display_value
                     , r.idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes 
                                      where idfilial = :P0_IDFILIAL )
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P447_TIPOATENDIMENTO (
        type: radioGroup
        label {
            label: Atendimento
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2: Normal;N,Atrasado;A,Todos;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P447_TIPORELATORIO (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2: Detalhado;D,Resumido;R
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 447
                items: {
                    P447_IDREPRESENTANTE: &P447_IDREPRESENTANTE.
                    P447_TIPOATENDIMENTO: &P447_TIPOATENDIMENTO.
                    P447_TIPORELATORIO: &P447_TIPORELATORIO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

)

