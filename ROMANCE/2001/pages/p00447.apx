    region acompanhamnento-dos-atendimentos (
        name: Acompanhamnento dos Atendimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor
                     , count(1) quantidade
                from notasvendas nv
                where nv.idsituacaonotavenda = 3
                  and nv.idfilial = :P0_IDFILIAL
                  and ( :P447_TIPOATENDIMENTO = 'T'
                      or ( :P447_TIPOATENDIMENTO = 'N' and nv.idsemanacobranca - nv.idsemanadistribuicao <= 6 )
                      or ( :P447_TIPOATENDIMENTO = 'A' and nv.idsemanacobranca - nv.idsemanadistribuicao > 6 ) )
                  and ( :P447_IDREPRESENTATE is null or nv.idrepresentante = :P447_IDREPRESENTANTE )
                  and :P447_TIPORELATORIO = 'R'
                group by nv.idrepresentante
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P447_TIPORELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1507104067485630829
        }

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
