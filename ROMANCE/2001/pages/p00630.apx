page 630 (
    name: Pagamentos Realizados
    title: Pagamentos Realizados
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 50%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region pagamentos-realizados (
        name: Pagamentos Realizados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pg.data
                     , pg.valorpago
                     , pg.observacao
                     , decode(pg.tipo,'P','Pagamento','D','Desconto') TIPO
                     , decode(Pg.conferido,'S','Sim') CONFERIDO
                     , decode(pg.identificacao,'DR','Dinheiro','TF','Transferência','CH','Cheque') IDENTIFICAÇÃO
                from roman.pagamentosnegociacoesbalanco pg
                where pg.idnegociacaobalanco = :P630_IDNEGOCIACAOBALANCO
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CONFERIDO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Conferido
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column DATA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 1
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column IDENTIFICAÇÃO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Identificação
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column TIPO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column VALORPAGO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P630_IDNEGOCIACAOBALANCO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @pagamentos-realizados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

