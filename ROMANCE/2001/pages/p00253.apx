    region pedidos-pagos-detalhado (
        name: Pedidos Pagos Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido
                     , 'P'||p.nrpedido "Nr Pedido"
                     , pck_romance.fnc_nomevendedora(pidvendedora => p.idvendedora) "Vendedora"
                     , pck_romance.fnc_retornatelefones(p.idvendedora) telefone
                     , p.databaixa "Data Baixa"
                     , p.datavencimento "Data Vencimento"
                     , p.valorcobrado "Valor Total"
                     , p.comissao  vlrdistrib
                     , nvl(( select 'Sim'
                             from dual
                             where exists ( select 1 
                                            from pagamentocomissoes pf
                                            where pf.idpedido = p.idpedido
                                              and pf.idrepresentante = p.idrepresentante )) ,'Não') comissaopagadist
                     , p.comissaogerente vlrgerente
                     , nvl(( select 'Sim'
                             from dual
                             where exists ( select 1
                                            from pagamentocomissoes pf
                                            where pf.idpedido = p.idpedido
                                              and pf.idgerente = p.idgerente ) ) ,'Não') comissaopagager
                     , ( select count(1)
                         from boletos v
                         where v.idpedido = p.idpedido
                           and v.situacao != 'Z')||'/'||              
                       ( select count(1)
                         from boletos v
                         where v.idpedido = p.idpedido
                           and v.situacao != 'Z'
                           and databaixa is not null) boletosquitados
                     , p.valorcobrado base_comissao
                from vw_comissoes_pagar p
                where (:P253_CLIENTE is null or p.idrepresentante = :P253_CLIENTE)
                  and p.idfilial = :P0_IDFILIAL
                  and ( :P253_TIPO_DATA is null
                    or ( :P253_TIPO_DATA = 'S' and pck_util.fnc_idsemanadata(p.databaixa) = :P253_IDSEMANA )
                    or ( :P253_TIPO_DATA = 'B' and trunc(p.databaixa) between to_date(:P253_DTINI,'dd/mm/yyyy') and to_date(:P253_DTFIM,'dd/mm/yyyy') ) )
                  and :P253_FILTRAR = 'S'
                union all
                select pp.idpedido 
                     , pp.numeropedido
                     , pp.vendedora
                     , pck_romance.fnc_retornatelefones(pp.idvendedora)
                     , pp.databaixa
                     , pp.datavencimentomenor
                     , pp.valorapagar
                     , nvl(pp.comissaodistribuidor,0)
                     , nvl(( select 'Sim'
                             from pagamentocomissoes pf
                             where pf.idpedido = pp.idpedido
                               and pf.idrepresentante = pp.idrepresentante
                               and pf.idvencimentopedido = pp.idvencimentopedido
                               and rownum <= 1 ) ,'Não')
                     , nvl(pp.comissaogerente,0)
                     , nvl(( select 'Sim'
                             from pagamentocomissoes pf
                             where pf.idpedido = pp.idpedido
                               and pf.idgerente = pp.idgerente
                               and pf.idvencimentopedido = pp.idvencimentopedido
                               and rownum <= 1 ) ,'Não')
                     , null boletosquitados
                     , case
                         when exists ( select 1
                                       from favorita.classificacoespedidos cp
                                       where cp.idpedido = pp.idpedido
                                         and cp.idcaracteristicapedido = 106 
                                         and exists (select 1
                                                       from favorita.itenspedidos
                                                      where idpedido = pp.idpedido
                                                        and perccomissaodistribuidor = 18)  ) then
                          round(( select ( valortotal * 0.70 )
                                   from favorita.pedidos p
                                   where p.idpedido = pp.idpedido ) / ( select count(1)
                                                                        from favorita.vencimentospedidos vc
                                                                        where vc.idpedido = pp.idpedido
                                                                          and vc.situacaovencimento = 'V' ),2) 
                         else
                           round( pp.valorapagar / ( select count(1)
                                                    from favorita.vencimentospedidos vc
                                                    where vc.idpedido = pp.idpedido
                                                      and vc.situacaovencimento = 'V' ),2) 
                       end base_comissao
                from favorita.VW_COMISSOESPAGAR_NOVA_M pp
                where (:P253_CLIENTE is null or pp.idrepresentante = :P253_CLIENTE)
                  and pp.idfilialromance = :P0_IDFILIAL
                  and ( :P253_TIPO_DATA is null
                    or ( :P253_TIPO_DATA = 'S' and pp.idsemanabaixa = :P253_IDSEMANA )
                    or ( :P253_TIPO_DATA = 'B' and trunc(pp.databaixa) between to_date(:P253_DTINI,'dd/mm/yyyy') and to_date(:P253_DTFIM,'dd/mm/yyyy') ) )
                  and :P253_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P253_TIPO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Use os Filtros
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 80377993847857921
        }

