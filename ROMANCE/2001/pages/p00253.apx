    region pedidos-pagos-resumidos (
        name: Pedidos Pagos Resumidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with t1 as (select representante  Representante
                                 , sum(valortotal) ValorTotal
                                 , count(1) QtdBoletos
                                 , idrepresentante
                            from (select p.idpedido
                                       , p.nrpedido NrPedido
                                       , pck_romance.fnc_nomerepresentante(idrepresentante) representante
                                       , pck_romance.fnc_nomevendedora(pidvendedora => p.idvendedora) Vendedora
                                       , pck_romance.fnc_retornatelefones(p.idvendedora) telefone
                                       , p.databaixa DataBaixa
                                       , p.datavencimento DataVencimento
                                       , p.valorcobrado ValorTotal
                                       , p.idrepresentante
                                  from vw_comissoes_pagar p
                                  where ( :P253_CLIENTE is null or p.idrepresentante = :P253_CLIENTE )
                                    and p.idfilial = :P0_IDFILIAL
                                    and ( :P253_DTINI is null or p.databaixa between to_date(:P253_DTINI,'dd/mm/rrrr') and to_date(:P253_DTFIM,'dd/mm/rrrr') )
                                  union
                                  select distinct pf.idpedido
                                               , pf.numeropedido
                                               , pf.representante
                                               , pf.vendedora
                                               , pck_romance.fnc_retornatelefones(pf.idvendedora)
                                               , pf.databaixa
                                               , pf.datavencimentomenor
                                               , pf.valorapagar 
                                               , pf.idrepresentante
                                  from favorita.VW_COMISSOESPAGAR_NOVA_M pf
                                  where ( :P253_CLIENTE is null or pf.idrepresentante = :P253_CLIENTE )
                                    and pf.idfilialromance = :P0_IDFILIAL
                                    and (:P253_DTINI is null or pf.databaixa between to_date(:P253_DTINI,'dd/mm/rrrr') and to_date(:P253_DTFIM,'dd/mm/rrrr') )  
                                  order by 5 desc )    
                            group by representante, idrepresentante
                            order by 1)
                   , t2 as (select  sum(valortotal) ValorTotalAnt
                                 , count(1) QtdBoletosAnt
                                 , idrepresentante
                            from (select p.idpedido
                                       , p.nrpedido NrPedido
                                       , pck_romance.fnc_nomerepresentante(idrepresentante) representante
                                       , pck_romance.fnc_nomevendedora(pidvendedora => p.idvendedora) Vendedora
                                       , pck_romance.fnc_retornatelefones(p.idvendedora) telefone
                                       , p.databaixa DataBaixa
                                       , p.datavencimento DataVencimento
                                       , p.valorcobrado ValorTotal
                                       , p.idrepresentante
                                  from vw_comissoes_pagar p
                                  where ( :P253_CLIENTE is null or p.idrepresentante = :P253_CLIENTE )
                                    and p.idfilial = :P0_IDFILIAL
                                    and (:P253_DTINI is null or p.databaixa between add_months(to_date(:P253_DTINI,'dd/mm/rrrr'),-12) and add_months(to_date(:P253_DTFIM,'dd/mm/rrrr'),-12))
                                  union
                                  select distinct pf.idpedido
                                       , pf.numeropedido
                                       , pf.representante
                                       , pf.vendedora
                                       , pck_romance.fnc_retornatelefones(pf.idvendedora)
                                       , pf.databaixa
                                       , pf.datavencimentomenor
                                       , pf.valorapagar 
                                       , pf.idrepresentante
                                  from favorita.VW_COMISSOESPAGAR_NOVA_M pf
                                  where ( :P253_CLIENTE is null or pf.idrepresentante = :P253_CLIENTE )
                                    and pf.idfilialromance = :P0_IDFILIAL
                                    and (:P253_DTINI is null or pf.databaixa between add_months(to_date(:P253_DTINI,'dd/mm/rrrr'),-12) and add_months(to_date(:P253_DTFIM,'dd/mm/rrrr'),-12))
                                  order by 5 desc)
                            group by representante, idrepresentante
                            order by 1)
                            
                select t1.Representante
                     , t1.ValorTotal
                     , t1.QtdBoletos
                     , t2.ValorTotalAnt
                     , t2.QtdBoletosAnt
                     , round(( (sum(t1.ValorTotal)/sum(t2.ValorTotalAnt) ) -1)*100,2) crescvlr
                     , round(( (sum(t1.QtdBoletos)/sum(t2.QtdBoletosAnt) ) -1)*100,2) crescqtd
                  from t1
                     , t2
                where t1.idrepresentante = t2.idrepresentante(+)
                group by t1.Representante
                       , t1.ValorTotal
                       , t1.QtdBoletos
                       , t2.ValorTotalAnt
                       , t2.QtdBoletosAnt
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
