        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: dd/mm/yyyy
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P253_FILTRAR (
        type: hidden
        layout {
            sequence: 80
            region: @filtro
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P253_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta 
                     , s.idsemana
                from semana_dias s
                where s.ano >= 2020
                order by s.idsemana
                ```
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P253_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Detalhado;D,Resumido;R
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P253_TIPO_DATA (
        type: radioGroup
        label {
            label: Tipo Data:
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC:Baixa;B,Semana;S
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction mostra-tipo-data (
        name: mostra tipo data
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P253_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P253_TIPO
            value: D
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P253_TIPO_DATA
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction oculta-mostra-tipo-data-detalhado (
        name: oculta/mostra tipo data detalhado
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P253_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P253_TIPO
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P253_IDSEMANA
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P253_DTINI
                    P253_DTFIM
                ]
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction oculta-tipo-data (
        name: oculta tipo data
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P253_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P253_TIPO
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P253_TIPO_DATA
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-data (
        name: Tipo data
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P253_TIPO_DATA
        }
        clientSideCondition {
            type: item=value
            item: P253_TIPO_DATA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P253_IDSEMANA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P253_DTINI
                    P253_DTFIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P253_IDSEMANA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P253_DTINI
                    P253_DTFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        name: Go To Page 253
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 253
                items: {
                    P253_CLIENTE: &P253_CLIENTE.
                    P253_TIPO: &P253_TIPO.
                    P253_DTINI: &P253_DTINI.
                    P253_DTFIM: &P253_DTFIM.
                    P253_IDSEMANA: &P253_IDSEMANA.
                    P253_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

