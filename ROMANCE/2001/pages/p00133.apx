    region incluidos-recentemente (
        name: Incluidos recentemente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pp.idpepinosrepresentante
                     , nrpedido
                     , valor
                     , decode(situacao,'S','SPC','C','Cobrança') situacao
                     , pck_romance.fnc_nomerepresentante(idrepresentante) representante
                     , nomevendedora
                     , cpf
                     , (select valor - nvl(( select sum(valor)
                         from pepinosrepresentantes
                                 where nrpedido = P.NRPEDIDO
                                   and idrepresentante = P.IDREPRESENTANTE
                                   and situacao = 'P' ),0)
                       from pepinosrepresentantes P
                       where idpepinosrepresentante = pp.idpepinosrepresentante) Saldo    
                     , log.usuario "Usuario Incluiu"
                     , log.data "Data Inclusão"
                from pepinosrepresentantes pp
                   , ( select lp.dataalteracao data
                            , lp.usuarioalteracao usuario
                            , lp.idpepinosrepresentante
                       from logroman.log_pepinosrepresentantes lp
                       where lp.tipoalteracao = 'INSERT' ) log
                where log.idpepinosrepresentante = pp.idpepinosrepresentante
                  and pp.idparcelamento is null
                  and ( :P133_CPF is null or cpf = :P133_CPF )
                  and ( :P133_NOME is null or lower(nomevendedora) like '%'||lower(:P133_NOME)||'%' )
                  --and ( :P133_CPF is not null or :P133_NOME is not null )
                  and ( :P133_NRPEDIDO is null or pp.nrpedido like  '%'||:P133_NRPEDIDO||'%' )
                  and ( :P133_PARCELAMENTO is null or exists ( select 1
                                                               from PARCELAMENTOSPEPINOSREPRES P
                                                               where p.idpepinorepresentante = pp.idpepinosrepresentante ) )
                order by 1 desc
                ```
        }
        layout {
            sequence: 55
            parentRegion: @filtro
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
