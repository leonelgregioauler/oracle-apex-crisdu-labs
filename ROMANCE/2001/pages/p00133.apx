    validation cpf (
        name: CPF
        execution {
            sequence: 210
        }
        validation {
            editableRegion: @page_plug
            type: columnIsNotNull
            column: CPF
        }
        error {
            errorMessage: Informe o CPF!
            associatedColumn: CPF
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation debito-duplo (
        name: Debito Duplo
        execution {
            sequence: 250
        }
        validation {
            editableRegion: @page_plug
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                  from pepinosrepresentantes r
                 where r.idrepresentante = :IDREPRESENTANTE
                   and r.valor           = :VALOR
                   and r.situacao        = :SITUACAO
                   and r.nrpedido        = :NRPEDIDO
                   and r.cpf             = :CPF
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Já há um débito com esse valor para esse representante.
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

