page 256 (
    name: Lista de Pedidos
    title: Lista de Pedidos
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region imprime (
        name: Imprime
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_imprime.prc_imprimelistapedidos(:P256_IDREPRESENTANTE);
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
    )

    region page_plug (
        name: " "
        type: staticContent
        layout {
            sequence: 1
            slot: body-3
        }
    )

    pageItem P256_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @page_plug
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

