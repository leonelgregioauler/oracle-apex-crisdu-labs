page 438 (
    name: Cobrança Exterior
    title: Cobrança Exterior
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function myIP() {  
                if (window.XMLHttpRequest) xmlhttp = new XMLHttpRequest();  
                else xmlhttp = new ActiveXObject("Microsoft.XMLHTTP");  
              
                xmlhttp.open("GET","http://api.hostip.info/get_html.php",false);  
                xmlhttp.send();  
              
                hostipInfo = xmlhttp.responseText.split("\n");  
              
                for (i=0; hostipInfo.length >= i; i++) {  
                    ipAddress = hostipInfo[i].split(":");  
                    if ( ipAddress[0] == "IP" ) 
                        alert(ipAddress[1]);
                }  
              
                return false;  
            }  
              
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region cobrança-exterior (
        name: Cobrança Exterior
        type: list
        source {
            list: @cobrança-exterior
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--3cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

    region top-5-de-notas-na-cobrança (
        name: Top 5 de Notas na Cobrança
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select idrepresentante link
                     , pck_romance.fnc_nomerepresentante(idrepresentante) display
                     , count(1) value
                from notasvendas n
                where idsituacaonotavenda = 4
                  and n.enviocobrancaterceirizada = 'S'
                  and n.enviadocobranca = 'S'
                  and n.idfilial = :P0_IDFILIAL
                group by idrepresentante
                order by 3 desc;
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2019,v('APP_USER')) = 'S'
                ```
        }
        settings {
            labelColumn: DISPLAY
            valueColumn: VALUE
        }
    )

)

