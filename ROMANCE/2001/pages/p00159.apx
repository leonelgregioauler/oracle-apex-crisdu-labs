    pageItem P159_ESTOQUEDESTINO (
        type: radioGroup
        label {
            label: Estoque Destino
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value
                     , return_value
                from (  select 'Distribuição PA' display_value
                             , 'P'            return_value
                             , 1 ordem
                        from dual
                        union
                        select 'Distribuição' display_value
                             , 'D'            return_value
                             , 2 ordem
                        from dual
                        union
                        select 'Reembalagem' display_value
                             , 'R'            return_value
                             , 3 ordem
                        from dual
                        where pck_romance.fnc_retornaparametro(parametro => 'USAESTOQUEREEMB',pidfilial => :P0_IDFILIAL) = 'S' )
                order by ordem
                ```
            displayNullValue: false
        }
        layout {
            sequence: 88
            region: @saída-de-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: ESTOQUEDESTINO
            used: always
        }
        default {
            type: static
            staticValue: P
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P159_IDESTOQUEFIL (
        type: selectList
        label {
            alignment: left
