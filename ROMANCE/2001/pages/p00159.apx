        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto) display_value
                     , e.idestoquefilial
                from estoquefilial e
                   , produtos      p
                where e.idfilial = :P0_IDFILIAL
                  and e.idproduto = p.idproduto
                  and p.codigosisdist = :P159_CODIGO
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
