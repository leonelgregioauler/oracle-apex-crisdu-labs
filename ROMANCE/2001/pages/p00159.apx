    validation quantidade-movimentada (
        name: quantidade movimentada >= 50
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where  nvl(to_number(:P159_QTD_PP),0)
                     + nvl(to_number(:P159_QTD_P),0)
                     + nvl(to_number(:P159_QTD_M),0) 
                     + nvl(to_number(:P159_QTD_G),0) 
                     + nvl(to_number(:P159_QTD_GG),0) 
                     + nvl(to_number(:P159_QTD_EGG),0) 
                     + nvl(to_number(:P159_QTD_EXGG),0) 
                     + nvl(to_number(:P159_QTD_U),0) >= 50
                ```
        }
        error {
            errorMessage: Quantidade não permitida para movimentar o estoque! Registre um evento explicando o motivo dessa quantidade e solicitando liberação!
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

    process fetch-row-from-movtosestoquepareemb (
        name: Fetch Row from MOVTOSESTOQUEPAREEMB
        type: autoRowFetch
        source {
            tableName: MOVTOSESTOQUEPAREEMB
            pkColumn: IDMOVTOESTOQUEPAREEMB
            pkItem: P159_IDMOVTOESTOQUEPAREEMB
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 32549798484616383
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  -- local variables here
                  videstoquereembalagem   number;
                  vusuario                varchar2(20) := NVL(v('APP_USER'),dbms_standard.login_user);
                  vqtd_u                  number;
                  v_nome_posto_avancado   varchar2(500);
                  --
                 begin
                  -- 
                  if :P159_IDMOVTOESTOQUEPAREEMB is null then
                      select seq_idmovtoestpareemb.nextval
                      into :P159_IDMOVTOESTOQUEPAREEMB
                      from dual;
                  end if;
                  --    
                  :P159_QTD_PP  := to_number(:P159_QTD_PP )*-1;
                  :P159_QTD_P   := to_number(:P159_QTD_P  )*-1;
                  :P159_QTD_M   := to_number(:P159_QTD_M  )*-1;       
                  :P159_QTD_G   := to_number(:P159_QTD_G  )*-1;
                  :P159_QTD_GG  := to_number(:P159_QTD_GG )*-1;
                  :P159_QTD_EGG := to_number(:P159_QTD_EGG)*-1;       
                  :P159_QTD_EXGG := to_number(:P159_QTD_EXGG)*-1;       
                  :P159_QTD_U   := to_number(:P159_QTD_U  )*-1;
                  --
                  -- Maicon Aimi - 18/03/2025 - 9156070 -- Busca o nome do posto avançado para concatenar na mensage da :P326_OBSERVACAO.
                  begin
                    select nome
                      into v_nome_posto_avancado
                      from roman.postoavancado pa
                     where pa.idpostoavancado = :P326_IDPOSTOAVANCADO;
                  exception
                    when others then
                      v_nome_posto_avancado := '';
                  end; 
                  --
                  if :P159_ESTOQUEDESTINO = 'P' or :P159_ESTOQUEDESTINO = 'D' then
                    --
                    :P159_OBSERVACAO := 'Transferência do setor de Reembalagem PA '|| v_nome_posto_avancado ||'. '||:P159_OBSERVACAO;
                    --
                  else
                    :P159_OBSERVACAO := 'Saída Manual. '||:P159_OBSERVACAO;
                  end if;
                  --
                  begin
                      select e.idestpostoavancado
                      into :P159_IDESTOQUEPOSTOAVANCADO
                      from estoquepostoavancado e
                      where e.idpostoavancado  = :P159_IDPOSTOAVANCADO
                        and idestoquefil       = :P159_IDESTOQUEFIL;
                  exception
                    when others then
                       SELECT seq_idestoquepostoavan.nextval
                       INTO :P159_IDESTOQUEPOSTOAVANCADO
                       from dual;
                       --
                       insert into estoquepostoavancado ( idestpostoavancado    , idpostoavancado    , idestoquefil
                                                        , qtd_pp             , qtd_p
                                                        , qtd_m                 , qtd_g              , qtd_gg
                                                        , qtd_egg               , qtd_exgg   , qtd_u )
                       values ( :P159_IDESTOQUEPOSTOAVANCADO     , :P159_IDPOSTOAVANCADO     , :P159_IDESTOQUEFIL
                              , 0              , 0
                              , 0                         , 0               , 0
                              , 0                       , 0, 0 );
                       --
                  END;
                  --
                  begin
                    --
                    insert into estoquepostoavancadoreemb ( IDESToquePAREEMB    , idpostoavancado    , idestoquefil
                                                          , qtd_pp             , qtd_p
                                                          , qtd_m                 , qtd_g              , qtd_gg
                                                          , qtd_egg            , qtd_exgg   , qtd_u )
                    values ( :P159_IDESTOQUEPOSTOAVANCADO     , :P159_IDPOSTOAVANCADO     , :P159_IDESTOQUEFIL
                           , 0                         , 0
                           , 0                         , 0               , 0
                           , 0                         , 0       , 0 );
                    --
                  exception
                    when others then
                      null;
                  end;
                  --
                  vqtd_u := NVL(:P159_QTD_PP  *-1,0)       + NVL(:P159_QTD_P *-1,0)
                          + NVL(:P159_QTD_M   *-1,0)       + NVL(:P159_QTD_G *-1,0)  + NVL(:P159_QTD_GG   *-1,0)
                          + NVL(:P159_QTD_EGG *-1,0)       + NVL(:P159_QTD_U *-1,0)  + NVL(:P159_QTD_EXGG *-1,0);
                  --
                  if :P159_DESTINO = 'F' then
                    --
                    if :P159_ESTOQUEDESTINO = 'D' then
                      --
                      -- feito * -1 porque na tela, 'e feito issopara deixar negativo
                      -- desta forma, volta a ser positivo, somando no estoque da empresa
                      --
                      insert into movimentosestoquefilial ( idmovtoestoquefilial  , idestoquefil  , idfilial
                                                          , observacao    , usuario
                                                          , datamovimento         , qtd_pp        , qtd_p
                                                          , qtd_m                 , qtd_g         , qtd_gg
                                                          , qtd_egg               , qtd_u         , iditemdevolucaorepres
                                                          , qtd_exgg)
                      values  ( seq_idmovtoestoquefilial.nextval  , :P159_IDESTOQUEFIL       , :P0_IDFILIAL
                              , :P159_OBSERVACAO                  , v('APP_USER')
                              , sysdate                           , :P159_QTD_PP *-1         , :P159_QTD_P  *-1
                              , :P159_QTD_M    *-1                , :P159_QTD_G  *-1         , :P159_QTD_GG *-1
                              , :P159_QTD_EGG  *-1                , :P159_QTD_U  *-1         , null
                              , :P159_QTD_EXGG *-1 );
                      --
                    elsif :P159_ESTOQUEDESTINO = 'P' then
                      --
                      -- feito * -1 porque na tela, 'e feito issopara deixar negativo
                      -- desta forma, volta a ser positivo, somando no estoque da empresa
                      --
                      insert into movimentosestoquepostoavan ( idmovtoestpostoavan , idpostoavancado , idestoquefil          , idfilial
                                                             , observacao          , usuario         , idestoquepostoavancado
                                                             , datamovimento       , qtd_pp          , qtd_p
                                                             , qtd_m               , qtd_g           , qtd_gg
                                                             , qtd_egg             , qtd_u           , qtd_exgg    ) 
                      values  ( seq_idmovtoestpostoavancado.nextval    , :P159_IDPOSTOAVANCADO    , :P159_IDESTOQUEFIL    , :P159_idfilial
                              , :P159_OBSERVACAO                       , :P159_USUARIO            , :P159_IDESTOQUEPOSTOAVANCADO
                              , sysdate                                , NULL                     , null
                              , null                                   , null                     , null
                              , null                                   , vqtd_u                   , null );
                      --
                    elsif :P159_ESTOQUEDESTINO = 'R' then
                      --
                      select ee.idestoquereembalagem
                      into videstoquereembalagem
                      from estoquereembalagem ee
                      where ee.idestoquefil = :P159_idestoquefil
                        and ee.idfilial     = :P159_idfilial;
                      --
                      if pck_romance.fnc_retornaparametro(parametro => 'ESTOQUEEMBPORGRADE',pidfilial => :P159_idfilial) = 'S' then
                        --
                        insert into movimentosestoquereemb ( idmovtoestreemb  , idestoquefil
                                                           , iditprodembal    , observacao            , usuario
                                                           , datamovimento    , idestoquereembalagem  , idfilial
                                                           , qtd_pp           , qtd_p                 , qtd_m
                                                           , qtd_g            , qtd_gg                , qtd_egg
                                                           , qtd_u            , qtd_exgg   , iditemdevolucaorepres )
                        values ( seq_idmovtoestreemb.nextval   , :P159_IDESTOQUEFIL
                               , NULL                          , :P159_OBSERVACAO                , VUSUARIO
                               , SYSDATE                       , VIDESTOQUEREEMBALAGEM           , :P159_IDFILIAL
                               , :P159_QTD_PP     *-1          , :P159_QTD_P  *-1                , :P159_QTD_M*-1
                               , :P159_QTD_G     *-1           , :P159_QTD_GG  *-1               , :P159_QTD_EGG*-1
                               , :P159_QTD_U    *-1            , :P159_QTD_EXGG  *-1 , NULL  );
                        --
                      else
                        --
                        insert into movimentosestoquereemb ( idmovtoestreemb  , idestoquefil
                                                           , iditprodembal    , observacao            , usuario
                                                           , datamovimento    , idestoquereembalagem  , idfilial
                                                           , qtd_pp           , qtd_p                 , qtd_m
                                                           , qtd_g            , qtd_gg                , qtd_egg
                                                           , qtd_u            , qtd_exgg            ,  iditemdevolucaorepres )
                        values ( seq_idmovtoestreemb.nextval   , :P159_idestoquefil
                               , null                          , :P159_observacao            , vusuario
                               , sysdate                       , videstoquereembalagem       , :P159_idfilial
                               , 0                             , 0                           , 0
                               , 0                             , 0                           , 0
                               , vqtd_u                        , 0                           , null  );
                        --
                      end if;
                      --
                    end if;
                    --
                  end if;
                  --    
                  -- movimentar tamanho unico na reembalagem do posto avançado
                  --
                  
                  :P159_QTD_PP   := 0;
                  :P159_QTD_P    := 0;
                  :P159_QTD_M    := 0;    
                  :P159_QTD_G    := 0;
                  :P159_QTD_GG   := 0;
                  :P159_QTD_EGG  := 0;    
                  :P159_QTD_EXGG :=0;      
                  :P159_QTD_U   := vqtd_u*-1;--deixar positivo novamente
                  --  
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 32550182414616383
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

