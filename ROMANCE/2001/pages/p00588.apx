    region cargas-montadas (
        name: Cargas Montadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idrepresentante
                     , pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                     , c.semana
                     , c.dataconclusao
                     , p.codigosisdist codigo
                     , p.nomeproduto produto
                     , ic.qtd_pp_sugerida
                     , ic.qtd_p_sugerida
                     , ic.qtd_m_sugerida
                     , ic.qtd_g_sugerida
                     , ic.qtd_gg_sugerida
                     , ic.qtd_egg_sugerida
                     , ic.qtd_exgg_sugerida
                     , ic.qtd_u_sugerida
                     , '|' s1
                     , case 
                         when nvl(ic.qtd_dist_pp,0) != nvl(ic.qtd_pp_sugerida,0) then
                           '<font color=red>'||nvl(ic.qtd_dist_pp,0)||'</font>'
                         else
                           '<font color=green>'||nvl(ic.qtd_dist_pp,0)||'</font>'
                       end qtd_dist_pp
                     , case 
                         when nvl(ic.qtd_dist_p,0) != nvl(ic.qtd_p_sugerida,0) then
                           '<font color=red>'||nvl(ic.qtd_dist_p,0)||'</font>'
                         else
                           '<font color=green>'||nvl(ic.qtd_dist_p,0)||'</font>'
                       end qtd_dist_p
                     , case 
                         when nvl(ic.qtd_dist_m,0) != nvl(ic.qtd_m_sugerida,0) then
                           '<font color=red>'||nvl(ic.qtd_dist_m,0)||'</font>'
                         else
                           '<font color=green>'||nvl(ic.qtd_dist_m,0)||'</font>'
                       end qtd_dist_m
                     , case 
                         when nvl(ic.qtd_dist_g,0) != nvl(ic.qtd_g_sugerida,0) then
                           '<font color=red>'||nvl(ic.qtd_dist_g,0)||'</font>'
                         else
                           '<font color=green>'||nvl(ic.qtd_dist_g,0)||'</font>'
                       end qtd_dist_g
                     , case 
                         when nvl(ic.qtd_dist_gg,0) != nvl(ic.qtd_gg_sugerida,0) then
                           '<font color=red>'||nvl(ic.qtd_dist_gg,0)||'</font>'
                         else
                           '<font color=green>'||nvl(ic.qtd_dist_gg,0)||'</font>'
                       end qtd_dist_gg
                     , case 
                         when nvl(ic.qtd_dist_egg,0) != nvl(ic.qtd_egg_sugerida,0) then
                           '<font color=red>'||nvl(ic.qtd_dist_egg,0)||'</font>'
                         else
                           '<font color=green>'||nvl(ic.qtd_dist_egg,0)||'</font>'
                       end qtd_dist_egg
                     , case 
                         when nvl(ic.qtd_dist_exgg,0) != nvl(ic.qtd_exgg_sugerida,0) then
                           '<font color=red>'||nvl(ic.qtd_dist_exgg,0)||'</font>'
                         else
                           '<font color=green>'||nvl(ic.qtd_dist_exgg,0)||'</font>'
                       end qtd_dist_exgg
                     , case 
                         when nvl(ic.qtd_dist_u,0) != nvl(ic.qtd_u_sugerida,0) then
                           '<font color=red>'||nvl(ic.qtd_dist_u,0)||'</font>'
                         else
                           '<font color=green>'||nvl(ic.qtd_dist_u,0)||'</font>'
                       end qtd_dist_u
                     , ( nvl(qtd_pp_sugerida,0)
                       + nvl(qtd_p_sugerida,0)
                       + nvl(qtd_m_sugerida,0)
                       + nvl(qtd_g_sugerida,0)
                       + nvl(qtd_gg_sugerida,0)
                       + nvl(qtd_egg_sugerida,0)
                       + nvl(qtd_exgg_sugerida,0)
                       + nvl(qtd_u_sugerida,0) ) totalsugerido
                     , ( nvl(qtd_dist_pp,0)
                       + nvl(qtd_dist_p,0)
                       + nvl(qtd_dist_m,0)
                       + nvl(qtd_dist_g,0)
                       + nvl(qtd_dist_gg,0)
                       + nvl(qtd_dist_egg,0)
                       + nvl(qtd_dist_exgg,0)
                       + nvl(qtd_dist_u,0) ) totaldistribuido
                from cargasrepresentantes c
                   , itenscargarepresentante ic
                   , produtos p
                where ic.idcargarepresentante = c.idcargarepresentante
                  and p.idproduto             = ic.idproduto
                  and c.idsemana              = :P588_SEMANA
                  and c.idfilial              = :P0_IDFILIAL
                  and :P588_FILTRAR           = 'S'
                  and c.situacao              = 3
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P588_TIPO_RELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4800120869118913816
        }

