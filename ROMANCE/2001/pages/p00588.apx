    region resumo-das-cargas (
        name: Resumo das Cargas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                     , pp_sugerida
                     , p_sugerida
                     , m_sugerida
                     , g_sugerida
                     , gg_sugerida
                     , egg_sugerida
                     , exgg_sugerida
                     , u_sugerida
                     , '|' s1
                     , dist_pp
                     , dist_p
                     , dist_m
                     , dist_g
                     , dist_gg
                     , dist_egg
                     , dist_exgg
                     , dist_u
                     , totalsugerido
                     , totaldistribuido
                     , (totaldistribuido - totalsugerido) diferenca
                     , round(( (totaldistribuido - totalsugerido) / totalsugerido ) * 100,2) margem
                from ( select idrepresentante
                            , sum( nvl(qtd_pp_sugerida,0) ) pp_sugerida
                            , sum( nvl(qtd_p_sugerida,0) ) p_sugerida
                            , sum( nvl(qtd_m_sugerida,0) ) m_sugerida
                            , sum( nvl(qtd_g_sugerida,0) ) g_sugerida
                            , sum( nvl(qtd_gg_sugerida,0) ) gg_sugerida
                            , sum( nvl(qtd_egg_sugerida,0) ) egg_sugerida
                            , sum( nvl(qtd_exgg_sugerida,0) ) exgg_sugerida
                            , sum( nvl(qtd_u_sugerida,0) ) u_sugerida
                            , sum( nvl(qtd_dist_pp,0) ) dist_pp
                            , sum( nvl(qtd_dist_p,0) ) dist_p
                            , sum( nvl(qtd_dist_m,0) ) dist_m
                            , sum( nvl(qtd_dist_g,0) ) dist_g
                            , sum( nvl(qtd_dist_gg,0) ) dist_gg
                            , sum( nvl(qtd_dist_egg,0) ) dist_egg
                            , sum( nvl(qtd_dist_exgg,0) ) dist_exgg
                            , sum( nvl(qtd_dist_u,0) ) dist_u
                            , sum(( nvl(qtd_pp_sugerida,0)
                                  + nvl(qtd_p_sugerida,0)
                                  + nvl(qtd_m_sugerida,0)
                                  + nvl(qtd_g_sugerida,0)
                                  + nvl(qtd_gg_sugerida,0)
                                  + nvl(qtd_egg_sugerida,0)
                                  + nvl(qtd_exgg_sugerida,0)
                                  + nvl(qtd_u_sugerida,0))) totalsugerido
                            , sum(( nvl(qtd_dist_pp,0)
                                  + nvl(qtd_dist_p,0)
                                  + nvl(qtd_dist_m,0)
                                  + nvl(qtd_dist_g,0)
                                  + nvl(qtd_dist_gg,0)
                                  + nvl(qtd_dist_egg,0)
                                  + nvl(qtd_dist_exgg,0)
                                  + nvl(qtd_dist_u,0))) totaldistribuido
                       from cargasrepresentantes c
                          , itenscargarepresentante ic
                       where ic.idcargarepresentante = c.idcargarepresentante
                         and c.idsemana              = :P588_SEMANA
                         and c.idfilial              = :P0_IDFILIAL
                         and :P588_FILTRAR           = 'S'
                         and c.situacao              = 3
                       group by idrepresentante ) cad
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
