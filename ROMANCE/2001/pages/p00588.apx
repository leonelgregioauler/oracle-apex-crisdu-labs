        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 48009656 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn DIFERENCA (
                sequence: 4
            )

            displayColumn DISTRIBUIDOR (
                sequence: 1
            )

            displayColumn MARGEM (
                sequence: 5
            )

            displayColumn TOTALDISTRIBUIDO (
                sequence: 3
            )

            displayColumn TOTALSUGERIDO (
                sequence: 2
            )

            sort (
                column: DISTRIBUIDOR
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: TOTALSUGERIDO
            )

            aggregate (
                column: TOTALDISTRIBUIDO
            )

            aggregate (
                column: DIFERENCA
            )

            aggregate (
                function: average
                column: MARGEM
            )

        )

    )

    pageItem P588_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P588_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta
                     , s.idsemana
                from semana_dias s
                where s.ano >= 2019
                  and exists ( select 1
                               from cargasrepresentantes c
                               where c.idsemana = s.idsemana
                                 and c.idfilial = :P0_IDFILIAL )
                order by s.idsemana desc
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        cascadingLov {
            parentItems: P0_IDFILIAL
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P588_TIPO_RELATORIO (
        type: radioGroup
        label {
            label: Relatório
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Detalhado;D,Resumido;R
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 588
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 588
                items: {
                    P588_SEMANA: &P588_SEMANA.
                    P588_TIPO_RELATORIO: &P588_TIPO_RELATORIO.
                    P588_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

