page 700 (
    name: Motivos Painel Leads
    title: Motivos Painel Leads
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region motivos-painel-de-leads (
        name: Motivos Painel de Leads
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idmotivopainelleads
                     , c.motivo
                     , case
                         when c.tipo = 'C' then 'Conclusão'
                         when c.tipo = 'D' then 'Devolução'
                     end tipo
                from roman.motivospainelleads c
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1503263425702338302
        }

        column IDMOTIVOPAINELLEADS (
            type: link
            heading {
                heading: Editar Motivo
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 701
                    items: {
                        P701_IDMOTIVOPAINELLEADS: #IDMOTIVOPAINELLEADS#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column MOTIVO (
            type: plainText
            heading {
                heading: Motivo
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        savedReport 15032698 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IDMOTIVOPAINELLEADS (
                sequence: 1
            )

            displayColumn MOTIVO (
                sequence: 2
            )

            displayColumn TIPO (
                sequence: 3
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Motivo
        layout {
            sequence: 10
            region: @motivos-painel-de-leads
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 702
                clearCache: 702
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

