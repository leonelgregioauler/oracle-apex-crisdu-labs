    pageItem P505_DATACONCLUSAO (
        type: displayOnly
        label {
            label: <b>Data da 1ª Conclusão</b>
            alignment: left
        }
        layout {
            sequence: 20
            region: @movimentação-das-devoluções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--preTextBlock
                t-Form-fieldContainer--postTextBlock
            ]
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                v_data varchar2(30);
                BEGIN
                  select to_char(min(dataconclusao),'dd/mm/rrrr hh24:mi:ss')
                    into v_data
                   from logroman.log_devolucoesrepresentant
                  where iddevolucaorepres = :P505_IDDEVOLUCAOREPRES
                    and situacao = 3;
                  RETURN v_data;
                END;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P505_IDDEVOLUCAOREPRES (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @movimentação-das-devoluções
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: Fechar
        label: Fechar
        layout {
            sequence: 30
            region: @movimentação-das-devoluções
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction fechajanela (
        name: FechaJanela
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @fechar
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

