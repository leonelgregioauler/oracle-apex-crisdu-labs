page 505 (
    name: Histórico Dev. Cargas
    title: Histórico Dev. Representantes
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 70%
        resizable: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            if ($('#movdevol td[headers="COR"]').val() =="S" ) {
                $('#movdevol td[headers="COR"]').filter(function(){
                    return $(this).text() === 'S'
                }).parent().children().css('background-color', 'Beige')
            } else {
                $('#movdevol td[headers="COR"]').filter(function(){
                    return $(this).text() === 'N'
                }).parent().children().css('background-color', 'White')
            }
            
            ```
    }
    css {
        inline: "#movdevol td {background-color: Beige}"
    }
    security {
        pageAccessProtection: unrestricted
    }

    region movimentação-das-devoluções (
        name: Movimentação das Devoluções
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.usuarioalteracao
                     , (select codigosisdist from produtos where idproduto = l.idproduto) Produto
                     , pck_romance.fnc_nomeproduto(l.idproduto) "Nome Produto"
                     , l.tipoalteracao
                     , to_char(l.dataalteracao,'dd/mm/rrrr hh24:mi:ss') dataalteracao
                     , l.valorproduto
                     , l.comissao
                     , l.qtd_pp
                     , l.qtd_p
                     , l.qtd_m
                     , l.qtd_g
                     , l.qtd_gg
                     , l.qtd_egg
                     , l.qtd_Exgg
                     , l.qtd_u
                     , case when to_date(l.dataalteracao,'dd/mm/rrrr hh24:mi:ss') > to_date(:P505_DATACONCLUSAO,'dd/mm/rrrr hh24:mi:ss') then 'S' else 'N' end cor 
                  from logroman.log_itensdevolucaorepres l
                 where iddevolucaorepres = :P505_IDDEVOLUCAOREPRES
                 order by dataalteracao desc
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: movdevol
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1108722695479543903
        }

