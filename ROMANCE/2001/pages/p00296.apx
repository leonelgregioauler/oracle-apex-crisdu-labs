page 296 (
    name: Notas para Enviar a Cobrança
    title: Notas para Enviar a Cobrança
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region notas-de-venda (
        name: Notas de Venda
        type: tabform
        source {
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(n.idvendedora) vendedora
                     , n.numeronota numero
                     , n.semanadistribuicao semanadist
                     , n.semanacobranca semanacob
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiao
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valorpago
                     , n.saldo
                     , null enviarcobranca
                     , n.idnotavenda
                from notasvendas n
                where n.idrepresentante = :P296_IDREREPRESENTANTE
                  and ( :P296_IDREGIAOVENDA is null or n.idregiaovenda = :P296_IDREGIAOVENDA )
                  and n.idsituacaonotavenda = 4
                  and n.saldo > 0
                  and nvl(n.enviadocobranca,'N') = 'N'
                  and pck_util.fnc_idsemana(trim(to_char(sysdate,'IW/RRRR'))) - n.idsemanacobranca >=10-- > trunc(nvl(n.dataretorno,n.datanota+42))+60
                  and not exists ( select 1
                                   from pagamentosnotasvendas p
                                   where pck_util.fnc_idsemana(n.semanacobranca)- n.idsemanacobranca>=10
                                     and p.idnotavenda = n.idnotavenda ) 
                order by 1
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P296_IDREPRESENTANTE
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhuma nota encontrada para enviar ao setor de cobrança!
        }
        componentAdvanced {
            stripHtml: true
        }

        column ENVIARCOBRANCA (
            reportColumnQueryId: 10
            derivedColumn: N
            type: simpleCheckbox
            heading {
                heading: Enviar para Cobrança
                alignment: center
            }
            lov {
                checkboxValues: S
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column IDNOTAVENDA (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 11
            }
            sorting {
                sortable: false
            }
        )

        column NUMERO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Nr. Nota
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column REGIAO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Região de Venda
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column SALDO (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Saldo
                alignment: center
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column SEMANACOB (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Sem. Cobrança
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column SEMANADIST (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Sem. Distribuição
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column VALORPAGO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column VALORTOTALNOTA (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column VALORTOTALVENDA (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Valor Venda
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column VENDEDORA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P296_IDREGIAOVENDA (
        type: selectList
        label {
            label: Região de Venda
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(r.idregiaovenda)||' - '||r.semana display_value
                     , r.idregiaovenda return_value
                from regioesrepresentantes r
                where r.idrepresentante = :P296_IDREPRESENTANTE
                order by r.semana
                ```
        }
        cascadingLov {
            parentItems: P296_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P296_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes
                                      where idfilial = :P0_IDFILIAL )
                order by 1 
                ```
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Enviar Notas
        layout {
            sequence: 10
            region: @notas-de-venda
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process envia-notas-para-cob (
        name: Envia notas para cob
        type: executeCode
        editableRegion: @notas-de-venda
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if (:ENVIARCOBRANCA = 'S') then
                    --
                    update notasvendas n
                    set n.enviadocobranca = 'S'
                    where idnotavenda = :IDNOTAVENDA;
                    --
                    insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao)
                    values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Nota enviada para o setor de cobrança na semana '||pck_util.fnc_semanaid(pck_util.fnc_idsemanadata(sysdate)),:IDNOTAVENDA,'C');
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Notas Enviadas para a Cobrança com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 293743043228066736
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 296
                items: {
                    P296_IDREPRESENTANTE: &P296_IDREPRESENTANTE.
                    P296_IDREGIAOVENDA: &P296_IDREGIAOVENDA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

