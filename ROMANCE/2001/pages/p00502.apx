    pageItem P502_ANO (
        type: numberField
        label {
            label: Ano
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        default {
            type: expression
            plsqlExpression: to_char(sysdate,'RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P502_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo is not null
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P502_IDMES (
        type: selectList
        label {
            label: Mês
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.mes
                     , m.numero
                from meses m
                order by m.numero 
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 502
                items: {
                    P502_IDFILIAL: &P502_IDFILIAL.
                    P502_ANO: &P502_ANO.
                    P502_IDMES: &P502_IDMES.
                }
                action: resetPagination
            }
        }
    )

)

