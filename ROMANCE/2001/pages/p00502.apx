page 502 (
    name: Inventários de Estoque
    title: Inventários de Estoque
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region inventario-do-estoque (
        name: Inventario do Estoque
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idestoquefilial
                     , w.produto
                     , w.codigo
                     , w.data
                     , w.mes
                     , w.descmes
                     , w.ano
                     , w.desccomissao comissao
                     , w.valorvenda
                     , w.qtd_pp_fisico
                     , w.qtd_p_fisico
                     , w.qtd_m_fisico
                     , w.qtd_g_fisico
                     , w.qtd_gg_fisico
                     , w.qtd_egg_fisico
                     , w.qtd_exgg_fisico
                     , w.qtd_u_fisico
                     , w.fisico_total
                     , w.qtd_pp_disponivel
                     , w.qtd_p_disponivel
                     , w.qtd_m_disponivel
                     , w.qtd_g_disponivel
                     , w.qtd_gg_disponivel
                     , w.qtd_egg_disponivel
                     , w.qtd_exgg_disponivel
                     , w.qtd_u_disponivel
                     , w.disponivel_total 
                from vw_inventarioestoque w
                where w.idfilial = :P502_IDFILIAL
                  and w.mes      = :P502_IDMES
                  and w.ano      = :P502_ANO
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum inventário localizado, verifique os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 62413653855363722
        }

