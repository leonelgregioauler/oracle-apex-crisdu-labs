page 314 (
    name: Liberar Acessos Estoque
    title: Liberar Acessos Estoque
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region controle-de-acessos (
        name: Controle de Acessos
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
    )

    region liberar-acessos (
        name: Liberar Acessos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idaplicacao
                      ,descricao
                      ,hierarquia
                      ,decode( hierarquia , null , '<b>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao) ||'</b>'
                                                 , DECODE(LEVEL , 2 , '<i>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>'
                                                                , 3 , '<i>'||LPAD('-> ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>') ) nivel_hierarquico
                      , nvl( ( select 'Já possui acesso!'
                               from acessos b
                                where b.idaplicacao = a.idaplicacao
                                  and b.usuario = :P314_USUARIOS),'<font color="red">Não possui acesso!</font>') possuiacesso
                      , idaplicacao idapp
                  from ( select a.idaplicacao
                              , a.descricao
                              , case when a.idaplicacao in (2003, 2009) then null else a.hierarquia end hierarquia
                         from aplicacoes a
                         where a.idsistema = 2001
                         order by idaplicacao) a
                 start with idaplicacao in (2003, 2009)
                connect by prior idaplicacao = hierarquia
                
                /*select idaplicacao
                      ,descricao
                      ,hierarquia
                      ,decode( hierarquia , null , '<b>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao) ||'</b>'
                                                 , DECODE(LEVEL , 2 , '<i>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>'
                                                                , 3 , '<i>'||LPAD('-> ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>') ) nivel_hierarquico
                      , nvl( ( select 'Já possui acesso!'
                               from acessos b 
                                where b.idaplicacao = a.idaplicacao 
                                  and b.usuario = :P314_USUARIOS),'<font color="red">Não possui acesso!</font>') possuiacesso
                      , idaplicacao idapp
                  from ( select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                         from aplicacoes a 
                         where a.idsistema = 2001
                           and a.idaplicacao not in (2001,2002,2007,2008,2013,2014,2015,2300)
                         union
                         select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                         from aplicacoes a 
                         where a.idsistema = 2001
                           and a.hierarquia is null
                           and a.idaplicacao = 2003
                         ORDER BY IDAPLICACAO) a
                 start with hierarquia is null
                connect by prior idaplicacao = hierarquia*/
                ```
        }
        layout {
            sequence: 15
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P314_USUARIOS
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: " - "
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Usu¿o com acesso total.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 7
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
            security {
                escapeSpecialChars: false
            }
        )

        column HIERARQUIA (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column IDAPLICACAO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: textField
            heading {
                heading: ID
            }
            layout {
                sequence: 2
            }
            appearance {
                width: 5
            }
            primaryKeySource {
                type: existingTrigger
            }
            sorting {
                sortable: false
            }
            advanced {
                customAttributes: readonly
            }
        )

        column IDAPP (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Idapp
                alignment: center
            }
            layout {
                sequence: 7
            }
        )

        column NIVEL_HIERARQUICO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Aplicação
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column POSSUIACESSO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Possui acesso?
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    pageItem P314_USUARIOS (
        type: selectList
        label {
            label: Usuários
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(username)||' - '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialusuario(username)) display_value
                ,username return_value
                from dba_users d
                where trunc(d.created) >= to_date('07/12/2010','dd/mm/rrrr')
                  AND USERNAME NOt IN ('APEX_PUBLIC_USER','APEX_040000','CATAL')
                  and account_status != 'LOCKED'
                  and exists (select 1 from usuariossistemas u where usuario = d.username and u.idsistema = 2001)
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @controle-de-acessos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar Acessos
        layout {
            sequence: 10
            region: @liberar-acessos
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Liberar Acesso
        layout {
            sequence: 20
            region: @liberar-acessos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction recarrega (
        name: Recarrega
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P314_USUARIOS
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: REDIRECIONA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process deleta-acessos (
        name: deleta acessos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                vpedido number;
                begin
                 FOR i IN 1.. HTMLDB_APPLICATION.G_F01.COUNT 
                 loop
                   --
                   delete acessos
                   where idaplicacao = HTMLDB_APPLICATION.G_F02(HTMLDB_APPLICATION.G_F01(i))
                     and usuario = :P314_USUARIOS;
                   --
                  END LOOP;
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Acessos deletados com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1412137117658681522
        }
        serverSideCondition {
            whenButtonPressed: @deletar
        }
    )

    process liberaracesso (
        name: liberaracesso
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                vpedido number;
                begin
                 FOR i IN 1.. HTMLDB_APPLICATION.G_F01.COUNT 
                 loop
                
                    insert into acessos (idacesso, usuario, idaplicacao, ativo)
                    values (seq_idacessos.nextval, :P314_USUARIOS, HTMLDB_APPLICATION.G_F02(HTMLDB_APPLICATION.G_F01(i)), 'S');
                
                  END LOOP;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Acessos liberados com sucesso!
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 252215303171474650
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 314
            }
            saveStateBeforeBranching: true
        }
    )

)

