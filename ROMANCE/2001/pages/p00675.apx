page 675 (
    name: Requisicao de Pagamento
    title: Requisicao de Pagamento
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: "Ações "
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region ações-especiais (
        name: Ações Especiais
        type: staticContent
        layout {
            sequence: 30
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: pck_util.fnc_verificaacesso(3571,v('APP_USER')) = 'S'
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region requisições-realizadas (
        name: Requisições Realizadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idrequisicaopgto
                     , t.Filial_origem
                     , t.Documento
                     , t.Tip_Documento
                     , t.datainclusao
                     , t.usuarioinclusao
                     , t.situacao
                     , t.Fornecedor
                     , t.contafinanceira
                     , t.subcontafinanceira
                     , t.valor
                     , t.desconto
                     , t.acrescimo
                     , t.valortotal
                     , t.vencimento
                     , t.parcelas
                     , t.qtdanexos "Qtd Anexos"
                     , t.comprovantepgto "comprovante pgto"
                     , t.usuarioaprovacao
                     , t.cnpj
                     , t.cnpjdest
                     , t.observacao
                 from(
                select r.idrequisicaopgto
                     , roman.pck_romance.fnc_nomefilial(r.idfilial) Filial_origem
                     , r.documento Documento
                     , ( select descricao from roman.formaspagamentos fp where fp.idformapagamento = r.idformapagamento) Tip_Documento
                     , r.datainclusao 
                     , r.usuarioinclusao
                     , decode(r.idsituacao,1,'Pendente',2,'Atendimento Financeiro',3,'Atendimento Fiscal',4,'Ajuste Lançamento',5,'Concluído Fiscal',6,'Programado',7,'Quitado',8,'Cancelado',10,'Programado - Fiscal Pendente',11,'Programado - Ajuste Fiscal Pendente',12,'Quitado - Fiscal Pendente',13,'Quitado - Ajuste Fiscal Pendente') situacao
                     , roman.pck_romance.fnc_nomefornecedor(r.idfornecedor)Fornecedor
                     , md.contafinanceira
                     , md.subcontafinanceira
                     , r.valor
                     , r.desconto 
                     , r.acrescimo
                     , r.valortotal
                     , r.vencimento
                     , r.parcelas
                     , ( select count(1) from roman.anexosrequisicoes a where a.idrequisicaopgto = r.idrequisicaopgto) qtdanexos
                     , ( select count(1) from roman.anexosrequisicoes a where a.idrequisicaopgto = r.idrequisicaopgto and a.comprovantepgto = 'S') comprovantepgto
                     , r.usuarioaprovacao
                     , p.cnpj
                     , case 
                         when r.idgrupo is null then
                             ( select rs.cnpj--||'-'||rs.razaosocial 
                                from roman.razoessociaisfiliais rs
                                   , roman.requisicoespagamentos rq
                               where rs.idfilial = rq.idfilialdestino
                                 and rs.idrazaosocialfilial = rq.idrazaosocialdest 
                                 and rq.idrequisicaopgto = r.idrequisicaopgto )
                           else 
                             ( select rs.cnpj--||'-'||rs.razaosocial 
                                 from roman.razoessociaisfiliais rs
                                    , roman.requisicoespagamentos rq
                                where rs.idfilial  = rq.idgrupo
                                  and rs.idrazaosocialfilial = rq.idfilialdestgr 
                                  and rq.idrequisicaopgto = r.idrequisicaopgto )
                        end cnpjdest
                     , r.observacao
                  from roman.requisicoespagamentos r
                     , roman.vw_matrizregrasdespesas md
                     , catal.fornecedores f
                     , catal.pessoas p
                 where r.idmatrizdespesa = md.idmatrizregra(+)
                   and f.idfornecedor = r.idfornecedor
                   and p.idpessoa = f.idpessoa
                   and ( :P675_TIPODATA = 'I' and  trunc(r.datainclusao) between to_date(:P675_DATAINICIO) and to_date(:P675_DATAFIM) or :P675_TIPODATA = 'V' and  trunc(r.vencimento) between to_date(:P675_DATAINICIO) and to_date(:P675_DATAFIM))
                   and ( :P675_SITUACAO  is null or r.idsituacao = :P675_SITUACAO )
                   and :P675_FILTRAR = 'S'
                   and (
                         r.usuarioinclusao = V('APP_USER')
                         -- Acesso 4037 (Visualiza requisições do mesmo setor): o usuário vê as
                         -- requisições de todos os usuários vinculados ao mesmo gerente que ele
                         or ( catal.pck_util.fnc_verificaacesso(4037, V('APP_USER')) = 'S'
                              and r.usuarioinclusao in ( select ug.usuario
                                                           from catal.usuarios ug
                                                              , catal.usuarios ue
                                                          where ue.usuario   = V('APP_USER')
                                                            and ug.idgerente = ue.idgerente ) )
                         -- Exceção: usuários vinculados ao gerente 288 (Thaymara) veem as requisições
                         -- de todos os demais usuários vinculados ao mesmo gerente
                         or ( exists ( select 1
                                         from catal.usuarios ue
                                        where ue.usuario = V('APP_USER')
                                          and ue.idgerente = 288 )
                              and r.usuarioinclusao in ( select ug.usuario
                                                           from catal.usuarios ug
                                                          where ug.idgerente = 288 ) )
                         -- Exceção: usuários SANDIT e GILHERMES veem as requisições de todos os
                         -- usuários vinculados ao gerente 298 (Leonardo Rikerth), responsável pela
                         -- equipe das filiais Rafiza Gramado e Rafiza Auto Locadora
                         or ( V('APP_USER') in ('SANDIT','GILHERMES')
                              and r.usuarioinclusao in ( select ug.usuario
                                                           from catal.usuarios ug
                                                          where ug.idgerente in ('293', '298','294') ) )
                         -- Exceção: usuários MAINARAGAELZER, BEATRIZGARCIA, JADERANGEL e CAMILALOPES
                         -- veem as requisições de todos os usuários vinculados ao gerente 310
                         or ( V('APP_USER') in ('MAINARAGAELZER','BEATRIZGARCIA','JADERANGEL','CAMILALOPES')
                              and r.usuarioinclusao in ( select ug.usuario
                                                           from catal.usuarios ug
                                                          where ug.idgerente = 310 ) )
                       ) --solicitado por Débora para Eduarda
                   and ( :P675_IDFILIAL is null or r.idfilial = :P675_IDFILIAL )
                   and (:P675_ANTECIPACAO is null or r.antecipacao = :P675_ANTECIPACAO )
                   and (:P675_COMPROVANTEPGTO is null or r.comprovantepgto = :P675_COMPROVANTEPGTO )
                   --and (:P675_ENVIAR_SETOR_FISCAL is null or r.fiscal = :P675_ENVIAR_SETOR_FISCAL)
                   /*and (r.usuarioinclusao = V('APP_USER')
                     or r.usuarioaprovacao = V('APP_USER')
                     or r.usuariofinalizadofiscal = V('APP_USER'))*/
                ) t
                /*where ( :P675_ATENDIMENTO = 'FIN' or
                       (:P675_ATENDIMENTO = 'COM' and substr(replace(t.cnpjdest,'.',''),1,8) in ('48320045','45397622','45300144','28800724','19321351','10571673','24737867','15551444','33354156','45612340','44671864','53923732','10571673')
                      or t.usuarioinclusao = 'MICHELEZIMPEL') or  --Equipe fiscal comercio, CNPJ RAIZ: 48.320.045, 45.397.622, 45.300.144.
                       :P675_ATENDIMENTO = 'IND' and substr(replace(t.cnpjdest,'.',''),1,8) =  ('07318638') ) -- Equipe fiscal indústria, CNPJ RAIZ: 07.318.638*/
                 order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 562578296200952714
        }

