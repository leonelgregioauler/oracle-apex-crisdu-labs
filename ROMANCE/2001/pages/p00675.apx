    pageItem P675_IDFILIAL (
        type: selectOne
        label {
            label: Filial
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(f.idfilial) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.ativo = 'S'
                  and f.idfilial = (select g.idfilial
                                     from catal.usuarios u
                                        , catal.gerentes g
                                    where u.idgerente = g.idgerente
                                      and u.usuario = V('APP_USER'))
                  --and f.tipofilial in ( select idtipofilial
                                      --  from acessostiposfiliais
                union
                select roman.pck_romance.fnc_nomefilial(f.idfilial) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.ativo = 'S'
                  and f.idfilial = 1088 -- Transportadora Crisdu
                  and v('APP_USER') in('ADRIELLEMOURA','MARIAKAMPFF')
                union 
                select roman.pck_romance.fnc_nomefilial(f.idfilial) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.ativo = 'S'
                  and f.idfilial = 1067 -- Crisdu Transportes
                  and v('APP_USER') in ('GUSTAVOFULBER','MARIAKAMPFF')
                union 
                select roman.pck_romance.fnc_nomefilial(f.idfilial) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.ativo = 'S'
                  and f.idfilial = 1120 -- Rafiza Auto Locadora Ltda
                  and v('APP_USER') in ('SANDIT','DOUGLASRIFFEL','GILHERMES','DIEGOPIECHO')  --usuário rafiza gramado ver rafiza taquara
                union 
                select roman.pck_romance.fnc_nomefilial(f.idfilial) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.ativo = 'S'
                  and f.idfilial = 1204
                  and v('APP_USER') in ('PAMELASEIBEL')  --usuário rafiza taquara ver rafiza gramado
                union 
                -- T10083980
                select roman.pck_romance.fnc_nomefilial(f.idfilial) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.ativo = 'S'
                  and f.idfilial = 1152 -- Revenda De Veiculos 
                  and v('APP_USER') in ('DOUGLASRIFFEL')  --usuário rafiza gramado ver rafiza taquara
                order by 1
                
                -- User DOUGLASRIFFEL adicionado no t10083980
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P675_SITUACAO (
        type: selectOne
        label {
            label: Situação
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.situacao display_value
                     , s.idsituacao return_value
                from roman.situacoesrequisicoes s
                -- Projeto fluxo paralelo: status onde o usu¿rio criador atua (1, 4) e status
                -- informacionais que ele acompanha (6, 7, 10, 11, 12, 13). Os status 11/13
                -- s¿o tratados internamente pelo fiscal; usu¿rio s¿ os v¿ como informa¿¿o.
                where s.idsituacao in (1, 4, 6, 7, 10, 11, 12, 13)
                order by s.idsituacao
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P675_TIPODATA (
        type: radioGroup
        label {
            label: Tipo de Data
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Inclusão;I,Vencimento;V
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @ações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: I
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @filtros
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button nova-requisicao (
        buttonName: Nova_Requisicao
        label: Nova Requisição
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 674
                items: {
                    P674_IDREQUISICAO:
                }
                clearCache: 674
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button ver-despesas-veiculos (
        buttonName: VER_DESPESAS_VEICULOS
        label: Ver Rateios de Veículos
        layout {
            sequence: 10
            region: @ações-especiais
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 796
                items: {
                    P796_FILTRAR: N
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 675
                items: {
                    P675_DATAINICIO: &P675_DATAINICIO.
                    P675_DATAFIM: &P675_DATAFIM.
                    P675_SITUACAO: &P675_SITUACAO.
                    P675_FILTRAR: S
                }
                action: resetPagination
            }
        }
    )

)

