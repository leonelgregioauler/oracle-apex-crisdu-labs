    region parâmetros-por-distribuidor (
        name: Parâmetros por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT p.IDPARAMETROREPRES
                     , p.IDREPRESENTANTE iddistribuidor 
                     , pck_romance.fnc_nomerepresentante(idrepresentante) distribiuidor
                     , c.PARAMETRO   
                     , c.VALOR
                     , c.OBSERVACAO
                  from PARAMETROSREPRESENTANTES p
                     , CADASTROSPARAMETROSREPRES c  
                WHERE c.IDCADASTROPARAMETRO = p.IDCADASTROPARAMETRO 
                 and IDREPRESENTANTE IN ( SELECT IDREPRESENTANTE 
                                            FROM representantes r 
                                               , gerentes       g
                                             WHERE g.idfilial  = :P0_IDFILIAL
                                               and r.ativo = 'S' 
                                               and g.idgerente = r.idgerente )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
