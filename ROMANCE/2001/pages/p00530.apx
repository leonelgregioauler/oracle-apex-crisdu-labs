    region parâmetros-dos-distribuidores-agrupado (
        name: "Parâmetros dos Distribuidores Agrupado "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT c.PARAMETRO   
                     , c.VALOR
                     , c.OBSERVACAO
                     , c.idfilial
                     , LISTAGG(  pck_romance.fnc_nomerepresentante(idrepresentante),',' ) WITHIN GROUP (ORDER BY pck_romance.fnc_nomerepresentante(idrepresentante) ) distribuidores
                  from PARAMETROSREPRESENTANTES p
                     , CADASTROSPARAMETROSREPRES c  
                WHERE c.IDCADASTROPARAMETRO = p.IDCADASTROPARAMETRO 
                 and IDREPRESENTANTE IN ( SELECT IDREPRESENTANTE 
                                            FROM representantes r 
                                               , gerentes       g
                                             WHERE g.idfilial  = :P0_IDFILIAL
                                               and r.ativo = 'S' 
                                               and g.idgerente = r.idgerente )
                GROUP by c.PARAMETRO   
                     , c.VALOR     
                     , c.OBSERVACAO
                     , c.idfilial
                ORDER BY 1     
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2194445166095058002
        }

