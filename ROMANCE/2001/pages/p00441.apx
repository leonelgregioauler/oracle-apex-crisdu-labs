            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: A
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: FILTRAR
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 441
                items: {
                    P441_TIPODATA: &P441_TIPODATA.
                    P441_IDREPRESENTANTE: &P441_IDREPRESENTANTE.
                    P441_TIPONOTIFICACAO: &P441_TIPONOTIFICACAO.
                    P441_DATAINICIO: &P441_DATAINICIO.
                    P441_DATAFIM: &P441_DATAFIM.
                }
                action: resetPagination
            }
