page 441 (
    name: Notificações Distribuidores
    title: Notificações Distribuidores
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region notificações-de-distribuidores (
        name: Notificações de Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nd.idnotificacao
                     , nd.idpessoa
                     , pck_romance.fnc_nomerepresentante(r.idrepresentante) distribuidor
                     , nd.idpedido
                     , decode(nd.tiponotificacao,'A','Aviso','P','Pedido') tiponotificacao
                     , nd.datainclusao
                     , nd.dataenvio
                     , nd.titulo
                     , nd.mensagem
                from notificacoesdistribuidores nd
                   , representantes r
                where r.idpessoa = nd.idpessoa
                  and ( :P441_IDREPRESENTANTE is null or r.idrepresentante = :P441_IDREPRESENTANTE )
                  and ( :P441_TIPONOTIFICACAO is null 
                       or ( :P441_TIPONOTIFICACAO = 'A' and nd.dataenvio is null )
                       or ( :P441_TIPONOTIFICACAO = 'E' and nd.dataenvio is not null ) )
                  and ( :P441_TIPODATA is null 
                       or ( :P441_TIPODATA = 'I' and trunc(nd.datainclusao) between to_date(:P441_DATAINICIO) and to_date(:P441_DATAFIM) )
                       or ( :P441_TIPODATA = 'E' and trunc(nd.dataenvio) between to_date(:P441_DATAINICIO) and to_date(:P441_DATAFIM) ) )
                order by 1 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent12
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2644276739230851829
        }

        column DATAENVIO (
            type: plainText
            heading {
                heading: Data do Envio
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
