page 714 (
    name: Cadastro Categorias Estrelas Romance
    title: Cadastro Categorias Estrelas Romance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"Confirma exclusão do registro?"';
    }

    region cadastro-de-categorias-estrelas-romance (
        name: Cadastro de  Categorias Estrelas Romance
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P714_IDCATEGORIACLUBE (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-categorias-estrelas-romance
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCATEGORIACLUBE
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P714_NOMECATEGORIA (
        type: textField
        label {
            label: Nome da Categoria
            alignment: left
        }
        layout {
            sequence: 20
            region: @cadastro-de-categorias-estrelas-romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: NOMECATEGORIA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar/Voltar
        layout {
            sequence: 10
            region: @cadastro-de-categorias-estrelas-romance
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 713
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @cadastro-de-categorias-estrelas-romance
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P714_IDCATEGORIACLUBE
        }
    )

    button insert (
        buttonName: INSERT
        label: Incluir
        layout {
            sequence: 40
            region: @cadastro-de-categorias-estrelas-romance
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P714_IDCATEGORIACLUBE
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @cadastro-de-categorias-estrelas-romance
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P714_IDCATEGORIACLUBE
        }
    )

    process fetch-row-from-categoriasclubes (
        name: Fetch Row from CATEGORIASCLUBES
        type: autoRowFetch
        source {
            tableName: CATEGORIASCLUBES
            pkColumn: IDCATEGORIACLUBE
            pkItem: P714_IDCATEGORIACLUBE
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1505406742154329522
        }
    )

    process process-row-of-categoriasclubes (
        name: Process Row of CATEGORIASCLUBES
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 v_operacao_dml varchar2(1);
                 v_md5 varchar2(4000);
                begin
                
                if v('REQUEST') = 'INSERT' then
                  v_operacao_dml := 'I';
                elsif v('REQUEST') = 'SAVE' then
                  v_operacao_dml := 'U';
                elsif v('REQUEST') = 'DELETE' then
                  v_operacao_dml := 'D';
                end if;
                
                pck_clubedesucesso.prc_categoriasclubes (:P714_IDCATEGORIACLUBE,
                                                         :P714_NOMECATEGORIA,
                                                         v_md5,
                                                         v_operacao_dml);
                
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação processada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1505407184946329522
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1505407538530329522
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: Go To Page 713
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 713
            }
        }
    )

)

