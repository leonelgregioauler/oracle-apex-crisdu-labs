page 640 (
    name: Notas com Débitos Acertos
    title: Notas com Débitos Acertos
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region notas-detalhadas (
        name: Notas Detalhadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , nv.numeronota
                     , pck_romance.fnc_nomevendedora(nv.idvendedora) consultora
                     , nv.valortotalnota
                     , nv.valortotalvendalqd
                     , nv.valortotaldevolucao
                     , nv.valorpago
                     , nv.saldo
                     , nv.dataacerto
                from notasvendas nv
                where nv.idrepresentante = :P640_IDREPRESENTANTE
                  and nv.semanacobranca  = :P640_SEMANA
                  and nv.saldo          <= 30
                  and nv.saldo           > 0
                  and nv.idsituacaonotavenda = 4
                  and nv.idfilial = 290
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 178454744580370441
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column DATAACERTO (
            type: plainText
            heading {
                heading: Data do Acerto
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        column IDNOTAVENDA (
            type: link
            heading {
                heading: Ir para Nota
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 37
                    items: {
                        P37_IDNOTAVENDA: #IDNOTAVENDA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column NUMERONOTA (
            type: plainText
            heading {
                heading: Nr Nota
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column SALDO (
            type: plainText
            heading {
                heading: Saldo
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALORPAGO (
            type: plainText
            heading {
                heading: Pago
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column VALORTOTALDEVOLUCAO (
            type: plainText
            heading {
                heading: Total Devolução
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column VALORTOTALNOTA (
            type: plainText
            heading {
                heading: Total Nota
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column VALORTOTALVENDALQD (
            type: plainText
            heading {
                heading: Total Venda
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 2498005 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONSULTORA (
                sequence: 3
            )

            displayColumn DATAACERTO (
                sequence: 9
            )

            displayColumn IDNOTAVENDA (
                sequence: 1
            )

            displayColumn NUMERONOTA (
                sequence: 2
            )

            displayColumn SALDO (
                sequence: 8
            )

            displayColumn VALORPAGO (
                sequence: 7
            )

            displayColumn VALORTOTALDEVOLUCAO (
                sequence: 5
            )

            displayColumn VALORTOTALNOTA (
                sequence: 4
            )

            displayColumn VALORTOTALVENDALQD (
                sequence: 6
            )

        )

    )

    pageItem P640_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @notas-detalhadas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P640_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @notas-detalhadas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

