    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction escolhe-período (
        name: Escolhe Período
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P523_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P523_TIPOPESQUISA
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P523_IDSEMANA_INI
                    P523_IDSEMANA_FIM
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P523_IDSEMANA
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P523_IDSEMANA_INI
                    P523_IDSEMANA_FIM
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P523_IDSEMANA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        name: Go To Page 523
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 523
                items: {
                    P523_TIPOPESQUISA: &P523_TIPOPESQUISA.
                    P523_IDSEMANA: &P523_IDSEMANA.
                    P523_IDSEMANA_INI: &P523_IDSEMANA_INI.
                    P523_IDSEMANA_FIM: &P523_IDSEMANA_FIM.
                    P523_IDREPRESENTANTE: &P523_IDREPRESENTANTE.
                    P523_INADIMPLENCIA: &P523_INADIMPLENCIA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

