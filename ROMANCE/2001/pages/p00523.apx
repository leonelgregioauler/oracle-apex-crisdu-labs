page 523 (
    name: Produtos para Faturar
    title: Produtos para Faturar
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region produtos-vendidos-para-faturar (
        name: Produtos Vendidos para Faturar
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist codigo
                     , initcap(p.nomeproduto) produto
                     , decode(it.comissao,'S','Com Comissão','N','Sem Comissão') comissao
                     , it.valorvenda valor
                     , sum(it.quantidade - it.qtddevolvida) qtdvenda
                     , sum((it.quantidade - it.qtddevolvida) * it.valorvenda) valorvenda
                from itensnotavenda it
                   , estoquefilial ep
                   , produtos p
                where ep.idestoquefilial = it.idestoquefil
                  and p.idproduto        = ep.idproduto
                  and exists ( select 1
                               from notasvendas nv
                               where nv.idnotavenda         = it.idnotavenda
                                 and nv.idsituacaonotavenda = 4
                                 and nv.valortotalvendalqd  > 0
                                 and nv.idfilial            = :P0_IDFILIAL 
                                 and ( :P523_INADIMPLENCIA = 'A' 
                                    or ( :P523_INADIMPLENCIA = 'S' and nv.saldo > 0 )
                                    or ( :P523_INADIMPLENCIA = 'N' and nv.saldo = 0 ) )
                                 and ( :P523_TIPOPESQUISA is null 
                                    or ( :P523_TIPOPESQUISA = 'S' and nv.idsemanacobranca = :P523_IDSEMANA )
                                    or ( :P523_TIPOPESQUISA = 'P' and nv.idsemanacobranca between :P523_IDSEMANA_INI and :P523_IDSEMANA_FIM ) )
                                 and ( :P523_IDREPRESENTANTE is null or nv.idrepresentante = :P523_IDREPRESENTANTE ) )
                  and it.quantidade - it.qtddevolvida > 0
                group by p.nomeproduto, p.codigosisdist, it.comissao, it.valorvenda
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum dado encontrado! Favor verificar os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 1588831714230640915
        }

        column CODIGO (
            type: plainText
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column COMISSAO (
            type: plainText
            heading {
                heading: Comissão
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column PRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column QTDVENDA (
            type: plainText
            heading {
                heading: Quantidade de Venda
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor de Venda
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column VALORVENDA (
            type: plainText
            heading {
                heading: Valor Total Venda
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 15888437 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CODIGO (
                sequence: 1
            )

            displayColumn COMISSAO (
                sequence: 4
            )

            displayColumn PRODUTO (
                sequence: 2
            )

            displayColumn QTDVENDA (
                sequence: 5
            )

            displayColumn VALOR (
                sequence: 3
            )

            displayColumn VALORVENDA (
                sequence: 6
            )

            sort (
                column: QTDVENDA
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            aggregate (
                column: QTDVENDA
            )

            aggregate (
                column: VALORVENDA
            )

        )

    )

    pageItem P523_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' ('||decode(r.ativo,'S','Ativo','N','Inativo')||')' d
                     , idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P523_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano d
                     , idsemana r
                from semana_dias s
                where idsemana between pck_util.fnc_idsemanadata(sysdate)-30 and pck_util.fnc_idsemanadata(sysdate)+10
                order by s.idsemana desc
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P523_IDSEMANA_FIM (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano d
                     , idsemana r
                from semana_dias s
                where idsemana between pck_util.fnc_idsemanadata(sysdate)-30 and pck_util.fnc_idsemanadata(sysdate)+10
                order by s.idsemana desc
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P523_IDSEMANA_INI (
