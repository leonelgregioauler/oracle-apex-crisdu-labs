    dynamicAction atualiza (
        name: Atualiza
        execution {
            sequence: 90
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @inserir-editar-despesa
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#P723_VALOR').prop('readonly', true);
            }
            affectedElements {
                selectionType: items
                items: P723_VALOR
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @inserir-editar-despesa
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select sum(C006)  --VALOR
                        from apex_collections ac
                       where collection_name = 'COL_'||v('APP_USER');
                    ```
            }
            affectedElements {
                selectionType: items
                items: P723_VALOR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction atualizavalor (
        name: AtualizaValor
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: items
            items: P723_IDMATRIZCLASSIFICACAO
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where :P723_TEMCNPJ = 'S' 
                   and :P723_IDDESPESA is null
                
                ```
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P723_VALOR
            }
            execution {
                sequence: 30
            }
            serverSideCondition {
                type: never
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      null;
                    end;
                    ```
                itemsToSubmit: P723_VALOR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                      v_valor number;
                    begin
                      if :P723_TEMCNPJ = 'S' then
                        select sum(C006)
                          into v_valor
                          from apex_collections
                         where collection_name = 'COL_'||v('APP_USER');
                      else
                        v_valor := 99; --:P723_VALOR;
                      end if;
                    
                    --  raise_application_error(-20001,'valor '||v_valor);
                    
                      return v_valor;
                    
                    end;
                    ```
                itemsToSubmit: [
                    P723_TEMCNPJ
                    P723_VALOR
                ]
            }
            affectedElements {
                selectionType: items
                items: P723_VALOR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

