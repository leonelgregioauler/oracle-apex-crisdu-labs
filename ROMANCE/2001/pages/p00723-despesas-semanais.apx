    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 50
            region: @inserir-editar-despesa
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                ( ( nvl(:P723_EMMAOS,'N') = 'N' and exists ( select 1
                                                            from fechamentossemanais s
                                                            where s.idfechamento = :P723_IDFECHAMENTO
                                                              and concluido = 'N') 
                                               and :P723_IDMOVIMENTOGERAL is null 
                  
                    or ( :P723_EMMAOS = 'S' and exists ( select 1 
                                                        from usuariosgruposatendimento ug
                                                        where ug.usuario = v('APP_USER')
                                                          and ug.idgrupoatendimento in (0,2) ) ) ) )
                                                          
                --Valida o idmovimentogeral para não permitir excluir ou alterar as informações quando é uma despesa gerada por uma saída de outra filial.
                --Quando esta com essa condição, não habilita nem para a equipe da controladoria.
                ```
        }
    )

