    process desvincular-cnpj (
        name: DESVINCULAR_CNPJ
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if nvl(:P723_TEMCNPJ, 'X') = 'N' then
                
                    delete from despesasformaspag
                    where iddespesa = :P723_IDDESPESA;
                
                    update despesas
                    set idrepresentante = null
                      , idrazaosocialfilial = null
                      , temcnpj = :P723_TEMCNPJ
                      , idtipodocumento = null
                      , idfornecedor = null
                      , datadocumento = null
                    where iddespesa = :P723_IDDESPESA;
                
                    -- delete na lancamentoscontabeis ocorre na trigger da tabela despesas
                    
                    commit;
                    
                end if;
                ```
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: CNPJ Desvinculado
        }
        advanced {
            executionMappingIdentifier: 2302617189537515254
        }
        serverSideCondition {
            type: expression
            plsqlExpression: nvl(:P723_TEMCNPJ, 'X') = 'N'
        }
    )

