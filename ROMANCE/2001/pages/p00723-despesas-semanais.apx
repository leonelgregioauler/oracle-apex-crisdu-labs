    validation valida-tem-cnpj-e-tipo-documento (
        name: Valida Tem CNPJ e Tipo Documento
        execution {
            sequence: 200
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody: RETURN NOT ( :P723_TEMCNPJ = 'S' AND( NVL(:P723_TIPODOCUMENTO, '') IS NULL or nvl(:P723_IDRAZAOSOCIALFILIAL, '') is null));
        }
        error {
            errorMessage: Para Despesas com o campo "Tem CNPJ" = "Sim", tem que ter lançamentos em Formas Pagamento e o campo "TIPO DOCUMENTO" e "RAZÃO SOCIAL" deve ser informado!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CREATE','SAVE')
                ```
        }
    )

    validation valida-temcnpj (
        name: Valida_TemCNPJ
        execution {
            sequence: 230
        }
        validation {
            type: itemIsNotNull
            item: P723_TEMCNPJ
        }
        error {
            errorMessage: Obrigatório informar!
            associatedItem: @P723_TEMCNPJ
        }
        serverSideCondition {
            type: never
        }
    )

    validation valida-total (
        name: Valida Total
        execution {
            sequence: 210
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  v_existe NUMBER;
                BEGIN
                  -- So validar se for 'S'
                  IF :P723_TEMCNPJ = 'S' THEN
                    -- Verifica se existe registro na tabela despesasformaspag
                    begin
                      select 1
                        into v_existe
                        from dual
                       where to_number(replace(:P723_VALOR,'.','')) <> 
                             (SELECT sum(valor)
                                FROM despesasformaspag
                               WHERE iddespesa = :P723_IDDESPESA);
                    exception
                      when others then null;
                    end;
                    --
                    --raise_application_error(-20001,'v_existe= '||v_existe);
                    IF v_existe = 1 THEN
                      RETURN FALSE;
                    END IF;
                  END IF;
                  RETURN TRUE;
                END;
                ```
        }
        error {
            errorMessage: O valor lançado em "Formas Pagamentos" deve ser igual ao "Valor Total" da despesa.
        }
        serverSideCondition {
            type: never
        }
    )

    validation valida-total-2 (
        name: Valida Total_1
        execution {
            sequence: 220
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  v_total_D NUMBER;
                  v_total_C number;
                  v_existe  number;
                BEGIN
                  -- So validar se for 'S'
                  IF :P723_TEMCNPJ = 'S' THEN
                    -- Verifica se existe registro na tabela despesasformaspag
                    select sum(C006)
                      into v_total_C
                      from apex_collections ac
                     where collection_name = 'COL_'||v('APP_USER');
                
                    select sum(valor)
                      into v_total_D
                      from despesasformaspag
                     where iddespesa = :P723_IDDESPESA;
                    
                    begin
                      select 1
                        into v_existe
                        from dual
                       where to_number(replace(:P723_VALOR,'.','')) <> nvl(v_total_C, v_total_D);
                           
                    exception
                      when others then null;
                    end;
                    --
                    IF v_existe = 1 THEN
                      RETURN FALSE;
                    END IF;
                  END IF;
                  RETURN TRUE;
                END;
                ```
        }
        error {
            errorMessage: O valor lançado em "Formas Pagamentos" deve ser igual ao "Valor Total" da despesa.
        }
        serverSideCondition {
            type: never
        }
    )

