        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idSUBcontafinan  return_value
                from SUBcontasfinanceiras c
                where exists ( select 1
                               from matrizclassificacoesdespesas m
                               where m.idmatrizclassificacao = :P723_IDMATRIZCLASSIFICACAO
                                 and m.idsubcontafinan       = c.idsubcontafinan )
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P723_IDCONTACONTABIL
                P723_IDMATRIZCLASSIFICACAO
            ]
        }
        layout {
            sequence: 120
            region: @inserir-editar-despesa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
