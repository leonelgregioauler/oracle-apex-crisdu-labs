    dynamicAction new (
        name: New
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P723_IDRAZAOSOCIALFILIAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      --
                      v_nomecol varchar2(500) := 'col_razaosocial';
                      --
                    begin
                      --
                      if apex_collection.collection_exists ( v_nomecol ) then
                        --
                        apex_collection.delete_collection ( v_nomecol );
                        --
                      end if;
                      --
                      apex_collection.create_collection_from_query ( p_collection_name => v_nomecol,
                                                                     p_query           => 'select '||:P723_IDRAZAOSOCIALFILIAL|| ' id from dual' );
                      --
                    end;
                    ```
                itemsToSubmit: P723_IDRAZAOSOCIALFILIAL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

