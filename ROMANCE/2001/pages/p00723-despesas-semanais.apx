    pageItem P723_IDCONTACONTABIL (
        type: selectList
        label {
            label: Conta Contábil
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idcontafinan  return_value
                from contasfinanceiras c
                where exists ( select 1
                               from matrizclassificacoesdespesas m
                               where m.idmatrizclassificacao = :P723_IDMATRIZCLASSIFICACAO
                                 and m.idcontafinan          = c.idcontafinan )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P723_IDMATRIZCLASSIFICACAO
        }
        layout {
            sequence: 110
            region: @inserir-editar-despesa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTACONTABIL
            used: always
        }
        readOnly {
            type: expression
            language: sql
            sqlExpression: :P723_IDREPRESENTANTE2 is not null or :P723_IDMOVIMENTOGERAL IS NOT NULL
        }
        security {
            encryptSessionState: false
        }
    )

