    pageItem P723_IDREPRESENTANTE2 (
        type: popupLov
        label {
            label: Idrepresentante2
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||r.idrepresentante||')' || decode(r.ativo,'S','','Inativo') display_value
                     , r.idrepresentante
                from catal.representantes r
                where r.idgerente in ( select idgerente
                                       from gerentes
                                       where idfilial = :P0_IDFILIAL )
                order by 1
                ```
        }
        layout {
            sequence: 210
            region: @inserir-editar-despesa
            slot: regionBody
            alignment: left
