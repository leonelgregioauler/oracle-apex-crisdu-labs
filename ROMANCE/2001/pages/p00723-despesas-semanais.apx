page 723 (
    name: Despesas Semanais
    alias: DESPESAS-SEMANAIS
    title: Despesas Semanais
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='Confirma a exclusão da Despesa?';
            
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
            }
            
            
            
            function  confirmadespesa(event)
            { 
            var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            
            if (tecla==13) {
            var answer = confirm("Confirma inclusão da despesa?")
            	if (answer){            
            		apex.submit('CREATE');
            	}
            }
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region arquivos-anexados (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     , idsaida||idanexosaida||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                    -- , '<a href="javascript: fnc_verimg('''||idsaida||idanexosaida||substr(t.nomearquivo,instr(t.nomearquivo,'.'),10)||''');">Ver arquivo</a>' link
                     , dataanexo data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario) usuario
                from anexossaidas t
                where idsaida = ( select s.idsaida
                                  from saidasdiversas s
                                     , movimentosgeral m
                                     , despesas d
                                  where d.iddespesa        = :P723_IDDESPESA
                                    and m.idmovimentogeral = d.idmovimentotogeral 
                                    and s.idsaida          = m.idsaidadiversa )
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from anexossaidas t
                where idsaida = ( select s.idsaida
                                  from saidasdiversas s
                                     , movimentosgeral m
                                     , despesas d
                                  where d.iddespesa        = :P723_IDDESPESA
                                    and m.idmovimentogeral = d.idmovimentotogeral 
                                    and s.idsaida          = m.idsaidadiversa )
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                sortable: false
            }
        )

        column LINK (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Link
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            link {
                target: {
                    page: 383
                    items: {
                        P383_ARQUIVO: #LINK#
                    }
                    action: resetPagination
                }
                linkText: Ver Anexo
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

    )

    region arquivos-anexados-2 (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     -- forma antiga , '<a href="javascript: fnc_verimg('''||iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' link
                     , dataanexo data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario) usuario
                     , iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) veranexo
                from anexosdespesas t
                where iddespesa = :P723_IDDESPESA
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                 :P723_IDDESPESA is not null and exists ( select 1
                                                           from anexosdespesas d
                                                           where d.iddespesa = :P723_IDDESPESA )
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                sortable: false
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column VERANEXO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: link
            heading {
                heading: Ver Anexo
                alignment: center
            }
            layout {
                sequence: 4
            }
            link {
                target: {
                    page: 383
                    items: {
                        P383_ARQUIVO: #VERANEXO#
                    }
                    action: resetPagination
                }
                linkText: Ver Anexo
            }
            sorting {
                sortable: false
            }
        )

    )

    region inserir-editar-despesa (
        name: Inserir/Editar Despesa
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <font color="blue" size=4> Agora você pode anexar os comprovantes após lançar a despesa!</font>
        }
    )

    pageItem P723_ANO (
        type: hidden
        layout {
            sequence: 90
            region: @inserir-editar-despesa
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ANO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_char(sysdate,'RRRR');
                end;
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P723_DATADOCUMENTO (
        type: displayOnly
        label {
