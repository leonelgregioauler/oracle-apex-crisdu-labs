    pageItem P723_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomepessoa d
                     , f.idfornecedor r
                  from catal.fornecedores f
                     , catal.pessoas      p
                 where f.idpessoa = p.idpessoa
                   and f.ativo = 'S'
                  order by 1
                ```
        }
        layout {
            sequence: 40
            region: @inserir-editar-despesa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        source {
            type: databaseColumn
            databaseColumn: IDFORNECEDOR
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from roman.parametros
                 where idfilial = :P0_IDFILIAL
                   and nome = 'CONTABILIZAEMPRESA'
                   and valor = 'S'
                   and 1=2 -- Foi definido que fornecedor não precisa ser informado.
                   --and :P723_IDDESPESA IS NOT NULL
                ```
        }
    )

    pageItem P723_IDMATRIZCLASSIFICACAO (
        type: selectList
        label {
