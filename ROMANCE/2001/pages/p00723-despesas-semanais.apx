        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATADOCUMENTO
            used: always
        }
        default {
            type: expression
            plsqlExpression:
                ```plsql
                to_char(systimestamp,'dd/mm/rrrr hh24:mi:ss')
                
                ```
