    button salvar (
        buttonName: SALVAR
        label: Salvar e Encaminhar para Fila
        layout {
            sequence: 20
            region: @buttons
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item!=value
            item: P684_MENSAGEM
            value: Operação bem sucedida
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-dml-em-negociaos-em-lote (
        name: Consulta DML em Negociaos em Lote
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vmd5 varchar2(1000);
                begin
                  -- Call the procedure
                  pck_cadastros_rmc.prc_negativacoesspclote(pidnegativacaospclote => :P684_IDNEGATIVACAOSPCLOTE,
                                                            pdataleitura => :P684_DATALEITURA,
                                                            pmensagem => :P684_MENSAGEM,
                                                            pcpf => :P684_CPF,
                                                            pnomepessoa => :P684_NOMEPESSOA,
                                                            pdatanascimento => :P684_DATANASCIMENTO,
                                                            pendereco => :P684_ENDERECO,
                                                            pnumero => :P684_NUMERO,
                                                            pcep => :P684_CEP,
                                                            pbairro => :P684_BAIRRO,
                                                            pcidade => :P684_CIDADE,
                                                            psigla => :P684_SIGLA,
                                                            pdatavencimento => :P684_DATAVENCIMENTO,
                                                            pdatacontrato => :P684_DATACONTRATO,
                                                            pvalorcontrato => :P684_VALORCONTRATO,
                                                            pnumerocontrato => :P684_NUMEROCONTRATO,
                                                            pexclusaospc => :P684_EXCLUSAOSPC,
                                                            pmd5 => vmd5,
                                                            poperacao_dml => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 572406340890072533
        }
    )

    process processo-dml-em-negativacoes-spc (
        name: Processo DML em Negativacoes SPC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vmd5 varchar2(1000);
                begin
                  -- Call the procedure
                  pck_cadastros_rmc.prc_negativacoesspclote(pidnegativacaospclote => :P684_IDNEGATIVACAOSPCLOTE,
                                                            pdataleitura => :P684_DATALEITURA,
                                                            pmensagem => :P684_MENSAGEM,
                                                            pcpf => :P684_CPF,
                                                            pnomepessoa => :P684_NOMEPESSOA,
                                                            pdatanascimento => :P684_DATANASCIMENTO,
                                                            pendereco => :P684_ENDERECO,
                                                            pnumero => :P684_NUMERO,
                                                            pcep => :P684_CEP,
                                                            pbairro => :P684_BAIRRO,
                                                            pcidade => :P684_CIDADE,
                                                            psigla => :P684_SIGLA,
                                                            pdatavencimento => :P684_DATAVENCIMENTO,
                                                            pdatacontrato => :P684_DATACONTRATO,
                                                            pvalorcontrato => :P684_VALORCONTRATO,
                                                            pnumerocontrato => :P684_NUMEROCONTRATO,
                                                            pexclusaospc => :P684_EXCLUSAOSPC,
                                                            pmd5 => vmd5,
                                                            poperacao_dml => 'U');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Enviado para fila Novamente.
        }
        advanced {
            executionMappingIdentifier: 572453145130417295
        }
        serverSideCondition {
            type: request=Value
            value: SALVAR
        }
    )

)

