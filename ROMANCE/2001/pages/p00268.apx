        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 60%
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function deletaanexo(pid)
            {
            
              var answer = confirm("Confirma exlusão do Anexo?")
              if (answer)
                {
                  document.getElementById('P268_DELETAR').value = pid;
                  apex.submit('DELETAR');
                }
            }
            ```
    }
    headerAndFooter {
        footerText:
            ```html
            <script javascript>
             window.resizeTo(screen.width*.46,screen.height*.46);  
                window.moveTo(screen.width*.26, screen.height*.20);  
            </script>
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region anexar-arquivos-transferência-de-merc (
        name: Anexar Arquivos Transferência de Merc.
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P268_NRPAGINA
            value: 214
        }
        settings {
            outputAs: text
        }
    )

    region arquivo-s-anexados (
        name: Arquivo(s) Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDANEXONOTAFISCAL,
                       IDNOTAFISCAL,
                       ATTACH_DATA,
                       ATTACH_MIMETYPE,
                       ATTACH_FILENAME,
                       ATTACH_LAST_UPDATE,
                       ATTACH_CHARSET,
                       round(sys.dbms_lob.getlength(ATTACH_DATA)/1024,2)||' kb' file_length,
                       sys.dbms_lob.getlength(ATTACH_DATA) download,
                       '<a href="javascript: deletaanexo('||IDANEXONOTAFISCAL||')"> Excluir </a>' remover,
                       roman.pck_bucket.sp_abre_anexo(url_bucket) preview
                  from ANEXOSNOTASFISCAIS
                where IDNOTAFISCAL = :P268_IDNOTAFISCAL
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Sem Arquivo(s) Anexado(s).
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
