        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P268_IDANEXONOTAFISCAL is null then
                        select "#OWNER#"."SEQ_IDANEXONOTAFISCAL".nextval
                          into :P268_IDANEXONOTAFISCAL
                          from sys.dual;
                    end if;
                end;
                ```
