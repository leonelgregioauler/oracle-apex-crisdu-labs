page 273 (
    name: Voltar Informações Nota
    title: Voltar Informações Nota
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region buscar-informações (
        name: Buscar Informações
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P273_IDNOTAVENDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @buscar-informações
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P273_INFO (
        type: selectList
        label {
            label: Data Alteração
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'idlog: '||l.idlog||' - '||to_char(l.dataalteracao,'dd/mm/rrrr hh24:mi:ss')||' idnota: '||l.idnotavenda display_value
                  , l.idlog return_log
                from logroman.log_notasvendas l
                where idnotavenda = :P273_IDNOTAVENDA
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            region: @buscar-informações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button confirma (
        buttonName: CONFIRMA
        label: Confirmar Alterações
        layout {
            sequence: 20
            region: @buscar-informações
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: Voltar
        label: Voltar
        layout {
            sequence: 10
            region: @buscar-informações
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 37
                items: {
                    P37_IDNOTAVENDA: &P273_IDNOTAVENDA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process confirma-atualizações (
        name: confirma atualizações
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidlog                 number := :P273_INFO;
                  vSEMANADISTRIBUICAO    VARCHAR2(10);
                  vSEMANACOBRANCA        VARCHAR2(10);
                  vIDREGIAOVENDA 	     NUMBER;
                  vVALORTOTALNOTA 	     NUMBER;
                  vVALORTOTALDEVOLUCAO   NUMBER;
                  vVALORTOTALVENDA       NUMBER;
                  vBASECOMISSAO 	     NUMBER;
                  vPERCCOMISSAO 	     NUMBER;
                  vVALORCOMISSAO	     NUMBER;
                  vVALORPAGO 	         NUMBER;
                  vSALDO 	             NUMBER;
                  vVALORTOTALVENDALQD    NUMBER;
                  vNUMERONOTA 	         number;
                  vIDSITUACAONOTAVENDA   number;
                  vEDICAOBLOQUEADA       VARCHAR2(1);
                  vQUITADAPEPINO         VARCHAR2(1);
                  vENVIADOCOBRANCA       VARCHAR2(1);
                  vPERCCOMISSAOCORRETA   number;
                  vIDREPRESENTANTEATENDE number;
                  vPERCPONTOS            number;
                  vDATAACERTO            date;
                  vRECUPERARPROMISSORIA  VARCHAR2(1);
                  vPROMISSORIARECUPERADA VARCHAR2(1);
                  vIDSEMANACOBRANCA      VARCHAR2(10);
                  vULTIMAALTERACAO       date;
                begin
                  --
                  select SEMANADISTRIBUICAO,SEMANACOBRANCA,IDREGIAOVENDA,VALORTOTALNOTA,VALORTOTALDEVOLUCAO,VALORTOTALVENDA,BASECOMISSAO,PERCCOMISSAO, 	     
                         VALORCOMISSAO,VALORPAGO,SALDO,VALORTOTALVENDALQD,NUMERONOTA,IDSITUACAONOTAVENDA,EDICAOBLOQUEADA,QUITADAPEPINO,ENVIADOCOBRANCA,      
                         PERCCOMISSAOCORRETA,IDREPRESENTANTEATENDE,PERCPONTOS,DATAACERTO,RECUPERARPROMISSORIA,PROMISSORIARECUPERADA,IDSEMANACOBRANCA
                  into  vSEMANADISTRIBUICAO,vSEMANACOBRANCA,vIDREGIAOVENDA,vVALORTOTALNOTA,vVALORTOTALDEVOLUCAO,vVALORTOTALVENDA,vBASECOMISSAO,vPERCCOMISSAO, 	     
                        vVALORCOMISSAO,vVALORPAGO,vSALDO,vVALORTOTALVENDALQD,vNUMERONOTA,vIDSITUACAONOTAVENDA,vEDICAOBLOQUEADA,vQUITADAPEPINO,vENVIADOCOBRANCA,      
                        vPERCCOMISSAOCORRETA,vIDREPRESENTANTEATENDE,vPERCPONTOS,vDATAACERTO,vRECUPERARPROMISSORIA,vPROMISSORIARECUPERADA,vIDSEMANACOBRANCA    
                  from logroman.log_notasvendas
                  where idlog = vidlog;
                  --
                  vULTIMAALTERACAO := sysdate;
                  --
                  update notasvendas
                  set SEMANADISTRIBUICAO    = vSEMANADISTRIBUICAO     
                	, SEMANACOBRANCA        = vSEMANACOBRANCA               
                	, IDREGIAOVENDA         = vIDREGIAOVENDA 	     	   
                	, VALORTOTALNOTA        = vVALORTOTALNOTA 	       	     
                	, VALORTOTALDEVOLUCAO   = vVALORTOTALDEVOLUCAO     
                	, VALORTOTALVENDA       = vVALORTOTALVENDA             
                	, BASECOMISSAO          = vBASECOMISSAO 	     	    
                	, PERCCOMISSAO          = vPERCCOMISSAO 	     	     
                	, VALORCOMISSAO         = vVALORCOMISSAO	     	     
                	, VALORPAGO             = vVALORPAGO 	         	         
                	, SALDO                 = vSALDO 	             	             
                	, VALORTOTALVENDALQD    = vVALORTOTALVENDALQD       
                	, NUMERONOTA            = vNUMERONOTA 	           	         
                	, IDSITUACAONOTAVENDA   = vIDSITUACAONOTAVENDA     
                	, EDICAOBLOQUEADA       = vEDICAOBLOQUEADA             
                	, QUITADAPEPINO         = vQUITADAPEPINO                 
                	, ENVIADOCOBRANCA       = vENVIADOCOBRANCA             
                	, PERCCOMISSAOCORRETA   = vPERCCOMISSAOCORRETA     
                	, IDREPRESENTANTEATENDE = vIDREPRESENTANTEATENDE 
                	, PERCPONTOS            = vPERCPONTOS                       
                	, DATAACERTO            = vDATAACERTO                       
                	, RECUPERARPROMISSORIA  = vRECUPERARPROMISSORIA   
                	, PROMISSORIARECUPERADA = vPROMISSORIARECUPERADA 
                	, IDSEMANACOBRANCA      = vIDSEMANACOBRANCA           
                	, ULTIMAALTERACAO       = vULTIMAALTERACAO             
                  where idnotavenda = :P273_IDNOTAVENDA;
                   --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Nota atualizada!
        }
        advanced {
            executionMappingIdentifier: 53886230933932929
        }
        serverSideCondition {
            whenButtonPressed: @confirma
        }
    )

)

