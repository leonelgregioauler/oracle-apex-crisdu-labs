    process new-save-interactive-grid-data (
        name: New - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @new
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 100959321319699617
        }
    )

    branch (
        name: Go To Page 492
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 492
                items: {
                    P492_IDFILIAL: &P492_IDFILIAL.
                    P492_PESQUISA: &P492_PESQUISA.
                    P492_DATAINICIO: &P492_DATAINICIO.
                    P492_DATAFIM: &P492_DATAFIM.
                    P492_ANO: &P492_ANO.
                    P492_TIPO: &P492_TIPO.
                    P492_IDPAIS: &P492_IDPAIS.
                    P492_SITUACAO_ASSINATURA: &P492_SITUACAO_ASSINATURA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

