    region carteira-atrasada-rmc (
        name: Carteira Atrasada RMC
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(p.cpf,p.documentoestrangeiro) "CPF"
                     , p.rg "RG"
                     , initcap(p.nomepessoa) "Consultora"
                --     , nv.idvendedora
                     , p.enderecoprincipal "Endereço"
                     , p.numero "Numero"
                     , p.bairro "Bairro"
                     , p.cep "Cep"
                     , roman.pck_romance.fnc_nomecidade(p.idcidade) "Cidade"
                     , p.email
                     , ( select t.telefone
                         from telefonespessoas t
                         where t.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                      from telefonespessoas tt
                                                      where tt.idpessoa = p.idpessoa
                                                        and not REGEXP_LIKE(telefone, '(\d)\1\1\1\1\1') ) ) "Telefones"
                     , p.datanascimento "Data de Nascimento"
                     , decode(p.sexo,'M','Masculino','F','Feminino') "Sexo"
                     , roman.pck_romance.fnc_nomefilial(nv.idfilial) "Empresa"
                     , roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) "Distribuidor"
                     , nv.numeronota "Nr Pedido"
                     , trunc(nv.datanota) "Data do Nota"
                     , trunc(nv.dataretorno) "Data do Retorno"
                     , trunc(nvl(nv.dataretornoorig,(nv.datanota+42))) "Data do Retorno Orig."
                     , trunc(nv.dataacerto) "Data do Acerto"
                     , nvl(nv.valortotalnota*nv.fatorconversao,0) "Total Nota"
                     , nvl(nv.valortotaldevolucao*nv.fatorconversao,0) "Total Devolução"
                     , nvl(nv.valortotalvenda*nv.fatorconversao,0) "Total Venda"
                     , nvl(nv.valortotalvendalqd*nv.fatorconversao,0) "Total Venda Liquida"
                     , nvl(nv.valorcomissao*nv.fatorconversao,0) "Comissão Consultora"
                     , nvl(nv.valorpago*nv.fatorconversao,0) "Pago"
                     , nvl(nv.saldo*nv.fatorconversao,0) "Saldo"
                     , nvl(nv.enviadocobranca,'N') "Enviado Cobrança"
                     , nv.dataenviadocobranca "Data de envio p/ Cobrança"
                     , decode(v.spc, 'S', 'Sim','Não') "Enviado ao SPC"
                /*     , ( select decode(aa.situacao,'R','Reprovada','A','Aprovada')
                         from assinaturaseletronicas aa
                         where aa.idassinaturaeletronica = ( select max(a.idassinaturaeletronica)
                                                             from assinaturaseletronicas a 
                                                             where a.idnotavenda = nv.idnotavenda
                                                               and a.status = 'C' ) ) situacao_assinatura
                     , nvl( ( select 'Sim'
                              from dual
                              where exists ( select 1
                                             from negociacoesparceiros np
                                             where np.idvendedora = nv.idvendedora
                                               and np.origem      = 'B' ) ),'Não') acordo_vigente 
                     , ( select max(ob.data)
                         from observacoesnotasvendas ob
                         where ob.idnotavenda = nv.idnotavenda ) ultimo_acionamento*/
                from roman.notasvendas nv
                   , catal.pessoas p
                   , catal.vendedoras v
                where v.idvendedora = nv.idvendedora
                  and p.idpessoa = v.idpessoa
                  and nv.idsituacaonotavenda = 4
                  and nv.saldo > 0
                  and p.idpais       = :P492_IDPAIS
                  and ( :P492_PESQUISA is null
                    or ( :P492_PESQUISA = 'A' and extract (year from nv.datanota) = :P492_ANO )
                    or ( :P492_PESQUISA = 'P' and nv.datanota between to_date(:P492_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') 
                                                                  and to_date(:P492_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) )
                  and ( :P492_IDFILIAL is null or nv.idfilial = :P492_IDFILIAL)
                  and ( :P492_DATAINICIO is not null or :P492_IDFILIAL is not null or :P492_ANO is not null )
                  and ( :P492_SITUACAO_ASSINATURA = 'X' or exists ( select 1
                                                                    from assinaturaseletronicas a
                                                                    where a.idnotavenda = nv.idnotavenda
                                                                      and a.status = 'C'
                                                                      and a.situacao = :P492_SITUACAO_ASSINATURA ) )
                  and ( :P492_ENVIADOCOBR = 'A' or (:P492_ENVIADOCOBR = 'S' and exists ( select 1
                                                                                           from negociacoesparceiros np
                                                                                          where np.idvendedora = v.idvendedora
                                                                                            and np.origem      = 'B' ) ) 
                                                or (:P492_ENVIADOCOBR = 'N' and not exists ( select 1
                                                                                               from negociacoesparceiros np
                                                                                              where np.idvendedora = v.idvendedora
                                                                                                and np.origem      = 'B' ) )   )
                  and ( :P492_ENVIADOSPC = 'A' or nvl(v.spc,'N') = :P492_ENVIADOSPC )
                  and ( :P492_SEXO ='A'        or p.sexo = :P492_SEXO ) 
                --  and ( :P492_VALORINI IS NULL or nvl(nv.valortotalnota*nv.fatorconversao,0) between :P492_VALORINI
                --                                                                                 and :P492_VALORFIM)
                -- solicitado pelo Paulo Saraiva para pegar pelo saldo
                  and ( :P492_VALORINI IS NULL or nvl(nv.saldo*nv.fatorconversao,0) between :P492_VALORINI
                                                                                        and :P492_VALORFIM)
                  and ( :P492_SMSENVIADO = 'A' or (:P492_SMSENVIADO = 'S' and exists ( select 1
                                                                                           from predisparosms 
                                                                                          where idnotavenda = nv.idnotavenda) ) 
                                                or (:P492_SMSENVIADO = 'N' and not exists (  select 1
                                                                                           from predisparosms 
                                                                                          where idnotavenda = nv.idnotavenda ) )  )
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
