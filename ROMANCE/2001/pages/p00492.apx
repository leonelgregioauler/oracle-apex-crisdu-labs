            ```css
            .t-Region-body { background-color: Beige !important;} 
            .t-Dialog { background-color: Beige !important;} 
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region carteira-atrasada-fav (
        name: Carteira Atrasada FAV
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                ---- SE INCLUIR ALGUM FILTRO AQUI, INCLUIR TAMBEM NA PAGINA 493---------------
                select nvl(p.cpf,p.documentoestrangeiro) "CPF"
                     , p.rg "RG"
                     , initcap(p.nomepessoa) "Consultora"
                     , p.enderecoprincipal "Endereço"
                     , p.numero "Numero"
                     , p.bairro "Bairro"
                     , p.cep "Cep"
                     , roman.pck_romance.fnc_nomecidade(p.idcidade) "Cidade"
                     , p.email
                     , ( select t.telefone
                         from telefonespessoas t
                         where t.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                      from telefonespessoas tt
                                                      where tt.idpessoa = p.idpessoa
                                                        and not REGEXP_LIKE(telefone, '(\d)\1\1\1\1\1') ) ) "Telefones"
                     , p.datanascimento "Data de Nascimento"
                     , decode(p.sexo,'M','Masculino','F','Feminino') "Sexo"
                     , pp.filialromance "Empresa"
                     , pp.representante "Distribuidor"
                     , pp.numeropedido "Nr Pedido"
                     , pp.dataemissao "Data de Emissão"
                     , pp.dataentrega "Data de Entrega"
                     , pp.datavencimentomenor "Vencimento"
                     , nvl(pp.valortotal*pp.fatorconversao,0) "Total Pedido"
                     , nvl(pp.valordesconto*pp.fatorconversao,0) "Valor Desconto"
                     , nvl(pp.valorapagar*pp.fatorconversao,0) "Valor a Pagar"
                     , nvl(pp.valorpago*pp.fatorconversao,0) "Pago"
                     , nvl(pp.saldodevedor*pp.fatorconversao,0) "Saldo"
                     , decode(v.spc, 'S', 'Sim','Não') "Enviado ao SPC"
                    /* , ( select max(m.datainclusao)
                         from mensagenssms m
                         where m.idpessoa = p.idpessoa
                           and m.idprocessosistema = 40 ) ultimo_acionamento */
                from favorita.vw_pedidos_fav pp
                   , catal.vendedoras v
                   , catal.pessoas p
                where pp.idvendedora = v.idvendedora
                  and v.idpessoa     = p.idpessoa
                  and pp.datacancelamento is null
                  and pp.saldodevedor > 0
                  --and pp.idvendedora =  2303662
                  and p.idpais       = :P492_IDPAIS
                  and ( :P492_PESQUISA is null
                    or ( :P492_PESQUISA = 'A' and extract (year from pp.dataemissao) = :P492_ANO )
                    or ( :P492_PESQUISA = 'P' and pp.dataemissao between to_date(:P492_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') 
                                                                     and to_date(:P492_DATAFIM   ||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) )
                  and ( :P492_IDFILIAL is null or pp.idfilialromance = :P492_IDFILIAL)
                  and ( :P492_DATAINICIO is not null or :P492_IDFILIAL is not null or :P492_ANO is not null )
                  and ( :P492_ENVIADOCOBR = 'A' or pp.enviadocobranca = :P492_ENVIADOCOBR )
                  and ( :P492_ACORDOVIG   = 'A' or (:P492_ENVIADOCOBR = 'S' and exists ( select 1
                                                                                           from negociacoesparceiros np
                                                                                          where np.idvendedora = v.idvendedora
                                                                                            and np.origem      = 'B' ) ) 
                                                or (:P492_ENVIADOCOBR = 'N' and not exists ( select 1
                                                                                               from negociacoesparceiros np
                                                                                              where np.idvendedora = v.idvendedora
                                                                                                and np.origem      = 'B' ) )   )
                  and ( :P492_ENVIADOSPC = 'A' or nvl(v.spc,'N') = :P492_ENVIADOSPC )
                  and ( :P492_SEXO = 'A' OR p.sexo = :P492_SEXO ) 
                --  and ( :P492_VALORINI IS NULL or nvl(pp.valorapagar*pp.fatorconversao,0) between :P492_VALORINI
                --                                                                              and :P492_VALORFIM)
                -- Solicitado pelo Paulo Saravia para busca o valor do saldo
                  and ( :P492_VALORINI IS NULL or nvl(pp.saldodevedor*pp.fatorconversao,0) between :P492_VALORINI
                                                                                               and :P492_VALORFIM)
                  and ( :P492_SMSENVIADO = 'A' or (:P492_SMSENVIADO = 'S' and exists ( select 1
                                                                                           from predisparosms 
                                                                                          where idpedido = pp.idpedido) ) 
                                                or (:P492_SMSENVIADO = 'N' and not exists (  select 1
                                                                                           from predisparosms 
                                                                                          where idpedido = pp.idpedido ) )  )
                    
                  
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P492_TIPO
            value: F
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma informação encontrada!
        }
        advanced {
            savedReportMappingIdentifier: 217148574902788976
        }

