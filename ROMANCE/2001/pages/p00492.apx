    dynamicAction ano (
        name: Ano
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P492_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P492_PESQUISA
            value: A
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P492_ANO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P492_ANO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction confirma-fav (
        name: Confirma_FAV
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @gerarpresms
        }
        serverSideCondition {
            type: item=value
            item: P492_TIPO
            value: F
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma executar pré-disparo de SMS?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var pcanal = $v("P492_CANAL");
                    var pmens  = $v("P492_MENSAGEM");
                    var pdata  = $v("P492_DATADISPARO");
                    var pmens2 = pmens.replace(/,/gi, "@");
                    
                    var purl = "f?p=&APP_ID.:493:&APP_SESSION.:::RP:P493_TIPO,P493_CANAL,P493_MENSAGEM,P493_DATADISPARO"+":R,"+pcanal+","+pmens2+","+pdata+":";
                    
                    apex.navigation.redirect (purl);
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P492_MENSAGEM
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

