    button openmodalf (
        buttonName: openModalF
        label: PRÉ-DISPARO
        layout {
            sequence: 10
            region: @carteira-atrasada-fav
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:openModal('PRESMS');
            warnOnUnsavedChanges: doNotCheck
        }
    )

