    pageItem P492_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and f.idgrupo is not null
                  and f.ididioma = :P492_IDPAIS
                ```
            nullDisplayValue: "- Todas - "
        }
        cascadingLov {
            parentItems: P492_IDPAIS
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

