page 316 (
    name: Expediente de Funcionários
    title: Expediente de Funcionários
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region expediente-de-funcionários (
        name: Expediente de Funcionários
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDEXPEDIENTEFUNCIONARIO,
                       IDFUNCIONARIO,
                       HORAINICIO,
                       HORAFIM,
                       DIA
                from EXPEDIENTEFUNCIONARIOS E
                where exists ( select 1
                               from funcionarios f
                               where f.idfuncionario = e.idfuncionario
                                 and f.idgerente = ( select idgerente
                                                     from usuarios u
                                                     where u.usuario = v('APP_USER') ) )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: "<font color=\"red\" size=\"6\"> É muito importante manter o padrão na forma de colocar o horário, ex.: 12:00:00! Faça o cadastro dos DOIS TURNOS do colaborador(a).  </font>  "
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 6711106078871999
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDEXPEDIENTEFUNCIONARIO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDFUNCIONARIO
                layout {
                    width: 755
                    sequence: 3
                }
            )

            displayColumn (
                column: @HORAINICIO
                layout {
                    width: 207
                    sequence: 4
                }
            )

            displayColumn (
                column: @HORAFIM
                layout {
                    width: 266
                    sequence: 5
                }
            )

            displayColumn (
                column: @DIA
                layout {
                    width: 351.5
                    sequence: 6
                }
            )

            sort (
                column: @IDFUNCIONARIO
                sort {
                    direction: desc
                    nulls: first
                    sequence: 1
                }
            )

            sort (
                column: @HORAINICIO
                sort {
                    nulls: first
                    sequence: 3
                }
            )

            sort (
                column: @DIA
                sort {
                    nulls: first
                    sequence: 2
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DIA (
            type: selectList
            heading {
                heading: Dia da Semana
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select display_value
                         , return_value 
                    from( select 'SEGUNDA-FEIRA' display_value
                         , 'SEGUNDA-FEIRA' return_value
                    from dual
                    union
                    select 'TERÇA-FEIRA' 
                         , 'TERÇA-FEIRA' display_value
                    from dual
                    union
                    select 'QUARTA-FEIRA' 
                         , 'QUARTA-FEIRA' 
                    from dual
                    union
                    select 'QUINTA-FEIRA' 
                         , 'QUINTA-FEIRA' 
                    from dual
                    union
                    select 'SEXTA-FEIRA' 
                         , 'SEXTA-FEIRA'
                    from dual
                    union
                    select 'SABADO' 
                         , 'SABADO'
                    from dual)
                    ```
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: DIA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column HORAFIM (
            type: textField
            heading {
                heading: Hora Final
            }
            layout {
                sequence: 60
            }
            appearance {
                width: 20
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: HORAFIM
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column HORAINICIO (
            type: textField
            heading {
                heading: Hora Início
            }
            layout {
                sequence: 50
            }
            appearance {
                width: 20
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: HORAINICIO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDEXPEDIENTEFUNCIONARIO (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDEXPEDIENTEFUNCIONARIO
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDFUNCIONARIO (
            type: selectList
            heading {
                heading: Funcionário
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select distinct pck_romance.fnc_nomepessoa(uu.idpessoa) display_value
                        , f.idfuncionario return_value
                    from usuarios uu
                     , funcionarios f
                    where f.idpessoa = uu.idpessoa
                      and uu.ativo = 'S'  
                      and uu.idgerente = ( select idgerente
                                           from usuarios u
                                           where u.usuario = v('APP_USER') )   
                    order by 1  
                    ```
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDFUNCIONARIO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @expediente-de-funcionários
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3475971892126006
        }
    )

)

