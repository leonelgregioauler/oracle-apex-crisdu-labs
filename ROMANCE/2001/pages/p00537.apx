page 537 (
    name: Informações do Pedido
    title: Informações do Pedido
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function imprimeboleto()
            {   
              vidpedido = document.getElementById('P537_IDPEDIDO').value;
              vidvendedora = document.getElementById('P537_IDVENDEDORA').value;
              /*vurl = 'https://boleto.romancemoda.com.br/boleto_bb_favorita_novo.php?cod1='+vidpedido+'&cod2='+vidvendedora;*/
              vurl = document.getElementById('P0_URLBOLETOBASE').value+'?cod1='+vidpedido+'&cod2='+vidvendedora;
              pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            
            function imprimirpedido()
            {
              pidpedido = document.getElementById('P537_IDPEDIDO').value;
              pjanela = window.open('f?p=&APP_ID.:324:&SESSION.::NO:324:P324_IDPEDIDO:'+pidpedido,'Pedido','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=1200,height=800,screenX=50,screenY =100','_blank');
              pjanela.focus();
            }
            ```
    }
