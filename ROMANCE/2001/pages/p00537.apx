    process carrega-informações-pedidos (
        name: Carrega Informações Pedidos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidvendedora number;
                  vidpedido    number := :P537_IDPEDIDO;
                  vvalorapagar number := 0;
                  vvalorpago   number := 0;
                  vvalorsaldo  number := 0;
                  --
                begin
                  --
                  begin
                    --
                    select sum(v.valorpagar)
                         , sum(v.valorpago)
                    into vvalorapagar
                       , vvalorpago
                    from favorita.vencimentospedidos v
                    where v.idpedido = vidpedido
                      and v.situacaovencimento = 'V';
                    --
                  exception
                    when others then
                      --
                      vvalorapagar := 0;
                      vvalorpago   := 0;
                      vvalorsaldo  := 0;
                      vidvendedora := null;
                      --
                  end;
                  --
                  select idvendedora
                  into vidvendedora
                  from favorita.pedidos p
                  where p.idpedido = vidpedido;
                  --
                  if vvalorapagar > 0 then
                    --
                    vvalorsaldo := vvalorapagar - vvalorpago;
                    --
                  end if;
                  --
                  :P537_VALORAPAGAR := vvalorapagar;
                  :P537_VALORPAGO   := vvalorpago;
                  :P537_VALORSALDO  := vvalorsaldo;
                  :P537_IDVENDEDORA := vidvendedora;
                  --
                exception
                  when others then
                    :P537_VALORAPAGAR := 0;
                    :P537_VALORPAGO   := 0;
                    :P537_VALORSALDO  := 0;
                    :P537_IDVENDEDORA := null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 6377829280042309
        }
    )

)

