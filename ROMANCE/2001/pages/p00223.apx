page 223 (
    name: Pagamentos Manutenções
    title: Pagamentos Manutenções
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region pagamentos (
        name: Pagamentos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idpgtomanutencao
                     , t.datapagamento
                     , t.valorpago
                from pagamentosmanutencoes t
                where t.idmanutencao = :P223_IDMANUTENCAO
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        messages {
            whenNoDataFound: -
        }
        componentAdvanced {
            stripHtml: true
        }

        column DATAPAGAMENTO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Data Pagamento
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
        )

        column IDPGTOMANUTENCAO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column VALORPAGO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Valor
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

    )

    region pagamentos-manutenções (
        name: Pagamentos Manutenções
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P223_DATAPAGAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @pagamentos-manutenções
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATAPAGAMENTO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P223_IDFECHAMENTOREPRES (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @pagamentos-manutenções
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTOREPRES
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P223_IDMANUTENCAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @pagamentos-manutenções
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDMANUTENCAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P223_IDPGTOMANUTENCAO (
        type: hidden
        layout {
            sequence: 10
            region: @pagamentos-manutenções
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPGTOMANUTENCAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P223_VALORPAGO (
        type: numberField
        label {
            label: Valor Pago
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @pagamentos-manutenções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G990D00
            width: 10
        }
        validation {
            maxLength: 10
        }
        source {
            type: databaseColumn
            databaseColumn: VALORPAGO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar e Atualizar Acerto
        layout {
            sequence: 20
            region: @pagamentos-manutenções
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 75
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Salvar Pagamento
        layout {
            sequence: 10
            region: @pagamentos-manutenções
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P223_IDPGTOMANUTENCAO
        }
    )

    validation p223-valorpago (
        name: P223_VALORPAGO
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from manutencoesrealizadas m
                where idmanutencao = :P223_IDMANUTENCAO
                  and ( valorservico - ( select sum(p.valorpago)
                                         from pagamentosmanutencoes p
                                         where p.idmanutencao = m.idmanutencao ))< to_number(:P223_VALORPAGO,'999G999G990D00')
                ```
        }
        error {
            errorMessage: O valor pago não pode ser maior que o valor pendente.
            associatedItem: @P223_VALORPAGO
        }
    )

    process fetch-row-from-pagamentosmanutencoes (
        name: Fetch Row from PAGAMENTOSMANUTENCOES
        type: autoRowFetch
        source {
            tableName: PAGAMENTOSMANUTENCOES
            pkColumn: IDPGTOMANUTENCAO
            pkItem: P223_IDPGTOMANUTENCAO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 496035067887316803
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P223_IDPGTOMANUTENCAO is null then
                        select "SEQ_IDPGTOMANUTENCAO".nextval
                          into :P223_IDPGTOMANUTENCAO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 496035260574316807
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-pagamentosmanutencoes (
        name: Process Row of PAGAMENTOSMANUTENCOES
        type: autoRowProcessing
        target {
            tableName: PAGAMENTOSMANUTENCOES
            pkColumn: IDPGTOMANUTENCAO
            pkItem: P223_IDPGTOMANUTENCAO
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 496035468890316811
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 223
                items: {
                    P223_IDMANUTENCAO: &P223_IDMANUTENCAO.
                    P223_IDFECHAMENTOREPRES: &P223_IDFECHAMENTOREPRES.
                    P223_IDPGTOMANUTENCAO:
                }
            }
        }
    )

)

