    pageItem P129_SEMANAANTERIOR (
        type: textField
        label {
            label: Semana Anterior
            alignment: left
        }
        layout {
            sequence: 120
            region: @remarcar-nota
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vsemana varchar(15);
                begin 
                  --
                  select semana
                  into vsemana
                  from fechamentossemanais f
                  where f.idfechamento = ( select min(idfechamento) 
                                           from fechamentossemanais ff
                                           where ff.idfilial = :P0_IDFILIAL
                                             and ff.concluido = 'N');
                
                  --
                  return vsemana;
                  --
                end;
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

