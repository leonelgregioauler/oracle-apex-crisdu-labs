    validation valida-remarcar-para-determinada-semana (
        name: Valida Remarcar para Determinada Semana
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from notasvendas nv
                where nv.idnotavenda = :P129_IDNOTAVENDA
                  and nv.semanadistribuicao = :P129_SEMANACOBRANCA
                ```
        }
        error {
            errorMessage: "Não é possível antecipar uma nota que foi distribuída na semana atual do distribuidor! "
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P129_TIPOALTERACAO = 'S' and v('REQUEST') = 'SAVE'
        }
    )

    validation valida-remarcar-para-semana-atual (
        name: Valida Remarcar para Semana Atual
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from notasvendas nv
                where nv.idnotavenda = :P129_IDNOTAVENDA
                  and nv.idsemanadistribuicao = ( select i.idsemana
                                                  from imptablettoservidor i
                                                  where i.idrepresentante = nv.idrepresentante
                                                    and i.idimp = ( select max(idimp)
                                                                    from imptablettoservidor ii
                                                                    where ii.idrepresentante = nv.idrepresentante
                                                                      and ii.processo        = 'L' ) )
                ```
        }
        error {
            errorMessage: "Não é possível antecipar uma nota que foi distribuída na semana atual do distribuidor! "
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P129_TIPOALTERACAO = 'C' and v('REQUEST') = 'SAVE'
        }
    )

    process atualiza-nota (
        name: atualiza nota
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcaracteristica number := 8;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number;
                  vidsemana number;
                  vobservacao varchar2(1000);
                begin
                  --
                  if :P129_TIPOALTERACAO = 'S' then
                    --
                    update notasvendas
                    set semanacobranca = :P129_SEMANACOBRANCA
                      , dataretorno = (select dt_ini
                                       from semana_dias
                                       where idsemana = pck_util.fnc_idsemana(:P129_SEMANACOBRANCA))
                    where idnotavenda = :P129_IDNOTAVENDA;
                    -- 
                    vidsemana := pck_util.fnc_idsemana(:P129_SEMANACOBRANCA);
                    --
                  elsif :P129_TIPOALTERACAO = 'C' then
                    --
                    update notasvendas
                    set semanacobranca = :P129_SEMANACOBATUAL
                      , dataretorno = (select dt_ini
                                       from semana_dias
                                       where idsemana = pck_util.fnc_idsemana(:P129_SEMANACOBRANCA))
                    where idnotavenda = :P129_IDNOTAVENDA;
                    --
                    vidsemana := pck_util.fnc_idsemana(:P129_SEMANACOBATUAL);
                    --
                  elsif :P129_TIPOALTERACAO = 'F' then  
                    --
                    update notasvendas
                    set semanacobranca = :P129_SEMANAFECHAMENTOATUAL
                      , dataretorno = (select dt_ini
                                       from semana_dias
                                       where idsemana = pck_util.fnc_idsemana(:P129_SEMANAFECHAMENTOATUAL))
                    where idnotavenda = :P129_IDNOTAVENDA;
                    --
                    vidsemana := pck_util.fnc_idsemana(:P129_SEMANAFECHAMENTOATUAL);
                    --
                  elsif :P129_TIPOALTERACAO = 'X' then
                    --
                    update notasvendas
                    set semanacobranca = :P129_SEMANAANTERIOR
                      , dataretorno = (select dt_ini
                                       from semana_dias
                                       where idsemana = pck_util.fnc_idsemana(:P129_SEMANAANTERIOR))
                    where idnotavenda = :P129_IDNOTAVENDA;
                    --
                    vidsemana := pck_util.fnc_idsemana(:P129_SEMANAANTERIOR);
                    --
                  else
                    --
                    update notasvendas
                    set semanacobranca = :P129_SEMANACOBREPATENDE
                      , dataretorno = (select dt_ini
                                       from semana_dias
                                       where idsemana = pck_util.fnc_idsemana(:P129_SEMANACOBRANCA))
                    where idnotavenda = :P129_IDNOTAVENDA;
                    --
                    vidsemana := pck_util.fnc_idsemana(:P129_SEMANACOBREPATENDE);
                    --
                  end if;
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P37_IDNOTAVENDA,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidsemana,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Remarcada com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 31316682215811708
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process busca-semana (
        name: busca semana
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  select trim(to_char(semana, '00')||'/'||to_char(ano))
                  into :P129_SEMANACOBRANCA
                  from semana_dias
                  where to_date(:P129_DATARETORNO,'dd/mm/rrrr') between dt_ini and dt_fim;
                  --
                  :P129_QUITADAPEPINO := 'R'; --REMARCADA
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 394574958756454660
        }
        serverSideCondition {
            type: never
        }
    )

    process fetch-row-from-notasvendas (
        name: Fetch Row from NOTASVENDAS
