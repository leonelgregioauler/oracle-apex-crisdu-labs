    pageItem P129_SEMANACOBATUAL (
        type: textField
        label {
            label: Semana Atual Cliente R.
            alignment: left
        }
        layout {
            sequence: 90
            region: @remarcar-nota
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 10
        }
        advanced {
            customAttributes: readonly
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vsemana varchar(15);
                begin 
                --
                  select pck_util.fnc_semanaid(min(pck_util.fnc_idsemana(r.semana)))
                  into vsemana
                  from regioesrepresentantes r
                  where idrepresentante = (select idrepresentante
                                           from notasvendas
                                           where idnotavenda = :P129_IDNOTAVENDA);
                
                  --
                  return vsemana;
                  --
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P129_SEMANACOBRANCA (
        type: selectList
        label {
            label: Semana de Cobrança
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.semana|| ' - ' ||to_char(s.dt_ini,'dd/mm')||' até '||to_char(s.dt_fim,'dd/mm') display_value
                  , r.semana return_value
                from regioesrepresentantes r
                  , semana_dias s
                where r.idrepresentante = (select idrepresentante
                                           from notasvendas
                                           where idnotavenda = :P129_IDNOTAVENDA)
                  and s.idsemana = pck_util.fnc_idsemana(r.semana)
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @remarcar-nota
            slot: regionBody
            alignment: left
        }
        appearance {
