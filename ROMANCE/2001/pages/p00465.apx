    pageItem P465_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' - '||decode(ativo,'S','Ativo','N','Inativo') d
                     , r.idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: - Selecione o Distribuidor -
        }
        layout {
            sequence: 20
            region: @20-top-cobranças
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P465_IDSEMANACOBRANCA_FIM (
        type: selectList
        label {
            label: <b>Semana Cob. Fim:</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.semanacompleta
                     , f.idsemana
                  from roman.semana_dias f
                 where f.idsemana > 951
                ```
        }
        layout {
            sequence: 20
            region: @ranking-de-cobranças-da-semana
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select max(f.idsemana)
                  from roman.semana_dias f
                 where f.ano = to_char(sysdate,'yyyy')
                ```
        }
        security {
            encryptSessionState: false
        }
    )

