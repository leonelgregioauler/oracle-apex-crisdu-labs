    region ranking-de-cobranças-da-semana (
        name: Ranking de Cobranças da Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rank() over (order by dados.total desc) posicao
                     , dados.distribuidor
                     , dados.regiao
                     , dados.total
                  from (select roman.pck_romance.fnc_nomerepresentante(fr.idrepresentante) as distribuidor
                             , roman.pck_romance.fnc_nomeregiaovenda(fr.idregiaovenda)  as regiao
                             , sum( fr.totalgeral )                                     as total
                          from roman.fechamentorepresentantes fr
                             , roman.fechamentossemanais f
                             , catal.filiais fi
                         where f.idfechamento = fr.idfechamento
                           and fi.idfilial = f.idfilial
                           and f.idsemana     between :P465_IDSEMANACOBRANCA_INICIO and :P465_IDSEMANACOBRANCA_FIM
                           and (    (:P0_IDFILIAL = -3 and fi.ididioma > 1) -- Fora do brasil
                                 or (:P0_IDFILIAL = -2 and fi.ididioma = 1) -- Brasil
                                 or (:P0_IDFILIAL = -1 )                    -- Todas
                                 or (:P0_IDFILIAL = fi.idfilial))           -- Somente uma filial
                         group by roman.pck_romance.fnc_nomerepresentante(idrepresentante)
                                , roman.pck_romance.fnc_nomeregiaovenda(fr.idregiaovenda)) dados
                ```
            pageItemsToSubmit: P465_IDSEMANACOBRANCA_INICIO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
