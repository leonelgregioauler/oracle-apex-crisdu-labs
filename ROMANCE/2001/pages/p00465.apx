    dynamicAction escolhe-distribuidor (
        name: Escolhe distribuidor
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P465_IDREPRESENTANTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @20-top-cobranças
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction recarrega-relatorio (
        name: Recarrega Relatorio
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P465_TIPO_PESQUISA
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @20-top-cobranças
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction tipo-pesquisa-distribuidor (
        name: Tipo Pesquisa Distribuidor
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P465_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P465_TIPO_PESQUISA
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P465_IDREPRESENTANTE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P465_IDREPRESENTANTE
            }
            execution {
                sequence: 10
            }
        )

    )

    validation validações (
        name: Validações
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                
                    -- Valida semana início não informada
                    if :P465_IDSEMANACOBRANCA_INICIO is null then
                        return 'Ateção! Semana início deve ser selecionada.';
                    end if;
                
                    -- Valida semana fim não informada
                    if :P465_IDSEMANACOBRANCA_FIM is null then
                        return 'Ateção! Semana fim deve ser selecionada.';
                    end if;
                
                    -- Valida semana inicial deve ser menor ou igual a semana final 
                    if :P465_IDSEMANACOBRANCA_INICIO > :P465_IDSEMANACOBRANCA_FIM then
                        return 'Ateção! Semana início não pode ser maior que a semana fim';
                    end if;
                
                    return null;
                    
                end;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

