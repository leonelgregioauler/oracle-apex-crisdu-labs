    region 20-top-cobranças (
        name: 20 TOP Cobranças
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.posicao
                     , t.distribuidor
                     , t.regiao
                     , t.semana
                     , t.total
                from ( select rownum posicao
                            , t.*
                       from ( select pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                                   , fr.totalgeral total
                                   , pck_romance.fnc_nomeregiaovenda(fr.idregiaovenda) regiao
                                   , f.semana 
                              from fechamentorepresentantes fr
                                 , fechamentossemanais f
                              where f.idfechamento = fr.idfechamento
                                and f.idfilial     = :P0_IDFILIAL
                                and fr.totalgeral  > 0
                                and ( :P465_TIPO_PESQUISA = 'G' or fr.idrepresentante = :P465_IDREPRESENTANTE )
                              order by 2 desc ) t ) t
                where rownum <= 20
                order by 1
                ```
            pageItemsToSubmit: [
                P465_TIPO_PESQUISA
                P465_IDREPRESENTANTE
            ]
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3298303502980328125
        }

