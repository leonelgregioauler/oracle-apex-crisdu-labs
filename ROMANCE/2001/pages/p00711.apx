page 711 (
    name: Relatório de Configuracoes Estrelas Romance
    title: Relatório de Configuracoes Estrelas Romance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region configurações-estrelas-romance (
        name: Configurações Estrelas Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDCONFIGURACAOCATEGORIA, 
                       S.NOMECLUBE,
                       C.IDCLUBEDESUCESSO,
                       C.IDCATEGORIACLUBE,
                       T.NOMECATEGORIA,
                       C.PONTUACAOINICIAL,
                       C.PONTUACAOFINAL,
                       --
                       (select listagg(initcap(nvl(p.apelido, p.nomepessoa)),'; ') WITHIN GROUP (ORDER BY nomepessoa ASC) 
                               from pessoas p
                              where p.idpessoa in (select idpessoa 
                                                     from filiais f
                                                    where f.idfilial in ( select regexp_substr(C.FRANQUIAS, '[^:]+', 1, level) ID
                                                                            from dual
                                                                         connect by level <= regexp_count(C.FRANQUIAS, ':') + 1 ) ) ) franquias,
                       (select nome
                        from paises p
                        where p.idpais = c.idpais ) pais
                  from CONFIGURACOESCATEGORIAS C
                     , CLUBEDESUCESSO S
                     , CATEGORIASCLUBES T
                 where c.idclubedesucesso = s.idclubedesucesso
                   and c.idcategoriaclube = t.idcategoriaclube
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 712
                items: {
                    P712_IDCONFIGURACAOCATEGORIA: #IDCONFIGURACAOCATEGORIA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1505384148160187292
        }

        column FRANQUIAS (
            type: plainText
            heading {
                heading: Franquias
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDCATEGORIACLUBE (
            type: hidden
            heading {
                heading: Idcategoriaclube
            }
            layout {
                sequence: 3
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDCLUBEDESUCESSO (
            type: hidden
            heading {
                heading: Estrelas Romance
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDCONFIGURACAOCATEGORIA (
            type: hidden
            heading {
                heading: Idconfiguracaocategoria
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMECATEGORIA (
            type: plainText
            heading {
                heading: Nome Categoria Estrelas Romance
            }
            layout {
                sequence: 26
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column NOMECLUBE (
            type: plainText
            heading {
                heading: Nome Estrelas Romance
            }
            layout {
                sequence: 16
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column PAIS (
            type: plainText
            heading {
                heading: País
                alignment: center
            }
            layout {
                sequence: 36
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column PONTUACAOFINAL (
            type: plainText
            heading {
                heading: Pont. Final
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column PONTUACAOINICIAL (
            type: plainText
            heading {
                heading: Pont. Inicial
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 15054154 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FRANQUIAS (
                sequence: 5
            )

            displayColumn NOMECATEGORIA (
                sequence: 2
            )

            displayColumn NOMECLUBE (
                sequence: 1
            )

            displayColumn PAIS (
                sequence: 6
            )

            displayColumn PONTUACAOFINAL (
                sequence: 4
            )

            displayColumn PONTUACAOINICIAL (
                sequence: 3
            )

            sort (
                column: PONTUACAOINICIAL
                sort {
                    sequence: 1
                }
            )

            sort (
                column: NOMECATEGORIA
                sort {
                    sequence: 2
                }
            )

            filter ir-condition (
                type: rowSearch
                search: uruguay
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Registro
        layout {
            sequence: 30
            region: @configurações-estrelas-romance
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 712
                clearCache: 712
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

