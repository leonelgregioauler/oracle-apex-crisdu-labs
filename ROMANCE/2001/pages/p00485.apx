    process bipa-produto (
        name: Bipa Produto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vusuario varchar2(100) := v('APP_USER');
                  vcodigobarras varchar2(100) := :P485_CODIGO_BARRAS;
                  vcodigo       varchar2(10);
                  vexiste       number := 0;
                  --
                begin
                  -- T12217271 >
                  select trim(substr(vcodigobarras,4,12)) produto
                    into vcodigo
                    from dual;
                  --
                  begin
                    --
                    select 1
                      into vexiste
                      from produtos p
                     where p.codigosisdist = vcodigo
                       and exists( select 1
                                     from roman.itemnf i
                                    where i.idnotafiscal = :P485_IDNOTAFISCAL
                                      and i.idproduto = p.idproduto );
                    --
                    exception when no_data_found then
                      raise_application_error(-20001,'Atenção!!! Item não previsto na Nota. Verifique o codigo bipado.');
                    --
                  end;
                  -- T12217271 />
                  -- Call the procedure
                  pck_estoque.prc_leiturarecebimento(petiqueta => :P485_CODIGO_BARRAS,
                                                     pidnotafiscal => :P485_IDNOTAFISCAL,
                                                     pusuario => vusuario,
                                                     pretorno => :P485_RETORNO);
                  --
                  :P485_CODIGO_BARRAS := '';
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1545457793311204715
        }
        serverSideCondition {
            type: request=Value
            value: BIPA_PRODUTO
        }
    )

    process processar-leitura-etiqueta (
        name: PROCESSAR_LEITURA_ETIQUETA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  v_usuario  varchar2(100) := v('APP_USER');
                  v_etiqueta varchar2(100) := trim(apex_application.g_x01);
                begin
                  -- Chama a procedure de leitura de recebimento
                  pck_estoque.prc_leiturarecebimento(
                    petiqueta     => v_etiqueta,
                    pidnotafiscal => :P485_IDNOTAFISCAL,
                    pusuario      => v_usuario,
                    pretorno      => :P485_RETORNO
                  );
                  
                  -- Retorna o valor do retorno para o JavaScript
                  :P485_CODIGO_BARRAS := '';
                  apex_json.open_object;
                  apex_json.write('status',  'OK');
                  apex_json.write('retorno', :P485_RETORNO);
                  apex_json.close_object;
                
                exception
                  when others then
                    apex_json.open_object;
                    apex_json.write('status', 'ERRO');
                    apex_json.write('retorno', sqlerrm);
                    apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 30
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 1323158095558172304
        }
    )

