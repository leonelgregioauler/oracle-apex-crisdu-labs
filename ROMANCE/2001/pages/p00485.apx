        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1)
                from etiquetasbipadas e
                where e.idnotafiscal = :P485_IDNOTAFISCAL
                  and e.etiqueta not like '%( Registro Manual )%'
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vquantidade number;
                begin
                  --
                  select count(1)
                  into vquantidade
                  from etiquetasbipadas e
                  where e.idnotafiscal = :P485_IDNOTAFISCAL
                    and e.etiqueta not like '%( Registro Manual )%';
                  --
                  return vquantidade;
                  --
                exception
                  when others then
                    return 0;
                end;
                ```
