    region etiquetas-bipadas (
        name: Etiquetas Bipadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.data
                     , e.etiqueta
                     , e.codigo
                     , e.tamanho
                     , e.quantidade
                     , '<a href=javascript:fnc_remover('||e.idetiquetabipada||');><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt=""></a>' remover
                from etiquetasbipadas e
                where e.idnotafiscal = :P485_IDNOTAFISCAL
                order by data desc
                ```
        }
        layout {
            sequence: 30
            slot: wizardBody
        }
        appearance {
