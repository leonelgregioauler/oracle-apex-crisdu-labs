    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_remover(pid)
            {
              document.getElementById("P485_IDREMOVER").value = pid;
                
              var answer = confirm("Confirma a exclusão da etiqueta bipada?");
              if (answer)
              {
                apex.submit('REMOVER');
              }
            }
            ```
    }
