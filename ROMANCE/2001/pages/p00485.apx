    dynamicAction da-processar-leitura-codigo-barras (
        name: DA_PROCESSAR_LEITURA_CODIGO_BARRAS
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P485_CODIGO_BARRAS
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P485_CODIGO_BARRAS
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // Obtém o valor do código de barras
                    var vCodigoBarras = apex.item('P485_CODIGO_BARRAS').getValue();
                    
                    // Valida se não está vazio
                    if (!vCodigoBarras || vCodigoBarras.trim() === '') {
                        return;
                    }
                    
                    // Exibe indicador de loading
                    apex.util.showSpinner($('#P485_CODIGO_BARRAS'));
                    
                    // Chama o AJAX Callback
                    apex.server.process('PROCESSAR_LEITURA_ETIQUETA', {
                        x01: vCodigoBarras,
                        pageItems: '#P485_IDNOTAFISCAL'
                    }, {
                        dataType: 'json',
                        success: function(pData) {
                            // Remove o spinner
                            apex.util.hideSpinner($('#P485_CODIGO_BARRAS'));
                            
                            // Limpa o campo de código de barras
                            apex.item('P485_CODIGO_BARRAS').setValue('');
                            
                            if (pData.status === 'OK') {
                                // Atualiza o item de retorno na tela
                                apex.item('P485_RETORNO').setValue(pData.retorno);
                                
                                // Exibe mensagem de sucesso (opcional)
                                if (pData.retorno) {
                                    apex.message.showPageSuccess(pData.retorno);
                                }
                                
                                // ¿ Refresh na região da modal
                                // Substitua 'NOME_DA_SUA_REGIAO' pelo Static ID da região
                                apex.region('NOME_DA_SUA_REGIAO').refresh();
                                
                            } else {
                                // Exibe mensagem de erro
                                apex.message.showErrors([{
                                    type:       'error',
                                    location:   'page',
                                    message:    pData.retorno || 'Erro ao processar etiqueta.',
                                    unsafe:     false
                                }]);
                            }
                            
                            // Retorna o foco para o campo de leitura (pronto para próxima bipagem)
                            apex.item('P485_CODIGO_BARRAS').setFocus();
                        },
                        error: function(jqXHR, textStatus, errorThrown) {
                            apex.util.hideSpinner($('#P485_CODIGO_BARRAS'));
                            apex.item('P485_CODIGO_BARRAS').setValue('');
                            
                            apex.message.showErrors([{
                                type:     'error',
                                location: 'page',
                                message:  'Erro de comunicação: ' + errorThrown,
                                unsafe:   false
                            }]);
                            
                            apex.item('P485_CODIGO_BARRAS').setFocus();
                        }
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-focus (
        name: Set Focus
        execution {
            sequence: 20
        }
