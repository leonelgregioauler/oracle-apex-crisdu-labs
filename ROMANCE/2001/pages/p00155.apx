page 155 (
    name: Entrada de Estoque Reemb PA
    title: Entrada de Estoque Reemb PA
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            
            function  confirmaproduto(event)
            { 
              var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            
              if (tecla==13)
                {
            		apex.submit('CREATE');
                }
            }
            
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region entrada-de-estoque (
        name: Entrada de Estoque
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

