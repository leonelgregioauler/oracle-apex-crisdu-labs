    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 20
            region: @entrada-de-estoque
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 155
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button create (
        buttonName: CREATE
        label: Movimentar
        layout {
            sequence: 10
            region: @entrada-de-estoque
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P155_IDMOVTOESTOQUEPAREEMB
        }
    )

    dynamicAction foco (
        name: Foco
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P155_CODIGO
            }
            execution {
                sequence: 10
            }
        )

    )

    validation quantidade-movimentada (
        name: Quantidade Movimentada >= 50
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where  nvl(to_number(:P155_QTD_PP),0)
                     + nvl(to_number(:P155_QTD_P),0)
                     + nvl(to_number(:P155_QTD_M),0) 
                     + nvl(to_number(:P155_QTD_G),0) 
                     + nvl(to_number(:P155_QTD_GG),0) 
                     + nvl(to_number(:P155_QTD_EGG),0) 
                     + nvl(to_number(:P155_QTD_EXGG),0) 
                     + nvl(to_number(:P155_QTD_U),0) >= 50
                ```
        }
        error {
            errorMessage: Quantidade não permitida para movimentar o estoque! Registre um evento explicando o motivo dessa quantidade e solicitando liberação!
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

    process fetch-row-from-movtosestoquepareemb (
        name: Fetch Row from MOVTOSESTOQUEPAREEMB
        type: autoRowFetch
        source {
            tableName: MOVTOSESTOQUEPAREEMB
            pkColumn: IDMOVTOESTOQUEPAREEMB
            pkItem: P155_IDMOVTOESTOQUEPAREEMB
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 32529586565612967
        }
        serverSideCondition {
            type: never
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P155_IDMOVTOESTOQUEPAREEMB is null then
                        select seq_idmovtoestpareemb.nextval 
                          into :P155_IDMOVTOESTOQUEPAREEMB
                          from dual;
                    end if;
                    --    
                    :P155_OBSERVACAO:= 'Entrada manual. '||:P155_OBSERVACAO;
                    --
                    begin
                        select e.idestpostoavancado
                        into :P155_IDESTOQUEPOSTOAVANCADO
                        from estoquepostoavancado e
                        where e.idpostoavancado  = :P155_IDPOSTOAVANCADO
                          and idestoquefil       = :P155_IDESTOQUEFIL;
                    exception
                      when others then
                         SELECT seq_idestoquepostoavan.nextval
                         INTO :P155_IDESTOQUEPOSTOAVANCADO
                         from dual;
                         --
                         insert into estoquepostoavancado ( idestpostoavancado    , idpostoavancado    , idestoquefil
                                                          , qtd_pp             , qtd_p
                                                          , qtd_m                 , qtd_g              , qtd_gg
                                                          , qtd_egg               , qtd_u )
                         values ( :P155_IDESTOQUEPOSTOAVANCADO     , :P155_IDPOSTOAVANCADO     , :P155_IDESTOQUEFIL
                                , 0                                , 0             
                                , 0                         , 0               , 0
                                , 0                       , 0 );
                         insert into estoquepostoavancadoreemb ( idestoquepareemb    , idpostoavancado    , idestoquefil
                                                          , qtd_pp             , qtd_p
                                                          , qtd_m                 , qtd_g              , qtd_gg
                                                          , qtd_egg               , qtd_u )
                         values ( :P155_IDESTOQUEPOSTOAVANCADO     , :P155_IDPOSTOAVANCADO     , :P155_IDESTOQUEFIL
                                , 0                                , 0             
                                , 0                         , 0               , 0
                                , 0                       , 0 );
                    END;
                
                    --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 32530456345612968
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-movtosestoquepareemb (
        name: Process Row of MOVTOSESTOQUEPAREEMB
        type: autoRowProcessing
        target {
            tableName: MOVTOSESTOQUEPAREEMB
            pkColumn: IDMOVTOESTOQUEPAREEMB
            pkItem: P155_IDMOVTOESTOQUEPAREEMB
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 32530823825612969
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 32530029930612968
        }
    )

    branch (
        execution {
