page 743 (
    name: Cadastros Novos Por Distribuidor
    title: Cadastros Novos Por Distribuidor
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-cadastros-novos (
        name: Relatório Cadastros Novos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  roman.pck_romance.fnc_nomepessoa(v.idpessoa) 
                     , v.idvendedora
                     , roman.pck_romance.fnc_nomerepresentante(v.idrepresentante)
                     , roman.pck_romance.fnc_nomefilial(v.idfilial)
                     , v.datainclusao
                from catal.vendedoras v
                where v.idfilial = :P0_IDFILIAL
                  and ( :P743_DISTRIBUIDOR = 999999999 or v.idrepresentante = :P743_DISTRIBUIDOR )
                  and trunc(v.datainclusao) between :P743_DATAINI and :P743_DATAFIM
                  and :P743_FILTRAR = 'S'
                order by 3,1
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2436527187595841606
        }

        column DATAINCLUSAO (
            type: plainText
            heading {
                heading: Data Inclusão
                alignment: center
            }
            layout {
                sequence: 220
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: V
            }
        )

        column IDVENDEDORA (
            type: plainText
            heading {
                heading: ID Vendedora
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column "ROMAN.PCK_ROMANCE.FNC_NOMEFILIAL(V.IDFILIAL)" (
            type: plainText
            heading {
                heading: Franquia
                alignment: center
            }
            layout {
                sequence: 250
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AK
            }
        )

        column "ROMAN.PCK_ROMANCE.FNC_NOMEPESSOA(V.IDPESSOA)" (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 260
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AM
            }
        )

        column "ROMAN.PCK_ROMANCE.FNC_NOMEREPRESENTANTE(V.IDREPRESENTANTE)" (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 240
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AJ
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 24365492 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn DATAINCLUSAO (
                sequence: 5
            )

            displayColumn IDVENDEDORA (
                sequence: 1
            )

            displayColumn "ROMAN.PCK_ROMANCE.FNC_NOMEFILIAL(V.IDFILIAL)" (
                sequence: 3
            )

            displayColumn "ROMAN.PCK_ROMANCE.FNC_NOMEPESSOA(V.IDPESSOA)" (
                sequence: 2
            )

            displayColumn "ROMAN.PCK_ROMANCE.FNC_NOMEREPRESENTANTE(V.IDREPRESENTANTE)" (
                sequence: 4
            )

            aggregate (
                function: count
                column: IDVENDEDORA
            )

            controlBreak (
                column: ROMAN.PCK_ROMANCE.FNC_NOMEFILIAL(V.IDFILIAL)
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: ROMAN.PCK_ROMANCE.FNC_NOMEREPRESENTANTE(V.IDREPRESENTANTE)
                layout {
                    sequence: 2
                }
            )

        )

    )

    pageItem P743_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P743_DATAINI (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P743_DISTRIBUIDOR (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||decode(r.ativo,'S','Ativo','Inativo') display_value
                     , idrepresentante return_value
                from catal.representantes r
                where r.idgerente = ( select idgerente 
                                      from catal.gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                union all
                select ' - Todos - ' 
                     , 999999999
                from dual
                where ( exists ( select 1
                                 from usuarios u
                                 where u.usuario = v('APP_USER')
                                   and u.idgerente in (143,257, 239, 280) )
                         or pck_util.fnc_verificaacesso(4035,v('APP_USER')) = 'S' )
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P743_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
            point: processing
        }
        behavior {
            target: {
                page: 743
                items: {
                    P743_FILTRAR: S
                }
                action: resetPagination
            }
        }
    )

)

