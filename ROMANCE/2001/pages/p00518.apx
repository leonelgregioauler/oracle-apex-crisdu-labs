page 518 (
    name: Atualizar Produtos
    title: Atualizar Produtos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region atualização-de-produtos (
        name: Atualização de Produtos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P518_CODIGO_PRODUTO (
        type: textField
        label {
            label: Código
            alignment: left
        }
        layout {
            sequence: 10
            region: @atualização-de-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P518_NOME_PRODUTO (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomeproduto||' - '||codigosisdist||'   SKU: '||skuvirtualage d
                     , idproduto
                from produtos p
                where p.codigosisdist = :P518_CODIGO_PRODUTO
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P518_CODIGO_PRODUTO
        }
        layout {
            sequence: 20
            region: @atualização-de-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select p.nomeproduto||' - '||codigosisdist||'   SKU: '||skuvirtualage d
                from produtos p
                where p.codigosisdist = :P518_CODIGO_PRODUTO
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P518_SKUVIRTUALAGE (
        type: numberField
        label {
            label: SKU Virtual Age
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @atualização-de-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 40
            region: @atualização-de-produtos
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction atualiza-nome-produto (
        name: Atualiza Nome Produto
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P518_CODIGO_PRODUTO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @atualização-de-produtos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-sku (
        name: "Valida SKU "
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P518_SKUVIRTUALAGE
        }
        error {
            errorMessage: Por favor, informe o SKU do produto!
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR
        }
    )

    process atualiza-sku-do-produto (
        name: Atualiza SKU do Produto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update produtos p
                  set p.skuvirtualage = :P518_SKUVIRTUALAGE
                  where p.codigosisdist = :P518_CODIGO_PRODUTO;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Produto atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1576761287364910434
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 518
                items: {
                    P518_CODIGO_PRODUTO:
                    P518_NOME_PRODUTO:
                    P518_SKUVIRTUALAGE:
                }
                action: resetPagination
            }
        }
    )

)

