    pageItem P686_FRANQUIAS (
        type: shuttle
        label {
            label: Franquias
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.idgrupo is not null
                  and f.tipofilial = 'D'
                ```
        }
        layout {
            sequence: 60
            region: @detalhes-da-campanha
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 5
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
