                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @DESCONTOTOTALDIVIDA
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DATAFIM (
            type: datePickerJquery
            heading {
                heading: Até
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
