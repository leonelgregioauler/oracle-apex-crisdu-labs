    button cadastrar (
        buttonName: CADASTRAR
        label: Cadastrar
        layout {
            sequence: 40
            region: @detalhes-da-campanha
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P686_IDCAMPANHACOBRANCA
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
