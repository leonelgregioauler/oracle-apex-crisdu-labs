        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @detalhes-da-campanha
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 685
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction libera-comissao (
        name: Libera Comissao
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P686_LIBERACOMISSAO
        }
        clientSideCondition {
            type: item=value
            item: P686_LIBERACOMISSAO
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P686_PERCENTUALCOMISSAO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P686_PERCENTUALCOMISSAO
            }
            execution {
                sequence: 10
            }
        )

    )

    process configurações-da-campanha-save-interactive-grid-data (
        name: Configurações da Campanha - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @configurações-da-campanha
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 890344718544251206
        }
    )

    process consulta-dml-em-campanhas-cobrancas (
        name: Consulta DML em Campanhas Cobrancas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  voperacao_dml varchar2(1) := 'S';
                begin
                  --
                  pck_negociacoes_rmc.prc_campanhascobrancas(pidcampanhacobranca => :P686_IDCAMPANHACOBRANCA,
                                                             pnome => :P686_NOME,
                                                             pdatainicio => :P686_DATAINICIO,
                                                             pdatafim => :P686_DATAFIM,
                                                             pcanal_negociacao => :P686_CANAL_NEGOCIACAO,
                                                             pfranquias => :P686_FRANQUIAS,
                                                             pliberacomissao => :P686_LIBERACOMISSAO,
                                                             ppercentualcomissao => :P686_PERCENTUALCOMISSAO,
                                                             pmd5 => :P686_MD5,
                                                             poperacao_dml => voperacao_dml);
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 890345419640251213
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P686_IDCAMPANHACOBRANCA
        }
    )

    process processo-dml-em-campanhas-cobrança (
        name: Processo DML em Campanhas Cobrança
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'CADASTRAR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  pck_negociacoes_rmc.prc_campanhascobrancas(pidcampanhacobranca => :P686_IDCAMPANHACOBRANCA,
                                                             pnome => :P686_NOME,
                                                             pdatainicio => :P686_DATAINICIO,
                                                             pdatafim => :P686_DATAFIM,
                                                             pcanal_negociacao => :P686_CANAL_NEGOCIACAO,
                                                             pfranquias => :P686_FRANQUIAS,
                                                             pliberacomissao => :P686_LIBERACOMISSAO,
                                                             ppercentualcomissao => :P686_PERCENTUALCOMISSAO,
                                                             pmd5 => :P686_MD5,
                                                             poperacao_dml => voperacao_dml);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Operação realizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 890332023127622510
        }
    )

)

