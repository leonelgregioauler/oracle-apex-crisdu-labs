page 686 (
    name: Detalhes da Campanha
    title: Detalhes da Campanha
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 70%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region configurações-da-campanha (
        name: Configurações da Campanha
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idconfigcampanhacobranca
                     , c.idcampanhacobranca
                     , c.datainicio
                     , c.datafim
                     , c.origens
                     , c.descontojuros
                     , c.descontovlroriginal
                     , c.descontototaldivida
                from configcampanhascobrancas c 
                where c.idcampanhacobranca = :P686_IDCAMPANHACOBRANCA
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P686_IDCAMPANHACOBRANCA
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            showTotalCount: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 572407406858072544
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDCONFIGCAMPANHACOBRANCA
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDCAMPANHACOBRANCA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @DATAINICIO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
