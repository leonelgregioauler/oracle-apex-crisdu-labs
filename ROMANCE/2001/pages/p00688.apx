page 688 (
    name: Painel Mesa de Crédito
    title: Painel Mesa de Credito
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function aprova(pid, pidhist){ 
            
              document.getElementById('P688_IDREP').value = pid;
              document.getElementById('P688_IDHIST').value = pidhist;
                
              var answer = confirm("Aprova esse Cadastro?")
              if (answer)
                {
                  apex.submit('APROVA');
                }
            }
            
            function reprova(pid, pidhist){ 
            
              document.getElementById('P688_IDREP').value = pid;
              document.getElementById('P688_IDHIST').value = pidhist;
                
              var answer = confirm("Reprovar esse Cadastro?")
              if (answer)
                {
                  apex.submit('REPROVA');
                }
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

