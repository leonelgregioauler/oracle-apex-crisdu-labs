    region painel-mesa-de-crédito (
        name: Painel Mesa de Crédito
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  v_sql clob;
                  --
                begin
                  --
                  v_sql := q'[
                    select cp.dataconsulta
                         , roman.pck_romance.fnc_nomefilial(ms.idfilial) franquia
                         , roman.pck_romance.fnc_nomerepresentante (ms.idrepresentante) distribuidor
                         , initcap( cp.nome) nome
                         , nvl(cp.cpf,cp.documentoestrangeiro) documento
                         , cp.nomemae
                         , cp.protocolo
                         --, cp.regiaocpf
                         --, cp.situacaocpf
                         , cp.datanascimento
                         , case
                             when ms.status = 'A' and ms.sigla = 'MS' then
                               '<font color="green"><b>Aprovada!</b></font>'
                             when ms.status = 'P' and ms.sigla = 'MS'  then
                               '<a href=javascript:aprova('||ms.idrepresentante||','||ms.idhistoricoconsultadoc||');><img src="#APP_IMAGES#ok.png" alt=""/></a>'
                             else
                               '-'
                           end aprovarcadastro
                         , case
                             when ms.status = 'R' and ms.sigla = 'MS' then
                               '<font color="red"><b>Reprovada</b></font>'
                             when ms.status = 'P' and ms.sigla = 'MS' then
                               '<a href=javascript:reprova('||ms.idrepresentante||','||ms.idhistoricoconsultadoc||');><img src="#APP_IMAGES#excluir.png" alt=""/></a>'
                             else
                               '-'
                           end reprovarcadastro
                         , case
                             when ms.status = 'A' and ms.sigla = 'GC' then
                               '<font color="green"><b>Aprovada!</b></font>'
                             when ms.status = 'P' and ms.sigla = 'GC'  then
                               '<a href=javascript:aprova('||ms.idrepresentante||','||ms.idhistoricoconsultadoc||');><img src="#APP_IMAGES#ok.png" alt=""/></a>'
                             else
                               '-'
                           end aprovarcadastrogest
                         , case
                             when ms.status = 'R' and ms.sigla = 'GC' then
                               '<font color="red"><b>Reprovada</b></font>'
                             when ms.status = 'P' and ms.sigla = 'GC' then
                               '<a href=javascript:reprova('||ms.idrepresentante||','||ms.idhistoricoconsultadoc||');><img src="#APP_IMAGES#excluir.png" alt=""/></a>'
                             else
                               '-'
                           end reprovarcadastrogest
                         , ms.idconsultaspc infocred
                         , ms.sigla
                         , case
                             when ms.situacao  = 'S' then 
                              'Aprovado'
                             else
                              'Reprovado'
                           end sitconsult
                        , case 
                           when ms.status = 'P' then 
                             'Pendente'
                           when ms.status = 'A' then 
                             'Aprovado'
                           when ms.status = 'R' then 
                             'Reprovado'
                          end sitmesa
                        , ms.dataenviomesa
                        , cp.runrut RUNRUT
                    from roman.mesadecreditos ms
                       , roman.consultaspc cp
                    where ms.idconsultaspc = cp.idconsultaspc
                      and trunc(ms.dataenviomesa) between to_date(:P688_DATAINICIO,'DD/MM/RRRR') and to_date(:P688_DATAFIM,'DD/MM/RRRR')  ]';
                  --
                  if :P688_IDFILIAL is not null then 
                    v_sql := v_sql ||
                             ' and ms.idfilial = :P688_IDFILIAL';
                  end if;
                  --
                  if :P688_IDREPRESENTANTE is not null then 
                    v_sql := v_sql ||
                             ' and ms.idrepresentante = :P688_IDREPRESENTANTE ';
                  end if;
                  --
                  if :P688_TIPO = 'M' then 
                    v_sql := v_sql ||
                             q'[ and ms.sigla = 'MS' ]';
                  end if;
                  --
                  if :P688_TIPO = 'G' then 
                    v_sql := v_sql ||
                             q'[ and ms.sigla = 'GC' ]';
                  end if;
                  --
                  if :P688_SITMESA = 'P' then 
                    v_sql := v_sql ||
                             q'[ and ms.status = 'P' ]';
                  end if;
                  --
                  if :P688_SITMESA = 'A' then 
                    v_sql := v_sql ||
                             q'[ and ms.status = 'A' ]';
                  end if;
                  --
                  if :P688_SITMESA = 'R' then 
                    v_sql := v_sql ||
                             q'[ and ms.status = 'R' ]';
                  end if;
                  --
                  v_sql := v_sql || ' order by dataenviomesa ';
                  --
                  return v_sql;
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
