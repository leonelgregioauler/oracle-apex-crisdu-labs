    pageItem P688_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) d
                     , idrepresentante r
                from representantes r
                where r.ativo = 'S'
                  and r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P688_IDFILIAL )
                order by 1
                ```
        }
        cascadingLov {
