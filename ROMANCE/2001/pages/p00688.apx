    pageItem P688_IDFILIAL (
        type: selectList
        label {
            label: Empresa:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo != 5
                union
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.ididioma in (2,4,6)
                union
                /*
                    Maicon Aimi - 23/09/2024
                    Adicionado as lojas de brsília a pedido da Janny
                */
                select f.nome
                     , f.idfilial
                  from roman.vw_filiais f
                 where f.idfilial in (1217,1246,1275)
                   and f.tipofilial = 'D'
                   and f.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: "- Todas - "
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

