    process informa-valores (
        name: Informa Valores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                  --
                  if :P688_DATAINICIO is null then
                    --
                    select trunc(SYSDATE,'MM')
                    into :P688_DATAINICIO
                    from dual;
                    --
                  end if;
                  --
                  if :P688_DATAFIM is null then
                    --
                    select trunc(sysdate) 
                    into :P688_DATAFIM
                    from dual;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1109959169768011323
        }
    )

    process realiza-procedimento (
        name: Realiza procedimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidrep number := :P688_IDREP;
                  --
                  vidhistoricoconsultadoc number := :P688_IDHIST;
                  --
                  vsituacao  varchar2(1);
                  vidusuario number;
                  --
                begin 
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                
                  if v('REQUEST') = 'APROVA' then
                     vsituacao := 'A';
                  elsif v('REQUEST') = 'REPROVA' then
                     vsituacao := 'R';
                  end if;
                  --
                     roman.pck_cadastros_rmc.prc_atualizasituacaomesa(pidhistoricoconsultadoc => vidhistoricoconsultadoc,
                                                                      psituacao               => vsituacao,
                                                                      pidusuario              => vidusuario,
                                                                      pidrepresentante        => vidrep );
                
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Dados Atualizados!
        }
        error {
            errorMessage: Erro ao processar, por favor, registre um ticket.
        }
        advanced {
            executionMappingIdentifier: 1110035554438416417
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('APROVA','REPROVA')
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 688
                items: {
                    P688_DATAINICIO: &P688_DATAINICIO.
                    P688_DATAFIM: &P688_DATAFIM.
                    P688_IDFILIAL: &P688_IDFILIAL.
                    P688_IDREPRESENTANTE: &P688_IDREPRESENTANTE.
                    P688_TIPO: &P688_TIPO.
                    P688_SITMESA: &P688_SITMESA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

