page 127 (
    name: Alterar Região
    alias: ALTERARSETOR
    title: Alterar Região
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            if (document.getElementById('P127_FECHAR').value =='S')
              {
                window.opener.location.reload(); 
                window.close();
              }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region alterar-região (
        name: Alterar Região
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P127_FECHAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @alterar-região
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P127_IDNOTAVENDA (
        type: hidden
        layout {
            sequence: 10
            region: @alterar-região
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDNOTAVENDA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P127_IDREGIAOVENDA (
        type: selectList
        label {
            label: Região Venda
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(idregiaovenda)||'-'||semana DISPLAY_VALUE
                     , idregiaovenda RETURN_VALUE
                from regioesrepresentantes r
                where r.idrepresentante = :P127_IDREPRESENTANTE
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P127_IDREPRESENTANTE
        }
        layout {
            sequence: 50
            region: @alterar-região
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREGIAOVENDA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P127_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @representantes-2
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @alterar-região
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P127_IDVENDEDORA (
        type: selectList
        label {
            label: Cliente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(pidvendedora => v.idvendedora) display_value
                     , v.idvendedora return_value
                from vendedoras v
                where v.ativo = 'S'
                  and v.idrepresentante = :P127_IDREPRESENTANTE
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P127_IDREPRESENTANTE
        }
        layout {
            sequence: 30
            region: @alterar-região
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDVENDEDORA
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 20
            region: @alterar-região
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 37
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 10
            region: @alterar-região
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P127_IDNOTAVENDA
        }
    )

    process altera-vendedora (
        name: altera vendedora
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update vendedoras
                  set idregiaovenda = :P127_IDREGIAOVENDA
                  where idvendedora = (select idvendedora from notasvendas where idnotavenda = :P127_IDNOTAVENDA);
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 27283284841398355
        }
    )

    process classificação-de-região-trocada (
        name: Classificação de Região Trocada
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcaracteristica number := 6;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number := :P127_IDREGIAOVENDA;
                  vobservacao varchar2(1000);
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P127_IDNOTAVENDA,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidvalorcaracteristica,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1408092705284863608
        }
    )

    process fetch-row-from-notasvendas (
        name: Fetch Row from NOTASVENDAS
        type: autoRowFetch
        source {
            tableName: NOTASVENDAS
            pkColumn: IDNOTAVENDA
            pkItem: P127_IDNOTAVENDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 258581370095304727
        }
    )

    process process-row-of-notasvendas (
        name: Process Row of NOTASVENDAS
        type: autoRowProcessing
        target {
            tableName: NOTASVENDAS
            pkColumn: IDNOTAVENDA
            pkItem: P127_IDNOTAVENDA
            supportedOperations: update
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 258581576561304728
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 258581787937304728
        }
    )

    branch (
        name: Go To Page 127
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 37
            }
        }
    )

)

