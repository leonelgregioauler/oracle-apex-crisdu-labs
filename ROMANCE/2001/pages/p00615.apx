                ```sql
                select w.idsemana
                     , w.semana
                     , w.filial
                     , w.idmetricacampanha
                     , w.metrica
                     , w.nivel
                     , w.media valor
                     , w.pontos
                     , w.pontuacao_possivel
                from vw_pontuacaocampanha  w
