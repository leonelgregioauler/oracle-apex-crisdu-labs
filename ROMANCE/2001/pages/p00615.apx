    region pontuação-por-distribuidor-2 (
        name: Pontuação Por Distribuidor
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  vidsemanaini number;
                  vidsemanafim number;
                begin
                  --
                  if :P615_TIPO_PESQUISA = 'S' then
                    --
                    pck_campanhas.prc_imprimepontdistribuidores(pidfilial => :P615_IDFILIAL,
                                                                pidsemanaini => :P615_IDSEMANA,
                                                                pidsemanafim => :P615_IDSEMANA);
                    --
                  elsif :P615_TIPO_PESQUISA = 'P' then
                    --
                    pck_campanhas.prc_imprimepontdistribuidores(pidfilial => :P615_IDFILIAL,
                                                                pidsemanaini => :P615_IDSEMANA_INI,
                                                                pidsemanafim => :P615_IDSEMANA_FIM);
                    --
                  elsif :P615_TIPO_PESQUISA = 'C' then
                    --
                    select c.idsemanaini
                         , c.idsemanafim
                    into vidsemanaini
                       , vidsemanafim
                    from campanhas c
                    where c.idcampanha = :P615_IDCAMPANHA;
                    --
                    pck_campanhas.prc_imprimepontdistribuidores(pidfilial => :P615_IDFILIAL,
                                                                pidsemanaini => vidsemanaini,
                                                                pidsemanafim => vidsemanafim,
                                                                pidcampanha => :P615_IDCAMPANHA);
                    --
                  end if;
                  --
                end;
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent8
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P615_TIPO_RELATORIO = 'X' and :P615_IDFILIAL is not null
        }
    )

