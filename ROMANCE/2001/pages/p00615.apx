    region ranking (
        name: Ranking
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select grupo
                     , filial
                     , pontos "Pontos"
                     , rank
                from ( 
                        select f.grupomotivoulevou grupo
                             , w.filial
                             , sum(w.pontos) pontos
                             , row_number() over (partition by grupomotivoulevou order by sum(w.pontos) desc) rank
                        from roman.vw_pontuacaocampanha  w
                           , roman.vw_filiais f
                        where w.idfilial = f.idfilial
                          and ( :P615_IDFILIAL is null or w.idfilial = :P615_IDFILIAL )
                          and ( :P615_TIPO_PESQUISA is null 
                             or ( :P615_TIPO_PESQUISA = 'S' and w.idsemana = :P615_IDSEMANA )
                             or ( :P615_TIPO_PESQUISA = 'P' and w.idsemana between :P615_IDSEMANA_INI and :P615_IDSEMANA_FIM )
                             or ( :P615_TIPO_PESQUISA = 'C' and w.idcampanha = :P615_IDCAMPANHA )  )
                          and ( :P615_GRUPO_FILIAIS = 'T'
                             or ( :P615_GRUPO_FILIAIS = 'S' and w.divisao = :P615_GRUPO ) )
                          and :P615_TIPO_RELATORIO  = 'R'
                        group by f.grupomotivoulevou, w.filial
                        order by f.grupomotivoulevou )
                --where rank <= 2
                
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P615_TIPO_RELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5822432368976678902
        }

        column FILIAL (
            type: plainText
            heading {
                heading: Franquia
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column GRUPO (
