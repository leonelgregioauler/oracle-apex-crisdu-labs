    pageItem P615_SESSION_IMPRIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @pontuação-por-distribuidor-2
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2001;
                    vidsemanaini number;
                    vidsemanafim number;
                    l_session number := v('APP_SESSION');
                BEGIN
                  if :P615_TIPO_PESQUISA = 'P' then
                    --
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':666:'||l_session||'::NO::P666_IDFILIAL,:P666_TIPO,:P666_IDSEMANA,:P666_IDSEMANAFIM:'||:P615_IDFILIAL||',P,'||:P615_IDSEMANA_INI||','||:P615_IDSEMANA_FIM,
                        p_checksum_type => 'SESSION');
                    --
                  elsif :P615_TIPO_PESQUISA = 'C' then
                    --
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':666:'||l_session||'::NO::P666_IDFILIAL,:P666_TIPO,:P666_IDCAMPANHA:'||:P615_IDFILIAL||',C,'||:P615_IDCAMPANHA,
                        p_checksum_type => 'SESSION');
                  else
                    --
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':666:'||l_session||'::NO::P666_IDFILIAL,P666_IDSEMANA:'||:P615_IDFILIAL||','||:P615_IDSEMANA,
                        p_checksum_type => 'SESSION');
                    --
                  end if;
                  --
                  return l_url;
                  --
                END;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

