    region pontuação (
        name: Pontuação
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.filial
                     , w.metrica
                     , sum(w.media) media
                     , sum(nvl(w.pontos,0)) pontos
                from vw_pontuacaocampanha w
                where ( :P615_IDFILIAL is null or w.idfilial = :P615_IDFILIAL )
                  and ( :P615_TIPO_PESQUISA is null 
                    or ( :P615_TIPO_PESQUISA = 'S' and w.idsemana = :P615_IDSEMANA )
                    or ( :P615_TIPO_PESQUISA = 'P' and w.idsemana between :P615_IDSEMANA_INI and :P615_IDSEMANA_FIM )
                    or ( :P615_TIPO_PESQUISA = 'C' and w.idcampanha = :P615_IDCAMPANHA ) )
                  and ( :P615_GRUPO_FILIAIS = 'T'
                     or ( :P615_GRUPO_FILIAIS = 'S' and w.divisao = :P615_GRUPO ) )
                  and :P615_TIPO_RELATORIO = 'R'
                group by  w.filial
                       , w.metrica
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P615_TIPO_RELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5579633262840155939
        }

