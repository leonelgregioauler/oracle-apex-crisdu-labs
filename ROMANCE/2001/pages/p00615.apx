    dynamicAction tipo-campanha (
        name: Tipo Campanha
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P615_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P615_TIPO_PESQUISA
            value: C
        }

