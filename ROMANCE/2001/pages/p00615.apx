    region conquistas (
        name: Conquistas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from (
                      select w.filial
                           , w.nivel
                      from vw_pontuacaocampanha w
                      where ( :P615_TIPO_PESQUISA is null 
                         or ( :P615_TIPO_PESQUISA = 'S' and w.idsemana = :P615_IDSEMANA )
                         or ( :P615_TIPO_PESQUISA = 'P' and w.idsemana between :P615_IDSEMANA_INI and :P615_IDSEMANA_FIM )
                         or ( :P615_TIPO_PESQUISA = 'C' and w.idcampanha = :P615_IDCAMPANHA )  )
                        and ( :P615_GRUPO_FILIAIS = 'T'
                           or ( :P615_GRUPO_FILIAIS = 'S' and w.divisao = :P615_GRUPO ) )
                     )
                pivot
                     (
                     count(nivel)
                     for nivel in ('Bronze' as Bronze ,'Diamante' as Diamante,'Prata' as Prata,'Ouro' as Ouro,'Nenhum' as Nenhum)
                     )
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P615_TIPO_RELATORIO
            value: R
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

