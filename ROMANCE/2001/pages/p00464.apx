page 464 (
    name: Logistica Reversa Finalizada
    title: Logistica Reversa Finalizada
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        fileUrls: https://websocket.romancemoda.com.br/romance_correios.js
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            /*function doLoad()
            {
               setTimeout( "refresh()", 5000);
            }*/
            
            function refresh()
            {
            window.location.href = window.location;
            }
            
            
            ```
        executeWhenPageLoads: doLoad();
    }
    security {
        pageAccessProtection: unrestricted
    }

    region logistica-reversa (
        name: Logistica Reversa
        type: list
        source {
            list: @logistica-reversa
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: t-WizardSteps--displayLabels
        }
    )

    region logistica-reversa-2 (
        name: Logistica Reversa
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P464_CODIGOCORREIO (
        type: textField
        label {
            label: Cód. Correio
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 80
            region: @logistica-reversa-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P464_ENDERECODESTINATARIO (
        type: textField
        label {
            label: Destinatario
            alignment: left
        }
        layout {
            sequence: 70
            region: @logistica-reversa-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vnome varchar2(100);
                begin
                  --
                  select pck_romance.fnc_nomepessoa(idpessoa) nome
                  into vnome
                  from favorita.enderecosentrega e
                  where e.idenderecoentrega = :P464_IDENDERECODESTINATARIO;
                  --
                  return vnome;
                  --
                exception
                  when others then
                    return 'Remetente não Encontrado.';
                end;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vnome varchar2(100);
                begin
                  --
                  select pck_romance.fnc_nomepessoa(idpessoa) nome
                  into vnome
                  from favorita.enderecosentrega e
                  where e.idenderecoentrega = :P464_IDENDERECODESTINATARIO;
                  --
                  return vnome;
                  --
                exception
                  when others then
                    return 'Remetente não Encontrado.';
                end;
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P464_ENDERECOREMETENTE (
        type: textField
        label {
            label: Remetente
            alignment: left
        }
        layout {
            sequence: 50
            region: @logistica-reversa-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vnome varchar2(100);
                begin
                  --
                  select pck_romance.fnc_nomepessoa(idpessoa) nome
                  into vnome
                  from favorita.enderecosentrega e
                  where e.idenderecoentrega = :P464_IDENDERECOREMETENTE;
                  --
                  return vnome;
                  --
                exception
                  when others then
                    return 'Remetente não Encontrado.';
                end;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vnome varchar2(100);
                begin
                  --
                  select pck_romance.fnc_nomepessoa(idpessoa) nome
                  into vnome
                  from favorita.enderecosentrega e
                  where e.idenderecoentrega = :P464_IDENDERECOREMETENTE;
                  --
                  return vnome;
                  --
                exception
                  when others then
                    return 'Remetente não Encontrado.';
                end;
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P464_IDENDERECODESTINATARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @logistica-reversa-2
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P464_IDENDERECOREMETENTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @logistica-reversa-2
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P464_IDLOGISTICAREVERSA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @logistica-reversa-2
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P464_IDOBJETOLOGISTICA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @logistica-reversa-2
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 10
            region: @logistica-reversa-2
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: itemIsNull
            item: P464_CODIGOCORREIO
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 20
            region: @logistica-reversa-2
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction busca-codigo-correio (
        name: Busca Codigo Correio
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @atualizar
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: "javascript: Correios.LogisticaReversa(document.getElementById('P464_IDLOGISTICAREVERSA').value ,function(dados){ console.log(dados)});"
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ATUALIZAR
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    process consulta-logistica-reversa (
        name: Consulta Logistica Reversa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdate        date;
                  vidpedido    number;
                  vidnotavenda number;
                  vidusuario   number;
                  vidlogistica number;
                  vidobjeto    number;
                  vmd5         varchar(1000);
                  videndereco1 number;
                  videndereco2 number;
                  vcodigo      varchar2(100);
                begin
                  --
                  PCK_LOGISTICAREVERSA.PRC_LOGISTICAREVERSA( PIDLOGISTICAREVERSA => :P464_IDLOGISTICAREVERSA,
                                                             PIDOBJETOLOGISTICA => :P464_IDOBJETOLOGISTICA,
                                                             PIDENDERECOREMETENTE => :P464_IDENDERECOREMETENTE,
                                                             PIDENDERECODESTINATARIO => :P464_IDENDERECODESTINATARIO,
                                                             PCODIGOCORREIO => :P464_CODIGOCORREIO,
                                                             PDATA => vdate,
                                                             PIDUSUARIO => vidusuario,
                                                             PIDNOTAVENDA => vidnotavenda,
                                                             PIDPEDIDO => vidpedido,
                                                             PMD5 => vmd5,
                                                             POPERACAO_DML => 'S' );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1522879886540937303
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 280
                items: {
                    P280_CPF:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @fechar
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 464
                items: {
                    P464_IDLOGISTICAREVERSA: &P464_IDLOGISTICAREVERSA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR
        }
    )

)

