page 373 (
    name: Fotos de Documentos
    title: Fotos de Documentos
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_aprovar(pid)
            {
              document.getElementById("P373_IDEDITAR").value = pid;
              apex.submit('APROVAR');
            }
            
            function fnc_reprovar(pid)
            {
              document.getElementById("P373_IDEDITAR").value = pid;
              apex.submit('REPROVAR');
            }
            
            function fnc_remover(pid)
            {
              document.getElementById("P373_IDEDITAR").value = pid;
              apex.submit('REMOVER');
            }
            ```
    }
    css {
        inline:
            ```css
            .img_documento {
                position: relative;
                max-width: 360px;
                width: 60%;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region fotos-de-documentos (
        name: Fotos de Documentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.tipofoto
                     , decode(f.recebida,'S','Sim','N','Não') recebida
                     , f.datadadosrecebido
                     , f.nomearquivo
                     , null verfoto
                     --, '<a href="http://fotos_documentos.romancemoda.com.br/'||f.nomearquivo||'" target="_blank"> <img src="http://fotos_documentos.romancemoda.com.br/'||f.nomearquivo||'" class="img_documento"><a>' foto
                     , case 
                         when nvl(f.revisado,'N') = 'N' and f.aprovado is null then 
                           '<a href="javascript:fnc_aprovar('||f.idfotodocumento||')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         when f.aprovado = 'S' then
                           'Foto Aprovada!'
                       end aprovar
                     , case 
                         when nvl(f.revisado,'N') = 'N' and f.aprovado is null then 
                           '<a href="javascript:fnc_reprovar('||f.idfotodocumento||')" ><img src="#APP_IMAGES#Deslike.png"  border="0"></a>'
                         when f.aprovado = 'N' then
                           'Foto Reprovada!'
                       end reprovar
                     , '<a href=javascript:fnc_remover('||f.idfotodocumento||');><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt=""></a>' remover
                from roman.fotosdocumentos f
                where f.documento = :P373_DOCUMENTO
                order by f.data 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1411455293888905318
        }

