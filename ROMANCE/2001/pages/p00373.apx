    pageItem P373_DOCUMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @fotos-de-documentos
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(cpf,documentoestrangeiro)
                from pessoas p
                where p.idpessoa = :P373_IDPESSOA
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P373_IDEDITAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @fotos-de-documentos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P373_IDNOTAVENDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @fotos-de-documentos
            slot: regionBody
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidnotavenda number;
                begin
                  --
                  select nv.idnotavenda
                  into vidnotavenda 
                  from notasvendas nv
                      , vendedoras v
                  where v.idpessoa = :P373_IDPESSOA
                    and nv.idvendedora = v.idvendedora
                    and nv.idsituacaonotavenda = 3;
                  --
                exception
                  when others then
                    return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P373_IDPESSOA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @fotos-de-documentos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button confirmar-promissoria (
        buttonName: CONFIRMAR_PROMISSORIA
        label: Confirmar Promissória
        layout {
            sequence: 20
            region: @fotos-de-documentos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente confirmar a Promissória?','CONFIRMAR_PROMISSORIA');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from notasvendas n
                where n.idnotavenda = :P373_IDNOTAVENDA
                  and nvl(n.promissoriarecuperada,'N') = 'N'
                  and not exists ( select 1
                                   from classificacoesnotasvendas cn
                                   where cn.idnotavenda = n.idnotavenda
                                     and cn.idcaracteristicanotavenda = 25 )
                  and not exists ( select 1
                                   from classificacoesnotasvendas cn
                                   where cn.idnotavenda = n.idnotavenda
                                     and cn.idcaracteristicanotavenda = 3 )
                ```
        }
    )

    button rejeitar-promissoria (
        buttonName: REJEITAR_PROMISSORIA
        label: Rejeitar Promissória
        layout {
            sequence: 10
            region: @fotos-de-documentos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente rejeitar a Promissória?','REJEITAR_PROMISSORIA');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from notasvendas n
                where n.idnotavenda = :P373_IDNOTAVENDA
                  and nvl(n.promissoriarecuperada,'N') = 'N'
                  and not exists ( select 1
                                   from classificacoesnotasvendas cn
                                   where cn.idnotavenda = n.idnotavenda
                                     and cn.idcaracteristicanotavenda = 25 )
                  and not exists ( select 1
                                   from classificacoesnotasvendas cn
                                   where cn.idnotavenda = n.idnotavenda
                                     and cn.idcaracteristicanotavenda = 3 )
                ```
        }
    )

    process aprovar-foto (
        name: Aprovar Foto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update fotosdocumentos f
                  set f.revisado = 'S'
                    , f.aprovado = 'S'
                    , datarevisao = sysdate
                    , usuariorevisao = v('APP_USER')
                  where f.idfotodocumento = :P373_IDEDITAR;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Foto aprovada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1433221118274698509
        }
        serverSideCondition {
            type: request=Value
            value: APROVAR
        }
    )

    process confirma-promissória (
        name: Confirma Promissória
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidcaracteristica number := 3;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);
                  --
                begin 
                  --
                  update notasvendas n
                  set n.promissoriarecuperada = 'S'
                    , n.recuperarpromissoria = 'N'
                  where n.idnotavenda = :P373_IDNOTAVENDA;
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P373_IDNOTAVENDA,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidvalorcaracteristica,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Promissória Confirmada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1511231128431380518
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR_PROMISSORIA
        }
    )

    process rejeitar-promissória (
        name: Rejeitar Promissória
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidcaracteristica number := 25;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);
                  --
                begin 
                  --
                  update notasvendas n
                  set n.promissoriarecuperada = 'N'
                    , n.recuperarpromissoria = 'S'
                  where n.idnotavenda = :P373_IDNOTAVENDA;
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P373_IDNOTAVENDA,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidvalorcaracteristica,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Promissória Rejeitada!
        }
        advanced {
            executionMappingIdentifier: 1511231230999380519
        }
        serverSideCondition {
            type: request=Value
            value: REJEITAR_PROMISSORIA
        }
    )

    process remover-marcação (
        name: Remover Marcação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update fotosdocumentos f
                  set f.revisado = null
                    , f.aprovado = null
                    , datarevisao = null
                    , usuariorevisao = null
                  where f.idfotodocumento = :P373_IDEDITAR;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Marcação removida com sucesso!
        }
        advanced {
            executionMappingIdentifier: 2834245408410780248
        }
        serverSideCondition {
            type: request=Value
            value: REMOVER
        }
    )

    process reprovar-foto (
        name: Reprovar Foto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update fotosdocumentos f
                  set f.revisado = 'S'
                    , f.aprovado = 'N'
                    , datarevisao = sysdate
                    , usuariorevisao = v('APP_USER')
                  where f.idfotodocumento = :P373_IDEDITAR;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Foto reprovada com sucesso! Vai ser necessário tirar novamente.
        }
        advanced {
            executionMappingIdentifier: 1433221239605698510
        }
        serverSideCondition {
            type: request=Value
            value: REPROVAR
        }
    )

    branch (
        name: Go To Page 373
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 373
                items: {
                    P373_IDPESSOA: &P373_IDPESSOA.
                    P373_DOCUMENTO: &P373_DOCUMENTO.
                    P373_IDEDITAR:
                    P373_IDNOTAVENDA: &P373_IDNOTAVENDA.
                }
                action: resetPagination
            }
        }
    )

)

