page 52 (
    name: Controle de Acessos
    title: Controle de Acessos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region retirar-acessos (
        name: Retirar Acessos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDACESSO",
                "IDACESSO" IDACESSO_DISPLAY,
                "USUARIO",
                "IDAPLICACAO",
                "ATIVO"
                from "#OWNER#"."ACESSOS"
                where usuario = :P52_USUARIOS
                  and idaplicacao in ( select idaplicacao from aplicacoes where idsistema = 2001)
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 400
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: showAll
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum acesso liberado!
        }
        componentAdvanced {
            stripHtml: true
        }

        column ATIVO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column CHECK$01 (
            reportColumnQueryId: 6
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDACESSO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingTrigger
            }
            sorting {
                sortable: false
            }
        )

        column IDACESSO_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column IDAPLICACAO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Aplicações
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select decode(hierarquia,null,  '<b>'|| TO_CHAR(descricao) ||'</b>'
                                                     , '<i>'||'* '|| TO_CHAR(descricao)||'</i>') display_value
                    , idaplicacao return_value
                    from aplicacoes
                    ```
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

    )

    region usuário (
        name: Usuário
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
    )

    pageItem P52_USUARIOS (
        type: selectList
        label {
            label: Usuário
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(username) display_value
                ,username return_value
                from dba_users d
                where trunc(d.created) >= to_date('07/12/2010','dd/mm/rrrr')
                AND USERNAME NOt IN ('APEX_PUBLIC_USER','APEX_040000','CATAL')
                and account_status != 'LOCKED'
                and exists ( select 1 
                               from usuariossistemas u 
                               where u.usuario   = d.username 
                                 and u.idsistema = 1000)
                order by 1
                ```
            nullDisplayValue: - Selecione o Usuário -
        }
        layout {
            sequence: 10
            region: @usuário
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @retirar-acessos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 51
                items: {
                    P51_USUARIOS: &P52_USUARIOS.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Retirar Acessos
        layout {
            sequence: 20
            region: @retirar-acessos
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @retirar-acessos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idaplicacao-must-be-numeric (
        name: IDAPLICACAO must be numeric
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @retirar-acessos
            type: columnIsNumeric
            column: IDAPLICACAO
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDAPLICACAO
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @retirar-acessos
        target {
            tableName: ACESSOS
            pkColumn: IDACESSO
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# row(s) deleted.
        }
        error {
            errorMessage: Unable to process delete.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 149650070394751558
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 52
                items: {
                    P52_USUARIOS: &P52_USUARIOS.
                }
            }
            saveStateBeforeBranching: true
        }
    )

)

