page 786 (
    name: Relatorio Guia de Despacho - Cargas
    alias: RELATORIO-GUIA-DE-DESPACHO
    title: Guia de Despacho - Cargas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }

    region fecha-emission (
        name: Fecha Emission
        type: staticContent
        layout {
            sequence: 30
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region guia-de-despacho (
        name: Guia de Despacho
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select c.fchemis
                     , v.rutrecep
                     , roman.pck_romance.fnc_nomerepresentante (v.idrepresentante) nomecliente
                     , v.correorecep
                     , pck_util.fnc_semanaid(v.idsemana) semana
                     , v.idcargarepresentante
                     , listagg(c.folio,';') folio
                     , max(v.mnttotal) valortotal
                     , max(v.valor_iva) valor_iva
                     , (select telefone
                          from telefonespessoas
                         where idtelefonepessoa = (select max(idtelefonepessoa)
                                                     from telefonespessoas 
                                                    where idpessoa = (select idpessoa
                                                                        from catal.representantes
                                                                       where idrepresentante = v.idrepresentante))) telefone
                
                  from roman.vw_cargas_dtemite v
                     , cargasrepres_dtemite    c
                 where v.idcargarepresentante = c.idcargarepresentante
                   and trunc(c.fchemis) between to_date(:P786_DATAINICIO,'dd/mm/rrrr')
                                            and to_date(:P786_DATAFIM   ,'dd/mm/rrrr')
                   and (nvl(:P786_IDFILIAL,0) = 0 or v.idfilial = :P786_IDFILIAL)
                   and :P786_FILTRAR = 'S'
                 group by c.fchemis
                     , v.rutrecep
                     , v.idrepresentante
                     , v.correorecep
                     , v.idsemana
                     , v.idcargarepresentante
                ~';
                ```
            pageItemsToSubmit: P786_FILTRAR
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 1334708196525460186
        }

