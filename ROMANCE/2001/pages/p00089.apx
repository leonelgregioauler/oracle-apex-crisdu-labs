        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 90
                items: {
                    P90_IDVENDADIRETA:
                    P90_IDFECHAMENTO: &P0_IDFECHAMENTO.
                    P90_IDFILIAL: &P0_IDFILIAL.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where nvl(f.concluido,'N') = 'N'
                  and f.idfechamento = :P0_IDFECHAMENTO
