page 89 (
    name: Venda Direta
    title: Venda Direta
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region venda-direta (
        name: Venda Direta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.idvendadireta
                     , substr(f.semana,4,4) ano
                     , substr(f.semana,1,2) semana
                     , f.semana fechamento
                     , v.data
                     , ( select initcap(nomepessoa)
                         from pessoas p
                            , funcionarios f
                         where p.idpessoa = f.idpessoa  
                           and f.idfuncionario = v.idfuncionario ) funcionario
                     , v.idfuncionario
                     , v.valortotal
                     , v.descricao
                     , decode(v.idsituacao,1,'Aberta',2,'Em Atendimento',3,'Concluída') situacao
                     , valorpago
                     , saldo   
                     , decode(ff.ativo,'S','Ativo','N','Inativo') situacao_funcionario    
                from vendasdiretas  v
                   , funcionarios ff
                   , fechamentossemanais f
                where ( :P0_IDFECHAMENTO = 999999999999 or v.idfechamento = :P0_IDFECHAMENTO)
                  and f.idfechamento = v.idfechamento
                  and ff.idfuncionario = v.idfuncionario
                  and v.idfilial     = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 90
                items: {
                    P90_IDVENDADIRETA: #IDVENDADIRETA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
            conditionType: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where nvl(f.concluido,'N') = 'N'
                  and f.idfechamento = :P89_IDFECHAMENTO
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma venda incluida.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1747912991992972795
        }

