            var htmldb_confirm_message='Confirmar envio da nota para o setor de Cobrança?';
            var htmldb_confirm_message2='Confirmar envio da nota para a Terceirizada?';
            
            function confirmadevolucaototal()
            {
              var answer = confirm("Confirma devolução total?")
              if (answer)
               {            
                 apex.submit('DEVOLUCAOTOTAL');
               }
            }
            
            function confirmacobranca()
            {
              var answer = confirm("Confirma envio para o Setor de Cobranças?")
              if (answer)
               {            
                 apex.submit('APPLY CHANGES');
               }
            }
            
            function confirmavendatotal()
            {
              var answer = confirm("Confirma venda total?")
              if (answer)
               {            
                 apex.submit('VENDATOTAL');
               }
            }
            
            function quitado()
            {
              document.getElementById('P37_QUITADAPEPINO').value = 'Q';
              apex.submit('CHANGE');
            }
            
            function pepino()
            {
              document.getElementById('P37_QUITADAPEPINO').value = 'P';
              apex.submit('APPLY');
            }
            
            function fnc_VENDEDORA()
            {
              vid = document.getElementById("P37_IDPESSOA").value;
              window.open('f?p=&APP_ID.:151:&SESSION.::NO::P151_IDPESSOA:'+vid,'CADASTRO', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=600,left=250,top=100','_blank'); void(0);
            }
            
            function fnc_imprimir()
            {
              vurl = document.getElementById("P37_SESSION_IMPRIME").value;
              pjan = window.open(vurl,'popup','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=400,height=700,left=250,top=100');
              pjan.focus();
            }
            
            
            function fnc_imprimir_cob()
            {
              vurl = document.getElementById("P37_SESSION_IMP_COB").value;
              pjan = window.open(vurl,'popup','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=800,height=900,left=250,top=100');
              pjan.focus();
            }
            
            
            function abrecadastro() 
            {
              vurl = document.getElementById("P37_SESSION").value;
              pjan = window.open(vurl,'popup','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=700,height=700,left=250,top=100');
              pjan.focus();
            }
            
            function confirmaantecipacao()
            {
              var answer = confirm("Confirma antecipação do acerto para semana atual?")
              if (answer)
