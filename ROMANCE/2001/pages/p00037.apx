                    -- 10682043 - Maicon Aimi - 14/10/2025 (NEW)
                    select 1
                      from dual
                     where roman.pck_util.fnc_verificaacesso(3570,v('APP_USER')) = 'S'
                    
                    union
                    
                    -- libera para time T.I
                    
                    select 1
                      from roman.usuariosgruposatendimento us
                     where us.usuario = v('APP_USER')
                       and us.idgrupoatendimento = 0
                    
                    /*
                    -- 10682043 - Maicon Aimi - 14/10/2025 (OLD)
                    select 1
                    from dual
                    where pck_util.fnc_verificaacesso(3569,v('APP_USER')) = 'S'
                       or exists ( select 1
                                     from roman.usuariosgruposatendimento us
                                    where us.usuario = v('APP_USER')
