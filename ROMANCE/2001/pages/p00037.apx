    process quitado (
        name: Quitado
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vsemana varchar2(10);
                  --
                begin
                  --
                  select max(semana)
                  into vsemana
                  from ( select semana
                         from fechamentossemanais
                         where idfilial = :P0_IDFILIAL
                           and concluido = 'N'
                         order by idfechamento desc )
                  where rownum = 1;
                  --
                  :P37_QUITADAPEPINO := 'Q';
                  --
                  if to_number(:P37_VALORPAGO,'999G999G990D00') = 0 then
                    insert into pagamentosnotasvendas ( idpagtonotavenda, idnotavenda, datapagamento, valorpago,semanacobranca)
                    values ( seq_idpgtonotavenda.nextval, :P37_IDNOTAVENDA , sysdate, to_number(:P37_VALORTOTALVENDALQD,'999G999G990D00'),vsemana);
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 150
        }
        advanced {
            executionMappingIdentifier: 266971267653343662
        }
        serverSideCondition {
            type: request=Value
            value: CHANGE
        }
    )

    process recupera-promissoria (
        name: Recupera Promissoria
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vsemana varchar2(15);
                begin
                  --
                  select pck_util.fnc_semanaid(pck_util.fnc_idsemanadata(sysdate)) semana
                  into vsemana
                  from dual;
                  --
                  update notasvendas
                  set promissoriarecuperada = 'S'
                    , recuperarpromissoria = 'N'
                  where idnotavenda = :P37_IDNOTAVENDA;
                  --
                  insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao,idrepresentante)
                  values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Promissória Recuperada na semana: '||vsemana,:P37_IDNOTAVENDA,'C',:P37_IDREPRESENTANTE);
                end;
                ```
