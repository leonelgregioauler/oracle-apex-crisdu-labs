    process enviar-para-cobrança (
        name: Enviar para Cobrança
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcaracteristica number := 5;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);
                  vsemananota varchar2(10);
                  vidsemananota number;
                  vsemanaatual varchar2(10);
                  vidsemanaatual number;
                begin
                  --
                  select pck_util.fnc_semanaid(pck_util.fnc_idsemanadata(sysdate))
                       , pck_util.fnc_idsemanadata(sysdate)
                  into vsemanaatual
                     , vidsemanaatual
                  from dual;
                  --
                  select semanacobranca
                       , pck_util.fnc_idsemana(semanacobranca)
                  into vsemananota
                     , vidsemananota
                  from notasvendas nv
                  where nv.idnotavenda = :P37_IDNOTAVENDA;
                  --
                  if :P37_IDSITUACAONOTAVENDA = 3 then
                    --
                    :P37_IDSITUACAONOTAVENDA := 4;
                    --
                  end if;
                  --
                  update itensnotavenda i
                  set i.qtddevolvida = 0
                  where i.qtddevolvida is null
                    and idnotavenda = :P37_IDNOTAVENDA;
                  --
                  if vidsemanaatual < vidsemananota then
                    --
                    update notasvendas 
                    set ENVIADOCOBRANCA = 'S'
                      , idsituacaonotavenda = 4
                      , dataenviadocobranca = sysdate
                      , idsituacaocobranca = 10
                      , perccomissao = 30
                      , semanacobranca = vsemanaatual
                    where idnotavenda = :P37_IDNOTAVENDA;
                    --
                  else
                    --
                    update notasvendas 
                    set ENVIADOCOBRANCA = 'S'
                      , idsituacaonotavenda = 4
                      , dataenviadocobranca = sysdate
                      , idsituacaocobranca = 10
                      , perccomissao = 30
                    where idnotavenda = :P37_IDNOTAVENDA;
                    --
                  end if;
                  --
                  vidvalorcaracteristica := pck_util.fnc_idsemanadata(sysdate);
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P37_IDNOTAVENDA,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidvalorcaracteristica,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 80
        }
        successMessage {
            successMessage: Nota enviada para o Setor de Cobranças!
        }
        advanced {
            executionMappingIdentifier: 593614982255556189
        }
        serverSideCondition {
            type: request=Value
            value: COBRANCA
        }
    )

