    process desvincular-pedido-favorita (
        name: Desvincular Pedido Favorita
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vpedido varchar2(4000);
                begin
                  --
                  -- Guarda o pedido vinculado antes de desvincular
                  --
                  select listagg(pedido, ', ')
                  into vpedido
                  from ( select to_char(fp.idpedido) pedido
                         from favorita.pedidos fp
                         where fp.idnotavenda = :P37_IDNOTAVENDA
                         union all
                         select cp.nrpedido
                         from catal.pedidos cp
                         where cp.idnotavenda = :P37_IDNOTAVENDA );
                  --
                  update catal.pedidos p
                  set p.idnotavenda = null
                  where idnotavenda = :P37_IDNOTAVENDA;
                  --
                  update favorita.pedidos p
                  set p.idnotavenda = null
                  where idnotavenda = :P37_IDNOTAVENDA;
                  --
                  update notasvendas
                  set perccomissao = 30
                  where idnotavenda = :P37_IDNOTAVENDA;
                  --
                  pck_romance.prc_atualizanotavenda(:P37_IDNOTAVENDA);
                  --
                  -- Registra a movimentação na correção da nota
                  --
                  if vpedido is not null then
                    --
                    insert into correcoesnotasvendas ( idcorrecaonotavenda , datacorrecao , usuario
                                                     , motivo              , idnotavenda  , situacao
                                                     , idrepresentante     , idfilial )
                    values ( seq_idcorrecaonotavenda.nextval , sysdate , v('APP_USER')
                           , 'Pedido Favorita '||vpedido||' desvinculado manualmente. Comissão alterada para 30%.'
                           , :P37_IDNOTAVENDA , 'C'
                           , :P37_IDREPRESENTANTE , :P37_IDFILIAL );
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 230
        }
        successMessage {
            successMessage: Pedido desvinculado!
        }
        advanced {
            executionMappingIdentifier: 551990469177080454
        }
        serverSideCondition {
            whenButtonPressed: @desvincular-pedido
        }
    )

