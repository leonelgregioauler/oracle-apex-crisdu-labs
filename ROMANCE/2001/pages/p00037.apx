    button gerar-codigo-liberacao (
        buttonName: GERAR_CODIGO_LIBERACAO
        label: Gerar Cód. de Liberação
        layout {
            sequence: 30
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where nvl(:P37_ENVIADOCOBRANCA,'N') = 'N'
                  and not exists ( select 1
                                   from liberacoesnotasvendas l
                                   where l.idnotavenda = :P37_IDNOTAVENDA
                                     and nvl(l.codigousado,'N') = 'N' )
                  and ( pck_util.fnc_verificaacesso(3540,v('APP_USER')) = 'N'
                     or ( pck_util.fnc_verificaacesso(2302,v('APP_USER')) = 'S' 
                        and pck_util.fnc_verificaacesso(3540,v('APP_USER')) = 'S' ) )
                  and not exists ( select 1
                                   from classificacoesnotasvendas cn
                                   where cn.idnotavenda = :P37_IDNOTAVENDA
                                     and cn.idcaracteristicanotavenda = 32 )
                union 
                select 1
                from dual
                where v('APP_USER') IN ('LUCASRAMOS','DANIELAOLIVEIRA') --ticket 14045294 - osiel
                ```
        }
    )

