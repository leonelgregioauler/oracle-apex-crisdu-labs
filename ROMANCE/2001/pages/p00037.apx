    validation p37-pedidofavorita (
        name: P37_PEDIDOFAVORITA
        execution {
            sequence: 120
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from favorita.pedidos p
                where p.idpedido = :P37_PEDIDOFAVORITA
                  and p.idvendedora = :P37_IDVENDEDORA
                  and p.idnotavenda is null
                  and p.datacancelamento is null
                  and p.tipopedido <> 'R'
                  and (trunc(p.dataemissao) < to_date('02/03/2026','dd/mm/yyyy') 
                    or trunc(p.dataemissao) >= to_date('02/03/2026','dd/mm/yyyy') 
                       and exists (select 1
                                   from favorita.parametros pp
                                   where pp.idfilialfavorita is null
                                     and pp.idfilialromance is null
                                     and pp.nome = 'VALORMINIMOPEDIDO'
                                     and p.valortotal > to_number(pp.valor)))
                ```
        }
        error {
            errorMessage: O pedido informado é inválido! Já foi utilizado, não pertence a esta consultora, ou é romance casa !
            associatedItem: @P37_PEDIDOFAVORITA
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P37_PEDIDOFAVORITA is not null  
                  and :P0_LIBERAR40COMPEDIDO = 'N'
                and v('REQUEST') not in ('CONFIRMAR','REJEITAR','DESVINCULAR_PEDIDO','DESFAZER_COB_TERCEIRIZADA_BR','GERAR_CODIGO_LIBERACAO','ENVIAR_PARA_COBRANÇA')
                and not exists ( select 1
                                 from usuarios u
                                 where usuario = v('APP_USER')
                                   and idgerente = 80 )
                ```
        }
    )

