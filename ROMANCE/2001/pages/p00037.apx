                delete roman.classificacoesnotasvendas cl
                where cl.idnotavenda = :P37_IDNOTAVENDA
                  and cl.idcaracteristicanotavenda = 59;
                  
                insert into roman.observacoesnotasvendas (idobsnotavenda,
                                                          idnotavenda,
                                                          data,
                                                          observacao,
                                                          usuario)
                values ( roman.seq_idobsnotavenda.nextval
