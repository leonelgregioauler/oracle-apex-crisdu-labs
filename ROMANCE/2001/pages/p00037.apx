    button inclui-correcao (
        buttonName: INCLUI_CORRECAO
        label: Efetuar Correção
        layout {
            sequence: 140
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 40
                items: {
                    P40_IDNOTAVENDA: &P37_IDNOTAVENDA.
                    P40_IDCORRECAONOTAVENDA:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento  u
                where :P37_IDNOTAVENDA is not null
                  and nvl(:P37_ENVIADOCOBRANCA,'N') = 'N'
                  and ( pck_util.fnc_verificaacesso(3540,v('APP_USER')) = 'N'
                    or ( pck_util.fnc_verificaacesso(2302,v('APP_USER')) = 'S'
                      and pck_util.fnc_verificaacesso(3540,v('APP_USER')) = 'S' ) )
                  and not exists ( select 1
                                   from classificacoesnotasvendas cn
                                   where cn.idnotavenda = :P37_IDNOTAVENDA
