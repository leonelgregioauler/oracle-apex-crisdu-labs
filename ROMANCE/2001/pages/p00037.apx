    pageItem P37_IDVENDEDORA (
        type: selectList
        label {
            label: Cliente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value
                     , return_value
                from (  select initcap(nvl(p.apelido, p.nomepessoa)) || ' (ID: '||v.idvendedora||')' display_value
                             , v.idvendedora                     return_value
                        from pessoas p
                           , vendedoras v
                        where p.idpessoa                    = v.idpessoa
                          and v.idvendedora                 = :P37_IDVENDEDORA
                        union
                        select initcap(nvl(p.apelido, p.nomepessoa)) || ' (ID: '||v.idvendedora||')' display_value
                             , v.idvendedora                     return_value
                        from pessoas p
                           , vendedoras v
                        where p.idpessoa                    = v.idpessoa
                          and v.idrepresentante             = :P37_IDREPRESENTANTE
                          and :P37_IDVENDEDORA              is null 
                        )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione a Vendedora -
        }
        cascadingLov {
            parentItems: [
                P37_IDREPRESENTANTE
                P37_IDREGIAOVENDA
                P37_SEMANADISTRIBUICAO
            ]
        }
        layout {
            sequence: 260
            region: @cadastro-de-nota-de-venda
            slot: regionBody
            alignment: left
            columnAttributes: readonly
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDVENDEDORA
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P37_IDNOTAVENDA
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P37_LIBERANOTACOBRANCA (
        type: textField
        label {
            label: Cod. Libera Nota Cobrança
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 100
            region: @cadastro-de-nota-de-venda
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: readonly style="text-align:right"
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vcodigoliberacao varchar2(30);
                begin
                  --
                  select c.codigoliberacao
                  into vcodigoliberacao
                  from vw_codigosliberacoes_cob c
                  where c.idnotavenda = :P37_IDNOTAVENDA;
                  --
                  return vcodigoliberacao;
                  --
                exception
                  when others then
                    return 'Sem Código Gerado ou Expirado!';
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.notasvendas n
                where idnotavenda = :P37_idnotavenda
                  and nvl(n.enviadocobranca,'N') = 'N'
                  and trunc(sysdate) - trunc(datadesfeitoenviocobranca) <= 10
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

