                      :P37_IDSITUACAONOTAVENDA := to_number(:P37_IDSITUACAONOTAVENDA)+1;
                    end if;
                      :P37_IDSITUACAONOTAVENDA := to_number(:P37_IDSITUACAONOTAVENDA)+1;
