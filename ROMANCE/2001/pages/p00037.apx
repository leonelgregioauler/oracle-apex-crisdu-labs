    button identificar-enchente (
        buttonName: IDENTIFICAR_ENCHENTE
        label: Impactada pela Enchente
        layout {
            sequence: 310
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--stretch
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from vendedoras v
                   , pessoas p
                   , notasvendas nv
                   , cidades c
                where nv.idnotavenda = :P37_IDNOTAVENDA
                  and v.idvendedora = nv.idvendedora
                  and v.idpessoa = p.idpessoa
                  and p.idcidade = c.idcidade
                  and c.idestado = 43
                  and not exists ( select 1
                                   from classificacoesnotasvendas cn
                                   where cn.idnotavenda = nv.idnotavenda
                                     and cn.idcaracteristicanotavenda = 68 )
                  and ( v('APP_USER') in ('GUILHERME','LUCASRAMOS')
                     or exists ( select 1
                                 from usuarios u
                                 where u.usuario = v('APP_USER') 
                                   and u.idgerente in (20,21) ) )
                ```
        }
    )

