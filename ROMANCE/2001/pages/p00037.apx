    process altera-representante-atende (
        name: Altera Representante Atende
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidregiaovenda number;
                  vidcaracteristica number := 7;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);
                begin
                  --
                  begin
                    --
                    select r.idregiaovenda
                    into vidregiaovenda
                    from regioesrepresentantes r
                    where r.idrepresentante = nvl(:P37_IDREPRESENTANTEATENDE,:P37_IDREPRESENTANTE)
                      and r.semana = :P37_SEMANACOBRANCA;
                    --
                  exception
                    when others then
                      --
                      begin
                          select r.idregiaovenda
                          into vidregiaovenda
                          from regioesrepresentantes r
                          where r.idrepresentante = nvl(:P37_IDREPRESENTANTEATENDE,:P37_IDREPRESENTANTE)
                            and r.idsemana = ( select min(rr.idsemana)
                                               from regioesrepresentantes rr
                                               where rr.idrepresentante = r.idrepresentante );
                      exception
                        when others then
                          null;
                      end;
                      --
                  end;
                  --
                  if :P37_IDREPRESENTANTEATENDE is not null then 
                    --
                    update notasvendas 
                    set idrepresentanteatende = :P37_IDREPRESENTANTEATENDE
                      , idregiaovenda         = vidregiaovenda
                    where idnotavenda = :P37_IDNOTAVENDA;
                    --
                    update vendedoras 
                    set idrepresentante = NVL(:P37_IDREPRESENTANTEATENDE, :P37_IDREPRESENTANTE)
                      , idregiaovenda   = vidregiaovenda
                    where idvendedora = :P37_IDVENDEDORA;
                    --
                    insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao,idrepresentante)
                    values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Nota marcada para o distribuidor: '||pck_romance.fnc_nomerepresentante(:P37_IDREPRESENTANTEATENDE)||' realizar o atendimento',:P37_IDNOTAVENDA,'C',:P37_IDREPRESENTANTEATENDE);
                    --
                    select idusuario
                    into vidusuario
                    from usuarios
                    where usuario = v('APP_USER');
                    --
                    pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                    pidnotavenda => :P37_IDNOTAVENDA,
                                                                    pidcaracteristicanotavenda => vidcaracteristica,
                                                                    pdataclassificado => vdataclassificado,
                                                                    pidusuario => vidusuario,
                                                                    pidvalorcaracteristica => :P37_IDREPRESENTANTEATENDE,
                                                                    pobservacao => vobservacao,
                                                                    poperacao_dml => 'I');
                    --
                  elsif :P37_IDREPRESENTANTEATENDE is null then
                    --
                    update notasvendas 
                    set idrepresentanteatende = :P37_IDREPRESENTANTEATENDE
                      , idregiaovenda         = vidregiaovenda
                    where idnotavenda = :P37_IDNOTAVENDA;
                    --
                    update vendedoras 
                    set idrepresentante = :P37_IDREPRESENTANTE
                      , idregiaovenda   = vidregiaovenda
                    where idvendedora = :P37_IDVENDEDORA;
                    --
                    insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao,idrepresentante)
                    values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Retirado Distribuidor(a) que iria realizar o atendimento',:P37_IDNOTAVENDA,'C',:P37_IDREPRESENTANTEATENDE);
                    --
                    select idusuario
                    into vidusuario
                    from usuarios
                    where usuario = v('APP_USER');
                    --
                    vidcaracteristica := 16;
                    --
                    pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                    pidnotavenda => :P37_IDNOTAVENDA,
                                                                    pidcaracteristicanotavenda => vidcaracteristica,
                                                                    pdataclassificado => vdataclassificado,
                                                                    pidusuario => vidusuario,
                                                                    pidvalorcaracteristica => :P37_IDREPRESENTANTEATENDE,
                                                                    pobservacao => vobservacao,
                                                                    poperacao_dml => 'I');
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 220
        }
        successMessage {
            successMessage: Representante atende alterado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 439023887115796031
        }
        serverSideCondition {
            type: request=Value
            value: ALTERAREPRESATENDE
        }
    )

