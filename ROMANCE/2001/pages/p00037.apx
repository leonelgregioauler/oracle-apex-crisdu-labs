    region correções (
        name: Correções
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idcorrecaonotavenda
                     , t.datacorrecao "Data Correção"
                     , decode(t.usuario,'APEX_PUBLIC_USER','netbook',t.usuario) "Usuário"
                     , t.motivo  "Motivo"
                     , decode(nvl(t.situacao,'P'),'P','Pendente','R','Rejeitado','C','Corrigido') "Situação"
                     , decode( nvl(t.situacao,'P'),'P','<a href="javascript: fnc_confirma('||t.idcorrecaonotavenda||')" ><img src="/i/menu/pencil16x16.gif"  border="0"></a>'
                                         ,'-') "Confirmar"
                     , decode( nvl(t.situacao,'P'),'P','<a href="javascript: fnc_rejeita('||t.idcorrecaonotavenda||')" ><img src="/i/menu/pencil16x16.gif"  border="0"></a>'
                                         ,'-') "Rejeitar"
                     , t.usuarioalteracao
                from correcoesnotasvendas t
                where IDNOTAVENDA = :P37_IDNOTAVENDA
                order by 1
                ```
        }
        layout {
            sequence: 70
            slot: body
            startNewRow: false
            newColumn: false
