    region itens-da-nota (
        name: Itens da Nota
        type: tabform
        source {
            sqlQuery:
                ```sql
                select i.iditemnotavenda
                     , i.idnotavenda
                     , i.idestoquefil
                     , epc.codigosisdist
                     , Produto
                     , decode(i.comissao,'S','Sim','N','Não') "Comissão"
                     , i.valorvenda
                     , i.quantidade
                     , i.quantidade qtddistribuida
                     , i.qtddevolvida qtddevolvidadisplay
                     , i.qtddevolvida
                     , i.quantidade - nvl(i.qtddevolvida,0) qtdvendida
                     , nvl((quantidade * valorvenda),0) "Valor Total Nota"
                     , nvl(((quantidade - qtddevolvida) * valorvenda),0) "Valor Total Venda"
                     , nvl((qtddevolvida * valorvenda),0) "Valor Total Devolvido"
                from itensnotavenda i
                   , ( select p.codigosisdist
                            , initcap(p.nomeproduto) produto
                            , e.idestoquefilial
                       from estoquefilial  e
                          , produtos       p
                       where e.idproduto    = p.idproduto) epc
                where i.idnotavenda       = :P37_IDNOTAVENDA
                  and epc.idestoquefilial = i.idestoquefil
                ```
        }
        layout {
            sequence: 80
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <hr>
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P37_IDNOTAVENDA
        }
        reportLayout {
            numberOfRows: 150
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum item incluido na nota.
        }
