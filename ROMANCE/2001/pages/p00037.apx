    pageItem P37_IDSITUACAONOTAVENDA (
        type: selectList
        label {
            label: Situação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value
                     , return_value
                from (
                    select s.descricao           display_value
                         , s.idsituacaonotavenda return_value
                         , s.ordem
                    from situacoesnotavenda  s
                    where s.idsituacaonotavenda         = :P37_IDSITUACAONOTAVENDA
                      and s.idsituacaonotavenda        not in  (6,7)
                      and nvl(:P37_EDICAOBLOQUEADA,'N') = 'S'
                    union
                    select s.descricao           display_value
                         , s.idsituacaonotavenda return_value
                         , s.ordem
                    from situacoesnotavenda  s
                    where nvl(:P37_EDICAOBLOQUEADA,'N') = 'N'
                      and s.idsituacaonotavenda        not in (6,7)
                    union
                    select s.descricao           display_value
                         , s.idsituacaonotavenda return_value
                         , s.ordem
                    from situacoesnotavenda  s
                    where s.idsituacaonotavenda         = :P37_IDSITUACAONOTAVENDA
                      and s.idsituacaonotavenda         = 6
                      and :P0_IDFILIAL                  = 1117
                      and nvl(:P37_EDICAOBLOQUEADA,'N') = 'S')
                order by ordem
                ```
            displayNullValue: false
        }
        layout {
            sequence: 130
            region: @cadastro-de-nota-de-venda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDSITUACAONOTAVENDA
            used: always
        }
        default {
            type: static
            staticValue: 1
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P37_EDICAOBLOQUEADA = 'S'
                  and :P37_ENVIADOCOBRANCA = 'S'
                union
                select 1
                  from notasvendas nf
                 where nf.idnotavenda = :P37_IDNOTAVENDA
                   and nf.valorpago > 0
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

