                function fnc_popup_edita_produto(pidproduto)
                {vidnotavenda = document.getElementById("P37_IDNOTAVENDA").value;
                window.open('f?p=&APP_ID.:4:&SESSION.::NO::P4_IDNOTAVENDA,P4_IDITEMNOTAVENDA:'+vidnotavenda+','+pidproduto,'CADASTRAITEM', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=700,height=180,left=250,top=100','_blank'); void(0);
                }
                
                function fnc_popup_correcao()
                {vidnotavenda = document.getElementById("P37_IDNOTAVENDA").value;
                window.open('f?p=&APP_ID.:40:&SESSION.::NO::P40_IDNOTAVENDA,P40_IDCORRECAONOTAVENDA:'+vidnotavenda+',','CORRECAO', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=250,left=250,top=100','_blank'); void(0);
