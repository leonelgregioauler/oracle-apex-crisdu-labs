    pageItem P37_COD_LIBERACAO (
        type: textField
        label {
            label: Cod Para Liberação Tablet
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 120
            region: @cadastro-de-nota-de-venda
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 8
        }
        validation {
            maxLength: 2000
        }
        advanced {
            customAttributes: readonly style="text-align:right"
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vcodigo varchar2(50);
                  --
                begin
                  --
                  select codigoliberacao
                  into vcodigo
                  from vw_liberacoesnotasvendas c
                  where c.idnotavenda = :P37_IDNOTAVENDA;
                  --
                  return vcodigo;
                  --
                exception 
                  when others then
                    return 'Cód. Não Existente ou Já Utilizado!';
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from notasvendas n
                where n.idnotavenda = :P37_IDNOTAVENDA
                  and nvl(enviadocobranca,'N') = 'N'
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

