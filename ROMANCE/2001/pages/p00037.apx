            region: @cadastro-de-nota-de-venda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        source {
            type: staticValue
            staticValue: <font color="red"><h1>Nota enviada para Cobrança SS! Não altere nenhuma informação!</font></h1>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from classificacoesnotasvendas c
                               where c.idnotavenda = :P37_IDNOTAVENDA
                                 and c.idcaracteristicanotavenda = 30 )
                  and not exists ( select 1
                                   from classificacoesnotasvendas c
                                   where c.idnotavenda = :P37_IDNOTAVENDA
                                     and c.idcaracteristicanotavenda = 31 )
                
                ```
        }
        security {
            encryptSessionState: false
        }
    )

