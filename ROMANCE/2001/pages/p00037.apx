    process atualiza-edição-bloqueada (
        name: Atualiza Edição Bloqueada
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update notasvendas nv
                  set nv.edicaobloqueada = 'S'
                  where nv.idnotavenda = :P37_IDNOTAVENDA
                    and nvl(nv.enviadocobranca,'N') = 'S'
                    and nv.edicaobloqueada = 'N';
                  --
                  update notasvendas nv
                  set nv.edicaobloqueada = 'N'
                  where nv.idnotavenda = :P37_IDNOTAVENDA
                    and nvl(nv.enviadocobranca,'N') = 'N'
                    and nv.edicaobloqueada = 'S'
                    and exists ( select 1
                                 from correcoesnotasvendas cn
                                 where cn.idnotavenda = nv.idnotavenda
                                   and nvl(cn.situacao,'P') = 'P' );
                  --
                  update notasvendas nv
                  set nv.edicaobloqueada = 'S'
                  where nv.idnotavenda = :P37_IDNOTAVENDA
                    and nvl(nv.enviadocobranca,'N') = 'N'
                    and nv.edicaobloqueada = 'N'
                    and not exists ( select 1
                                     from correcoesnotasvendas cn
                                     where cn.idnotavenda = nv.idnotavenda
                                       and nvl(cn.situacao,'P') = 'P' );
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 240
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 4547028590386037246
        }
    )

    process atualizar-situação-cobrança (
        name: Atualizar Situação Cobrança
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vsituacao     number;
                  vsemana       varchar2(10);
                  vnomesituacao varchar2(100);
                begin
                  --
                  if v('REQUEST') = 'EM_NEGOCIACAO' then
                    vsituacao := 20;
                  elsif v('REQUEST') = 'DOCUMENTACAO' then
                    vsituacao := 50;
                  elsif v('REQUEST') = 'INCOBRAVEL' then
                    vsituacao := 60;
                  elsif v('REQUEST') = 'DISTRIBUIDOR_RECEBEU_RESP' then
                    vsituacao := 70;
                  end if;
                  --
                  select situacao
                  into vnomesituacao
                  from situacoescobranca 
                  where idsituacao = vsituacao;
                  --
                  update notasvendas n
                  set n.idsituacaocobranca = vsituacao
                  where n.idnotavenda = :P37_IDNOTAVENDA;
                  --
                  select pck_util.fnc_semanaid(pck_util.fnc_idsemanadata(sysdate)) semana
                  into vsemana
                  from dual;
                  --
                  insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao,idrepresentante)
                  values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Situação Cobrança: '||vnomesituacao||', atualizada na semana: '||vsemana,:P37_IDNOTAVENDA,'C',:P37_IDREPRESENTANTE);
                  --
                end;
                ```
        }
        execution {
            sequence: 280
        }
        successMessage {
            successMessage: Situação atualizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1405437965729756632
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('DOCUMENTACAO','INCOBRAVEL','DISTRIBUIDOR_RECEBEU_RESP','EM_NEGOCIACAO')
                ```
        }
    )

    process atualizar-situação-cobrança-de-desfazer (
