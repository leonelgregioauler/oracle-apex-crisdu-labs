    pageItem P37_PEDIDOFAVORITA (
        type: textField
        label {
            label: Pedido Fav.
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 430
            region: @cadastro-de-nota-de-venda
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 4000
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  -- 
                  vnumeroped number;
                  vverifica number := 0;
                  --
                begin
                  --
                  begin
                  --
                  select nrpedido
                  into vnumeroped
                  from pedidos
                  where idnotavenda = :P37_IDNOTAVENDA;
                  --
                  exception
                  when others then
                      begin
                      --
                      select count(fp.idpedido)
                      into  vverifica
                      from  favorita.pedidos fp
                      where fp.idnotavenda = :P37_IDNOTAVENDA;
                      --
                      if vverifica > 1 then
                        --
                        raise_application_error(-20001,'Atenção! Nota Está vinculado e mais de um pedido.');
                        --
                      end if;
                      --
                      select fp.idpedido
                      into  vnumeroped
                      from  favorita.pedidos fp
                      where fp.idnotavenda = :P37_IDNOTAVENDA;        
                      --
                      exception
                      --
                      when no_data_found then
                      vnumeroped := NULL;
                      -- 
                      end;
                  end;
                  --
                
                  return vnumeroped;
                  --
                end;
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from parametrosnetbook p
                where nome = 'TIPOCOMISSAO'
                  and valor = 'F'
                  and p.idfilial = :P0_IDFILIAL
                ```
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P37_PEDIDOFAVORITA is not null
                  and :P0_LIBERAR40COMPEDIDO = 'N'
                union
                select 1
                from notasvendas 
                where enviadocobranca = 'S'
                  and idnotavenda = :P37_IDNOTAVENDA
                  and exists ( select 1
                               from catal.usuarios
                               where idgerente != 80 --Adriana de Castro Berger (Cobranca Interna)
                                 and usuario = v('APP_USER'))
                  and exists ( select 1 -- ticket 9450041
                                 from roman.usuariosgruposatendimento g
                                where g.idgrupoatendimento = 73 --Prevenção de Perdas
                                  and g.usuario = v('APP_USER'))
                ```
        }
        security {
            encryptSessionState: false
        }
    )

