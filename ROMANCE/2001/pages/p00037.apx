    button cedencia-divida (
        buttonName: CEDENCIA_DIVIDA
        label: Cêdencia de Dívida
        layout {
            sequence: 220
            region: @ações-cobrança
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
