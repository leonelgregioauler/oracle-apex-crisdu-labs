    process vender-tudo (
        name: Vender Tudo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcaracteristica number;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);
                begin
                  --
                  update itensnotavenda i
                  set i.qtddevolvida = 0
                  where i.idnotavenda = :P37_IDNOTAVENDA
                    and i.qtddevolvida is null;
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P37_IDNOTAVENDA,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidvalorcaracteristica,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 140
        }
        advanced {
            executionMappingIdentifier: 353086776648856910
        }
        serverSideCondition {
            type: request=Value
            value: VENDATOTAL
        }
    )

