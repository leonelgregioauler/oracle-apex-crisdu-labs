    validation valida-acerto-sem-semana-de-fechamento-na-empresa (
        name: Valida acerto sem semana de fechamento na empresa
        execution {
            sequence: 160
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P37_IDSITUACAONOTAVENDA = 4 
                  and v('REQUEST') = 'SAVE'
                  and not exists ( select 1
                                   from fechamentossemanais f
                                   where f.idfilial = :P0_IDFILIAL
                                     and f.semana   = :P37_SEMANACOBRANCA )
                ```
        }
        error {
            errorMessage: Não é possível acertar a nota na semana de cobrança atual, não existe um Fechamento em aberto nesta semana na Empresa! Remarque a mesma e realize de novo o acerto.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P37_IDSITUACAONOTAVENDA = 4 
                  and v('REQUEST') = 'SAVE'
                  and exists ( select 1
                               from notasvendas nv
                               where nv.idnotavenda = :P37_IDNOTAVENDA 
                                 and nv.idsituacaonotavenda = 3 )
                ```
        }
    )

    validation valida-antecipação-de-nota (
        name: Valida Antecipação de nota
        execution {
            sequence: 180
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from notasvendas nv
                where nv.idnotavenda = :P37_IDNOTAVENDA
                  and nv.idsemanadistribuicao = ( select i.idsemana
                                                  from imptablettoservidor i
                                                  where i.idrepresentante = nv.idrepresentante
                                                    and i.idimp = ( select max(idimp)
                                                                    from imptablettoservidor ii
                                                                    where ii.idrepresentante = nv.idrepresentante
                                                                      and ii.processo        = 'L' ) )
                ```
        }
        error {
            errorMessage: "Não é possível antecipar uma nota que foi distribuída na semana atual do distribuidor! "
        }
        serverSideCondition {
            type: request=Value
            value: ADIANTAR_ATENDIMENTO_NOTA
        }
    )

