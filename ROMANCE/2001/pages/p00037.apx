    process atualiza-correções-com-tempo-limite-excedido (
        name: "Atualiza correções com tempo limite  excedido.  "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update correcoesnotasvendas c
                    set    c.motivo = c.motivo||'       Rejeitado automaticamente, tempo limite excedido.',
                           c.situacao = 'R'
                    where  c.idnotavenda = :P37_IDNOTAVENDA 
                    and    trunc(c.datacorrecao) <= trunc(sysdate) - 10
                    and    c.situacao = 'P';   
                end;
                ```
        }
