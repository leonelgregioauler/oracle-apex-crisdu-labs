    pageItem P37_SESSION (
        type: hidden
        layout {
            sequence: 270
            region: @cadastro-de-nota-de-venda
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2001;
                    l_session number := v('APP_SESSION');
                    vidpessoa number;
                BEGIN
                    select idpessoa
                    into vidpessoa
                    from vendedoras where idvendedora = :P37_IDVENDEDORA;
                    
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':8:'||l_session||'::NO::P8_IDPESSOA:'||vidpessoa,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P37_IDNOTAVENDA
        }
        security {
            encryptSessionState: false
        }
    )

