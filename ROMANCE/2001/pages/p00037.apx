    region assinaturas-realizadas (
        name: Assinaturas Realizadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.datarealizada
                     , a.desctipoassinatura tipo
                     , case
                         when a.tipoassinatura = 'T' then
                           a.cpf_terceiro||' - '||a.nome_terceiro
                         else
                           '-'
                       end dadosterceiros
                     , a.dataavaliacao
                     , a.descsituacao situacao
                     , a.link
                from vw_assinaturas_eletronicas a
                where a.idnotavenda = :P37_IDNOTAVENDA
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent9
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from assinaturaseletronicas a
                where a.idnotavenda = :P37_IDNOTAVENDA
                  and a.status = 'C'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5589907937619058234
        }

