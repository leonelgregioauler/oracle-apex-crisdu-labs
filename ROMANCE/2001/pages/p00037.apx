    pageItem P37_RESPONSAVELCOBRANCA (
        type: selectList
        label {
            label: Responsável cobrança
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select d
                      , r 
                from (select u.usuario d
                           , u.usuario r
                           , 1  tipo
                      from catal.usuarios u
                      where u.ativo = 'S'
                        and u.idgerente = 80
                        and exists( select 1
                                    from roman.usuariosgruposatendimento g
                                    where g.usuario = u.usuario
                                      and g.idgrupoatendimento = 3)
                        and u.idusuario in (5797,5755,549)
                 union all
                     Select u.usuario d
                          , u.usuario r
                          , 2 tipo
                     from catal.usuarios u
                     where u.ativo = 'S'
                       and u.idgerente = 80
                       and exists( select 1
                                   from roman.usuariosgruposatendimento g
                                   where g.usuario = u.usuario
                                     and g.idgrupoatendimento = 3)
                       and u.idusuario not in (442,5797,549)
                
                      order by 3,1 )
                ```
        }
        layout {
            sequence: 190
            region: @cadastro-de-nota-de-venda
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: RESPONSAVELCOBRANCA
            used: always
        }
        readOnly {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2337,v('APP_USER')) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

