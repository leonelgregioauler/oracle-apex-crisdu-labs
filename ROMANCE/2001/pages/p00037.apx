        }
    )

    process conclui (
        name: Conclui
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  :P37_EDICAOBLOQUEADA := 'S';
                  --
                  if :P37_IDSITUACAONOTAVENDA = 2 then
                    delete itensnotavenda ii
                    where ii.quantidade is null
                      and exists ( select 1
                                   from notasvendas n
                                   where n.idsituacaonotavenda = 2 /*distribuida*/ 
                                     and n.idnotavenda = :P37_IDNOTAVENDA
                                     and n.idnotavenda = ii.idnotavenda );
                  end if; 
                end;
                ```
        }
        execution {
            sequence: 110
        }
        advanced {
            executionMappingIdentifier: 19039167642141764
        }
        serverSideCondition {
