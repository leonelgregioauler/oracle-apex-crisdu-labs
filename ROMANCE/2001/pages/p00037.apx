    button adiantar-atendimento-nota (
        buttonName: ADIANTAR_ATENDIMENTO_NOTA
        label: Adiantar Cobrança da Nota
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: confirmaantecipacao();
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where nvl(:P37_ENVIADOCOBRANCA,'N') = 'N'
                  and :P37_IDSITUACAONOTAVENDA = 3
                  and not exists ( select 1
                                   from liberacoesnotasvendas l
                                   where l.idnotavenda = :P37_IDNOTAVENDA
                                     and nvl(l.codigousado,'N') = 'N' )
                  and ( pck_util.fnc_verificaacesso(3540,v('APP_USER')) = 'N'
                     or ( pck_util.fnc_verificaacesso(2302,v('APP_USER')) = 'S' 
                        and pck_util.fnc_verificaacesso(3540,v('APP_USER')) = 'S' ) )
                  and not exists ( select 1
                                   from classificacoesnotasvendas cn
                                   where cn.idnotavenda = :P37_IDNOTAVENDA
                                     and cn.idcaracteristicanotavenda = 34 )
                ```
        }
    )

    button alterar-regiao (
        buttonName: ALTERAR_regiao
