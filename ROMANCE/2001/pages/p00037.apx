            plsqlFunctionBody:
                ```plsql
                declare 
                  --
                  vvalor number(15,2);
                  --
                begin
                  --
                  select pck_util.fnc_calculajuros_v2( p_valor_debito => n.saldo,
                                                       p_data_venc    => n.dataretornoorig,
                                                       p_data_calc    => sysdate,
                                                       p_idpais       => catal.pck_util.fnc_paisvendedora(pidvendedora => n.idvendedora))
                  into vvalor
                  from notasvendas n
                  where n.idnotavenda = :P37_IDNOTAVENDA; 
                  --
                  return(vvalor);
                  --
                end;
                ```
