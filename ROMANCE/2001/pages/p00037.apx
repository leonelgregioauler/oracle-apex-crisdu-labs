                #DEFAULT#
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where exists ( select 1
                               from roman.notasvendas nv
                               where nv.idnotavenda = :P37_IDNOTAVENDA
                                 and nv.saldo > 0 
                                 and nv.idsituacaonotavenda = 4
                                 and not exists ( select 1
                                                  from roman.classificacoesnotasvendas cl
                                                  where cl.idnotavenda = nv.idnotavenda
                                                    and cl.idcaracteristicanotavenda = 59))
                  and exists ( select 1
                               from roman.usuariosgruposatendimento u
                               where u.usuario = v('APP_USER')
                                 and u.idgrupoatendimento = 73 )
                ```
        }
