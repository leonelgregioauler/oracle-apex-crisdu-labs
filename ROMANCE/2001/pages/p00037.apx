    process aplica-comissão-com-pedido (
        name: Aplica Comissão com Pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcaracteristica         number := 9;
                  vidclassificacaonotavenda number;
                  vdataclassificado         date := sysdate;
                  vidusuario                number;
                  vidvalorcaracteristica    number;
                  vobservacao               varchar2(1000);
                  vpedido                   varchar2(100) := trim(:P37_PEDIDOFAVORITA);
                  vpedidovinculado          varchar2(100);
                  vqtdvinculado             number := 0;
                begin
                  --
                  -- Pedido informado deve conter somente números
                  --
                  if not regexp_like(vpedido, '^[0-9]+$') then
                    raise_application_error(-20001, 'Pedido informado inválido: "'||vpedido||'". Informe somente o número do pedido.');
                  end if;
                  --
                  vidvalorcaracteristica := to_number(vpedido);
                  --
                  -- Verifica se a nota já possui pedido vinculado (Favorita ou Catal)
                  --
                  select max(pedido)
                  into vpedidovinculado
                  from ( select to_char(fp.idpedido) pedido
                         from favorita.pedidos fp
                         where fp.idnotavenda = :P37_IDNOTAVENDA
                         union all
                         select cp.nrpedido
                         from catal.pedidos cp
                         where cp.idnotavenda = :P37_IDNOTAVENDA );
                  --
                  if vpedidovinculado is not null then
                    --
                    -- Nota já possui pedido: se for outro pedido, bloqueia (cada nota aceita somente um pedido)
                    --
                    if vpedidovinculado != vpedido
                   and vpedidovinculado != '21233'||lpad(vpedido,12,'0')
                   and vpedidovinculado != '2846474'||lpad(vpedido,10,'0') then
                      --
                      raise_application_error(-20001, 'Esta nota já possui o pedido '||vpedidovinculado||' vinculado. Cada nota aceita somente um pedido. Para trocar, utilize "Desvincular Pedido".');
                      --
                    end if;
                    --
                    -- Mesmo pedido já vinculado (nota apenas salva novamente): não faz nada
                    --
                  else
                    --
                    -- Nota sem pedido: vincula o pedido informado (deve estar livre)
                    --
                    if to_number(vpedido) < 3000000 then
                      --
                      update catal.pedidos p
                      set idnotavenda = :P37_IDNOTAVENDA
                      where ( p.nrpedido = '21233'||lpad(vpedido,12,'0')
                           or p.nrpedido = '2846474'||lpad(vpedido,10,'0') )
                        and p.idvendedora = :P37_IDVENDEDORA
                        and p.idnotavenda is null;
                      --
                      vqtdvinculado := sql%rowcount;
                      --
                    else
                      --
                      update favorita.pedidos fp
                      set fp.idnotavenda = :P37_IDNOTAVENDA
                      where fp.idpedido = to_number(vpedido)
                        and fp.idvendedora = :P37_IDVENDEDORA --ticket 16726808, antes as filiais estavam conseguindo vincular pedidos de outras clientes na nota
                        and fp.idnotavenda is null;
                      --
                      vqtdvinculado := sql%rowcount;
                      --
                    end if;
                    --
                    if vqtdvinculado = 0 then
                      raise_application_error(-20001, 'Pedido '||vpedido||' não encontrado, de outra consultora ou já vinculado a outra nota. Os 40% não foram aplicados.');
                    end if;
                    --
                    -- Registra o vínculo em uma nova classificação 9
                    -- (classificações anteriores são mantidas como histórico)
                    --
                    select idusuario
                    into vidusuario
                    from usuarios
                    where usuario = v('APP_USER');
                    --
                    pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda  => vidclassificacaonotavenda,
