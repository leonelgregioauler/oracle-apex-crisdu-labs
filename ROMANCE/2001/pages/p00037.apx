    button enviar-pap (
        buttonName: ENVIAR_PAP
        label: Enviar PAP
        layout {
            sequence: 80
            region: @ações-cobrança
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--simple
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual 
                where exists ( select 1 
                               from roman.classificacoesnotasvendas cc
                                where cc.idnotavenda = :P37_IDNOTAVENDA
                                  and pck_util.fnc_verificaacesso(3540,v('APP_USER')) = 'S'
                                  and cc.idcaracteristicanotavenda != 50
                                  and cc.dataclassificado = ( select max(c.dataclassificado)
                                                               from roman.classificacoesnotasvendas c
                                                               where c.idcaracteristicanotavenda in (50,51) 
                                                                 and c.idnotavenda = :P37_IDNOTAVENDA )   
                                  and not exists ( select 1 
                                                   from roman.classificacoesnotasvendas cl
                                                   where cl.idnotavenda = cc.idnotavenda
                                                     and cl.idcaracteristicanotavenda = 32 )  
                                  and exists ( select 1
                                               from vw_filiais f
                                               where f.idfilial = :P0_IDFILIAL) 
                               union 
                               select 1 
                               from roman.classificacoesnotasvendas cc
                               where cc.idnotavenda = :P37_IDNOTAVENDA 
                                 and pck_util.fnc_verificaacesso(3540,v('APP_USER')) = 'S'
                                 and not exists ( select 1 
                                                  from roman.classificacoesnotasvendas cl
                                                  where cl.idnotavenda = cc.idnotavenda
                                                    and cl.idcaracteristicanotavenda in (32,50) ) 
                                 and exists ( select 1
                                               from vw_filiais f
                                               where f.idfilial = :P0_IDFILIAL ) )
                ```
        }
    )

