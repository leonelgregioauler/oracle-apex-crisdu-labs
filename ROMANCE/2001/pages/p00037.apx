                function fnc_popup_alterar()
                {vidnotavenda = document.getElementById("P37_IDNOTAVENDA").value;
                window.open('f?p=&APP_ID.:127:&SESSION.::NO::P127_IDNOTAVENDA,P127_FECHAR:'+vidnotavenda+',N','ALTERACAO', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=200,left=200,top=100','_blank'); void(0);
                }
                
                function fnc_popup_remarcar()
                {vidnotavenda = document.getElementById("P37_IDNOTAVENDA").value;
                window.open('f?p=&APP_ID.:129:&SESSION.::NO::P129_IDNOTAVENDA,P129_FECHAR:'+vidnotavenda+',N','ALTERACAO', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=200,left=200,top=100','_blank'); void(0);
                }
                
                
                function formatar_mascara(src,mascara,evt){
                var tecla;  
                if(evt.which){tecla = evt.which}
                else if(evt.keyCode){ tecla = evt.keyCode;}  
                 if( tecla != 8 ){
                 var campo = src.value.length;
                 var saida = mascara.substring(0,1);
                 var texto = mascara.substring(campo);
                 if(texto.substring(0,1) != saida) {
                 src.value+=texto.substring(0,1);}}
                }
                
                
                function fnc_confirma(pid)
                {
                  document.getElementById('P37_IDCORRECAO').value = pid;
                  apex.submit('CONFIRMAR');
                }
                
                function fnc_rejeita(pid)
                {
                  document.getElementById('P37_IDCORRECAO').value = pid;
                  apex.submit('REJEITAR');
                }
                </script>
