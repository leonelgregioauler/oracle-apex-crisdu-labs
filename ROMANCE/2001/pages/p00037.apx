    process enviar-prevenção (
        name: Enviar Prevenção
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcaracteristica number := 50;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);
                  vtelefone varchar2(30);
                  vexiste varchar2(1);
                  
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  vidvalorcaracteristica := pck_util.fnc_idsemanadata(sysdate);
                  --
                  
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P37_IDNOTAVENDA,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidvalorcaracteristica,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                    --
                  begin
                    --
                    select translate(t.telefone,'0123456789AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvXxYyWwZz_-,.  !@#$%?&*()/??','0123456789') telefone
                    into vtelefone
                    from telefonespessoas t
                    where t.idpessoa = :P37_IDPESSOA
                      and rownum = 1;
                    --
                  exception 
                    when NO_DATA_FOUND then
                      vtelefone := null;
                  end;
                  --
                  begin
                      --
                      select 'S'
                      into vexiste
                      from favorita.tarefas t
                      where t.idpessoa = :P37_IDPESSOA
                        and t.idtipotarefa = 69
                        and t.idsituacao in (0,10,20)
                        and t.idgrupoatendimento = 73;
                    exception 
                      when others then
                        vexiste := 'N';
                  end;
                    --
                    if vexiste = 'N' then
                      --
                      insert into favorita.tarefas ( idtarefa            , datainclusao    , idsituacao
                                                   , observacao          , idtipotarefa    , idpessoa
                                                   , idgrupoatendimento  , telefone        , idusuario
                                                   , idcanalatendimento )
                      values ( favorita.seq_idtarefa.nextval ,   sysdate ,  0
                             , pck_util.fnc_retornatelefones(:P37_IDPESSOA) , 69  , :P37_IDPESSOA
                             , 73 , vtelefone , :P0_IDUSUARIO, 4 ); 
                      --
                    end if;
                    --
                end;
                ```
        }
        execution {
            sequence: 450
        }
        successMessage {
            successMessage: Nota enviada para área de prevenção de perdas!
        }
        advanced {
            executionMappingIdentifier: 32980599579069115
        }
        serverSideCondition {
            whenButtonPressed: @enviar-pap
        }
    )

