    pageItem P37_IDREGIAOVENDA (
        type: selectList
        label {
            label: Região
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.descricao display_value
                     , r.idregiaovenda return_value
                from regioesvenda r
                   , regioesrepresentantes rr
                where r.idregiaovenda    = rr.idregiaovenda
                  and rr.idrepresentante = :P37_IDREPRESENTANTE
                  and (rr.semana          = :P37_SEMANADISTRIBUICAO
                    or rr.semana          = pck_romance.fnc_semanacobranca(:P37_SEMANADISTRIBUICAO))
                  and :P37_IDNOTAVENDA is null
                union
                select r.descricao display_value
                     , r.idregiaovenda return_value
                from regioesvenda r
                where r.idregiaovenda    = :P37_IDREGIAOVENDA
                  and :P37_IDNOTAVENDA is not null
                order by 1
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P37_IDREPRESENTANTE
                P37_SEMANADISTRIBUICAO
            ]
        }
        layout {
            sequence: 280
            region: @cadastro-de-nota-de-venda
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREGIAOVENDA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P37_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value
                     , return_value
                from (  select pck_romance.fnc_nomepessoa(r.idpessoa)||' - '||idrepresentante display_value
                             , r.idrepresentante                     return_value
                        from representantes r
                        where r.idrepresentante             = :P37_IDREPRESENTANTE
                          and nvl(:P37_EDICAOBLOQUEADA,'N') = 'S' 
                        union
                        select pck_romance.fnc_nomepessoa(r.idpessoa)||' - '||idrepresentante display_value
                             , r.idrepresentante                     return_value
                        from representantes r
                        where r.idgerente                   = ( select idgerente
                                                                from gerentes u
                                                                where u.idfilial = :P0_IDFILIAL ) 
                          and nvl(:P37_EDICAOBLOQUEADA,'N') = 'N' )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o Distribuidor -
        }
        layout {
            sequence: 210
            region: @cadastro-de-nota-de-venda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P37_IDNOTAVENDA
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P37_IDREPRESENTANTEATENDE (
        type: selectList
        label {
            label: Distribuidor Atende
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value
                     , return_value
                from (  select initcap( p.nomepessoa)||'-'||r.idrepresentante display_value
                             , r.idrepresentante                     return_value
                        from pessoas p
                           , representantes r
                        where p.idpessoa                    = r.idpessoa
                          and r.idrepresentante             = :P37_IDREPRESENTANTEATENDE
                          and nvl(:P37_EDICAOBLOQUEADA,'N') = 'S' 
                          and r.ativo                       = 'S'
                        union
                        select initcap( p.nomepessoa)||'-'||r.idrepresentante display_value
                             , r.idrepresentante                     return_value
                        from pessoas p
                           , representantes r
                        where p.idpessoa                    = r.idpessoa
                          and r.idrepresentante             != :P37_IDREPRESENTANTE
                          and r.ativo                       = 'S'
                          and r.idgerente                   = ( select idgerente
                                        						from gerentes u
                                        						where u.idfilial = :P0_IDFILIAL
                                                                  and u.ativo = 'S' ))
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o Representante -
        }
        layout {
            sequence: 330
            region: @cadastro-de-nota-de-venda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTEATENDE
            used: always
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from notasvendas nv
                where nv.idnotavenda          = :P37_IDNOTAVENDA
                  and nv.idsituacaonotavenda  = 4
                  and nvl(nv.saldo, 0)       <= 0
                ```
        }
        security {
            encryptSessionState: false
        }
    )

