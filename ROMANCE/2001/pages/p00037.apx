        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(3540,v('APP_USER')) = 'S'
                  or ( pck_util.fnc_verificaacesso(3540,v('APP_USER')) = 'S'
                     and pck_util.fnc_verificaacesso(2302,v('APP_USER')) = 'S' )
                  and not exists ( select 1
                                   from classificacoesnotasvendas cn
                                   where cn.idnotavenda = :P37_IDNOTAVENDA
                                     and cn.idcaracteristicanotavenda = 32 )
                ```
        }
    )

