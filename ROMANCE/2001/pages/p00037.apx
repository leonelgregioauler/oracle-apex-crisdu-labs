    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 40
            region: @cadastro-de-nota-de-venda
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P37_IDNOTAVENDA is not null
                 /* and nvl(:P37_ENVIADOCOBRANCA,'N') = 'N'*/
                  and :P37_EDICAOBLOQUEADA = 'N'
                union
                select 1
                from usuarios u
                where usuario = v('APP_USER')
                  and u.idgerente in ( 80,143,180,257)
                union
                -- ticket 9450041
                select 1
                  from roman.usuariosgruposatendimento g
                 where g.idgrupoatendimento = 73 --Prevenção de Perdas
                   and g.usuario = v('APP_USER')
                ```
        }
    )

