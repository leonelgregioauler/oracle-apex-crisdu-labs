                ```plsql
                declare 
                 vsituacao varchar2(200);
                begin
                  --
                  select descricao
                  into vsituacao
                  from catal.situacoespromissorias
                  where idsituacaopromis = (select idsituacaopromissoria
                                            from notasvendas 
                                            where idnotavenda = :P37_IDNOTAVENDA);
                  --
                  return(vsituacao);
                  --
                end;
                ```
