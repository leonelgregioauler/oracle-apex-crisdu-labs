page 468 (
    name: "Lista de Notas Adicionais "
    title: "Lista de Notas Adicionais "
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region notas-adicionais (
        name: Notas Adicionais
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' irparanota
                     , nv.numeronota
                     , nv.idvendedora
                     , roman.pck_romance.fnc_nomevendedora (nv.idvendedora) Vendedora
                     , roman.pck_romance.fnc_nomerepresentante (nv.idrepresentante) Distribuidor 
                     , na.data
                     , na.semana
                     , count (i.iditemnotaadicional) totaldeprodutos
                     , sum(i.quantidade) quantidadedeitens
                from roman.notasadicionais na
                   , roman.notasvendas nv
                   , roman.itensnotasadicionais i
                where na.idnotavenda = nv.idnotavenda
                  and i.idnotaadicional = na.idnotaadicional
                  and na.idrepresentante = :P468_IDREPRESENTANTE
                  and na.semana = :P468_SEMANA
                group by nv.numeronota
                       , nv.idvendedora
                       , nv.idrepresentante
                       , na.data
                       , na.semana
                       , nv.idnotavenda
                ```
        }
        layout {
            sequence: 20
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 30580779601601023
        }

        column DATA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDVENDEDORA (
            type: plainText
            heading {
                heading: Id Vendedora
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column IRPARANOTA (
            type: plainText
            heading {
                heading: Ir para nota
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NUMERONOTA (
            type: plainText
            heading {
                heading: Nota
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column QUANTIDADEDEITENS (
            type: plainText
            heading {
                heading: Total de Itens
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column TOTALDEPRODUTOS (
            type: plainText
            heading {
                heading: Total de Produtos
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column VENDEDORA (
            type: plainText
            heading {
                heading: Vendedora
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 306325 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATA (
                sequence: 6
            )

            displayColumn DISTRIBUIDOR (
                sequence: 5
            )

            displayColumn IDVENDEDORA (
                sequence: 3
            )

            displayColumn IRPARANOTA (
                sequence: 1
            )

            displayColumn NUMERONOTA (
                sequence: 2
            )

            displayColumn QUANTIDADEDEITENS (
                sequence: 9
            )

            displayColumn SEMANA (
                sequence: 7
            )

            displayColumn TOTALDEPRODUTOS (
                sequence: 8
            )

            displayColumn VENDEDORA (
                sequence: 4
            )

        )

    )

    pageItem P468_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @notas-adicionais
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P468_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @notas-adicionais
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

