page 782 (
    name: Credenciais Capta Leads
    alias: CREDENCIAIS-CAPTA-LEADS
    title: Credenciais Capta Leads
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 90%
        height: 80%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    help {
        helpText: No help is available for this page.
    }

    region credenciaisorigcob (
        name: credenciaisorigcob
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CREDENCIAISORIGCOB
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1072905694073467201
        }

        savedReport 10729113 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDCREDENCIALORIGCOB
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ORIGEMCOBRANCA
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDFORMAPAGAMENTO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @SIGLAPV
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @PV
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @TOKEN
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @IDSERVICO
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @CLIENTSECRET
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @TIPODESTINO
                layout {
                    sequence: 11
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDFORMAPAGAMENTOFAVORITA
                layout {
                    width: 197.438
                    sequence: 5
                }
            )

            displayColumn (
                column: @IDEMPRESAVIRTUALAGE
                layout {
                    sequence: 12
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CLIENTSECRET (
            type: textarea
            heading {
                heading: Client Secret
            }
            layout {
                sequence: 110
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: CLIENTSECRET
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
            help {
                helpText: Usado na RMC para gerar link de PIX, Mauricio usa na tabela vw_pagamento_cartao_credito_rmc
            }
        )

        column IDCREDENCIALORIGCOB (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDCREDENCIALORIGCOB
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: seq_IDCREDENCIALORIGCOB
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDEMPRESAVIRTUALAGE (
            type: selectList
            heading {
                heading: Empresa Virtual Age
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select e.nome
                         , e.idempresavirtualage
                      from favorita.empresasvirtualage e
                     where e.idempresavirtualage in (200,300,600)
                    order by 1
                    ```
            }
            layout {
                sequence: 130
            }
            source {
                databaseColumn: IDEMPRESAVIRTUALAGE
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            help {
                helpText: Usado na Favorita para gerar link de cartão de credito, essa configuração o Mauricio usa na tabela vw_pagamento_cartao_credito
            }
        )

        column IDFORMAPAGAMENTO (
            type: selectList
            heading {
                heading: Forma de Pagamento
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select f.descricao
                         , f.idformapagamento
                      from roman.formaspagamentosnegociacoes f
                     --where f.idformapagamento in ('J','H')
                    order by 1 
                    ```
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDFORMAPAGAMENTO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            help {
                helpText: Usado na RMC para gerar link de PIX, Mauricio usa na tabela vw_pagamento_cartao_credito_rmc
            }
        )

        column IDFORMAPAGAMENTOFAVORITA (
            type: selectList
            heading {
                heading: Forma de Pagamento Favorita
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT F.DESCRICAO
                         , F.IDFORMAPAGAMENTO
                      FROM FAVORITA.FORMASPAGAMENTOS F
                     WHERE F.IDFORMAPAGAMENTO = 1007
                    ORDER BY 1 ASC
                    ```
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: IDFORMAPAGAMENTOFAVORITA
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            help {
                helpText: Usado na Favorita para gerar link de cartão de credito, essa configuração o Mauricio usa na tabela vw_pagamento_cartao_credito
            }
        )

        column IDSERVICO (
            type: numberField
            heading {
                heading: Serviço
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                databaseColumn: IDSERVICO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column ORIGEMCOBRANCA (
            type: selectList
            heading {
                heading: Origem Cobrança
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select o.descricao
                         , o.origemcobranca
                      from roman.origenscobranca o
                    order by 1
                    ```
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ORIGEMCOBRANCA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            help {
                helpText: Usado na RMC para gerar link de PIX, Mauricio usa na tabela vw_pagamento_cartao_credito_rmc
            }
        )

        column PV (
            type: numberField
            heading {
                heading: PV / MerchantID e Token/ MerchantKey
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                databaseColumn: PV
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            help {
                helpText: Usado tanto na RMC quanto na favorita para gerar links de pagamento
            }
        )

        column SIGLAPV (
            type: textField
            heading {
                heading: Sigla PV
            }
            settings {
                textCase: upper
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: SIGLAPV
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
            help {
                helpText: Usado tanto na RMC quanto na favorita para gerar links de pagamento
            }
        )

        column TIPODESTINO (
            type: selectList
            heading {
                heading: Tipo Destino
            }
            lov {
                type: staticValues
                staticValues: STATIC:Favorita Sul;fav_sul,Favorita Norte;fav_norte,Débitos;debitos,Capta Leads;capta_leads
            }
            layout {
                sequence: 120
            }
            source {
                databaseColumn: TIPODESTINO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column TOKEN (
            type: textField
            heading {
                heading: Token
            }
            layout {
                sequence: 90
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: TOKEN
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    button voltar (
        buttonName: Voltar
        label: Voltar
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction voltar (
        name: Voltar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @voltar
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process credenciaisorigcob-save-interactive-grid-data (
        name: credenciaisorigcob - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @credenciaisorigcob
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1072906824766467213
        }
    )

)

