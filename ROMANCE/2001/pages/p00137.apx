page 137 (
    name: Cadastro de Fornecedor
    title: Cadastro de Fornecedor
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-fornecedor (
        name: Cadastro de Fornecedor
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P137_ATIVO (
        type: selectList
        label {
            label: Ativo
            alignment: right
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @cadastro-de-fornecedor
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: ATIVO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P137_IDFORNECEDOR (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-fornecedor
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFORNECEDOR
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P137_IDPESSOA (
        type: hidden
        layout {
            sequence: 30
            region: @cadastro-de-fornecedor
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPESSOA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P137_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @cadastro-de-fornecedor
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
            height: 3
        }
        validation {
            maxLength: 150
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P137_REFERENCIA (
        type: hidden
        layout {
            sequence: 40
            region: @cadastro-de-fornecedor
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: REFERENCIA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P137_SALDO (
        type: hidden
        layout {
            sequence: 20
            region: @cadastro-de-fornecedor
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: SALDO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @cadastro-de-fornecedor
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: window.opener.location.reload(); window.close();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @cadastro-de-fornecedor
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P137_IDFORNECEDOR
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @cadastro-de-fornecedor
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P137_IDFORNECEDOR
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 30
            region: @cadastro-de-fornecedor
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P137_IDFORNECEDOR
        }
    )

    process fetch-row-from-fornecedores (
        name: Fetch Row from FORNECEDORES
        type: autoRowFetch
        source {
            tableOwner: CATAL
            tableName: FORNECEDORES
            pkColumn: IDFORNECEDOR
            pkItem: P137_IDFORNECEDOR
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 11286279288713464
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDFORNECEDOR.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P137_IDFORNECEDOR := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 11286480981713464
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-fornecedores (
        name: Process Row of FORNECEDORES
        type: autoRowProcessing
        target {
            tableOwner: CATAL
            tableName: FORNECEDORES
            pkColumn: IDFORNECEDOR
            pkItem: P137_IDFORNECEDOR
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela FORNECEDORES.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 11286662547713464
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 11286874171713466
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 137
            }
            saveStateBeforeBranching: true
        }
    )

)

