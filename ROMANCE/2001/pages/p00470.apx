    pageItem P470_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 80
            region: @histórico-de-consulta-cheque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
            height: 5
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vmensagem varchar2(500);
                begin
                  --
                  select case 
                           when c.restricao = 'S' and spc_quantidade > 0 then
                             'Reprovado. Possui '||spc_quantidade||' restruições.'
                           when nvl(spc_valortotal,0) = 0 and spc_quantidade = 0 then
                             'Aprovado'
                         end observacao
                  into vmensagem
                  from consultaspc c
                  where c.idconsultaspc = ( select max(cc.idconsultaspc)
                                            from consultaspc cc
                                            where cc.cpf = replace(replace(replace(:P470_DOCUMENTO,'.',''),'-',''),' ','') );
                  --
                  return vmensagem;
                  --
                exception
                  when others then
                    return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

