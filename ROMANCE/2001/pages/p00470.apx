        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-liberação (
        name: Valida liberação
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P470_LIBERADO
        }
        error {
            errorMessage: Por favor, informe se está ou não Liberado.
            associatedItem: @P470_LIBERADO
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

    process busca-histórico-gerado (
        name: Busca Histórico Gerado
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  vidhistorico number;
                begin
                  --
                  select idhistoricocheque
                  into vidhistorico
                  from historicosconsultacheques h
                  where h.idcheque = :P470_IDCHEQUE;
                  --
                  :P470_IDHISTORICOCHEQUE := vidhistorico;
                  --
                exception
                  when others then
                    :P470_IDHISTORICOCHEQUE := null;
                    :P470_LIBERADO          := null;
                    :P470_OBSERVACAO        := null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1528958880917824010
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P470_IDCHEQUE
        }
    )

    process históric-consulta-cheque (
        name: Históric Consulta Cheque
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdataconsulta date;
                begin
                  -- Call the procedure
                  if :P470_IDHISTORICOCHEQUE is not null then
                    --
                    pck_cadastros_rmc.prc_historicosconsultacheques(pidhistoricocheque => :P470_IDHISTORICOCHEQUE,
                                                                    pidcheque => :P470_IDCHEQUE,
                                                                    pidvendedora => :P470_IDVENDEDORA,
                                                                    pdataconsulta => vdataconsulta,
                                                                    pusuario => :P470_USUARIO,
                                                                    pliberado => :P470_LIBERADO,
                                                                    pcodigoliberacao => :P470_CODIGOLIBERACAO,
                                                                    pobservacao => :P470_OBSERVACAO,
                                                                    pidsemana => :P470_IDSEMANA,
                                                                    pmd5 => :P470_MD5,
                                                                    poperacao_dml => 'S');
                    --
                    :P470_DATACONSULTA := to_char(vdataconsulta,'DD/MM/RRRR HH24:MI:SS');
                    --
                  end if;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1528958585387824007
        }
    )

    process processo-dml-em-históricos-de-cheques (
        name: Processo DML em Históricos de Cheques
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vdata         date;
                  --
                begin
                  --
                  if v('REQUEST') = 'SUBMIT' then
                    voperacao_dml := 'I';
                    :P470_USUARIO := v('APP_USER');
                  elsif v('REQUEST') = 'DELETE' then
                    voperacao_dml := 'D';
                  elsif v('REQUEST') = 'SAVE' then
                    voperacao_dml := 'U';
                  end if;
                  --
                  vdata := to_date(:P470_DATACONSULTA,'DD/MM/RRRR HH24:MI:SS');
                  --
                  pck_cadastros_rmc.prc_historicosconsultacheques(pidhistoricocheque => :P470_IDHISTORICOCHEQUE,
                                                                  pidcheque => :P470_IDCHEQUE,
                                                                  pidvendedora => :P470_IDVENDEDORA,
                                                                  pdataconsulta => vdata,
                                                                  pusuario => :P470_USUARIO,
                                                                  pliberado => :P470_LIBERADO,
                                                                  pcodigoliberacao => :P470_CODIGOLIBERACAO,
                                                                  pobservacao => :P470_OBSERVACAO,
                                                                  pidsemana => :P470_IDSEMANA,
                                                                  pmd5 => :P470_MD5,
                                                                  poperacao_dml => voperacao_dml);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1528957107266797089
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SUBMIT','DELETE','SAVE')
                ```
        }
    )

    branch (
        name: Go To Page 470
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 470
                items: {
                    P470_IDHISTORICOCHEQUE: &P470_IDHISTORICOCHEQUE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SUBMIT','SAVE')
                  and :P470_PAGINA = 469
                ```
        }
    )

    branch (
        name: Go To Page 470
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 470
                items: {
