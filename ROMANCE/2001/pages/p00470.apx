            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'CANCEL'
                  and :P470_PAGINA = 469
                ```
        }
    )

    branch (
        name: Go To Page 280
        execution {
            sequence: 50
        }
        behavior {
            target: {
                page: 280
                items: {
                    P280_CPF: &P470_DOCUMENTO.
                }
