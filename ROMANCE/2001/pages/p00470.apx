            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente excluir a Liberação?','DELETE');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P470_IDHISTORICOCHEQUE
        }
