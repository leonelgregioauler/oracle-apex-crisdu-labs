    pageItem P470_IDVENDEDORA (
        type: selectList
        label {
            label: Consultora
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(idvendedora) nome
                     , idvendedora
                from vendedoras v
                    , pessoas p
                where v.idpessoa = p.idpessoa
                  and p.cpf = replace(replace(replace(:P470_DOCUMENTO,'.',''),'-',''),' ','')
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @histórico-de-consulta-cheque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P470_LIBERADO (
        type: radioGroup
        label {
            label: Liberado
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @histórico-de-consulta-cheque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vliberado varchar2(1);
                begin
                  --
                  select case 
                           when c.restricao = 'S' and spc_quantidade > 0 then
                             'N'
                           when nvl(spc_valortotal,0) = 0 and spc_quantidade = 0 then
                             'S'
                         end observacao
                  into vliberado
                  from consultaspc c
                  where c.idconsultaspc = ( select max(cc.idconsultaspc)
                                            from consultaspc cc
                                            where cc.cpf = replace(replace(replace(:P470_DOCUMENTO,'.',''),'-',''),' ','') );
                  --
                  return vliberado;
                  --
                exception
                  when others then
                    return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P470_MD5 (
        type: hidden
        settings {
