page 380 (
    name: Links Auxiliares
    title: Links Auxiliares
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region links-auxiliares (
        name: Links Auxiliares
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select titulo
                     ,  endereco
                from LINKSDESUPORTE l
                where l.idlinksuporte > 0
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1422078193309783113
        }

        column ENDERECO (
            type: plainText
            heading {
                heading: Assista o Vídeo
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column TITULO (
            type: plainText
            heading {
                heading: Titulo
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 14221103 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ENDERECO (
                sequence: 2
            )

            displayColumn TITULO (
                sequence: 1
            )

        )

    )

    region passo (
        name: Passo 1
        type: staticContent
        source {
            htmlCode: <iframe frameborder="0" scrolling="no" marginheight="0" marginwidth="0"width="788.54" height="443" type="text/html" src="https://www.youtube.com/embed/dgLIX5FLkoo?autoplay=1&fs=0&iv_load_policy=3&showinfo=0&rel=0&cc_load_policy=0&start=0&end=0"></iframe>
        }
        layout {
            sequence: 10
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-autoheight
                js-dialog-size720x480
            ]
        }
        advanced {
            htmlDomId: PASSO1
            regionDisplaySelector: true
        }
    )

    region tablets-compatíveis-para-compra (
        name: Tablets Compatíveis para Compra
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent7
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <h4> 
                <font color="green"><b>Os modelos citados abaixo são os atualmente indicados!<br> </font>
                <br>
                <b> Linha atual e com estoque nas lojas: </b></br>
                <br>
                <b> Samsung Galaxy Tab A9+ SM-X210</b> </br>
                <br>
                <b> Samsung Galaxy Tab A9+ SM-X216</b> </br>
