page 230 (
    name: Relação de Distribuidor
    title: Relação de Distribuidor
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region relação-de-distribuidores (
        name: Relação de Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) distribuidor
                     , p.cpf CPF
                     , r.idrepresentante codigo
                     , decode(r.ativo,'S','Ativo','N','Inativo') ativo
                      , case
                         when r.ativo = 'S' then
                           catal.pck_util.fnc_retornasemanaatualrepres(r.idrepresentante)
                       end "Semana Atual"
                     , u.usuario
                     , case
                         when exists ( select 1
                                       from vw_filiais f
                                       where f.idfilial = pck_romance.fnc_filialrepresentante(r.idrepresentante)
                                         and f.idgrupo != 5 ) then
                           to_char(pck_mobile.fnc_gerasenhadeacesso(u.usuario))
                         when exists ( select 1
                                       from vw_filiais f
                                       where f.idfilial = pck_romance.fnc_filialrepresentante(r.idrepresentante)
                                         and f.idgrupo  = 5 ) then
                           pck_mobile.fnc_gerasenhauruguai(r.idrepresentante)
                       end senha
                     , (select nvl(catal.pck_util.fnc_semanaid( min(nv.idsemanadistribuicao)), 'Sem Registro')
                        from roman.notasvendas nv
                        where nv.idrepresentante = r.idrepresentante
                          and nv.idsituacaonotavenda in (4,3)) iniciou_na_empresa
                     , r.datainativacao
                     , ( select s.semanacompleta
                         from roman.semana_dias s
                         where s.idsemana = r.semanaparou ) "Semana Cobranca Parou"
                     , ( select lr.dataalteracao
                         from logcatal.log_representantes lr
                         where lr.idrepresentante = r.idrepresentante
                           and lr.tipoalteracao = 'INSERT' ) datainclusao
                    , ( select max(lr.dataalteracao)
                        from ( select lr2.dataalteracao,
                                  lr2.ativo,
                                  lag(lr2.ativo) over (order by lr2.dataalteracao) as ativo_anterior
                               from logcatal.log_representantes lr2
                               where lr2.idrepresentante = r.idrepresentante
                               and lr2.tipoalteracao   = 'UPDATE') lr
                        where lr.ativo          = 'S'
                          and lr.ativo_anterior = 'N') data_reativacao --T13322498
                from representantes r
                   , usuarios u
                   , catal.pessoas p
                where r.idgerente = (select idgerente 
                                     from gerentes
                                     where idfilial = :P0_IDFILIAL)
                  and u.idpessoa  = r.idpessoa
                  and r.idpessoa  = p.idpessoa
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
