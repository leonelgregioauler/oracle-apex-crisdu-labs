    region balanço (
        name: Balanço
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cod
                     , nome
                     , semana
                     , QTDINICIALBALANCO        qtdbalancoinicial
                     , nvl(valorinicialbalanco,0) balancoinicial
                     , '+' s0
                     , carga
                     , valorcarga
                     , '-' s1
                     , devolucao
                     , valordevolucao
                     , '-' s2
                     , vendeu
                     , valorvendeu
                     , '-' s3
                     , emaberto
                     , valoremaberto
                     , '=' s4
                     , ( nvl(QTDINICIALBALANCO,0)+ carga-devolucao-vendeu-emaberto) faltadevolver
                     , ( nvl(valorinicialbalanco,0)+valorcarga-valordevolucao-valorvendeu-valoremaberto) valorfaltadevolver
                   --  , ( nvl(valorinicialbalanco,0)+valorcarga-valordevolucao-valorvendeu-valoremaberto)*0.675 valorfaltadevolversemcom
                     , ativo
                     , '|' s5
                     , debitos
                     , debitoscobranca
                from (
                        select r.idrepresentante cod
                             , pck_romance.fnc_nomerepresentante(r.idrepresentante) nome
                             , pck_util.fnc_semanaid(idsemanabalanco) semana
                             , valorinicialbalanco
                             , QTDINICIALBALANCO
                             , nvl( ( select sum((nvl(qtd_dist_pp ,0) 
                                                + nvl(qtd_dist_p ,0)  
                                                + nvl(qtd_dist_m ,0)  
                                                + nvl(qtd_dist_g ,0)
                                                + nvl(qtd_dist_gg,0)  
                                                + nvl(qtd_dist_egg,0) 
                                                 + nvl(qtd_dist_exgg,0) 
                                                + nvl(qtd_dist_u,0))) 
                                       from itenscargarepresentante i 
                                       where i.idcargarepresentante in ( select c.idcargarepresentante
                                                                         from cargasrepresentantes c
                                                                         where c.idrepresentante = r.idrepresentante
                                                                           and c.situacao        = 3 -- concluida
                                                                           and c.idsemana >= r.idsemanabalanco )),0) carga
                             , nvl( ( select sum( (nvl(qtd_dist_pp ,0) 
                                                 + nvl(qtd_dist_p ,0)  
                                                 + nvl(qtd_dist_m ,0)  
                                                 + nvl(qtd_dist_g ,0)
                                                 + nvl(qtd_dist_gg,0)  
                                                 + nvl(qtd_dist_egg,0) 
                                                 + nvl(qtd_dist_exgg,0) 
                                                 + nvl(qtd_dist_u,0))*i.valorvenda )
                                       from itenscargarepresentante i 
                                       where i.idcargarepresentante in ( select c.idcargarepresentante
                                                                         from cargasrepresentantes c
                                                                         where c.idrepresentante = r.idrepresentante
                                                                           and c.situacao        = 3 -- concluida
                                                                           and c.idsemana >= r.idsemanabalanco )),0) valorcarga
                             , nvl(( select sum(nvl(i.qtd_u,0)
                                              + nvl(i.qtd_egg,0)
                                              + nvl(i.qtd_gg ,0)
                                              + nvl(i.qtd_g  ,0)
                                              + nvl(i.qtd_m  ,0)
                                              + nvl(i.qtd_p  ,0)
                                              + nvl(i.qtd_pp ,0))
                                     from itensdevolucaorepres i
                                     where i.iddevolucaorepres in ( select d.iddevolucaorepres
                                                                     from devolucoesrepresentantes d
                                                                     where d.idrepresentante = r.idrepresentante
                                                                       and d.situacao        != 0
                                                                       and d.idsemana >= r.idsemanabalanco ) ),0) devolucao
                             , nvl(( select sum((nvl(i.qtd_u,0)
                                               + nvl(i.qtd_egg,0)
                                               + nvl(i.qtd_gg ,0)
                                               + nvl(i.qtd_g  ,0)
                                               + nvl(i.qtd_m  ,0)
                                               + nvl(i.qtd_p  ,0)
                                               + nvl(i.qtd_pp ,0))*i.valorproduto)
                                     from itensdevolucaorepres i
                                     where i.iddevolucaorepres in ( select d.iddevolucaorepres
                                                                     from devolucoesrepresentantes d
                                                                     where d.idrepresentante = r.idrepresentante
                                                                       and d.situacao        != 0
                                                                       and d.idsemana >= r.idsemanabalanco ) ),0) valordevolucao
                             , nvl(( select sum(nvl(i.quantidade,0)-nvl(i.qtddevolvida,0))
                                     from itensnotavenda i
                                     where i.idnotavenda in ( select idnotavenda
                                                              from notasvendas n
                                                              where n.idrepresentante = r.idrepresentante
                                                                and n.idsituacaonotavenda = 4 
                                                                and n.idsemanacobranca >= r.idsemanabalanco ) ),0) vendeu
                             , nvl(( select sum((nvl(i.quantidade,0)-nvl(i.qtddevolvida,0))*i.valorvenda )
                                     from itensnotavenda i
                                     where i.idnotavenda in ( select idnotavenda
                                                              from notasvendas n
                                                              where n.idrepresentante = r.idrepresentante
                                                                and n.idsituacaonotavenda = 4 
                                                                and n.idsemanacobranca >= r.idsemanabalanco ) ),0) valorvendeu
                             , nvl(( select sum(i.quantidade)
                                     from itensnotavenda i
                                     where i.idnotavenda in ( select idnotavenda
                                                              from notasvendas n
                                                              where n.idrepresentante = r.idrepresentante
                                                                and n.idsituacaonotavenda < 4  ) ),0) emaberto
                             , nvl(( select sum(i.quantidade*i.valorvenda)
                                     from itensnotavenda i
                                     where i.idnotavenda in ( select idnotavenda
                                                              from notasvendas n
                                                              where n.idrepresentante = r.idrepresentante
                                                                and n.idsituacaonotavenda < 4 ) ),0) valoremaberto
                             , decode(r.ativo,'S','Sim','Não') ativo 
                             , ( select sum(n.saldo)
                                 from notasvendas n
                                 where idsituacaonotavenda = 4
                                   and n.idrepresentante = r.idrepresentante
                                   and n.enviadocobranca is null
                                   and saldo > 0 ) debitos
                             , ( select sum(n.saldo)
                                 from notasvendas n
                                 where idsituacaonotavenda = 4
                                   and n.idrepresentante = r.idrepresentante
                                   and n.enviadocobranca = 'S'
                                   and saldo > 0 ) debitoscobranca
                        from representantes r
                        where ( ( :P209_FILTRO = 'R' and r.idrepresentante = :P209_IDREPRESENTANTE )
                              or  :P209_FILTRO = 'T' )
                          and r.idgerente = ( select idgerente 
                                              from gerentes
                                              where idfilial = :P0_IDFILIAL ))
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <b>Números expressos em valores.</b><font color="GREEN">VALORES EXPRESSOS EM PREÇO DE VENDA</font><br><br>
                <b>-> Carga </b>= Soma de todas quantidades de produtos carregados a partir da semana de balanço.<br>
                <b>-> Devolução </b>= Soma de todas quantidades devolvidas a partir da semana de balanço.<br>
                <b>-> Vendeu </b>= Soma de todas quantidades vendidas a partir da semana de balanço.<br>
                <b>-> Peças em Consul. </b>= Soma de produtos que estão em notas não atendidas.<br>
                <b>-> Falta devolver </b>= Produtos com o distribuidor que falta prestar contas.<br>
                <br>
                <br>
                <b> Informações gerais, independente da semana de balanço:</b><font color="GREEN"> Valor já descontada comissão da consultora</font><br>
                <b>-> Débitos </b>= Valor total devido pelas consultoras que estão em poder do distribuidor.<br>
                <b>-> Débitos em Cobrança</b>= Valor total devido pelas consultoras que estão em poder do Setor de Cobranças.<br>
                <br>
                <br>
                <font color="red"> &nbsp &nbsp &nbsp &nbsp &nbsp &nbsp &nbsp  Balanço de Estoque! Não lucratividade. </FONT>
                <br>
                <br>
                ```
        }
        serverSideCondition {
            type: item=value
            item: P209_TIPO
            value: R
        }
        link {
            linkColumn: customTarget
            target: {
                page: 135
                items: {
                    P135_IDREPRESENTANTE: #COD#
                    P135_PAGINA: 209
                }
