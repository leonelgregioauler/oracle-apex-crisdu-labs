    pageItem P209_FILTRO (
        type: radioGroup
        label {
            label: Filtro
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Todos;T,Por Distribuidor;R
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P209_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' - Ult. Balanço: '||pck_util.fnc_semanaid( r.idsemanabalanco ) display_value
                     , r.idrepresentante return_value
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente
                  and g.idfilial = :P0_IDFILIAL
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P209_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Resumido;R,Produto;D,Categoria;C
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

    button p209-filtrar (
        buttonName: P209_FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: P209_FILTRAR
        }
    )

    dynamicAction filtrar (
        name: filtrar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @p209-filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction filtro (
        name: filtro
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P209_FILTRO
        }
        clientSideCondition {
            type: item=value
            item: P209_FILTRO
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P209_IDREPRESENTANTE
                    P209_TIPO
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P209_IDREPRESENTANTE
                    P209_TIPO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 209
                items: {
                    P209_FILTRO: &P209_FILTRO.
                    P209_IDREPRESENTANTE: &P209_IDREPRESENTANTE.
                    P209_TIPO: &P209_TIPO.
                }
                successMessage: false
            }
        }
    )

)

