    region balanço-por-semana-relatório-novo (
        name: Balanço por Semana (Relatório Novo)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distribuidor
                     , semana
                   --  , QTDINICIALBALANCO        qtdbalancoinicial
                   --  , nvl(valorinicialbalanco,0) balancoinicial
                     , carga
                     , valorcarga
                     , '-' s1
                     , devolucao
                     , valordevolucao
                     , '-' s2
                     , vendeu
                     , valorvendeu
                     , '-' s3
                     , emaberto
                     , valoremaberto
                     , '=' s4
                     , faltadevolver
                     , w.valorfaltadevolver
                   --   , '|' s5
                   --   , debitos
                   --  , debitoscobranca
                     , '|' s5
                     , ( select sum(w1.faltadevolver)
                         from vw_balanco_representantes w1
                         where w1.idrepresentante = w.idrepresentante
                           and w1.idsemana       <= w.idsemana ) qtdsaldoparcial
                     , ( select sum(w1.valorfaltadevolver)
                         from vw_balanco_representantes w1
                         where w1.idrepresentante = w.idrepresentante
                           and w1.idsemana       <= w.idsemana ) valorsaldoparcial
                     , '|' s6
                     , nvl(w.debitos,0) debitos
                     , nvl(w.debitoscobrados,0) debitoscobrados
                     , nvl(w.debitossetorcobranca,0) debitossetorcobranca
                     
                from vw_balanco_representantes w
                where idrepresentante = :P209_IDREPRESENTANTE
                
                ```
        }
        layout {
            sequence: 40
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P209_TIPO = 'R'
                and v('APP_USER') IN ('EVERTON','FERNANDO','DANIEL','GUILHERME')
                ```
        }
        componentAppearance {
            showNullValuesAs: -
