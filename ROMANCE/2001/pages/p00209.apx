    region balanço-sem-comissão-consultora-relatório-novo (
        name: Balanço Sem Comissão Consultora (Relatório Novo)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distribuidor
                     , pck_util.fnc_semanaid(w.idsemanabalanco) semana
                     , sum(nvl(QTDINICIALBALANCO  ,0)) qtdbalancoinicial
                     , sum(nvl(valorinicialbalanco,0)) balancoinicial
                     , '+' s0
                     , sum(carga                ) carga
                     , sum(valorcarga           ) valorcarga
                     , '-' s1               
                     , sum(devolucao            ) devolucao
                     , sum(valordevolucao       ) valordevolucao
                     , '-' s2               
                     , sum(vendeu               ) vendeu
                     , sum(valorvendeu          ) valorvendeu
                     , '-' s3               
                     , sum(emaberto             ) emaberto
                     , sum(valoremaberto        ) valoremaberto
                     , '=' s4               
                     , sum(faltadevolver        ) faltadevolver
                     , sum(w.valorfaltadevolver ) valorfaltadevolver
                     , '|' s5               
                     , sum(w.debitos) debitos
                     , sum(w.debitoscobrados) debitoscobrados
                     , sum(w.debitossetorcobranca) debitossetorcobranca
                from vw_balanco_representantes w
                where ( ( :P209_FILTRO = 'R' and w.idrepresentante = :P209_IDREPRESENTANTE )
                      or  :P209_FILTRO = 'T' )
                  and w.idgerente = ( select idgerente 
                                      from gerentes
                                      where idfilial = :P0_IDFILIAL )
                group by distribuidor, w.idsemanabalanco
                
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P209_TIPO = 'R'
                and v('APP_USER') IN ('EVERTON','FERNANDO','GUILHERME')
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 135
                items: {
                    P135_IDREPRESENTANTE: #COD#
                    P135_PAGINA: 209
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt="" />
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            savePublicReport: true
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
