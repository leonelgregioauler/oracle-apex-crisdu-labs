    region categoria (
        name: Categoria
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomecategoria(p.idcategoria) categoria
                     , sum(carga) carga
                     , sum(devolucao) devolucao
                     , sum(vendido) vendido
                     , sum(acobrar) acobrar
                     , sum(carga) - sum(devolucao) - sum(vendido) - sum(acobrar) resultado
                     , sum(vlrcarga) vlrcarga
                     , sum(vlrdevolucao) vlrdevolucao     
                     , sum(vlrvendido) vlrvendido
                     , sum(vlracobrar) vlrcobrar
                     , sum(vlrcarga) - sum(vlrdevolucao) - sum(vlrvendido) - sum(vlracobrar) vlrresultado
                from ( select idproduto
                             , nvl(( select sum(nvl(i.qtd_dist_pp,0)   + nvl(i.qtd_dist_p,0)  
                                              + nvl(i.qtd_dist_m,0)    + nvl(i.qtd_dist_g,0)    
                                              + nvl(i.qtd_dist_gg,0)   + nvl(i.qtd_dist_egg,0) 
                                              + nvl(i.qtd_dist_exgg,0) + nvl(i.qtd_dist_u,0))
                                     from itenscargarepresentante i
                                     where i.idestoquefil = e.idestoquefilial
                                       and exists ( select 1
                                                    from cargasrepresentantes c
                                                    where c.idcargarepresentante           = i.idcargarepresentante
                                                      and c.idrepresentante                = :P209_IDREPRESENTANTE
                                                      and c.idsemana >= ( select r.idsemanabalanco
                                                                          from representantes r
                                                                          where r.idrepresentante = :P209_IDREPRESENTANTE) ) ),0 ) carga
                             , nvl(( select sum((nvl(i.qtd_dist_pp,0)   + nvl(i.qtd_dist_p,0)  
                                              + nvl(i.qtd_dist_m,0)    + nvl(i.qtd_dist_g,0)    
                                              + nvl(i.qtd_dist_gg,0)   + nvl(i.qtd_dist_egg,0) 
                                              + nvl(i.qtd_dist_exgg,0) + nvl(i.qtd_dist_u,0))*i.valorvenda)
                                     from itenscargarepresentante i
                                     where i.idestoquefil = e.idestoquefilial
                                       and exists ( select 1
                                                    from cargasrepresentantes c
                                                    where c.idcargarepresentante           = i.idcargarepresentante
                                                      and c.idrepresentante                = :P209_IDREPRESENTANTE
                                                      and c.idsemana >= ( select r.idsemanabalanco
                                                                          from representantes r
                                                                          where r.idrepresentante = :P209_IDREPRESENTANTE) ) ),0 ) vlrcarga
                             , nvl(( select sum(nvl(qtd_pp,0)   + nvl(qtd_p,0)   
                                              + nvl(qtd_m,0)    + nvl(qtd_g,0)    
                                              + nvl(qtd_gg,0)   + nvl(qtd_egg,0) 
                                              + nvl(qtd_exgg,0) + nvl(qtd_u,0))
                                     from itensdevolucaorepres ii
                                     where ii.idestoquefil = e.idestoquefilial
                                       and exists ( select 1
                                                    from devolucoesrepresentantes d
                                                    where d.iddevolucaorepres              = ii.iddevolucaorepres
                                                      and d.idrepresentante                = :P209_IDREPRESENTANTE
                                                      and d.idsemana >= ( select r.idsemanabalanco
                                                                          from representantes r
                                                                          where r.idrepresentante = :P209_IDREPRESENTANTE) ) ) ,0) devolucao
                             , nvl(( select sum((nvl(qtd_pp,0)   + nvl(qtd_p,0)   
                                              + nvl(qtd_m,0)    + nvl(qtd_g,0)    
                                              + nvl(qtd_gg,0)   + nvl(qtd_egg,0) 
                                              + nvl(qtd_exgg,0) + nvl(qtd_u,0))*ii.valorproduto)
                                     from itensdevolucaorepres ii
                                     where ii.idestoquefil = e.idestoquefilial
                                       and exists ( select 1
                                                    from devolucoesrepresentantes d
                                                    where d.iddevolucaorepres              = ii.iddevolucaorepres
                                                      and d.idrepresentante                = :P209_IDREPRESENTANTE
                                                      and d.idsemana >= ( select r.idsemanabalanco
                                                                          from representantes r
                                                                          where r.idrepresentante = :P209_IDREPRESENTANTE) ) ) ,0) vlrdevolucao
                             , nvl(( select sum(it.quantidade - nvl(it.qtddevolvida,0))
                                     from itensnotavenda it
                                     where it.idestoquefil = e.idestoquefilial
                                       and exists ( select 1 
                                                    from notasvendas nn
                                                    where nn.idnotavenda = it.idnotavenda
                                                      and nn.idrepresentante = :P209_IDREPRESENTANTE
                                                      and nn.idsituacaonotavenda = 4 ) ),0) vendido
                             , nvl(( select sum((it.quantidade - nvl(it.qtddevolvida,0))*it.valorvenda)
                                     from itensnotavenda it
                                     where it.idestoquefil = e.idestoquefilial
                                       and exists ( select 1 
                                                    from notasvendas nn
                                                    where nn.idnotavenda = it.idnotavenda
                                                      and nn.idrepresentante = :P209_IDREPRESENTANTE
                                                      and nn.idsituacaonotavenda = 4 ) ),0) vlrvendido
                             , nvl(( select sum(it.quantidade)
                                     from itensnotavenda it
                                     where it.idestoquefil = e.idestoquefilial
                                       and exists ( select 1 
                                                    from notasvendas nn
                                                    where nn.idnotavenda = it.idnotavenda
                                                      and nn.idrepresentante = :P209_IDREPRESENTANTE
                                                      and nn.idsituacaonotavenda = 3 ) ),0) acobrar
                             , nvl(( select sum(it.quantidade*it.valorvenda)
                                     from itensnotavenda it
                                     where it.idestoquefil = e.idestoquefilial
                                       and exists ( select 1 
                                                    from notasvendas nn
                                                    where nn.idnotavenda = it.idnotavenda
                                                      and nn.idrepresentante = :P209_IDREPRESENTANTE
                                                      and nn.idsituacaonotavenda = 3 ) ),0) vlracobrar
                        from estoquefilial e
                        where e.idfilial = :P0_IDFILIAL ) e
                      , produtos p
                where p.idproduto = e.idproduto
                group by p.idcategoria
                ```
        }
        layout {
            sequence: 60
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
