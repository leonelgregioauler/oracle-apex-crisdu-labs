    region pedidos-resumido (
        name: Pedidos resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante )  "Representante"
                     , nvl(ped.valorapagar,0) "Valor Total"
                     , nvl(ped.qtd,0) "Qtd Pedidos"
                     , nvl(paris.valorapagar,0) "Valor Total Paris"
                     , nvl(paris.qtd,0) "Qtd Paris"
                     , nvl(ped.valorapagar,0) + nvl(paris.valorapagar,0) "Total"
                     , nvl(ped.qtd,0) + nvl(paris.qtd,0) "QTD Total"
                     , '=' s1
                     , '|' s2
                     , '|' s3
                     , '+' s4
                     , m.cnpj
                     , nvl(paris.qtd_perfumes,0) qtd_perfumes
                     , pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(r.idrepresentante)) empresa
                from representantes r
                   , mei m
                   , ( select idrepresentante
                            , sum(( select sum(v.valorpagar)
                                 from favorita.vw_vencimentospedidos_fav v
                                 where v.codsituacaovencimento = 'V' -- <-- valido
                                   and v.idpedido              = pp.idpedido )) valorapagar--sum(pp.valorapagar) valorapagar -- ticket 8901701
                            , sum(pp.valortotal) valortotal
                            , count(distinct idpedido) qtd
                       from favorita.pedidos pp
                       where pp.idsituacaoentrega >= 20000
                         and pp.tipopedido in ('P', 'T', 'V', 'R')
                         and not exists ( select 1
                                          from favorita.classificacoespedidos cp
                                          where cp.idpedido = pp.idpedido 
                                            and cp.idcaracteristicapedido = 73 )
                         
                         and not exists ( select 1
                                          from favorita.classificacoespedidos c
                                          where c.idcaracteristicapedido = 8
                                            and c.idvalorcaracteristica  = 16
                                            and c.idpedido               = pp.idpedido )
                         and pp.valorapagar > 0
                         and pp.datacancelamento is null
                         and ( :P0_IDFILIAL is null 
                             or ( :P0_IDFILIAL = 1135 and pp.idfilialromance in (1089,1090,1132,124,122,320,221,1070,1072,1071,1082,1083,1210,1106,1227,1223,1243) )
                             or ( :P0_IDFILIAL != 1135 and pp.idfilialromance  = :P0_IDFILIAL ) )
                         and ( :P583_TIPO_PESQUISA is null
                           or ( :P583_TIPO_PESQUISA = 'D' and ( :P583_TIPODATA = 'E' and trunc(pp.dataemissao) between to_date(:P583_DTINI,'DD/MM/RRRR') and to_date(:P583_DTFIM,'DD/MM/RRRR')
                                                             or :P583_TIPODATA = 'A' and trunc(pp.dataentrega) between to_date(:P583_DTINI,'DD/MM/RRRR') and to_date(:P583_DTFIM,'DD/MM/RRRR') ) )
                           or ( :P583_TIPO_PESQUISA = 'S' and pp.idsemanaemissao = :P583_IDSEMANA )
                           or ( :P583_TIPO_PESQUISA = 'P' and pp.idsemanaemissao between :P583_IDSEMANA_INI and :P583_IDSEMANA_FIM ) )  
                       /* and (:P583_PEDIDOBRINDE = 'S' -- Mostra todos
                           or ( :P583_PEDIDOBRINDE = 'N' and not exists (select 1
                                                                           from favorita.classificacoespedidos c
                                                                          where c.idpedido               = pp.idpedido
                                                                            and c.idcaracteristicapedido = 49
                                                                            and c.idvalorcaracteristica  = 2610 ) ) ) -- pedido de brinde*/
                       group by idrepresentante ) ped
                    , ( select idrepresentante
                             , sum(pp.valorapagar) valorapagar
                             , count(distinct idpedido) qtd
                             , sum(( select nvl(sum(it.quantidade),0)
                                     from favorita.itenspedidos it
                                     where it.idpedido = pp.idpedido
                                       and it.idprodutodetalhado in (2350,2352,2351,2349,2348,2347,2346,2345,2344,2343,2817,2818,2819,2820,2821,2822,2824,2825,2826,2827,4235,4232,4233,4234,4227,4228,4229,4230,4231,4236) )) qtd_perfumes
                        from favorita.pedidos pp
                        where pp.idsituacaoentrega >= 20000
                          and ( pp.tipopedido = 'F'
                             or exists ( select 1
                                         from favorita.classificacoespedidos cp
                                          where cp.idpedido = pp.idpedido 
                                           and cp.idcaracteristicapedido = 73 ) )
                          
                          and not exists ( select 1
                                           from favorita.classificacoespedidos c
                                           where c.idcaracteristicapedido = 8
                                             and c.idvalorcaracteristica  = 16
                                             and c.idpedido               = pp.idpedido )
                          and pp.valorapagar > 0
                          and pp.datacancelamento is null
                          and ( :P0_IDFILIAL is null 
                             or ( :P0_IDFILIAL = 1135 and pp.idfilialromance in (1089,1090,1132,124,122,320,221,1070,1072,1071,1082,1083,1210,1106,1227,1223,1243) )
                             or ( :P0_IDFILIAL != 1135 and pp.idfilialromance  = :P0_IDFILIAL ) )
                          and ( :P583_TIPO_PESQUISA is null
                           or ( :P583_TIPO_PESQUISA = 'D' and ( :P583_TIPODATA = 'E' and trunc(pp.dataemissao) between to_date(:P583_DTINI,'DD/MM/RRRR') and to_date(:P583_DTFIM,'DD/MM/RRRR')
                                                             or :P583_TIPODATA = 'A' and trunc(pp.dataentrega) between to_date(:P583_DTINI,'DD/MM/RRRR') and to_date(:P583_DTFIM,'DD/MM/RRRR') ) )
                           or ( :P583_TIPO_PESQUISA = 'S' and pp.idsemanaemissao = :P583_IDSEMANA )
                           or ( :P583_TIPO_PESQUISA = 'P' and pp.idsemanaemissao between :P583_IDSEMANA_INI and :P583_IDSEMANA_FIM ) )  
                        group by idrepresentante ) paris
                where ( :P0_IDFILIAL is null
                      or ( :P0_IDFILIAL = 1135 and exists ( select 1
                                                            from gerentes g
                                                            where g.idgerente = r.idgerente  
                                                              and g.idfilial  in (1089,1090,1132,124,122,320,221,1070,1072,1071,1082,1083,1210,1106,1227,1223,1243) ) )
                      or ( :P0_IDFILIAL != 1135 and r.idgerente = ( select idgerente
                                                                    from gerentes g
                                                                    where g.idfilial = :P0_IDFILIAL ) ) )
                  and r.ativo = 'S' -- Esta linha estava comentada, foi reativada no ticket de suporte 13527232
                  and nvl(ped.qtd,0) > 0
                  and r.idpessoa        = m.idpessoa(+)
                  and r.idrepresentante = ped.idrepresentante(+)
                  and r.idrepresentante = paris.idrepresentante(+)
                ```
        }
