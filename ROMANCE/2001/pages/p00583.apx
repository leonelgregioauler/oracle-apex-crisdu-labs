                declare
                  v number;
                  d date;
                begin
                
                  select idsemana+1
                  into v
                  from semana_dias
                  where semana = to_number(substr( :P583_SEMANA,1,2))
                    and ano    = substr( :P583_SEMANA,4,4);
                
                  select dt_ini
                  into d
                  from semana_dias
                  where idsemana = v;
                  return d;
                exception
                  when others then
                    return null;
                end;
                
                ```
