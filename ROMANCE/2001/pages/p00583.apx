            function fnc_imprimelista()   
            {
              if ( document.getElementById('P187_TIPODATA_0').value != "" )  {
                  var vtipodata = 'E';
              }
                
              if ( document.getElementById('P187_TIPODATA_1').value != "" )  {
                  var vtipodata = 'A';
              }
                
              var vdtini = document.getElementById('P187_DTINI').value;
              var vdtfim = document.getElementById('P187_DTFIM').value;
              var vidrepresentante = document.getElementById('P187_IDREPRESENTANTE').value;
                  
              var pjanela1=window.open('f?p=&APP_ID.:49:&SESSION.::NO::P49_TIPODATA,P49_DATAINI,P49_DATAFIM,P49_IDREPRESENTANTE:'+vtipodata+','+vdtini+','+vdtfim+','+vidrepresentante,'Lista de Pedidos', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=700,height=800,left=600,top=100','_blank'); pjanela1.focus(); void(0);
            }
