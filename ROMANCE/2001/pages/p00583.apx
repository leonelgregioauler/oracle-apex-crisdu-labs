    dynamicAction tipo-pesquisa (
        name: Tipo pesquisa
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P583_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P583_TIPO_PESQUISA
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P583_TIPODATA
                    P583_DTINI
                    P583_DTFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P583_TIPODATA
                    P583_DTINI
                    P583_DTFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 187
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 583
                items: {
                    P583_DTINI: &P583_DTINI.
                    P583_DTFIM: &P583_DTFIM.
                    P583_IDREPRESENTANTE: &P583_IDREPRESENTANTE.
                    P583_TIPO_PESQUISA: &P583_TIPO_PESQUISA.
                    P583_TIPODATA: &P583_TIPODATA.
                    P583_IDSEMANA: &P583_IDSEMANA.
                    P583_IDSEMANA_INI: &P583_IDSEMANA_INI.
                    P583_IDSEMANA_FIM: &P583_IDSEMANA_FIM.
                }
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

