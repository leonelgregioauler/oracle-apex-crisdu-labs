    pageItem P583_DTFIM (
        type: datePickerJquery
        label {
            label: até
            alignment: left
        }
        layout {
            sequence: 60
            region: @pedidos-feitos
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        validation {
            maxLength: 4000
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v number;
                  d date;
                begin
                
                  select idsemana+1
                  into v
                  from semana_dias
                  where semana = to_number(substr( :P583_SEMANA,1,2))
                    and ano    = substr( :P583_SEMANA,4,4);
                
                  select dt_fim
                  into d
                  from semana_dias
                  where idsemana = v;
                  return d;
                exception
                  when others then
                    return null;
                end;
                
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P583_DTINI (
