        }

        savedReport 45272387 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAPAGAMENTO (
                sequence: 3
            )

            displayColumn DOCUMENTOS (
                sequence: 7
            )

            displayColumn FORMAPAGAMENTO (
