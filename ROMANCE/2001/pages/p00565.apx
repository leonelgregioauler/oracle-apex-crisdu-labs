            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 75
                items: {
                    P75_IDFECHAMENTO: &P565_IDFECHAMENTO.
                    P75_IDFECHAMENTOREPRES: &P565_IDFECHAMENTOREPRES.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process delete-gerente (
        name: Delete Gerente
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  delete pagamentoscomissoesnegociacoes pg
                  where pg.idpagamentocomissao = :P565_IDEDITAR;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Comissão excluida com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5293547568300909823
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR_GER
        }
    )

