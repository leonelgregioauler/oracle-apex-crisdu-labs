page 565 (
    name: Comissões de Negociações Pagas
    title: Comissões de Negociações Pagas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 50%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function deletapgto(pid)
            {
            
              var answer = confirm("Confirma exlusão do pagamento da comissão?")
              if (answer)
                {
                  document.getElementById('P565_IDEDITAR').value = pid;
                  apex.submit('DELETAR');
                }
            }
            
            function deletapgto_ger(pid)
            {
            
              var answer = confirm("Confirma exlusão do pagamento da comissão?")
              if (answer)
                {
                  document.getElementById('P565_IDEDITAR').value = pid;
                  apex.submit('DELETAR_GER');
                }
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region pagamentos-realizados (
        name: Pagamentos Realizados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case
                          when ( select concluido
                                 from fechamentossemanais
                                 where idfechamento = :P565_IDFECHAMENTO ) = 'N' then
                           '<a href="javascript: deletapgto('||idpagamentocomissao||')"> Excluir Pgto</a>'           
                        else
                          '-'
                        end idpagamentocomissao
                     , cp.vendedora
                     , cp.datapagamento
                     , cp.semana
                     , cp.valorpago
                     , cp.formapagamento
                     , documentos
                from vw_comissoes_cobraki_paga cp
                where cp.idrepresentante = :P565_IDREPRESENTANTE
                  and cp.idfechamentorepres = :P565_IDFECHAMENTOREPRES
                  and cp.idgerente is null
                  and   (( :P564_TIPO is null or :P564_TIPO = 'A'  and cp.origem in ('B','A') )
                     or ( :P564_TIPO = 'C' and cp.origem = 'C' ) )
                union
                select case
                          when ( select concluido
                                 from fechamentossemanais
                                 where idfechamento = :P565_IDFECHAMENTO ) = 'N' then
                           '<a href="javascript: deletapgto_ger('||idpagamentocomissao||')"> Excluir Pgto</a>'           
                        else
                          '-'
                        end idpagamentocomissao
                     , cp.vendedora
                     , cp.datapagamento
                     , cp.semana
                     , cp.valorpago
                     , cp.formapagamento
                     , documentos
                from vw_comissoes_cobraki_paga cp
                where cp.idgerente= :P565_IDGERENTE
                  and cp.idfechamentorepres = :P565_IDFECHAMENTOREPRES
                  and (  ( :P564_TIPO = 'A' and cp.origem in ('B','A') )
                       or ( :P564_TIPO = 'C' and cp.origem = 'C' ) )
                order by datapagamento desc
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma comissão paga.
        }
        advanced {
            savedReportMappingIdentifier: 33789907235274410
        }

