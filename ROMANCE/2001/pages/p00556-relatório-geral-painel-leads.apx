page 556 (
    name: Relatório Geral Painel Leads
    alias: RELATÓRIO-GERAL-PAINEL-LEADS
    title: Relatório Geral Painel Leads
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    comments {
        comments: Criado por Maicon Aimi - 09/10/2025 - 10276934
    }

    region quantidade-de-empreendedoras-reativadas-painel-inativas (
        name: Quantidade de empreendedoras reativadas (painel inativas)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Pequeno gafanhoto! Atenção! Se ajustar essa query aqui na página 2001.556, é preciso replicar na query corespondente na página 2001.75 - Maicon Aimi - 10/10/2025 10276934
                select favorita.pck_util_fav.fnc_nomerepresentante(p.iddistribuidor) nome_representante
                     , initcap(c.nomecompleto) nome_lead
                     , nvl(c.cpf, c.documentoestrangeiro) documento
                     --, REGEXP_REPLACE(c.cpf, '([0-9]{3})([0-9]{3})([0-9]{3})([0-9]{2})', '\1.\2.\3-\4')  cpf_lead
                     , REGEXP_REPLACE(c.fone, '([0-9]{2})([0-9]{5})([0-9]{4})', '(\1) \2-\3') contato
                from roman.controlecontatossite c,
                     roman.painelcontatossite p,
                     roman.fechamentorepresentantes vv,
                     roman.semana_dias sd,
                     catal.pessoas pe,
                     catal.vendedoras v
                where c.idcontrolecontatossite = p.idcontrolecontatossite
                  and vv.idfechamentorepres = :P75_idfechamentorepres
                  and sd.semanacompleta = vv.semana
                  and p.iddistribuidor = :P75_idrepresentante
                  and (    (c.idpais = 1 AND c.cpf = pe.cpf)
                        or (c.idpais != 1 AND c.documentoestrangeiro = pe.documentoestrangeiro))
                  and trunc(p.datasituacao) between trunc(sd.dt_ini) and trunc(sd.dt_fim)
                  and p.idsituacaopainel = 2
                  and v.idpessoa = pe.idpessoa
                  and v.datareativacaovendedora between trunc(sd.dt_ini) and trunc(sd.dt_fim);
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent8
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1793547813395217906
        }

        column CONTATO (
            type: plainText
            heading {
                heading: Contato
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column DOCUMENTO (
            type: plainText
            heading {
                heading: Documento
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column NOME_LEAD (
            type: plainText
