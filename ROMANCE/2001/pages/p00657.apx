page 657 (
    name: Histórico de Pontos Vendedora
    title: Histórico de Pontos Vendedora
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region histórico-de-pontos (
        name: Histórico de Pontos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(h.idvendedora) consultora
                     , h.data
                     , case 
                         when h.idnotavenda is not null then
                           ( select nv.numeronota
                             from notasvendas nv
                             where nv.idnotavenda = h.idnotavenda )
                         when h.idpedido is not null then
                           'P'||h.idpedido
                       end numero
                     , h.pontos
                from historicospontospremios h
                where h.idvendedora = :P657_IDVENDEDORA
                order by h.idhistoricopontospremio desc;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 132698197324068509
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column DATA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column NUMERO (
            type: plainText
            heading {
                heading: Número Venda
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column PONTOS (
            type: plainText
            heading {
                heading: Pontos
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 1424498 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONSULTORA (
                sequence: 1
            )

            displayColumn DATA (
                sequence: 2
            )

            displayColumn NUMERO (
                sequence: 3
            )

            displayColumn PONTOS (
                sequence: 4
            )

            aggregate (
                column: PONTOS
            )

        )

    )

    pageItem P657_IDVENDEDORA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @histórico-de-pontos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

