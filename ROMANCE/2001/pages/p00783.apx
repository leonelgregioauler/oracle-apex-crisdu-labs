page 783 (
    name: Ranking das Melhores empreendedoras do Brasil
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 40
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region ranking-das-melhores-empreendedoras-do-brasil (
        name: Ranking das Melhores Empreendedoras do Brasil
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(nv.idfilial) Franquia
                     , roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) Distribuidor
                     , roman.pck_romance.fnc_cpfvendedora(nv.idvendedora) CPF
                     , roman.pck_romance.fnc_nomevendedora(nv.idvendedora) Empreendedora
                     , to_char(sum(pn.valorpago),'999G999G990D00') valor_pago
                from roman.notasvendas nv 
                   , roman.pagamentosnotasvendas pn 
                where pn.idnotavenda = nv.idnotavenda
                  and pn.valorpago > 0
                  and (:P783_IDREPRESENTANTE is null  or nv.idrepresentante = :P783_IDREPRESENTANTE)
                  and pn.idsemanacobranca between :P783_IDSEMANAINI and :P783_IDSEMANAFIM
                  and ((:P783_IDFILIAL = 1135 and nv.idfilial in (select f.idfilial from catal.filiais f where f.pertencecomercialromance = 'S')  )
                        or (:P783_IDFILIAL in (1,2,3,4) and nv.idfilial in (select f.idfilial from catal.filiais f where f.regional = :P783_IDFILIAL) )
                        or (:P783_IDFILIAL not in (1,2,3,4) and nv.idfilial  = :P783_IDFILIAL ) 
                        or (:P783_IDFILIAL = -2 and nv.idfilial in (select f.idfilial from catal.filiais f where f.ididioma = 1)))
                  /*and ((:P783_IDFILIAL = 1135 and nv.idfilial in (select f.idfilial from catal.filiais f where f.pertencecomercialromance = 'S')  )
                        or ( :P783_IDFILIAL in (1,2,3,4) and nv.idfilial in (select f.idfilial from catal.filiais f where f.regional = :P783_IDFILIAL) )
                        or ( :P783_IDFILIAL not in (1,2,3,4) and nv.idfilial  = :P783_IDFILIAL ) )*/
                
                group by nv.idfilial, nv.idrepresentante , nv.idvendedora
                order by 5 desc
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1322368339504849016
        }

        column CPF (
            type: plainText
            heading {
                heading: CPF
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column EMPREENDEDORA (
            type: plainText
            heading {
                heading: Empreendedora
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column FRANQUIA (
            type: plainText
            heading {
                heading: Franquia
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column VALOR_PAGO (
            type: plainText
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 13223906 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CPF (
                sequence: 3
            )

            displayColumn DISTRIBUIDOR (
                sequence: 2
            )

            displayColumn EMPREENDEDORA (
                sequence: 4
            )

            displayColumn FRANQUIA (
                sequence: 1
            )

            displayColumn VALOR_PAGO (
                sequence: 5
            )

        )

    )

    pageItem P783_FILTRAR (
        type: hidden
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P783_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select (select initcap(nvl(apelido,nomepessoa))
                        from catal.pessoas 
                        where idpessoa = f.idpessoa )|| CASE when v('APP_USER') in ('EVERTON','GUILHERME','OSIELF') then  ' - '||f.idfilial end display_value
                     , f.idfilial
                from catal.filiais f
                where ( f.tipofilial = 'D'
                         or f.tipofilial = 'O' and idfilial in (1085,1088,1153,1150) or f.tipofilial = 'F' and idfilial in (1075, 1150) or f.tipofilial = 'R' and idfilial = 240 or f.tipofilial = 'A')
                  and f.ativo = 'S'
                  and f.idfilial != 1217
                  and exists ( select 1 from roman.usuariosfiliais u where u.idfilial  = f.idfilial and u.usuario   = v('APP_USER') )           
                UNION all
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.idfilial = 160
                  and v('APP_USER') in ('GUILHERME','FERNANDO','OSIELF','MAICONAIMI','CESARH', 'DIEGOPIECHO')
                union all
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.idfilial = 1217
                  and v('APP_USER') IN ('GUILHERME', 'PAMELAB','EVERTON','MYCON','OSIELF')
                union all
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.idfilial = 1067
                  and v('APP_USER') IN ('BRUNOB','FERNANDO','OSIELF')
                union all
                select distinct 'Regional '||f.regional nome
                     , f.regional idfilial
                  from catal.filiais f
                 where f.regional is not null
                   and f.regional = 1
                   and v('APP_USER') in ('RAFAELK','DANIELEPACHECO','NATHALIAKINAST')
                union all
                select distinct 'Regional '||f.regional nome
                     , f.regional idfilial
                  from catal.filiais f
                 where f.regional is not null
                   and f.regional = 2
                   and v('APP_USER') in ('RAFAELK','NATHALIAKINAST')
                union all
                select distinct 'Regional '||f.regional nome
                     , f.regional idfilial
                  from catal.filiais f
                 where f.regional is not null
                   and f.regional = 3
                   and v('APP_USER') in ('RAFAELK','BETHANIASOUTO','NATHALIAKINAST')
                union all
                select distinct 'Regional '||f.regional nome
                     , f.regional idfilial
                  from catal.filiais f
                 where f.regional is not null
                   and f.regional = 4
                   and v('APP_USER') in ('RAFAELK','TIESSAMASOTTI','NATHALIAKINAST')
                union
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.idfilial = 1135
                  and v('APP_USER') IN ('NATHALIAKINAST','MAICONAIMI','RAFAELK','SUELENBAUER')
                union all
                select '- Brasil - ' display_value
                     , -2 return_value
                from dual
                where v('APP_USER') IN ('GUILHERME','OSIELF','MAICONAIMI','CESARH', 'DIEGOPIECHO','NATHALIAKINAST','RAFAELK','SUELENBAUER')
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P783_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||decode(r.ativo,'S','Ativo','N','Inativo') d
                     , r.idrepresentante r
                from catal.representantes r
                   , catal.gerentes g
                where r.idgerente = g.idgerente
                  and r.ativo = 'S'
                  and ( :P783_IDFILIAL is null or g.idfilial = :P783_IDFILIAL)
                  -- or (:P783_IDFILIAL in (1,2,3,4) and g.idfilial in (select f.idfilial from catal.filiais f where f.regional = :P783_IDFILIAL)))
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P783_IDFILIAL
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P783_IDSEMANAFIM (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semanacompleta
                     , idsemana
                from semana_dias s
                where s.dt_fim < sysdate +7
                  AND IDSEMANA >= :P783_IDSEMANAINI
                order by idsemana desc
                ```
        }
        cascadingLov {
            parentItems: P783_IDSEMANAINI
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P783_IDSEMANAINI (
        type: selectList
        label {
            label: De
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semanacompleta
                     , idsemana
                from semana_dias s
                where s.dt_fim < sysdate +7
                order by idsemana desc
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

