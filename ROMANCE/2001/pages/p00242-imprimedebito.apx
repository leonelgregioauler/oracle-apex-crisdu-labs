page 242 (
    name: Imprime Débitos
    alias: IMPRIMEDEBITO
    title: Imprime Débitos
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region comando (
        name: comando
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_imprime.prc_imprimelistadebitos(:P242_IDREPRESENTANTE,:P242_IDREGIAOVENDA,:P242_ENVIADOCOBRANCA);
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
    )

    pageItem P242_ENVIADOCOBRANCA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @comando
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P242_IDREGIAOVENDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @comando
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P242_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @comando
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

