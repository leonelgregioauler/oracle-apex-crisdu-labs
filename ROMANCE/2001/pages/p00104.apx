page 104 (
    name: Liberar Semana
    title: Liberar Semana
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region em-processamento (
        name: Em processamento
        type: staticContent
        source {
            htmlCode: <FONT color="green" size="8"> Aguarde! Gerando informações para liberar a próxima semana! Mantenha esta janela aberta até o final do processo. (Ela pode ser minimizada)</font>
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P104_PROCESSAR = 'S'
                ```
        }
    )

    region page_plug (
        name: " "
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region page_plug-2 (
        name: " "
        type: staticContent
        source {
            htmlCode: <FONT color="green"> Processo concluído, execute o atalho "Importar"!</font>
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P104_PROCESSAR
            value: N
        }
    )

    pageItem P104_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @page_plug
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P104_IDGERENTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @page_plug
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P104_IDREGIAOVENDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @page_plug
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P104_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @page_plug
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P104_PROCESSAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @page_plug
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P104_SEMANACOBRANCA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @page_plug
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction submit (
        name: submit
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: item=value
            item: P104_PROCESSAR
            value: S
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SUBMIT
            }
            execution {
                sequence: 10
            }
        )

    )

    validation já-processado (
        name: Já processado
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from controleexportacaonetbook t
                where idrepresentante = :P104_IDREPRESENTANTE
                ```
        }
        error {
            errorMessage: Já está sendo liberado a semana para este representante!
            displayLocation: inlineInNotification
        }
    )

    process gerar-arquivo (
        name: gerar arquivo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- 
                  pck_integracao.prc_exportarepresentante(pidrepresentante => :P104_IDREPRESENTANTE,
                                                          pidgerente       => null,
                                                          pidfilial        => null,
                                                          psemanacobranca  => null,
                                                          pidregiaovenda   => null);
                 --
                      delete controleexportacaonetbook 
                      where idrepresentante = :P104_IDREPRESENTANTE;
                      --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 16645158968137762
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from controleexportacaonetbook t
                where idrepresentante = :P104_IDREPRESENTANTE
                ```
        }
    )

    branch (
        name: Branch
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 2
                items: {
                    P2_IDFILIAL: &P2_IDFILIAL.
                    P2_IDGERENTE: &P2_IDGERENTE.
                    P2_IDREPRESENTANTE: &P2_IDREPRESENTANTE.
                    P2_IDREGIAOVENDA: &P2_IDREGIAOVENDA.
                    P2_PROCESSAR: N
                }
                successMessage: false
            }
        }
    )

)

