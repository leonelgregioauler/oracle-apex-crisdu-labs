    region analítico-acessos-mensal (
        name: Analítico Acessos Mensal
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from (
                      select w.idfilial
                           , pck_romance.fnc_nomefilial(w.idfilial) empresa
                           , extract(year from w.datalogin) ano
                           , extract(month from w.datalogin) mes
                           , count(1)      qtd
                      from registrosloginminhasacola w       
                      where w.idfilial is not null
                      and ( :P0_IDFILIAL = -1 
                         or ( :P0_IDFILIAL > 0 and W.idfilial = :P0_IDFILIAL ) )
                      group by w.idfilial
                             , extract(year from w.datalogin)  
                           , extract(month from w.datalogin) 
                --      order by 2,3,4
                --      where ( )
                     )
                pivot
                     (
                     sum(qtd)
                     for mes in ( 1 as "Janeiro"
                                , 2 as "Fevereiro" 
                                , 3 as "Março"
                                , 4 as "Abril"
                                , 5 as "Maio"
                                , 6 as "Junho"
                                , 7 as "Julho"
                                , 8 as "Agosto"
                                , 9 as "Setembro"
                                , 10 as "Outubro"
                                , 11 as "Novembro"
                                , 12 as "Dezembro")
                     )                 
                     order by 2,3 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
