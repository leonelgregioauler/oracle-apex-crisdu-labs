    region vendas-mensal (
        name: Vendas Mensal
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from (
                      select nv.idfilial
                           , pck_romance.fnc_nomefilial(nv.idfilial) empresa
                           , extract(year from nv.dataatualizacao) ano
                           , extract(month from nv.dataatualizacao) mes
                           , initcap(TO_CHAR(TO_DATE(extract(month from nv.dataatualizacao), 'MM'), 'MONth')) nomemes
                           , count(distinct nv.idvendedora)      qtd
                      from notasvendasapp nv
                      where :P425_TIPO = 'M'
                        and ( :P0_IDFILIAL = -1 
                           or ( :P0_IDFILIAL > 0 and nv.idfilial = :P0_IDFILIAL ) )
                      group by nv.idfilial
                             , extract(year from nv.dataatualizacao) 
                             , extract(month from nv.dataatualizacao)
                     )
                pivot
                     (
                     sum(qtd)
                     for ano in ( 2018 as "2018"
                                , 2019 as "2019" 
                                , 2020 as "2020"
                                , 2021 as "2021")
                     )                 
                     order by 2,3     
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
