    region acessos-mensal (
        name: Acessos Mensal
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from (
                      select w.idfilial
                           , pck_romance.fnc_nomefilial(w.idfilial) empresa
                           , extract(year from w.datalogin) ano
                           , extract(month from w.datalogin) mes
                           , initcap(TO_CHAR(TO_DATE(extract(month from w.datalogin), 'MM'), 'MONth')) nomemes
                           , count(1)      qtd
                      from registrosloginminhasacola w       
                      where w.idfilial is not null
                      and ( :P0_IDFILIAL = -1 
                         or ( :P0_IDFILIAL > 0 and W.idfilial = :P0_IDFILIAL ) )
                      group by w.idfilial
                             , extract(year from w.datalogin)  
                           , extract(month from w.datalogin) 
                --      order by 2,3,4
                --      where ( )
                     )
                pivot
                     (
                     sum(qtd)
                     for ano in ( 2018 as "2018"
                                , 2019 as "2019" 
                                , 2020 as "2020"
                                , 2021 as "2021")
                     )                 
                     order by 2,3
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P425_TIPO
            value: M
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5609532756110593946
        }

