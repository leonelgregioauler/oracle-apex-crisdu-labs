    region compartilhamento-mensal (
        name: Compartilhamento Mensal
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from (
                      select w.idfilial
                           , pck_romance.fnc_nomefilial(w.idfilial) empresa
                           , extract(year from w.datacompartilhamento) ano
                           , extract(month from w.datacompartilhamento) mes
                           , initcap(TO_CHAR(TO_DATE(extract(month from w.datacompartilhamento), 'MM'), 'month')) nomemes
                           , count(1)      qtd
                      from registroscompartilhafotos w       
                      where w.idfilial is not null
                      and ( :P0_IDFILIAL = -1 
                         or ( :P0_IDFILIAL > 0 and W.idfilial = :P0_IDFILIAL ) ) 
                      group by w.idfilial
                             , extract(year from w.datacompartilhamento)  
                           , extract(month from w.datacompartilhamento) 
                --      order by 2,3,4
                --      where ( )
                     )
                pivot
                     (
                     sum(qtd)
                     for ano in ( 2018 as "2018"
                                , 2019 as "2019" 
                                , 2020 as "2020"
                                , 2021 as "2021")
                     )                 
                     order by 2,3     
                ```
        }
