    region acessos-semanal (
        name: Acessos Semanal
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from (
                      select w.idfilial
                           , pck_romance.fnc_nomefilial(w.idfilial) empresa
                           , s.semana
                           , s.ano
                           , count(1)      qtd
                      from registrosloginminhasacola w              
                         , semana_dias               s
                      where w.idfilial is not null
                        and w.idsemana   = s.idsemana
                        and :P425_TIPO = 'S'
                        and ( :P0_IDFILIAL = -1 
                           or ( :P0_IDFILIAL > 0 and W.idfilial = :P0_IDFILIAL ) )
                      group by w.idfilial
                             , s.semana 
                             , s.ano
                     )
                pivot
                     (
                     sum(qtd)
                     for ano in ( 2018 as "2018"
                                , 2019 as "2019" 
                                , 2020 as "2020"
                                , 2021 as "2021")
                     )                 
                     order by 2,3     
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
