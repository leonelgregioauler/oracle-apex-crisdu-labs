    region vendas-mensal-2 (
        name: Vendas Mensal
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from (
                      select nv.idfilial
                           , pck_romance.fnc_nomefilial(nv.idfilial) empresa
                           , s.semana
                           , s.ano 
                           , count(distinct nv.idvendedora)      qtd
                      from notasvendasapp nv
                         , semana_dias               s           
                      where :P425_TIPO = 'S'
                        and s.idsemana = pck_util.fnc_idsemanadata(dataatualizacao)
                        and ( :P0_IDFILIAL = -1 
                           or ( :P0_IDFILIAL > 0 and nv.idfilial = :P0_IDFILIAL ) )
                      group by nv.idfilial
                           , s.semana
                           , s.ano
                     )
                pivot
                     (
                     sum(qtd)
                     for ano in ( 2018 as "2018"
                                , 2019 as "2019" 
                                , 2020 as "2020"
                                , 2021 as "2021")
                     )                 
