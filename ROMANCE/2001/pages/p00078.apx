    region pago-neste-acerto (
        name: Pago neste acerto
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '<a href="javascript: deletapgto('||IDITEMDEVOLUCAOREPRES||')"> Excluir </a>' remover
                     , IDITEMDEVOLUCAOREPRES
                     , ( select d.semana 
                         from devolucoesrepresentantes d 
                         where d.iddevolucaorepres = i.iddevolucaorepres ) "Devolução"
                     , pck_romance.fnc_nomeproduto(i.idproduto) produto
                     , ( select initcap(d.descricao)
                         from defeitos d 
                         where d.iddefeito = i.iddefeito) defeito
                     , ( nvl(i.qtd_pp,0)
                      + nvl(i.qtd_p,0)
                      + nvl(i.qtd_m,0)
                      + nvl(i.qtd_g,0)
                      + nvl(i.qtd_gg,0)
                      + nvl(i.qtd_egg,0)
                      + nvl(i.qtd_exgg,0)
                      + nvl(i.qtd_u,0) ) "Qtd"
                     , i.valorproduto vlrund
                     , ( nvl(i.qtd_pp,0)
                      + nvl(i.qtd_p,0)
                      + nvl(i.qtd_m,0)
                      + nvl(i.qtd_g,0)
                      + nvl(i.qtd_gg,0)
                      + nvl(i.qtd_egg,0)
                      + nvl(i.qtd_exgg,0)
                      + nvl(i.qtd_u,0) )* i.valorproduto vlrtotal
                     , ((( nvl(i.qtd_pp,0)
                      + nvl(i.qtd_p,0)
                      + nvl(i.qtd_m,0)
                      + nvl(i.qtd_g,0)
                      + nvl(i.qtd_gg,0)
                      + nvl(i.qtd_egg,0)
                      + nvl(i.qtd_exgg,0)
                      + nvl(i.qtd_u,0) ) * i.valorproduto)*0.6 /*tira 40% da vendedora*/)*0.8 vlrtotalpago
                     , i.situacaodefeito
                     , i.idfechamentoreprespago
                from itensdevolucaorepres i
                where idfechamentoreprespago = :P78_IDFECHAMENTOREPRES
                  and idfechamentoreprespago < 80783
                union
                select '<a href="javascript: deletapgto('||IDITEMDEVOLUCAOREPRES||')"> Excluir </a>' remover
                     , IDITEMDEVOLUCAOREPRES
                     , ( select d.semana 
                         from devolucoesrepresentantes d 
                         where d.iddevolucaorepres = i.iddevolucaorepres ) "Devolução"
                     , pck_romance.fnc_nomeproduto(i.idproduto) produto
                     , ( select initcap(d.descricao)
                         from defeitos d 
                         where d.iddefeito = i.iddefeito) defeito
                     , ( nvl(i.qtd_pp,0)
                      + nvl(i.qtd_p,0)
                      + nvl(i.qtd_m,0)
                      + nvl(i.qtd_g,0)
                      + nvl(i.qtd_gg,0)
                      + nvl(i.qtd_egg,0)
                      + nvl(i.qtd_exgg,0)
                      + nvl(i.qtd_u,0) ) "Qtd"
                     , i.valorproduto vlrund
                     , ( nvl(i.qtd_pp,0)
                      + nvl(i.qtd_p,0)
                      + nvl(i.qtd_m,0)
                      + nvl(i.qtd_g,0)
                      + nvl(i.qtd_gg,0)
                      + nvl(i.qtd_egg,0)
                      + nvl(i.qtd_exgg,0)
                      + nvl(i.qtd_u,0) )* i.valorproduto vlrtotal
                     , case 
                         when :P0_IDFILIAL not in (1041,1095,1094,1081) then
                           ((( nvl(i.qtd_pp,0)
                              + nvl(i.qtd_p,0)
                              + nvl(i.qtd_m,0)
                              + nvl(i.qtd_g,0)
                              + nvl(i.qtd_gg,0)
                              + nvl(i.qtd_egg,0)
                              + nvl(i.qtd_exgg,0)
                              + nvl(i.qtd_u,0) ) * i.valorproduto)*decode( i.comissao,'S',0.6 /*tira 40% da vendedora*/
                                                                                         , 1  /* produto sem comissao */)) 
                                                                                         /* comissao do representante é retirada depois no acerto*/
                         when :P0_IDFILIAL in (1041,1095,1094,1081) then
                           ((( nvl(i.qtd_pp,0)
                              + nvl(i.qtd_p,0)
                              + nvl(i.qtd_m,0)
                              + nvl(i.qtd_g,0)
                              + nvl(i.qtd_gg,0)
                              + nvl(i.qtd_egg,0)
                              + nvl(i.qtd_exgg,0)
                              + nvl(i.qtd_u,0) ) * i.valorproduto)*decode( i.comissao,'S',0.7 /*tira 40% da vendedora*/
                                                                                         , 1  /* produto sem comissao */)) 
                                                                                         /* comissao do representante é retirada depois no acerto*/
                       end vlrtotalpagar
                     , i.situacaodefeito
                     , i.idfechamentoreprespago
                from itensdevolucaorepres i
                where idfechamentoreprespago = :P78_IDFECHAMENTOREPRES
                  and idfechamentoreprespago >= 80783
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
