    button pagar-tudo (
        buttonName: PAGAR_TUDO
        label: Pagar Tudo
        layout {
            sequence: 10
            region: @new
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente PAGAR tudo?','PAGAR_TUDO');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from itensdevolucaorepres i
                where i.iddefeito is not null
                  and i.situacaodefeito is null
                  and exists ( select 1
                                 from defeitos d
                                 where d.iddefeito = i.iddefeito
                                   and d.origemdefeito = 'R')
                  and exists ( select 1
                               from devolucoesrepresentantes d 
                               where d.iddevolucaorepres = i.iddevolucaorepres 
                               and d.idrepresentante = ( select idrepresentante 
                                                         from fechamentorepresentantes 
                                                         where idfechamentorepres = :P78_IDFECHAMENTOREPRES ) )
                ```
