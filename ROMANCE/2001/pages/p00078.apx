    process pagar-tudo (
        name: Pagar tudo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update itensdevolucaorepres i
                  set situacaodefeito = 'P'
                    , idfechamentoreprespago = :P78_IDFECHAMENTOREPRES
                  where i.iddefeito is not null
                    and i.situacaodefeito is null
                    and exists ( select 1
                                 from defeitos d
                                 where d.iddefeito = i.iddefeito
                                   and d.origemdefeito = 'R')
                    and exists ( select 1
                                 from devolucoesrepresentantes d 
                                 where d.iddevolucaorepres = i.iddevolucaorepres 
