page 78 (
    name: Cadastro de Resgates
    title: Cadastro de Resgates
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 70%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='Confirma o não pagamento de todos os resgates?';
            
            
            var htmldb_delete_message_2='É necessário entrar em contato com a Controladoria para executar esta operação!';
            
            function deletapgto(pid)
            {
              document.getElementById('P78_DELETAR').value = pid;
                
              var answer = confirm("Confirma exlusão do Resgate?");
              if (answer)
                {
                  apex.submit('REMOVER');
                }
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-resgates (
        name: Cadastro de Resgates
        type: staticContent
        source {
            htmlCode:
                ```html
                <script language="javascript">
                function  confirmaresgate(event)
                { 
                var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
                
                if (tecla==13) {
                var answer = confirm("Confirma inclusão de resgate?")
                	if (answer){            
                		apex.submit('CREATE');
                	}
                }
                }
                </script>
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
    )

    region defeitos-pendentes-de-pagamento (
        name: Defeitos Pendentes de Pagamento
        type: tabform
        source {
            sqlQuery:
                ```sql
                select IDITEMDEVOLUCAOREPRES
                     , ( select d.semana 
                         from devolucoesrepresentantes d 
                         where d.iddevolucaorepres = i.iddevolucaorepres ) "Devolução"
                     , (select p.codigosisdist||'-'||p.nomeproduto
                        from produtos p
                        where p.idproduto = i.idproduto) "Produto"
                     , ( select initcap(d.descricao)
                         from defeitos d 
                         where d.iddefeito = i.iddefeito) defeito
                     , ( nvl(i.qtd_pp,0)
                      + nvl(i.qtd_p,0)
                      + nvl(i.qtd_m,0)
                      + nvl(i.qtd_g,0)
                      + nvl(i.qtd_gg,0)
                      + nvl(i.qtd_egg,0)
                      + nvl(i.qtd_exgg,0)
                      + nvl(i.qtd_u,0) ) Qtd
                     , i.valorproduto vlrund
                     , ( nvl(i.qtd_pp,0)
                      + nvl(i.qtd_p,0)
                      + nvl(i.qtd_m,0)
                      + nvl(i.qtd_g,0)
                      + nvl(i.qtd_gg,0)
                      + nvl(i.qtd_egg,0)
                      + nvl(i.qtd_exgg,0)
                      + nvl(i.qtd_u,0) ) * i.valorproduto vlrtotal
                     , case 
                         when :P0_IDFILIAL not in (1095,1111,1121,1094,1109,1129,1194,1081,1108,1041) then
                           ((( nvl(i.qtd_pp,0)
                              + nvl(i.qtd_p,0)
                              + nvl(i.qtd_m,0)
                              + nvl(i.qtd_g,0)
                              + nvl(i.qtd_gg,0)
                              + nvl(i.qtd_egg,0)
                              + nvl(i.qtd_exgg,0)
                              + nvl(i.qtd_u,0) ) * i.valorproduto)*decode( i.comissao,'S',0.6 /*tira 40% da vendedora*/
                                                                                         , 1  /* produto sem comissao */)) 
                                                                                         /* comissao do representante é retirada depois no acerto*/
                         when :P0_IDFILIAL in (1095,1111,1121,1094,1109,1129,1194,1081,1108,1041) then
                           ((( nvl(i.qtd_pp,0)
                              + nvl(i.qtd_p,0)
                              + nvl(i.qtd_m,0)
                              + nvl(i.qtd_g,0)
                              + nvl(i.qtd_gg,0)
                              + nvl(i.qtd_egg,0)
                              + nvl(i.qtd_exgg,0)
                              + nvl(i.qtd_u,0) ) * i.valorproduto)*decode( i.comissao,'S',0.7 /*tira 40% da vendedora*/
                                                                                         , 1  /* produto sem comissao */)) 
                                                                                         /* comissao do representante é retirada depois no acerto*/
                       end vlrtotalpagar
                     , i.situacaodefeito
                     , i.idfechamentoreprespago
                     , observacao
                from itensdevolucaorepres i
                where i.iddefeito is not null
                  and i.situacaodefeito is null
                  and exists ( select 1
                                 from defeitos d
                                 where d.iddefeito = i.iddefeito
                                   and d.origemdefeito = 'R')
                  and exists ( select 1
                               from devolucoesrepresentantes d 
                               where d.iddevolucaorepres = i.iddevolucaorepres 
                               and d.idrepresentante = ( select idrepresentante 
                                                         from fechamentorepresentantes 
                                                         where idfechamentorepres = :P78_IDFECHAMENTOREPRES ) )
                order by i.iddevolucaorepres desc
                
                ```
        }
        layout {
            sequence: 35
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Não há peças com defeitos para ser cobrado.
        }
        componentAdvanced {
            stripHtml: true
        }

