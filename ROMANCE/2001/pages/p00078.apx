    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDPERDA.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P78_IDPERDA := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 30
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 580698694769159473
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

