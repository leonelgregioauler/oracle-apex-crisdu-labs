            items: P408_IDESTOQUEINSUMO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @estoque-de-inusmos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

