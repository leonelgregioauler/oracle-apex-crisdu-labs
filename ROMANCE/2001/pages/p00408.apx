page 408 (
    name: Estoque Insumos
    title: Estoque Insumos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region estoque-de-inusmos (
        name: Estoque de Inusmos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idestoqueinsumo
                     , e.idproduto
                     , ( select initcap(c.nome)
                         from categorias c
                         where c.idcategoria = p.idcategoria ) categoria
                     , ( select initcap(cc.nome)
                         from caracteristicascategorias cc
                         where cc.idcategoria = p.idcaracteristicacateg ) subctegoria
                     , p.codigosisdist codigo
                     , initcap(p.nomeproduto) produto
                     , decode(e.ativo,'S','Ativo','N','Inativo') ativo
                     , e.valor
                     , e.entrada
                     , e.saida
                     , e.atual
                from estoquesinsumos e
                   , produtos p
                where p.idproduto = e.idproduto
                  and e.idfilial  = :P0_IDFILIAL
                  and ( :P408_IDESTOQUEINSUMO is null or e.idestoqueinsumo = :P408_IDESTOQUEINSUMO )
                order by 1
                ```
            pageItemsToSubmit: P408_IDESTOQUEINSUMO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4437833963350659156
        }

