    pageItem P408_IDESTOQUEINSUMO (
        type: selectList
        label {
            label: Produto de Insumo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist||' - '||initcap(p.nomeproduto) display_value
                     , e.idestoqueinsumo return_value
                from produtos p
                   , estoquesinsumos e
                where e.idproduto = p.idproduto
                  and e.idfilial  = :P0_IDFILIAL
                order by p.nomeproduto 
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
