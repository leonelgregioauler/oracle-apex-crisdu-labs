        action valida-se-o-grid-esta-carregado (
            name: Valida se o grid esta carregado
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // Bloqueia a abertura da região se o grid estiver vazio
                    var model = apex.region('igPrecificacao').call('getViews', 'grid').model;
                    var temRegistro = false;
                    
                    model.forEach(function () { temRegistro = true; });
                    
                    if (!temRegistro) {
                        apex.message.alert('Nenhum registro na consulta. Informe os parametros necessários e execute a consulta (botão Filtrar) antes de atualizar os valores.');
                        apex.da.cancelEvent.call(this); // impede as próximas ações da DA (Set Value / Open Region)
                        return;
                    }
                    
                    ```
            }
            execution {
                sequence: 1
                fireOnInit: false
            }
        )

    )

    process acrescimosprecificacaorep-save-interactive-grid-data (
        name: ACRESCIMOSPRECIFICACAOREP  - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @acrescimosprecificacaorep
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                BEGIN
                  IF :APEX$ROW_STATUS = 'U' THEN
                    ROMAN.PCK_CADASTROS_RMC.PRC_COLLECTION_PRECIFICACAO_834( p_acao           => 'ATUALIZAR',
                                                                             p_instancia      => :P834_INSTANCIA,
                                                                             p_idacrescimo    => :IDACRESCIMOPRECIFICACAOREP,
                                                                             p_valoracrescimo => :VALORACRESCIMO,
                                                                             p_ativo          => :ATIVO);
                  END IF;
                END;
                
                ```
        }
        lockRow {
            lockRow: false
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1222439481269117027
        }
    )

    process controla-acesso-aos-filtros (
        name: Controla Acesso aos Filtros
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  IF :REQUEST = 'ATALHO' THEN
                    :P834_ORIGEM := 'ATALHO';
                    :P834_ORIGEM := 'REPRESENTANTE';
                  ELSE
                    :P834_ORIGEM := 'MENU';
                    -- Aberto pelo menu: limpa o que ficou na sessão de uma abertura anterior pelo atalho
                    :P834_IDREPRESENTANTE := NULL;
                    :P834_IDREGIAOVENDA   := NULL;
                    :P834_IDCATEGORIA     := NULL;
                  END IF;
                  --
                  -- Categoria: vem com todas as categorias ativas marcadas (usuario desmarca as que nao quiser)
                  IF :P834_IDCATEGORIA IS NULL THEN
                    SELECT LISTAGG(IDCATEGORIA, ':') WITHIN GROUP (ORDER BY NOME)
                      INTO :P834_IDCATEGORIA
                      FROM ROMAN.CATEGORIAS
                     WHERE ATIVO = 'S';
                  END IF;
                END;
                
                ```
        }
        execution {
            sequence: 1
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1221655156778070636
        }
    )

