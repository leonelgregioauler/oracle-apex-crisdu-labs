    dynamicAction marca-distribuidores-das-regioes (
        name: Marca Distribuidores das Regioes
        execution {
            sequence: 36
        }
        when {
            selectionType: items
            items: P834_IDREGIAOVENDA
        }

        action seleciona-os-distribuidores-das-regioes (
            name: Seleciona os distribuidores das regioes
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                      -- Marca todos os distribuidores ativos da franquia que possuem as Regioes selecionadas
                      SELECT LISTAGG(IDREPRESENTANTE, ':') WITHIN GROUP (ORDER BY IDREPRESENTANTE)
                        INTO :P834_IDREPRESENTANTE
                        FROM (SELECT DISTINCT R.IDREPRESENTANTE
                                FROM ROMAN.REGIOESREPRESENTANTES RR
                                   , CATAL.REPRESENTANTES R
                                   , CATAL.GERENTES G
                               WHERE R.IDREPRESENTANTE = RR.IDREPRESENTANTE
                                 AND G.IDGERENTE       = R.IDGERENTE
                                 AND G.IDFILIAL        = :P0_IDFILIAL
                                 AND R.ATIVO           = 'S'
                                 AND RR.IDREGIAOVENDA in (SELECT /*+ CARDINALITY(t 10) */ TO_NUMBER(column_value) FROM TABLE(apex_string.split(:P834_IDREGIAOVENDA, ':')) t)
                                 AND EXISTS (select 1
                                               from ROMAN.ACRESCIMOSPRECIFICACAOREP AP
                                              where AP.IDREGIAOREPRESENTANTE = RR.IDREGIAOREPRESENTANTE));
                    END;
                    ```
                itemsToSubmit: [
                    P0_IDFILIAL
                    P834_IDREGIAOVENDA
                ]
                itemsToReturn: P834_IDREPRESENTANTE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction marca-todas-as-regioes (
        name: Marca Todas as Regioes
        execution {
            sequence: 35
        }
        when {
            selectionType: items
            items: P834_IDREPRESENTANTE
        }

        action seleciona-todas-as-regioes-dos-distribuidores (
            name: Seleciona todas as regioes dos distribuidores
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    -- sim foi decidido pra vir tudo selecionado e o usuario DESELECIONAR O QUE ELE NÃO QUER....................
                    -- DIONYRINKER
                    
                    BEGIN
                      -- Mesma regra do LOV de P834_IDREGIAOVENDA, retornando todos os IDs separados por ":"
                      SELECT LISTAGG(IDREGIAOVENDA, ':') WITHIN GROUP (ORDER BY DESCRICAO)
                        INTO :P834_IDREGIAOVENDA
                        FROM (SELECT DISTINCT RV.IDREGIAOVENDA, RV.DESCRICAO
                                FROM ROMAN.REGIOESVENDA RV
                                   , ROMAN.REGIOESREPRESENTANTES RR
                               WHERE RV.IDREGIAOVENDA = RR.IDREGIAOVENDA
                                 AND RV.ATIVO = 'S'
                                 AND RR.IDREPRESENTANTE in (SELECT /*+ CARDINALITY(t 10) */ TO_NUMBER(column_value) FROM TABLE(apex_string.split(:P834_IDREPRESENTANTE, ':')) t)
                                 AND EXISTS (select 1
                                               from ROMAN.ACRESCIMOSPRECIFICACAOREP R
                                              where R.IDREGIAOREPRESENTANTE = RR.IDREGIAOREPRESENTANTE));
                    END;
                    ```
                itemsToSubmit: P834_IDREPRESENTANTE
                itemsToReturn: P834_IDREGIAOVENDA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P834_IDREPRESENTANTE
            }
        )

    )

