        layout {
            sequence: 40
            region: @atualização-em-lote
            slot: regionBody
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        comments {
            comments: Este campo foi criado para receber o erro vindo do banco, pois o raise direto após a execução do processo de banco mostrava na tela mas a barra de progresso nao sumia, então dessa forma o java esconde a barra de progresso e captura a msg de erro no item e mostra para o usuario
        }
    )

    pageItem P834_IDCATEGORIA (
        type: selectMany
        label {
            label: Categoria
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT NOME d
                     , IDCATEGORIA r 
                  FROM ROMAN.CATEGORIAS 
                 WHERE ATIVO = 'S' 
                 ORDER BY NOME
                ```
        }
        layout {
            sequence: 30
            region: @parametros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        help {
            helpText:
                ```html
                <p>Todas as Categorias vêm marcadas ao abrir a tela. Desmarque as que não quiser ver.</p>
                <p>Campo vazio também lista todas as Categorias.</p>
                <p>Aviso: listar todas as Categorias pode causar lentidão na consulta.</p>
                ```
        }
    )

    pageItem P834_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT NOMEPRODUTO d, IDPRODUTO r 
                  FROM ROMAN.PRODUTOS 
                 WHERE (:P834_IDCATEGORIA IS NULL OR IDCATEGORIA = :P834_IDCATEGORIA) 
                   AND ATIVO = 'S' 
                 ORDER BY NOMEPRODUTO
                ```
            displayExtraValues: false
            nullDisplayValue: Todos
        }
        cascadingLov {
            parentItems: P834_IDCATEGORIA
            itemsToSubmit: P834_IDCATEGORIA
        }
        layout {
            sequence: 40
            region: @parametros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: never
        }
    )

    pageItem P834_IDREGIAOREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @parametros
            slot: regionBody
        }
        advanced {
