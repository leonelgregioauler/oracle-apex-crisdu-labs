    pageItem P834_DESC_FILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @parametros
            slot: regionBody
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(:P0_IDFILIAL) FILIAL
                  from dual
                ```
