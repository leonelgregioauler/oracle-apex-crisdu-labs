    dynamicAction carrega-collection (
        name: Carrega Collection
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action chama-barra-de-progresso (
            name: Chama Barra de Progresso
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // Animação: enche de 0% a 100% em 5s e recomeça, até a barra ser removida
                    if (!$('#p834-loading-css').length) {
                        $('head').append('<style id="p834-loading-css">@keyframes p834-carregar { from { width: 0; } to { width: 100%; } }</style>');
                    }
                    
                    $('#p834-loading').remove(); // evita duas barras na tela
                    
                    $(
                        '<div id="p834-loading" style="position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center">' +
                          '<div style="background:#fff;padding:20px 24px;border-radius:8px;width:340px;box-shadow:0 4px 16px rgba(0,0,0,.25)">' +
                            '<div style="margin-bottom:10px;font-weight:600">Carregando registros...</div>' +
                            '<div style="height:10px;background:#e5e5e5;border-radius:5px;overflow:hidden">' +
                              '<div style="height:100%;width:0;background:#3b2f63;animation:p834-carregar 5s linear infinite"></div>' +
                            '</div>' +
                          '</div>' +
                        '</div>'
                    ).appendTo('body');
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action confirma-todos-representantes (
            name: Confirma Todos Representantes
            action: confirm
            settings {
                title: Atenção!
                message:
                    ```html
                    Você esta filtrando todos os Distribuidores de &P834_DESC_FILIAL., essa consulta pode demorar mais que o normal devido ao alto volume de dados, continuar?
                    
                    ```
                style: warning
                icon: fa-warning
                confirmLabel: Sim
                cancelLabel: Não
            }
            execution {
                sequence: 8
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNull
                item: P834_IDREPRESENTANTE
            }
            serverSideCondition {
                type: itemIsNull
                item: P834_IDREPRESENTANTE
            }
        )

        action grava-colletion (
            name: Grava Colletion
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                      --
                      :P834_ERRO := null;
                      --
                      ROMAN.PCK_CADASTROS_RMC.PRC_COLLECTION_PRECIFICACAO_834(p_acao => 'LIMPAR', p_instancia => :P834_INSTANCIA);
                      --
                      ROMAN.PCK_CADASTROS_RMC.PRC_COLLECTION_PRECIFICACAO_834( p_acao            => 'INSERIR',
                                                                               p_idfilial        => :P0_IDFILIAL,
                                                                               p_idcategoria     => :P834_IDCATEGORIA,
                                                                               p_idproduto       => :P834_IDPRODUTO,
                                                                               p_idrepresentante => :P834_IDREPRESENTANTE,
                                                                               p_idregiaovenda   => :P834_IDREGIAOVENDA,
                                                                               p_instancia       => :P834_INSTANCIA);
                    --
                    EXCEPTION
                      WHEN OTHERS THEN
                        ROLLBACK;
                        :P834_ERRO := REGEXP_REPLACE(SQLERRM, '^ORA-[0-9]+: ', '');
                    --
                    END;
                    ```
                itemsToSubmit: [
                    P0_IDFILIAL
                    P834_IDCATEGORIA
                    P834_IDPRODUTO
                    P834_IDREPRESENTANTE
                    P834_IDREGIAOVENDA
                    P834_INSTANCIA
                ]
                itemsToReturn: P834_ERRO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-confirm (
            action: confirm
            settings {
                message: Certo! então tenha paciência e aguarde o carregamento de dados terminar...
                style: information
                icon: fa-emoji-sweet-smile
                confirmLabel: Começar!
                cancelLabel: Desistir
            }
            execution {
                sequence: 9
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @acrescimosprecificacaorep
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action some-barra-progresso (
            name: Some Barra Progresso
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('#p834-loading').remove();
                    
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action trata-possivel-erro-vindo-do-banco (
            name: Trata possivel erro vindo do banco 2
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var erro = $v('P834_ERRO');
                    
                    if (erro) {
                        $('#p834-loading').remove();
                        apex.message.alert(erro);
                        apex.da.cancelEvent.call(this);
                    }
                    
                    ```
            }
            execution {
                sequence: 21
                fireOnInit: false
            }
        )

    )

