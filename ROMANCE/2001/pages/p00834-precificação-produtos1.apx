    dynamicAction atualiza-valores (
        name: Atualiza Valores
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @bt-atualizar-valor
        }

        action atualiza-valores (
            name: Atualiza Valores
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                      --
                      :P834_ERRO := null;
                      --
                      ROMAN.PCK_CADASTROS_RMC.PRC_ATUALIZA_ACRESCIMO_CATEGORIA( p_valoracrescimo => :P834_LOTE_VALORACRESCIMO,
                                                                                p_instancia      => :P834_INSTANCIA);
                      --
                      EXCEPTION
                      WHEN OTHERS THEN
                        ROLLBACK;
                        :P834_ERRO := REGEXP_REPLACE(SQLERRM, '^ORA-[0-9]+: ', '');
                      --
                    END;
                    
                    ```
                itemsToSubmit: [
                    P834_LOTE_VALORACRESCIMO
                    P834_INSTANCIA
                ]
                itemsToReturn: P834_ERRO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action chama-barra-progresso (
            name: Chama Barra Progresso 2
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // Animação: enche de 0% a 100% em 2s e recomeça, até a barra ser removida
                    if (!$('#p834-loading-css').length) {
                        $('head').append('<style id="p834-loading-css">@keyframes p834-carregar { from { width: 0; } to { width: 100%; } }</style>');
                    }
                    
                    $('#p834-loading').remove(); // evita duas barras na tela
                    
                    $(
                        '<div id="p834-loading" style="position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center">' +
                          '<div style="background:#fff;padding:20px 24px;border-radius:8px;width:340px;box-shadow:0 4px 16px rgba(0,0,0,.25)">' +
                            '<div style="margin-bottom:10px;font-weight:600">Atualizando registros...</div>' +
                            '<div style="height:10px;background:#e5e5e5;border-radius:5px;overflow:hidden">' +
                              '<div style="height:100%;width:0;background:#3b2f63;animation:p834-carregar 5s linear infinite"></div>' +
                            '</div>' +
                          '</div>' +
                        '</div>'
                    ).appendTo('body');
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action msg-sucesso (
            name: Msg Sucesso
            action: executeJsCode
            settings {
                jsCode: $('#p834-loading').remove(); apex.message.showPageSuccess('Valores atualizados com sucesso.');
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @atualização-em-lote
            }
            execution {
                sequence: 21
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @acrescimosprecificacaorep
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action trata-possivel-erro-vindo-do-banco (
            name: Trata possivel erro vindo do banco
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var erro = $v('P834_ERRO');
                    
                    if (erro) {
                        $('#p834-loading').remove();
                        apex.message.alert(erro);
                        apex.da.cancelEvent.call(this);
                    }
                    
                    ```
            }
            execution {
                sequence: 21
                fireOnInit: false
            }
        )

