page 834 (
    name: Precificação Produtos
    alias: PRECIFICAÇÃO-PRODUTOS1
    title: Precificação Produtos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        inline:
            ```css
            #regiao-cinza {
              background-color: #dddddd !important;
              border: 1px solid #cfcfcf;
            }
            ```
    }

    region acrescimosprecificacaorep (
        name: "ACRESCIMOSPRECIFICACAOREP "
        title: Precificação por Produto
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT n001 IDACRESCIMOPRECIFICACAOREP,
                       n002 IDREGIAOREPRESENTANTE,
                       ROMAN.PCK_ROMANCE.fnc_nomerepresentante(n004) REPRESENTANTE,
                       c006 REGIAO,
                       c002 CATEGORIA,
                       c003 PRODUTO,
                       n003 VALORACRESCIMO,
                       c004 ATIVO,
                       d001 DTINCLUSAO,
                       c005 USUARIOCADASTROU,
                       n004 IDREPRESENTANTE
                  FROM apex_collections
                 WHERE collection_name = 'COL_PRECIFICACAO_834_' || :P834_INSTANCIA
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                margin-top-md
            ]
        }
        advanced {
            htmlDomId: igPrecificacao
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: [
                actionsMenu
                saveButton
            ]
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 2471111490110974930
        }

