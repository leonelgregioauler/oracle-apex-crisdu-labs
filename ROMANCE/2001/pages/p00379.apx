    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region legenda (
        name: Legenda
        type: staticContent
        source {
            htmlCode:
                ```html
                <b>Aberturas - </b>Clientes novas com apenas uma nota que foram cadastradas no período/semana. <br>
                <b>Acerto Efetuado - </b>Clientes que foram atendidas no período/semana. <br>
                <b>Aguardando Atendimento - </b>Clientes que estão com notas Aguardando Acerto no período/semana. <br>
                <b>Assinatura Reprovada Ag. Acerto - </b>Notas Aguardando atendimento com Assinatura Eletrônica Reprovada.<br>
                <b>Assinatura Reprovada Débito - </b>Nota Acertada que está com Débito e Assinatura Eletrônica Reprovada.<br>
                <b>Clientes Inativas da Semana - </b>Clientes que estão inativas e foram atendidas no período/semana.<br>
                <b>Clientes Novas (Acertadas) -</b> Clientes que possuem apenas 1 nota Acertada na empresa e que foi no período/semana.<br>
                <b>Débitos Deixados na Semana -</b> Notas que foram acertadas no período/semana e que estão com Débito.<br>
                <b>Notas com Débitos -</b> Notas que foram acertadas no período/semana e que estão débito igual ou menor ao Valor informado.<br>
                <b>Notas com Devolução Total -</b> Notas que foram acertadas no período/semana e que estão com devolução total de mercadorias.<br>
                <b>Notas com 1 Item -</b> Notas que foram acertadas/distribuidas no período/semana com apenas 1 produto cadastrado.<br>
                <b>Notas em Aberto -</b> Notas que estão aguardando atendimento remarcadas, com semanas em aberto de acordo com o filtro utilizado de quantidades.<br>
                <b>Notas Remarcadas -</b> Notas que estão aguardando atendimento que foram remarcadas.<br>
                <b>Valores Baixos de Pagamento -</b> Notas que foram atendidas no período/semana com valores pagos até o valor sugerido no filtro.<br>
                
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P379_ATENDENTE (
        type: selectList
        label {
            label: Atendente a Receber a(s) Tarefa(s)
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeusuario(usuario) display_value
                     , idusuario
                from usuarios u
                where u.ativo = 'S'
                  and exists ( select 1
                               from usuariosgruposatendimento ug
                               where ug.usuario = u.usuario 
                                 and ug.idgrupoatendimento = 22 )
                order by 1
                ```
            nullDisplayValue: - Todas Atendentes -
        }
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2514,v('APP_USER')) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

