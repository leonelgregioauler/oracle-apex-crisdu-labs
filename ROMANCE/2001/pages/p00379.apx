                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ),0) valorpagonasemana
                     , v.idpessoa
                     , null gerartarefa
                     , null remarcada_proxima_visita
                     , 26
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 3
                  and n.idrepresentante = :P379_IDREPRESENTANTE
                  and ( ( :P379_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM )
                     or ( :P379_TIPOSEMANA = 'C' and n.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ) )
                  -- Clientes Novas (Acertadas)
                  and :P379_FILTROS = 26
                  and ( select count(1)
                        from notasvendas nv
                        where nv.idvendedora = v.idvendedora ) = 1
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento = 73
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ),0) valorpagonasemana
                     , v.idpessoa
                     , null gerartarefa
                     , null remarcada_proxima_visita
                     , 64
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.saldo > 0
                  and n.idrepresentante = :P379_IDREPRESENTANTE
                  and ( ( :P379_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM )
                     or ( :P379_TIPOSEMANA = 'C' and n.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ) )
                  -- Assinatura Reprovada Débito
                  and :P379_FILTROS = 64
                  and exists ( select 1
                               from assinaturaseletronicas a
                               where a.idnotavenda = n.idnotavenda
                                 and a.status = 'C'
                                 and a.situacao = 'R'
                                 and not exists ( select 1
                                                  from assinaturaseletronicas aa
                                                  where aa.idnotavenda = a.idnotavenda  
                                                   and aa.idassinaturaeletronica > a.idassinaturaeletronica
                                                   and aa.status = 'C'
                                                   and aa.situacao = 'A' ) )
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento = 73
                                     and t.idsituacao in (0,10,20) )
                
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , 0 valorpagonasemana
                     , v.idpessoa
                     , null gerartarefa
                     , null remarcada_proxima_visita
                     , 65
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 3
                  and n.idrepresentante = :P379_IDREPRESENTANTE
                  and ( ( :P379_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM )
                     or ( :P379_TIPOSEMANA = 'C' and n.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ) )
                  -- Assinatura Reprovada Ag. Acerto
                  and :P379_FILTROS = 65
                  and exists ( select 1
                               from assinaturaseletronicas a
                               where a.idnotavenda = n.idnotavenda
                                 and a.status = 'C'
                                 and a.situacao = 'R'
                                 and not exists ( select 1
                                                  from assinaturaseletronicas aa
                                                  where aa.idnotavenda = a.idnotavenda  
                                                   and aa.idassinaturaeletronica > a.idassinaturaeletronica
                                                   and aa.status = 'C'
                                                   and aa.situacao = 'A' ) )
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento = 73
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , case when (n.idsemanacobranca - n.idsemanadistribuicao) > 12 then
                           'Sim'
                           else
                           'Não'
                        end remarcada_proxima_visita
                     , 66 tipotarefa
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 3
                  and n.idrepresentante = :P379_IDREPRESENTANTE
                  and (n.idsemanacobranca - n.idsemanadistribuicao) > 6
                  -- notas remarcadas (notas em aberto)
                  and :P379_FILTROS = 66
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento = 73
                                     and t.idsituacao in (0,10,20) )
                ```
            pageItemsToSubmit: [
                P379_IDREPRESENTANTE
                P379_TIPOSEMANA
                P379_IDSEMANA_INI
                P379_IDSEMANA_FIM
                P379_FILTROS
                P379_VALORPAGO
                P379_VALORSALDO
                P379_QTDSEMANASEMABERTO
                P379_QTD_ATE
            ]
        }
