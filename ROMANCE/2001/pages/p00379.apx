                     , ca.idcanalatendimento return_value
                from roman.canaisdeatendimentos ca
                ```
        }
        layout {
            sequence: 120
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P379_FILTROS (
        type: radioGroup
        label {
            label: Filtrar Por
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.display
                     , t.return_value
                from ( 
                      select 'Notas com Devolução Total' display
                           , 14 return_value
                      from dual
                      union
                      select 'Débitos Deixados na Semana' 
                           , 15
                      from dual
                      union
                      select 'Valores Baixos de Pagamento'
                           , 16
                      from dual
                      union
                      select 'Notas em Aberto'
                           , 17
                      from dual
                      union
                      select 'Notas com Débitos'
                           , 18
                      from dual
                      union
                      select 'Clientes Inativas da Semana'
                           , 19
                      from dual
                      union
                      select 'Notas com 1 Item'
                           , 22
                      from dual
                      union
                      select 'Clientes Novas (Acertadas)'
                           , 26
                      from dual
                      union
                      select 'Acerto Efetuado'
                           , 27
                      from dual
                      union
                      select 'Aguardando Atendimento'
                           , 31
                      from dual
                      union
                      select 'Aberturas'
                           , 26
                      from dual
                      union
                      select 'Assinatura Reprovada Débito'
                           , 64
                      from dual
                      union
                      select 'Assinatura Reprovada Ag. Acerto'
                           , 65
                      from dual
                      union
                      select 'Notas Remarcadas'
                           , 66
                      from dual ) t
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P379_IDFILIALROMANCE (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select nome
                     , idfilial
                from vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and pck_util.fnc_verificaacesso(2514,v('APP_USER')) = 'S'
                union
                select nome
                     , idfilial
                from vw_filiais f
                where exists ( select 1
                               from usuariosfiliais u
                               where u.idfilial = f.idfilial
                                 and u.usuario  = v('APP_USER') )
                  and pck_util.fnc_verificaacesso(2514,v('APP_USER')) = 'N'
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P379_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' ('||decode(ativo,'S','ATIVO','INATIVO')||')' display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P379_IDFILIALROMANCE )
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P379_IDFILIALROMANCE
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

