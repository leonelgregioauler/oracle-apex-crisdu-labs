                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , null remarcada_proxima_visita
                     , 27
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P379_IDREPRESENTANTE
                  and ( ( :P379_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM )
                     or ( :P379_TIPOSEMANA = 'C' and n.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ) )
                  -- Acerto Efetuado
                  and :P379_FILTROS = 27
                  and not exists ( select 1
