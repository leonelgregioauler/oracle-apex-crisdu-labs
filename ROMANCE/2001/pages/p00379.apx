page 379 (
    name: Análise de Atendimento
    title: Análise de Atendimento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region análise-dos-atendimentos (
        name: Análise dos Atendimentos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P379_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , null remarcada_proxima_visita
                     , 17 tipotarefa
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 3
                  and n.idrepresentante = :P379_IDREPRESENTANTE
                  and (n.idsemanacobranca - n.idsemanadistribuicao) between :P379_QTDSEMANASEMABERTO + 6 and :P379_QTD_ATE+ 6
                  -- notas em aberto
                  and :P379_FILTROS = 17
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento = 73
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P379_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , null remarcada_proxima_visita
                     , 14 
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P379_IDREPRESENTANTE
                  and ( ( :P379_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM )
                     or ( :P379_TIPOSEMANA = 'C' and n.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ) )
                  and n.valorpago = 0
                  and n.saldo = 0
                  -- Notas com Devolução Total
                  and :P379_FILTROS = 14
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento = 73
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P379_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , null remarcada_proxima_visita
                     , 16
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P379_IDREPRESENTANTE
                  and ( ( :P379_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM
                                                 and n.valorpago between 0.01 and to_number(:P379_VALORPAGO) )
                     or ( :P379_TIPOSEMANA = 'C' and n.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM
                                                 and n.valorpago between 0.01 and to_number(:P379_VALORPAGO) )
                     or ( :P379_TIPOSEMANA = 'P' and exists ( select 1
                                                              from pagamentosnotasvendas pg
                                                              where pg.idnotavenda = n.idnotavenda
                                                                and pg.semanacobranca = :P379_SEMANA
                                                                and pg.valorpago between 0.01 and to_number(:P379_VALORPAGO) )))
                  -- Valores Baixos de Pagamento
                  and :P379_FILTROS = 16
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento = 22
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P379_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , null remarcada_proxima_visita
                     , 15
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P379_IDREPRESENTANTE
                  and ( ( :P379_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM )
                     or ( :P379_TIPOSEMANA = 'C' and n.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ) )
                  and n.saldo > 0
                  -- Débitos Deixados na Semana
                  and :P379_FILTROS = 15
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento = 73
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P379_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , null remarcada_proxima_visita
                     , 18
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P379_IDREPRESENTANTE
                  and ( ( :P379_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM )
                     or ( :P379_TIPOSEMANA = 'C' and n.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ) )
                  and n.saldo > 0
                  and n.saldo <= to_number(:P379_VALORSALDO)
                  -- Notas com Débitos
                  and :P379_FILTROS = 18
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento = 22
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P379_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , null remarcada_proxima_visita
                     , 19
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P379_IDREPRESENTANTE
                  and ( ( :P379_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM )
                     or ( :P379_TIPOSEMANA = 'C' and n.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ) )
                  -- Clientes Inativas da Semana
                  and :P379_FILTROS = 19
                  and v.ativo = 'N'
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento = 73
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ),0) valorpagonasemana
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , null remarcada_proxima_visita
                     , 22
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda in ( 3 , 4 )
                  and n.idrepresentante = :P379_IDREPRESENTANTE
                  and ( ( :P379_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM )
                     or ( :P379_TIPOSEMANA = 'C' and n.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ) )
                  -- Notas com 1 Item
                  and :P379_FILTROS = 22
                  and ( select count(1)
                        from itensnotavenda it
                        where it.idnotavenda = n.idnotavenda ) = 1
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento = 73
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ),0) valorpagonasemana
                     , v.idpessoa
                     , null gerartarefa
                     , null remarcada_proxima_visita
                     , 26
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P379_IDREPRESENTANTE
                  and ( ( :P379_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM )
                     or ( :P379_TIPOSEMANA = 'C' and n.idsemanacobranca between :P379_IDSEMANA_INI and :P379_IDSEMANA_FIM ) )
                  -- Clientes Novas (Acertadas)
                  and :P379_FILTROS = 'CN'
                  and ( select count(1)
                        from notasvendas nv
                        where nv.idvendedora = v.idvendedora
                          and nv.idsituacaonotavenda = 4 ) = 1
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento = 73
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
