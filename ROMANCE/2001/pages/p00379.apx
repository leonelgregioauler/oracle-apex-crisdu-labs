    process gerar-tarefas (
        name: Gerar Tarefas
        type: executeCode
        editableRegion: @análise-dos-atendimentos
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidgrupoatendimento number := 73;
                  vtelefone           varchar2(30);
                  vexiste             varchar2(1);
                  vtelefones          varchar2(1000);
                  vidusuario          number := :P379_ATENDENTE;
                  --
                begin
                  --
                  if (:GERARTAREFA = 'S') then
                    --
                    begin
                      --
                      select translate(t.telefone,'0123456789AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvXxYyWwZz_-,.  !@#$%?&*()/??','0123456789') telefone
                      into vtelefone
                      from telefonespessoas t
                      where t.idpessoa = :IDPESSOA
                        and rownum = 1;
                      --
                    exception 
                      when NO_DATA_FOUND then
                        vtelefone := null;
                    end;
                    --
                    begin
                      --
                      select 'S'
                      into vexiste
                      from favorita.tarefas t
                      where t.idpessoa = :IDPESSOA
                        and t.idtipotarefa = :TIPOTAREFA
                        and t.idsituacao in (0,10,20)
                        and t.idgrupoatendimento = 73;
                    exception 
                      when others then
                        vexiste := 'N';
                    end;
                    --
                    if vexiste = 'N' then
                      --
                      insert into favorita.tarefas ( idtarefa            , datainclusao    , idsituacao
                                                   , observacao          , idtipotarefa    , idpessoa
                                                   , idgrupoatendimento  , telefone        , idusuario
                                                   , idcanalatendimento )
                      values ( favorita.seq_idtarefa.nextval ,   sysdate ,  0
                             , pck_util.fnc_retornatelefones(:IDPESSOA) , :TIPOTAREFA  , :IDPESSOA
                             , vidgrupoatendimento , vtelefone , vidusuario, :P379_CANALATENDIMENTO ); 
                      --
                    end if;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Tarefas Geradas com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 1421983815610706946
        }
        serverSideCondition {
            type: request=Value
            value: GERARTAREFAS
        }
    )

    branch (
        name: Go To Page 379
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 379
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

