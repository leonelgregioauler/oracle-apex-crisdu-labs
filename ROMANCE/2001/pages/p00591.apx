    pageItem P591_SALDO (
        type: numberField
        label {
            label: Saldo (=)
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 120
            region: @informações-do-acordo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select (neg.valor  - nvl(quit.valor,0)) saldo
                from ( select nvl(sum(pp.valorparcela),0) valor
                       from pagamentosnegociacoesparceiros pp
                       where pp.idnegociacaoparceiro = :P591_IDNEGOCIACAOPARCEIRO
                         and pp.situacao = 'Q' ) quit
                   , ( select n.valornegociacao valor
                       from negociacoesparceiros n
                       where n.idnegociacaoparceiro = :P591_IDNEGOCIACAOPARCEIRO ) neg
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return :P591_VALORNEGOCIACAO;
                end;
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

