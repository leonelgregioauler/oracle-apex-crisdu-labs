    process atualiza-parcela (
        name: Atualiza Parcela
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vsituacao  varchar2(1);
                  vidusuario number;
                  --
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = :P0_USUARIO;
                  --
                  if v('REQUEST') = 'QUITAR' then
                    vsituacao := 'Q';
                  elsif v('REQUEST') = 'EMESPERA' then
                    vsituacao := 'E';
                  elsif v('REQUEST') = 'VENCIDO' then
                    vsituacao := 'V';
                  end if;
                  --
                  pck_negociacoes_rmc.prc_atualizaparcela_acordo( pidpagamentonegociacao => :P591_IDEDITAR,
                                                                  psituacao              => vsituacao,
                                                                  pidusuario             => vidusuario);
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Parcela atualizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 84932648881458376
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('EMESPERA','VENCIDO')
        }
    )

    process atualiza-parcela-quitar (
        name: Atualiza Parcela (QUITAR)
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vsituacao  varchar2(1);
                  vidusuario number;
                  --
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = :P0_USUARIO;
                  --
                  if v('REQUEST') = 'QUITAR' then
                    vsituacao := 'Q';
                  elsif v('REQUEST') = 'EMESPERA' then
                    vsituacao := 'E';
                  elsif v('REQUEST') = 'VENCIDO' then
                    vsituacao := 'V';
                  end if;
                  --
                  pck_negociacoes_rmc.prc_atualizaparcela_acordo( pidpagamentonegociacao => :P591_IDEDITAR,
                                                                  psituacao              => vsituacao,
                                                                  pidusuario             => vidusuario);
                  --
                end;
                ```
        }
        execution {
