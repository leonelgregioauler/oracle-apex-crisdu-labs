    region documentos-sinalizados (
        name: Documentos Sinalizados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(d.idvendedora) "Consultora"
                     , d.cpf "CPF"
                     , case
                         when d.idnotavenda is not null then
                           'Sacola Romance'
                         when d.idpedido is not null then
                           'Pedido Favorita'
                         when d.idboleto is not null then
                           'Pedido Catalogo'
                         when d.idpepinorepres is not null then
                           'Pepino Antigo'
                       end origem
                     , d.documento "Nr Débito"
                     , d.valorfinal valor
                     , d.valororiginal 
                     , d.valoratualizado
                     , d.valordesconto
                     , (valoratualizado - d.valororiginal) juros   
                     , case
                         when exists ( select 1
                                       from favorita.pedidos p
                                       where p.idvendedora = d.idvendedora
                                         and to_char(p.idpedido) = d.documento
                                         and exists ( select 1
                                                      from pagamentosnegociacoesparceiros pp
                                                      where pp.idnegociacaoparceiro = :P591_IDNEGOCIACAOPARCEIRO
                                                        and pp.situacao             in ('E','Q') ) ) then
                            favorita.pck_pedidos_fav.fnc_retornacodigoliberacao(to_number(d.documento))
                         else
                           null
                       end codigoliberacao  
                     , '<a href="javascript: fnc_removedocumento('||d.iddocumentonegociacao||');">Remover</a>' remover
                     , valorjuros
                     , representatividade
                from documentosnegociacao d
                where d.idnegociacaoparceiro = :P591_IDNEGOCIACAOPARCEIRO
                order by d.iddocumentonegociacao
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
