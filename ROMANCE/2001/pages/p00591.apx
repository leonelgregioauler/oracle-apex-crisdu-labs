    process atualiza-valores (
        name: Atualiza Valores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update negociacoesparceiros np
                  set np.valornegociacao = ( select sum(pp.valorparcela)
                                             from pagamentosnegociacoesparceiros pp
                                             where pp.idnegociacaoparceiro = np.idnegociacaoparceiro )
                  where np.idnegociacaoparceiro = :P591_IDNEGOCIACAOPARCEIRO
                    and np.formapagamento = 'D';
                  --
                end;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 4960652249362855006
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

    process atualiza-valores-acordo (
        name: Atualiza Valores Acordo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalorpago number;
                  --
                begin
                  --
                  select nvl(sum(pp.valorparcela),0)
                  into vvalorpago
                  from pagamentosnegociacoesparceiros pp
                  where pp.idnegociacaoparceiro = :P591_IDNEGOCIACAOPARCEIRO
                    and pp.situacao = 'Q';
                  --
                  update negociacoesparceiros n
                  set n.valorpago = nvl(vvalorpago,0)
                    , n.saldo =  n.valornegociacao - nvl(vvalorpago,0)
                  where n.idnegociacaoparceiro = :P591_IDNEGOCIACAOPARCEIRO;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 819497322308729124
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P591_IDNEGOCIACAOPARCEIRO
        }
    )

