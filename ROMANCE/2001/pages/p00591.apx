    button chave-pix-boleto (
        buttonName: CHAVE_PIX_BOLETO
        label: Chave Pix Boleto
        layout {
            sequence: 110
            region: @informações-do-acordo
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 592
                items: {
                    P592_IDNEGOCIACAOPARCEIRO: &P591_IDNEGOCIACAOPARCEIRO.
                    P592_TIPO: X
                    P592_IDPAGAMENTO_PIX:
                    P592_CHAVEPIX:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
