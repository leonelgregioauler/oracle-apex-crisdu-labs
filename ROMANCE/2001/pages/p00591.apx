    region parcelas-do-acordo (
        name: Parcelas do Acordo
        type: tabform
        source {
            sqlQuery:
                ```sql
                SELECT ROWID
                     , P.IDPAGAMENTONEGOCIACAOPARCEIRO
                     , P.IDNEGOCIACAOPARCEIRO
                     , P.NUMEROPARCELA
                     , P.NUMEROBOLETO
                     , P.DATAVENCIMENTO
                     , P.VALORPARCELA
                     , P.VALORPARCELA parc
                     , P.DATABAIXA
                     , DECODE(P.SITUACAO,'E','EM ESPERA','A','ABERTO','V','VENCIDO','Q','QUITADO', 'C','CANCELADO') SITUACAO
                     , case 
                         when situacao in ('A','E','V') then -- Maicon Aimi - 12/03/2025 - 9924583 (removido do IN a situação 'C')
                           '<a href="javascript:fnc_quitar('|| IDPAGAMENTONEGOCIACAOPARCEIRO ||')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         else 
                           null
                       end QUITAR
                     , case 
                         when situacao in ('V','A') then
                           '<a href="javascript:fnc_emespera('|| IDPAGAMENTONEGOCIACAOPARCEIRO ||')" ><img src="#APP_IMAGES#Ampulheta.png"  border="0"></a>'
                         else 
                           null
                       end EMESPERA
                     , case 
                         when situacao in ('A','E') then 
                           '<a href="javascript:fnc_vencido('|| IDPAGAMENTONEGOCIACAOPARCEIRO ||')" ><img src="#APP_IMAGES#Deslike.png"  border="0"></a>'
                         else
                           null
                       end VENCIDO
                     , COMPROVANTE 
                     , case
                         when p.situacao != 'Q' and exists ( select 1
                                                             from controlearquivocaixa ca
                                                             where ca.idpagamentonegociacao = p.idpagamentonegociacaoparceiro ) then
                           '<a href=javascript:imprimeboleto('||p.IDPAGAMENTONEGOCIACAOPARCEIRO||','||( select idvendedora
                                                                                                        from negociacoesparceiros np where np.idnegociacaoparceiro = p.idnegociacaoparceiro )||');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>'  
                         when p.situacao != 'Q' and exists ( select 1
                                                             from favorita.controlearquivosbanco cc
                                                             where cc.idpagamentonegociacao = p.idpagamentonegociacaoparceiro 
                                                               and cc.situacaobanco = 'A' ) then
                         '<a href=javascript:imprimeboleto_bb('||p.IDPAGAMENTONEGOCIACAOPARCEIRO||','||( select idvendedora
                                                                                                         from negociacoesparceiros np where np.idnegociacaoparceiro = p.idnegociacaoparceiro )||');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>'  
                         else
                           ' - ' 
                       end imprimirboleto
                     , decode(p.boletoenviado,'S','Sim','N','Não') smsenviado
                     , decode(p.boletoenviadoemail,'S','Sim','N','Não') emailenviado
                     , datapagamento
                     , valorabatido valor_abater
                FROM PAGAMENTOSNEGOCIACOESPARCEIROS P
                WHERE P.IDNEGOCIACAOPARCEIRO = :P591_IDNEGOCIACAOPARCEIRO
                ORDER BY 4
                ```
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
