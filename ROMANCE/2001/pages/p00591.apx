page 591 (
    name: Pagamentos do Acordo
    title: Pagamentos do Acordo
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 90%
        height: 70%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            
            function fnc_quitar(pid)
            {
              document.getElementById("P591_IDEDITAR").value = pid;
              apex.submit('QUITAR');
            }
            
            function fnc_emespera(pid)
            {
              document.getElementById("P591_IDEDITAR").value = pid;
              apex.submit('EMESPERA');
            }
            
            function fnc_vencido(pid)
            {
              document.getElementById("P591_IDEDITAR").value = pid;
              apex.submit('VENCIDO');
            }
            
            function imprimeboleto(vidpagamento,vidvendedora)
            {   
              vurl = 'https://boleto.romancemoda.com.br/caixa/boleto.php?cod1='+vidpagamento+'&cod2='+vidvendedora;
              pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            
            function imprimeboleto_bb(vidpagamento,vidvendedora)
            {   
              vurl = 'https://boleto.romancemoda.com.br/bb/boleto_qrcode.php?cod1='+vidpagamento+'&cod2='+vidvendedora;
              pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            
            function fnc_removedocumento(piddocumento)
            {
                apex.confirm("Deseja realmente remover o documento sinalizado?", {
              request:"DELETAR_DOCUMENTO",
              set:{"P591_IDDELETAR":piddocumento}
              });
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     --, '<a href="javascript: fnc_verimg('''||iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' 
                     , idnegociacao||idanexonegociacao||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , dataanexo
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                from anexosnegociacoes t
                where t.idnegociacao = :P591_IDNEGOCIACAOPARCEIRO
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from anexosnegociacoes t
                where t.idnegociacao = :P591_IDNEGOCIACAOPARCEIRO
                ```
        }
