    process libera-comissão-ao-distribuidor (
        name: Libera Comissão ao Distribuidor
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidusuario number;
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  update negociacoesparceiros np
                  set np.liberarcomissaorepres = 'S'
                  where np.idnegociacaoparceiro = :P591_IDNEGOCIACAOPARCEIRO;
                  --
                  insert into observacoesnegociacoes ( idobservacaonegociacao,
                                                       idnegociacaoparceiro,
                                                       idusuario,
                                                       data,
                                                       observacao) 
                  values ( seq_idobservacaonegociacao.nextval
                         , :P591_IDNEGOCIACAOPARCEIRO
                         , vidusuario
                         , sysdate
                         , 'Negociação liberada para comissionamento de distribuidor');
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 110
        }
        successMessage {
            successMessage: Comissão liberada para Distribuidor.
        }
        advanced {
            executionMappingIdentifier: 5293548049418909828
        }
