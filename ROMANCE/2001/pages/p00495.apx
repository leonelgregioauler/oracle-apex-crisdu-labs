page 495 (
    name: Relatório de Disparos SMS
    title: Rel. Disparos SMS
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region avisos (
        name: Avisos
        type: staticContent
        source {
            htmlCode:
                ```html
                <font color="green" style="text-align:center"> <h3>
                    Mensagens programadas com sucesso!
                    </h3></font>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P495_IDCAMPANHADISP
        }
    )

    region disparos-sms (
        name: Disparos SMS
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.*
                  from predisparosms p
                     , mensagensdisparos m
                 where p.idmensagemdisparo = m.idmensagemdisparo
                   and (  p.idcampanhadisparo = :P495_IDCAMPANHADISP  
                         or (:P495_IDCAMPANHADISP is null and
                                (:P495_IDFILIAL   is null or p.idfilial          = :P495_IDFILIAL )       and
                                (:P495_IDPAIS     is null or p.idpais            = :P495_IDPAIS )        and
                                (:P495_SAFRA      is null or p.safra             = to_date('01/'||:P495_SAFRA,'dd/mm/rrrr') )  and
                                (:P495_CANAL      is null or p.canaldisparo      = :P495_CANAL )        and
                                (:P495_DATAINICIO is null or p.datahoradisp between to_date(:P495_DATAINICIO || '000000','DD/MM/RRRR HH24MISS')  
                                                                                and to_date(:P495_DATAFIM    || '235959','DD/MM/RRRR HH24MISS') ) 
                            ) )
                   and ( :P495_IDCAMPANHADISP is not null or 
                         :P495_IDFILIAL       is not null or 
                         :P495_IDPAIS         is not null or 
                         :P495_SAFRA          is not null or 
                         :P495_CANAL          is not null or 
                         :P495_DATAINICIO     is not null )
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
            csvSeparator: ;
            filename: DisparosSMS
        }
        advanced {
            savedReportMappingIdentifier: 101070029512311024
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDPREDISPAROSMS
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDMENSAGEMDISPARO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDPESSOA
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @IDNOTAVENDA
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @IDPEDIDO
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @VALORACIONADO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @SAFRA
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @MENSAGEM
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @DATAHORADISP
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @IDPAIS
                layout {
                    sequence: 11
                }
            )

            displayColumn (
                column: @CANALDISPARO
                layout {
                    sequence: 12
                }
            )

            displayColumn (
                column: @TELEFONE
                layout {
                    sequence: 13
                }
            )

            displayColumn (
                column: @USUARIO
                layout {
                    sequence: 14
                }
            )

            displayColumn (
                column: @DATACAMPANHA
                layout {
                    sequence: 15
                }
            )

            displayColumn (
                column: @IDCAMPANHADISPARO
                layout {
                    sequence: 16
                }
            )

            displayColumn (
                column: @IDFILIAL
                layout {
                    sequence: 17
                }
            )

        )

        column CANALDISPARO (
            type: selectList
            heading {
                heading: Canal Disparo
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select processo d
                         , idprocessosistema r
                      from processossistemas 
                     where idprocessosistema in (25,40,41,42,43)
                    
                    ```
            }
            layout {
                sequence: 110
            }
            source {
                databaseColumn: CANALDISPARO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column DATACAMPANHA (
            type: hidden
            layout {
                sequence: 140
            }
            source {
                databaseColumn: DATACAMPANHA
                dataType: date
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column DATAHORADISP (
            type: datePickerJquery
            heading {
                heading: Data/Hora Disp
            }
            layout {
                sequence: 90
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
            source {
                databaseColumn: DATAHORADISP
                dataType: date
            }
        )

        column IDCAMPANHADISPARO (
            type: hidden
            layout {
                sequence: 150
            }
            source {
                databaseColumn: IDCAMPANHADISPARO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDFILIAL (
            type: selectList
            heading {
                heading: Filial
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select f.nome
                         , f.idfilial
                    from vw_filiais f
                    where f.tipofilial = 'D'
                      and f.ativo = 'S'
                      and f.idgrupo is not null
                    
                    ```
            }
            layout {
                sequence: 160
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDMENSAGEMDISPARO (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                databaseColumn: IDMENSAGEMDISPARO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDNOTAVENDA (
            type: numberField
            heading {
                heading: Nota Venda
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                databaseColumn: IDNOTAVENDA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column IDPAIS (
            type: textField
            heading {
                heading: País
            }
            layout {
                sequence: 100
            }
            source {
                databaseColumn: IDPAIS
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column IDPEDIDO (
            type: numberField
            heading {
                heading: Pedido
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: IDPEDIDO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column IDPESSOA (
            type: displayOnly
            heading {
                heading: Pessoa
            }
            settings {
                basedOn: lov
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomepessoa as d,
                           idpessoa as r
                      from pessoas
                    
                    ```
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDPESSOA
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDPREDISPAROSMS (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: IDPREDISPAROSMS
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column MENSAGEM (
            type: textarea
            heading {
                heading: Mensagem
            }
            layout {
                sequence: 80
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: MENSAGEM
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column SAFRA (
            type: datePickerJquery
            heading {
                heading: Safra
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            appearance {
                formatMask: mm/rrrr
            }
            source {
                databaseColumn: SAFRA
                dataType: date
            }
        )

        column TELEFONE (
            type: textField
            heading {
                heading: Telefone
            }
            layout {
                sequence: 120
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: TELEFONE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column USUARIO (
            type: textField
            heading {
                heading: Usuario
            }
            layout {
                sequence: 130
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: USUARIO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column VALORACIONADO (
            type: numberField
            heading {
                heading: Valor
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: VALORACIONADO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P495_CANAL (
        type: selectList
        label {
            label: Canal Disparo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select processo d
                     , idprocessosistema r
                  from processossistemas 
                 where idprocessosistema in (25,40,41,42,43)
                order by 1
                ```
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P495_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P495_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P495_IDCAMPANHADISP (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @avisos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P495_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and f.idgrupo is not null
                  and f.ididioma = :P495_IDPAIS
                ```
            nullDisplayValue: "- Todas - "
        }
        cascadingLov {
            parentItems: P495_IDPAIS
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P495_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome display_value
                     , p.idpais return_value
                from paises p
                order by idpais
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        default {
            type: static
            staticValue: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P495_SAFRA (
        type: datePickerJquery
        label {
            label: Safra
            alignment: left
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: MM/RRRR
            width: 7
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: P620_FILTRAR
        }
    )

    button limpar (
        buttonName: LIMPAR
        label: Limpar Filtros
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: P620_FILTRAR
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @disparos-sms
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 492
                clearCache: 492
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P495_IDCAMPANHADISP
        }
    )

    dynamicAction ano (
        name: Ano
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P495_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P495_PESQUISA
            value: A
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P495_ANO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P495_ANO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction limpa (
        name: Limpa
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @voltar
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: null
                itemsToSubmit: P495_IDCAMPANHADISP
            }
            affectedElements {
                selectionType: items
                items: P495_IDCAMPANHADISP
            }
            execution {
                sequence: 10
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction limpacampanha (
        name: LimpaCampanha
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: null
            }
            affectedElements {
                selectionType: items
                items: P495_IDCAMPANHADISP
            }
            execution {
                sequence: 10
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction periodo (
        name: Periodo
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P495_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P495_PESQUISA
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P495_DATAINICIO
                    P495_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P495_DATAINICIO
                    P495_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Voltar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 492
                clearCache: 492
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
        }
    )

    branch (
        name: LimparFiltros
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 495
                items: {
                    P495_IDCAMPANHADISP:
                    P495_IDPAIS:
                    P495_IDFILIAL:
                    P495_DATAINICIO:
                    P495_DATAFIM:
                    P495_SAFRA:
                    P495_CANAL:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @limpar
        }
    )

)

