page 837 (
    name: Parâmetros Juros
    alias: PARÂMETROS-JUROS1
    title: Parâmetros Juros
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region parâmetros-juros-e-multas (
        name: Parâmetros Juros e Multas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.IDPARAMETROJUROS,
                       t.idpais,
                       t.pct_multa,
                       t.pct_juros,
                       t.ativo,
                       t.criado_em,
                       t.alterado_em
                  from roman.parametrosjuros t
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        pagination {
            type: page
            showTotalCount: false
        }
        toolbar {
            controls: saveButton
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 94443835955650320
        }

        savedReport 487588 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @EDITAR
                layout {
                    width: 51
                    sequence: 1
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDPARAMETROJUROS
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @IDPAIS
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @PCT_MULTA
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @PCT_JUROS
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @ATIVO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @CRIADO_EM
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @ALTERADO_EM
                layout {
                    sequence: 7
                }
            )

        )

        column ALTERADO_EM (
            type: datePicker
            heading {
                heading: Alterado Em
            }
            layout {
                sequence: 90
            }
            appearance {
                formatMask: dd/mm/yyyy hh24:mi:ss
            }
            source {
                databaseColumn: ALTERADO_EM
                dataType: timestamp
            }
            readOnly {
                type: always
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ATIVO (
            type: hidden
            layout {
                sequence: 70
            }
            source {
                databaseColumn: ATIVO
                dataType: varchar2
            }
            default {
                type: static
                staticValue: S
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column CRIADO_EM (
            type: datePicker
            heading {
                heading: Criado Em
            }
            layout {
                sequence: 80
            }
            appearance {
                formatMask: dd/mm/yyyy hh24:mi:ss
            }
            source {
                databaseColumn: CRIADO_EM
                dataType: timestamp
            }
            readOnly {
                type: always
            }
        )

        column EDITAR (
            type: hidden
            layout {
                sequence: 100
            }
            source {
                type: none
            }
        )

        column IDPAIS (
            type: popupLov
            heading {
                heading: Idpais
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select p.nome d
                         , p.idpais r
                      from catal.paises p
                     where exists (select 1
                                     from catal.filiais f
                                    where f.ididioma = p.idpais)
                    
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDPAIS
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDPARAMETROJUROS (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDPARAMETROJUROS
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: seq_idparametrojuros
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column PCT_JUROS (
