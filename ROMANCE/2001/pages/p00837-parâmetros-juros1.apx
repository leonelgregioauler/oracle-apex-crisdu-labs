            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999g990d00
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: PCT_JUROS
                dataType: number
            }
            columnFilter {
