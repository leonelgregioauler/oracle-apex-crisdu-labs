    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 130
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction semanas-remarcadas (
        name: Semanas Remarcadas
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P833_FILTROS
        }
        clientSideCondition {
            type: item=value
            item: P833_FILTROS
            value: 17
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P833_QTDSEMANASEMABERTO
                    P833_QTD_ATE
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P833_QTDSEMANASEMABERTO
                    P833_QTD_ATE
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

