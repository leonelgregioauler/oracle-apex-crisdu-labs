page 833 (
    name: Análise de Atendimento V2
    alias: ANÁLISE-DE-ATENDIMENTO-V2
    title: Análise de Atendimento V2
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region análise-dos-atendimentos (
        name: Análise dos Atendimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P833_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 3
                  and n.idfilial = :P833_IDFILIALROMANCE
                  and ( :P833_IDREPRESENTANTE is null or n.idrepresentante = :P833_IDREPRESENTANTE )
                  and (n.idsemanacobranca - n.idsemanadistribuicao) between :P833_QTDSEMANASEMABERTO + 6 and :P833_QTD_ATE+ 6
                  -- notas em aberto
                  and :P833_FILTROS = 17
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P833_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idfilial = :P833_IDFILIALROMANCE
                  and ( :P833_IDREPRESENTANTE is null or n.idrepresentante = :P833_IDREPRESENTANTE )
                  and ( ( :P833_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM )
                     or ( :P833_TIPOSEMANA = 'C' and n.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ) )
                  and n.valorpago = 0
                  and n.saldo = 0
                  -- Notas com Devolução Total
                  and :P833_FILTROS = 14
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P833_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idfilial = :P833_IDFILIALROMANCE
                  and ( :P833_IDREPRESENTANTE is null or n.idrepresentante = :P833_IDREPRESENTANTE )
                  and ( ( :P833_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM
                                                 and n.valorpago between 0.01 and to_number(:P833_VALORPAGO) )
                     or ( :P833_TIPOSEMANA = 'C' and n.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM
                                                 and n.valorpago between 0.01 and to_number(:P833_VALORPAGO) )
                     or ( :P833_TIPOSEMANA = 'P' and exists ( select 1
                                                              from pagamentosnotasvendas pg
                                                              where pg.idnotavenda = n.idnotavenda
                                                                and pg.semanacobranca = :P833_SEMANA
                                                                and pg.valorpago between 0.01 and to_number(:P833_VALORPAGO) )))
                  -- Valores Baixos de Pagamento
                  and :P833_FILTROS = 16
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P833_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idfilial = :P833_IDFILIALROMANCE
                  and ( :P833_IDREPRESENTANTE is null or n.idrepresentante = :P833_IDREPRESENTANTE )
                  and ( ( :P833_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM )
                     or ( :P833_TIPOSEMANA = 'C' and n.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ) )
                  and n.saldo > 0
                  -- Débitos Deixados na Semana
                  and :P833_FILTROS = 15
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P833_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idfilial = :P833_IDFILIALROMANCE
                  and ( :P833_IDREPRESENTANTE is null or n.idrepresentante = :P833_IDREPRESENTANTE )
                  and ( ( :P833_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM )
                     or ( :P833_TIPOSEMANA = 'C' and n.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ) )
                  and n.saldo > 0
                  and n.saldo <= to_number(:P833_VALORSALDO)
                  -- Notas com Débitos
                  and :P833_FILTROS = 18
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.semanacobranca = :P833_SEMANA ),0) valorpagonasemana
                     , n.saldo
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idfilial = :P833_IDFILIALROMANCE
                  and ( :P833_IDREPRESENTANTE is null or n.idrepresentante = :P833_IDREPRESENTANTE )
                  and ( ( :P833_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM )
                     or ( :P833_TIPOSEMANA = 'C' and n.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ) )
                  -- Clientes Inativas da Semana
                  and :P833_FILTROS = 19
                  and v.ativo = 'N'
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ),0) valorpagonasemana
                     , n.saldo
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda in ( 3 , 4 )
                  and n.idfilial = :P833_IDFILIALROMANCE
                  and ( :P833_IDREPRESENTANTE is null or n.idrepresentante = :P833_IDREPRESENTANTE )
                  and ( ( :P833_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM )
                     or ( :P833_TIPOSEMANA = 'C' and n.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ) )
                  -- Notas com 1 Item
                  and :P833_FILTROS = 22
                  and ( select count(1)
                        from itensnotavenda it
                        where it.idnotavenda = n.idnotavenda ) = 1
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ),0) valorpagonasemana
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idfilial = :P833_IDFILIALROMANCE
                  and ( :P833_IDREPRESENTANTE is null or n.idrepresentante = :P833_IDREPRESENTANTE )
                  and ( ( :P833_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM )
                     or ( :P833_TIPOSEMANA = 'C' and n.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ) )
                  -- Clientes Novas (Acertadas)
                  and :P833_FILTROS = 'CN'
                  and ( select count(1)
                        from notasvendas nv
                        where nv.idvendedora = v.idvendedora
                          and nv.idsituacaonotavenda = 4 ) = 1
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ),0) valorpagonasemana
                     , n.saldo
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idfilial = :P833_IDFILIALROMANCE
                  and ( :P833_IDREPRESENTANTE is null or n.idrepresentante = :P833_IDREPRESENTANTE )
                  and ( ( :P833_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM )
                     or ( :P833_TIPOSEMANA = 'C' and n.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ) )
                  -- Acerto Efetuado
                  and :P833_FILTROS = 27
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ),0) valorpagonasemana
                     , n.saldo
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 3
                  and n.idfilial = :P833_IDFILIALROMANCE
                  and ( :P833_IDREPRESENTANTE is null or n.idrepresentante = :P833_IDREPRESENTANTE )
                  and ( ( :P833_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM )
                     or ( :P833_TIPOSEMANA = 'C' and n.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ) )
                  -- Aguardando Atendimento
                  and :P833_FILTROS = 31
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ),0) valorpagonasemana
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 3
                  and n.idfilial = :P833_IDFILIALROMANCE
                  and ( :P833_IDREPRESENTANTE is null or n.idrepresentante = :P833_IDREPRESENTANTE )
                  and ( ( :P833_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM )
                     or ( :P833_TIPOSEMANA = 'C' and n.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ) )
                  -- Clientes Novas (Acertadas)
                  and :P833_FILTROS = 26
                  and ( select count(1)
                        from notasvendas nv
                        where nv.idvendedora = v.idvendedora ) = 1
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ),0) valorpagonasemana
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.saldo > 0
                  and n.idrepresentante = :P833_IDREPRESENTANTE
                  and ( ( :P833_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM )
                     or ( :P833_TIPOSEMANA = 'C' and n.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ) )
                  -- Assinatura Reprovada Débito
                  and :P833_FILTROS = 64
                  and exists ( select 1
                               from assinaturaseletronicas a
                               where a.idnotavenda = n.idnotavenda
                                 and a.status = 'C'
                                 and a.situacao = 'R'
                                 and not exists ( select 1
                                                  from assinaturaseletronicas aa
                                                  where aa.idnotavenda = a.idnotavenda  
                                                   and aa.idassinaturaeletronica > a.idassinaturaeletronica
                                                   and aa.status = 'C'
                                                   and aa.situacao = 'A' ) )
                
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , 0 valorpagonasemana
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 3
                  and n.idfilial = :P833_IDFILIALROMANCE
                  and ( :P833_IDREPRESENTANTE is null or n.idrepresentante = :P833_IDREPRESENTANTE )
                  and ( ( :P833_TIPOSEMANA = 'D' and n.idsemanadistribuicao between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM )
                     or ( :P833_TIPOSEMANA = 'C' and n.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ) )
                  -- Assinatura Reprovada Ag. Acerto
                  and :P833_FILTROS = 65
                  and exists ( select 1
                               from assinaturaseletronicas a
                               where a.idnotavenda = n.idnotavenda
                                 and a.status = 'C'
                                 and a.situacao = 'R'
                                 and not exists ( select 1
                                                  from assinaturaseletronicas aa
                                                  where aa.idnotavenda = a.idnotavenda  
                                                   and aa.idassinaturaeletronica > a.idassinaturaeletronica
                                                   and aa.status = 'C'
                                                   and aa.situacao = 'A' ) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , nvl(( select sum(pg.valorpago)
                             from pagamentosnotasvendas pg
                             where pg.idnotavenda = n.idnotavenda
                               and pg.idsemanacobranca between :P833_IDSEMANA_INI and :P833_IDSEMANA_FIM ),0) valorpagonasemana
                     , n.saldo
                     , ( select tf.telefonelimpo
                         from telefonespessoas tf
                         where tf.idtelefonepessoa = ( select max(tt.idtelefonepessoa)
                                                       from telefonespessoas tt
                                                       where tt.idpessoa = v.idpessoa
                                                         and tt.telefonelimpo is not null ) ) ult_telefone
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 3
                  and n.idfilial = :P833_IDFILIALROMANCE
                  and ( :P833_IDREPRESENTANTE is null or n.idrepresentante = :P833_IDREPRESENTANTE )
                  and (n.idsemanacobranca - n.idsemanadistribuicao) > 6
                  -- notas remarcadas (notas em aberto)
                  and :P833_FILTROS = 66
                ```
            pageItemsToSubmit: [
                P833_IDFILIALROMANCE
                P833_IDREPRESENTANTE
                P833_TIPOSEMANA
                P833_IDSEMANA_INI
                P833_IDSEMANA_FIM
                P833_FILTROS
                P833_VALORPAGO
                P833_VALORSALDO
                P833_QTDSEMANASEMABERTO
                P833_QTD_ATE
            ]
        }
