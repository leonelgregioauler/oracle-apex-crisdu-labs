    region legenda (
        name: Legenda
        type: staticContent
        source {
            htmlCode:
                ```html
                <b>Aberturas - </b>Clientes novas com apenas uma nota que foram cadastradas no período/semana. <br>
                <b>Acerto Efetuado - </b>Clientes que foram atendidas no período/semana. <br>
                <b>Aguardando Atendimento - </b>Clientes que estão com notas Aguardando Acerto no período/semana. <br>
                <b>Assinatura Reprovada Ag. Acerto - </b>Notas Aguardando atendimento com Assinatura Eletrônica Reprovada.<br>
                <b>Assinatura Reprovada Débito - </b>Nota Acertada que está com Débito e Assinatura Eletrônica Reprovada.<br>
                <b>Clientes Inativas da Semana - </b>Clientes que estão inativas e foram atendidas no período/semana.<br>
                <b>Clientes Novas (Acertadas) -</b> Clientes que possuem apenas 1 nota Acertada na empresa e que foi no período/semana.<br>
                <b>Débitos Deixados na Semana -</b> Notas que foram acertadas no período/semana e que estão com Débito.<br>
                <b>Notas com Débitos -</b> Notas que foram acertadas no período/semana e que estão débito igual ou menor ao Valor informado.<br>
                <b>Notas com Devolução Total -</b> Notas que foram acertadas no período/semana e que estão com devolução total de mercadorias.<br>
                <b>Notas com 1 Item -</b> Notas que foram acertadas/distribuidas no período/semana com apenas 1 produto cadastrado.<br>
                <b>Notas em Aberto -</b> Notas que estão aguardando atendimento remarcadas, com semanas em aberto de acordo com o filtro utilizado de quantidades.<br>
                <b>Notas Remarcadas -</b> Notas que estão aguardando atendimento que foram remarcadas.<br>
                <b>Valores Baixos de Pagamento -</b> Notas que foram atendidas no período/semana com valores pagos até o valor sugerido no filtro.<br>
                
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P833_FILTROS (
        type: radioGroup
        label {
            label: Filtrar Por
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.display
                     , t.return_value
                from ( 
                      select 'Notas com Devolução Total' display
                           , 14 return_value
                      from dual
                      union
                      select 'Débitos Deixados na Semana' 
                           , 15
                      from dual
                      union
                      select 'Valores Baixos de Pagamento'
                           , 16
                      from dual
                      union
                      select 'Notas em Aberto'
                           , 17
                      from dual
                      union
                      select 'Notas com Débitos'
                           , 18
                      from dual
                      union
                      select 'Clientes Inativas da Semana'
                           , 19
                      from dual
                      union
                      select 'Notas com 1 Item'
                           , 22
                      from dual
                      union
                      select 'Clientes Novas (Acertadas)'
                           , 26
                      from dual
                      union
                      select 'Acerto Efetuado'
                           , 27
                      from dual
                      union
                      select 'Aguardando Atendimento'
                           , 31
                      from dual
                      union
                      select 'Aberturas'
                           , 26
                      from dual
                      union
                      select 'Assinatura Reprovada Débito'
                           , 64
                      from dual
                      union
                      select 'Assinatura Reprovada Ag. Acerto'
                           , 65
                      from dual
                      union
                      select 'Notas Remarcadas'
                           , 66
                      from dual ) t
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P833_IDFILIALROMANCE (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select nome
                     , idfilial
                from vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and pck_util.fnc_verificaacesso(2514,v('APP_USER')) = 'S'
                union
                select nome
                     , idfilial
                from vw_filiais f
                where exists ( select 1
                               from usuariosfiliais u
                               where u.idfilial = f.idfilial
                                 and u.usuario  = v('APP_USER') )
                  and pck_util.fnc_verificaacesso(2514,v('APP_USER')) = 'N'
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P833_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' ('||decode(ativo,'S','ATIVO','INATIVO')||')' display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P833_IDFILIALROMANCE )
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P833_IDFILIALROMANCE
        }
        layout {
            sequence: 20
            region: @filtros
