    validation qtd-semanas-necessário (
        name: QTD Semanas Necessário
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P833_QTDSEMANASEMABERTO
        }
        error {
            errorMessage: Informe a quantidade de semanas em aberto
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'BUSCAR'
                  and :P833_FILTROS = 'NA'
                ```
        }
    )

)

