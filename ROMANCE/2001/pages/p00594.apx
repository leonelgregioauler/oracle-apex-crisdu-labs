page 594 (
    name: Bipar Itens de Devolução
    title: Bipar Itens de Devolução
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 90%
        resizable: false
    }
    css {
        inline: ".t-Region-body { background-color: Beige !important;}"
    }
    security {
        pageAccessProtection: unrestricted
    }

    region realizar-movimentação (
        name: Realizar Movimentação
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <font color="red"><h3>Atenção: Peças inseridas com o leitor de código de barras, irão para o tamanho único</h3></font>
        }
    )

    region últimos-bipados (
        name: Últimos Bipados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.data
                     , i.usuario
                     , case
                         when i.codigo = 'NAO LOCALIZADO' then
                           '<font color=RED><b>NAO LOCALIZADO</b></font>'
                         else
                           i.codigo
                       end codigo
                     , case 
                         when i.idestoquefilial is not null then
                           pck_romance.fnc_nomeprodutoestoque(i.idestoquefilial)
                         else
                           '<font color=RED><b>NAO LOCALIZADO</b></font>'
                       end produto
                     , decode(i.estoquedestino,'R','Reembalagem','D','Distribuição','S','Reembalagem PA','P','Distribuição PA') destino
                from itensbipadosdevolucoes i
                where i.iddevolucaorepres = :P594_IDDEVOLUCAO
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            parentRegion: @realizar-movimentação
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum produto Localizado!
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 88108263256094525
        }

        column CODIGO (
            type: plainText
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
        )

        column DATA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: A
            }
        )

        column DESTINO (
            type: plainText
            heading {
                heading: Destino
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column PRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Bipado por
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        savedReport 882095 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CODIGO (
                sequence: 3
            )

            displayColumn DATA (
                sequence: 1
            )

            displayColumn DESTINO (
                sequence: 5
            )

            displayColumn PRODUTO (
                sequence: 4
            )

            displayColumn USUARIO (
                sequence: 2
            )

        )

    )

    pageItem P594_AVISO (
        type: textField
        label {
            label: Atenção:  Tente de novo, movimentação não realizada.
            alignment: left
        }
        layout {
            sequence: 40
            region: @realizar-movimentação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 80
        }
        serverSideCondition {
            type: item=value
            item: P594_SUCESSO
            value: N
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P594_CODIGOBARRAS (
        type: textField
        label {
            label: Bipe Aqui >
            alignment: left
        }
        layout {
            sequence: 30
            region: @realizar-movimentação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 13
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P594_DESTINO (
        type: displayOnly
        label {
            label: "Destino "
            alignment: left
        }
        layout {
            sequence: 20
            region: @realizar-movimentação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vdestino varchar2(100);
                begin
                  if :P594_ESTOQUEDESTINO = 'D' then
                    vdestino := 'Distribuição';
                  elsif :P594_ESTOQUEDESTINO = 'R' then
                    vdestino := 'Reembalagem';
                  elsif :P594_ESTOQUEDESTINO = 'P' then
                    vdestino := 'Distribuição PA';
                  elsif :P594_ESTOQUEDESTINO = 'S' then
                    vdestino := 'Reembalagem PA';
                  end if;
                  --
                  return vdestino;
                  --
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P594_ESTOQUEDESTINO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @realizar-movimentação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P594_IDDEVOLUCAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @realizar-movimentação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P594_IDPOSTOAVANCADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @realizar-movimentação
            slot: regionBody
        }
        serverSideCondition {
            type: never
        }
    )

    pageItem P594_ORIGEMCHAMADA (
        type: hidden
        layout {
            sequence: 100
            region: @realizar-movimentação
            slot: regionBody
        }
    )

    pageItem P594_QTD_ETIQUETAS (
        type: displayOnly
        label {
            label: Etiquetas Bipadas
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 80
            region: @realizar-movimentação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<h1>'||count(1)||'</h1>' qtd
                from itensbipadosdevolucoes it
                where it.iddevolucaorepres = :P594_IDDEVOLUCAO
                  and it.idestoquefilial is not null
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P594_SUCESSO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @realizar-movimentação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar e Atualizar
        layout {
            sequence: 10
            region: @realizar-movimentação
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 115
                items: {
                    P115_IDDEVOLUCAOREPRES: &P594_IDDEVOLUCAO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P594_ORIGEMCHAMADA
            value: 115
        }
    )

    button fecharpa (
        buttonName: FECHARPA
        label: Fechar e Atualizar
        layout {
            sequence: 20
            region: @realizar-movimentação
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 319
                items: {
                    P319_IDDEVOLUCAOREPRES: &P594_IDDEVOLUCAO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P594_ORIGEMCHAMADA
            value: 319
        }
    )

    dynamicAction movimenta (
        name: Movimenta
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P594_CODIGOBARRAS
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P594_CODIGOBARRAS
        }
        serverSideCondition {
            type: never
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P594_CODIGOBARRAS
            }
            execution {
                sequence: 20
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: MOVIMENTADEVOLUCAO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-focus (
        name: Set Focus
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P594_CODIGOBARRAS
            }
            execution {
                sequence: 10
            }
        )

    )

    validation valida-tamanho-do-código-de-barras (
        name: Valida tamanho do código de barras
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where length(trim(:P594_CODIGOBARRAS)) NOT IN (5,13)
                ```
        }
        error {
            errorMessage: Por favor, verifique o código de barras bipado, código não reconhecido.
            associatedItem: @P594_CODIGOBARRAS
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P594_CODIGOBARRAS
        }
    )

    process movimenta-devolução (
        name: Movimenta Devolução
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vsucesso varchar2(1);
                  vusuario varchar2(50) := v('APP_USER');
                  --
                begin
                  --
                  pck_estoque_v2.prc_movimentadevolucao(pcodigobarras => :P594_CODIGOBARRAS,
                                                        piddevolucao  => :P594_IDDEVOLUCAO,
                                                        ptipo         => :P594_ESTOQUEDESTINO,
                                                        pidfilial     => :P0_IDFILIAL,
                                                        pusuario      => vusuario ,
                                                        psucesso      => vsucesso);
                  --
                  :P594_CODIGOBARRAS := null;
                  :P594_SUCESSO := vsucesso;
                  
                  -- inclui o id do posto avançado. 
                  update roman.itensdevolucaorepres id
                  set id.idpostoavancado = :P594_IDPOSTOAVANCADO
                  where id.iddevolucaorepres = :P594_IDDEVOLUCAO;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Movimentação realizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 82238659873270539
        }
    )

    branch (
        name: Go To Page 594
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 594
                items: {
                    P594_CODIGOBARRAS:
                    P594_SUCESSO:
                    P594_IDDEVOLUCAO: &P594_IDDEVOLUCAO.
                    P594_ESTOQUEDESTINO: &P594_ESTOQUEDESTINO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'MOVIMENTADEVOLUCAO'
                  and :P594_SUCESSO = 'S'
                ```
        }
    )

    branch (
        name: Go To Page 594
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 594
                items: {
                    P594_CODIGOBARRAS:
                    P594_SUCESSO: &P594_SUCESSO.
                    P594_DESTINO: &P594_DESTINO.
                    P594_ESTOQUEDESTINO: &P594_ESTOQUEDESTINO.
                    P594_IDDEVOLUCAO: &P594_IDDEVOLUCAO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'MOVIMENTADEVOLUCAO'
                  and :P594_SUCESSO = 'N'
                ```
        }
    )

)

