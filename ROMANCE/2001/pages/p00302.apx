page 302 (
    name: Categorias
    title: Categorias
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region categorias (
        name: Categorias
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "IDCATEGORIA",
                "NOME",
                "DESCRICAO",
                "PERCLUCRO",
                decode(ativo,'S','Sim','N','Não') ativo,
                "OBSERVACAO",
                "REFERENCIA",
                "TEMPOPADRAOREEMBALAGEM"
                from "#OWNER#"."CATEGORIAS"
                order by nome
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column ATIVO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Ativo
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Descricao
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: never
            }
        )

        column IDCATEGORIA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Idcategoria
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: never
            }
        )

        column NOME (
            reportColumnQueryId: 3
            derivedColumn: N
            type: link
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            link {
                target: {
                    page: 306
                    items: {
                        P306_IDCATEGORIA: #IDCATEGORIA#
                    }
                    action: resetPagination
                }
                linkText: #NOME#
            }
            sorting {
                sortable: false
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 7
            }
            sorting {
                sortable: false
            }
        )

        column PERCLUCRO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Perclucro
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: never
            }
        )

        column REFERENCIA (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Referencia
                alignment: center
            }
            layout {
                sequence: 8
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: never
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
            security {
                escapeSpecialChars: false
            }
        )

        column TEMPOPADRAOREEMBALAGEM (
            reportColumnQueryId: 9
            derivedColumn: N
            type: textField
            heading {
                heading: Tempo Reembalagem
                alignment: center
            }
            layout {
                sequence: 9
            }
            appearance {
                formatMask: 999G999G999G999G990D00
                width: 16
            }
            sorting {
                sortable: false
            }
        )

    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @categorias
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation tempopadraoreembalagem-must-be-numeric (
        name: TEMPOPADRAOREEMBALAGEM must be numeric
        execution {
            sequence: 90
        }
        validation {
            editableRegion: @categorias
            type: columnIsNumeric
            column: TEMPOPADRAOREEMBALAGEM
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: TEMPOPADRAOREEMBALAGEM
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @categorias
        target {
            tableName: CATEGORIAS
            pkColumn: ROWID
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 344058817294390778
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 302
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

