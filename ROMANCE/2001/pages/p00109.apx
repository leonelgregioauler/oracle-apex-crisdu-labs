page 109 (
    name: Alteração de despesas
    title: Alteração de despesas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region alteração-de-despesas (
        name: Alteração de despesas
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P109_DATAVENCIMENTO (
        type: datePickerJquery
        label {
            label: Data vencimento
            alignment: left
        }
        layout {
            sequence: 40
            region: @alteração-de-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: DATAVENCIMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P109_IDCONTACONTABIL (
        type: selectList
        label {
            label: Conta Contábil
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idcontafinan
                from contasfinanceiras c
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @alteração-de-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTACONTABIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P109_IDDESPESA (
        type: hidden
        layout {
            sequence: 10
            region: @alteração-de-despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDDESPESA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P109_IDSUBCONTACONTABIL (
        type: selectList
        label {
            label: Sub Conta Contábil
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idsubcontafinan
                from subcontasfinanceiras c
                where c.idcontafinan = :P109_IDCONTACONTABIL
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione a Sub Conta  -
        }
        cascadingLov {
            parentItems: P109_IDCONTACONTABIL
        }
        layout {
            sequence: 30
            region: @alteração-de-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDSUBCONTACONTABIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P109_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @alteração-de-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P109_VALOR (
        type: numberField
        label {
            label: Valor
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @alteração-de-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G990D00
            width: 12
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: VALOR
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @alteração-de-despesas
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 68
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @alteração-de-despesas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P109_IDDESPESA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @alteração-de-despesas
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P109_IDDESPESA
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 30
            region: @alteração-de-despesas
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P109_IDDESPESA
        }
    )

    process fetch-row-from-despesas (
        name: Fetch Row from DESPESAS
        type: autoRowFetch
        source {
            tableName: DESPESAS
            pkColumn: IDDESPESA
            pkItem: P109_IDDESPESA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 169583955385641276
        }
    )

    process process-row-of-despesas (
        name: Process Row of DESPESAS
        type: autoRowProcessing
        target {
            tableName: DESPESAS
            pkColumn: IDDESPESA
            pkItem: P109_IDDESPESA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela DESPESAS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 169584158869641278
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 169584379210641279
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: Go To Page 109
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 109
                items: {
                    P109_IDCONTACONTABIL: &P109_IDCONTACONTABIL.
                }
            }
            saveStateBeforeBranching: true
        }
    )

    branch (
        execution {
            sequence: 5
        }
        behavior {
            target: {
                page: 68
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
        comments {
            comments: Created 24-FEV-2012 17:47 by ROMAN
        }
    )

)

