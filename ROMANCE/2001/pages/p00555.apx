page 555 (
    name: Pesquisa de Eventos
    title: Pesquisa de Eventos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region pesquisa-de-eventos (
        name: Pesquisa de Eventos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct (c.idchamado)
                     , c.dataabertura
                     , pck_romance.fnc_nomefilial(pck_romance.fnc_filialusuario(upper(c.usuario))) "Empresa"
                     , initcap(c.usuario) "Usuário"
                     , pck_chamados.fnc_situacaochamado(c.idsituacao) situacao
                     , c.descricao
                     , c.idtipochamado
                     , pck_chamados.fnc_tipochamado(c.idtipochamado) tipochamado
                     , c.iditemchamado
                     , pck_chamados.fnc_itemchamado(c.iditemchamado) itemchamado
                     , c.idservicochamado
                     , pck_chamados.fnc_servicochamado(c.idservicochamado) servicochamado
                     , ( select count(1) from historicochamados h where h.idchamado = c.idchamado) "Qtd de Históricos"
                     , c.idimpactotrabalho
                     , pck_chamados.fnc_impactochamado(c.idimpactotrabalho) impacto
                     , prioridade
                     , pck_romance.fnc_nomeusuario(responsavel) responsavel
                     , c.dataencerrado
                     , null historicos
                from chamados  c
                where ( :P555_DESCRICAO is null or lower(c.descricao) like '%'||lower(replace(:P555_DESCRICAO,' ','%' ))||'%' )
                  and ( :P555_USUARIO is null or lower(c.usuario) like '%'||lower(replace(:P555_USUARIO,' ','%' ))||'%' )
                  and ( :P555_DESCRICAO is not null
                     or :P555_USUARIO is not null )
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 26584934640629302
        }

