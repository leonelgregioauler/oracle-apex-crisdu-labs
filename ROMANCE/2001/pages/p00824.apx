            templateOptions: #DEFAULT#
        }
    )

    button entregabrinde (
        buttonName: ENTREGABRINDE
        label: Entregar Brinde
        layout {
            sequence: 20
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 30
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 825
                items: {
                    P825_CUPOM: &P824_CUPOM.
                }
                clearCache: 825
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P824_DATARETIRADA
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction confirmação-de-dados (
        name: "Confirmação de Dados "
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @entregabrinde
        }

        action native-confirm (
            action: confirm
            settings {
                message: Os dados da empreendedora estão realmente corretos ? Esta operação não poderá ser desfeita !
                style: warning
                confirmLabel: SIM
                cancelLabel: NÃO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ENTREGABRINDE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction mostra-botão-entrega (
        name: "Mostra Botão Entrega "
        execution {
            sequence: 10
        }
        when {
            selectionType: button
            button: @entregabrinde
        }
        clientSideCondition {
            type: item=value
            item: P824_RETIRADOPOR
            value: A
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @entregabrinde
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: button
                button: @entregabrinde
            }
            execution {
                sequence: 10
            }
        )

    )

    process busca-dados (
        name: "Busca Dados "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                --
                vvendedora     varchar2(100);
                vdocumento     varchar2(15);
                vdistribuidor  varchar2(100);
                vretiradopor   varchar2(100);
                --
                begin
                  --
                  select roman.pck_romance.fnc_nomevendedora(clc.idvendedora) vendedora
                       ,(select nvl(p.cpf,p.documentoestrangeiro)
                         from catal.vendedoras v
                            , catal.pessoas p 
                         where p.idpessoa = v.idpessoa
                            and v.idvendedora = clc.idvendedora) documento      
                       ,(select roman.pck_romance.fnc_nomerepresentante(vv.idrepresentante)
                         from catal.vendedoras vv 
                         where vv.idvendedora = clc.idvendedora) distribuidor      
                       , clc.retiradopor retirado 
                   into vvendedora, vdocumento, vdistribuidor , vretiradopor
                from roman.conquistoulevoucupons clc
                where clc.idconquistoulevoucupom = :P824_CUPOM;
                  --
                  :P824_VENDEDORA       := vvendedora;
                  :P824_DOCUMENTO       := vdocumento;
                  :P824_DISTRIBUIDOR    := vdistribuidor;
                  :P824_RETIRADOPOR     :=  vretiradopor;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 23341413599502811
        }
    )

    process processo-entregar-brinde (
        name: Processo Entregar Brinde
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                  --raise_application_error(-20001,'xxxxx');
                begin
                  --
                  if :P824_RETIRADOPOR != 'A' then --aguardando 
                  update roman.conquistoulevoucupons clc
                  set clc.retiradopor = :P824_RETIRADOPOR, clc.dataretirada = sysdate 
                  where clc.idconquistoulevoucupom = :P824_CUPOM;
                  --
                  else 
                    --
                    raise_application_error(-20001,'Informe quem Retirou!');
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 23341272659502809
        }
        serverSideCondition {
            whenButtonPressed: @entregabrinde
        }
    )

    branch (
        name: Go To Page 823
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 823
                request: 823
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
        }
    )

)

