page 824 (
    name: Entrega Brindes
    title: Entrega Brindes
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region ações (
        name: "Ações "
        type: staticContent
        layout {
            sequence: 30
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region brindes-cupom (
        name: Brindes Cupom
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.nomebrinde 
                     , b.idbrindeclube
                     , (select cc.nomeclassif
                        from roman.conquistoulevouclassificacoes cc
                        where cc.idclassificacao = it.idclassificacao) classificação
                     , (select cr.nomecaracteristica
                        from roman.conquistoulevoucaracteristicas cr
                        where cr.idcaracteristica = it.idcaracteristica ) característica
                from roman.brindesclub b
                   , roman.itensconqlevcupons it 
                where it.idbrindeclube = b.idbrindeclube
                  and it.idconquistoulevoucupom = :P824_CUPOM
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 12594034295070510
        }

        column CARACTERÍSTICA (
            type: plainText
            heading {
                heading: Característica
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column CLASSIFICAÇÃO (
            type: plainText
            heading {
                heading: Classificação
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDBRINDECLUBE (
            type: plainText
            heading {
                heading: Id Brinde
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column NOMEBRINDE (
            type: plainText
            heading {
                heading: Brinde
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 233543 (
            visibility: primaryDefault
