            preText:
                ```html
                <font color="red">
                    <h3>
                    Confira os Dados da Empreendedora e Cupom 
                    </h3>
                </font>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.conquistoulevoucupons clc
                where clc.dataretirada is null
                  and clc.idconquistoulevoucupom = :P824_CUPOM
                ```
