    pageItem P824_DOCUMENTO (
        type: displayOnly
        label {
            label: Documento
            alignment: left
        }
        layout {
            sequence: 50
            region: @dados-cupom
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(p.cpf,p.documentoestrangeiro) documento
                from catal.pessoas p 
                   , catal.vendedoras v 
                where p.idpessoa = v.idpessoa
                  and v.idvendedora = :P824_IDVENDEDORA
                ```
        }
        default {
            type: item
            item: P824_CUPOM
        }
    )

    pageItem P824_ENTREGUE (
        type: displayOnly
        label {
            label: Entregue
            alignment: left
        }
        layout {
            sequence: 110
            region: @dados-cupom
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 'Data Resgate: '||clc.dataresgate|| '  --  ' ||'Data Entrega: ' || clc.dataretirada|| '  --  ' ||'Retirado Por: '
                || decode (clc.retiradopor,'E','Empreendedora','D','Distribuidor') info
                from roman.conquistoulevoucupons clc
                where clc.idconquistoulevoucupom = :P824_CUPOM
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.conquistoulevoucupons clc
                where clc.dataretirada is not null
                  and clc.idconquistoulevoucupom = :P824_CUPOM
                ```
        }
    )

