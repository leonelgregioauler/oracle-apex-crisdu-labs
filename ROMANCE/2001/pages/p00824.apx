    pageItem P824_DISTRIBUIDOR (
        type: displayOnly
        label {
            label: Distribuidor :
            alignment: left
        }
        layout {
            sequence: 70
            region: @dados-cupom
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(v.idrepresentante)
                  from catal.vendedoras v 
                  where v.idvendedora = :P824_IDVENDEDORA
                ```
        }
