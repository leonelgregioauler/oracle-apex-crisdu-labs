    region faixa-etária-das-consultoras (
        name: Faixa Etária das Consultoras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select fe.nome
                         from faixasetarias fe
                         where fe.idfaixaetaria = f.idfaixaetaria ) faixa
                     , count( distinct v.idvendedora ) qtd
                from faixasetarias f
                   , vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and v.ativo    = 'S'
                  and p.datanascimento is not null
                  and NVL(Floor(Months_Between(trunc(sysdate),p.datanascimento)/12),0) between f.valorinicial and f.valorfinal
                  and not exists ( select 1
                                   from representantes r
                                   where r.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = v.idpessoa )
                  and exists ( select 1
                               from notasvendas nv
                               where nv.idvendedora = v.idvendedora )
                  and ( :P467_IDFILIAL = -1 
                    or ( :P467_IDFILIAL > 1 and v.idfilial = :P467_IDFILIAL )
                    or ( :P467_IDFILIAL = -10 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial   = v.idfilial
                                                           and f.tipofilial = 'D'
                                                           and f.ativo      = 'S'
                                                           and f.idgrupo   != 5 ) )
                    or ( :P467_IDFILIAL = -20 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial   = v.idfilial
                                                           and f.tipofilial = 'D'
                                                           and f.ativo      = 'S'
                                                           and f.idgrupo    = 5 ) ) )
                group by idfaixaetaria
                union
                select 'Sem Faixa Etária'
                     , count(distinct(p.idpessoa)) qtd
                from pessoas p
                  , vendedoras v
                where p.idpessoa = v.idpessoa
                  and v.ativo    = 'S'
                  and not exists ( select 1
                                   from representantes r
                                   where r.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = v.idpessoa )
                  and exists ( select 1
                               from notasvendas nv
                               where nv.idvendedora = v.idvendedora )
                  and not exists ( select 1
                                   from faixasetarias f
                                   where NVL(Floor(Months_Between(trunc(sysdate),p.datanascimento)/12),0) between f.valorinicial and f.valorfinal )
                  and ( :P467_IDFILIAL = -1 
                    or ( :P467_IDFILIAL > 1 and v.idfilial = :P467_IDFILIAL )
                    or ( :P467_IDFILIAL = -10 and exists ( select 1
                                                           from vw_filiais f
                                                           where f.idfilial   = v.idfilial
                                                             and f.tipofilial = 'D'
                                                             and f.ativo      = 'S'
                                                             and f.idgrupo   != 5 ) )
                    or ( :P467_IDFILIAL = -20 and exists ( select 1
                                                           from vw_filiais f
                                                           where f.idfilial   = v.idfilial
                                                             and f.tipofilial = 'D'
                                                             and f.ativo      = 'S'
                                                             and f.idgrupo    = 5 ) ) )
                
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
