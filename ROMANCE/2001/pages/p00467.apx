    region análise-de-consultoras-antes-e-depois-do-app (
        name: Análise de Consultoras - Antes e Depois do app
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(r.idfilial) empresa
                     , ( select pck_romance.fnc_nomerepresentante(rr.idrepresentante )
                         from representantes rr
                         where rr.idrepresentante = v.idrepresentante )   distribuidor
                     , v.idvendedora  
                     , pck_romance.fnc_nomepessoa(v.idpessoa) consultora
                     , cpf
                     , datalogin    
                     , ( select sum(n.valortotalvenda)/count(1)
                         from notasvendas n
                         where n.idvendedora = r.idvendedora      
                           and n.idsituacaonotavenda = 4
                           and n.dataacerto  < r.datalogin
                           and n.dataacerto  > r.datalogin-360 )  mediaantesapp
                     , ( select sum(n.valortotalvenda)/count(1)
                         from notasvendas n
                         where n.idvendedora = r.idvendedora 
                           and n.idsituacaonotavenda = 4
                           and n.dataacerto  > r.datalogin)  mediadepoisapp    
                     , ( select sum(n.valortotalvenda)/count(1)
                         from notasvendas n
                         where n.idvendedora = r.idvendedora 
                           and n.idsituacaonotavenda = 4
                           and n.dataacerto  > r.datalogin)  
                     - ( select sum(n.valortotalvenda)/count(1)
                         from notasvendas n
                         where n.idvendedora = r.idvendedora 
                           and n.idsituacaonotavenda = 4
                           and n.dataacerto  < r.datalogin
                           and n.dataacerto  > r.datalogin-360 )  diferenca 
                           
                           
                     , case 
                         when ( select sum(n.valortotalvenda)/count(1)
                                from notasvendas n
                                 where n.idvendedora = r.idvendedora  
                                   and n.idsituacaonotavenda = 4                                    
                                   and n.dataacerto  < r.datalogin
                                   and n.dataacerto  > r.datalogin-360 )  > 0 then
                        round(( select sum(n.valortotalvenda)/count(1)
                         from notasvendas n
                         where n.idvendedora = r.idvendedora    
                           and n.idsituacaonotavenda = 4
                           and n.dataacerto  > r.datalogin) *100 /   ( select sum(n.valortotalvenda)/count(1)
                                                                       from notasvendas n
                                                                       where n.idvendedora = r.idvendedora       
                                                                         and n.idsituacaonotavenda = 4
                                                                         and n.dataacerto  < r.datalogin
                                                                         and n.dataacerto  > r.datalogin-360 )    ,2)-100 end perc
                           
                            
                     , ( select count(rc.datacompartilhamento)
                         from registroscompartilhafotos rc
                         where rc.idvendedora  = r.idvendedora ) qtdcompartilhado 
                     , decode(v.ativo,'S','Ativo','N','Inativo') situacao
                from registrosloginminhasacola r
                   , vendedoras                v
                where r.primeirologin = 'S' 
                  and r.idvendedora   = v.idvendedora
                  and ( :P467_IDFILIAL = -1 
                    or ( :P467_IDFILIAL > 1 and r.idfilial = :P467_IDFILIAL )
                    or ( :P467_IDFILIAL = -10 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial   = r.idfilial
                                                           and f.tipofilial = 'D'
                                                           and f.ativo      = 'S'
                                                           and f.idgrupo   != 5 ) )
                    or ( :P467_IDFILIAL = -20 and exists ( select 1
                                                         from vw_filiais f
                                                         where f.idfilial   = r.idfilial
                                                           and f.tipofilial = 'D'
                                                           and f.ativo      = 'S'
                                                           and f.idgrupo    = 5 ) ) )
                  and exists  ( select 1
                                 from notasvendas n
                                 where n.idvendedora = r.idvendedora 
                                   and n.idsituacaonotavenda = 4
                                   and n.dataacerto < r.datalogin
                                   and n.dataacerto > r.datalogin-360)  
                  and exists  ( select 1
                                 from notasvendas n
                                 where n.idvendedora = r.idvendedora  
                                   and n.idsituacaonotavenda = 4
                                   and n.dataacerto > r.datalogin)    
                ```
            pageItemsToSubmit: P467_IDFILIAL
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 10
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
