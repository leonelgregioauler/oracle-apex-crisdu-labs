    region filtro-de-empresa (
        name: Filtro de Empresa
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P467_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select (select initcap(nvl(apelido,nomepessoa))
                        from pessoas 
                        where idpessoa = f.idpessoa )|| CASE when v('APP_USER') in ('EVERTON','GUILHERME','LUIZV','FERNANDO') then
                                                                    ' - '||f.idfilial
                                                                    end display_value
                     , f.idfilial
                from filiais f
                where ( f.tipofilial = 'D'
                     or f.tipofilial = 'O' and idfilial in (1085,1088) )
                  and f.ativo = 'S'
                  and exists ( select 1
                               from usuariosfiliais u
                               where u.idfilial  = f.idfilial
                                 and u.usuario   = v('APP_USER') )
                UNION
                select '- Todas - ' display_value
                     , -1 return_value
                from dual
                where v('APP_USER') IN ('EVERTON', 'PRISCILAREIS', 'PAOLOO', 'EDUARDO','GUILHERME', 'PAMELAB', 'RUBIAS','FERNANDAZS')
                UNION
                select '- Brasil -'
                     , -10
                from dual
                where v('APP_USER') IN ('EVERTON', 'PRISCILAREIS', 'PAOLOO', 'EDUARDO','GUILHERME', 'PAMELAB', 'RUBIAS','FERNANDAZS')
                UNION 
                select '- Exterior -'
                     , -20
                from dual
                where v('APP_USER') IN ('EVERTON', 'PRISCILAREIS', 'PAOLOO', 'EDUARDO','GUILHERME', 'PAMELAB', 'RUBIAS','FERNANDAZS')
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtro-de-empresa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction escolhe-empresa (
        name: Escolhe Empresa
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P467_IDFILIAL
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @análise-de-consultoras-antes-e-depois-do-app
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

