page 100 (
    name: Boletos Recebidos em Mãos
    title: Boletos Recebidos em Mãos
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region boletos-recebidos-em-mãos (
        name: Boletos Recebidos em Mãos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select consultora "Consultora"
                     , cpf "CPF"
                     , valortotal "Valor Total"
                     , b.datavencimento "Vencimento"
                     , b.valoratualizado "Valor Atualizado p/ Hoje"
                from vw_debitosvendedfavorita b
                where b.situacao not in ('C','Q','H','Z')
                  and b.pagoaorepresentante = 'S'  
                  and not exists (select 1
                                 from boletos bb
                                 where bb.idboletonegociacao = b.idboleto
                                   and b.situacao not in ( 'C','Q','H')) 
                  and b.idrepresentante = :P100_IDREPRESENTANTE
                order by 1 ;
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column CPF (
            type: plainText
            heading {
                heading: Cpf
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column Consultora (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column "Valor Atualizado p/ Hoje" (
            type: plainText
            heading {
                heading: Valor atualizado p/ hoje
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column "Valor Total" (
            type: plainText
            heading {
                heading: Valor total
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column Vencimento (
            type: plainText
            heading {
                heading: Vencimento
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
        )

        savedReport 1896126 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn CPF (
                sequence: 2
            )

            displayColumn "Consultora" (
                sequence: 1
            )

            displayColumn "Valor Atualizado p/ Hoje" (
                sequence: 5
            )

            displayColumn "Valor Total" (
                sequence: 3
            )

            displayColumn "Vencimento" (
                sequence: 4
            )

            aggregate (
                column: VALORCOBRADO
            )

            aggregate (
                column: "Valor Atualizado p/ Hoje"
            )

            aggregate (
                column: "Valor Total"
            )

        )

    )

    pageItem P100_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @boletos-recebidos-em-mãos
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

)

