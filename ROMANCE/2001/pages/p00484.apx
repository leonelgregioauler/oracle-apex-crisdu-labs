page 484 (
    name: Pontuação Distribuidores
    title: Pontuação Distribuidores
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region font-color-white-font (
        name: <font color="white"></font>
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_imprime.prc_pontuacaoempresas(ptipo => :P484_TIPO,
                                                    pidfilial => :P484_IDFILIAL,
                                                    pidgrupo => :P484_IDGRUPO,
                                                    pidcampanha => :P484_IDCAMPANHA,
                                                    pidcampanhafilial => :P484_IDCAMPANHAFILIAL);
                end;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item!=value
            item: P484_IDCAMPANHA
            value: 6
        }
    )

    region font-color-white-font-2 (
        name: <font color="white"></font>
