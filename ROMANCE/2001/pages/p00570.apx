page 570 (
    name: Negociações Realizadas
    title: Negociações Realizadas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region negociações (
        name: Negociações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select consultora
                     , datanegociacao
                     , valornegociacao
                     , formapagamentodescr
                     , datalimitedeposito
                     , valorconfirmado
                from vw_negociacoesparceiros 
                where idrepresentante = :P570_IDREPRESENTANTE
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4552643339503530731
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column DATALIMITEDEPOSITO (
            type: plainText
            heading {
                heading: Limite Depósito
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column DATANEGOCIACAO (
            type: plainText
            heading {
                heading: Data Negociação
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column FORMAPAGAMENTODESCR (
            type: plainText
            heading {
                heading: Forma de Pagamento
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column VALORCONFIRMADO (
            type: plainText
            heading {
                heading: Valor Confirmado
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column VALORNEGOCIACAO (
            type: plainText
            heading {
                heading: Valor Negociação
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 406868 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONSULTORA (
                sequence: 1
            )

            displayColumn DATALIMITEDEPOSITO (
                sequence: 5
            )

            displayColumn DATANEGOCIACAO (
                sequence: 2
            )

            displayColumn FORMAPAGAMENTODESCR (
                sequence: 4
            )

            displayColumn VALORCONFIRMADO (
                sequence: 6
            )

            displayColumn VALORNEGOCIACAO (
                sequence: 3
            )

            aggregate (
                column: VALORNEGOCIACAO
            )

            aggregate (
                column: VALORCONFIRMADO
            )

        )

    )

    pageItem P570_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @negociações
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

