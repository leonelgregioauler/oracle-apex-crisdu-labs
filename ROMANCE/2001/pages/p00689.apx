page 689 (
    name: Info Mesa de Credito
    title: Info Mesa de Credito
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1280
        height: 620
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region botões (
        name: Botões
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region info-mesa-da-credito (
        name: Info. Mesa da Credito
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cs.ccf chequesfundo
                     , cs.spc_quantidade
                     , cs.spc_valortotal
                     , cs.spcscore12meses
                     , cs.spcscore3meses
                     , cs.idconsultaspc
                     , cs.regiaocpf
                     , cs.situacaocpf
                from roman.consultaspc cs
                where cs.idconsultaspc = :P689_IDCONSULTA
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1110084682234389903
        }

        column CHEQUESFUNDO (
            type: link
            heading {
                heading: Cheque s/ Fundo
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            link {
                target: {
                    page: 416
                    items: {
                        P416_IDCONSULTASPC: #IDCONSULTASPC#
                    }
                    action: resetPagination
                }
                linkText: #CHEQUESFUNDO#
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDCONSULTASPC (
            type: hidden
            heading {
                heading: Idconsultaspc
            }
            layout {
                sequence: 60
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
            security {
                escapeSpecialChars: false
            }
        )

        column REGIAOCPF (
            type: plainText
            heading {
                heading: Região do CPF
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column SITUACAOCPF (
            type: plainText
            heading {
                heading: Situação do CPF
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column SPCSCORE12MESES (
            type: plainText
            heading {
                heading: Score 12 meses
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column SPCSCORE3MESES (
            type: plainText
            heading {
                heading: Score 3 meses
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column SPC_QUANTIDADE (
            type: link
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 397
                    items: {
                        P397_IDCONSULTASPC: #IDCONSULTASPC#
                    }
                    action: resetPagination
                }
                linkText: #SPC_QUANTIDADE#
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column SPC_VALORTOTAL (
            type: plainText
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        savedReport 11100945 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CHEQUESFUNDO (
                sequence: 5
            )

            displayColumn REGIAOCPF (
                sequence: 2
            )

            displayColumn SITUACAOCPF (
                sequence: 1
            )

            displayColumn SPCSCORE12MESES (
                sequence: 6
            )

            displayColumn SPCSCORE3MESES (
                sequence: 7
            )

            displayColumn SPC_QUANTIDADE (
                sequence: 3
            )

            displayColumn SPC_VALORTOTAL (
                sequence: 4
            )

        )

    )

    pageItem P689_IDCONSULTA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @info-mesa-da-credito
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: Fechar
        label: Fechar
        layout {
            sequence: 10
            region: @botões
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process close (
        name: Close
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1459955692342807502
        }
    )

)

