page 185 (
    name: Atualizar Produto
    title: Atualizar Produto
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function confirma(event)
            { var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            if (tecla==13) 
            { var answer = confirm("Confirma inclusão do item no estoque?")
              if (answer)
              {apex.submit('CREATE');}}}
            
            
            function fnc_popup(pid)
              {
                window.open('f?p=&APP_ID.:124:&SESSION.::NO::P124_IDESTOQUEFILIAL:'+pid,'ESTOQUE', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=300,left=200,top=100','_blank'); void(0);
            }
            
            function fnc_popup_habilitar()
            {
              window.open( 'f?p=&APP_ID.:142:&SESSION.::NO::', 'HABILITAR', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=300,left=250,top=100','_blank'); void(0);
            }
            
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region atualizar-produto (
        name: Atualizar Produto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ RULE*/( select c.nome ||' ('||c.idcategoria ||')'
                         from categorias c
                         where c.idcategoria = ( select pr.idcategoria
                                                 from produtos pr
                                                 where pr.idproduto = e.idproduto ) ) "Categoria"
                     , ( select pr.codigosisdist
                         from produtos pr
                         where pr.idproduto = e.idproduto )  "Código"
                     , ( select initcap(pr.nomeproduto) 
                         from produtos pr
                         where pr.idproduto = e.idproduto )  "Produto"
                     , ( select c.descricao
                         from cores c
                         where c.idcor = e.idcor)  "Cor"
                     , e.quantidade
                     , decode(e.ativo,'S','Sim','Não') ativo
                     , e.idestoquefilial
                     , e.idfilial
                     , e.idproduto
                     , e.idcor
                     , decode(e.comissao, 'S', 'Sim','N','Não') comissao
                     , e.vlrvenda
                from estoquefilial e
                where e.idfilial = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        link {
