    region ultimas-cobranças (
        name: Ultimas Cobranças
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select link
                     , label 
                     , value "Cobrança"
                from( select fr.idfechamentorepres link
                           , fr.semana label
                           , fr.totalgeral value
                      from fechamentorepresentantes fr
                      where fr.idrepresentante = :P524_IDREPRESENTANTE
                      order by 1 desc)
                where rownum <= 10
                order by 1
