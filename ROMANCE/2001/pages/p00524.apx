    region ultimas-cobranças-2 (
        name: Ultimas Cobranças
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.*
                from (
                select pck_romance.fnc_nomeregiaovenda(f.idregiaovenda) regiao
                     , f.semana
                     , f.qtdnotasatender para_atender
                     , f.qtdnotasfechou total_acertadas
                     , f.qtdnotasnovas notas_novas
                     , f.qtdnotasnovasoutrareg novas_outra_regiao
                     , f.totalcobranca cobranca
                     , case 
                         when totalcobranca = 0 then
                           0
                         when qtdnotasfechou = 0 then
                           0
                         else 
                           nvl(f.totalcobranca,1)/nvl(f.qtdnotasfechou,1) 
                       end ticketmedio
                     , f.totalgeral total
                     , nvl(( select count(1)
                             from notasvendas nv
                             where nv.idregiaovenda = f.idregiaovenda
                               and nv.idrepresentante = f.idrepresentante
                               and nv.idsituacaonotavenda = 4
                               and nv.saldo > 0),0) debitos
                     , f.totaldebitosnovos debitos_novos
                     , nvl(f.totalpepinosrecebidos,0) debitos_recebidos
                from fechamentorepresentantes f 
                where idrepresentante = :P524_IDREPRESENTANTE
                order by f.idfechamentorepres desc) t
                where rownum <= 10
                ```
        }
        layout {
            sequence: 20
            parentRegion: @ultimas-cobranças-3
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
