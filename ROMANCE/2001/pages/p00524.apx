    region dívida-ativa (
        name: Dívida Ativa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(:P0_IDFILIAL) Franquia
                     , pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                     , r.totalcheques
                     , r.totalchequespago
                     , r.totalcheques - r.totalchequespago saldocheques
                     , r.cheques
                     , r.pgtoscheques
                     , r.cheques - pgtoscheques saldochequesdev
                     , r.totalemprestimos
                     , r.totalemprestimospago
                     , r.totalemprestimos - r.totalemprestimospago saldoemprestimos
                     , r.debitosromance
                     , r.debitosfavorita
                     /*, r.saldomanutencao*/
                     , r.saldoacerto
                     , r.saldodefeitos
                     , r.negbalvalor
                     , r.negbalpago
                     , (r.negbalvalor - r.negbalpago) negbalancosaldo
                     , r.negcarros
                     , r.negcarrospago
                     , (r.negcarros - r.negcarrospago) negcarrossaldo
                     , case
                         when r.saldoacerto >= 0 then
                           ((r.totalcheques - r.totalchequespago)
                           +(r.totalemprestimos - r.totalemprestimospago)
                           +(r.cheques - pgtoscheques)
                           + r.debitosromance
                           + r.debitosfavorita
                           /*+ r.saldomanutencao*/
                           + r.saldoacerto
                           + r.saldodefeitos
                           + (r.negbalvalor - r.negbalpago) 
                           + (r.negcarros - r.negcarrospago) )
                         when r.saldoacerto < 0 then
                           ( (r.totalcheques - r.totalchequespago)
                           + (r.totalemprestimos - r.totalemprestimospago)
                           + (r.cheques - pgtoscheques)
                           + r.debitosromance
                           + r.debitosfavorita
                           /*+ r.saldomanutencao*/
                           + r.saldodefeitos
                           + (r.negbalvalor - r.negbalpago)
                           + (r.negcarros - r.negcarrospago) ) 
                       end dividatotal
                     , case
                         when r.saldoacerto < 0 then
                           0
                         else
                           r.saldoacerto
                       end saldoacertopositivo
                from ( 
                       select idrepresentante
                            , nvl(( select sum(c.VALOR) saldo
                                    from CHEQUES2 c
                                    where c.semfundo = 'S'
                                      and nvl(c.emprestimo,'N') = 'N'
                                      and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from c.datainclusao ) = :P524_ANO )
                                      and c.idrepresentante = r.idrepresentante ),0) totalcheques
                            , nvl(( select sum(cp.valor)
                                    from cheques2pgto cp
                                    where exists ( select 1
                                                   from cheques2 c
                                                   where c.idrepresentante = r.idrepresentante
                                                     and c.semfundo        = 'S'
                                                     and nvl(c.emprestimo,'N') = 'N'
                                                     and c.idcheque        = cp.idcheque )
                                      and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from to_date(cp.datapgto,'DD/MM/RRRR') ) = :P524_ANO ) ),0) totalchequespago
                            , nvl(( select sum(cc.valor)
                                    from cheques2 cc
                                    where nvl(cc.semfundo,'N') = 'S'
                                      and cc.emprestimo = 'S'
                                      and cc.idrepresentante = r.idrepresentante
                                      and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from cc.datainclusao ) = :P524_ANO ) ),0) cheques
                            , nvl(( select sum(pgc.valor)
                                    from cheques2pgto pgc
                                    where exists ( select 1
                                                   from cheques2 cc
                                                   where nvl(cc.semfundo,'N') = 'S'
                                                     and cc.emprestimo = 'S'
                                                     and cc.idrepresentante = r.idrepresentante
                                                     and cc.idcheque = pgc.idcheque )
                                      and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from to_date(pgc.datapgto,'DD/MM/RRRR') ) = :P524_ANO ) ),0) pgtoscheques
                            , nvl(( select sum(valor)
                                      from(
                                    select sum(nvl(valor,0)+ nvl(valorjuros,0)) valor
                                      from emprestimos e
                                     where e.idrepresentante = r.idrepresentante
                                       and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from e.data ) = :P524_ANO )
                                    union
                                    select sum(nvl(n.valortotal,0)) valor -- + nvl(n.valorjuros,0)) - nvl(n.valordescontonegociacao,0)) valor --**
                                      from vw_negociacoes_rmc n
                                     where n.idrepresentante = r.idrepresentante
                                       and n.idtiponegociacao = 4
                                       and nvl(n.cancelado,'N') = 'N'
                                       and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from n.data ) = :P524_ANO ))),0) totalemprestimos
                            , nvl(( select sum(valor)
                                     from(
                                   select sum(pe.valorpago) valor
                                     from pagamentosemprestimos pe
                                    where exists ( select 1
                                                   from emprestimos e
                                                   where e.idrepresentante = r.idrepresentante
                                                     and e.idemprestimo    = pe.idemprestimo )
                                      and pe.data <= trunc(sysdate)
                                      and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from pe.data ) = :P524_ANO ) 
                                    union
                                    select sum(nvl(n.valorpago,0)) valor --+ nvl(n.entrada,0)) valor --**
                                      from vw_negociacoes_rmc n
                                     where n.idrepresentante = r.idrepresentante
                                       and n.idtiponegociacao = 4
                                       and nvl(n.cancelado,'N') = 'N'
                                       and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from n.data ) = :P524_ANO ))),0) totalemprestimospago
                            , nvl(( select sum(nv.saldo)
                                    from notasvendas nv
                                    where nv.idrepresentante = r.idrepresentante
                                      and nv.saldo           > 0
                                      and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from nv.datanota ) = :P524_ANO )
                                      and nv.idsituacaocobranca = 70 ),0) debitosromance
                            , nvl(( select sum(df.valoratualizado)
                                    from vw_debitosrepresfavorita df
                                    where df.idrepresentante = r.idrepresentante 
                                      and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from df.datavencimento ) = :P524_ANO ) ),0) debitosfavorita
                            /*, nvl(( select sum(m.valorservico)
                                    from manutencoesrealizadas m
                                    where m.idrepresentante = r.idrepresentante
                                      and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from m.datamanutencao ) = :P524_ANO )
                                      and m.cobrar          = 'S' ) - ( select sum(pm.valorpago)
                                                                        from pagamentosmanutencoes pm
                                                                        where pm.valorpago > 0
                                                                          and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from pm.datapagamento ) = :P524_ANO )
                                                                          and exists ( select 1
                                                                                       from manutencoesrealizadas m
                                                                                       where m.idrepresentante = r.idrepresentante
                                                                                         and m.idmanutencao    = pm.idmanutencao
                                                                                         and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from m.datamanutencao ) = :P524_ANO ) ) ),0) saldomanutencao*/
                            , nvl(( select f.saldo
                                    from fechamentorepresentantes f
                                    where f.idfechamentorepres = ( select max(idfechamentorepres)
                                                                   from fechamentorepresentantes ff
                                                                   where ff.idrepresentante = r.idrepresentante
                                                                     and exists ( select 1
                                                                                  from fechamentossemanais fs
                                                                                  where fs.idfechamento = ff.idfechamento
                                                                                    and fs.concluido    = 'S' ))),0) saldoacerto
                            , nvl(( select sum( ((( nvl(ii.qtd_pp,0)
                                                  + nvl(ii.qtd_p,0)
                                                  + nvl(ii.qtd_m,0)
                                                  + nvl(ii.qtd_g,0)
                                                  + nvl(ii.qtd_gg,0)
                                                  + nvl(ii.qtd_egg,0)
                                                  + nvl(ii.qtd_exgg,0)
                                                  + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.6,1))
                                               - 
                                               ((( nvl(ii.qtd_pp,0) 
                                                  + nvl(ii.qtd_p,0)
                                                  + nvl(ii.qtd_m,0)
                                                  + nvl(ii.qtd_g,0)
                                                  + nvl(ii.qtd_gg,0)
                                                  + nvl(ii.qtd_egg,0)
                                                  + nvl(ii.qtd_exgg,0)
                                                  + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.6,1))*nvl((select c.percpromotor
                                                                                                                             from comissoesfiliais c
                                                                                                                                , fechamentorepresentantes fe
                                                                                                                             where fe.idrepresentante = d.idrepresentante
                                                                                                                               and fe.semana          = d.semana
                                                                                                                               and c.idcomissaofilial = fe.idcomissao
                                                                                                                               and rownum = 1)/100,0.2))
                                    from itensdevolucaorepres ii
                                       , devolucoesrepresentantes d
                                    where ii.origemdefeito = 'R'
                                      and ii.iddefeito         is not null
                                      and ii.idfechamentoreprespago is null
                                      and ii.situacaodefeito is null
                                      and d.iddevolucaorepres = ii.iddevolucaorepres
                                      and d.idrepresentante   = r.idrepresentante 
                                      and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from d.datainclusao ) = :P524_ANO )
                                      and d.idsemana         >= 668 ),0) saldodefeitos
                            , nvl(( select sum(valor)
                                     from(
                                    select sum( nb.valor - nb.valordesconto ) valor
                                      from vw_negociacoesbalanco nb
                                     where nb.idrepresentante = r.idrepresentante
                                       and nb.charcancelado = 'N' 
                                       and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from nb.data ) = :P524_ANO )
                                    union
                                    select sum(nvl(n.valortotal,0)) valor --+ nvl(n.valorjuros,0)) - nvl(n.valordescontonegociacao,0)) valor --**
                                      from vw_negociacoes_rmc n
                                     where n.idrepresentante = r.idrepresentante
                                       and n.idtiponegociacao = 3
                                       and nvl(n.cancelado,'N') = 'N' 
                                       and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from n.data ) = :P524_ANO ))),0) negbalvalor
                            , nvl(( select sum(valor)
                                     from(
                                    select sum(nb.valorpago) valor
                                      from vw_negociacoesbalanco nb
                                     where nb.idrepresentante = r.idrepresentante
                                       and nb.charcancelado = 'N' 
                                       and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from nb.data ) = :P524_ANO ) 
                                    union
                                    select sum(nvl(n.valorpago,0)) valor-- + nvl(n.entrada,0)) valor --**
                                      from vw_negociacoes_rmc n
                                     where n.idrepresentante = r.idrepresentante
                                       and n.idtiponegociacao = 3
                                       and nvl(n.cancelado,'N') = 'N'
                                       and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from n.data ) = :P524_ANO ))) ,0)  negbalpago
                           /* , nvl(( select sum(n.valortotal)
                                    from negociacoes n
                                    where n.idtiponegociacao = 1
                                      and n.idrepresentante = r.idrepresentante 
                                      and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from n.data ) = :P524_ANO ) ),0)  negcarros*/
                             , nvl(( select sum(w.valortotal)
                                     from vw_negociacoes_rmc w 
                                     where w.idtiponegociacao = 1
                                       and w.idrepresentante = r.idrepresentante 
                                       and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from w.data ) = :P524_ANO ) ),0)  negcarros
                             , nvl(( select sum(w.valorpago)-- + nvl(w.entrada,0))
                                     from vw_negociacoes_rmc w 
                                     where w.idtiponegociacao = 1
                                       and w.idrepresentante = r.idrepresentante 
                                       and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from w.data ) = :P524_ANO ) ),0) negcarrospago
                           /* , nvl(( select sum(n.valorpago)
                                    from negociacoes n
                                    where n.idtiponegociacao = 1
                                      and n.idrepresentante = r.idrepresentante 
                                      and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from n.data ) = :P524_ANO ) ),0) negcarrospago*/
                       from representantes r
                       where ( :P524_IDREPRESENTANTE = -1 or r.idrepresentante = :P524_IDREPRESENTANTE )
                         --and r.ativo     = 'S'
                         and r.idgerente = ( select idgerente
                                             from gerentes g
                                             where g.idfilial = :P0_IDFILIAL ) )  r
                    
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P524_IDREPRESENTANTE is not null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1588834902779640947
        }

