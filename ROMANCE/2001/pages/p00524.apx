    region ultimas-cobranças-3 (
        name: Ultimas Cobranças
        type: staticContent
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent6
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P524_IDREPRESENTANTE > 0 
                  and :P524_IDREPRESENTANTE is not null
                ```
        }
    )

    pageItem P524_ANO (
        type: numberField
        label {
            label: Ano
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @filtro-de-distribuidores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 4
        }
        default {
            type: expression
            plsqlExpression: to_char(sysdate,'RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P524_IDREPRESENTANTE (
        type: selectOne
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ' - Buscar Todos - '
                     , -1
                from dual
                union
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' - '||idrepresentante||' ('||decode(ativo,'S','Ativo','N','Inativo')||')' d
                     , idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtro-de-distribuidores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P524_TIPO_PESQUISA (
        type: radioGroup
        label {
            label: Pesquisa Por
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Ano;A,Geral;G
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtro-de-distribuidores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: A
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 40
            region: @filtro-de-distribuidores
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction escolha-de-pesquisa (
        name: Escolha de Pesquisa
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P524_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P524_TIPO_PESQUISA
            value: A
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P524_ANO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P524_ANO
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 524
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 524
                items: {
                    P524_IDREPRESENTANTE: &P524_IDREPRESENTANTE.
                    P524_TIPO_PESQUISA: &P524_TIPO_PESQUISA.
                    P524_ANO: &P524_ANO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: BUSCAR
        }
    )

)

