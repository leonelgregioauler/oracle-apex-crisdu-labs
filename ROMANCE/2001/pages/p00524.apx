    region resumo-das-cobranças (
        name: Resumo das Cobranças
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.totalcobranca "Total Cobrança"
                     , t.vlrcomissao "Total Comissão"
                     , t.totaldepositos "Total em Depósitos"
                     , t.vlrespecie "Total em Espécie"
                     , t.valordevolvidoaorepres "Total Devolvido"
                     , t.totalcomissoesfavoritarepres "Total Comissão Favorita"
                     , t.qtdacertos "Qtd Acertos"
                     , case
                         when totalcobranca > 0 and qtdacertos > 0 then
                           totalcobranca/qtdacertos 
                         else
                           0 
                       end "Ticket Médio"
                from (
                      select nvl(sum(fr.totalcobranca),0) totalcobranca
                           , nvl(sum(fr.vlrcomissao),0) vlrcomissao
                           , nvl(sum(fr.totaldepositos),0) totaldepositos
                           , nvl(sum(fr.vlrespecie),0) vlrespecie
                           , nvl(sum(fr.valordevolvidoaorepres),0) valordevolvidoaorepres
                           , nvl(sum(fr.totalcomissoesfavoritarepres),0) totalcomissoesfavoritarepres
                           , count(fr.idfechamentorepres) qtdacertos
                      from fechamentorepresentantes fr
                      where ( :P524_IDREPRESENTANTE = -1 or fr.idrepresentante = :P524_IDREPRESENTANTE )
                        and fr.idfilial = :P0_IDFILIAL
                        and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from fr.dataacerto ) = :P524_ANO ) ) t
                ```
            pageItemsToSubmit: P524_IDREPRESENTANTE
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
