    region resumo-da-empresa (
        name: Resumo da Empresa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(t.comissaorepres,0) comissaorepres
                     , nvl(t.comissaogerente,0) comissaogerente
                     , nvl(t.vendadiretaromance,0) vendadiretaromance
                     , nvl(t.vendadiretafavorita,0) vendadiretafavorita
                     , nvl(v.saldo,0) saldovendadireta
                from (
                       select sum(f.totalcomissoesrepresentantes) comissaorepres
                            , sum(f.totalcomissaogerente) comissaogerente
                            , sum(f.totalvendadiretafavorita) vendadiretafavorita
                            , sum(f.totalvendasdiretas) vendadiretaromance
                       from fechamentossemanais f
                       where f.idfilial = :P0_IDFILIAL
                         and ( :P524_TIPO_PESQUISA = 'G' or exists ( select 1
                                                                     from semana_dias s
                                                                     where s.idsemana = f.idsemana
                                                                       and s.ano = :P524_ANO ) ) ) t
                   , (
                       select sum(v.saldo) saldo
                       from vendasdiretas v
                       where v.idfilial = :P0_IDFILIAL
                         and ( :P524_TIPO_PESQUISA = 'G' or extract ( year from v.data ) = :P524_ANO ) ) v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent8
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
