        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region balanço-antigo (
        name: Balanço (Antigo)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(sistema.saldo,0) "Saldo Sistema"
                     , nvl(desconto.saldo,0) "Saldo com Desconto 22,5%"
                     , nvl(negociacao.valor,0) "Negociado"
                     , nvl(pago.valor,0) "Negociação Paga"
                from ( select (( comissao.saldo*0.60 ) + semcomissao.saldo) saldo
                       from ( select sum(w.valorfaltadevolver) saldo
                              from vw_balanco_romance_v4_com w
                              where w.idrepresentante = :P524_IDREPRESENTANTE 
                                and w.idgerente = ( select idgerente 
                                                    from gerentes
                                                    where idfilial = :P0_IDFILIAL ) ) comissao
                           , ( select sum(w.valorfaltadevolver) saldo
                               from vw_balanco_romance_v4_sem w
                               where w.idrepresentante = :P524_IDREPRESENTANTE 
                                 and w.idgerente = ( select idgerente 
                                                     from gerentes
                                                     where idfilial = :P0_IDFILIAL ) ) semcomissao ) sistema
                   , ( select ((( comissao.saldo*0.60 ) + semcomissao.saldo)*0.775) saldo
                       from ( select sum(w.valorfaltadevolver) saldo
                              from vw_balanco_romance_v4_com w
                              where w.idrepresentante = :P524_IDREPRESENTANTE 
                                and w.idgerente = ( select idgerente 
                                                    from gerentes
                                                    where idfilial = :P0_IDFILIAL ) ) comissao
                          , ( select sum(w.valorfaltadevolver) saldo
                              from vw_balanco_romance_v4_sem w
                              where w.idrepresentante = :P524_IDREPRESENTANTE 
                                and w.idgerente = ( select idgerente 
                                                    from gerentes
                                                    where idfilial = :P0_IDFILIAL ) ) semcomissao ) desconto
                   , ( select sum(n.valor) valor
                       from vw_negociacoesbalanco n
                       where n.idrepresentante = :P524_IDREPRESENTANTE ) negociacao
                   , ( select sum(pg.valorpago) valor
                       from vw_negociacoesbalanco pg
                       where idrepresentante     = :P524_IDREPRESENTANTE ) pago
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from representantes r
                where r.idrepresentante = :P524_IDREPRESENTANTE
                  and r.idsemanabalanco >= 743
                  and :P524_IDREPRESENTANTE != -1
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 3704152463919193916
        }

