                items: P15_QTD_PP
            }
            execution {
                sequence: 10
            }
        )

    )

    process correção-de-quantidade (
        name: Correção de quantidade
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  viditcarga  number       := :P15_IDITEMCARGAREPRES;
                  vidcarga    number       := :P15_IDCARGAREPRESENTANTE;
                  videstoque  number       := :P15_IDESTOQUEFIL;
                  vquantidade number       := :P15_QUANTIDADE;
                  vcargamais  varchar2(1)  := :P15_CARGAAMAIS;
                  vvalorvenda number(15,2) := :P15_VALORVENDA;
                  vvalorcusto number(15,2) := :P15_VALORCUSTO;
                  vidproduto  number       := :P15_IDPRODUTO;
                  vcomissao   varchar2(1)  := :P15_COMISSAO;
                  vidposto    number       := :P15_IDPOSTOAVANCADO;
                  vtipoestoque varchar2(1) := :P15_ESTOQUEMOVTO;
                  --
                begin
                  --
                  delete itenscargarepresentante i
                  where i.iditemcargarepres = viditcarga;
                  --
                  --
                  if (vquantidade > 0 and v('REQUEST') != 'DELETAR') then
                    --
                    insert into itenscargarepresentante ( iditemcargarepres    , idcargarepresentante   , idestoquefil
                                                        , quantidade           , valorvenda             , valorcusto
                                                        , idproduto            , comissao               , cargaamais
                                                        , idpostoavancado      , estoquemovto )
                    values ( viditcarga         , vidcarga        , videstoque
                           , vquantidade        , vvalorvenda     , vvalorcusto
                           , vidproduto         , vcomissao       , vcargamais 
                           , vidposto           , vtipoestoque    );
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 28550843762271027
        }
    )

    process fetch-row-from-itenscargarepresentante (
        name: Fetch Row from ITENSCARGAREPRESENTANTE
        type: autoRowFetch
        source {
            tableName: ITENSCARGAREPRESENTANTE
            pkColumn: IDITEMCARGAREPRES
            pkItem: P15_IDITEMCARGAREPRES
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 28551608542271028
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 28551244303271027
        }
        serverSideCondition {
            whenButtonPressed: @delete
            type: never
        }
    )

    branch (
        name: Go To Page 13
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 13
                items: {
                    P15_IDITEMCARGAREPRES:
                }
            }
        }
    )

)

