    pageItem P15_IDESTOQUEFIL (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select codigosisdist ||' - '|| initcap(p.nomeproduto)/*||ef.idestoquefilial */ display_value
                     , ef.idestoquefilial return_value
                from produtos      p
                   , estoquefilial ef
                where p.idproduto        = ef.idproduto
                  and ef.idestoquefilial = :P15_IDESTOQUEFIL
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @editar-item-da-carga
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDESTOQUEFIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

