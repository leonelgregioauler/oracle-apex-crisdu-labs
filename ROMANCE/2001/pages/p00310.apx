        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P310_ESTADO (
        type: popupLov
        label {
            label: Estado
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome||' - '||sigla display_value
                  , idestado
                from estados
                where idpais = :P310_PAIS
                order by nome
                ```
        }
        cascadingLov {
            parentItems: P310_PAIS
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P310_PAIS (
        type: radioGroup
        label {
            label: País
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nome)||' - '||sigla
                  , idpais return_value
                from paises
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
