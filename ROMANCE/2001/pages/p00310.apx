    region débitos-por-estado-resumido (
        name: Débitos por Estado Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(1) qtdconsultoras
                     , ( select e.nome||' - '||e.sigla
                         from estados e
                         where e.idestado = c.idestado) estado
                     , sum(n.saldo) valordebito
                from roman.notasvendas n
                   , vendedoras v
                   , pessoas p
                   , cidades c
                where n.idvendedora = v.idvendedora
                  and v.idpessoa = p.idpessoa
                  and n.idsituacaonotavenda = 4
                  and n.saldo > 0
                  and p.idcidade = c.idcidade
                  and exists ( select 1
                               from estados e
                               where e.idestado = c.idestado 
                                 and e.idpais = :P310_PAIS )
                group by c.idestado
                order by 1 desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P310_TIPO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 348653471529394668
        }

