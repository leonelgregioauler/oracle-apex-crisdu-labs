page 310 (
    name: Débitos por Estado
    title: Débitos por Estado
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region débitos-por-estado (
        name: Débitos por Estado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(1) qtdconsultoras
                     , pck_romance.fnc_nomecidade(p.idcidade) cidade
                     , sum(n.saldo) valordebito
                from roman.notasvendas n 
                   , vendedoras v
                   , pessoas p
                where n.idvendedora = v.idvendedora
                  and v.idpessoa = p.idpessoa
                  and n.idsituacaonotavenda = 4
                  and n.saldo > 0
                  and exists ( select 1
                               from cidades c
                               where c.idcidade = p.idcidade
                                 and c.idestado = :P310_ESTADO )
                group by p.idcidade
                order by 1 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P310_TIPO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 348644038512374972
        }

        column CIDADE (
            type: plainText
            heading {
                heading: Cidade
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column QTDCONSULTORAS (
            type: plainText
            heading {
                heading: Quantidade de Consultoras
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column VALORDEBITO (
            type: plainText
            heading {
                heading: Valor de Débitos
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
