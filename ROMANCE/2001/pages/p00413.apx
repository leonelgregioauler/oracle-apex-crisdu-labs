    region produtos (
        name: Produtos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select it.iditeminsumo
                     , it.idinsumo
                     , it.idproduto
                     , pck_romance.fnc_nomeproduto(it.idproduto) produto
                     , it.idestoqueinsumo
                     , it.valor
                     , it.entrada
                     , it.saida
                     , it.venda
                     , case
                         when it.atual < 0 then
                           '<font color="red">'||it.atual||'</font>'
                         when it.atual = 0 then
                           '<font color="blue">'||it.atual||'</font>'
                         when it.atual > 0 then
                           '<font color="green">'||it.atual||'</font>'
                       end atual
                from itensinsumos it
                where it.idinsumo = :P413_IDINSUMO
                order by 3
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent6
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from itensinsumos ii
                where ii.idinsumo = :P413_IDINSUMO
                  and :P413_DATACONFIRMACAO is null
                ```
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

