    process get-pk (
        name: get pk
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P413_IDINSUMO is null then
                        select "SEQ_IDINSUMO".nextval
                          into :P413_IDINSUMO
                          from dual;
                    end if;
                    --
                    :P413_IDFILIAL := :P0_IDFILIAL;
                    --
                    :P413_IDSEMANA := PCK_UTIL.FNC_IDSEMANA(:P413_SEMANA);
                    --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1483775595595286082
        }
        serverSideCondition {
            type: request=Value
            value: COMECAR
        }
    )

