            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript:apex.confirm('Deseja realmente confirmar os Insumos da Semana?', { request:'CONFIRMAR'})"
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where :P413_DATACONFIRMACAO is null
                  and :P413_IDINSUMO is not null
                ```
        }
    )

    button movimentacao-manual (
        buttonName: MOVIMENTACAO_MANUAL
        label: Movimentação Manual
        layout {
            sequence: 10
            region: @ações-dos-produtos
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 411
                items: {
                    P411_IDMOVTOESTOQUEINSUMO:
                    P411_IDFILIAL: &P0_IDFILIAL.
                    P411_IDINSUMO: &P413_IDINSUMO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2519,v('APP_USER')) = 'S'
                ```
        }
    )

