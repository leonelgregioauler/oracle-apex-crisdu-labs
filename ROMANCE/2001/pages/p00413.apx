    region histórico-da-semana-anterior (
        name: Histórico da Semana Anterior
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select it.iditeminsumo
                     , it.idinsumo
                     , it.idproduto
                     , pck_romance.fnc_nomeproduto(it.idproduto) produto
                     , it.idestoqueinsumo
                     , it.valor
                     , it.entrada
                     , it.saida
                     , it.venda
                from itensinsumos it
                   , insumos i
                where i.idinsumo = it.idinsumo
                  and i.idinsumo != :P413_IDINSUMO
                  and i.idsemana = :P413_IDSEMANA -1 
                  and i.idfilial = :P0_IDFILIAL
                order by 3
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Não encontrado controle de Insumos da Semana Anterior.
        }

