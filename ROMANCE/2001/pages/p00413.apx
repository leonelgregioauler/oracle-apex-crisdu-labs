    pageItem P413_SEMANA (
        type: textField
        label {
            label: Semana
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @controle-de-insumos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 10
        }
        source {
            type: databaseColumn
            databaseColumn: SEMANA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vsemana varchar2(20);
                begin
                  --
                  select pck_util.fnc_semanaid(pck_util.fnc_idsemanadata(sysdate)) semana
                  into vsemana
                  from dual;
                  --
                  return vsemana;
                  --
                end;
                ```
        }
        readOnly {
            type: itemIsNotNull
            item: P413_IDINSUMO
        }
        security {
            encryptSessionState: false
        }
    )

