    validation valida-novo-insumo (
        name: Valida novo Insumo
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from insumos i
                               where i.idfilial = :P0_IDFILIAL
                                 and i.semana = :P413_SEMANA )
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Já existe uma movimentação de insumos para esta semana. Se necessário entre em contato com o Suporte de Estoque.
        }
        serverSideCondition {
            type: request=Value
            value: COMECAR
        }
    )

    validation valida-qtd-movimentada (
        name: Valida QTD Movimentada
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @produtos
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_number(:ENTRADA) - ( to_number(:SAIDA) + to_number(:VENDA) )  >= 0
                ```
        }
        error {
            errorMessage: Não é possível realizar esta movimentação maior que o disponível.
            associatedColumn: ATUAL
        }
        serverSideCondition {
            type: request=Value
            value: SALVAR
        }
    )

