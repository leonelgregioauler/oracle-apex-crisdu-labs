    process confirmar-insumo (
        name: Confirmar Insumo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update insumos i
                  set i.dataconfirmacao = sysdate
                    , i.usuarioconfirmou = v('APP_USER')
                  where i.idinsumo = :P413_IDINSUMO;
                  --
                  commit;
                  --
                  pck_estoque.prc_confirmainsumo(pidinsumo => :P413_IDINSUMO,
                                                 pusuario => v('APP_USER') );
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Insumo confirmado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1482778646274386410
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR
        }
    )

