    region relatório-de-pepinos (
        name: Relatório de Pepinos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*FIRST_ROWS(50)*/ r.idpepinosrepresentante
                     , r.idfechamentorepres 
                     , ( select initcap(p.nomepessoa)
                         from pessoas p
                         where p.idpessoa = ( select rr.idpessoa
                                              from representantes rr
                                              where rr.idrepresentante = r.idrepresentante ) ) Representante
                     , r.nrpedido
                     , r.valor
                     , 'Semana:'||( select semana
                                    from fechamentossemanais ff
                                    where ff.idfechamento = ( select idfechamentopontuacao
                                                                from fechamentorepresentantes  f
                                                                where f.idfechamentorepres = r.idfechamentorepres ) ) semana
                     , decode( r.situacao , 'N' , 'Novo'
                                          , 'P' , 'Pago'
                                          , 'D' , 'Devolução de Mercadoria'
                                          , 'C' , 'Enviado para Cobrança' ) situacao
                     , r.nomevendedora "Nome Consultora"
                     , r.observacao
                     , r.cpf
                     , NVL(( select sum(pg.valor) 
                             from pepinosrepresentantes pg
                             where pg.nrpedido = r.nrpedido
                               and pg.idrepresentante = r.idrepresentante
                               and pg.situacao in ( 'P','D') ),0) valorpago /*pago,devolvido*/
                     , r.valor - NVL(( select sum(pg.valor) 
                                       from pepinosrepresentantes pg
                                       where pg.nrpedido = r.nrpedido
                                         and pg.idrepresentante = r.idrepresentante
                                         and pg.situacao in ( 'P','D') ),0) saldo
                     , ( select pck_romance.fnc_retornatelefones( idvendedora )
                         from vendedoras v
                            , pessoas p
                         where v.idpessoa = p.idpessoa
                           and p.cpf = r.cpf ) telefones 
                from pepinosrepresentantes r 
                where/* r.situacao in ('N','C')
                  and*/ ( :P95_IDREPRESENTANTE is null or r.idrepresentante = :P95_IDREPRESENTANTE  )
                  and pck_romance.fnc_filialrepresentante(pidrepresentante => r.idrepresentante) = :P0_IDFILIAL
                  and ( (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S')
                       or r.idfilial = pck_romance.fnc_filialusuario( v('APP_USER')))
                ```
        }
        layout {
            sequence: 10
            parentRegion: @débitos-papel
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        componentAppearance {
            showNullValuesAs: -
