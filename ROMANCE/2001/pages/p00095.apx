page 95 (
    name: Relatório de Débitos
    title: Relatório de Pepinos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region débitos-netbook (
        name: Débitos Netbook
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana
                     , ano
                     , sum(debito) debito
                     , sum(pago) pago
                from ( 
                        select substr(n.semanacobranca,1,2) semana
                             , substr(n.semanacobranca,4,4) ano
                             , sum(n.valortotalvendalqd - ( select sum(p.valorpago)
                                                            from pagamentosnotasvendas p
                                                             where p.idnotavenda = n.idnotavenda )) debito
                             , sum(( select sum(p.valorpago)
                                    from pagamentosnotasvendas p
                                     where p.idnotavenda     = n.idnotavenda
                                       and p.semanacobranca != n.semanacobranca )) pago
                        from notasvendas n
                        where n.idsituacaonotavenda = 4
                          and n.idfilial = :P0_IDFILIAL
                        group by n.semanacobranca
                        union
                        select substr(n.semanacobranca,1,2) semana
                             , substr(n.semanacobranca,4,4) ano
                             , 0
                             , sum(p.valorpago)
                        from pagamentosnotasvendas p
                           , notasvendas n
                        where p.idnotavenda     = n.idnotavenda 
                          and n.idfilial        =  :P0_IDFILIAL
                          and p.semanacobranca != n.semanacobranca 
                        group by n.semanacobranca )
                group by semana
                     , ano
                order by 2 desc, 1 desc
                ```
        }
        layout {
            sequence: 40
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 52
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        messages {
            whenNoDataFound: -
        }
        componentAdvanced {
            stripHtml: true
        }

        column ANO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Ano
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column DEBITO (
            reportColumnQueryId: 3
