    region tipo (
        name: Tipo
        type: staticContent
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
    )

    pageItem P95_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap( p.nomepessoa ) display_value
                     , rr.idrepresentante return_value
                from pessoas p
                   , representantes rr
                where rr.idpessoa        = p.idpessoa
                  and p.ativo = 'S'
                  and rr.idgerente = ( select idgerente
                                       from gerentes g
                                       where idfilial = :P0_IDFILIAL)
                order by 1
                ```
            nullDisplayValue: - Selecionar Todos -
        }
        layout {
            sequence: 10
            region: @débitos-papel
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P95_TIPO (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Papel;P,Netbook resumido por semana;N
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @tipo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: P
        }
        security {
            encryptSessionState: false
        }
    )

    button enviar-pepinos-para-cobrança (
        buttonName: ENVIAR_PEPINOS_PARA_COBRANÇA
        label: Enviar Pepinos Para Cobrança
        layout {
            sequence: 10
            region: @relatório-de-pepinos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 96
                items: {
                    P96_IDREPRESENTANTE: &P95_IDREPRESENTANTE.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo (
        name: tipo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P95_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P95_TIPO
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @débitos-netbook
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: region
                region: @débitos-papel
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @débitos-netbook
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: region
                region: @débitos-papel
            }
            execution {
