            highlight ir-condition (
                name: Dist. com ou  + de 52 semanas
                condition {
                    column: TOTAL_SEMA
                    operator: >=
                    value: 52
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #ED6B6B
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-2 (
                name: Dist. entre 40 a 51 semanas
                condition {
                    column: TOTAL_SEMA
                    operator: between
                    from: 40
                    to: 51
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #EDED80
                }
                execution {
                    sequence: 10
                }
            )

        )

