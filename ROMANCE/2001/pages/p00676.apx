    pageItem P676_ATIVO (
        type: radioGroup
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            nullDisplayValue: Ambos
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P676_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P676_IDFILIAL (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(u.idfilial) display_value
                     , u.idfilial return_value
                from roman.usuariosfiliais u
                where u.usuario = v('APP_USER')
                  and exists( select 1
                                from roman.vw_filiais f
                               where f.idfilial = u.idfilial
                                 and f.tipofilial = 'D'
                                 and f.ativo = 'S')
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P676_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) display_value
                     , r.idrepresentante return_value
                from catal.representantes r
                where r.idgerente = ( select ff.idgerente
                                       from roman.vw_filiais ff
                                       where  ff.idfilial = :P676_IDFILIAL)
                  --and r.ativo = :P676_ATIVO
                order by 1 
                ```
            nullDisplayValue: "- Todos - "
        }
        cascadingLov {
            parentItems: P676_IDFILIAL
            itemsToSubmit: P676_IDREPRESENTANTE
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P676_SEMANAATE (
        type: selectList
        label {
            label: Até:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ss.semanacompleta display_value
                     , ss.idsemana return_value
                from roman.semana_dias ss
                where ss.ano between 2014 and to_number(to_char(sysdate,'yyyy'))
                order by 2 desc
                ```
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P676_SEMANADE (
        type: selectList
        label {
            label: De:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ss.semanacompleta display_value
                     , ss.idsemana return_value
                from roman.semana_dias ss
                where ss.ano between 2014 and to_number(to_char(sysdate,'yyyy'))
                order by 2 desc
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

