    region lista-de-balanços-por-empresa (
        name: Lista de Balanços Por Empresa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rep.empresa                                                   empresa
                     , roman.pck_romance.fnc_nomerepresentante(rep.idrepresentante)  distribuidor
                     , decode(rep.ativo,'S','Ativo','N','Inativo')                   ativo
                     , (select sd.semanacompleta
                          from roman.semana_dias sd
                         where sd.idsemana = rep.semanaparou) semana_parou
                     , catal.pck_util.fnc_semanaid(rep.idsemanabalanco)                    semana
                     , rep.databalancoiniciado                                       data_balanco
                     , ( select catal.pck_util.fnc_semanaid(min(n.idsemanadistribuicao)) 
                           from roman.notasvendas n
                          where idrepresentante  = rep.idrepresentante )              iniciou_em
                     , nfcom.Qtd_pc_Com_comissao
                     , nfcom.valor_Com_comissao
                     , nfsem.Qtd_pc_sem_comissao
                     , nfsem.valor_Sem_comissao
                     , rep.idrepresentante 
                     , (select (x.idsemanafec - xx.idsemanabalanco)
                                  from ( select (max(f.idsemana)) idsemanafec
                                           from roman.fechamentossemanais f
                                          where f.idfilial = rep.idfilial)x
                                     , (select (rt.idsemanabalanco) idsemanabalanco
                                          from catal.representantes rt
                                         where rt.idrepresentante = rep.idrepresentante)xx) total_sema
                from ( select r.idrepresentante
                            , roman.pck_romance.fnc_nomefilial(f.idfilial) empresa
                            , r.ativo
                            , r.semanaparou
                            , r.idsemanabalanco
                            , f.idfilial
                            , r.databalancoiniciado 
                       from catal.representantes r
                          , catal.filiais f
                          , catal.gerentes g
                       where r.idgerente = g.idgerente
                         and g.idfilial = f.idfilial
                         and f.ativo = 'S'
                         and f.tipofilial = 'D'
                          and (:P676_IDFILIAL is null or f.idfilial = :P676_IDFILIAL)
                         and (:P676_ATIVO is null or r.ativo = :P676_ATIVO)
                         and r.idsemanabalanco between :P676_SEMANADE and :P676_SEMANAATE
                         and (:P676_IDREPRESENTANTE is null or r.idrepresentante = :P676_IDREPRESENTANTE)
                    
                    
                    /*select r.idrepresentante
                            , f.nome empresa
                            , r.ativo
                            , r.semanaparou
                            , r.idsemanabalanco
                            , f.idfilial
                            , r.databalancoiniciado 
                       from catal.representantes r
                          , roman.vw_filiais f
                       where r.idgerente = f.idgerente
                         and f.ativo = 'S'
                         and f.tipofilial = 'D'
                         and (:P676_IDFILIAL is null or f.idfilial = :P676_IDFILIAL)
                         and (:P676_ATIVO is null or r.ativo = :P676_ATIVO)
                         and r.idsemanabalanco between :P676_SEMANADE and :P676_SEMANAATE
                         and (:P676_IDREPRESENTANTE is null or r.idrepresentante = :P676_IDREPRESENTANTE)
                       union
                       select r.idrepresentante
                            , f.nome empresa
                            , r.ativo
                            , r.semanaparou
                            , r.idsemanabalanco
                            , f.idfilial
                            , null databalancoiniciado
                       from catal.representantes r
                          , roman.vw_filiais f
                       where r.idgerente = f.idgerente
                         and f.ativo = 'S'
                         and f.tipofilial = 'D'
                         and (:P676_IDFILIAL is null or f.idfilial = :P676_IDFILIAL)
                         and (:P676_ATIVO is null or r.ativo = :P676_ATIVO)
                         and r.idsemanabalanco between :P676_SEMANADE and :P676_SEMANAATE
                         and :P676_IDREPRESENTANTE is null or r.idrepresentante = :P676_IDREPRESENTANTE*/) rep
                       ,(select w.idrepresentante
                              , w.idsemanabalanco
                              , sum(w.faltadevolver)      Qtd_pc_Com_comissao
                              , sum(w.valorfaltadevolver) valor_Com_comissao
                         from roman.vw_balanco_romance_v4_com w
                         Group by w.idrepresentante,
                                    w.idsemanabalanco) nfcom
                        ,(select w.idrepresentante
                               , w.idsemanabalanco
                               , sum(faltadevolver) Qtd_pc_sem_comissao
                               , sum(w.valorfaltadevolver)  valor_Sem_comissao 
                          from roman.vw_balanco_romance_v4_sem w
                          group by w.idrepresentante
                                 , w.idsemanabalanco) nfsem
                where nfcom.idrepresentante = rep.idrepresentante
                  and nfcom.idsemanabalanco = rep.idsemanabalanco
                  and nfsem.idrepresentante = rep.idrepresentante
                  and nfsem.idsemanabalanco = rep.idsemanabalanco
                  and :P676_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
