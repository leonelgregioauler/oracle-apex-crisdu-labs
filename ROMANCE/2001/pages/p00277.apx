    region arquivo-s-anexados (
        name: Arquivo(s) Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDANEXONOTAFISCAL,
                       IDNOTAFISCAL,
                       ATTACH_DATA,
                       ATTACH_MIMETYPE,
                       ATTACH_FILENAME,
                       ATTACH_LAST_UPDATE,
                       ATTACH_CHARSET,
                       round(sys.dbms_lob.getlength(ATTACH_DATA)/1024,2)||' kb' file_length,
                       sys.dbms_lob.getlength(ATTACH_DATA) download,
                       '<a href="javascript: deletaanexo('||IDANEXONOTAFISCAL||')"> Excluir </a>' remover
                  from ANEXOSNOTASFISCAIS
                where IDNOTAFISCAL = :P277_IDNOTAFISCAL
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
