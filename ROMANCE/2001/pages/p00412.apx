page 412 (
    name: Controle de Insumos
    title: Controle de Insumos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region controle-de-insumos (
        name: Controle de Insumos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "IDINSUMO", 
                "USUARIO",
                "DATAINICIO",
                "DATACONFIRMACAO",
                "SEMANA",
                "VALOR",
                "ENTRADA",
                "SAIDA",
                "VENDA",
                "ATUAL",
                "IDSEMANA"
                from "#OWNER#"."INSUMOS" 
                where idfilial = :P0_IDFILIAL
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 413
                items: {
                    P413_IDINSUMO: #IDINSUMO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum controle de Insumo Encontrado.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 4434325622782120929
        }

        column ATUAL (
            type: hidden
            heading {
                heading: Atual
            }
            layout {
                sequence: 9
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
            security {
                escapeSpecialChars: false
            }
        )

        column DATACONFIRMACAO (
            type: plainText
            heading {
                heading: Data Confirmação
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DATAINICIO (
            type: plainText
            heading {
                heading: Iniciado em
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column ENTRADA (
            type: plainText
            heading {
                heading: Qtd Inicial
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column IDINSUMO (
            type: plainText
            heading {
                heading: Cód. Insumo
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDSEMANA (
            type: plainText
            heading {
                heading: ID Semana
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column SAIDA (
            type: plainText
            heading {
                heading: Qtd Consumo Interno
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Criado Por
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column VENDA (
            type: plainText
            heading {
                heading: Qtd Venda
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 14837566 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATACONFIRMACAO (
                sequence: 9
            )

            displayColumn DATAINICIO (
                sequence: 8
            )

            displayColumn ENTRADA (
                sequence: 4
            )

            displayColumn IDINSUMO (
                sequence: 1
            )

            displayColumn IDSEMANA (
                sequence: 10
            )

            displayColumn SAIDA (
                sequence: 5
            )

            displayColumn SEMANA (
                sequence: 2
            )

            displayColumn USUARIO (
                sequence: 7
            )

            displayColumn VALOR (
                sequence: 3
            )

            displayColumn VENDA (
                sequence: 6
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Controle
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-novo-controle (
        name: Valida Novo Controle
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from insumos i
                               where i.idfilial = :P0_IDFILIAL
                                 and i.idsemana = pck_util.fnc_idsemanadata(sysdate) )
                ```
        }
        error {
            errorMessage: Já existe uma movimentação de insumos para esta semana. Se necessário entre em contato com o Suporte de Estoque.
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 413
                items: {
                    P413_IDINSUMO:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)

