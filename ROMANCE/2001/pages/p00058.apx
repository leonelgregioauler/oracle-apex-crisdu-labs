    process fetch-row-from-movimentosestoquevend (
        name: Fetch Row from MOVIMENTOSESTOQUEVEND
        type: autoRowFetch
        source {
            tableName: MOVIMENTOSESTOQUEVEND
            pkColumn: IDMOVTOESTVEND
            pkItem: P58_IDMOVTOESTVEND
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 22295185490906609
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vid number;
                  vidrepres number;
                  vparametro  varchar2(1);
                begin 
                  --
                  select pck_romance.fnc_retornaparametro ( parametro => 'ESTOQUEPORGRADE'
                                                          , pidfilial => :P0_IDFILIAL)
                  into vparametro
                  from dual;
                  --
                  begin
                    select e.idestoquevendedora
                    into :P58_IDESTOQUEVENDEDORA
                    from estoquevendedora e
                    where idvendedora   = :P58_IDVENDEDORA
                      and idestoquefil  = :P58_IDESTOQUEFIL;
                  exception
                    when no_data_found then
                      select seq_idestoquevendedora.nextval
                      into :P58_IDESTOQUEVENDEDORA
                      from dual;
                      --
                      insert into estoquevendedora ( idestoquevendedora, idvendedora, idestoquefil, quantidade )
                      values ( :P58_IDESTOQUEVENDEDORA, :P58_IDVENDEDORA, :P58_IDESTOQUEFIL, 0);      
                      --
                  end;
                  --
                  select seq_idmovtoestoquevendedora.nextval
                  into vid
                  from dual;
                  --
                 -- if vparametro = 'S' then
                    --
                    if to_number(nvl(:P58_QTDVENDA_PP   ,'0')) > 0
                      or to_number(nvl(:P58_QTDVENDA_P  ,'0')) > 0
                      or to_number(nvl(:P58_QTDVENDA_M  ,'0')) > 0
                      or to_number(nvl(:P58_QTDVENDA_G  ,'0')) > 0
                      or to_number(nvl(:P58_QTDVENDA_GG ,'0')) > 0
                      or to_number(nvl(:P58_QTDVENDA_EGG,'0')) > 0
                      or to_number(nvl(:P58_QTDVENDA_U  ,'0')) > 0  
                      or TO_NUMBER(NVL(:P58_QTDVENDA ,'0'))> 0then
                      --
                      insert into movimentosestoquevend ( idmovtoestvend  , idvendedora   , idestoquefil
                                                        , quantidade      , iditnotavenda , observacao
                                                        , usuario         , datamovimento , idestoquevendedora 
                                                        , qtd_pp          , qtd_p         , qtd_m           
                                                        , qtd_g           , qtd_gg        , qtd_egg         
                                                        , qtd_u   )
                      values ( vid                              , :P58_IDVENDEDORA                   , :P58_IDESTOQUEFIL
                             , to_number(:P58_QTDVENDA)*-1      , null                               , 'Venda de Mercadoria. '||:P58_OBSERVACAO
                             , v('APP_USER')                    , sysdate                            , :P58_IDESTOQUEVENDEDORA
                             , to_number(:P58_QTDVENDA_pp)*-1   , to_number(:P58_QTDVENDA_p)*-1      , to_number(:P58_QTDVENDA_m)*-1    
                             , to_number(:P58_QTDVENDA_g)*-1    , to_number(:P58_QTDVENDA_gg)*-1     , to_number(:P58_QTDVENDA_egg )*-1
                             , to_number(:P58_QTDVENDA_u)*-1   );     
                      --
                    end if;
                    --
                    if  TO_NUMBER(NVL(:P58_QTDDEVOL_PP ,'0'))  > 0
                     or TO_NUMBER(NVL(:P58_QTDDEVOL_P  ,'0'))  > 0
                     or TO_NUMBER(NVL(:P58_QTDDEVOL_M  ,'0'))  > 0
                     or TO_NUMBER(NVL(:P58_QTDDEVOL_G  ,'0'))  > 0
                     or TO_NUMBER(NVL(:P58_QTDDEVOL_GG ,'0'))  > 0
                     or TO_NUMBER(NVL(:P58_QTDDEVOL_EGG,'0'))  > 0
                     or TO_NUMBER(NVL(:P58_QTDDEVOL_U  ,'0'))  > 0 
                     or TO_NUMBER(NVL(:P58_QTDDEVOLUCAO  ,'0'))> 0 then
                      --
                      select seq_idmovtoestoquevendedora.nextval
                      into vid
                      from dual;
                      --
                      insert into movimentosestoquevend ( idmovtoestvend  , idvendedora   , idestoquefil
                                                        , quantidade      , iditnotavenda , observacao
                                                        , usuario         , datamovimento , idestoquevendedora 
                                                        , qtd_pp          , qtd_p         , qtd_m           
                                                        , qtd_g           , qtd_gg        , qtd_egg         
                                                        , qtd_u  )
                      values ( vid                                   , :P58_IDVENDEDORA                   , :P58_IDESTOQUEFIL
                             , to_number(:P58_QTDDEVOLUCAO)*-1       , null                               , 'Devoulção de mercadoria. '||:P58_OBSERVACAO
                             , v('APP_USER')                         , sysdate                            , :P58_IDESTOQUEVENDEDORA
                             , to_number(:P58_QTDDEVOL_pp)*-1        , to_number(:P58_QTDDEVOL_p )*-1     , to_number(:P58_QTDDEVOL_m  )*-1         
                             , to_number(:P58_QTDDEVOL_g )*-1        , to_number(:P58_QTDDEVOL_gg)*-1     , to_number(:P58_QTDDEVOL_egg)*-1
                             , to_number(:P58_QTDDEVOL_u )*-1   ); 
                    
                      --
                      select e.idestoquerepresentante
                      into vidrepres
                      from estoquerepresentante e
                      where idrepresentante = :P58_IDREPRESENTANTE
                        and idestoquefil    = :P58_IDESTOQUEFIL;
                      --
                      insert into movimentosestoquerepres ( idmovtoestrepres   , idrepresentante   , idestoquefil
                                                          , quantidade         , iditnotavenda     , observacao
                                                          , usuario            , datamovimento     , idestoquerepresentante
                                                          , idtransfprodrepres 
                                                          , qtd_pp          , qtd_p         , qtd_m           
                                                          , qtd_g           , qtd_gg        , qtd_egg         
                                                          , qtd_u  )
                      values ( seq_idmovtoestoquerepres.nextval  , :P58_IDREPRESENTANTE   , :P58_IDESTOQUEFIL
                             , to_number(:P58_QTDDEVOLUCAO)      , null                   ,  'Devoulção de mercadoria. '||:P58_OBSERVACAO
                             , v('APP_USER')                     , sysdate                , vidrepres
                             , null
                             , to_number(:P58_QTDDEVOL_pp) , to_number(:P58_QTDDEVOL_p ) , to_number(:P58_QTDDEVOL_m  )       
                             , to_number(:P58_QTDDEVOL_g ) , to_number(:P58_QTDDEVOL_gg) , to_number(:P58_QTDDEVOL_egg)
                             , to_number(:P58_QTDDEVOL_u ) ); 
                      --
                    end if;
