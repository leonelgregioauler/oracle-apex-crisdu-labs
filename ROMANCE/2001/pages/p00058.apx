    pageItem P58_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap( nvl(p.apelido,p.nomepessoa ) ) display_value
                     , r.idrepresentante  return_value
                from representantes r
                   , pessoas        p
                   , gerentes       g
                where r.idpessoa  = p.idpessoa
                  and r.idgerente = g.idgerente
                  and g.idfilial  = :P0_IDFILIAL
                  and exists ( select 1 
                               from estoquerepresentante ee
                               where ee.idrepresentante = r.idrepresentante )
                order by 1
                ```
            nullDisplayValue: - Selecione o Representante -
        }
        layout {
            sequence: 20
            region: @saída-de-estoque-cliente
            slot: regionBody
            alignment: left
            columnSpan: 10
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P58_IDVENDEDORA (
        type: selectList
        label {
            label: Cliente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap( nvl(p.apelido,p.nomepessoa ) ) display_value
                     , v.idvendedora  return_value
                from vendedoras     v
                   , pessoas        p
                   , representantes r
                   , gerentes       g
                where v.idpessoa        = p.idpessoa
                  and v.idrepresentante = r.idrepresentante
                  and r.idgerente       = g.idgerente
                  and g.idfilial        = :P0_IDFILIAL
                  and r.idrepresentante = :P58_IDREPRESENTANTE
                  and exists ( select 1 
                               from estoquevendedora ee
                               where ee.idvendedora = v.idvendedora )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione a Vendedora -
        }
        cascadingLov {
            parentItems: P58_IDREPRESENTANTE
        }
        layout {
            sequence: 30
            region: @saída-de-estoque-cliente
