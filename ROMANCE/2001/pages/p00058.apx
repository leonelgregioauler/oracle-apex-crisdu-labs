    pageItem P58_IDESTOQUEFIL (
        type: selectList
        label {
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap( pr.nomeproduto ) || decode(c.descricao, null, '', ' ('||c.descricao||')' ) display_value
                     , e.idestoquefilial   return_value
                from estoquefilial         e
                   , estoquerepresentante  er
                   , produtos              pr
                   , cores                 c
                where e.idproduto        = pr.idproduto
                  and e.idestoquefilial  = er.idestoquefil
                  and er.idrepresentante = :P58_IDREPRESENTANTE
                  and e.idcor            = c.idcor (+)
                 -- and pr.ativo           = 'S'
                  and e.idfilial         = :P0_IDFILIAL
                  AND pr.codigosisdist   = :P58_CODIGO
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P58_CODIGO
        }
        layout {
            sequence: 50
            region: @saída-de-estoque-cliente
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDESTOQUEFIL
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

