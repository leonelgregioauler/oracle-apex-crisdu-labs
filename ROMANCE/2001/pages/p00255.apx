page 255 (
    name: Exportar para Planilha de Distribuição Posto Avançado
    title: Exportar para Planilha de Distribuição Posto Avançado
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region exportar-para-planilha-de-distribuição (
        name: Exportar para Planilha de Distribuição
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select opcao1
                     , codigosisdist
                     , tipoestoque
                     , categoria
                     , produto
                     , estoque
                from (select /*+ rule*/ ee.classificacao1 opcao1
                     , ( select p.codigosisdist from produtos p where ee.idproduto = p.idproduto)  codigosisdist
                     , ee.classificacao2 tipoestoque
                     , ( select c.nome from categorias c where c.idcategoria = ( select p.idcategoria from produtos p where ee.idproduto = p.idproduto) ) categoria
                     , ( select initcap(p.nomeproduto) from produtos p where ee.idproduto = p.idproduto)  produto
                     ,/* (nvl(e.qtd_pp ,0)  - pck_estoque.fnc_estoquereserva_pa(pidestoquefil => e.idestoquefil,ptamanho => 'PP',pidpostoavancado => e.idpostoavancado  ))
                     + (nvl(e.qtd_p  ,0)  - pck_estoque.fnc_estoquereserva_pa(pidestoquefil => e.idestoquefil,ptamanho => 'P',pidpostoavancado => e.idpostoavancado  ))
                     + (nvl(e.qtd_m  ,0)  - pck_estoque.fnc_estoquereserva_pa(pidestoquefil => e.idestoquefil,ptamanho => 'M',pidpostoavancado => e.idpostoavancado  ))
                     + (nvl(e.qtd_g  ,0)  - pck_estoque.fnc_estoquereserva_pa(pidestoquefil => e.idestoquefil,ptamanho => 'G',pidpostoavancado => e.idpostoavancado  ))
                     + (nvl(e.qtd_gg ,0)  - pck_estoque.fnc_estoquereserva_pa(pidestoquefil => e.idestoquefil,ptamanho => 'GG',pidpostoavancado => e.idpostoavancado  ))
                     + (nvl(e.qtd_egg,0)  - pck_estoque.fnc_estoquereserva_pa(pidestoquefil => e.idestoquefil,ptamanho => 'EGG',pidpostoavancado => e.idpostoavancado  ))
                     + (nvl(e.qtd_exgg,0) - pck_estoque.fnc_estoquereserva_pa(pidestoquefil => e.idestoquefil,ptamanho => 'EXGG',pidpostoavancado => e.idpostoavancado  ))
                     +*/ (nvl(e.qtd_u  ,0)  - pck_estoque.fnc_estoquereserva_pa(pidestoquefil => e.idestoquefil,ptamanho => 'U',pidpostoavancado => e.idpostoavancado  ))  estoque
                     , ee.vlrvenda 
                     , decode(ee.comissao,'S','Sim','Não') comissao
                from estoquepostoavancado e
                   , estoquefilial ee
                where e.idestoquefil = ee.idestoquefilial
                  and e.idpostoavancado = :P255_IDPOSTOAVANCADO
                  and ee.idfilial = :P0_IDFILIAL
                  and ee.ativo = 'S'
                order by 5 )
                where estoque > 0
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 100000
        }
        advanced {
            savedReportMappingIdentifier: 46351744475148799
        }

        column CATEGORIA (
            type: plainText
            heading {
                heading: Categoria
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: CATEGORIA
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column CODIGOSISDIST (
            type: plainText
            heading {
                heading: Codigosisdist
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: CODIGOSISDIST
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column ESTOQUE (
            type: plainText
            heading {
                heading: Estoque
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: ESTOQUE
                endUserAlias: F
            }
            enableUsersTo {
                pivot: false
            }
        )

        column OPCAO1 (
            type: plainText
            heading {
                heading: Opcao1
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: OPCAO1
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column PRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: PRODUTO
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column TIPOESTOQUE (
            type: plainText
            heading {
                heading: Tipoestoque
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: TIPOESTOQUE
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 463551 (
            visibility: primaryDefault
            view {
                rowsPerPage: 5000
            }

            displayColumn CATEGORIA (
                sequence: 4
            )

            displayColumn CODIGOSISDIST (
                sequence: 2
            )

            displayColumn ESTOQUE (
                sequence: 6
            )

            displayColumn OPCAO1 (
                sequence: 1
            )

            displayColumn PRODUTO (
                sequence: 5
            )

            displayColumn TIPOESTOQUE (
                sequence: 3
            )

        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
    )

    pageItem P255_IDPOSTOAVANCADO (
        type: radioGroup
        label {
            label: Posto Avançado
            alignment: left
        }
        settings {
            noOfCols: 5
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nome) display_value
                     , idpostoavancado return_value
                from postoavancado 
                where idfilial = :P0_IDFILIAL
                  and ativo = 'S'
                  and ( ( :P0_IDPOSTOAVANCADO is not null and idpostoavancado = :P0_IDPOSTOAVANCADO )
                       or (:P0_IDPOSTOAVANCADO is null ) )
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction filtra-posto (
        name: filtra posto
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P255_IDPOSTOAVANCADO
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

