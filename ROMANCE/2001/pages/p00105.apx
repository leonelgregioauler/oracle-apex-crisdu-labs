            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idaplicacao-must-be-numeric (
        name: IDAPLICACAO must be numeric
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @liberação-de-acessos
            type: columnIsNumeric
            column: IDAPLICACAO
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDAPLICACAO
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idperfil-must-be-numeric (
        name: IDPERFIL must be numeric
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @liberação-de-acessos
            type: columnIsNumeric
            column: IDPERFIL
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDPERFIL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation valida-descrição (
        name: Valida Descrição
        execution {
            sequence: 50
        }
        validation {
            type: itemIsNotNull
            item: P105_DESCRICAO
            alwaysExecute: true
        }
        error {
            errorMessage: Favor Informar uma Descrição!
        }
    )

    process delete-perfil-acesso (
        name: Delete-Perfil-Acesso
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                begin
                  --
                  delete roman.perfilacesso pa
                  where pa.idperfil = :P105_IDPERFIL;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 562370561240727913
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process fetch-row-from-perfil (
        name: Fetch Row from PERFIL
        type: autoRowFetch
        source {
            tableName: PERFIL
            pkColumn: IDPERFIL
            pkItem: P105_IDPERFIL
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 29044457598484648
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P105_IDPERFIL is null then
                        select "#OWNER#"."SEQ_IDPERFIL".nextval
                          into :P105_IDPERFIL
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 29044865016484649
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process libera-acesso (
        name: libera acesso
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                vpedido number;
                begin
                 FOR i IN 1.. HTMLDB_APPLICATION.G_F01.COUNT 
                 loop
                
                    insert into perfilacesso (idperfilacesso, idperfil, idaplicacao)
                    values (seq_idperfilacesso.nextval, :P105_IDPERFIL , HTMLDB_APPLICATION.G_F02(HTMLDB_APPLICATION.G_F01(i)));
                
                  END LOOP;
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 29016792532087581
        }
    )

    process process-row-of-perfil (
        name: Process Row of PERFIL
        type: autoRowProcessing
        target {
            tableName: PERFIL
            pkColumn: IDPERFIL
            pkItem: P105_IDPERFIL
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 29045216397484649
        }
    )

    process reset-page (
        name: reset page
