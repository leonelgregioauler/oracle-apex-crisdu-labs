            type: itemIsNotNull
            item: P105_IDPERFIL
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Liberar Acessos
        layout {
            sequence: 20
            region: @liberação-de-acessos
            slot: topAndBottom
