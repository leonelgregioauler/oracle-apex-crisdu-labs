    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process informa-valores-filtro (
        name: Informa Valores Filtro
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P561_DATAINICIO is null then
                    :P561_DATAINICIO := to_date('01/04/2020','DD/MM/RRRR');
                  end if;
                  --
                  if :P561_DATAFIM is null then
                    :P561_DATAFIM := trunc(sysdate);
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 4539823131245495101
        }
    )

    branch (
        name: Go To Page 561
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 561
                items: {
                    P561_IDFILIAL: &P561_IDFILIAL.
                    P561_IDREPRESENTANTE: &P561_IDREPRESENTANTE.
                    P561_IDVENDEDORA: &P561_IDVENDEDORA.
                    P561_TIPO_PAGAMENTO: &P561_TIPO_PAGAMENTO.
                    P561_STATUS: &P561_STATUS.
                    P561_DATAINICIO: &P561_DATAINICIO.
                    P561_DATAFIM: &P561_DATAFIM.
                    P561_TIPO_DATA: &P561_TIPO_DATA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

