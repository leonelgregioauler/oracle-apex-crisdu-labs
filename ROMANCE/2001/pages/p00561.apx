    region negociações-de-parceiros (
        name: Negociações de Parceiros
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.idnegociacaoparceiro
                     , n.idfilial
                     , n.filial 
                     , n.idrepresentante
                     , n.representante
                     , n.idvendedora
                     , n.vendedora
                     , n.cpf
                     , n.datanegociacao
                     , n.datalimitedeposito
                     , n.valornegociacao
                     , n.formapagamento
                     , n.contabancaria
                     , n.parcelas
                     , n.valorconfirmado
                     , case
                         when n.charformapgto = 'D' then
                           case
                             when exists ( select 1
                                           from depositosnegociacoesparc dn
                                           where dn.idnegociacaoparceiro = n.idnegociacaoparceiro
                                             and dn.datarevisao is not null
                                             and dn.situacao    = 'R') then
                               'Depósito Rejeitado pelo motivo: '||( select observacao 
                                                                     from depositosnegociacoesparc dn
                                                                     where dn.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                       and dn.situacao             = 'R'
                                                                       and rownum = 1 )
                             when exists ( select 1
                                           from depositosnegociacoesparc dn
                                           where dn.idnegociacaoparceiro = n.idnegociacaoparceiro
                                             and dn.datarevisao is not null
                                             and dn.situacao    = 'C' ) then
                               ( select 'Data da baixa: '||to_char(dn.datarevisao,'DD/MM/RRRR HH24:MI:SS')||' - Nr Iden.: '||dn.nroidentificacao_digitado info
                                 from depositosnegociacoesparc dn
                                 where dn.idnegociacaoparceiro = n.idnegociacaoparceiro
                                   and dn.situacao             = 'C'
                                   and dn.datarevisao is not null
                                   and rownum = 1 )
                             when exists ( select 1
                                           from depositosnegociacoesparc dn
                                           where dn.idnegociacaoparceiro = n.idnegociacaoparceiro
                                             and dn.situacao             = 'A'
                                             and dn.datarevisao is null ) then
                               'Pendente de confirmação'
                             else
                               'Depósito não encontrado'
                           end
                         else
                           '-'
                       end deposito
                     , nvl(( select sum(dn.valor_digitado) 
                             from depositosnegociacoesparc dn
                             where dn.idnegociacaoparceiro = n.idnegociacaoparceiro ),0) valor_revisado 
                from vw_negociacoes_realizadas n
                where ( :P561_IDFILIAL is null or n.idfilial = :P561_IDFILIAL )
                  and ( :P561_TIPO_DATA is null
                     or ( :P561_TIPO_DATA = 'N' and trunc(n.datanegociacao) between to_date(:P561_DATAINICIO) and to_date(:P561_DATAFIM) )
                     or ( :P561_TIPO_DATA = 'B' and exists ( select 1
                                                             from pagamentosnegociacoesparceiros pn
                                                             where pn.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                               and trunc(pn.databaixa) between to_date(:P561_DATAINICIO) and to_date(:P561_DATAFIM) ) ) )
                  and ( :P561_IDREPRESENTANTE is null or n.idrepresentante = :P561_IDREPRESENTANTE )
                  and ( :P561_IDVENDEDORA is null or n.idvendedora = :P561_IDVENDEDORA )
                  and ( :P561_TIPO_PAGAMENTO = 'A'
                     or ( :P561_TIPO_PAGAMENTO = 'C' and n.charformapgto = 'C' )
                     or ( :P561_TIPO_PAGAMENTO = 'D' and n.charformapgto = 'D' ) )
                  and ( :P561_STATUS = 'T' 
                     or ( :P561_STATUS = 'C' and n.valorconfirmado >= n.valornegociacao )
                     or ( :P561_STATUS = 'A' and n.valorconfirmado < n.valornegociacao ) )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma negociação encontrada.
        }
        advanced {
            savedReportMappingIdentifier: 26940165551953848
        }

