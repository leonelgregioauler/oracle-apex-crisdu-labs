page 229 (
    name: Lista de ID de Cliente V
    title: Lista de ID de Cliente V
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
    )

    region lista-id-cliente (
        name: Lista ID Cliente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(v.idvendedora) "Vendedora"
                     , idvendedora "ID SITE"
                     , pck_romance.fnc_nomerepresentante(v.idrepresentante) "Representante"
                     , rg.descricao "Região de Venda"
                     , ( select pck_romance.fnc_nomecidade(p.idcidade) 
                         from pessoas p
                         where p.idpessoa = v.idpessoa ) "Cidade"
                from vendedoras v
                   , representantes r
                   , regioesvenda rg
                where v.idrepresentante = r.idrepresentante
                  and v.idregiaovenda   = rg.idregiaovenda
                  and v.idfilial        = :P0_IDFILIAL
                  and v.ativo           = 'S'
                  and ( :P229_IDREPRESENTANTE is null or v.idrepresentante = :P229_IDREPRESENTANTE )
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Não Há Vendedoras cadastradas.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 540563605774166215
        }

        column Cidade (
            type: plainText
            heading {
                heading: Cidade
                alignment: center
            }
            layout {
                sequence: 14
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column "ID SITE" (
            type: plainText
            heading {
                heading: Id Site
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: ID_SITE
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Região de Venda" (
            type: plainText
            heading {
                heading: Região De Venda
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Regiao_de_Venda
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Representante (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Representante
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Vendedora (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Vendedora
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 5405642 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn "Cidade" (
                sequence: 2
            )

            displayColumn "ID SITE" (
                sequence: 3
            )

            displayColumn "Região de Venda" (
                sequence: 5
            )

            displayColumn "Representante" (
                sequence: 4
            )

            displayColumn "Vendedora" (
                sequence: 1
            )

            controlBreak (
                column: "Representante"
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: "Região de Venda"
                layout {
                    sequence: 2
                }
            )

        )

    )

    pageItem P229_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' - '||idrepresentante nome
                     , idrepresentante 
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button p229-filtrar (
        buttonName: P229_FILTRAR
        label: Filtrar
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: P229_FILTRAR
        }
    )

    branch (
        name: filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 229
                items: {
                    P229_IDREPRESENTANTE: &P229_IDREPRESENTANTE.
                }
                successMessage: false
            }
        }
    )

)

