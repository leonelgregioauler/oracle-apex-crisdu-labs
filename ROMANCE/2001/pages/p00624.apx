page 624 (
    name: Débitos Romance de Respon. do Distribuidor
    title: Débitos Romance de Respon. do Distribuidor
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region débitos (
        name: Débitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , pck_romance.fnc_nomevendedora(nv.idvendedora) consultora
                     , nv.numeronota 
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.valortotalnota
                     , nv.valorpago
                     , saldo
                from notasvendas nv
                where nv.idsituacaocobranca = 70
                  and nv.idsituacaonotavenda = 4
                  and nv.saldo > 0
                  and nv.idrepresentante = :P75_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1639377324476187640
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: M
            }
        )

        column IDNOTAVENDA (
            type: link
            heading {
                heading: Ir Para Nota
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 37
                    items: {
                        P37_IDNOTAVENDA: #IDNOTAVENDA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
                linkAttributes: target="_blank"
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: L
            }
        )

        column NUMERONOTA (
            type: plainText
            heading {
                heading: Nr Nota
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: N
            }
        )

        column SALDO (
            type: plainText
            heading {
                heading: Saldo
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: S
            }
        )

        column SEMANACOBRANCA (
            type: plainText
            heading {
                heading: Sem. Cobrança
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: P
            }
        )

        column SEMANADISTRIBUICAO (
            type: plainText
            heading {
                heading: Sem. Distribuição
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: O
            }
        )

        column VALORPAGO (
            type: plainText
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: R
            }
        )

        column VALORTOTALNOTA (
            type: plainText
            heading {
                heading: Total Nota
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: Q
            }
        )

        savedReport 1195708 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONSULTORA (
                sequence: 2
            )

            displayColumn IDNOTAVENDA (
                sequence: 1
            )

            displayColumn NUMERONOTA (
                sequence: 3
            )

            displayColumn SALDO (
                sequence: 8
            )

            displayColumn SEMANACOBRANCA (
                sequence: 5
            )

            displayColumn SEMANADISTRIBUICAO (
                sequence: 4
            )

            displayColumn VALORPAGO (
                sequence: 7
            )

            displayColumn VALORTOTALNOTA (
                sequence: 6
            )

        )

    )

    pageItem P624_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @débitos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

