page 343 (
    name: Controle de Débitos
    title: Controle de Débitos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region débitos-pendentes-na-semana (
        name: Débitos Pendentes na Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select numeronota nrpedido
                     , semanadistribuicao
                     , semanacobranca semana
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) representante
                     , pck_romance.fnc_nomevendedora(n.idvendedora) nomevendedora
                     , n.valortotalvenda valor
                     , n.valorpago valorpago
                     , n.saldo saldo
                     , pck_romance.fnc_nomefilial(idfilial) filial
                     , ( select max(trunc(pn.datapagamento))
                         from pagamentosnotasvendas pn
                         where pn.idnotavenda = n.idnotavenda) ultimopagamento
                     , pck_romance.fnc_cpfvendedora(n.idvendedora) cpf
                     , idnotavenda
                     , idrepresentante 
                     , pck_romance.fnc_retornatelefones( idvendedora ) telefones 
                     , ( select nroconsultaspc
                         from pessoas
                         where idpessoa = ( select idpessoa 
                                             from vendedoras 
                                             where idvendedora = n.idvendedora ) ) "Consulta SPC"
                     , idsemanacobranca
                from notasvendas n
                where saldo > 0
                  and idrepresentante = :P343_IDREPRESENTANTE
                  and ( :P343_TIPOFILTRO is null
                     or ( :P343_TIPOFILTRO = 'S' and n.semanacobranca = :P343_SEMANA )
                     or ( :P343_TIPOFILTRO = 'P' and n.idsemanacobranca between :P343_SEMANAINI and :P343_SEMANAFIM ) )
                order by n.idsemanacobranca desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent8
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2087138563225842986
        }

