    dynamicAction refresh (
        name: refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P343_SEMANA
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P343_SEMANA
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                      vidsemana number;
                      vsemanavolta varchar(10);
                    begin
                      --
                      select pck_util.fnc_idsemana(:P343_SEMANA)
                      into vidsemana
                      from dual;
                      --
                      vidsemana := vidsemana - 6;
                      --
                      select pck_util.fnc_semanaid(vidsemana)
                      into vsemanavolta 
                      from dual;
                      --
                      return vsemanavolta;
                      --
                    end;
                    ```
            }
            affectedElements {
                selectionType: items
                items: P343_SEMANAVOLTA
            }
            execution {
                sequence: 10
            }
        )

    )

