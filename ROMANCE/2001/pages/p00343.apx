    pageItem P343_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes
                                      where idfilial = :P0_IDFILIAL )
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_SEMANA (
        type: textField
        label {
            label: Semana
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_SEMANAFIM (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.semana
                     , f.idsemana
                from fechamentossemanais f
                where f.idfilial = :P0_IDFILIAL
                order by f.idsemana desc
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_SEMANAINI (
        type: selectList
        label {
            label: De
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.semana
                     , f.idsemana
                from fechamentossemanais f
                where f.idfilial = :P0_IDFILIAL
                order by f.idsemana 
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_SEMANAVOLTA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidsemana number;
                  vsemanavolta varchar(10);
                begin
                  --
                  select pck_util.fnc_idsemana(:P343_SEMANA)
                  into vidsemana
                  from dual;
                  --
                  vidsemana := vidsemana - 6;
                  --
                  select pck_util.fnc_semanaid(vidsemana)
                  into vsemanavolta 
                  from dual;
                  --
                  return vsemanavolta;
                  --
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_TIPOFILTRO (
        type: radioGroup
