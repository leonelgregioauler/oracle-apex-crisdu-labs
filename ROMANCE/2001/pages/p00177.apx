page 177 (
    name: Relatório de Vendas
    title: Relatório de Vendas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-de-vendas (
        name: Relatório de Vendas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with filiais_escopo as (
                  -- (Comercial Romance / regional / America Latina / todas / uma especifica).
                  select f.idfilial
                  from roman.vw_filiais_filtro f
                  where f.ref_filial =  :P0_IDFILIAL
                )
                select produto "Produto"
                     , sum(distribuido) "Distribuido"
                     , sum(vendido) "Vendido"
                     , sum(w.valorVendido) "Total Vendido"
                     , round(decode(sum(Vendido)  , 0 , 0
                                                  , ( sum(Vendido) * 100  /  sum(distribuido) )) ,2) "perc Venda"
                from vw_percvendaprodutos_2 w
                   , filiais_escopo         fe
                where w.idfilial = fe.idfilial
                  and ( :P177_IDPRODUTO is null or idestoquefil = :P177_IDPRODUTO)
                  and ( (:P177_TIPO = 'S' and semanacobranca = :P177_SEMANA)
                     or (:P177_TIPO = 'P' and idsemanacobranca between :P177_IDSEMANAINI and :P177_IDSEMANAFIM ) )
                group by produto
                       , w.idfilial
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros utilizados.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 22449520727542920
        }

        column Distribuido (
            type: plainText
            heading {
                heading: Distribuido para Consultora
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: Distribuido
                endUserAlias: G
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Produto (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Produto
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Total Vendido" (
            type: plainText
            heading {
                heading: Total Vendido
                alignment: center
            }
            layout {
                sequence: 17
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column Vendido (
            type: plainText
            heading {
                heading: Vendido
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: Vendido
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "perc Venda" (
            type: plainText
            heading {
                heading: Perc Venda
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: perc_Venda
                endUserAlias: F
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 224512 (
            visibility: primaryDefault
            view {
                rowsPerPage: 500
            }

            displayColumn "Distribuido" (
                sequence: 2
            )

            displayColumn "Produto" (
                sequence: 1
            )

            displayColumn "Total Vendido" (
                sequence: 4
            )

            displayColumn "Vendido" (
                sequence: 3
            )

            displayColumn "perc Venda" (
                sequence: 5
            )

            sort (
                column: "perc Venda"
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            sort (
                column: "Vendido"
                sort {
                    direction: desc
                    sequence: 2
                }
            )

            sort (
                column: "% Venda"
                sort {
                    direction: desc
                    sequence: 3
                }
            )

        )

    )

    pageItem P177_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                with filiais_escopo as (
                  -- (Comercial Romance / regional / America Latina / todas / uma especifica).
                  select f.idfilial
                  from roman.vw_filiais_filtro f
                  where f.ref_filial =  :P0_IDFILIAL
                )
                select pck_romance.fnc_nomeprodutoestoque(e.idestoquefilial)
                     , e.idestoquefilial
                from estoquefilial e
                   , filiais_escopo fe
                where e.idfilial = fe.idfilial
                
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P177_IDSEMANAFIM (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano semana
                     , idsemana 
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-1 and to_char(sysdate,'RRRR')
                order by idsemana desc
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P177_IDSEMANAINI (
        type: selectList
        label {
            label: De
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano semana
                     , idsemana 
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-1 and to_char(sysdate,'RRRR')
                order by idsemana desc
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P177_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                with filiais_escopo as (
                  -- (Comercial Romance / regional / America Latina / todas / uma especifica).
                  select f.idfilial
                  from roman.vw_filiais_filtro f
                  where f.ref_filial =  :P0_IDFILIAL
                )
                select semana display_value
                     , semana RETURN_VALUE
                from ( select distinct fs.semana
                       from fechamentossemanais fs
                          , filiais_escopo      fe
                       where fs.idfilial = fe.idfilial
                       order by to_number(substr(semana,4,4)) desc
                              , to_number(substr(semana,1,2)) desc )
                where rownum < 80
                
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P177_TIPO (
        type: radioGroup
        label {
            label: Filtrar por
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Semana;S,Periodo;P
            displayNullValue: false
        }
        layout {
            sequence: 5
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    button p177-filtrar (
        buttonName: P177_FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: P177_FILTRAR
        }
    )

    dynamicAction filtrar (
        name: filtrar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @p177-filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: filtrar
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction tipo (
        name: tipo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P177_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P177_TIPO
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P177_SEMANA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P177_DTINI
                    P177_DTFIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-3 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P177_IDSEMANAINI
                    P177_IDSEMANAFIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: [
                    P177_DTINI
                    P177_DTFIM
                ]
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value-2 (
            action: setValue
            affectedElements {
                selectionType: items
                items: P177_SEMANA
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P177_SEMANA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P177_DTINI
                    P177_DTFIM
                ]
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

        action native-show-3 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P177_IDSEMANAINI
                    P177_IDSEMANAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        name: FILTRO
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 177
                items: {
                    P177_SEMANA: &P177_SEMANA.
                    P177_IDSEMANAFIM: &P177_IDSEMANAFIM.
                    P177_IDSEMANAINI: &P177_IDSEMANAINI.
                    P177_TIPO: &P177_TIPO.
                    P177_IDPRODUTO: &P177_IDPRODUTO.
                }
                successMessage: false
            }
        }
    )

)

