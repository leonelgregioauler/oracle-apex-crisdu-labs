            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process processo-guias-brindes (
        name: Processo Guias Brindes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  --
                  -- Campanha é obrigatória: evita disparar a geração para todas as campanhas ativas.
                  if :P807_CAMPANHA is null then
                    raise_application_error(-20001, 'Selecione a campanha antes de gerar as guias.');
                  end if;
                  --
                  -- Filial é obrigatória (-1 = Todas as filiais é um valor válido, tratado na procedure).
                  /*if :P807_IDFILIAL is null or :P807_IDFILIAL = - 1 then
                    raise_application_error(-20002, 'Selecione a filial (ou "Todos") antes de gerar as guias.');
                  end if;*/
                  --
                  ROMAN.PCK_CONQUISTOULEVOU.PRC_GERAR_GUIAS_AUTO( pidcampanha => :P807_CAMPANHA,
                                                                  pidfilial   => :P807_IDFILIAL );
                  --
                END;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1803027460142884043
        }
        serverSideCondition {
            whenButtonPressed: @gerar
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 806
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
        }
    )

)

