    region cupons-campanha-não-enviados (
        name: Cupons Campanha Não Enviados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select --apex_item.CHECKBOX2(2, ccp.idconquistoulevoucupom/*||'|'||m.documento*/, null) as check1
                     ccp.idconquistoulevoucupom cupom 
                     , ccp.idvendedora
                     , (select p.nomepessoa from catal.vendedoras v , catal.pessoas p 
                        where p.idpessoa = v.idpessoa 
                          and v.idvendedora = ccp.idvendedora) vendedora
                     , ccp.idfilialretira
                     , (select r.idfilial
                        from catal.vendedoras v
                            ,catal.representantes r
                        where r.idrepresentante = v.idrepresentante
                          and v.idvendedora = ccp.idvendedora) id_franquia
                     , roman.pck_romance.fnc_nomefilial((select r.idfilial
                        from catal.vendedoras v
                            ,catal.representantes r
                        where r.idrepresentante = v.idrepresentante
                          and v.idvendedora = ccp.idvendedora)) franquia
                     , (select case 
                               when TIPOLOJA = 'LF' then
                                 favorita.pck_util_fav.fnc_nomefilialfavorita(ccp.idfilialretira)
                               else
                                 roman.pck_romance.fnc_nomefilial(idfilial)
                               end filialretira
                        from (select r.idfilial
                                   , (select p.valor
                                      from roman.parametros p
                                      where p.nome = 'CONQUISTOULEVOULOJA'
                                        and p.idfilial = r.idfilial) TIPOLOJA
                              from catal.vendedoras v
                                  ,catal.representantes r
                              where r.idrepresentante = v.idrepresentante
                                and v.idvendedora = ccp.idvendedora)) filial_retira
                     , ccp.dataresgate
                     , case 
                         when ccp.situacao = 'F' then 'Falta Estoque' 
                         when ccp.situacao = 'P' then 'Processado' 
                         else  'Criado' end situacao
                from roman.conquistoulevoucupons ccp
                where ccp.dataguia is null
                  and (:P807_IDFILIAL = -1 or ccp.idfilialretira = :P807_IDFILIAL)
                  and ccp.idconquistoulevou = :P807_CAMPANHA
                  and ccp.dataresgate < SYSDATE - 1
                Order by 5,4;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1803026764968884036
        }

