    region geração-de-guias-de-envios-de-brindes (
        name: Geração de Guias de Envios de Brindes
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    pageItem P807_CAMPANHA (
        type: selectList
        label {
            label: Campanha
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecampanha display_value 
                     , c.idconquistoulevou return_value
                from roman.campanhasconquistoulevou c
                where c.idpais = :P807_IDPAIS
                ```
        }
        cascadingLov {
            parentItems: P807_IDPAIS
        }
        layout {
            sequence: 20
            region: @geração-de-guias-de-envios-de-brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P807_IDFILIAL (
        type: selectList
        label {
            label: "Franquia / Loja "
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'FR - '||f.nome
                     , f.idfilial
                from roman.vw_filiais f 
                where f.ididioma = :P807_IDPAIS
                  and f.idfilial  not in (1275,1217,1246)
                  and exists (select 1
                              from roman.conquistoulevoucupons clp 
                              where clp.idfilialretira = f.idfilial
                                and clp.idconquistoulevou = :P807_CAMPANHA
                                and clp.dataguia is null)
                  and exists (select 1 
                              from roman.parametros pr
                              where pr.nome = 'CONQUISTOULEVOULOJA'
                                and pr.idfilial = f.idfilial
                                and pr.valor = 'FR')
                   
                union 
                select 'LF - '||favorita.pck_util_fav.fnc_nomefilialfavorita(af.idfilialfavoritaorigem) 
                     , af.idfilialfavoritaorigem
                from favorita.atendimentosfiliaisrmc af
                   , roman.vw_filiais fx
                where fx.idfilial = af.idfilialdestino
                  and af.principal = 'S'
                  and fx.ididioma = :P807_IDPAIS
                  and exists (select 1
                              from roman.conquistoulevoucupons clp 
                              where clp.idfilialretira = af.idfilialfavoritaorigem
                                and clp.idconquistoulevou = :P807_CAMPANHA
                                and clp.dataguia is null)
                
                union 
                select 'LR - '||f.nome
                     , f.idfilial
                from roman.vw_filiais f 
                where f.ididioma = :P807_IDPAIS
                  and exists (select 1
                              from roman.conquistoulevoucupons clp 
                              where clp.idfilialretira = f.idfilial
                                and clp.idconquistoulevou = :P807_CAMPANHA
                                and clp.dataguia is null)
                  and exists (select 1 
                              from roman.parametros pr
                              where pr.nome = 'CONQUISTOULEVOULOJA'
                                and pr.idfilial = f.idfilial
                                and pr.valor = 'LR')
                union 
                select 'FF - '||f.nome
                     , f.idfilial
                from roman.vw_filiais f 
                where f.ididioma = :P807_IDPAIS
                  and exists (select 1
                              from roman.conquistoulevoucupons clp 
                              where clp.idfilialretira = f.idfilial
                                and clp.idconquistoulevou = :P807_CAMPANHA
                                and clp.dataguia is null)
                  and exists (select 1 
                              from roman.parametros pr
                              where pr.nome = 'CONQUISTOULEVOULOJA'
                                and pr.idfilial = f.idfilial
                                and pr.valor = 'FF')
                
                ```
            nullDisplayValue: --Todos--
            nullReturnValue: -1
        }
        cascadingLov {
            parentItems: [
                P807_CAMPANHA
                P807_IDPAIS
            ]
        }
        layout {
            sequence: 30
            region: @geração-de-guias-de-envios-de-brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALRETIRA
            used: always
        }
        default {
            type: item
            item: P807_IDFILIAL
        }
        comments {
            comments: Traz as franquias ou lojas do pais que exista cupom com data guia nula.
        }
    )

    pageItem P807_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome 
                     , p.idpais
                from catal.paises p
                where exists ( select 1 
                               from roman.campanhasconquistoulevou cp 
                               where cp.idpais = p.idpais)
                ```
        }
        layout {
            sequence: 10
            region: @geração-de-guias-de-envios-de-brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

