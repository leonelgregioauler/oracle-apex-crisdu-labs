page 334 (
    name: Defeitos Detalhados
    title: Defeitos Detalhados
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region defeitos-detalhados (
        name: Defeitos Detalhados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddevolucaorepres
                     , pck_romance.fnc_nomerepresentante(d.idrepresentante) idrepresentante
                     , d.semana
                     , nvl(i.qtd_pp,0) qtd_pp
                     , nvl(i.qtd_p,0) qtd_p
                     , nvl(i.qtd_m,0) qtd_m
                     , nvl(i.qtd_g,0) qtd_g
                     , nvl(i.qtd_gg,0) qtd_gg
                     , nvl(i.qtd_egg,0) qtd_egg
                     , nvl(i.qtd_exgg,0) qtd_exgg
                     , nvl(i.qtd_u,0) qtd_u
                     , pck_romance.fnc_nomeprodutoestoque(i.idestoquefil) Produto
                     --, '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':115:'||v('APP_SESSION')||'::NO::P115_IDDEVOLUCAOREPRES:'||d.iddevolucaorepres,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' verdev
                from devolucoesrepresentantes d 
                   , itensdevolucaorepres i
                where i.iddevolucaorepres = d.iddevolucaorepres
                  and i.iddefeito         = :P334_IDDEFEITO
                  and d.semana            = :P334_SEMANA
                  and d.idfilial          = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 543910508370060117
        }

        column IDDEVOLUCAOREPRES (
            type: plainText
            heading {
                heading: Cod Devolução
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

