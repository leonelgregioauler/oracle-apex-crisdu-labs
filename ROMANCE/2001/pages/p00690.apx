    pageItem P690_NOVA_FRANQUIA (
        type: selectList
        label {
            label: Nova Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct nvl(p.apelido,p.nomepessoa) as display_value
                     , f.idfilial                           as return_value
                  from catal.filiais f
                     , catal.pessoas P
                 where f.idpessoa   = p.idpessoa
                   and f.tipofilial = 'D'
                   and f.ativo = 'S'
                   and f.idfilial not in (select distinct p.idfilial
                                            from roman.parametroscreditos p)
                ```
        }
        layout {
            sequence: 20
            region: @adicionar-franquia
            slot: regionBody
            alignment: left
            columnSpan: 8
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
    )

    pageItem P690_ORIGEM_FRANQUIA (
        type: selectList
        label {
            label: Franquia Origem
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct nvl(pes.apelido,pes.nomepessoa) as display_value
                     , p.idfilial                               as return_value
                  from roman.parametroscreditos p
                     , catal.filiais            f
                     , catal.pessoas            pes
                 where f.idfilial   = p.idfilial
                   and pes.idpessoa = f.idpessoa
                 order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @adicionar-franquia
            slot: regionBody
            alignment: left
            columnSpan: 8
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
    )

