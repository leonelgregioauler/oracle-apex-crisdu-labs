    validation valida-franquia-origem-e-nova-franquia (
        name: VALIDA FRANQUIA ORIGEM E NOVA FRANQUIA
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                
                    /* Obriga informar a franqui origem e destino*/
                    if :P690_ORIGEM_FRANQUIA is null or :P690_NOVA_FRANQUIA is null then
                        apex_error.add_error( p_message          => 'Atenção! É necessário informar tanto a franquia de origem quanto a nova franquia.'
                   				            , p_display_location => apex_error.c_inline_in_notification); 
                
                    end if; 
                    
                    /* Obriga informar a franqui origem e destino*/
                    if :P690_ORIGEM_FRANQUIA is null or :P690_NOVA_FRANQUIA is null then
                        return 'Atenção! É necessário informar tanto a franquia de origem quanto a nova franquia.';
                    end if; 
                    
                    /*Tratamento de erros genericos*/
                exception
                    when others then
                        apex_error.add_error( p_message          => 'Ops! Ocorreu um erro ao tentar adicionar uma nova franquia! '|| SQLERRM || '  (VALIDA FRANQUIA ORIGEM E NOVA FRANQUIA)'
                   				            , p_display_location => apex_error.c_inline_in_notification); 
                end;
                ```
        }
        serverSideCondition {
            type: never
        }
    )

    process grava-nova-franquia (
        name: GRAVA_NOVA_FRANQUIA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                    /* Obriga informar a franqui origem e destino*/
                    if :P690_ORIGEM_FRANQUIA is null or :P690_NOVA_FRANQUIA is null then
                        apex_error.add_error( p_message          => 'Atenção! É necessário informar tanto a franquia de origem quanto a nova franquia.'
                   				            , p_display_location => apex_error.c_inline_in_notification); 
                        return;
                    end if; 
                
                    /* Grava parametros para nova filial*/
                    for vreg in (select *
                                   from roman.parametroscreditos p
                                  where p.idfilial = :P690_ORIGEM_FRANQUIA)
                    loop
                        insert into roman.parametroscreditos( idparametrocredito,
                                                              idfilial,
                                                              parametro,
                                                              sigla,
                                                              valorinicial,
                                                              valorfinal,
                                                              ativo,
                                                              observacao)
                                                      values( roman.seq_idparametrocredito.nextval,
                                                              :P690_NOVA_FRANQUIA,
                                                              vreg.parametro,
                                                              vreg.sigla,
                                                              vreg.valorinicial,
                                                              vreg.valorfinal,
                                                              vreg.ativo,
                                                              vreg.observacao);
                                                          
                    end loop;
                
                    /* Limpa campo nova franqui*/
                    :P690_NOVA_FRANQUIA := null;
                
                    /*Commit dos processos da rotina*/
                    commit;
                
                    /*Tratamento de erros genericos*/
                exception
                    when others then
                        apex_error.add_error( p_message          => 'Ops! Ocorreu um erro ao tentar adicionar uma nova franquia! '|| SQLERRM || '  (GRAVA_NOVA_FRANQUIA)'
                   				            , p_display_location => apex_error.c_inline_in_notification); 
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Nova franquia adicionada com sucesso.
        }
        advanced {
            executionMappingIdentifier: 370059552580365549
        }
        serverSideCondition {
            whenButtonPressed: @adicionar-franquia
        }
    )

