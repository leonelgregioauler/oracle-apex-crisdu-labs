page 590 (
    name: Anexos de Fechamentos
    title: Anexos de Fechamentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-700x
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P590_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos-de-fechamentos (
        name: Anexos de Fechamentos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     , observacao
                     --, '<a href="javascript: fnc_verimg('''||iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' 
                     --, idfechamentorepres||idanexoacerto||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , url_bucket link
                     , dataanexo
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     , '<a href="javascript: fnc_removeanexo('||t.idanexoacerto||','''||t.nomearquivo||''');">Remover</a>' remover
                from anexosacertos t
                where t.idfechamentorepres = :P590_IDFECHAMENTOREPRES
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Nenhum arquivo localizado!
        }

        column DATAANEXO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Data Anexo
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                sortable: false
            }
        )

        column LINK (
            reportColumnQueryId: 3
            derivedColumn: N
            type: link
            heading {
                heading: Link
                alignment: center
            }
            layout {
                sequence: 3
            }
            link {
                target: {
                    type: url
                    url: #LINK#
                }
                linkText: Ver Anexo
                linkAttributes: target="_blank"
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column REMOVER (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Usuario
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P590_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            filenameColumn: NOMEARQUIVO
            fileTypes: image/png,image/jpeg,application/pdf
        }
        layout {
            sequence: 50
            region: @anexos-de-fechamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P590_DATAANEXO (
        type: hidden
        layout {
            sequence: 80
            region: @anexos-de-fechamentos
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATAANEXO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P590_IDANEXOACERTO (
        type: hidden
        layout {
            sequence: 10
            region: @anexos-de-fechamentos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXOACERTO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P590_IDANEXODELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @anexos-de-fechamentos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P590_IDFECHAMENTOREPRES (
        type: displayOnly
        label {
            label: ID Fech.
            alignment: left
        }
        layout {
            sequence: 20
            region: @anexos-de-fechamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTOREPRES
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P590_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @anexos-de-fechamentos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                begin
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  return vidusuario;
                  --
                end;
                  
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P590_NOMEARQUIVO (
        type: hidden
        layout {
            sequence: 40
            region: @anexos-de-fechamentos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P590_OBSERVACAO (
        type: textarea
        label {
            label: Observacao
            alignment: left
        }
        layout {
            sequence: 60
            region: @anexos-de-fechamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
            height: 3
        }
        validation {
            maxLength: 1000
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 10
            region: @anexos-de-fechamentos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where f.concluido = 'N' 
                  and ( exists ( select 1
                               from fechamentorepresentantes ff
                               where ff.idfechamento = f.idfechamento
                                 and ff.idfechamentorepres = :P590_IDFECHAMENTOREPRES )
                    or :P0_IDFECHAMENTO = f.idfechamento )
                  and :P590_IDANEXOACERTO is null
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @anexos-de-fechamentos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P590_IDANEXOACERTO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @anexos-de-fechamentos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 75
                items: {
                    P75_IDFECHAMENTOREPRES: &P590_IDFECHAMENTOREPRES.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation informar-arquivo (
        name: Informar arquivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P590_ARQUIVOTEMP
        }
        error {
            errorMessage: Selecione o arquivo!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_acertos(pidfechamentorepres => :P590_IDFECHAMENTOREPRES);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 81986810384542548
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P590_IDANEXOACERTO := null;
                  pck_anexos.prc_apagaanexo_acertos(pidanexoacerto => :P590_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 81988492320542552
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexosacertos (
        name: Fetch Row from ANEXOSACERTOS
        type: autoRowFetch
        source {
            tableName: ANEXOSACERTOS
            pkColumn: IDANEXOACERTO
            pkItem: P590_IDANEXOACERTO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 81987271584542551
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P590_IDANEXOACERTO is null then
                        select "#OWNER#"."SEQ_IDANEXOACERTO".nextval
                          into :P590_IDANEXOACERTO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 81987616340542552
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexosacertos (
        name: Process Row of ANEXOSACERTOS
        type: autoRowProcessing
        target {
            tableName: ANEXOSACERTOS
            pkColumn: IDANEXOACERTO
            pkItem: P590_IDANEXOACERTO
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada
        }
        advanced {
            executionMappingIdentifier: 81988096937542552
        }
    )

    branch (
        name: 590
        execution {
            sequence: 40
        }
        behavior {
            target: {
                page: 590
                items: {
                    P590_IDANEXOACERTO:
                    P590_IDFECHAMENTOREPRES: &P590_IDFECHAMENTOREPRES.
                }
                clearCache: 328
                action: resetPagination
                successMessage: false
            }
        }
    )

)

