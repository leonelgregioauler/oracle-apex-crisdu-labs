page 439 (
    name: Análise de Atendimento
    title: Análise de Atendimento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region análise-dos-atendimentos (
        name: Análise dos Atendimentos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , 17 tipotarefa
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 3
                  and n.idrepresentante = :P439_IDREPRESENTANTE
                  and (n.idsemanacobranca - n.idsemanadistribuicao) between :P439_QTDSEMANASEMABERTO + 6 and :P439_QTD_ATE+ 6
                  and :P439_FILTROS = 'NA'
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento in ( 26,27,28 )
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , 14 
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P439_IDREPRESENTANTE
                  and ( ( :P439_TIPOSEMANA = 'D' and n.semanadistribuicao = :P439_SEMANA )
                     or ( :P439_TIPOSEMANA = 'C' and n.semanacobranca     = :P439_SEMANA ) )
                  and n.valorpago = 0
                  and n.saldo = 0
                  and :P439_FILTROS = 'DV'
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento in ( 26,27,28 )
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , 16
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P439_IDREPRESENTANTE
                  and ( ( :P439_TIPOSEMANA = 'D' and n.semanadistribuicao = :P439_SEMANA )
                     or ( :P439_TIPOSEMANA = 'C' and n.semanacobranca     = :P439_SEMANA ) )
                  and n.valorpago between 0.01 and to_number(:P439_VALORPAGO)
                  and :P439_FILTROS = 'BP'
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento in ( 26,27,28 )
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , 15
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P439_IDREPRESENTANTE
                  and ( ( :P439_TIPOSEMANA = 'D' and n.semanadistribuicao = :P439_SEMANA )
                     or ( :P439_TIPOSEMANA = 'C' and n.semanacobranca     = :P439_SEMANA ) )
                  and n.saldo > 0
                  and :P439_FILTROS = 'DS'
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento in ( 26,27,28 )
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , 18
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P439_IDREPRESENTANTE
                  and ( ( :P439_TIPOSEMANA = 'D' and n.semanadistribuicao = :P439_SEMANA )
                     or ( :P439_TIPOSEMANA = 'C' and n.semanacobranca     = :P439_SEMANA ) )
                  and n.saldo > 0
                  and n.saldo <= to_number(:P439_VALORSALDO)
                  and :P439_FILTROS = 'SA'
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento in ( 26,27,28 )
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , 19
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P439_IDREPRESENTANTE
                  and ( ( :P439_TIPOSEMANA = 'D' and n.semanadistribuicao = :P439_SEMANA )
                     or ( :P439_TIPOSEMANA = 'C' and n.semanacobranca     = :P439_SEMANA ) )
                  and :P439_FILTROS = 'CA'
                  and v.ativo = 'N'
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento in ( 26,27,28 )
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , 22
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda in ( 3 , 4 )
                  and n.idrepresentante = :P439_IDREPRESENTANTE
                  and ( ( :P439_TIPOSEMANA = 'D' and n.semanadistribuicao = :P439_SEMANA )
                     or ( :P439_TIPOSEMANA = 'C' and n.semanacobranca     = :P439_SEMANA ) )
                  and :P439_FILTROS = 'NI'
                  and ( select count(1)
                        from itensnotavenda it
                        where it.idnotavenda = n.idnotavenda ) = 1
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento in ( 26,27,28 )
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , 26
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P439_IDREPRESENTANTE
                  and ( ( :P439_TIPOSEMANA = 'D' and n.semanadistribuicao = :P439_SEMANA )
                     or ( :P439_TIPOSEMANA = 'C' and n.semanacobranca     = :P439_SEMANA ) )
                  and :P439_FILTROS = 'CN'
                  and ( select count(1)
                        from notasvendas nv
                        where nv.idvendedora = v.idvendedora
                          and nv.idsituacaonotavenda = 4 ) = 1
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento in ( 26,27,28 )
                                     and t.idsituacao in (0,10,20) )
                union
                select n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , ( select nvl(documentoestrangeiro,cpf)
                         from pessoas p
                         where p.idpessoa = v.idpessoa) cpf
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvenda
                     , n.valortotaldevolucao
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , v.idpessoa
                     , null gerartarefa
                     , 27
                from notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsituacaonotavenda = 4
                  and n.idrepresentante = :P439_IDREPRESENTANTE
                  and ( ( :P439_TIPOSEMANA = 'D' and n.semanadistribuicao = :P439_SEMANA )
                     or ( :P439_TIPOSEMANA = 'C' and n.semanacobranca     = :P439_SEMANA ) )
                  and :P439_FILTROS = 'AE'
                  and not exists ( select 1
                                   from favorita.tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and t.idgrupoatendimento in ( 26,27,28 )
                                     and t.idsituacao in (0,10,20) )
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros utilizados!
        }

        column CLIENTE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column CPF (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Documento
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
        )

        column DATANOTA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
        )

        column DISTRIBUIDOR (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

        column GERARTAREFA (
            reportColumnQueryId: 16
            derivedColumn: N
            type: simpleCheckbox
            heading {
                heading: Gerar Tarefa
                alignment: center
            }
            lov {
                checkboxValues: S
            }
            layout {
                sequence: 16
                columnAlignment: center
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from dual
                    where pck_util.fnc_verificaacesso(2514,v('APP_USER')) = 'S'
                    ```
            }
        )

        column IDPESSOA (
            reportColumnQueryId: 15
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 15
            }
        )

        column NUMERONOTA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nr Nota
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
        )

        column REGIAOVENDA (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Região de Venda
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
        )

        column SALDO (
            reportColumnQueryId: 14
            derivedColumn: N
            heading {
                heading: Saldo
                alignment: center
            }
            layout {
                sequence: 14
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

        column SEMANACOBRANCA (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Cobrança
                alignment: center
            }
            layout {
                sequence: 7
            }
        )

        column SEMANADISTRIBUICAO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Distribuição
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
        )

        column TIPOTAREFA (
            reportColumnQueryId: 17
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 17
            }
        )

        column VALORPAGO (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Pago
                alignment: center
            }
            layout {
                sequence: 13
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

        column VALORTOTALDEVOLUCAO (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Devolução
                alignment: center
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

        column VALORTOTALNOTA (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Valor Nota
                alignment: center
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

        column VALORTOTALVENDA (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Valor Venda
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

        column VALORTOTALVENDALQD (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Venda Liq.
                alignment: center
            }
            layout {
                sequence: 12
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P439_ATENDENTE (
        type: selectList
        label {
            label: Atendente a Receber a(s) Tarefa(s)
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeusuario(usuario) display_value
                     , idusuario
                from usuarios u
                where u.ativo = 'S'
                  and exists ( select 1
                               from usuariosgruposatendimento ug
                               where ug.usuario = u.usuario 
                                 and ug.idgrupoatendimento in ( 26,27,28 ) )
                order by 1
                ```
            nullDisplayValue: - Todas Atendentes -
        }
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2514,v('APP_USER')) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P439_FILTROS (
        type: radioGroup
        label {
            label: Filtrar Por
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Notas com Devolução Total;DV,Débitos Deixados na Semana;DS,Valores Baixos de Pagamento;BP,Notas em Aberto;NA,Notas com Débitos;SA,Clientes Inativas da Semana;CA,Notas com 1 Item;NI,Clientes Novas;CN,Acerto Efetuado;AE
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P439_IDFILIALROMANCE (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where exists ( select 1
                               from usuariosfiliais u
                               where u.idfilial = f.idfilial
                                 and u.usuario  = v('APP_USER') )
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P439_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' ('||decode(ativo,'S','ATIVO','INATIVO')||')' display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P439_IDFILIALROMANCE )
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P439_IDFILIALROMANCE
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P439_QTDSEMANASEMABERTO (
        type: numberField
        label {
            label: QTD Semanas em Aberto
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
