page 737 (
    name: Relatorio Metas Romance - Franquias
    title: Relatorio Metas Romance - Franquias
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region ideal-até-o-momento (
        name: Ideal até o momento
        type: chart
        layout {
            sequence: 10
            parentRegion: @totais
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chart {
            type: statusMeterGauge
        }
        title {
            title: Ideal até o momento
        }
        chartLayout {
            maxWidth: 600
        }
        performance {
            lazyLoading: true
        }
        gauge {
            orientation: horizontal
        }
        value {
            position: center
            format: decimal
            formatScaling: million
        }

        series ideal-até-o-momento (
            name: Ideal até o momento
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome
                         , totalcobranca atingido
                         , ideal
                         , 'Ideal: ' || to_char(ideal, '999G999G999G999G990D00') ideal_tooltip
                         , ideal - 100 ideal_abaixo
                         , ideal + 100 ideal_acima
                         , cor_ideal_abaixo
                         , cor_ideal_acima
                    from (
                        select 'Ideal até o momento' nome
                             , trunc(sum(ideal)) ideal
                             , trunc(sum(totalcobranca), 2) totalcobranca
                             , '#ff7755' cor_ideal_abaixo
                             , '#99ff99' cor_ideal_acima
                             
                          from (
                                select  ( nvl(m.desafiocalculadoatual,0) / (select count(*)
                                                                              from roman.semana_dias s
                                                                             where s.cicloromance = :P737_CICLOROMANCE))
                                            * ( case
                                                    when trunc(sysdate) > (select max(dt_fim)
                                                                             from roman.semana_dias
                                                                            where cicloromance = :P737_CICLOROMANCE)
                                                    then
                                                         (select count(*)
                                                            from roman.semana_dias
                                                           where cicloromance = :P737_CICLOROMANCE)
                                                    else
                                                         (select greatest(count(1), 1)
                                                            from roman.semana_dias
                                                           where cicloromance = :P737_CICLOROMANCE
                                                             and dt_fim <= trunc(sysdate))
                                                  end) ideal
                    
                                      , nvl(tf.totalcobranca,0) totalcobranca
                                   from metasdesafiodistribuidores m
                                      , catal.filiais fi
                                      , (select f.idfilial
                                              , fr.idrepresentante
                                              , nvl(sum(fr.totalgeral),0) totalcobranca
                                           from fechamentossemanais f
                                              , fechamentorepresentantes fr
                                          where fr.idfechamento = f.idfechamento
                                            and f.idsemana in (select idsemana
                                                                 from roman.semana_dias 
                                                                where semanacompleta in (select semanacompleta anterior
                                                                                           from roman.semana_dias s
                                                                                          where cicloromance = :P737_CICLOROMANCE) )
                                       group by f.idfilial, fr.idrepresentante ) tf
                                  where m.cicloromance = :P737_CICLOROMANCE
                                    and m.idfilial = fi.idfilial
                                    and m.idfilial = tf.idfilial(+)
                                    and m.idrepresentante = tf.idrepresentante(+)
                                    and m.idfilial = :P737_IDFILIAL
                                    and :P737_PERIODO = 'C'
                                    and m.idrepresentante not in (select idrepresentante
                                                                    from representantes
                                                                   where idpessoa = (select idpessoa
                                                                                       from gerentes
                                                                                      where idfilial = :P0_IDFILIAL) )
                                union all
                    
                                select round(sum(case
                                                    when b.dt_ini <= trunc(sysdate) then 
                                                        b.desafio_semanal
                                                    else 0
                                                  end), 2) ideal
                                     , nvl(sum(b.totalcobranca), 0) totalcobranca
                                 from (
                                    select m.idfilial
                                         , m.idrepresentante
                                         , s.dt_ini
                                         , ( m.desafiocalculadoatual / sc.total_semanas ) desafio_semanal
                                         , nvl(tf.totalcobranca, 0) totalcobranca
                                         , m.mediasemanal
                                      from roman.metasdesafiodistribuidores m
                                         , catal.filiais fi
                                         , roman.semana_dias s
                                         , ( select cicloromance
                                                  , count(*) total_semanas
                                               from roman.semana_dias
                                              group by cicloromance ) sc
                                         , ( select f.idfilial
                                                  , fr.idrepresentante
                                                  , f.idsemana
                                                  , sum(fr.totalgeral) totalcobranca
                                               from roman.fechamentossemanais f
                                                  , roman.fechamentorepresentantes fr
                                                  , roman.semana_dias s
                                              where fr.idfechamento = f.idfechamento
                                                and f.idsemana = s.idsemana
                                                and s.idsemana between :P737_SEMANAINICIAL and :P737_SEMANAFINAL
                                             group by f.idfilial
                                                    , fr.idrepresentante
                                                    , f.idsemana ) tf
                                    where m.idfilial = fi.idfilial
                                    and m.cicloromance = s.cicloromance
                                    and m.cicloromance = sc.cicloromance
                                    and s.idsemana between :P737_SEMANAINICIAL and :P737_SEMANAFINAL
                                    and m.idfilial = tf.idfilial(+)
                                    and m.idrepresentante = tf.idrepresentante(+)
                                    and s.idsemana = tf.idsemana(+)
                                    and m.idfilial = :P737_IDFILIAL
                                    and :P737_PERIODO = 'S'
                                    and m.idrepresentante not in (
                                                                    select r.idrepresentante
                                                                      from catal.representantes r
                                                                     where r.idpessoa in ( select g.idpessoa
                                                                                            from catal.gerentes g
                                                                                           where g.idfilial = :P0_IDFILIAL ) )
                                ) b
                                group by b.idfilial
                                       , b.idrepresentante
                            )
                    )
                    where totalcobranca is not null
                    ```
                pageItemsToSubmit: [
                    P737_CICLOROMANCE
                    P737_REGIONAL
                    P737_SEMANASRESTANTES
                    P737_IDFILIAL
                ]
            }
            columnMapping {
                label: ATINGIDO
                value: ATINGIDO
                maxValue: IDEAL
                customTooltip: IDEAL_TOOLTIP
            }
            thresholds {
                values: &IDEAL_ABAIXO.,&IDEAL_ACIMA.
                colors: &COR_IDEAL_ABAIXO.,&COR_IDEAL_ACIMA.
                display: onIndicator
            }
        )

    )

    region relatorio-de-metas-romance-gestores (
        name: Relatorio de Metas Romance - Gestores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfilial
                     , representante
                     , desafiocalculadoatual
                     , idealateomomento
                     , totalcobranca
                     , previa
                     , realizado as "%Realizado"
                     , case when valorfaltanteporsemana < 0
                            then 0
                            else valorfaltanteporsemana
                       end valorfaltanteporsemana
                     , mediasemanal
                     , case when desafiocalculadoatual = 0 then
                                'WHITE'
                           when SEMREST = 5 and realizado < 16.67 or
                                SEMREST = 4 and realizado < 33.33 or
                                SEMREST = 3 and realizado < 50 or
                                SEMREST = 2 and realizado < 66.67 or
                                SEMREST = 1 and realizado < 83.33 or
                                SEMREST = 0 and realizado < 100 then
                               'RED'
                            else
                              'GREEN'
                       end css_color
                  from (
                       select m.idfilial
                            , m.idrepresentante
                            , favorita.pck_util_fav.fnc_nomerepresentante(m.idrepresentante) representante
                            , m.desafiocalculadoatual desafiocalculadoatual
                            , ( nvl(m.desafiocalculadoatual,0) / (select count(*)
                                                                    from roman.semana_dias s
                                                                   where s.cicloromance = :P737_CICLOROMANCE))
                                * ( case
                                        when trunc(sysdate) > (select max(dt_fim)
                                                                 from roman.semana_dias
                                                                where cicloromance = :P737_CICLOROMANCE)
                                        then
                                             (select count(*)
                                                from roman.semana_dias
                                               where cicloromance = :P737_CICLOROMANCE)
                                        else
                                             (select greatest(count(1), 1)
                                                from roman.semana_dias
                                               where cicloromance = :P737_CICLOROMANCE
                                                 and dt_fim <= trunc(sysdate))
                                      end) idealateomomento
                            , nvl(tf.totalcobranca,0) totalcobranca
                            -- PRÉVIA: cobranca em tempo real da semana aberta atual do representante, restrita ao ciclo selecionado
                            , nvl(
                                ( select sum(p.valorpago)
                                    from pagamentosnotasvendas p
                                   where p.semanacobranca = pv.previasemana
                                     and p.origem        not in ('C','E')
                                     and p.idnotavenda in ( select n.idnotavenda
                                                              from notasvendas n
                                                             where n.idrepresentante = m.idrepresentante
                                                               and nvl(n.tiponota,'R') = 'R'
                                                               and n.idsemanacobranca  = pv.previaidsemana )
                                ) + nvl(
                                ( select sum(p.valorpago)
                                    from pagamentosnotasvendas p
                                   where p.semanacobranca = pv.previasemana
                                     and p.origem        not in ('C','E')
                                     and p.idnotavenda in ( select n.idnotavenda
                                                              from notasvendas n
                                                             where n.idrepresentanteatende = m.idrepresentante
                                                               and n.idsemanacobranca      = pv.previaidsemana
                                                               and nvl(n.tiponota,'R')     = 'R'
                                                               and exists ( select 1
                                                                            from catal.representantes r
                                                                           where r.idrepresentante = n.idrepresentante
                                                                             and r.ativo = 'N'
                                                                             and r.semanaparou < roman.pck_util.fnc_idsemana(psemana => pv.previasemana) ) )
                                ), 0)
                              , 0)
                            + nvl(
                                ( select sum(p.valorpago)
                                    from pagamentosnotasvendas p
                                   where p.semanacobranca = pv.previasemana
                                     and p.origem        = 'R'
                                     and p.idnotavenda in ( select n.idnotavenda
                                                              from notasvendas n
                                                             where n.idrepresentante = m.idrepresentante
                                                               and n.idsemanacobranca != pv.previaidsemana )
                                ), 0)
                            + nvl(
                                ( select sum(p.valorpago)
                                    from pagamentosnotasvendas p
                                   where p.semanacobranca = pv.previasemana
                                     and p.origem        = 'R'
                                     and p.idnotavenda in ( select n.idnotavenda
                                                              from notasvendas n
                                                             where n.idrepresentanteatende = m.idrepresentante
                                                               and n.idsemanacobranca      != pv.previaidsemana
                                                               and exists ( select 1
                                                                            from catal.representantes r
                                                                           where r.idrepresentante = n.idrepresentante
                                                                             and r.ativo           = 'N' ) )
                                ), 0) previa
                            , case
                                when m.desafiocalculadoatual > 0 then
                                    round( (nvl(tf.totalcobranca,0) / m.desafiocalculadoatual) * 100,2)
                                else
                                    0
                                end realizado
                            , case
                                when
                                    (select count(*)
                                       from semana_dias
                                      where cicloromance = :P737_CICLOROMANCE
                                        and dt_fim > trunc(sysdate) ) = 0 then
                                    0
                                 else
                                    (m.desafiocalculadoatual - nvl(tf.totalcobranca,0))  /
                                    (select count(*)
                                       from semana_dias
                                      where cicloromance = :P737_CICLOROMANCE
                                        and dt_fim > trunc(sysdate) )
                                end valorfaltanteporsemana
                            , (select count(*)
                                 from semana_dias
                                where cicloromance = :P737_CICLOROMANCE
                                  and dt_fim > trunc(sysdate)) SEMREST
                            , m.mediasemanal
                         from metasdesafiodistribuidores m
                            , catal.filiais fi
                            , (select f.idfilial
                                    , fr.idrepresentante
                                    , nvl(sum(fr.totalgeral),0) totalcobranca
                                 from fechamentossemanais f
                                    , fechamentorepresentantes fr
                                where fr.idfechamento = f.idfechamento
                                  and f.idsemana in (select idsemana
                                                      from roman.semana_dias
                                                      where semanacompleta in (select semanacompleta anterior
                                                                                 from roman.semana_dias s
                                                                                where cicloromance = :P737_CICLOROMANCE) )
                                group by f.idfilial, fr.idrepresentante ) tf
                            -- >>> pv ajustado: restrito ao ciclo selecionado (:P737_CICLOROMANCE) <<<
                            , (select i.idrepresentante
                                    , i.semana   previasemana
                                    , i.idsemana previaidsemana
                                 from roman.preacertorepresentantes i
                                where i.idsemana >= 615
                                  and i.idsemana in ( select sd.idsemana
                                                        from roman.semana_dias sd
                                                       where sd.cicloromance = :P737_CICLOROMANCE )
                                  and not exists ( select 1
                                                     from roman.impnettoservidor imp
                                                    where imp.idrepresentante = i.idrepresentante
                                                      and imp.semana          = i.semana )
                                  and i.idsemana = ( select max(i2.idsemana)
                                                       from roman.preacertorepresentantes i2
                                                      where i2.idrepresentante = i.idrepresentante
                                                        and i2.idsemana >= 615
                                                        and i2.idsemana in ( select sd2.idsemana
                                                                                from roman.semana_dias sd2
                                                                               where sd2.cicloromance = :P737_CICLOROMANCE )
                                                        and not exists ( select 1
                                                                           from roman.impnettoservidor imp2
                                                                          where imp2.idrepresentante = i2.idrepresentante
                                                                            and imp2.semana          = i2.semana ) )
                              ) pv
                        where m.cicloromance = :P737_CICLOROMANCE
                        and m.idfilial = fi.idfilial
                        and m.idfilial = tf.idfilial(+)
                        and m.idrepresentante = tf.idrepresentante(+)
                        and m.idrepresentante = pv.idrepresentante(+)
                        and m.idfilial = :P737_IDFILIAL
                        and :P737_PERIODO = 'C'
                        and m.idrepresentante not in (select idrepresentante
                                                        from representantes
                                                       where idpessoa = (select idpessoa
                                                                           from gerentes
                                                                          where idfilial = :P0_IDFILIAL) )
                       union all
                
                       select x.idfilial
                            , x.idrepresentante
                            , x.representante
                            , x.desafiocalculadoatual
                            , x.idealateomomento
                            , x.totalcobranca
                            , x.previa
                            , x.realizado as "%Realizado"
                            , case
                                when x.valorfaltanteporsemana < 0 then
                                    0
                                else x.valorfaltanteporsemana
                              end valorfaltanteporsemana
                            , x.semrest
                            , x.mediasemanal
                        from (
                             select b.idfilial
                                  , b.idrepresentante
                                  , favorita.pck_util_fav.fnc_nomerepresentante(b.idrepresentante) representante
                                  , round(sum(b.desafio_semanal), 2) desafiocalculadoatual
                                  , round(sum(case when b.dt_ini <= trunc(sysdate) then b.desafio_semanal else 0 end), 2) idealateomomento
                                  , nvl(sum(b.totalcobranca), 0) totalcobranca
                                  , max(b.previa) previa
                                  , case
                                        when sum(b.desafio_semanal) > 0
                                        then round((nvl(sum(b.totalcobranca), 0) / sum(b.desafio_semanal)) * 100, 2)
                                        else 0
                                    end realizado
                                  , sum(case when b.dt_fim > trunc(sysdate) then 1 else 0 end) semrest
                                  , case
                                        when sum(case when b.dt_fim > trunc(sysdate) then 1 else 0 end) = 0 then 0
                                        else
                                            ( sum(b.desafio_semanal) - nvl(sum(b.totalcobranca), 0) ) / sum(case when b.dt_fim > trunc(sysdate) then 1 else 0 end)
                                    end valorfaltanteporsemana
                                  , max(b.mediasemanal) mediasemanal
                             from (
                                select m.idfilial
                                     , m.idrepresentante
                                     , s.dt_ini
                                     , s.dt_fim
                                     , ( m.desafiocalculadoatual / sc.total_semanas ) desafio_semanal
                                     , nvl(tf.totalcobranca, 0) totalcobranca
                                     -- PRÉVIA: mesma lógica do bloco 'C', restrita ao intervalo de semanas selecionado
                                     , nvl(
                                         ( select sum(p.valorpago)
                                             from pagamentosnotasvendas p
                                            where p.semanacobranca = pv.previasemana
                                              and p.origem        not in ('C','E')
                                              and p.idnotavenda in ( select n.idnotavenda
                                                                       from notasvendas n
                                                                      where n.idrepresentante = m.idrepresentante
                                                                        and nvl(n.tiponota,'R') = 'R'
                                                                        and n.idsemanacobranca  = pv.previaidsemana )
                                         ) + nvl(
                                         ( select sum(p.valorpago)
                                             from roman.pagamentosnotasvendas p
                                            where p.semanacobranca = pv.previasemana
                                              and p.origem        not in ('C','E')
                                              and p.idnotavenda in ( select n.idnotavenda
                                                                       from roman.notasvendas n
                                                                      where n.idrepresentanteatende = m.idrepresentante
                                                                        and n.idsemanacobranca      = pv.previaidsemana
                                                                        and nvl(n.tiponota,'R')     = 'R'
                                                                        and exists ( select 1
                                                                                     from catal.representantes r
                                                                                    where r.idrepresentante = n.idrepresentante
                                                                                      and r.ativo = 'N'
                                                                                      and r.semanaparou < roman.pck_util.fnc_idsemana(psemana => pv.previasemana) ) )
                                         ), 0)
                                       , 0)
                                     + nvl(
                                         ( select sum(p.valorpago)
                                             from pagamentosnotasvendas p
                                            where p.semanacobranca = pv.previasemana
                                              and p.origem        = 'R'
                                              and p.idnotavenda in ( select n.idnotavenda
                                                                       from notasvendas n
                                                                      where n.idrepresentante = m.idrepresentante
                                                                        and n.idsemanacobranca != pv.previaidsemana )
                                         ), 0)
                                     + nvl(
                                         ( select sum(p.valorpago)
                                             from pagamentosnotasvendas p
                                            where p.semanacobranca = pv.previasemana
                                              and p.origem        = 'R'
                                              and p.idnotavenda in ( select n.idnotavenda
                                                                       from notasvendas n
                                                                      where n.idrepresentanteatende = m.idrepresentante
                                                                        and n.idsemanacobranca      != pv.previaidsemana
                                                                        and exists ( select 1
                                                                                     from catal.representantes r
                                                                                    where r.idrepresentante = n.idrepresentante
                                                                                      and r.ativo           = 'N' ) )
                                         ), 0) previa
                                     , m.mediasemanal
                                  from roman.metasdesafiodistribuidores m
                                     , catal.filiais fi
                                     , roman.semana_dias s
                                     , ( select cicloromance
                                              , count(*) total_semanas
                                           from roman.semana_dias
                                          group by cicloromance ) sc
                                     , ( select f.idfilial
                                              , fr.idrepresentante
                                              , f.idsemana
                                              , sum(fr.totalgeral) totalcobranca
                                           from roman.fechamentossemanais f
                                              , roman.fechamentorepresentantes fr
                                              , roman.semana_dias s
                                          where fr.idfechamento = f.idfechamento
                                            and f.idsemana = s.idsemana
                                            and s.idsemana between :P737_SEMANAINICIAL and :P737_SEMANAFINAL
                                         group by f.idfilial
                                                , fr.idrepresentante
                                                , f.idsemana ) tf
                                     -- >>> pv ajustado: restrito ao intervalo de semanas selecionado <<<
                                     , ( select i.idrepresentante
                                              , i.semana   previasemana
                                              , i.idsemana previaidsemana
                                           from roman.preacertorepresentantes i
                                          where i.idsemana >= 615
                                            and i.idsemana between :P737_SEMANAINICIAL and :P737_SEMANAFINAL
                                            and not exists ( select 1
                                                               from roman.impnettoservidor imp
                                                              where imp.idrepresentante = i.idrepresentante
                                                                and imp.semana          = i.semana )
                                            and i.idsemana = ( select max(i2.idsemana)
                                                                 from roman.preacertorepresentantes i2
                                                                where i2.idrepresentante = i.idrepresentante
                                                                  and i2.idsemana >= 615
                                                                  and i2.idsemana between :P737_SEMANAINICIAL and :P737_SEMANAFINAL
                                                                  and not exists ( select 1
                                                                                     from roman.impnettoservidor imp2
                                                                                    where imp2.idrepresentante = i2.idrepresentante
                                                                                      and imp2.semana          = i2.semana ) )
                                       ) pv
                                where m.idfilial = fi.idfilial
                                and m.cicloromance = s.cicloromance
                                and m.cicloromance = sc.cicloromance
                                and s.idsemana between :P737_SEMANAINICIAL and :P737_SEMANAFINAL
                                and m.idfilial = tf.idfilial(+)
                                and m.idrepresentante = tf.idrepresentante(+)
                                and s.idsemana = tf.idsemana(+)
                                and m.idrepresentante = pv.idrepresentante(+)
                                and m.idfilial = :P737_IDFILIAL
                                and :P737_PERIODO = 'S'
                                and m.idrepresentante not in (
                                                                select r.idrepresentante
                                                                  from catal.representantes r
                                                                 where r.idpessoa in ( select g.idpessoa
                                                                                        from catal.gerentes g
                                                                                       where g.idfilial = :P0_IDFILIAL ) )
                            ) b
                            group by b.idfilial
                                   , b.idrepresentante
                        ) x
                    )
                order by 2
                ```
            pageItemsToSubmit: [
                P737_CICLOROMANCE
                P737_SEMANASRESTANTES
                P737_IDFILIAL
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 4869578915120437201
        }

        column %Realizado (
            type: plainText
            heading {
                heading: % Realizado
                alignment: center
            }
            layout {
                sequence: 67
                columnAlignment: center
            }
            appearance {
                formatMask: 999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: V
            }
        )

        column CSS_COLOR (
            type: plainText
            heading {
                heading: Css Color
                alignment: center
            }
            layout {
                sequence: 77
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: W
            }
        )

        column DESAFIOCALCULADOATUAL (
            type: plainText
            heading {
