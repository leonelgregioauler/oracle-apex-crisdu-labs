    pageItem P737_SEMANAFINAL (
        type: selectList
        label {
            label: Semana Final
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT SEMANACOMPLETA D
                     , IDSEMANA R
                  FROM (
                        SELECT distinct s.semanacompleta
                                      , s.idsemana
                          FROM semana_dias s
                             , metasdesafioromance m
                         WHERE s.cicloromance = m.cicloromance
                           AND s.ano = :P737_ANO
                           AND m.idfilial = :P737_IDFILIAL
                           AND s.idsemana between (SELECT idsemana FROM semana_dias WHERE idsemana = :P737_SEMANAINICIAL) and (SELECT max(idsemana) FROM semana_dias WHERE dt_ini < trunc(sysdate))
                           AND s.cicloromance is not null
                           AND m.datacongelado is not null ) sd
                 ORDER BY idsemana
                ```
        }
        cascadingLov {
            parentItems: [
                P737_ANO
                P737_IDFILIAL
                P737_SEMANAINICIAL
