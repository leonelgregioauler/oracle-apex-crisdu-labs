        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                     select to_char(sum( m.desafiocalculadoatual),'999G999G999G999G990D00')  totaldesafio
                          , to_char(nvl(round(( sum(tf.totalcobranca /* * fi.fatorconversao*/ ) / sum(m.desafiocalculadoatual)) * 100,2),0),'999G990D00') percrealizado
                          , to_char(sum(m.desafiocalculadoatual) - nvl(sum(tf.totalcobranca /* * fi.fatorconversao*/ ),0),'999G999G999G999G990D00')  valorfaltante
                          , to_char(nvl(sum(tf.totalcobranca /* * fi.fatorconversao*/ ),0),'999G999G999G999G990D00')  totalrealizado
                       from metasdesafiodistribuidores m
                          , catal.filiais fi
                          , ( select f.idfilial
                                   , fr.idrepresentante
                                   , nvl(sum(fr.totalgeral),0) totalcobranca
                                from fechamentossemanais f
                                   , fechamentorepresentantes fr
                               where fr.idfechamento = f.idfechamento
                                 and f.idsemana in (select idsemana
                                                    from roman.semana_dias 
                                                    where semanacompleta in (select semanacompleta anterior
                                                                             from roman.semana_dias s
                                                                             where cicloromance = :P737_CICLOROMANCE) )
                               group by f.idfilial, fr.idrepresentante ) tf
                      where m.cicloromance = :P737_CICLOROMANCE
                        and m.idfilial = fi.idfilial
                        and m.idfilial = tf.idfilial(+)
                        and m.idrepresentante = tf.idrepresentante(+)
                        and m.idfilial = :P737_IDFILIAL
                    ```
                itemsToSubmit: P737_CICLOROMANCE
            }
            affectedElements {
                selectionType: items
                items: [
                    P737_TOTALDESAFIODIST
                    P737_PERCREALIZADO
                    P737_VALORFALTANTE
                    P737_REALIZADO
                ]
            }
            execution {
                sequence: 30
            }
        )

