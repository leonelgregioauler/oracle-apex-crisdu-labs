    dynamicAction carrega-regional-do-gestor (
        name: Carrega Regional do Gestor
        execution {
            sequence: 70
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select f.regional
                  from filiais f
                     , gerentes g
                     , usuarios u
                  where g.idpessoa = u.idpessoa
                  and f.idfilial = g.idfilial
                  and u.usuario = v('APP_USER')
                ```
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select f.regional
                      from filiais f
                         , gerentes g
                         , usuarios u
                      where g.idpessoa = u.idpessoa
                      and f.idfilial = g.idfilial
                      and u.usuario = v('APP_USER')
                    ```
                itemsToSubmit: P737_REGIONAL
            }
            affectedElements {
                selectionType: items
                items: P737_REGIONAL
            }
            execution {
                sequence: 20
            }
        )

    )

