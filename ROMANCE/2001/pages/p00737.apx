    pageItem P737_ANO (
        type: selectList
        label {
            label: Ano
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ANO D
                     , ANO R
                  FROM ( 
                        SELECT EXTRACT(YEAR FROM SYSDATE)  ANO FROM DUAL 
                        UNION
                        SELECT EXTRACT(YEAR FROM SYSDATE)-1  ANO FROM DUAL 
                        UNION
                        SELECT EXTRACT(YEAR FROM SYSDATE) + 1
                          FROM DUAL
                         WHERE EXTRACT(MONTH FROM SYSDATE) > 10  )
                 ORDER BY 1
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P737_CICLOROMANCE (
        type: selectList
        label {
            label: Ciclo Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CICLOROMANCE || ' - De   ' ||
                       (select semanacompleta semanaini
                          from semana_dias 
                         where idsemana = (select min(idsemana)
                                             from semana_dias
                                            where cicloromance = sd.cicloromance)) 
                       || ' Até ' ||
                       (select semanacompleta semanaini
                          from semana_dias 
                         where idsemana = (select max(idsemana)
                                             from semana_dias
                                            where cicloromance = sd.cicloromance))   D
                     --
                     , CICLOROMANCE R
                  FROM (
                        SELECT distinct s.cicloromance
                          FROM semana_dias s
                             , metasdesafiodistribuidores m
                         WHERE s.cicloromance is not null
                           AND s.cicloromance = m.cicloromance
                           AND m.datacongelado is not null
                           AND s.ano = :P737_ANO ) sd
                     
                 ORDER BY to_number(substr(cicloromance,4,4)), 
                           to_number(substr(cicloromance,1,2))
                ```
        }
        cascadingLov {
            parentItems: [
                P737_ANO
                P737_IDFILIAL
            ]
            itemsToSubmit: [
                P737_ANO
                P737_CICLOROMANCE
            ]
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P737_IDFILIAL (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH usuario_id AS (
                    -- Calcula o ID do usuário uma única vez
                    SELECT favorita.pck_util_fav.fnc_idusuario(v('APP_USER')) AS id_usuario
                      FROM dual
                ),
                base_filiais AS (
                    -- Base comum reutilizada em todos os UNIONs
                    SELECT f.idfilial
                         , initcap(nvl(p.apelido, p.nomepessoa)) AS display_value
                         , f.regional
                         , f.pertencecomercialromance
                         , f.ididioma
                    FROM   filiais  f
                    JOIN   pessoas  p ON p.idpessoa = f.idpessoa
                    WHERE  f.tipofilial = 'D'
                      AND  f.ativo      = 'S'
                )
                -- Gerente da filial
                SELECT bf.display_value
                     , bf.idfilial
                FROM   base_filiais bf
                WHERE  EXISTS (
                           SELECT 1
                           FROM   gerentes  g
                           JOIN   usuarios  u ON u.idpessoa = g.idpessoa
                           WHERE  g.idfilial = bf.idfilial
                             AND  u.usuario  = v('APP_USER')
                       )
                
                UNION
                
                -- Regional 7: usuáriosfiliais
                SELECT bf.display_value
                     , bf.idfilial
                FROM   base_filiais bf
                WHERE  :P737_REGIONAL = 7
                  AND  EXISTS (
                           SELECT 1
                           FROM   usuariosfiliais  uf
                           JOIN   usuarios         u  ON u.usuario  = uf.usuario
                           JOIN   gerentes         g  ON g.idpessoa = u.idpessoa
                           WHERE  uf.idfilial = bf.idfilial
                             AND  u.usuario   = v('APP_USER')
                       )
                
                UNION
                
                -- Comercial Romance
                SELECT bf.display_value
                     , bf.idfilial
                FROM   base_filiais bf
                     , usuario_id   ui
                WHERE  bf.pertencecomercialromance = 'S'
                  AND  (   favorita.pck_util_fav.fnc_verificagrupoatendimento(58, ui.id_usuario) = 'S'
                        OR favorita.pck_util_fav.fnc_verificagrupoatendimento(0,  ui.id_usuario) = 'S')
                
                UNION
                
                -- Regionais 1–5
                SELECT bf.display_value
                     , bf.idfilial
                FROM   base_filiais bf
                     , usuario_id   ui
                WHERE  (bf.regional = 1 AND favorita.pck_util_fav.fnc_verificagrupoatendimento(90, ui.id_usuario) = 'S')
                    OR (bf.regional = 2 AND favorita.pck_util_fav.fnc_verificagrupoatendimento(91, ui.id_usuario) = 'S')
                    OR (bf.regional = 3 AND favorita.pck_util_fav.fnc_verificagrupoatendimento(92, ui.id_usuario) = 'S')
                    OR (bf.regional = 4 AND favorita.pck_util_fav.fnc_verificagrupoatendimento(93, ui.id_usuario) = 'S')
                    OR (bf.regional = 5 AND favorita.pck_util_fav.fnc_verificagrupoatendimento(94, ui.id_usuario) = 'S')
                    OR favorita.pck_util_fav.fnc_verificagrupoatendimento(0, ui.id_usuario) = 'S'  -- labs (acesso total)
                
                UNION
                
                -- Comércio Exportação
                SELECT bf.display_value
                     , bf.idfilial
                FROM   base_filiais bf
                     , usuario_id   ui
                WHERE  bf.ididioma > 1
                  AND  ( exists (select 1
                        from usuarios u
                        join gerentes ge on u.idgerente = ge.idgerente
                        where u.idusuario = ui.id_usuario
                          and ge.idfilial = 1086
                          and rownum = 1)  -- correção do parêntese
                        OR favorita.pck_util_fav.fnc_verificagrupoatendimento(0, ui.id_usuario) = 'S')
                
                ORDER BY 1;
                ```
            nullDisplayValue: -- Selecionar --
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

