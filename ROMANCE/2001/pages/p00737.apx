    dynamicAction seta-valores (
        name: "Seta Valores "
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P737_SEMANAFINAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: NULL;
                itemsToSubmit: P737_SEMANASRESTANTES
            }
            execution {
                sequence: 70
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: P737_SEMANAFINAL
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ideal-até-o-momento
            }
            execution {
                sequence: 100
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @relatorio-de-metas-romance-gestores
            }
            execution {
                sequence: 90
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                     select to_char(sum(m.desafiocalculadoatual / sc.total_semanas_ciclo) * sp.total_semanas_periodo_selecionado, '999G999G999G999G990D00')
                       from metasdesafioromance m
                          , ( select distinct cicloromance
                                from semana_dias
                               where idsemana between :P737_SEMANAINICIAL and :P737_SEMANAFINAL ) s
                          , ( select count(1) total_semanas_ciclo
                                from semana_dias
                               where cicloromance in (select cicloromance from semana_dias where idsemana between :P737_SEMANAINICIAL and :P737_SEMANAFINAL) ) sc
                          , ( select count(*) total_semanas_periodo_selecionado
                                from roman.semana_dias
                                where idsemana between :P737_SEMANAINICIAL and :P737_SEMANAFINAL) sp
                          , catal.filiais fi
                      where m.cicloromance = s.cicloromance
                        and m.idfilial = fi.idfilial
                        and m.idfilial = :P737_IDFILIAL
                    group by sp.total_semanas_periodo_selecionado
                    ```
                itemsToSubmit: [
                    P737_IDFILIAL
                    P737_SEMANAINICIAL
                    P737_SEMANAFINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P737_TOTALDESAFIOFRAN
            }
            execution {
                sequence: 50
            }
        )

        action set-value (
            name: Set Value
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(totaldesafio, '999G999G999G999G990D00') totaldesafio
                         , to_char((totalrealizado / totaldesafio) * 100, '999G990D00') percrealizado
                         , to_char(valorfaltante, '999G999G999G999G990D00') valorfaltante
                         , to_char(totalrealizado,'999G999G999G999G990D00') totalrealizado
                    from (
                    select sum(totaldesafio) totaldesafio
                         , sum(valorfaltante) valorfaltante
                         , sum(totalrealizado) totalrealizado
                    from (
                        select sum(m.desafiocalculadoatual) / sc.total_semanas totaldesafio
                                --
                             , case when sum(m.desafiocalculadoatual) > 0 
                                     then round((nvl(sum(tf.totalcobranca),0) / sum(m.desafiocalculadoatual)) * sc.total_semanas * 100,2)
                                     else 0
                                end percrealizado
                                --
                              , (sum(m.desafiocalculadoatual) / sc.total_semanas) - nvl(sum(tf.totalcobranca),0) valorfaltante
                                --
                              , nvl(sum(tf.totalcobranca),0) totalrealizado
                                --
                           from metasdesafiodistribuidores m
                              , catal.filiais fi
                             , roman.semana_dias s
                             , ( select cicloromance
                                      , count(*) total_semanas
                                   from roman.semana_dias
                                  group by cicloromance ) sc
                             , ( select f.idfilial
                                      , fr.idrepresentante
                                      , f.idsemana
                                      , sum(fr.totalgeral) totalcobranca
                                   from roman.fechamentossemanais f
                                      , roman.fechamentorepresentantes fr
                                      , roman.semana_dias s
                                  where fr.idfechamento = f.idfechamento
                                    and f.idsemana = s.idsemana
                                    and s.idsemana between :P737_SEMANAINICIAL and :P737_SEMANAFINAL
                                 group by f.idfilial
                                        , fr.idrepresentante
                                        , f.idsemana ) tf
                          where m.idfilial = fi.idfilial
                            and m.cicloromance = s.cicloromance
                            and m.cicloromance = sc.cicloromance
                            and s.idsemana between :P737_SEMANAINICIAL and :P737_SEMANAFINAL
                            and m.idfilial = tf.idfilial(+)
                            and m.idrepresentante = tf.idrepresentante(+)
                            and s.idsemana = tf.idsemana(+)
                            and m.idfilial = :P737_IDFILIAL
                            and :P737_PERIODO = 'S'
                            and m.idrepresentante not in (
                                                            select r.idrepresentante
                                                              from catal.representantes r
                                                             where r.idpessoa in ( select g.idpessoa
                                                                                    from catal.gerentes g
                                                                                   where g.idfilial = :P0_IDFILIAL ) )
                          group by sc.total_semanas
                    )
                    )
                    ```
                itemsToSubmit: [
                    P737_SEMANAINICIAL
                    P737_SEMANAFINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: [
                    P737_TOTALDESAFIODIST
                    P737_PERCREALIZADO
                    P737_VALORFALTANTE
                    P737_REALIZADO
                ]
            }
            execution {
                sequence: 30
            }
        )

        action set-value-2 (
            name: Set Value
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select count(*)
                      from semana_dias 
                     where idsemana between :P737_SEMANAINICIAL and :P737_SEMANAFINAL
                       and dt_fim > trunc(sysdate)
                    ```
                itemsToSubmit: [
                    P737_SEMANAINICIAL
                    P737_SEMANAFINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P737_SEMANASRESTANTES
            }
            execution {
                sequence: 40
            }
        )

    )

