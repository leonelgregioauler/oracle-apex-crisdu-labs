    button cancel (
        buttonName: CANCEL
        label: Fechar e Atualizar Carga
        layout {
            sequence: 20
            region: @correções-de-carga
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Corrigir
        layout {
            sequence: 10
            region: @correções-de-carga
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P143_IDCORRECAOCARGAREPRES
        }
    )

    button insert (
        buttonName: INSERT
        label: Excluir
        layout {
            sequence: 30
            region: @correções-de-carga
            slot: bottom
            horizontalAlignment: left
