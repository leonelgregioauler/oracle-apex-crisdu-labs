page 143 (
    name: Correções de Carga
    title: Correções de Carga
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_keypress(kcode)
            {
             var tecla = kcode;// event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            // console.log (tecla);
             if (tecla==13) 
             {
              var answer = confirm("Confirma inclusão do item na carga?");
              if (answer)
              {
                v = 'S';
                  void(0);
                apex.submit('CREATE');
              }
                 
             // apex.confirm("Confirma inclusão do item na carga?", {
             //                                    request:"CREATE"
             //                                  });
              //pause;
             } 
              else 
              { if([190,188,110,194].indexOf(tecla) !=-1) 
                {
                 alert('Informe uma Quantidade Válida!'); 
                 return false;
                }
              }
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region correções-de-carga (
        name: Correções de Carga
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    pageItem P143_IDCORRECAOCARGAREPRES (
        type: hidden
        layout {
            sequence: 10
            region: @correções-de-carga
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCORRECAOCARGAREPRES
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P143_IDITEMCARGAREPRES (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @correções-de-carga
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDITEMCARGAREPRES
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P143_IDPOSTOAVANCADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @correções-de-carga
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 1
                from roman.itenscargarepresentante a
                   , roman.postoavancado p
                where a.idpostoavancado = p.idpostoavancado
                  and p.ativo = 'S'
                  and a.idpostoavancado is not null
                  and a.iditemcargarepres = :P143_IDITEMCARGAREPRES
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P143_PRODUTO (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto) produto
                            , e.idestoquefilial
                from estoquefilial  e
                   , produtos       p
                where e.idproduto    = p.idproduto
                  and e.idestoquefilial =  ( select idestoquefil
                                             from itenscargarepresentante i 
                                             where i.iditemcargarepres =:P143_IDITEMCARGAREPRES )
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @correções-de-carga
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

