        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction se-é-posto-avançado (
        name: Se é posto avançado
        execution {
            sequence: 40
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P143_IDPOSTOAVANCADO
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P143_QTD_DIST_PP
                    P143_QTD_DIST_P
                    P143_QTD_DIST_M
                    P143_QTD_DIST_G
                    P143_QTD_DIST_GG
                    P143_QTD_DIST_EGG
                    P143_QTD_DIST_EXGG
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P143_QTD_DIST_U
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction seta-foco-pp (
        name: Seta Foco PP
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: item=value
            item: P0_ESTOQUEPORGRADE
            value: S
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P143_QTD_DIST_PP
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction seta-foco-u (
        name: Seta Foco U
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: item=value
            item: P0_ESTOQUEPORGRADE
            value: N
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P143_QTD_DIST_U
            }
            execution {
                sequence: 10
            }
        )

    )

    validation validar-quantidade-negativa (
        name: Validar quantidade negativa
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(nvl(:P143_QTD_DIST_PP  ,'0')) < 0
                   or to_number(nvl(:P143_QTD_DIST_P   ,'0')) < 0
                   or to_number(nvl(:P143_QTD_DIST_M   ,'0')) < 0
                   or to_number(nvl(:P143_QTD_DIST_G   ,'0')) < 0
                   or to_number(nvl(:P143_QTD_DIST_GG  ,'0')) < 0
                   or to_number(nvl(:P143_QTD_DIST_EGG ,'0')) < 0
                   or to_number(nvl(:P143_QTD_DIST_ExGG,'0')) < 0
                   or to_number(nvl(:P143_QTD_DIST_U   ,'0')) < 0
                ```
        }
        error {
            errorMessage: Informe uma quantidade válida!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation validar-quantidade-nula (
        name: Validar quantidade nula
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where :P143_QTD_DIST_PP is null
                  and :P143_QTD_DIST_P  is null
                  and :P143_QTD_DIST_M  is null
                  and :P143_QTD_DIST_G  is null
                  and :P143_QTD_DIST_GG is null
                  and :P143_QTD_DIST_EGG is null
                  and :P143_QTD_DIST_EXGG is null
                  and :P143_QTD_DIST_U is null
                ```
        }
        error {
            errorMessage: Informe uma quantidade!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process fetch-row-from-correcoescargarepres (
        name: Fetch Row from CORRECOESCARGAREPRES
        type: autoRowFetch
        source {
            tableName: CORRECOESCARGAREPRES
            pkColumn: IDCORRECAOCARGAREPRES
            pkItem: P143_IDCORRECAOCARGAREPRES
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 28581837561348984
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P143_IDCORRECAOCARGAREPRES is null then
                        select "SEQ_IDCORRECAOCARGAREPRES".nextval
                          into :P143_IDCORRECAOCARGAREPRES
                          from dual;
                    end if;
                  IF v('REQUEST') = 'INSERT' THEN
                    :P143_QTD_DIST_PP  := 0;
                    :P143_QTD_DIST_P  := 0;
                    :P143_QTD_DIST_M  := 0;
                    :P143_QTD_DIST_G  := 0;
                    :P143_QTD_DIST_GG  := 0;
                    :P143_QTD_DIST_EGG := 0;
                    :P143_QTD_DIST_EXGG  := 0;
                    :P143_QTD_DIST_U  := 0; 
                  end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 28582206154348985
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') IN ('CREATE','INSERT')
                ```
        }
    )

    process process-row-of-correcoescargarepres (
        name: Process Row of CORRECOESCARGAREPRES
        type: autoRowProcessing
        target {
            tableName: CORRECOESCARGAREPRES
            pkColumn: IDCORRECAOCARGAREPRES
            pkItem: P143_IDCORRECAOCARGAREPRES
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 28582617039348985
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 28583039794348986
        }
    )

    branch (
        name: Go To Page 13
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 13
                items: {
                    P143_IDITEMCARGAREPRES:
                }
            }
        }
    )

)

