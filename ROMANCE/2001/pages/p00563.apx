page 563 (
    name: Históricos eventos
    title: Históricos eventos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1000
        height: 600
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region históricos-de-eventos (
        name: Históricos de eventos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.idchamado
                     , h.idhistoricochamado
                     , h.datahistorico
                     , h.descricao
                     , h.usuario
                     , h.datafim
                     , pck_util.fnc_tempodecorrido( h.tempodecorrido , 'H' ) tempodecorrido
                from historicochamados h
                   , chamados c
                where h.idchamado = c.idchamado
                  and h.idchamado = :P563_IDCHAMADO
                   or h.idhistoricochamado is null
                order by h.datahistorico asc;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 27165786075447415
        }

        column DATAFIM (
            type: plainText
            heading {
                heading: Data fim
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
        )

        column DATAHISTORICO (
            type: plainText
            heading {
                heading: Data histórico
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDCHAMADO (
            type: plainText
            heading {
                heading: ID chamado
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDHISTORICOCHAMADO (
            type: hidden
            heading {
                heading: Idhistoricochamado
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column TEMPODECORRIDO (
            type: plainText
            heading {
                heading: Tempo decorrido
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 314867 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAFIM (
                sequence: 6
            )

            displayColumn DATAHISTORICO (
                sequence: 3
            )

            displayColumn DESCRICAO (
                sequence: 4
            )

            displayColumn IDCHAMADO (
                sequence: 2
            )

            displayColumn IDHISTORICOCHAMADO (
                sequence: 1
            )

            displayColumn TEMPODECORRIDO (
                sequence: 7
            )

            displayColumn USUARIO (
                sequence: 5
            )

        )

    )

    pageItem P563_IDCHAMADO (
        type: hidden
        layout {
            sequence: 10
            region: @históricos-de-eventos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

