page 150 (
    name: Relatório de Pepinos Pagos
    title: Relatório de Pepinos Pagos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 5
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
    )

    region relatório-de-pepinos (
        name: Relatório de Pepinos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.idpepinosrepresentante
                     , r.idfechamentorepres 
                     , r.nrpedido
                     , r.valor
                     , ( select initcap(p.nomepessoa)
                         from pessoas p
                         where p.idpessoa = ( select rr.idpessoa
                                              from representantes rr
                                              where rr.idrepresentante = r.idrepresentante ) ) Representante
                     , 'Semana:'||r.semana semana
                     , decode(r.situacao,'N','Novo','P','Pago', 'D', 'Mercadoria Devolvida') situacao
                     , 'Semana: '||r.semanapago semanapago
                     , r.observacao
                     , r.nomevendedora
                from pepinosrepresentantes r
                where r.situacao = 'P'
                  and ( :P150_IDREPRESENTANTE is null or r.idrepresentante = :P150_IDREPRESENTANTE  )
                  and pck_romance.fnc_filialrepresentante(pidrepresentante => r.idrepresentante) = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            savePublicReport: true
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column IDFECHAMENTOREPRES (
            type: plainText
            heading {
                heading: Idfechamentorepres
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDFECHAMENTOREPRES
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDPEPINOSREPRESENTANTE (
            type: plainText
            heading {
                heading: Idpepinosrepresentante
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDPEPINOSREPRESENTANTE
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column NOMEVENDEDORA (
            type: plainText
            heading {
                heading: Vendedora
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: NOMEVENDEDORA
                endUserAlias: J
            }
            enableUsersTo {
                pivot: false
            }
        )

        column NRPEDIDO (
            type: plainText
            heading {
                heading: Nr Pedido
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: NRPEDIDO
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: OBSERVACAO
                endUserAlias: H
            }
            enableUsersTo {
                pivot: false
            }
        )

        column REPRESENTANTE (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 11
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: REPRESENTANTE
                endUserAlias: K
            }
            enableUsersTo {
                pivot: false
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: 00"/"0000
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: SEMANA
                endUserAlias: F
            }
            enableUsersTo {
                pivot: false
            }
        )

        column SEMANAPAGO (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 9
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: SEMANAPAGO
                endUserAlias: I
            }
            enableUsersTo {
                pivot: false
            }
        )

        column SITUACAO (
            type: plainText
            heading {
                heading: Situação
                alignment: center
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: SITUACAO
                endUserAlias: G
            }
            enableUsersTo {
                pivot: false
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: VALOR
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 3068109 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn NRPEDIDO (
                sequence: 2
            )

            displayColumn OBSERVACAO (
                sequence: 6
            )

            displayColumn REPRESENTANTE (
                sequence: 1
            )

            displayColumn SALDO (
                sequence: 9
            )

            displayColumn SEMANA (
                sequence: 3
            )

            displayColumn SITUACAO (
                sequence: 5
            )

            displayColumn VALOR (
                sequence: 7
            )

            displayColumn VALORPAGO (
                sequence: 8
            )

            displayColumn "Vendedora" (
                sequence: 4
            )

            sort (
                column: SEMANA
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: VALOR
            )

            aggregate (
                column: VALORPAGO
            )

            aggregate (
                column: SALDO
            )

            aggregate (
                function: count
                column: NRPEDIDO
            )

        )

    )

    pageItem P150_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap( p.nomepessoa ) display_value
                     , rr.idrepresentante return_value
                from pessoas p
                   , representantes rr
                where rr.idpessoa        = p.idpessoa
                  and p.ativo = 'S'
                  and rr.idgerente = ( select idgerente
                                       from gerentes g
                                       where idfilial = :P0_IDFILIAL)
                order by 1
                ```
            nullDisplayValue: - Selecionar Todos -
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

)

