    pageItem P415_FILTROPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
            initialFetch: onUserRequest
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select (p.codigosisdist ||' - '|| pck_romance.fnc_nomeproduto(p.idproduto))  display_value
                     , p.idproduto return_value
                from produtos p
                where p.idcategoria != 141
                  and p.ativo = 'S'
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
