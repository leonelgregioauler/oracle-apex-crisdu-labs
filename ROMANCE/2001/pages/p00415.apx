page 415 (
    name: Distribuição de Produtos
    title: Distribuição de Produtos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region distribuição-de-produtos (
        name: Distribuição de Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ FIRST_ROWS(50) */ p.idproduto
                     , codigosisdist 
                     , ( select c.nome from categorias c where c.idcategoria = p.idproduto ) categoria
                     , initcap(p.nomeproduto) produto
                     , 'Valor Venda: '||trim(to_char(e.vlrvenda,'999G990D00'))||' Qtd '||( pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'PP')
                                                                                         + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'P')
                                                                                         + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'M')
                                                                                         + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'G')
                                                                                         + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'GG')
                                                                                         + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'EGG')
                                                                                         + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'EXGG')
                                                                                         + pck_estoque.fnc_estoquedisponivel(e.idestoquefilial,'U')) DETALHE
                     , ( select count(1) 
                         from roman.fotosprodutos f
                         where f.idproduto = p.idproduto ) "Qtd Fotos"
                     , initcap(usuariocadastrou) as "Usuário Cadastrou"
                     , p.dtinclusao datacadastro
                     , ( select count(1)
                         from itensnotavenda i
                            , notasvendas n
                         where n.idnotavenda = i.idnotavenda
                           and n.idsituacaonotavenda = 3
                           and i.idestoquefil = e.idestoquefilial )  qtdconsultoras
                     , ( select sum(i.quantidade)
                         from itensnotavenda i
                            , notasvendas n
                         where n.idnotavenda = i.idnotavenda
                           and n.idsituacaonotavenda = 3
                           and i.idestoquefil = e.idestoquefilial )  qtditens
                from produtos p
                   , estoquefilial e
                where e.idproduto = p.idproduto
                  and e.idfilial = :P0_IDFILIAL
                  and p.idcategoria != 141
                  and ( :P415_POSSUIFOTOS is null
                       or ( :P415_POSSUIFOTOS = 'S' and exists ( select 1
                                                                 from fotosprodutos f
                                                                 where f.idproduto = p.idproduto ) ) 
                       or ( :P415_POSSUIFOTOS = 'N' and not exists ( select 1
                                                                     from fotosprodutos f
                                                                     where f.idproduto = p.idproduto ) ) )
                  and ( :P415_MOSTRARTODOS = 'S' 
                     or ( :P415_MOSTRARTODOS = 'N' and ( p.idproduto = :P415_FILTROPRODUTO 
                                                     or ( p.codigosisdist = :P415_FILTROREF ) ) ) )
                order by 6
                ```
            pageItemsToSubmit: [
                P415_FILTROPRODUTO
                P415_TIPOPESQUISA
                P415_FILTROREF
                P415_FILTRONOME
                P415_MOSTRARTODOS
                P415_POSSUIFOTOS
            ]
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
