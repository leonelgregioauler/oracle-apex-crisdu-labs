page 2 (
    name: Distribuição
    title: Distribuição
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region estoque (
        name: Estoque
        type: list
        source {
            list: @estoque-distribuição-d
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--4cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

    region por-categoria-est-disponível (
        name: Por Categoria - Est. Disponível
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select id
                    , display_value
                    , return_value
                from (
                select null id
                     , ( select c.nome
                         from categorias c 
                         where c.idcategoria = p.idcategoria) display_value
                     , sum(pck_estoque.fnc_esttotalDISPfilial(e.idestoquefilial)) return_value
                from estoquefilial e
                   , produtos p
                where e.idproduto = p.idproduto
                  and e.idfilial = :P0_IDFILIAL
                group by p.idcategoria
                order by 3 desc)
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        settings {
            labelColumn: DISPLAY_VALUE
            valueColumn: RETURN_VALUE
        }
    )

    region top-5-produto-em-estoque (
        name: Top 5 Produto em Estoque
        type: plugin/d3BarChart
        source {
            sqlQuery:
                ```sql
                select id
                    , display_value
                    , return_value
                from (
                select null id
                     , pck_romance.fnc_nomeproduto(idproduto) display_value
                     , sum(pck_estoque.fnc_esttotalDISPfilial(e.idestoquefilial)) return_value
                from estoquefilial e
                where idfilial = :P0_IDFILIAL
                group by idproduto
                order by 3 desc)
                where rownum <=5
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        settings {
            xValuesColumn: DISPLAY_VALUE
            yValuesColumn: RETURN_VALUE
            seriesName: Top 5
            valueFormatMask: attributeValue
            tooltips: showYValue
            colorScheme: modern2
        }
    )

)

