page 567 (
    name: "Negociações Cobraki "
    title: "Negociações Cobraki "
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region negociações-realizadas-cobraki (
        name: Negociações Realizadas Cobraki
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.idnegociacaoparceiro
                     , n.idrepresentante
                     , n.representante
                     , n.idvendedora
                     , n.vendedora
                     , n.cpf
                     , n.datanegociacao
                     , n.datalimitedeposito
                     , n.valornegociacao
                     , nvl(n.valornegociacao * f.fatorconversao, 0) convernegociacao
                     , n.formapagamento
                     , n.parcelas
                     , n.valorconfirmado
                     , nvl(n.valorconfirmado * f.fatorconversao, 0) converconfirmado
                     , n.contabancaria
                     , case
                         when n.charformapgto = 'D' then
                           nvl( ( select 'Recebido'
                                  from dual
                                  where exists ( select 1
                                                 from depositosnegociacoesparc d
                                                 where d.idnegociacaoparceiro = n.idnegociacaoparceiro ) ),'Não Recebido')
                         else
                           'Sem Necessidade'
                       end comprovante
                     , idnegociacaoparceiro id
                     , decode(campanhaespecial,'S','Sim','N','Não') "Campanha?"
                from roman.vw_negociacoes_realizadas n
                   , roman.vw_filiais f
                where n.idfilial = f.idfilial
                  and n.idfilial = :P0_IDFILIAL 
                  and n.origem = 'C'
                  and (:P567_TIPO_DATA is null
                   or (:P567_TIPO_DATA = 'N' and trunc(n.datanegociacao) between to_date(:P567_DATAINICIO) and to_date(:P567_DATAFIM))
                   or (:P567_TIPO_DATA = 'V' and exists ( select 1
                                                          from pagamentosnegociacoesparceiros pp
                                                          where pp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                            and trunc(pp.datavencimento) between to_date(:P567_DATAINICIO) and to_date(:P567_DATAFIM ) ) )
                   or ( :P567_TIPO_DATA = 'P' and exists ( select 1
                                                           from roman.pagamentosnegociacoesparceiros pp
                                                           where pp.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                             and trunc(pp.databaixa) between to_date(:P567_DATAINICIO) and to_date(:P567_DATAFIM ) ) ) )
                  and ( :P567_IDREPRESENTANTE is null or n.idrepresentante = :P567_IDREPRESENTANTE )
                  and ( :P567_IDVENDEDORA is null or n.idvendedora = :P567_IDVENDEDORA )
                  and ( :P567_TIPO_PAGAMENTO = 'A'  or n.charformapgto = :P567_TIPO_PAGAMENTO )
                  and ( :P567_STATUS = 'T' 
                     or ( :P567_STATUS = 'C' and n.valorconfirmado = n.valornegociacao )
                     or ( :P567_STATUS = 'A' and n.valorconfirmado != n.valornegociacao ) )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma negociação encontrada.
        }
        advanced {
            savedReportMappingIdentifier: 60774613350883029
        }

