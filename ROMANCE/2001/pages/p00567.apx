    pageItem P567_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) nome
                     , idrepresentante
                from representantes r
                where r.ativo = 'S'
                  and r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P0_IDFILIAL
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P567_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' CPF: '||p.cpf||' DOC: '||p.documentoestrangeiro d
                     , v.idvendedora r
                from pessoas p
                   , vendedoras v
                where v.idpessoa = p.idpessoa 
                  and v.idfilial = :P0_IDFILIAL
                  and ( :P567_IDREPRESENTANTE is null or v.idrepresentante = :P567_IDREPRESENTANTE )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P567_IDREPRESENTANTE
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

