        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 567
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 567
                items: {
                    P567_IDREPRESENTANTE: &P567_IDREPRESENTANTE.
                    P567_IDVENDEDORA: &P567_IDVENDEDORA.
                    P567_TIPO_PAGAMENTO: &P567_TIPO_PAGAMENTO.
                    P567_STATUS: &P567_STATUS.
                    P567_DATAINICIO: &P567_DATAINICIO.
                    P567_DATAFIM: &P567_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

