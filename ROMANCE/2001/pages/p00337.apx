        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 9371124 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn QTDACERTADAS (
                sequence: 4
            )

            displayColumn QTDDEBITOPENDENTE (
                sequence: 14
            )

            displayColumn QTDDEBITOSRECEBIDOS (
                sequence: 16
            )

            displayColumn QTDDEVOLUCAOTOTAL (
                sequence: 8
            )

            displayColumn QTDDEVOLUCAOZERADA (
                sequence: 6
            )

            displayColumn QTDNOVAS (
                sequence: 3
            )

            displayColumn QTDPAGAMENTOTOTAL (
                sequence: 10
            )

            displayColumn QTDPAGASMENOSQUE50 (
                sequence: 12
            )

            displayColumn REPRESENTANTE (
                sequence: 1
            )

            displayColumn SEMANACOBRANCA (
                sequence: 2
            )

            displayColumn TOTALACERTADAS (
                sequence: 5
            )

            displayColumn TOTALDEBITOPENDENTE (
                sequence: 15
            )

            displayColumn TOTALDEBITOSRECEBIDOS (
                sequence: 17
            )

            displayColumn TOTALDEVOLUCAOTOTAL (
                sequence: 9
            )

            displayColumn TOTALDEVOLUCAOZERADA (
                sequence: 7
            )

            displayColumn TOTALPAGAMENTOTOTAL (
                sequence: 11
            )

            displayColumn TOTALPAGASMENOSQUE50 (
                sequence: 13
            )

            sort (
                column: SEMANACOBRANCA
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            aggregate (
                column: QTDNOVAS
            )

            aggregate (
                column: QTDACERTADAS
            )

            aggregate (
                column: TOTALACERTADAS
            )

            aggregate (
                column: QTDDEVOLUCAOZERADA
            )

            aggregate (
                column: TOTALDEVOLUCAOZERADA
            )

            aggregate (
                column: QTDDEVOLUCAOTOTAL
            )

            aggregate (
                column: TOTALDEVOLUCAOTOTAL
            )

            aggregate (
                column: QTDPAGAMENTOTOTAL
            )

            aggregate (
