    region controle-semanal-detalhado (
        name: Controle Semanal Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(nota.idrepresentante) representante
                     , nota.qtdnovas
                     , nota.totalnovas
                     , nota.qtdacertadas
                     , nota.totalacertadas
                     , nota.qtddevolucaototal
                     , nota.totaldevolucaototal
                     , nota.qtdpagamentototal
                     , nota.totalpagamentototal
                     , nota.qtdpagasmenosque50
                     , nota.totalpagasmenosque50
                     , nota.qtddebitopendente
                     , nota.totaldebitopendente
                     , nota.qtddebitosrecebidos
                     , nota.totaldebitosrecebidos
                     , nota.qtddevolucaozerada
                     , nota.totaldevolucaozerada
                from ( select n.idrepresentante
                            , ( select count(1)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 3 
                                  and nv.semanadistribuicao = :P337_SEMANACOBRANCA ) qtdnovas
                            , ( select sum(nv.valortotalnota)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 3 
                                  and nv.semanadistribuicao = :P337_SEMANACOBRANCA ) totalnovas
                            , ( select count(1)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4 
                                  and nv.semanacobranca = :P337_SEMANACOBRANCA ) qtdacertadas
                            , ( select sum(p.valorpago)
                                from pagamentosnotasvendas p
                                where p.semanacobranca = :P337_SEMANACOBRANCA
                                  and p.origem = 'R'
                                  and exists ( select 1
                                               from notasvendas nv
                                               where nv.idrepresentante = :P337_IDREPRESENTANTE
                                                 and nv.idnotavenda = p.idnotavenda
                                                 and nv.semanacobranca = :P337_SEMANACOBRANCA ) ) totalacertadas
                            , ( select count(1)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = :P337_SEMANACOBRANCA
                                  and nv.valortotaldevolucao = nv.valortotalnota ) qtddevolucaototal
                            , ( select sum(nv.valortotaldevolucao)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = :P337_SEMANACOBRANCA
                                  and nv.valortotaldevolucao = nv.valortotalnota ) totaldevolucaototal
                            , ( select count(1)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = :P337_SEMANACOBRANCA
                                  and nv.valortotalvendalqd = nv.valorpago ) qtdpagamentototal
                            , ( select sum(nv.valorpago)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = :P337_SEMANACOBRANCA
                                  and nv.valortotalvendalqd = nv.valorpago ) totalpagamentototal
                            , ( select count(1)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = :P337_SEMANACOBRANCA 
                                  and nvl(nv.valorpago,0) < 50 ) qtdpagasmenosque50
                            , ( select sum(nv.valorpago)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = :P337_SEMANACOBRANCA 
                                  and nvl(nv.valorpago,0) < 50
                                  and nvl(nv.valorpago,0) > 0 ) totalpagasmenosque50
                            , ( select count(1)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobrancaorig = :P337_SEMANACOBRANCA
                                  and nv.saldo > 0 ) qtddebitopendente
                            , ( select sum(nv.saldo)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobrancaorig = :P337_SEMANACOBRANCA
                                  and nv.saldo > 0 ) totaldebitopendente
                            , ( select count(1)
                                from pagamentosnotasvendas p
                                where p.semanacobranca = :P337_SEMANACOBRANCA
                                  and p.origem = 'R'
                                  and exists ( select 1
                                               from notasvendas nv
                                               where nv.idrepresentante = :P337_IDREPRESENTANTE
                                                 and nv.idnotavenda = p.idnotavenda
                                                 and nv.semanacobranca != :P337_SEMANACOBRANCA ) ) qtddebitosrecebidos
                            , ( select sum(p.valorpago)
                                from pagamentosnotasvendas p
                                where p.semanacobranca = :P337_SEMANACOBRANCA
                                  and p.origem = 'R'
                                  and exists ( select 1
                                               from notasvendas nv
                                               where nv.idrepresentante = :P337_IDREPRESENTANTE
                                                 and nv.idnotavenda = p.idnotavenda
                                                 and nv.semanacobranca != :P337_SEMANACOBRANCA ) ) totaldebitosrecebidos 
                            , ( select count(1)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = :P337_SEMANACOBRANCA
                                  and nvl(nv.valortotaldevolucao,0) = 0 ) qtddevolucaozerada
                            , ( select sum(nv.valorpago)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = :P337_SEMANACOBRANCA
                                  and nvl(nv.valortotaldevolucao,0) = 0 ) totaldevolucaozerada
                       from notasvendas n
                       where n.idrepresentante = :P337_IDREPRESENTANTE
                       group by n.idrepresentante ) nota
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
