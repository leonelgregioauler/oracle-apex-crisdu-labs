            )

            aggregate (
                column: QTDDEBITOSRECEBIDOS
            )

            aggregate (
                column: TOTALDEBITOSRECEBIDOS
            )

            controlBreak (
                column: REPRESENTANTE
                layout {
                    sequence: 1
                }
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P337_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P337_SEMANACOBRANCA (
        type: textField
        label {
            label: Semana de Cobraça
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 8
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P337_SEMANACOBRANCA_FIM (
        type: textField
        label {
            label: Semana de Cobraça
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 8
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P337_TIPORELATORIO (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Semanal;S,Período;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-de-pesquisa (
        name: Tipo de Pesquisa
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P337_TIPORELATORIO
        }
        clientSideCondition {
            type: item=value
            item: P337_TIPORELATORIO
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P337_SEMANACOBRANCA_FIM
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P337_SEMANACOBRANCA_FIM
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 337
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 337
                items: {
                    P337_SEMANACOBRANCA: &P337_SEMANACOBRANCA.
                    P337_IDREPRESENTANTE: &P337_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

