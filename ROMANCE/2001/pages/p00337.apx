    region controle-semanal-por-período (
        name: Controle Semanal por Período
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(nota.idrepresentante) representante
                     , nota.semanacobranca
                     , nota.qtdnovas
                     , nota.qtdacertadas
                     , nota.totalacertadas
                     , nota.qtddevolucaototal
                     , nota.totaldevolucaototal
                     , nota.qtdpagamentototal
                     , nota.totalpagamentototal
                     , nota.qtdpagasmenosque50
                     , nota.totalpagasmenosque50
                     , nota.qtddebitopendente
                     , nota.totaldebitopendente
                     , nota.qtddebitosrecebidos
                     , nota.totaldebitosrecebidos
                     , nota.qtddevolucaozerada
                     , nota.totaldevolucaozerada
                from ( select n.idrepresentante
                            , n.semanacobranca
                            , ( select f.qtdnotasnovas
                                from fechamentorepresentantes f
                                where f.idrepresentante = :P337_IDREPRESENTANTE
                                  and f.semana = n.semanacobranca ) qtdnovas
                            , ( select count(1)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4 
                                  and nv.semanacobranca = n.semanacobranca ) qtdacertadas
                            , ( select sum(p.valorpago)
                                from pagamentosnotasvendas p
                                where p.semanacobranca = n.semanacobranca
                                  and p.origem = 'R'
                                  and exists ( select 1
                                               from notasvendas nv
                                               where nv.idrepresentante = :P337_IDREPRESENTANTE
                                                 and nv.idnotavenda = p.idnotavenda
                                                 and nv.semanacobranca = n.semanacobranca ) ) totalacertadas
                            , ( select count(1)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = n.semanacobranca
                                  and nv.valortotaldevolucao = nv.valortotalnota ) qtddevolucaototal
                            , ( select sum(nv.valortotaldevolucao)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = n.semanacobranca
                                  and nv.valortotaldevolucao = nv.valortotalnota ) totaldevolucaototal
                            , ( select count(1)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = n.semanacobranca
                                  and nv.valortotalvendalqd = nv.valorpago ) qtdpagamentototal
                            , ( select sum(nv.valorpago)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = n.semanacobranca
                                  and nv.valortotalvendalqd = nv.valorpago ) totalpagamentototal
                            , ( select count(1)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = n.semanacobranca
                                  and nvl(nv.valorpago,0) < 50 ) qtdpagasmenosque50
                            , ( select sum(nv.valorpago)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = n.semanacobranca
                                  and nvl(nv.valorpago,0) < 50
                                  and nvl(nv.valorpago,0) > 0 ) totalpagasmenosque50
                            , ( select count(1)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = n.semanacobranca
                                  and nv.saldo > 0 ) qtddebitopendente
                            , ( select sum(nv.saldo)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = n.semanacobranca
                                  and nv.saldo > 0 ) totaldebitopendente
                            , ( select count(1)
                                from pagamentosnotasvendas p
                                where p.semanacobranca = n.semanacobranca
                                  and p.origem = 'R'
                                  and exists ( select 1
                                               from notasvendas nv
                                               where nv.idrepresentante = :P337_IDREPRESENTANTE
                                                 and nv.idnotavenda = p.idnotavenda
                                                 and nv.semanacobranca != n.semanacobranca ) ) qtddebitosrecebidos
                            , ( select sum(p.valorpago)
                                from pagamentosnotasvendas p
                                where p.semanacobranca = n.semanacobranca
                                  and p.origem = 'R'
                                  and exists ( select 1
                                               from notasvendas nv
                                               where nv.idrepresentante = :P337_IDREPRESENTANTE
                                                 and nv.idnotavenda = p.idnotavenda
                                                 and nv.semanacobranca != n.semanacobranca ) ) totaldebitosrecebidos 
                            , ( select count(1)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = n.semanacobranca
                                  and nvl(nv.valortotaldevolucao,0) = 0 ) qtddevolucaozerada
                            , ( select sum(nv.valorpago)
                                from notasvendas nv
                                where nv.idrepresentante = :P337_IDREPRESENTANTE
                                  and nv.idsituacaonotavenda = 4
                                  and nv.semanacobranca = n.semanacobranca
                                  and nvl(nv.valortotaldevolucao,0) = 0 ) totaldevolucaozerada
                       from notasvendas n
                       where n.idrepresentante = :P337_IDREPRESENTANTE
                         and n.idsemanacobranca between pck_util.fnc_idsemana(:P337_SEMANACOBRANCA) and pck_util.fnc_idsemana(:P337_SEMANACOBRANCA_FIM)
                         and :P337_TIPORELATORIO = 'P'
                       group by n.idrepresentante
                              , n.semanacobranca ) nota
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
