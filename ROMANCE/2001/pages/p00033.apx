page 33 (
    name: Efetuar Pagamento
    title: Efetuar Pagamento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"Deseja realmente excluir o pagamento?"';
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_valorpago(pid)
            {
               document.getElementById("P33_IDEDITAR").value = pid;
              apex.submit('EDITAR');
            }
            ```
        executeWhenPageLoads: "window.opener.location.reload(); "
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region efetuar-pagamento (
        name: Efetuar pagamento
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region pagamentos (
        name: Pagamentos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  '<a href="javascript:fnc_valorpago('|| idpagtonotavenda ||')" ><img src="/i/menu/pencil16x16.gif"  border="0"></a>' Editar
                     , datapagamento
                     , valorpago
                     , observacao
                     , decode(origem,'R','Representante','C','Cobrança','P','Perda') "Origem"
                     , ( select pp.usuarioalteracao
                         from logroman.log_pagamentosnotasvendas pp
                         where pp.idpagtonotavenda = pg.idpagtonotavenda
                           and pp.tipoalteracao = 'INSERT') "Cadastrou"
                from pagamentosnotasvendas pg
                where idnotavenda = :P33_IDNOTAVENDA
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        messages {
            whenNoDataFound: Não há pagamentos incluídos
        }
        componentAdvanced {
            stripHtml: true
        }

        column Cadastrou (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Cadastrou
                alignment: center
            }
            layout {
                sequence: 6
            }
        )

        column DATAPAGAMENTO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                defaultSequence: 1
            }
        )

        column EDITAR (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from dual
                    where pck_util.fnc_verificaacesso(2344,v('APP_USER'))= 'S'
                    union
                    select 1
                      from catal.funcionarios f
                         , catal.usuarios u
                         , catal.cargos c
                     where f.idpessoa = u.idpessoa
                       and f.idcargo = c.idcargo
                       and u.ativo = 'S'
                       and c.idcargo = 4 -- Assistente de Cobrança
                       and u.usuario = v('APP_USER')
                    ```
            }
            security {
                escapeSpecialChars: false
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column Origem (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Origem
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column VALORPAGO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990d00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

    )

    pageItem P33_DATAPAGAMENTO (
        type: hidden
        layout {
            sequence: 30
            region: @efetuar-pagamento
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATAPAGAMENTO
            used: always
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P33_IDEDITAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @efetuar-pagamento
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P33_IDMOTIVOBAIXA (
        type: selectList
        label {
            label: Motivo Baixa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select  m.motivo
                     ,  m.idmotivobaixa
                from roman.motivosbaixas m
                order by 1 
                ```
        }
        layout {
            sequence: 70
            region: @efetuar-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P33_IDNOTAVENDA (
        type: hidden
        layout {
            sequence: 20
            region: @efetuar-pagamento
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDNOTAVENDA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P33_IDPAGTONOTAVENDA (
        type: hidden
        layout {
            sequence: 10
            region: @efetuar-pagamento
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPAGTONOTAVENDA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P33_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        settings {
            autoHeight: true
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @efetuar-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
            height: 1
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P33_ORIGEM (
        type: radioGroup
        label {
            label: Origem
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Cobrança' d
                    , 'C' r
                from dual 
                where exists ( select 1
                               from usuariosgruposatendimento ug
                               where ug.idgrupoatendimento = 3
                                 and ug.usuario = v('APP_USER') )
                union
                select 'Perda' d
                    , 'P' r
                from dual 
                where exists ( select 1
                               from usuariosgruposatendimento ug
                               where ug.idgrupoatendimento = 3
                                 and ug.usuario = v('APP_USER') )
                union
                select 'Premiação Campanha'
                     , 'X'
                from dual
                where v('APP_USER') in ('GUILHERME','EZAQUIELD','CAROLINISEVERO')
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @efetuar-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: ORIGEM
            used: always
        }
        default {
            type: static
            staticValue: C
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P33_VALORPAGO (
        type: numberField
        label {
            label: Valor
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @efetuar-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 10
        }
        source {
            type: databaseColumn
            databaseColumn: VALORPAGO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button deletar (
        buttonName: Deletar
        label: Deletar
        layout {
            sequence: 20
            region: @efetuar-pagamento
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P33_ORIGEM != 'R'
                  and :P33_IDPAGTONOTAVENDA is not null
                  and pck_util.fnc_verificaacesso(3551,v('APP_USER'))= 'S'
                ```
        }
    )

    button fechar (
        buttonName: Fechar
        label: Fechar
        layout {
            sequence: 10
            region: @efetuar-pagamento
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 37
                items: {
                    P37_IDNOTAVENDA: &P33_IDNOTAVENDA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 40
            region: @efetuar-pagamento
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(3550,v('APP_USER'))= 'S'
                ```
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 30
            region: @efetuar-pagamento
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P33_ORIGEM != 'R'
                  and :P33_IDPAGTONOTAVENDA is not null
                ```
        }
    )

    dynamicAction perda (
        name: Perda
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P33_ORIGEM
        }
        clientSideCondition {
            type: item=value
            item: P33_ORIGEM
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P33_IDMOTIVOBAIXA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P33_IDMOTIVOBAIXA
            }
            execution {
                sequence: 10
            }
        )

    )

    process atualiza-nota (
        name: atualiza nota
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_romance.prc_atualizanotavenda(:P33_IDNOTAVENDA);
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 32009299111993730
        }
    )

    process fetch-row-from-pagamentosnotasvendas (
        name: Fetch Row from PAGAMENTOSNOTASVENDAS
        type: autoRowFetch
        source {
            tableName: PAGAMENTOSNOTASVENDAS
            pkColumn: IDPAGTONOTAVENDA
            pkItem: P33_IDPAGTONOTAVENDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 32008074482993728
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P33_IDPAGTONOTAVENDA is null then
                        select "SEQ_IDPGTONOTAVENDA".nextval
                          into :P33_IDPAGTONOTAVENDA
                          from sys.dual;
                    end if;
                    
                      
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 32008534218993729
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

    process inclui-histórico (
        name: Inclui Histórico
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                  declare
                  --
                  vidclassificacaonotavenda number;
                  vidcaracteristica number := 43;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number := :P33_IDMOTIVOBAIXA;
                  vobservacao varchar2(1000);
                  --
                begin
                  --
                  insert into observacoesnotasvendas
                  values (seq_idobsnotavenda.nextval,:P33_IDNOTAVENDA,sysdate,'Valor incluido de R$'||:P33_VALORPAGO||' pelo usuário '||v('APP_USER')||' - '||:P33_OBSERVACAO,v('APP_USER'),null);
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P33_IDNOTAVENDA,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidvalorcaracteristica,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                  --
                  commit;
                  -- 
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 20618694223026921
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P33_ORIGEM = 'P' and v('REQUEST') in ('INSERIR','SALVAR')
        }
    )

    process process-row-of-pagamentosnotasvendas (
        name: Process Row of PAGAMENTOSNOTASVENDAS
        type: autoRowProcessing
        target {
            tableName: PAGAMENTOSNOTASVENDAS
            pkColumn: IDPAGTONOTAVENDA
            pkItem: P33_IDPAGTONOTAVENDA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 32008938840993730
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 32009686413993731
        }
        serverSideCondition {
            whenButtonPressed: @deletar
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 33
                items: {
                    P33_IDPAGTONOTAVENDA: &P33_IDEDITAR.
                }
            }
        }
        serverSideCondition {
            type: request=Value
            value: EDITAR
        }
    )

    branch (
        name: Go To Page 33
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 33
                items: {
                    P33_IDNOTAVENDA: &P33_IDNOTAVENDA.
                    P33_IDPAGTONOTAVENDA:
                }
            }
        }
    )

)

