    region lista-de-acordos (
        name: Lista de Acordos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(w.idnegociacaoparceiro)
                     , w.idvendedora
                     , w.vendedora
                     , w.cpf
                     , w.idrepresentante
                     , w.representante
                     , w.filial
                     , w.datanegociacao
                     , (select max(pn.datapagamento)
                        from   pagamentosnegociacoesparceiros pn
                        where  pn.idnegociacaoparceiro = w.idnegociacaoparceiro) datapagamento
                     , w.qtdparcelas
                     , w.formapgto
                     , w.valornegociacao
                     , w.valorpago
                     , ( select x.doc
                         from ( select listagg(d.documento, ' - ') within group (order by 1) doc
                                     , min(v.datavencimento) datavencimento
                                from roman.documentosnegociacao d
                                   , favorita.vencimentospedidos v
                               where d.idpedido = v.idpedido
                                  and d.idnegociacaoparceiro = w.idnegociacaoparceiro
                                  and d.idpedido is not null 
                                  and v.situacaovencimento = 'V'
                                  and v.valorpago = 0 ) x
                         where x.datavencimento > trunc (sysdate - 31) ) "PEDIDO CRÉDITO"
                     , nvl( ( select x.valorpagar
                              from ( select  sum(v.valorpagar) valorpagar
                                          ,  min(v.datavencimento) datavencimento
                                     from roman.documentosnegociacao d
                                        , favorita.vencimentospedidos v
                                     where d.idpedido = v.idpedido
                                       and d.idnegociacaoparceiro = w.idnegociacaoparceiro
                                       and d.idpedido is not null
                                       and v.situacaovencimento = 'V' 
                                       and v.valorpago = 0 ) x
                              where x.datavencimento > trunc (sysdate - 31) ),0 ) "FAVORITA CRÉDITO"   
                      , ( select x.doc
                          from ( select listagg(d.documento, ' - ' )within group (order by 1) doc
                                      , min(v.datavencimento) datavencimento
                                 from roman.documentosnegociacao d
                                    , favorita.vencimentospedidos v
                                 where d.idpedido = v.idpedido
                                   and d.idnegociacaoparceiro = w.idnegociacaoparceiro
                                   and d.idpedido is not null
                                   and v.situacaovencimento = 'V'
                                   and v.valorpago = 0 ) x
                          where x.datavencimento <= trunc (sysdate - 31) ) "PEDIDO COBRANÇA"
                      , nvl( ( select x.valorpagar
                               from ( select sum(v.valorpagar) valorpagar
                                           , min(v.datavencimento) datavencimento
                                      from roman.documentosnegociacao d
                                         , favorita.vencimentospedidos v
                                      where d.idpedido = v.idpedido
                                        and d.idnegociacaoparceiro = w.idnegociacaoparceiro
                                        and d.idpedido is not null
                                        and v.situacaovencimento = 'V' 
                                        and v.valorpago = 0 ) x
                               where x.datavencimento <= trunc (sysdate - 31) ),0 ) "FAVORITA COBRANÇA"
                       , ( select listagg(d.documento, ' - ' )within group (order by 1) doc
                           from roman.documentosnegociacao d
                           where d.idnegociacaoparceiro = w.idnegociacaoparceiro
                             and d.idnotavenda is not null ) "NOTA ROMANCE"       
                       , nvl( ( select sum(d.valororiginal)
                                from roman.documentosnegociacao d
                                where d.idnegociacaoparceiro = w.idnegociacaoparceiro
                                  and d.idnotavenda is not null ),0 ) "ROMANCE COBRANÇA"
                       , w.documentoestrangeiro
                from vw_negociacoes_acordoaki w
                where ( :P597_DATAINICIO is null
                     or w.datanegociacao between to_date(:P597_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P597_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                  and ( :P597_TIPODATA = 'N')
                  and ( :P597_IDFILIAL is null or w.idfilial = :P597_IDFILIAL )
                  and ( :P597_FORMAPAGAMENTO = 'A' or w.formapagamento = :P597_FORMAPAGAMENTO )
                  and ( :P597_CPF is null or w.cpf = regexp_replace(:P597_CPF, '[^0-9]', '') )
                  and ( :P597_NEGOCIA = 'A' or w.negocia = :P597_NEGOCIA )
                  and ( :P597_DOCUMENTOESTRANGEIRO is null or w.documentoestrangeiro = regexp_replace(:P597_DOCUMENTOESTRANGEIRO, '[^0-9]', '')) 
                  and ( :P597_PAIS = '-1' or to_char(w.idpais) = :P597_PAIS )
                UNION
                select w.idnegociacaoparceiro
                     , w.idvendedora
                     , w.vendedora
                     , w.cpf
                     , w.idrepresentante
                     , w.representante
                     , w.filial
                     , w.datanegociacao
                     , pn.datapagamento
                     , w.qtdparcelas
                     , w.formapgto
                     , w.valornegociacao
                     , w.valorpago
                     , ( select x.doc
                         from ( select listagg(d.documento, ' - ') within group (order by 1) doc
                                     , min(v.datavencimento) datavencimento
                                from roman.documentosnegociacao d
                                   , favorita.vencimentospedidos v
                                where d.idpedido = v.idpedido
                                  and d.idnegociacaoparceiro = w.idnegociacaoparceiro
                                  and d.idpedido is not null 
                                  and v.situacaovencimento = 'V'
                                  and v.valorpago = 0 ) x
                         where x.datavencimento > trunc (sysdate - 31) ) "PEDIDO CRÉDITO"
                     , nvl( ( select x.valoratualizado
                              from ( select sum(d.valoratualizado) valoratualizado
                                          , min(v.datavencimento) datavencimento
                                     from roman.documentosnegociacao d
                                        , favorita.vencimentospedidos v
                                     where d.idpedido = v.idpedido
                                       and d.idnegociacaoparceiro = w.idnegociacaoparceiro 
                                       and d.idpedido is not null
                                       and v.situacaovencimento = 'V'
                                       and v.valorpago = 0 ) x
                              where x.datavencimento > trunc (sysdate - 31) ),0 ) "FAVORITA CRÉDITO"   
                      , ( select x.doc
                          from ( select listagg(d.documento, ' - ' )within group (order by 1) doc
                                      , min(v.datavencimento) datavencimento
                                 from roman.documentosnegociacao d
                                    , favorita.vencimentospedidos v
                                 where d.idpedido = v.idpedido
                                   and d.idnegociacaoparceiro = w.idnegociacaoparceiro
                                   and d.idpedido is not null
                                   and v.situacaovencimento = 'V'
                                   and v.valorpago = 0 ) x
                          where x.datavencimento <= trunc (sysdate - 31) ) "PEDIDO COBRANÇA"
                      , nvl( ( select x.valoratualizado             
                               from ( select sum(d.valoratualizado) valoratualizado
                                           , min(v.datavencimento) datavencimento
                                      from roman.documentosnegociacao d
                                         , favorita.vencimentospedidos v
                                      where d.idpedido = v.idpedido
                                        and d.idnegociacaoparceiro = w.idnegociacaoparceiro
                                        and d.idpedido is not null
                                        and v.situacaovencimento = 'V'
                                        and v.valorpago = 0 ) x
                               where x.datavencimento <= trunc (sysdate - 31)  ),0 ) "FAVORITA COBRANÇA"
                       , ( select listagg(d.documento, ' - ' )within group (order by 1) doc
                           from roman.documentosnegociacao d
                           where d.idnegociacaoparceiro = w.idnegociacaoparceiro
                             and d.idnotavenda is not null ) "NOTA ROMANCE"       
                       , nvl( ( select sum(d.valoratualizado)
                                from roman.documentosnegociacao d
                                where d.idnegociacaoparceiro = w.idnegociacaoparceiro
                                  and d.idnotavenda is not null ),0 ) "ROMANCE COBRANÇA"
                       , w.documentoestrangeiro
                from vw_negociacoes_acordoaki w
                    , pagamentosnegociacoesparceiros pn
                where w.idnegociacaoparceiro = pn.idnegociacaoparceiro(+)
                  and ( :P597_DATAINICIO is null
                     or trunc(pn.databaixa) between :P597_DATAINICIO and :P597_DATAFIM )
                  and (:P597_TIPODATA = 'P')
                  and ( :P597_IDFILIAL is null or w.idfilial = :P597_IDFILIAL )
                  and ( :P597_FORMAPAGAMENTO = 'A' or w.formapagamento = :P597_FORMAPAGAMENTO )
                  and ( :P597_CPF is null or w.cpf = regexp_replace(:P597_CPF, '[^0-9]', '') )
                  and ( :P597_NEGOCIA = 'A' or w.negocia = :P597_NEGOCIA )
                  and ( :P597_DOCUMENTOESTRANGEIRO is null or w.documentoestrangeiro = regexp_replace(:P597_DOCUMENTOESTRANGEIRO, '[^0-9]', '')) 
                  and ( :P597_PAIS = '-1' or to_char(w.idpais) = :P597_PAIS )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
