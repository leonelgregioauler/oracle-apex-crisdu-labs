    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 597
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 597
                items: {
                    P597_IDFILIAL: &P597_IDFILIAL.
                    P597_FORMAPAGAMENTO: &P597_FORMAPAGAMENTO.
                    P597_CPF: &P597_CPF.
                    P597_DATAINICIO: &P597_DATAINICIO.
                    P597_DATAFIM: &P597_DATAFIM.
                    P597_NEGOCIA: &P597_NEGOCIA.
                    P597_PAIS: &P597_PAIS.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

