        lov {
            type: staticValues
            staticValues: STATIC:Boleto;B,Cartão de Crédito;C,PIX;P,Aqui Pago;U,Membrezia;Q,Abitab;N,Ambos;A,Redpagos;L
            displayExtraValues: false
