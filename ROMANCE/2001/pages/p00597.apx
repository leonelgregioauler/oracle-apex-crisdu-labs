page 597 (
    name: Acordos Realizados
    title: Acordos Realizados
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acordos-resumidos (
        name: Acordos Resumidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.filial
                     , count( distinct w.idnegociacaoparceiro) qtd
                     , sum(w.valornegociacao) valornegociado
                     , sum(w.valorpago) valorpago
                     , sum(valornegociacao- valorpago) saldo
                from  vw_negociacoes_acordoaki w
                where :P597_TIPODATA = 'N'
                  and ( :P597_NEGOCIA = 'A' or w.negocia = :P597_NEGOCIA )
                  and ( :P597_DATAINICIO is null
                     or w.datanegociacao between to_date(:P597_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P597_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                  and ( :P597_PAIS = '-1' or to_char(w.idpais) = :P597_PAIS )
                group by w.filial
                union
                select w.filial
                     , count( distinct w.idnegociacaoparceiro) qtd
                     , sum(w.valornegociacao) valornegociado
                     , sum(w.valorpago) valorpago
                     , sum(valornegociacao- valorpago) saldo
                from  vw_negociacoes_acordoaki w
                    , pagamentosnegociacoesparceiros pn
                where w.idnegociacaoparceiro = pn.idnegociacaoparceiro(+)
                  and ( :P597_NEGOCIA = 'A' or w.negocia = :P597_NEGOCIA )
                  and :P597_TIPODATA = 'P'
                  and ( :P597_DATAINICIO is null
                     or trunc(pn.databaixa) between :P597_DATAINICIO and :P597_DATAFIM )
                  and ( :P597_PAIS = '-1' or to_char(w.idpais) = :P597_PAIS )
                group by w.filial
                order by 1
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5332173276022464627
        }

