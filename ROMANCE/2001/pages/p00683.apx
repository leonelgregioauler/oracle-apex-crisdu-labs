    region envios-ao-spc (
        name: Envios ao SPC
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.idnegativacaospclote
                     , n.dataleitura
                     , n.mensagem
                     , roman.pck_romance.fnc_nomefilial(v.idfilial)Filial
                     , n.idpessoa
                     , n.cpf
                     , n.nomepessoa
                     , n.datanascimento
                     , n.endereco
                     , n.numero
                     , n.cep
                     , n.bairro
                     , n.cidade||'/'||n.sigla cidade
                     , n.numerocontrato
                     , n.datacontrato
                     , n.valorcontrato
                     , n.datavencimento
                     , decode(n.tipomovimento,'I','Inclusão ao SPC','E','Exclusão do SPC') movimento
                     , pck_romance.fnc_nomerepresentante(v.idrepresentante) distribuidor
                     , nvl( ( select 'Sim'
                              from classificacoesnotasvendas cn
                                 , notasvendas nv
                              where cn.idnotavenda = nv.idnotavenda
                                and nv.idvendedora = v.idvendedora
                                and nv.numeronota = n.numerocontrato
                                and cn.idcaracteristicanotavenda = 59 ),'Não') cedencia_divida
                from negativacoesspclote n
                   , catal.vendedoras v
                where v.idpessoa = n.idpessoa
                  and n.dataleitura between to_date(:P683_DATAINICIO||' 00:00:01', 'DD/MM/RRRR HH24:MI:SS') and to_date(:P683_DATAFIM||' 23:59:59', 'DD/MM/RRRR HH24:MI:SS')
                  and ( :P683_SITUACAO is null
                      or ( :P683_SITUACAO = 'S' and n.mensagem in ('Operação bem sucedida','Motivo da Liquidação/Baixa Invalida') )
                      or ( :P683_SITUACAO = 'E' and n.mensagem not in ('Operação bem sucedida','Motivo da Liquidação/Baixa Invalida') ) )
                  and ( :P683_CPF is null or n.cpf = regexp_replace(:P683_CPF, '[^0-9]', '') )
                  and (:P683_FRANQUIA is null or v.idfilial = :P683_FRANQUIA)
                  and :P683_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado! Verifique os Filtros.
        }
        advanced {
            savedReportMappingIdentifier: 572403345249072503
        }

