    region placar (
        name: Placar
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select n.mensagem situacao
                     , count(1) qtd
                from negativacoesspclote n
                      , catal.vendedoras v
                where v.idpessoa = n.idpessoa
                  and n.dataleitura between to_date(:P683_DATAINICIO||' 00:00:01', 'DD/MM/RRRR HH24:MI:SS') and to_date(:P683_DATAFIM||' 23:59:59', 'DD/MM/RRRR HH24:MI:SS')
                  and (:P683_FRANQUIA is null or v.idfilial = :P683_FRANQUIA)
                group by mensagem
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: SITUACAO
            valueColumn: QTD
            layout: 2Columns
            color: yes
        }
    )

