        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                
                select nome
                     , idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idfilial != 1063
                  and f.ididioma = 1
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
