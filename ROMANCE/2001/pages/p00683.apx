    process popula-data (
        name: Popula Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  :P683_DATAINICIO := trunc(sysdate);
                  :P683_DATAFIM := trunc(sysdate);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 572405813660072528
        }
        serverSideCondition {
            type: itemIsNull
            item: P683_DATAINICIO
        }
    )

    branch (
        execution {
