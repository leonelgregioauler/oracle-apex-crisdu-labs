        behavior {
            target: {
                page: 683
                items: {
                    P683_SITUACAO: &P683_SITUACAO.
                    P683_CPF: &P683_CPF.
                    P683_DATAINICIO: &P683_DATAINICIO.
                    P683_DATAFIM: &P683_DATAFIM.
                    P683_FILTRAR: S
