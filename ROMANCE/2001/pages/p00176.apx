page 176 (
    name: Acompanhamento
    title: Acompanhamento
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region acompanhamento (
        name: Acompanhamento
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select link
                     , label 
                     , value "Notas Novas"
                from( select fr.idfechamentorepres link
                           , fr.semana label
                           , fr.qtdnotasnovas value
                      from fechamentorepresentantes fr
                      where fr.idrepresentante = :P176_IDREPRESENTANTE
                        and fr.idregiaovenda = :P176_IDREGIAOVENDA
                      order by 1 desc)
                where rownum <= 10
                order by 1
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @filtro
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: combination
        }
        title {
            title: Acompanhamento
        }
        chartLayout {
            maxWidth: 1024
            height: 600
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            position: bottom
            hideAndShowBehavior: none
        }

        series cobrança (
            name: Cobrança
            type: line
            execution {
                sequence: 20
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: "\"2\""
                value: "\"3\""
            }
            appearance {
                assignedToY2Axis: true
            }
            marker {
                show: false
            }
            label {
                show: true
                position: aboveMarker
            }
            performance {
                maxRowsToProcess: 15
            }
        )

        series nro-notas (
            name: Nro Notas
            execution {
                sequence: 30
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: "\"2\""
                value: "\"3\""
            }
            appearance {
                assignedToY2Axis: true
            }
            label {
                show: true
                position: aboveMarker
            }
            performance {
                maxRowsToProcess: 15
            }
        )

        series venda (
            name: % Venda
            type: line
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: "\"2\""
                value: "\"3\""
            }
            marker {
                show: false
            }
            label {
                show: true
                position: aboveMarker
            }
            performance {
                maxRowsToProcess: 15
            }
        )

        axis x (
            name: x
            value {
                formatScaling: none
            }
            majorTicks {
                show: false
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: true
            }
        )

        axis y-1 (
            name: y2
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: true
            }
        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 1
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
    )

    pageItem P176_IDREGIAOVENDA (
        type: selectList
        label {
            label: Região de Venda
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(idregiaovenda) display_value
                     , idregiaovenda return_value
                from regioesrepresentantes
                where idrepresentante = :P176_IDREPRESENTANTE
                order by ordem
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P176_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

