    region pontuações-show-de-prêmios (
        name: Pontuações - Show de Prêmios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante (v.idrepresentante) distribuidor
                      , PP.nomepessoa consultora 
                      , ''''||pp.cpf||'''' CPF
                      , v.idvendedora
                      , case
                           when v.ativo = 'S' then 'Sim'
                        else 'Não'
                        end Ativo
                      , p.pontos pontos
                      /*, ( select c.nomecategoria
                         from categoriasclubes c
                         where c.idcategoriaclube = p.idcategoriaclube ) categoria*/
                      , case 
                          when  p.idcategoriaclube = 7 then 1 -- 1 estrela
                          when  p.idcategoriaclube = 8 then 2 -- 2 estrela
                          when  p.idcategoriaclube = 9 then 3 -- 3 estrela
                          when  p.idcategoriaclube = 10 then 4 -- 4 estrela
                          when  p.idcategoriaclube = 11 then 5 -- 5 estrela
                          when  p.idcategoriaclube = 12 then 6 -- Superstar
                          when  p.idcategoriaclube = 14 then 0 -- Nenhuma
                        end categoria
                
                      , (select decode(Sum(debito),0,'N',null,'N','S') debito
                          from (
                          select (vp.valorpagar-vp.valorpago) debito
                          from favorita.pedidos            p
                              ,favorita.vencimentospedidos vp
                              ,favorita.pagamentospedidos  pp
                          where p.idpedido    = vp.idpedido
                            and vp.idvencimentopedido = pp.idvencimentopedido
                            and vp.situacaovencimento = 'V'
                            and trunc(vp.datavencimento) < trunc(sysdate)
                            and p.idvendedora = v.idvendedora
                          union
                          select distinct 1 debito
                          from roman.notasvendas nv
                          where nv.idsituacaonotavenda = 4
                            and nv.saldo               > 0 
                            and nv.idvendedora         = v.idvendedora
                            )) debito
                      , cd.nomecidade  Cidade
                      , es.sigla       Estado
                      , upper(pa.nome) Pais      
                      , '<a href="javascript: fnc_abrelogin('''||fnc_encode_base64(pstring => v.idvendedora )||''')"> Ver Tela</a>'  link
                      , (select max(rl.datalogin)
                         from roman.registrosloginminhasacola rl
                         where  rl.idvendedora = v.idvendedora) "Ultimo Acesso APP"
                FROM PONTUACOESCLUBEDESUCESSO P
                   , VENDEDORAS V
                   , PESSOAS PP
                   , CIDADES CD
                   , ESTADOS ES
                   , PAISES PA
                WHERE /* Liga tabela Vendedoras com Pontos Clube*/
                      V.IDVENDEDORA = P.IDVENDEDORA
                      /* Liga tabela de pessoas com Vendedoras*/
                  and v.idpessoa    = pp.idpessoa
                      /* Lida a tabela de Cidades com Pessoas*/
                  and pp.idcidade  = cd.idcidade
                      /* Liga a tabela de Cidade com Estados*/
                  and cd.idestado = es.idestado
                      /* Liga a tabela de Estado com paises*/
                  and es.idpais   = pa.idpais
                      /* Empresa*/
                  and       /* Todas as empresas*/
                       (    (:P716_FILIAL = -1)
                            /* Todas empresas REGIONAL 1*/
                         or (:P716_FILIAL = -10 and exists (select 1
                                                              from catal.filiais f
                                                             where f.idfilial = v.idfilial
                                                               and f.regional = 1))
                            /* Todas empresas REGIONAL 2*/
                         or (:P716_FILIAL = -20 and exists (select 1
                                                              from catal.filiais f
                                                             where f.idfilial = v.idfilial
                                                               and f.regional = 2))
                            /* Todas empresas REGIONAL 3*/
                         or (:P716_FILIAL = -30 and exists (select 1
                                                              from catal.filiais f
                                                             where f.idfilial = v.idfilial
                                                               and f.regional = 3))
                            /* Todas empresas REGIONAL 4*/
                         or (:P716_FILIAL = -40 and exists (select 1
                                                              from catal.filiais f
                                                             where f.idfilial = v.idfilial
                                                               and f.regional = 4))
                            /* Todas empresas REGIONAL 5*/
                         or (:P716_FILIAL = -40 and exists (select 1
                                                              from catal.filiais f
                                                             where f.idfilial = v.idfilial
                                                               and f.regional = 5))
                            /* Somente da filial selecionada em tela*/
                         or (v.idfilial = :P716_FILIAL ))
                      /* Filtra pra trazer somente pessoa com CPF preenchido */
                  and pp.cpf is not null
                      /* Fiiltra por Representante*/
                  and ( :P716_DISTRIBUIDOR = -1 or v.idrepresentante = :P716_DISTRIBUIDOR )
                      /* Filtra por Categoria Clube*/
                  and ( :P716_IDCATEGORIA is null or p.idcategoriaclube = :P716_IDCATEGORIA )
                      /* sei lá!*/
                  and :P716_FILTRAR = 'S'
                      /* Define o tipo do relatóeio*/
                  and :P716_TIPOREL = 'S'
                  -- FILTRO DE SITUACAO VENDEDORA
                  and ( :P716_SITUACAO_CONSULTORA = 'T' 
                     or ( :P716_SITUACAO_CONSULTORA = 'A' and v.ativo = 'S' )
                     or ( :P716_SITUACAO_CONSULTORA = 'I' and v.ativo = 'N' ) )
                  --Ajustes solicitados pela Sanny devido ao Projeto Gestão de eventos - Estrelas Romance
                  and not exists ( select 1
                                   from representantes rep
                                   where rep.idpessoa = pp.idpessoa 
                                     and rep.ativo = 'S')
                  ----- tratamento para pegar apenas distribuidores da filial informada no filtro
                   -- é a mesma query usada no list :P716_DISTRIBUIDOR
                   and v.idrepresentante in ( select r.idrepresentante
                                              from catal.representantes r
                                                 , catal.pessoas p
                                             where /* Liga Tebala Pessoas e Representantes*/
                                                   p.idpessoa = r.idpessoa
                                                   /* Representante Ativo*/
                                               and r.ativo = 'S'
                                                   /* Filtra representante por filial e Regional*/
                                                        /* Todos os representates*/
                                               and (    (:P716_FILIAL = -1) 
                                                        /* Representantes das filiais REGIONAL 1*/
                                                     or (:P716_FILIAL = -10 and  exists (select f.idfilial 
                                                                                           from catal.filiais f
                                                                                          where f.idfilial = r.idfilial
                                                                                            and f.tipofilial = 'D'
                                                                                            and f.ativo = 'S'
                                                                                            and f.regional = 1)) 
                                                        /* Representantes das filiais REGIONAL 2*/
                                                     or (:P716_FILIAL = -20 and  exists (select f.idfilial 
                                                                                           from catal.filiais f
                                                                                          where f.idfilial = r.idfilial
                                                                                            and f.tipofilial = 'D'
                                                                                            and f.ativo = 'S'
                                                                                            and f.regional = 2))
                                                        /* Representantes das filiais REGIONAL 3*/
                                                     or (:P716_FILIAL = -30 and  exists (select f.idfilial 
                                                                                           from catal.filiais f
                                                                                          where f.idfilial = r.idfilial
                                                                                            and f.tipofilial = 'D'
                                                                                            and f.ativo = 'S'
                                                                                            and f.regional = 3))
                                                        /* Representantes das filiais REGIONAL 4*/
                                                     or (:P716_FILIAL = -40 and  exists (select f.idfilial 
                                                                                           from catal.filiais f
                                                                                          where f.idfilial = r.idfilial
                                                                                            and f.tipofilial = 'D'
                                                                                            and f.ativo = 'S'
                                                                                            and f.regional = 4))
                                                        /* Representantes das filiais REGIONAL 5*/
                                                     or (:P716_FILIAL = -50 and  exists (select f.idfilial 
                                                                                           from catal.filiais f
                                                                                          where f.idfilial = r.idfilial
                                                                                            and f.tipofilial = 'D'
                                                                                            and f.ativo = 'S'
                                                                                            and f.regional = 5))
                                                        /* Somente os representantes da filial selecionada em tela*/
                                                     or (r.idfilial = :P716_FILIAL)))
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
