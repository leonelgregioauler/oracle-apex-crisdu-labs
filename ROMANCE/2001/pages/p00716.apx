                ```sql
                select d
                     , r
                from ( select 'Resumido' d
                            , 'R' r
                       from dual 
                       union
                       select 'Detalhado'
                            , 'D'
                       from dual
                       where exists ( select 1
                                      from usuarios u
                                      where u.usuario = v('APP_USER') 
                                        and u.idgerente in (280,143) )
                       union
                       select 'Detalhado Plus'
                            , 'DP'
                       from dual
                       union
                       select 'Show de Prêmios'
                            , 'S'
                       from dual
                       where exists ( select 1
                                      from usuarios u
                                      where u.usuario = v('APP_USER') 
                                        and u.idgerente in (280,143) )
                       union
                       select 'Agrupado por Distribuidor'
                            , 'A'
                       from dual
                       union
                       select 'Loteria Federal'
                            , 'L'
                       from dual
                       where exists ( select 1
                                      from usuarios u
                                      where u.usuario = v('APP_USER') 
                                        and u.idgerente in (280,143) ) )
                              
                ```
