    pageItem P716_DISTRIBUIDOR (
        type: selectList
        label {
            label: <b>Distribuidor:</b>
            alignment: left
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                -- Script padrão de criação de uma consulta (Function Body Reurning Sql Query)
                declare
                  -- Variáveis de controle
                  v_select   varchar2(4000);
                  v_from     varchar2(4000);
                  v_where    varchar2(4000);
                  
                begin
                  -- Monta o Select 
                  v_select := 'select initcap(p.nomepessoa) as display_value
                     , r.idrepresentante     as return_value';
                
                  -- Monta o From
                  v_from := '  from catal.representantes r
                     , catal.pessoas p';
                  
                  -- Monta o Where
                  v_where := ' where p.idpessoa = r.idpessoa'; -- join pessoas ->representante
                
                  -- Filtro Situação do Representante
                  if :P716_SITUACAO_REPRESENTANTE = 'A' then
                	v_where := v_where || ' and r.ativo = ''S''';
                  elsif :P716_SITUACAO_REPRESENTANTE = 'I' Then
                	v_where := v_where || ' and r.ativo = ''N''';
                  end if;
                  
                  -- Filtro Filial
                  if :P716_FILIAL is not null then
                	if :P716_FILIAL = -10 then
                	  v_where := v_where || ' and  exists (select f.idfilial 
                			     from catal.filiais f
                			    where f.idfilial = r.idfilial
                			  	  and f.tipofilial = ''D''
                				  and f.ativo = ''S''
                				  and f.regional = 1)';
                	elsif :P716_FILIAL = -20 then
                	  v_where := v_where || ' and  exists (select f.idfilial 
                			     from catal.filiais f
                			    where f.idfilial = r.idfilial
                			  	  and f.tipofilial = ''D''
                				  and f.ativo = ''S''
                				  and f.regional = 2)';
                	elsif :P716_FILIAL = -30 then
                	  v_where := v_where || ' and  exists (select f.idfilial 
                			     from catal.filiais f
                			    where f.idfilial = r.idfilial
                			  	  and f.tipofilial = ''D''
                				  and f.ativo = ''S''
                				  and f.regional = 3)';
                	elsif :P716_FILIAL = -40 then
                	  v_where := v_where || ' and  exists (select f.idfilial 
                			     from catal.filiais f
                			    where f.idfilial = r.idfilial
                			  	  and f.tipofilial = ''D''
                				  and f.ativo = ''S''
                				  and f.regional = 4)';
                	elsif :P716_FILIAL = -50 then
                	  v_where := v_where || ' and  exists (select f.idfilial 
                			     from catal.filiais f
                			    where f.idfilial = r.idfilial
                			  	  and f.tipofilial = ''D''
                				  and f.ativo = ''S''
                				  and f.regional = 5)';
                	else
                      v_where := v_where || ' and  r.idfilial = :P716_FILIAL';
                	end if;
                  end if;
                  
                  -- Para debug é só descomentar(Dúvidas, ablar com o Maicon)
                  if v('APP_USER') in ('MAICONAIMI','OSIELF','CESARH','BRUNOB','DIEGOPIECHO') then
                    roman.prc_grava_log_debug_desenvolvedores(v('APP_USER'), 'Query Bynd', v_select, v_from, v_where);
                  end if;
                
                  -- Retona uma consulta SQL completa
                  return v_select || v_from || v_where;
                  
                end;
                ```
            nullDisplayValue: - Todos -
            nullReturnValue: -1
        }
        cascadingLov {
            parentItems: [
                P716_FILIAL
                P716_SITUACAO_REPRESENTANTE
            ]
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

