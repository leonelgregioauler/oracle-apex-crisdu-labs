    dynamicAction buscaciclo (
        name: BuscaCiclo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P716_FILIAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: P716_CICLO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select htf.escape_sc(pck_util.fnc_semanaid(pidsemana => ( (f.idsemanainicio - (f.quantidadeciclos - 1)) +
                                                                (select idsemana - f.idsemanainicio
                                                                   from semana_dias
                                                                  where sysdate between dt_ini and dt_fim  )
                                                                   ) ) || ' à ' || 
                           pck_util.fnc_semanaid( pidsemana => f.idsemanainicio +
                                                  (select idsemana - f.idsemanainicio
                                                                   from semana_dias
                                                                  where sysdate between dt_ini and dt_fim  ) ) ) ciclo
                      from filiaisclubedesucesso f
                     where f.idfilial         = :P716_FILIAL
                       and f.idclubedesucesso = (select idclubedesucesso
                                                   from clubedesucesso
                                                  where sysdate between datavigenciainicial
                                                                    and datavigenciafinal);
                    ```
                itemsToSubmit: P716_FILIAL
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P716_CICLO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction show (
        name: Show
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P716_TIPOREL
        }
        clientSideCondition {
            type: itemIsInList
            item: P716_TIPOREL
            list: [
                D
                DP
            ]
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P716_CPF
                    P716_DOC_ESTRANGEIRO
                    P716_POSSUIDIVIDA
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P716_POSSUIDIVIDA
            }
            execution {
                sequence: 20
            }
            clientSideCondition {
                type: item=value
                item: P716_TIPOREL
                value: DP
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P716_CPF
                    P716_DOC_ESTRANGEIRO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    validation obriga-selecionar-uma-filial-detalhado-plus (
        name: Obriga selecionar uma filial detalhado plus
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                begin
                    /* Impede que o usuário escolha a opção "- Todas -" quando o tipo de relatório for "DP" (Pontuações - Detalhado Plus )*/
                    if :P716_TIPOREL = 'DP' and :P716_FILIAL = -1 then
                        return false;
                    else
                        return true;
                    end if;
                end;
                ```
        }
        error {
            errorMessage:
                ```
                Para gerar o relatório <span style="color: red; font-weight: bold;">"Detalhado Plus"</span>, selecione uma Filial específica. 
                </br>
                A opção "- Todas -" não é permitida para esse relatório<i class="fa fa-exclamation" aria-hidden="true"></i>
                </br>
                </br>
                Verifique o Filtro <span style="color: red; font-weight: bold;">*</span>
                <span style="color: black; font-weight: bold;">Filial:</span>
                ```
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    process inicializa-page-itens (
        name: Inicializa Page Itens
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    
                    /* Busca ID Filial do usuário conectado*/
                    select g.idfilial
                      into :P716_FILIAL_USUARIO
                      from catal.gerentes g
                     where g.idgerente = (select u.idgerente
                                            from catal.usuarios u
                                           where u.usuario = v('APP_USER'));
                
                    /*Inicializa situação consultora*/
                    if :P716_SITUACAO_CONSULTORA is null then
                        :P716_SITUACAO_CONSULTORA := 'A';
                    end if;
                
                    /*Inicializa situação representante*/
                    if :P716_SITUACAO_REPRESENTANTE is null then
                        :P716_SITUACAO_REPRESENTANTE := 'A';
                    end if;
                
                /* Tratamento de erro da rotina*/
                exception
                    when others then
                        :P716_FILIAL_USUARIO := null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 255179684253823702
        }
    )

    branch (
        name: Go To Page 716
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 716
                items: {
                    P716_FILIAL: &P716_FILIAL.
                    P716_DISTRIBUIDOR: &P716_DISTRIBUIDOR.
                    P716_FILTRAR: S
                    P716_IDCATEGORIA: &P716_IDCATEGORIA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

