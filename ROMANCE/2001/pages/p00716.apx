    region pontuações-detalhado-plus (
        name: Pontuações - Detalhado Plus
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                 
                 v_select varchar2(32767);
                 v_where  varchar2(4000);
                 v_group  varchar2(4000);
                 v_order  varchar2(1000);
                
                BEGIN
                
                /*
                    Maicon Aimi - 14/08/2025 - 10530720
                
                    Fala pessoal! A coluna perc_sacola da query abaixo é meio complicada.
                    Foi feita com base na coluna existente no relatório da página 2001.670.
                    Então, se precisarem dar manutenção, tenham paciência, perseverança
                    e, por favor, não me xinguem. :)
                */
                
                
                  v_select := 'select t.distribuidor ' ||
                         ', t.empreendedora consultora ' ||
                         ', t.categoria' ||
                         ', sum(t.pontos) pontos' ||
                         ', t.idcategoriaclube' ||
                         ', t.idvendedora' ||
                         ', t.cpf' ||
                         ', t.documentoestrangeiro' ||
                         ', t.idfilial' ||
                         ', t.idrepresentante' ||
                         ', decode(roman.pck_util.fnc_debito_vendedora(t.idvendedora), 0, ''Não'', ''Sim'') as possui_debito' ||
                         ', roman.pck_util.fnc_debito_vendedora(t.idvendedora,''R'') as debito_romance' ||
                         ', roman.pck_util.fnc_debito_vendedora(t.idvendedora,''F'') as debito_favorita' ||
                         ', (select round((sum(nvl(nv.valortotalvenda,0)) /  nullif(sum(nvl(nv.valortotalnota,0)),0)) * 100,2) perc_Sacola
                               from roman.notasvendas nv
                              where nv.idsituacaonotavenda = 4
                                and nv.idvendedora = t.idvendedora
                                and nv.idsemanacobranca between (select (f.idsemanainicio - (f.quantidadeciclos-1)) + ( select idsemana - f.idsemanainicio
                                                                                                                          from semana_dias
                                                                                                                         where sysdate between dt_ini and dt_fim )
                                                                   from roman.filiaisclubedesucesso f
                                                                  where f.idfilial         = :P716_FILIAL
                                                                    and f.idclubedesucesso = (select idclubedesucesso
                                                                                                from roman.clubedesucesso
                                                                                               where sysdate between datavigenciainicial
                                                                                                                 and datavigenciafinal)) and  
                                                                (select s.idsemana
                                                                   from roman.semana_dias s
                                                                  where sysdate between s.dt_ini and s.dt_fim)) as perc_sacola' ||
                         ', (select count(*)
                               from roman.notasvendas nva
                              where nva.idvendedora = t.idvendedora
                                and nva.idsituacaonotavenda = 4) as qtd_sacolas_acertadas' || 
                         ', (select count(*)
                               from favorita.pedidos pf
                              where pf.idvendedora = t.idvendedora
                                and pf.datacancelamento is null 
                                and pf.idsituacaoentrega >= 60000) as qtd_pedidos_favorita'|| --16457279
                         ', (select to_char(nvl(sum(nt.valorpago) / nullif(count(nt.idnotavenda),0),0),''999G999G999G999G999G999G990D00'')
                               from roman.notasvendas nt
                              where nt.idvendedora = t.idvendedora
                                and nt.idsituacaonotavenda = 4) as ticket_medio' ||
                         ', (select x.telefonelimpo
                               from (select tp.idpessoa
                                          , tp.telefonelimpo
                                          , row_number() over (partition by tp.idpessoa
                                                                   order by tp.idtelefonepessoa desc) rn
                                       from roman.telefonespessoas tp
                                      where tp.telefonelimpo is not null) x
                              where x.idpessoa = t.idpessoa
                                and x.rn = 1) as telefone_1' ||
                         ', (select x.telefonelimpo
                               from (select tp.idpessoa
                                          , tp.telefonelimpo
                                          , row_number() over (partition by tp.idpessoa
                                                                   order by tp.idtelefonepessoa desc) rn
                                       from roman.telefonespessoas tp
                                      where tp.telefonelimpo is not null) x
                              where x.idpessoa = t.idpessoa
                                and x.rn = 2) as telefone_2' ||
                         ', (select decode(count(*),0,''Não'',''Sim'')' ||
                         '    from roman.notasvendas nv' ||
                         '   where nv.idvendedora = t.idvendedora' ||
                         '     and nv.idsituacaonotavenda = 3' ||
                         ') as sacola_ativa' ||
                         ', (select c.nomecidade
                               from catal.pessoas p
                                  , catal.cidades c
                              where p.idpessoa = t.idpessoa
                                and c.idcidade = p.idcidade) as cidade' || --15256661
                     ' from roman.vw_detalhamento_pontos t ' ||
                     '    , representantes r ';
                  --
                  v_where := 'where t.idrepresentante = r.idrepresentante and ''S'' ' || ' = '|| '''' || v('P716_FILTRAR') ||'''';
                  v_where := v_where ||
                               ' and not exists  (select 1
                                from representantes rr
                               where rr.idpessoa = t.idpessoa
                                 and rr.idrepresentante = t.idrepresentante)
                                -- 10250672
                                and not exists (select 1 
                                                  from catal.funcionarios fu
                                                 where fu.idpessoa = t.idpessoa
                                                   and fu.ativo = ''S'' ) ' ;
                  --
                  if :P716_FILIAL != -1 then
                    if :P716_FILIAL = -10 then
                      v_where := v_where || ' and ' || 
                           'exists (select 1
                                      from catal.filiais f
                                     where f.idfilial = t.idfilial
                                       and f.regional = 1)' ;
                    elsif :P716_FILIAL = -20 then
                      v_where := v_where || ' and ' || 
                           'exists (select 1
                                      from catal.filiais f
                                     where f.idfilial = t.idfilial
                                       and f.regional = 2)' ;
                    elsif :P716_FILIAL = -30 then
                      v_where := v_where || ' and ' || 
                           'exists (select 1
                                      from catal.filiais f
                                     where f.idfilial = t.idfilial
                                       and f.regional = 3)' ;
                    elsif :P716_FILIAL = -40 then
                      v_where := v_where || ' and ' || 
                           'exists (select 1
                                      from catal.filiais f
                                     where f.idfilial = t.idfilial
                                       and f.regional = 4)' ;
                    elsif :P716_FILIAL = -50 then
                      v_where := v_where || ' and ' || 
                           'exists (select 1
                                      from catal.filiais f
                                     where f.idfilial = t.idfilial
                                       and f.regional = 5)' ;
                    else
                      v_where := v_where || ' and ' || 
                           't.idfilial = '|| v('P716_FILIAL');
                    end if;
                
                  end if;
                  --
                  if :P716_DISTRIBUIDOR != -1 then 
                    v_where := v_where || ' and ' ||
                           't.idrepresentante = ' ||v('P716_DISTRIBUIDOR');
                  end if;
                  --
                  if :P716_IDCATEGORIA is not null then 
                    v_where := v_where || ' and ' ||
                           't.idcategoriaclube = ' ||v('P716_IDCATEGORIA');
                  end if;
                  --
                  if :P716_CPF is not null then 
                    v_where := v_where || ' and ' ||
                           't.cpf = ' || ''''|| v('P716_CPF') || '''';
                  end if;
                  --
                  if :P716_SITUACAO_CONSULTORA = 'A' then
                    v_where := v_where || ' and ' || 't.ativo = ''S'' ';
                  end if;
                  --
                  if :P716_SITUACAO_CONSULTORA = 'I' then
                    v_where := v_where || ' and ' || 't.ativo = ''N'' ';
                  end if;
                  --
                  v_where := v_where || ' and ' || 't.ididioma = ' || '''' || v('P716_IDPAIS') || '''';
                  --
                  IF :P716_POSSUIDIVIDA = 'S' THEN
                    v_where := v_where || ' and roman.pck_util.fnc_debito_vendedora(t.idvendedora) > 0';
                  ELSIF :P716_POSSUIDIVIDA = 'N' THEN
                    v_where := v_where || ' and roman.pck_util.fnc_debito_vendedora(t.idvendedora) = 0';
                  END IF;
                  --
                  v_group := '
                   group by t.distribuidor
                     , t.empreendedora
                     , t.categoria
                     , t.idcategoriaclube
                     , t.idvendedora
                     , t.idpessoa
                     , t.cpf
                     , t.documentoestrangeiro
                     , t.idfilial
                     , t.idrepresentante
                     , t.ativo ';
                  v_order := ' order by categoria asc
                            , pontos desc';
                
                  return (v_select || chr(10) ||
                          v_where  || chr(10) ||
                          v_group  || chr(10) ||
                          v_order );
                
                END;
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
