    region pontuações-agrupado-por-distribuidor (
        name: Pontuações - Agrupado por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                  from(
                SELECT VW.distribuidor
                     , vw.idrepresentante
                     , vw.idcategoriaclube
                     --, VW.CATEGORIA
                     , nvl(count(distinct VW.idvendedora),0) QtdVendedoras 
                FROM roman.vw_detalhamento_pontos VW
                            /* Todas as empresas*/
                where       (    (:P716_FILIAL = -1)
                            /* Todas empresas REGIONAL 1*/
                         or (:P716_FILIAL = -10 and exists (select 1
                                                              from catal.filiais f
                                                             where f.idfilial = vw.idfilial
                                                               and f.regional = 1))
                            /* Todas empresas REGIONAL 2*/
                         or (:P716_FILIAL = -20 and exists (select 1
                                                              from catal.filiais f
                                                             where f.idfilial = vw.idfilial
                                                               and f.regional = 2))
                            /* Todas empresas REGIONAL 3*/
                         or (:P716_FILIAL = -30 and exists (select 1
                                                              from catal.filiais f
                                                             where f.idfilial = vw.idfilial
                                                               and f.regional = 3))
                            /* Todas empresas REGIONAL 4*/
                         or (:P716_FILIAL = -40 and exists (select 1
                                                              from catal.filiais f
                                                             where f.idfilial = vw.idfilial
                                                               and f.regional = 4))
                            /* Todas empresas REGIONAL 5*/
                         or (:P716_FILIAL = -40 and exists (select 1
                                                              from catal.filiais f
                                                             where f.idfilial = vw.idfilial
                                                               and f.regional = 5))
                            /* Somente da filial selecionada em tela*/
                         or (vw.idfilial = :P716_FILIAL ))
                       /* Representante*/
                  and ( :P716_DISTRIBUIDOR = -1 or vw.idrepresentante = :P716_DISTRIBUIDOR )
                       /* Categoria*/
                   and ( :P716_IDCATEGORIA is null or vw.idcategoriaclube = :P716_IDCATEGORIA )
                       /* Sei lá, já estava na página!!*/
                   and :P716_FILTRAR = 'S'
                       /* Situação da vendedora*/
                   and (   ( :P716_SITUACAO_CONSULTORA = 'T')
                        or ( :P716_SITUACAO_CONSULTORA = 'A' and vw.ativo = 'S')
                        or ( :P716_SITUACAO_CONSULTORA = 'I' and vw.ativo = 'N'))
                   ----- tratamento para pegar apenas distribuidores da filial informada no filtro
                   -- é a mesma query usada no list :P716_DISTRIBUIDOR
                   and vw.idrepresentante in ( select r.idrepresentante
                                              from catal.representantes r
                                                 , catal.pessoas p
                                             where /* Liga Tebala Pessoas e Representantes*/
                                                   p.idpessoa = r.idpessoa
                                                   /* Representante Ativo*/
                                               --and r.ativo = 'S'
                                                   /* Filtra representante por filial e Regional*/
                                                        /* Todos os representates*/
                                               and (    (:P716_FILIAL = -1) 
                                                        /* Representantes das filiais REGIONAL 1*/
                                                     or (:P716_FILIAL = -10 and  exists (select f.idfilial 
                                                                                           from catal.filiais f
                                                                                          where f.idfilial = r.idfilial
                                                                                            and f.tipofilial = 'D'
                                                                                            and f.ativo = 'S'
                                                                                            and f.regional = 1)) 
                                                        /* Representantes das filiais REGIONAL 2*/
                                                     or (:P716_FILIAL = -20 and  exists (select f.idfilial 
                                                                                           from catal.filiais f
                                                                                          where f.idfilial = r.idfilial
                                                                                            and f.tipofilial = 'D'
                                                                                            and f.ativo = 'S'
                                                                                            and f.regional = 2))
                                                        /* Representantes das filiais REGIONAL 3*/
                                                     or (:P716_FILIAL = -30 and  exists (select f.idfilial 
                                                                                           from catal.filiais f
                                                                                          where f.idfilial = r.idfilial
                                                                                            and f.tipofilial = 'D'
                                                                                            and f.ativo = 'S'
                                                                                            and f.regional = 3))
                                                        /* Representantes das filiais REGIONAL 4*/
                                                     or (:P716_FILIAL = -40 and  exists (select f.idfilial 
                                                                                           from catal.filiais f
                                                                                          where f.idfilial = r.idfilial
                                                                                            and f.tipofilial = 'D'
                                                                                            and f.ativo = 'S'
                                                                                            and f.regional = 4))
                                                        /* Representantes das filiais REGIONAL 5*/
                                                     or (:P716_FILIAL = -50 and  exists (select f.idfilial 
                                                                                           from catal.filiais f
                                                                                          where f.idfilial = r.idfilial
                                                                                            and f.tipofilial = 'D'
                                                                                            and f.ativo = 'S'
                                                                                            and f.regional = 5))
                                                        /* Somente os representantes da filial selecionada em tela*/
                                                     or (r.idfilial = :P716_FILIAL)))
                   -----
                 group by VW.distribuidor
                        , vw.idrepresentante
                        , vw.idcategoriaclube
                        --, VW.CATEGORIA
                 order by VW.distribuidor
                        , vw.idcategoriaclube)
                           PIVOT
                            (
                            sum(QtdVendedoras) as QtdVendedoras
                            --for CATEGORIA in ('Nenhum', '1 Estrela','2 Estrelas','3 Estrelas','4 Estrelas','5 Estrelas','Superstar')
                            for IDCATEGORIACLUBE in ( 7,8,9,10,11,12,14 ) -- alterado para pegar pelo ID pois pela descricao estava falhando na contagem
                            )
                            order by distribuidor
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P716_TIPOREL
            value: A
        }
        componentAppearance {
            showNullValuesAs: 0
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 371575043955912615
        }

