    pageItem P716_FILIAL (
        type: selectList
        label {
            label: <b>Filial:</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                    select nome 
                         , idfilial
                      from roman.vw_filiais f
                     where f.tipofilial = 'D'
                       and f.ativo = 'S'
                       and f.ididioma = :P716_IDPAIS
                       and roman.pck_util.fnc_verificaacesso(3308,v('APP_USER')) = 'S' -- (Parâmetro criado para controlar a exibição de todas as empresas ao usuário logado na página 716.)
                     union
                    select '- Todas -' nome /*Todos para usuários listados no parametro 3308*/
                         , -1 idfilial
                      from dual
                     where roman.pck_util.fnc_verificaacesso(3308,v('APP_USER')) = 'S' 
                union
                    -- regional 1
                    select initcap(nvl(p.apelido, p.nomepessoa)) nome
                         , f.idfilial
                      from catal.pessoas p
                         , catal.filiais f
                     where p.idpessoa = f.idpessoa
                       and f.tipofilial = 'D'
                       and f.ativo = 'S'
                       and f.regional = 1
                       and f.ididioma = :P716_IDPAIS
                       and favorita.pck_util_fav.fnc_verificagrupoatendimento(90, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                     union
                    select 'Regional 1' nome /*Todas emp do Regional 1*/
                         , -10 idfilial
                      from dual
                    where favorita.pck_util_fav.fnc_verificagrupoatendimento(90, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                union
                -- regional 2
                    select initcap(nvl(p.apelido, p.nomepessoa)) nome
                         , f.idfilial
                      from catal.pessoas p
                         , catal.filiais f
                     where p.idpessoa = f.idpessoa
                       and f.tipofilial = 'D'
                       and f.ativo = 'S'
                       and f.regional = 2
                       and f.ididioma = :P716_IDPAIS
                       and favorita.pck_util_fav.fnc_verificagrupoatendimento(91, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                     union
                    select 'Regional 2' nome /*Todas emp do Regional 2*/
                         , -20 idfilial
                      from dual
                     where favorita.pck_util_fav.fnc_verificagrupoatendimento(91, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                union
                    -- regional 3
                    select initcap(nvl(p.apelido, p.nomepessoa)) nome
                         , f.idfilial
                      from catal.pessoas p
                         , catal.filiais f
                     where p.idpessoa = f.idpessoa
                       and f.tipofilial = 'D'
                       and f.ativo = 'S'
                       and f.regional = 3
                       and f.ididioma = :P716_IDPAIS
                       and favorita.pck_util_fav.fnc_verificagrupoatendimento(92, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                     union
                    select 'Regional 3' nome /*Todas emp do Regional 3*/
                         , -30 idfilial
                      from dual
                     where favorita.pck_util_fav.fnc_verificagrupoatendimento(92, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                union
                  -- regional 4
                  select initcap(nvl(p.apelido, p.nomepessoa)) nome
                     , f.idfilial
                    from catal.pessoas p
                     , catal.filiais f
                   where p.idpessoa = f.idpessoa
                     and f.tipofilial = 'D'
                     and f.ativo = 'S'
                     and f.regional = 4
                     and f.ididioma = :P716_IDPAIS
                     and favorita.pck_util_fav.fnc_verificagrupoatendimento(93, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                     union
                    select 'Regional 4' nome /*Todas emp do Regional 4*/
                         , -40 idfilial
                      from dual
                     where favorita.pck_util_fav.fnc_verificagrupoatendimento(93, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                union
                  -- regional 5
                  select initcap(nvl(p.apelido, p.nomepessoa)) nome
                     , f.idfilial
                    from catal.pessoas p
                     , catal.filiais f
                   where p.idpessoa = f.idpessoa
                     and f.tipofilial = 'D'
                     and f.ativo = 'S'
                     and f.regional = 5
                     and f.ididioma = :P716_IDPAIS
                     and favorita.pck_util_fav.fnc_verificagrupoatendimento(94, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                     union
                    select 'Regional 5' nome 
                         , -50 idfilial
                      from dual
                     where favorita.pck_util_fav.fnc_verificagrupoatendimento(94, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                union
                  select nome
                       , idfilial
                    from roman.vw_filiais f
                   where f.tipofilial = 'D'
                     and f.ativo = 'S'
                     and f.idfilial = :P716_FILIAL_USUARIO
                     and f.ididioma = :P716_IDPAIS
                
                ```
        }
        cascadingLov {
            parentItems: P716_IDPAIS
            itemsToSubmit: P716_IDPAIS
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

