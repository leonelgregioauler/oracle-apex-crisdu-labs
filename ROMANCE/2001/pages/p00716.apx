    region pontuações-resumido (
        name: Pontuações - Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                 
                 v_select_1 varchar2(4000);
                 v_select_2 varchar2(4000);
                 v_where  varchar2(4000);
                 v_where_2 varchar2(4000);
                 v_group  varchar2(4000);
                 v_order  varchar2(1000);
                
                BEGIN
                  
                  v_select_1 := 
                    ' select c.idcategoriaclube ' ||
                    ' , c.nomecategoria ' ||
                    ' , nvl(wp.pontos,0) pontos ' ||
                    ' , nvl(wp.qtdvend,0) QtdVendedoras ' ||
                    ' from roman.categoriasclubes c ' ||
                    ' ,( ';
                  --
                  v_select_2 := 
                    ' select t.idcategoriaclube ' ||
                    ', sum( t.pontos) pontos ' ||
                    ', count( distinct t.idvendedora) qtdvend ' ||
                    ' from roman.vw_detalhamento_pontos t ' ;
                  --
                  v_where := 'where ''S'' ' || ' = '|| '''' || v('P716_FILTRAR') ||'''' ;
                  v_where := v_where ||
                               ' and not exists  (select 1
                                from representantes r
                               where r.idpessoa = t.idpessoa
                                 and r.idrepresentante = t.idrepresentante) ' ;
                  --
                  if :P716_FILIAL != -1 then
                    if :P716_FILIAL = -10 then
                      v_where := v_where || ' and ' || 
                           'exists (select 1
                                      from catal.filiais f
                                     where f.idfilial = t.idfilial
                                       and f.regional = 1)' ;
                    elsif :P716_FILIAL = -20 then
                      v_where := v_where || ' and ' || 
                           'exists (select 1
                                      from catal.filiais f
                                     where f.idfilial = t.idfilial
                                       and f.regional = 2)' ;
                    elsif :P716_FILIAL = -30 then
                      v_where := v_where || ' and ' || 
                           'exists (select 1
                                      from catal.filiais f
                                     where f.idfilial = t.idfilial
                                       and f.regional = 3)' ;
                    elsif :P716_FILIAL = -40 then
                      v_where := v_where || ' and ' || 
                           'exists (select 1
                                      from catal.filiais f
                                     where f.idfilial = t.idfilial
                                       and f.regional = 4)' ;
                    elsif :P716_FILIAL = -50 then
                      v_where := v_where || ' and ' || 
                           'exists (select 1
                                      from catal.filiais f
                                     where f.idfilial = t.idfilial
                                       and f.regional = 5)' ;
                    else
                      v_where := v_where || ' and ' || 
                           't.idfilial = '|| v('P716_FILIAL');
                    end if;
                
                  end if;
                  --
                  if :P716_DISTRIBUIDOR != -1 then 
                    v_where := v_where || ' and ' ||
                           't.idrepresentante = ' ||v('P716_DISTRIBUIDOR');
                  end if;
                  --
                  if :P716_IDCATEGORIA is not null then 
                    v_where := v_where || ' and ' ||
                           't.idcategoriaclube = ' ||v('P716_IDCATEGORIA');
                  end if;
                  --
                  if :P716_SITUACAO_CONSULTORA = 'A' then
                    v_where := v_where || ' and ' || 't.ativo = ''S'' ';
                  end if;
                  --
                  if :P716_SITUACAO_CONSULTORA = 'I' then
                    v_where := v_where || ' and ' || 't.ativo = ''N'' ';
                  end if;
                  --
                  v_where := v_where || ' and ' || 't.ididioma = ' || '''' || v('P716_IDPAIS') || '''';
                  --
                  v_where_2 := ') wp where c.idcategoriaclube = wp.idcategoriaclube(+)';
                  --
                  v_group := ' group by t.idcategoriaclube ';
                  --
                  return (v_select_1 || chr(10) ||
                          v_select_2 || chr(10) ||
                          v_where    || chr(10) ||
                          v_group    || chr(10) ||
                          v_where_2);
                
                END;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
