        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 2432137243459257114
        }

