page 742 (
    name: Históricos de Franquia
    title: Históricos de Franquia
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 65%
        height: 50%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region históricos-de-franquia (
        name: Históricos de Franquia
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P742_DATAHISTORICO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @históricos-de-franquia
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATAHISTORICO
            used: always
        }
        default {
            type: expression
            plsqlExpression: to_char(systimestamp,'dd/mm/rrrr hh24:mi:ss')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P742_IDCONTROLECONTATOSSITE (
        type: displayOnly
        label {
            label: Nr. Protocolo
            alignment: left
        }
        layout {
            sequence: 20
            region: @históricos-de-franquia
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTROLECONTATOSSITE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P742_IDHISTORICOFRANQUIASETOR (
        type: hidden
        layout {
            sequence: 10
            region: @históricos-de-franquia
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDHISTORICOFRANQUIASETOR
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P742_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @históricos-de-franquia
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: expression
            plsqlExpression: :P0_IDUSUARIO
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P742_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 50
            region: @históricos-de-franquia
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 143
            height: 7
        }
        validation {
            maxLength: 1000
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P742_IDHISTORICOFRANQUIASETOR
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: never
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 2979075655160028505
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process fetch-row-from-historicosfranquiasetor (
        name: Fetch Row from HISTORICOSFRANQUIASETOR
        type: autoRowFetch
        source {
            tableName: HISTORICOSFRANQUIASETOR
            pkColumn: IDHISTORICOFRANQUIASETOR
            pkItem: P742_IDHISTORICOFRANQUIASETOR
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 2979074075645028506
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P742_IDHISTORICOFRANQUIASETOR is null then
                        select "#OWNER#"."SEQ_IDHISTFRANQUIASETOR".nextval
                          into :P742_IDHISTORICOFRANQUIASETOR
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2979074488018028506
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-historicosfranquiasetor (
        name: Process Row of HISTORICOSFRANQUIASETOR
        type: autoRowProcessing
        target {
            tableName: HISTORICOSFRANQUIASETOR
            pkColumn: IDHISTORICOFRANQUIASETOR
            pkItem: P742_IDHISTORICOFRANQUIASETOR
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 2979074873888028506
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 2979075209422028506
        }
    )

    branch (
        name: Volta para 172
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 172
                items: {
                    P172_IDCONTROLECONTATOSSITE: &P742_IDCONTROLECONTATOSSITE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,CREATE
        }
    )

)

