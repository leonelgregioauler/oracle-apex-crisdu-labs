page 702 (
    name: Novo Motivo Painel Leads
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region novo-motivo-painel-leads (
        name: Novo Motivo Painel Leads
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P702_IDMOTIVOPAINELLEADS (
        type: hidden
        layout {
            sequence: 10
            region: @novo-motivo-painel-leads
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P702_MOTIVO (
        type: textField
        label {
            label: Motivo
            alignment: left
        }
        layout {
            sequence: 20
            region: @novo-motivo-painel-leads
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P702_TIPO (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Conclusão;C,Devolução ;D
        }
        layout {
            sequence: 30
            region: @novo-motivo-painel-leads
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 10
            region: @novo-motivo-painel-leads
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @novo-motivo-painel-leads
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process insere-novo-motivo (
        name: Insere novo motivo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 
                 vidmotivopainelleads number := :P702_IDMOTIVOPAINELLEADS;
                 vmotivo              varchar2(100) := :P702_MOTIVO;
                 vtipo                varchar2(1) := :P702_TIPO;
                 voperacao_dml        varchar2(1) := 'I';
                 vmd5                 varchar(32767) := null;
                
                
                begin
                
                pck_cadastros_rmc.prc_motivospainelleads(pidmotivopainelleads => vidmotivopainelleads,
                                                           pmotivo => vmotivo,
                                                           ptipo => vtipo,
                                                           pmd5 => vmd5,
                                                           poperacao_dml => voperacao_dml);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1503265973311338327
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 700
                action: resetPagination
            }
        }
    )

)

