    process formas-pagto-despesas-save-interactive-grid-data (
        name: Formas Pagto Despesas - Save Interactive Grid Data
        type: executeCode
        editableRegion: @formas-pagto-despesas
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  --
                  v_nomecol varchar2(50);
                  v_valor   number;
                  --
                BEGIN
                  --
                  -- fazer as validacoes aqui e em caso de falha, atribui 1 para v_controle
                  --
                  v_nomecol := 'COL_'||v('APP_USER');
                  v_valor   := to_number(replace(:VALOR,'.',''));
                  --
                  IF :TIPOPAGAMENTO = 'B' and :IDCONTACORRENTE IS NULL then
                    raise_application_error(-20001,'Para Tipo Pagamento=Banco, obrigatório informar Conta Corrente');
                  END IF;
                  --
                  IF :APEX$ROW_STATUS = 'C' then -- Create
                    --
                    apex_collection.add_member( p_collection_name => v_nomecol
                                              , p_c001            => :IDDESPESA
                                              , p_c002            => :IDSAIDA
                                              , p_c003            => :TIPOLANCAMENTO
                                              , p_c004            => :TIPOPAGAMENTO
                                              , p_c005            => :IDFORMAPAGAMENTO
                                              , p_c006            => v_valor
                                              , p_c007            => :IDCONTACORRENTE
                                              , p_c008            => :IDDESPESAFORMAPAG);
                    --
                  END IF;
                  --
                  IF :APEX$ROW_STATUS = 'U' then -- Update
                    apex_collection.update_member( p_collection_name => v_nomecol
                                                 , p_seq             => :SEQ_ID
                                                 , p_c001            => :IDDESPESA
                                                 , p_c002            => :IDSAIDA
                                                 , p_c003            => :TIPOLANCAMENTO
                                                 , p_c004            => :TIPOPAGAMENTO
                                                 , p_c005            => :IDFORMAPAGAMENTO
                                                 , p_c006            => v_valor
                                                 , p_c007            => :IDCONTACORRENTE
                                                 , p_c008            => :IDDESPESAFORMAPAG);
                  END IF;
                  --
                  IF :APEX$ROW_STATUS = 'D' then -- Delete
                
                    delete from despesasformaspag
                    where iddespesaformapag = :IDDESPESAFORMAPAG;
                
                    apex_collection.delete_member( p_collection_name => v_nomecol,
                                                   p_seq             => :SEQ_ID);
                  END IF;
                  --
                  select sum(C006)  --VALOR
                    into :P777_VALORTOTAL -- :AI_VALORFP
                    from apex_collections ac
                   where collection_name = v_nomecol;
                  --
                  --
                END;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Dados Salvos!
        }
        advanced {
            executionMappingIdentifier: 379711453866136413
        }
    )

    process mostradados (
        name: MostraDados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  v_nomecol varchar2(50);
                  v_query   varchar2(4000);
                  --
                begin
                  --
                  v_nomecol := 'COL_'||v('APP_USER');
                  --
                  -- Primeiro exclui a collection caso exista, para depois recriar.
                  -- se for uma alteração da despesa ou saida, entao cria a collection através de query, senão cria uma comum
                  --
                  if apex_collection.collection_exists ( v_nomecol ) then
                    --
                    apex_collection.delete_collection ( v_nomecol );
                    --
                  end if;
                  --
                  if :P777_IDDESPESA is not null or :P777_IDSAIDA is not null then
                    --
                    v_query :=
                        ' select iddespesa
                               , idsaida
                               , tipolancamento
                               , tipopagamento
                               , idformapagamento
                               , valor
                               , idcontacorrente
                               , iddespesaformapag
                            from despesasformaspag';
                
                    if :P777_TIPO = 'D' then -- Despesa
                      --
                      v_query := v_query || ' where iddespesa = ' || :P777_IDDESPESA;
                      --
                    else -- Saida
                      --
                      v_query := v_query || ' where idsaida = ' || :P777_IDSAIDA;
                      --
                    end if;
                    --
                    apex_collection.create_collection_from_query ( p_collection_name => v_nomecol,
                                                                   p_query           => v_query);
                    --
                  else
                    --
                    apex_collection.create_collection ( p_collection_name => v_nomecol );
                    --
                  end if;
                  -- 
                  -- Popula campo idrazaosocialfilial 
                  begin
                    select C001
                      into :P777_IDRAZAOSOCIALFILIAL
                      from apex_collections c
                     where c.collection_name = 'COL_RAZAOSOCIAL';
                  exception
                    when no_data_found 
                      then null;
                  end;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 379661669067591839
        }
    )

    branch (
