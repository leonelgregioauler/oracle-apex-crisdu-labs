    region formas-pagto-despesas (
        name: Formas Pagto Despesas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ac.seq_id
                     , C001 IDDESPESA
                     , C002 IDSAIDA
                     , C003 TIPOLANCAMENTO
                     , C004 TIPOPAGAMENTO
                     , C005 IDFORMAPAGAMENTO
                     , C006 VALOR
                     , C007 IDCONTACORRENTE
                     , C008 IDDESPESAFORMAPAG
                  from apex_collections ac
                 where collection_name = 'COL_'||v('APP_USER');
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: FORMASPAG
        }
        headerAndFooter {
            headerText: <b>Atenção:</b> As alterações feitas nessa tela só serão efetivamente salvas após clicar em "Salvar" na tela de Despesa ou Saída
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            showTotalCount: false
        }
        toolbar {
            controls: [
                actionsMenu
                saveButton
            ]
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
        }
        download {
            formats: csv
            csvSeparator: ;
            filename: PagamentosDespesas
        }
        heading {
