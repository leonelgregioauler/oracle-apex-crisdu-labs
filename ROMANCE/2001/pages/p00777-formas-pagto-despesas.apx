        column IDCONTACORRENTE (
            type: selectList
            heading {
                heading: Conta Corrente
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(b.nomebanco) ||' - AG: '|| 
                           c.agencia ||' - CC: '|| 
                           c.conta ||' - '|| 
                           initcap(c.beneficiario) d --conta_beneficiario 
                         , c.idcontabanc r
                    from contasbancarias c 
                       , pessoas         pf 
                       , bancos          b 
                    where c.idpessoa     = pf.idpessoa 
                      and c.idbanco      = b.idbanco 
                      and c.ativo = 'S' 
                      and c.tipoconta = 'C'
                      and exists (select 1 
                                    from catal.filiais f 
                                   where f.idpessoa = c.idpessoa 
                                     and f.idfilial = :P0_IDFILIAL)
                    ```
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: IDCONTACORRENTE
                dataType: varchar2
            }
            columnFilter {
                enabled: false
            }
            enableUsersTo {
                sort: false
                hide: false
            }
        )

        column IDDESPESA (
            type: hidden
            settings {
                valueProtected: false
