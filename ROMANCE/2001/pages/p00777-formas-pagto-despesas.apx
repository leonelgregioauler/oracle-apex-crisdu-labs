                    ```sql
                    select descricao d
                         , idformapagamento r
                      from formaspagamentos
                     where tipopagamento in (:TIPOPAGAMENTO,'A')
                       and idformapagamento not in ('K','A','X','Y','J','C','E','W','F','G','O','P','R','I','V')
                     order by 1
                    
                    ```
            }
            cascadingLov {
                parentColumns: TIPOPAGAMENTO
