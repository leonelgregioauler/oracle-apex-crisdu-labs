page 228 (
    name: Impressão Pedido
    title: Impressão Pedido
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region imprime (
        name: Imprime
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalidabol number;
                  vpedido number := :P228_IDPEDIDO;
                  vpromissoria varchar2(1) := 'S';
                  vetiqueta varchar2(1);
                begin 
                  --
                  catal.pck_imprime_fav.prc_imprimepedido27 (vpedido ,vpromissoria) ;
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
    )

    pageItem P228_IDPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @imprime
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPEDIDO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

