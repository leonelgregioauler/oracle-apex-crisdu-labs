page 195 (
    name: Lista de Cheques Sem fundo
    title: Lista de Cheques Sem fundo
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region lista-de-cheques-sem-fundo (
        name: Lista de Cheques Sem Fundo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.IDCHEQUE
                     , v('P195_IDFECHAMENTOREPRES') idfechamento
                     , ( select initcap(bb.nomebanco) 
                         from bancos bb
                         where bb.idbanco = c.idbanco )Banco
                     , c.AGENCIA
                     , c.CONTA
                     , c.NRCHEQUE
                     , c.DATAINCLUSAO
                     , pck_romance.fnc_nomerepresentante(c.idrepresentante) Representante
                     , pck_romance.fnc_nomecidade(c.idcidade) cidade
                     , c.VALOR
                     , c.PREDATADO
                     , c.OBSERVACAO
                     , c.DESTINO
                     , decode(c.semfundo, 'S','Sim', 'Não') Semfundo
                     , decode(c.pago, 'S','Sim', 'Não') Pago
                     , ( select nvl(sum(p.valor),0) from cheques2pgto p where p.idcheque = c.idcheque ) valorpago
                     , c.VALOR - ( select nvl(sum(p.valor),0) from cheques2pgto p where p.idcheque = c.idcheque ) saldo
                from CHEQUES2 c
                where c.semfundo = 'S'
                  and idfilial = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum cheque em aberto para este representante.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 270279620979048532
        }

