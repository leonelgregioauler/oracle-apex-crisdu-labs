page 331 (
    name: Cheques de Empréstimos
    title: Cheques de Empréstimos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cheques-de-empreéstimos-em-aberto (
        name: Cheques de Empreéstimos em Aberto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.IDCHEQUE
                     , v('P331_IDFECHAMENTOREPRES') idfechamento
                     , ( select initcap(bb.nomebanco) 
                         from bancos bb
                         where bb.idbanco = c.idbanco )Banco
                     , c.AGENCIA
                     , c.CONTA
                     , c.NRCHEQUE
                     , c.DATAINCLUSAO
                     , pck_romance.fnc_nomerepresentante(c.idrepresentante) Representante
                     , pck_romance.fnc_nomecidade(c.idcidade) cidade
                     , c.VALOR
                     , c.PREDATADO
                     , c.OBSERVACAO
                     , c.DESTINO
                     , decode(c.semfundo, 'S','Sim', 'Não') Semfundo
                     , decode(c.pago, 'S','Sim', 'Não') Pago
                     , ( select nvl(sum(p.valor),0) from cheques2pgto p where p.idcheque = c.idcheque ) valorpago
                     , decode(emprestimo, 'S','Empréstimo') tipo
                from CHEQUES2 c
                where c.emprestimo = 'S'
                  and nvl(c.chequepredatado,'N') = 'N'
                  and c.idrepresentante = :P331_IDREPRESENTANTE
                  and c.valor > ( select nvl(sum(p.valor),0) from cheques2pgto p where p.idcheque = c.idcheque )
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <font color="blue" align="center"><h2> Para Pagamento/Baixa de cheque de empréstimo, favor entrar em contato com a Controladoria.</h2></font>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum cheque em aberto para este distribuidor.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 702763553506859224
        }

