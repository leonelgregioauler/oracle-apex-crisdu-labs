                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @OBSERVACAO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            aggregate sum (
                column: @VALOR
                showGrandTotal: true
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DATA (
            type: datePicker
            heading {
                heading: Data
            }
            layout {
                sequence: 110
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: DATA
                dataType: date
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDRATEIOREQUISICAO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDRATEIOREQUISICAO
