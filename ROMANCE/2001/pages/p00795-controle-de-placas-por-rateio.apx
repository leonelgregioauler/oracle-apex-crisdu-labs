page 795 (
    name: Controle de Placas por Rateio
    alias: CONTROLE-DE-PLACAS-POR-RATEIO
    title: Controle de Placas por Rateio
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
            t-PageBody--noContentPadding
        ]
    }
    dialog {
        width: 50%
        height: 50%
        resizable: false
    }

    region informar-valores-por-placa (
        name: Informar Valores por Placa
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: PLACASRATEIOSREQUISICOES
            whereClause:
                ```sql
                 idrateiorequisicao = :P795_IDRATEIOREQUISICAO
                  and idrequisicaopgto = :P795_IDREQUISICAOPGTO
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3600796063316959836
        }

        savedReport 18003182 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @DATA
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
