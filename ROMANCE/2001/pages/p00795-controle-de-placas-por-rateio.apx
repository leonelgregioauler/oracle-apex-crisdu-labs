                alignment: center
            }
            layout {
                sequence: 90
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: OBSERVACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
