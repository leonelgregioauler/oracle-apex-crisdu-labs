page 233 (
    name: Incluir Correção
    title: Incluir Correção
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fechajanela()
            {
              if (document.getElementById("P233_IDCORRECAONOTAFISCAL").value != '')
                 {
                   window.opener.location.reload();
                   window.close();
                 }
            }
            ```
        executeWhenPageLoads: fechajanela();
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region incluir-correção (
        name: Incluir Correção
        type: staticContent
