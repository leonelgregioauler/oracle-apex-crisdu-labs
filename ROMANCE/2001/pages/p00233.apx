            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 214
                items: {
                    P214_IDNOTAFISCAL: &P233_IDNOTAFISCAL.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @incluir-correção
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P233_IDCORRECAONOTAFISCAL
        }
    )

    process atualizar-situação-transferência (
        name: Atualizar Situação Transferência
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update notasfiscais
                  set situacaofilial = null
                  where idnotafiscal = :P233_IDNOTAFISCAL;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 557352556961611923
        }
    )

    process envia-email (
        name: envia email
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_util.prc_enviaemail(ppara => 'fernando@romancemoda.com.br'
                                         , pcopia => 'edimilson@romancemoda.com.br'
                                         , passunto => '[CORRECAO DE TRANSFERENCIA] '||:P214_DOCUMENTO||' - '||pck_romance.fnc_nomefilial(:P214_IDFILIALEMITENTE)
                                         , ptexto => 'O usuário '||v('APP_USER')||' está efetuando uma correcao de transferência de mercadoria. <br>Motivo:'||:P233_MOTIVO );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 578556766883291173
        }
        serverSideCondition {
            type: never
        }
    )

    process fetch-row-from-correcoesnotasfiscais (
        name: Fetch Row from CORRECOESNOTASFISCAIS
        type: autoRowFetch
        source {
            tableName: CORRECOESNOTASFISCAIS
            pkColumn: IDCORRECAONOTAFISCAL
            pkItem: P233_IDCORRECAONOTAFISCAL
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 557347587404553837
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P233_IDCORRECAONOTAFISCAL is null then
                        select "SEQ_IDCORRECAONOTAFISCAL".nextval
                          into :P233_IDCORRECAONOTAFISCAL
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 557347780437553841
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-correcoesnotasfiscais (
        name: Process Row of CORRECOESNOTASFISCAIS
        type: autoRowProcessing
        target {
            tableName: CORRECOESNOTASFISCAIS
            pkColumn: IDCORRECAONOTAFISCAL
            pkItem: P233_IDCORRECAONOTAFISCAL
            supportedOperations: insert
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Correção efetuada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 557347966412553841
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
