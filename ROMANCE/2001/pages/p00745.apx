page 745 (
    name: Consultoras Retiradas do SPC
    title: Consultoras Retiradas do SPC
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 50%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region consultoras-retiradas-do-spc (
        name: Consultoras Retiradas do SPC
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct v.idvendedora "ID Site"
                     , initcap(p.nomepessoa) "Consultora"
                     , p.cpf "CPF"
                     , decode(v.spc,'S','Sim','Não') "SPC"
                     , v.dataretiradaspc "Data Retirada do SPC"
                     , ( select max(np.datanegociacao)
                         from negociacoesparceiros np
                         where np.idvendedora = v.idvendedora ) "Data maior Negociação"
                     , ( select max(pp.datapagamento)
                         from pagamentosnotasvendas pp
                            , notasvendas nv
                         where pp.idnotavenda = nv.idnotavenda
                           and nv.idvendedora = v.idvendedora
                           and pp.valorpago > 0 ) "Data Ultimo Pgto"
                     , ( select decode(pn.origem,'R','Distribuidor','C','Cobrança','G','PAP','D','Deb Romance','O','Cobraki')
                         from pagamentosnotasvendas pn
                         where pn.idpagtonotavenda = ( select max(pnv.idpagtonotavenda)
                                                       from pagamentosnotasvendas pnv
                                                          , notasvendas nv
                                                       where nv.idnotavenda = pnv.idnotavenda
                                                         and pnv.valorpago > 0
                                                         and nv.idvendedora = v.idvendedora ) ) "Origem Ult. Pgto"
                from vendedoras v
                   , pessoas p
                where v.spc = 'N'
                  and v.dataretiradaspc is not null
                  and p.cpf is not null
                  and p.idpessoa = v.idpessoa
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2118952477126156335
        }

