    region notas-para-enviar-para-cobrança (
        name: Notas para Enviar para Cobrança
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda id
                     , to_number(nv.numeronota) nro
                     , nv.datanota
                     , nv.semanacobranca "Cobrança"
                     , pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) "Vendedora"
                     , pck_romance.fnc_nomeregiaovenda(nv.idregiaovenda) "Região"
                     , nv.saldo
                     , trunc(nv.dataacerto) dataacerto  
                     , trunc(nvl(dataretorno, datanota+42))+60 prazo
                     , ( select max(trunc(datapagamento))
                         from pagamentosnotasvendas p
                         where p.idnotavenda = nv.idnotavenda ) "Ult. Pgto"  
                     , case decode(promissoriarecuperada,'S','N',decode(nv.recuperarpromissoria,'S','S','N'))
                         when 'S' THEN  'Recup Promissória' 
                         else ( select 'Enviar SPC' a 
                                from dual
                                where nv.saldo > 0
                                  and pck_util.fnc_idsemana(trim(to_char(sysdate,'IW/RRRR'))) - pck_util.fnc_idsemana(nv.semanacobranca)>=12-- > trunc(nvl(n.dataretorno,n.datanota+42))+60
                                  and not exists ( select 1
                                                   from pagamentosnotasvendas p
                                                   where pck_util.fnc_idsemana(nv.semanacobranca)- pck_util.fnc_idsemana(p.semanacobranca)>=12 
                                                     and p.idnotavenda = nv.idnotavenda ) )
                             end    "Recup. Promi./Enviar SPC"
                     , decode(nv.enviadocobranca,'S', 'Sim','Não') "Enviado para Cobrança"
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#e2.gif" alt="" /></a>' url
                     , null
                from notasvendas    nv
                where nv.idfilial        = :P0_IDFILIAL
                  and nv.idrepresentante = :P194_IDREPRESENTANTE
                  and nvl(nv.enviadocobranca,'N') = 'N'
                  and nv.idsituacaonotavenda = 4
                  and nv.saldo > 0
                  and trunc(nv.dataretorno) - nvl((select max(trunc(pg.datapagamento))
                                                   from roman.pagamentosnotasvendas pg
                                                   where pg.idnotavenda = nv.idnotavenda),trunc(nv.dataretorno)-42) > 40
                  
                  
                ```
        }
