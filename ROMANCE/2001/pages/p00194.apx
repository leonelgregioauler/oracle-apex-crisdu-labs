    process enviar-para-cobrança (
        name: Enviar para cobrança
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vsemana varchar2(15);
                  --
                begin
                  --
                  update notasvendas n
                  set n.enviadocobranca = 'S'
                  where idnotavenda = :P194_IDNOTAVENDA;
                  --
                  select pck_util.fnc_semanaid(pck_util.fnc_idsemanadata(sysdate)) semana
                  into vsemana
                  from dual;
                  --
                  insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao)
                  values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Nota enviada para o setor de cobrança na semana: '||vsemana,:P194_IDNOTAVENDA,'C');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Nota Enviada para a Cobrança!
        }
        advanced {
            executionMappingIdentifier: 32725334698186705
        }
        serverSideCondition {
            type: request=Value
            value: ENVIARCOBRANCA
        }
    )

)

