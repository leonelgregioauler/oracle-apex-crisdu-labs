page 601 (
    name: Clientes com Débitos
    title: Clientes com Débitos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region clientes-com-débito (
        name: Clientes com Débito
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) consultora
                     , v.idvendedora "ID Site"
                     , decode(v.ativo,'S','Ativo','N','Inativo') ativo
                     , p.cpf cpf
                     , pck_romance.fnc_retornatelefones(v.idvendedora) telefones
                     , nvl(( select sum(vs.saldoatualizado)
                             from vw_debitos_vendedora_bee_v2 vs
                             where vs.idvendedora = v.idvendedora ),0) saldoatualizado
                     , ( select max(t.datainclusao)
                         from favorita.tarefas t
                         where t.idpessoa = p.idpessoa ) ultimatarefa
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and ( :P601_IDFILIAL is null or v.idfilial = :P601_IDFILIAL )
                  and exists ( select 1
                               from negociacoesparceiros np
                               where np.idvendedora = v.idvendedora
                                 and np.origem      = 'B'
                                 and trunc(np.datanegociacao) between to_date(:P601_DATAINICIO) and to_date(:P601_DATAFIM) 
                                 and np.formapagamento = :P601_TIPO_NEGOCIACAO )
                order by 1 
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado! Verifique os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 5197224655053429401
        }

        column ATIVO (
            type: plainText
            heading {
                heading: Situação Vend.
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column CPF (
            type: plainText
            heading {
                heading: Cpf
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column "ID Site" (
            type: plainText
            heading {
                heading: ID Site
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column SALDOATUALIZADO (
            type: plainText
            heading {
                heading: Saldo Atualizado
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column TELEFONES (
            type: plainText
            heading {
                heading: Telefones
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column ULTIMATAREFA (
            type: plainText
            heading {
                heading: Ultima Tarefa
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 52024201 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATIVO (
                sequence: 3
            )

            displayColumn CONSULTORA (
                sequence: 1
            )

            displayColumn CPF (
                sequence: 4
            )

            displayColumn "ID Site" (
                sequence: 2
            )

            displayColumn SALDOATUALIZADO (
                sequence: 6
            )

            displayColumn TELEFONES (
                sequence: 5
            )

            displayColumn ULTIMATAREFA (
                sequence: 7
            )

            filter ir-condition (
                column: SALDOATUALIZADO
                operator: >
                value: 0
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P601_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P601_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P601_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo != 5
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P601_TIPO_NEGOCIACAO (
        type: radioGroup
        label {
            label: Tipo de Negociação
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Depósito;D,Boleto;B,Cartão de Crédito;C,Pix;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 601
                items: {
                    P601_IDFILIAL: &P601_IDFILIAL.
                    P601_TIPO_NEGOCIACAO: &P601_TIPO_NEGOCIACAO.
                    P601_DATAINICIO: &P601_DATAINICIO.
                    P601_DATAFIM: &P601_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

