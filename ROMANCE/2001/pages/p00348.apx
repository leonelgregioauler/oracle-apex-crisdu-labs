page 348 (
    name: Imprimir Notas enviadas para Cobrança
    title: Imprimir Notas enviadas para Cobrança
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region imprime (
        name: Imprime
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_imprime.prc_imprimenotasenviadascob(pidrepresentante => :P348_IDREPRESENTANTE,
                                                          pidregiaovenda => :P348_IDREGIAOVENDA);
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
    )

    pageItem P348_IDREGIAOVENDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @imprime
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P348_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @imprime
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

