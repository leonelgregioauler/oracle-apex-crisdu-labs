page 83 (
    name: Confirmar Despesas
    title: Confirmar Despesas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region despesas-programadas (
        name: Despesas Programadas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDDESPESA",
                "IDCONTACONTABIL",
                "OBSERVACAO",
                "VALOR",
                "IDSUBCONTACONTABIL",
                "DATAVENCIMENTO",
                "IDFILIAL",
                idfechamento
                from "#OWNER#"."DESPESAS"
                where idfechamento is null
                  and idfilial = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (nulo)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Não há despesas para confirmar.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 9
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column DATAVENCIMENTO (
            reportColumnQueryId: 6
            derivedColumn: N
            type: datePicker
            heading {
                heading: Data Vencimento
            }
            layout {
                sequence: 6
            }
            appearance {
                width: 10
            }
        )

        column IDCONTACONTABIL (
            reportColumnQueryId: 2
            derivedColumn: N
            type: selectList
            heading {
                heading: Conta
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(c.nomeconta) display_value
                         , c.idcontafinan
                    from contasfinanceiras c
                    where nvl(centrodecusto,'N') = 'N'
                    order by 1
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 4
            }
        )

        column IDDESPESA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDDESPESAS
            }
        )

        column IDFECHAMENTO (
            reportColumnQueryId: 8
            derivedColumn: N
            type: selectList
            heading {
                heading: Confirmar
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select fs.semana DISPLAY_VALUE
                    , fs.idfechamento RETURN_VALUE
                    from fechamentossemanais fs
                    where fs.idfilial = :P0_IDFILIAL
                    AND fs.concluido = 'N'
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 9
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 7
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Filial
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                         , f.idfilial return_value
                    from filiais    f
                       , pessoas    p
                    where f.idpessoa  = p.idpessoa
                    ```
            }
            layout {
                sequence: 3
            }
        )

        column IDSUBCONTACONTABIL (
            reportColumnQueryId: 5
            derivedColumn: N
            type: selectList
            heading {
                heading: Sub Conta
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(c.nomeconta) display_value
                         , c.idsubcontafinan
                    from subcontasfinanceiras c
                    order by 1
                    ```
                nullDisplayValue: - Selecione a Subconta
            }
            layout {
                sequence: 5
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: textField
            heading {
                heading: Observação
            }
            layout {
                sequence: 8
            }
            appearance {
                width: 50
            }
        )

        column VALOR (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textField
            heading {
                heading: Valor
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
                width: 12
            }
            advanced {
                customAttributes: style="text-align: right;"
            }
        )

    )

    pageItem P83_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @despesas-programadas
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 40
            region: @despesas-programadas
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @despesas-programadas
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 81
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @despesas-programadas
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @despesas-programadas
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation datavencimento-must-be-a-valid-date (
        name: DATAVENCIMENTO must be a valid date
        execution {
            sequence: 60
        }
        validation {
            editableRegion: @despesas-programadas
            type: columnIsAValidDate
            column: DATAVENCIMENTO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser uma data válida.
            associatedColumn: DATAVENCIMENTO
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idcontacontabil-must-be-numeric (
        name: IDCONTACONTABIL must be numeric
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @despesas-programadas
            type: columnIsNumeric
            column: IDCONTACONTABIL
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: IDCONTACONTABIL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idsubcontacontabil-must-be-numeric (
        name: IDSUBCONTACONTABIL must be numeric
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @despesas-programadas
            type: columnIsNumeric
            column: IDSUBCONTACONTABIL
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: IDSUBCONTACONTABIL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation valor-must-be-numeric (
        name: VALOR must be numeric
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @despesas-programadas
            type: columnIsNumeric
            column: VALOR
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: VALOR
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @despesas-programadas
        target {
            tableName: DESPESAS
            pkColumn: IDDESPESA
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Linha(s) #MRD_COUNT# deletadas.
        }
        error {
            errorMessage: Não é possível processar a deleção.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 158232284258623942
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @despesas-programadas
        target {
            tableName: DESPESAS
            pkColumn: IDDESPESA
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Linha(s) #MRU_COUNT# atualizada(s); linha(s) #MRI_COUNT# inserida(s).
        }
        error {
            errorMessage: Não foi possível processar a atualização.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 158232081319623942
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Go To Page 83
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 83
                successMessage: false
            }
        }
    )

)

