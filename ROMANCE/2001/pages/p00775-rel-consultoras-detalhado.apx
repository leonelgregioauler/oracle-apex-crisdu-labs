page 775 (
    name: Rel. Consultoras Detalhado
    alias: REL-CONSULTORAS-DETALHADO
    title: Rel. Consultoras Detalhado
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
