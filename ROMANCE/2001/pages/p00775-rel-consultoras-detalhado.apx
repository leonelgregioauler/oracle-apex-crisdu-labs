    region rel-consultoras-detalhado (
        name: Rel. Consultoras Detalhado
        title: Consultoras Por Distribuidor Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select Filial
                     , Distribuidor
                     , Vendedora
                     , qtd_pedidos_realizados pedidos_realizados
                  from(
                -- Com pedidos
                select t.filial_gerente Filial
                     , t.nome_representante Distribuidor
                     , t.nome_vendedora Vendedora
                     , count(p.idpedido) qtd_pedidos_realizados
                  from roman.vw_vendedoras t
                     , favorita.pedidos p
                 where t.idvendedora = p.idvendedora
                   and trunc(p.dataemissao) between nvl(:p_datainicio,trunc(p.dataemissao)) and nvl(:p_datafim,trunc(p.dataemissao))
                   and p.datacancelamento is null
                   and (:P775_idfilial is null or t.idfilial_gerente = :P775_idfilial)
                   and :P775_FILTRAR = 'S'
                   and (:P775_COMPEDIDOS is null or :P775_COMPEDIDOS = 1 )
                group by t.filial_gerente 
                       , t.nome_representante 
                       , t.nome_vendedora
                --
                union
                --
                -- sem pedidos
                select t.filial_gerente Filial
                     , t.nome_representante Distribuidor
                     , t.nome_vendedora Vendedora
                     , 0 pedidos_realizados
                  from roman.vw_vendedoras t
                 where (:P775_idfilial is null or t.idfilial_gerente = :P775_idfilial)
                   AND :P775_FILTRAR = 'S'
                   and not exists (select 1
                                     from favorita.pedidos p
                                    where trunc(p.dataemissao) between nvl(:p_datainicio,trunc(p.dataemissao)) and nvl(:p_datafim,trunc(p.dataemissao))
                                      and p.datacancelamento is null
                                      and p.idvendedora = t.idvendedora)
                   and (:P775_COMPEDIDOS is null or :P775_COMPEDIDOS = 2 )
                order by 1 asc
                       , 2 asc) t
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        headerAndFooter {
            headerText: Total Consultoras por Distribuidor Detalhado
        }
        serverSideCondition {
            type: item=value
            item: P775_TIPORELATORIO
            value: 1
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 377903287806833727
        }

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column FILIAL (
            type: plainText
            heading {
                heading: Filial
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column PEDIDOS_REALIZADOS (
            type: plainText
            heading {
                heading: Pedidos Realizados
                alignment: end
            }
            layout {
                sequence: 13
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column VENDEDORA (
            type: plainText
            heading {
                heading: Consultora
            }
            layout {
                sequence: 23
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Rel. Consultoras Detalhado
        }

        savedReport 3779052 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DISTRIBUIDOR (
                sequence: 2
            )

            displayColumn FILIAL (
                sequence: 1
            )

            displayColumn PEDIDOS_REALIZADOS (
                sequence: 4
            )

            displayColumn VENDEDORA (
                sequence: 3
            )

            sort (
                column: DISTRIBUIDOR
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: CONSULTORAS
            )

            aggregate (
                column: PEDIDOS_REALIZADOS
            )

            aggregate (
                function: count
                column: VENDEDORA
            )

            controlBreak (
                column: FILIAL
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: DISTRIBUIDOR
                layout {
                    sequence: 2
                }
            )

        )

    )

    region rel-consultoras-resumido (
        name: Rel. Consultoras Resumido
        title: Consultoras Por Distribuidor Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select Filial
                     , Distribuidor
                     , sum(Vendedoras) Vendedoras
                     , sum(qtd_pedidos_realizados) pedidos_realizados
                  from(
                -- Com pedidos
                select t.filial_gerente Filial
                     , t.nome_representante Distribuidor
                     , count(t.idvendedora) Vendedoras
                     , count(p.idpedido) qtd_pedidos_realizados
                  from roman.vw_vendedoras t
                     , favorita.pedidos p
                 where t.idvendedora = p.idvendedora
                   and trunc(p.dataemissao) between nvl(:p_datainicio,trunc(p.dataemissao)) and nvl(:p_datafim,trunc(p.dataemissao))
                   and p.datacancelamento is null
                   and (:P775_idfilial is null or t.idfilial_gerente = :P775_idfilial)
                   and :P775_FILTRAR = 'S'
                   and (:P775_COMPEDIDOS is null or :P775_COMPEDIDOS = 1 )
                group by t.filial_gerente 
                       , t.nome_representante 
                --
                union
                --
                -- sem pedidos
                select t.filial_gerente Filial
                     , t.nome_representante Distribuidor
                     , count(t.idvendedora) Vendedoras
                     , 0 pedidos_realizados
                  from roman.vw_vendedoras t
                 where (:P775_idfilial is null or t.idfilial_gerente = :P775_idfilial)
                   AND :P775_FILTRAR = 'S'
                   and not exists (select 1
                                     from favorita.pedidos p
                                    where trunc(p.dataemissao) between nvl(:p_datainicio,trunc(p.dataemissao)) and nvl(:p_datafim,trunc(p.dataemissao))
                                      --and p.datacancelamento is null
                                      and p.idvendedora = t.idvendedora)
                   and (:P775_COMPEDIDOS is null or :P775_COMPEDIDOS = 2 )
                   group by t.filial_gerente
                          , t.nome_representante
                order by 1 asc
                       , 2 asc) t
                group by Filial
                       , Distribuidor
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        headerAndFooter {
            headerText: Total Consultoras por Distribuidor Resumido
        }
        serverSideCondition {
            type: item=value
            item: P775_TIPORELATORIO
            value: 2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
