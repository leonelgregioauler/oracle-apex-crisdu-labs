page 251 (
    name: Imprime Defeitos
    title: Imprime Defeitos
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region imprime-devolução (
        name: Imprime Devolução
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_imprime.prc_imprimedevolucao_defeitos ( pidrepresentante => :P251_IDREPRESENTANTE
                                                            , psemana          => :P251_SEMANA
                                                            , ptipo            => :P251_TIPO );
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            column: 1
        }
    )

    pageItem P251_IDREPRESENTANTE (
        type: hidden
        layout {
            sequence: 20
            region: @imprime-devolução
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P251_SEMANA (
        type: hidden
        layout {
            sequence: 30
            region: @imprime-devolução
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P251_TIPO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @imprime-devolução
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

