page 637 (
    name: Campanhas de SMS
    title: Campanhas de SMS
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_removesms(piddisparo)
            {
              apex.confirm("Deseja realmente remover o agendamento de SMS?", {
              request:"DELETAR",
              set:{"P637_IDDISPARO":piddisparo}
              });
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region lista-de-sms (
        name: Lista de SMS
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.datainclusao
                     , p.processo
                     , d.mensagem "Mensagem"
                     , count(1) qtd
                     , d.usuario "Usuário Campanha"
                     , '<a href="javascript: fnc_removesms('||m.idmensagemdisparo||');">Remover</a>' remover
                     , (select sum(valoracionado) 
                          from predisparosms 
                         where idmensagemdisparo = m.idmensagemdisparo) "Valor"
                  from mensagenssms m
                     , processossistemas p
                     , mensagensdisparos d
                where m.idprocessosistema in (25,40,41,42,43)
                  and p.idprocessosistema = m.idprocessosistema
                  and m.idmensagemdisparo = d.idmensagemdisparo
                  and ( :P637_SITUACAO is null
                    or ( :P637_SITUACAO = 'P' and m.dataenvio is null )
                    or ( :P637_SITUACAO = 'E' and m.dataenvio is not null ) )
                  and m.datainclusao between to_date(:P637_DATA_INICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS')-1 and to_date(:P637_DATA_FIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')+1
                group by m.datainclusao
                       , m.idmensagemdisparo
                       , p.processo
                       , d.mensagem
                       , d.usuario
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 6121477364441531606
        }

        column DATAINCLUSAO (
            type: plainText
            heading {
                heading: Data de Inclusão
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: A
            }
        )

        column Mensagem (
