    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process alimenta-data (
        name: Alimenta Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  :P637_DATA_INICIO := trunc(sysdate);
                  :P637_DATA_FIM := trunc(sysdate);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 6121477183938531604
        }
        serverSideCondition {
            type: itemIsNull
            item: P637_DATA_INICIO
        }
    )

    process deleta-campanha-programada (
        name: Deleta Campanha programada
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_cadastros_rmc.prc_removecampanhasms(pidmensagemdisparo => :P637_IDDISPARO);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Agendamento de Mensagens cancelado!
        }
        advanced {
            executionMappingIdentifier: 93227994886132841
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    branch (
        name: Go To Page 637
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 637
                items: {
                    P637_IDDISPARO:
                    P637_SITUACAO: &P637_SITUACAO.
                    P637_DATA_INICIO: &P637_DATA_INICIO.
                    P637_DATA_FIM: &P637_DATA_FIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 637
                items: {
                    P637_SITUACAO: &P637_SITUACAO.
                    P637_DATA_INICIO: &P637_DATA_INICIO.
                    P637_DATA_FIM: &P637_DATA_FIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

