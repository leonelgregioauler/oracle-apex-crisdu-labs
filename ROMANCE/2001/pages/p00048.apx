    validation p48-senha (
        name: P48_SENHA2
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from dual
                where :P48_SENHA != :P48_SENHA2
                ```
        }
        error {
            errorMessage: Senha de confirmação está diferente!
            associatedItem: @P48_SENHA2
        }
        serverSideCondition {
            whenButtonPressed: @criar-usuario
        }
    )

    validation p48-senha-2 (
        name: P48_SENHA2
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from dual
                where :P48_SENHA != :P48_SENHA2
                ```
        }
        error {
            errorMessage: Senha de confirmação está diferente!
            associatedItem: @P48_SENHA2
        }
        serverSideCondition {
            whenButtonPressed: @altera-senha
        }
    )

    process alterar-senha (
        name: alterar senha
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  result boolean;
                  verro  varchar2(200);
                begin
                  -- Call the function
                  result := sys.ip_ddl.alter_password(pvnewpassword => :P59_SENHA,
                                                      pvuser => upper(:P59_USUARIO),
                                                      pverror => verro  );
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Senha alterada com sucesso!
        }
        error {
            errorMessage: Problemas ao alterar a senha, contate o administrador!
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 149214775167603246
        }
        serverSideCondition {
            whenButtonPressed: @altera-senha
        }
    )

    process bloquear-usuario (
        name: bloquear usuario
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  result boolean;
                  verro varchar2(300);
                begin
                  -- Call the function
                  result := ip_ddl.account_lock(pvuser => upper(:P59_USUARIO),
                                                pverror => verro );
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Usuário bloqueado com sucesso!
        }
        error {
            errorMessage: Problemas ao bloquear usuário, contate o administrador!
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 149214957761603246
        }
        serverSideCondition {
            whenButtonPressed: @bloquear-usuario
        }
    )

    process criar-usuario (
        name: criar usuario
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  -- Boolean parameters are translated from/to integers: 
                  -- 0/1/null <--> false/true/null 
                  result boolean;
                  verro varchar2(300);
                begin
                  -- Call the function
                  result := ip_ddl.create_user(pvname => :P48_USUARIO
                                              ,pvsenha =>:P48_SENHA
                                              ,pvsistema => '600'
                                              ,pverror => verro);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Usuário criado com sucesso!
        }
        error {
            errorMessage: Problemas ao criar usuário, contate o administrador!
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 149214569142603243
        }
        serverSideCondition {
            whenButtonPressed: @criar-usuario
        }
    )

    process desbloquear-usuario (
        name: desbloquear usuario
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  result boolean;
                verro varchar2(300);
                begin
                  result := ip_ddl.account_unlock(pvuser => upper(:P59_USUARIO),
                                                  pverror => verro);
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Usuário desbloqueado com sucesso!
        }
        error {
            errorMessage: Problemas ao desbloquear usuário, contate o administrador!
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 149215173757603248
        }
        serverSideCondition {
            whenButtonPressed: @desbloquear-usuario
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 48
            }
            saveStateBeforeBranching: true
        }
        comments {
