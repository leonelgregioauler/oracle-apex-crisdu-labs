page 48 (
    name: Controle de Usuários
    title: Controle de Usuários
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region lista-de-usuários (
        name: Lista de Usuários
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select username 
                     , username "Usuário"
                     , decode( account_status , 'LOCKED' , 'Bloqueada'
                                              , 'OPEN'   , 'Ativa' ) "Status da Conta"
                     , lock_date "Data do Bloqueio"
                     , created  "Criada em"
                from dba_users D
                where exists ( select 1 
                               from usuariossistemas u 
                               where u.usuario   = d.username 
                                 and u.idsistema = 1000)
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column "Criada em" (
            type: plainText
            heading {
                heading: Criada Em
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: Criada_em
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Data do Bloqueio" (
            type: plainText
            heading {
                heading: Data Do Bloqueio
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: Data_do_Bloqueio
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Status da Conta" (
            type: plainText
            heading {
                heading: Status Da Conta
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Status_da_Conta
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column USERNAME (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 5
            }
            link {
                target: {
                    page: 50
                    items: {
                        P50_USUARIO: #USERNAME#
                    }
                }
                linkText: <img src="#IMAGE_PREFIX#menu/pencil2_16x16.gif" alt="">
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: USERNAME
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Usuário (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Usuário
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 1434232 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn "Criada em" (
                sequence: 5
            )

            displayColumn "Data do Bloqueio" (
                sequence: 4
            )

            displayColumn "Status da Conta" (
                sequence: 3
            )

            displayColumn USERNAME (
                sequence: 1
            )

            displayColumn "Usuário" (
                sequence: 2
            )

        )

    )

    region usuários (
