    process busca-dados (
        name: Busca dados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                --
                vdataenvio  date;
                vnota       number;
                
                begin
                  --
                  select gb.dataenvio, gb.nronotafiscal
                    into vdataenvio , vnota
                  from roman.guiasentregasbrindes gb 
                  where gb.idguiaentregabrinde = :P808_GUIAENVIO;
                  --
                  :P808_DATAENVIO  := vdataenvio;
                  :P808_NOTA       := vnota;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1803378837426160902
        }
    )

    process processo-insere-data-envio (
        name: Processo insere Data Envio
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vdataenvio date := :P808_DATAENVIO;
                 -- vdataenvio date := to_date((:P808_DATAENVIO),'DD-MM-YYYY HH24:MI:SS');
                  vidguia number  := :P808_GUIAENVIO;
                  vnota number    := :P808_NOTA;
                  --
                begin 
                  --
                  update roman.guiasentregasbrindes gb 
                  set gb.dataenvio = vdataenvio, gb.nronotafiscal = vnota
                  where gb.idguiaentregabrinde = vidguia;
                  --
                  for i in (select cl.idconquistoulevoucupom
                                 , g.dataenvio
                            from roman.conquistoulevoucupons cl
                               , roman.guiasentregascupons gc 
                               , roman.guiasentregasbrindes g
                            where cl.idconquistoulevoucupom = gc.idconquistoulevoucupom
                              and gc.idguiaentregabrinde = g.idguiaentregabrinde 
                              and g.idguiaentregabrinde = vidguia)
                  loop 
                    --
                    update roman.conquistoulevoucupons cl
                    set cl.dataenviofilial = i.dataenvio
                    where cl.idconquistoulevoucupom = i.idconquistoulevoucupom ;
                    
                  end loop;
                  --
                   apex_application.g_print_success_message := '<span style="color : white ">Alteração realizada com sucesso! </span>';
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1803326001826522312
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

    branch (
        name: Go To Page 807
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 806
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
        }
    )

