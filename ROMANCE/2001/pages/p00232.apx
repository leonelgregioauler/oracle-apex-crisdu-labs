    pageItem P232_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) d
                     , idrepresentante r
                from representantes r
                where r.ativo = 'S'
                  and r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: - Todos -
            nullReturnValue: -1
        }
        layout {
            sequence: 30
            region: @tipo-de-depósitos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

