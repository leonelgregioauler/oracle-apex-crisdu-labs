page 232 (
    name: Ligações Feitas para Depósito
    title: Ligações Feitas para Depósito
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatar_mascara(src,mascara,evt){
            var tecla;  
            if(evt.which){tecla = evt.which}
            else if(evt.keyCode){ tecla = evt.keyCode;}  
             if( tecla != 8 ){
             var campo = src.value.length;
             var saida = mascara.substring(0,1);
             var texto = mascara.substring(campo);
             if(texto.substring(0,1) != saida) {
             src.value+=texto.substring(0,1);}}
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region depósitos-confirmados (
        name: Depósitos Confirmados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select dep.iddepositodiarios
                     , pck_romance.fnc_nomerepresentante(dep.idrepresentante) Representante
                     , dep.data  Data_deposito
                     , ( select b.nomebanco from bancos b where b.idbanco = cb.idbanco) Banco
                     , cb.agencia ||', '||cb.conta agencia_conta
                     , initcap(cb.beneficiario) beneficiario
                     , dep.valordeposito Valor_depositado
                     , ( select descricao 
                         from tipospagamentos t
                         where t.codigo = dep.tipo ) tipo
                     , decode(dep.comprovado,'S','Sem Comprovante'
                                            ,'C','Cópia'
                                            ,'M','Em Mãos'
                                            ,'G','Com Gerente') Comprovado
                     , dep.nrocomprovante
                     , dep.observacao
                     , ( select count(1)||' - '||listagg(trim(to_char(dd.valor_digitado,'999G999G999G999G990D00'))||' - '||dd.nroidentificacao_digitado,'; ') within group (order by 1)
                         from depositosdiarios_leituraocr dd
                         where dd.iddepositodiario = dep.iddepositodiarios ) fotos                               
                     , ( select f.semana
                         from fechamentorepresentantes f
                         where f.idfechamentorepres = dep.idfechamentorepres ) Semana 
                     , dep.usuarioconfirmou
                     , dep.dataconfirmacao
                     , pix.chave
                from depositosdiarios_orig dep
                   , contasbancarias cb
                   , chavespix pix
                where dep.idcontabanc   = cb.idcontabanc
                  and pix.idcontabancaria(+) = cb.idcontabanc
                  and dep.idfechamentorepres in ( select f.idfechamentorepres
                                                     from fechamentorepresentantes f
                                                     where f.semana = :P232_SEMANA )
                  and dep.data >= to_date('01/08/2016','DD/MM/RRRR')
                  and ( :P232_IDREPRESENTANTE is null
                        or ( :P232_IDREPRESENTANTE = -1 and exists ( select 1 
                                                                     from representantes r
                                                                     where r.idrepresentante = dep.idrepresentante  
                                                                       and r.idgerente       = ( select idgerente
                                                                                                 from gerentes g
                                                                                                 where g.idfilial = :P0_IDFILIAL ) ) )
                        or ( :P232_IDREPRESENTANTE > 0 and dep.idrepresentante = :P232_IDREPRESENTANTE ) )
                order by 1 desc
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
