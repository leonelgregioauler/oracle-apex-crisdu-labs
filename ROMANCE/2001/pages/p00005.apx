page 5 (
    name: Atualizar Nr Comprovante
    title: Atualizar Nr Comprovante
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region atualizar-nr-comprovante (
        name: Atualizar Nr Comprovante
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P5_IDDEPOSITODIARIOS (
        type: hidden
        layout {
            sequence: 10
            region: @atualizar-nr-comprovante
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDDEPOSITODIARIOS
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P5_NROCOMPROVANTE (
        type: numberField
        label {
            label: Nro Comprovante
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @atualizar-nr-comprovante
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: NROCOMPROVANTE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @atualizar-nr-comprovante
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_IDDEPOSITODIARIOS
        }
    )

    process fetch-row-from-depositosdiarios-orig (
        name: Fetch Row from DEPOSITOSDIARIOS_ORIG
        type: autoRowFetch
        source {
            tableName: DEPOSITOSDIARIOS_ORIG
            pkColumn: IDDEPOSITODIARIOS
            pkItem: P5_IDDEPOSITODIARIOS
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 30233396139081354
        }
    )

    process process-row-of-depositosdiarios-orig (
        name: Process Row of DEPOSITOSDIARIOS_ORIG
        type: autoRowProcessing
        target {
            tableName: DEPOSITOSDIARIOS_ORIG
            pkColumn: IDDEPOSITODIARIOS
            pkItem: P5_IDDEPOSITODIARIOS
            supportedOperations: update
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 30233809900081354
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 30234175625081355
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 75
            }
        }
    )

)

