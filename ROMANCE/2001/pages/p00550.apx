page 550 (
    name: Liberar Próxima Semana
    title: Liberar Próxima Semana
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region em-processamento (
        name: Em processamento
        type: staticContent
        source {
            htmlCode: <FONT color="green" size="6"> Aguarde! Gerando informações para liberar a próxima semana! Mantenha esta janela aberta até o final do processo.(Ela pode ser minimizada!)</font>
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P550_PROCESSAR = 'S'
                ```
        }
    )

    region page_plug (
        name: " "
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region page_plug-2 (
        name: " "
        type: staticContent
        source {
            htmlCode: <FONT color="green"> Processo concluído, execute o atalho "Importar"!</font>
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P550_PROCESSAR
            value: N
        }
    )

    pageItem P550_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @page_plug
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P550_IDGERENTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @page_plug
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P550_IDREGIAOVENDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @page_plug
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P550_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @page_plug
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P550_PROCESSAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @page_plug
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P550_SEMANACOBRANCA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @page_plug
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction submit (
        name: submit
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: item=value
            item: P550_PROCESSAR
            value: S
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SUBMIT
            }
            execution {
                sequence: 10
            }
        )

    )

    validation já-processado (
        name: Já processado
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from controleexportacaonetbook t
                where idrepresentante = :P550_IDREPRESENTANTE
                ```
        }
        error {
            errorMessage: Já está sendo liberado a semana para este representante!
            displayLocation: inlineInNotification
        }
    )

    process gerar-arquivo (
        name: gerar arquivo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   vidfilial number;
                	 vidpostoavancado number;
                begin
                  --
                  select pck_romance.fnc_filialrepresentante(:P550_IDREPRESENTANTE)
                  into vidfilial
                  from dual;
                  -- 
                  select idpostoavancado
                  into vidpostoavancado
                  from representantes
                  where idrepresentante = :P550_IDREPRESENTANTE;
                  --
                  pck_integracao.prc_exportarepresentante(pidrepresentante => :P550_IDREPRESENTANTE,
                                                          pidgerente       => null,
                                                          pidfilial        => null,
                                                          psemanacobranca  => null,
                                                          pidregiaovenda   => null);
                  --
                  delete controleexportacaonetbook 
                  where idrepresentante = :P550_IDREPRESENTANTE;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 1495072064048047239
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from controleexportacaonetbook t
                where idrepresentante = :P550_IDREPRESENTANTE
                  and not exists ( select 1
                                   from parametros p
                                   where p.idfilial = pck_romance.fnc_filialrepresentante(:P550_IDREPRESENTANTE) 
                                     and nome       = 'DATAIMPLANTACAOTABLET'
                                     and valor      != '-' )
                ```
        }
    )

    process libera-tablet (
        name: libera tablet
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vsemana   varchar2(100);
                  vidsemana varchar2(100);
                  vidfilial number ;
                  vidrepresentante number := :P550_IDREPRESENTANTE;
                  vliberado  varchar2(1);
                  vnova number;
                  vativanotificacao varchar(1) := 'N';
                  --
                  vfaturamentoativo varchar2(1) := 'N';
                  --
                begin
                  --
                  begin
                    --
                    select valor
                    into vfaturamentoativo
                    from parametros p
                    where p.nome = 'SITUACAOFATURAMENTOURUWARE'
                      and p.idfilial = :P0_IDFILIAL;
                    --
                  exception
                    when others then
                      vfaturamentoativo := 'N';
                  end;
                  --
                  begin
                    --
                    select pr.valor
                    into vativanotificacao
                    from parametrosrepresentantes pr
                    where pr.parametro = 'ATIVANOTIFICACAODEBITO'
                      and pr.idrepresentante = vidrepresentante;
                    --
                  exception
                    when others then
                      vativanotificacao := 'N';
                  end;
                  --
                  for a in( select r.idsemana 
                                 , r.semana
                                 , pck_romance.fnc_filialrepresentante(r.idrepresentante) idfilial
                            from regioesrepresentantes r
                            where idrepresentante = vidrepresentante
                            order by 1 )
                  loop
                    vsemana   := a.semana;
                    vidsemana := a.idsemana;
                    vidfilial := a.idfilial;
                    --
                    exit;
                    --
                  end loop;
                  --
                  -- verifica se houve sync da semana anterior para poder liberar a proxima
                  --
                  select 'S'
                  into vliberado
                  from imptablettoservidor
                  where idrepresentante = vidrepresentante
                    and processo        = 'S'
                    and idsemana        = vidsemana-1;
                  --
                  if vliberado = 'S' then
                    --
                    insert into  imptablettoservidor ( idimp        , idrepresentante , semana
                                                     , data         , idfilial        , idsemana
                                                     , datatabletok , processo )
                    values ( SEQ_IDIMPTABLETTOSERV.nextval , vidrepresentante , vsemana
                           , sysdate                       , vidfilial        , vidsemana
                           , null                          , 'L');
                    --
                    if vfaturamentoativo = 'S' then
                      --
                      insert into filafaturamentouruguay ( idfilafaturamento
                                                         , idrepresentante
                                                         , dataliberacao
                                                         , idsemana
                                                         , enviado )
                      values ( seq_idfilafaturamento.nextval
                             , vidrepresentante
                             , sysdate
                             , vidsemana-1
                             , 'N' );
                      --
                    end if;
                    --
                    commit;
                    --
                    if vativanotificacao = 'S' then
                      --
                      pck_controle_rmc.prc_geranotificacaodebito(pidrepresentante => vidrepresentante, pidsemana => vidsemana);
                      --
                    end if;
                    --
                  end if;
                  --
                exception
                   when others then
                     -- se for a primeira importaaco tambem liberada
                     --
                     select count(1)
                     into vnova
                     from imptablettoservidor
                     where idrepresentante = vidrepresentante;
                     --
                      if vnova = 0 then
                        insert into  imptablettoservidor (idimp         , idrepresentante , semana
                                                         , data         , idfilial        , idsemana
                                                         , datatabletok , processo )
                        values ( SEQ_IDIMPTABLETTOSERV.nextval , vidrepresentante ,vsemana
                               , sysdate                       , vidfilial           , vidsemana
                               , null                          , 'L');
                        --
                        commit;
                        --
                      end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 1495071687896047236
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from controleexportacaonetbook t
                where idrepresentante = :P550_IDREPRESENTANTE
                ```
        }
    )

    branch (
        name: Branch
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 550
                items: {
                    P550_IDFILIAL: &P550_IDFILIAL.
                    P550_IDGERENTE: &P550_IDGERENTE.
                    P550_IDREPRESENTANTE: &P550_IDREPRESENTANTE.
                    P550_IDREGIAOVENDA: &P550_IDREGIAOVENDA.
                    P550_PROCESSAR: N
                }
                successMessage: false
            }
        }
    )

)

