            affectedElements {
                selectionType: items
                items: P490_SEMANA
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 490
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 490
                items: {
                    P490_IDREPRESENTANTE: &P490_IDREPRESENTANTE.
                    P490_TIPO_PESQUISA: &P490_TIPO_PESQUISA.
                    P490_SEMANA: &P490_SEMANA.
                    P490_SEMANA_DIST: &P490_SEMANA_DIST.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: BUSCAR
        }
    )

