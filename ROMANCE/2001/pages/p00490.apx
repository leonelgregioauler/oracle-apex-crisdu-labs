    region itens-distribuídos-com-comissão (
        name: Itens Distribuídos com Comissão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select p.codigosisdist||' - '||p.nomeproduto
                         from produtos p
                            , estoquefilial e
                         where e.idestoquefilial = it.idestoquefil
                           and e.idproduto       = p.idproduto ) produto
                     , sum(it.quantidade) distribuido
                     , sum(it.quantidade*it.valorvenda) total
                from notasvendas nv
                   , itensnotavenda it
                where nv.idnotavenda         = it.idnotavenda
                  and nv.idfilial            = :P0_IDFILIAL
                  and nv.idsituacaonotavenda = 3
                  and nv.idrepresentante     = :P490_IDREPRESENTANTE
                  and it.comissao            = 'S'
                  and ( :P490_TIPO_PESQUISA = 'N'
                     or ( :P490_TIPO_PESQUISA = 'S' and nv.idsemanacobranca = :P490_SEMANA ) )
                group by it.idestoquefil
                order by pck_romance.fnc_nomeprodutoestoque(idestoquefil)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item!=value
            item: P490_TIPO_PESQUISA
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1557999672950132114
        }

        column DISTRIBUIDO (
            type: plainText
            heading {
                heading: Distribuido
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column PRODUTO (
            type: plainText
