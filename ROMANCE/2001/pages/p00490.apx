    pageItem P490_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' - '||decode(ativo,'S','Ativo','N','Inativo') distribuidor
                     , idrepresentante
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: - Selecione o Distribuidor -
        }
        cascadingLov {
            parentItems: P0_IDFILIAL
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P490_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select rg.semana||' - '||pck_romance.fnc_nomeregiaovenda(rg.idregiaovenda) d
                     , rg.idsemana r
                from regioesrepresentantes rg
                where rg.idrepresentante = :P490_IDREPRESENTANTE
                order by idsemana
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        cascadingLov {
            parentItems: P490_IDREPRESENTANTE
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P490_SEMANA_DIST (
        type: selectList
        label {
            label: Semana Distribuição
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta
                     , idsemana
                from semana_dias s
                where s.ano between 2020 and 2021
                order by idsemana
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        cascadingLov {
            parentItems: P490_IDREPRESENTANTE
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P490_TIPO_PESQUISA (
        type: radioGroup
        label {
            label: Pesquisar por
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC:Notas na Rua;N,Por Semana;S,Por Distribuição;D
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction escolha-distribuicao (
        name: Escolha Distribuicao
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P490_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P490_TIPO_PESQUISA
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P490_SEMANA_DIST
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P490_SEMANA_DIST
            }
            execution {
