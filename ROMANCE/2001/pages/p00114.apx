    validation quantidade-movimentada (
        name: quantidade movimentada >= 50
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where  nvl(to_number(:P114_QTD_PP),0)
                     + nvl(to_number(:P114_QTD_P),0)
                     + nvl(to_number(:P114_QTD_M),0) 
                     + nvl(to_number(:P114_QTD_G),0) 
                     + nvl(to_number(:P114_QTD_GG),0) 
                     + nvl(to_number(:P114_QTD_EGG),0) 
                     + nvl(to_number(:P114_QTD_EXGG),0) 
                     + nvl(to_number(:P114_QTD_U),0) >= 50
                ```
        }
        error {
            errorMessage: Quantidade não permitida para movimentar o estoque! Registre um evento explicando o motivo dessa quantidade e solicitando liberação!
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

    validation saída-limite-maior-que (
        name: Saída - Limite maior que 5
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P114_MODO = 'S'
                  and (   nvl(to_number(:P114_QTD_PP),0)
                        + nvl(to_number(:P114_QTD_P),0)
                        + nvl(to_number(:P114_QTD_M),0)
                        + nvl(to_number(:P114_QTD_G),0)
                        + nvl(to_number(:P114_QTD_GG),0)
                        + nvl(to_number(:P114_QTD_EGG),0)
                        + nvl(to_number(:P114_QTD_EXGG),0)
                        + nvl(to_number(:P114_QTD_U),0) ) > 5
                ```
        }
        error {
            errorMessage: "Saída não permitida: o limite é de 5 unidades por movimento. "
        }
    )

    validation validar-quantidade (
        name: Validar Quantidade
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(:P114_QTD_PP) >= 0
                  or to_number(:P114_QTD_P) >= 0
                  or to_number(:P114_QTD_M) >= 0
                  or to_number(:P114_QTD_G) >= 0
                  or to_number(:P114_QTD_GG) >= 0
                  or to_number(:P114_QTD_EGG) >= 0
                  or to_number(:P114_QTD_EXGG) >= 0
                  or to_number(:P114_QTD_U) >= 0
                ```
        }
        error {
            errorMessage: Informe uma quantidade Válida!
            displayLocation: inlineInNotification
        }
    )

    process append-observação-do-movimento (
        name: Append Observação do Movimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vprefixo varchar2(60);
                begin
                  if :P114_MODO = 'S' then
                    vprefixo := 'Saída manual reembalagem';
                  else
                    vprefixo := 'Entrada manual reembalagem';
                  end if;
                  --
                  if trim(:P114_OBSERVACAO) is null then
                    :P114_OBSERVACAO := vprefixo;
                  else
                    :P114_OBSERVACAO := vprefixo || ' - ' || trim(:P114_OBSERVACAO);
                  end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 900000000000000002
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

