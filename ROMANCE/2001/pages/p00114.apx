page 114 (
    name: Movimentação de Estoque Reembalagem
    title: Movimentação de Estoque Reembalagem
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            
            function  confirmaproduto(event)
            { 
              var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            console.log (tecla);
              if (tecla==13)
                {
            		if (window._submitting114) return false;
            		window._submitting114 = true;
            		apex.submit('CREATE');
                }
              else 
              { if([190,188,110,194].indexOf(tecla) !=-1) 
                {
                 alert('Informe uma Quantidade Válida!'); 
                 return false;
                }
              }
            }
            
            function mudacampo()
            { 
              campo = document.getElementById('P114_CODIGO');
              var length = campo.value.length;
              if (  (eval(campo.value.length) == "5") || (eval(campo.value.length) == "13") )
               {
                 document.getElementById('P114_QTD_U').focus();
               }
            }
            
            function tem_casas_decimais(valor)
            {
             if (typeof(valor) != 'String')
              valor = valor.toString();
            
             return valor.match(/[.,]/) != null;
            }
            ```
    }
    css {
        inline: ".t-Region-body { background-color: Beige !important;}"
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region movimentação-de-estoque-reembalagem (
        name: Movimentação de Estoque Reembalagem
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
    )

    region relatório-de-movimentos-do-dia (
        name: Relatório de Movimentos do Dia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select initcap( nvl(p.apelido,p.nomepessoa ) ) 
                         from filiais f
                            , pessoas p
                         where f.idpessoa = p.idpessoa
                           and f.idfilial = e.idfilial ) "Filial"
                     , ( select ca.nome
                         from categorias ca
                         where ca.idcategoria = ( select pr.idcategoria 
                                                 from produtos    pr
                                                 where pr.idproduto = e.idproduto ) ) "Categoria"
                     , ( select initcap( pr.codigosisdist ) 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Código"      
                     , ( select initcap( pr.nomeproduto ) 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Produto"         
                     , ( select c.descricao 
                         from cores c
                         where c.idcor = e.idcor ) "Cor"
                     , e.idestoquefilial
                     , e.idfilial
                     , e.idproduto
                     , e.idcor
                     , me.observacao    "Observação"
                     , me.usuario       "Usuário"
                     , me.datamovimento "Data Movimento"
                     , trunc(me.datamovimento) "Dia"
                     , me.qtd_pp
                     , me.qtd_p
                     , me.qtd_m
                     , me.qtd_g
                     , me.qtd_gg
                     , me.qtd_egg
                     , me.qtd_u
                     , nvl(me.qtd_pp,0) + nvl(me.qtd_p,0) + nvl(me.qtd_m,0) + nvl(me.qtd_g,0) + nvl(me.qtd_gg,0) + nvl(me.qtd_egg,0) + nvl(me.qtd_u,0) "Qtd Pecas"
                from estoquefilial           e
                   , movimentosestoquereemb me
                where e.idestoquefilial = me.idestoquefil
                  and e.idfilial = :P0_IDFILIAL
                  and trunc(me.datamovimento) = trunc(sysdate)
                  and (
                        ( :P0_ESTOQUEPORGRADE = 'S' 
                             and ( nvl(me.qtd_pp,0) <> 0 or nvl(me.qtd_p,0) <> 0  or nvl(me.qtd_m,0) <> 0 or nvl(me.qtd_g,0) <> 0
                                or nvl( me.qtd_gg,0) <> 0 or nvl(me.qtd_egg,0) <> 0 or nvl(me.qtd_u,0) <> 0 ))
                      or ( :P0_ESTOQUEPORGRADE = 'N' and nvl(me.qtd_u,0) <> 0 )
                      )
                order by me.datamovimento desc
                ```
        }
        layout {
            sequence: 20
            parentRegion: @movimentação-de-estoque-reembalagem
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
