    pageItem P114_IDESTOQUEFIL (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap( pr.nomeproduto ) || decode(c.descricao, null, '', ' ('||c.descricao||')' ) display_value
                     , e.idestoquefilial   return_value
                from estoquefilial e
                   , produtos                pr
                   , cores                   c
                where e.idproduto = pr.idproduto
                  and e.idcor     = c.idcor (+)
                  and e.idfilial  = :P0_IDFILIAL
                  and pr.codigosisdist = SUBSTR(:P114_CODIGO,1,5)
                  and e.ativo = 'S'
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P114_CODIGO
        }
        layout {
            sequence: 40
            region: @movimentação-de-estoque-reembalagem
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDESTOQUEFIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

