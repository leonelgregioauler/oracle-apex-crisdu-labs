            pkItem: P114_IDMOVTOESTREEMB
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 170463169991680501
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vid       number;
                  vparametro varchar2(1);
                begin 
                  --
                  select pck_romance.fnc_retornaparametro( parametro => 'ESTOQUEEMBPORGRADE'
                                                         , pidfilial => :P0_IDFILIAL )  
                  into vparametro
                  from dual;
                  --
                  begin
                    select e.idestoquereembalagem
                    into :P114_IDESTOQUEREEMBALAGEM  
                    from estoquereembalagem e
                    where e.idestoquefil  = :P114_IDESTOQUEFIL
                      and e.idfilial      = :P0_IDFILIAL;
                  exception
                    when no_data_found then
                      select seq_idestoquereemb.nextval
                      into :P114_IDESTOQUEREEMBALAGEM  
                      from dual;
                      --
                      if vparametro = 'N' then
                        --
                        insert into estoquereembalagem ( idestoquereembalagem  , idestoquefil  , quantidade  , idfilial )
                        values ( :P114_IDESTOQUEREEMBALAGEM , :P114_IDESTOQUEFIL , 0 , :P114_IDFILIAL);      
                        --
                      else
                        --
                        insert into estoquereembalagem ( idestoquereembalagem  , idestoquefil  , quantidade  
                                                       , idfilial              , qtd_pp        , qtd_p    
                                                       , qtd_m                 , qtd_g         , qtd_gg   
                                                       , qtd_egg               , qtd_u         )
                        VALUES ( :P114_IDESTOQUEREEMBALAGEM   , :P114_IDESTOQUEFIL   , 0 
                               , :P114_IDFILIAL               , 0         , 0   
                               , 0                            , 0          , 0   
                               , 0                            , 0          );      
                        --
                      end if;
                      --
                  end;
                  --
                  if :P114_IDMOVTOESTREEMB is null then
                    select "SEQ_IDMOVTOESTREEMB".nextval
                    into :P114_IDMOVTOESTREEMB
                    from dual;
                  end if;
                  --
                  -- Modo Saída: inverte o sinal das quantidades. O trigger
                  -- trg_movimentosestoquereemb_aft soma o valor ao saldo e ja
                  -- bloqueia saldo negativo (parametro VALIDAESTOQUEREEMBNEGATIVO).
                  if :P114_MODO = 'S' then
                    :P114_QTD_PP  := to_number(:P114_QTD_PP ) * -1;
                    :P114_QTD_P   := to_number(:P114_QTD_P  ) * -1;
                    :P114_QTD_M   := to_number(:P114_QTD_M  ) * -1;
                    :P114_QTD_G   := to_number(:P114_QTD_G  ) * -1;
                    :P114_QTD_GG  := to_number(:P114_QTD_GG ) * -1;
                    :P114_QTD_EGG := to_number(:P114_QTD_EGG) * -1;
                    :P114_QTD_U   := to_number(:P114_QTD_U  ) * -1;
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 170463366707680506
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

