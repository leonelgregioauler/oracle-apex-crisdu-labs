page 142 (
    name: Habilita produto no estoque
    title: Habilita produto no estoque
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function  confirmaproduto(event)
            { 
              var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            
              if (tecla==13)
                {
            		apex.submit('CREATE');
                }
            }
            
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region habilitar-produto-no-estoque (
        name: Habilitar produto no estoque
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P142_COMISSAO (
        type: radioGroup
        label {
            label: Comissão
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @habilitar-produto-no-estoque
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P142_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: right
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.tiraacento(pstring => initcap( pr.nomeproduto ))||' - '||pr.codigosisdist display_value
                     , pr.idproduto   return_value
                from produtos                pr
                where not exists ( select 1 
                                   from estoquefilial  e
                                   where e.idproduto = pr.idproduto
                                     and e.idfilial  = :P0_IDFILIAL)
                and ativo = 'S'                     
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @habilitar-produto-no-estoque
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P142_VALORVENDA (
        type: numberField
        label {
            label: Valor Venda
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @habilitar-produto-no-estoque
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 15
        }
        validation {
            maxLength: 15
        }
        advanced {
            customAttributes: onKeyUp="javascript: confirmaproduto(event)"; style="text-align: right;"
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button close (
        buttonName: CLOSE
        label: Fechar
        layout {
            sequence: 10
            region: @habilitar-produto-no-estoque
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: window.opener.location.reload(); window.close();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button habilitar (
        buttonName: HABILITAR
        label: Habilitar
        layout {
            sequence: 20
            region: @habilitar-produto-no-estoque
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation p142-comissao (
        name: P142_COMISSAO
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P142_COMISSAO
        }
        error {
            errorMessage: Informe se tem comissão!
            associatedItem: @P142_COMISSAO
        }
    )

    validation p142-idproduto (
        name: P142_IDPRODUTO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P142_IDPRODUTO
        }
        error {
            errorMessage: Informe o produto!
            associatedItem: @P142_IDPRODUTO
        }
    )

    validation p142-valorvenda (
        name: P142_VALORVENDA
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P142_VALORVENDA
        }
        error {
            errorMessage: Informe o valor de venda!
            associatedItem: @P142_VALORVENDA
        }
    )

    process insere-produto (
        name: insere produto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  insert into estoquefilial (idestoquefilial, idfilial, idproduto, quantidade, ativo, comissao, vlrvenda, qtd_pp, qtd_p, qtd_m, qtd_g, qtd_gg, qtd_egg, qtd_u)
                  values (seq_idestoquefil.nextval , :P0_IDFILIAL, :P142_IDPRODUTO, 0, 'S', :P142_COMISSAO, :P142_VALORVENDA, 0, 0, 0, 0, 0, 0, 0);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Produto habilitado no estoque!
        }
        error {
            errorMessage: Ocorreu um erro ao habilitar o produto, contate o administrador!
        }
        advanced {
            executionMappingIdentifier: 283983072734236572
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 284014085894240380
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 142
                successMessage: false
            }
        }
        comments {
            comments: Created 01-JUN-2012 09:24 by ROMAN
        }
    )

)

