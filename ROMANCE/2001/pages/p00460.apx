page 460 (
    name: Logistica Reversa
    title: Logistica Reversa
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-700x
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region atualizar-dados-consultora (
        name: Atualizar Dados Consultora
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @logistica-reversa
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <font color="GREEN">Atualize os dados da Consultora antes de iniciar a Logística.</font>
        }
    )

    region logistica-reversa (
        name: Logistica Reversa
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region nova-logistica-reversa (
        name: Nova Logistica Reversa
        type: list
        source {
            list: @logistica-reversa
        }
        layout {
            sequence: 1
            slot: contentBody
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: t-WizardSteps--displayLabels
        }
    )

    pageItem P460_ATUALIZADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @atualizar-dados-consultora
            slot: regionBody
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vlibera varchar2(1) := 'N';
                begin
                  --
                  select 'S'
                  into vlibera
                  from dual
                  where exists ( select 1
                                 from pessoas p
                                 where p.idpessoa = :P460_IDPESSOA
                                   and p.email is not null )
                    and exists ( select 1
                                 from telefonespessoas t
                                 where t.idpessoa = :P460_IDPESSOA
                                   and t.prioridade = 1
                                   and t.enviosms   = 1
                                   and t.whatsapp   = 1 );
                  --
                  return vlibera;
                  --
                exception
                  when others then
                    return 'N';
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P460_CONSULTORA (
        type: textField
        label {
            label: Consultora
            alignment: left
        }
        layout {
            sequence: 100
            region: @logistica-reversa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(nv.idvendedora) consultora
                from notasvendas nv
                where nv.idnotavenda = :P460_IDNOTAVENDA;
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P460_DDD (
        type: textField
        label {
            label: DDD
            alignment: left
        }
        layout {
            sequence: 10
            region: @atualizar-dados-consultora
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vddd number;
                begin
                  --
                  select substr(p.telefone,0,2)
                  into vddd
                  from telefonespessoas p
                  where p.idpessoa = :P460_IDPESSOA
                    and p.prioridade = 1
                    and p.enviosms   = 1
                    and p.whatsapp   = 1
                    and rownum = 1;
                  --
                  return vddd;
                  --
                exception
                  when others then
                    return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P460_EMAIL (
        type: textField
        label {
            label: Email
            alignment: left
        }
        layout {
            sequence: 30
            region: @atualizar-dados-consultora
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vemail varchar2(200);
                begin
                  --
                  select email
                  into vemail
                  from pessoas p
                  where p.idpessoa = :P460_IDPESSOA;
                  --
                  return vemail;
                  --
                exception
                  when others then
                    return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P460_IDLOGISTICAREVERSA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @logistica-reversa
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P460_IDNOTAVENDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @logistica-reversa
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P460_IDPESSOA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @logistica-reversa
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select idpessoa
                from vendedoras v
                   , notasvendas nv
                where nv.idvendedora = v.idvendedora
                  and nv.idnotavenda = :P460_IDNOTAVENDA
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P460_NRNOTA (
        type: textField
        label {
            label: da Nota
            alignment: left
        }
        layout {
            sequence: 110
            region: @logistica-reversa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select numeronota
                from notasvendas nv
                where nv.idnotavenda = :P460_IDNOTAVENDA;
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P460_TELEFONE (
        type: textField
        label {
            label: Telefone
            alignment: left
        }
        layout {
            sequence: 20
            region: @atualizar-dados-consultora
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vtelefone number;
                begin
                  --
                  select substr(p.telefone,3,100)
                  into vtelefone
                  from telefonespessoas p
                  where p.idpessoa = :P460_IDPESSOA
                    and p.prioridade = 1
                    and p.enviosms   = 1
                    and p.whatsapp   = 1
                    and rownum = 1;
                  --
                  return vtelefone;
                  --
                exception
                  when others then
                    return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 10
            region: @atualizar-dados-consultora
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button iniciar (
        buttonName: INICIAR
        label: Iniciar Logística
        layout {
            sequence: 10
            region: @logistica-reversa
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P460_ATUALIZADO
            value: S
        }
    )

    validation valida-email (
        name: Valida Email
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P460_EMAIL
        }
        error {
            errorMessage: Por favor, informe o emaill para realizar a logística!
        }
        serverSideCondition {
            type: request=Value
            value: INICIAR
        }
    )

    process atualiza-cadastro-de-consultora (
        name: Atualiza Cadastro de Consultora
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_logisticareversa.prc_atualizacadastrologistica(pidpessoa => :P460_IDPESSOA,
                                                                     pddd => :P460_DDD,
                                                                     ptelefone => :P460_TELEFONE,
                                                                     pemail => :P460_EMAIL);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1522733521350796932
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

    branch (
        name: Go To Page 461
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 461
                items: {
                    P461_CADASTRAR: N
                    P461_IDNOTAVENDA: &P460_IDNOTAVENDA.
                    P461_IDPESSOA: &P460_IDPESSOA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @iniciar
        }
    )

    branch (
        name: Go To Page 460
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 460
                items: {
                    P460_DDD: &P460_DDD.
                    P460_TELEFONE: &P460_TELEFONE.
                    P460_EMAIL: &P460_EMAIL.
                    P460_ATUALIZADO: S
                    P460_IDNOTAVENDA: &P460_IDNOTAVENDA.
                    P460_IDPESSOA: &P460_IDPESSOA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

