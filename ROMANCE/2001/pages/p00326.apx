    pageItem P326_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select P.CODIGOSISDIST ||' - '|| initcap(p.nomeproduto) display_value
                     , e.idestoquefilial return_value
                from produtos      p
                   , estoquefilial e
                where e.idproduto = p.idproduto
                  and e.idfilial = :P0_IDFILIAL
                  and e.ativo = 'S'
                order by p.nomeproduto
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
