    pageItem P326_IDPOSTOAVANCADO (
        type: selectList
        label {
            label: Posto Avançado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nome) display_value
                     , idpostoavancado return_value
                from postoavancado 
                where idfilial = :P0_IDFILIAL
                  and ( ( :P0_IDPOSTOAVANCADO is not null and idpostoavancado = :P0_IDPOSTOAVANCADO )
                       or (:P0_IDPOSTOAVANCADO is null ) )
                  and ativo = 'S' --trazer somente PA ativos T12019799
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @transferir-para-distribuição-pa
            slot: regionBody
            alignment: left
        }
