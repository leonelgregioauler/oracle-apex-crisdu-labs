    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function  confirmaproduto(event)
            { 
              var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            console.log (tecla);
              if (tecla==13)
                {
            		apex.submit('CREATE');
                    document.getElementById('P326_QTD_U').focus();
                }
              else 
              { if([190,188,110,194].indexOf(tecla) !=-1) 
                {
                 alert('Informe uma Quantidade Válida!'); 
                 return false;
                }
              }
            }
            
            function mudacampo()
            { 
              campo = document.getElementById('P326_CODIGO');
              var length = campo.value.length;
              if ( (eval(campo.value.length) == "5") || (eval(campo.value.length) == "13") )
               {
                 document.getElementById('P326_QTD_U').focus();
               }
            }
            
            function desfazer(id)
            { 
              document.getElementById('P326_IDDESFAZER').value = id;
            		apex.submit('DESFAZER');
            }
            
            function tem_casas_decimais(valor)
            {
             if (typeof(valor) != 'String')
              valor = valor.toString();
            
             return valor.match(/[.,]/) != null;
            }
            ```
    }
    css {
        inline: ".t-Region-body { background-color: Beige !important;}"
