    pageItem P326_IDESTOQUEFIL (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap( pr.nomeproduto ) display_value
                     , e.idestoquefilial   return_value
                from estoquefilial e
                   , produtos                pr
                where e.idproduto = pr.idproduto
                  and e.idfilial  = :P0_IDFILIAL 
                  and pr.codigosisdist = SUBSTR(:P326_CODIGO,1,5)
                  and e.ativo = 'S'
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P326_CODIGO
        }
