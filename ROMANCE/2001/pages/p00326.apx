    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vid        number;
                  vparametro varchar2(1) := :P326_TRANSFEREPARAESTOQUE;
                  v_nome_posto_avancado varchar2(500);
                begin 
                  --
                  if :P326_OPCAO = 'P' then
                    :P326_IDESTOQUEFIL := :P326_IDPRODUTO;
                  end if;
                  --
                  select e.idestpostoavancado
                  into :P326_IDESTOQUEPOSTOAVANCADO
                  from roman.estoquepostoavancado e
                  where e.idestoquefil = :P326_IDESTOQUEFIL
                    and e.idpostoavancado = :P326_IDPOSTOAVANCADO;
                  --
                  -- Maicon Aimi - 18/03/2025 - 9156070 -- Busca o nome do posto avançado para concatenar na mensage da :P326_OBSERVACAO.
                  begin
                    select nome
                      into v_nome_posto_avancado
                      from roman.postoavancado pa
                     where pa.idpostoavancado = :P326_IDPOSTOAVANCADO;
                  exception
                    when others then
                      v_nome_posto_avancado := '';
                  end; 
                  --
                  begin
                    select e.idestoquepareemb
                    into :P326_IDESTOQUEREEMBALAGEM  
                    from roman.estoquepostoavancadoreemb e
                    where e.idestoquefil = :P326_IDESTOQUEFIL
                      and e.idpostoavancado = :P326_IDPOSTOAVANCADO;
                  exception
                    when no_data_found then
                      select max(e.idestoquepareemb)+1
                      into :P326_IDESTOQUEREEMBALAGEM  
                      from roman.estoquepostoavancadoreemb e
                      order by 1 desc;
                      --
                      insert into roman.estoquepostoavancadoreemb ( idestoquepareemb , idpostoavancado , idestoquefil
                                                                  , qtd_pp           , qtd_p           , qtd_m
                                                                  , qtd_g            , qtd_gg          , qtd_egg
                                                                  , qtd_exgg         , qtd_u)
                      --
                      values ( :P326_IDESTOQUEREEMBALAGEM  , :P326_IDPOSTOAVANCADO , :P326_IDESTOQUEFIL
                             , 0                           , 0                     , 0
                             , 0                           , 0                     , 0
                             , 0                           , 0 );
                      --
                  end;
                  --    
                  :P326_QTD_U   := to_number(:P326_QTD_U  )*-1;
                  --
                  if :P326_TRANSFEREPARAESTOQUE = 'D' then
                    --
                    :P326_OBSERVACAO :=  'Transferido para estoque distribuição do PA ('|| v_nome_posto_avancado ||'). '||:P326_OBSERVACAO ;
                    --
                  else
                    --      
                    :P326_OBSERVACAO := 'Saída manual sem transferir para estoque distribuição. '||:P326_OBSERVACAO ;
                    --
                  end if;         
                  --
                  if :P326_IDMOVTOESTOQUEPAREEMB is null then
                    select "SEQ_IDMOVTOESTPAREEMB".nextval
                    into :P326_IDMOVTOESTOQUEPAREEMB
                    from sys.dual;
                  end if;
                  --
                end;
                
                --"Transferido para estoque distribuição do PA (colocar o nome do PA)." 
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 339468980351677309
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process grava-movtosestoquepareemb (
        name: GRAVA MOVTOSESTOQUEPAREEMB
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                    -- Sql de insert direto na tabela 
                    insert into roman.movtosestoquepareemb( idmovtoestoquepareemb
                                                          , idpostoavancado
                                                          , idestoquefil
                                                          , observacao
                                                          , usuario
                                                          , datamovimento
                                                          , idestoquepostoavancado
                                                          , qtd_u
                                                          , transfereparaestoque
                                                          , embaladopor)
                                                   values ( :P326_IDMOVTOESTOQUEPAREEMB
                                                          , :P326_IDPOSTOAVANCADO
                                                          , :P326_IDESTOQUEFIL
                                                          , :P326_OBSERVACAO
                                                          , :P326_USUARIO
                                                          , :P326_DATAMOVIMENTO
                                                          , :P326_IDESTOQUEPOSTOAVANCADO
                                                          , :P326_QTD_U
                                                          , :P326_TRANSFEREPARAESTOQUE
                                                          , :P326_EMBALADOPOR);
                
                    -- Efetiva a instrução insert realizada acima                                   
                    commit;
                
                    -- Limpa campos da página
                    :P326_OBSERVACAO            := null;
                    :P326_IDMOVTOESTOQUEPAREEMB := null;
                    :P326_QTD_U                 := null;
                    :P326_IDPRODUTO             := null;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Movimentação realizada com sucesso.
        }
        advanced {
            executionMappingIdentifier: 45539553252629305
        }
        serverSideCondition {
            type: request=Value
            value: CREATE
        }
    )

)

