    region movimentos-de-estoque-distribuição-pa (
        name: Movimentos de Estoque Distribuição PA
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select ca.nome
                         from roman.categorias ca
                         where ca.idcategoria = ( select pr.idcategoria 
                                                  from roman.produtos    pr
                                                  where pr.idproduto = e.idproduto ) ) "Categoria"
                     , ( select initcap( pr.codigosisdist ) 
                         from roman.produtos    pr
                         where pr.idproduto = e.idproduto ) "Código"      
                     , ( select initcap( pr.nomeproduto ) 
                         from roman.produtos    pr
                         where pr.idproduto = e.idproduto ) "Produto"         
                     , ( select c.descricao 
                         from roman.cores c
                         where c.idcor = e.idcor ) "Cor"
                     , mp.qtd_u
                     , mp.observacao
                     , mp.usuario
                     , mp.datamovimento
                     , pck_romance.fnc_nomepostoavancado(ep.idpostoavancado) "Posto Avançado"
                     , mp.idmovtoestpostoavan
                from roman.estoquefilial e
                   , roman.estoquepostoavancado ep
                   , roman.movimentosestoquepostoavan mp
                where e.idestoquefilial     = ep.idestoquefil
                  and ep.idestpostoavancado = mp.idestoquepostoavancado
                  and e.idfilial            = :P0_IDFILIAL
                order by mp.idmovtoestpostoavan desc
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 5
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        messages {
            whenNoDataFound: no data found
        }
        componentAdvanced {
            stripHtml: true
        }

