    validation quantidade-movimentada (
        name: Quantidade movimentada >= 400
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where nvl(to_number(:P326_QTD_U),0) >= 400
                ```
        }
        error {
            errorMessage: Quantidade não permitida para movimentar o estoque! Realize o movimento em mais de um lançamento!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('CREATE','SALVAR')
                ```
        }
    )

    validation validar-quantidade (
        name: Validar Quantidade
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(:P326_QTD_PP) >= 0
                  or to_number(:P326_QTD_P) >= 0
                  or to_number(:P326_QTD_M) >= 0
                  or to_number(:P326_QTD_G) >= 0
                  or to_number(:P326_QTD_GG) >= 0
                  or to_number(:P326_QTD_EGG) >= 0
                  or to_number(:P326_QTD_EXGG) >= 0
                  or to_number(:P326_QTD_U) >= 0
                ```
        }
        error {
            errorMessage: Informe uma quantidade Válida!
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process desfazer (
        name: DESFAZER
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    --
                    insert into roman.movtosestoquepareemb ( idmovtoestoquepareemb   ,   idpostoavancado
                                                           , idestoquefil            ,   observacao
                                                           , usuario                 ,   datamovimento
                                                           , idestoquepostoavancado  ,   qtd_u                  
                                                           , destino                 ,   idfilial
                                                           , estoquedestino          ,   transfereparaestoque ) 
                    select roman.seq_idmovtoestpareemb.nextval   ,   ep.idpostoavancado
                         , me.idestoquefil                       ,   'Transferência de estoque PA desfeita' 
                         , v('APP_USER')                         ,   sysdate
                         , me.idestoquepostoavancado             ,   me.qtd_u  *-1                         
                         , me.destino                            ,   me.idfilial
                         , me.estoquedestino                     ,   me.transfereparaestoque
                    from roman.estoquefilial          e
                       , roman.estoquepostoavancado   ep
                       , roman.movtosestoquepareemb   me
                    where ep.idestoquefil           = e.idestoquefilial
                      and me.idestoquepostoavancado = ep.idestpostoavancado
                      and me.idmovtoestoquepareemb  = :P326_IDDESFAZER
                      and nvl(transfereparaestoque,'N') = 'D';
                    --
                    update roman.movtosestoquepareemb me
                    set me.desfeito = 'S'
                    where idmovtoestoquepareemb = :P326_IDDESFAZER;
                    COMMIT;
                    --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Movimento desfeito com sucesso!
        }
        advanced {
            executionMappingIdentifier: 339305227067405196
        }
        serverSideCondition {
            type: request=Value
            value: DESFAZER
        }
    )

