    region movimentos-do-dia-reembalagem (
        name: Movimentos do Dia (Reembalagem)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select ca.nome
                         from roman.categorias ca
                         where ca.idcategoria = ( select pr.idcategoria 
                                                 from roman.produtos    pr
                                                 where pr.idproduto = e.idproduto ) ) "Categoria"
                     , ( select initcap( pr.codigosisdist ) 
                         from roman.produtos    pr
                         where pr.idproduto = e.idproduto ) "Código"      
                     , ( select initcap( pr.nomeproduto ) 
                         from roman.produtos    pr
                         where pr.idproduto = e.idproduto ) "Produto"         
                     , ( select c.descricao 
                         from roman.cores c
                         where c.idcor = e.idcor ) "Cor"
                     , mp.observacao    "Observação"
                     , mp.usuario       "Usuário"
                     , mp.datamovimento "Data Movimento"
                     , trunc(mp.datamovimento) "Dia"
                     , mp.qtd_u "Qtd U"
                     , case nvl(desfeito,'N')
                         when 'N' then 
                           case mp.transfereparaestoque
                               when 'D' then
                                  (select '<a href="javascript: desfazer('||mp.idmovtoestoquepareemb||')" ><img src="/i/menu/pencil2_16x16.gif" alt=""></a>'
                                  from dual
                                  where mp.qtd_u < 0)
                               else
                                  '-'
                               end 
                         else  
                            'Já Desfeito'
                         end  desfazer
                     , mp.idmovtoestoquepareemb "ID"
                     , mp.embaladopor -- 14/08/2024 - Maicon Aimi - 9156070
                from roman.estoquefilial e
                   , roman.estoquepostoavancado ep
                   , roman.movtosestoquepareemb mp
                where e.idestoquefilial         = ep.idestoquefil
                  and e.idfilial                = :P0_IDFILIAL
                  and mp.idestoquepostoavancado = ep.idestpostoavancado
                  and trunc(mp.datamovimento)   = trunc(sysdate)
                order by mp.datamovimento desc
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
