page 540 (
    name: Filtro de Filiais
    title: Filtro de Filiais
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtro-de-empresas (
        name: Filtro de Empresas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "IDFILIAL",
                "USUARIO"
                from "#OWNER#"."FILTROSFILIAIS"
                where USUARIO = v('APP_USER')
                ```
        }
        layout {
            sequence: 15
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhuma empresa adicionada.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 4
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 2
            derivedColumn: N
            type: selectList
            heading {
                heading: Empresa
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome
                         , idfilial
                    from vw_filiais f
                    where f.ativo = 'S'
                      and f.tipofilial = 'D'
                    ```
                displayExtraValues: false
            }
            layout {
                sequence: 3
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
            default {
                type: plsqlExpression
                plsqlExpression: v('APP_USER')
            }
        )

    )

    button add (
        buttonName: ADD
        label: +
        layout {
            sequence: 40
            region: @filtro-de-empresas
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: Remover
        layout {
            sequence: 20
            region: @filtro-de-empresas
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja remover as Empresas?','MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Aplicar
        layout {
            sequence: 30
            region: @filtro-de-empresas
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @filtro-de-empresas
        target {
            tableName: FILTROSFILIAIS
            pkColumn: ROWID
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# linha(s) removida.
        }
        advanced {
            executionMappingIdentifier: 15697572356576594
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @filtro-de-empresas
        target {
            tableName: FILTROSFILIAIS
            pkColumn: ROWID
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# linha(s) atualizada, #MRI_COUNT# linha(s) inserida.
        }
        advanced {
            executionMappingIdentifier: 15697145471576593
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Go To Page 540
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 540
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('DELETE','SUBMIT')
        }
    )

)

