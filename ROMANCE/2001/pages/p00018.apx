page 18 (
    name: Lista de Regiões de Venda
    title: Lista de Regiões de Venda
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region regiões-de-venda (
        name: Regiões de Venda
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idregiaovenda
                     , initcap (descricao) Descrição
                     , decode(ativo,'S','Sim', 'N','Não') ativo
                     , ( select e.nome from estados e where e.idestado = r.idestado )idestado
                from regioesvenda r
                where r.idestado in ( select f.idestado
                                      from filiaisregioesvenda f
                                      where f.idfilial = :P0_IDFILIAL)
                order by 2
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 29
                items: {
                    P29_IDREGIAOVENDA: #IDREGIAOVENDA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column ATIVO (
            type: plainText
            heading {
                heading: Ativo
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: ATIVO
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column DESCRIÇÃO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: DESCRIÇÃO
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: IDESTADO
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDREGIAOVENDA (
            type: hidden
            heading {
                heading: Idregiaovenda
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDREGIAOVENDA
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        savedReport 1259036 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn ATIVO (
                sequence: 2
            )

            displayColumn DESCRIÇÃO (
                sequence: 1
            )

            displayColumn IDESTADO (
                sequence: 3
            )

            sort (
                column: DESCRICAO
                sort {
                    sequence: 1
                }
            )

            controlBreak (
                column: IDESTADO
                layout {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Nova Região
        layout {
            sequence: 30
            region: @regiões-de-venda
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 29
                clearCache: 29
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

