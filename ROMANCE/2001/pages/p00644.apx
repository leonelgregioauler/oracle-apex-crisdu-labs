    region romance (
        name: Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.datanota datanota
                     , roman.pck_romance.fnc_nomevendedora(nv.idvendedora) consultora
                     , roman.pck_romance.fnc_cpfvendedora(nv.idvendedora) Documento
                     , roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor
                     , 'Romance'
                     , roman.pck_romance.fnc_retornatelefones(nv.idvendedora)telefone
                     , nv.numeronota nota
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.valortotalnota valor_total
                     , nv.valortotalvenda valor_venda
                     , nvl( ( select sum(pv.valorpago)
                              from roman.pagamentosnotasvendas pv
                              where pv.idnotavenda = nv.idnotavenda ),0) valorpago
                     , nv.saldo
                     , nv.idnotavenda 
                from roman.notasvendas nv
                   , roman.vw_filiais f
                where nv.idfilial = f.idfilial 
                  and f.ididioma = 1
                  and nv.idsituacaonotavenda = 4
                  and nv.idsituacaocobranca in (10,70) -- T11956011 solicitado que fosse incluido o id 10.
                  and nv.saldo > 0
                  and (:P644_IDFILIAL is null or nv.idfilial = :P644_IDFILIAL)
                  and (:P644_IDREPRESENTANTE is null or nv.idrepresentante = :P644_IDREPRESENTANTE)
                  and :P644_ORIGEM = 'N' 
                  and (:P644_DATAINICIO is null or nv.datanota between to_date(:P644_DATAINICIO||'00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P644_DATAFIM||'23:59:59','DD/MM/RRRR HH24:MI:SS'))
                  and exists (select 1
                              from roman.caracteristicasnotasvendas n
                                  , roman.classificacoesnotasvendas c
                              where c.idcaracteristicanotavenda = n.idcaracteristicanotavenda
                                and c.idnotavenda = nv.idnotavenda
                                and n.idcaracteristicanotavenda = 59) -- T11956011 trazer notas com classificação de cedência
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P644_ORIGEM
            value: N
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 32469339942541106
        }

