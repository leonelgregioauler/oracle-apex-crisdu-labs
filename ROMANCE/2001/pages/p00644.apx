            encryptSessionState: false
        }
    )

    pageItem P644_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) d
                     , idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P644_IDFILIAL )
                  --and r.ativo = 'S'
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P644_IDFILIAL
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
