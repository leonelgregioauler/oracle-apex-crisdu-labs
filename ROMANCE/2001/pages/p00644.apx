    dynamicAction situação (
        name: Situação
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P644_ORIGEM
        }
        clientSideCondition {
            type: item=value
            item: P644_ORIGEM
            value: A
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P644_SITUACAO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P644_SITUACAO
            }
            execution {
                sequence: 10
            }
        )

    )

    process informa-valores (
        name: Informa Valores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                  --
                  if :P644_DATAINICIO is null then
                    --
                    select trunc(SYSDATE,'MM')
                    into :P644_DATAINICIO
                    from dual;
                    --
                  end if;
                  --
                  if :P644_DATAFIM is null then
                    --
                    select trunc(sysdate) 
                    into :P644_DATAFIM
                    from dual;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 32428010251459305
        }
    )

    branch (
        name: Go To Page 644
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 644
                items: {
                    P644_IDREPRESENTANTE: &P644_IDREPRESENTANTE.
                    P644_SITUACAO: &P644_SITUACAO.
                    P644_DATAINICIO: &P644_DATAINICIO.
                    P644_DATAFIM: &P644_DATAFIM.
                    P644_ORIGEM: &P644_ORIGEM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

