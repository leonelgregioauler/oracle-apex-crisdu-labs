page 644 (
    name: Perdas Detalhadas
    title: Gestao de Perdas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function aprovaassinatura(pid){ 
            
              document.getElementById('P573_ID').value = pid;
                
              var answer = confirm("Aprova a Assinatura Eletronica?")
              if (answer)
                {
                  apex.submit('APROVA_ASSINATURA');
                }
            }
            
            function reprovaassinatura(pid){ 
            
              document.getElementById('P573_ID').value = pid;
              openModal('REPROVAR');
              
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region assinaturas-realizadas (
        name: Assinaturas Realizadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                       select a.datarealizada datarealizada
                     , a.vendedora nomepessoa
                     , a.cpf
                     , a.representante
                     , case
                         when a.situacao = 'R' then
                           'Reprovada'||' - '||nvl(a.motivoreprovacao,'Motivo não informado')
                         else
                           '-'
                       end reprovarassinatura
                     , identificacao
                     , a.desctiponota tipo
                     , decode (a.tipoassinatura, 'P', 'Titular', 'T', 'Terceiro') Tipo_de_Assinatura
                     , case
                       when (select count(1)
                               from roman.notasvendas nv
                              where a.idvendedora = nv.idvendedora) = '1' then 'Sim'
                        else 'Não'
                       end Abertura
                       
                     , a.telefone
                     , nv.numeronota
                     , nv.semanadistribuicao 
                     , case 
                        when nv.idsituacaonotavenda = '4' and nv.saldo > 0 then 'Débito'
                        when nv.idsituacaonotavenda = '3' then 'Aguardando Acerto'
                        when nv.idsituacaonotavenda = '5' then 'Cancelada'
                        when nv.saldo <= 0 then 'Quitada'        
                        else '-'
                       end situacao_nota
                     , nv.valortotalnota
                     , nv.valortotalvenda
                     , nv.valorpago
                     , nv.saldo
                     , nv.dataacerto
                     , nvl(( select 'Sim'
                             from dual
                             where exists ( select 1
                                            from codigosliberacoescobranca cc
                                            where cc.idnotavenda = nv.idnotavenda ) ), 'Não') codigo_gerado
                     , nv.idnotavenda 
                from vw_assinaturas_eletronicas a
                   , notasvendas nv
                where a.idnotavenda = nv.idnotavenda 
                  and :P644_ORIGEM = 'A' 
                  and a.datarealizada between to_date(:P644_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P644_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and ( :P644_IDFILIAL is null or a.idfilial = :P644_IDFILIAL)
                  and ( :P644_IDREPRESENTANTE is null or a.idrepresentante = :P644_IDREPRESENTANTE )
                  and (( :P644_SITUACAO = 'R' and a.situacao = 'R' )
                     or ( :P644_SITUACAO = 'S' and a.situacao = 'R' and nv.idsituacaonotavenda = 4
                                                                    and nv.saldo > 0
                                                                    and not exists (select 1
                                                                                    from roman.assinaturaseletronicas aa
                                                                                    where aa.idnotavenda = a.idnotavenda  
                                                                                     and aa.idassinaturaeletronica > a.idassinaturaeletronica
                                                                                     and aa.status = 'C'
                                                                                     and aa.situacao = 'A' )))
                  and a.situacao != 'P'
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P644_ORIGEM
            value: A
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma assinatura encontrada!
        }
        advanced {
            savedReportMappingIdentifier: 6753598369184167150
        }

