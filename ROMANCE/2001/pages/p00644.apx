    region favorita (
        name: "Favorita "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.dataemissao Dataemissao
                     , p.vendedora Consultora 
                     , p.cpf Documento
                     , p.representante Distribuidor
                     , 'Favorita'
                     , roman.pck_romance.fnc_retornatelefones(p.idvendedora)telefone
                     , p.numeropedido
                     , p.valortotal 
                     , p.valorapagar
                     , p.valorpago valor_pago
                     , p.saldodevedor 
                from favorita.vw_pedidos_fav p
                where p.ididioma = 1
                  and p.datacancelamento is null
                  and p.saldodevedor > 0
                  and exists ( select 1
                               from favorita.vencimentospedidos v
                               where v.situacaovencimento = 'V'
                                 and v.idpedido = p.idpedido )
                  and exists ( select 1
                               from favorita.classificacoespedidos c
                               where c.idpedido = p.idpedido
                                 and c.idcaracteristicapedido in (28,40,41,104) )
                  and (:P644_IDFILIAL is null or p.idfilialromance = :P644_IDFILIAL)
                  and (:P644_IDREPRESENTANTE is null or p.idrepresentante = :P644_IDREPRESENTANTE)
                  and :P644_ORIGEM = 'F' 
                  and (:P644_DATAINICIO is null or p.dataemissao between to_date(:P644_DATAINICIO||'00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P644_DATAFIM||'23:59:59','DD/MM/RRRR HH24:MI:SS'))
                order by 1
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P644_ORIGEM
            value: F
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 32470641186541119
        }

