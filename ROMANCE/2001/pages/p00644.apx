    region pap (
        name: PAP
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.datanota datanota
                     , p.nomepessoa Consultora
                     , p.cpf Documento
                     , (select p.nomepessoa
                        from catal.representantes r
                           , catal.pessoas p 
                        where r.idpessoa = p.idpessoa
                          and r.idrepresentante = v.idrepresentante ) Distribuidor
                     , 'Romance' PAP
                     , ( select listagg(o.nome||'-'||telefone||' - '||t.observacao,'/') within group (order by 1) 
                         from telefonespessoas t
                            , operadorastelefonia o
                         where t.idpessoa = p.idpessoa
                           and t.idoperadoratel = o.idoperadoratel(+)) telefone
                     , nv.numeronota nota
                     , nv.valortotalnota valor_total
                     , nv.valortotalvenda valor_venda
                     , nvl( ( select sum(pv.valorpago)
                              from roman.pagamentosnotasvendas pv
                              where pv.idnotavenda = nv.idnotavenda ),0) valorpago
                     , nv.saldo
                 --  , nv.idnotavenda 
                from roman.notasvendas nv
                   , roman.vw_filiais f
                   , catal.pessoas p
                   , catal.vendedoras v
                where nv.idfilial = f.idfilial 
                  and p.idpessoa = v.idpessoa
                  and v.idvendedora = nv.idvendedora
                  and f.ididioma = 1
                  and exists ( select 1 
                               from roman.classificacoesnotasvendas c
                               where c.idnotavenda = nv.idnotavenda
                                 and c.idcaracteristicanotavenda = 50 )
                 -- and nv.idsituacaonotavenda = 4
                  and nv.saldo > 0
                  and (:P644_IDFILIAL is null or nv.idfilial = :P644_IDFILIAL)
                  and (:P644_IDREPRESENTANTE is null or nv.idrepresentante = :P644_IDREPRESENTANTE)
                  and :P644_ORIGEM = 'P' 
                  and (:P644_DATAINICIO is null or nv.datanota between to_date(:P644_DATAINICIO||'00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P644_DATAFIM||'23:59:59','DD/MM/RRRR HH24:MI:SS'))
                union 
                select p.dataemissao Dataemissao
                     , p.vendedora Consultora 
                     , p.cpf Documento
                     , p.representante Distribuidor
                     , 'Favorita' PAP
                     , ( select listagg(o.nome||'-'||telefone||' - '||t.observacao,'/') within group (order by 1) 
                         from telefonespessoas t
                            , operadorastelefonia o
                            , catal.pessoas pe
                            , catal.vendedoras v
                         where t.idpessoa = pe.idpessoa
                           and t.idoperadoratel = o.idoperadoratel(+)
                           and pe.idpessoa = v.idpessoa
                           and v.idvendedora = p.idvendedora) telefone
                     , p.numeropedido
                     , p.valortotal 
                     , p.valorapagar
                     , p.valorpago valor_pago
                     , p.saldodevedor 
                    -- , p.idpedido
                from favorita.vw_pedidos_fav p
                where p.ididioma = 1
                  and p.datacancelamento is null
                  and p.saldodevedor > 0
                  and exists ( select 1
                               from favorita.vencimentospedidos v
                               where v.situacaovencimento = 'V'
                                 and v.idpedido = p.idpedido )
                  and exists ( select 1
                               from favorita.classificacoespedidos c
                               where c.idpedido = p.idpedido
                                 and c.idcaracteristicapedido = 98 )
                  and (:P644_IDFILIAL is null or p.idfilialromance = :P644_IDFILIAL)
                  and (:P644_IDREPRESENTANTE is null or p.idrepresentante = :P644_IDREPRESENTANTE)
                  and :P644_ORIGEM = 'P' 
                and (:P644_DATAINICIO is null or p.dataemissao between to_date(:P644_DATAINICIO||'00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P644_DATAFIM||'23:59:59','DD/MM/RRRR HH24:MI:SS'))
                
                
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
