    pageItem P644_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
