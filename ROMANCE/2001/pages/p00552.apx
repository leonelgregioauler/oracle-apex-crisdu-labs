        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||decode(r.ativo,'S','Ativo','N','Inativo') d
                     , r.idrepresentante r
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente
                  and ( :P552_IDFILIAL is null or g.idfilial = :P552_IDFILIAL)
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P552_IDFILIAL
        }
        layout {
            sequence: 50
            region: @filtros
