    region pedidos-por-distribuidor (
        name: Pedidos por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ci.cidade
                     , ci.total_clientes
                     , nvl(pe.total_pedidos,0) total_pedidos
                     , round(nvl(sum(pe.total_pedidos / ci.total_clientes * 100),0),0) percentual
                  from (select c.nomecidade cidade
                             , count(p.cpf) total_clientes
                             , c.idcidade
                             , v.idrepresentante
                          from catal.vendedoras v, catal.pessoas p, catal.cidades c
                         where v.idpessoa = p.idpessoa
                           and p.idcidade = c.idcidade
                           and v.ativo = 'S'
                           and  v.idrepresentante = :P552_DISTRIBUIDOR
                           and :P552_TIPOPESQUISA = 'D' 
                           and exists (select 1
                                         from roman.notasvendas nv
                                        where nv.idvendedora = v.idvendedora
                                          and nv.idsituacaonotavenda = 3)
                         group by c.nomecidade, c.idcidade, v.idrepresentante) ci
                     , (select c.nomecidade cidade
                             , c.idcidade
                             , count(distinct p.cpf) total_pedidos
                          from favorita.pedidos pp,
                               catal.pessoas    p,
                               catal.vendedoras v,
                               catal.cidades    c
                         where p.idpessoa = v.idpessoa
                           and pp.idvendedora = v.idvendedora
                           and c.idcidade = p.idcidade
                           and pp.idsituacaoentrega >= 20000
                           and pp.tipopedido in ('P', 'V')
                           and pp.valorapagar > 0
                           and pp.idfilialromance = :P552_IDFILIAL
                           and :P552_TIPOPESQUISA = 'D' 
                           and pp.idrepresentante = :P552_DISTRIBUIDOR
                           and pp.datacancelamento is null
                           and v.ativo = 'S'
                           and trunc(pp.dataemissao) between :P552_DATAINICIO and :P552_DATAFIM
                         group by c.nomecidade, c.idcidade) pe
                 where ci.idcidade = pe.idcidade (+) 
                 group by ci.cidade, ci.total_clientes, pe.total_pedidos
                
                ```
        }
