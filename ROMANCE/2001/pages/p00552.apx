                items: P552_DISTRIBUIDOR
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P552_DISTRIBUIDOR
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P552_IDFILIAL
            }
            execution {
                sequence: 30
            }
        )

    )

    dynamicAction tipo-pesquisa-f (
        name: Tipo pesquisa F
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P552_TIPOPESQUISA
        }
