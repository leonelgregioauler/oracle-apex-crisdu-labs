    branch (
        name: Go To Page 552
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 552
                items: {
                    P552_TIPOPESQUISA: &P552_TIPOPESQUISA.
                    P552_IDFILIAL: &P552_IDFILIAL.
                    P552_DATAINICIO: &P552_DATAINICIO.
                    P552_DATAFIM: &P552_DATAFIM.
                    P552_DISTRIBUIDOR: &P552_DISTRIBUIDOR.
