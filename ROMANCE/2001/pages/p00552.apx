    pageItem P552_CONSULTORASUNICAS (
        type: displayOnly
        label {
            label: Consultoras Únicas
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vqtd  varchar2(100);
                begin
                  select '<b>'|| trim(to_char(count( distinct pf.idvendedora ),'999G999G999G990')) ||'</b>' VENDEDORAS
                  into vqtd
                  from favorita.pedidos pf
                     , favorita.vencimentospedidos v
                  where v.idpedido           = pf.idpedido
                    and v.situacaovencimento = 'V'
                    and trunc(v.datavencimento) between to_date(:P552_DATAINICIO) and to_date(:P552_DATAFIM)
                    and ( :P552_TIPOPESQUISA = 'T'
                         or ( :P552_TIPOPESQUISA = 'F' and pf.idfilialromance = :P552_IDFILIAL )
                         or ( :P552_TIPOPESQUISA = 'G' and pf.idfilialromance in ( select idfilial 
                                                                                   from filtrosfiliais ff
                                                                                   where ff.usuario = v('APP_USER') ) ) )
                    and pf.idsituacaoentrega >= 20000
                    and pf.tipopedido = 'P'
                    and not exists ( select 1
                                     from favorita.classificacoespedidos cp
                                     where cp.idcaracteristicapedido = 28
                                       and cp.idpedido               = pf.idpedido )
                    and not exists ( select 1
                                     from favorita.pagamentospedidos pg
                                     where pg.idvencimentopedido = v.idvencimentopedido
                                       and pg.idformapagamento   = 16 )
                    and not exists ( select 1
                                     from favorita.classificacoespedidos cp
                                     where cp.idcaracteristicapedido = 25
                                       and cp.idpedido               = pf.idpedido )
                    and not exists ( select 1
                                      from favorita.itensindisponiveispedidos it
                                      where it.idpedido   = pf.idpedido
                                        and it.quantidade > 0 )
                    and nvl(pf.valorapagar,0) > 0;
                    --
                    return vqtd;
                    --
                exception
                  when others then
                      return '0';
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

