    region análise-favorita-com-quebra (
        name: Análise Favorita com Quebra
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 99
                     , '- Total -' descricao
                     , sum(total.vendedoras) "Vendedoras"
                     , '=' s1
                     , sum(total.qtd) "Qtd Venda"
                     , 100 perc0
                     , '-' s3
                     , sum(total.qtdquitado) "Qtd Quitado"
                     , case
                         when sum(total.qtdquitado) = 0 then
                           0
                         else
                           round((sum(total.qtdquitado)/sum(total.qtd)*100),2)
                       end perc1
                     , sum(total.qtddebito) "Qtd Débito"
                     , case
                         when sum(total.qtddebito) = 0 then
                           0
                         else
                           round((sum(total.qtddebito)/sum(total.qtd)*100),2)
                       end perc2
                     , sum(total.qtdquebra) "Qtd Quebra"
                     , case
                         when sum(total.qtdquebra) = 0 then
                           0
                         else
                           round((sum(total.qtdquebra)/sum(total.qtd)*100),2)
                       end perc3
                     , '|' s2
                     , sum(total.valortotal) "Total"
                     , sum(total.valorquitado) "Quitado"
                     , case
                         when sum(total.valorquitado) = 0 then
                           0
                         else
                           round((sum(total.valorquitado)/sum(total.valortotal)*100),2) 
                       end perc4
                     , sum(total.valordebito) "Débito"
                     , case
                         when sum(total.valordebito) = 0 then
                           0
                         else
                           round((sum(total.valordebito)/sum(total.valortotal)*100),2)
                       end perc5
                     , sum(total.valorquebra) "Quebra"
                     , case
                         when sum(total.valorquebra) = 0 then
                           0
                         else
                           round((sum(total.valorquebra)/sum(total.valortotal)*100),2)
                       end perc6
                from ( select ( nvl(venda.quantidade,0) + nvl(debito.quantidade,0) + nvl(comquebra.quantidade,0) ) qtd
                            , ( nvl(venda.vendedoras,0) + nvl(debito.vendedoras,0) + nvl(comquebra.vendedoras,0) ) vendedoras
                            , nvl(venda.quantidade,0) qtdquitado
                            , nvl(debito.quantidade,0) qtddebito
                            , nvl(comquebra.quantidade,0) qtdquebra
                            , round((nvl(venda.valor,0) + nvl(debito.valor,0) + nvl(comquebra.valor,0) ),2 ) valortotal
                            , round(nvl(venda.valor,0),2) valorquitado
                            , round(nvl(debito.valor,0),2) valordebito
                            , round(nvl(comquebra.valor,0),2) valorquebra
                       from favorita.nivelfaturamento n
                          , ( select nf.idfaturamento
                                   , count( distinct pf.idpedido ) quantidade
                                   , count( distinct pf.idvendedora ) vendedoras
                                   , sum( pf.valorapagar * pf.fatorconversao ) valor
                              from favorita.pedidos pf
                                 , favorita.nivelfaturamento nf
                                 , favorita.vencimentospedidos v
                              where v.idpedido           = pf.idpedido
                                and v.situacaovencimento = 'V'
                                and (pf.valorapagar*pf.fatorconversao) between nf.valorinicio and nf.valorfim
                                and trunc(v.datavencimento) between to_date(:P552_DATAINICIO) and to_date(:P552_DATAFIM)
                                and ( :P552_TIPOPESQUISA = 'T'
                                     or ( :P552_TIPOPESQUISA = 'F' and pf.idfilialromance = :P552_IDFILIAL )
                                     or ( :P552_TIPOPESQUISA = 'G' and pf.idfilialromance in ( select idfilial 
                                                                                               from filtrosfiliais ff
                                                                                               where ff.usuario = v('APP_USER') ) ) )
                                and pf.idsituacaoentrega >= 20000
                                and pf.tipopedido = 'P'
                                and not exists ( select 1
                                                 from favorita.classificacoespedidos cp
                                                 where cp.idcaracteristicapedido = 28
                                                   and cp.idpedido               = pf.idpedido )
                                and not exists ( select 1
                                                 from favorita.pagamentospedidos pg
                                                 where pg.idvencimentopedido = v.idvencimentopedido
                                                   and pg.idformapagamento   = 16 )
                                and not exists ( select 1
                                                 from favorita.classificacoespedidos cp
                                                 where cp.idcaracteristicapedido = 25
                                                   and cp.idpedido               = pf.idpedido )
                                and not exists ( select 1
                                                  from favorita.itensindisponiveispedidos it
                                                  where it.idpedido   = pf.idpedido
                                                    and it.quantidade > 0 )
                                and nvl(pf.valorapagar,0) > 0
                                and nvl(v.valorpago,0) >= v.valorpagar
                              group by nf.idfaturamento ) venda
                           , ( select nf.idfaturamento
                                    , count( distinct pf.idpedido ) quantidade
                                    , count( distinct pf.idvendedora ) vendedoras
                                    , sum( pf.valorapagar * pf.fatorconversao ) valor
                               from favorita.pedidos pf
                                  , favorita.nivelfaturamento nf
                                  , favorita.vencimentospedidos v
                               where v.idpedido           = pf.idpedido
                                 and v.situacaovencimento = 'V'
                                 and (pf.valorapagar*pf.fatorconversao) between nf.valorinicio and nf.valorfim
                                 and trunc(v.datavencimento) between to_date(:P552_DATAINICIO) and to_date(:P552_DATAFIM)
                                 and ( :P552_TIPOPESQUISA = 'T'
                                     or ( :P552_TIPOPESQUISA = 'F' and pf.idfilialromance = :P552_IDFILIAL )
                                     or ( :P552_TIPOPESQUISA = 'G' and pf.idfilialromance in ( select idfilial 
                                                                                               from filtrosfiliais ff
                                                                                               where ff.usuario = v('APP_USER') ) ) )
                                 and pf.idsituacaoentrega >= 20000
                                 and pf.tipopedido = 'P'
                                 and not exists ( select 1
                                                  from favorita.classificacoespedidos cp
                                                  where cp.idcaracteristicapedido = 28
                                                    and cp.idpedido               = pf.idpedido )
                                 and not exists ( select 1
                                                  from favorita.pagamentospedidos pg
                                                  where pg.idvencimentopedido = v.idvencimentopedido
                                                    and pg.idformapagamento   = 16 )
                                 and not exists ( select 1
                                                  from favorita.classificacoespedidos cp
                                                  where cp.idcaracteristicapedido = 25
                                                    and cp.idpedido               = pf.idpedido )
                                 and not exists ( select 1
                                                  from favorita.itensindisponiveispedidos it
                                                  where it.idpedido   = pf.idpedido
                                                    and it.quantidade > 0 )
                                 and nvl(pf.valorapagar,0) > 0
                                 and nvl(v.valorpago,0) < v.valorpagar
                               group by nf.idfaturamento ) debito
                           , ( select nf.idfaturamento
                                    , count( distinct pf.idpedido ) quantidade
                                    , count( distinct pf.idvendedora ) vendedoras
                                    , sum( ( select sum(i.quantidade*i.valorvenda)
                                             from favorita.itensindisponiveispedidos i
                                             where i.idpedido = pf.idpedido ) * pf.fatorconversao ) valor
                               from favorita.pedidos pf
                                  , favorita.nivelfaturamento nf
                                  , favorita.vencimentospedidos v
                               where v.idpedido           = pf.idpedido
                                 and v.situacaovencimento = 'V'
                                 and (pf.valorapagar*pf.fatorconversao) between nf.valorinicio and nf.valorfim
                                 and trunc(v.datavencimento) between to_date(:P552_DATAINICIO) and to_date(:P552_DATAFIM)
                                 and ( :P552_TIPOPESQUISA = 'T'
                                     or ( :P552_TIPOPESQUISA = 'F' and pf.idfilialromance = :P552_IDFILIAL )
                                     or ( :P552_TIPOPESQUISA = 'G' and pf.idfilialromance in ( select idfilial 
                                                                                               from filtrosfiliais ff
                                                                                               where ff.usuario = v('APP_USER') ) ) )
                                 and pf.idsituacaoentrega >= 20000
                                 and pf.tipopedido = 'P'
                                 and not exists ( select 1
                                                  from favorita.classificacoespedidos cp
                                                  where cp.idcaracteristicapedido = 28
                                                    and cp.idpedido               = pf.idpedido )
                                 and not exists ( select 1
                                                  from favorita.pagamentospedidos pg
                                                  where pg.idvencimentopedido = v.idvencimentopedido
                                                    and pg.idformapagamento   = 16 )
                                 and not exists ( select 1
                                                  from favorita.classificacoespedidos cp
                                                  where cp.idcaracteristicapedido = 25
                                                    and cp.idpedido               = pf.idpedido )
                                 and exists ( select 1
                                              from favorita.itensindisponiveispedidos it
                                              where it.idpedido   = pf.idpedido
                                                and it.quantidade > 0 )
                                 and nvl(pf.valorapagar,0) > 0
                                 and nvl(v.valorpago,0) < v.valorpagar
                               group by nf.idfaturamento ) comquebra
                          where n.idfaturamento = venda.idfaturamento(+)
                            and n.idfaturamento = debito.idfaturamento(+)
                            and n.idfaturamento = comquebra.idfaturamento(+) ) total
                where to_date(:P552_DATAINICIO) is not null
                union
                select n.idfaturamento
                     , n.descricao
                     , ( nvl(venda.vend,0) + nvl(debito.vend,0) + nvl(comquebra.vend,0) ) vendedoras
                     , '|'
                     , ( nvl(venda.quantidade,0) + nvl(debito.quantidade,0) )
                     , round( (( nvl(venda.quantidade,0) + nvl(debito.quantidade,0) ) / tot.quantidade * 100 ),2)
                     , '-'
                     , nvl(venda.quantidade,0)
                     , case
                         when nvl(venda.quantidade,0) = 0 then
                           0
                         else
                           round(( nvl(venda.quantidade,0) / (nvl(venda.quantidade,0) + nvl(debito.quantidade,0)) * 100 ),2)
                       end
                     , nvl(debito.quantidade,0)
                     , case
                         when nvl(debito.quantidade,0) = 0 then
                           0
                         else
                           round(( nvl(debito.quantidade,0) / (nvl(venda.quantidade,0) + nvl(debito.quantidade,0)) * 100 ),2)
                       end
                     , nvl(comquebra.quantidade,0)
                     , case
                         when nvl(comquebra.quantidade,0) = 0 then
                           0
                         else
                           round(( nvl(comquebra.quantidade,0) / (nvl(venda.quantidade,0) + nvl(debito.quantidade,0) + nvl(comquebra.quantidade,0)) * 100 ),2)
                       end
                     , '|'
                     , round( nvl(venda.valor,0) + nvl(debito.valor,0),2)
                     , round(nvl(venda.valor,0),2)
                     , case
                         when nvl(venda.valor,0) = 0 then
                           0
                         else
                           round((nvl(venda.valor,0)/(nvl(venda.valor,0)+nvl(debito.valor,0))*100),2)
                       end
                     , round(nvl(debito.valor,0),2)
                     , case
                         when nvl(debito.valor,0) = 0 then
                           0
                         else
                           round((nvl(debito.valor,0)/(nvl(venda.valor,0)+nvl(debito.valor,0))*100),2)
                       end
                     , round(nvl(comquebra.valor,0),2)
                     , case
                         when nvl(comquebra.valor,0) = 0 then
                           0
                         else
                           round((nvl(comquebra.valor,0)/(nvl(venda.valor,0)+nvl(debito.valor,0)+nvl(comquebra.valor,0))*100),2)
                       end
                from favorita.nivelfaturamento n
                   , ( select count( distinct pf.idpedido ) quantidade
                       from favorita.pedidos pf
                          , favorita.nivelfaturamento nf
                          , favorita.vencimentospedidos v
                       where v.idpedido           = pf.idpedido
                         and v.situacaovencimento = 'V'
                         and (pf.valorapagar*pf.fatorconversao) between nf.valorinicio and nf.valorfim
                         and trunc(v.datavencimento) between to_date(:P552_DATAINICIO) and to_date(:P552_DATAFIM)
                         and ( :P552_TIPOPESQUISA = 'T'
                                     or ( :P552_TIPOPESQUISA = 'F' and pf.idfilialromance = :P552_IDFILIAL )
                                     or ( :P552_TIPOPESQUISA = 'G' and pf.idfilialromance in ( select idfilial 
                                                                                               from filtrosfiliais ff
                                                                                               where ff.usuario = v('APP_USER') ) ) )
                         and pf.idsituacaoentrega >= 20000
                         and pf.tipopedido = 'P'
                         and not exists ( select 1
                                          from favorita.classificacoespedidos cp
                                          where cp.idcaracteristicapedido = 28
                                            and cp.idpedido               = pf.idpedido )
                         and not exists ( select 1
                                          from favorita.pagamentospedidos pg
                                          where pg.idvencimentopedido = v.idvencimentopedido
                                            and pg.idformapagamento   = 16 )
                         and not exists ( select 1
                                          from favorita.classificacoespedidos cp
                                          where cp.idcaracteristicapedido = 25
                                            and cp.idpedido               = pf.idpedido )
                         and nvl(pf.valorapagar,0) > 0 ) tot
                   , ( select nf.idfaturamento
                            , count( distinct pf.idpedido ) quantidade
                            , count( distinct pf.idvendedora ) vend
                            , sum( pf.valorapagar * pf.fatorconversao ) valor
                       from favorita.pedidos pf
                          , favorita.nivelfaturamento nf
                          , favorita.vencimentospedidos v
                       where v.idpedido           = pf.idpedido
                         and v.situacaovencimento = 'V'
                         and (pf.valorapagar*pf.fatorconversao) between nf.valorinicio and nf.valorfim
                         and trunc(v.datavencimento) between to_date(:P552_DATAINICIO) and to_date(:P552_DATAFIM)
                         and ( :P552_TIPOPESQUISA = 'T'
                                     or ( :P552_TIPOPESQUISA = 'F' and pf.idfilialromance = :P552_IDFILIAL )
                                     or ( :P552_TIPOPESQUISA = 'G' and pf.idfilialromance in ( select idfilial 
                                                                                               from filtrosfiliais ff
                                                                                               where ff.usuario = v('APP_USER') ) ) )
                         and pf.idsituacaoentrega >= 20000
                         and pf.tipopedido = 'P'
                         and not exists ( select 1
                                          from favorita.classificacoespedidos cp
                                          where cp.idcaracteristicapedido = 28
                                            and cp.idpedido               = pf.idpedido )
                         and not exists ( select 1
                                          from favorita.pagamentospedidos pg
                                          where pg.idvencimentopedido = v.idvencimentopedido
                                            and pg.idformapagamento   = 16 )
                         and not exists ( select 1
                                          from favorita.classificacoespedidos cp
                                          where cp.idcaracteristicapedido = 25
                                            and cp.idpedido               = pf.idpedido )
                         and not exists ( select 1
                                          from favorita.itensindisponiveispedidos it
                                          where it.idpedido   = pf.idpedido
                                            and it.quantidade > 0 )
                         and nvl(pf.valorapagar,0) > 0
                         and nvl(v.valorpago,0) >= v.valorpagar
                       group by nf.idfaturamento ) venda
                   , ( select nf.idfaturamento
                            , count( distinct pf.idpedido ) quantidade
                            , count( distinct pf.idvendedora ) vend
                            , sum( pf.valorapagar * pf.fatorconversao ) valor
                       from favorita.pedidos pf
                          , favorita.nivelfaturamento nf
                          , favorita.vencimentospedidos v
                       where v.idpedido           = pf.idpedido
                         and v.situacaovencimento = 'V'
                         and (pf.valorapagar*pf.fatorconversao) between nf.valorinicio and nf.valorfim
                         and trunc(v.datavencimento) between to_date(:P552_DATAINICIO) and to_date(:P552_DATAFIM)
                         and ( :P552_TIPOPESQUISA = 'T'
                                     or ( :P552_TIPOPESQUISA = 'F' and pf.idfilialromance = :P552_IDFILIAL )
                                     or ( :P552_TIPOPESQUISA = 'G' and pf.idfilialromance in ( select idfilial 
                                                                                               from filtrosfiliais ff
                                                                                               where ff.usuario = v('APP_USER') ) ) )
                         and pf.idsituacaoentrega >= 20000
                         and pf.tipopedido = 'P'
                         and not exists ( select 1
                                          from favorita.classificacoespedidos cp
                                          where cp.idcaracteristicapedido = 28
                                            and cp.idpedido               = pf.idpedido )
                         and not exists ( select 1
                                          from favorita.pagamentospedidos pg
                                          where pg.idvencimentopedido = v.idvencimentopedido
                                            and pg.idformapagamento   = 16 )
                         and not exists ( select 1
                                          from favorita.classificacoespedidos cp
                                          where cp.idcaracteristicapedido = 25
                                            and cp.idpedido               = pf.idpedido )
                         and not exists ( select 1
                                          from favorita.itensindisponiveispedidos it
                                          where it.idpedido   = pf.idpedido
                                            and it.quantidade > 0 )
                         and nvl(pf.valorapagar,0) > 0
                         and nvl(v.valorpago,0) < v.valorpagar
                       group by nf.idfaturamento ) debito
                   , ( select nf.idfaturamento
                            , count( distinct pf.idpedido ) quantidade
                            , count( distinct pf.idvendedora ) vend
                            , sum( ( select sum(i.quantidade*i.valorvenda)
                                    from favorita.itensindisponiveispedidos i
                                    where i.idpedido = pf.idpedido ) * pf.fatorconversao ) valor
                       from favorita.pedidos pf
                          , favorita.nivelfaturamento nf
                          , favorita.vencimentospedidos v
                       where v.idpedido           = pf.idpedido
                         and v.situacaovencimento = 'V'
                         and (pf.valorapagar*pf.fatorconversao) between nf.valorinicio and nf.valorfim
                         and trunc(v.datavencimento) between to_date(:P552_DATAINICIO) and to_date(:P552_DATAFIM)
                         and ( :P552_TIPOPESQUISA = 'T'
                                     or ( :P552_TIPOPESQUISA = 'F' and pf.idfilialromance = :P552_IDFILIAL )
                                     or ( :P552_TIPOPESQUISA = 'G' and pf.idfilialromance in ( select idfilial 
                                                                                               from filtrosfiliais ff
                                                                                               where ff.usuario = v('APP_USER') ) ) )
                         and pf.idsituacaoentrega >= 20000
                         and pf.tipopedido = 'P'
                         and not exists ( select 1
                                          from favorita.classificacoespedidos cp
                                          where cp.idcaracteristicapedido = 28
                                            and cp.idpedido               = pf.idpedido )
                         and not exists ( select 1
                                          from favorita.pagamentospedidos pg
                                          where pg.idvencimentopedido = v.idvencimentopedido
                                            and pg.idformapagamento   = 16 )
                         and not exists ( select 1
                                          from favorita.classificacoespedidos cp
                                          where cp.idcaracteristicapedido = 25
                                            and cp.idpedido               = pf.idpedido )
                         and exists ( select 1
                                      from favorita.itensindisponiveispedidos it
                                      where it.idpedido   = pf.idpedido
                                        and it.quantidade > 0  )
                         and nvl(pf.valorapagar,0) > 0
                         and nvl(v.valorpago,0) < v.valorpagar
                       group by nf.idfaturamento ) comquebra
                where n.idfaturamento = venda.idfaturamento(+)
                  and n.idfaturamento = debito.idfaturamento(+)
                  and n.idfaturamento = comquebra.idfaturamento(+)
                  and to_date(:P552_DATAINICIO) is not null
                order by 1
                ```
        }
