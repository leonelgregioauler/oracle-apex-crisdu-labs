        }
        layout {
            sequence: 20
            region: @endereço-do-remetente
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_IDPESSOA_C (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @cadastro-de-endereço-de-entrega
            slot: regionBody
        }
        source {
            type: item
            item: P461_IDPESSOA
        }
        security {
            encryptSessionState: false
