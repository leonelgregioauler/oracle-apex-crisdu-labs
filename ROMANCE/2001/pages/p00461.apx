page 461 (
    name: Endereço do Remetente
    title: Endereço do Remetente
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-endereço-de-entrega (
        name: Cadastro de Endereço de Entrega
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P461_CADASTRAR = 'S'
                ```
        }
        settings {
            outputAs: text
        }
    )

    region endereço-do-remetente (
        name: Endereço do Remetente
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P461_CADASTRAR
            value: N
        }
    )

    region nova-logistica-reversa (
        name: Nova Logistica Reversa
        type: list
        source {
            list: @logistica-reversa
        }
        layout {
            sequence: 1
            slot: contentBody
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: t-WizardSteps--displayLabels
        }
    )

    pageItem P461_BAIRRO (
        type: textField
        label {
            label: Bairro
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @cadastro-de-endereço-de-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_CADASTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @endereço-do-remetente
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_CEP (
        type: textField
        label {
            label: Cep
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 100
            region: @cadastro-de-endereço-de-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_COMPLEMENTO (
        type: textField
        label {
            label: Complemento
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 70
            region: @cadastro-de-endereço-de-entrega
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecidade||' - '||c.sigla display_value
                     , c.idcidade  return_value
                from favorita.vw_cidades_fav c
                order by 1 
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @cadastro-de-endereço-de-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 28
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_IDENDERECOENTREGA (
        type: selectList
        label {
            label: Endereço de Entrega
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.rua||' n° '||e.numero||', '||e.bairro||' - '||roman.pck_romance.fnc_nomecidade(e.idcidade) display_value
                     , e.idenderecoentrega return_value
                from favorita.enderecosentrega e
                where e.idpessoa = :P461_IDPESSOA
                union
                select 'Nenhum Endereço de Entrega cadastrado.' 
                     , null
                from dual
                where not exists ( select 1
                                   from favorita.enderecosentrega ee
                                   where ee.idpessoa = :P461_IDPESSOA )
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @endereço-do-remetente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_IDENDERECOENTREGA_C (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-endereço-de-entrega
            slot: regionBody
        }
        source {
            type: item
            item: P461_IDENDERECOENTREGA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_IDNOTAVENDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @endereço-do-remetente
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_IDPESSOA (
        type: hidden
        settings {
