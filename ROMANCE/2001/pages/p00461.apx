        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @cadastro-de-endereço-de-entrega
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 110
            region: @cadastro-de-endereço-de-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
            height: 5
        }
        validation {
            maxLength: 1000
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_REFERENCIA (
        type: textField
        label {
            label: Referência
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 90
            region: @cadastro-de-endereço-de-entrega
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_RUA (
        type: textField
        label {
            label: Rua
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @cadastro-de-endereço-de-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 30
            region: @endereço-do-remetente
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button atualizar-c (
        buttonName: ATUALIZAR_C
        label: Atualizar e Continuar
        layout {
            sequence: 10
            region: @cadastro-de-endereço-de-entrega
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P461_IDENDERECOENTREGA_C
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar e Continuar
        layout {
            sequence: 20
            region: @cadastro-de-endereço-de-entrega
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo Endereço
        layout {
            sequence: 10
            region: @endereço-do-remetente
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button proximo-passo-com (
        buttonName: PROXIMO_PASSO_COM
        label: Continuar
        layout {
            sequence: 20
            region: @endereço-do-remetente
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                                   from favorita.enderecosentrega ee
                                   where ee.idpessoa = :P461_IDPESSOA )
                ```
        }
    )

    validation valida-cep-do-endereço-de-entrega (
        name: Valida CEP do Endereço de Entrega
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from favorita.enderecosentrega e
                where e.idenderecoentrega = :P461_IDENDERECOENTREGA
                  and e.cep is null
                ```
        }
        error {
            errorMessage: É necessário que o CEP esteja informado para continuar a Logística.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('ATUALIZAR_C','CRIAR','PROXIMO_PASSO_COM')
                ```
        }
    )

    process carrega-endereço-de-entrega (
        name: Carrega Endereço de Entrega
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- 
                  favorita.pck_cadastros_fav.prc_enderecosentrega(pidenderecoentrega => :P461_IDENDERECOENTREGA,
                                                                  pidpessoa => :P461_IDPESSOA_C,
                                                                  prua => :P461_RUA,
                                                                  pnumero => :P461_NUMERO,
                                                                  pcomplemento => :P461_COMPLEMENTO,
                                                                  pbairro => :P461_BAIRRO,
                                                                  pcep => :P461_CEP,
                                                                  pidcidade => :P461_IDCIDADE,
                                                                  pobservacao => :P461_OBSERVACAO,
                                                                  preferencia => :P461_REFERENCIA,
                                                                  pmd5 => :P461_MD5,
                                                                  poperacao_dml => 'S');
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1520049036839977641
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P461_IDENDERECOENTREGA
        }
    )

    process processo-dml-em-endereços-de-entrega (
        name: Processo DML em Endereços de Entrega
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'ATUALIZAR_C' then
                    --
                    voperacao_dml := 'U';
                    --
                  end if;
                  --
                  FAVORITA.PCK_CADASTROS_FAV.PRC_ENDERECOSENTREGA( PIDENDERECOENTREGA => :P461_IDENDERECOENTREGA_C,
                                                                   PIDPESSOA => :P461_IDPESSOA,
                                                                   PRUA => :P461_RUA,
                                                                   PNUMERO => :P461_NUMERO,
                                                                   PCOMPLEMENTO => :P461_COMPLEMENTO,
                                                                   PBAIRRO => :P461_BAIRRO,
                                                                   PCEP => :P461_CEP,
                                                                   PIDCIDADE => :P461_IDCIDADE,
                                                                   POBSERVACAO => :P461_OBSERVACAO,
                                                                   PREFERENCIA => :P461_REFERENCIA,
                                                                   PMD5 => :P461_MD5,
                                                                   POPERACAO_DML => voperacao_dml);
                  --
                  :P461_IDENDERECOENTREGA := :P461_IDENDERECOENTREGA_C;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1522692906868549236
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('ATUALIZAR_C','CRIAR')
                ```
        }
    )

    branch (
        name: Go To Page 461
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 461
                items: {
                    P461_IDNOTAVENDA: &P461_IDNOTAVENDA.
                    P461_IDPESSOA: &P461_IDPESSOA.
                    P461_IDENDERECOENTREGA:
                    P461_IDENDERECOENTREGA_C:
                    P461_CADASTRAR: S
                    P461_IDPESSOA_C: &P461_IDPESSOA.
                    P461_RUA:
                    P461_NUMERO:
                    P461_BAIRRO:
                    P461_COMPLEMENTO:
                    P461_IDCIDADE:
                    P461_REFERENCIA:
                    P461_CEP:
                    P461_OBSERVACAO:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    branch (
        name: Go To Page 461
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 461
                items: {
                    P461_IDNOTAVENDA: &P461_IDNOTAVENDA.
                    P461_IDENDERECOENTREGA: &P461_IDENDERECOENTREGA.
                    P461_IDPESSOA: &P461_IDPESSOA.
                    P461_CADASTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

    branch (
        name: Go To Page 462
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 462
                items: {
                    P462_IDENDERECOENTREGA:
                    P462_IDENDERECOREMETENTE: &P461_IDENDERECOENTREGA.
                    P462_IDNOTAVENDA: &P461_IDNOTAVENDA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('PROXIMO_PASSO_COM','CRIAR','ATUALIZAR_C')
                ```
        }
    )

)

