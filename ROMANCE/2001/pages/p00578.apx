    region favorita-paris-resumido (
        name: Favorita Paris Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(ped.idrepresentante) distribuidor
                     , qtd
                     , total
                     , pontuacao
                     , qtd_perfumes
                from ( 
                       select p.idrepresentante
                            , count(distinct idpedido) qtd
                            , sum(pck_rankingpontuacao.fnc_retornapontuacaopedido(p.idpedido)) pontuacao
                            , sum(p.valortotal) total
                            , sum(( select nvl(sum(it.quantidade),0)
                                    from favorita.itenspedidos it
                                    where it.idpedido = p.idpedido
                                     and it.idprodutodetalhado in (2350,2352,2351,2349,2348,2347,2346,2345,2344,2343,2817,2818,2819,2820,2821,2822,2824,2825,2826,2827,4235,4232,4233,4234,4227,4228,4229,4230,4231,4236) )) qtd_perfumes
                       from favorita.vw_pedidos_fav p
                       where p.idfilialromance = :P0_IDFILIAL
                         and p.valorapagar > 0
                         and trunc(p.dataemissao) between to_date(:P578_DATAINICIO,'dd/mm/rrrr') and to_date(:P578_DATAFIM,'dd/mm/rrrr')
                         and exists ( select 1
                                      from favorita.classificacoespedidos cp
                                      where cp.idpedido = p.idpedido 
                                        and cp.idcaracteristicapedido = 73 )
                         and not exists ( select 1
                                          from favorita.classificacoespedidos cp
                                          where cp.idpedido = p.idpedido 
                                            and cp.idcaracteristicapedido = 25 ) 
                       group by idrepresentante ) ped
                order by 4 desc;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P578_RELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4800951477488773038
        }

