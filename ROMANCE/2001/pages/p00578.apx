    region favorita-paris-perfumes (
        name: Favorita Paris Perfumes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.dataemissao
                     , p.representante
                     , p.vendedora
                     , p.idpedido 
                     , ( select nvl(sum(it.quantidade),0)
                         from favorita.itenspedidos it
                         where it.idpedido = p.idpedido
                           and it.idprodutodetalhado in (2350,2352,2351,2349,2348,2347,2346,2345,2344,2343,2817,2818,2819,2820,2821,2822,2824,2825,2826,2827,4235,4232,4233,4234,4227,4228,4229,4230,4231,4236) ) "Total Perfumes"
                     , ( select round(sum( it.quantidade * ( it.valorvenda * (((100-it.perccomissaodistribuidor)/100)) ) ),2)
                         from favorita.itenspedidos it
                         where it.idpedido = p.idpedido
                           and it.idprodutodetalhado in (2350,2352,2351,2349,2348,2347,2346,2345,2344,2343,2817,2818,2819,2820,2821,2822,2824,2825,2826,2827,4235,4232,4233,4234,4227,4228,4229,4230,4231,4236) ) "Total Pagar Perfumes"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado in (4235,2343)) "1 Milha"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado in (2344,4233)) "812 Men Vip"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado in (4232,2345)) "812 Vip Rosé"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado in (4234,2346)) "812 Sexy"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado in (4227,2347)) "Man In Black"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado in (2348,4229)) "Girls"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado in (2349,4228)) "Fabulosa"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado in (2350,4230)) "Crystals"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado in (2351,4231)) "Champion"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado in (2352,4236)) "J Adoro"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2827) "Miss Lady"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2819) "Apolo"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2820) "Vida Bela"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2817) "Chic"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2818) "Ok Ele & Ela"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2824) "Intense (Woman)"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2825) "Infinite Blue"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2821) "Atitude"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2822) "Red Love"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2826) "Afrodite"
                     , pck_rankingpontuacao.fnc_retornapontuacaopedido(p.idpedido) pontuacao
                     , p.valortotal
                from favorita.vw_pedidos_fav p
                where p.idfilialromance = :P0_IDFILIAL
                  and ( :P578_IDREPRESENTANTE is null or p.idrepresentante = :P578_IDREPRESENTANTE )
                  and trunc(p.dataemissao) between to_date(:P578_DATAINICIO,'dd/mm/rrrr') and to_date(:P578_DATAFIM,'dd/mm/rrrr')
                  and exists ( select 1
                               from favorita.classificacoespedidos cp
                               where cp.idpedido = p.idpedido 
                                 and cp.idcaracteristicapedido = 73 )
                  and not exists ( select 1
                                   from favorita.classificacoespedidos cp
                                   where cp.idpedido = p.idpedido 
                                     and cp.idcaracteristicapedido = 25 )
                order by 1 desc;
                ```
        }
