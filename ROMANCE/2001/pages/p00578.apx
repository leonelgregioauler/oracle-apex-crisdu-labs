    branch (
        name: Go To Page 578
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 578
                items: {
                    P578_IDREPRESENTANTE: &P578_IDREPRESENTANTE.
                    P578_TIPO_RELATORIO: &P578_TIPO_RELATORIO.
                    P578_DATAINICIO: &P578_DATAINICIO.
                    P578_DATAFIM: &P578_DATAFIM.
                    P578_RELATORIO: &P578_RELATORIO.
                }
                action: resetPagination
            }
        }
