page 244 (
    name: Reembalagem
    title: Reembalagem
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region por-categoria (
        name: Por Categoria
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select id
                    , display_value
                    , return_value
                from (
                select null id
                     , ( select c.nome
                         from categorias c 
                         where c.idcategoria = p.idcategoria) display_value
                     , sum(nvl(e.qtd_pp,0)+nvl(e.qtd_p,0)+nvl(e.qtd_m,0)+nvl(e.qtd_g,0)+nvl(e.qtd_gg,0)+nvl(e.qtd_egg,0)+nvl(e.qtd_exgg,0)+nvl(e.qtd_u,0)) return_value
                from estoquefilial ef
                   , estoquereembalagem e
                   , produtos p
                where ef.idproduto = p.idproduto
                  and ef.idestoquefilial = e.idestoquefil
                  and ef.idfilial = :P0_IDFILIAL
                group by p.idcategoria
                order by 3 desc)
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DISPLAY_VALUE
            valueColumn: RETURN_VALUE
        }
    )

    region reembalagem (
        name: Reembalagem
        type: list
        source {
            list: @estoque-reembalagem-d
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--3cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

    region top-5-produto-em-estoque (
        name: Top 5 Produto em Estoque
        type: plugin/d3BarChart
        source {
            sqlQuery:
                ```sql
                select id
                    , display_value
                    , return_value
                from (
                        select null id
                             , pck_romance.fnc_nomeproduto(idproduto) display_value
                             , sum(nvl(e.qtd_pp,0)+nvl(e.qtd_p,0)+nvl(e.qtd_m,0)+nvl(e.qtd_g,0)+nvl(e.qtd_gg,0)+nvl(e.qtd_egg,0)+nvl(e.qtd_exgg,0)+nvl(e.qtd_u,0)) return_value
                        from estoquefilial ef
                           , estoquereembalagem e
                        where ef.idfilial = :P0_IDFILIAL
                          and ef.idestoquefilial = e.idestoquefil
                        group by idproduto
                        order by 3 desc)
                where rownum <=5;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            xValuesColumn: DISPLAY_VALUE
            yValuesColumn: RETURN_VALUE
            seriesName: Top 5
            valueFormatMask: attributeValue
            tooltips: showYValue
            colorScheme: modern2
        }
    )

)

