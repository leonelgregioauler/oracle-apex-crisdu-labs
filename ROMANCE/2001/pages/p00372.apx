page 372 (
    name: Logs Fechamento Distribuidor
    title: Logs Fechamento Distribuidor
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region alterações-do-fechamento (
        name: Alterações do Fechamento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.usuarioalteracao 
                     , decode(f.tipoalteracao,'INSERT','Inclusão','UPDATE','Atualização','DELETE','Exclusão') tipoalteracao
                     , f.dataalteracao
                     , f.idfechamentorepres 
                     , pck_romance.fnc_nomerepresentante(f.idrepresentante) representante
                     , f.totalcobranca 
                     , f.totalgeral
                     , f.vlrespecie
                     , f.vlrcheque
                     , ( select c.percpromotor
                         from comissoesfiliais c
                         where c.idcomissaofilial = f.idcomissao ) comissao
                     , f.vlrcomissao
                     , f.totaldepositos
                     , f.totaldepositoschq
                     , f.totalentregue
                     , f.totalpepinosrecebidos
                     , f.totalperdas
                     , f.totalchequessemfundo
                     , f.totalcomissoesfavoritarepres
                     , f.saldo
                     , f.valordevolvidoaorepres
                     , f.dataacerto
                     , f.usuarioacerto
                     , f.totaldebitosnovos
                from logroman.log_fechamentorepresentant f
                where f.idfechamentorepres = :P372_IDFECHAMENTOREPRES
                order by f.dataalteracao desc
                ```
            pageItemsToSubmit: P372_IDFECHAMENTOREPRES
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1826679029919342306
        }

