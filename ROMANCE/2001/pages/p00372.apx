    pageItem P372_IDFECHAMENTOREPRES (
        type: numberField
        label {
            label: Cod. Fechamento
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
