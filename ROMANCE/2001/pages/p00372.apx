            encryptSessionState: false
        }
    )

    dynamicAction atualiza-relatorio (
        name: Atualiza relatorio
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P372_IDFECHAMENTOREPRES
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P372_IDFECHAMENTOREPRES
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @alterações-do-fechamento
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

