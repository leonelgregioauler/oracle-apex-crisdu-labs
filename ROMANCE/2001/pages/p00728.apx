page 728 (
    name: Novo Motivo Reativa Clientes
    title: Novo Motivo - Reativação de Clientes
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region novo-motivo-reativação-de-clientes (
        name: Novo Motivo Reativação de Clientes
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P728_IDMOTIVOREATIVAVEND (
        type: hidden
        layout {
            sequence: 10
            region: @novo-motivo-reativação-de-clientes
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P728_MOTIVO (
        type: textField
        label {
            label: Motivo
            alignment: left
        }
        layout {
            sequence: 20
            region: @novo-motivo-reativação-de-clientes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P728_TIPO (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Conclusão;C,Devolução ;D
        }
        layout {
            sequence: 30
            region: @novo-motivo-reativação-de-clientes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 10
            region: @novo-motivo-reativação-de-clientes
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process insere-novo-motivo (
        name: Insere novo motivo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 
                 vidmotivoreativavend number := :P728_IDMOTIVOREATIVAVEND;
                 vmotivo              varchar2(100) := :P728_MOTIVO;
                 vtipo                varchar2(1) := :P728_TIPO;
                 voperacao_dml        varchar2(1) := 'I';
                 vmd5                 varchar2(32767) := null;
                
                
                begin
                
                roman.pck_cadastros_rmc.prc_motivosreativavend(pidmotivoreativavend => vidmotivoreativavend,
                                                               pmotivo              => vmotivo,
                                                               ptipo                => vtipo,
                                                               pmd5                 => :pmd5,
                                                               poperacao_dml        => voperacao_dml);
                                                               
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2432843347781084427
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 726
                action: resetPagination
            }
        }
    )

)

