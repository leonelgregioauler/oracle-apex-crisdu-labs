page 72 (
    name: Nova Entrada
    title: Nova Entrada
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='Confirma a exclusão da Entrada?';
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region nova-entrada (
        name: Nova Entrada
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P72_DATA (
        type: datePickerJquery
        label {
            label: Data
            alignment: left
        }
        layout {
            sequence: 110
            region: @nova-entrada
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_char(sysdate,'DD/MM/RRRR');
                end;
                ```
        }
        readOnly {
            type: itemIsNotNull
            item: P72_FECHAMENTOORIG
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_DESCRICAO (
        type: textarea
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 130
            region: @nova-entrada
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
            height: 4
        }
        validation {
            maxLength: 200
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P72_FECHAMENTOORIG
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_FECHAMENTOORIG (
        type: hidden
        layout {
            sequence: 20
            region: @nova-entrada
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: FECHAMENTOORIG
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_IDCONTACONTABIL (
        type: selectList
        label {
            label: Conta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idcontafinan  return_value
                from contasfinanceiras c
                where exists ( select 1
                               from matrizclassificacoesentradas m
                               where m.idmatrizentrada = :P72_IDMATRIZENTRADA
                                 and m.idcontafinan          = c.idcontafinan )
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P72_IDMATRIZENTRADA
        }
        layout {
            sequence: 90
            region: @nova-entrada
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTACONTABIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_IDENTRADA (
        type: hidden
        layout {
            sequence: 10
            region: @nova-entrada
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDENTRADA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 140
            region: @nova-entrada
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @nova-entrada
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_IDFILIALORIG (
        type: hidden
        layout {
            sequence: 30
            region: @nova-entrada
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALORIG
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_IDMATRIZENTRADA (
        type: selectList
        label {
            label: Matriz de Entrada
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.classificacaoentrada
                     , m.idmatrizentrada r
                from matrizclassificacoesentradas m
                where m.idfilial = :P72_IDFILIAL
                order by 1
                ```
            nullDisplayValue: - Selecione a Classificação -
        }
        cascadingLov {
            parentItems: P72_IDFILIAL
        }
        layout {
            sequence: 80
            region: @nova-entrada
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDMATRIZENTRADA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_IDSUBCONTACONTABIL (
        type: selectList
        label {
            label: Sub Conta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idSUBcontafinan  return_value
                from SUBcontasfinanceiras c
                where exists ( select 1
                               from matrizclassificacoesentradas m
                               where m.idmatrizentrada = :P72_IDMATRIZENTRADA
                                 and m.idsubcontafinan = c.idsubcontafinan )
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P72_IDMATRIZENTRADA
        }
        layout {
            sequence: 100
            region: @nova-entrada
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDSUBCONTACONTABIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_SEMANA (
        type: hidden
        layout {
            sequence: 40
            region: @nova-entrada
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: SEMANA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_char(sysdate,'IW/RRRR');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_TIPO (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Outros;O,Investimento;I,Fatura;F
            displayNullValue: false
        }
        layout {
            sequence: 150
            region: @nova-entrada
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: TIPO
            used: always
        }
        default {
            type: static
            staticValue: O
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_VALORTOTAL (
        type: numberField
        label {
            label: Valor Total
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 120
            region: @nova-entrada
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 12
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: VALORTOTAL
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P72_IDFILIALORIG
        }
        security {
            encryptSessionState: false
        }
    )

    button anexar-documentos (
        buttonName: ANEXAR_DOCUMENTOS
        label: Anexar Documentos
        layout {
            sequence: 10
            region: @nova-entrada
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 342
                items: {
                    P342_IDENTRADA: &P72_IDENTRADA.
                    P342_IDANEXODELETAR:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P72_IDENTRADA is not null
                  and exists ( select 1
                               from parametros p
                               where p.idfilial = :P0_IDFILIAL 
                                 and p.nome     = 'ANEXARDOCUMENTOS' 
                                 and p.valor    = 'S' )
                ```
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 20
            region: @nova-entrada
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 70
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 50
            region: @nova-entrada
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P72_IDENTRADA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 30
            region: @nova-entrada
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where :P72_IDENTRADA IS NOT NULL
                  AND :P72_IDFILIALORIG IS NULL
                  and exists ( select 1
                               from fechamentossemanais f
                               where f.idfechamento = :P72_IDFECHAMENTO
                                 and f.concluido    = 'N' )
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 40
            region: @nova-entrada
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from dual
                where :P72_IDENTRADA is not null
                  and exists ( select 1
                               from fechamentossemanais f
                               where f.idfechamento = :P72_IDFECHAMENTO
                                 and f.concluido    = 'N' )
                ```
        }
    )

    validation p72-idcontacontabil (
        name: P72_IDCONTACONTABIL
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P72_IDCONTACONTABIL
        }
        error {
            errorMessage: #LABEL# deve ser informada!
            associatedItem: @P72_IDCONTACONTABIL
        }
    )

    validation p72-valortotal (
        name: P72_VALORTOTAL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P72_VALORTOTAL
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P72_VALORTOTAL
        }
    )

    validation valida-matriz (
        name: Valida Matriz
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P72_IDMATRIZENTRADA
        }
        error {
            errorMessage: Por favor, utilize a classificação da Entrada!
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('SAVE','CREATE')
        }
    )

    process fetch-row-from-entradasdiversas (
        name: Fetch Row from ENTRADASDIVERSAS
        type: autoRowFetch
        source {
            tableName: ENTRADASDIVERSAS
            pkColumn: IDENTRADA
            pkItem: P72_IDENTRADA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 156907777845547373
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDENTRADASDIVERSAS.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P72_IDENTRADA := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 156907978980547373
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-entradasdiversas (
        name: Process Row of ENTRADASDIVERSAS
        type: autoRowProcessing
        target {
            tableName: ENTRADASDIVERSAS
            pkColumn: IDENTRADA
            pkItem: P72_IDENTRADA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table ENTRADASDIVERSAS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 156908173168547373
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        clear {
            type: pages
            pages: 64
        }
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 156908366069547374
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: Go To Page 70
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 70
            }
            saveStateBeforeBranching: true
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)

