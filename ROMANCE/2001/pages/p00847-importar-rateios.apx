page 847 (
    name: Importar Rateios
    alias: IMPORTAR-RATEIOS
    title: Importar Rateios da Planilha
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 90%
        height: 85%
        chained: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }

    region planilha (
        name: Planilha
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region prévia (
        name: Prévia
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ac.seq_id
                     , ac.c001 nomeempresa
                     , ac.c002 nomecentrocusto
                     , ac.n001 valor
                     , ac.n002 idsubconta
                     , ac.n003 idfilial
                     , ac.n004 idcentrodecusto
                     , ac.n003 idfilial_orig
                     , ac.n004 idcentrodecusto_orig
                     , ( select 'Centro de custo: '||c.nome||' - Conta: '||pck_romance.fnc_nomecontafinan(m.idcontafinan)||' - Sub Conta: '||pck_romance.fnc_nomesubcontafinan(m.idsubcontafinan)
                         from matrizregrasdespesas m
                            , centrodecustos c
                         where m.idmatrizregra   = ac.n005
                           and c.idcentrodecusto = m.idcentrodecusto ) matriz
                     , case ac.c004
                         when 'OK'          then case ac.c005 when 'SUGERIDO' then 'Vinculada (sugestão automática — confira)' else 'Vinculada' end
                         when 'SEM_VINCULO' then 'Sem vínculo: informe Filial e Centro de custo'
                         when 'SEM_MATRIZ'  then 'Sem matriz: não há regra ativa para '||pck_romance.fnc_nomefilial(ac.n003)||' / '||(select c.nome from centrodecustos c where c.idcentrodecusto = ac.n004)||' / '||pck_romance.fnc_nomesubcontafinan(ac.n002)
                         when 'DUPLICADA'   then 'Duplicada: mesma filial e matriz em outra linha'
                         else 'Erro: '||ac.c003
                       end status
                from apex_collections ac
                where ac.collection_name = 'IMPORTA_RATEIOS'
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: PREVIA
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchField
                actionsMenu
                saveButton
            ]
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 400
        }
        advanced {
            savedReportMappingIdentifier: 2026100984400025
        }

        savedReport previa-padrao (
            visibility: primary
            view {
                default: grid
                settingsAreaExpanded: false
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
