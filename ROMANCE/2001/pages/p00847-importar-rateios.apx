    region resumo-por-subconta (
        name: Resumo por subconta
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(pck_romance.fnc_nomesubcontafinan(ac.n002), 'Sem subconta') subconta
                     , count(*) linhas
                     , to_char(sum(ac.n001), 'FM999G999G999G990D00') valor
                from apex_collections ac
                where ac.collection_name = 'IMPORTA_RATEIOS'
                group by ac.n002
                order by 1
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: Planilha: &P847_QTDPLANILHA. linhas — total &P847_TOTALPLANILHA.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: apex_collection.collection_exists('IMPORTA_RATEIOS') and apex_collection.collection_member_count('IMPORTA_RATEIOS') > 0
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: Nenhuma linha carregada.
        }

        column LINHAS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Linhas
                alignment: end
