            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDCENTRODECUSTO (
            type: selectList
            heading {
                heading: Centro de custo
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select distinct c.nome d
                         , c.idcentrodecusto r
                    from matrizregrasdespesas m
                       , centrodecustos c
                    where c.idcentrodecusto = m.idcentrodecusto
                      and m.idfornecedor    = :P847_IDFORNECEDOR
                      and m.idfilial        = :IDFILIAL
                      and m.ativo           = 'S'
                    order by 1
                    ```
                displayExtraValues: false
                nullDisplayValue: - Selecione -
            }
            cascadingLov {
                parentColumns: IDFILIAL
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: IDCENTRODECUSTO
                dataType: number
            }
        )

        column IDCENTRODECUSTO_ORIG (
            type: hidden
            layout {
                sequence: 94
            }
            source {
                databaseColumn: IDCENTRODECUSTO_ORIG
                dataType: number
            }
        )

        column IDFILIAL (
            type: selectList
            heading {
                heading: Filial
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomefilial(f.idfilial) d
                         , f.idfilial r
                    from filiais f
                    where f.ativo = 'S'
                      and exists ( select 1
                                   from matrizregrasdespesas m
                                   where m.idfornecedor = :P847_IDFORNECEDOR
                                     and m.idfilial     = f.idfilial
                                     and m.ativo        = 'S' )
                    order by 1
                    ```
                displayExtraValues: false
                nullDisplayValue: - Selecione -
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
            }
        )

        column IDFILIAL_ORIG (
            type: hidden
            layout {
                sequence: 92
            }
            source {
                databaseColumn: IDFILIAL_ORIG
                dataType: number
            }
        )

        column IDSUBCONTA (
            type: selectList
            heading {
                heading: Subconta
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select distinct pck_romance.fnc_nomecontafinan(m.idcontafinan)||' / '||pck_romance.fnc_nomesubcontafinan(m.idsubcontafinan) d
                         , m.idsubcontafinan r
                    from matrizregrasdespesas m
                    where m.idfornecedor = :P847_IDFORNECEDOR
                      and m.ativo        = 'S'
                    order by 1
                    ```
                displayExtraValues: false
            }
            layout {
                sequence: 70
            }
