            selectionType: region
            region: @prévia
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    pck_importarateios_rmc.prc_resolve(:P847_IDREQUISICAO);
                    :P847_AVISO := pck_importarateios_rmc.fnc_aviso_rateio_existente(:P847_IDREQUISICAO);
                    ```
                itemsToSubmit: P847_IDREQUISICAO
                itemsToReturn: P847_AVISO
                showProcessing: true
            }
            execution {
