    process calcula-aviso-de-rateio-existente (
        name: Calcula aviso de rateio existente
        type: executeCode
        source {
            plsqlCode: :P847_AVISO := pck_importarateios_rmc.fnc_aviso_rateio_existente(:P847_IDREQUISICAO);
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 5827516885663087815
        }
    )

    process carrega-prévia (
        name: Carrega prévia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vconteudo clob;
                  vqtd      number;
                  vtotal    number;
                begin
                  if :P847_IDSUBCONTA is null then
                    raise_application_error(-20001, 'Informe a subconta padrão.');
                  end if;
                  --
                  if :P847_ARQUIVO is not null then
                    select pck_importarateios_rmc.fnc_blob_para_clob(f.blob_content)
                    into vconteudo
                    from apex_application_temp_files f
                    where f.name = :P847_ARQUIVO;
                  else
                    vconteudo := :P847_TEXTO;
                  end if;
                  --
                  if vconteudo is null or dbms_lob.getlength(vconteudo) = 0 then
                    raise_application_error(-20001, 'Envie o arquivo CSV ou cole as linhas do Excel.');
                  end if;
                  --
                  pck_importarateios_rmc.prc_carrega( pidrequisicao => :P847_IDREQUISICAO
                                                    , pidsubconta   => :P847_IDSUBCONTA
                                                    , pconteudo     => vconteudo
                                                    , pqtdlinhas    => vqtd
                                                    , pvalortotal   => vtotal );
                  --
                  if :P847_ARQUIVO is not null then
                    dbms_lob.freetemporary(vconteudo);
                  end if;
                  --
                  :P847_QTDPLANILHA   := vqtd;
                  :P847_TOTALPLANILHA := to_char(vtotal, 'FM999G999G999G990D00', 'nls_numeric_characters='',.''');
                  --
                  :P847_ARQUIVO := null;
                  :P847_TEXTO   := null;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1975384329391728778
        }
        serverSideCondition {
            whenButtonPressed: @previsualizar
        }
    )

    process confirma-importação (
        name: Confirma importação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_importarateios_rmc.prc_confirma( pidrequisicao => :P847_IDREQUISICAO
                                                     , pusuario      => v('APP_USER') );
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Rateios importados!
        }
        advanced {
            executionMappingIdentifier: 6586669600452360203
        }
        serverSideCondition {
            whenButtonPressed: @confirmar
        }
    )

    process fecha-diálogo (
        name: Fecha diálogo
        type: closeDialog
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 5682877211348179891
        }
        serverSideCondition {
            whenButtonPressed: @confirmar
        }
    )

    process inicia-collection (
        name: Inicia collection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P847_INICIADO is null then
                    apex_collection.create_or_truncate_collection(pck_importarateios_rmc.c_colecao);
                    :P847_INICIADO := 'S';
                  end if;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 8483165301193135590
        }
    )

    process prévia-save-interactive-grid-data (
        name: Prévia - Save Interactive Grid Data
        type: executeCode
        editableRegion: @prévia
        source {
            plsqlCode:
                ```plsql
                declare
                  vmudou boolean;
                begin
                  if :APEX$ROW_STATUS = 'D' then
                    apex_collection.delete_member( p_collection_name => pck_importarateios_rmc.c_colecao
                                                 , p_seq             => :SEQ_ID );
                  elsif :APEX$ROW_STATUS = 'U' then
                    vmudou := not ( nvl(:IDFILIAL, -1)        = nvl(:IDFILIAL_ORIG, -1)
                                and nvl(:IDCENTRODECUSTO, -1) = nvl(:IDCENTRODECUSTO_ORIG, -1) );
                    --
                    if vmudou and ( :IDFILIAL is null or :IDCENTRODECUSTO is null ) then
                      raise_application_error(-20001, 'Informe Filial e Centro de custo.');
                    end if;
                    --
                    pck_importarateios_rmc.prc_atualiza_linha( pseq             => :SEQ_ID
                                                             , pidsubconta      => :IDSUBCONTA
                                                             , pidfilial        => case when vmudou then :IDFILIAL        end
                                                             , pidcentrodecusto => case when vmudou then :IDCENTRODECUSTO end );
                  end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 6517292322882108882
        }
        serverSideCondition {
            type: request!=Value
            value: PREVISUALIZAR
        }
    )

)

