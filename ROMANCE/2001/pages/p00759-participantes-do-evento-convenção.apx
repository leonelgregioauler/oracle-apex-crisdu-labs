page 759 (
    name: Participantes do Evento(Convenção)
    alias: PARTICIPANTES-DO-EVENTO-CONVENÇÃO
    title: Participantes do Evento(Convenção)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }

    region identificar-participantes-do-evento (
        name: Identificar Participantes do Evento
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpessoaconvencao
                     , p.nomecompleto nome
                     , p.parentesco identificacao
                     , pck_romance.fnc_nomefilial(p.idfilial) franquia
                     , ( select setor 
                         from setoreschamados s 
                         where s.idsetorchamado = p.idsetor ) setor
                     , case 
                         when p.parentesco != 'Proprio' then
                           pck_romance.fnc_nomerepresentante(p.idrepresentante) 
                         else
                           '-'
                       end acompanhante_de
                     , p.vaiparticipardoevento
                from pessoasconvencao p
                --where p.idfilial = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 10
            slot: fullWidthContent
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 108303274394987627
        }

        savedReport 2831393 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @NOME
