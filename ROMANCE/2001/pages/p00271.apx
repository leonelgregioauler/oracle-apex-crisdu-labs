page 271 (
    name: Correção de Rec. de Compra
    title: Correção de Rec. de Compra
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 50%
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            if ($v("P271_IDNOTAFISCAL")=="")
                {
                    window.parent.opener.location.reload();
                    window.close();
                }
            ```
    }
    headerAndFooter {
        footerText:
            ```html
            <script javascript>
             window.resizeTo(screen.width*.46,screen.height*.46);  
                window.moveTo(screen.width*.26, screen.height*.20);  
            </script>
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region correção-de-rec-de-compra (
        name: Correção de Rec. de Compra
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P271_DATACORRECAO (
        type: hidden
        layout {
            sequence: 20
            region: @correção-de-rec-de-compra
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATACORRECAO
            used: always
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P271_IDCORRECAONOTAFISCAL (
        type: hidden
        layout {
            sequence: 10
            region: @correção-de-rec-de-compra
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCORRECAONOTAFISCAL
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P271_IDNOTAFISCAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @correção-de-rec-de-compra
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDNOTAFISCAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P271_MOTIVO (
        type: textarea
        label {
            label: Motivo
            alignment: left
        }
        settings {
            charCounter: true
        }
        layout {
            sequence: 40
            region: @correção-de-rec-de-compra
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
            height: 8
        }
        validation {
            maxLength: 500
        }
        source {
            type: databaseColumn
            databaseColumn: MOTIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P271_USUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @correção-de-rec-de-compra
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: expression
            plsqlExpression: v('app_user')
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @correção-de-rec-de-compra
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 25
                items: {
                    P25_IDNOTAFISCAL: &P271_IDNOTAFISCAL.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @correção-de-rec-de-compra
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P271_IDCORRECAONOTAFISCAL
        }
    )

    validation not-is-null (
        name: Not is null
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P271_MOTIVO
        }
        error {
            errorMessage: Favor incluir um motivo.
            associatedItem: @P271_MOTIVO
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P271_IDCORRECAONOTAFISCAL is null then
                        select "#OWNER#"."SEQ_IDCORRECAONOTAFISCAL".nextval
                          into :P271_IDCORRECAONOTAFISCAL
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 65689737161904723
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-correcoesnotasfiscais (
        name: Process Row of CORRECOESNOTASFISCAIS
        type: autoRowProcessing
        target {
            tableName: CORRECOESNOTASFISCAIS
            pkColumn: IDCORRECAONOTAFISCAL
            pkItem: P271_IDCORRECAONOTAFISCAL
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 65690162646904724
        }
    )

    branch (
        name: go to page 25
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 271
                items: {
                    P271_IDNOTAFISCAL:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)

