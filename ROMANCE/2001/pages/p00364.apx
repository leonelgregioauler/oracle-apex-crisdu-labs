page 364 (
    name: Relatório de Notas Para Recuperar Promissória
    title: Relatório de Notas Para Recuperar Promissória
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region notas (
        name: Notas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda id
                     , to_number(nv.numeronota) nro
                     , nv.datanota
                     , nv.semanacobranca "Cobrança"
                     , nvl(nv.enviadocobranca,'N') 
                     , roman.pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) "Vendedora"
                     , roman.pck_romance.fnc_nomeregiaovenda(nv.idregiaovenda) "Região"
                     , nv.saldo
                     , trunc(nv.dataacerto) dataacerto  
                     , trunc(nvl(dataretorno, datanota+42))+60 prazo
                     , ( select max(trunc(datapagamento))
                         from roman.pagamentosnotasvendas p
                         where p.idnotavenda = nv.idnotavenda ) "Ult. Pgto"  
                     , case decode(promissoriarecuperada,'S','N',decode(nv.recuperarpromissoria,'S','S','N'))
                         when 'S' THEN  'Recup Promissória' 
                             end    "Recup. Promi./Enviar SPC"
                     , decode(nv.enviadocobranca,'S', 'Sim','Não') "Enviado para Cobrança"
                from roman.notasvendas    nv
                where nv.idfilial        = :P0_IDFILIAL
                  and nv.idrepresentante = :P364_IDREPRESENTANTE
                  and nv.idsituacaonotavenda = 4
                  and nvl(nv.promissoriarecuperada,'N') = 'N'
                  and nv.saldo > 0
                  and nv.recuperarpromissoria = 'S'
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1408440932801794306
        }

        column Cobrança (
            type: plainText
            heading {
                heading: Data para Cobrança
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

