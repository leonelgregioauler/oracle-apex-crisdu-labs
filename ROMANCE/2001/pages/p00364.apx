        layout {
            sequence: 10
            region: @notas-para-recuperar-promissória
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction filtrar (
        name: Filtrar
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P364_IDREPRESENTANTE
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P364_IDREPRESENTANTE
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

