        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P364_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Representante
            alignment: left
        }
        settings {
            displayAs: modalDialog
