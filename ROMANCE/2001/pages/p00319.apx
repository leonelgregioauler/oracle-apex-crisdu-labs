    button 319-inclui-correcao (
        buttonName: 319_INCLUI_CORRECAO
        label: Efetuar Correção
        layout {
            sequence: 50
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 208
                items: {
                    P208_IDDEVOLUCAOREPRES: &P319_IDDEVOLUCAOREPRES.
                    P208_IDCORRECAODEVOLUCAO:
                    P208_PAGINA: 319
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: 115_INCLUI_CORRECAO
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where :P319_IDDEVOLUCAOREPRES is not null
                  and :P319_SITUACAO = 3
                  and :P0_ESTOQUECONGELADO = 'N'
                 -- and trunc(sysdate) - trunc(to_date(:P319_DATACONCLUSAO,'dd/mm/rrrr hh24:mi:ss')) <= 2
                  and ( trunc(sysdate) - trunc(to_date(:P319_DATACONCLUSAO,'dd/mm/rrrr hh24:mi:ss')) <= 1
                       or exists ( select 1
                               from correcaodevolucao c
                               where c.iddevolucaorepres = :P319_IDDEVOLUCAOREPRES 
                                 and c.usuario = 'OPTIMUS'
                                 and trunc(sysdate) - trunc(c.datacorrecao) <= 1 ) )
                ```
        }
    )

