    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function formatar_mascara(src,mascara,evt){
              var tecla;  
              if(evt.which)
                {
                  tecla = evt.which
                }
              else 
                if(evt.keyCode)
                  { 
                    tecla = evt.keyCode;
                  }
              if ( tecla != 8 && tecla!=13 && tecla!=47 && tecla!=59) 
                {
                  var campo = src.value.length;
                  var saida = mascara.substring(0,1);
                  var texto = mascara.substring(campo);
                  if(texto.substring(0,1) != saida) 
                    { 
                      src.value+=texto.substring(0,1);
                    }
                }
              
            }
            
            function fnc_popup_produto()
            {
              viddevol = document.getElementById('P319_IDDEVOLUCAOREPRES').value;
              window.open( 'f?p=&APP_ID.:320:&SESSION.::NO::P320_IDDEVOLUCAOREPRES,P320_IDITEMDEVOLUCAOREPRES,P320_OPCAO:'+viddevol +',,C', 'CADITEMDEVOL', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=500,left=250,top=100','_blank'); void(0);
            }
            
            
            function fnc_imprime()
            {
