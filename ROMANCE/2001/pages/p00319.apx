    dynamicAction concluir-devolução (
        name: Concluir Devolução
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @save
        }
        serverSideCondition {
            type: item=value
            item: P319_SITUACAO
            value: 1
        }

        action native-confirm (
            action: confirm
            settings {
                title: Atenção
                message: Você realmente deseja concluir?
                style: warning
                confirmLabel: Sim
                cancelLabel: Não
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vusuario varchar2(100) := v('APP_USER');
                    begin
                      --
                      pck_estoque_v2.prc_concluidevolucao(piddevolucaorepres => :P319_IDDEVOLUCAOREPRES,
                                                          pusuario => vusuario);
                      --
                      update devolucoesrepresentantes
                      set situacao = 3
                      where iddevolucaorepres = :P319_IDDEVOLUCAOREPRES;
                      --
                      commit;
                      --
                    end;
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: "location.reload(); "
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @create
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @create
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CREATE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

