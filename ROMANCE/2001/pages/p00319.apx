                  update devolucoesrepresentantes
                  set situacao = 3
                  where iddevolucaorepres = :P319_IDDEVOLUCAOREPRES;
                  --
                  pck_estoque_v2.prc_concluidevolucao(piddevolucaorepres => :P319_IDDEVOLUCAOREPRES,
