    process libera-correcao (
        name: Libera Correcao
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update devolucoesrepresentantes
                  set dataconclusao = sysdate
                  where iddevolucaorepres = :P319_IDDEVOLUCAOREPRES;
                  --
                  insert into correcaodevolucao(idcorrecaodevolucao,datacorrecao,usuario,motivo,iddevolucaorepres,idrepresentante)
                  values (seq_idcorrecaodevolucao.nextval,sysdate,'OPTIMUS','Devolução liberada para correção!',:P319_IDDEVOLUCAOREPRES,:P319_IDREPRESENTANTE);
                  --
                end;
                ```
        }
        execution {
            sequence: 15
        }
        successMessage {
            successMessage:
                ```
                Correção Liberada!
                
                ```
        }
        error {
            errorMessage: Entre em contato com o Administrador do Sistema!
        }
        advanced {
            executionMappingIdentifier: 6830418146331423
        }
        serverSideCondition {
            whenButtonPressed: @liberar-correção
        }
    )

