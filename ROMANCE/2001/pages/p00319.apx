            function  confirmadevol(event)
            { var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            if (tecla==13) 
            { var answer = confirm("Confirma inclusão da devolução?")
              if (answer)
              {apex.submit('CREATE');}}}
            
            
            function  cancelar(event)
            { 
              var answer = confirm("Deseja realmente cancelar a devolução?")
              if (answer)
                {
                  apex.submit('APPLY');
                }
            }
            
