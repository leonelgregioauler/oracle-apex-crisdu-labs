    process atualiza (
        name: atualiza
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                update devolucoesrepresentantes d
                set d.valortotal = ( select SUM((( nvl(i.qtd_pp,0)
                                           + nvl(i.qtd_p,0)
                                           + nvl(i.qtd_m,0)
                                           + nvl(i.qtd_g,0)
                                           + nvl(i.qtd_gg,0)
                                           + nvl(i.qtd_egg,0)
                                           + nvl(i.qtd_u,0))*i.valorproduto) )
                                    from itensdevolucaorepres i
                                    where i.iddevolucaorepres = d.iddevolucaorepres )
                where d.iddevolucaorepres = :P319_IDDEVOLUCAOREPRES;
                END;
                ```
        }
        execution {
            sequence: 1
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 6827656800331421
        }
    )

    process cancelar (
        name: Cancelar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                 :P319_SITUACAO := 0;
                    delete itensdevolucaorepres i
                    where i.iddevolucaorepres = :p319_iddevolucaorepres;
                end;
                ```
        }
        execution {
            sequence: 1
        }
        successMessage {
            successMessage: Devolução cancelada!
        }
        advanced {
