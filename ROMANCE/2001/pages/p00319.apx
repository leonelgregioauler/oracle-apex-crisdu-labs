    pageItem P319_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||r.idrepresentante||') - ' || decode(r.ativo,'S','','Inativo') display_value
                     , r.idrepresentante
                from representantes r
                where idgerente in ( select idgerente
                                     from gerentes
                                     where idfilial = :P0_IDFILIAL)
                  and idpostoavancado = :P319_IDPOSTOAVANCADO
                  and ativo = 'S'
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o Representante -
        }
        layout {
            sequence: 40
            region: @devoluções-de-distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P319_IDDEVOLUCAOREPRES
        }
        security {
            encryptSessionState: false
        }
    )

