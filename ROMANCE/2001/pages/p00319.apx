    region itens-da-devolução (
        name: Itens da Devolução
        type: tabform
        source {
            sqlQuery:
                ```sql
                select i.iditemdevolucaorepres
                     , i.iddevolucaorepres
                     , i.idestoquefil
                     , ( select p.codigosisdist
                         from produtos p
                         where p.idproduto = i.idproduto ) "Código"
                     , pck_romance.fnc_nomeproduto(pidproduto => i.idproduto) "Produto"
                     , decode(e.comissao, 'S', 'Sim', 'N', 'Não') "Comissão?"
                     , i.qtd_pp
                     , i.qtd_p
                     , i.qtd_m
                     , i.qtd_g
                     , i.qtd_gg
                     , i.qtd_egg
                     , i.qtd_exgg
                     , i.qtd_u
                     , ( select d.descricao from defeitos d where d.iddefeito = i.iddefeito ) "Defeito"
                     , i.valorproduto "Vlr Venda"
                     , (( nvl(i.qtd_pp,0)
                       + nvl(i.qtd_p,0)
                       + nvl(i.qtd_m,0)
                       + nvl(i.qtd_g,0)
                       + nvl(i.qtd_gg,0)
                       + nvl(i.qtd_egg,0)
                       + nvl(i.qtd_exgg,0)
                       + nvl(i.qtd_u,0))*i.valorproduto) "Total"
                     , ( nvl(i.qtd_pp,0)
                       + nvl(i.qtd_p,0)
                       + nvl(i.qtd_m,0)
                       + nvl(i.qtd_g,0)
                       + nvl(i.qtd_gg,0)
                       + nvl(i.qtd_egg,0)
                       + nvl(i.qtd_exgg,0)
                       + nvl(i.qtd_u,0)) "Qtd Total"
                     , decode(i.estoquedestino,'S','Reembalagem PA','P','Distribuição PA','F','Defeito',i.estoquedestino) "Destino"
                     , i.idproduto
                     , i.estoquedestino
                     , ( select decode(origemdefeito,'F','Forncedor','R','Distribuidor')
                         from defeitos d
                         where d.iddefeito = i.iddefeito ) origemdefeito
                from itensdevolucaorepres i
                   , estoquefilial        e
                where i.idestoquefil      = e.idestoquefilial(+)
                  and i.iddevolucaorepres = :P319_IDDEVOLUCAOREPRES
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <b><font size="4" color="red"> Ao incluir um produto que já foi lançado na devolução, ele irá somar com a quantidade que já existia mais a quantidade nova que será lançada. Ex.: Tinha 15 Cueca Euro incluída as 09:00, as 10:00 inclui mais 20, então a quantidade nova ficará com 35. </font></b>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P319_IDDEVOLUCAOREPRES is not null
                  and :P319_SITUACAO != 0
                ```
        }
        reportLayout {
            numberOfRows: 1500
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
