    pageItem P762_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Representante
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||decode(r.ativo,'S','Ativo','N','Inativo')||') - '||r.idrepresentante display_value
                     , r.idrepresentante
                from representantes r
                where pck_romance.fnc_filialgerente(pidgerente => r.idgerente) = :P0_IDFILIAL
                 -- and r.ativo  = 'S'
                order by 1 
                ```
        }
        layout {
            sequence: 10
            region: @log-de-representante
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtar (
        buttonName: Filtar
        label: Filtar
        layout {
            sequence: 10
            region: @log-de-representante
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
            point: processing
        }
        behavior {
            target: {
                page: 762
                items: {
                    P762_IDREPRESENTANTE: &P762_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
    )

)

