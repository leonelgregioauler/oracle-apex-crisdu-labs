page 762 (
    name: Log Representantes
    alias: LOG-REPRESENTANTES
    title: Log Representantes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region log-de-representante (
        name: "Log de Representante "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region log-representante (
        name: Log Representante
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.dataalteracao "Data Alteração"
                     , v.usuarioalteracao "Usuario Alterou"
                     , decode(v.tipoalteracao,'UPDATE','Alteração','INSERT','Inclusão','DELETE','Exclusão') "Tipo Alteração"
                     , v.idrepresentante "ID Rep"
                     , v.idpessoa "ID Pessoa"
                     , decode(v.ativo,'S','Sim','N','Não') "Ativo"
                     , v.observacao "Observação"
                     , roman.pck_romance.fnc_nomepostoavancado(v.idpostoavancado) "Posto Avançado"
                     , pck_util.fnc_semanaid(v.semanaparou) "Semana Parou"
                     , (select nvl(cpf, documentoestrangeiro) from catal.pessoas where idpessoa = v.idpessoa) "Documento"
                     , roman.pck_romance.fnc_nomefilial(v.idfilial) "Filial"
                     , roman.pck_romance.fnc_nomegerente(v.idgerente) "Gerente"
                from logcatal.log_representantes v
                where v.idrepresentante = :P762_IDREPRESENTANTE
                order by v.idlog desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: singleRowView
        }
        singleRowView {
            excludeNullValues: true
            onlyDisplayedColumns: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Não há informações.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1233815998681497343
        }

