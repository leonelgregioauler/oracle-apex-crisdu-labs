    process gera-sms-para-consultoras (
        name: Gera SMS para Consultoras
        type: executeCode
        editableRegion: @lista-de-consultoras
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vcodigo      number;
                  --
                  vidmensagemsms          number := null;
                  vmensagem               varchar2(200);
                  vdatainclusao           date := sysdate;
                  vdataenvio              date;
                  vretorno                varchar2(1000);
                  vidprocessosistema      number := 37;
                  ventregue               varchar2(1) := 'N';
                  vidcontrolecontatossite number := null;
                  vididioma               number := 1;
                  --
                begin
                  --
                  select w.codigo
                  into vcodigo
                  from vw_vendedoras_acordoaki w
                  where w.idpessoa = :IDPESSOA;
                  --
                  vidmensagemsms := null;
                  vmensagem      := 'Acesse www.acordoaki.com.br/'||vcodigo||' para ver a oferta que preparamos para voce, e volte a trabalhar conosco.';
                  --
                  for tel in ( select pck_util.fcn_retornasonumeros(tf.telefone) telefone
                               from telefonespessoas tf
                               where tf.idpessoa = :IDPESSOA
                                 and tf.telefone is not null
                               order by tf.ultimaatualizacao desc )
                  loop
                    --
                    pck_integracao_mob.prc_mensagenssms( pidmensagemsms          => vidmensagemsms,
                                                         ptelefone               => tel.telefone,
                                                         pmensagem               => vmensagem,
                                                         pdatainclusao           => vdatainclusao,
                                                         pdataenvio              => vdataenvio,
                                                         pretorno                => vretorno,
                                                         pidpessoa               => :IDPESSOA,
                                                         pidprocessosistema      => vidprocessosistema,
                                                         pentregue               => ventregue,
                                                         pidcontrolecontatossite => vidcontrolecontatossite,
                                                         pididioma               => vididioma,
                                                         poperacaodml            => 'I');
                    --
                    commit;
                    exit;
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Mensagens enviadas com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5394804841000274440
        }
        serverSideCondition {
            whenButtonPressed: @enviar-mensagem
        }
    )

    branch (
        name: filtrar
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 604
                items: {
                    P604_IDREPRESENTANTE: &P604_IDREPRESENTANTE.
                    P604_IDREGIAOVENDA: &P604_IDREGIAOVENDA.
                    P604_VALOR_INI: &P604_VALOR_INI.
                    P604_VALOR_FIM: &P604_VALOR_FIM.
                }
                action: resetPagination
            }
        }
    )

