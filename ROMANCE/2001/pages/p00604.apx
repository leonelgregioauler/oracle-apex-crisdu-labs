        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region lista-de-consultoras (
        name: Lista de Consultoras
        type: tabform
        source {
            sqlQuery:
                ```sql
                select distinct p.idpessoa
                     , initcap(p.nomepessoa)||' - '||p.cpf nomepessoa
                     , pck_romance.fnc_retornatelefones(v.idvendedora)telefone
                     , pck_romance.fnc_nomecidade(p.idcidade) nomecidade
                     , p.bairro
                     , n.numeronota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , ( select rv.descricao from regioesvenda rv where rv.idregiaovenda = ( select vv.idregiaovenda from vendedoras vv where vv.idpessoa = p.idpessoa)) "Regiao Consultora"
                     , n.valortotalnota
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , n.idnotavenda
                from pessoas p
                   , vendedoras v
                   , notasvendas n
                where v.idpessoa        = p.idpessoa
                  and n.idregiaovenda   = :P604_IDREGIAOVENDA                            
                  and v.idvendedora     = n.idvendedora
                  and n.idrepresentante = :P604_IDREPRESENTANTE
                  and n.idsituacaonotavenda = 4
                  and n.saldo between to_number(:P604_VALOR_INI) and to_number(:P604_VALOR_FIM)
                  and nvl(n.enviadocobranca,'N') = 'S'
                  and n.saldo > 0
                  and ( not exists ( select 1
                                     from mensagenssms m
                                     where m.idpessoa = p.idpessoa
                                       and m.idprocessosistema = 37 )
                      or ( not exists ( select 1
                                        from mensagenssms m
                                        where m.idpessoa = p.idpessoa
                                          and m.idprocessosistema = 37
                                          and trunc(sysdate) - trunc(m.datainclusao) < 30 ) 
                           and exists ( select 1
                                        from mensagenssms m
                                        where m.idpessoa = p.idpessoa
                                          and m.idprocessosistema = 37
                                          and trunc(sysdate) - trunc(m.datainclusao) > 30 ) ) )
                order by saldo 
                ```
        }
