page 192 (
    name: Exportar para Planilha de Distribuição
    title: Exportar para Planilha de Distribuição
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region exportar-para-planilha-de-distribuição (
        name: Exportar para Planilha de Distribuição
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.classificacao1 opcao1
                     , ( select p.codigosisdist from produtos p where e.idproduto = p.idproduto)  codigosisdist
                     , e.classificacao2 tipoestoque
                     , ( select c.nome from categorias c where c.idcategoria = ( select p.idcategoria from produtos p where e.idproduto = p.idproduto) ) categoria
                     , ( select initcap(p.nomeproduto) from produtos p where e.idproduto = p.idproduto)  produto
                     , (nvl(e.qtd_pp ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'PP')  )
                     + (nvl(e.qtd_p  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'P')   )
                     + (nvl(e.qtd_m  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'M')   )
                     + (nvl(e.qtd_g  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'G')   )
                     + (nvl(e.qtd_gg ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'GG')  )
                     + (nvl(e.qtd_egg,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EGG') )
                     + (nvl(e.qtd_exgg,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EXGG') )
                     + (nvl(e.qtd_u  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'U'))  estoque
                     , e.vlrvenda 
                     , decode(e.comissao,'S','Sim','Não') comissao
                     , idestoquefilial
                from estoquefilial e
                where e.idfilial = :P0_IDFILIAL
                  and e.ativo = 'S'
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
