page 132 (
    name: Atualizar Promissórias
    title: Atualizar Promissórias
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function  retornainformacao()
            {
              for(i=0;i<document.wwv_flow.length;i++)
               {
                
                      if( document.wwv_flow.f02[i].value == "")  
                      {
                        var ajaxRequest = new htmldb_Get(null,&APP_ID.,'APPLICATION_PROCESS=buscafilial',0);
                        
                        var ajaxRequest3 = new htmldb_Get(null,&APP_ID.,'APPLICATION_PROCESS=buscainfodenotas',0);
                        
                        var ajaxRequest4 = new htmldb_Get(null,&APP_ID.,'APPLICATION_PROCESS=buscapromissorias',0);
                          
                        ajaxRequest.add('F2001275CPF',document.wwv_flow.f01[i].value);
                        ajaxRequest3.add('F2001275CPF',document.wwv_flow.f01[i].value);
                        ajaxRequest4.add('F2001275CPF',document.wwv_flow.f01[i].value);
            
                        ajaxResult  = ajaxRequest.get();
                        ajaxResult3 = ajaxRequest3.get();
                        ajaxResult4 = ajaxRequest4.get();
            
                        document.wwv_flow.f02[i].value = ajaxResult;
                        document.wwv_flow.f03[i].value = ajaxResult3;
                        document.wwv_flow.f04[i].value = ajaxResult4;
                       
                        ajaxRequest = null;
                        ajaxRequest3 = null;
                        ajaxRequest4 = null;
                          
                      }
                       
                      ajaxResult2 = null;
                  
                      if( document.wwv_flow.f01[i].value == "" )
                      {
                          document.wwv_flow.f02[i].value = ajaxResult2;
                          document.wwv_flow.f03[i].value = ajaxResult2;
                          document.wwv_flow.f04[i].value = ajaxResult2;
                      }
               } 
            }
            ```
    }
