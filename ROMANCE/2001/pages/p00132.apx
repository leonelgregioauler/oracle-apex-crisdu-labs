        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where catal.pck_util.fnc_verificaacesso(3541,v('APP_USER')) = 'S' 
                  and exists ( select 1
                               from favorita.tarefas t
                               where t.idtipotarefa = 33
                                 and trunc(t.datainclusao) = trunc(sysdate) )
                ```
        }
