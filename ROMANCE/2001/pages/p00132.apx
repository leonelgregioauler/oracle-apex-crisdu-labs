    process atualiza-notas-vendas (
        name: atualiza notas vendas
        type: executeCode
        editableRegion: @notas-de-venda
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidnota        number;
                  vcpf           varchar2(15);
                  vidvendedora   number;
                  vidpessoa      number;
                  vidusuario     number;
                  i              integer;
                  verro          varchar2(2000);
                  vidpromissoria number := to_number(:P132_SITUACAOPROMISSORIA,'999G999G999G999G990D00');
                  vatualiza      varchar2(1) := :ATUALIZARPOMISSORIA;
                  vpromissoria   varchar2(300);
                  vassinaturaterceiro varchar2(1000) := :ASSINATURATERCEIRO;
                  --
                  vregistratarefa varchar2(1);
                  --
                  vidclassificacaonotavenda  number;
                  vidcaracteristicanotavenda number := 4;
                  vdataclassificado          date := sysdate;
                  vidvalorcaracteristica     number;
                  vobservacao                varchar2(1000);
                  --
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios 
                  where usuario = v('APP_USER');
                  --
                  select pck_util.fnc_verificaacesso(3541,v('APP_USER'))
                  into vregistratarefa
                  from dual;
                  --
                  vcpf := replace(replace(:CPF,'.',''),'-','');
                  --
                  begin
                    --
                    select v.idvendedora 
                         , v.idpessoa
                    into vidvendedora
                       , vidpessoa
                    from vendedoras v
                       , pessoas p
                    where p.idpessoa = v.idpessoa
                      and p.cpf = vcpf;
                  exception
                    when others then
                      vcpf := null;
                  end;
                  --
                  select s.descricao
                  into vpromissoria
                  from catal.situacoespromissorias s
                  where s.idsituacaopromis = vidpromissoria;
                  --
                  if vcpf is not null then
                      --
                      for i in ( select n.idnotavenda
                                 from notasvendas n
                                 where n.idvendedora = vidvendedora 
                                   and n.saldo > 0
                                   and n.idsituacaonotavenda = 4 )
                      loop 
                        --
                        vidclassificacaonotavenda := null;
                        --
                        pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda  => vidclassificacaonotavenda,
                                                                        pidnotavenda               => i.idnotavenda,
                                                                        pidcaracteristicanotavenda => vidcaracteristicanotavenda,
                                                                        pdataclassificado          => vdataclassificado,
                                                                        pidusuario                 => vidusuario,
                                                                        pidvalorcaracteristica     => vidvalorcaracteristica,
                                                                        pobservacao                => vobservacao,
                                                                        poperacao_dml              => 'I');
                        --
                        if vatualiza = 'S' then
                          --
                          begin
                            --
                            update notasvendas
                            set IDSITUACAOPROMISSORIA = vidpromissoria
                              , recuperarpromissoria  = nvl(:RECUPERARPROMISSORIA,'N')
                              , usuariopromissoriarec = v('APP_USER')
                              , dataatualizacaopromissoria = sysdate
                              , promissoriarecuperada = 'S'
                            where idnotavenda  = i.idnotavenda;
                            --
                            if :ASSINATURATERCEIRO is not null then
                              --
                              insert into observacoesnotasvendas
                              values (seq_idobsnotavenda.nextval, i.idnotavenda, sysdate, 'Promissória Atualizada - '||vpromissoria||'. Assinatura de Terceiro: '||vassinaturaterceiro||'.', v('APP_USER'), null);
                              --
                            else
                              --
                              insert into observacoesnotasvendas
                              values (seq_idobsnotavenda.nextval, i.idnotavenda, sysdate, 'Promissória Atualizada - '||vpromissoria||'.', v('APP_USER'),null);
                              --
                            end if;
                            --
                          exception
                            when others then
                              --insert into teste values ('erro ao atualizar promissoria da nota',i.idnotavenda);
                              null;
                          --
                          end;
                          --
                        else
                          --
                          update notasvendas
                            set recuperarpromissoria  = nvl(:RECUPERARPROMISSORIA,'N')
                              , usuariopromissoriarec = v('APP_USER')
                              , dataatualizacaopromissoria = sysdate
                              , IDSITUACAOPROMISSORIA = vidpromissoria
                              , promissoriarecuperada = 'S'
                           where idnotavenda  = i.idnotavenda
                             and IDSITUACAOPROMISSORIA is null;
                            --
                            if :ASSINATURATERCEIRO is not null then
                              --
                              insert into observacoesnotasvendas
                              values (seq_idobsnotavenda.nextval, i.idnotavenda, sysdate, 'Promissória Atualizada - '||vpromissoria||'. Assinatura de Terceiro: '||vassinaturaterceiro||'.', v('APP_USER'),null);
                              --
                            else
                              --
                              insert into observacoesnotasvendas
                              values (seq_idobsnotavenda.nextval, i.idnotavenda, sysdate, 'Promissória Atualizada - '||vpromissoria||'.', v('APP_USER'),null);
                              --
                            end if;
                            --
                        end if;
                        --
                        if vregistratarefa = 'S' then
                          --
                          insert into favorita.tarefas ( idtarefa
                                                       , idtipotarefa
                                                       , telefone
                                                       , datainclusao
                                                       , prioridade
                                                       , idsituacao
                                                       , observacao
                                                       , idusuario
                                                       , idpessoa
                                                       , idgrupoatendimento )
                          values ( favorita.seq_idtarefa.nextval          
                                 , 33
                                 , null
                                 , sysdate
                                 , null
                                 , 0
                                 , pck_romance.fnc_retornatelefones(vidvendedora)
                                 , vidusuario
                                 , vidpessoa
                                 , 3 );
                          --
                        end if;
                        --
                      end loop;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Nota(s) Atualizada(s)!
        }
        advanced {
            executionMappingIdentifier: 201640174057991038
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process atualiza-tarefas (
        name: Atualiza Tarefas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  for i in ( select t.idtarefa
                             from favorita.tarefas t
                                , vendedoras v
                                , pessoas p
                             where t.idsituacao < 30
                               and t.idtipotarefa = 33
                               and v.idpessoa = t.idpessoa
                               and p.idpessoa = t.idpessoa
                               and not exists ( select 1
                                                from favorita.vw_pedidosvencidos_fav pv
                                                   , vendedoras v
                                                where pv.idvendedora = v.idvendedora
                                                  and v.idpessoa = t.idpessoa )
                               and not exists ( select 1
                                                from roman.notasvendas nv
                                                where nv.idvendedora = v.idvendedora
                                                  and nv.saldo > 0
                                                 and nv.idsituacaonotavenda = 4 )
                               and not exists ( select 1
                                                from roman.pepinosrepresentantes pr
                                                where pr.valorsaldo > 0
                                                  and pr.cpf = p.cpf ) )
                  loop
                    --
                    update favorita.tarefas t
                    set t.idsituacao = 30
                    where t.idtarefa = i.idtarefa;
                    --
                  end loop;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Tarefas Atualizadas!
        }
        advanced {
            executionMappingIdentifier: 3204453683114048002
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR_TAREFAS
        }
    )

)

