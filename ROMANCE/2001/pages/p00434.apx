    region clientes-que-ficaram-em-débito (
        name: Clientes que Ficaram em Débito
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfilial
                     , empresa
                     , vendedoras "Consultoras com Nota"
                     , n1 "Até 300"
                     , round((n1/vendedoras*100),2) perc1
                     , n2 "300 até 400"
                     , round((n2/vendedoras*100),2) perc2
                     , n3 "400 até 500"
                     , round((n3/vendedoras*100),2) perc3
                     , n4 "500 até 700"
                     , round((n4/vendedoras*100),2) perc4
                     , n5 "700 até 1000"
                     , round((n5/vendedoras*100),2) perc5
                     , n6 "1000 até 1500"
                     , round((n6/vendedoras*100),2) perc6
                     , n7 "1500 até 2000"
                     , round((n7/vendedoras*100),2) perc7
                     , n8 "2000 até 3000"
                     , round((n8/vendedoras*100),2) perc8
                     , n9 "Mais que 3000"
                     , round((n9/vendedoras*100),2) perc9
                     , novas "Aguardando Acerto"
                     , round((novas/vendedoras*100),2) percn
                from ( select idfilial
                            , pck_romance.fnc_nomefilial(idfilial) empresa
                            , ( select count(1) qtd
                                from vendedoras v
                                where v.idfilial = f.idfilial
                                  and v.ativo = 'S' ) vendedoras
                            , ( select count(distinct nv.idvendedora ) qtd
                                from notasvendas nv
                                where nv.valortotalvendalqd   <= 300                  
                                  and nv.saldo                 > 0
                                  and nv.idnotavenda = ( select max(idnotavenda)
                                                         from notasvendas nvv
                                                         where nvv.idfilial       = F.Idfilial
                                                           and nvv.idvendedora    = nv.idvendedora
                                                           and nvv.dataacerto     between to_date(:P434_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P434_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')   
                                                           and nvv.idsituacaonotavenda = 4  ) 
                                  and exists ( select 1
                                               from vendedoras v
                                               where v.idvendedora = nv.idvendedora
                                                 and v.ativo       = 'S'  ) )  n1
                            , ( select count(distinct nv.idvendedora ) qtd
                                from notasvendas nv
                                where nv.valortotalvendalqd between 300.01 and 400              
                                  and nv.saldo                 > 0
                                  and nv.idnotavenda = ( select max(idnotavenda)
                                                         from notasvendas nvv
                                                         where nvv.idfilial       = F.Idfilial
                                                           and nvv.idvendedora    = nv.idvendedora
                                                           and nvv.dataacerto     between to_date(:P434_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P434_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')   
                                                           and nvv.idsituacaonotavenda = 4  ) 
                                  and exists ( select 1
                                               from vendedoras v
                                               where v.idvendedora = nv.idvendedora
                                                 and v.ativo       = 'S'  ) )  n2
                            , ( select count(distinct nv.idvendedora ) qtd
                                from notasvendas nv
                                where nv.valortotalvendalqd between 400.01 and 500              
                                  and nv.saldo                 > 0
                                  and nv.idnotavenda = ( select max(idnotavenda)
                                                         from notasvendas nvv
                                                         where nvv.idfilial       = F.Idfilial
                                                           and nvv.idvendedora    = nv.idvendedora
                                                           and nvv.dataacerto     between to_date(:P434_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P434_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')   
                                                           and nvv.idsituacaonotavenda = 4  ) 
                                  and exists ( select 1
                                               from vendedoras v
                                               where v.idvendedora = nv.idvendedora
                                                 and v.ativo       = 'S'  ) )  n3
                            , ( select count(distinct nv.idvendedora ) qtd
                                from notasvendas nv
                                where nv.valortotalvendalqd between 500.01 and 700              
                                  and nv.saldo                 > 0
                                  and nv.idnotavenda = ( select max(idnotavenda)
                                                         from notasvendas nvv
                                                         where nvv.idfilial       = F.Idfilial
                                                           and nvv.idvendedora    = nv.idvendedora
                                                           and nvv.dataacerto     between to_date(:P434_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P434_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')   
                                                           and nvv.idsituacaonotavenda = 4  ) 
                                  and exists ( select 1
                                               from vendedoras v
                                               where v.idvendedora = nv.idvendedora
                                                 and v.ativo       = 'S'  ) )  n4
                            , ( select count(distinct nv.idvendedora ) qtd
                                from notasvendas nv
                                where nv.valortotalvendalqd between 700.01 and 1000              
                                  and nv.saldo                 > 0
                                  and nv.idnotavenda = ( select max(idnotavenda)
                                                         from notasvendas nvv
                                                         where nvv.idfilial       = F.Idfilial
                                                           and nvv.idvendedora    = nv.idvendedora
                                                           and nvv.dataacerto     between to_date(:P434_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P434_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')   
                                                           and nvv.idsituacaonotavenda = 4  ) 
                                  and exists ( select 1
                                               from vendedoras v
                                               where v.idvendedora = nv.idvendedora
                                                 and v.ativo       = 'S'  ) )  n5
                            , ( select count(distinct nv.idvendedora ) qtd
                                from notasvendas nv
                                where nv.valortotalvendalqd between 1000.01 and 1500              
                                  and nv.saldo                 > 0
                                  and nv.idnotavenda = ( select max(idnotavenda)
                                                         from notasvendas nvv
                                                         where nvv.idfilial       = F.Idfilial
                                                           and nvv.idvendedora    = nv.idvendedora
                                                           and nvv.dataacerto     between to_date(:P434_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P434_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')   
                                                           and nvv.idsituacaonotavenda = 4  ) 
                                  and exists ( select 1
                                               from vendedoras v
                                               where v.idvendedora = nv.idvendedora
                                                 and v.ativo       = 'S'  ) )  n6
                            , ( select count(distinct nv.idvendedora ) qtd
                                from notasvendas nv
                                where nv.valortotalvendalqd between 1500.01 and 2000              
                                  and nv.saldo                 > 0
                                  and nv.idnotavenda = ( select max(idnotavenda)
                                                         from notasvendas nvv
                                                         where nvv.idfilial       = F.Idfilial
                                                           and nvv.idvendedora    = nv.idvendedora
                                                           and nvv.dataacerto     between to_date(:P434_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P434_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')   
                                                           and nvv.idsituacaonotavenda = 4  ) 
                                  and exists ( select 1
                                               from vendedoras v
                                               where v.idvendedora = nv.idvendedora
                                                 and v.ativo       = 'S'  ) )  n7                 
                            , ( select count(distinct nv.idvendedora ) qtd
                                from notasvendas nv
                                where nv.valortotalvendalqd between 2000.01 and 3000              
                                  and nv.saldo                 > 0
                                  and nv.idnotavenda = ( select max(idnotavenda)
                                                         from notasvendas nvv
                                                         where nvv.idfilial       = F.Idfilial
                                                           and nvv.idvendedora    = nv.idvendedora
                                                           and nvv.dataacerto     between to_date(:P434_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P434_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')   
                                                           and nvv.idsituacaonotavenda = 4  ) 
                                  and exists ( select 1
                                               from vendedoras v
                                               where v.idvendedora = nv.idvendedora
                                                 and v.ativo       = 'S'  ) )  n8
                            , ( select count(distinct nv.idvendedora ) qtd
                                from notasvendas nv
                                where nv.valortotalvendalqd > 3000              
                                  and nv.saldo                 > 0
                                  and nv.idnotavenda = ( select max(idnotavenda)
                                                         from notasvendas nvv
                                                         where nvv.idfilial       = F.Idfilial
                                                           and nvv.idvendedora    = nv.idvendedora
                                                           and nvv.dataacerto     between to_date(:P434_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P434_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')   
                                                           and nvv.idsituacaonotavenda = 4  ) 
                                  and exists ( select 1
                                               from vendedoras v
                                               where v.idvendedora = nv.idvendedora
                                                 and v.ativo       = 'S'  ) )  n9
                            , ( select count(distinct v.idvendedora ) qtd
                                from vendedoras v 
                                where v.ativo = 'S'
                                  and v.idfilial = f.idfilial
                                  and exists ( select 1
                                               from notasvendas nv
                                               where nv.idvendedora = v.idvendedora
                                                 and datanota  between to_date(:P434_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P434_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')      
                                  and exists ( select 1
                                               from vendedoras v
                                               where v.idvendedora = nv.idvendedora
                                                 and v.ativo       = 'S'
                                                 and v.idfilial    = f.idfilial )
                                                 and nv.idsituacaonotavenda = 3 )
                                  and not exists ( select 1
                                                   from notasvendas nv
                                                   where nv.idvendedora = v.idvendedora
                                                     and nv.idsituacaonotavenda = 4 ) ) novas
                       from filiais f
                       where f.ativo = 'S'       
                         and idfilial = :P0_IDFILIAL
                         and f.tipofilial = 'D' )
                where vendedoras > 0
                ```
            pageItemsToSubmit: P0_IDFILIAL
        }
        layout {
