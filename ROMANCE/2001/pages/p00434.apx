    region faturamento-de-clientes-valores (
        name: Faturamento de Clientes Valores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfilial
                     , empresa    
                     , SUM(valortotal) "Valor total Nota"
                     , sum(n1) "Até 300"
                     , round((sum(n1)/SUM(valortotal)*100),2) perc1
                     , sum(n2) "300 até 400"
                     , round((sum(n2)/SUM(valortotal)*100),2) perc2
                     , sum(n3) "400 até 500"
                     , round((sum(n3)/SUM(valortotal)*100),2) perc3
                     , sum(n4) "500 até 700"
                     , round((sum(n4)/SUM(valortotal)*100),2) perc4
                     , sum(n5) "700 até 1000"
                     , round((sum(n5)/SUM(valortotal)*100),2) perc5
                     , sum(n6) "1000 até 1500"
                     , round((sum(n6)/SUM(valortotal)*100),2) perc6
                     , sum(n7) "1500 até 2000"
                     , round((sum(n7)/SUM(valortotal)*100),2) perc7
                     , sum(n8) "2000 até 3000"
                     , round((sum(n8)/SUM(valortotal)*100),2) perc8
                     , sum(n9) "Mais que 3000"
                     , round((sum(n9)/SUM(valortotal)*100),2) perc9 
                     , '|' s1
                     , sum(n1q) "Até 300 Quitado"
                     , round(((sum(n1q)/sum(n1))*100),2) perc1quitado
                     , sum(n2q) "300 até 400 Quitado"
                     , round(((sum(n2q)/sum(n2))*100),2) perc2quitado
                     , sum(n3q) "400 até 500 Quitado"
                     , round(((sum(n3q)/sum(n3))*100),2) perc3quitado
                     , sum(n4q) "500 até 700 Quitado"
                     , round(((sum(n4q)/sum(n4))*100),2) perc4quitado
                     , sum(n5q) "700 até 1000 Quitado"
                     , round(((sum(n5q)/sum(n5))*100),2) perc5quitado
                     , sum(n6q) "1000 até 1500 Quitado"
                     , round(((sum(n6q)/sum(n6))*100),2) perc6quitado
                     , sum(n7q) "1500 até 2000 Quitado"
                     , round(((sum(n7q)/sum(n7))*100),2) perc7quitado
                     , sum(n8q) "2000 até 3000 Quitado"
                     , round(((sum(n8q)/sum(n8))*100),2) perc8quitado
                     , sum(n9q) "Mais que 3000 Quitado"
                     , round(((sum(n9q)/sum(n9))*100),2) perc9quitado    
                     , '|' s2
                     , sum(n1d) "Até 300 Débito"
                     , round((sum(n1d)/sum(n1)*100),2) perc1debito
                     , sum(n2d) "300 até 400 Débito"
                     , round((sum(n2d)/sum(n2)*100),2) perc2debito
                     , sum(n3d) "400 até 500 Débito"
                     , round((sum(n3d)/sum(n3)*100),2) perc3debito
                     , sum(n4d) "500 até 700 Débito"
                     , round((sum(n4d)/sum(n4)*100),2) perc4debito
                     , sum(n5d) "700 até 1000 Débito"
                     , round((sum(n5d)/sum(n5)*100),2) perc5debito
                     , sum(n6d) "1000 até 1500 Débito"
                     , round((sum(n6d)/sum(n6)*100),2) perc6debito
                     , sum(n7d) "1500 até 2000 Débito"
                     , round((sum(n7d)/sum(n7)*100),2) perc7debito
                     , sum(n8d) "2000 até 3000 Débito"
                     , round((sum(n8d)/sum(n8)*100),2) perc8debito
                     , sum(n9d) "Mais que 3000 Débito"
                     , round((sum(n9d)/sum(n9)*100),2) perc9debito
                     , '|' s3
                     , '|' s4
                     , '|' s5
                     , '|' s6
                     , '|' s7
                     , '|' s8
                     , '|' s9
                   --  , novas "Aguardando Acerto"
                  --   , round((novas/count(distinct idvendedora )*100),2) percn
                from ( select idfilial
                            , pck_romance.fnc_nomefilial(idfilial) empresa
                            , sum( nv.valortotalvendalqd) valortotal
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) < 300                    then    sum( nv.valortotalvendalqd)    end n1
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between  300.01 and  400 then    sum( nv.valortotalvendalqd)    end n2
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between  400.01 and  500 then    sum( nv.valortotalvendalqd)    end n3
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between  500.01 and  700 then    sum( nv.valortotalvendalqd)    end n4
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between  700.01 and 1000 then    sum( nv.valortotalvendalqd)    end n5
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between 1000.01 and 1500 then    sum( nv.valortotalvendalqd)    end n6
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between 1500.01 and 2000 then    sum( nv.valortotalvendalqd)    end n7
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between 2000.01 and 3000 then    sum( nv.valortotalvendalqd)    end n8
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) > 3000                   then    sum( nv.valortotalvendalqd)    end n9  
                            --
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) < 300                    and sum(nv.saldo) > 0 then    sum( nv.valortotalvendalqd)    end n1d
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between  300.01 and  400 and sum(nv.saldo) > 0 then    sum( nv.valortotalvendalqd)    end n2d
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between  400.01 and  500 and sum(nv.saldo) > 0 then    sum( nv.valortotalvendalqd)    end n3d
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between  500.01 and  700 and sum(nv.saldo) > 0 then    sum( nv.valortotalvendalqd)    end n4d
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between  700.01 and 1000 and sum(nv.saldo) > 0 then    sum( nv.valortotalvendalqd)    end n5d
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between 1000.01 and 1500 and sum(nv.saldo) > 0 then    sum( nv.valortotalvendalqd)    end n6d
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between 1500.01 and 2000 and sum(nv.saldo) > 0 then    sum( nv.valortotalvendalqd)    end n7d
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between 2000.01 and 3000 and sum(nv.saldo) > 0 then    sum( nv.valortotalvendalqd)    end n8d
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) > 3000                   and sum(nv.saldo) > 0 then    sum( nv.valortotalvendalqd)    end n9d  
                            --
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) < 300                    and sum(nv.saldo) <= 0 then    sum( nv.valortotalvendalqd)    end n1q
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between  300.01 and  400 and sum(nv.saldo) <= 0 then    sum( nv.valortotalvendalqd)    end n2q
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between  400.01 and  500 and sum(nv.saldo) <= 0 then    sum( nv.valortotalvendalqd)    end n3q
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between  500.01 and  700 and sum(nv.saldo) <= 0 then    sum( nv.valortotalvendalqd)    end n4q
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between  700.01 and 1000 and sum(nv.saldo) <= 0 then    sum( nv.valortotalvendalqd)    end n5q
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between 1000.01 and 1500 and sum(nv.saldo) <= 0 then    sum( nv.valortotalvendalqd)    end n6q
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between 1500.01 and 2000 and sum(nv.saldo) <= 0 then    sum( nv.valortotalvendalqd)    end n7q
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) between 2000.01 and 3000 and sum(nv.saldo) <= 0 then    sum( nv.valortotalvendalqd)    end n8q
                            , case  when ( sum( nv.valortotalvendalqd) / count(1) ) > 3000                   and sum(nv.saldo) <= 0 then    sum( nv.valortotalvendalqd)    end n9q  
                       from notasvendas nv
                       where nv.dataacerto     between to_date(:P434_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P434_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')     
                         and nv.idsituacaonotavenda = 4 
                         and nv.idfilial            = :P0_IDFILIAL
                         and exists ( select 1
                                      from vendedoras v
                                      where v.idvendedora = nv.idvendedora
                                        and v.ativo       = 'S' )    
                       having sum( nv.valortotalvendalqd) > 0              
                       group by nv.idfilial
                              , nv.idvendedora )       
                              
                group by idfilial
                     , empresa  
                order by 2
                ```
            pageItemsToSubmit: P0_IDFILIAL
        }
