page 673 (
    name: Ranking de Pedidos Pagos
    title: Ranking de Pedidos Pagos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region pedidos-pagos (
        name: Pedidos Pagos
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
    )

    region pedidos-resumido (
        name: Pedidos resumido
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante )  "Representante"
                     , nvl(ped.valorapagar,0) "Valor Total"
                     , nvl(ped.qtd,0) "Qtd Pedidos"
                     , m.cnpj
                     , roman.pck_romance.fnc_nomefilial(roman.pck_romance.fnc_filialrepresentante(r.idrepresentante)) empresa
                     , nvl(ped.valorapagar,0)/nvl(ped.qtd,0) tmedio
                from representantes r
                   , mei m
                   , (select count(distinct pp.idpedido) qtd
                           , pp.idrepresentante
                           , pp.idfilialromance 
                           , sum(pp.valorapagar) valorapagar
                      from favorita.vw_comissoes_pagar_fav pp
                      where ( :P0_IDFILIAL is null 
                         or ( :P0_IDFILIAL = 1135 and pp.idfilialromance in (1089,1090,1132,124,122,320,221,1070,1072,1071,1082,1083,1210,1106,1227,1223,1243) )
                         or ( :P0_IDFILIAL != 1135 and pp.idfilialromance  = :P0_IDFILIAL ) )
                      -- pp.idfilialromance = 100
                      and (:P673_TIPO_PESQUISA = 'D' and trunc(pp.databaixa) between to_date(:P673_DTINI,'dd/mm/yyyy') and to_date(:P673_DTFIM,'dd/mm/yyyy')
                          or (:P673_TIPO_PESQUISA = 'S' and pp.idsemanabaixa = :P673_IDSEMANA)
                          or (:P673_TIPO_PESQUISA = 'P' and pp.idsemanabaixa between :P673_IDSEMANA_INI and :P673_IDSEMANA_FIM) )
                      group by pp.idrepresentante
                             , pp.idfilialromance )ped
                where ( :P0_IDFILIAL is null 
                   or ( :P0_IDFILIAL = 1135 and ped.idfilialromance in (1089,1090,1132,124,122,320,221,1070,1072,1071,1082,1083,1210,1106,1227,1223,1243) )
                   or ( :P0_IDFILIAL != 1135 and ped.idfilialromance  = :P0_IDFILIAL ) )
                   --ped.idfilialromance = 100
                  and r.ativo = 'S'
                  and r.idpessoa        = m.idpessoa(+)
                  and r.idrepresentante = ped.idrepresentante(+)
                  and :P673_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 300
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        performance {
            maxRowsToProcess: 5000
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
            csvSeparator: ;
            linkText: <font size="18">Clique aqui para Download em Excel</font>
            filename: Pedidos_semana_anterior
        }

        column CNPJ (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: CNPJ
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
        )

        column EMPRESA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column "Qtd Pedidos" (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Qtd Pedidos
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            sorting {
                defaultSequence: 1
                direction: desc
            }
            advanced {
                computeSum: true
            }
        )

        column Representante (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: MEI
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column TMEDIO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Ticket Médio Dist
                alignment: center
            }
            layout {
                sequence: 15
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column "Valor Total" (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

    )

    pageItem P673_DTFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 40
            region: @pedidos-pagos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 30
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P673_DTINI (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 30
            region: @pedidos-pagos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 30
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P673_FILTRAR (
        type: hidden
        layout {
            sequence: 90
            region: @pedidos-pagos
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P673_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta
                     , s.idsemana
                from semana_dias s
                where s.ano >= 2019
                order by idsemana
                ```
        }
        layout {
            sequence: 50
            region: @pedidos-pagos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P673_IDSEMANA_FIM (
        type: selectList
        label {
            label: Até Semana
            alignment: left
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                  
                select s.semanacompleta
                     , s.idsemana
                from semana_dias s
                where s.ano >= 2019
                  and s.idsemana >= :P673_IDSEMANA_INI
                order by idsemana
                ```
        }
        layout {
            sequence: 70
            region: @pedidos-pagos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P673_IDSEMANA_INI (
        type: selectList
        label {
            label: De Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta
                     , s.idsemana
                from semana_dias s
                where s.ano >= 2019
                order by idsemana
                ```
        }
        layout {
            sequence: 60
            region: @pedidos-pagos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P673_MEDIAFIL (
        type: displayOnly
        label {
            label: Ticket Médio Franquia:
            alignment: left
        }
        layout {
            sequence: 10
            region: @pedidos-resumido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select  to_char(sum(pp.valorapagar) / count(distinct(rp.idrepresentante)),'999G999G990D00') mediafil
                from favorita.vw_comissoes_pagar_fav pp
                   , catal.representantes rp
                where rp.idrepresentante = pp.idrepresentante
                  and rp.ativo = 'S'
                  and ( :P0_IDFILIAL is null  
                          or ( :P0_IDFILIAL = 1135 and pp.idfilialromance in (1089,1090,1132,124,122,320,221,1070,1072,1071,1082,1083,1210,1106,1227,1223,1243) )
                          or ( :P0_IDFILIAL != 1135 and pp.idfilialromance  = :P0_IDFILIAL ) )
                  and (:P673_TIPO_PESQUISA = 'D' and trunc(pp.databaixa) between to_date(:P673_DTINI,'dd/mm/yyyy') and to_date(:P673_DTFIM,'dd/mm/yyyy')
                          or (:P673_TIPO_PESQUISA = 'S' and pp.idsemanabaixa = :P673_IDSEMANA)
                          or (:P673_TIPO_PESQUISA = 'P' and pp.idsemanabaixa between :P673_IDSEMANA_INI and :P673_IDSEMANA_FIM) )
                ```
            used: always
        }
    )

    pageItem P673_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @pedidos-pagos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P673_TIPO_PESQUISA (
        type: radioGroup
        label {
            label: Tipo de Pesquisa
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC:Data;D,Semana;S,Período Semana;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @pedidos-pagos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: D
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @pedidos-pagos
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction pesquisa-periodo-semana (
        name: Pesquisa Periodo Semana
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P673_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P673_TIPO_PESQUISA
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P673_IDSEMANA_INI
                    P673_IDSEMANA_FIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P673_IDSEMANA_INI
                    P673_IDSEMANA_FIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction pesquisa-semana (
        name: Pesquisa Semana
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P673_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P673_TIPO_PESQUISA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P673_IDSEMANA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P673_IDSEMANA
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-pesquisa (
        name: Tipo Pesquisa
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P673_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P673_TIPO_PESQUISA
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P673_DTINI
                    P673_DTFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P673_DTINI
                    P673_DTFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 673
                items: {
                    P673_FILTRAR: S
                }
                action: resetPagination
            }
        }
    )

)

