    pageItem P682_IDFILIAL (
        type: selectList
        label {
            label: <b>Franquia</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and ( :P589_IDPAIS is null or f.ididioma = :P589_IDPAIS)
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
