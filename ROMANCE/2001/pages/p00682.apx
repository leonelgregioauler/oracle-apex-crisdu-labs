page 682 (
    name: Contratos Enviados para o PAP
    title: Contratos Enviados para o PAP
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region contratos-enviados-para-o-pap (
        name: Contratos Enviados Para o PAP
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- query pra trazer informações da ROMANCE!
                select 'Romance'                                                   as "Origem",
                       cn.dataclassificado                                         as "Data do Envio",
                       roman.pck_romance.fnc_nomefilial(nv.idfilial)               as "Franquia",
                       roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) as "Distribuidor",
                       roman.pck_romance.fnc_nomevendedora(nv.idvendedora)         as "Consultora",
                       pes.cpf                                                     as "Cpf",
                       np.datanegociacao                                           as "Data Negociacao",
                       nv.numeronota                                               as "Nr Nota/Pedido",
                       trunc(nv.dataacerto)                                        as "Data Debito",
                       nvl(dn.valororiginal,0)                                     as "Valor Original",
                       nvl(dn.valoratualizado,0)                                   as "Valor Atualizado",
                       nvl(np.valornegociacao,0)                                   as "Valor Negociacao",
                       nvl(dn.valordesconto,0)                                     as "Valor Desconto",
                       nvl(np.qtdparcelas,0)                                       as "qtd Parcelas",
                       nvl(np.valorpago,0)                                         as "Valor Pago Vigente",
                       nvl(np.valorpago,0)                                         as "Valor Pago Acumulado Negociação",
                       favorita.pck_util_fav.fnc_nomeusuario(cn.idusuario)         as "Responsavel"
                  from roman.notasvendas               nv,
                       roman.classificacoesnotasvendas cn,
                       roman.documentosnegociacao      dn,
                       roman.negociacoesparceiros      np,
                       catal.vendedoras                ven,
                       catal.pessoas                   pes
                 where  -- Ligações entre tabelas
                       cn.idnotavenda               = nv.idnotavenda
                   and cn.idcaracteristicanotavenda = 50
                   and dn.idnotavenda               = nv.idnotavenda
                   and np.idnegociacaoparceiro      = dn.idnegociacaoparceiro
                   and ven.idvendedora              = nv.idvendedora
                   and pes.idpessoa                 = ven.idpessoa
                   and ( np.datanegociacao is null or (trunc(np.datanegociacao) >= trunc(cn.dataclassificado) ))
                   -- Filtro TIPO E DATA
                   and (    ( :P682_TIPODATA = 'E' and cn.dataclassificado between to_date(:P682_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') 
                                                                               and to_date(:P682_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                         or ( :P682_TIPODATA = 'D' and nv.dataacerto between to_date(:P682_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') 
                                                                         and to_date(:P682_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) )
                   -- Filtro SITUAÇÃO
                   and (   :P682_SITUACAO = 'T'
                      or ( :P682_SITUACAO = 'N' and np.valornegociacao > 0 )
                      or ( :P682_SITUACAO = 'P' and dn.valorpago > 0 )
                      or ( :P682_SITUACAO = 'A' and dn.saldo > 0 ) )
                   -- Filtro CARTEIRA A=Ambas, R=Romance
                   and ( :P682_CARTEIRA = 'A'          or  :P682_CARTEIRA = 'R')  
                   -- Filtro FRANQUIA
                   and ( :P682_IDFILIAL is null        or nv.idfilial = :P682_IDFILIAL )
                   -- Filtro DISTRIBUIDOR
                   and ( :P682_IDREPRESENTANTE is null or nv.idrepresentante = :P682_IDREPRESENTANTE )
                   -- Filtro CONSULTORA
                   and ( :P682_IDVENDEDORA is null     or nv.idvendedora = :P682_IDVENDEDORA )
                   -- Filtro CPF VENDEDORA
                   and ( :P682_CPF_VENDEDORA is null   or pes.cpf = :P682_CPF_VENDEDORA)
                   -- Filtro RESPONSÁVEL COBRANÇA
                   and ( :P682_RESPONSAVEL is null     or cn.idusuario  = :P682_RESPONSAVEL ) 
                           
                union
                
                -- query pra trazer informações da FAVORITA!
                select 'Favorita'                                                 as "Origem",
                       c.dataclassificado                                         as "Data do Envio",
                       roman.pck_romance.fnc_nomefilial(p.idfilialromance)        as "Franquia",
                       roman.pck_romance.fnc_nomerepresentante(p.idrepresentante) as "Distribuidor",
                       roman.pck_romance.fnc_nomevendedora(p.idvendedora)         as "Consultora",
                       pes.cpf                                                    as "CPF",
                       n.datanegociacao                                           as "Data Negociacao" ,              
                       to_char(p.numeropedido)                                    as "Nr Nota/Pedido",
                       ( select max(v.datavencimento)
                           from favorita.vencimentospedidos v
                          where v.idpedido = p.idpedido)                          as "Data Debito" ,
                       nvl(d.valororiginal,0)                                     as "Valor Original",
                       nvl(d.valoratualizado,0)                                   as "Valor Atualizado",
                       nvl(n.valornegociacao,0)                                   as "Valor Negociacao",
                       nvl(d.valordesconto,0)                                     as "Valor Desconto",
                       nvl(n.qtdparcelas,0)                                       as "qtd Parcelas",
                       nvl(n.valorpago,0)                                         as "Valor Pago Vigente",
                       nvl(n.valorpago,0)                                         as "Valor Pago Acumulado Negociação",
                       favorita.pck_util_fav.fnc_nomeusuario(c.idusuario)         as "Responsavel"
                  from favorita.pedidos               p,
                       favorita.classificacoespedidos c,
                       catal.vendedoras               ven,
                       catal.pessoas                  pes,
                       roman.documentosnegociacao     d,
                       roman.negociacoesparceiros     n
                 where -- Ligações entre tabelas
                       c.idpedido               = p.idpedido
                   and c.idcaracteristicapedido = 98
                   and d.idpedido               = p.idpedido
                   and n.idnegociacaoparceiro   = d.idnegociacaoparceiro
                   and ven.idvendedora          = p.idvendedora
                   and pes.idpessoa             = ven.idpessoa
                   and ( n.datanegociacao is null or (trunc(n.datanegociacao) >= trunc(c.dataclassificado) ))
                   -- Filtro TIPO E DATA
                   and (    ( :P682_TIPODATA = 'E' and c.dataclassificado between to_date(:P682_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') 
                                                                              and to_date(:P682_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS'))
                         or ( :P682_TIPODATA = 'D' and (select max(v.datavencimento)
                                                          from favorita.vencimentospedidos v
                                                         where v.idpedido = p.idpedido)  between to_date(:P682_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') 
                                                                                             and to_date(:P682_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) )
                   -- Filtro SITUAÇÃO
                   and (     :P682_SITUACAO = 'T'
                        or ( :P682_SITUACAO = 'N' and n.valornegociacao > 0 )
                        or ( :P682_SITUACAO = 'P' and d.valorpago > 0 )
                        or ( :P682_SITUACAO = 'A' and d.saldo > 0) )
                   -- Filtro CARTEIRA (A=Ambas, F=Favorita)
                   and ( :P682_CARTEIRA = 'A'          or :P682_CARTEIRA = 'F')
                   -- Filtro FRANQUIA
                   and ( :P682_IDFILIAL is null        or p.idfilialromance = :P682_IDFILIAL )
                   -- Filtro DISTRIBUIDOR
                   and ( :P682_IDREPRESENTANTE is null or p.idrepresentante = :P682_IDREPRESENTANTE )
                   -- Filtro CONSULTORA
                   and ( :P682_IDVENDEDORA is null     or p.idvendedora = :P682_IDVENDEDORA )
                   -- Filtro CPF VENDEDORA
                   and ( :P682_CPF_VENDEDORA is null   or pes.cpf = :P682_CPF_VENDEDORA)
                   -- Filtro RESPONSÁVEL COBRANÇA
                   and ( :P682_RESPONSAVEL is null     or c.idusuario = :P682_RESPONSAVEL )   
                 order by 8;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--stacked
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 566519242886089235
        }

