            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P682_IDREPRESENTANTE (
        type: popupLov
        label {
            label: <b>Distribuidor</b>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||decode(r.ativo,'S','Ativo','N','Inativo') d
                     , r.idrepresentante r
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente
                  and ( :P682_IDFILIAL is null or g.idfilial = :P682_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P682_IDFILIAL
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P682_IDVENDEDORA (
        type: popupLov
        label {
            label: <b>Consultora</b>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' CPF: '||p.cpf d
                     , v.idvendedora r
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and ( :P682_IDREPRESENTANTE is null or v.idrepresentante = :P682_IDREPRESENTANTE )
                  and ( :P682_IDFILIAL is null or v.idfilial = :P682_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: - Toda -
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P682_RESPONSAVEL (
        type: selectList
        label {
            label: <b>Responsável Cob.</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomepessoa) d
                     , u.idusuario r
                from pessoas p
                   , usuarios u
                where p.idpessoa = u.idpessoa
                  and u.idgerente = 80
                  and u.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: - Todos -
