    region contratos-enviados-para-o-pap-aguardando-negociação (
        name: Contratos Enviados Para o PAP (Aguardando Negociação)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- query pra trazer informações da ROMANCE!
                select 'Romance'                                                   as "Origem",
                       cn.dataclassificado                                         as "Data do Envio",
                       roman.pck_romance.fnc_nomefilial(nv.idfilial)               as "Franquia",
                       roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) as "Distribuidor",
                       roman.pck_romance.fnc_nomevendedora(nv.idvendedora)         as "Consultora",
                       pes.cpf                                                     as "Cpf",
                       nv.idnotavenda                                              as "ID Nota/Pedido",
                       nv.numeronota                                               as "Nr Nota/Pedido",
                       ( select nvl(n.saldo,0) + nvl((select sum(nvl(p.valorpago,0)) 
                                                        from roman.pagamentosnotasvendas p
                                                       where p.idnotavenda = n.idnotavenda),0) saldo_congelado
                           from roman.notasvendas n
                          where n.idnotavenda = nv.idnotavenda)                    as "Saldo Congelado Nota/Pedido",
                       favorita.pck_util_fav.fnc_nomeusuario(cn.idusuario)         as "Responsavel",
                       (select decode(pp.origem,'R','Representante','C','Cobrança','P','Perda') "Origem"
                          from roman.pagamentosnotasvendas pp
                         where pp.idpagtonotavenda = (select max(pag.idpagtonotavenda) idpagtonotavenda
                                                        from roman.pagamentosnotasvendas pag
                                                       where pag.idnotavenda = nv.idnotavenda)) as  "Situação"
                  from roman.notasvendas               nv,
                       roman.classificacoesnotasvendas cn,
                       catal.vendedoras                ven,
                       catal.pessoas                   pes
                 where  -- Ligações entre tabelas
                       cn.idnotavenda               = nv.idnotavenda
                   and cn.idcaracteristicanotavenda = 50
                   and ven.idvendedora              = nv.idvendedora
                   and pes.idpessoa                 = ven.idpessoa
                   -- Filtro DATA
                   and cn.dataclassificado between to_date(:P682_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS')  and to_date(:P682_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                   -- Filtro CARTEIRA A=Ambas, R=Romance
                   and ( :P682_CARTEIRA = 'A'          or  :P682_CARTEIRA = 'R')  
                   -- Filtro FRANQUIA
                   and ( :P682_IDFILIAL is null        or nv.idfilial = :P682_IDFILIAL )
                   -- Filtro DISTRIBUIDOR
                   and ( :P682_IDREPRESENTANTE is null or nv.idrepresentante = :P682_IDREPRESENTANTE )
                   -- Filtro CONSULTORA
                   and ( :P682_IDVENDEDORA is null     or nv.idvendedora = :P682_IDVENDEDORA )
                   -- Filtro CPF VENDEDORA
                   and ( :P682_CPF_VENDEDORA is null   or pes.cpf = :P682_CPF_VENDEDORA)
                   -- Filtro RESPONSÁVEL COBRANÇA
                   and ( :P682_RESPONSAVEL is null     or cn.idusuario  = :P682_RESPONSAVEL ) 
                   -- Filtro para trazer somente NOTASVENDAS que não existem na tabela roman.documentosnegociacao
                   and not exists ( select 1
                                      from roman.documentosnegociacao d
                                     where d.idnotavenda = nv.idnotavenda)
                   -- Filtro: objetivo 1... é trazer somente um regitro em casos onde foi enviado e retirado do PAP varias vezes.
                   --         objetivo 2... trazer somente registro que a data de envio é maior que a data da retirada do PAP, assim garantido que só vem registro enviado e ainda não retirados do PAP.              
                   and cn.dataclassificado = (select max(cc.dataclassificado)
                                               from roman.classificacoesnotasvendas cc
                                              where cc.idnotavenda = nv.idnotavenda
                                                and cc.idcaracteristicanotavenda in (50,51))
                         
                union
                
                -- query pra trazer informações da FAVORITA!
                select 'Favorita'                                                 as "Origem",
                       c.dataclassificado                                         as "Data do Envio",
                       roman.pck_romance.fnc_nomefilial(p.idfilialromance)        as "Franquia",
                       roman.pck_romance.fnc_nomerepresentante(p.idrepresentante) as "Distribuidor",
                       roman.pck_romance.fnc_nomevendedora(p.idvendedora)         as "Consultora",
                       pes.cpf                                                    as "CPF",
                       p.idpedido                                                 as "ID Nota/Pedido",
                       to_char(p.numeropedido)                                    as "Nr Nota/Pedido",
                       (select nvl(ped.valorapagar,0) + nvl((select sum(nvl(v.valorpago,0))
                                                             from favorita.vencimentospedidos v
                                                            where v.idpedido = p.idpedido),0)
                          from favorita.pedidos ped
                         where ped.idpedido = p.idpedido)                         as "Saldo Congelado Nota/Pedido",
                       favorita.pck_util_fav.fnc_nomeusuario(c.idusuario)         as "Responsavel",
                       (select decode(pag.origempagamento,'R','Representante','C','Cobrança','P','Perda','-') as "Origem"
                          from favorita.pagamentospedidos pag
                         where pag.idpagamentopedido = ( select max(pp.idpagamentopedido)
                                                        from favorita.pagamentospedidos pp
                                                       where pp.idvencimentopedido = ( select max(ve.idvencimentopedido) idvencimentopedido
                                                                                         from favorita.vencimentospedidos ve
                                                                                        where ve.idpedido = p.idpedido))) as  "Situação"
                  from favorita.pedidos               p,
                       favorita.classificacoespedidos c,
                       catal.vendedoras               ven,
                       catal.pessoas                  pes
                 where -- Ligações entre tabelas
                       c.idpedido               = p.idpedido
                   and c.idcaracteristicapedido = 98
                   and ven.idvendedora          = p.idvendedora
                   and pes.idpessoa             = ven.idpessoa
                   -- Filtro DATA
                   and c.dataclassificado between to_date(:P682_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS')  and to_date(:P682_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                   -- Filtro CARTEIRA (A=Ambas, F=Favorita)
                   and ( :P682_CARTEIRA = 'A'          or :P682_CARTEIRA = 'F')
                   -- Filtro FRANQUIA
                   and ( :P682_IDFILIAL is null        or p.idfilialromance = :P682_IDFILIAL )
                   -- Filtro DISTRIBUIDOR
                   and ( :P682_IDREPRESENTANTE is null or p.idrepresentante = :P682_IDREPRESENTANTE )
                   -- Filtro CONSULTORA
                   and ( :P682_IDVENDEDORA is null     or p.idvendedora = :P682_IDVENDEDORA )
                   -- Filtro CPF VENDEDORA
                   and ( :P682_CPF_VENDEDORA is null   or pes.cpf = :P682_CPF_VENDEDORA)
                   -- Filtro RESPONSÁVEL COBRANÇA
                   and ( :P682_RESPONSAVEL is null     or c.idusuario = :P682_RESPONSAVEL ) 
                   -- Filtro para trazer somente PEDIDOS que não existem na tabela roman.documentosnegociacao
                   and not exists ( select 1
                                      from roman.documentosnegociacao d
                                     where d.idpedido = p.idpedido)
                   -- Filtro: objetivo 1... é trazer somente um regitro em casos onde foi enviado e retirado do PAP varias vezes.
                   --         objetivo 2... trazer somente registro que a data de envio é maior que a data da retirada do PAP, assim garantido que só vem registro enviado e ainda não retirados do PAP.              
                   and c.dataclassificado = (select max(cc.dataclassificado)
                                               from favorita.classificacoespedidos cc
                                              where cc.idpedido = p.idpedido
                                                and cc.idcaracteristicapedido in (98,99))
                 order by 8;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--stacked
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <b>Atenção: Considerar que alguns filtro para esse relatório tem comportamento diferente. </b> <br><br>
                
                <b>1) Filtro Tipo de Data.</b> Não considera o tipo, esse filtro fica fixo por data de envio ao PAP.<br>
                <b>2) Filtro Situação.</b> Este filtro não tem efeito neste relatório.<br>
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
