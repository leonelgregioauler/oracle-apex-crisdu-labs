    dynamicAction deleta-pagamento (
        name: Deleta pagamento
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @delete
        }

        action native-confirm (
            action: confirm
            settings {
                message: Deseja realmente remover este pagamento?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DELETE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process fetch-row-from-pagamentosemprestimos (
        name: Fetch Row from PAGAMENTOSEMPRESTIMOS
        type: autoRowFetch
        source {
            tableName: PAGAMENTOSEMPRESTIMOS
            pkColumn: IDPAGAMENTO
            pkItem: P211_IDPAGAMENTO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 831216174574738333
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vnome  varchar2(300);
                  vvalor number(15,2);
                  vvalorpago number(15,2);
                begin
                  --
                  if :P211_IDPAGAMENTO is null then
                    --
                    select SEQ_IDPAGAMENTOEMPRESTIMO.nextval
                    into :P211_IDPAGAMENTO
                    from dual;
                    --
                  end if;
                  --
                  select e.nome
                       , e.valor
                  into vnome
                     , vvalor
                  from emprestimos e
                  where e.idemprestimo = :P211_IDEMPRESTIMO;
                  --
                  select sum(p.valorpago)
                  into vvalorpago
                  from pagamentosemprestimos p
                  where p.idemprestimo = :P211_IDEMPRESTIMO;
                  --
                /*  catal.pck_util.prc_enviaemail( ppara => 'edunog@terra.com.br'
                                               , pcopia => 'tatianaromance@gmail.com'
                                               , passunto => 'Pagamento de Empréstimo'
                                               , ptexto => 'Olá!'||chr(10)||chr(10)||
                                                        vnome||' efetuou o pagamento de R$ '||trim(TO_CHAR(TO_NUMBER(:P211_VALORPAGO),'999G999G990D00'))||' referente ao empréstimo de R$ '||trim(TO_CHAR(vvalor,'999G999G990D00'))||' para '||pck_romance.fnc_nomeusuario(v('APP_USER'))||'.'||chr(10)||chr(10)||
                                                        'Saldo devedor: R$ '||trim(TO_CHAR((vvalor - vvalorpago - TO_NUMBER(:P211_VALORPAGO)),'999G999G990D00'))||'.'||chr(10)||chr(10)||
                                                        'Observação do usuário: '||:P211_OBSERVACAO||chr(10)||chr(10)|| 
                                                        'Mensagem enviada automaticamente.' );*/
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 831216366434738335
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-pagamentosemprestimos (
        name: Process Row of PAGAMENTOSEMPRESTIMOS
        type: autoRowProcessing
        target {
            tableName: PAGAMENTOSEMPRESTIMOS
            pkColumn: IDPAGAMENTO
            pkItem: P211_IDPAGAMENTO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 831216555437738335
        }
    )

    branch (
        name: Go To Page
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 211
                items: {
                    P211_IDPAGAMENTO:
                    P211_IDEMPRESTIMO: &P211_IDEMPRESTIMO.
                }
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETE
        }
    )

    branch (
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 211
                items: {
                    P211_IDPAGAMENTO: &P211_IDPAGAMENTO.
                    P211_IDEMPRESTIMO: &P211_IDEMPRESTIMO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SAVE','CREATE')
                ```
        }
    )

)

