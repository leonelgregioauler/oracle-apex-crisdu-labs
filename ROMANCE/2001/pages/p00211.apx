    button anexar-documentos (
        buttonName: ANEXAR_DOCUMENTOS
        label: Anexar Documentos
        layout {
            sequence: 10
            region: @pagamento-de-empréstimo
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 442
                items: {
                    P442_IDEMPRESTIMO: &P211_IDEMPRESTIMO.
                    P442_IDANEXOEMPRESTIMOPGTO:
                    P442_IDANEXODELETAR:
                    P442_IDPAGAMENTO: &P211_IDPAGAMENTO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P211_IDEMPRESTIMO is not null
                  and :P211_IDPAGAMENTO is not null
                ```
        }
    )

