    pageItem P595_IDKITVENDA (
        type: popupLov
        label {
            label: Kit de Venda
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select referencia||' - '||descricao d
                     , idkitvenda r
                from favorita.kitsvendas r
                where trunc(sysdate) between r.datainicial and r.datafinal
                order by descricao
                ```
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P595_IDPRODUTODETALHADO (
        type: popupLov
        label {
            label: Produto Detalhado
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, 1) as d
                     , idprodutodetalhado as r
                from favorita.produtosdetalhados pd
                where pd.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P595_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomepessoa) d
                     , r.idrepresentante r
                from representantes r
                   , pessoas p
                where r.idpessoa = p.idpessoa
                  and r.ativo = 'S'
                  and r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

