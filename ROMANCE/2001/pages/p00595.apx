    region kit-de-venda-detalhado (
        name: Kit de Venda Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(ped.idrepresentante) as "Representante"
                     , ped.dataemissao 
                     , favorita.pck_util_fav.fnc_nomepessoa(idpessoa) NomeCliente
                     , qtdpedido
                     , valorvenda
                     , idpedido
                from ( select v.idpessoa
                            , ip.idkitvenda
                            , p.idrepresentante  
                            , p.idpedido
                            , trunc(p.dataemissao) dataemissao  
                            , (sum(ip.quantidade)/count(ip.iditempedido)) qtdpedido 
                            , sum(ip.valorvenda * ip.quantidade) valorvenda
                       from favorita.pedidos p
                          , favorita.itenspedidos ip
                          , vendedoras v
                       where p.idpedido = ip.idpedido
                         and :P595_TIPO_PRODUTO = 'K'
                         and ( :P595_IDREPRESENTANTE is null or p.idrepresentante = :P595_IDREPRESENTANTE )
                         and v.idvendedora = p.idvendedora
                         and p.datacancelamento is null
                         and p.idsituacaoentrega >= 20000
                         and trunc(p.dataemissao) between to_date(:P595_DATAINICIO,'DD/MM/RRRR') and to_date(:P595_DATAFIM,'DD/MM/RRRR')
                         and ip.idkitvenda = :P595_IDKITVENDA
                         and p.idfilialromance = :P0_IDFILIAL
                         and ( :P595_PEDIDOS_PAGOS = 'T'
                           or ( :P595_PEDIDOS_PAGOS = 'N' and exists ( select 1
                                                                       from favorita.vencimentospedidos v
                                                                       where v.situacaovencimento = 'V'
                                                                         and v.idpedido           = p.idpedido
                                                                         and v.valorpago          < v.valorpagar ) )
                           or ( :P595_PEDIDOS_PAGOS = 'S' and exists ( select 1
                                                                       from favorita.vencimentospedidos v
                                                                       where v.situacaovencimento = 'V'
                                                                         and v.idpedido           = p.idpedido
                                                                         and v.valorpago         >= v.valorpagar ) ) )
                         group by p.idrepresentante, ip.idkitvenda, p.idpedido, p.dataemissao, idpessoa ) ped  
                order by qtdpedido desc
                  
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P595_TIPO_RELATORIO = 'D' and :P595_TIPO_PRODUTO = 'K'
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum produto encontrado! Verifique os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 5033183841561824326
        }

