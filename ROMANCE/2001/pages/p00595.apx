    region produtos-resumidos (
        name: Produtos Resumidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomeproduto(pidproduto => i.idproduto , pididioma => :P0_IDIDIOMA, pcomreferencia => 'N'  ) nomeproduto
                     , sum(i.quantidade)
                     , sum(i.valorapagar)
                     , pd.referencia
                     , p.idfilialromance
                     , p.filialromance
                     , p.idfilialfavorita
                     , p.filialfavorita
                     , p.representante
                from favorita.vw_itenspedidos_fav i
                   , favorita.vw_pedidos_fav p
                   , favorita.vw_produtos_fav pd
                   , vw_filiais f
                where i.idpedido           = p.idpedido
                  and p.idfilialromance    = f.idfilial
                  and pd.idproduto(+)      = i.idproduto
                  and f.idfilial           = :P0_IDFILIAL
                  and i.ididioma           = f.ididioma
                  and p.ididioma           = f.ididioma
                  and pd.ididioma          = f.ididioma
                  and p.tipopedido = 'P'
                  and ( :P595_IDREPRESENTANTE is null or p.idrepresentante = :P595_IDREPRESENTANTE )
                  and p.datacancelamento is null
                  and ( :P595_TIPO_PRODUTO is null
                    --or ( :P595_TIPO_PRODUTO = 'P' and i.idprodutodetalhado = :P595_IDPRODUTODETALHADO )
                    or ( :P595_TIPO_PRODUTO = 'P' and (:P595_IDPRODUTODETALHADO is null or i.idprodutodetalhado = :P595_IDPRODUTODETALHADO) )
                    or ( :P595_TIPO_PRODUTO = 'V' and exists ( select 1
                                                               from filtrosprodutosdetalhados ft
                                                               where ft.idprodutodetalhado = i.idprodutodetalhado
                                                                 and ft.usuario            = v('APP_USER') ) ) )
                  and :P595_TIPO_RELATORIO = 'R'
                  and trunc(p.dataemissao) between to_date(:P595_DATAINICIO,'DD/MM/RRRR') and to_date(:P595_DATAFIM,'DD/MM/RRRR')
                  and p.idsituacaoentrega >= 20000
                  and ( :P595_PEDIDOS_PAGOS = 'T'
                     or ( :P595_PEDIDOS_PAGOS = 'S' and (p.valorapagar - p.valorpago) = 0 ) 
                     or ( :P595_PEDIDOS_PAGOS = 'N' and (p.valorapagar - p.valorpago) > 0 ) )
                group by i.idproduto
                       , pd.referencia
                       , p.idfilialromance
                       , p.filialromance
                       , p.idfilialfavorita
                       , p.filialfavorita
                       , p.representante
                order by 2 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P595_TIPO_RELATORIO = 'R' and :P595_TIPO_PRODUTO in ('P','V')
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
