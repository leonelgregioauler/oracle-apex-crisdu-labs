    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 595
                items: {
                    P595_IDREPRESENTANTE: &P595_IDREPRESENTANTE.
                    P595_TIPO_PRODUTO: &P595_TIPO_PRODUTO.
                    P595_IDPRODUTODETALHADO: &P595_IDPRODUTODETALHADO.
                    P595_IDKITVENDA: &P595_IDKITVENDA.
                    P595_PEDIDOS_PAGOS: &P595_PEDIDOS_PAGOS.
                    P595_TIPO_RELATORIO: &P595_TIPO_RELATORIO.
                    P595_DATAINICIO: &P595_DATAINICIO.
                    P595_DATAFIM: &P595_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

