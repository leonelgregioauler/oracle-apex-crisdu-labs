    dynamicAction tipo-kit (
        name: Tipo Kit
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P595_TIPO_PRODUTO
        }
        clientSideCondition {
            type: item=value
            item: P595_TIPO_PRODUTO
            value: K
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P595_IDKITVENDA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P595_IDKITVENDA
            }
            execution {
                sequence: 10
            }
        )

    )

