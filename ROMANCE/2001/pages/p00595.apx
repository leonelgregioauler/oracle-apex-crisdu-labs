    region produtos-detalhados (
        name: Produtos Detalhados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.numeropedido
                     , p.representante
                     , p.vendedora
                     , p.cpf
                     , p.dataemissao
                     , p.dataentrega
                     , p.valortotal
                     , p.valorapagar
                     , p.nomeusuario
                     , i.quantidade
                     , i.valorapagar valoritens
                     , p.idfilialromance
                     , p.filialromance
                     , p.idfilialfavorita
                     , p.filialfavorita
                     -- 11138525 - Maicon Aimi - 22/10/2025
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,1) || case when i.idcompreeganhe is not null or i.idbrinde is not null then ' (Brinde)' end nomeprodutodetalhado
                from favorita.vw_itenspedidos_fav i
                   , favorita.vw_pedidos_fav p
                   , vw_filiais f
                where i.idpedido           = p.idpedido
                  and f.idfilial           = :P0_IDFILIAL
                  and p.idfilialromance    = f.idfilial
                  and p.ididioma           = f.ididioma
                  and i.ididioma           = f.ididioma
                  and p.idsituacaoentrega  >= 20000
                  and ( :P595_IDREPRESENTANTE is null or p.idrepresentante = :P595_IDREPRESENTANTE )
                  and p.datacancelamento is null
                  and ( :P595_TIPO_PRODUTO is null
                    or ( :P595_TIPO_PRODUTO = 'P' and (:P595_IDPRODUTODETALHADO is null or i.idprodutodetalhado = :P595_IDPRODUTODETALHADO ))
                    --or ( :P595_TIPO_PRODUTO = 'P' and i.idprodutodetalhado = :P595_IDPRODUTODETALHADO )
                    or ( :P595_TIPO_PRODUTO = 'V' and exists ( select 1
                                                               from filtrosprodutosdetalhados ft
                                                               where ft.idprodutodetalhado = i.idprodutodetalhado
                                                                 and ft.usuario            = v('APP_USER') ) ) )
                  and :P595_TIPO_RELATORIO = 'D'
                  and p.dataemissao between to_date(:P595_DATAINICIO||' 00:00:00','DD/MM/RRRR hh24:mi:ss') and to_date(:P595_DATAFIM||' 23:59:59','DD/MM/RRRR hh24:mi:ss')
                  and ( :P595_PEDIDOS_PAGOS = 'T'
                     or ( :P595_PEDIDOS_PAGOS = 'S' and (p.valorapagar - p.valorpago) = 0 ) 
                     or ( :P595_PEDIDOS_PAGOS = 'N' and (p.valorapagar - p.valorpago) > 0 ) )
                order by i.quantidade desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P595_TIPO_RELATORIO = 'D' and :P595_TIPO_PRODUTO in ('P','V')
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum produto encontrado! Verifique os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 4990352651921264647
        }

