page 707 (
    name: Estrelas Romance
    title: Estrelas Romance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region estrelas-romance (
        name: Estrelas Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDCLUBEDESUCESSO, 
                       NOMECLUBE,
                       DATAVIGENCIAINICIAL,
                       DATAVIGENCIAFINAL
                from CLUBEDESUCESSO
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 708
                items: {
                    P708_IDCLUBEDESUCESSO: #IDCLUBEDESUCESSO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1505241841775149527
        }

        column DATAVIGENCIAFINAL (
            type: plainText
            heading {
                heading: Fim Vigência
            }
            layout {
                sequence: 22
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DATAVIGENCIAINICIAL (
            type: plainText
            heading {
                heading: Início Vigência
            }
            layout {
                sequence: 12
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDCLUBEDESUCESSO (
            type: hidden
            heading {
                heading: Idclubedesucesso
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMECLUBE (
            type: plainText
            heading {
                heading: Nome Clube
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 15052442 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAVIGENCIAFINAL (
                sequence: 4
            )

            displayColumn DATAVIGENCIAINICIAL (
                sequence: 3
            )

            displayColumn IDCLUBEDESUCESSO (
                sequence: 1
            )

            displayColumn NOMECLUBE (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Cadastro
        layout {
            sequence: 30
            region: @estrelas-romance
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 708
                clearCache: 708
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

