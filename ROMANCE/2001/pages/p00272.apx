page 272 (
    name: Correção de Carga
    title: Correção de Carga
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region correção-de-carga (
        name: Correção de Carga
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P272_DATACORRECAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @correção-de-carga
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATACORRECAO
            used: always
        }
        default {
            type: expression
            plsqlExpression: SYSDATE
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P272_IDCARGAREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @correção-de-carga
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCARGAREPRESENTANTE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P272_IDCORRECAOCARGA (
        type: hidden
        layout {
            sequence: 10
            region: @correção-de-carga
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCORRECAOCARGA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P272_MOTIVO (
        type: textarea
        label {
            label: Motivo
            alignment: left
        }
        settings {
            charCounter: true
        }
        layout {
            sequence: 40
            region: @correção-de-carga
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: MOTIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P272_USUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @correção-de-carga
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: expression
            plsqlExpression: V('APP_USER')
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 20
            region: @correção-de-carga
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
                items: {
                    P13_IDCARGAREPRESENTANTE: &P272_IDCARGAREPRESENTANTE.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 10
            region: @correção-de-carga
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P272_IDCORRECAOCARGA
        }
    )

    validation valida-correção (
        name: valida correção
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where lower(:P272_MOTIVO) like '%correção'
                ```
        }
        error {
            errorMessage: Favor utilizar uma descrição adequada!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process fetch-row-from-correcoescargas (
        name: Fetch Row from CORRECOESCARGAS
        type: autoRowFetch
        source {
            tableName: CORRECOESCARGAS
            pkColumn: IDCORRECAOCARGA
            pkItem: P272_IDCORRECAOCARGA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 55268119048776818
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P272_IDCORRECAOCARGA is null then
                        select "#OWNER#"."SEQ_IDCORRECAOCARGAREPRES".nextval
                          into :P272_IDCORRECAOCARGA
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 55268516030776819
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-correcoescargas (
        name: Process Row of CORRECOESCARGAS
        type: autoRowProcessing
        target {
            tableName: CORRECOESCARGAS
            pkColumn: IDCORRECAOCARGA
            pkItem: P272_IDCORRECAOCARGA
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 55268977915776819
        }
    )

)

