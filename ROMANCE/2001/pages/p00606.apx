page 606 (
    name: Distribuidores x Balanço
    title: Distribuidores x Balanço
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region relação-de-distribuidores (
        name: Relação de Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select empresa
                     , pck_romance.fnc_nomerepresentante(r.idrepresentante) distribuidor
                     , r.ativo
                     , r.iniciouem
                     , r.semana
                     , r.data
                from (  
                       select r.idrepresentante
                            , f.nome empresa
                            , decode(r.ativo,'S','Ativo','N','Inativo') ativo
                            , r.semanaparou
                            , pck_util.fnc_semanaid(r.idsemanabalanco) semana
                            , r.databalancoiniciado data
                            , ( select pck_util.fnc_semanaid(min(n.idsemanadistribuicao)) Semana
                                from notasvendas n
                                where idrepresentante  = r.idrepresentante ) iniciouem
                       from representantes r
                          , vw_filiais f
                       where r.idgerente = f.idgerente
                         and f.ativo = 'S'
                         and f.tipofilial = 'D'
                         and r.ativo = 'S'
                         and r.idsemanabalanco >= 762
                       union
                       select r.idrepresentante
                            , f.nome empresa
                            , decode(r.ativo,'S','Ativo','N','Inativo') ativo
                            , r.semanaparou
                            , pck_util.fnc_semanaid(r.idsemanabalanco) semana
                            , null data
                            , ( select pck_util.fnc_semanaid(min(n.idsemanadistribuicao)) Semana
                                from notasvendas n
                                where idrepresentante  = r.idrepresentante ) iniciouem
                       from representantes r
                          , vw_filiais f
                       where r.idgerente = f.idgerente
                         and f.ativo = 'S'
                         and f.tipofilial = 'D'
                         and r.ativo = 'S'
                         and r.idsemanabalanco < 762 ) r
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5407199384246160438
        }

        column ATIVO (
            type: plainText
            heading {
                heading: Situação
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column DATA (
            type: plainText
            heading {
                heading: Data do Balanço
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: F
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column INICIOUEM (
            type: plainText
            heading {
                heading: Iniciou Em
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana Balanço
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 55198711 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATIVO (
                sequence: 3
            )

            displayColumn DATA (
                sequence: 6
            )

            displayColumn DISTRIBUIDOR (
                sequence: 2
            )

            displayColumn EMPRESA (
                sequence: 1
            )

            displayColumn INICIOUEM (
                sequence: 4
            )

            displayColumn SEMANA (
                sequence: 5
            )

            sort (
                column: EMPRESA
                sort {
                    sequence: 1
                }
            )

            sort (
                column: DISTRIBUIDOR
                sort {
                    sequence: 2
                }
            )

        )

    )

)

