page 31 (
    name: Parâmetros Filial
    title: Parâmetros Filial
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region parâmetros-da-filial (
        name: Parâmetros da Filial
        type: tabform
        source {
            sqlQuery:
                ```sql
                select "ROWID"
                     , "IDFILIAL"
                     , "NOME"
                     , "VALOR"
                     , "OBSERVACAO"
                  from "#OWNER#"."PARAMETROS" p
                 where p.idfilial = :P0_IDFILIAL
                   and (    -- TI (grupo 0) sempre vê tudo:
                            exists ( select 1
                                       from roman.usuariosgruposatendimento ug
                                      where ug.idgrupoatendimento = 0
                                        and ug.usuario = v('APP_USER') )
                         OR -- Quem não é do grupo 9 nem do grupo 58 continua vendo tudo:
                            not exists ( select 1
                                           from roman.usuariosgruposatendimento ug
                                          where ug.idgrupoatendimento in ( 9, 58 )
                                            and ug.usuario = v('APP_USER') )
                         OR -- Grupo 9 (Análise de Crédito Favorita) enxerga somente estes parâmetros:
                            (     exists ( select 1
                                             from roman.usuariosgruposatendimento ug
                                            where ug.idgrupoatendimento = 9
                                              and ug.usuario = v('APP_USER') )
                              and p.nome in ( 'QTDMAXLEADSRESERVADOS', 'PRAZOEXPRESERVADOS' ) )
                         OR -- Grupo 58 (Comercial Romance) enxerga somente este parâmetro:
                            (     exists ( select 1
                                             from roman.usuariosgruposatendimento ug
                                            where ug.idgrupoatendimento = 58
                                              and ug.usuario = v('APP_USER') )
                              and p.nome = 'PRECIFICACAOCATEGORIAFILIAL' )
                       )
                       
                /*select "ROWID"
                     , "IDFILIAL"
                     , "NOME"
                     , "VALOR"
                     , "OBSERVACAO"
                  from "#OWNER#"."PARAMETROS" p
                 where p.idfilial = :P0_IDFILIAL
                   and (    -- Grupo 9 (Análise de Crédito Favorita) enxerga somente estes parâmetros:
                            (     exists ( select 1
                                             from roman.usuariosgruposatendimento ug
                                            where ug.idgrupoatendimento = 9
                                              and ug.usuario = v('APP_USER') )
                              and p.nome in ( 'QTDMAXLEADSRESERVADOS', 'PRAZOEXPRESERVADOS' ) )
                         OR -- Quem não é do grupo 9 continua vendo tudo normalmente:
                            not exists ( select 1
                                           from roman.usuariosgruposatendimento ug
                                          where ug.idgrupoatendimento = 9
                                            and ug.usuario = v('APP_USER') )
                       )*/
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <div style="background:#fdecea; border:1px solid #c00000; border-left:4px solid #c00000;
                            color:#c00000; font-weight:bold; padding:10px 14px; margin-bottom:10px;
                            border-radius:4px;">
                  &#9888; Atenção! Ao mudar o parâmetro nesta tela, altera o parâmetro de toda a franquia,
                  não somente de um representante.
                </div>
                ```
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 6
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
        )

        column NOME (
            reportColumnQueryId: 3
            derivedColumn: N
            type: textField
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 25
            }
            advanced {
                customAttributes: readonly
                cellWidth: 40
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: textField
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 6
            }
            appearance {
                width: 70
            }
            advanced {
                cellWidth: 60
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
            security {
                escapeSpecialChars: false
            }
        )

        column VALOR (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textField
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 15
            }
            advanced {
                cellWidth: 15
            }
        )

    )

    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 40
            region: @parâmetros-da-filial
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @parâmetros-da-filial
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 31
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @parâmetros-da-filial
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @parâmetros-da-filial
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idfilial-must-be-numeric (
        name: IDFILIAL must be numeric
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @parâmetros-da-filial
            type: columnIsNumeric
            column: IDFILIAL
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDFILIAL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idfilial-not-null (
        name: IDFILIAL not null
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @parâmetros-da-filial
            type: columnIsNotNull
            column: IDFILIAL
        }
        error {
            errorMessage: #COLUMN_HEADER# must have a value.
            associatedColumn: IDFILIAL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation nome-not-null (
        name: NOME not null
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @parâmetros-da-filial
            type: columnIsNotNull
            column: NOME
        }
        error {
            errorMessage: #COLUMN_HEADER# must have a value.
            associatedColumn: NOME
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation valor-not-null (
        name: VALOR not null
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @parâmetros-da-filial
            type: columnIsNotNull
            column: VALOR
        }
        error {
            errorMessage: #COLUMN_HEADER# must have a value.
            associatedColumn: VALOR
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @parâmetros-da-filial
        target {
            tableName: PARAMETROS
            pkColumn: ROWID
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# row(s) deleted.
        }
        advanced {
            executionMappingIdentifier: 26345326512229815
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @parâmetros-da-filial
        target {
            tableName: PARAMETROS
            pkColumn: ROWID
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 26344916829229815
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 31
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

