page 398 (
    name: Atualização de Notas Caducadas
    title: Atualização de Notas Caducadas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region adicionar-notas (
        name: Adicionar Notas
        type: tabform
        source {
            sqlQuery:
                ```sql
                Select null nrnota
                     , null cpf
                     , null retirarspc
                from dual
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P398_MENSAGEM
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CPF (
            reportColumnQueryId: 2
            derivedColumn: N
            type: textField
            heading {
                heading: CPF
                alignment: center
            }
            layout {
                sequence: 2
            }
            appearance {
                width: 30
            }
            sorting {
                sortable: false
            }
        )

        column NRNOTA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: textField
            heading {
                heading: Nr Nota
                alignment: center
            }
            layout {
                sequence: 1
            }
            appearance {
                width: 20
            }
            sorting {
                sortable: false
            }
        )

        column RETIRARSPC (
            reportColumnQueryId: 3
            derivedColumn: N
            type: simpleCheckbox
            heading {
                heading: Retirar do SPC
                alignment: center
            }
            lov {
                checkboxValues: S
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

    )

    region mensagem (
        name: Mensagem
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P398_MENSAGEM (
        type: textField
        label {
            label: Mensagem a Atualizar
            alignment: left
        }
        layout {
            sequence: 10
            region: @mensagem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Add Nota
        layout {
            sequence: 20
            region: @adicionar-notas
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button comecar (
        buttonName: COMECAR
        label: Começar
        layout {
            sequence: 20
            region: @mensagem
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button confimar (
        buttonName: CONFIMAR
        label: Confirmar
        layout {
            sequence: 10
            region: @adicionar-notas
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction set-focus (
        name: Set Focus
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @add
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.widget.tabular.addRow();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: jquerySelector
                jquerySelector: "[name=f01]:last"
            }
            execution {
                sequence: 20
            }
        )

    )

    process atualiza-informações (
        name: Atualiza Informações
        type: executeCode
        editableRegion: @adicionar-notas
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidnotavenda number;
                  vidvendedora number;
                  vidpepino    number;
                  --
                begin
                  --
                  begin
                    --
                    select idvendedora
                    into vidvendedora
                    from pessoas p
                       , vendedoras v
                    where v.idpessoa = p.idpessoa
                      and p.cpf = replace(replace(:CPF,'-',''),'.','');
                    --
                  exception
                    when others then
                      --
                      begin
                        --
                        select idpepinosrepresentante
                        into vidpepino
                        from pepinosrepresentantes p
                        where p.cpf = :CPF
                          and p.nrpedido = :NRNOTA
                          and p.responsavelcobranca is not null;
                        --
                      exception
                        when others then 
                          --
                          select idpepinosrepresentante
                          into vidpepino
                          from pepinosrepresentantes p
                          where p.cpf = :CPF
                            and p.nrpedido = :NRNOTA;
                          --
                      end;
                      --
                  end;
                  --
                  begin
                    --
                    select idnotavenda
                    into vidnotavenda
                    from notasvendas n
                    where n.idvendedora = vidvendedora
                      and n.numeronota  = :NRNOTA;
                    --
                  exception
                    when others then
                      --
                      begin
                        --
                        select idpepinosrepresentante
                        into vidpepino
                        from pepinosrepresentantes p
                        where p.cpf = :CPF
                          and p.nrpedido = :NRNOTA
                          and p.responsavelcobranca is not null;
                        --
                      exception
                        when others then 
                          --
                          select idpepinosrepresentante
                          into vidpepino
                          from pepinosrepresentantes p
                          where p.cpf = :CPF
                            and p.nrpedido = :NRNOTA;
                          --
                      end; 
                      --
                  end;
                  --
                  if vidnotavenda is not null then
                    --
                    insert into correcoesnotasvendas ( idcorrecaonotavenda
                                                     , datacorrecao
                                                     , usuario
                                                     , motivo
                                                     , idnotavenda
                                                     , situacao )
                    values ( seq_idcorrecaonotavenda.nextval
                           , sysdate
                           , v('APP_USER')
                           , :P398_MENSAGEM
                           , vidnotavenda
                           , 'C' );
                    --
                    insert into observacoesnotasvendas ( idobsnotavenda
                                                       , idnotavenda
                                                       , data
                                                       , observacao
                                                       , usuario )
                    values ( seq_idobsnotavenda.nextval
                           , vidnotavenda
                           , sysdate
                           , :P398_MENSAGEM
                           , v('APP_USER') );
                    --
                  elsif vidpepino is not null then
                    --
                    insert into observacoespepinosrepres ( idobspepinorepresentante,
                                                           idpepinorepresentante,
                                                           data,
                                                           observacao,
                                                           usuario)
                    values ( seq_idobspepinosrepres.nextval
                           , vidpepino
                           , sysdate
                           , :P398_MENSAGEM
                           , v('APP_USER') );
                    --
                  end if;
                  --
                  if :RETIRARSPC = 'S' THEN
                    --
                    update vendedoras v
                    set v.spc = null
                    where v.idvendedora = vidvendedora;
                    --
                  end if;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: "Informações Atualizadas com sucesso! "
        }
        advanced {
            executionMappingIdentifier: 1444530903071760539
        }
        serverSideCondition {
            whenButtonPressed: @confimar
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 398
                items: {
                    P398_MENSAGEM:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @confimar
        }
    )

)

