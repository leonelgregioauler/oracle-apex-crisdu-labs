page 41 (
    name: Estoque Distribuição Atual
    title: Estoque Distribuição Atual
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function confirma(event)
            { 
             var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
             if (tecla==13) 
              {
                var answer = confirm("Confirma inclusão do item no estoque?");
                if (answer)
                 { 
            	   apex.submit('CREATE');
            	 }
              }
            }
            
            
            function fnc_popup(pid)
            {
              window.open('f?p=&APP_ID.:124:&SESSION.::NO::P124_IDESTOQUEFILIAL:'+pid,'ESTOQUE', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=300,left=200,top=100','_blank'); 
              void(0);
            }
            
            function fnc_popup_habilitar()
            {
              window.open( 'f?p=&APP_ID.:142:&SESSION.::NO::', 'HABILITAR', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=300,left=250,top=100','_blank'); 
              void(0);
            }
            
            function fnc_popup_estreserva(pidestoquefil)
            {
              window.open( 'f?p=&APP_ID.:210:&SESSION.::NO::P210_IDESTOQUEFIL:'+pidestoquefil, 'ESTRESERVA', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1100,height=900,left=100,top=50','_blank'); 
              void(0);
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region estoque-atual (
        name: Estoque Atual
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with filiais_escopo as (
                  -- Mesma regra de escopo de filial usada em query_estoquefilial_filtro_p0_idfilial.sql
                  -- (Comercial Romance / regional / America Latina / todas / uma especifica).
                  select f.idfilial
                  from roman.vw_filiais_filtro f
                  where f.ref_filial =  :P0_IDFILIAL
                )
                select  /*+ first_rows (50) */ pck_romance.fnc_nomefilial(e.idfilial ) "Filial"
                     , ( select c.nome
                         from categorias c
                         where c.idcategoria = p.idcategoria ) "Categoria"
                     , p.codigosisdist  "Código"
                     , p.nomeproduto  "Produto"
                     , ( select c.descricao
                         from cores c
                         where c.idcor = e.idcor)  "Cor"
                     , e.quantidade
                     , decode(e.ativo,'S','Sim','Não') ativo
                     , e.idestoquefilial
                     , e.idfilial
                     , e.idproduto
                     , e.idcor
                     , decode(e.comissao, 'S', 'Sim','N','Não') comissao
                     , e.vlrvenda
                     , '|' "EF"
                     , nvl(e.qtd_pp ,0) "EF PP"
                     , nvl(e.qtd_p  ,0) "EF P"
                     , nvl(e.qtd_m  ,0) "EF M"
                     , nvl(e.qtd_g  ,0) "EF G"
                     , nvl(e.qtd_gg ,0) "EF GG"
                     , nvl(e.qtd_egg,0) "EF EGG"
                     , nvl(e.qtd_exgg,0) "EF EXGG"
                     , nvl(e.qtd_u  ,0) "EF U"
                     , '|' "ER"
                     , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'PP')  "ER PP"
                     , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'P')   "ER P"
                     , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'M')   "ER M"
                     , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'G')   "ER G"
                     , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'GG')  "ER GG"
                     , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EGG') "ER EGG"
                     , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EXGG') "ER EXGG"
                     , pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'U')   "ER U"
                     , '|' "ED"
                     , nvl(e.qtd_pp ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'PP')  "ED PP"
                     , nvl(e.qtd_p  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'P')   "ED P"
                     , nvl(e.qtd_m  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'M')   "ED M"
                     , nvl(e.qtd_g  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'G')   "ED G"
                     , nvl(e.qtd_gg ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'GG')  "ED GG"
                     , nvl(e.qtd_egg,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EGG') "ED EGG"
                     , nvl(e.qtd_exgg,0)- pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EXGG') "ED EXGG"
                     , nvl(e.qtd_u  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'U')   "ED U"
                     --
                     , (nvl(e.qtd_pp ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'PP')  )
                     + (nvl(e.qtd_p  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'P')   )
                     + (nvl(e.qtd_m  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'M')   )
                     + (nvl(e.qtd_g  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'G')   )
                     + (nvl(e.qtd_gg ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'GG')  )
                     + (nvl(e.qtd_egg,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EGG') )
                     + (nvl(e.qtd_exgg,0)- pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EXGG'))
                     + (nvl(e.qtd_u  ,0) - pck_estoque.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'U')) "ED TOTAL"
                from estoquefilial e
                   , produtos p
                   , filiais_escopo fe
                where e.idfilial  = fe.idfilial
                  and p.idproduto = e.idproduto
                  and ( :P41_FILTRARTODOS = 'S' or e.idproduto = :P41_IDPRODUTO )
                ```
            pageItemsToSubmit: [
                P41_FILTRARTODOS
                P41_IDPRODUTO
            ]
        }
