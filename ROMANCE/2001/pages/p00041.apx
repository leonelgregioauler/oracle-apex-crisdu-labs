    pageItem P41_FILTRARTODOS (
        type: radioGroup
        label {
            label: Mostrar Todos
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @estoque-atual
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P41_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
            initialFetch: onUserRequest
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                with filiais_escopo as (
                  -- Mesma regra de escopo de filial usada em query_estoquefilial_filtro_p0_idfilial.sql
                  -- (Comercial Romance / regional / America Latina / todas / uma especifica).
                  select f.idfilial
                  from roman.vw_filiais_filtro f
                  where f.ref_filial =  :P0_IDFILIAL
                )
                select distinct
                       (p.codigosisdist ||' - '|| pck_romance.fnc_nomeproduto(e.idproduto)) display_value
                     , e.idproduto return_value
                from estoquefilial e
                   , produtos      p
                   , filiais_escopo fe
                where e.idproduto = p.idproduto
                  and e.idfilial  = fe.idfilial
                  and e.ativo     = 'S'
                order by 1
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @estoque-atual
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 30
            region: @estoque-atual
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: FILTRAR
        }
    )

    button novaentrada (
        buttonName: NOVAENTRADA
        label: Nova Entrada
        layout {
            sequence: 10
            region: @estoque-atual
            slot: previous
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 43
                items: {
                    P43_IDFILIAL: &P0_IDFILIAL.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2316,v('APP_USER'))= 'S'
                  and :P0_ESTOQUECONGELADO = 'N'
                ```
        }
    )

    button novasaida (
        buttonName: NOVASAIDA
        label: Nova Saída
        layout {
            sequence: 20
            region: @estoque-atual
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 110
                items: {
                    P110_IDFILIAL: &P0_IDFILIAL.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2316,v('APP_USER')) = 'S'
                  and :P0_ESTOQUECONGELADO = 'N'
                ```
        }
    )

    dynamicAction atualiza-relatório (
        name: Atualiza relatório
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P41_FILTRARTODOS
                P41_IDPRODUTO
            ]
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction seta-foco (
        name: Seta Foco
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: void(0);
            }
            execution {
                sequence: 10
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P41_IDPRODUTO
            }
            execution {
                sequence: 20
            }
        )

    )

    branch (
        name: branch
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 41
                items: {
                    P41_IDPRODUTO: &P41_IDPRODUTO.
                    P41_FILTRARTODOS: &P41_FILTRARTODOS.
                }
                successMessage: false
            }
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

)

