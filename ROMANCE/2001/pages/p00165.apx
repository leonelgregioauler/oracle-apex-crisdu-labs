            )

            highlight ir-condition (
                name: Comissão Alterada
                condition {
                    column: "Comissão Alterada"
                    value: Sim
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #CCA52F
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-2 (
                name: Remarcadas Acertadas
                condition {
                    column: INTERVALO
                    operator: >
                    value: 6
                }
                colors {
                    background: #F54444
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-3 (
                name: Ticket Médio abaixo de 200
                condition {
                    column: TICKETMEDIO
                    operator: <
                    value: 200
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #FF7755
                    text: #000000
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-4 (
                name: Ticket Medio acima 300
                condition {
                    column: TICKETMEDIO
                    operator: >
                    value: 300
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #99FF99
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-5 (
                name: Ticket Médio 200 a 300
                condition {
                    column: TICKETMEDIO
                    operator: between
                    from: 200.01000000
                    to: 299.99000000
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #FFFF99
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

