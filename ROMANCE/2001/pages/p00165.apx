    region lista-de-notas-de-venda (
        name: Lista de Notas de Venda
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ FIRST_ROWS(50) */ nv.idnotavenda
                     , to_number(nv.numeronota) numeronota
                     , nv.datanota
                     , nv.semanadistribuicao/*||'  '||pck_romance.fnc_semanadias(psemana => nv.semanadistribuicao)*/ "Semana Distribuição"
                     , nv.semanacobranca/*||'  '||pck_romance.fnc_semanadias(psemana => nv.semanacobranca)*/ "Semana Cobrança"
                     , pck_romance.fnc_nomepessoa(vv.idpessoa) "Vendedora"
                     , c.nomecidade
                     , nv.valortotalnota
                     , nv.valortotaldevolucao
                     , nv.valortotalvenda
                     , nv.basecomissao
                     , nv.perccomissao
                     , nv.perccomissaocorreta
                     , nv.valorcomissao
                     , nv.valortotalvenda - nv.valorcomissao valorpagar
                     , nvl(( select sum(pn.valorpago) 
                         from pagamentosnotasvendas pn
                         where pn.idnotavenda = nv.idnotavenda
                           and pn.semanacobranca =  trim(:P165_SEMANA) ),0) pagonasemana
                     , nvl(( select sum(pn.valorpago) 
                         from pagamentosnotasvendas pn
                         where pn.idnotavenda = nv.idnotavenda
                           and pn.semanacobranca !=  trim(:P165_SEMANA) ),0) pagoforasemana
                     , nv.saldo
                     , ( select sn.descricao from situacoesnotavenda sn where sn.idsituacaonotavenda = nv.idsituacaonotavenda ) "Situação"
                     , decode(nv.quitadapepino,'Q','Quitado','P','Inadimplente','R','Remarcada') "Quitado/Pepino"
                     , pck_util.fnc_idsemana(nv.semanacobranca) - pck_util.fnc_idsemana(nv.semanadistribuicao) intervalo
                     , nv.semanacobranca
                     , case 
                          when nv.perccomissao != nv.perccomissaocorreta then 
                             'Sim'
                          else 
                             'Não'  
                       end  "Comissão Alterada"
                     , nv.dataacerto "Data Acerto"
                     , nvl(( select 'Sim'
                                 from pedidos pp
                                 where trunc(pp.dataentrega) > trunc(nv.dataretorno)-10
                                   and pp.idnotavenda is null
                                   and pp.tipo = 'P'
                                   and pp.idpedido = ( select max(idpedido)
                                                       from pedidos p
                                                       where p.idvendedora = nv.idvendedora )),'Não') "Pedido Favorita" 
                      , pck_romance.fnc_nomerepresentante(nv.idrepresentanteatende) "Rep Atende"
                      , pck_romance.fnc_nomerepresentante(nv.idrepresentante) "Representante"
                      , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' url
                      , ( select listagg(to_char(pg.valorpago,'FML999G999G999G999G990D00')||' - '||decode(pg.usuarioalteracao,'APEX_PUBLIC_USER','Netbook',pg.usuarioalteracao),' ') within group ( order by 1 ) Origem
                          from logroman.log_pagamentosnotasvendas pg
                             , pagamentosnotasvendas p
                          where pg.idpagtonotavenda = p.idpagtonotavenda
                            and p.idnotavenda = nv.idnotavenda ) "Origem Pagamento(s)"
                      , pck_romance.fnc_retornatelefones(nv.idvendedora) "Telefones"
                      , pck_romance.fnc_ticketmedioconsultora(nv.idvendedora) ticketmedio
                      , nv.idvendedora
                      , decode(vv.ativo,'S','Ativo','N','Inativo') situacaocliente
                      , nvl((select 'Sim'
                             from dual
                             where exists (select 1
                                           from registrosloginminhasacola r
                                           where r.idvendedora = vv.idvendedora)),'Não') usaapp
                      -- Maicon Aimi - 10276934 - 11/07/2025 - Adicionado a data reativação
                      , case 
                          when vv.datareativacaovendedora is not null then
                            to_char(trunc(vv.datareativacaovendedora), 'DD/MM/YYYY') || 
                            ' (' || (trunc(sysdate) - trunc(vv.datareativacaovendedora)) || ' dias)'
                          else
                            null
                        end as data_reativacao
                      , nvl( ( select 'Sim'
                               from classificacoesnotasvendas cn
                               where cn.idcaracteristicanotavenda = 71
                                 and cn.idnotavenda = nv.idnotavenda
                                 and rownum <= 1 ),'Nao') acertada_outro_tablet
                      , case 
                          when vv.ativo = 'S' then
                            ( select 'Sim'
                              from notasvendas nn
                              where nn.idvendedora = vv.idvendedora
                                and nn.idsituacaonotavenda = 3
                                and nn.idnotavenda > nv.idnotavenda
                                and rownum = 1 )
                          else 
                            'Nao'
                        end ciclo_renovado
                from notasvendas    nv
                   , vendedoras     vv
                   , regioesvenda   rv
                   , catal.pessoas p
                   , catal.cidades c
                where nv.idvendedora   = vv.idvendedora
                  and nv.idregiaovenda = rv.idregiaovenda
                  and vv.idpessoa = p.idpessoa
                  and p.idcidade = c.idcidade
                  and nv.idrepresentante = :P165_IDREPRESENTANTE
                  and nv.idsituacaonotavenda != 5
                  -- 03/07/2025 - Maicon/Osiel/Bruno  <- que time! - 10588803
                  -- deve se manter o nv.idsituacaonotavenda != 5 junto com o filtro abaixo.
                  and (:P165_IDSITUACAONOTAVENDA is null or nv.idsituacaonotavenda = :P165_IDSITUACAONOTAVENDA)
                  and nvl(nv.tiponota,'R') = 'R'
                  and nv.semanacobranca = trim(:P165_SEMANA)
                union all 
                select /*+ FIRST_ROWS(50) */ nv.idnotavenda
                     , to_number(nv.numeronota) numeronota
                     , nv.datanota
                     , nv.semanadistribuicao/*||'  '||pck_romance.fnc_semanadias(psemana => nv.semanadistribuicao)*/ "Semana Distribuição"
                     , nv.semanacobranca/*||'  '||pck_romance.fnc_semanadias(psemana => nv.semanacobranca)*/ "Semana Cobrança"
                     , pck_romance.fnc_nomepessoa(vv.idpessoa) "Vendedora"
                     , c.nomecidade
                     , nv.valortotalnota
                     , nv.valortotaldevolucao
                     , nv.valortotalvenda
                     , nv.basecomissao
                     , nv.perccomissao
                     , nv.perccomissaocorreta
                     , nv.valorcomissao
                     , nv.valortotalvenda - nv.valorcomissao valorpagar
                     , nvl(( select sum(pn.valorpago) 
                         from pagamentosnotasvendas pn
                         where pn.idnotavenda = nv.idnotavenda
                           and pn.semanacobranca =  trim(:P165_SEMANA) ),0) pagonasemana
                     , nvl(( select sum(pn.valorpago) 
                         from pagamentosnotasvendas pn
                         where pn.idnotavenda = nv.idnotavenda
                           and pn.semanacobranca !=  trim(:P165_SEMANA) ),0) pagoforasemana
                     , nv.saldo
                     , ( select sn.descricao from situacoesnotavenda sn where sn.idsituacaonotavenda = nv.idsituacaonotavenda ) "Situação"
                     , decode(nv.quitadapepino,'Q','Quitado','P','Inadimplente','R','Remarcada') "Quitado/Pepino"
                     , pck_util.fnc_idsemana(nv.semanacobranca) - pck_util.fnc_idsemana(nv.semanadistribuicao) intervalo
                     , nv.semanacobranca
                     , case 
                          when nv.perccomissao != nv.perccomissaocorreta then 
                             'Sim'
                          else 
                             'Não'  
                       end  "Comissão Alterada"
                     , nv.dataacerto "Data Acerto"
                     , nvl(( select 'Sim'
                                 from pedidos pp
                                 where trunc(pp.dataentrega) > trunc(nv.dataretorno)-10
                                   and pp.idnotavenda is null
                                   and pp.tipo = 'P'
                                   and pp.idpedido = ( select max(idpedido)
                                                       from pedidos p
                                                       where p.idvendedora = nv.idvendedora )),'Não') "Pedido Favorita" 
                      , pck_romance.fnc_nomerepresentante(nv.idrepresentanteatende) "Rep Atende"
                      , pck_romance.fnc_nomerepresentante(nv.idrepresentante) "Representante"
                      , null irparanota
                      , ( select listagg(to_char(pg.valorpago,'FML999G999G999G999G990D00')||' - '||decode(pg.usuarioalteracao,'APEX_PUBLIC_USER','Netbook',pg.usuarioalteracao),' ') within group ( order by 1 ) Origem
                          from logroman.log_pagamentosnotasvendas pg
                             , pagamentosnotasvendas p
                          where pg.idpagtonotavenda = p.idpagtonotavenda
                            and p.idnotavenda = nv.idnotavenda ) "Origem Pagamento(s)"
                      , pck_romance.fnc_retornatelefones(nv.idvendedora) "Telefones"
                      , pck_romance.fnc_ticketmedioconsultora(nv.idvendedora) ticketmedio
                      , nv.idvendedora
                      , decode(vv.ativo,'S','Ativo','N','Inativo') situacaocliente
                      , nvl((select 'Sim'
                             from dual
                             where exists (select 1
                                           from registrosloginminhasacola r
                                           where r.idvendedora = vv.idvendedora)),'Não') usaapp
                      -- Maicon Aimi - 10276934 - 11/07/2025 - Adicionado a data reativação
                      , case 
                          when vv.datareativacaovendedora is not null then
                            to_char(trunc(vv.datareativacaovendedora), 'DD/MM/YYYY') || 
                            ' (' || (trunc(sysdate) - trunc(vv.datareativacaovendedora)) || ' dias)'
                          else
                            null
                        end as data_reativacao
                      , nvl( ( select 'Sim'
                               from classificacoesnotasvendas cn
                               where cn.idcaracteristicanotavenda = 71
                                 and cn.idnotavenda = nv.idnotavenda
                                 and rownum <= 1 ),'Nao') acertada_outro_tablet
                      , case 
                          when vv.ativo = 'S' then
                            ( select 'Sim'
                              from notasvendas nn
                              where nn.idvendedora = vv.idvendedora
                                and nn.idsituacaonotavenda = 3
                                and nn.idnotavenda > nv.idnotavenda
                                and rownum = 1 )
                          else 
                            'Nao'
                        end ciclo_renovado
                from notasvendas    nv
                   , vendedoras     vv
                   , regioesvenda   rv
                   , catal.pessoas p
                   , catal.cidades c
                where nv.idvendedora   = vv.idvendedora
                  and nv.idregiaovenda = rv.idregiaovenda(+)
                  and vv.idpessoa = p.idpessoa
                  and p.idcidade = c.idcidade
                  and nv.idrepresentanteatende = :P165_IDREPRESENTANTE
                  and nv.idsituacaonotavenda != 5
                  -- 03/07/2025 - Maicon/Osiel/Bruno  <- que time! - 10588803
                  -- deve se manter o nv.idsituacaonotavenda != 5 junto com o filtro abaixo.
                  and (:P165_IDSITUACAONOTAVENDA is null or nv.idsituacaonotavenda = :P165_IDSITUACAONOTAVENDA)
                  and nv.semanacobranca = trim(:P165_SEMANA)
                  and nvl(nv.tiponota,'R') = 'R'
                  and exists ( select 1
                                from representantes r
                                where r.idrepresentante = nv.idrepresentante
                                  and r.ativo = 'N'
                                  and r.semanaparou  < pck_util.fnc_idsemana(psemana => trim(:P165_SEMANA) ) )
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 164
                items: {
                    P164_IDNOTAVENDA: #IDNOTAVENDA#
                    P164_IDPAGTONOTAVENDA:
                    P164_SEMANAACERTO: #SEMANACOBRANCA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt="">
            conditionType: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where f.semana = :P165_SEMANA
                  and nvl(f.concluido,'N') = 'N'
                  and f.idfilial = :P0_IDFILIAL
                  and :P75_IDFECHAMENTOREPRES is not null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: Não há notas incluídas.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            savePublicReport: true
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

