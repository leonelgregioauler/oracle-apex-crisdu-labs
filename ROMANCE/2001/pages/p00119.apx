                return :P119_IDPRODUTO;
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P119_IDDEVOLUCAOREPRES
        }
        readOnly {
            type: itemIsNotNull
            item: P119_IDPRODUTO2
        }
        security {
            encryptSessionState: false
        }
    )

