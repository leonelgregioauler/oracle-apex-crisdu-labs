    dynamicAction new (
        name: New
        execution {
            sequence: 160
        }
        when {
            selectionType: items
            items: P119_CODIGO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    
                    begin
                        select 1 into :P119_VALIDAPROD
                        from produtos      p
                           , estoquefilial e
                        where p.codigosisdist = SUBSTR(:P119_CODIGO,1,5)
                          and p.idproduto = e.idproduto
                          and e.idfilial = :P0_IDFILIAL
                          and e.ativo = 'S';
                    exception
                     when no_data_found then
                       :P119_VALIDAPROD := 0;
                       
                    end;
                    ```
                itemsToSubmit: P119_CODIGO
                itemsToReturn: P119_VALIDAPROD
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

