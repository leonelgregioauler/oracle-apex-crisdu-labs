    dynamicAction direciona-para-posto-avançado (
        name: direciona para posto avançado
        execution {
            sequence: 70
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from representantes
                where idpostoavancado is not null
                and idrepresentante = (select idrepresentante
                                       from devolucoesrepresentantes d
                                       where d.iddevolucaorepres = :P119_IDDEVOLUCAOREPRES)
                ```
        }

        action native-set-value (
            action: setValue
            settings {
                value: P
            }
            affectedElements {
                selectionType: items
                items: P119_ESTOQUEDESTINO
            }
            execution {
                sequence: 10
            }
        )

    )

