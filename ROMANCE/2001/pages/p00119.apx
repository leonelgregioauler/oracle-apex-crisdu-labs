    region incluir-item (
        name: Incluir Item
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region último-item-incluído-qtde-total-p119-qtdreg (
        name: Último item incluído (Qtde Total &P119_QTDREG.)
        type: tabform
        source {
            sqlQuery:
                ```sql
                select a.*
                from (
                select i.iditemdevolucaorepres
                     , i.iddevolucaorepres
                     , i.idestoquefil
                     , ( select p.codigosisdist
                         from produtos p
                         where p.idproduto = i.idproduto ) "Código"
                     , pck_romance.fnc_nomeproduto(pidproduto => i.idproduto) "Produto"
                     , decode(e.comissao, 'S', 'Sim', 'N', 'Não') "Comissão?"
                     , i.qtd_pp
                     , i.qtd_p
                     , i.qtd_m
                     , i.qtd_g
                     , i.qtd_gg
                     , i.qtd_egg
                     , i.qtd_exgg
                     , i.qtd_u
                     , ( select d.descricao from defeitos d where d.iddefeito = i.iddefeito ) "Defeito"
                     , i.valorproduto "Vlr Venda"
                     , (( nvl(i.qtd_pp,0)
                       + nvl(i.qtd_p,0)
                       + nvl(i.qtd_m,0)
                       + nvl(i.qtd_g,0)
                       + nvl(i.qtd_gg,0)
                       + nvl(i.qtd_egg,0)
                       + nvl(i.qtd_exgg,0)
                       + nvl(i.qtd_u,0))*i.valorproduto) "Total"
                     , decode(i.estoquedestino,'R','Reembalagem','D','Distribuição','D','Defeito','F','Defeito',i.estoquedestino) "Destino"
                     , decode(i.origemdefeito,'R','Distribuidor','F','Fornecedor') origemdefeito
                from itensdevolucaorepres i
                   , estoquefilial        e
                where i.idestoquefil      = e.idestoquefilial
                  and i.iddevolucaorepres = :P119_IDDEVOLUCAOREPRES
                  order by i.iditemdevolucaorepres desc ) a
                where rownum = 1
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P119_IDDEVOLUCAOREPRES is not null
                ```
        }
        reportLayout {
            numberOfRows: 150
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: showAll
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 1500
        }
        messages {
            whenNoDataFound: Dados não encontrados.
        }
        componentAdvanced {
            stripHtml: true
        }

