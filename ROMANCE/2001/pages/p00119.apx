    pageItem P119_IDPOSTOAVANCADO (
        type: selectList
        label {
            label: Posto Avançado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome
                     , p.idpostoavancado
                from postoavancado p
                where idfilial = :P0_IDFILIAL
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @incluir-item
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDPOSTOAVANCADO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vid number;
                begin
                  select r.idpostoavancado
                  into vid
                  from representantes r
                     , devolucoesrepresentantes d
                  where r.idrepresentante = d.idrepresentante
                  and d.iddevolucaorepres = :P115_IDDEVOLUCAOREPRES;
                  --
                  return vid;
                end;
                ```
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P119_IDPRODUTO (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto) display_value
                     , p.idproduto return_value
                from produtos      p
                   , estoquefilial e
                where p.codigosisdist = SUBSTR(:P119_CODIGO,1,5)
                  and p.idproduto = e.idproduto
                  and e.idfilial = :P0_IDFILIAL
                  and e.ativo = 'S'
                order by 1;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P119_CODIGO
        }
        layout {
            sequence: 140
            region: @incluir-item
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDPRODUTO
            used: always
        }
        serverSideCondition {
            type: itemIsNull
            item: P119_IDITEMDEVOLUCAOREPRES
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P119_IDPRODUTO2 (
        type: selectOne
        label {
            label: Produto
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select P.CODIGOSISDIST ||' - '|| initcap(p.nomeproduto) display_value
                     , p.idproduto return_value
                from produtos      p
                   , estoquefilial e
                where e.idproduto = p.idproduto
                  and e.idfilial = :P0_IDFILIAL
                  and e.ativo = 'S'
                order by p.nomeproduto
                ```
        }
        layout {
            sequence: 145
            region: @incluir-item
            slot: regionBody
            alignment: left
        }
        appearance {
