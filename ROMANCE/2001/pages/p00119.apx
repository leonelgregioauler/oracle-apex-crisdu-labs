    process inclui-devolução (
        name: Inclui Devolução
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                --
                  viditemdevolucao      number;
                  viddevolucao          number := :P119_IDDEVOLUCAOREPRES ;
                  videstoquefil         number;
                  vidproduto            number;   
                  vqtd_pp               number;
                  vqtd_p                number; 
                  vqtd_m                number; 
                  vqtd_g                number; 
                  vqtd_gg               number; 
                  vqtd_egg              number; 
                  vqtd_exgg             number; 
                  
                  vqtd_u                number; 
                  vestoquedestino       varchar(1) := :P119_ESTOQUEDESTINO ;
                  vidpostoavancado      number := :P119_IDPOSTOAVANCADO;
                  viddefeitonovo        number := nvl(:P119_IDDEFEITO,0) ;
                  vrepresentanteficou   varchar(1) := :P119_REPRESENTANTEFICOU;
                  vlrvenda              number(15,2);
                  vcomissao             varchar2(1);
                  videstoqueanterior    number;
                  viddefeitoanterior    number;
                --
                begin
                  --
                  --insert into teste values('teste devolucao',:P119_IDDEVOLUCAOREPRES||'-'||videstoquefil||'-'||:P119_IDITEMDEVOLUCAOREPRES||'-'||:P119_QTD_U||'-'||nvl(:P119_IDPRODUTO,:P119_IDPRODUTO2));
                  --
                  select idestoquefilial
                       , e.vlrvenda
                       , e.comissao
                  into videstoquefil
                     , vlrvenda
                     , vcomissao
                  from estoquefilial e
                  where e.idfilial = :P0_IDFILIAL
                    and e.idproduto = nvl(:P119_IDPRODUTO,:P119_IDPRODUTO2)
                    and e.ativo = 'S';
                  -- 
                  begin
                    --
                    select nvl(i.qtd_pp,0), nvl(i.qtd_p,0), nvl(i.qtd_m,0), nvl(i.qtd_g,0), nvl(i.qtd_gg,0), nvl(i.qtd_egg,0), nvl(i.qtd_exgg,0), nvl(i.qtd_u,0), iditemdevolucaorepres, idestoquefil, nvl(iddefeito,0)
                    into vqtd_pp, vqtd_p, vqtd_m, vqtd_g, vqtd_gg, vqtd_egg, vqtd_exgg,  vqtd_u, viditemdevolucao, videstoqueanterior, viddefeitoanterior
                    from itensdevolucaorepres i
                    where i.idestoquefil       = videstoquefil
                      and i.estoquedestino     = :P119_ESTOQUEDESTINO
                      and i.iddevolucaorepres  = :P119_IDDEVOLUCAOREPRES
                      and nvl(i.iddefeito,0)   = nvl(:P119_IDDEFEITO,0);
                  exception 
                    when others then
                      videstoqueanterior := null;
                  end;
                  --
                  vqtd_pp   := vqtd_pp +   nvl(:P119_QTD_PP,0);
                  vqtd_p    := vqtd_p +    nvl(:P119_QTD_P,0);
                  vqtd_m    := vqtd_m +    nvl(:P119_QTD_M,0);
                  vqtd_g    := vqtd_g +    nvl(:P119_QTD_G,0);
                  vqtd_gg   := vqtd_gg +   nvl(:P119_QTD_GG,0);
                  vqtd_egg  := vqtd_egg +  nvl(:P119_QTD_EGG,0); 
                  vqtd_exgg := vqtd_exgg + nvl(:P119_QTD_EXGG,0);
                  --vqtd_xxgg := vqtd_xxgg + nvl(:P119_QTD_XXGG,0);
                  vqtd_u    := vqtd_u +    nvl(:P119_QTD_U,0);
                  --
                  if videstoquefil = videstoqueanterior
                    and viddefeitonovo = viddefeitoanterior then
                    --
                    delete itensdevolucaorepres i
                    where i.iditemdevolucaorepres = viditemdevolucao;
                    --
                    insert into itensdevolucaorepres ( iditemdevolucaorepres    , iddevolucaorepres      , idestoquefil
                                                     , idproduto                
                                                     , qtd_pp                   , qtd_p                  , qtd_m
                                                     , qtd_g                    , qtd_gg                 , qtd_egg
                                                     , qtd_u                    , estoquedestino         , idpostoavancado
                                                     , iddefeito                , valorproduto           , representanteficou
                                                     , situacaodefeito          , idfechamentoreprespago , comissao
                                                     , qtd_exgg                 , origemdefeito          , usuariomovimentacao )
                    values ( :P119_IDITEMDEVOLUCAOREPRES      , :P119_IDDEVOLUCAOREPRES      , videstoquefil
                           , :P119_IDPRODUTO                  
                           , vQTD_PP                          , vQTD_P                       , vQTD_M
                           , vQTD_G                           , vQTD_GG                      , vQTD_EGG
                           , vQTD_U                           , :P119_ESTOQUEDESTINO         , :P119_IDPOSTOAVANCADO
                           , :P119_IDDEFEITO                  , vlrvenda                     , :P119_REPRESENTANTEFICOU
                           , null                             , null                         , vcomissao
                           , vQTD_EXGG                        , :P119_ORIGEMDEFEITO          , v('APP_USER'));
                    --
                  elsif videstoqueanterior is null then
                    --
                    insert into itensdevolucaorepres ( iditemdevolucaorepres    , iddevolucaorepres      , idestoquefil
                                                     , idproduto                
                                                     , qtd_pp                   , qtd_p                  , qtd_m
                                                     , qtd_g                    , qtd_gg                 , qtd_egg
                                                     , qtd_u                    , estoquedestino         , idpostoavancado
                                                     , iddefeito                , valorproduto           , representanteficou
                                                     , situacaodefeito          , idfechamentoreprespago , comissao
                                                     , qtd_exgg                 , origemdefeito          , usuariomovimentacao)
                    values ( :P119_IDITEMDEVOLUCAOREPRES      , :P119_IDDEVOLUCAOREPRES      , videstoquefil
                           , :P119_IDPRODUTO                  
                           , :P119_QTD_PP                     , :P119_QTD_P                  , :P119_QTD_M
                           , :P119_QTD_G                      , :P119_QTD_GG                 , :P119_QTD_EGG
                           , :P119_QTD_U                      , :P119_ESTOQUEDESTINO         , :P119_IDPOSTOAVANCADO
                           , :P119_IDDEFEITO                  , vlrvenda                     , :P119_REPRESENTANTEFICOU
                           , null                             , null                         , vcomissao
                           , :P119_QTD_EXGG                   , :P119_ORIGEMDEFEITO          , v('APP_USER'));
                    --
                  elsif viddefeitonovo != viddefeitoanterior then
                    --
                    insert into itensdevolucaorepres ( iditemdevolucaorepres    , iddevolucaorepres      , idestoquefil
                                                     , idproduto                
                                                     , qtd_pp                   , qtd_p                  , qtd_m
                                                     , qtd_g                    , qtd_gg                 , qtd_egg
                                                     , qtd_u                    , estoquedestino         , idpostoavancado
                                                     , iddefeito                , valorproduto           , representanteficou
                                                     , situacaodefeito          , idfechamentoreprespago , comissao
                                                     , qtd_exgg                 , origemdefeito          , usuariomovimentacao)
                    values ( :P119_IDITEMDEVOLUCAOREPRES      , :P119_IDDEVOLUCAOREPRES      , videstoquefil
                           , :P119_IDPRODUTO                  
                           , :P119_QTD_PP                     , :P119_QTD_P                  , :P119_QTD_M
                           , :P119_QTD_G                      , :P119_QTD_GG                 , :P119_QTD_EGG
                           , :P119_QTD_U                      , :P119_ESTOQUEDESTINO         , :P119_IDPOSTOAVANCADO
                           , :P119_IDDEFEITO                  , vlrvenda                     , :P119_REPRESENTANTEFICOU
                           , null                             , null                         , vcomissao
                           , :P119_QTD_EXGG                   , :P119_ORIGEMDEFEITO          , v('APP_USER'));
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 29883824448922899
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

