    validation impede-quantidades-maiores-que (
        name: Impede quantidades maiores que 1000
        execution {
            sequence: 40
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(:P119_QTD_PP) >= 1000
                   or to_number(:P119_QTD_P) >= 1000
                   or to_number(:P119_QTD_M) >= 1000
                   or to_number(:P119_QTD_G) >= 1000
                   or to_number(:P119_QTD_GG) >= 1000
                   or to_number(:P119_QTD_EGG) >= 1000
                   or to_number(:P119_QTD_EXGG) >= 1000
                   or to_number(:P119_QTD_U) >= 1000
                ```
        }
        error {
            errorMessage: Quantidade excessiva! Lançamento não permitido.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
