    pageItem P119_ESTOQUEDESTINO (
        type: radioGroup
        label {
            label: Destino
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao
                    , codigo
                from (select 'Reembalagem' descricao
                           , 'R'  codigo
                           , 1 ordem
                      from dual
                      where pck_romance.fnc_retornaparametro(parametro => 'USAESTOQUEREEMB',pidfilial => :P0_IDFILIAL) = 'S'
                      union
                      select 'Distribuição'
                           , 'D'
                           , 2 
                      from dual
                      union
                      select 'Defeito'
                           , 'F'
                           , 4
                      from dual)
                order by ordem
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @incluir-item
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: ESTOQUEDESTINO
            used: always
        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

