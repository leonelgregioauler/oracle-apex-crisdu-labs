page 643 (
    name: Lista de Notas com Saldo Negativo
    title: Lista de Notas com Saldo Negativo
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region lista-de-notas (
        name: Lista de Notas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                 9646489 - Osiel - Alteração para mostrar notas com saldo negativo também realizado na página 183 que chama esta pagina. 
                */
                select nv.idnotavenda
                     , nv.numeronota
                     , pck_romance.fnc_nomevendedora(nv.idvendedora) consultora
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.valortotalnota
                     , nv.valortotalvendalqd
                     , nv.valorpago
                     , nv.saldo
                from notasvendas nv
                where nv.idrepresentante = :P643_IDREPRESENTANTE
                  and nv.saldo < -1
                  and nv.idsituacaonotavenda = 4
                  /*and exists ( select 1
                               from classificacoesnotasvendas cf
                               where cf.idnotavenda = nv.idnotavenda
                                 and cf.idcaracteristicanotavenda = 47 )*/
                  and ( nv.semanacobranca = :P643_SEMANA
                     or exists ( select 1
                                 from pagamentosnotasvendas pg
                                 where pg.idnotavenda = nv.idnotavenda
                                   and pg.semanacobranca = :P643_SEMANA
                                   and pg.origem = 'R' ) )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma assinatura reprovada.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 7975788450873423198
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: M
            }
        )

        column IDNOTAVENDA (
            type: link
