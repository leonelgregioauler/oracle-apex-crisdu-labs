page 393 (
    name: Consultoras que fizeram login no equipamento
    title: Consultoras que fizeram login no equipamento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 70%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region consultoras-que-fizeram-login-no-equipamento (
        name: Consultoras que fizeram login no equipamento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct ra.device_name tablet
                     , ( select pck_romance.fnc_nomerepresentante(v.idrepresentante)
                         from vendedoras v
                         where v.idvendedora = ra.idvendedora) distribuidor
                     , pck_romance.fnc_nomevendedora(idvendedora) ||' - '|| cpf consultora
                     , datalogin data      
                     , ( select count(1)
                         from registroscompartilhafotos r
                         where r.cpf = ra.cpf ) qtdcompart
                from registrosloginminhasacola ra
                where ra.device_serial = :P393_SERIAL
                  and ra.primeirologin ='S'
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 2749094606073654544
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column DATA (
            type: plainText
            heading {
                heading: Data
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 13
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column QTDCOMPART (
            type: plainText
            heading {
                heading: Fotos Compart.
                alignment: center
            }
            layout {
                sequence: 23
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column TABLET (
            type: plainText
            heading {
                heading: Tablet
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 27491031 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONSULTORA (
                sequence: 3
            )

            displayColumn DATA (
                sequence: 4
            )

            displayColumn DISTRIBUIDOR (
                sequence: 2
            )

            displayColumn QTDCOMPART (
                sequence: 5
            )

            displayColumn TABLET (
                sequence: 1
            )

            sort (
                column: DATA
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            controlBreak (
                column: TABLET
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P393_SERIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @consultoras-que-fizeram-login-no-equipamento
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

