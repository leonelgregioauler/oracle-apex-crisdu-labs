        type: textField
        label {
            label: Complemento
            alignment: left
        }
        layout {
            sequence: 30
            region: @consultar-cep
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P473_CEP
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P473_LOCALIDADE (
        type: textField
        label {
            label: Localidade
            alignment: left
        }
        layout {
            sequence: 50
            region: @consultar-cep
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P473_CEP
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P473_LOGRADOURO (
        type: textField
        label {
            label: Logradouro
            alignment: left
        }
        layout {
            sequence: 20
            region: @consultar-cep
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P473_CEP
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P473_UF (
        type: textField
        label {
            label: UF
            alignment: left
        }
        layout {
            sequence: 60
            region: @consultar-cep
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P473_CEP
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 10
            region: @consultar-cep
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process busca-cep (
        name: Busca CEP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidusuario number;
                  vjson      clob;
                  vjsonobj   json_object_t;
                  vstep      number;
                  vurl       varchar2(500);
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios 
                  where usuario = v('APP_USER');
                  --
                  insert into favorita.consultacep_temp 
                  values ( :P473_CEP
                         , vidusuario
                         , sysdate );
                  --
                  commit;
                  --
                  begin
                    -- Tenta Brasil API primeiro
                    vurl := 'https://brasilapi.com.br/api/cep/v1/'||replace(replace(:P473_CEP,'.',''),'-','');
                    vjson := utl_http.request(vurl);
                    vstep := 1;
                  exception
                    when others then
                      -- Se falhar, tenta cep-promise
                        --
                        vurl := 'https://cep.awesomeapi.com.br/json/'||replace(replace(:P473_CEP,'.',''),'-','');
                        vjson := utl_http.request(vurl);
                        vstep := 2;
                        --
                  end;
                  
                  vjsonobj := json_object_t.parse(vjson);
                  --
                    :P473_CEP         := vjsonobj.get_string('cep');
                    :P473_LOGRADOURO  := vjsonobj.get_string('logradouro');
                    :P473_COMPLEMENTO := vjsonobj.get_string('complemento');
                    :P473_BAIRRO      := vjsonobj.get_string('bairro');
                    :P473_LOCALIDADE  := vjsonobj.get_string('localidade');
                    :P473_UF          := vjsonobj.get_string('uf');
                    --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1531637894674704503
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 473
                items: {
                    P473_CEP: &P473_CEP.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

