            alignment: left
        }
        layout {
            sequence: 10
            region: @consultar-cep
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

