page 639 (
    name: Anexos de Empréstimo
    title: Anexos de Empréstimo
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/wizard-modal-dialog
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P639_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos-de-acordos (
        name: Anexos de Acordos
        type: staticContent
        layout {
            sequence: 10
            slot: wizardBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     --, '<a href="javascript: fnc_verimg('''||iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' 
                     , idemprestimo||idanexoemprestimo||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , dataanexo
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     , '<a href="javascript: fnc_removeanexo('||t.idanexoemprestimo||','''||t.nomearquivo||''');">Remover</a>' remover
                from anexosemprestimos t
                where t.idemprestimo = :P639_IDEMPRESTIMO
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: wizardBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Nenhum arquivo localizado!
        }

        column DATAANEXO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data Anexo
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                sortable: false
            }
        )

        column LINK (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Link
                alignment: center
            }
            layout {
                sequence: 2
            }
            link {
                target: {
                    page: 383
                    items: {
                        P383_ARQUIVO: #LINK#
                    }
                    action: resetPagination
                }
                linkText: Ver Anexo
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column REMOVER (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Usuario
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P639_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            filenameColumn: NOMEARQUIVO
            fileTypes: image/png,image/jpeg,application/pdf
        }
        layout {
            sequence: 50
            region: @anexos-de-acordos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P639_DATAANEXO (
        type: hidden
        layout {
            sequence: 80
            region: @anexos-de-acordos
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATAANEXO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P639_IDANEXODELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @anexos-de-acordos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P639_IDANEXOEMPRESTIMO (
        type: hidden
        layout {
            sequence: 10
            region: @anexos-de-acordos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXOEMPRESTIMO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P639_IDEMPRESTIMO (
        type: displayOnly
        label {
            label: ID Acordo.
            alignment: left
        }
        layout {
            sequence: 20
            region: @anexos-de-acordos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: IDEMPRESTIMO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P639_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @anexos-de-acordos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                begin
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  return vidusuario;
                  --
                end;
                  
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P639_NOMEARQUIVO (
        type: hidden
        layout {
            sequence: 40
            region: @anexos-de-acordos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 10
            region: @anexos-de-acordos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P639_IDANEXOEMPRESTIMO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @anexos-de-acordos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 204
                items: {
                    P204_IDEMPRESTIMO: &P639_IDEMPRESTIMO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation informar-arquivo (
        name: Informar arquivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P639_ARQUIVOTEMP
        }
        error {
            errorMessage: Selecione o arquivo!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_emprestimos(pidemprestimo => :P639_IDEMPRESTIMO);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 232116278132890127
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P639_IDANEXOEMPRESTIMO := null;
                  pck_anexos.prc_apagaanexo_emprestimos(pidanexoemprestimo => :P639_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 232117859631890127
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexosemprestimos (
        name: Fetch Row from ANEXOSEMPRESTIMOS
        type: autoRowFetch
        source {
            tableName: ANEXOSEMPRESTIMOS
            pkColumn: IDANEXOEMPRESTIMO
            pkItem: P639_IDANEXOEMPRESTIMO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 232116608646890127
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P639_IDANEXOEMPRESTIMO is null then
                        select "#OWNER#"."SEQ_IDANEXOEMPRESTIMO".nextval
                          into :P639_IDANEXOEMPRESTIMO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 232117059847890127
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexosemprestimos (
        name: Process Row of ANEXOSEMPRESTIMOS
        type: autoRowProcessing
        target {
            tableName: ANEXOSEMPRESTIMOS
            pkColumn: IDANEXOEMPRESTIMO
            pkItem: P639_IDANEXOEMPRESTIMO
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada
        }
        advanced {
            executionMappingIdentifier: 232117456354890127
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 639
                items: {
                    P639_IDANEXOEMPRESTIMO:
                    P639_IDEMPRESTIMO: &P639_IDEMPRESTIMO.
                    P639_ARQUIVOTEMP:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)

