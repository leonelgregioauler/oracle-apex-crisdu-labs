    region acompanhar-balanço-de-distribuidores-por-região (
        name: Acompanhar Balanço de Distribuidores - Por Região
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(r.idfilial) Empresa
                     , roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) distribuidor
                     , r.ativo
                     , r.iniciouem
                     , r.semana
                     , r.data
                     , nvl(r.saldo_com,0) qtd_com
                     , nvl(r.valor_com,0) valor_com
                     , nvl(r.saldo_sem,0) qtd_sem
                     , nvl(r.valor_sem,0) valor_sem
                     , nvl(r.saldo_com,0) + nvl(r.saldo_sem,0) total
                     , nvl(r.valor_com,0) + nvl(r.valor_sem,0) valortotal
                     , round((nvl(r.valor_sem ,0) + (nvl(r.valor_com,0) * 0.6)),2) valor_sem_40
                     , round((nvl(r.valor_sem ,0) + (nvl(r.valor_com,0) * 0.7)),2) valor_sem_30
                     , media_cobranca
                     , media_cobranca_18s
                     , case
                         when media_cobranca > 0 then
                          round(round((nvl(r.valor_sem,0) + (r.valor_com * 0.6)),2) / media_cobranca) 
                         else
                           0
                       end cobertura_40
                     , case
                         when media_cobranca > 0 then
                          round(round((nvl(r.valor_sem,0) + (r.valor_com * 0.7)),2) / media_cobranca) 
                         else
                           0
                       end cobertura_30
                     , r.atu
                     , pck_romance.fnc_nomeregiaovenda(idregiaovenda) regiaovenda
                     , r.idfilial
                from (  
                       select r.idrepresentante
                            , decode(r.ativo,'S','Ativo','N','Inativo') ativo
                            , r.semanaparou
                            , pck_util.fnc_semanaid(r.idsemanabalanco) semana
                            , r.databalancoiniciado data
                            , com_comissao.qtd saldo_com
                            , sem_comissao.qtd saldo_sem
                            , com_comissao.total valor_com
                            , sem_comissao.total valor_sem
                            , ( select pck_util.fnc_semanaid(min(n.idsemanadistribuicao)) Semana
                                from notasvendas n
                                where idrepresentante  = r.idrepresentante ) iniciouem
                            , pck_balanco_rmc.fnc_mediaultimascobrancas(r.idrepresentante, ( select case when count(idfechamentorepres) > 6 then 6
                                                                                                         else count(idfechamentorepres) end 
                                                                                               from fechamentorepresentantes 
                                                                                              where idrepresentante = r.idrepresentante 
                                                                                                and idregiaovenda = rr.idregiaovenda -- 10610196
                                                                                                and totalgeral > 0) , rr.idregiaovenda) media_cobranca
                            , pck_balanco_rmc.fnc_mediaultimascobrancas(r.idrepresentante, ( select case when count(idfechamentorepres) > 18 then 18 -- 10610196
                                                                                                         else count(idfechamentorepres) end 
                                                                                               from fechamentorepresentantes 
                                                                                              where idrepresentante = r.idrepresentante 
                                                                                                and totalgeral > 0) ) media_cobranca_18S
                            , ( select to_char(max(pr.data),'DD/MM/RRRR HH24:MI:SS') data
                                from roman.pecasrepresentantes pr
                                where pr.idrepresentante = r.idrepresentante )atu
                            , rr.idregiaovenda
                            , g.idfilial
                       from representantes r
                           ,gerentes g
                          , regioesrepresentantes rr
                          , ( select pr.idrepresentante
                                   , sum(pr.quantidade) qtd
                                   , sum(pr.quantidade*pr.valorvenda)  total
                              from vw_pecas_produtos_repres pr
                              where pr.comissao = 'S'
                              group by pr.idrepresentante ) com_comissao
                          , ( select pr.idrepresentante
                                   , sum(pr.quantidade) qtd
                                   , sum(pr.quantidade*pr.valorvenda)  total
                              from vw_pecas_produtos_repres pr
                              where pr.comissao = 'N'
                              group by pr.idrepresentante ) sem_comissao
                          , (select fr.idrepresentante
                                   ,fr.idregiaovenda
                                   , count(fr.idfechamentorepres) qtd_fechamentos
                              from   fechamentorepresentantes fr
                              where  totalgeral > 0
                              group by fr.idrepresentante, fr.idregiaovenda) fechamentos
                       where r.idgerente = g.idgerente
                         and r.idrepresentante = rr.idrepresentante
                         and ( :P0_IDFILIAL = -1 or g.idfilial = :P0_IDFILIAL )
                         and ( :P527_IDREPRESENTANTE = -1 and r.idgerente in ( select idgerente -- se escolher todos representantes, deve filtar apenas representantes de filiais liberadas para o usuario
                                                                                from gerentes g
                                                                               where g.idfilial in (select t.idfilial
                                                                                                      from roman.usuariosfiliais t
                                                                                                     where t.usuario = v('APP_USER')) )
                            or ( :P527_IDREPRESENTANTE > 0 and r.idrepresentante = :P527_IDREPRESENTANTE ) )
                         and r.ativo = 'S'
                         and r.idsemanabalanco >= 762  
                         and not exists ( select 1
                                          from gerentes g
                                          where g.idpessoa = r.idpessoa 
                                            and g.idpessoa not in (36372, 86481) ) -- 13094255
                         and r.idrepresentante = fechamentos.idrepresentante
                         and r.idrepresentante = com_comissao.idrepresentante(+)
                         and r.idrepresentante = sem_comissao.idrepresentante(+)
                         and ( :P527_FECHAMENTOS = 'T' or (fechamentos.qtd_fechamentos >= 7))
                         and r.ativo = 'S'
                         and fechamentos.idregiaovenda = rr.idregiaovenda
                       union all
                       select r.idrepresentante
                            , decode(r.ativo,'S','Ativo','N','Inativo') ativo
                            , r.semanaparou
                            , null semana
                            , null data
                            , 0 saldo_com
                            , 0 saldo_sem
                            , 0 valor_com
                            , 0 valor_sem
                            , ( select pck_util.fnc_semanaid(min(n.idsemanadistribuicao)) Semana
                                from notasvendas n
                                where idrepresentante  = r.idrepresentante ) iniciouem
                            , 0 media_cobranca
                            , 0 media_cobranca_18S
                            , ( select to_char(max(pr.data),'DD/MM/RRRR HH24:MI:SS') data
                                from roman.pecasrepresentantes pr
                                where pr.idrepresentante = r.idrepresentante )atu
                            , rr.idregiaovenda
                            , g.idfilial
                       from representantes r
                          , gerentes g
                          , regioesrepresentantes rr
                          , (select fr.idrepresentante
                                   ,fr.idregiaovenda
                                   , count(fr.idfechamentorepres) qtd_fechamentos
                              from   fechamentorepresentantes fr
                              where  totalgeral > 0
                              group by fr.idrepresentante, fr.idregiaovenda) fechamentos
                       where r.idgerente = g.idgerente
                         and r.idrepresentante = rr.idrepresentante
                         and r.idrepresentante = fechamentos.idrepresentante
                         and ( :P0_IDFILIAL = -1 or g.idfilial = :P0_IDFILIAL )
                         and ( :P527_IDREPRESENTANTE = -1 and r.idgerente in ( select idgerente -- se escolher todos representantes, deve filtar apenas representantes de filiais liberadas para o usuario
                                                                                from gerentes g
                                                                               where g.idfilial in (select t.idfilial
                                                                                                      from roman.usuariosfiliais t
                                                                                                     where t.usuario = v('APP_USER')) )
                            or ( :P527_IDREPRESENTANTE > 0 and r.idrepresentante = :P527_IDREPRESENTANTE ) )
                         and r.ativo = 'S'
                         and ( :P527_FECHAMENTOS = 'T' or (fechamentos.qtd_fechamentos >= 7))
                         and not exists ( select 1
                                          from gerentes g
                                          where g.idpessoa = r.idpessoa 
                                            and g.idpessoa not in (36372, 86481) ) -- 13094255
                         and r.idsemanabalanco < 762 
                         and r.ativo = 'S'
                         and rr.idregiaovenda = fechamentos.idregiaovenda) r
                ```
            pageItemsToSubmit: P527_IDREPRESENTANTE
        }
