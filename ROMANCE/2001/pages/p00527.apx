            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P527_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ' - Todos - ' d
                     , -1 r
                from dual
                union 
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' ('||decode(r.ativo,'S','Ativo','N','Inativo')||')' d 
                     , r.idrepresentante r
                  from representantes r
                     , gerentes g
                 where r.idgerente = g.idgerente
                   and (:P0_IDFILIAL = -1 and g.idfilial in (select t.idfilial
                                                               from roman.usuariosfiliais t
                                                              where t.usuario = v('APP_USER')) -- se escolher todas as empresas, busca apenas as empresas que o usuario tem liberado
                    or (:P0_IDFILIAL <> -1 and g.idfilial = :P0_IDFILIAL ))
                   and r.ativo = 'S'
                 order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P0_IDFILIAL
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: static
            staticValue: -1
        }
        security {
            encryptSessionState: false
        }
    )

