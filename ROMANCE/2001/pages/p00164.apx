page 164 (
    name: Inclui valor Pago
    title: Inclui valor Pago
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 75%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function  confirma(event)
            { 
             var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
              if (tecla==13) 
                {
                if ( document.getElementById("P164_IDPAGTONOTAVENDA").value == '' )
                  {
            	apex.submit('CREATE');
                  }
                if ( document.getElementById("P164_IDPAGTONOTAVENDA").value != '' )
                  {
            	apex.submit('SAVE');
                  }
               }
            }
            
            var htmldb_delete_message='Deseja realmente excluir o pagamento?';
            
            function fnc_valorpago(pid)
            {
               document.getElementById("P164_IDEDITAR").value = pid;
              apex.submit('EDITAR');
            }
            
            function formataMoeda(valor){
              v = valor.value;
              v=v.replace(/\D/g,"") // permite digitar apenas numero
              v=v.replace(/(\d{1})(\d{14})$/,"$1.$2") // coloca ponto antes dos ultimos digitos
              v=v.replace(/(\d{1})(\d{11})$/,"$1.$2") // coloca ponto antes dos ultimos 11 digitos
              v=v.replace(/(\d{1})(\d{8})$/,"$1.$2") // coloca ponto antes dos ultimos 8 digitos
              v=v.replace(/(\d{1})(\d{5})$/,"$1.$2") // coloca ponto antes dos ultimos 5 digitos
              v=v.replace(/(\d{1})(\d{1,2})$/,"$1,$2") // coloca virgula antes dos ultimos 2 digitos
              valor.value = v;
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region aviso (
        name: Aviso
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pagamentos (
        name: Pagamentos
        type: staticContent
