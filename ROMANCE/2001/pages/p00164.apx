    validation p164-valorpago (
        name: P164_VALORPAGO
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_number(:P164_VALORPAGO,'999G999G999G990D00') > 0
                ```
        }
        error {
            errorMessage: O valor deve ser maior que zero!
            associatedItem: @P164_VALORPAGO
        }
        serverSideCondition {
            type: requestIsNotContainedInValue
            value: DELETE, EDITAR
        }
    )

    validation validamaiorquesaldo (
        name: VALIDAMAIORQUESALDO
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vvalorpago       NUMBER;
                  vvalorapagar     NUMBER;
                begin
                  --
                  select SUM(VALORPAGO)
                  into vvalorpago
                  from roman.pagamentosnotasvendas rn
                  where rn.idnotavenda = :P164_IDNOTAVENDA
                    and rn.idpagtonotavenda != nvl(:P164_IDPAGTONOTAVENDA,-1);
                  --
                   vvalorpago := nvl(vvalorpago,0) + TO_NUMBER(:P164_VALORPAGO,'999G999G999G990D00');
                  --
                  select nvl(nv.valortotalvendalqd,0)
                  into vvalorapagar
                  from roman.notasvendas nv
                  where nv.idnotavenda = :P164_IDNOTAVENDA;
                  --
                  if (vvalorpago > vvalorapagar) then
                     Return ('Valor pago maior que valor devido.');
                  end if;
                  --
                end;
                ```
        }
    )

    process atualiza-nota (
        name: atualiza nota
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidfechamento     number;
                  vidfechamentorep  number;
                  vidluc            number;
                  vteste            number;
                  vidrepresentante  number;
                  vidfilial         number;
                begin
                  --
                  pck_romance.prc_atualizanotavenda( :P164_IDNOTAVENDA );
                  --
                  BEGIN
                  select idrepresentante, idfilial
                  into vidrepresentante, vidfilial
                  from notasvendas
                  where idnotavenda = :P164_IDNOTAVENDA;
                  --
                  exception
                    when NO_DATA_FOUND then
                      RAISE_APPLICATION_ERROR(-20001,'Não encontou a nota');
                  END;
                  --
                  begin
                    --
                    select idfechamento, f.idfechamentorepres
                    into vidfechamento, vidfechamentorep
                    from fechamentorepresentantes f
                    where idrepresentante = vidrepresentante
                      and idfechamento    = ( select idfechamento 
                                              from fechamentossemanais ff
                                              where ff.idfilial = f.idfilial
                                                and ff.semana   = :P164_SEMANAACERTO );
                    --
                    pck_acertosfechamento.prc_buscacobranca( vidfechamentorep );
                    --
                    pck_acertosfechamento.prc_atualiza_acerto ( vidfechamentorep );
                    --
                    pck_acertosfechamento.prc_atualiza_gavetas ( vidfechamento );
                    --
                  exception
                    when others then
                      null;
                  end;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 319459474508387835
        }
    )

    process fetch-row-from-pagamentosnotasvendas (
        name: Fetch Row from PAGAMENTOSNOTASVENDAS
        type: autoRowFetch
        source {
            tableName: PAGAMENTOSNOTASVENDAS
            pkColumn: IDPAGTONOTAVENDA
            pkItem: P164_IDPAGTONOTAVENDA
        }
        execution {
            sequence: 60
