            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item!=value
            item: P164_EDICAOBLOQUEADA
            value: S
        }
    )

    region pagamentos-efetuados (
        name: Pagamentos Efetuados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idpagtonotavenda
                     , case
                         when exists ( select 1 
                                       from fechamentossemanais f
                                       where f.idfilial = :P0_IDFILIAL
                                         and f.semana   = t.semanacobranca 
                                         and f.concluido = 'N') then
                           '<a href="javascript:fnc_valorpago('|| t.idpagtonotavenda ||')" ><img src="/i/menu/pencil16x16.gif"  border="0"></a>' 
                         else 
                           'Fechamento deste pagamento está Concluído!'
                       end Editar
                     , datapagamento
                     , valorpago
                     , t.semanacobranca
                     , case
                         when t.origem = 'C' then
                           'Origem Cobrança: '||t.observacao
                         when t.origem = 'D' then
                           'Origem Deb. Romance: '||t.observacao
                         when t.origem = 'G' then
                           'Origem PAP: '||t.observacao
                         when t.origem = 'O' then
                           'Origem Cobraki: '||t.observacao
                         when t.origem = 'R' then
                           'Filial ou Distribuidor'
                         when t.origem = 'E' then
                           'E-commerce'
                         else
                           '-'
                       end origem
                from pagamentosnotasvendas t
                /*  and IDFECHAMENTOREPRES is null
                union
                select '' Editar
                     , idpagtonotavenda
                     , datapagamento
                     , valorpago
                     , t.semanacobranca
                from pagamentosnotasvendas t
                where idnotavenda = :P164_IDNOTAVENDA
                  and IDFECHAMENTOREPRES is not null*/
                  where idnotavenda = :P164_IDNOTAVENDA
                  and origem != 'P'
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum pagamento efetuado.
        }
        componentAdvanced {
            stripHtml: true
        }

        column DATAPAGAMENTO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data Pgto
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
        )

        column EDITAR (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 2
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from dual 
                    where  ( select 1
                              from roman.notasvendas rn
                              where rn.idnotavenda = :P37_IDNOTAVENDA 
                                and nvl(rn.ENVIADOCOBRANCA,'N') = 'N'
                                and rn.IDSITUACAONOTAVENDA = 4
                                and not exists ( select 1
                                                 from roman.itensnotavenda i
                                                 where i.idnotavenda = rn.IDNOTAVENDA  
                                                   and i.qtddevolvida is null)
                                and not exists (select 1 
                                                from usuarios 
                                                where usuario = v('APP_USER')
                                                and idgerente = 80) ) = 1
                    union
                    select 1
                    from dual
                    where v('APP_USER') = 'BRUNOB'
                    
                    ```
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDPAGTONOTAVENDA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column ORIGEM (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Origem
                alignment: center
            }
            layout {
                sequence: 6
            }
        )

        column SEMANACOBRANCA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Semana Acerto
