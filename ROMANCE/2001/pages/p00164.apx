    pageItem P164_SEMANAACERTO (
        type: selectList
        label {
            label: Acerto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value
                     , return_value
                from (select p.semanacobranca display_value
                           , p.semanacobranca return_value
                           , p.idpagtonotavenda ordem
                      from pagamentosnotasvendas p
                      where p.idpagtonotavenda = :P164_IDPAGTONOTAVENDA                                                                                                        
                      union
                      select trim(semana)  display_value
                           , trim(semana)  return_value
                           , f.idfechamento ordem
                      from fechamentossemanais f
                      where idfilial = :P0_IDFILIAL
                        and concluido = 'N'
                        and :P164_IDPAGTONOTAVENDA is null)
                order by ordem desc
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @pagamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: SEMANACOBRANCA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                vsemana varchar2(100);
                begin
                select display_value
                into vsemana
                from (
                        select trim(semana)  display_value
                             , trim(semana)  return_value
                        from fechamentossemanais
                        where idfilial = :P0_IDFILIAL
                        order by idfechamento desc)
                where rownum = 1;
                  return vsemana;
                end;
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where ( ( select 1
                          from roman.notasvendas rn
                          where rn.idnotavenda = :P37_IDNOTAVENDA 
                            and nvl(rn.ENVIADOCOBRANCA,'N') = 'N'
                            and rn.IDSITUACAONOTAVENDA = 4
                            and not exists ( select 1
                                             from roman.itensnotavenda i
                                             where i.idnotavenda = rn.IDNOTAVENDA  
                                               and i.qtddevolvida is null)
                            and not exists (select 1 
                                            from usuarios 
                                            where usuario = v('APP_USER')
                                            and idgerente = 80) ) = 1
                 or (  pck_util.fnc_verificaacesso(2344,v('APP_USER')) = 'S' ))
                 and :P164_IDPAGTONOTAVENDA is NULL
                ```
        }
        security {
            encryptSessionState: false
        }
    )

