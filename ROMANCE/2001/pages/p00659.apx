page 659 (
    name: Notas em aberto com Ass. Reprovada
    title: Notas em aberto com Ass. Reprovada
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region notas-aguardando-acerto-com-ass (
        name: Notas aguardando acerto com Ass
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomevendedora (nv.idvendedora) nome
                     , roman.pck_romance.fnc_cpfvendedora (nv.idvendedora) CPF
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda ,'SESSION')||''',''_blank''); void(0)">'||nv.numeronota||'</a>' AS nota
                     , nv.valortotalnota
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.semanacobrancaorig
                     , nv.distribuidor 
                     , nv.enderecoprincipal
                     , nv.numero
                     , nv.bairro
                     , nv.cidade cidade
                     , nv.complemento
                     , nv.telefones
                  from ( select distinct(n.idnotavenda) notas_qtd
                              , n.idvendedora
                              , n.numeronota 
                              , n.valortotalnota
                              , n.semanadistribuicao
                              , n.semanacobranca
                              , n.semanacobrancaorig
                              , roman.pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                              , p.enderecoprincipal
                              , p.numero
                              , p.bairro
                              , roman.pck_romance.fnc_nomecidade (p.idcidade) cidade
                              , p.complemento
                              , roman.pck_romance.fnc_retornatelefones (p.idpessoa) telefones
                              , n.idnotavenda
                           from roman.notasvendas n
                              , roman.vw_assinaturas_eletronicas a
                              , catal.gerentes g
                              , catal.representantes r
                              , catal.pessoas p
                              , catal.vendedoras v
                         where n.idnotavenda = a.idnotavenda
                           and n.idfilial = g.idfilial
                           and n.idrepresentante = r.idrepresentante
                           and v.idpessoa = p.idpessoa
                           and v.idvendedora = n.idvendedora
                           and a.situacao = 'R'
                           and n.idsituacaonotavenda = 3
                           and not exists ( select 1
                                              from roman.assinaturaseletronicas aa
                                             where aa.idnotavenda = n.idnotavenda
                                               and aa.situacao = 'A')
                           and r.idrepresentante  = :P659_DISTRIBUIDOR
                           and (:P659_DATAINI is null or trunc(n.datanota) between to_date(:P659_DATAINI,'dd/mm/rrrr') and to_date(:P659_DATAFIM, 'dd/mm/rrrr'))) nv
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 98897460140134004
        }

