    region pagamento-de-comissões (
        name: Pagamento de Comissões
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idpedido 
                     , nrpedido
                     , (select case when p.tipopedido = 'P' then 'Pedido'
                                    when p.tipopedido = 'T' then 'Troca'
                                    when p.tipopedido = 'V' then 'Venda Direta'
                                    when p.tipopedido = 'R' then 'Romance Casa'
                                    else p.tipopedido end
                          from favorita.pedidos p where p.idpedido = t.idpedido) as "Tipo Pedido"  -- 9986405 - Maicon Aimi - 20/06/2025
                     , vendedora
                     , datavencimento
                     , valorcobrado
                     --, comissao
                    -- , to_number(to_char(comissao,'999G999G999G999G999G990D00')) comissao
                     , to_number(to_char(comissao,'9999999990D00')) comissao
                     --, comissaogerente
                     --, to_number(to_char(comissaogerente,'999G999G999G999G999G990D00')) comissaogerente
                     , to_number(to_char(comissaogerente,'9999999990D00')) comissaogerente
                     --, idfechamentorepres
                     , idrepresentante
                     , databaixa
                     , pck_romance.fnc_nomerepresentante(idrepresentante) Representante
                     , 'Distribuidor' tipocomissao
                     , null origem
                     , null emissao
                     , null idpagamentopedido
                     , null idvencimentopedido
                     , cast(null as number) percinad
                     , cast(null as number) comissaofixa
                     , cast(null as number) comissaobonus
                from vw_comissoes_pagar t
                where idrepresentante = :P180_IDREPRESENTANTE
                  and :P180_IDREPRESENTANTE is not null
                  and t.idfilial = :P0_IDFILIAL
                  and t.comissao > 0
                  and not exists ( select 1 
                                   from pagamentocomissoes pp
                                   where pp.idpedido  = t.idpedido 
                                     and pp.idrepresentante is not null)
                union
                select idpedido
                     , nrpedido
                     , (select case when p.tipopedido = 'P' then 'Pedido'
                                    when p.tipopedido = 'T' then 'Troca'
                                    when p.tipopedido = 'V' then 'Venda Direta'
                                    when p.tipopedido = 'R' then 'Romance Casa'
                                    else p.tipopedido end
                          from favorita.pedidos p where p.idpedido = t.idpedido) as "Tipo Pedido"  -- 9986405 - Maicon Aimi - 20/06/2025
                     , vendedora
                     , datavencimento
                     , valorcobrado
                     --, comissao
                    -- , to_number(to_char(comissao,'999G999G999G999G999G990D00')) comissao
                     , to_number(to_char(comissao,'9999999990D00')) comissao
                     --, comissaogerente
                     --, to_number(to_char(comissaogerente,'999G999G999G999G999G990D00')) comissaogerente
                     , to_number(to_char(comissaogerente,'9999999990D00')) comissaogerente
                   --  , idfechamentorepres
                     , idrepresentante
                     , databaixa
                     , pck_romance.fnc_nomerepresentante(idrepresentante) Representante
                     , 'Gerente' tipocomissao
                     , null origem
                     , null emissao
                     , null idpagamentopedido
                     , null idvencimentopedido
                     , cast(null as number) percinad
                     , to_number(to_char(comissaogerente,'9999999990D00')) comissaofixa
                     , 0 comissaobonus
                from vw_comissoes_pagar t
                where idgerente = :P180_IDGERENTE
                  and :P180_IDGERENTE is not null
                  and t.idfilial = :P0_IDFILIAL
                  and t.comissaogerente > 0
                  and not exists ( select 1 
                                   from pagamentocomissoes pp
                                   where pp.idpedido  = t.idpedido 
                                     and pp.idgerente is not null)
                union-------------sistema novo
                select DISTINCT idpedido 
                     , numeropedido nrpedido
                     , (select case when p.tipopedido = 'P' then 'Pedido'
                                    when p.tipopedido = 'T' then 'Troca'
                                    when p.tipopedido = 'V' then 'Venda Direta'
                                    when p.tipopedido = 'R' then 'Romance Casa'
                                    else p.tipopedido end
                          from favorita.pedidos p where p.idpedido = tf.idpedido) as "Tipo Pedido"  -- 9986405 - Maicon Aimi - 20/06/2025
                     , vendedora
                     , datavencimentomenor datavencimento
                     , tf.valorapagar valorcobrado
                     --, nvl(tf.comissaodistribuidor,0) comissao
                     --, to_number(to_char(tf.comissaodistribuidor,'999G999G999G999G999G990D00')) comissao
                     , to_number(to_char(tf.comissaodistribuidor,'9999999990D00')) comissao
                     --, comissaogerente
                     --, to_number(to_char(tf.comissaogerente,'999G999G999G999G999G990D00')) comissaogerente
                     , to_number(to_char(tf.comissaogerente,'9999999990D00')) comissaogerente
                   --  , idfechamentorepres
                     , idrepresentante
                     , databaixa
                     , Representante
                     , 'Distribuidor' tipocomissao
                     , tf.filialfavorita origem
                     , tf.emissao
                     , tf.idpagamentopedido
                     , tf.idvencimentopedido
                     , cast(null as number) percinad
                     , cast(null as number) comissaofixa
                     , cast(null as number) comissaobonus
                from favorita.VW_COMISSOESPAGAR_NOVA_M tf
                where idrepresentante = :P180_IDREPRESENTANTE
                  and :P180_IDREPRESENTANTE is not null
                  and tf.idfilialromance = :P0_IDFILIAL
                  and tf.comissaodistribuidor > 0
                  and exists ( select 1
                               from controlepgtocomissoesped cp
                               where cp.idpedido = tf.idpedido
                                 and cp.fechado_repres = 'N' )
                  and not exists ( select 1 
                                   from pagamentocomissoes pp
                                   where pp.idpedido  = tf.idpedido 
                                     and pp.idrepresentante is not null
                                     and pp.idvencimentopedido = tf.idvencimentopedido)
                union
                select distinct idpedido
                     , numeropedido nrpedido
                     , (select case when p.tipopedido = 'P' then 'Pedido'
                                    when p.tipopedido = 'T' then 'Troca'
                                    when p.tipopedido = 'V' then 'Venda Direta'
                                    when p.tipopedido = 'R' then 'Romance Casa'
                                    else p.tipopedido end
                          from favorita.pedidos p where p.idpedido = tf.idpedido) as "Tipo Pedido"  -- 9986405 - Maicon Aimi - 20/06/2025
                     , vendedora
                     , datavencimentomenor datavencimento
                     , valorapagar valorcobrado
                     --, tf.comissaodistribuidor comissao
                    --, to_number(to_char(tf.comissaodistribuidor ,'999G999G999G999G999G990D00')) comissao
                    , to_number(to_char(tf.comissaodistribuidor ,'9999999990D00')) comissao
                     --, comissaogerente
                    --, to_number(to_char(tf.comissaogerente ,'999G999G999G999G999G990D00')) comissaogerente
                    --, to_number(to_char(tf.comissaogerente ,'9999999990D00')) comissaogerente
                    -- Bônus Adimplência: comissão do gestor + bônus da parcela (mesma regra do pagamento; pago na mesma linha)
                    , to_number(to_char(tf.comissaogerente
                                      + pck_comger_bonus.fnc_bonus_pendente(tf.idvencimentopedido, tf.idgerente) ,'9999999990D00')) comissaogerente
                   --  , idfechamentorepres
                     , idrepresentante
                     , databaixa
                     , gerente
                     , 'Gerente' tipocomissao
                     , tf.filialfavorita origem
                     , tf.emissao
                     , tf.idpagamentopedido
                     , tf.idvencimentopedido
                     -- Bônus Adimplência: composição da comissão do gestor (só exibição)
                     , pck_comger_bonus.fnc_inad_pendente(tf.idvencimentopedido, tf.idgerente) percinad
                     , to_number(to_char(tf.comissaogerente ,'9999999990D00')) comissaofixa
                     , to_number(to_char(pck_comger_bonus.fnc_bonus_pendente(tf.idvencimentopedido, tf.idgerente) ,'9999999990D00')) comissaobonus
                from favorita.VW_COMISSOESPAGAR_NOVA_M tf
                where idgerente = :P180_IDGERENTE
                  and :P180_IDGERENTE is not null
                  and tf.idfilialromance = :P0_IDFILIAL
                  and comissaogerente > 0
                  and exists ( select 1
                               from controlepgtocomissoesped cp
                               where cp.idpedido = tf.idpedido
                                 and cp.fechado_gerente = 'N' )
                  and not exists ( select 1 
                                   from pagamentocomissoes pp
                                   where pp.idpedido  = tf.idpedido 
                                     and pp.idvencimentopedido = tf.idvencimentopedido
                                     and pp.idgerente is not null)
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: onClick="javascript:somavalor();"
        }
        reportLayout {
            numberOfRows: 150
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum pedido quitado pendente de acerto.
        }
        componentAdvanced {
            stripHtml: true
        }

