    process atualiza-acerto-após-pagar-comissões (
        name: Atualiza Acerto Após Pagar Comissões
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidfechamento number;
                  --
                begin
                  --
                  pck_acertosfechamento.prc_buscacobranca( :P180_IDFECHAMENTOREPRES );
                  pck_acertosfechamento.prc_atualiza_acerto ( :P180_IDFECHAMENTOREPRES );
                  --
                  select idfechamento
                  into vidfechamento
                  from FECHAMENTOREPRESENTANTES
                  where idfechamentorepres = :P180_IDFECHAMENTOREPRES;
                  --
                  pck_acertosfechamento.prc_atualiza_gavetas ( vidfechamento );
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 819499551998729146
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('PGTOGESTOR','PGTODISTRIBUIDOR','SUBMIT')
        }
    )

    process pagar-gerente (
        name: Pagar Gerente
        type: executeCode
        editableRegion: @pagamento-de-comissões
        source {
            plsqlCode:
                ```plsql
                declare
                  verro varchar2(2000); 
                  vtipo varchar2(1);
                  vvalorpago number(15,2);
                  vidfechamento number;
                begin
                  --
                  begin
                    select tipopedido
                    into vtipo
                    from favorita.pedidos p
                    where p.idpedido = :IDPEDIDO;
                  exception
                    when others then
                      vtipo := null;
                  end;
                  --
                  if :IDPEDIDO < 3000000 then
                    --
                    insert into pagamentocomissoes ( idpgtocomissao   , idrepresentante    , datapagamento
                                                   , valorpago        , idgerente          , fechamento
                                                   , conferido        , idfechamentorepres , idpedido )
                    select seq_idpgtocomissao.nextval , null                     , sysdate
                           , p.comissaogerente        , p.idgerente              , :P180_FECHAMENTO
                           , null                     , :P180_IDFECHAMENTOREPRES , p.IDPEDIDO
                    from vw_comissoes_pagar p
                    where idpedido = :IDPEDIDO
                      and not exists ( select 1 
                                       from pagamentocomissoes pp
                                       where pp.idpedido  = p.idpedido 
                                         and pp.idgerente is not null );
                    --
                  elsif vtipo in ('P','R','T') then
                    --
                    insert into pagamentocomissoes ( idpgtocomissao   , idrepresentante    , datapagamento
                                                   , valorpago        , idgerente          , fechamento
                                                   , conferido        , idfechamentorepres , idpedido
                                                   , idpagamentopedido, idvencimentopedido )
                    select seq_idpgtocomissao.nextval , null                     , sysdate
                           , p.comissaogerente        , p.idgerente              , :P180_FECHAMENTO
                           , null                     , :P180_IDFECHAMENTOREPRES , p.IDPEDIDO
                           , p.idpagamentopedido      , :IDVENCIMENTOPEDIDO
                    from favorita.VW_COMISSOESPAGAR_NOVA_M p
                    where idpedido = :IDPEDIDO
                      and idvencimentopedido = :IDVENCIMENTOPEDIDO
                      and not exists ( select 1 
                                       from pagamentocomissoes pp
                                       where pp.idpedido  = p.idpedido 
                                         and pp.idvencimentopedido = p.idvencimentopedido
                                         and pp.idgerente is not null );
                    --
                  elsif vtipo = 'V' then
                    --
                    insert into pagamentocomissoes ( idpgtocomissao   , idrepresentante    , datapagamento
                                                   , valorpago        , idgerente          , fechamento
                                                   , conferido        , idfechamentorepres , idpedido )
                    select seq_idpgtocomissao.nextval , null                     , sysdate
                           , p.valoraabater           , p.idgerente              , :P180_FECHAMENTO
                           , null                     , :P180_IDFECHAMENTOREPRES , p.IDPEDIDO
                    from favorita.vw_comissoes_descontar_fav p
                    where idpedido = :IDPEDIDO;
                    --
                    select p.valorapagar
                    into vvalorpago
                    from favorita.vw_comissoes_descontar_fav p
                    where p.idpedido = :IDPEDIDO;
                    --
                    update favorita.pagamentospedidos p
                    set p.valorpago = vvalorpago
                      , p.databaixa = trunc(sysdate)
                      , p.datapagamento = trunc(sysdate)
                    where exists ( select 1
                                   from favorita.vencimentospedidos v
                                   where v.idpedido = :IDPEDIDO
                                     and v.idvencimentopedido = p.idvencimentopedido 
                                     and v.situacaovencimento = 'V' )
                      and p.idformapagamento = 9;
                    --
                  end if;
                  --
                /*exception
                  when others then
                    verro := sqlerrm;
                    insert into teste values ('erro comissão favorita',verro||'-'||:VALORCOMISSAO||'-'|| :IDREPRESENTANTE||' - '||:IDPEDIDO );*/
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Pagamento efetuado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 206995373362301337
        }
        serverSideCondition {
            whenButtonPressed: @submit
            type: itemIsNotNull
            item: P180_IDGERENTE
        }
    )

    process pagar-representante (
        name: Pagar Representante
        type: executeCode
        editableRegion: @pagamento-de-comissões
        source {
            plsqlCode:
                ```plsql
                declare
                  verro varchar2(2000); 
                  vtipo varchar2(1);
                begin
                  --
                  begin
                    select tipopedido
                    into vtipo
                    from favorita.pedidos p
                    where p.idpedido = :IDPEDIDO;
                  exception
                    when others then
                      vtipo := null;
                  end;
                  --
                  if :IDPEDIDO < 3000000 then
                    --
                    insert into pagamentocomissoes ( idpgtocomissao   , idrepresentante    , datapagamento
                                                   , valorpago        , idgerente          , fechamento
                                                   , conferido        , idfechamentorepres , idpedido )
                    select seq_idpgtocomissao.nextval , p.IDREPRESENTANTE        , sysdate
                           , p.COMISSAO               , null                     , :P180_FECHAMENTO
                           , null                     , :P180_IDFECHAMENTOREPRES , p.IDPEDIDO
                    from vw_comissoes_pagar p
                    where idpedido = :IDPEDIDO;
                    --
                  elsif vtipo in ('P','R','T') then
                    --
                    insert into pagamentocomissoes ( idpgtocomissao   , idrepresentante    , datapagamento
                                                   , valorpago        , idgerente          , fechamento
                                                   , conferido        , idfechamentorepres , idpedido
                                                   , idpagamentopedido , tipopedido )
                    select seq_idpgtocomissao.nextval , p.IDREPRESENTANTE        , sysdate
                           , p.comissaodistribuidor   , null                     , :P180_FECHAMENTO
                           , null                     , :P180_IDFECHAMENTOREPRES , p.IDPEDIDO
                           , p.idpagamentopedido      , p.tipopedido 
                    from favorita.VW_COMISSOESPAGAR_NOVA_M p
                    where idpedido = :IDPEDIDO
                      and p.idvencimentopedido = :IDVENCIMENTOPEDIDO
                      and exists ( select 1
                                   from controlepgtocomissoesped cp
                                   where cp.idpedido = p.idpedido
                                     and cp.fechado_repres = 'N' )
                      and not exists ( select 1 
                                       from pagamentocomissoes pp
                                       where pp.idpedido  = p.idpedido 
                                         and pp.idvencimentopedido = p.idvencimentopedido
                                         and pp.idrepresentante is not null );
                    --
                  end if;
                /*exception
                  when others then
                    verro := sqlerrm;
                    insert into teste values ('erro comissão favorita',verro||'-'||:VALORCOMISSAO||'-'|| :IDREPRESENTANTE||' - '||:IDPEDIDO );*/
                end;
                
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Pagamento efetuado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 206994994982301336
        }
        serverSideCondition {
            whenButtonPressed: @submit
            type: itemIsNull
            item: P180_IDGERENTE
        }
    )

