    pageItem P180_VALORDESCONTOG (
        type: displayOnly
        label {
            label: Total Desconto(-)
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 80
            region: @pagamento-de-comissões
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(nvl( ( select sum(valorapagar-valorcomissaodistribuidor-valorcomissaogerente)*-1
                                      from favorita.vw_comissoes_descontar_fav tf
                                      where idgerente = :P180_IDGERENTE
                                        and not exists ( select 1 
                                                         from pagamentocomissoes pp
                                                         where pp.idpedido  = tf.idpedido 
                                                           and pp.idgerente is not null)
                                        and pck_util.fnc_idsemanadata(trunc(sysdate)) = pck_util.fnc_idsemanadata(tf.datavencimentomenor) ),0),'999G999G999G990D00') valor
                from dual
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0,00
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

