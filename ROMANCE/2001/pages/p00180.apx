    title: Pagamento de Comissões
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            /*function somavalor() {
               var theForm = document.wwv_flow;
               var vTemp = 0;
               var vNum = 0;
                
               for(i=0;i<theForm.f01.length;i++){
                    if(theForm.f01[i].checked){
                        vNum = $(theForm.f07[i]).val();
                        vNum = vNum.replace(',','.');
                        vTemp = parseFloat(vTemp) + parseFloat(vNum);
                    }
               }
                
              document.getElementById('P180_VALORSELECIONADO').value = vTemp;
            }*/
            
            function somavalor() {
               var theForm = document.wwv_flow;
               var vTemp = 0;
               var vNum = 0;
                
               for (i = 0; i < theForm.f01.length; i++) {
                    if (theForm.f01[i].checked) {
                        vNum = $(theForm.f07[i]).val();
                        vNum = vNum.replace(',', '.');
                        vTemp = parseFloat(vTemp) + parseFloat(vNum);
                    }
               }
            
               // Arredondar o resultado para 2 casas decimais
               vTemp = parseFloat(vTemp.toFixed(2));
                
               document.getElementById('P180_VALORSELECIONADO').value = vTemp;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

