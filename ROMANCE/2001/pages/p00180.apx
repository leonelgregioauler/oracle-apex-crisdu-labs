    pageItem P180_VALORTOTAL (
        type: displayOnly
        label {
            label: Valor Total(+)
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 60
            region: @pagamento-de-comissões
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char((nvl( (select sum(comissaogerente)
                                  from vw_comissoes_pagar t
                                  where idgerente = :P180_IDGERENTE
                                    and not exists ( select 1 
                                                     from pagamentocomissoes pp
                                                     where pp.idpedido  = t.idpedido 
                                                       and pp.idgerente is not null) ) ,0)
                        -- Bônus Adimplência: soma o bônus pendente de cada parcela
                        + nvl( ( select sum(tf.comissaogerente + pck_comger_bonus.fnc_bonus_pendente(tf.idvencimentopedido, tf.idgerente))
                                 from favorita.VW_COMISSOESPAGAR_NOVA_M tf
                                 where tf.idgerente = :P180_IDGERENTE
                                   and exists ( select 1
                                                from controlepgtocomissoesped tt
                                                where tt.idpedido = tf.idpedido
                                                  and tt.fechado_gerente = 'N' )
                                   and not exists ( select 1 
                                                    from pagamentocomissoes pp
                                                    where pp.idpedido  = tf.idpedido 
                                                      and pp.idvencimentopedido = tf.idvencimentopedido
                                                      and pp.idgerente is not null) ),0)),'999G999G999G990D00') valor
                from dual
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0,00
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P180_IDGERENTE
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P180_VALORTOTALG (
        type: displayOnly
        label {
            label: Total(=)
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 90
            region: @pagamento-de-comissões
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char((nvl( ( select sum(comissaogerente)
                                       from favorita.VW_COMISSOESPAGAR_NOVA_M tf
                                       where idgerente = :P180_IDGERENTE
                                         and exists ( select 1
                                                      from controlepgtocomissoesped tt
                                                      where tt.idpedido = tf.idpedido
                                                        and tt.fechado_gerente = 'N' )
                                         and not exists ( select 1 
                                                          from pagamentocomissoes pp
                                                          where pp.idpedido  = tf.idpedido 
                                                            and pp.idvencimentopedido = tf.idvencimentopedido
                                                            and pp.idgerente is not null) ) ,0)
                        + nvl( (select sum(comissaogerente)
                                  from vw_comissoes_pagar t
                                  where idgerente = :P180_IDGERENTE
                                    and not exists ( select 1 
                                                     from pagamentocomissoes pp
                                                     where pp.idpedido  = t.idpedido 
                                                       and pp.idgerente is not null) ) ,0) 
                    /*    + nvl( ( select sum(valorapagar-valorcomissaodistribuidor-valorcomissaogerente)*-1
                                 from favorita.vw_comissoes_descontar_fav tf
                                 where idgerente = :P180_IDGERENTE
                                   and pck_util.fnc_idsemanadata(trunc(sysdate)) = pck_util.fnc_idsemanadata(tf.datavencimentomenor)
                                   and not exists ( select 1 
                                                    from pagamentocomissoes pp
                                                    where pp.idpedido  = tf.idpedido 
                                                      and pp.idgerente is not null) )  ,0)  */
                             
                               ) ,'999G999G999G990D00') valor
                from dual
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0,00
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P180_VALORTOTALR (
        type: displayOnly
        label {
            label: Valor Total (+)
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 110
            region: @pagamento-de-comissões
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char((nvl( (select sum(t.comissao)
                                  from vw_comissoes_pagar t
                                  where idrepresentante = :P180_IDREPRESENTANTE
                                    and t.comissao > 0
                                    and not exists ( select 1 
                                                     from pagamentocomissoes pp
                                                     where pp.idpedido  = t.idpedido 
                                                       and pp.idrepresentante is not null) ) ,0)
                        + nvl( ( select sum(tf.comissaodistribuidor)
                                 from favorita.VW_COMISSOESPAGAR_NOVA_M tf
                                  where idrepresentante = :P180_IDREPRESENTANTE
                                   and tf.comissaodistribuidor > 0
                                   and exists ( select 1
                                                from controlepgtocomissoesped cp
                                                where cp.idpedido = tf.idpedido
                                                  and cp.fechado_repres = 'N' )
                                   and not exists ( select 1 
                                                    from pagamentocomissoes pp
                                                    where pp.idpedido  = tf.idpedido 
                                                      and pp.idvencimentopedido = tf.idvencimentopedido
                                                      and pp.idrepresentante is not null) ),0)),'999G999G999G990D00') comissaodistribuidor
                from dual
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0,00
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P180_IDREPRESENTANTE
        }
        security {
            encryptSessionState: false
        }
    )

