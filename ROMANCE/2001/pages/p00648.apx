page 648 (
    name: Perdas - Sinalizar Débitos
    title: Perdas - Sinalizar Débitos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region nova-perda (
        name: Nova Perda
        type: list
        source {
            list: @nova-perda
        }
        layout {
            sequence: 40
            slot: dialogHeader
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    region sinalizar-débitos (
        name: Sinalizar Débitos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select id
                     , tipo
                     , numeronota 
                     , consultora
                     , cpf
                     , datanota
                     , dataacerto
                     , semanadistribuicao
                     , semanacobranca
                     , valortotalnota
                     , valortotalvendalqd
                     , valorpago
                     , saldo
                     , idvendedora
                from vw_debitos_perdas_detalhado w
                where idrepresentante = :P648_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Nenhum débito encontrado
        }

        column CHECK$01 (
            reportColumnQueryId: 15
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
        )

        column CONSULTORA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column CPF (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Cpf
                alignment: center
            }
            layout {
                sequence: 6
            }
        )

        column DATAACERTO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Vencimento
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
        )

        column DATANOTA (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
        )

        column IDVENDEDORA (
            reportColumnQueryId: 14
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 15
            }
        )

        column NUMERONOTA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Nr Nota/Pedido
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column SALDO (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Saldo
                alignment: center
            }
            layout {
                sequence: 14
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column SEMANACOBRANCA (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Cobrança
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
        )

        column SEMANADISTRIBUICAO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Distribuição
                alignment: center
            }
            layout {
                sequence: 9
                columnAlignment: center
            }
        )

        column TIPO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column VALORPAGO (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 13
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column VALORTOTALNOTA (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Total
                alignment: center
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column VALORTOTALVENDALQD (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Total Venda
                alignment: center
            }
            layout {
                sequence: 12
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

    )

    pageItem P648_IDNEGOCIACAO (
        type: displayOnly
        label {
            label: ID Neg,
            alignment: left
        }
        layout {
            sequence: 10
            region: @sinalizar-débitos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vidnegociacao number;
                begin
                  --
                  select max(idnegociacaoparceiro)
                  into vidnegociacao
                  from negociacoesparceiros np
                  where np.origem = 'P'
                    and np.idrepresentante = :P648_IDREPRESENTANTE
                    and np.formapagamento is null;
                  --
                  return vidnegociacao;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P648_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @sinalizar-débitos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button sinalizar (
        buttonName: SINALIZAR
        label: Sinalizar
        layout {
            sequence: 10
            region: @sinalizar-débitos
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    process sinaliza-documentos (
        name: Sinaliza Documentos
        type: executeCode
        editableRegion: @sinalizar-débitos
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  cursor c1 (vid number) is
                    select *
                    from vw_debitos_perdas_detalhado w
                    where w.id = vid;
                  --
                  r1 c1%rowtype;
                  --
                begin
                  -- 
                  open c1(:ID);
                  fetch c1 into r1;
                  close c1;
                  --
                  --raise_application_error(-20001,:P648_IDNEGOCIACAO||' - '||:ID||' CPF- '||r1.cpf||' TipoDOc- '||r1.tipo);
                  --
                  pck_negociacoes_rmc.prc_sinalizadocumentoperda(pidnegociacaoparceiro => :P648_IDNEGOCIACAO,
                                                                 pid => r1.id,
                                                                 ptipodocumento => r1.tipo,
                                                                 pnumero => r1.NUMERONOTA,
                                                                 pcpf => r1.CPF,
                                                                 pidrepresentante => :P648_IDREPRESENTANTE,
                                                                 pidvendedora => r1.IDVENDEDORA,
                                                                 pvalor => r1.SALDO);
                  --
                  commit;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Débitos Sinalizados
        }
        advanced {
            executionMappingIdentifier: 32786887527319210
        }
        serverSideCondition {
            type: request=Value
            value: SINALIZAR
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 649
                items: {
                    P649_IDNEGOCIACAO: &P648_IDNEGOCIACAO.
                    P649_IDREPRESENTANTE: &P648_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @sinalizar
        }
    )

)

