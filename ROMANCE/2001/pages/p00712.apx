page 712 (
    name: Cadastro de Configuracoes Estrelas Romance
    title: Cadastro de Configuracoes Estrelas Romance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region cadastro-de-config-categorias (
        name: Cadastro de Config. Categorias
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P712_FRANQUIAS (
        type: shuttle
        label {
            label: Franquias
            alignment: left
        }
        settings {
            showControls: movingOnly
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido, p.nomepessoa)) display_value
                     , f.idfilial
                from pessoas p
                   , filiais f
                where p.idpessoa = f.idpessoa
                 and f.tipofilial = 'D'
                order by 1
                ```
        }
        layout {
            sequence: 70
            region: @cadastro-de-config-categorias
            slot: regionBody
            alignment: left
            columnSpan: 7
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 5
        }
        source {
            type: databaseColumn
            databaseColumn: FRANQUIAS
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P712_IDCATEGORIACLUBE (
        type: selectList
        label {
            label: Categoria
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomecategoria d
                     , idcategoriaclube r
                  from categoriasclubes
                order by 1
                ```
        }
        layout {
            sequence: 30
            region: @cadastro-de-config-categorias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCATEGORIACLUBE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P712_IDCLUBEDESUCESSO (
        type: selectList
        label {
            label: Estrelas Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomeclube d
                     , idclubedesucesso r
                  from clubedesucesso
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @cadastro-de-config-categorias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCLUBEDESUCESSO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P712_IDCONFIGURACAOCATEGORIA (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-config-categorias
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONFIGURACAOCATEGORIA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P712_IDPAIS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @cadastro-de-config-categorias
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPAIS
            used: always
        }
    )

    pageItem P712_PONTUACAOFINAL (
        type: numberField
        label {
            label: Pontuacao Final
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @cadastro-de-config-categorias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: PONTUACAOFINAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P712_PONTUACAOINICIAL (
        type: numberField
        label {
            label: Pontuacao Inicial
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @cadastro-de-config-categorias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: PONTUACAOINICIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar/Voltar
        layout {
            sequence: 10
            region: @cadastro-de-config-categorias
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 711
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @cadastro-de-config-categorias
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P712_IDCONFIGURACAOCATEGORIA
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @cadastro-de-config-categorias
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P712_IDCONFIGURACAOCATEGORIA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @cadastro-de-config-categorias
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P712_IDCONFIGURACAOCATEGORIA
        }
    )

    process fetch-row-from-configuracoescategorias (
        name: Fetch Row from CONFIGURACOESCATEGORIAS
        type: autoRowFetch
        source {
            tableName: CONFIGURACOESCATEGORIAS
            pkColumn: IDCONFIGURACAOCATEGORIA
            pkItem: P712_IDCONFIGURACAOCATEGORIA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1505381827913187283
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P712_IDCONFIGURACAOCATEGORIA is null then
                        select "#OWNER#"."SEQ_IDCONFIGURACAOCATEGORIA".nextval
                          into :P712_IDCONFIGURACAOCATEGORIA
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1505382207603187283
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-configuracoescategorias (
        name: Process Row of CONFIGURACOESCATEGORIAS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 v_operacao_dml varchar2(1);
                 v_md5 varchar2(4000);
                begin
                
                  if v('REQUEST') = 'CREATE' then
                    v_operacao_dml := 'I';
                  elsif v('REQUEST') = 'SAVE' then
                    v_operacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETE' then
                    v_operacao_dml := 'D';
                  end if;
                  pck_clubedesucesso.prc_configuracoescategorias(pidconfiguracaocategoria => :P712_IDCONFIGURACAOCATEGORIA,
                                                                 pidclubedesucesso        => :P712_IDCLUBEDESUCESSO,
                                                                 pidcategoriaclube        => :P712_IDCATEGORIACLUBE,
                                                                 pfranquias               => :P712_FRANQUIAS,
                                                                 ppontuacaoinicial        => :P712_PONTUACAOINICIAL,
                                                                 ppontuacaofinal          => :P712_PONTUACAOFINAL,
                                                                 pidpais                  => :P712_IDPAIS,
                                                                 pmd5                     => v_md5,
                                                                 poperacao_dml            => v_operacao_dml);
                end;
                
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação processada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1505382696294187283
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1505383028076187283
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 711
            }
        }
    )

)

