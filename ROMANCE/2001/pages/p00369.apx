page 369 (
    name: Controle de Estoques
    title: Controle de Estoques
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region controle-de-estoques-anual (
        name: Controle de Estoques Anual
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.idfilial
                     , f.nome
                     , nvl(( select sum( nvl(it.qtd_dist_pp,0)
                                       + nvl(it.qtd_dist_p,0)
                                       + nvl(it.qtd_dist_m,0)
                                       + nvl(it.qtd_dist_g,0)
                                       + nvl(it.qtd_dist_gg,0)
                                       + nvl(it.qtd_dist_egg,0)
                                       + nvl(it.qtd_dist_exgg,0)
                                       + nvl(it.qtd_dist_u,0) ) qtd
                             from itenscargarepresentante it
                                , cargasrepresentantes c
                             where it.idcargarepresentante = c.idcargarepresentante
                               and c.situacao              <> 0
                               and c.idfilial              = f.idfilial
                               and exists ( select 1
                                            from semana_dias s
                                            where s.idsemana = c.idsemana
                                              and s.ano = :P369_ANO ) ),0) qtdcargas
                     , nvl(( select sum( nvl(itd.qtd_pp,0)
                                       + nvl(itd.qtd_p,0)
                                       + nvl(itd.qtd_m,0)
                                       + nvl(itd.qtd_g,0)
                                       + nvl(itd.qtd_gg,0)
                                       + nvl(itd.qtd_egg,0)
                                       + nvl(itd.qtd_exgg,0)
                                       + nvl(itd.qtd_u,0) ) qtd
                             from itensdevolucaorepres itd
                                , devolucoesrepresentantes d
                             where itd.iddevolucaorepres = d.iddevolucaorepres
                               and d.situacao            <> 0
                               and d.idfilial            = f.idfilial
                               and exists ( select 1
                                            from semana_dias s
                                            where s.idsemana = d.idsemana
                                              and s.ano = :P369_ANO ) ),0) qtddev
                     , nvl(( select sum( nvl(itn.quantidade,0) - nvl(itn.qtddevolvida,0) ) qtd
                             from itensnotavenda itn
                                , notasvendas n 
                             where itn.idnotavenda       = n.idnotavenda
                               and n.idsituacaonotavenda = 4
                               and n.idfilial            = f.idfilial
                               and exists ( select 1
                                            from semana_dias s
                                            where s.idsemana = n.idsemanacobranca
                                              and s.ano = :P369_ANO ) ),0) qtdntv
                     , nvl(( select sum( nvl(i.qtd_pp_chegou,0)
                                       + nvl(i.qtd_p_chegou,0)
                                       + nvl(i.qtd_m_chegou,0)
                                       + nvl(i.qtd_g_chegou,0)
                                       + nvl(i.qtd_gg_chegou,0)
                                       + nvl(i.qtd_egg_chegou,0)
                                       + nvl(i.qtd_exgg_chegou,0)
                                       + nvl(i.qtd_u_chegou,0) )
                             from itemnf i
                                , notasfiscais nf
                             where nf.idfilialdestino = f.idfilial
                               and i.idnotafiscal     = nf.idnotafiscal
                               and nf.situacaofilial  = 'R'
                               and nf.datarecebimento is not null
                               and exists ( select 1
                                            from semana_dias s
                                            where s.idsemana = nf.idsemananota
                                              and s.ano = :P369_ANO ) ),0) qtdnfrecebida
                from vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and :P369_TIPO = 'A'
                  and ( :P369_IDFILIAL is null or f.idfilial = :P369_IDFILIAL )
                order by 2
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P369_TIPO
            value: A
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1408096838669863649
        }

