    )

    pageItem P369_SEMANAFIM (
        type: selectList
        label {
            label: até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano semana
                     , s.idsemana
                from semana_dias s
                where s.ano >= 2016
                order by s.idsemana
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

