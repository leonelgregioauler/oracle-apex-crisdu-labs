    dynamicAction tipo-filtro (
        name: Tipo Filtro
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P369_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P369_TIPO
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P369_SEMANAINICIO
                    P369_SEMANAFIM
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P369_ANO
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P369_SEMANAINICIO
                    P369_SEMANAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P369_ANO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        name: Go To Page 369
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 369
                items: {
                    P369_ANO: &P369_ANO.
                    P369_TIPO: &P369_TIPO.
                    P369_SEMANAINICIO: &P369_SEMANAINICIO.
                    P369_SEMANAFIM: &P369_SEMANAFIM.
                    P369_IDFILIAL: &P369_IDFILIAL.
                }
                action: resetPagination
            }
        }
    )

