    pageItem P369_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todas Filiais -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
