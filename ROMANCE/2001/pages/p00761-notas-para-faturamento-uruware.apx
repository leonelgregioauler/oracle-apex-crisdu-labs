page 761 (
    name: Notas para Faturamento Uruware
    alias: NOTAS-PARA-FATURAMENTO-URUWARE
    title: Notas para Faturamento Uruware
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }

    region relação-de-notas (
        name: Relação de Notas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idpessoa,
                       w.nomepessoa,
                       w.rut,
                       w.idnotavenda,
                       w.idrepresentante,
                       w.idsemanacobranca,
                       w.datanota,
                       w.dataacerto,
                       w.numeronota,
                       w.valortotalnota,
                       w.valortotaldevolucao,
                       w.vendaliquida,
                       w.valordesconto,
                       w.valorpago
                from vw_notas_faturamento_uy w
                where w.idrepresentante = :P761_IDREPRESENTANTE
                  and w.idsemanacobranca = :P761_IDSEMANA
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 52597818653184312
        }

        column DATAACERTO (
            type: plainText
            heading {
                heading: Acerto
                alignment: center
            }
            layout {
                sequence: 80
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        column DATANOTA (
