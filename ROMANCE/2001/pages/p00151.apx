page 151 (
    name: Incluir Usuário
    title: Incluir Usuário
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            window.opener.location.reload();
            ```
        executeWhenPageLoads:
            ```javascript-browser
            if (document.getElementById('P58_IDCHAMADO').value == '')
            {
             window.close();
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region incluir-usuário (
        name: Incluir Usuário
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P151_IDCHAMADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @incluir-usuário
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCHAMADO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P151_IDUSUARIOSCHAMADO (
        type: hidden
        layout {
            sequence: 10
            region: @incluir-usuário
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIOSCHAMADO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P151_USUARIO (
        type: popupLov
        label {
            label: Usuário
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeusuario(u.usuario) display_value
                     , usuario return_value
                from usuarios u
                where not exists ( select 1 
                                    from usuarioschamados uu
                                    where uu.idchamado = :P151_IDchamado
                                      and uu.usuario   = u.usuario )
                and not exists ( select 1 
                                  from representantes r
                                  where r.idrepresentante = :Var1 )
                order by 1
                
                ```
            nullDisplayValue: - Selecione o usuário -
        }
        layout {
            sequence: 30
            region: @incluir-usuário
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @incluir-usuário
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P151_IDUSUARIOSPROJETOS
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @incluir-usuário
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P151_IDUSUARIOSPROJETOS
        }
    )

    process fetch-row-from-usuarioschamados (
        name: Fetch Row from USUARIOSCHAMADOS
        type: autoRowFetch
        source {
            tableName: USUARIOSCHAMADOS
            pkColumn: IDUSUARIOSCHAMADOS
            pkItem: P151_IDUSUARIOSCHAMADOS
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 31580587050445758
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P151_IDUSUARIOSCHAMADOS is null then
                        select "SEQ_IDUSUARIOSCHAMADOS".nextval
                          into :P151_IDUSUARIOSCHAMADO
                          from dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 31580967351445758
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-usuarioschamados (
        name: Process Row of USUARIOSCHAMADOS
        type: autoRowProcessing
        target {
            tableName: USUARIOSCHAMADOS
            pkColumn: IDUSUARIOSCHAMADOS
            pkItem: P151_IDUSUARIOSCHAMADOS
            supportedOperations: [
                insert
                delete
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 31581428488445758
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        clear {
            type: pages
            pages: 40
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 31581832267445758
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: Go To Page 58
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 111
                successMessage: false
            }
        }
        comments {
            comments: Created 21-JAN-2013 18:22 by ROMAN
        }
    )

)

