        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 618
                items: {
                    P618_DATAINICIO: &P618_DATAINICIO.
                    P618_DATAFIM: &P618_DATAFIM.
                    P618_IDVENDEDORA: &P618_IDVENDEDORA.
                    P618_SITUACAO: &P618_SITUACAO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
