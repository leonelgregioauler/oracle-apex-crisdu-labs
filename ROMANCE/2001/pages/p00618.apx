    region placar-do-dia (
        name: Placar do Dia
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Pendente' situacao
                     , count(1) quantidade
                from negativacoesspc n
                where n.dataprocessado is null
                union
                select 'Sucesso' situacao
                     , count(1) quantidade
                from negativacoesspc n
                where n.status = 'S'
                  and trunc(n.dataprocessado) = trunc(sysdate)
                union
                select 'Com Erro' situacao
                     , count(1) quantidade
                from negativacoesspc n
                where n.status = 'E'
                  and trunc(n.dataprocessado) = trunc(sysdate)
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: SITUACAO
            valueColumn: QUANTIDADE
            color: yes
        }
    )

