    pageItem P618_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' CPF: '||p.cpf d
                     , v.idvendedora r
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 50
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P618_SITUACAO (
        type: radioGroup
        label {
            label: Situação
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Ambos;X,Com Sucesso;S,Com Erro;E,Pendente;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        default {
            type: static
            staticValue: X
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
