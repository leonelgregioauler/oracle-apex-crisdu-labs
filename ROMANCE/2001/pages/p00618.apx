    region negativações-spc (
        name: Negativações SPC
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vn.idnegativacaospc
                     , vn.data
                     , vn.mensagem
                     , vn.descstatus
                     , vn.usuario
                     , vn.token_usuario
                     , vn.idpessoa
                     , vn.idvendedora
                     , vn.cpf
                     , vn.nome
                     , vn.datanascimento
                     , vn.ddd
                     , vn.telefone
                     , vn.datavencimento
                     , vn.numerocontrato      
                     , vn.datacompra
                     , vn.valordebito
                     , vn.idnaturezainclusao
                     , vn.cep
                     , vn.endereco
                     , vn.bairro
                     , vn.numero
                from roman.vw_negativacoespc_rmc vn
                where ( :P618_DATAINICIO is null or  vn.data between to_date(:P618_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P618_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                  and ( :P618_IDVENDEDORA is null or vn.idvendedora = :P618_IDVENDEDORA )
                  and ( :P618_SITUACAO = 'X'
                   or ( :P618_SITUACAO = 'S' and vn.status = 'S' )
                   or ( :P618_SITUACAO = 'E' and vn.status = 'E' )
                   or ( :P618_SITUACAO = 'P' and vn.dataprocessado is null ) )
                order by 1 desc
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma Informação encontrada!
        }
        advanced {
            savedReportMappingIdentifier: 113666148499439003
        }

