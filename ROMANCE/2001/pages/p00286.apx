page 286 (
    name: Gerar Código de Liberação
    title: Gerar Código de Liberação
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 50%
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    headerAndFooter {
        footerText:
            ```html
            <script javascript>
             window.resizeTo(screen.width*.46,screen.height*.46);  
                window.moveTo(screen.width*.26, screen.height*.20);  
            </script>
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region gerar-código-de-liberação (
        name: Gerar Código de Liberação
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P286_CODIGO (
        type: textField
        label {
            label: Código
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @gerar-código-de-liberação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P286_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) display_value
                     , r.idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                  and r.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: "- Selecione um Distribuidor - "
        }
        cascadingLov {
            parentItems: P0_IDFILIAL
        }
        layout {
            sequence: 10
            region: @gerar-código-de-liberação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P286_RESULTADO (
        type: textField
        label {
            label: Cod. Gerado
            alignment: left
        }
        layout {
            sequence: 30
            region: @gerar-código-de-liberação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: readonly
        }
        security {
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 10
            region: @gerar-código-de-liberação
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Gerar
        layout {
            sequence: 20
            region: @gerar-código-de-liberação
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction fechar (
        name: Fechar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @fechar
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process gerar (
        name: Gerar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vusuario varchar2(100) := v('APP_USER');
                  vidcodigo number;
                  vcodigo number;
                  vdata date := sysdate;
                  vmd5 varchar2(1000);
                  --
                begin
                  -- Call the function
                  :P286_RESULTADO := pck_mobile.fnc_geracodigovalidacao(pcodigo => :P286_CODIGO);
                  --
                  vcodigo := :P286_RESULTADO;
                  --
                  pck_mobile.prc_codigosaplicativos(pidcodigoaplicativo => vidcodigo,
                                                    pidfilial => :P0_IDFILIAL,
                                                    pidrepresentante => :P286_IDREPRESENTANTE,
                                                    pdata => vdata,
                                                    pliberadopor => vusuario,
                                                    pcodigo => :P286_CODIGO,
                                                    pcodigogerado => vcodigo,
                                                    pmd5 => vmd5,
                                                    poperacao_dml => 'I');
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 209937400890862215
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: gerar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 286
                action: resetPagination
            }
        }
    )

)

