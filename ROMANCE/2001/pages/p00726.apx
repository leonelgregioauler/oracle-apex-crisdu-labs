page 726 (
    name: Motivos Painel de Clientes Reativas
    title: Motivos Painel de Clientes Reativas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region motivos-reativação-de-clientes (
        name: Motivos - Reativação de Clientes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idmotivoreativavend
                     , c.motivo
                     , case
                         when c.tipo = 'C' then 'Conclusão'
                         when c.tipo = 'D' then 'Devolução'
                     end tipo
                from roman.motivosreativavend c
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2432840972695084403
        }

        column IDMOTIVOREATIVAVEND (
            type: link
            heading {
                heading: Editar Motivo
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            link {
                target: {
                    page: 727
                    items: {
                        P727_IDMOTIVOREATIVAVEND: #IDMOTIVOREATIVAVEND#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column MOTIVO (
            type: plainText
            heading {
                heading: Motivo
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 24328487 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IDMOTIVOREATIVAVEND (
                sequence: 1
            )

            displayColumn MOTIVO (
                sequence: 2
            )

            displayColumn TIPO (
                sequence: 3
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Motivo
        layout {
            sequence: 10
            region: @motivos-reativação-de-clientes
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 728
                clearCache: 728
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

