    region consultas-pela-favorita (
        name: Consultas Pela Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(fil.idfilial) empresa
                     , (nvl(cons.qtd,0)+nvl(semcons.qtd,0)+nvl(semusuario.qtd,0)) quantidade
                from ( select f.idfilial
                       from vw_filiais f
                       where exists ( select 1
                                      from historicosconsultasdoc h
                                      where h.idfilial = f.idfilial )
                         and idgrupo != 5 ) fil
                   , ( select h.idfilial idfilial
                            , (count(distinct c.idconsultaspc) )  qtd
                       from consultaspc c
                          , historicosconsultasdoc h
                       where h.dataconsulta between to_date(:P426_DATAINICIO||' 00:00:00', 'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P426_DATAFIM||' 23:59:59', 'dd/mm/rrrr hh24:mi:ss')
                         and h.documento = c.cpf
                         and c.idfilial = 200
                       group by h.idfilial ) cons
                   , ( select c.idfilial 
                            , (count(distinct c.idconsultaspc) )  qtd
                       from consultaspc c
                       where c.dataconsulta between to_date(:P426_DATAINICIO||' 00:00:00', 'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P426_DATAFIM||' 23:59:59', 'dd/mm/rrrr hh24:mi:ss')
                         and not exists ( select 1
                                          from historicosconsultasdoc h
                                          where h.documento = c.cpf
                                            and h.dataconsulta between to_date(:P426_DATAINICIO||' 00:00:00', 'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P426_DATAFIM||' 23:59:59', 'dd/mm/rrrr hh24:mi:ss') )
                         and exists ( select 1
                                      from usuarios ug
                                      where ug.usuario = c.usuario
                                        and ug.idgerente = ( select idgerente
                                                             from gerentes g
                                                             where g.idfilial = 200 ) ) 
                       group by c.idfilial ) semcons
                    , ( select c.idfilial 
                            , (count(distinct c.idconsultaspc) )  qtd
                       from consultaspc c
                       where c.dataconsulta between to_date(:P426_DATAINICIO||' 00:00:00', 'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P426_DATAFIM||' 23:59:59', 'dd/mm/rrrr hh24:mi:ss')
                         and not exists ( select 1
                                          from historicosconsultasdoc h
                                          where h.documento = c.cpf
                                            and h.dataconsulta between to_date(:P426_DATAINICIO||' 00:00:00', 'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P426_DATAFIM||' 23:59:59', 'dd/mm/rrrr hh24:mi:ss') )
                         and c.usuario is null
                         and c.idfilial = 200
                       group by c.idfilial ) semusuario
                where cons.idfilial(+) = fil.idfilial
                  and semcons.idfilial(+) = fil.idfilial
                  and semusuario.idfilial(+) = fil.idfilial
                order by 1
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2639207348923336402
        }

