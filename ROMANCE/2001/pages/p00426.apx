    region consultas-por-empresa-e-cpf (
        name: Consultas por Empresa e CPF
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(idfilial) empresa
                     , c.cpf
                     , c.codigooperador
                     , count(1 )  quantidade
                from consultaspc c
                where c.dataconsulta between to_date(:P426_DATAINICIO||' 00:00:00', 'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P426_DATAFIM||' 23:59:59', 'dd/mm/rrrr hh24:mi:ss')
                group by c.idfilial 
                       , c.cpf
                       , c.codigooperador
                order by 1
