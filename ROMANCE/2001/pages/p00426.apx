    region consulta-grupos-favorita (
        name: Consulta Grupos Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.descricao Grupo
                     , count(distinct c.usuario) quantidade
                from consultaspc c
                   , usuariosgruposatendimento ug
                   , gruposatendimento g
                where c.dataconsulta between to_date(:P426_DATAINICIO||' 00:00:00', 'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P426_DATAFIM||' 23:59:59', 'dd/mm/rrrr hh24:mi:ss')
                  and c.idfilial = 200
                  and ug.usuario = c.usuario
                  and g.idgrupoatendimento = ug.idgrupoatendimento
                  and ug.usuario is not null
                  and not exists ( select 1
                                   from historicosconsultasdoc h 
                                   where h.documento = c.cpf )
                group by g.descricao
                union
                select pck_romance.fnc_nomefilial(c.idfilial) empresa
                     , count(1) quantidade
                from consultaspc c
                where c.dataconsulta between to_date(:P426_DATAINICIO||' 00:00:00', 'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P426_DATAFIM||' 23:59:59', 'dd/mm/rrrr hh24:mi:ss')
                  and c.idfilial = 200
                  and c.usuario is null
                  and not exists ( select 1
                                   from historicosconsultasdoc h 
                                   where h.documento = c.cpf )
                group by idfilial
                order by 1
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent11
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1489716798908155127
        }

