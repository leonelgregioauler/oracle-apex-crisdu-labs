    region consulta-grupos-favorita-detalhado (
        name: Consulta Grupos Favorita Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.descricao Grupo
                     , c.usuario
                     , count(1) quantidade
                from consultaspc c
                   , usuariosgruposatendimento ug
                   , gruposatendimento g
                where c.dataconsulta between to_date(:P426_DATAINICIO||' 00:00:00', 'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P426_DATAFIM||' 23:59:59', 'dd/mm/rrrr hh24:mi:ss')
                  and c.idfilial = 200
                  and ug.usuario = c.usuario
                  and g.idgrupoatendimento = ug.idgrupoatendimento
                  and ug.usuario is not null
                group by g.descricao , c.usuario
                union
                select pck_romance.fnc_nomefilial(c.idfilial) empresa
                     , usuario
                     , count(1) quantidade
                from consultaspc c
                where c.dataconsulta between to_date(:P426_DATAINICIO||' 00:00:00', 'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P426_DATAFIM||' 23:59:59', 'dd/mm/rrrr hh24:mi:ss')
                  and c.idfilial = 200
                  and c.usuario is null
                group by idfilial , c.usuario
                order by 1
                ```
        }
