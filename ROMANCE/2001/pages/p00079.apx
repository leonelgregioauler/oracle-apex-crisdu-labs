        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select p.valor
                from parametros p
                where p.nome = 'CONFIRMADEPOSITOSAUTOMATICO' 
                  and p.idfilial = :P0_IDFILIAL
                ```
