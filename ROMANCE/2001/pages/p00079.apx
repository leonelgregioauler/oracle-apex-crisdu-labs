page 79 (
    name: Confirmar Depósitos
    title: Confirmar Depósitos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function confirmaexclusao() {
            	var answer = confirm("Deseja realmente desvincular o depósito?")
            	if (answer){
            		apex.submit('EXCLUIRDEP');
            	}
                    else
                    {
                    document.getElementById('P38_EXCLUIR').value = '';
                    }
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region confirmar-depósitos (
        name: Confirmar Depósitos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select iddepositodiarios
                     , data
                     , idrepresentante
                     , ( select  initcap(bb.nomebanco) || ' - <b>' || cb.agencia ||'/'||cb.conta||'</b> - <i>'||initcap(cb.beneficiario)||'</i>' 
                          from contasbancarias cb
                             , bancos          bb
                          where cb.idbanco      = bb.idbanco
                            and cb.idcontabanc = d.idcontabanc) idcontabanc
                     , idpgtoforn
                     , valordeposito
                     , comprovado
                     , nrocomprovante
                     , observacao
                     , tipo
                     , idcheque
                     , idpgtoforn_orig
                     , iddepositodiarios id2     
                     , valororiginal
                     , referentea
                     , fechamento
                     , idfechamentorepres
                     , OBSERVACAOGERENTE
                     , USUARIOCONFIRMOU
                     , DATACONFIRMACAO
                     , nvl(( select count(1)
                             from depositosdiarios_leituraocr dr
                             where dr.iddepositodiario = d.iddepositodiarios ),0) qtdfotos
                from depositosdiarios_orig d
                where ( comprovado = 'S'
                        and exists ( select 1 
                                     from depositosdiarios_leituraocr dr
                                     where dr.iddepositodiario = d.iddepositodiarios ) 
                        and pck_romance.fnc_filialrepresentante(d.idrepresentante) not in (1095,1111,1121,1129,1081,1108,1041,1194,1206,1148,1209,1244)
                      or ( comprovado = 'S'
                           and pck_romance.fnc_filialrepresentante(d.idrepresentante) in (1095,1111,1121,1129,1081,1108,1041,1194,1206,1148,1209,1244) )
                      or ( comprovado = 'M'
                           and exists ( select 1
                                        from depositosdiarios_leituraocr dd
                                        where dd.iddepositodiario = d.iddepositodiarios ) ) )
                  and idrepresentante = :P79_IDREPRESENTANTE
                  and extract ( year from data) >= 2019
                  and idfechamentorepres is null
                  and ( :P79_CONFIRMAAUTOMATICO = 'N'
                       or ( :P79_GERENTE = 'S' )
                       or ( :P79_CONFIRMAAUTOMATICO = 'S' and exists ( select 1
                                                                       from fechamentossemanais fr
                                                                       where fr.idfechamento = :P79_IDFECHAMENTOPONTUACAO 
                                                                         and fr.idsemana     = d.idsemana ) ) ) 
                  and IDENTIFICACAO is null
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (nulo)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum depósito pendente de confirmação.
        }
        componentAdvanced {
            stripHtml: true
        }

