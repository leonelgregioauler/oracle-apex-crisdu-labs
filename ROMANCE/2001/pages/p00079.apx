    pageItem P79_GERENTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @confirmar-depósitos
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vgerente varchar2(1) := 'N';
                begin
                  --
                  select 'S'
                  into vgerente
                  from dual
                  where ( select idpessoa 
                          from gerentes g
                          where g.idfilial = :P0_IDFILIAL ) = ( select idpessoa
                                                                from representantes r
                                                                where r.idrepresentante = :P79_IDREPRESENTANTE );
                  --
                  return vgerente;
                  --
                exception
                  when others then
                    return 'N';
                end;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vgerente varchar2(1) := 'N';
                begin
                  --
                  select 'S'
                  into vgerente
                  from dual
                  where ( select idpessoa 
                          from gerentes g
                          where g.idfilial = :P0_IDFILIAL ) = ( select idpessoa
                                                                from representantes r
                                                                where r.idrepresentante = :P79_IDREPRESENTANTE );
                  --
                  return vgerente;
                  --
                exception
                  when others then
                    return 'N';
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

