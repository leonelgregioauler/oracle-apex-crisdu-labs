    region depósitos-confirmados-neste-acerto (
        name: Depósitos Confirmados neste Acerto
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null Desvincular
                     , depdia.data  Data_deposito
                     , initcap(bb.nomebanco)  Banco
                     , cb.agencia ||', '||cb.conta  agencia_conta
                     , initcap(cb.beneficiario) beneficiario
                     , depdia.valordeposito Valor_depositado
                     , ( select t.descricao
                         from tipospagamentos t
                         where t.codigo = depdia.tipo )tipo
                     , decode(depdia.comprovado,'S','Sem Comprovante'
                                               ,'C','Cópia'
                                               ,'G','Com Gerente'
                                               ,'M','Em Mãos') Comprovado
                     , depdia.nrocomprovante
                     , depdia.OBSERVACAOGERENTE observacao
                     , depdia.iddepositodiarios
                     , depdia.usuarioconfirmou
                     , depdia.dataconfirmacao
                from depositosdiarios_orig depdia
                   , pagamentosfornecedores pgf
                   , contasbancarias cb
                   , bancos          bb 
                where cb.idbanco                = bb.idbanco    
                  and depdia.idcontabanc        = cb.idcontabanc
                  and depdia.idpgtoforn         = pgf.idpgtoforn
                  and depdia.idfechamentorepres = :P79_IDFECHAMENTOREPRES
                union
                select null Desvincular
                     , depdia.data  Data_deposito
                     , initcap(bb.nomebanco)  Banco
                     , cb.agencia ||', '||cb.conta  agencia_conta
                     , initcap(cb.beneficiario) beneficiario
                     , depdia.valordeposito Valor_depositado
                     , ( select t.descricao
                         from tipospagamentos t
                         where t.codigo = depdia.tipo )tipo
                     , decode(depdia.comprovado,'S','Sem Comprovante'
                                               ,'C','Cópia'
                                               ,'G','Com Gerente'
                                               ,'M','Em Mãos') Comprovado
                     , depdia.nrocomprovante
                     , depdia.OBSERVACAOGERENTE observacao
                     , depdia.iddepositodiarios
                     , depdia.usuarioconfirmou
                     , depdia.dataconfirmacao
                from depositosdiarios_orig depdia
                   , contasbancarias cb
                   , bancos          bb 
                where cb.idbanco                = bb.idbanco    
                  and depdia.idcontabanc        = cb.idcontabanc
                  and exists ( select 1
                               from extratoscontasbancarias ex
                               where ex.iddepositodiario_orig = depdia.iddepositodiarios )
                  and depdia.idfechamentorepres = :P79_IDFECHAMENTOREPRES
                ```
        }
        layout {
            sequence: 25
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

