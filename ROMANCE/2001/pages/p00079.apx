    region outros-depósitos (
        name: Outros Depósitos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select depdia.data  Data_deposito
                     , initcap(bb.nomebanco)  Banco
                     , cb.agencia ||', '||cb.conta  agencia_conta
                     , initcap(cb.beneficiario) beneficiario
                     , depdia.valordeposito Valor_depositado
                     , ( select t.descricao
                         from tipospagamentos t
                         where t.codigo = depdia.tipo )tipo
                     , decode(depdia.comprovado,'S','Sem Comprovante'
                                               ,'C','Cópia'
                                               ,'G','Com Gerente'
                                               ,'M','Em Mãos') Comprovado
                     , depdia.nrocomprovante
                     , depdia.OBSERVACAOGERENTE observacao
                     --, depdia.iddepositodiarios
                     , depdia.observacao observacaoescritorio
                     , decode(depdia.identificacao,'CA','Carro'
                                           ,'CH','Cheque sem Fundo'
                                           ,'EE','Empréstimo'
                                           ,'CT','Catálogo'
                                           ,'OT','Outros') identificacaointerna
                from depositosdiarios_orig depdia
                   , pagamentosfornecedores pgf
                   , contasbancarias cb
                   , bancos          bb 
                where cb.idbanco                = bb.idbanco    
                  and depdia.idcontabanc        = cb.idcontabanc
                  and depdia.idpgtoforn         = pgf.idpgtoforn
                  and depdia.comprovado         = 'C'
                  and depdia.idrepresentante    = :P79_IDREPRESENTANTE
                  and trunc(depdia.data) between trunc(sysdate)-150 and trunc(sysdate)
                ```
        }
        layout {
            sequence: 45
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent13
                t-Region--scrollBody
