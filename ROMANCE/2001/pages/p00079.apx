    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @confirmar-depósitos
        target {
            tableName: DEPOSITOSDIARIOS_ORIG
            pkColumn: IDDEPOSITODIARIOS
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Linha(s) #MRU_COUNT# atualizada(s); linha(s) #MRI_COUNT# inserida(s).
        }
        error {
            errorMessage: Não foi possível processar a atualização.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 157688575030470478
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process retira-deposito-do-acerto (
        name: retira deposito do acerto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  -- update para quando NÃO tem foto
                  update depositosdiarios_orig d
                  set fechamento         = null
                    , idfechamentorepres = null
                    , comprovado        = 'S'
                  where iddepositodiarios = :P79_IDDEPOSITO
                    and not exists ( select 1 
                                     from depositosdiarios_leituraocr do
                                     where do.iddepositodiario = d.iddepositodiarios );
                  --
                  -- update para quando TEM foto
                  update depositosdiarios_orig d
                  set fechamento         = null
                    , idfechamentorepres = null
                    , comprovado        = 'M'
                  where iddepositodiarios = :P79_IDDEPOSITO
                    and exists ( select 1 
                                 from depositosdiarios_leituraocr do
                                 where do.iddepositodiario = d.iddepositodiarios );
                  --                  
                end;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 157688765649470478
        }
        serverSideCondition {
            type: request=Value
            value: EXCLUIRDEP
        }
    )

