    region depósitos-aguardando-envio-de-fotos (
        name: Depósitos aguardando envio de Fotos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select depdia.data  Data_deposito
                     , initcap(bb.nomebanco)  Banco
                     , cb.agencia ||', '||cb.conta  agencia_conta
                     , initcap(cb.beneficiario) beneficiario
                     , depdia.valordeposito Valor_depositado
                     , ( select t.descricao
                         from tipospagamentos t
                         where t.codigo = depdia.tipo )tipo
                     , decode(depdia.comprovado,'S','Sem Comprovante'
                                               ,'C','Cópia'
                                               ,'G','Com Gerente'
                                               ,'M','Em Mãos') Comprovado
                     , depdia.nrocomprovante
                     , depdia.OBSERVACAOGERENTE observacao
                     , depdia.iddepositodiarios
                from depositosdiarios_orig depdia
                   , contasbancarias cb
                   , bancos          bb 
                where cb.idbanco                = bb.idbanco    
                  and depdia.idcontabanc        = cb.idcontabanc
                  and exists ( select 1
                               from extratoscontasbancarias ex
                               where ex.iddepositodiario_orig = depdia.iddepositodiarios )
                  and depdia.idrepresentante = :P79_IDREPRESENTANTE
                  and depdia.comprovado = 'S'
                  and not exists ( select 1
                                   from depositosdiarios_leituraocr dl
                                   where dl.iddepositodiario = depdia.iddepositodiarios )
                ```
        }
        layout {
            sequence: 55
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent12
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Nenhum depósito pendente de envio de foto!
        }

