    region registros-detalhados (
        name: Registros Detalhados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.estado
                     , r.telefoneassociado
                     , r.nomeassociado
                     , r.datainclusao
                     , r.datavencimento
                     , r.nomeentidade
                     , r.valor
                     , r.tipo
                from restricoesconsultaspc r
                where r.idconsultaspc = :P430_IDCONSULTASPC
                order by r.valor desc
                ```
        }
        layout {
            sequence: 20
            slot: body
