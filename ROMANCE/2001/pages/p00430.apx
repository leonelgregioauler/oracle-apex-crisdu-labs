    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P430_IDCONSULTASPC is null then
                        select "#OWNER#"."SEQ_IDCONSULTASPC".nextval
                          into :P430_IDCONSULTASPC
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1492767910464744243
        }
    )

