    region cheques-c-fundo (
        name: Cheques C/ Fundo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.codigo
                     , c.descricao
                     , c.banco
                     , c.dataultimocheque
                     , c.origem
                     , c.quantidade
                from chequesconsultaspc c
                where c.idconsultaspc = :P430_IDCONSULTASPC
                order by c.dataultimocheque desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent11
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from chequesconsultaspc c
                where c.idconsultaspc = :P430_IDCONSULTASPC
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1492570794229879948
        }

