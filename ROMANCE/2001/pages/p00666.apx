page 666 (
    name: Impressão Distribuidores Motivou Levou
    title: Impressão Distribuidores Motivou Levou
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão (
        name: Impressão
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  vidsemanaini number;
                  vidsemanafim number;
                begin
                  --
                  if :P666_TIPO = 'P' then
                    --
                    pck_campanhas.prc_imprimepontdistribuidores(pidfilial => :P666_IDFILIAL,
                                                                pidsemanaini => :P666_IDSEMANA,
                                                                pidsemanafim => :P666_IDSEMANAFIM);
                    --
                  else
                    --
                    pck_campanhas.prc_imprimepontdistribuidores(pidfilial => :P666_IDFILIAL,
                                                                pidsemanaini => :P666_IDSEMANA,
                                                                pidsemanafim => :P666_IDSEMANA);
                    --
                  end if;
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item!=value
            item: P666_TIPO
            value: C
        }
    )

    region impressão-campanha (
        name: Impressão Campanha
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  vidsemanaini number;
                  vidsemanafim number;
                begin
                  --
                    select c.idsemanaini
                         , c.idsemanafim
                    into vidsemanaini
                       , vidsemanafim
                    from campanhas c
                    where c.idcampanha = :P666_IDCAMPANHA;
                    --
                    pck_campanhas.prc_imprimepontdistribuidores(pidfilial => :P666_IDFILIAL,
                                                                pidsemanaini => vidsemanaini,
                                                                pidsemanafim => vidsemanafim,
                                                                pidcampanha => :P666_IDCAMPANHA);
                  --
                end;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P666_TIPO
            value: C
        }
    )

    pageItem P666_IDCAMPANHA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P666_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P666_IDSEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P666_IDSEMANAFIM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P666_TIPO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

