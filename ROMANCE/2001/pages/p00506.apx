page 506 (
    name: Balanços de Distribuidores Anteriores
    title: Balanços de Distribuidores Anteriores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 90%
        height: 90%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region balanços-anteriores-ao-gerado-com-comissão (
        name: Balanços Anteriores ao Gerado Com Comissão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idrepresentante
                     , data
                     , semana
                     , usuario
                     , qtdinicial_com
                     , valorinicil_com
                     , qtdcarga_com
                     , valorcarga_com
                     , qtddevolucao_com
                     , valordevolucao_com
                     , qtdvendeu_com
                     , valorvendeu_com
                     , qtdemclientes_com
                     , valoremclientes_com
                     , qtdveiooutros_com
                     , valorveiooutros_com
                     , qtdfoioutros_com
                     , valorfoioutros_com
                     , qtdsaldo_com
                     , valorsaldo_com
                     /*, case
                         when exists ( select 1
                                       from vw_filiais f
                                       where f.idfilial = :P0_IDFILIAL 
                                         and f.idgrupo = 5 ) then
                           trim(to_char((valorsaldo_com*0.70),'999G999G999G999G999G990D00'))
                         else
                           trim(to_char((valorsaldo_com*0.65),'999G999G999G999G999G990D00'))
                       end saldocomdesconto*/
                from vw_balanco_congelado b
                where b.idrepresentante = :P506_IDREPRESENTANTE
                  and b.idbalancocongelado = (select max(idbalancocongelado)
                                                 from balancocongelado
                                                where idsemana = b.idsemana
                                                  and idrepresentante = b.idrepresentante)
                order by b.idsemana desc
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1565448422146058710
        }

