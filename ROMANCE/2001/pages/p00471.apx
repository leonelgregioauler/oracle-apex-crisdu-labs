page 471 (
    name: Foto do Comprovante
    title: Foto do Comprovante
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 80%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region foto-do-comprovante (
        name: Foto do Comprovante
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idleituraocr_deposito
                     , iddepositodiario
                     , idrepresentante 
                     , '<iframe  width=500px; height=655px; src="/apex/f?p=2001:472:&APP_SESSION.::NO:RP:P472_ARQUIVO:'||nomearquivo||'"></iframe>' foto
                     , ( select urlcomprovante
                         from comprovantes comp
                         where comp.idcomprovante = d.idcomprovante) urlcomprovante
                     , nroidentificacao_digitado
                     , valor_digitado                      
                     , d.usuariorevisao       
                     , d.datarevisao
                from depositosdiarios_leituraocr D
                where iddepositodiario = :P471_IDDEPOSITODIARIO
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 898669465930044413
        }

        column DATAREVISAO (
            type: plainText
            heading {
                heading: Data da Revisão
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        column FOTO (
            type: plainText
            heading {
                heading: Foto
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
            serverSideCondition {
                type: noRowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from comprovantes
                    where iddepositosdiarios = :P471_IDDEPOSITODIARIO
                    ```
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDDEPOSITODIARIO (
            type: hidden
            heading {
                heading: Iddepositodiario
            }
            layout {
                sequence: 20
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDLEITURAOCR_DEPOSITO (
            type: hidden
            heading {
                heading: Idleituraocr deposito
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDREPRESENTANTE (
            type: hidden
            heading {
                heading: Idrepresentante
            }
            layout {
                sequence: 30
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NROIDENTIFICACAO_DIGITADO (
            type: plainText
            heading {
                heading: Identificação
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column URLCOMPROVANTE (
            type: plainText
            heading {
                heading: Foto (Versão 2)
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <img src="#URLCOMPROVANTE#" style="height: 655px; width: 500px;"/>
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from comprovantes
                    where iddepositosdiarios = :P471_IDDEPOSITODIARIO
                    ```
            }
        )

        column USUARIOREVISAO (
            type: plainText
            heading {
                heading: Revisado Por
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALOR_DIGITADO (
            type: plainText
            heading {
                heading: "Valor "
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 9013911 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAREVISAO (
                sequence: 6
            )

            displayColumn FOTO (
                sequence: 1
            )

            displayColumn NROIDENTIFICACAO_DIGITADO (
                sequence: 3
            )

            displayColumn URLCOMPROVANTE (
                sequence: 2
            )

            displayColumn USUARIOREVISAO (
                sequence: 5
            )

            displayColumn VALOR_DIGITADO (
                sequence: 4
            )

        )

    )

    pageItem P471_IDDEPOSITODIARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @foto-do-comprovante
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

