page 160 (
    name: Primeiro acesso
    title: Primeiro acesso
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 500px
        height: 650px
        cssClasses: [
            modal
            modal_primeiro_acesso
        ]
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region primeiro-acesso (
        name: Primeiro acesso
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
            columnAttributes: align="center"
        }
        appearance {
            template: @/login
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
            cssClasses: primeiro_acesso
            icon: fa-info-circle
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P160_IDUSUARIO (
        type: numberField
        label {
            label: ID do seu usuário
            alignment: left
        }
        settings {
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @primeiro-acesso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: [
                input
                input100P
            ]
            width: 30
            valuePlaceholder: Aqui você deve informar o ID que você anotou no aviso do sistema antigo!
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P160_NOVASENHA (
        type: password
        label {
            label: Nova Senha
            alignment: left
        }
        layout {
            sequence: 30
            region: @primeiro-acesso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: [
                input
                input100P
            ]
            width: 30
            valuePlaceholder: Aqui você informa a sua nova senha. Com letras e números!
        }
        sessionState {
            storage: request
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P160_USUARIO (
        type: textField
        label {
            label: Usuário
            alignment: left
        }
        layout {
            sequence: 10
            region: @primeiro-acesso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: [
                input
                input100P
            ]
            width: 30
            valuePlaceholder: Coloque aqui o seu nome de usuário.
        }
        security {
            encryptSessionState: false
        }
    )

    button trocarsenha (
        buttonName: TROCARSENHA
        label: Trocar Senha
        layout {
            sequence: 40
            region: @primeiro-acesso
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
            cssClasses: btn_black
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation verifica-usuário (
        name: Verifica usuário
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios
                where usuario = upper(:P160_USUARIO)
                  and idusuario = :P160_IDUSUARIO
                ```
        }
        error {
            errorMessage: Usuário/ID incorreto!
            displayLocation: inlineWithField
            associatedItem: @P160_USUARIO
        }
    )

    process alterar-senha (
        name: alterar senha
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                 vpossui varchar2(1);
                  vexiste  varchar2(1);
                begin
                  Begin
                    --
                    select 'S'
                    into vexiste
                    from all_users a
                    where a.username = upper(:P160_USUARIO);
                    --
                    execute immediate 'alter user '||upper(:P160_USUARIO)||' identified by "'||:P160_NOVASENHA||'"';
                    --
                  exception
                    when others then
                       execute immediate 'create user '||upper(:P160_USUARIO)||' identified by "'||:P160_NOVASENHA||'"';
                  end;
                
                  begin
                    --
                    select 'S'
                    into vpossui
                    from dual
                    where exists (select 1
                                  from usuariossistemas 
                                  where usuario = upper(:P160_USUARIO) 
                                    and idsistema = 2001);
                  exception
                    when others then
                      vpossui := 'N';
                  end;
                  --
                  if vpossui = 'N' then
                    --
                    begin
                        insert into usuariossistemas (idusuariosistema,idsistema,usuario,ativo)
                        values (seq_idusuariossistema.nextval, 2001, upper(:P160_USUARIO), 'S');
                    exception
                      when others then
                        null;
                    end;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Senha alterada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 30206322531757087
        }
    )

    branch (
        name: Fazer login
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 101
                action: resetPagination
            }
        }
    )

)

