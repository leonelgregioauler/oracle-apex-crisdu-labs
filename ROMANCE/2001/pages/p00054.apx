page 54 (
    name: Lista de Telas
    title: Lista de Telas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 40
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region lista-de-telas (
        name: Lista de Telas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idaplicacao
                      ,descricao
                      ,hierarquia
                      ,decode( hierarquia , null , '<b>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao) ||'</b>'
                                                 , DECODE(LEVEL , 2 , '<i>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>'
                                                                , 3 , '<i>'||LPAD('-> ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>') ) nivel_hierarquico
                      , aparecer
                      , usadonapagina
                      , (select tc.descricao from roman.tiposcontrolesaplicacoes tc where tc.idtiposcontroles = aux.idtiposcontroles) Tipocontrole
                      , observacao
                      , pagina
                  from ( select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                              , a.aparecer
                              , a.usadonapagina
                              , a.idtiposcontroles
                              , a.observacao
                              , a.pagina
                         from aplicacoes a 
                         where a.idsistema = :P54_SISTEMA
                         union
                         select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                              , a.aparecer
                              , a.usadonapagina
                              , a.idtiposcontroles
                              , a.observacao
                              , a.pagina
                         from aplicacoes a 
                         where a.idsistema = :P54_SISTEMA
                           and a.hierarquia is null
                         ORDER BY IDAPLICACAO) aux
                 start with hierarquia is null
                connect by prior idaplicacao = hierarquia
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 56
                items: {
                    P56_IDAPLICACAO: #IDAPLICACAO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column APARECER (
            type: plainText
            heading {
                heading: Aparecer
                alignment: center
            }
            layout {
                sequence: 16
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descricao
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: DESCRICAO
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column HIERARQUIA (
            type: plainText
            heading {
                heading: Hierarquia
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: HIERARQUIA
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDAPLICACAO (
            type: plainText
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDAPLICACAO
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column NIVEL_HIERARQUICO (
            type: plainText
            heading {
                heading: Aplicação
                alignment: center
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: NIVEL_HIERARQUICO
                endUserAlias: F
            }
            enableUsersTo {
                pivot: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 56
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column PAGINA (
            type: plainText
            heading {
                heading: Página
                alignment: center
            }
            layout {
                sequence: 26
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column TIPOCONTROLE (
            type: plainText
            heading {
                heading: Tipo Controle
                alignment: center
            }
            layout {
                sequence: 46
            }
            source {
