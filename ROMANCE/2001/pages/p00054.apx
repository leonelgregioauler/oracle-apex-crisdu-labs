        )

        savedReport 1439558 (
            visibility: primaryDefault
            view {
                rowsPerPage: 1000
            }

            displayColumn APARECER (
                sequence: 2
            )

            displayColumn IDAPLICACAO (
                sequence: 3
            )

            displayColumn NIVEL_HIERARQUICO (
                sequence: 1
            )

            displayColumn OBSERVACAO (
                sequence: 6
            )

            displayColumn PAGINA (
                sequence: 4
            )

            displayColumn TIPOCONTROLE (
                sequence: 5
            )

            displayColumn USADONAPAGINA (
                sequence: 7
            )

        )

    )

    pageItem P54_SISTEMA (
        type: selectList
        label {
            label: Sistema
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Optimus Romance 2001;2001,Optimus Favorita 2000;2000,Optimus Financeiro 2650;2600
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: static
            staticValue: 2001
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Nova Aplicação
        layout {
            sequence: 30
            region: @lista-de-telas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 56
                clearCache: 56
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

