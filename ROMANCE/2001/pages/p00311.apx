    region notas-adicionais (
        name: Notas Adicionais
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select na.idnotaadicional 
                 , na.idrepresentante
                 , na.idvendedora
                 , na.idnotaadicionalnetsys
                 , na.data
                 , na.semana
                 , '<a href="javascript: deletaadicional('||idnotaadicional||')"> Excluir </a>' remover
                from roman.notasadicionais na
                where na.idnotavenda = :P311_IDNOTAVENDA
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
