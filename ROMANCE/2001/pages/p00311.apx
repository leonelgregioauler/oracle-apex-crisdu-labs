page 311 (
    name: Notas/Itens Adicionais
    title: Notas/Itens Adicionais
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function deletaadicional(pid)
            {
              document.getElementById('P311_DELETAR').value = pid;
                
              var answer = confirm("Confirma exlusão da Nota Adicional?");
              if (answer)
                {
                  apex.submit('REMOVER');
                }
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region itens-adicionais (
        name: Itens Adicionais
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ia.iditemnotaadicional
                 , pck_romance.fnc_nomeprodutoestoque(ia.idestoquefil) produto
                 , ia.quantidade
                 , ia.iditemnotaadicionalnetsys
                from roman.itensnotasadicionais ia
                where exists ( select 1
                               from roman.notasadicionais na
                               where na.idnotaadicional = ia.idnotaadicional
                                 and na.idnotavenda = :P311_IDNOTAVENDA)
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            includeSearchBar: false
        }
