            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    process remove-adicional (
        name: Remove Adicional
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_sincronizacao.prc_removenotaadicional(pidnotaadicional => :P311_DELETAR);
                  --
                  :P311_DELETAR := null;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Nota Adicional removida com sucesso!
        }
        advanced {
            executionMappingIdentifier: 93226891954132830
        }
        serverSideCondition {
            type: request=Value
            value: REMOVER
        }
    )

    branch (
        name: Go To Page 37
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 37
                items: {
                    P37_IDNOTAVENDA: &P311_IDNOTAVENDA.
                }
                action: resetPagination
            }
        }
    )

)

