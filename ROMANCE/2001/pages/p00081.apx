                    page: 617
                    items: {
                        P617_IDDETALHEDESPESA: #IDDETALHEDESPESA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            sorting {
                sortable: false
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Incluído Por
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P81_AVISO_QUESTIONAMENTO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @avisos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="Blue"><h2> Você possui '||count(1)||' questionamento(s) pendente(s) de leitura! </font></h2>' display_value
                from questionamentoscontroladoria q
                where q.confirmacaoleitura = 'N'
                  and ( ( q.idpessoa = ( select idpessoa
                                         from usuarios u
                                         where u.usuario = v('APP_USER') ) )
                     or ( q.idfilial = :P0_IDFILIAL and exists ( select 1
                                                                 from usuarios u
                                                                    , gerentes g
                                                                 where u.idpessoa = g.idpessoa 
                                                                   and u.usuario = v('APP_USER') ) ) )
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button confirmardespesas (
        buttonName: CONFIRMARDESPESAS
        label: Confirmar Despesas
        layout {
            sequence: 30
            region: @despesas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 83
                items: {
                    P83_IDFECHAMENTO: &P82_IDFECHAMENTO.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button criar-detalhe (
        buttonName: CRIAR_DETALHE
        label: Criar Detalhe
        layout {
            sequence: 10
            region: @detalhes-de-despesas-da-unidade
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 617
                items: {
                    P617_DETALHE:
                    P617_IDDETALHEDESPESA:
                    P617_IDFILIAL: &P0_IDFILIAL.
                    P617_MD5:
                    P617_USUARIO: &P0_USUARIO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novadespesa (
        buttonName: Novadespesa
        label: Nova Despesa
        layout {
            sequence: 40
            region: @despesas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 82
                items: {
                    P82_IDFECHAMENTO: &P0_IDFECHAMENTO.
                    P82_IDFILIAL: &P0_IDFILIAL.
                    P82_IDDESPESA:
                    P82_IDMATRIZCLASSIFICACAO:
                    P82_IDCONTACONTABIL:
                    P82_IDSUBCONTACONTABIL:
                }
                clearCache: 82
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais
                where idfechamento = :P0_IDFECHAMENTO
                  and concluido = 'N'
                ```
        }
    )

    button novo-questionamento (
        buttonName: NOVO_QUESTIONAMENTO
        label: Novo Questionamento
        layout {
            sequence: 10
            region: @despesas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 389
                items: {
                    P389_QUESTIONAMENTO:
                    P389_PAGINA: 81
                    P389_IDFECHAMENTO: &P0_IDFECHAMENTO.
                    P389_IDQUESTIONAMENTO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento in ( 2 , 0 )
                  and ug.usuario = v('APP_USER')
                  and :P0_IDFECHAMENTO is not null
                ```
        }
    )

    button revisardespesas (
        buttonName: REVISARDESPESAS
        label: Revisar Despesas
        layout {
            sequence: 20
            region: @despesas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 162
                items: {
                    P162_ORIGEMD: D
                }
                clearCache: 162
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2309,v('APP_USER') ) = 'S'
                ```
        }
    )

)

