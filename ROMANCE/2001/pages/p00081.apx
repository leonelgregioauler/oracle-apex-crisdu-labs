    region acompanhamento-de-despesas (
        name: Acompanhamento de Despesas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util.fnc_semanaid(a.idsemana) semana
                     , a.total
                     , a.valor
                     , a.totalfixa
                     , a.valorfixa
                     , a.totalvariavel
                     , a.valorvariavel
                     , a.percfixa "% Fixa"
                     , a.percvariavel "% Variavel"
                     , a.totalcobranca
                     , round((nvl(a.valorfixa,1)/a.totalcobranca*100),2) percgeralfixa
                     , round((nvl(a.valorvariavel,1)/a.totalcobranca*100),2) percgeralvariavel
                from ( select f.idsemana
                            , (w.fixa + w.variavel) total
                            , to_char(w.valor_total,'999G999G999G999G990D00') valor
                            , w.fixa totalfixa
                            , w.valor_fixa valorfixa
                            , w.variavel totalvariavel
                            , w.valor_variavel valorvariavel
                            , to_char((w.valor_fixa/w.valor_total)*100,'999G999G999G999G990D00') percfixa
                            , to_char((w.valor_variavel/w.valor_total)*100,'999G999G999G999G990D00') percvariavel
                            , w.valor_total totalcobranca
                       from fechamentossemanais f
                          , vw_acomp_despesas w
                       where f.idfechamento = w.idfechamento
                         and f.idfilial = :P0_IDFILIAL
                         and 1 = 2
                       order by f.idsemana desc ) a
                where rownum <= 6
                order by a.idsemana desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: 0
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1427698939082767442
        }

