    region detalhes-de-despesas-da-unidade (
        name: Detalhes de Despesas da Unidade
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddetalhedespesa
                     , d.idfilial
                     , d.data
                     , d.usuario
                     , d.detalhe
                from detalhesdespesasfiliais d
                where d.idfilial = :P0_IDFILIAL
                order by d.data
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
