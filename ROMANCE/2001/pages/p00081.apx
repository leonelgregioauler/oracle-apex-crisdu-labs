    region avisos (
        name: Avisos
        type: staticContent
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from questionamentoscontroladoria q
                where q.confirmacaoleitura = 'N'
                  and ( ( q.idpessoa = ( select idpessoa
                                         from usuarios u
                                         where u.usuario = v('APP_USER') ) )
                     or ( q.idfilial = :P0_IDFILIAL and exists ( select 1
                                                                 from usuarios u
                                                                    , gerentes g
                                                                 where u.idpessoa = g.idpessoa 
                                                                   and u.usuario = v('APP_USER') ) ) )
                ```
        }
    )

    region despesas (
        name: Despesas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select editar
                     , roman.pck_romance.fnc_nomefilial(t.idfilial) Franquia
                     , IDDESPESA
                     , ano
                     , semana
                     , Cliente
                     , IDFECHAMENTOREPRES
                     , IDCONTACONTABIL
                     , IDSUBCONTACONTABIL
                     , t.OBSERVACAO
                     , fechamento
                     , VALOR
                     , t.IDFILIAL
                     , t.IDFECHAMENTO
                     , emmaos
                     , DESCRICAOORIGEM 
                     , t.revisao "Revisão" 
                     , t.datavencimento
                     , case 
                         when t.idmovimentotogeral is not null then
                           ( select count(1)
                             from roman.saidasdiversas s
                                , roman.movimentosgeral m
                                , roman.anexossaidas a
                             where m.idmovimentogeral = t.idmovimentotogeral 
                               and s.idsaida          = m.idsaidadiversa
                               and a.idsaida          = s.idsaida )
                         else
                           qtdanexos
                       end qtdanexos
                     , case
                         when exists ( select 1
                                       from roman.subcontasfinanceiras s
                                       where s.idsubcontafinan = ( select d.idsubcontacontabil
                                                                   from roman.despesas d
                                                                   where d.iddespesa = t.IDDESPESA ) 
                                         and s.tipo is not null ) and IDSUBCONTACONTABIL is not null then
                           ( select decode(s.tipo,'F','Fixa','V','Variável')
                             from roman.subcontasfinanceiras s
                             where s.idsubcontafinan = ( select d.idsubcontacontabil
                                                         from roman.despesas d
                                                         where d.iddespesa = t.IDDESPESA ) )
                         else
                           ( select decode(c.tipo,'F','Fixa','V','Variável')
                             from roman.contasfinanceiras c
                             where c.idcontafinan = ( select d.idcontacontabil
                                                      from roman.despesas d
                                                      where d.iddespesa = t.IDDESPESA )
                               and c.tipo is not null )
                       end tipo
                     , matrizclassificacao
                     , t.datalancamento
                     , t.usuario
                     , (select cnpj
                          from razoessociaisfiliais
                         where idrazaosocialfilial = t.idrazaosocialfilial) "CNPJ Despesa"
                from roman.vw_despesas_distribuidoras t
                where t.idfilial     = :P0_IDFILIAL
                  and (:P0_IDFECHAMENTO = 999999999999 or t.idfechamento = :P0_IDFECHAMENTO )
                ```
        }
        layout {
            sequence: 40
            slot: body-3
        }
