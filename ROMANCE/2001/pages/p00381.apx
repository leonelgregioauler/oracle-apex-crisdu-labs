    region categoria (
        name: Categoria
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomecategoria(c.idcategoria) categoria
                     , '|' separador
                     , sum(nvl(prod.qtdbalancoinicial,0)) qtdbalancoinicial
                     , sum(nvl(prod.valorbalancoinicial,0)) valorbalancoinicial
                     , '+' seq_balanco
                     , sum(nvl(prod.carga,0)) carga
                     , sum(nvl(prod.vlrcarga,0)) vlrcarga
                     , '-' sep_devol
                     , sum(nvl(prod.devolucao,0)) devolucao
                     , sum(nvl(prod.vlrdevolucao,0)) vlrdevolucao
                     , '-' sep_vend
                     , sum(nvl(prod.vendido,0)) vendido
                     , sum(nvl(prod.vlrvendido,0)) vlrvendido
                     , '-' sep_foiparaoutro
                     , sum(nvl(prod.qtddevolveufoioutro,0)) qtddevolveufoioutro
                     , sum(nvl(prod.valordevolveufoioutro,0)) valordevolveufoioutro
                     , '+' sep_veiodeoutro
                     , sum(nvl(prod.qtddevolveuveiooutros,0)) qtddevolveuveiooutros
                     , sum(nvl(prod.valordevolveuveiooutros,0)) valordevolveuveiooutros
                     , '-' sep_aberto
                     , sum(nvl(prod.acobrar,0)) acobrar
                     , sum(nvl(prod.vlrcobrar,0)) vlrcobrar
                     , '=' sep_resultado
                     , sum(nvl(prod.qtdresultado,0)) qtdresultado
                     , sum(nvl(prod.vlrresultado,0)) vlrresultado
                from categorias c
                   , ( select idcategoria
                            , qtdbalancoinicial
                            , case
                                when charcomissao = 'N' then
                                  valorbalancoinicial
                                when charcomissao = 'S' then
                                  ( valorbalancoinicial * 0.65 )
                              end valorbalancoinicial
                            , carga
                            , case
                                when charcomissao = 'N' then
                                  vlrcarga
                                when charcomissao = 'S' then
                                  ( vlrcarga * 0.65 )
                              end vlrcarga
                            , devolucao
                            , case
                                when charcomissao = 'N' then
                                  vlrdevolucao
                                when charcomissao = 'S' then
                                  ( vlrdevolucao * 0.65 )
                              end vlrdevolucao
                            , vendido
                            , case
                                when charcomissao = 'N' then
                                  vlrvendido
                                when charcomissao = 'S' then
                                  ( vlrvendido * 0.65 )
                              end vlrvendido
                            , qtddevolveufoioutro 
                            , case
                                when charcomissao = 'N' then
                                  valordevolveufoioutro
                                when charcomissao = 'S' then
                                  ( valordevolveufoioutro * 0.65 )
                              end valordevolveufoioutro
                            , qtddevolveuveiooutros 
                            , case
                                when charcomissao = 'N' then
                                  valordevolveuveiooutros
                                when charcomissao = 'S' then
                                  ( valordevolveuveiooutros * 0.65 )
                              end valordevolveuveiooutros
                            , acobrar
                            , case
                                when charcomissao = 'N' then
                                  vlracobrar
                                when charcomissao = 'S' then
                                  ( vlracobrar * 0.65 )
                              end vlrcobrar
                            , ( qtdbalancoinicial
                              + carga
                              - devolucao
                              - vendido
                              - qtddevolveufoioutro
                              + qtddevolveuveiooutros
                              - acobrar ) qtdresultado
                            , case
                                when charcomissao = 'N' then
                                  ( nvl(valorbalancoinicial,0)
                                  + nvl(vlrcarga,0)
                                  - nvl(vlrdevolucao,0)
                                  - nvl(vlrvendido,0)
                                  - nvl(valordevolveufoioutro,0)
                                  + nvl(valordevolveuveiooutros,0)
                                  - nvl(vlracobrar,0) ) 
                                when charcomissao = 'S' then
                                  ( nvl(valorbalancoinicial*0.65,0)
                                  + nvl(vlrcarga*0.65,0)
                                  - nvl(vlrdevolucao*0.65,0)
                                  - nvl(vlrvendido*0.65,0)
                                  - nvl(valordevolveufoioutro*0.65,0)
                                  + nvl(valordevolveuveiooutros*0.65,0)
                                  - nvl(vlracobrar*0.65,0) ) 
                              end vlrresultado
                       from vw_balancoprodutos_repres w
                       where w.idrepresentante = :P381_IDREPRESENTANTE ) prod
                where prod.idcategoria(+) = c.idcategoria
                group by c.idcategoria 
                order by 1
                ```
        }
        layout {
            sequence: 60
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent11
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P381_TIPO
            value: C
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1504160212758056828
        }

