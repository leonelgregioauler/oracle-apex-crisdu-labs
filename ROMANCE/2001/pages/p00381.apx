        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

    button confirmar (
        buttonName: CONFIRMAR
        label: Confirmar
        layout {
            sequence: 30
            region: @iniciar-balanço
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button p381-filtrar (
        buttonName: P381_FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtro
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: P209_FILTRAR
        }
    )

    button p381-iniciarnovobalanco (
        buttonName: P381_INICIARNOVOBALANCO
        label: Iniciar Novo Balanço
        layout {
            sequence: 10
            region: @filtro
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: openModal('INICIARBALANCO');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P381_IDREPRESENTANTE
        }
    )

    button p381-verbalancoatual (
        buttonName: P381_VERBALANCOATUAL
        label: Ver Balanço Inicial Atual
        layout {
            sequence: 20
            region: @filtro
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 403
                items: {
                    P403_IDREPRESENTANTE: &P381_IDREPRESENTANTE.
                    P403_PAGINA: 381
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P381_IDREPRESENTANTE
        }
    )

    button p381-vercadastro (
        buttonName: P381_VERCADASTRO
        label: Ver Cadastro
        layout {
            sequence: 30
            region: @filtro
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 135
                items: {
                    P135_IDREPRESENTANTE: &P381_IDREPRESENTANTE.
                    P135_PAGINA: 381
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P381_IDREPRESENTANTE
        }
    )

    dynamicAction confirma-balanço (
        name: Confirma Balanço
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @confirmar
        }

        action native-confirm (
            action: confirm
            settings {
                message:
                    ```html
                    Confirma o Balanço deste distribuidor?
                    
                    Isto pode demorar alguns minutos.
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CONFIRMABALANCO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction filtrar (
        name: filtrar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @p381-filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction filtro (
        name: filtro
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P381_FILTRO
        }
        clientSideCondition {
            type: item=value
            item: P381_FILTRO
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P381_IDREPRESENTANTE
                    P381_TIPO
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P381_IDREPRESENTANTE
                    P381_TIPO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    validation valida-semana (
        name: Valida Semana
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P381_IDSEMANA
        }
        error {
            errorMessage: Informe a Semana!
            associatedItem: @P381_IDSEMANA
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMABALANCO
        }
    )

    process confirma-balanço (
        name: Confirma Balanço
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_balanco_rmc.prc_iniciabalanco(pidrepresentante => :P381_IDREPRESENTANTE,
                                                pidsemana => :P381_IDSEMANA);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1500821860466377542
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMABALANCO
        }
    )

    branch (
        name: filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 381
                items: {
                    P381_FILTRO: &P381_FILTRO.
                    P381_IDREPRESENTANTE: &P381_IDREPRESENTANTE.
                    P381_TIPO: &P381_TIPO.
                    P381_QTD_VALOR: &P381_QTD_VALOR.
                }
                successMessage: false
            }
        }
    )

)

