    region produto (
        name: Produto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ first_rows (50) */ produto
                     , ativo
                     , comissao
                     , vlrvenda
                     , '|' separador
                     , qtdbalancoinicial
                     , case
                         when charcomissao = 'S' then
                           ( valorbalancoinicial * 0.65 )
                         when charcomissao = 'N' then
                           valorbalancoinicial 
                       end valorbalancoinicial
                     , '+' sep_balancoinicial
                     , carga
                     , case
                         when charcomissao = 'S' then
                           ( vlrcarga * 0.65 )
                         when charcomissao = 'N' then
                           vlrcarga
                       end vlrcarga
                     , '-' sep_devol
                     , devolucao
                     , case
                         when charcomissao = 'S' then
                           ( vlrdevolucao * 0.65 )
                         when charcomissao = 'N' then
                           vlrdevolucao
                       end vlrdevolucao
                     , '-' sep_vend
                     , vendido
                     , case
                         when charcomissao = 'S' then
                           ( vlrvendido * 0.65 )
                         when charcomissao = 'N' then
                           vlrvendido
                       end vlrvendido
                     , '-' sep_foiparaoutro
                     , qtddevolveufoioutro
                     , case
                         when charcomissao = 'S' then
                           ( valordevolveufoioutro * 0.65 )
                         when charcomissao = 'N' then
                           valordevolveufoioutro
                       end valordevolveufoioutro
                     , '+' sep_veiodeoutro
                     , qtddevolveuveiooutros
                     , case
                         when charcomissao = 'S' then
                           ( valordevolveuveiooutros * 0.65 )
                         when charcomissao = 'N' then
                           valordevolveuveiooutros
                       end valordevolveuveiooutros
                     , '-' sep_aberto
                     , acobrar
                     , case
                         when charcomissao = 'S' then
                           ( vlracobrar * 0.65 )
                         when charcomissao = 'N' then
                           vlracobrar
                       end vlracobrar
                     , '=' sep_result
                     , ( qtdbalancoinicial
                       + carga
                       - devolucao
                       - vendido
                       - qtddevolveufoioutro
                       + qtddevolveuveiooutros
                       - acobrar ) qtdresultado
                     , case
                         when charcomissao = 'N' then
                           ( nvl(vlrcarga,0)
                           - nvl(vlrdevolucao,0)
                           - nvl(vlrvendido,0)
                           - nvl(valordevolveufoioutro,0)
                           + nvl(valordevolveuveiooutros,0)
                           - nvl(vlracobrar,0) ) 
                         when charcomissao = 'S' then
                           ( nvl(vlrcarga*0.65,0)
                           - nvl(vlrdevolucao*0.65,0)
                           - nvl(vlrvendido*0.65,0)
                           - nvl(valordevolveufoioutro*0.65,0)
                           + nvl(valordevolveuveiooutros*0.65,0)
                           - nvl(vlracobrar*0.65,0) ) 
                       end vlrresultado
                from vw_balancoprodutos_repres w
                where idrepresentante = :P381_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 50
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent13
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P381_TIPO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1501359288622848348
        }

