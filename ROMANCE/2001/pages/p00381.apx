    region balanço-resumido-v (
        name: Balanço Resumido v2.0
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distribuidor
                     , w.idrepresentante
                     , pck_util.fnc_semanaid(w.idsemanabalanco) semana
                     , sum(nvl(QTDINICIALBALANCO  ,0)) qtdbalancoinicial
                     , sum(nvl(valorinicialbalanco,0)) balancoinicial
                     , '+' s0
                     , sum(carga                ) carga
                     , sum(valorcarga           ) valorcarga
                     , '-' s1               
                     , sum(devolucao            ) devolucao
                     , sum(valordevolucao       ) valordevolucao
                     , '-' s2               
                     , sum(vendeu               ) vendeu
                     , sum(valorvendeu          ) valorvendeu
                     , '-' s3               
                     , sum(emaberto             ) emaberto
                     , sum(valoremaberto        ) valoremaberto
                     , '+' s6
                   , sum(qtddevolveuveiooutros)   qtddevolveuveiooutros
                   , sum(valordevolveuveiooutros) valordevolveuveiooutros
                     , '-' s7
                    , sum(qtddevolveufoioutro)    qtddevolveufoioutro
                    , sum(valordevolveufoioutro)  valordevolveufoioutro
                     , '=' s4               
                     , sum(faltadevolver        ) faltadevolver
                     , sum(w.valorfaltadevolver ) valorfaltadevolver
                     , '|' s5               
                     , sum(w.debitos) debitos
                     , sum(w.debitoscobrados) debitoscobrados
                     , sum(w.debitossetorcobranca) debitossetorcobranca
                from vw_balanco_romance_v2 w
                where ( ( :P381_FILTRO = 'R' and w.idrepresentante = :P381_IDREPRESENTANTE )
                      or  :P381_FILTRO = 'T' )
                  and w.idgerente = ( select idgerente 
                                      from gerentes
                                      where idfilial = :P0_IDFILIAL )
                group by distribuidor, w.idsemanabalanco
                     , w.idrepresentante
                
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P381_TIPO = 'R'
        }
        link {
            linkColumn: customTarget
