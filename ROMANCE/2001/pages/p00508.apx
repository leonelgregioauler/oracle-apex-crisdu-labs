page 508 (
    name: Lista de Tablets por Distribuidor
    title: Lista de Tablets por Distribuidor
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 80%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region lista-de-tablets-por-distribuidor (
        name: Lista de Tablets por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(r.idrepresentante) ) empresa
                     , pck_romance.fnc_nomerepresentante(r.idrepresentante) "Distribuidor"
                     , count(1) "Qtd Tablets"
                     , listagg(e.nome||' - '||
                               case 
                                 when lower(e.informacoes) like 'trocar%' then
                                      '<font color="red">'
                                 when lower(e.informacoes) = 'ok' then
                                      '<font color="green">'
                                 else
                                      '<font color="blue">'
                                 end
                                      ||e.informacoes
                                      ||'</font>'
                                ||' Android '||e.versao
                                ||' Cadastrado dia ' ||to_char(e.datacadastro,'DD/MM/RRRR HH24:MI:SS')
                                ||'<br>') within group (order by 1) tablets
                from representantes r
                   , usuarios u          
                   , equipamentos e
                where r.idpessoa = u.idpessoa
                  and r.ativo    = 'S'        
                  and e.usuario = u.usuario
                  and e.idtipoequipamento = 0
                  and e.situacao = 'U' 
                  and ( select count(1)
                        from regioesrepresentantes rg
                        where rg.idrepresentante = r.idrepresentante ) > 1
                  /*and exists ( select 1
                               from equipamentos e
                               where e.idtipoequipamento = 0
                                 and e.usuario = u.usuario
                                 and e.situacao = 'U' ) */
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = r.idpessoa ) 
                  and (:P0_IDFILIAL = -1 or  pck_romance.fnc_filialrepresentante(r.idrepresentante) = :P0_IDFILIAL  )
                group by r.idrepresentante
                       , pck_romance.fnc_filialrepresentante(r.idrepresentante) 
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 6978788773964106451
        }

        column Distribuidor (
            type: plainText
            heading {
                heading: Distribuidor
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column "Qtd Tablets" (
            type: plainText
            heading {
                heading: Qtd Tablets
                alignment: end
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column TABLETS (
            type: plainText
            heading {
                heading: Tablets
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 34933270 (
            visibility: primaryDefault
            view {
                rowsPerPage: 1000
            }

            displayColumn "Distribuidor" (
                sequence: 2
            )

            displayColumn EMPRESA (
                sequence: 1
            )

            displayColumn "Qtd Tablets" (
                sequence: 3
            )

            displayColumn TABLETS (
                sequence: 4
            )

            sort (
                column: "Distribuidor"
                sort {
                    sequence: 1
                }
            )

            controlBreak (
                column: EMPRESA
                layout {
                    sequence: 1
                }
            )

        )

    )

    region placar-de-tablets (
        name: Placar de Tablets
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select informacoes
                     , count(1) QTD
                from representantes r
                   , usuarios u      
                   , equipamentos e
                where r.idpessoa = u.idpessoa
                  and r.ativo    = 'S'
                  and e.usuario = u.usuario
                  and e.idtipoequipamento = 0
                  and e.situacao = 'U'             
                  and e.idfilial = :P0_IDFILIAL
                   and ( select count(1)
                        from regioesrepresentantes rg
                        where rg.idrepresentante = r.idrepresentante ) > 1
                  and exists ( select count(1)
                               from equipamentos e
                               where e.idtipoequipamento = 0
                                 and e.usuario = u.usuario
                                 and e.situacao = 'U' ) 
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = r.idpessoa )       
                group by e.idfilial, informacoes
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: INFORMACOES
            valueColumn: QTD
            color: yes
        }
    )

)

