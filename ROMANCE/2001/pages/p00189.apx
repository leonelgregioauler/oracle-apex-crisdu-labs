    region débitos-pagos (
        name: Débitos Pagos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(n.idvendedora) consultora
                     , p.datapagamento
                     , p.valorpago
                     , n.numeronota     
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||p.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' url
                     , ( select listagg(to_char(pg.valorpago,'FML999G999G999G999G990D00')||' - '||decode(pg.usuarioalteracao,'APEX_PUBLIC_USER','Netbook',pg.usuarioalteracao),' ') within group (order by 1)
                         from logroman.log_pagamentosnotasvendas pg
                         where pg.idpagtonotavenda = p.idpagtonotavenda) "Origem Pagamento(s)"
                from pagamentosnotasvendas p
                   , notasvendas n 
                where p.semanacobranca =  trim(:P189_SEMANA)
                  and p.idnotavenda = n.idnotavenda
                  and  n.idrepresentante = :P189_IDREPRESENTANTE 
                     --   or n.idrepresentanteatende = :P189_IDREPRESENTANTE)
                  and n.semanacobranca != trim(:P189_SEMANA) 
                  and p.origem = 'R'
                order by 1    
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
