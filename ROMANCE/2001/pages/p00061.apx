page 61 (
    name: Relatório para Pagamentos Distribuidor
    title: Relatório para Pagamentos Distribuidor
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region vendas-para-distribuidor (
        name: Vendas para Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select p.nomepessoa from pessoas p, filiais f where p.idpessoa = f.idpessoa and f.idfilial = m.idfilial ) "Filial"
                     , razaosocial 
                      ||', '|| endereco
                      ||', '|| bairro
                      ||' - '||cep
                      ||' - '||( select nomecidade||' - '||sigla from cidades c, estados e where c.idestado = e.idestado and c.idcidade = m.idcidade) 
                      ||' ['|| m.cnpj||'] ' "MEI"
                     , m.idmei 
                     , nvl(( select sum(pp.valorpago) from pagamentosmei pp where pp.idmei = m.idmei and to_char(pp.datapagamento,'RRRR') = to_char(sysdate,'RRRR') ),0) "Valor Pago"
                from mei m
                where 50000 - nvl(( select sum(pp.valorpago) from pagamentosmei pp where pp.idmei = m.idmei and to_char(pp.datapagamento,'RRRR') = to_char(sysdate,'RRRR') ),0) > 0
                  and m.ativo = 'S'
                  and idfilial = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 62
                items: {
                    P62_IDMEI: #IDMEI#
                    P62_IDPAGAMENTOMEI:
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhum cliente cadastrado.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column Filial (
            type: plainText
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Filial
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDMEI (
            type: plainText
            heading {
                heading: Idmei
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDMEI
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column MEI (
            type: plainText
            heading {
                heading: Mei
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: MEI
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Valor Pago" (
            type: plainText
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: Valor_Pago
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 1457850 (
            visibility: primaryDefault
            view {
                rowsPerPage: 200
            }

            displayColumn "Filial" (
                sequence: 1
            )

            displayColumn MEI (
                sequence: 2
            )

            displayColumn "Valor Pago" (
                sequence: 3
            )

            sort (
                column: MEI
                sort {
                    sequence: 1
                }
            )

            controlBreak (
                column: "Filial"
                layout {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 30
            region: @vendas-para-distribuidor
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 170
                clearCache: 170
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

)

