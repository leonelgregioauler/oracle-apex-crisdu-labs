page 339 (
    name: Anexos de Saídas
    title: Anexos de Saídas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P339_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos-de-saídas (
        name: Anexos de Saídas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     --, '<a href="javascript: fnc_verimg('''||idsaida||idanexosaida||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' link
                     --, idsaida||idanexosaida||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , url_bucket link
                     , dataanexo
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     , '<a href="javascript: fnc_removeanexo('||idanexosaida||','''||t.nomearquivo||''');">Remover</a>' remover
                     , APEX_ITEM.CHECKBOX2(1, idsaida , NULL ) visto
                from anexossaidas t
                where idsaida = :P339_IDSAIDA
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P339_IDSAIDA
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 767066869034495609
        }

        column DATAANEXO (
            type: plainText
            heading {
                heading: Data Anexo
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column LINK (
            type: link
            heading {
                heading: Link
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: #LINK#
                }
                linkText: Ver anexo
                linkAttributes: target="_blank"
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEARQUIVO (
            type: plainText
            heading {
                heading: Arquivo
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column REMOVER (
            type: plainText
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Anexado Por
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column VISTO (
            type: plainText
            heading {
                heading: Visto
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
            security {
                escapeSpecialChars: false
            }
        )

        savedReport 7797095 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAANEXO (
                sequence: 3
            )

            displayColumn LINK (
                sequence: 2
            )

            displayColumn NOMEARQUIVO (
                sequence: 1
            )

            displayColumn REMOVER (
                sequence: 5
            )

            displayColumn USUARIO (
                sequence: 4
            )

            displayColumn VISTO (
                sequence: 6
            )

        )

    )

    pageItem P339_ARQUIVOTEMP (
