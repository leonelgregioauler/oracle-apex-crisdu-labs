    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 50
            region: @anexos-de-saídas
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P339_IDANEXOSAIDA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 10
            region: @anexos-de-saídas
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P339_IDANEXOSAIDA
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_saidas(pidsaida => :P339_IDSAIDA
                                                ,pidanexo => :P339_IDANEXOSAIDA);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 767066528151495606
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P339_IDANEXOSAIDA := null;
                  pck_anexos.prc_apagaanexo_saidas(pidanexosaida => :P339_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 767066666928495607
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexossaidas (
        name: Fetch Row from ANEXOSSAIDAS
        type: autoRowFetch
        source {
            tableName: ANEXOSSAIDAS
            pkColumn: IDANEXOSAIDA
            pkItem: P339_IDANEXOSAIDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 779695674559026432
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P339_IDANEXOSAIDA is null then
                        select "#OWNER#"."SEQ_IDANEXOSAIDA".nextval
                          into :P339_IDANEXOSAIDA
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 779696063288026432
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexossaidas (
        name: Process Row of ANEXOSSAIDAS
        type: autoRowProcessing
        target {
            tableName: ANEXOSSAIDAS
            pkColumn: IDANEXOSAIDA
            pkItem: P339_IDANEXOSAIDA
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Arquivo anexado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 779696496565026432
        }
    )

    branch (
        name: Go To Page 339
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 339
                items: {
                    P339_IDSAIDA: &P339_IDSAIDA.
                    P339_IDANEXOSAIDA:
                    P339_IDANEXODELETAR:
                }
                action: resetPagination
            }
        }
    )

)

