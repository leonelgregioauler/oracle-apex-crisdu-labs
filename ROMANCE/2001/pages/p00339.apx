        layout {
            sequence: 70
            region: @anexos-de-saídas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                begin
                  --
                  select idusuario 
                  into vidusuario 
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  return vidusuario;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

