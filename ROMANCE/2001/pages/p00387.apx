page 387 (
    name: Comissões Pendentes
    title: Comissões Pendentes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region comissões-pendentes (
        name: Comissões Pendentes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idpedido 
                     , nrpedido
                     , vendedora
                     , datavencimento
                     , valorcobrado
                     , comissao
                     , comissaogerente
                     , idrepresentante
                     , databaixa
                     , pck_romance.fnc_nomerepresentante(idrepresentante) Representante
                     , 'Distribuidor' tipocomissao
                     , null idvencimento
                from vw_comissoes_pagar t
                where idrepresentante = :P387_IDREPRESENTANTE
                  and :P387_IDREPRESENTANTE is not null
                  and t.comissao > 0
                  and not exists ( select 1 
                                   from pagamentocomissoes pp
                                   where pp.idpedido  = t.idpedido 
                                     and pp.idrepresentante is not null)
                union -------------sistema novo
                select distinct idpedido 
                     , numeropedido nrpedido
                     , vendedora
                     , ( select datavencimento 
                         from favorita.vencimentospedidos vp
                         where vp.idvencimentopedido = tf.idvencimentopedido )  datavencimento
                     , tf.valorapagar valorcobrado
                     , tf.comissaodistribuidor comissao
                     , comissaogerente
                     , idrepresentante
                     , databaixa
                     , Representante
                     , 'Distribuidor' tipocomissao
                     , idvencimentopedido idvencimento
                from favorita.VW_COMISSOESPAGAR_NOVA_M tf
                where idrepresentante = :P387_IDREPRESENTANTE
                  and :P387_IDREPRESENTANTE is not null
                  and tf.comissaodistribuidor > 0
                  and exists ( select 1
                               from controlepgtocomissoesped cp
                               where cp.idpedido = tf.idpedido
                                 and cp.fechado_repres = 'N' )
                  and not exists ( select 1 
                                   from pagamentocomissoes pp
                                   where pp.idpedido  = tf.idpedido 
                                     and pp.idvencimentopedido = tf.idvencimentopedido
                                     and pp.idrepresentante is not null )
                ```
            pageItemsToSubmit: P387_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma comissão pendente encontrada!
        }
        advanced {
            savedReportMappingIdentifier: 1425102886122362607
        }

