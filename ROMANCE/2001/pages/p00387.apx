    pageItem P387_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @comissões-pendentes
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P387_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' - '||decode(r.ativo,'N','Inativo','S','Ativo')  display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
