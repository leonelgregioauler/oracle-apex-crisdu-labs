            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button ir-para-acerto (
        buttonName: IR_PARA_ACERTO
        label: Ir para o Acerto
        layout {
            sequence: 30
            region: @comissões-pendentes
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 75
                items: {
                    P75_IDFECHAMENTOREPRES: &P387_IDFECHAMENTO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentorepresentantes f
                where f.idrepresentante = :P387_IDREPRESENTANTE
                  and f.idfechamentorepres = :P387_IDFECHAMENTO
                ```
        }
    )

    button pagar-comissao (
        buttonName: PAGAR_COMISSAO
        label: Preparar Pagamento de Comissão
        layout {
            sequence: 20
            region: @comissões-pendentes
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from favorita.vw_comissoes_pagar_fav
                               where idrepresentante = :P387_IDREPRESENTANTE
                               union
                               select 1
                               from vw_comissoes_pagar
                               where idrepresentante = :P387_IDREPRESENTANTE )
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = :P387_IDREPRESENTANTE 
                                 and r.ativo           = 'N' )
                  and exists ( select 1
                               from dual
                               where pck_util.fnc_verificaacesso(2410,v('APP_USER')) = 'S')
                ```
        }
    )

    process realiza-pagamento-de-comissões-pendentes (
        name: Realiza Pagamento de Comissões Pendentes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidfechamento number;
                  --
                  vexiste varchar2(1);
                  --
                  vidrepresentante number := :P387_IDREPRESENTANTE;
                  --
                  vidseq number := null;
                  --
                begin
                  --
                  begin 
                    --
                    select 'S'
                    into vexiste
                    from dual
                    where exists ( select 1
                                   from regioesrepresentantes r
                                   where r.idrepresentante = :P387_IDREPRESENTANTE);
                    --
                  exception
                    when others then
                      vexiste := 'N';
                  end;
                  --
                  if vexiste = 'N' then
                    --
                    select seq_idregiaorepresentante.nextval
                    into vidseq
                    from dual;
                    --
                    insert into regioesrepresentantes ( idregiaorepresentante
                                                      , idrepresentante
                                                      , idregiaovenda
                                                      , ordem
                                                      , semana
                                                      , idsemana )
                    select vidseq
                         , vidrepresentante
                         , r.idregiaovenda
                         , 1
                         , pck_util.fnc_semanaid(pck_util.fnc_idsemanadata(trunc(sysdate)))
                         , pck_util.fnc_idsemanadata(trunc(sysdate))
                    from regioesvenda r
                       , filiaisregioesvenda f
                    where f.idfilial = :P0_IDFILIAL
                      and r.idestado = f.idestado
                      and rownum = 1
                    order by r.idregiaovenda;
                    --
                    commit;
                    --
                  end if;
                  --
                  pck_acertosfechamento.prc_ajustarepresentante(pidrepresentante => :P387_IDREPRESENTANTE);
                  --
                  select max(f.idfechamentorepres)
                  into vidfechamento
                  from fechamentorepresentantes f
                  where f.idrepresentante = :P387_IDREPRESENTANTE;
                  --
                  :P387_IDFECHAMENTO := vidfechamento;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1425104561747362624
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'PAGAR_COMISSAO'
                  and :P387_IDREPRESENTANTE is not null
                ```
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 387
                items: {
                    P387_IDREPRESENTANTE: &P387_IDREPRESENTANTE.
                    P387_IDFECHAMENTO:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

