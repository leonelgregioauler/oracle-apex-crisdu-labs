    }

    region balanço (
        name: Balanço
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cod
                     , semana
                     , nome
                     , valorcargasemcomissao
                     , valorcargacomcomissao
                     , '|' s1
                     , valordevolucaosemcomissao
                     , valordevolucaocomcomissao
                     , '|' s2
                     , valorvendeusemcomissao
                     , valorvendeucomcomissao
                     , '|' s3
                     , valoremabertosemcomissao
                     , valoremabertocomcomissao
                     , '=' s4
                     , ( (valorcargasemcomissao + valorcargacomcomissao)
                        -(valordevolucaosemcomissao + valordevolucaocomcomissao)
                        -(valorvendeusemcomissao+valorvendeucomcomissao)
                        -(valoremabertosemcomissao+ valoremabertocomcomissao) ) Lucroprejuizo
                     , ativo
                from (
                        select r.idrepresentante cod
                             , pck_romance.fnc_nomerepresentante(r.idrepresentante) nome
                             , nvl( ( select sum( (nvl(qtd_dist_pp ,0) 
                                                 + nvl(qtd_dist_p ,0)  
                                                 + nvl(qtd_dist_m ,0)  
                                                 + nvl(qtd_dist_g ,0)
                                                 + nvl(qtd_dist_gg,0)  
                                                 + nvl(qtd_dist_egg,0) 
                                                 + nvl(qtd_dist_exgg,0) 
                                                 + nvl(qtd_dist_u,0))*i.valorvenda )
                                       from itenscargarepresentante i 
                                       where i.comissao = 'N'
                                         and i.idcargarepresentante in ( select c.idcargarepresentante
                                                                         from cargasrepresentantes c
                                                                         where c.idrepresentante = r.idrepresentante
                                                                           and c.situacao        != 0
                                                                           and pck_util.fnc_idsemana(c.semana) >= r.idsemanabalanco )),0) valorcargasemcomissao
                             , nvl( ( select sum( (nvl(qtd_dist_pp ,0) 
                                                 + nvl(qtd_dist_p ,0)  
                                                 + nvl(qtd_dist_m ,0)  
                                                 + nvl(qtd_dist_g ,0)
                                                 + nvl(qtd_dist_gg,0)  
                                                 + nvl(qtd_dist_egg,0) 
                                                 + nvl(qtd_dist_exgg,0) 
                                                 + nvl(qtd_dist_u,0))*i.valorvenda )
                                       from itenscargarepresentante i 
                                       where i.comissao = 'S'
                                         and i.idcargarepresentante in ( select c.idcargarepresentante
                                                                         from cargasrepresentantes c
                                                                         where c.idrepresentante = r.idrepresentante
                                                                           and c.situacao        != 0
                                                                           and pck_util.fnc_idsemana(c.semana) >= r.idsemanabalanco )),0) valorcargacomcomissao
                             , nvl(( select sum((nvl(i.qtd_u,0)
                                               + nvl(i.qtd_egg,0)
                                               + nvl(i.qtd_gg ,0)
                                               + nvl(i.qtd_g  ,0)
                                               + nvl(i.qtd_m  ,0)
                                               + nvl(i.qtd_p  ,0)
                                               + nvl(i.qtd_pp ,0))*i.valorproduto)
                                     from itensdevolucaorepres i
                                     where i.comissao = 'N'
                                        and i.iddevolucaorepres in ( select d.iddevolucaorepres
                                                                     from devolucoesrepresentantes d
                                                                     where d.idrepresentante = r.idrepresentante
                                                                       and d.situacao        != 0
                                                                       and pck_util.fnc_idsemana(d.semana) >= r.idsemanabalanco ) ),0) valordevolucaosemcomissao
                             , nvl(( select sum((nvl(i.qtd_u,0)
                                               + nvl(i.qtd_egg,0)
                                               + nvl(i.qtd_gg ,0)
                                               + nvl(i.qtd_g  ,0)
                                               + nvl(i.qtd_m  ,0)
                                               + nvl(i.qtd_p  ,0)
                                               + nvl(i.qtd_pp ,0))*i.valorproduto)
                                     from itensdevolucaorepres i
                                     where i.comissao = 'S'
                                        and i.iddevolucaorepres in ( select d.iddevolucaorepres
                                                                     from devolucoesrepresentantes d
                                                                     where d.idrepresentante = r.idrepresentante
                                                                       and d.situacao        != 0
                                                                       and pck_util.fnc_idsemana(d.semana) >= r.idsemanabalanco ) ),0) valordevolucaocomcomissao
                             , nvl(( select sum((nvl(i.quantidade,0)-nvl(i.qtddevolvida,0))*i.valorvenda )
                                     from itensnotavenda i
                                     where i.comissao = 'N'
                                       and i.idnotavenda in ( select idnotavenda
                                                              from notasvendas n
                                                              where n.idrepresentante = r.idrepresentante
                                                                and n.idsituacaonotavenda = 4 
                                                                and pck_util.fnc_idsemana(n.semanacobranca) >= r.idsemanabalanco ) ),0) valorvendeusemcomissao
                             , nvl(( select sum((nvl(i.quantidade,0)-nvl(i.qtddevolvida,0))*i.valorvenda )
                                     from itensnotavenda i
                                     where i.comissao = 'S'
                                       and i.idnotavenda in ( select idnotavenda
                                                              from notasvendas n
                                                              where n.idrepresentante = r.idrepresentante
                                                                and n.idsituacaonotavenda = 4 
                                                                and pck_util.fnc_idsemana(n.semanacobranca) >= r.idsemanabalanco ) ),0) valorvendeucomcomissao
                             , nvl(( select sum(i.quantidade*i.valorvenda)
                                     from itensnotavenda i
                                     where i.comissao = 'N'
                                       --and i.qtddevolvida is null
                                       and i.idnotavenda in ( select idnotavenda
                                                              from notasvendas n
                                                              where n.idrepresentante = r.idrepresentante
                                                                and n.idsituacaonotavenda < 4 ) ),0) valoremabertosemcomissao
                             , nvl(( select sum(i.quantidade*i.valorvenda)
                                     from itensnotavenda i
                                     where i.comissao = 'S'
                                       --and i.qtddevolvida is null
                                       and i.idnotavenda in ( select idnotavenda
                                                              from notasvendas n
                                                              where n.idrepresentante = r.idrepresentante
                                                                and n.idsituacaonotavenda < 4 ) ),0) valoremabertocomcomissao
                             , decode(r.ativo,'S','Sim','Não') ativo 
                             , pck_util.fnc_semanaid( r.idsemanabalanco ) semana
                        from representantes r
                        where ( ( :P241_FILTRO = 'R' and r.idrepresentante = :P241_IDREPRESENTANTE )
                              or  :P241_FILTRO = 'T' )
                          and r.idgerente = ( select idgerente 
                                              from gerentes
                                              where idfilial = :P0_IDFILIAL ))
                
                ```
        }
