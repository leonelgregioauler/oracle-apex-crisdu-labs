    button p241-filtrar (
        buttonName: P241_FILTRAR
        label: Filtrar
        layout {
            sequence: 20
            region: @balanço
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: P241_FILTRAR
        }
    )

    dynamicAction filtrar (
        name: filtrar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @p241-filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction filtro (
        name: filtro
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P241_FILTRO
        }
        clientSideCondition {
            type: item=value
            item: P241_FILTRO
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P241_IDREPRESENTANTE
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P241_IDREPRESENTANTE
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 241
                items: {
                    P241_FILTRO: &P241_FILTRO.
                    P241_IDREPRESENTANTE: &P241_IDREPRESENTANTE.
                }
                successMessage: false
            }
        }
    )

)

