    dynamicAction refresh-relatorio (
        name: Refresh Relatorio
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P608_IDCARGAREPRESENTANTE
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P608_IDCARGAREPRESENTANTE
        }

        action native-refresh (
