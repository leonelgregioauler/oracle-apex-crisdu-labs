page 608 (
    name: Log Cargas
    title: Log Cargas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region log-cargas (
        name: Log Cargas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select lc.usuarioalteracao
                     , decode(TIPOALTERACAO,'INSERT','Inclusão','UPDATE','Alteração','DELETE','Exclusão') "Tipo Alt."
                     , lc.dataalteracao
                     , lc.idcargarepresentante
                     , roman.pck_romance.fnc_nomerepresentante(lc.idrepresentante) "Distribuidor"
                     , lc.semana
                     , lc.valortotal
                     , lc.idfilial
                     , decode(situacao, 1,'Aberta', 2,'Aguardando Conclusão', 3, 'Concluída',0, 'Cancelada') "Situação"  
                     , lc.observacao
                     , decode(abertura , 'S', 'Sim', 'Não') abertura 
                     , roman.pck_romance.fnc_nomeregiaovenda(lc.idregiaovenda) "Região Venda"
                     , lc.idsemana
                     , lc.dataconclusao
                     , lc.datainclusao
                     , lc.dataultimaalteracao
                     , lc.usuarioconcluiu
                     , lc.usuarioincluiu
                     , lc.usuarioultimaalteracao
                     , lc.totaldistribuido
                     , lc.totalsugerido
                     , lc.montadapor
                from logroman.log_cargasrepresentantes lc
                where  idcargarepresentante = :P608_IDCARGAREPRESENTANTE
                order by 3 desc
                ```
            pageItemsToSubmit: P608_IDCARGAREPRESENTANTE
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma informação encontrada.
        }
        advanced {
            savedReportMappingIdentifier: 110338315258924739
        }

