    region relatorio (
        name: Relatorio
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                 p_query varchar2(2000);
                 p_where varchar2(2000);
                 p_exec  varchar2(4000);
                begin
                  --
                  p_query := 'select h.IDHISTORICOCATEGORIZACAO, h.IDCLUBEDESUCESSO, h.IDCATEGORIACLUBE, h.PONTUACAO
                          , ( select l.NOMECLUBE from CLUBEDESUCESSO l where l.IDCLUBEDESUCESSO = h.IDCLUBEDESUCESSO) NOMECLUBEDESUCESSO
                          , favorita.pck_util_fav.fnc_nomevendedora(h.idvendedora) vendedora
                          , ( select distinct l.NOMECATEGORIA from CATEGORIASCLUBES l where l.IDCATEGORIACLUBE = h.IDCATEGORIACLUBE) NOMECATEGORIACLUBE
                          --, pck_util.fnc_semanaid(idsemanaini) "Semana Inicio"
                         -- , pck_util.fnc_semanaid(idsemanafim) "Semana Fim"
                          , pck_util.fnc_semanaid(idsemanaini) || '' à '' || pck_util.fnc_semanaid(idsemanafim) "ciclo"
                          , v.idfilial filial
                          , favorita.pck_util_fav.fnc_nomerepresentante(v.idrepresentante) Representante
                          , h.idsemanaini
                          , p.cpf
                          , p.documentoestrangeiro
                          , ( select ''('' || substr(t.telefonelimpo, 1, 2) || '') '' ||
                                            substr(t.telefonelimpo, 3, 1) || '' '' ||
                                            substr(t.telefonelimpo, 4, 4) || ''-'' ||
                                            substr(t.telefonelimpo, 8, 4) as Telefone
                                from catal.telefonespessoas t
                               where t.idpessoa = 35261
                               order by t.idtelefonepessoa desc
                               fetch first 1 row only) as Telefone
                          , h.idvendedora
                            from historicoscategorizacoes h
                               , vendedoras v
                               , pessoas p
                           where h.idvendedora = v.idvendedora
                             and v.idpessoa = p.idpessoa
                             and v.ativo = ''S''';
                  --
                  if :P715_FILTRAR = 'S' then
                    --
                    --raise_application_error(-20001,'xxxxxx');
                    if :P715_FILIAL != -1 then
                      p_where := p_where || ' and ' || v('P715_FILIAL') || ' = v.idfilial ';
                    end if;
                    --
                    if :P715_CATEGORIA != -1  then
                      p_where := p_where || ' and h.idcategoriaclube = ' || v('P715_CATEGORIA') ;
                    end if;
                    --
                    if :P715_DISTRIBUIDOR != -1 then
                      p_where := p_where || ' and ' || v('P715_DISTRIBUIDOR') || ' = v.idrepresentante ';
                    end if;
                    --
                    if :P715_VENDEDORA != -1 then
                      p_where := p_where || ' and h.idvendedora = ' || v('P715_VENDEDORA') ;
                    end if;
                    --
                    if :P715_CPF is not null then
                      p_where := p_where || ' and p.idpessoa = ''' || v('P715_CPF')||'''' ;
                    end if;
                    --
                    if :P715_DOC_ESTRANGEIRO is not null then
                      p_where := p_where || ' and exists ( select 1 from catal.pessoas p where p.idpessoa = v.idpessoa and p.documentoestrangeiro = ''' || v('P715_DOC_ESTRANGEIRO')||''')' ;
                    end if;
                    --
                    --p_exec := p_query || p_where;
                  else
                    p_where := ' and 1 = 2 ';
                  end if;
                    
                  return p_query || p_where;
                
                end
                ```
            pageItemsToSubmit: [
                P715_FILIAL
                P715_CATEGORIA
                P715_DISTRIBUIDOR
                P715_VENDEDORA
                P715_FILTRAR
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
