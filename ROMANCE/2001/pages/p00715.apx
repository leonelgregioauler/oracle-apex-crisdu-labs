    pageItem P715_DISTRIBUIDOR (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select DISTINCT favorita.pck_util_fav.fnc_nomerepresentante (r.idrepresentante) nomevendedora
                     , r.idrepresentante r
                  from vendedoras v
                     , representantes r
                     , historicoscategorizacoes h
                 where v.idrepresentante = r.idrepresentante
                   and v.idvendedora = h.idvendedora
                   and r.idfilial = :P715_FILIAL
                   -- Maicon Aimi - 9196244 - 13/08/2024
                   and r.ativo = 'S'
                 order by 1
                ```
            nullDisplayValue: -- Todos --
            nullReturnValue: -1
        }
        cascadingLov {
            parentItems: P715_FILIAL
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
