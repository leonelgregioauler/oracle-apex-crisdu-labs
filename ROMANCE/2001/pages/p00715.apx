    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 10
            region: @filtros
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction buscaciclo (
        name: BuscaCiclo
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P715_FILIAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: P715_CICLO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select htf.escape_sc(
                           pck_util.fnc_semanaid(pidsemana => ( (f.idsemanainicio - f.quantidadeciclos) +
                                                                (select idsemana - f.idsemanainicio
                                                                   from semana_dias
                                                                  where sysdate between dt_ini and dt_fim  )
                                                                   ) ) || ' a ' || 
                           pck_util.fnc_semanaid( pidsemana => f.idsemanainicio +
                                                  (select idsemana - f.idsemanainicio
                                                                   from semana_dias
                                                                  where sysdate between dt_ini and dt_fim  ) ) ) ciclo
                      from filiaisclubedesucesso f
                     where f.idfilial         = :P715_FILIAL
                       and f.idclubedesucesso = (select idclubedesucesso
                                                   from clubedesucesso
                                                  where sysdate between datavigenciainicial
                                                                    and datavigenciafinal);
                    ```
                itemsToSubmit: P715_FILIAL
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P715_CICLO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-set-value (
            action: setValue
            settings {
                value: S
            }
            affectedElements {
                selectionType: items
                items: P715_FILTRAR
            }
            execution {
                sequence: 10
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

