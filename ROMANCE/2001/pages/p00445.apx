    region empréstimos-2 (
        name: Empréstimos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(e.idfilial) empresa
                     , f.semana
                     , count(1) quantidade
                     , sum((nvl(e.valor,0)+nvl(e.valorjuros,0))*ff.fatorconversao) valor
                     , sum(nvl(( select sum(pg.valorpago)
                                 from pagamentosemprestimos pg
                                 where pg.idemprestimo = e.idemprestimo ),0)*ff.fatorconversao) valorpago
                     , sum(((nvl(e.valor,0)+nvl(e.valorjuros,0))*ff.fatorconversao - (nvl(( select sum(pg.valorpago)
                                                                                           from pagamentosemprestimos pg
                                                                                           where pg.idemprestimo = e.idemprestimo ),0)*ff.fatorconversao))) saldo
                from emprestimos e
                   , fechamentossemanais f
                   , vw_filiais ff
                where e.idfechamento = f.idfechamento
                  and ff.idfilial = e.idfilial
                  and extract ( year from e.data ) = :P445_ANO
                  and ( :P445_IDFILIAL is null or e.idfilial = :P445_IDFILIAL )
                  and :P445_TIPO_RELATORIO = 'D'
                group by e.idfilial
                       , f.semana
                       , f.idsemana 
                order by f.idsemana 
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P445_TIPO_RELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum dado encontrado!
        }
