page 445 (
    name: Controle de Empréstimos
    title: Controle de Empréstimos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region empréstimos (
        name: Empréstimos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(e.idfilial) empresa
                     , count(1) quantidade
                     , sum((nvl(e.valor,0)+nvl(e.valorjuros,0))*f.fatorconversao) valor
                     , sum(nvl(( select sum(pg.valorpago)
                                 from pagamentosemprestimos pg
                                 where pg.idemprestimo = e.idemprestimo ),0)*f.fatorconversao) valorpago
                     , sum((nvl(e.valor,0)+nvl(e.valorjuros,0))*f.fatorconversao- (nvl(( select sum(pg.valorpago)
                                                                      from pagamentosemprestimos pg
                                                                      where pg.idemprestimo = e.idemprestimo ),0)*f.fatorconversao)) saldo
                from emprestimos e
                   , vw_filiais f
                where f.idfilial = e.idfilial
                  and extract ( year from e.data ) = :P445_ANO
                  and :P445_TIPO_RELATORIO = 'R'
                group by e.idfilial
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P445_TIPO_RELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum dado encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 2671544031494939121
        }

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
