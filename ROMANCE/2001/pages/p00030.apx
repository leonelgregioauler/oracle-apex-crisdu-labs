page 30 (
    name: Incluir Histórico
    title: Incluir Histórico
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
        executeWhenPageLoads: opener.location.reload()
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region incluir-histórico (
        name: Incluir Histórico
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P30_DATA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @incluir-histórico
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P30_IDNOTAVENDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @incluir-histórico
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDNOTAVENDA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P30_IDOBSNOTAVENDA (
        type: hidden
        layout {
            sequence: 10
            region: @incluir-histórico
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDOBSNOTAVENDA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P30_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        settings {
            charCounter: true
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @incluir-histórico
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 8
        }
        validation {
            valueRequired: true
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P30_USUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @incluir-histórico
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return v('APP_USER');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @incluir-histórico
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P30_IDOBSNOTAVENDA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @incluir-histórico
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P30_IDOBSNOTAVENDA
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 10
            region: @incluir-histórico
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 37
                items: {
                    P37_IDNOTAVENDA: &P30_IDNOTAVENDA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @incluir-histórico
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P30_IDOBSNOTAVENDA
        }
    )

    process fetch-row-from-observacoesnotasvendas (
        name: Fetch Row from OBSERVACOESNOTASVENDAS
        type: autoRowFetch
        source {
            tableName: OBSERVACOESNOTASVENDAS
            pkColumn: IDOBSNOTAVENDA
            pkItem: P30_IDOBSNOTAVENDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 31983683780926566
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P30_IDOBSNOTAVENDA is null then
                        select "SEQ_IDOBSNOTAVENDA".nextval
                          into :P30_IDOBSNOTAVENDA
                          from dual;
                        select sysdate
                          into :P30_DATA
                          from dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 31984074135926567
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-observacoesnotasvendas (
        name: Process Row of OBSERVACOESNOTASVENDAS
        type: autoRowProcessing
        target {
            tableName: OBSERVACOESNOTASVENDAS
            pkColumn: IDOBSNOTAVENDA
            pkItem: P30_IDOBSNOTAVENDA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 31984517959926567
        }
    )

    branch (
        name: Go To Page 30
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 30
                items: {
                    P30_IDNOTAVENDA: &P30_IDNOTAVENDA.
                    P30_IDOBSNOTAVENDA:
                }
            }
        }
    )

)

