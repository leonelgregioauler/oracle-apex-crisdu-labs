page 661 (
    name: Lista Plataforma Débitos Romance
    title: Lista Plataforma Débitos Romance
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: "Filtros "
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region lista-de-débitos (
        name: Lista de Débitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomevendedora(a.idvendedora) nome
                     , roman.pck_romance.fnc_cpfvendedora(a.idvendedora) CPF
                     , case 
                        when a.tipo in ('catalogo','favorita') then 'FAVORITA'
                        when a.tipo = 'romance' then 'ROMANCE'
                       end origem
                     , a.numero debito 
                     , a.saldo Valor_original
                     , a.saldoatualizado Valor_atualizado
                    -- , to_char(a.dataemissao, 'rrrr') Ano
                     , a.dataemissao
                     , roman.pck_romance.fnc_nomefilial (v.idfilial) franquia
                     , roman.pck_romance.fnc_retornatelefones(a.idvendedora) telefones
                     , p.email
                     , a.percdesconto||'%'
                     , a.valordesconto
                from roman.vw_debitos_vend_acordoaki_v2 a
                   , catal.pessoas p
                   , catal.vendedoras v
                   , catal.gerentes g
                where p.idpessoa = v.idpessoa
                  and v.idvendedora = a.idvendedora
                  and v.idfilial = g.idfilial
                  and (:P661_IDREPRESENTANTE is null or a.idrepresentante = :P661_IDREPRESENTANTE)
                  and (:P661_IDFILIAL is null or g.idgerente = :P661_IDFILIAL)
                  and :P661_FILTRAR = 'S'
                  and (:P661_DATAINI is null or trunc(a.dataemissao) between to_date(:P661_DATAINI,'dd/mm/rrrr') and  to_date(:P661_DATAFIM,'dd/mm/rrrr'))
                  and (:P661_IDVENDEDORA is null or a.idvendedora = :P661_IDVENDEDORA )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 99562485651844802
        }

