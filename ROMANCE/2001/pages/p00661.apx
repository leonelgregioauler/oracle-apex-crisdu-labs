    pageItem P661_FILTRAR (
        type: hidden
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P661_IDFILIAL (
        type: selectList
        label {
            label: Franquia:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idgerente
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.idfilial != 1063
                  and exists (select 1
                              from roman.notasvendas nv
                              where nv.idfilial = f.idfilial
                                and nv.idsituacaonotavenda = 3)
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P661_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor:
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap (p.nomepessoa) display_value
                     , r.idrepresentante return_value
                from pessoas p
                   , representantes r
                where r.idpessoa = p.idpessoa 
                  and r.ativo = 'S'
                  and r.idgerente = :P661_IDFILIAL
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P661_IDFILIAL
            itemsToSubmit: P661_IDREPRESENTANTE
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P661_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora:
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' CPF: '||p.cpf d
                     , v.idvendedora r
                from vendedoras v
                   , pessoas p
                   , gerentes g
                where p.idpessoa = v.idpessoa
                  and v.idfilial = g.idfilial
                  and ( :P661_IDREPRESENTANTE is null or v.idrepresentante = :P661_IDREPRESENTANTE )
                  and ( :P661_IDFILIAL is null or g.idgerente = :P661_IDFILIAL )
                order by 1
                ```
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
