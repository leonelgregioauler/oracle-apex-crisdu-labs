        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 661
                items: {
                    P661_FILTRAR: S
                }
                action: resetPagination
            }
        }
    )

