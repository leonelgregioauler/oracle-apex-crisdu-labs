page 221 (
    name: Defeitos Fornecedores
    title: Defeitos Fornecedores
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region defeitos-fornecedores (
        name: Defeitos Fornecedores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(idfornecedor) fornecedor
                     , pck_romance.fnc_nomeproduto( idproduto ) produto
                     , usuario
                     , datainclusao
                     , dd.qtd_pp
                     , dd.qtd_p
                     , dd.qtd_m
                     , dd.qtd_g
                     , dd.qtd_gg
                     , dd.qtd_egg
                     , dd.qtd_exgg
                     , dd.qtd_u
                     , ( select initcap(descricao)
                         from defeitos d
                         where d.iddefeito = dd.iddefeito ) defeito
                     , observacao
                     , numeronota
                from defeitosfornecedores  dd
                where idfilial = :P0_IDFILIAL
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: singleRowView
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt="" />
            conditionType: never
        }
        singleRowView {
            excludeNullValues: true
            onlyDisplayedColumns: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Defeitos não informados.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
