    pageItem P293_IDCIDADE_EDI (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomecidade) || '-' || e.sigla as display_value
                     , c.idcidade                              as return_value
                  from catal.cidades c
                     , roman.estados e
                 where e.idestado = c.idestado
                 order by 1
                ```
        }
        layout {
            sequence: 130
            region: @editar-pré-cadastro-de-pessoa
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

