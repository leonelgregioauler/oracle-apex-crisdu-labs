    pageItem P293_IDCIDADE (
        type: textField
        label {
            label: Cidade
            alignment: left
        }
        layout {
            sequence: 140
            region: @informações-sistema
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vnomecidade varchar2(100);
                begin
                  --
                  select pck_romance.fnc_nomecidade(:P293_IDCIDADE) cidade
                  into vnomecidade
                  from dual;
                  --
                  return(vnomecidade);
                  --
                end;
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P293_IDCIDADE_1 (
        type: selectList
        label {
            label: Cidade
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomecidade(idcidade)  display_value
                     , c.IDCIDADE return_value 
                from CIDADES c
                   , filiaisregioesvenda f
                   , estados e
                where f.idfilial = :P0_IDFILIAL
                  and f.idestado = e.idestado
                  and e.idestado = c.idestado
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P293_DATANASCIMENTO_EDI
        }
        layout {
            sequence: 190
            region: @cadastro-atualizado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCIDADE
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P293_IDCIDADE_A (
        type: plugin/simpleCheckbox
        label {
