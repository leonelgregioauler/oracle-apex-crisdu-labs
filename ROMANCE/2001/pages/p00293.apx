    process salvar-pré-cadastro (
        name: Salvar Pré Cadastro
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                    -- Realiza um update na tabela preatualizacaocadastro atualizando os dados do pré cadastro.
                    update roman.preatualizacaocadastro
                       set nomepessoa           = :P293_NOMEPESSOA_EDI,
                           datanascimento       = :P293_DATANASCIMENTO_EDI,
                           cpf                  = :P293_CPF_EDI,
                           rg                   = :P293_RG_EDI,
                           enderecoprincipal    = :P293_ENDERECOPRINCIPAL_EDI,
                           enderecosecundario   = :P293_ENDERECOSECUNDARIO_EDI,
                           bairro               = :P293_BAIRRO_EDI,
                           numero               = :P293_NUMERO_EDI,
                           complemento          = :P293_COMPLEMENTO_EDI,
                           cep                  = :P293_CEP_EDI,
                           idcidade             = :P293_IDCIDADE_EDI,
                           nroconsultaspc       = :P293_NROCONSULTASPC_EDI,
                           email                = :P293_EMAIL_EDI,
                           observacao           = :P293_OBSERVACAO_EDI
                     where idpreatualizacao = :P293_IDPREATUALIZACAO;
                     
                     -- Persiste a alteração no banco de dados
                     commit;
                
                     -- Tratamento de erro da rotina
                exception
                    when others then
                        apex_error.add_error( p_message => 'Ops! Ocorreu um erro na rotina (Salvar Pré Cadastro). Entre em contato com o suporte. ' || SQLERRM
                		                    , p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
