page 293 (
    name: Comparando Cadastros
    title: Comparando Cadastros
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            $(document).on("dialogopen", function(event, ui) {
              var dialog = $(event.target).closest(".ui-dialog");
              
              // Garante que a modal seja arrastável
              dialog.draggable({
                handle: ".ui-dialog-titlebar", // Apenas a barra de título pode ser usada para arrastar
              });
            
              // Centraliza novamente, caso necessário
              dialog.css({
                top: "20%",
                left: "30%",
              });
            });
            ```
    }
    css {
        inline:
            ```css
            .ui-dialog-titlebar {
                background-color: #309fdb !important;
                color: white !important;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region atualizar (
        name: Atualizar
        type: staticContent
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <font color="red"> -----> Selecione as informações para serem atualizadas! <----- </font>
        }
    )

    region atualização-de-cadastro (
        name: Atualização de Cadastro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
