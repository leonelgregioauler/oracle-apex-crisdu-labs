    process inicializa-região-pré-cadastro-de-pessoa (
        name: Inicializa Região Pré Cadastro de Pessoa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    :P293_NOMEPESSOA_EDI         := :P293_NOMEPESSOA_1;
                    :P293_DATANASCIMENTO_EDI     := :P293_DATANASCIMENTO_1;
                    :P293_CPF_EDI                := :P293_CPF_1;
