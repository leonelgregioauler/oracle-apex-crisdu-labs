    process aprovar-atualização (
        name: Aprovar atualização
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                    -- Atualiza os dados da pessoa.
                    for vReg in ( select *
                                    from roman.preatualizacaocadastro p
                                   where p.idpreatualizacao = :P293_IDPREATUALIZACAO)
                    loop
                        
                        -- Atualiza os dados da tabela CATAL.PESSOAS com os dados da tabela ROMAN.PREATUALIZACAOCADASTRO que foram selecionados na página
                        update catal.pessoas p
                           set p.nomepessoa          = decode(:P293_NOMEPESSOA_A,         'S', vreg.nomepessoa,          p.nomepessoa)
                             , p.datanascimento      = decode(:P293_DATANASCIMENTO_A,     'S', vreg.datanascimento,      p.datanascimento)
                             , p.cpf                 = decode(:P293_CPF_A,                'S', vreg.cpf,                 p.cpf)
                             , p.rg                  = decode(:P293_RG_A,                 'S', vreg.rg,                  p.rg)
                             , p.enderecoprincipal   = decode(:P293_ENDERECOPRINCIPAL_A,  'S', vreg.enderecoprincipal,   p.enderecoprincipal)
                             , p.enderecosecundario  = decode(:P293_ENDERECOSECUNDARIO_A, 'S', vreg.enderecosecundario,  p.enderecosecundario)
                             , p.bairro              = decode(:P293_BAIRRO_A,             'S', vreg.bairro,              p.bairro)
                             , p.numero              = decode(:P293_NUMERO_A,             'S', vreg.numero,              p.numero)
                             , p.complemento         = decode(:P293_COMPLEMENTO_A,        'S', vreg.complemento,         p.complemento)
                             , p.cep                 = decode(:P293_CEP_A,                'S', vreg.cep,                 p.cep)
                             , p.idcidade            = decode(:P293_IDCIDADE_A,           'S', vreg.idcidade,            p.idcidade)
                             , p.nroconsultaspc      = decode(:P293_NROCONSULTASPC_A,     'S', vreg.nroconsultaspc,      p.nroconsultaspc)
                             , p.email               = decode(:P293_EMAIL_A,              'S', vreg.email,               p.email)
                             , p.observacao          = decode(:P293_OBSERVACAO_A,         'S', vreg.observacao,          p.observacao)
                         where p.idpessoa = vReg.idpessoa;
                    end loop;
                  
                    -- Seta como jaá atualizada na tabela de pré Atualização
                    update preatualizacaocadastro 
                       set situacao = 'A'
                     where idpreatualizacao = :P293_IDPREATUALIZACAO;
                
                    -- Efetiva a alteração no banco de dados
                    commit;
                
                    -- Tratamento de erros da rotina
                exception
                    when others then
                        apex_error.add_error( p_message => 'Ops! Ocorreu um erro na rotina (Aprovar Atualização). Entre em contato com o suporte.' || SQLERRM
                		                    , p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Cadastro Atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 269462615808000928
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST IN ('APROVAR_E_IR_CADASTRO', 'APROVAR')
        }
    )

    process fetch-row-from-pessoas (
        name: Fetch Row from PESSOAS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  select NOMEPESSOA, to_date(DATANASCIMENTO,'DD/MM/RRRR'), CPF, RG, ENDERECOPRINCIPAL, ENDERECOSECUNDARIO, BAIRRO, NUMERO, COMPLEMENTO, CEP, pck_romance.fnc_nomecidade(IDCIDADE), nroconsultaspc, EMAIL, OBSERVACAO , DOCUMENTOESTRANGEIRO
                  into :P293_NOMEPESSOA, :P293_DATANASCIMENTO, :P293_CPF, :P293_RG, :P293_ENDERECOPRINCIPAL, :P293_ENDERECOSECUNDARIO, :P293_BAIRRO, :P293_NUMERO, :P293_COMPLEMENTO, :P293_CEP, :P293_IDCIDADE, :P293_nroconsultaspc, :P293_EMAIL, :P293_OBSERVACAO , :P293_DOCUMENTOESTRANGEIRO
                  from pessoas p
                  where p.idpessoa  = :P293_IDPESSOA;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 269461829166000927
        }
    )

