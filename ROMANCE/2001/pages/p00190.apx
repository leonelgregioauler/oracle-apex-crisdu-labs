    region débitos-de-distribuidor (
        name: Débitos de Distribuidor
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.idboleto
                     , numero
                     , empresa "Empresa"
                     , idrepresentante
                     , representante || ' - ' || situacaorepres ||' - '||empresa "Representante"
                     , vendedora "Vendedora"
                     , cpfvend "Cpf Vendedora"
                     , valortotal "Valor Total"
                     , b.datavencimento "Vencimento"
                     , diasatrasado "Dias Atrasado"
                     , situacao "Situação"
                     , case 
                         when b.origem = 'antigo' then
                           b.valoratualizado
                         else
                           (select pck_util.fnc_calculajuros(pvalororiginal      => (p.saldodevedor-case when b.origem = 'novo' then 
                                                                                                        nvl(( select sum(vp.valorpagar) valor
                                                                                                              from favorita.vencimentospedidos vp
                                                                                                              where vp.idpedido = b.idboleto
                                                                                                                and vp.situacaovencimento = 'V'
                                                                                                                and vp.datavencimento >= TRUNC(sysdate)
                                                                                                                and vp.valorpago < vp.valorpagar
                                                                                                                and vp.valorpagar > 0 ),0) 
                                                                                                     else 
                                                                                                       0
                                                                                                     end),
                                                 pdatavencimentoorig => p.datavencimentomenor,
                                                 pdatavencimentonovo => sysdate,
                                                 ppercmulta          => 2,
                                                 ppercjuros          => 1)/*+case when b.origem = 'novo' then 
                                                                                                        nvl(( select sum(vp.valorpagar) valor
                                                                                                              from favorita.vencimentospedidos vp
                                                                                                              where vp.idpedido = b.idboleto
                                                                                                                and vp.situacaovencimento = 'V'
                                                                                                                and vp.datavencimento >= TRUNC(sysdate)
                                                                                                                and vp.valorpago < vp.valorpagar
                                                                                                                and vp.valorpagar > 0 ),0) 
                                                                                                     else 
                                                                                                       0
                                                                                                     end|*/
                           from favorita.vw_pedidos_fav p 
                           where p.idpedido = b.idboleto
                             and p.ididioma = 1)
                       end "Valor Atualizado p/ Hoje"
                     , valororiginal "Valor Original"
                     , vencimentooriginal "Venc. Original"
                     , vencimentos
                     , motivo "Motivo"
                     , case
                         when b.origem = 'antigo' then
                           nvl(valorpago,0)
                         else 
                           nvl((select sum(pg.valorpago)
                                    from favorita.vencimentospedidos v
                                       , favorita.pagamentospedidos pg
                                    where v.situacaovencimento = 'V'
                                      and pg.idvencimentopedido = v.idvencimentopedido
                                      and v.idpedido = b.idboleto ) ,0) 
                       end "Valor Pago"
                     , case
                         when b.origem = 'novo' then 
                            nvl(( select sum(vp.valorpagar) valor
                                  from favorita.vencimentospedidos vp
                                  where vp.idpedido = b.idboleto
                                    and vp.situacaovencimento = 'V'
                                    and vp.datavencimento >= TRUNC(sysdate)
                                    and vp.valorpago < vp.valorpagar
                                    and vp.valorpagar > 0 ),0) 
                         else 
                           0
                         end "Valor Não Vencido"
                from debitosdistribuidoresfav b --vw_debitosrepresfavorita b
                where b.idfilial = :P0_IDFILIAL
                  and ( ( :P190_PESQUISA = 'R' and b.idrepresentante = :P190_IDREPRESENTANTE  )
                    or ( :P190_PESQUISA = 'S' and b.situacaorepres = :P190_SITUACAO )
                    or ( :P190_PESQUISA = 'T' ) )
                  and :P190_FILTRAR = 'S'
                  and nvl(b.valorpago,0) < b.valororiginal
                  and :P190_PESQUISA != 'A'
                
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <font color="green"><h3>Disponibilizado a informação de Valor Não Vencido para casos de pedidos que possuem parcelamentos, mais especificamente pedidos de distribuidores!</h3></font>
        }
        reportLayout {
            numberOfRows: 300
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        messages {
            whenNoDataFound: Nenhum Débito encontrado!
        }
        breakFormatting {
            breakColumns: col1
            style: repeatHeadings
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
            linkText: Clique aqui para baixar para Excel
        }

