        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select  '<font color"red"><h3>Atualizado em '|| to_char(LAST_DATE,'dd/mm/rrrr hh24:mi:ss')||', a próxima atualização será '|| to_char(next_date,'dd/mm/rrrr hh24:mi:ss')||'</font></h3>' a
                from all_jobs
                where what like upper('%vw_mdebitosrepresfavorita%')
                ```
        }
