    pageItem P190_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @filtrar-distribuidor
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P190_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||r.idrepresentante||')' || decode(r.ativo,'S','','Inativo') display_value
                     , r.idrepresentante
                from representantes r
                where idgerente in ( select idgerente
                                     from gerentes
                                     where idfilial = :P0_IDFILIAL)
                order by 1
                ```
        }
        layout {
            sequence: 30
            region: @filtrar-distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P190_PESQUISA (
        type: radioGroup
        label {
            label: Tipo de Pesquisa
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select d
                     , r
                from ( select 'Todos' d
                            , 'T' r
                            , 3 ordem
                       from dual
                       union
                       select 'Situação'
                            , 'S'
                            , 2
                       from dual
                       union
                       select 'Distribuidor'
                            , 'R'
                            , 1
                       from dual
                       union
                       select 'ADM'
                            , 'A'
                            , 4
                       from dual
                       where v('APP_USER') in ('EZEQUIAS','BRUNOMULLER','GUILHERME') )
                order by ordem
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtrar-distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P190_SITUACAO (
        type: selectList
        label {
            label: Situação Distribuidor
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Ativo;Ativo,Inativo;Inativo
            nullDisplayValue: - Selecione a Situação -
        }
        layout {
            sequence: 40
            region: @filtrar-distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtrar-distribuidor
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction mostra-campos (
        name: mostra campos
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P190_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P190_PESQUISA
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P190_IDREPRESENTANTE
                    P190_SITUACAO
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P190_SITUACAO
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P190_IDREPRESENTANTE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction mostra-campos-situacao (
        name: "mostra campos situacao "
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P190_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P190_PESQUISA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P190_IDREPRESENTANTE
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P190_SITUACAO
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P190_SITUACAO
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P190_IDREPRESENTANTE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction mostra-campos-todos (
        name: mostra campos todos
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P190_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P190_PESQUISA
            value: T
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P190_IDREPRESENTANTE
                    P190_SITUACAO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 190
                items: {
                    P190_IDREPRESENTANTE: &P190_IDREPRESENTANTE.
                    P190_PESQUISA: &P190_PESQUISA.
                    P190_SITUACAO: &P190_SITUACAO.
                    P190_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

