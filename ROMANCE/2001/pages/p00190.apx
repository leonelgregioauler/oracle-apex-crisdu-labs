    region débitos-adm (
        name: Débitos ADM
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idboleto
                     , numero
                     , empresa "Empresa"
                     , idrepresentante
                     , representante "Representante"
                     , vendedora "Vendedora"
                     , cpfvend "Cpf Vendedora"
                     , round(valortotal*t.fatorconversao,2) "Valor Total"
                     , datavencimento "Vencimento"
                     , diasatrasado "Dias Atrasado"
                     , situacao "Situação"
                     , round(valor_atualizado*t.fatorconversao,2) "Valor Atualizado p/ Hoje"
                     , round(valororiginal*t.fatorconversao,2) "Valor Original"
                     , vencimentooriginal "Venc. Original"
                     , vencimentos
                     , motivo "Motivo"
                     , round(valor_pago*t.fatorconversao,2) "Valor Pago" 
                     , round(valor_nao_vencido*t.fatorconversao,2) "Valor Não Vencido"
                from (
                      select b.idboleto
                           , numero
                           , empresa
                           , idrepresentante
                           , representante || ' - ' || situacaorepres ||' - '||empresa representante
                           , vendedora
                           , cpfvend
                           , valortotal 
                           , b.datavencimento
                           , diasatrasado
                           , situacao
                           , case 
                               when b.origem = 'antigo' then
                                 b.valoratualizado
                               else
                                 (select pck_util.fnc_calculajuros(pvalororiginal      => p.saldodevedor,
                                                       pdatavencimentoorig => p.datavencimentomenor,
                                                       pdatavencimentonovo => sysdate,
                                                       ppercmulta          => 2,
                                                       ppercjuros          => 1)
                                 from favorita.vw_pedidos_fav p 
                                 where p.idpedido = b.idboleto
                                   and p.ididioma = 1)
                             end valor_atualizado
                           , valororiginal
                           , vencimentooriginal
                           , vencimentos
                           , motivo 
                           , case
                               when b.origem = 'antigo' then
                                 nvl(valorpago,0)
                               else 
                                 nvl((select sum(pg.valorpago)
                                          from favorita.vencimentospedidos v
                                             , favorita.pagamentospedidos pg
                                          where v.situacaovencimento = 'V'
                                            and pg.idvencimentopedido = v.idvencimentopedido
                                            and v.idpedido = b.idboleto ) ,0) 
                             end valor_pago
                           , case
                               when b.origem = 'novo' then 
                                  nvl(( select sum(vp.valorpagar) valor
                                        from favorita.vencimentospedidos vp
                                        where vp.idpedido = b.idboleto
                                          and vp.situacaovencimento = 'V'
                                          and vp.datavencimento >= TRUNC(sysdate)
                                          and vp.valorpago < vp.valorpagar
                                          and vp.valorpagar > 0 ),0) 
                               else 
                                 0
                               end valor_nao_vencido
                           , f.fatorconversao
                      from debitosdistribuidoresfav b --vw_debitosrepresfavorita b
                         , vw_filiais f
                      where f.idfilial = b.idfilial
                        and b.valorpago < b.valororiginal
                        and :P190_FILTRAR = 'S'
                        and :P190_PESQUISA = 'A' ) t
                
                
                ```
        }
        layout {
            sequence: 40
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P190_PESQUISA = 'A' and :P190_FILTRAR = 'S'
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 562691313897185828
        }

