            aggregate (
                function: count
                column: "Representante"
            )

            filter ir-condition (
                type: rowExpression
                rowExpression: substr(D,4,4) in (to_char(sysdate,'rrrr'), to_char(sysdate,'rrrr')+1)
                identification {
                    name: Ano atual
                }
            )

            controlBreak (
                column: IDSEMANA
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: SEMANA
                layout {
                    sequence: 2
                }
            )

        )

    )

