page 16 (
    name: Lista de Cargas
    title: Lista de Cargas
    appearance {
        pageTemplate: @/marquee
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_popup_carga(vidfilial,vidrepresentante,vsemana,vcargamais)
            {
              window.open('f?p=&APP_ID.:20:&SESSION.::NO::P20_IDFILIAL,P20_IDREPRESENTANTE,P20_SEMANA,P20_CARGAMAIS:'+vidfilial+','+vidrepresentante+','+vsemana+','+vcargamais,'CARGA', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=700,height=800,left=600,top=100','_blank'); void(0);
            }
            
            function fnc_popup_listadist(vidfilial,vsemana)
            {
              var vtipo = $v("P16_TIPO");
              window.open('f?p=&APP_ID.:266:&SESSION.::NO::P266_IDFILIAL,P266_SEMANA,P266_TIPO:'+vidfilial+','+vsemana+','+vtipo,'Lista Distribuição', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=700,height=800,left=600,top=100','_blank'); void(0);
            }
            
            function formatar_mascara(src,mascara,evt){
              var tecla;  
              if(evt.which)
                {
                  tecla = evt.which
                }
              else 
                if(evt.keyCode)
                  { 
                    tecla = evt.keyCode;
                  }
              if ( tecla != 8 && tecla!=13 && tecla!=47 && tecla!=59) 
                {
                  var campo = src.value.length;
                  var saida = mascara.substring(0,1);
                  var texto = mascara.substring(campo);
                  if(texto.substring(0,1) != saida) 
                    { 
                      src.value+=texto.substring(0,1);
                    }
                }
              
            }
            
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region cargas-em-aberto (
        name: Cargas em aberto
        title: "Cargas Não Concluídas "
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select c.semana
                     , c.idsemana
                     , count(1) qtd
                from cargasrepresentantes c
                where idfilial = :P0_IDFILIAL
                  and c.situacao in (1,2)
                group by c.semana,c.idsemana
                ORDER BY c.idsemana
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: SEMANA
            valueColumn: QTD
        }
    )

    region imprimir (
        name: Imprimir
        type: staticContent
        layout {
            sequence: 20
            slot: rightSideColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
    )

    region lista-de-cargas (
        name: Lista de Cargas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*FIRST_ROWS(50)*/ c.idcargarepresentante
                     , pck_romance.fnc_nomerepresentante(c.idrepresentante)||' - '||c.idrepresentante "Representante"
                     , c.semana
                     , ( select sum( nvl(i.quantidade ,0))
                         from itenscargarepresentante i
                         where i.idcargarepresentante = c.idcargarepresentante
                           and i.cargaamais = 'N' )                                                          "Qtd Sugerida"
                     , ( select nvl(sum(i.quantidade*i.valorvenda),0) 
                         from itenscargarepresentante i 
                         where i.idcargarepresentante = c.idcargarepresentante
                           and i.cargaamais = 'N'  )                               "Valor Sugerido."
                     , ( select sum( nvl(i.qtd_dist_pp,0)     + nvl(i.qtd_dist_p,0)
                                   + nvl(i.qtd_dist_m,0)      + nvl(i.qtd_dist_g,0)
                                   + nvl(i.qtd_dist_gg,0)     + nvl(i.qtd_dist_egg,0)
                                   + nvl(i.qtd_dist_exgg,0)   + nvl(i.qtd_dist_u,0))
                         from itenscargarepresentante i
                         where i.idcargarepresentante = c.idcargarepresentante )                             "Qtd Distribuido"
                     , ( select sum(nvl(( nvl(qtd_dist_pp ,0)       + nvl(qtd_dist_p ,0)  
                                        + nvl(qtd_dist_m ,0)        + nvl(qtd_dist_g ,0)
                                        + nvl(qtd_dist_gg,0)        + nvl(qtd_dist_egg,0) 
                                        + nvl(qtd_dist_exgg,0)      + nvl(qtd_dist_u,0)) * i.valorvenda,0)) 
                         from itenscargarepresentante i 
                         where i.idcargarepresentante = c.idcargarepresentante )                               "Valor Distribuido"
                     , nvl(( select sum(nvl((nvl(qtd_dist_pp ,0)    + nvl(qtd_dist_p ,0)  
                                      + nvl(qtd_dist_m ,0)          + nvl(qtd_dist_g ,0)
                                      + nvl(qtd_dist_gg,0)          + nvl(qtd_dist_egg,0) 
                                      + nvl(qtd_dist_exgg,0)        + nvl(qtd_dist_u,0))*i.valorvenda,0)) 
                         from itenscargarepresentante i 
                         where i.idcargarepresentante = c.idcargarepresentante 
                           and i.cargaamais           = 'S'
                           and i.comissao             = 'S'),0)                                                "Valor Carga + COM Comissão"
                     , nvl(( select sum(nvl((nvl(qtd_dist_pp ,0)   + nvl(qtd_dist_p ,0)  
                                      + nvl(qtd_dist_m ,0)         + nvl(qtd_dist_g ,0)
                                      + nvl(qtd_dist_gg,0)         + nvl(qtd_dist_egg,0) 
                                      + nvl(qtd_dist_exgg,0)       + nvl(qtd_dist_u,0))*i.valorvenda,0)) 
                         from itenscargarepresentante i 
                         where i.idcargarepresentante = c.idcargarepresentante 
                           and i.cargaamais           = 'S'
                           and i.comissao             = 'N'),0)                                               "Valor Carga + SEM Comissão"
                     , pck_romance.fnc_nomeregiaovenda(c.idregiaovenda) "Região de Venda"
                     , ( select sum(nvl(( nvl(qtd_dist_pp ,0)     + nvl(qtd_dist_p ,0)  
                                        + nvl(qtd_dist_m ,0)      + nvl(qtd_dist_g ,0)
                                        + nvl(qtd_dist_gg,0)      + nvl(qtd_dist_egg,0) 
                                        + nvl(qtd_dist_exgg,0)    + nvl(qtd_dist_u,0))*i.valorvenda,0)) 
                         from itenscargarepresentante i 
                         where i.idcargarepresentante = c.idcargarepresentante 
                           and i.comissao = 'S'
                           and nvl(i.cargaamais,'N') = 'N' )                                                 "Valor com Comissão"
                     , ( select sum(nvl(( nvl(qtd_dist_pp ,0)    + nvl(qtd_dist_p ,0)  
                                        + nvl(qtd_dist_m ,0)     + nvl(qtd_dist_g ,0)
                                        + nvl(qtd_dist_gg,0)     + nvl(qtd_dist_egg,0) 
                                        + nvl(qtd_dist_exgg,0)   + nvl(qtd_dist_u,0))*i.valorvenda,0)) 
                         from itenscargarepresentante i 
                         where i.idcargarepresentante = c.idcargarepresentante 
                           and i.comissao = 'N' 
                           and nvl(i.cargaamais,'N') = 'N')                                                  "Valor sem Comissão"
                     , decode( c.situacao, 1 , 'Aberto'
                                         , 2 , 'Aguardando Conclusão'
                                         , 3 , 'Concluído'
                                         , 0 , 'Cancelada') "Situação"
                     , '<a href="javascript: fnc_popup_carga('||c.idfilial||','||c.idrepresentante||','''||c.semana||''',''N'');"><img src="#IMAGE_PREFIX#ws/small_page.gif" alt="Imprimir"></a>' Imprimir
                     , '<a href="javascript: fnc_popup_carga('||c.idfilial||','||c.idrepresentante||','''||c.semana||''',''S'');"><img src="#IMAGE_PREFIX#ws/small_page.gif" alt="Imprimir Carga +"></a>' Imprimir2
                     , decode(c.abertura,'S','Sim','N','Não') "Abertura"
                     , usuarioincluiu         "Usuário que Incluiu"
                     , datainclusao          "Data inclusão"
                     , dataultimaalteracao   "Última Alteração"
                     , usuarioultimaalteracao "Usuário Ult. Alteração"
                     , dataconclusao         "Data Conclusão"
                     , usuarioconcluiu       "Usuário Concluiu"
                     , idsemana
                     , montadapor            "Montada Por"
                from cargasrepresentantes c
                where idfilial = :P0_IDFILIAL
                 -- and c.idsemana >= 586
                order by idsemana desc, 2
                ```
        }
