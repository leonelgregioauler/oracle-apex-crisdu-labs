    process apagar (
        name: APAGAR
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  delete correcoescargarepres i
                  where i.idcargarepresentante in ( select idcargarepresentante
                                                    from cargasrepresentantes
                                                    where semana = :P16_SEMANA
                                                      and idfilial = :P0_IDFILIAL );
                  --
                  delete itenscargarepresentante i
                  where i.idcargarepresentante in ( select idcargarepresentante
                                                    from cargasrepresentantes
                                                    where semana = :P16_SEMANA
                                                      and idfilial = :P0_IDFILIAL );
                  --
                  delete cargasrepresentantes
                  where semana = :P16_SEMANA
                    and idfilial = :P0_IDFILIAL ;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Carga excluída!
        }
        advanced {
            executionMappingIdentifier: 257320186138446648
        }
        serverSideCondition {
            whenButtonPressed: @p16-apagarcarga
        }
    )

    branch (
        name: Go To Page 16
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 16
            }
        }
    )

    branch (
        name: Go To Page 502
