    process busca-informações (
        name: Busca Informações
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdocumento           varchar2(15);
                  vidrepresentante     number;
                  vnomerepresentante   varchar2(400);
                  vidregiaovenda       number;
                  vidsemana            number;
                  vidregiaorepresvenda number;
                  --
                begin
                  --
                  vdocumento := replace(replace(replace(:P469_DOCUMENTO,'.',''),'-',''),' ','');
                  --
                  begin
                    --
                    select r.idrepresentante
                         , initcap(p.nomepessoa)||' - '||decode(r.ativo,'S','Ativo','N','Inativo') nome
                         , ( select rg.idregiaorepresentante
                             from regioesrepresentantes rg
                             where rg.idrepresentante = r.idrepresentante
                               and rg.idsemana        = ( select min(idsemana)
                                                          from regioesrepresentantes rgg
                                                          where rgg.idrepresentante = rg.idrepresentante) ) idregiaorepresentante
                    into vidrepresentante
                       , vnomerepresentante
                       , vidregiaorepresvenda
                    from representantes r
                       , pessoas p
                    where r.idpessoa = p.idpessoa
                      and p.cpf      = vdocumento;
                    --
                    select rg.idregiaovenda
                         , rg.idsemana
                    into vidregiaovenda
                       , vidsemana
                    from regioesrepresentantes rg
                    where rg.idregiaorepresentante = vidregiaorepresvenda;
                    --
                  exception
                    when others then
                      null;
                  end;
                  --
                  :P469_IDREPRESENTANTE  := vidrepresentante;
                  :P469_NOMEDISTRIBUIDOR := vnomerepresentante;
                  :P469_IDREGIAOVENDA    := vidregiaovenda;
                  :P469_IDSEMANA         := vidsemana;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1528836662928351423
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P469_DOCUMENTO
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 469
                items: {
                    P469_TIPODOCUMENTO: &P469_TIPODOCUMENTO.
