    region cheques-vinculados-ao-distribuidor (
        name: Cheques vinculados ao Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDCHEQUE
                     , initcap(bb.nomebanco) Banco
                     , AGENCIA
                     , CONTA
                     , NRCHEQUE
                     , DATAINCLUSAO
                     , pck_romance.fnc_nomefilial(c.idfilial) "Filial"
                     , pck_romance.fnc_nomecidade(c.idcidade) cidade
                     , VALOR
                     , PREDATADO
                     , c.OBSERVACAO
                     , decode(c.semfundo, 'S','Sim', 'Não') Semfundo
                     , decode(c.pago, 'S','Sim', 'Não') Pago
                     , decode(c.emprestimo, 'S','Sim', 'Não') Emprestimo
                     , decode(c.perda, 'S','Sim', 'Não') Perda
                     , nvl(( select sum(cp.valor) from cheques2pgto cp where cp.idcheque = c.idcheque),0) "Valor Pago"
                     , VALOR - nvl(( select sum(cp.valor) from cheques2pgto cp where cp.idcheque = c.idcheque),0) "Saldo"
                     , null codigoliberacao
                     , nvl(( select decode(liberado,'S','Liberado','N','Não Liberado')
                             from historicosconsultacheques hc
                             where hc.idcheque = c.idcheque ),'Não Consultado.') liberacao
                from CHEQUES2 c
                   , bancos   bb
                where c.idbanco         = bb.idbanco(+)
                  and c.idrepresentante = :P469_IDREPRESENTANTE
                order by datainclusao desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent11
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P469_DOCUMENTO
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum Cheque encontrado para este distribuidor.
        }
        advanced {
            savedReportMappingIdentifier: 1528836926761351426
        }

