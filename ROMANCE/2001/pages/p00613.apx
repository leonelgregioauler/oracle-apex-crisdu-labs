    region valores-métricas (
        name: Valores Métricas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idvalormetricacampanha
                     , w.campanha
                     , w.metrica
                     , w.filial
                     , w.descnivel nivel
                     , w.pontos
                     , w.valorinicial
                     , w.valorfinal
                from vw_valoresmetricascampanhas w
                where w.idcampanha = :P613_IDCAMPANHA
                  and exists ( select 1 
                               from usuariosfiliais uf
                               where uf.usuario = v('APP_USER')
                                 and uf.idfilial = w.idfilial )
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
