    pageItem P613_IDMETRICACAMPANHA (
        type: selectList
        label {
            label: Metrica
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.descricao||' - '||decode(m.grupo,'R','Romance','F','Favorita','O','Organização','Outros') display_value
                     , m.idmetricacampanha
                from metricascampanhas m
                order by 2
                ```
        }
        layout {
            sequence: 10
            region: @gerar-valores-de-métricas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
