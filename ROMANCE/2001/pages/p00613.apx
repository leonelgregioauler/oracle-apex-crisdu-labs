    pageItem P613_IDCAMPANHA (
        type: radioGroup
        label {
            label: Campanha
            alignment: left
        }
        settings {
            noOfCols: 5
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.descricao||' - '||c.identificacao
                     , c.idcampanha
                from campanhas c
                where c.tipocampanha = 'M'
                  and c.idcampanha >= 15
                order by 2 desc
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @métricas-da-campanha
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 15
        }
        security {
            encryptSessionState: false
        }
    )

