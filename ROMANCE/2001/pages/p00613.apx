page 613 (
    name: Operacional
    title: Operacional
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_excluir(vidreprescamp)
            {
              
              apex.confirm("Deseja realmente excluir este Distribuidor?"
                         , {  request:"EXCLUIR_REPRES"
                            , set:{"P613_IDEXCLUIR":vidreprescamp}}
                           );
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

