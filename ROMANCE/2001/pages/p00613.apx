    region métricas-da-campanha (
        name: Métricas da Campanha
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select mc.idmetricacampanha
                     , mc.descricao
                     , mc.grupo
                     , case
                         when mc.idcampanha = 8 then
                           decode(mc.grupo,'R','Romance','F','Favorita','O','Organização') 
                         when mc.idcampanha = 10 then
                           ( select p.nome
                             from pilaresmetricas p
                             where p.sigla = mc.grupo ) 
                       end descgrupo
                     , mc.tipo
                     , idmetricacampanha idmetrica
                from metricascampanhas mc
                where mc.idcampanha = :P613_IDCAMPANHA
                ```
            pageItemsToSubmit: P613_IDCAMPANHA
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
