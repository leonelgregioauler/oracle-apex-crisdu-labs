    pageItem P613_IDSEMANA_CONTROLE (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta 
                     , s.idsemana
                from semana_dias s
                   , campanhas c
                where c.tipocampanha = 'M'
                  and c.idcampanha = 16
                  and s.idsemana between pck_util.fnc_idsemana(c.semanaini) and pck_util.fnc_idsemana(c.semanafim) 
                order by 2
                ```
        }
        layout {
            sequence: 20
