    region distribuidores-participantes (
        name: "Distribuidores Participantes "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.idrepresentantecampanha
                     , r.idrepresentante
                     , pck_romance.fnc_nomerepresentante(r.idrepresentante) representante
                     , r.idsemana
                     , pck_util.fnc_semanaid(idsemana) semana
                     , '<a href="javascript: fnc_excluir('||r.idrepresentantecampanha||');"><img src="#APP_IMAGES#excluir.png" alt=""/></a>' excluir
                from representantescampanhas r
                where r.idfilial = :P613_IDFILIAL_CONTROLE
                  and r.idsemana = :P613_IDSEMANA_CONTROLE
                ```
        }
        layout {
            sequence: 10
            parentRegion: @controle-de-distribuidores
            slot: subRegions
        }
