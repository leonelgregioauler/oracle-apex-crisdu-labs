    process remove-distribuidor-na-campanha (
        name: Remove Distribuidor na Campanha
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidrepresentantecampanha number := :P613_IDEXCLUIR;
                  vidcampanha              number;  
                  vidfilial                number;
                  vidsemana                number;
                  vidrepresentante         number;
                  vmd5                     varchar2(1000);
                  --
                begin
                  -- 
                  pck_campanhas.prc_representantescampanhas(pidrepresentantecampanha => vidrepresentantecampanha,
                                                            pidcampanha => vidcampanha,
                                                            pidfilial => vidfilial,
                                                            pidsemana => vidsemana,
                                                            pidrepresentante => vidrepresentante,
                                                            pmd5 => vmd5,
                                                            poperacao_dml => 'D');
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Distribuidor Removido com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5579631139252155918
        }
        serverSideCondition {
            type: request=Value
            value: EXCLUIR_REPRES
        }
    )

