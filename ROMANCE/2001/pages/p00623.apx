page 623 (
    name: Analise de Consultoras
    title: Analise de Consultoras
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region notas-de-consultoras (
        name: Notas de Consultoras
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.numeronota
                     , roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) Distribuidor
                     , p.nomepessoa
                     , p.cpf
                     , nv.datanota
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , decode(nv.idsituacaonotavenda,'3','Aguardando Acerto','4','Acerto Efetuado') Situação 
                from roman.notasvendas nv
                   , catal.vendedoras v 
                   , catal.pessoas p
                where nv.idvendedora = v.idvendedora
                  and v.idpessoa  = p.idpessoa  
                  and v.ativo = 'S' 
                  and nv.idsituacaonotavenda != 5
                  and nv.datanota between to_date(:P623_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P623_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and exists ( select 1
                               from catal.cidades c
                               where c.idcidade = p.idcidade
                                 and c.idcidade = :P623_IDCIDADE)
                  and exists ( select 1
                              from roman.vw_filiais f
                              where f.idfilial = nv.idfilial
                              and f.idfilial = :P623_IDFILIAL )
                order by 3
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        download {
            csvExportEnabled: true
            filename: notas_consultora
        }

        column CPF (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: CPF
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column DATANOTA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Data Nota
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column DISTRIBUIDOR (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column NOMEPESSOA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column NUMERONOTA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Número Nota
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column SEMANACOBRANCA (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Semana de Cobrança
                alignment: center
            }
            layout {
                sequence: 7
            }
            sorting {
                sortable: false
            }
        )

        column SEMANADISTRIBUICAO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Semana de Distribuição
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column SITUAÇÃO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Situação
                alignment: center
            }
            layout {
                sequence: 8
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P623_DATAFIM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @notas-de-consultoras
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P623_DATAINICIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @notas-de-consultoras
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P623_IDCIDADE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @notas-de-consultoras
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P623_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @notas-de-consultoras
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

