page 248 (
    name: Histórico
    title: Histórico
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region histórico (
        name: Histórico
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select fr.idfechamentorepres
                     , pck_romance.fnc_nomerepresentante(pidrepresentante => fr.idrepresentante) Representante
                     , ( select rv.descricao 
                         from regioesvenda rv
                         where rv.idregiaovenda = fr.idregiaovenda ) "Região"
                     , fr.semana
                     , ( select semana
                         from fechamentossemanais f
                         where f.idfechamento = fr.idfechamentopontuacao) semanafechamento
                     , fr.saldo 
                     , fr.idfechamentorepres ID
                     , ( select listagg(da.observacao,' ') within group (order by 1)
                         from depositosdiarios_orig da
                         where da.idfechamentorepres = fr.idfechamentorepres ) alteracoes 
                     , fr.observacao
                     , fr.observacaoproximoacerto
                     , fr.dataacerto
                     , fr.usuarioacerto
                from fechamentorepresentantes fr
                where fr.idrepresentante = :P248_IDREPRESENTANTE
                  AND FR.idfechamentorepres <= :P248_IDFECHAMENTOREPRES
                ORDER BY 1 DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 200
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column ALTERACOES (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Obs Depósitos
                alignment: center
            }
            layout {
                sequence: 8
            }
            sorting {
                sortable: false
            }
        )

        column DATAACERTO (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Data Acerto
                alignment: center
            }
            layout {
                sequence: 11
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Id
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column IDFECHAMENTOREPRES (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column OBSERVACAO (
