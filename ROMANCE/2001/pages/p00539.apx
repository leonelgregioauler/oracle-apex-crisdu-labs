page 539 (
    name: Análise de Inadimplência
    title: Análise de Inadimplência
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region análise-de-inadimplência-romance (
        name: Análise de Inadimplência Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 99
                     , '- Total -' descricao
                     , sum(total.vend) "Vendedoras"
                     , '=' s1
                     , sum(total.qtd) "Qtd Venda"
                     , 100 perc0
                     , '-' s3
                     , sum(total.qtdquitado) "Qtd Quitado"
                     , round((sum(total.qtdquitado)/sum(total.qtd)*100),2) perc1
                     , sum(total.qtddebito) "Qtd Débito"
                     , round((sum(total.qtddebito)/sum(total.qtd)*100),2) perc2
                     , '|' s2
                     , sum(total.valortotal) "Total"
                     , sum(total.valorquitado) "Quitado"
                     , round((sum(total.valorquitado)/sum(total.valortotal)*100),2) perc3
                     , sum(total.valordebito) "Débito"
                     , round((sum(total.valordebito)/sum(total.valortotal)*100),2) perc4
                     , sum(valortotalnota) valortotalnota    
                     , sum(valortotalvenda) valortotalvenda
                     , sum(valortotalvenda) * 100 / sum(valortotalnota) pervenda
                from ( select ( venda.quantidade + debito.quantidade ) qtd
                            , ( venda.vend       + debito.vend       ) vend
                            , venda.quantidade qtdquitado
                            , debito.quantidade qtddebito
                            , round((venda.valor + debito.valor),2 ) valortotal
                            , round(venda.valor,2) valorquitado
                            , round(debito.valor,2) valordebito                       
                            , round(venda.valortotalnota,2) valortotalnota   
                            , round(venda.valortotalvenda,2) valortotalvenda
                       from nivelfaturamento n
                          , ( 
                               select nf.idfaturamento
                                    , count( distinct idnotavenda ) quantidade
                                    , count( distinct idvendedora ) vend
                                    , sum(nv.valortotalvendalqd*nv.fatorconversao) valor
                                    , sum(nv.valortotalnota*nv.fatorconversao) valortotalnota   
                                    , sum(nv.valortotalvenda*nv.fatorconversao) valortotalvenda
                               from notasvendas nv
                                  , nivelfaturamento nf
                               where nv.dataacerto between to_date(:P539_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P539_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                 and ( :P539_TIPOPESQUISA = 'T'
                                     or ( :P539_TIPOPESQUISA = 'D' and nv.idrepresentante = :P539_IDREPRESENTANTE )
                                     or ( :P539_TIPOPESQUISA = 'F' and nv.idfilial = :P539_IDFILIAL )
                                     or ( :P539_TIPOPESQUISA = 'G' and nv.idfilial in ( select idfilial 
                                                                                        from filtrosfiliais ff
                                                                                        where ff.usuario = v('APP_USER') ) ) )
                                 and nv.idsituacaonotavenda = 4 
                                 and (nv.valortotalvendalqd*nv.fatorconversao) between nf.valorinicio and nf.valorfim
                                 and nv.valortotalvendalqd > 0
                                 and nv.saldo <= 0
                /*                 and exists ( select 1
                                              from vendedoras v
                                              where v.idvendedora = nv.idvendedora
                                                and v.ativo       = 'S' )         */
                               group by idfaturamento ) venda
                           , ( 
                               select nf.idfaturamento
                                    , count( distinct idnotavenda ) quantidade
                                    , count( distinct idvendedora ) vend
                                    , sum(nv.valortotalvendalqd*nv.fatorconversao) valor  
                                    , sum(nv.valortotalnota*nv.fatorconversao) valortotalnota  
                                    , sum(nv.valortotalvenda*nv.fatorconversao) valortotalvenda
                               from notasvendas nv
                                  , nivelfaturamento nf
                               where nv.dataacerto between to_date(:P539_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P539_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                 and nv.idsituacaonotavenda = 4 
                                 and ( :P539_TIPOPESQUISA  = 'T' 
                                     or ( :P539_TIPOPESQUISA = 'D' and nv.idrepresentante = :P539_IDREPRESENTANTE )
                                     or ( :P539_TIPOPESQUISA = 'F' and nv.idfilial = :P539_IDFILIAL )
                                     or ( :P539_TIPOPESQUISA = 'G' and nv.idfilial in ( select idfilial 
                                                                                        from filtrosfiliais ff
                                                                                        where ff.usuario = v('APP_USER') ) ) )
                                 and (nv.valortotalvendalqd*nv.fatorconversao) between nf.valorinicio and nf.valorfim
                                 and nv.valortotalvendalqd > 0
                                 and nv.saldo > 0 
                /*                 and exists ( select 1
                                              from vendedoras v
                                              where v.idvendedora = nv.idvendedora
                                                and v.ativo       = 'S' )*/
                               group by idfaturamento ) debito
                          where n.idfaturamento = venda.idfaturamento(+)
                            and n.idfaturamento = debito.idfaturamento(+) ) total
                where :P539_DATAINICIO is not null
                union
                select n.idfaturamento
                     , n.descricao
                     , ( nvl(venda.vend,0) + nvl(debito.vend,0) ) 
                     , '|'
                     , ( nvl(venda.quantidade,0) + nvl(debito.quantidade,0) )
                     , case 
                         when tot.quantidade > 0 then
                           round( (( nvl(venda.quantidade,0) + nvl(debito.quantidade,0) ) / tot.quantidade * 100 ),2)
                         else
                           0
                       end
                     , '-'
                     , nvl(venda.quantidade,0)
                     , case
                         when nvl(venda.quantidade,0) = 0 then
                           0
                         else
                           round(( venda.quantidade / (venda.quantidade + nvl(debito.quantidade,0)) * 100 ),2)
                       end
                     , nvl(debito.quantidade,0)
                     , case
                         when nvl(debito.quantidade,0) = 0 then
                           0
                         else
                           round(( debito.quantidade / (nvl(venda.quantidade,0) + debito.quantidade) * 100 ),2)
                       end
                     , '|'
                     , round( nvl(venda.valor,0) + nvl(debito.valor,0),2)
                     , round(nvl(venda.valor,0),2)
                     , case
                         when nvl(venda.valor,0) = 0 then
                           0
                         else
                           round((venda.valor/(venda.valor+nvl(debito.valor,0))*100),2)
                       end
                     , round(nvl(debito.valor,0),2)
                     , case
                         when nvl(debito.valor,0) = 0 then
                           0
                         else
                           round((debito.valor/(nvl(venda.valor,0)+debito.valor)*100),2)
                       end
                     , venda.valortotalnota
                     , venda.valortotalvenda
                     , venda.valortotalvenda * 100 / venda.valortotalnota percvenda
                from nivelfaturamento n
                   , ( 
                        select count( distinct idnotavenda ) quantidade
                             , count( distinct idvendedora ) vend
                        from notasvendas nv
                           , nivelfaturamento nf
                        where nv.dataacerto between to_date(:P539_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P539_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')  
                          and nv.idsituacaonotavenda = 4 
                          and ( :P539_TIPOPESQUISA = 'T'
                             or ( :P539_TIPOPESQUISA = 'D' and nv.idrepresentante = :P539_IDREPRESENTANTE )
                             or ( :P539_TIPOPESQUISA = 'F' and nv.idfilial = :P539_IDFILIAL )
                             or ( :P539_TIPOPESQUISA = 'G' and nv.idfilial in ( select idfilial 
                                                                                from filtrosfiliais ff
                                                                                where ff.usuario = v('APP_USER') ) ) )
                          and (nv.valortotalvendalqd*nv.fatorconversao) between nf.valorinicio and nf.valorfim
                          and nv.valortotalvendalqd > 0
                          and nv.saldo <= 0
                /*          and exists ( select 1
                                       from vendedoras v
                                       where v.idvendedora = nv.idvendedora
                                         and v.ativo       = 'S' )*/ ) tot
                   , ( 
                        select nf.idfaturamento
                             , count( distinct idnotavenda ) quantidade
                             , count( distinct idvendedora ) vend
                             , sum(nv.valortotalvendalqd*nv.fatorconversao) valor
                             , sum(nv.valortotalnota*nv.fatorconversao) valortotalnota    
                             , sum(nv.valortotalvenda*nv.fatorconversao) valortotalvenda         
                        from notasvendas nv
                           , nivelfaturamento nf
                        where nv.dataacerto between to_date(:P539_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P539_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')  
                          and nv.idsituacaonotavenda = 4 
                          and ( :P539_TIPOPESQUISA = 'T'
                             or ( :P539_TIPOPESQUISA = 'D' and nv.idrepresentante = :P539_IDREPRESENTANTE )
                             or ( :P539_TIPOPESQUISA = 'F' and nv.idfilial = :P539_IDFILIAL )
                             or ( :P539_TIPOPESQUISA = 'G' and nv.idfilial in ( select idfilial 
                                                                                from filtrosfiliais ff
                                                                                where ff.usuario = v('APP_USER') ) ) )
                          and (nv.valortotalvendalqd*nv.fatorconversao) between nf.valorinicio and nf.valorfim
                          and nv.valortotalvendalqd > 0
                          and nv.saldo <= 0
                /*          and exists ( select 1
                                       from vendedoras v
                                       where v.idvendedora = nv.idvendedora
                                         and v.ativo       = 'S' )*/
                        group by idfaturamento ) venda
                    , ( 
                        select nf.idfaturamento
                             , count( distinct idnotavenda ) quantidade
                             , count( distinct idvendedora ) vend
                             , sum(nv.valortotalvendalqd*nv.fatorconversao) valor  
                             , sum(nv.valortotalvenda*nv.fatorconversao) valortotalvenda
                        from notasvendas nv
                           , nivelfaturamento nf
                        where nv.dataacerto between to_date(:P539_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P539_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') 
                          and nv.idsituacaonotavenda = 4 
                          and (nv.valortotalvendalqd*nv.fatorconversao) between nf.valorinicio and nf.valorfim
                          and nv.valortotalvendalqd > 0
                          and ( :P539_TIPOPESQUISA = 'T'
                             or ( :P539_TIPOPESQUISA = 'D' and nv.idrepresentante = :P539_IDREPRESENTANTE )
                             or ( :P539_TIPOPESQUISA = 'F' and nv.idfilial = :P539_IDFILIAL )
                             or ( :P539_TIPOPESQUISA = 'G' and nv.idfilial in ( select idfilial 
                                                                                from filtrosfiliais ff
                                                                                where ff.usuario = v('APP_USER') ) ) )
                          and nv.saldo > 0 
                 /*         and exists ( select 1
                                       from vendedoras v
                                       where v.idvendedora = nv.idvendedora
                                         and v.ativo       = 'S' )*/
                        group by idfaturamento ) debito
                where n.idfaturamento = venda.idfaturamento(+)
                  and n.idfaturamento = debito.idfaturamento(+)
                  and :P539_DATAINICIO is not null
                order by 1
                
                ```
        }
