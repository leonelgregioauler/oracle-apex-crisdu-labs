    pageItem P539_CONSULTORASUNICAS (
        type: displayOnly
        label {
            label: Consultoras Únicas
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vqtd varchar2(100);
                begin
                    select '<B>'|| TRIM(to_char(count( distinct idvendedora ),'999G999G990')) ||'</B>' vend
                    into vqtd
                    from notasvendas nv
                     where nv.dataacerto between to_date(:P539_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P539_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                       and ( :P539_TIPOPESQUISA = 'T'
                           or ( :P539_TIPOPESQUISA = 'D' and nv.idrepresentante = :P539_IDREPRESENTANTE )
                           or ( :P539_TIPOPESQUISA = 'F' and nv.idfilial = :P539_IDFILIAL )
                           or ( :P539_TIPOPESQUISA = 'G' and nv.idfilial in ( select idfilial 
                                                                              from filtrosfiliais ff
                                                                              where ff.usuario = v('APP_USER') ) ) )
                       and nv.idsituacaonotavenda = 4;
                     
                     return vqtd;
                exception
                 when others then
                    return '0' ;
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

