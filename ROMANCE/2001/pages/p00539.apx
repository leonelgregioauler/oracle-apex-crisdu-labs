        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P539_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and exists ( select 1
                               from usuariosfiliais u
                               where u.usuario = v('APP_USER')
                                 and u.idfilial = f.idfilial )
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P539_IDFILIAL_REP (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idgerente
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                ```
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P539_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||'('||decode(r.ativo,'S','Ativo','N','Inativo')||')' display_value
                     , r.idrepresentante return_value
                from pessoas p
                   , representantes r
                where r.idpessoa = p.idpessoa 
                  and r.idgerente = :P539_IDFILIAL_REP
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P539_IDFILIAL_REP
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P539_TIPOPESQUISA (
        type: radioGroup
        label {
            label: Pesquisar Por
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Empresa'
                     , 'F'
                from dual
                union
                select 'Grupo de Empresas'
                     , 'G'
                from dual
                where exists ( select 1
                               from usuariosgruposatendimento ug
                               where ug.idgrupoatendimento in (0,20)
                                 and ug.usuario            = v('APP_USER') )
                union
                select 'Distribuidor'
                     , 'D'
                from dual
                where exists ( select 1
                               from usuariosgruposatendimento ug
                               where ug.idgrupoatendimento in (0,20)
                                 and ug.usuario            = v('APP_USER') )
                union
                select 'Todas'
                     , 'T'
                from dual
                where exists ( select 1
                               from usuariosgruposatendimento ug
                               where ug.idgrupoatendimento in (0,20)
                                 and ug.usuario            = v('APP_USER') )
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: F
        }
        security {
            encryptSessionState: false
        }
    )

    button add-filiais (
        buttonName: ADD_FILIAIS
        label: + Empresas
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 540
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-d (
        name: Tipo D
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P539_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P539_TIPOPESQUISA
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P539_IDREPRESENTANTE
                    P539_IDFILIAL_REP
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P539_IDREPRESENTANTE
                    P539_IDFILIAL_REP
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-f (
        name: Tipo F
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P539_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P539_TIPOPESQUISA
            value: F
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P539_IDFILIAL
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P539_IDFILIAL
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-g (
        name: Tipo G
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P539_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P539_TIPOPESQUISA
            value: G
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @add-filiais
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: button
                button: @add-filiais
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 539
                items: {
                    P539_IDFILIAL_REP: &P539_IDFILIAL_REP.
                    P539_IDREPRESENTANTE: &P539_IDREPRESENTANTE.
                    P539_IDFILIAL: &P539_IDFILIAL.
                    P539_TIPOPESQUISA: &P539_TIPOPESQUISA.
                    P539_DATAINICIO: &P539_DATAINICIO.
                    P539_DATAFIM: &P539_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

