page 529 (
    name: Detalhamento Estoque Distribuidor
    title: Detalhamento Estoque Distribuidor
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region itens-do-estoque (
        name: Itens do Estoque
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                      c.nome categoria
                     , vp.produto
                     , vp.codigo
                     , vp.quantidade
                    -- , vp.totalcusto
                     , vp.totalvenda
                     , decode(vp.comissao,'S','Com Comissão','N','Sem Comissão') comissao
                     , vp.valorvenda
                from roman.vw_pecas_produtos_repres vp
                   , roman.produtos p
                   , roman.categorias c
                where vp.idproduto       = p.idproduto
                  and p.idcategoria      = c.idcategoria
                  and vp.idrepresentante = :P529_ID_REPRESENTANTE
                  and vp.comissao        = :P529_COM_SEM_COMISSAO
                  and vp.idfilial        = :P0_IDFILIAL
                  and vp.quantidade > 0
                  and vp.totalcusto > 0
                  and vp.totalvenda > 0
                order by c.nome, vp.produto
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1502518562040732605
        }

        column CATEGORIA (
            type: plainText
            heading {
                heading: Categoria
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column CODIGO (
            type: plainText
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column COMISSAO (
            type: hidden
            heading {
                heading: Comissão
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
            security {
                escapeSpecialChars: false
            }
        )

        column PRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column TOTALVENDA (
            type: plainText
            heading {
                heading: Total Venda
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column VALORVENDA (
            type: plainText
            heading {
                heading: Valor Venda
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 15025503 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn CATEGORIA (
                sequence: 1
            )

            displayColumn CODIGO (
                sequence: 3
            )

            displayColumn PRODUTO (
                sequence: 2
            )

            displayColumn QUANTIDADE (
                sequence: 4
            )

            displayColumn TOTALVENDA (
                sequence: 6
            )

            displayColumn VALORVENDA (
                sequence: 5
            )

            aggregate (
                column: QUANTIDADE
            )

            aggregate (
                column: TOTALCUSTO
            )

            aggregate (
                column: TOTALVENDA
            )

            aggregate (
                column: VALORVENDA
            )

        )

    )

    pageItem P529_COM_SEM_COMISSAO (
        type: hidden
        layout {
            sequence: 20
            region: @itens-do-estoque
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P529_ID_REPRESENTANTE (
        type: hidden
        layout {
            sequence: 10
            region: @itens-do-estoque
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

