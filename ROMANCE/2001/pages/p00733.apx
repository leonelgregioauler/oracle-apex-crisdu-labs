    process gerarciclo (
        name: GerarCiclo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    declare
                        l_exists number;
                    begin
                        select 1
                          into l_exists
                          from roman.metasdesafioromance m
                         where m.cicloromance = :P733_CICLOROMANCE
                           and rownum = 1
                           and exists ( select 1
                                          from catal.filiais f
                                         where f.idfilial = m.idfilial
                                           and f.ididioma = :P733_PAIS );
                        
                        apex_error.add_error(
                            p_message => 'O ciclo já existe para o país!', 
                            p_display_location => apex_error.c_inline_in_notification  
                        );
                
                        --apex_application.stop_apex_engine; -- Termina o processamento
                    exception
                        when no_data_found then
                            if :P733_CICLOROMANCE is not null then
                                pck_metasromance.prc_gerametasdesafioromance(:P733_CICLOROMANCE,
                                                                             V('APP_USER'),
                                                                             'N',
                                                                             :P733_PAIS);
                                commit;
                            end if;
                    end;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        successMessage {
            successMessage: Novo ciclo gerado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 2434653723405320560
        }
        serverSideCondition {
            type: request=Value
            value: GERARCICLO
        }
    )

    process popula-os-itens-da-pagina (
        name: Popula os itens da pagina
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  --
                  :P733_DATACRIACAOCICLO      := NULL;
                  :P733_USUARIOCRIACAO        := NULL;
                  :P733_CICLOCONGELADO        := NULL;
                  :P733_DATACONGELADO         := NULL;
                  :P733_USUARIOCONGELAMENTO   := NULL; 
                  :P733_DESAFIOCALCULADOATUAL := NULL;
                  --
                  SELECT to_char(datacriacao, 'dd/mm/rrrr hh24:mi:ss')
                       , usuariocriacao
                       , decode(ciclocongelado, 'S', 'Sim', 'Não')
                       , to_char(datacongelado, 'dd/mm/rrrr hh24:mi:ss')
                       , usuariocongelamento
                       , to_char(sum(desafiocalculadoatual), '999G999G999G999G990D00')
                    INTO :P733_DATACRIACAOCICLO
                       , :P733_USUARIOCRIACAO
                       , :P733_CICLOCONGELADO
                       , :P733_DATACONGELADO
                       , :P733_USUARIOCONGELAMENTO
                       , :P733_DESAFIOCALCULADOATUAL
                    FROM roman.metasdesafioromance m
                       , catal.filiais f
                   WHERE cicloromance = :P733_CICLOROMANCE
                     AND m.idfilial = f.idfilial
                     AND f.idfilial NOT IN (1217, 1246, 1063, 1149)
                     AND f.ididioma = :P733_PAIS
                  GROUP BY to_char(datacriacao, 'dd/mm/rrrr hh24:mi:ss')
                         , usuariocriacao
                         , decode(ciclocongelado, 'S', 'Sim', 'Não')
                         , to_char(datacongelado, 'dd/mm/rrrr hh24:mi:ss')
                         , usuariocongelamento;
                
                EXCEPTION
                  WHEN NO_DATA_FOUND THEN
                    NULL;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 23793798965416501
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

