    pageItem P733_PAIS (
        type: selectList
        label {
            label: País:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome
                     , p.idpais
                from paises p
                where exists ( select 1
                               from filiais f
                               where f.ididioma = p.idpais
                                 and f.tipofilial = 'D'
                                 and f.ativo = 'S' )
                ```
            nullDisplayValue: - Selecione um País -
