    region desafios-romance (
        name: Desafios Romance
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT m.idmetadesafioromance
                     , m.idfilial
                     , m.ano
                     , m.cicloromance
                     , m.desafiocalculadoanterior
                     , m.desafioperccrescimento
                     , m.desafiocalculadoatual
                     , m.mediasemanal
                     , m.ciclocongelado
                     , m.usuariocriacao
                     , m.usuariocongelamento
                  --, :P733_DATACONGELADO DATACONGELADO
                  FROM roman.metasdesafioromance m
                     , catal.filiais f
                 WHERE m.idfilial = f.idfilial
                   AND m.cicloromance = :P733_CICLOROMANCE
                   AND f.idfilial NOT IN (1217, 1246, 1063, 1149)
                   AND f.ididioma = :P733_PAIS
                   /*AND (nvl(:P733_PAIS,'T') = 'T' OR (:P733_PAIS ='B' and f.ididioma = 1)
                                                   OR (:P733_PAIS ='E' and f.ididioma != 1))*/
                ```
            pageItemsToSubmit: P733_CICLOROMANCE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
