    dynamicAction new (
        name: New_1
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P733_CICLOROMANCE
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(datacriacao,'dd/mm/rrrr hh24:mi:ss'),
                           usuariocriacao,
                           decode(ciclocongelado,'S','Sim','Não'),
                           to_char(datacongelado,'dd/mm/rrrr hh24:mi:ss'),
                           usuariocongelamento,
                           to_char(sum(desafiocalculadoatual),'999G999G999G999G990D00')
                      from metasdesafioromance m
                         , catal.filiais f
                     where cicloromance = :P733_CICLOROMANCE
                       and m.idfilial = f.idfilial
                       and f.idfilial not in (1217,1246,1063,1149)
                       and (nvl(:P733_PAIS,'T') = 'T' OR (:P733_PAIS ='B' and f.ididioma = 1)
                                                      OR (:P733_PAIS ='N' and f.ididioma != 1))
                      group by to_char(datacriacao,'dd/mm/rrrr hh24:mi:ss'),
                           usuariocriacao,
                           decode(ciclocongelado,'S','Sim','Não'),
                           to_char(datacongelado,'dd/mm/rrrr hh24:mi:ss'),
                           usuariocongelamento
                        --and rownum = 1
                    ```
                itemsToSubmit: P733_CICLOROMANCE
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: [
                    P733_DATACRIACAOCICLO
                    P733_USUARIOCRIACAO
                    P733_CICLOCONGELADO
                    P733_DATACONGELADO
                    P733_USUARIOCONGELAMENTO
                    P733_DESAFIOCALCULADOATUAL
                ]
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction recalculapercentual (
        name: RecalculaPercentual
        execution {
            sequence: 130
        }
        when {
            selectionType: columns
            interactiveGrid: @desafios-romance
            columns: DESAFIOCALCULADOATUAL
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression:
                    ```plsql
                    CASE WHEN TO_NUMBER(:DESAFIOCALCULADOANTERIOR,'99999999999999999D00') > 0 AND 
                              TO_NUMBER(:DESAFIOCALCULADOATUAL,'99999999999999999D00') > 0 
                         THEN TO_CHAR( (TO_NUMBER(:DESAFIOCALCULADOATUAL,'99999999999999999D00') * 100 / 
                                        TO_NUMBER(:DESAFIOCALCULADOANTERIOR,'99999999999999999D00') )-100 ,
                                      '999999990D000') 
                                      --'999G999G999G999G990D000') 
                         ELSE
                            0 --TO_CHAR(TO_NUMBER(:DESAFIOPERCCRESCIMENTO,'99999999999999999D00') ,'999G999G999G999G990D000')
                     END
                    
                    ```
                itemsToSubmit: [
                    DESAFIOCALCULADOANTERIOR
                    DESAFIOCALCULADOATUAL
                ]
            }
            affectedElements {
                selectionType: columns
                columns: DESAFIOPERCCRESCIMENTO
            }
            execution {
                sequence: 10
            }
        )

    )

