    dynamicAction calculamediasemanal (
        name: CalculaMediaSemanal
        execution {
            sequence: 110
        }
        when {
            selectionType: columns
            interactiveGrid: @desafios-romance
            columns: DESAFIOCALCULADOATUAL
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: columns
                columns: MEDIASEMANAL
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression:
                    ```plsql
                    TO_CHAR(TO_NUMBER(TRIM(:DESAFIOCALCULADOATUAL),'99999999999999999D00') / 6 ,'999G999G999G999G990D00')
                    
                    ```
                itemsToSubmit: DESAFIOCALCULADOATUAL
            }
            affectedElements {
                selectionType: columns
                columns: MEDIASEMANAL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction confirmaatualizar (
        name: ConfirmaAtualizar
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @atualizarciclo
        }

