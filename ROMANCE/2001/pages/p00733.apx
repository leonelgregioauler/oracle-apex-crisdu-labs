        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM roman.metasdesafioromance c
                 WHERE c.cicloromance = :P733_CICLOROMANCE
                   AND EXISTS ( SELECT 1
                                  FROM catal.filiais f
                                 WHERE f.idfilial = c.idfilial
                                   AND ( f.ididioma = :P733_PAIS
                                      OR :P733_PAIS IS NULL ))
                   AND rownum = 1
                ```
        }
