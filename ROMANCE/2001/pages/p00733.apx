    pageItem P733_CICLOROMANCE (
        type: selectList
        label {
            label: Ciclo:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CICLOROMANCE || ' - Semana  ' ||
                       (select semanacompleta semanaini
                          from semana_dias 
                         where idsemana = (select min(idsemana)
                                             from semana_dias
                                            where cicloromance = sd.cicloromance)) 
                       || ' Até ' ||
                       (select semanacompleta semanaini
                          from semana_dias 
                         where idsemana = (select max(idsemana)
                                             from semana_dias
                                            where cicloromance = sd.cicloromance))   D
                     --
                     , CICLOROMANCE R
                  FROM (
                         SELECT distinct s.cicloromance 
                           FROM semana_dias s
                              , metasdesafioromance m
                          WHERE s.cicloromance is not null
                            AND s.cicloromance = m.cicloromance
                         --
                         UNION 
                         --
                         SELECT cicloromance 
                           FROM semana_dias
                          WHERE idsemana = ( SELECT min(idsemana)
                                               FROM semana_dias 
                                              WHERE idsemana > ( SELECT max(idsemana)
                                                                   FROM semana_dias 
                                                                  WHERE cicloromance = (SELECT cicloromance
                                                                                          FROM metasdesafioromance 
                                                                                         where idmetadesafioromance = (select max(idmetadesafioromance)
                                                                                                                         from metasdesafioromance ) ) ) )
                           AND exists (SELECT 1
                                         FROM metasdesafioromance) 
                  
                         --
                         UNION ALL
                         --
                         SELECT cicloromance
                           FROM semana_dias
                          WHERE trunc(sysdate) between dt_ini and dt_fim
                            AND not exists (SELECT 1
                                              FROM metasdesafioromance)
                         --
                         union
                         --
                         SELECT cicloromance
                           FROM semana_dias
                          --WHERE ano = extract(year from sysdate) ) SD
                          WHERE ano in (extract(year from sysdate),extract(year from sysdate)+1 ) ) SD
                  --
                  ORDER BY to_number(substr(cicloromance,4,4)), 
                           to_number(substr(cicloromance,1,2))
                           
                           /*(select idsemana
                                              from semana_dias
                                             where trunc(sysdate) between dt_ini and dt_fim)*/
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            height: 1
        }
        readOnly {
            type: itemIsNotNull
            item: P733_CICLOROMANCE
        }
        security {
            encryptSessionState: false
        }
    )

