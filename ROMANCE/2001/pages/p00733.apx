    button atualizarciclo (
        buttonName: AtualizarCiclo
        label: Atualizar Ciclo
        layout {
            sequence: 30
            region: @botoes
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM roman.metasdesafioromance m
                 WHERE m.cicloromance = :P733_CICLOROMANCE
                   AND rownum = 1
                   AND m.ciclocongelado = 'N'
                   AND EXISTS ( SELECT 1
                                FROM catal.filiais f
                                WHERE f.idfilial = m.idfilial
                                  AND f.ididioma = :P733_PAIS )
                ```
        }
        comments {
            comments: Somente ciclos ABERTOS podem ser atualizados
        }
    )

    button congelarciclo (
        buttonName: CongelarCiclo
        label: Congelar Ciclo
        layout {
            sequence: 40
            region: @botoes
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM roman.metasdesafioromance m
                 WHERE m.cicloromance = :P733_CICLOROMANCE
                   AND ROWNUM = 1
                   AND m.datacongelado IS NULL
                   AND :P733_PAIS IS NOT NULL
                   AND EXISTS ( SELECT 1
                                  FROM roman.acessos a
                                 WHERE a.idaplicacao = 2785
                                   AND a.usuario = v('APP_USER') )
                   AND EXISTS ( SELECT 1
                                FROM catal.filiais f
                                WHERE f.idfilial = m.idfilial
                                  AND f.ididioma = :P733_PAIS );
                ```
        }
        comments {
            comments: Somente ciclos ABERTOS podem ser atualizados
        }
    )

