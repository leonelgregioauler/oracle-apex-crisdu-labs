page 1 (
    name: Início
    title: Início
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function abresistema(pid)
            {
             window.open('f?p='+pid+'::APP_SESSION:');
            }
            //$( "#dialogAPP" ).dialog();
            ```
        executeWhenPageLoads:
            ```javascript-browser
            $(window).on("theme42ready", function() {
            
               if ($("body").hasClass("js-navExpanded")) {
            
               $("#t_Button_navControl").click();
            
              }
            
            });
            ```
    }
    css {
        fileUrls: http://code.jquery.com/ui/1.9.2/themes/redmond/jquery-ui.css
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region aviso (
        name: Aviso
        type: staticContent
        layout {
            sequence: 60
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from vw_filiais f
                where f.idfilial = :P0_IDFILIAL
                  and f.ididioma = 4
                union
                select 1
                from dual 
                where :P0_IDFILIAL = 1129
                ```
        }
    )

    region aviso-2 (
        name: Aviso
        type: staticContent
        layout {
            sequence: 50
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                Devido a situação atual, a partir de <b>segunda-feira (23/03/2020)</b> a T.I trabalhará em formato Home Office.<br>
                Caso necessite suporte, nos chame no <b>WhatsApp</b> que ajudamos você.<br>
                Contatos:<br><br>
                
                - 51 9 82810011 (Suporte Romance)<br>
                - 51 9 80423097 (Suporte Minha Sacola)<br>
                - 51 9 81018384 (Suporte Infra/Equipamentos)<br><br>
                
                Aqui vão algumas dicas: <br><br>
                
                <b>- Lave com frequência as mãos.</b><br>
                <b>- Evite aglomerações.</b><br>
                <b>- Fique atento aos sintomas.</b>
                ```
        }
        serverSideCondition {
            type: never
        }
    )

    region início (
        name: Início
        type: list
        source {
            list: @menu-de-navegação
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--3cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

    region lista-de-ações-pendentes (
        name: Lista de Ações Pendentes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Verificar '||count(1) ||' nota(s) antiga(s) não atendida(s).' as "Ação Pendente",
                       '<a href="'||'f?p=&APP_ID.:36:'||:APP_SESSION||':IR_REPORT_4703628:::P36_RELATORIOPRONTO:S'||'"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""></a>' as "Verificar"
                from notasvendas n
                where n.idsituacaonotavenda = 3                      
                  and n.idsemanacobranca  < ((select idsemana 
                                             from semana_dias s
                                             where to_char(sysdate,'IW') = s.semana
                                               and to_char(sysdate,'IW') = s.ano )-1)
                  and n.idfilial = :P0_IDFILIAL
                having count(1) > 0
                union
                select 'Verificar '||count(1)||' produto(s) ativo(s) sem preço.' as "Ação Pendente",
                       '<a href="'||'f?p=&APP_ID.:185:'||:APP_SESSION||':IR_REPORT_4710418:::'||'"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""></a>' as "Verificar"   
                from estoquefilial e
                where nvl(e.vlrvenda,0) =0 
                  and e.idfilial = :P0_IDFILIAL
                  and e.ativo = 'S'
                having count(1) > 0
                union
                select 'Verificar '||count(1)||' produto(s) com estoque negativo.' ,
                       '<a href="'||'f?p=&APP_ID.:41:'||:APP_SESSION||':IR_REPORT_136094:::'||'"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""></a>' as "Verificar"   
                from estoquefilial e
                where  ((nvl(e.qtd_pp ,0) - pck_romance.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'PP')) 
                     + (nvl(e.qtd_p  ,0) - pck_romance.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'P'))   
                     + (nvl(e.qtd_m  ,0) - pck_romance.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'M'))   
                     + (nvl(e.qtd_g  ,0) - pck_romance.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'G'))   
                     + (nvl(e.qtd_gg ,0) - pck_romance.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'GG'))  
                     + (nvl(e.qtd_egg,0) - pck_romance.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EGG'))
                     + (nvl(e.qtd_exgg,0)- pck_romance.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'EXGG'))
                     + (nvl(e.qtd_u  ,0) - pck_romance.fnc_estoquereserva(pidestoquefil => e.idestoquefilial,ptamanho => 'U'))) < 0
                  and e.idfilial = :P0_IDFILIAL
                  and e.ativo = 'S'
                having count(1) > 0
                union
                select 'Verificar '||count(1)||' cliente(s) vinculada(s) com região que seu Cliente R não atende mais.',
                       '<a href="'||'f?p=&APP_ID.:7:'||:APP_SESSION||':IR_REPORT_4717178:::P7_TODOS:S'||'"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""></a>' as "Verificar"    
                from vendedoras v
                where v.ativo = 'S' 
                  and v.idregiaovenda not in ( select re.idregiaovenda
                                               from regioesrepresentantes re
                                               where re.idrepresentante = v.idrepresentante )
                  and pck_romance.fnc_filialrepresentante(idrepresentante) = :P0_IDFILIAL
                having count(1) > 0
                union 
                select 'Verificar '||count(1)||' evento(s) atendido e aguardando aprovação.',
                       apex_util.prepare_url('<a href="'||'f?p=OPTIMUS:4:'||:APP_SESSION||':IR_REPORT_4718217::'||'"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""></a>') as "Verificar"    
                from chamados c
                where c.idsituacao = 40
                  and c.usuario = v('APP_USER')
                having count(1) > 0
                union
                select 'Verificar '|| count(1) ||' carga(s) de Clientes R aguardando conclusão.',
                       '<a href="'||'f?p=&APP_ID.:16:'||:APP_SESSION||':IR_REPORT_4710033:::'||'"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""></a>' as "Verificar"   
                from cargasrepresentantes c
                where c.situacao = 2
                  and c.idfilial = :P0_IDFILIAL
                having count(1) > 0
                union
                select 'Verificar '||count(distinct nf.idnotafiscal)||' nota(s) de entrada pendente(s) de recebimento.',
                       '<a href="'||'f?p=&APP_ID.:22:'||:APP_SESSION||':IR_REPORT_1213833:::'||'"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""></a>' as "Verificar"   
                from notasfiscais nf
                   ,  itemnf i
                   , produtos p
                where nf.situacaofilial  = 'A'
                  and nf.idfilialdestino = :P0_IDFILIAL
                  and i.idproduto        = p.idproduto
                  and i.idnotafiscal     = nf.idnotafiscal
                  and p.venda            = 'S'
                having count(1) > 0
                union 
                select 'Verificar '||count(1) ||' nota(s) para Enviar ao SPC.' as "Ação Pendente",
                       '<a href="'||'f?p=&APP_ID.:36:'||:APP_SESSION||':IR_REPORT_4982035:::P36_RELATORIOPRONTO:S'||'"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""></a>' as "Verificar"
                from notasvendas n
                where n.idsituacaonotavenda = 4
                  and n.saldo > 0
                  and  pck_util.fnc_idsemana(trim(to_char(sysdate,'IW/RRRR'))) - pck_util.fnc_idsemana(n.semanacobranca)>=12-- > trunc(nvl(n.dataretorno,n.datanota+42))+60
                  and not exists ( select 1
                                   from pagamentosnotasvendas p
                                   where pck_util.fnc_idsemana(n.semanacobranca)- pck_util.fnc_idsemana(p.semanacobranca)>=12 
                                     and p.idnotavenda = n.idnotavenda )
                  and n.idfilial = :P0_IDFILIAL
                  and n.enviadocobranca != 'S'
                having count(1) > 0
                union
                select 'Verificar '||to_char(sum(m.valorservico
                                                 - nvl(( select sum(p.valorpago)
                                                 from pagamentosmanutencoes p
                                                 where p.idmanutencao = m.idmanutencao ),0)),'999G999G999G999G990D00') 
                       ||' de Manutenções Pendentes de Pagamento.' as "Ação Pendente",
                       '<a href="'||'f?p=&APP_ID.:224:'||:APP_SESSION||':::'||'"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""></a>' as "Verificar"
                from manutencoesrealizadas m
                where valorservico
                     - nvl(( select sum(p.valorpago)
                         from pagamentosmanutencoes p
                         where p.idmanutencao = m.idmanutencao ),0) > 0
                  and nvl(m.cobrar,'S') = 'S'
                  and pck_romance.fnc_filialrepresentante(m.idrepresentante) = :P0_IDFILIAL
                  and idrepresentante is not null
                having sum(m.valorservico
                           - nvl(( select sum(p.valorpago)
                           from pagamentosmanutencoes p
                           where p.idmanutencao = m.idmanutencao ),0)) > 0
                union
                select 'Verificar '||count(1) ||' Nota(s) Duplicada(s)' as "Ação Pendente",
                       '<a href="'||'f?p=&APP_ID.:36:'||:APP_SESSION||':IR_REPORT_5002876:::P36_RELATORIOPRONTO:S'||'"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""></a>' as "Verificar"
                from notasvendas n
                where n.idsituacaonotavenda = 3
                  and (select count(1)
                       from notasvendas nv
                       where nv.idsituacaonotavenda = 3
                         and nv.idvendedora = n.idvendedora
                         and nv.idfilial = :P0_IDFILIAL) >= 2
                  and n.idfilial = :P0_IDFILIAL
                having count(1) > 0
                ```
        }
        layout {
            sequence: 20
            slot: body-1
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }
        componentAdvanced {
            stripHtml: true
        }

        column "Ação Pendente" (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Ação Pendente
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column Verificar (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Verificar
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region rendimento-documentadoras (
        name: Rendimento Documentadoras
        type: staticContent
        layout {
            sequence: 40
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from usuariosgruposatendimento u
                               where u.idgrupoatendimento = 35
                                 and u.usuario            = v('APP_USER') )
                ```
        }
    )

    pageItem P1_AVISO_RENDIMENTO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @rendimento-documentadoras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="BLUE"><h2>Promissórias atualizadas da Romance '||nvl(romance.qtd,0)||' e da Favorita '||nvl((favorita.qtd+catal.qtd),0)||'. Total '||nvl((romance.qtd+favorita.qtd+catal.qtd),0)||' da meta de 10 mil.</h2></font>' d
                from dual
                   , ( select count(1) qtd
                       from classificacoesnotasvendas cn
                       where cn.idcaracteristicanotavenda = 4
                         and to_char(cn.dataclassificado,'MM/RRRR') = to_char(sysdate,'MM/RRRR')
                         and exists ( select 1
                                      from usuarios u
                                         , usuariosgruposatendimento ug
                                      where u.usuario = ug.usuario
                                        and u.idusuario = cn.idusuario
                                        and ug.idgrupoatendimento = 35 ) ) romance
                   , ( select count(1) qtd
                       from favorita.classificacoespedidos cp
                       where cp.idcaracteristicapedido = 71
                         and to_char(cp.dataclassificado,'MM/RRRR') = to_char(sysdate,'MM/RRRR')
                         and exists ( select 1
                                      from usuarios u
                                         , usuariosgruposatendimento ug
                                      where u.usuario = ug.usuario
                                        and u.idusuario = cp.idusuario
                                        and ug.idgrupoatendimento = 35 ) ) favorita
                   , ( select count(1) qtd
                       from boletos b
                       where b.idsituacaopromissoria is not null
                         and b.usuariopromissoriarec is not null
                         and to_char(b.dataatualizacaoprom,'MM/RRRR') = to_char(sysdate,'MM/RRRR')
                         and exists ( select 1
                                      from usuariosgruposatendimento ug
                                      where ug.usuario = b.usuariopromissoriarec 
                                        and ug.idgrupoatendimento = 35 ) ) catal
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P1_IDIOMA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @início
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P1_MENSAGEM_CARSA (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @aviso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="green"><h2> Existem '||count(1)||' notas para serem enviadas a cobrança terceirizada.</h2></font>' a
                from notasvendas nv
                where nv.enviadocobranca = 'S'
                  and nv.saldo           > 0
                  and nvl(nv.enviocobrancaterceirizada,'N') = 'N'
                  and nv.idfilial        = :P0_IDFILIAL
                  and not exists ( select 1
                                   from classificacoesnotasvendas c
                                   where c.idcaracteristicanotavenda = 41
                                     and c.idnotavenda               = nv.idnotavenda )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction notifca-a-troca-de-senha (
        name: Notifca a troca de senha
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from controletrocasenha c
                where c.ativo = 'S'
                And 2 = 1
                and dataalteracao is null
                and idusuario = (select idusuario
                                from usuarios
                                where upper (usuario) = v('APP_USER'))
                ```
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    <html>
                    <head>       
                       <!--IMPORTAÇÕES NECESSÁRIAS-->
                        <link rel="stylesheet" href="http://code.jquery.com/ui/1.9.2/themes/redmond/jquery-ui.css" />
                        <script src="http://code.jquery.com/jquery-1.8.3.js"></script>
                        <script src="http://code.jquery.com/ui/1.9.2/jquery-ui.js"></script>         
                    </head>
                    <body>
                    <div id="dialog" title="Controle de autenticação">
                        <p>Você precisa redefinir a sua senha! Verifique seu email.<br> Seu acesso será bloqueado meia hora após o login.</p>
                    </div>
                    <script>
                    $( "#dialog" ).dialog();
                    </script>
                    </body>
                    </html>
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction popup-optimus-cara-nova (
        name: Popup Optimus Cara Nova
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: false
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function(){
                    var ver='v5';
                    if(localStorage.getItem('optimus_popup')===ver)return;
                    var s='<style>'+
                    '.opt-dlg .ui-dialog-titlebar{display:none}'+
                    '.opt-dlg{position:fixed!important;top:50%!important;left:50%!important;transform:translate(-50%,-50%)!important;margin:0!important;border:none!important;border-radius:12px!important;overflow:hidden;padding:0!important;box-shadow:0 24px 64px rgba(0,0,0,.9)!important}'+
                    '.opt-dlg .ui-dialog-content{padding:0!important;overflow:hidden!important}'+
                    '.opt-dlg .ui-dialog-buttonpane{display:none!important}'+
                    '.opt-dlg-x{position:absolute;top:10px;right:10px;background:rgba(0,0,0,.5);color:#fff;border:none;border-radius:50%;width:34px;height:34px;font-size:20px;cursor:pointer;line-height:34px;text-align:center;z-index:10}'+
                    '.opt-dlg-x:hover{background:rgba(0,0,0,.85)}'+
                    '.ui-widget-overlay{position:fixed!important;top:0!important;left:0!important;width:100%!important;height:100%!important}'+
                    '</style>';
                    $(document.body).append(s);
                    var src='#APP_FILES#Card%20banner%20%205.jpg.jpeg';
                    var img=new Image();
                    img.onload=function(){
                    var h='<img src="'+src+'" style="width:100%;display:block" alt="Optimus">';
                    var d=$('<div>').html(h).appendTo(document.body);
                    d.dialog({
                      modal:true,
                      width:680,
                      dialogClass:'opt-dlg',
                      title:'',
                      resizable:false,
                      close:function(){$(this).dialog('destroy').remove();}
                    });
                    $('<button class="opt-dlg-x">&#10005;</button>')
                      .on('click',function(){localStorage.setItem('optimus_popup',ver);d.dialog('close');})
                      .appendTo(d.closest('.ui-dialog'));
                    };
                    img.src=src;
                    })();
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    process busca-id-filial (
        name: Busca id filial
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P0_IDFILIAL is null then
                 :P0_IDFILIAL := pck_romance.fnc_filialusuario(v('APP_USER'));
                end if;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 36841566399313413
        }
    )

    process troca-idioma (
        name: troca idioma
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                APEX_UTIL.SET_SESSION_LANG(nvl(:P1_IDIOMA,'pt-br'));
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 96739582789516507
        }
    )

)

