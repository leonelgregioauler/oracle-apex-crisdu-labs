    region débitos-pagos-outros-distribuidores (
        name: Débitos Pagos Outros Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomevendedora(n.idvendedora) consultora
                     , p.datapagamento
                     , p.valorpago
                     , n.numeronota
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) ClienteR
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||n.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' url
                from pagamentosnotasvendas p
                   , notasvendas n 
                where p.semanacobranca =  trim(:P257_SEMANA)
                  and p.idnotavenda = n.idnotavenda
                  and n.idrepresentanteatende = :P257_IDREPRESENTANTE
                  and n.semanacobranca != trim(:P257_SEMANA) 
                order by 1    
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
