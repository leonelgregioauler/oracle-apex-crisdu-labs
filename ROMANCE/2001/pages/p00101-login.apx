page 101 (
    name: LOGIN
    alias: LOGIN
    title: Login
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
        cssClasses: login
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .image_login {
                background-image: url("#APP_FILES#img_login.jpg");
            }
            
            /* === Responsividade - Tablet === */
            @media screen and (max-width: 992px) {
                #content_image_login {
                    padding: 30px 20px;
                }
                #login_asset_optimus_branco {
                    max-width: 160px;
                }
                #text_image_login h4 {
                    font-size: 1.1rem;
                }
                #text_image_login p {
                    font-size: 0.85rem;
                }
                #logos_grupo {
                    max-width: 160px;
                }
            }
            
            /* === Responsividade - Mobile === */
            @media screen and (max-width: 768px) {
                /* Oculta a coluna inteira do painel de imagem */
                body.login .col-start {
                    display: none !important;
                }
                /* Coluna do formulario ocupa 100% da tela */
                body.login .col-end {
                    flex: 0 0 100% !important;
                    max-width: 100% !important;
                    width: 100% !important;
                    padding: 0 16px !important;
                }
                /* Regiao de login centralizada */
                .login_region {
                    width: 100% !important;
                    max-width: 420px !important;
                    margin: 20px auto !important;
                    box-sizing: border-box !important;
                }
                /* Inputs ocupam largura total */
                .input100P {
                    width: 100% !important;
                    box-sizing: border-box !important;
                }
                /* Botoes ocupam largura total */
                .btn_login,
                .btn_primeiro_acesso {
                    width: 100% !important;
                    display: block !important;
                }
            }
            
            ```
    }
    advanced {
        reloadOnSubmit: always
    }

    region background-image (
        name: Background Image
        type: staticContent
        source {
            htmlCode:
                ```html
                <div id="content_image_login">
                    <img src="#APP_FILES#logo_optimus_branco.png" id="login_asset_optimus_branco">
                    <div id="text_image_login">
                        <h4>Sua gestão, mais inteligente.</h4>
                        <p>Centralize atividades, acompanhe processos e acesse todas as ferramentas<br/>em um único ambiente.</p>
                        <img id="logos_grupo" alt="logo crisdu" src="#APP_FILES#logos_grupo.png"/>
                    </div>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: image_login
        }
    )

    region seja-bem-vindo-ao-optimus (
        name: Seja Bem-vindo ao Optimus!
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
            startNewRow: false
            columnAttributes: align="center"
        }
        appearance {
            template: @/login
            templateOptions: #DEFAULT#
            cssClasses: login_region
        }
        headerAndFooter {
            footerText: <a href="#WORKSPACE_IMAGES#TeamViewer_Setup.exe" id="link_acesso_remoto"> Acesso Remoto (Team Viewer)</a>
        }
    )

    pageItem P101_LABELPRIMEIROACESSO (
        type: displayOnly
        label {
            label: Labelprimeiroacesso
            alignment: left
        }
        layout {
            sequence: 60
            region: @seja-bem-vindo-ao-optimus
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            cssClasses: label_primeiro_acesso
        }
        source {
            type: staticValue
            staticValue: Meu primeiro acesso
        }
    )

    pageItem P101_PASSWORD (
        type: password
        label {
            label: Senha
            alignment: left
        }
        layout {
            sequence: 30
            region: @seja-bem-vindo-ao-optimus
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: [
                input100P
                input_password
            ]
            width: 30
            valuePlaceholder: Senha
        }
        validation {
            maxLength: 20
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P101_USERNAME (
        type: textField
        label {
            label: Usuário
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @seja-bem-vindo-ao-optimus
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: [
                input100P
                input_username
            ]
            width: 30
            valuePlaceholder: Usuário
        }
        validation {
            maxLength: 20
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button p101-login (
        buttonName: P101_LOGIN
        label: Entrar
        layout {
            sequence: 40
            region: @seja-bem-vindo-ao-optimus
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--pillStart
                t-Button--stretch
            ]
            cssClasses: [
                btn_login
                btn_black
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: P101_LOGIN
            requestSourceType: staticValue
            requestSource: LOGIN
        }
    )

    button p101-primeiroacesso (
        buttonName: P101_PRIMEIROACESSO
        label: Fazer Meu Primeiro Acesso
        layout {
            sequence: 70
            region: @seja-bem-vindo-ao-optimus
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--pillStart
                t-Button--stretch
            ]
            cssClasses: [
                btn_primeiro_acesso
                btn_white
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 160
                items: {
                    P160_USUARIO: &P101_USERNAME.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button p101-redefinirsenha (
        buttonName: P101_REDEFINIRSENHA
        label: Alterar Senha
        layout {
            sequence: 50
            region: @seja-bem-vindo-ao-optimus
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--pillEnd
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 203
                items: {
                    P203_USUARIO: &P101_USERNAME.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: P101_REDEFINIR
            requestSourceType: staticValue
            requestSource: LOGIN
        }
        serverSideCondition {
            type: never
        }
    )

    validation controle-de-autenticação (
        name: Controle de autenticação
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                   vRetorno boolean;
                begin
                   vRetorno := PCK_AUDITORIAROMANCE.fnc_validalogin(pusuario => trim(:P101_USERNAME));
                
                
                   if not vRetorno then
                      return 'Usuário inativo';
                   end if;
                end;				
                ```
        }
        error {
            associatedItem: @P101_USERNAME
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from parametros
                where idfilial = 340
                and nome = 'CONTROLE_AUTENTICACAO'
                and valor = 'S';
                ```
        }
    )

    validation p101-username (
        name: P101_USERNAME
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariossistemas u
                where u.usuario = trim(upper(v('P101_USERNAME')))
                and u.idsistema = 2001
                and u.ativo = 'S'
                ```
        }
        error {
            errorMessage: Você não tem permissão de acesso a este sistema!
            displayLocation: inlineInNotification
        }
    )

    process clear-page-s-cache (
        name: Clear Page(s) Cache
        type: clearSessionState
        execution {
            sequence: 30
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 15463357131080271
        }
    )

    process get-username-cookie (
        name: Get Username Cookie
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    v varchar2(255) := null;
                    c owa_cookie.cookie;
                begin
                   c := owa_cookie.get('LOGIN_USERNAME_COOKIE');
                   :P101_USERNAME := c.vals(1);
                exception when others then null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15463558630080271
        }
    )

    process login (
        name: Login
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                wwv_flow_custom_auth_std.login(
                    P_UNAME       => trim(:P101_USERNAME),
                    P_PASSWORD    => :P101_PASSWORD,
                    P_SESSION_ID  => v('APP_SESSION'),
                    P_FLOW_PAGE   => :APP_ID||':1'
                    );
                ```
        }
        execution {
            sequence: 20
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 15463179750080271
        }
    )

    process set-username-cookie (
        name: Set Username Cookie
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                owa_util.mime_header('text/html', FALSE);
                owa_cookie.send(
                    name=>'LOGIN_USERNAME_COOKIE',
                    value=>trim(lower(:P101_USERNAME)));
                exception when others then null;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 15462984905080269
        }
    )

)

