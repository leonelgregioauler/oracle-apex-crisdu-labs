    pageItem P842_CHANGES_JSON (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @saída-de-brindes-do-estoque
            slot: regionBody
        }
    )

    pageItem P842_IDCONQUISTOULEVOU (
        type: selectList
        label {
            label: Campanha
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.NOMECAMPANHA D,
                       C.IDCONQUISTOULEVOU R
                  FROM ROMAN.CAMPANHASCONQUISTOULEVOU C
                 WHERE C.IDPAIS = (SELECT F.IDIDIOMA /*IDIDIOMA em VW_FILIAIS = IDPAIS, legado*/
                                      FROM ROMAN.VW_FILIAIS F
                                     WHERE F.IDFILIAL = :P842_IDFILIAL)
                 ORDER BY C.IDCONQUISTOULEVOU DESC
                ```
        }
        cascadingLov {
            parentItems: P842_IDFILIAL
            itemsToSubmit: P842_IDFILIAL
        }
        layout {
            sequence: 15
            region: @saída-de-brindes-do-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P842_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.nomefilial r  /*Filiais user Gerente(Gerente pode ver toda) */
                     , t.idfilial f
                 from roman.vw_franquia_loja_conquistou_levou t
                where t.tipo = 'FR'
                  and exists (select 1
                                from catal.usuarios u
                                   , catal.gerentes g
                               where u.idpessoa = g.idpessoa
                                 and u.ativo = 'S'
                                 and g.ativo = 'S'
                                 and u.usuario = v('APP_USER'))
                union
                select t.nomefilial r /*Filial Usuario (Filtra por filial do seu gerente)*/
                     , t.idfilial f
                 from roman.vw_franquia_loja_conquistou_levou t
                    , catal.gerentes g
                    , catal.usuarios u
                where t.idfilial = g.idfilial
                  and g.idgerente = u.idgerente
                  and t.tipo = 'FR'
                  and u.usuario = 'DIEGOPIECHO'
                union
                select t.nomefilial r /*para o TI usar*/
                     , t.idfilial f
                 from roman.vw_franquia_loja_conquistou_levou t
                where t.tipo = 'FR'
                  and exists ( select 1
                                 from roman.usuariosgruposatendimento ug
                                 where ug.usuario = v('APP_USER')
                                   and ug.idgrupoatendimento in (0,1,2) )-- Grupo TI, Contorladoria, Suporte Estoque Romance
                --  and (favorita.pck_util_fav.fnc_verificagrupoatendimento(0, favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) ) = 'S'
                order by 1
                
                ```
        }
        layout {
            sequence: 10
            region: @saída-de-brindes-do-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P842_IDGUIA (
        type: selectList
        label {
            label: Guia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 'Guia - ' || G.IDGUIAENTREGABRINDE || ' - Emissão ' ||
                              TO_CHAR(G.DATAEMISSAO,'DD/MM/YYYY') AS D,
                       G.IDGUIAENTREGABRINDE AS R
                  FROM ROMAN.GUIASENTREGASBRINDES G
                  JOIN ROMAN.CAMPANHASCONQUISTOULEVOU C ON C.IDCONQUISTOULEVOU = G.IDCONQUISTOULEVOU
                 WHERE G.IDFILIAL         = :P842_IDFILIAL
                   AND G.IDCONQUISTOULEVOU = :P842_IDCONQUISTOULEVOU
                 --  AND (   (:P842_TIPOMOV = 'E' AND G.DATAENVIO IS NULL     AND G.STATUSMOV_ENTRADA IN ('N','P'))
                    --    OR (:P842_TIPOMOV = 'S' AND G.DATAENVIO IS NOT NULL AND G.STATUSMOV_SAIDA   IN ('N','P')))
                 ORDER BY G.DATAEMISSAO DESC
                ```
        }
        cascadingLov {
            parentItems: [
                P842_IDFILIAL
                P842_IDCONQUISTOULEVOU
            ]
            itemsToSubmit: [
                P842_IDFILIAL
                P842_IDCONQUISTOULEVOU
            ]
        }
        layout {
            sequence: 30
            region: @saída-de-brindes-do-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

