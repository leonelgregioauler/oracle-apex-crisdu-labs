    process atualizar-status-da-guia (
        name: Atualizar Status da Guia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  V_TOTAL_GUIA  NUMBER;
                  V_TOTAL_MOV   NUMBER;
                  V_NOVO_STATUS VARCHAR2(1);
                BEGIN
                  IF :P842_IDGUIA IS NULL THEN RETURN; END IF;
                
                  SELECT SUM(QTDGUIA),
                         SUM(CASE WHEN :P842_TIPOMOV = 'E' THEN QTDENTRADA ELSE QTDSAIDA END)
                    INTO V_TOTAL_GUIA, V_TOTAL_MOV
                    FROM ROMAN.GUIABRINDESCONQLEV
                   WHERE IDGUIAENTREGABRINDE = :P842_IDGUIA
                     AND IDPRODDETAL_ROM IS NOT NULL;
                
                  IF V_TOTAL_MOV IS NULL OR V_TOTAL_MOV = 0 THEN
                    V_NOVO_STATUS := 'N';
                  ELSIF V_TOTAL_MOV >= V_TOTAL_GUIA THEN
                    V_NOVO_STATUS := 'C';
                  ELSE
                    V_NOVO_STATUS := 'P';
                  END IF;
                
                  IF :P842_TIPOMOV = 'E' THEN
                    UPDATE ROMAN.GUIASENTREGASBRINDES
                       SET STATUSMOV_ENTRADA = V_NOVO_STATUS
                     WHERE IDGUIAENTREGABRINDE = :P842_IDGUIA;
                  ELSE
                    UPDATE ROMAN.GUIASENTREGASBRINDES
                       SET STATUSMOV_SAIDA = V_NOVO_STATUS
                     WHERE IDGUIAENTREGABRINDE = :P842_IDGUIA;
                  END IF;
                END;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 84200000111
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR_GRADE
        }
    )

