    dynamicAction confirmar-movimentação-coletar-dados-do-ig (
        name: Confirmar Movimentação - Coletar Dados do IG
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @confirmar-grade
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // PRÉ-REQUISITO: Static ID da região IG = "IG_BRINDES_842" no APEX Builder
                    var igRegion = apex.region("IG_BRINDES_842");
                    if (!igRegion) {
                        apex.message.showErrors([{type:"error",location:"page",
                            message:"Região do grid não encontrada. Defina o Static ID 'IG_BRINDES_842' na região do Interactive Grid no APEX Builder."}]);
                        return;
                    }
                    var model  = igRegion.widget().interactiveGrid("getViews","grid").model;
                    var linhas = [];
                    model.forEach(function(record) {
                        var pp   = parseFloat(model.getValue(record,"QTD_PP")   || 0);
                        var p    = parseFloat(model.getValue(record,"QTD_P")    || 0);
                        var m    = parseFloat(model.getValue(record,"QTD_M")    || 0);
                        var g    = parseFloat(model.getValue(record,"QTD_G")    || 0);
                        var gg   = parseFloat(model.getValue(record,"QTD_GG")   || 0);
                        var egg  = parseFloat(model.getValue(record,"QTD_EGG")  || 0);
                        var exgg = parseFloat(model.getValue(record,"QTD_EXGG") || 0);
                        var u    = parseFloat(model.getValue(record,"QTD_U")    || 0);
                        if (pp + p + m + g + gg + egg + exgg + u === 0) { return; }
                        linhas.push({
                            idBrinde  : model.getValue(record,"IDBRINDECLUBE"),
                            idProd    : model.getValue(record,"IDPRODDETAL_ROM"),
                            idGuia    : model.getValue(record,"IDGUIAENTREGABRINDE"),
                            nomeBrinde: model.getValue(record,"NOMEBRINDE"),
                            qtdGuia   : parseFloat(model.getValue(record,"QTDGUIA") || 0),
                            qtd_pp:pp, qtd_p:p,    qtd_m:m,    qtd_g:g,
                            qtd_gg:gg, qtd_egg:egg, qtd_exgg:exgg, qtd_u:u
                        });
                    });
                    if (linhas.length === 0) {
                        apex.message.showErrors([{type:"error",location:"page",
                            message:"Informe ao menos uma quantidade maior que zero."}]);
                        return;
                    }
                    apex.item("P842_CHANGES_JSON").setValue(JSON.stringify(linhas));
                    apex.page.submit({request:"CONFIRMAR_GRADE"});
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

