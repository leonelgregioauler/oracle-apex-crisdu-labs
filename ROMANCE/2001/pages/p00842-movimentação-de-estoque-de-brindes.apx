page 842 (
    name: Movimentação de Estoque de Brindes
    alias: MOVIMENTAÇÃO-DE-ESTOQUE-DE-BRINDES
    title: Movimentação de Estoque de Brindes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region brindes-da-guia (
        name: Brindes da Guia
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Fonte: APEX_COLLECTIONS populada por pck_conquistoulevou.PRC_POPULA_GRADE
                -- Mapeamento: N001-N005 = QTD_PP..GG (NUMBER editável)
                --             C006-C008 = QTD_EGG,EXGG,U (VARCHAR2 editável)
                --             C009-C011 = QTDGUIA,QTDENTRADA,QTDSAIDA (display)
                SELECT ac.seq_id,
                       TO_NUMBER(ac.c001)                              AS idbrindeclube,
                       TO_NUMBER(ac.c002)                              AS idguiaentregabrinde,
                       TO_NUMBER(ac.c003)                              AS idproddetal_rom,
                       ac.c014                                        AS codigosisdist,
                       ac.c004                                        AS nomebrinde,
                       ac.c005                                        AS produto_romance,
                       NVL(TO_NUMBER(ac.c013), 0)                     AS saldo_disponivel,
                       NVL(TO_NUMBER(ac.c009), 0)                     AS qtdguia,
                       NVL(TO_NUMBER(ac.c010), 0)                     AS qtdentrada,
                       NVL(TO_NUMBER(ac.c011), 0)                     AS qtdsaida,
                       NVL(TO_NUMBER(ac.c009),0)-NVL(TO_NUMBER(ac.c010),0) AS qtdpendente_entrada,
                       NVL(TO_NUMBER(ac.c009),0)-NVL(TO_NUMBER(ac.c011),0) AS qtdpendente_saida,
                       ac.n001                                        AS qtd_pp,
                       ac.n002                                        AS qtd_p,
                       ac.n003                                        AS qtd_m,
                       ac.n004                                        AS qtd_g,
                       ac.n005                                        AS qtd_gg,
                       ac.c006                                        AS qtd_egg,
                       ac.c007                                        AS qtd_exgg,
                       ac.c008                                        AS qtd_u
                FROM   apex_collections ac
                WHERE  ac.collection_name = 'MOVBRINDES_GRADE'
                --ORDER  BY 5
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: IG_BRINDES_842
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P842_IDGUIA
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: actionsMenu
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 84200000060
        }

