    button anexar-arquivo (
        buttonName: ANEXAR_ARQUIVO
        label: Anexar Arquivo
        layout {
            sequence: 20
            region: @pagamento-de-balanço
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 507
                items: {
                    P507_IDANEXOPGTOBALANCO:
                    P507_IDPAGAMENTOBALANCO: &P501_IDPAGAMENTONEGOCIACAO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P501_IDPAGAMENTONEGOCIACAO
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 60
            region: @pagamento-de-balanço
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P501_IDPAGAMENTONEGOCIACAO is null and :P501_IDPARCELANEGOCIACAOBALANCO is null
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 40
            region: @pagamento-de-balanço
            slot: help
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P501_IDPAGAMENTONEGOCIACAO is not null
                  and :P501_MOSTRA_BOTAO_RECEBER = 1
                  and exists ( select 1
                               from fechamentossemanais f
                               where f.idfechamento = :P501_IDFECHAMENTO
                                 and f.concluido    = 'N' )
                ```
        }
    )

    button receber (
        buttonName: RECEBER
        label: Receber
        layout {
            sequence: 70
            region: @pagamento-de-balanço
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P501_IDPARCELANEGOCIACAOBALANCO is not null and :P501_IDPAGAMENTONEGOCIACAO is null
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 50
            region: @pagamento-de-balanço
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P501_IDPAGAMENTONEGOCIACAO IS NOT NULL
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @pagamento-de-balanço
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 498
                items: {
                    P498_IDNEGOCIACAOBALANCO: &P501_IDNEGOCIACAOBALANCO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-cheque (
        name: Tipo Cheque
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P501_IDENTIFICACAO
        }
        clientSideCondition {
            type: item=value
            item: P501_IDENTIFICACAO
            value: CH
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P501_BOMPARA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P501_BOMPARA
            }
            execution {
                sequence: 10
            }
        )

    )

    process carrega-saldo (
        name: Carrega Saldo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  -- Este processo foi criado pois o valor do saldo da parcela não vinha com os centavos pelo campo do link entre a pagina 498 e 501.
                  --
                  vsaldo        number;
                  vvalorparcela number;
                  vsituacao     varchar2(10);
                  --
                begin
                  --
                  if :P501_IDPARCELANEGOCIACAOBALANCO is not null then
                    --
                    PCK_ACERTOS_RMC.prc_saldoparcelanegociacaobalanco( pidparcelanegociacaobalanco => :P501_IDPARCELANEGOCIACAOBALANCO
                                                                     , pvalorparcela => vvalorparcela
                                                                     , pvalorsaldo => vsaldo
                                                                     , psituacao => vsituacao);
                    --
                    :P501_VALORPAGO := to_char(vsaldo,'999G999G999G990D00');
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1502506132348939801
        }
    )

    process consulta-em-pagamentos-de-negociações-de-balanço (
        name: Consulta em Pagamentos de Negociações de Balanço
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdata         date;
                  vvalor        number;
                  vbompara      date;
                  vsaldo        number;
                  vvalorparcela number;
                  vsituacao     varchar2(10);
                begin
                  --
                  PCK_ACERTOS_RMC.PRC_PAGAMENTOSNEGBALANCO( PIDPAGAMENTONEGOCIACAO => :P501_IDPAGAMENTONEGOCIACAO,
                                                            PIDNEGOCIACAOBALANCO => :P501_IDNEGOCIACAOBALANCO,
                                                            PDATA => vdata,
                                                            PVALORPAGO => vvalor,
                                                            POBSERVACAO => :P501_OBSERVACAO,
                                                            PIDFECHAMENTO => :P501_IDFECHAMENTO,
                                                            PTIPO => :P501_TIPO,
                                                            PCONFERIDO => :P501_CONFERIDO,
                                                            PIDENTIFICACAO => :P501_IDENTIFICACAO,
                                                            PBOMPARA => vbompara,
                                                            PMD5 => :P501_MD5,
                                                            POPERACAO_DML => 'S');
                  --
                  :P501_DATA := to_char(vdata,'DD/MM/RRRR HH24:MI:SS');
                  --
                  :P501_BOMPARA := to_char(vbompara,'DD/MM/RRRR');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1564564802432368001
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P501_IDPAGAMENTONEGOCIACAO
        }
    )

    process processo-dml-em-pagamentos-de-neg-de-balanços (
        name: Processo DML em Pagamentos de Neg de Balanços
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vvalor        number;
                  vdata         date;
                  vbompara      date;
                  vvalorparcela number;
                  vsituacao     varchar2(3);
                  vsaldo        number;
                  vvtotal_parcelas  number;
                  vvalor_negociacao number;
                  vvalorpagosemparcela number := 0;
                  vvalorpago number := to_number(replace(:P501_valorpago,'.',''));
                  --
                begin
                  --
                  
                  --
                  if v('REQUEST') in ( 'CRIAR','RECEBER') then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  PCK_ACERTOS_RMC.prc_saldoparcelanegociacaobalanco( pidparcelanegociacaobalanco => :P501_IDPARCELANEGOCIACAOBALANCO
                                                                  , pvalorparcela => vvalorparcela
                                                                  , pvalorsaldo => vsaldo
                                                                  , psituacao => vsituacao);
                  --
                  -- Colocado aqui esta validação pois nao conseguimos validar o total das parcelas em tempo de execução da tela 498
                  select (nb.valor + nb.valorjuros) valor_negociacao
                       , nvl(sum(pnb.valor),0) valor_total_parcelas
                   into vvalor_negociacao
                      , vvtotal_parcelas
                   from negociacoesbalanco nb
                      , parcelanegociacaobalanco pnb
                  where pnb.idnegociacaobalanco(+) = nb.idnegociacaobalanco
                    and nb.idnegociacaobalanco = :P501_IDNEGOCIACAOBALANCO
                group by (nb.valor + nb.valorjuros);
                  --
                  begin
                  select nvl(sum(pnb.valorpago),0) valorpago
                    into vvalorpagosemparcela
                    from pagamentosnegociacoesbalanco pnb
                   where pnb.idnegociacaobalanco = :P501_IDNEGOCIACAOBALANCO
                     and pnb.valorpago            > 0
                     and pnb.conferido            = 'S'
                     and pnb.idparcelanegociacaobalanco is null;
                    --
                    exception when no_data_found then
                    vvalorpagosemparcela := 0;
                  end;
                  --
                  vvalorpagosemparcela := (vvalor_negociacao - vvalorpagosemparcela);
                  --
                  if (vvalorpagosemparcela <> vvtotal_parcelas) and voperacao_dml <> 'D' and :P501_IDPARCELANEGOCIACAOBALANCOis is not null then
                    --
                    raise_application_error(-20000,'Atenção! A soma das parcelas é diferente do valor da negociação. Ajuste os valores das parcelas antes de efetuar novos pagamentos.'||chr(10)||'Info.: Negociação R$ '||vvalorpagosemparcela||' <> Parcelas R$ '||vvtotal_parcelas);
                    --
                  end if;
                  --
                  if vsituacao = 'QUI' and voperacao_dml in ('I') then
                    --
                    raise_application_error(-20001,'Parcela quitada não pode receber novos pagamentos.');
                    --
                  end if;
                  --
                  if :P501_IDENTIFICACAO = 'CH' and :P501_BOMPARA is null and voperacao_dml in ('I') then
                    raise_application_error(-20002,'Para campo Identificação CHEQUE, informar a data BOM PARA');
                  end if;
                  --
                  if vvalorpago > vsaldo and voperacao_dml in ('I') then
                    --
                    raise_application_error(-20003,'Valor a pagar não pode ser maior que o saldo da parcela.Info.: Pagar R$ '||:P501_valorpago||' / Saldo R$ '||vsaldo);
                    --
                    else
                      --
                      vdata := to_date(:P501_DATA,'DD/MM/RRRR HH24:MI:SS');
                      --
                      vbompara := to_date(:P501_BOMPARA,'DD/MM/RRRR');
                      --
                      vvalor := to_number(:P501_VALORPAGO,'999G999G999G990D00');   
                      --
                      PCK_ACERTOS_RMC.PRC_PAGAMENTOSNEGBALANCO( PIDPAGAMENTONEGOCIACAO => :P501_IDPAGAMENTONEGOCIACAO,
                                                                PIDNEGOCIACAOBALANCO => :P501_IDNEGOCIACAOBALANCO,
                                                                PDATA => vdata,
                                                                PVALORPAGO => vvalor,
                                                                POBSERVACAO => :P501_OBSERVACAO,
                                                                PIDFECHAMENTO => :P501_IDFECHAMENTO,
                                                                PTIPO => :P501_TIPO,
                                                                PCONFERIDO => :P501_CONFERIDO,
                                                                PIDENTIFICACAO => :P501_IDENTIFICACAO,
                                                                PBOMPARA => vbompara ,
                                                                PMD5 => :P501_MD5,
                                                                POPERACAO_DML => voperacao_dml,
                                                                pidparcelanegociacaobalanco => :P501_IDPARCELANEGOCIACAOBALANCO);
                    --
                    end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1564553015616143150
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('DELETAR','SALVAR','CRIAR','RECEBER')
                ```
        }
    )

    branch (
        name: Go To Page 498
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 498
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: CRIAR
        }
    )

    branch (
        name: Go To Page 501
        execution {
            sequence: 40
        }
        behavior {
            target: {
                page: 501
                items: {
                    P501_IDPAGAMENTONEGOCIACAO: &P501_IDPAGAMENTONEGOCIACAO.
                    P501_IDNEGOCIACAOBALANCO: &P501_IDNEGOCIACAOBALANCO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: SALVAR
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 501
                items: {
                    P501_IDPAGAMENTONEGOCIACAO:
                    P501_IDNEGOCIACAOBALANCO: &P501_IDNEGOCIACAOBALANCO.
                    P501_VALORPAGO:
                    P501_DATA:
                    P501_TIPO:
                    P501_CONFERIDO:
                    P501_VALORPAGO:
                    P501_OBSERVACAO:
                    P501_IDFECHAMENTO:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

)

