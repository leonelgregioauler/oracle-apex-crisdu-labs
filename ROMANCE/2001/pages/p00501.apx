            virtualKeyboard: text
        }
        layout {
            sequence: 80
            region: @pagamento-de-balanço
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
        }
        advanced {
            customAttributes: "onkeyup=\"formataMoeda(this);\" "
        }
        security {
            encryptSessionState: false
        }
