            sequence: 120
            region: @pagamento-de-balanço
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P501_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @pagamento-de-balanço
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P501_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 90
            region: @pagamento-de-balanço
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
            height: 5
        }
        security {
            encryptSessionState: false
        }
