page 501 (
    name: Pagamentos de Balanço
    title: Pagamentos de Balanço
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 60%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formataMoeda(valor){
              v = valor.value;
              v=v.replace(/\D/g,"") // permite digitar apenas numero
              v=v.replace(/(\d{1})(\d{14})$/,"$1.$2") // coloca ponto antes dos ultimos digitos
              v=v.replace(/(\d{1})(\d{11})$/,"$1.$2") // coloca ponto antes dos ultimos 11 digitos
              v=v.replace(/(\d{1})(\d{8})$/,"$1.$2") // coloca ponto antes dos ultimos 8 digitos
              v=v.replace(/(\d{1})(\d{5})$/,"$1.$2") // coloca ponto antes dos ultimos 5 digitos
              v=v.replace(/(\d{1})(\d{1,2})$/,"$1,$2") // coloca virgula antes dos ultimos 2 digitos
              valor.value = v;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region pagamento-de-balanço (
        name: Pagamento de Balanço
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P501_BOMPARA (
        type: datePickerJquery
        label {
            label: Bom Para
            alignment: left
        }
        layout {
            sequence: 70
            region: @pagamento-de-balanço
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P501_CONFERIDO (
        type: plugin/simpleCheckbox
        label {
            label: Conferido?
            alignment: left
        }
        settings {
            checkedValue: S
        }
        layout {
            sequence: 60
            region: @pagamento-de-balanço
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P501_DATA (
        type: datePickerJquery
        label {
            label: Data
            alignment: left
        }
        layout {
            sequence: 30
            region: @pagamento-de-balanço
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR HH24:MI:SS
            width: 18
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P501_IDPAGAMENTONEGOCIACAO
        }
        readOnly {
            type: itemIsNotNull
            item: P501_IDPAGAMENTONEGOCIACAO
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P501_IDENTIFICACAO (
        type: radioGroup
        label {
            label: Identificação
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Dinheiro;DR,Cheque;CH,Transferencia;TF
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @pagamento-de-balanço
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: DR
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P501_IDFECHAMENTO (
        type: selectList
        label {
            label: Fechamento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana
                     , idfechamento
                from fechamentossemanais 
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 110
            region: @pagamento-de-balanço
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P501_IDNEGOCIACAOBALANCO (
        type: hidden
