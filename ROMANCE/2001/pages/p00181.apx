page 181 (
    name: Pagamentos Recebidos
    title: Pagamentos Recebidos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region pagamentos-recebidos (
        name: Pagamentos Recebidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nome
                     , p.data
                     , p.valorpago
                     , p.observacao
                     , p.identificacao
                     , to_char(p.data,'IW/RRRR') SEMANA
                from pagamentosemprestimos p
                   , emprestimos e
                where p.idemprestimo = e.idemprestimo
                  and e.idfilial     = :P0_IDFILIAL  
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 85504025740399885
        }

        column DATA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DATA
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDENTIFICACAO (
            type: plainText
            heading {
                heading: Identificação
                alignment: center
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: IDENTIFICACAO
                endUserAlias: G
            }
            enableUsersTo {
                pivot: false
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: NOME
                endUserAlias: H
            }
            enableUsersTo {
                pivot: false
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observaçào
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: OBSERVACAO
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 9
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: SEMANA
                endUserAlias: I
            }
            enableUsersTo {
                pivot: false
            }
        )

        column VALORPAGO (
            type: plainText
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990d00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: VALORPAGO
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 855055 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATA (
                sequence: 2
            )

            displayColumn IDENTIFICACAO (
                sequence: 5
            )

            displayColumn NOME (
                sequence: 1
            )

            displayColumn OBSERVACAO (
                sequence: 4
            )

            displayColumn SEMANA (
                sequence: 6
            )

            displayColumn VALORPAGO (
                sequence: 3
            )

            sort (
                column: DATA
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            aggregate (
                column: VALORPAGO
            )

        )

    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @pagamentos-recebidos
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 173
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

