page 294 (
    name: Acompanhamento de Desempenho
    title: Acompanhamento de Desempenho
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region desempenho (
        name: Desempenho
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select substr(f.semana,4,4) 
                     , f.totalcobranca
                     , f.qtdnotasnovas
                     , pck_romance.fnc_nomerepresentante(f.idrepresentante) representante
                from fechamentorepresentantes f
                where f.semana like '%'||:P294_SEMANA||'%'
                  and f.idrepresentante = :P294_IDREPRESENTANTE
                order by 1 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma informação localizada. Verifique a semana informada!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 308901801197466317
        }

        column QTDNOTASNOVAS (
            type: plainText
            heading {
                heading: Qtd Notas Novas
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column REPRESENTANTE (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 13
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column "SUBSTR(F.SEMANA,4,4)" (
            type: plainText
            heading {
                heading: Ano
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column TOTALCOBRANCA (
            type: plainText
            heading {
                heading: Total da Cobrança
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 3089048 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn QTDNOTASNOVAS (
                sequence: 3
            )

            displayColumn REPRESENTANTE (
                sequence: 4
            )

            displayColumn "SUBSTR(F.SEMANA,4,4)" (
                sequence: 1
            )

            displayColumn TOTALCOBRANCA (
                sequence: 2
            )

            sort (
                column: SUBSTR(F.SEMANA,4,4)
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            aggregate (
                function: average
                column: TOTALCOBRANCA
            )

            aggregate (
                function: average
                column: QTDNOTASNOVAS
            )

            controlBreak (
                column: REPRESENTANTE
                layout {
                    sequence: 1
                }
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P294_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select pck_romance.fnc_nomerepresentante(r.idrepresentante) display_value
                     , r.idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes
                                      where idfilial = :P0_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: - - Ver Todos - -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P294_SEMANA (
        type: textField
        label {
            label: Semana
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: FILTRO
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 294
                items: {
                    P294_IDREPRESENTANTE: &P294_IDREPRESENTANTE.
                    P294_SEMANA: &P294_SEMANA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

