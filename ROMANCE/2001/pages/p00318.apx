    pageItem P318_IDDEVOLUCAO (
        type: textField
        label {
            label: Iddevolucao_desenvolvimento
            alignment: left
        }
        layout {
            sequence: 20
            region: @posto-avançado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from roman.usuariosgruposatendimento ug
                 where ug.usuario = v('APP_USER')
                   and ug.idgrupoatendimento = 0
                ```
        }
    )

    pageItem P318_IDPOSTOAVANCADO (
        type: selectList
        label {
            label: PA
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nome) display_value
                     , idpostoavancado return_value
                from postoavancado 
                where idfilial = :P0_IDFILIAL
                  and ativo = 'S'
                  and ( ( :P0_IDPOSTOAVANCADO is not null and idpostoavancado = :P0_IDPOSTOAVANCADO )
                       or (:P0_IDPOSTOAVANCADO is null ) )
                
                union 
                
                select initcap(nome) display_value
                     , idpostoavancado return_value
                from postoavancado 
                where v('APP_USER') = 'MAICONAIMI'
                  and ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @posto-avançado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Nova Devolução
        layout {
            sequence: 30
            region: @devoluções-distribuidor-pa
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 319
                items: {
                    P319_IDPOSTOAVANCADO: &P318_IDPOSTOAVANCADO.
                }
                clearCache: 319
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button vai-para-devolucao (
        buttonName: VAI_PARA_DEVOLUCAO
        label: Vai Para Devolucao
        layout {
            sequence: 30
            region: @posto-avançado
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from roman.usuariosgruposatendimento ug
                 where ug.usuario = v('APP_USER')
                   and ug.idgrupoatendimento = 0
                ```
        }
    )

    branch (
        name: GO_TO_319
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 319
                items: {
                    P319_IDDEVOLUCAOREPRES: &P318_IDDEVOLUCAO.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @vai-para-devolucao
        }
    )

