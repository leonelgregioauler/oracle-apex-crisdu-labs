    region devoluções-distribuidor-pa (
        name: Devoluções Distribuidor PA
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iddevolucaorepres
                     , pck_romance.fnc_nomerepresentante(idrepresentante) "Representante"
                     , semana
                     , valortotal
                     , idfilial
                     , decode( situacao , 1 , 'Aberta'
                                        , 2 , 'Aguardando Conclusão'
                                        , 3 , 'Concluída'
                                        , 0 , 'Cancelada') "Situação"
                     , observacao
                     , ( select sum(i.qtd_pp)
                         from itensdevolucaorepres i
                         where i.iddevolucaorepres = d.iddevolucaorepres ) "Qtd PP"
                     , ( select sum(i.qtd_p)
                         from itensdevolucaorepres i
                         where i.iddevolucaorepres = d.iddevolucaorepres ) "Qtd P"
                     , ( select sum(i.qtd_m)
                         from itensdevolucaorepres i
                         where i.iddevolucaorepres = d.iddevolucaorepres ) "Qtd M"
                     , ( select sum(i.qtd_g)
                         from itensdevolucaorepres i
                         where i.iddevolucaorepres = d.iddevolucaorepres ) "Qtd G"            
                     , ( select sum(i.qtd_gg)
                         from itensdevolucaorepres i
                         where i.iddevolucaorepres = d.iddevolucaorepres ) "Qtd GG"
                     , ( select sum(i.qtd_egg)
                         from itensdevolucaorepres i
                         where i.iddevolucaorepres = d.iddevolucaorepres ) "Qtd EGG"
                     , ( select sum(i.qtd_exgg)
                         from itensdevolucaorepres i
                         where i.iddevolucaorepres = d.iddevolucaorepres ) "Qtd EXGG"
                     , ( select sum(i.qtd_u)
                         from itensdevolucaorepres i
                         where i.iddevolucaorepres = d.iddevolucaorepres ) "Qtd U" 
                     , ( select sum((nvl(i.qtd_u,0)
                                  + nvl(i.qtd_exgg,0)
                                  + nvl(i.qtd_egg,0)
                                  + nvl(i.qtd_gg ,0)
                                  + nvl(i.qtd_g  ,0)
                                  + nvl(i.qtd_m  ,0)
                                  + nvl(i.qtd_p  ,0)
                                  + nvl(i.qtd_pp ,0))*i.valorproduto)
                         from itensdevolucaorepres i
                         where i.iddevolucaorepres = d.iddevolucaorepres 
                           and i.comissao = 'S' ) "Total COM Comissão" 
                     , ( select sum((nvl(i.qtd_u,0)
                                  + nvl(i.qtd_exgg,0)
                                  + nvl(i.qtd_egg,0)
                                  + nvl(i.qtd_gg ,0)
                                  + nvl(i.qtd_g  ,0)
                                  + nvl(i.qtd_m  ,0)
                                  + nvl(i.qtd_p  ,0)
                                  + nvl(i.qtd_pp ,0))*I.valorproduto)
                         from itensdevolucaorepres i
                         where i.iddevolucaorepres = d.iddevolucaorepres 
                           and i.comissao = 'N' ) "Total SEM Comissão"  
                     , ( select sum(nvl(i.qtd_u,0)
                                  + nvl(i.qtd_exgg,0)
                                  + nvl(i.qtd_egg,0)
                                  + nvl(i.qtd_gg ,0)
                                  + nvl(i.qtd_g  ,0)
                                  + nvl(i.qtd_m  ,0)
                                  + nvl(i.qtd_p  ,0)
                                  + nvl(i.qtd_pp ,0))
                         from itensdevolucaorepres i
                         where i.iddevolucaorepres = d.iddevolucaorepres ) "Total Peças" 
                     , d.datainclusao "Data Inclusão"
                     , d.dataconclusao "Data Conclusão"
                     , d.usuario "Usuário Incluiu"
                from devolucoesrepresentantes d
                where d.idfilial = :P0_IDFILIAL
                  and d.idpostoavancado = :P318_IDPOSTOAVANCADO
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
