page 531 (
    name: Pagamentos de Venda Direta Romance
    title: Pagamentos de Venda Direta Romance
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region pagamentos-de-venda-direta (
        name: Pagamentos de Venda Direta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select pck_romance.fnc_nomepessoa(idpessoa)
                         from funcionarios f
                         where f.idfuncionario = v.idfuncionario ) funcionario
                     , v.semana
                     , pg.valorpago
                     , pg.datapagamento
                     , pg.semanacobranca
                     , pg.usuario
                from pagamentosvendasdiretas pg
                   , vendasdiretas v
                where v.idvendadireta = pg.idvendadireta
                  and pg.idfechamento = :P531_IDFECHAMENTO
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: "Nenhum pagamento de venda direta da romance encontrado. "
        }
        advanced {
            savedReportMappingIdentifier: 958404033020324904
        }

