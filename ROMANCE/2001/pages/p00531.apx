    pageItem P531_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @pagamentos-de-venda-direta
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    process confirmar-assinatura (
        name: Confirmar Assinatura
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidcaracteristica number := 24;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);
                  vidnotavenda number := :P531_IDRECEBIDO;
                  --
                begin 
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P531_IDRECEBIDO,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidvalorcaracteristica,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Assinatura Confirmada!
        }
        advanced {
            executionMappingIdentifier: 958452462118807199
        }
        serverSideCondition {
            type: request=Value
            value: ASSINATURACONFIRMADA
        }
    )

    process confirmar-promissoria (
        name: Confirmar Promissoria
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidcaracteristica number := 3;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);
                  vidnotavenda number := :P531_IDRECEBIDO;
                  --
                begin 
                  --
                  update notasvendas n
                  set n.promissoriarecuperada = 'S'
                  where n.idnotavenda = :P531_IDRECEBIDO;
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P531_IDRECEBIDO,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidvalorcaracteristica,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Promissória Recebida
        }
        advanced {
            executionMappingIdentifier: 958452024871807198
        }
        serverSideCondition {
            type: request=Value
            value: PROMISSORIARECEBIDA
        }
    )

)

