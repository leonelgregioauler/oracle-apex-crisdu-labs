    region resumido-p748-nomecategoria (
        name: Resumido - &P748_NOMECATEGORIA.
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  v_select varchar2(4000);
                  v_where  varchar2(4000);
                  --
                begin
                  --
                  v_where := ' ';
                  --
                  v_select := 'select favorita.pck_util_fav.fnc_nomerepresentante(t.idrepresentante) distribuidor,
                       favorita.pck_util_fav.fnc_nomevendedora(t.idvendedora) empreendedora ,
                       sum(t.pontos) pontos,
                       t.cpf,
                       t.documentoestrangeiro
                          from roman.vw_detalhamento_pontos t
                         where t.idcategoriaclube = :P748_IDCATEGORIA
                           and not exists  (select 1
                                              from representantes r
                                             where r.idpessoa = t.idpessoa
                                               and r.idrepresentante = t.idrepresentante) 
                           and exists ( select 1 
                                          from filiais f
                                         where f.idfilial = t.idfilial
                                           and f.ididioma = :P748_IDPAIS ) ';
                  if :P748_IDFILIAL != -1 then
                    v_where := v_where || ' and t.idfilial = :P748_IDFILIAL ';
                  end if;
                  --
                  if :P748_IDREPRESENTANTE != -1 then 
                    v_where := v_where || ' and t.idrepresentante = :P748_IDREPRESENTANTE ';
                  end if;
                  --
                  if nvl(:P748_SITUACAO_CONSULTORA,'T') != 'T' then
                    if :P748_SITUACAO_CONSULTORA = 'A' then
                      v_where := v_where || ' and t.ativo = ''S'' ';
                    else
                      v_where := v_where || ' and t.ativo = ''N'' ';
                    end if;
                  end if;
                  --
                  v_where := v_where || ' group by t.idrepresentante, t.idvendedora, t.cpf, t.documentoestrangeiro ';
                  --
                  return (v_select || chr(10) || v_where );
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
