    region pontos-vencidos (
        name: Pontos Vencidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                    Maicon Aimi - 09/10/2024 - query criada para atender o ticket 9160738
                */
                select h.pontos                                                       pontos
                     , favorita.pck_util_fav.fnc_nomerepresentante(r.idrepresentante) representrante
                     , favorita.pck_util_fav.fnc_nomevendedora(h.idvendedora)         vendedora
                     , p.cpf                                                          cpf_vendedora
                     , p.documentoestrangeiro                                         doc_estrangeiro_vendedora
                     , pck_util.fnc_semanaid(h.idsemana)                              semana_cobranca_pagamento
                     , decode(h.idnotavenda,null, 'Pedido', 'Nota Venda')             tipo_documento
                     , decode(h.idnotavenda,null, h.idpedido, h.idnotavenda)          documento
                     , case when h.idnotavenda is not null then 
                         (select datapagamento 
                            from roman.pagamentosnotasvendas 
                           where idpagtonotavenda = h.idpagamentonotavenda ) 
                       else 
                         (select datapagamento 
                            from favorita.pagamentospedidos
                           where idpagamentopedido = h.idpagamentopedido ) 
                       end                                                            data_pagamento
                     , case
                         when h.dataexpiracao is null then
                           to_char((select s.dt_fim
                                      from roman.semana_dias s
                                     where s.idsemana = h.idsemana + 18),'dd/mm/rrrr')  
                         else
                           to_char(h.dataexpiracao,'dd/mm/rrrr')
                         end  pontos_a_vencer
                  from roman.historicospontosclube h
                     , catal.vendedoras            v
                     , catal.representantes        r
                     , catal.pessoas               p
                 where -- Ligações entre tabelas
                       v.idvendedora     = h.idvendedora
                   and r.idrepresentante = v.idrepresentante
                   and p.idpessoa = v.idpessoa
                       -- filtros
                   and ( h.idpagamentonotavenda is not null or h.idpagamentopedido is not null)
                   and nvl(h.pontos,0) > 0
                       -- Esse BETWEEN tem o objetivo de trazer apenas os pontos que expiraram no período de um ano para trás.
                   and ( h.idsemana between (:P748_IDSEMANAATUAL - 70) and (:P748_IDSEMANAATUAL - 19)
                     or h.dataexpiracao < trunc(sysdate) )
                   and h.idvendedora = :P748_IDVENDEDORA
                 order by idsemana desc
                 
                 
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                margin-top-lg
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <div style="font-family: Arial, sans-serif; font-size: 20px; color: #4a4a4a; text-align: left; padding-top: 20px; padding-bottom: 20px; border: 1px solid #b3b3b3; background-color: #f2f2f2; margin-bottom: 30px;">
                  <ul style="list-style-type: disc; padding-left: 20px;">
                    <div style="margin-bottom: 5px;"> <strong>Observações:</strong> </div>
                    <li>&P748_DESCRITIVO_SEMANA_ATUAL..</li>
                    <li>Os pontos têm validade de 18 semanas.</li>
                    <li>&P748_DESCRITIVO_PERIODO_VIGENTE..</li>
                  </ul>
                </div>
                ```
        }
