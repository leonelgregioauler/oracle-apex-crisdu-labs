    process inicializa-variaveis (
        name: Inicializa variaveis
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                
                    -- Busca informações da semana atual para exibir ao usuário final
                    select 'Semana Atual: ' || s.semanacompleta || '  vigência: ' || to_char(s.dt_ini,'DD/MM/YYYY') || ' a ' || to_char(s.dt_fim,'DD/MM/YYYY')
                         , idsemana
                      into :P748_DESCRITIVO_SEMANA_ATUAL
                         , :P748_IDSEMANAATUAL
                      from roman.semana_dias s
                     where trunc(sysdate) between s.dt_ini and s.dt_fim;
                
                
                    -- Monta o informativo do período vigênte dos pontos expirados
                    select 'Estão listados abaixo os pontos vencidos entre SEMANA ' 
                        || (select s.semanacompleta || ' (' || s.dt_ini || ') até SEMANA '
                              from roman.semana_dias s
                             where s.idsemana = (1044 -70))
                        || (select s.semanacompleta || ' (' || s.dt_fim || ')'
                              from roman.semana_dias s
                             where s.idsemana = (1044 -18))
                      into :P748_DESCRITIVO_PERIODO_VIGENTE
                      from dual;
                
                
                    -- Tratamento de erros
                exception
                    when others then
                        :P748_DESCRITIVO_SEMANA_ATUAL     := 'Semana não encontrada';
                        :P748_DESCRITIVO_PERIODO_VIGENTE  := 'Não encontrado';
                        :P748_IDSEMANAATUAL               := null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 49810731736076913
        }
    )

)

