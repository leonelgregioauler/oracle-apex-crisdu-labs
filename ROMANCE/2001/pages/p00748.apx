    region detalhado-p748-nomecategoria (
        name: Detalhado - &P748_NOMECATEGORIA.
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select t.pontos
                     , t.idsemana
                     , roman.pck_util.fnc_semanaid(t.idsemana) semana_cobranca_pagamento
                     , t.tipodocumento
                     , t.documento
                     , t.idpagamentonotavenda
                     , t.idpagamentopedido
                     , case
                         when t.idregistrologinminhasacola is not null then
                           ( select r.datalogin
                             from registrosloginminhasacola r
                             where r.idregistrologinminhasacola = t.idregistrologinminhasacola )
                         when t.idpagamentonotavenda is not null then
                           (select datapagamento 
                              from roman.pagamentosnotasvendas 
                             where idpagtonotavenda = t.idpagamentonotavenda ) 
                         when t.idpedido is not null and exists ( select 1
                                                                  from vw_filiais fl
                                                                  where fl.idfilial = t.idfilial
                                                                    and fl.ididioma = 1) then 
                           (select datapagamento 
                              from favorita.pagamentospedidos
                             where idpagamentopedido = t.idpagamentopedido)
                         when t.idpedido is not null and exists ( select 1
                                                                  from vw_filiais fl
                                                                  where fl.idfilial = t.idfilial
                                                                    and fl.ididioma != 1) then 
                           (select databaixa 
                              from favorita.pagamentospedidos
                             where idpagamentopedido = t.idpagamentopedido)
                             
                       end data_pagamento
                    , dataexpiracao
                  from roman.vw_detalhamento_pontos t
                 where t.idvendedora = :P748_IDVENDEDORA
                 order by 2
                
                ~';
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
