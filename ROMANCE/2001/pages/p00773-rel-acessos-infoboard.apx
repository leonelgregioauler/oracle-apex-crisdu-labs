                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Rel Acessos Infoboard
        }

        savedReport 3774838 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Nome Modulo" (
                sequence: 1
            )

            displayColumn "Nome Perfil" (
                sequence: 2
            )

            displayColumn "Usuario" (
                sequence: 3
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Acesso
        layout {
            sequence: 10
            region: @rel-acessos-infoboard
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 774
                clearCache: 774
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @rel-acessos-infoboard
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @rel-acessos-infoboard
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

