page 773 (
    name: Rel Acessos Infoboard
    alias: REL-ACESSOS-INFOBOARD
    title: Rel Acessos Infoboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region rel-acessos-infoboard (
        name: Rel Acessos Infoboard
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDACESSOINFOBOARD
                     , a.IDUSUARIO
                     , (favorita.pck_util_fav.fnc_nomeusuario(a.idusuario)||' - '||u.usuario) "Usuario"
                     , IDPERFILINFOBOARD
                     , (select nomeperfil
                          from perfisinfoboard
                         where idperfilinfoboard = a.idperfilinfoboard) "Nome Perfil"
                     , (select idmodinfoboard
                          from modulosinfoboard
                         where idmodinfoboard = (select idmodinfoboard
                                                   from perfisinfoboard
                                                  where idperfilinfoboard = a.idperfilinfoboard)) idmodinfoboard
                     , (select nomeinfoboard
                          from modulosinfoboard
                         where idmodinfoboard = (select idmodinfoboard
                                                   from perfisinfoboard
                                                  where idperfilinfoboard = a.idperfilinfoboard)) "Nome Modulo"
                
                  from ACESSOSINFOBOARD a
                     , catal.usuarios u
                  where a.idusuario = u.idusuario
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 774
                items: {
                    P774_IDACESSOINFOBOARD: \#IDACESSOINFOBOARD#\
                    P774_IDMODINFOBOARD: #IDMODINFOBOARD#
                }
                clearCache: 774
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 377479473616149725
        }

        column IDACESSOINFOBOARD (
            type: hidden
            heading {
                heading: Idacessoinfoboard
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDMODINFOBOARD (
            type: plainText
            heading {
                heading: Idmodinfoboard
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column IDPERFILINFOBOARD (
            type: plainText
            heading {
                heading: Idperfilinfoboard
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDUSUARIO (
            type: plainText
            heading {
                heading: Idusuario
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column "Nome Modulo" (
            type: plainText
            heading {
                heading: Nome Modulo
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column "Nome Perfil" (
            type: plainText
            heading {
                heading: Nome Perfil
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column Usuario (
            type: plainText
            heading {
                heading: Usuario
            }
