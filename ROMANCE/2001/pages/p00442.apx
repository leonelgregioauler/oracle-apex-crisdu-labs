        }
    )

    pageItem P442_IDPAGAMENTO (
        type: numberField
        label {
            label: ID Controle
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @anexos-pagamentos-de-empréstimos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: IDPAGAMENTO
            used: always
        }
        readOnly {
            type: always
        }
