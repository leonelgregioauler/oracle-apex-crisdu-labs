        }
    )

    pageItem P442_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @anexos-pagamentos-de-empréstimos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vidusuario number;
                  --
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  return vidusuario;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P442_NOMEARQUIVO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @anexos-pagamentos-de-empréstimos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 60
            region: @anexos-pagamentos-de-empréstimos
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P442_IDANEXOEMPRESTIMOPGTO
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 20
            region: @anexos-pagamentos-de-empréstimos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P442_IDANEXOEMPRESTIMOPGTO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @anexos-pagamentos-de-empréstimos
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 211
                items: {
                    P211_IDEMPRESTIMO: &P442_IDEMPRESTIMO.
                    P211_IDPAGAMENTO: &P442_IDPAGAMENTO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process anexo (
        name: Anexo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_pgtoemprestimo(pidpagamento => :P442_IDPAGAMENTO);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Arquivo anexado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1504346751370345857
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P442_IDANEXOEMPRESTIMO := null;
                  pck_anexos.prc_apagaanexo_pgtoemprestimo(pidanexoemprestimopgto => :P442_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 1504347164402345857
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexosemprestimospgtos (
        name: Fetch Row from ANEXOSEMPRESTIMOSPGTOS
        type: autoRowFetch
        source {
            tableName: ANEXOSCHEQUESPGTO
            pkColumn: IDANEXOCHEQUEPGTO
            pkItem: P442_IDANEXOEMPRESTIMOPGTO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1504347588763345857
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P442_IDANEXOEMPRESTIMOPGTO is null then
                        select "#OWNER#"."SEQ_IDANEXOEMPRESTIMOPGTO".nextval
                          into :P442_IDANEXOEMPRESTIMOPGTO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1504347914557345858
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexosemprestimospgtos (
        name: Process Row of ANEXOSEMPRESTIMOSPGTOS
        type: autoRowProcessing
        target {
            tableName: ANEXOSEMPRESTIMOSPGTOS
            pkColumn: IDANEXOEMPRESTIMOPGTO
            pkItem: P442_IDANEXOEMPRESTIMOPGTO
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Arquivo Anexado.
        }
        advanced {
            executionMappingIdentifier: 1504348341324345858
        }
    )

    branch (
        name: Go To Page 442
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 211
                items: {
                    P211_IDEMPRESTIMO: &P442_IDEMPRESTIMO.
                    P211_IDPAGAMENTO: &P442_IDPAGAMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('DELETAR','SAVE','CREATE')
                ```
        }
    )

)

