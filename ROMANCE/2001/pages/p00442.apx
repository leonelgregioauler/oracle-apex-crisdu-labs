        }
        layout {
            sequence: 90
            region: @anexos-pagamentos-de-empréstimos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P442_IDANEXOEMPRESTIMOPGTO (
        type: hidden
        layout {
            sequence: 10
            region: @anexos-pagamentos-de-empréstimos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXOEMPRESTIMOPGTO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P442_IDEMPRESTIMO (
        type: hidden
