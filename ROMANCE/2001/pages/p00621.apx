    region compartilhamentos-por-distribuidor (
        name: Compartilhamentos Por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(c.idfilial) Filial
                     , roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) Distribuidor
                     , m.cnpj
                     , count(c.idregistrocompartilhafoto)Qtd
                from roman.registroscompartilhafotos c
                     , catal.vendedoras v
                     , catal.representantes r
                     , catal.mei m
                where c.idvendedora = v.idvendedora
                  and v.idrepresentante = r.idrepresentante
                  and r.idpessoa = m.idpessoa(+)
                  and not exists(select 1
                                 from catal.representantes r
                                 where r.idpessoa = v.idpessoa)
                  and c.idsemana between :P621_IDSEMANAINI and :P621_IDSEMANAFIM 
                  and ( :P621_IDREPRESENTANTE is null or v.idrepresentante = :P621_IDREPRESENTANTE )
                  and ( :P621_IDVENDEDORA is null or c.idvendedora = :P621_IDVENDEDORA )
                  and ( :P621_TIPOPESQUISA = 'T'
                     or ( :P621_TIPOPESQUISA  = 'F' and c.idfilial= :P621_IDFILIAL )
                     or ( :P621_TIPOPESQUISA  = 'G' and c.idfilial in ( select idfilial 
                                                                        from filtrosfiliais ff
                                                                        where ff.usuario = v('APP_USER') ) ) )
                  and :P621_FILTRAR = 'S'
                group by v.idrepresentante,c.idfilial, m.cnpj
                order by 1,2
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
