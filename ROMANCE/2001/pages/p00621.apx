            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P621_IDSEMANAFIM (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semanacompleta
                     , idsemana
                from semana_dias s
                where s.dt_fim < sysdate +7
                  AND IDSEMANA >= :P621_IDSEMANAINI
                order by idsemana desc
                ```
        }
        cascadingLov {
            parentItems: P621_IDSEMANAINI
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
