    pageItem P621_TIPOPESQUISA (
        type: radioGroup
        label {
            label: Pesquisar Por
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Empresa;F,Grupo de Empresas;G,Todas;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @page_plug
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: F
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P621_TIPOVISAO (
        type: radioGroup
        label {
            label: Visão
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Detalhada;D,Resumida;R
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @page_plug-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

    button add-filiais (
        buttonName: ADD_FILIAIS
        label: + Empresas
        layout {
            sequence: 50
            region: @page_plug
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 540
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @page_plug
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction filtrar (
        name: Filtrar
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction muda-filtro-fim (
        name: Muda Filtro Fim
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P621_IDSEMANAFIM
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P621_IDSEMANAFIM_ANT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction muda-filtro-ini (
        name: Muda Filtro Ini
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P621_IDSEMANAINI
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P621_IDSEMANAINI_ANT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P621_TIPOVISAO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @uso-do-vendas-2
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @uso-do-vendas
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction tipo-f (
        name: Tipo F
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P621_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P621_TIPOPESQUISA
            value: F
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P621_IDFILIAL
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P621_IDFILIAL
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-g (
        name: Tipo G
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P621_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P621_TIPOPESQUISA
            value: G
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @add-filiais
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: button
                button: @add-filiais
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipof (
        name: TipoF
        execution {
            sequence: 80
        }
        when {
            selectionType: region
            region: @new
        }
        clientSideCondition {
            type: item=value
            item: P621_TIPOPESQUISA
            value: F
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @new
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @new
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 621
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 621
                items: {
                    P621_IDSEMANAINI: &P621_IDSEMANAINI.
                    P621_IDSEMANAINI_ANT: &P621_IDSEMANAINI_ANT.
                    P621_TIPOPESQUISA: &P621_TIPOPESQUISA.
                    P621_IDSEMANAFIM: &P621_IDSEMANAFIM.
                    P621_IDSEMANAFIM_ANT: &P621_IDSEMANAFIM_ANT.
                    P621_IDFILIAL: &P621_IDFILIAL.
                    P621_FILTRAR: S
                    P621_IDVENDEDORA: &P621_IDVENDEDORA.
                    P621_IDREPRESENTANTE: &P621_IDREPRESENTANTE.
                    P621_TIPOVISAO: &P621_TIPOVISAO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

)

