    region acompanhamento-por-empresa (
        name: Acompanhamento Por Empresa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(d.idfilial) Filial 
                     , nvl(d.atu,0) "Atual"
                     , round(d.atu / d.sa) "Média Atual"
                     , nvl(a.ant,0) "Anterior"
                     , round(a.ant / a.san) "Média Anterior"
                     , case
                         when a.ant > 0 then
                           round(((d.atu-a.ant)/a.ant)*100 ,2)
                         else
                           d.atu
                       end crescimento
                from (select count(distinct(l.idvendedora)) atu
                           , idfilial
                           , count (distinct(l.idsemana)) sa
                      from roman.registrosloginminhasacola l
                      where l.idsemana between :P621_IDSEMANAINI and :P621_IDSEMANAFIM 
                        and ( :P621_IDSEMANAINI is not null )
                        and ( :P621_TIPOPESQUISA = 'T'
                         or ( :P621_TIPOPESQUISA = 'F' and l.idfilial = :P621_IDFILIAL )
                         or ( :P621_TIPOPESQUISA = 'G' and l.idfilial in ( select idfilial 
                                                                           from filtrosfiliais ff
                                                                           where ff.usuario = v('APP_USER') ) ) )
                      group by idfilial ) d
                   , ( select count(distinct (l.idvendedora)) ant
                            , idfilial
                            , count (distinct(l.idsemana)) san
                       from roman.registrosloginminhasacola l
                       where l.idsemana between :P621_IDSEMANAINI_ANT and :P621_IDSEMANAFIM_ANT 
                         and ( :P621_IDSEMANAINI_ANT is not null )
                         and ( :P621_TIPOPESQUISA = 'T'
                          or ( :P621_TIPOPESQUISA = 'F' and l.idfilial = :P621_IDFILIAL )
                          or ( :P621_TIPOPESQUISA = 'G' and l.idfilial in ( select idfilial 
                                                                            from filtrosfiliais ff
                                                                            where ff.usuario = v('APP_USER') ) ) )
                      group by idfilial ) a
                where d.idfilial = a.idfilial(+)
                  and :P621_FILTRAR = 'S'
                order by 1 
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
