    region não-compartilha (
        name: Não Compartilha
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(l.idfilial) Filial
                      , roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) Distribuidor
                      , roman.pck_romance.fnc_nomevendedora(v.idvendedora) Consultora
                      , roman.pck_romance.fnc_cpfvendedora(v.idvendedora) cpf
                from roman.registrosloginminhasacola l
                   , catal.vendedoras v
                where l.idvendedora = v.idvendedora
                  and not exists( select 1
                                  from roman.registroscompartilhafotos c
                                  where l.idvendedora = c.idvendedora )
                  and l.idsemana between :P621_IDSEMANAINI and :P621_IDSEMANAFIM 
                  and  l.idfilial = :P621_IDFILIAL 
                  and ( :P621_IDREPRESENTANTE is null or v.idrepresentante = :P621_IDREPRESENTANTE )
                  and ( :P621_IDVENDEDORA is null or l.idvendedora = :P621_IDVENDEDORA )
                  and :P621_FILTRAR = 'S'
                  and :P621_IDFILIAL is not null
                  and :P621_TIPOVISAO = 'D'
                group by l.idfilial,v.idrepresentante, v.idvendedora
                ```
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: subRegions
        }
