            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P621_IDSEMANAFIM_ANT (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semanacompleta
                     , idsemana
                from semana_dias s
                where s.dt_fim < sysdate +7 
                order by idsemana desc
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 20
            region: @período-de-comparação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidsemana number;
                begin
                  select idsemana
                  into vidsemana
                  from semana_dias
                  where (semana,ano) = ( select semana, ano-1
                                         from semana_dias
                                         where idsemana = :P621_IDSEMANAFIM );
                                         
                  RETURN VIDSEMANA;
                exception
                  when others then
                    return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

