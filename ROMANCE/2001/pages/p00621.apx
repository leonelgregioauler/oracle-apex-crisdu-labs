    region acompanhamento-por-distribuidor (
        name: Acompanhamento Por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(d.idfilial) Empresa 
                     , roman.pck_romance.fnc_nomerepresentante(d.idrepresentante) Representante
                     , d.cnpj
                     , nvl(d.atu,0) atual
                     , round(d.atu / d.sa) "Média Atual"
                     , nvl(a.ant,0) anterior
                     , round(a.ant / a.san) "Média Anterior"
                     , case
                         when a.ant > 0 then
                           round(((d.atu-a.ant)/a.ant)*100 ,2)
                         else
                           d.atu
                       end crescimento
                from (select count (distinct l.idvendedora) atu
                           , l.idfilial
                           , v.idrepresentante
                           , m.cnpj
                           , count (distinct(l.idsemana)) sa
                      from roman.registrosloginminhasacola l
                         , catal.vendedoras v
                         , catal.representantes r
                         , catal.mei m
                      where l.idvendedora = v.idvendedora
                        and v.idrepresentante = r.idrepresentante
                        and r.idpessoa = m.idpessoa(+)
                        and l.idsemana between :P621_IDSEMANAINI and :P621_IDSEMANAFIM 
                        and ( :P621_IDSEMANAINI is not null )
                        and ( :P621_TIPOPESQUISA = 'T'
                         or ( :P621_TIPOPESQUISA = 'F' and l.idfilial = :P621_IDFILIAL )
                         or ( :P621_TIPOPESQUISA = 'G' and l.idfilial in ( select idfilial 
                                                                           from filtrosfiliais ff
                                                                           where ff.usuario = v('APP_USER') ) ) )
                      group by l.idfilial,v.idrepresentante,m.cnpj ) d
                   , ( select count (distinct l.idvendedora) ant
                            , l.idfilial
                            , v.idrepresentante
                            , m.cnpj
                            , count (distinct(l.idsemana)) san
                       from roman.registrosloginminhasacola l
                          , catal.vendedoras v
                          , catal.representantes r
                          , catal.mei m
                       where l.idvendedora = v.idvendedora
                         and v.idrepresentante = r.idrepresentante
                         and r.idpessoa = m.idpessoa(+)
                         and l.idsemana between :P621_IDSEMANAINI_ANT and :P621_IDSEMANAFIM_ANT
                         and ( :P621_IDSEMANAINI is not null )
                         and ( :P621_TIPOPESQUISA = 'T'
                          or ( :P621_TIPOPESQUISA = 'F' and l.idfilial = :P621_IDFILIAL )
                          or ( :P621_TIPOPESQUISA = 'G' and l.idfilial in ( select idfilial 
                                                                            from filtrosfiliais ff
                                                                            where ff.usuario = v('APP_USER') ) ) )
                       group by l.idfilial,v.idrepresentante,m.cnpj) a
                where d.idrepresentante = a.idrepresentante(+)
                  and :P621_FILTRAR = 'S'
                order by 1,2 
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: -Nenhum dado encontrado, verifique os filtros-
        }
        advanced {
            savedReportMappingIdentifier: 116548001956927128
        }

