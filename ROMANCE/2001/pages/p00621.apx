    pageItem P621_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and exists ( select 1
                               from usuariosfiliais uf
                               where uf.idfilial = f.idfilial
                                 and uf.usuario  = v('APP_USER') )
                
                ```
        }
        layout {
            sequence: 20
            region: @page_plug
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P621_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||decode(r.ativo,'S','Ativo','N','Inativo') d
                     , r.idrepresentante r
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente
                  and ( :P621_IDFILIAL is null or g.idfilial = :P621_IDFILIAL)
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P621_IDFILIAL
        }
        layout {
            sequence: 20
            region: @page_plug
            slot: regionBody
            alignment: left
        }
        appearance {
