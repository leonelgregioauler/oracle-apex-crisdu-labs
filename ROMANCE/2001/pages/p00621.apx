    region top-vendas-favorita (
        name: Top Vendas Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rownum "POSIÇÃO"
                             , x.*
                from (select roman.pck_romance.fnc_nomevendedora(p.idvendedora) CONSULTORA
                           , roman.pck_romance.fnc_cpfvendedora(p.idvendedora) cpf
                           , sum(p.valorapagar) VALOR
                           , nvl( ( select 'Sim'
                                    from dual
                                    where exists( select 1
                                                  from roman.registrosloginminhasacola r
                                                  where r.idvendedora = p.idvendedora
                                                    and r.idsemana between :P621_IDSEMANAINI and :P621_IDSEMANAFIM ) ), 'Não') login 
                           , ( select min(r.datalogin)
                               from roman.registrosloginminhasacola r
                               where r.idvendedora = p.idvendedora ) menor_data
                           , ( select max(r.datalogin)
                               from roman.registrosloginminhasacola r
                               where r.idvendedora = p.idvendedora ) maior_data  
                from favorita.vw_pedidos_fav p
                where p.saldodevedor = 0
                  and p.idpais = 1
                  and p.valorapagar > 0 
                  and p.datacancelamento is null
                  and p.idsemanaemissao between :P621_IDSEMANAINI and :P621_IDSEMANAFIM
                  and exists (select 1 
                              from roman.registrosloginminhasacola l
                              where l.idvendedora = p.idvendedora)
                  and not exists (select 1
                                  from catal.gerentes g
                                  where g.idpessoa = p.idpessoa )
                  and not exists (select 1
                                  from catal.representantes r
                                  where r.idpessoa = p.idpessoa )
                  and ( :P621_TIPOPESQUISA = 'T'
                   or ( :P621_TIPOPESQUISA = 'F' and p.idfilialromance = :P621_IDFILIAL )
                   or ( :P621_TIPOPESQUISA = 'G' and p.idfilialromance in ( select idfilial 
                                                                            from filtrosfiliais ff
                                                                            Where ff.usuario = v('APP_USER') ) ) )
                  and :P621_FILTRAR = 'S'
                group by p.idvendedora
                order by 3 desc ) x
                where rownum <= 100;
                
                
                
                
                
                ```
        }
        layout {
            sequence: 90
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: -Nenhum dado encontrado, verifique os filtros-
        }
        advanced {
            savedReportMappingIdentifier: 116629353021590213
        }

