    region uso-do-vendas (
        name: Uso do Vendas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(l.idfilial) Filial
                     , roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) Distribuidor
                     , roman.pck_romance.fnc_nomevendedora(l.idvendedora) Consultora
                     , count(distinct (l.idregistrologinminhasacola)) qtd
                     --, count (distinct (l.idvendedora)) qtd
                from roman.registrosloginminhasacola l
                   , catal.vendedoras v
                where l.idvendedora = v.idvendedora
                  and exists ( select 1
                               from roman.itensnotasvendasapp iv
                                  , roman.notasvendasapp nv
                               where iv.idnotavendaapp = nv.idnotavendaapp
                                 and l.idvendedora = nv.idvendedora
                                 and iv.quantidadevendida != 0 )
                  and not exists(select 1
                                 from catal.representantes r
                                 where r.idpessoa = v.idpessoa)
                  and l.idsemana between :P621_IDSEMANAINI and :P621_IDSEMANAFIM 
                  and ( :P621_IDREPRESENTANTE is null or v.idrepresentante = :P621_IDREPRESENTANTE )
                  and ( :P621_IDVENDEDORA is null or l.idvendedora = :P621_IDVENDEDORA )
                  and ( :P621_TIPOPESQUISA = 'T'
                         or ( :P621_TIPOPESQUISA = 'F' and l.idfilial = :P621_IDFILIAL )
                         or ( :P621_TIPOPESQUISA = 'G' and l.idfilial in ( select idfilial 
                                                                           from filtrosfiliais ff
                                                                           where ff.usuario = v('APP_USER') ) ) )
                  and :P621_TIPOVISAO = 'D'
                  and :P621_FILTRAR = 'S'
                group by l.idfilial,v.idrepresentante, l.idvendedora
                order by 1,2,4 desc
                ```
        }
        layout {
            sequence: 20
            parentRegion: @uso
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P621_TIPOVISAO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: -Nenhum dado encontrado, verifique os filtros-
        }
        advanced {
            savedReportMappingIdentifier: 116550005369927148
        }

