    region top-vendas-romance (
        name: Top Vendas Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rownum "POSIÇÃO"
                             , x.*
                from (select roman.pck_romance.fnc_nomevendedora(nv.idvendedora) CONSULTORA
                      , roman.pck_romance.fnc_cpfvendedora(nv.idvendedora) cpf
                      , sum(nv.valortotalvenda) VENDA
                      , nvl( ( select 'Sim'
                               from dual
                               where exists( select 1
                                             from roman.registrosloginminhasacola r
                                             where r.idvendedora = nv.idvendedora
                                               and r.idsemana between :P621_IDSEMANAINI and :P621_IDSEMANAFIM ) ), 'Não') login
                      , ( select min(r.datalogin)
                          from roman.registrosloginminhasacola r
                          where r.idvendedora = nv.idvendedora ) menor_data
                      , ( select max(r.datalogin)
                          from roman.registrosloginminhasacola r
                          where r.idvendedora = nv.idvendedora ) maior_data
                from roman.notasvendas nv
                where nv.idsituacaonotavenda = 4
                and nv.saldo = 0
                and nv.idsemanacobranca between :P621_IDSEMANAINI and :P621_IDSEMANAFIM 
                and ( :P621_IDREPRESENTANTE is null or nv.idrepresentante = :P621_IDREPRESENTANTE )
                and ( :P621_IDVENDEDORA is null or nv.idvendedora = :P621_IDVENDEDORA )
                and ( :P621_TIPOPESQUISA = 'T'
                 OR ( :P621_TIPOPESQUISA = 'F' and NV.IDFILIAL = :P621_IDFILIAL )
                 OR ( :P621_TIPOPESQUISA = 'G' and NV.IDFILIAL in ( select idfilial 
                                                                    from filtrosfiliais ff
                                                                    Where ff.usuario = v('APP_USER') ) ) )
                and :P621_FILTRAR = 'S'
                group by nv.idvendedora
                order by 3 desc) x
                where rownum <= 100;
                
                
                
                ```
        }
