    region uso-do-vendas-2 (
        name: Uso do Vendas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ROMAN.PCK_ROMANCE.FNC_NOMEFILIAL(X.IDFILIAL) FILIAL
                     , X.REPRESENTANTE
                     , X.CNPJ
                     , X.VENDEDORAS
                     , X.QTD_USO
                     , CASE
                         WHEN X.VENDEDORAS > 0 THEN
                           ROUND( ((X.QTD_USO/X.VENDEDORAS) * 100),2)
                         ELSE
                           0
                       END "% SOB USO"
                     , X.QTD_VENDA
                     , CASE
                         WHEN X.QTD_USO > 0 THEN
                           ROUND( ((X.QTD_VENDA/X.QTD_USO) * 100),2)
                         ELSE
                           0
                       END "% VENDA SOB USO"
                FROM ( SELECT R.IDREPRESENTANTE
                            , ROMAN.PCK_ROMANCE.fnc_nomerepresentante(R.IDREPRESENTANTE) REPRESENTANTE
                            , ( SELECT COUNT(DISTINCT IDVENDEDORA)
                                FROM ROMAN.NOTASVENDAS NV
                                WHERE NV.IDREPRESENTANTE = R.IDREPRESENTANTE
                                  AND NV.IDFILIAL    = G.IDFILIAL
                                  AND NV.IDSITUACAONOTAVENDA = 3 ) VENDEDORAS
                            , USO_APP.QTD QTD_USO
                            , USO_VENDAS.QTD QTD_VENDA
                            , M.CNPJ
                            , G.IDFILIAL
                       FROM CATAL.REPRESENTANTES R
                          , CATAL.GERENTES G
                          , CATAL.MEI M
                          , ( SELECT V.IDREPRESENTANTE
                                    , COUNT(DISTINCT RL.IDVENDEDORA) QTD
                              FROM ROMAN.REGISTROSLOGINMINHASACOLA RL
                                 , CATAL.VENDEDORAS V
                              WHERE V.IDVENDEDORA = RL.IDVENDEDORA
                                AND ( :P621_TIPOPESQUISA = 'T'
                                  OR ( :P621_TIPOPESQUISA = 'F' and RL.IDFILIAL = :P621_IDFILIAL )
                                  OR ( :P621_TIPOPESQUISA = 'G' and RL.IDFILIAL in ( select idfilial 
                                                                                    from filtrosfiliais ff
                                                                                    Where ff.usuario = v('APP_USER') ) ) )
                                AND V.ATIVO = 'S'
                                AND RL.IDSEMANA BETWEEN :P621_IDSEMANAINI and :P621_IDSEMANAFIM 
                              GROUP BY V.IDREPRESENTANTE ) USO_APP
                          , ( SELECT NAP.IDREPRESENTANTE
                                   , COUNT(DISTINCT NAP.IDVENDEDORA) QTD
                              FROM ROMAN.ITENSNOTASVENDASAPP ITP
                                 , ROMAN.NOTASVENDASAPP NAP
                                 , ROMAN.NOTASVENDAS NV
                              WHERE ITP.IDNOTAVENDAAPP = NAP.IDNOTAVENDAAPP
                                AND NAP.IDNOTAVENDA    = NV.IDNOTAVENDA
                                AND ITP.QUANTIDADEVENDIDA > 0
                                AND NV.IDSITUACAONOTAVENDA = 3
                                AND ( :P621_TIPOPESQUISA = 'T'
                                   OR ( :P621_TIPOPESQUISA = 'F' and NV.IDFILIAL = :P621_IDFILIAL )
                                   OR ( :P621_TIPOPESQUISA = 'G' and NV.IDFILIAL in ( select idfilial 
                                                                                     from filtrosfiliais ff
                                                                                     Where ff.usuario = v('APP_USER') ) ) )
                              GROUP BY NAP.IDREPRESENTANTE ) USO_VENDAS
                       WHERE R.ATIVO = 'S'
                         AND G.IDGERENTE = R.IDGERENTE
                         AND R.IDPESSOA = M.IDPESSOA(+)
                         and ( :P621_TIPOPESQUISA = 'T'
                            or ( :P621_TIPOPESQUISA = 'F' and G.IDFILIAL = :P621_IDFILIAL )
                            or ( :P621_TIPOPESQUISA = 'G' and G.IDFILIAL in ( select idfilial 
                                                                              from filtrosfiliais ff
                                                                              Where ff.usuario = v('APP_USER') ) ) )
                         AND :P621_FILTRAR = 'S'
                         and :P621_TIPOVISAO = 'R'
                         AND R.IDREPRESENTANTE = USO_APP.IDREPRESENTANTE(+)
                         AND R.IDREPRESENTANTE = USO_VENDAS.IDREPRESENTANTE(+) ) X
                ORDER BY 2
                ```
        }
        layout {
            sequence: 30
            parentRegion: @uso
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P621_TIPOVISAO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5822433629561678915
        }

