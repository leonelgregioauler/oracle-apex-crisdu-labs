page 749 (
    name: VerFoto
    alias: VERFOTO
    title: Visualiza Foto
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        width: 36%
        height: 80%
    }
    css {
        inline:
            ```css
            .t-Cards-item {
                border-radius: 14px;
                box-shadow: 0 4px 18px rgba(0,0,0,.15);
                overflow: hidden;
                background: #fff;
            }
            
            .t-Cards-item:hover {
                transform: scale(1.01);
                transition: .2s ease;
            }
            
            .t-Cards-media img {
                border-radius: 12px;
            }
            
            .t-Dialog-body {
                padding: 20px;
                background: #f8f9fa;
            }
            
            .card-media-custom {
              width: 600px;
              height: 600px;
              overflow: hidden;
              border-radius: 16px 16px 0 0;
            }
            
            .card-media-custom img {
              width: 100%;
              height: 100%;
              object-fit: fit;
            }
            #R42753404620785411_Cards {
                display: flex;
                flex-wrap: wrap; 
                gap: 10px;
            }
            
            #R42753404620785411_Cards .a-CardView-item {
                width: 600PX !important;
            }
            ```
    }

    region new (
        name: New
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 SELECT 
                    TRIM(column_value) fotosdiretorio -- link_foto
                FROM fotosanalisecreditopy f,
                     XMLTABLE(('"' || REPLACE(f.fotosdiretorio,';','","') || '"'))
                WHERE f.IDFOTOSANALISECREDITOPY = :P749_IDFOTO;
                
                ```
            pageItemsToSubmit: P749_IDFOTO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
                t-CardsRegion--styleC
                t-Form--stretchInputs
                t-Region-orderBy--center
                margin-left-md
            ]
        }
        media {
            advancedFormatting: true
            htmlExpression:
                ```html
                <div class="card-media-custom">
                <img src="&FOTOSDIRETORIO." alt="Imagem" />
                </div>
                ```
        }
    )

    pageItem P749_IDFOTO (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

)

