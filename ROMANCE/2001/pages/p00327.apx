page 327 (
    name: Relatório de Defeitos
    title: Relatório de Defeitos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region agrupado-por-distribuidor (
        name: Agrupado por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idrepresentante
                     , distribuidor
                     , IDSEMANA    
                     , semana
                     --
                     , sum(defeitosdist) defeitosdist
                     , sum(vlrdefeitosdist) vlrdefeitosdist
                     --
                     , sum(qtdpago) qtdpago
                     , sum(vlrpago) vlrpago
                     --
                     , sum(qtdnaocobrado) qtdnaocobrado
                     , sum(vlrnaocobrado) vlrnaocobrado
                     --
                     , sum(defeitosdist - qtdpago - qtdnaocobrado) saldoqtd
                     , case
                         when  sum(vlrdefeitosdist - vlrnaocobrado - vlrpago) < 0 then
                           0
                       else
                         sum(vlrdefeitosdist - vlrnaocobrado - vlrpago)
                       end saldo
                     --              
                     , '-' s1
                     , '-' s2
                     , '=' s3
                from( select dd.idrepresentante
                           , pck_romance.fnc_nomerepresentante(dd.idrepresentante) distribuidor
                           , dd.semana
                           , dd.idsemana
                           -- qtd/valor total distribuidores
                           , nvl(( select sum((nvl(ii.qtd_pp,0)
                                              +nvl(ii.qtd_p,0)
                                              +nvl(ii.qtd_m,0)
                                              +nvl(ii.qtd_g,0)
                                              +nvl(ii.qtd_gg,0)
                                              +nvl(ii.qtd_egg,0)
                                              +nvl(ii.qtd_exgg,0)
                                              +nvl(ii.qtd_u,0))) qtd
                                   from itensdevolucaorepres ii
                                   where ii.iddevolucaorepres = dd.iddevolucaorepres 
                                     and ii.iddefeito         is not null
                                     and ii.origemdefeito     = 'R'),0) defeitosdist
                           , nvl(( select case
                                            when :P0_IDFILIAL not in (1095,1111,1121,1094,1109,1129,1194,1081,1108,1041) then
                                              sum( ((( nvl(ii.qtd_pp,0)
                                                      + nvl(ii.qtd_p,0)
                                                      + nvl(ii.qtd_m,0)
                                                      + nvl(ii.qtd_g,0)
                                                      + nvl(ii.qtd_gg,0)
                                                      + nvl(ii.qtd_egg,0)
                                                      + nvl(ii.qtd_exgg,0)
                                                      + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.6,1))
                                                   - 
                                                   ((( nvl(ii.qtd_pp,0)
                                                      + nvl(ii.qtd_p,0)
                                                      + nvl(ii.qtd_m,0)
                                                      + nvl(ii.qtd_g,0)
                                                      + nvl(ii.qtd_gg,0)
                                                      + nvl(ii.qtd_egg,0)
                                                      + nvl(ii.qtd_exgg,0)
                                                      + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.6,1))*nvl((select c.percpromotor
                                                                                                                                 from comissoesfiliais c
                                                                                                                                    , fechamentorepresentantes fe
                                                                                                                                 where fe.idrepresentante = dd.idrepresentante
                                                                                                                                   and fe.semana          = dd.semana
                                                                                                                                   and c.idcomissaofilial = fe.idcomissao
                                                                                                                                   and rownum = 1)/100,0.2))
                                            when :P0_IDFILIAL in (1095,1111,1121,1094,1109,1129,1194,1081,1108,1041) then
                                              sum( ((( nvl(ii.qtd_pp,0)
                                                      + nvl(ii.qtd_p,0)
                                                      + nvl(ii.qtd_m,0)
                                                      + nvl(ii.qtd_g,0)
                                                      + nvl(ii.qtd_gg,0)
                                                      + nvl(ii.qtd_egg,0)
                                                      + nvl(ii.qtd_exgg,0)
                                                      + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.7,1))
                                                   - 
                                                   ((( nvl(ii.qtd_pp,0)
                                                      + nvl(ii.qtd_p,0)
                                                      + nvl(ii.qtd_m,0)
                                                      + nvl(ii.qtd_g,0)
                                                      + nvl(ii.qtd_gg,0)
                                                      + nvl(ii.qtd_egg,0)
                                                      + nvl(ii.qtd_exgg,0)
                                                      + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.7,1))*nvl((select c.percpromotor
                                                                                                                                 from comissoesfiliais c
                                                                                                                                    , fechamentorepresentantes fe
                                                                                                                                 where fe.idrepresentante = dd.idrepresentante
                                                                                                                                   and fe.semana          = dd.semana
                                                                                                                                   and c.idcomissaofilial = fe.idcomissao
                                                                                                                                   and rownum = 1)/100,0.2))
                                          end qtd
                                   from itensdevolucaorepres ii
                                   where ii.iddevolucaorepres = dd.iddevolucaorepres 
                                     and ii.iddefeito         is not null
                                     and ii.origemdefeito     = 'R'),0) vlrdefeitosdist
                           -- qtd/valor pago distribuidores
                           , nvl(( select sum(nvl(ii.qtd_pp,0)
                                             +nvl(ii.qtd_p,0)
                                             +nvl(ii.qtd_m,0)
                                             +nvl(ii.qtd_g,0)
                                             +nvl(ii.qtd_gg,0)
                                             +nvl(ii.qtd_egg,0)
                                             +nvl(ii.qtd_exgg,0)
                                             +nvl(ii.qtd_u,0)) qtd
                                   from itensdevolucaorepres ii
                                      , fechamentorepresentantes f
                                   where ii.idfechamentoreprespago = f.idfechamentorepres
                                     and f.idrepresentante         = dd.idrepresentante
                                     and ii.origemdefeito          = 'R'
                                     and ii.iddefeito              is not null
                                     and ii.situacaodefeito        = 'P'
                                     and ii.iddevolucaorepres      = dd.iddevolucaorepres
                                 ),0) qtdpago
                           , nvl(( select sum(ii.valorcobrado) qtd
                                   from itensdevolucaorepres ii
                                   where ii.idfechamentoreprespago is not null
                                     and ii.origemdefeito          = 'R'
                                     and ii.situacaodefeito        = 'P'
                                     and ii.iddefeito         is not null
                                     and ii.iddevolucaorepres      = dd.iddevolucaorepres 
                                 ),0) vlrpago
                           , nvl(( select sum(nvl(ii.qtd_pp,0)
                                             +nvl(ii.qtd_p,0)
                                             +nvl(ii.qtd_m,0)
                                             +nvl(ii.qtd_g,0)
                                             +nvl(ii.qtd_gg,0)
                                             +nvl(ii.qtd_egg,0)
                                             +nvl(ii.qtd_exgg,0)
                                             +nvl(ii.qtd_u,0)) qtd
                                   from itensdevolucaorepres ii
                                   where ii.origemdefeito          = 'R'
                                     and ii.situacaodefeito        = 'D'
                                     and ii.iddevolucaorepres      = dd.iddevolucaorepres 
                                 ),0) qtdnaocobrado
                           , nvl(( select case
                                            when :P0_IDFILIAL not in (1095,1111,1121,1094,1109,1129,1194,1081,1108,1041) then
                                              sum( ((( nvl(ii.qtd_pp,0)
                                                      + nvl(ii.qtd_p,0)
                                                      + nvl(ii.qtd_m,0)
                                                      + nvl(ii.qtd_g,0)
                                                      + nvl(ii.qtd_gg,0)
                                                      + nvl(ii.qtd_egg,0)
                                                      + nvl(ii.qtd_exgg,0)
                                                      + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.6,1))
                                                   - 
                                                   ((( nvl(ii.qtd_pp,0)
                                                      + nvl(ii.qtd_p,0)
                                                      + nvl(ii.qtd_m,0)
                                                      + nvl(ii.qtd_g,0)
                                                      + nvl(ii.qtd_gg,0)
                                                      + nvl(ii.qtd_egg,0)
                                                      + nvl(ii.qtd_exgg,0)
                                                      + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.6,1))*nvl((select c.percpromotor
                                                                                                                                 from comissoesfiliais c
                                                                                                                                    , fechamentorepresentantes fe
                                                                                                                                 where fe.idrepresentante = dd.idrepresentante
                                                                                                                                   and fe.semana          = dd.semana
                                                                                                                                   and c.idcomissaofilial = fe.idcomissao
                                                                                                                                   and rownum = 1)/100,0.2))
                                            when :P0_IDFILIAL in (1095,1111,1121,1094,1109,1129,1194,1081,1108,1041) then
                                              sum( ((( nvl(ii.qtd_pp,0)
                                                      + nvl(ii.qtd_p,0)
                                                      + nvl(ii.qtd_m,0)
                                                      + nvl(ii.qtd_g,0)
                                                      + nvl(ii.qtd_gg,0)
                                                      + nvl(ii.qtd_egg,0)
                                                      + nvl(ii.qtd_exgg,0)
                                                      + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.7,1))
                                                   - 
                                                   ((( nvl(ii.qtd_pp,0)
                                                      + nvl(ii.qtd_p,0)
                                                      + nvl(ii.qtd_m,0)
                                                      + nvl(ii.qtd_g,0)
                                                      + nvl(ii.qtd_gg,0)
                                                      + nvl(ii.qtd_egg,0)
                                                      + nvl(ii.qtd_exgg,0)
                                                      + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.7,1))*nvl((select c.percpromotor
                                                                                                                                 from comissoesfiliais c
                                                                                                                                    , fechamentorepresentantes fe
                                                                                                                                 where fe.idrepresentante = dd.idrepresentante
                                                                                                                                   and fe.semana          = dd.semana
                                                                                                                                   and c.idcomissaofilial = fe.idcomissao
                                                                                                                                   and rownum = 1)/100,0.2))
                                          end qtd
                                   from itensdevolucaorepres ii
                                   where ii.iddevolucaorepres = dd.iddevolucaorepres 
                                     and ii.origemdefeito     = 'R'
                                     and ii.iddefeito         is not null
                                     and ii.situacaodefeito   = 'D'),0) vlrnaocobrado
                           -- qtd/valor total defeitos fornecedores
                           -- devoluções
                           , nvl(( select sum(nvl(ii.qtd_pp,0)
                                             +nvl(ii.qtd_p,0)
                                             +nvl(ii.qtd_m,0)
                                             +nvl(ii.qtd_g,0)
                                             +nvl(ii.qtd_gg,0)
                                             +nvl(ii.qtd_egg,0)
                                             +nvl(ii.qtd_exgg,0)
                                             +nvl(ii.qtd_u,0)) qtd
                                   from itensdevolucaorepres ii
                                   where ii.iddevolucaorepres = dd.iddevolucaorepres 
                                     and ii.iddefeito         is not null
                                     and ii.origemdefeito     = 'F'),0)  defeitosforn
                           -- devoluções
                           , nvl(( select sum((nvl(ii.qtd_pp,0)
                                              +nvl(ii.qtd_p,0)
                                              +nvl(ii.qtd_m,0)
                                              +nvl(ii.qtd_g,0)
                                              +nvl(ii.qtd_gg,0)
                                              +nvl(ii.qtd_egg,0)
                                              +nvl(ii.qtd_exgg,0)
                                              +nvl(ii.qtd_u,0))*ii.valorproduto) qtd
                                   from itensdevolucaorepres ii
                                   where ii.iddevolucaorepres = dd.iddevolucaorepres 
                                     and ii.iddefeito         is not null
                                     and ii.origemdefeito     = 'F'),0)  vlrdefeitosforn
                      from devolucoesrepresentantes dd
                      where dd.idsemana >= 668
                        and :P327_FILTRAR = 'S'
                        and ( :P327_IDREPRESENTANTE is null or dd.idrepresentante = :P327_IDREPRESENTANTE )
                        and dd.idfilial = :P0_IDFILIAL
                        and exists ( select 1
                                     from representantes r
                                     where r.idrepresentante = dd.idrepresentante
                                       and r.ativo           = 'S' )
                        and ( pck_util.fnc_verificaacesso(pidaplicacao => 2407,pusuario =>  v('APP_USER')) = 'S' or dd.idfilial = :P0_IDFILIAL ) ) vw
                group by idrepresentante
                       , distribuidor
                       , semana
                       , idsemana
                order by distribuidor , idsemana
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
