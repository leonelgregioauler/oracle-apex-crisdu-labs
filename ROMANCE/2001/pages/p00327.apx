    region agrupado-por-semana (
        name: Agrupado por Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfilial
                     , nomefilial
                     , IDSEMANA    
                     , semana
                     --
                     , sum(defeitosdist) defeitosdist
                     , sum(vlrdefeitosdist) vlrdefeitosdist
                     --
                     , sum(qtdpago) qtdpago
                     , sum(vlrpago) vlrpago
                     --
                     , sum(defeitosdist - qtdpago) saldoqtd
                     , sum(vlrdefeitosdist - vlrpago) saldo
                     --
                     , sum(defeitosforn) 
                           -- recebimento notas fiscais 
                            + nvl((select  sum((nvl(d.qtd_pp,0)
                                               +nvl(d.qtd_p,0)
                                               +nvl(d.qtd_m,0)
                                               +nvl(d.qtd_g,0)
                                               +nvl(d.qtd_gg,0)
                                               +nvl(d.qtd_egg,0)
                                               +nvl(d.qtd_exgg,0)
                                               +nvl(d.qtd_u,0))) qtdtotal
                                   from defeitosfornecedores d          
                                   where d.idsemana = vw.idsemana
                                     and d.idfilial = vw.idfilial ),0) defeitosforn
                     , sum(vlrdefeitosforn) 
                           -- recebimento notas fiscais 
                            + nvl((select  sum((nvl(d.qtd_pp,0)
                                               +nvl(d.qtd_p,0)
                                               +nvl(d.qtd_m,0)
                                               +nvl(d.qtd_g,0)
                                               +nvl(d.qtd_gg,0)
                                               +nvl(d.qtd_egg,0)
                                               +nvl(d.qtd_exgg,0)
                                               +nvl(d.qtd_u,0))*d.valorvenda) qtdtotal
                                   from defeitosfornecedores d          
                                   where d.idsemana = vw.idsemana
                                     and d.idfilial = vw.idfilial ),0) vlrdefeitosforn
                from( select dd.idfilial
                           , pck_romance.fnc_nomefilial(dd.idfilial) nomefilial
                           , dd.semana
                           , dd.idsemana
                           -- qtd/valor total distribuidores
                           , nvl(( select sum((nvl(ii.qtd_pp,0)
                                              +nvl(ii.qtd_p,0)
                                              +nvl(ii.qtd_m,0)
                                              +nvl(ii.qtd_g,0)
                                              +nvl(ii.qtd_gg,0)
                                              +nvl(ii.qtd_egg,0)
                                              +nvl(ii.qtd_exgg,0)
                                              +nvl(ii.qtd_u,0))) qtd
                                   from itensdevolucaorepres ii
                                   where ii.iddevolucaorepres = dd.iddevolucaorepres 
                                     and ii.origemdefeito     = 'R'),0) defeitosdist
                           , nvl(( select case
                                            when :P0_IDFILIAL not in (1095,1111,1121,1094,1109,1129,1194,1081,1108,1041) then
                                              sum( ((( nvl(ii.qtd_pp,0)
                                                      + nvl(ii.qtd_p,0)
                                                      + nvl(ii.qtd_m,0)
                                                      + nvl(ii.qtd_g,0)
                                                      + nvl(ii.qtd_gg,0)
                                                      + nvl(ii.qtd_egg,0)
                                                      + nvl(ii.qtd_exgg,0)
                                                      + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.6,1))
                                                   - 
                                                   ((( nvl(ii.qtd_pp,0)
                                                      + nvl(ii.qtd_p,0)
                                                      + nvl(ii.qtd_m,0)
                                                      + nvl(ii.qtd_g,0)
                                                      + nvl(ii.qtd_gg,0)
                                                      + nvl(ii.qtd_egg,0)
                                                      + nvl(ii.qtd_exgg,0)
                                                      + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.6,1))*nvl((select c.percpromotor
                                                                                                                                 from comissoesfiliais c
                                                                                                                                    , fechamentorepresentantes fe
                                                                                                                                 where fe.idrepresentante = dd.idrepresentante
                                                                                                                                   and fe.semana          = dd.semana
                                                                                                                                   and c.idcomissaofilial = fe.idcomissao
                                                                                                                                   and rownum = 1)/100,0.2))
                                            when :P0_IDFILIAL in (1095,1111,1121,1094,1109,1129,1194,1081,1108,1041) then
                                              sum( ((( nvl(ii.qtd_pp,0)
                                                      + nvl(ii.qtd_p,0)
                                                      + nvl(ii.qtd_m,0)
                                                      + nvl(ii.qtd_g,0)
                                                      + nvl(ii.qtd_gg,0)
                                                      + nvl(ii.qtd_egg,0)
                                                      + nvl(ii.qtd_exgg,0)
                                                      + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.7,1))
                                                   - 
                                                   ((( nvl(ii.qtd_pp,0)
                                                      + nvl(ii.qtd_p,0)
                                                      + nvl(ii.qtd_m,0)
                                                      + nvl(ii.qtd_g,0)
                                                      + nvl(ii.qtd_gg,0)
                                                      + nvl(ii.qtd_egg,0)
                                                      + nvl(ii.qtd_exgg,0)
                                                      + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.7,1))*nvl((select c.percpromotor
                                                                                                                                 from comissoesfiliais c
                                                                                                                                    , fechamentorepresentantes fe
                                                                                                                                 where fe.idrepresentante = dd.idrepresentante
                                                                                                                                   and fe.semana          = dd.semana
                                                                                                                                   and c.idcomissaofilial = fe.idcomissao
                                                                                                                                   and rownum = 1)/100,0.2))
                                          end qtd
                                   from itensdevolucaorepres ii
                                   where ii.iddevolucaorepres = dd.iddevolucaorepres 
                                     and ii.origemdefeito     = 'R'),0) vlrdefeitosdist
                           -- qtd/valor pago distribuidores
                           , nvl(( select sum(nvl(ii.qtd_pp,0)
                                             +nvl(ii.qtd_p,0)
                                             +nvl(ii.qtd_m,0)
                                             +nvl(ii.qtd_g,0)
                                             +nvl(ii.qtd_gg,0)
                                             +nvl(ii.qtd_egg,0)
                                             +nvl(ii.qtd_exgg,0)
                                             +nvl(ii.qtd_u,0)) qtd
                                   from itensdevolucaorepres ii
                                      , fechamentorepresentantes f
                                   where ii.idfechamentoreprespago = f.idfechamentorepres
                                     and f.idrepresentante         = dd.idrepresentante
                                     and ii.origemdefeito          = 'R'
                                     and ii.iddevolucaorepres      = dd.iddevolucaorepres
                                 ),0) qtdpago
                           , nvl(( select sum(ii.valorcobrado) qtd
                                   from itensdevolucaorepres ii
                                   where ii.idfechamentoreprespago is not null
                                     and ii.origemdefeito          = 'R'
                                     and ii.iddevolucaorepres      = dd.iddevolucaorepres 
                                 ),0) vlrpago
                           -- qtd/valor total defeitos fornecedores
                           -- devoluções
                           , nvl(( select sum(nvl(ii.qtd_pp,0)
                                             +nvl(ii.qtd_p,0)
                                             +nvl(ii.qtd_m,0)
                                             +nvl(ii.qtd_g,0)
                                             +nvl(ii.qtd_gg,0)
                                             +nvl(ii.qtd_egg,0)
                                             +nvl(ii.qtd_exgg,0)
                                             +nvl(ii.qtd_u,0)) qtd
                                   from itensdevolucaorepres ii
                                   where ii.iddevolucaorepres = dd.iddevolucaorepres 
                                     and ii.origemdefeito     = 'F'),0)  defeitosforn
                           -- devoluções
                           , nvl(( select sum((nvl(ii.qtd_pp,0)
                                              +nvl(ii.qtd_p,0)
                                              +nvl(ii.qtd_m,0)
                                              +nvl(ii.qtd_g,0)
                                              +nvl(ii.qtd_gg,0)
                                              +nvl(ii.qtd_egg,0)
                                              +nvl(ii.qtd_exgg,0)
                                              +nvl(ii.qtd_u,0))*ii.valorproduto) qtd
                                   from itensdevolucaorepres ii
                                   where ii.iddevolucaorepres = dd.iddevolucaorepres 
                                     and ii.origemdefeito     = 'F'),0)  vlrdefeitosforn
                      from devolucoesrepresentantes dd
                      where dd.idsemana >= 668
                        and :P327_FILTRAR = 'S'
                        and ( :P327_TIPOPESQUISA = 'T'
                            or ( :P327_TIPOPESQUISA = 'D' and dd.idrepresentante = :P327_IDREPRESENTANTE ) )
                        and ( pck_util.fnc_verificaacesso(pidaplicacao => 2407,pusuario =>  v('APP_USER')) = 'S' or dd.idfilial = :P0_IDFILIAL ) ) vw
                group by idfilial
                       , nomefilial
                       , semana
                       , idsemana
                order by idsemana
                ```
        }
