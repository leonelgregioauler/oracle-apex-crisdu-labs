    dynamicAction tipo-pesquisa-distribuidor (
        name: Tipo Pesquisa Distribuidor
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P327_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P327_TIPOPESQUISA
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P327_IDREPRESENTANTE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P327_IDREPRESENTANTE
            }
            execution {
                sequence: 10
            }
        )

    )

    validation escolha-da-semana (
        name: Escolha da semana
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P327_SEMANAINICIO > :P327_SEMANAFIM
                ```
        }
        error {
            errorMessage: Por favor, verifique as semanas selecionadas!
        }
    )

    branch (
        name: Go To Page 327
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 327
                items: {
                    P327_ORIGEMDEFEITO: &P327_ORIGEMDEFEITO.
                    P327_SEMANAINICIO: &P327_SEMANAINICIO.
                    P327_SEMANAFIM: &P327_SEMANAFIM.
                    P327_TIPOPESQUISA: &P327_TIPOPESQUISA.
                    P327_IDREPRESENTANTE: &P327_IDREPRESENTANTE.
                    P327_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

