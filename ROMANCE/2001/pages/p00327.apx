    region defeitos-gerados-para-resgate (
        name: Defeitos Gerados para Resgate
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana
                     , pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                     , defeito
                     , iddefeito
                     , sum(qtdtotal) qtdtotal
                     , sum(vlrtotalpagar) vlrtotalpagar
                     , sum(valoraserdescontado) valoraserdescontado
                from (   select pck_util.fnc_semanaid(dr.idsemana) semana
                             , idrepresentante
                             , (select dd.descricao
                                from defeitos dd
                                where dd.iddefeito = i.iddefeito) defeito
                             , iddefeito
                             , sum((nvl(i.qtd_pp,0)
                                   +nvl(i.qtd_p,0)
                                   +nvl(i.qtd_m,0)
                                   +nvl(i.qtd_g,0)
                                   +nvl(i.qtd_gg,0)
                                   +nvl(i.qtd_egg,0)
                                   +nvl(i.qtd_exgg,0)
                                   +nvl(i.qtd_u,0))) qtdtotal
                             , sum( ( nvl(i.qtd_pp,0)
                                    + nvl(i.qtd_p,0)
                                    + nvl(i.qtd_m,0)
                                    + nvl(i.qtd_g,0)
                                    + nvl(i.qtd_gg,0)
                                    + nvl(i.qtd_egg,0)
                                    + nvl(i.qtd_exgg,0)
                                    + nvl(i.qtd_u,0) ) * i.valorproduto) vlrtotalpagar
                             , case
                                 when :P0_IDFILIAL not in (1095,1111,1121,1094,1109,1129,1194,1081,1108,1041) then
                                   sum( ((( nvl(i.qtd_pp,0)
                                          + nvl(i.qtd_p,0)
                                          + nvl(i.qtd_m,0)
                                          + nvl(i.qtd_g,0)
                                          + nvl(i.qtd_gg,0)
                                          + nvl(i.qtd_egg,0)
                                          + nvl(i.qtd_exgg,0)
                                          + nvl(i.qtd_u,0) ) * i.valorproduto )*decode(i.comissao,'S',0.6,1))
                                       - 
                                       ((( nvl(i.qtd_pp,0)
                                          + nvl(i.qtd_p,0)
                                          + nvl(i.qtd_m,0)
                                          + nvl(i.qtd_g,0)
                                          + nvl(i.qtd_gg,0)
                                          + nvl(i.qtd_egg,0)
                                          + nvl(i.qtd_exgg,0)
                                          + nvl(i.qtd_u,0) ) * i.valorproduto )*decode(i.comissao,'S',0.6,1))*0.18)
                                 when :P0_IDFILIAL in (1095,1111,1121,1094,1109,1129,1194,1081,1108,1041) then
                                   sum( ((( nvl(i.qtd_pp,0)
                                          + nvl(i.qtd_p,0)
                                          + nvl(i.qtd_m,0)
                                          + nvl(i.qtd_g,0)
                                          + nvl(i.qtd_gg,0)
                                          + nvl(i.qtd_egg,0)
                                          + nvl(i.qtd_exgg,0)
                                          + nvl(i.qtd_u,0) ) * i.valorproduto )*decode(i.comissao,'S',0.7,1))
                                       - 
                                       ((( nvl(i.qtd_pp,0)
                                          + nvl(i.qtd_p,0)
                                          + nvl(i.qtd_m,0)
                                          + nvl(i.qtd_g,0)
                                          + nvl(i.qtd_gg,0)
                                          + nvl(i.qtd_egg,0)
                                          + nvl(i.qtd_exgg,0)
                                          + nvl(i.qtd_u,0) ) * i.valorproduto )*decode(i.comissao,'S',0.7,1))*0.18)
                               end valoraserdescontado
                        from itensdevolucaorepres i
                           , devolucoesrepresentantes dr
                        where dr.iddevolucaorepres = i.iddevolucaorepres
                          and dr.idfilial = :P0_IDFILIAL
                          and i.iddefeito is not null
                          and ( :P327_TIPOPESQUISA = 'T'
                              or ( :P327_TIPOPESQUISA = 'D' and dr.idrepresentante = :P327_IDREPRESENTANTE ) )
                          and i.origemdefeito = :P327_ORIGEMDEFEITO 
                          and dr.idsemana between :P327_SEMANAINICIO and :P327_SEMANAFIM 
                          and dr.idsemana >= 668  --30/2017
                        group by i.iddefeito , dr.idsemana, idrepresentante
                        union
                        select pck_util.fnc_semanaid(d.idsemana) semana
                             , null
                             , (select dd.descricao
                                from defeitos dd
                                where dd.iddefeito = d.iddefeito) defeito
                             , iddefeito 
                             , sum(( nvl(d.qtd_pp,0)
                                   + nvl(d.qtd_p,0)
                                   + nvl(d.qtd_m,0)
                                   + nvl(d.qtd_g,0)
                                   + nvl(d.qtd_gg,0)
                                   + nvl(d.qtd_egg,0)
                                   + nvl(d.qtd_exgg,0)
                                   + nvl(d.qtd_u,0) ) ) qtdtotal
                             , sum( ( nvl(d.qtd_pp,0)
                                    + nvl(d.qtd_p,0)
                                    + nvl(d.qtd_m,0)
                                    + nvl(d.qtd_g,0)
                                    + nvl(d.qtd_gg,0)
                                    + nvl(d.qtd_egg,0)
                                    + nvl(d.qtd_exgg,0)
                                    + nvl(d.qtd_u,0)  ) * d.valorvenda) vlrtotalpagar
                             , null valoraserdescontado
                        from defeitosfornecedores d
                        where :P327_ORIGEMDEFEITO  = 'F'
                          and ( :P327_SEMANAINICIO is null or idsemana between :P327_SEMANAINICIO and :P327_SEMANAFIM )
                          and d.idfilial = :P0_IDFILIAL
                          and d.idsemana >= 668  --30/2017
                        group by d.idsemana , d.iddefeito )
                group by semana
                     , defeito
                     , iddefeito
                     , idrepresentante
                ```
        }
        layout {
            sequence: 20
            parentRegion: @filtros-2
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
