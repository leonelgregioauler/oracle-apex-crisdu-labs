    region defeitos-resgatados (
        name: Defeitos Resgatados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.semana semana
                     , pck_romance.fnc_nomerepresentante(f.idrepresentante) distribuidor
                     , (select d.descricao
                        from defeitos d
                        where d.iddefeito = i.iddefeito) defeito
                     , sum((nvl(i.qtd_pp,0)
                           +nvl(i.qtd_p,0)
                           +nvl(i.qtd_m,0)
                           +nvl(i.qtd_g,0)
                           +nvl(i.qtd_gg,0)
                           +nvl(i.qtd_egg,0)
                           +nvl(i.qtd_exgg,0)
                           +nvl(i.qtd_u,0))) qtdtotal
                     , sum(valorcobrado) valordescontado
                from itensdevolucaorepres i
                   , fechamentorepresentantes f
                where i.iddefeito is not null
                  and i.idfechamentoreprespago = f.idfechamentorepres
                  and ( :P327_TIPOPESQUISA = 'T'
                      or ( :P327_TIPOPESQUISA = 'D' and f.idrepresentante = :P327_IDREPRESENTANTE ) )
                  and exists ( select 1
                               from devolucoesrepresentantes dr
                               where dr.iddevolucaorepres = i.iddevolucaorepres
                                 and dr.idfilial = :P0_IDFILIAL )
                  and pck_util.fnc_idsemana(f.semana) between :P327_SEMANAINICIO and :P327_SEMANAFIM 
                  and pck_util.fnc_idsemana(f.semana) >= 668
                group by i.iddefeito , semana , idrepresentante
                ```
        }
        layout {
            sequence: 30
            parentRegion: @filtros-2
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum defeito resgatado
        }
        advanced {
            savedReportMappingIdentifier: 573650413242901717
        }

