        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00')||'/'||ano) d
                     , s.idsemana r
                from semana_dias s
                where s.idsemana between 668 and pck_util.fnc_idsemanadata(sysdate)
                order by idsemana 
