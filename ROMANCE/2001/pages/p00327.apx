    region agrupados-por-fornecedor (
        name: Agrupados por Fornecedor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.semana
                     , pck_romance.fnc_nomefornecedor(f.idfornecedor) fornecedor
                     , pck_romance.fnc_nomeproduto(i.idproduto) produto
                     , sum((nvl(i.qtd_pp,0)
                           +nvl(i.qtd_p,0)
                           +nvl(i.qtd_m,0)
                           +nvl(i.qtd_g,0)
                           +nvl(i.qtd_gg,0)
                           +nvl(i.qtd_egg,0)
                           +nvl(i.qtd_exgg,0)
                           +nvl(i.qtd_u,0))) qtdtotal
                     , sum((nvl(i.qtd_pp,0)
                           +nvl(i.qtd_p,0)
                           +nvl(i.qtd_m,0)
                           +nvl(i.qtd_g,0)
                           +nvl(i.qtd_gg,0)
                           +nvl(i.qtd_egg,0)
                           +nvl(i.qtd_exgg,0)
                           +nvl(i.qtd_u,0))*f.precocusto) totaldefeito
                from devolucoesrepresentantes d
                   , itensdevolucaorepres i
                   , fornecedoresprodutos f
                   , defeitos df
                where d.iddevolucaorepres = i.iddevolucaorepres
                  and ( :P327_TIPOPESQUISA = 'T' 
                      or ( :P327_TIPOPESQUISA = 'D' and d.idrepresentante = :P327_IDREPRESENTANTE ) )
                  and f.idproduto         = i.idproduto
                  and df.iddefeito        = i.iddefeito
                  and df.origemdefeito    = 'F'
                  and i.idsemana          >= 668
                  and ( pck_util.fnc_verificaacesso(pidaplicacao => 2407,pusuario =>  v('APP_USER')) = 'S' or d.idfilial = :P0_IDFILIAL ) 
                  and :P327_FILTRAR = 'S'
                group by f.idfornecedor
                       , d.semana
                       , i.idproduto;
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
