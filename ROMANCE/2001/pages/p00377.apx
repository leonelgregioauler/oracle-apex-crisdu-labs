page 377 (
    name: Analise de Comissão Distribuidor
    title: Analise de Comissão Distribuidor
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region itens-que-deram-comissões (
        name: Itens que Deram Comissões
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select it.nomeproduto
                     , it.valorapagar
                     , it.perccomissaodistribuidor
                     , it.valorcomissaodistribuidor 
                from favorita.vw_itenspedidos_fav it
                where it.idpedido = :P377_IDPEDIDO
                  and it.ididioma = 1
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <b><font color="green">Pedidos em nome de Distribuidores, não geram comissão, devido o valor a pagar já possuir o desconto da comissão!</b></font>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1419554741712451935
        }

        column NOMEPRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column PERCCOMISSAODISTRIBUIDOR (
            type: plainText
            heading {
                heading: % da Comissão Distribuidor
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column VALORAPAGAR (
            type: plainText
            heading {
                heading: Valor a Pagar
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column VALORCOMISSAODISTRIBUIDOR (
            type: plainText
            heading {
                heading: Valor Comissão Distribuidor
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        savedReport 14197772 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn NOMEPRODUTO (
                sequence: 1
            )

            displayColumn PERCCOMISSAODISTRIBUIDOR (
                sequence: 3
            )

            displayColumn VALORAPAGAR (
                sequence: 2
            )

            displayColumn VALORCOMISSAODISTRIBUIDOR (
                sequence: 4
            )

            aggregate (
                column: VALORCOMISSAODISTRIBUIDOR
            )

            aggregate (
                column: VALORAPAGAR
            )

        )

    )

    pageItem P377_IDPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @itens-que-deram-comissões
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

