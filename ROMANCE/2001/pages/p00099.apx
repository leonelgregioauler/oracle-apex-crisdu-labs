page 99 (
    name: Evento Finalizado
    title: Evento Finalizado
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutStart
            js-dialog-class-t-Drawer--md
        ]
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region aviso (
        name: Aviso
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from mensagensaviso
                where diadasemana = TO_CHAR(SYSDATE,'D')
                  and TO_CHAR(SYSDATE,'HH24:MI:SS') between horarioini and horariofim
                ```
        }
    )

    region mensagem-de-registros (
        name: Mensagem de Registros
        type: staticContent
        source {
            htmlCode:
                ```html
                <h2 align="middle">Obrigado por registrar o Evento!</h2>
                <h2 align="middle"><br>Vamos atender o mais breve possível.</h2>
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region passo-a-passo (
        name: Passo a Passo
        type: list
        source {
            list: @registrar-evento
        }
        layout {
            sequence: 20
            slot: dialogHeader
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    pageItem P99_MENSAGEM (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @aviso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            customAttributes: readonly
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<h2 align="middle">'||mensagem||'</h2>' mensagem
                from mensagensaviso
                where diadasemana = TO_CHAR(SYSDATE,'D')
                  and TO_CHAR(SYSDATE,'HH24:MI:SS') between horarioini and horariofim
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

