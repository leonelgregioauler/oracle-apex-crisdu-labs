    region pedidos-detalhado (
        name: Pedidos Detalhado
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(p.idrepresentante )  "Representante"
                     , idpedido
                     , 'P'||nrpedido  "Nr Pedido"
                     , 'Call Center' "Origem"
                     , pck_romance.fnc_nomevendedora(p.idvendedora )  "Consultora"
                     , trunc(dtemissao)  "Data Emissão"
                     , dataentrega "Data Entrega"
                     , datavencimento "Data Vencimento"
                     , ( select s.descricao
                         from catal.situacoes s
                         where s.idsituacao = p.situacao ) "Situação Entrega"
                     , p.valortotal  "Valor Revista"
                     , VLRTOTALSEMCOMISSAO "Valor Total"
                     , ( select ( select c.nomecidade ||' - '|| e.sigla from cidades c , estados e where c.idestado = e.idestado and c.idcidade = pv.idcidade )
                        from pessoas        pv 
                       where pv.idpessoa = ( select idpessoa 
                                             from vendedoras     v
                                             where v.idvendedora = p.idvendedora) ) "Cidade Vendedora"
                     , decode(p.tipo, 'P','Pedido'
                                    , 'R','Retirada de Pontos'
                                    , 'B','Brinde'
                                    , 'V','Venda Direta'
                                    , 'T','Troca') "Pedido - Ret. Pontos"
                     , ( select pck_romance.fnc_nomeregiaovenda(r.idregiaovenda) 
                         from regioesvenda r
                         where r.idregiaovenda = (select idregiaovenda 
                                                  from vendedoras v
                                                  where v.idvendedora = p.idvendedora)) "Região de Venda"
                     , decode(p.represetantefezparavend,'S','Sim','Não') "Cli R fez para Cli V"
                     , pck_romance.fnc_cpfvendedora(p.idvendedora) "Cpf"
                     , decode(p.quitadocartao,'S','Com Cartão','N','Com Boleto') "Pedido Feito"
                     ,( select  LISTAGG(( select u.usuario
                                          from usuarios u
                                  where u.idusuario = cp.idusuario)||'-'||favorita.pck_util_fav.fnc_nomecaracteristicapedido(cp.idcaracteristicapedido,1)||'-'||to_char(cp.dataclassificado,'dd/mm/rrrr hh:mm:ss') , '; ') WITHIN GROUP (ORDER BY 1 desc) as Caracteristicas
                        from favorita.classificacoespedidos cp
                        where cp.idpedido = p.idpedido
                          and cp.idcaracteristicapedido in (9,25,26)) as Caracteristicas
                     , null historicos
                     , null "Entregue?"
                from pedidos        p
                where p.controlecancelado is null
                  and p.situacao != 'Z'
                  and p.idfilial          = :P0_IDFILIAL
                  and ( :P187_IDREPRESENTANTE is null or p.idrepresentante = :P187_IDREPRESENTANTE)
                  and ( :P187_TIPODATA = 'E' and trunc(dtemissao) between to_date(:P187_DTINI,'DD/MM/RRRR') and to_date(:P187_DTFIM,'DD/MM/RRRR')
                     or :P187_TIPODATA = 'A' and trunc(p.dataentrega) between to_date(:P187_DTINI,'DD/MM/RRRR') and to_date(:P187_DTFIM,'DD/MM/RRRR') )
                union
                select pck_romance.fnc_nomerepresentante(pp.idrepresentante )  "Representante"
                     , idpedido
                     , to_char(pp.numeropedido ) "Nr Pedido"
                     , ( select ff.nomefilialfavorita
                         from favorita.filiaisfavorita ff
                         where ff.idfilialfavorita = pp.idfilialfavorita ) origem
                     , pck_romance.fnc_nomevendedora(pp.idvendedora )  "Consultora"
                     , trunc(pp.dataemissao)  "Data Emissão"
                     , pp.dataentrega "Data Entrega"
                     , ( select min(datavencimento)
                         from favorita.vencimentospedidos vc
                         where vc.situacaovencimento = 'V'
                           and vc.idpedido           = pp.idpedido ) "Data Vencimento"
                     , favorita.pck_util_fav.fnc_situacaoentrega(pp.idsituacaoentrega,'I',1) situacao
                     , pp.valortotal  "Valor Revista"
                     , pp.valorapagar "Valor Total"
                     , ( select ( select c.nomecidade ||' - '|| e.sigla from cidades c , estados e where c.idestado = e.idestado and c.idcidade = pv.idcidade )
                         from pessoas        pv 
                         where pv.idpessoa = ( select idpessoa 
                                               from vendedoras     v
                                               where v.idvendedora = pp.idvendedora) ) "Cidade Vendedora"
                     , decode(pp.tipopedido, 'P','Pedido'
                                    , 'R','Retirada de Pontos'
                                    , 'B','Brinde'
                                    , 'V','Venda Direta'
                                    , 'F','Paris'
                                    , 'T','Troca') "Pedido - Ret. Pontos"
                     , ( select pck_romance.fnc_nomeregiaovenda(r.idregiaovenda) 
                         from regioesvenda r
                         where r.idregiaovenda = (select idregiaovenda 
                                                  from vendedoras v
                                                  where v.idvendedora = pp.idvendedora)) "Região de Venda"
                     , nvl( ( select w.descricao
                               from favorita.vw_classificacoespedidos_fav w
                               where w.idpedido               = pp.idpedido 
                                 and w.ididioma               = 1
                                 and w.idcaracteristicapedido = 2 ) ,'Não')   "Cli R fez para Cli V"
                     , pck_romance.fnc_cpfvendedora(pp.idvendedora) "Cpf"
                     , ( select w.descricao
                         from favorita.vw_classificacoespedidos_fav w
                         where w.idpedido               = pp.idpedido 
                           and w.ididioma               = 1
                           and w.idcaracteristicapedido = 8 ) "Pedido Feito"
                     , ( select  LISTAGG(( select u.usuario
                                           from usuarios u
                                           where u.idusuario = cp.idusuario)||'-'||favorita.pck_util_fav.fnc_nomecaracteristicapedido(cp.idcaracteristicapedido,1)||'-'||to_char(cp.dataclassificado,'dd/mm/rrrr hh:mm:ss') , '; ') WITHIN GROUP (ORDER BY 1 desc) as Caracteristicas
                         from favorita.classificacoespedidos cp
                         where cp.idpedido = pp.idpedido
                           and cp.idcaracteristicapedido in (9,25,26)) as Caracteristicas
                     , ( select listagg(h.datahistorico||' - '||h.descricao,' / ') within group ( order by 1 desc )
                         from favorita.historicospedidos h
                         where h.idpedido = pp.idpedido
                           and rownum <= 4 ) historicos
                     , case
                         when exists ( select 1
                                       from favorita.classificacoespedidos cp
                                       where cp.idcaracteristicapedido = 76
                                         and cp.idpedido               = pp.idpedido ) then
                           'Sim'
                         when exists ( select 1
                                       from favorita.classificacoespedidos cp
                                       where cp.idcaracteristicapedido = 75
                                         and cp.idpedido               = pp.idpedido ) then
                           'Não'
                         else
                           'Sem Marcação'
                       end entregue
                from favorita.pedidos pp
                where pp.idsituacaoentrega >= 20000
                  and pp.datacancelamento is null
                  and (:P187_IDREPRESENTANTE IS NULL OR pp.idrepresentante = :P187_IDREPRESENTANTE)
                  and pp.idfilialromance  = :P0_IDFILIAL
                  and ( :P187_TIPODATA = 'E' and trunc(pp.dataemissao) between to_date(:P187_DTINI,'DD/MM/RRRR') and to_date(:P187_DTFIM,'DD/MM/RRRR')
                     or :P187_TIPODATA = 'A' and trunc(pp.dataentrega) between to_date(:P187_DTINI,'DD/MM/RRRR') and to_date(:P187_DTFIM,'DD/MM/RRRR') ) 
                  and ( :P187_CONFIRMACAO_ENTREGA = 'A'
                     or ( :P187_CONFIRMACAO_ENTREGA = 'S' and exists ( select 1
                                                                       from favorita.classificacoespedidos cp
                                                                       where cp.idcaracteristicapedido = 76
                                                                         and cp.idpedido               = pp.idpedido ) )
                     or ( :P187_CONFIRMACAO_ENTREGA = 'N' and exists ( select 1
                                                                       from favorita.classificacoespedidos cp
                                                                       where cp.idcaracteristicapedido = 75
                                                                         and cp.idpedido               = pp.idpedido ) ) )
                ORDER BY 1,4
                ```
        }
        layout {
            sequence: 50
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
        reportLayout {
            numberOfRows: 300
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: -
        }
        breakFormatting {
            breakColumns: col1
            style: repeatHeadings
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
            csvSeparator: ;
            linkText: <font size="18">Clique aqui para baixar para Excel</font>
            filename: Pedidos_semana_anterior
        }

