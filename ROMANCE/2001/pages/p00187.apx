    region pedidos-resumido (
        name: Pedidos resumido
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante )  "Representante"
                     , nvl(ped.valorapagar,0) "Valor Total"
                     , nvl(ped.qtd,0) "Qtd Pedidos"
                     , nvl(paris.valorapagar,0) "Valor Total Paris"
                     , nvl(paris.qtd,0) "Qtd Paris"
                     , nvl(ped.valorapagar,0) + nvl(paris.valorapagar,0) "Total"
                     , nvl(ped.qtd,0) + nvl(paris.qtd,0) "QTD Total"
                     , '=' s1
                     , '|' s2
                     , '|' s3
                     , '+' s4
                from representantes r
                   , ( select idrepresentante
                            , sum(pp.valorapagar) valorapagar
                            , sum(pp.valortotal) valortotal
                            , count(1) qtd
                       from favorita.pedidos pp
                       where pp.idsituacaoentrega >= 20000
                         and pp.tipopedido in ('P', 'T', 'V')
                         and pp.valorapagar > 0
                         and not exists ( select 1
                                          from favorita.classificacoespedidos cf
                                          where cf.idcaracteristicapedido = 25
                                            and cf.idpedido               = pp.idpedido )
                         and pp.idfilialromance  = :P0_IDFILIAL
                         and ( :P187_TIPODATA = 'E' and trunc(pp.dataemissao) between to_date(:P187_DTINI,'DD/MM/RRRR') and to_date(:P187_DTFIM,'DD/MM/RRRR')
                            or :P187_TIPODATA = 'A' and trunc(pp.dataentrega) between to_date(:P187_DTINI,'DD/MM/RRRR') and to_date(:P187_DTFIM,'DD/MM/RRRR') )     
                         and ( :P187_CONFIRMACAO_ENTREGA = 'A'
                             or ( :P187_CONFIRMACAO_ENTREGA = 'S' and exists ( select 1
                                                                               from favorita.classificacoespedidos cp
                                                                               where cp.idcaracteristicapedido = 76
                                                                                 and cp.idpedido               = pp.idpedido ) )
                             or ( :P187_CONFIRMACAO_ENTREGA = 'N' and exists ( select 1
                                                                               from favorita.classificacoespedidos cp
                                                                               where cp.idcaracteristicapedido = 75
                                                                                 and cp.idpedido               = pp.idpedido ) ) )
                       group by idrepresentante ) ped
                    , ( select idrepresentante
                            , sum(pp.valorapagar) valorapagar
                            , count(1) qtd
                       from favorita.pedidos pp
                       where pp.idsituacaoentrega >= 20000
                         and pp.tipopedido = 'F'
                         and pp.valorapagar > 0
                         and not exists ( select 1
                                          from favorita.classificacoespedidos cf
                                          where cf.idcaracteristicapedido = 25
                                            and cf.idpedido               = pp.idpedido )
                         and pp.idfilialromance  = :P0_IDFILIAL
                         and ( :P187_TIPODATA = 'E' and trunc(pp.dataemissao) between to_date(:P187_DTINI,'DD/MM/RRRR') and to_date(:P187_DTFIM,'DD/MM/RRRR')
                            or :P187_TIPODATA = 'A' and trunc(pp.dataentrega) between to_date(:P187_DTINI,'DD/MM/RRRR') and to_date(:P187_DTFIM,'DD/MM/RRRR') )     
                         and ( :P187_CONFIRMACAO_ENTREGA = 'A'
                             or ( :P187_CONFIRMACAO_ENTREGA = 'S' and exists ( select 1
                                                                               from favorita.classificacoespedidos cp
                                                                               where cp.idcaracteristicapedido = 76
                                                                                 and cp.idpedido               = pp.idpedido ) )
                             or ( :P187_CONFIRMACAO_ENTREGA = 'N' and exists ( select 1
                                                                               from favorita.classificacoespedidos cp
                                                                               where cp.idcaracteristicapedido = 75
                                                                                 and cp.idpedido               = pp.idpedido ) ) )
                       group by idrepresentante ) paris
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P0_IDFILIAL )
                  and r.ativo = 'S'
                  and r.idrepresentante = ped.idrepresentante(+)
                  and r.idrepresentante = paris.idrepresentante(+)
                ```
        }
        layout {
            sequence: 70
            slot: body-3
        }
