    region consultoras-que-não-tem-pedidos (
        name: Consultoras que não tem Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.numeronota
                     , roman.pck_romance.fnc_nomevendedora(nv.idvendedora) vendedora
                     , roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) representante
                     , roman.pck_romance.fnc_nomeregiaovenda(nv.idregiaovenda) regiaovenda
                     , nv.semanadistribuicao
                     , nv.semanacobranca
                     , nv.dataretorno
                     , nv.valortotalnota
                     , roman.pck_romance.fnc_retornatelefones(nv.idvendedora) telefones
                from roman.notasvendas nv
                where nv.dataretorno between to_date(:P187_DTINI,'DD/MM/RRRR') and to_date(:P187_DTFIM,'DD/MM/RRRR')
                  and nv.idsituacaonotavenda = 3
                  and nv.idrepresentante = :P187_IDREPRESENTANTE
                  and not exists ( select 1
                                   from favorita.vw_pedidostablet_fav p
                                   where p.idvendedora = nv.idvendedora
                                     and p.dataentrega between to_date(:P187_DTINI,'DD/MM/RRRR') and to_date(:P187_DTFIM,'DD/MM/RRRR') )
                ```
        }
        layout {
            sequence: 80
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P187_TIPO = 'D'
                  and :P187_DTINI is not null
                  and :P187_IDREPRESENTANTE is not null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
