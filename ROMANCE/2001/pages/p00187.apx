    pageItem P187_DTFIM (
        type: datePickerJquery
        label {
            label: até
            alignment: left
        }
        layout {
            sequence: 40
            region: @pedidos-feitos
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        validation {
            maxLength: 4000
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v number;
                  d date;
                begin
                
                  select idsemana+1
                  into v
                  from semana_dias
                  where semana = to_number(substr( :P187_SEMANA,1,2))
                    and ano    = substr( :P187_SEMANA,4,4);
                
                  select dt_fim
                  into d
                  from semana_dias
                  where idsemana = v;
                  return d;
                exception
                  when others then
                    return null;
                end;
                
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P187_DTINI (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 30
            region: @pedidos-feitos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        validation {
            maxLength: 4000
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v number;
                  d date;
                begin
                
                  select idsemana+1
                  into v
                  from semana_dias
                  where semana = to_number(substr( :P187_SEMANA,1,2))
                    and ano    = substr( :P187_SEMANA,4,4);
                
                  select dt_ini
                  into d
                  from semana_dias
                  where idsemana = v;
                  return d;
                exception
                  when others then
                    return null;
                end;
                
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P187_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @representantes-2
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 60
            region: @pedidos-feitos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P187_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @pedidos-feitos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P187_TIPODATA (
        type: radioGroup
        label {
            label: Filtar
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Emissão;E,Entrega;A
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @pedidos-feitos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: E
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @pedidos-feitos
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 10
            region: @pedidos-detalhado
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: fnc_imprimelista();
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P187_IDREPRESENTANTE
        }
    )

    button imprimir-2 (
        buttonName: IMPRIMIR_1
        label: Imprimir
        layout {
            sequence: 10
            region: @pedidos-detalhado-2
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: fnc_imprimelista();
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P187_IDREPRESENTANTE
        }
    )

    dynamicAction tipo (
        name: tipo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P187_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P187_TIPO
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P187_IDREPRESENTANTE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: region
                region: @pedidos-detalhado
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-3 (
            action: hide
            affectedElements {
                selectionType: region
                region: @pedidos-resumido
            }
            execution {
                sequence: 30
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P187_IDREPRESENTANTE
            }
            execution {
                sequence: 20
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: region
                region: @pedidos-detalhado
            }
            execution {
                sequence: 10
            }
        )

        action native-show-3 (
            action: show
            affectedElements {
                selectionType: region
                region: @pedidos-resumido
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        name: Go To Page 187
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 187
                items: {
                    P187_DTINI: &P187_DTINI.
                    P187_DTFIM: &P187_DTFIM.
                    P187_IDREPRESENTANTE: &P187_IDREPRESENTANTE.
                    P187_CONFIRMACAO_ENTREGA: &P187_CONFIRMACAO_ENTREGA.
                }
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

