page 284 (
    name: Iniciar Sync
    title: Iniciar Sync
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 70%
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    headerAndFooter {
        footerText:
            ```html
            <script javascript>
             window.resizeTo(screen.width*.46,screen.height*.46);  
                window.moveTo(screen.width*.26, screen.height*.20);  
            </script>
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region aviso-importante (
        name: AVISO IMPORTANTE
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region iniciar-sync (
        name: Iniciar Sync
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <b><font color="green">Informe o ID do Distribuidor para iniciar o Sync.</font></b>
        }
        settings {
            outputAs: text
        }
    )

    region últimas-liberações (
        name: Últimas liberações
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from ( select idimp
                						 , pck_romance.fnc_nomerepresentante(idrepresentante)||' - '||idrepresentante distribuidor
                						 , semana
                						 , data
                						 , decode(processo, 'L','Semana Liberada', 'S', 'Sync Iniciado') processo
                				from imptablettoservidor i
                				where idfilial = :P0_IDFILIAL
                                 and (:P0_IDPOSTOAVANCADO is null or exists ( select 1
                                                                                from representantes r
                                                                                where r.idrepresentante = i.idrepresentante
                                                                                  and r.idpostoavancado = :P0_IDPOSTOAVANCADO 
                                                                                  and r.ativo = 'S' ) )
                      
                				order by 1 desc )
                where rownum <= 20
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 25
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
            sorting {
                sortable: false
            }
        )

        column DISTRIBUIDOR (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column IDIMP (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column PROCESSO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Processo
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column SEMANA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P284_AVISO (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 10
            region: @aviso-importante
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText:
                ```html
                <font color="RED"><h2>
                    Atualize a versão do APP VENDAS para efetuar o SYNC! <br>Só irá concluir se estiver atualizado.
                    </h2></font>
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P284_DATA (
        type: hidden
        layout {
            sequence: 50
            region: @iniciar-sync
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P284_DATATABLETOK (
        type: hidden
        layout {
            sequence: 80
            region: @iniciar-sync
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATATABLETOK
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P284_IDFILIAL (
        type: hidden
        layout {
            sequence: 60
            region: @iniciar-sync
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                 return :P0_IDFILIAL;
                END;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P284_IDIMP (
        type: hidden
        layout {
            sequence: 10
            region: @iniciar-sync
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDIMP
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P284_IDREPRES (
        type: textField
        label {
            label: ID
            alignment: left
        }
        layout {
            sequence: 20
            region: @iniciar-sync
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P284_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select PCK_ROMANCE.fnc_nomepessoa(idpessoa)||' - '||pck_mobile.fnc_gerasenhadeacesso_idpes(r.idpessoa) display_value
                    , r.idrepresentante return_value
                from representantes r
                where pck_romance.fnc_filialgerente(idgerente) = :P0_IDFILIAL
                  and (:P0_IDPOSTOAVANCADO is null or  r.idpostoavancado = :P0_IDPOSTOAVANCADO )
                  and r.idrepresentante = :P284_IDREPRES
                and r.ativo = 'S'
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P284_IDREPRES
        }
        layout {
            sequence: 30
            region: @iniciar-sync
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P284_IDSEMANA (
        type: hidden
        layout {
            sequence: 70
            region: @iniciar-sync
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDSEMANA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P284_PROCESSO (
        type: hidden
        layout {
            sequence: 90
            region: @iniciar-sync
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: PROCESSO
            used: always
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P284_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value
                     , return_value
                from (select pck_romance.fnc_nomeregiaovenda(idregiaovenda)||' - '||semana display_value
                					 , r.semana return_value
                			from regioesrepresentantes r
                			where idrepresentante = :P284_IDREPRESENTANTE
                			order by pck_util.fnc_idsemana(r.semana))
                where rownum = 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P284_IDREPRESENTANTE
        }
        layout {
            sequence: 40
            region: @iniciar-sync
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--xlarge
            ]
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: SEMANA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Iniciar Sync
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P284_IDIMP
        }
    )

    dynamicAction confirma (
        name: Confirma
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @create
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma o SYNC deste distribuidor?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CREATE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation foto-pendente (
        name: Foto pendente
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from depositosdiarios_orig s
                where s.comprovado in ('S','M')
                  and trunc(s.data) between trunc(sysdate)-7 and trunc(sysdate)+2
                  and s.idcontabanc not in (4367,5949)
                  and s.idrepresentante = :P284_IDREPRES
                  and s.idfechamentorepres is null
                  and s.identificacao is null
                  and not exists ( select 1
                                   from depositosdiarios_leituraocr d
                                   where d.iddepositodiario = s.iddepositodiarios )
                  and not exists ( select 1
                                   from autorizacaoimptablet a
                                   where a.idrepresentante = :P284_IDREPRES
                                     and a.semana          = :P284_SEMANA )
                ```
        }
        error {
            errorMessage: "Não é possível iniciar o Sync! Há fotos pendentes de envio! "
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from parametrosrepresentantes r
                where parametro = 'HABILITAFOTODEPOSITO'
                  and valor     = 'S'
                  and idrepresentante  = :P284_IDREPRES
                  and pck_romance.fnc_retornaparametro('LIBERASYNCSEMREVISAO',:P0_IDFILIAL) = 'N'
                ```
        }
    )

    validation valida-sync-duplicado (
        name: valida sync duplicado
        execution {
            sequence: 30
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                not exists ( select 1
                             from imptablettoservidor i
                             where i.idrepresentante = :P284_IDREPRES
                               and trunc(data) = trunc(sysdate)
                               and processo = 'S' )
                or ( exists ( select 1
                              from imptablettoservidor i
                              where i.idrepresentante = :P284_IDREPRES
                                 and trunc(data) = trunc(sysdate)
                                 and processo = 'S' )
                  and exists ( select 1
                               from liberasyncduplicado la
                               where la.idrepresentante = :P284_IDREPRES ) )
                ```
        }
        error {
            errorMessage: Este distribuidor já teve SYNC feito hoje!
        }
    )

    validation valida-sync-ja-iniciado (
        name: valida sync ja iniciado
        execution {
            sequence: 20
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                -- 08/01/2024 - Maicon Aimi - ticket - 8529690(Fernanda Aparecida Carvalho Dos Santos - Ti)
                -- Ajustar para que não seja permitido iniciar o sync antes de liberar a nova semana, conforme anexo foi iniciado o sync depois liberado nova semana.
                --
                -- Validação criada para permitir iniciar sync somente quando semana estiver com a semana liberada
                not exists ( select *
                               from imptablettoservidor i
                              where i.processo = 'S' and 
                                       i.idimp = ( select max(i.idimp)
                                                     from imptablettoservidor i
                                                    where i.idrepresentante = :P284_IDREPRES) )
                ```
        }
        error {
            errorMessage: Este distribuidor tem um SYNC iniciado!
        }
    )

    validation validar-solicitações-pendentes (
        name: Validar Solicitações Pendentes
        execution {
            sequence: 40
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                 exists ( select 1
                          from depositosdiarios_orig
                          where idrepresentante = :P284_IDREPRES
                          and idstatus in (1) )
                ```
        }
        error {
            errorMessage: Este distribuidor possui solicitações pendentes.
        }
        serverSideCondition {
            type: never
        }
    )

    process fetch-row-from-imptablettoservidor (
        name: Fetch Row from IMPTABLETTOSERVIDOR
        type: autoRowFetch
        source {
            tableName: IMPTABLETTOSERVIDOR
            pkColumn: IDIMP
            pkItem: P284_IDIMP
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 215319212055115958
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P284_IDIMP is null then
                        select "#OWNER#"."SEQ_IDIMPTABLETTOSERV".nextval
                          into :P284_IDIMP
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 215319607027115958
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-imptablettoservidor (
        name: Process Row of IMPTABLETTOSERVIDOR
        type: autoRowProcessing
        target {
            tableName: IMPTABLETTOSERVIDOR
            pkColumn: IDIMP
            pkItem: P284_IDIMP
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Processo concluído! Feche o aplicativo e entre novamente.
        }
        advanced {
            executionMappingIdentifier: 215320055050115959
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 215320487811115959
        }
    )

    branch (
        name: Go To Page 284
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 284
                items: {
                    P284_IDIMP:
                }
                clearCache: 284
                action: resetPagination
            }
        }
    )

)

