page 178 (
    name: Pagamentos da Semana
    title: Pagamentos da Semana
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 60%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region acordo-aki-da-semana (
        name: Acordo Aki da Semana
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pc.idrepresentante
                     , pck_romance.fnc_nomerepresentante(pc.idrepresentante) Nome
                     , TO_DATE(to_char(datapagamento,'dd/mm/rrrr')) "Data Pgto"
                     , sum(valorpago) "Valor Pago"
                from pagamentoscomissoesnegociacoes pc
                where nvl(pc.valorpago,0)    > 0
                  and pc.idfechamentorepres in ( select idfechamentorepres
                                                 from fechamentorepresentantes ff
                                                 where ff.idfechamento =  :P178_IDFECHAMENTO)
                  and exists ( select 1
                               from negociacoesparceiros np
                               where np.idnegociacaoparceiro = pc.idnegociacaoparceiro
                                 and np.origem               = 'A' )
                group by pc.idrepresentante
                       , datapagamento
                order by 2
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: showAll
        }
        messages {
            whenNoDataFound: Nenhuma comissão paga.
        }

        column "Data Pgto" (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data pgto
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column IDREPRESENTANTE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: ID Distribuidor
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column NOME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column "Valor Pago" (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Valor pago
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

    )

