    pageItem P161_UTILIZA_ASSINATURA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @page_plug
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select pr.valor
                from parametrosrepresentantes pr
                where pr.idrepresentante = :P161_IDREPRESENTANTE
                  and pr.parametro       = 'UTILIZAASSINATURAELETRONICA'
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    process confirmar-assinatura (
        name: Confirmar Assinatura
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidcaracteristica number := 24;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);
                  vidnotavenda number := :P161_IDRECEBIDO;
                  --
                begin 
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P161_IDRECEBIDO,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidvalorcaracteristica,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Assinatura Confirmada!
        }
        advanced {
            executionMappingIdentifier: 1507101827447630807
        }
        serverSideCondition {
            type: request=Value
            value: ASSINATURACONFIRMADA
        }
    )

    process confirmar-promissoria (
        name: Confirmar Promissoria
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidcaracteristica number := 3;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);
                  vidnotavenda number := :P161_IDRECEBIDO;
                  --
                begin 
                  --
                  update notasvendas n
                  set n.promissoriarecuperada = 'S'
                  where n.idnotavenda = :P161_IDRECEBIDO;
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P161_IDRECEBIDO,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidvalorcaracteristica,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Promissória Recebida
        }
        advanced {
            executionMappingIdentifier: 478544304721102629
        }
        serverSideCondition {
            type: request=Value
            value: PROMISSORIARECEBIDA
        }
    )

    process processos-da-assinatura-eletronica (
        name: Processos da assinatura eletronica
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidcaracteristica number;
                  vidclassificacaonotavenda number;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);
                  vidnotavenda number := :P161_IDRECEBIDO;
                  --
                begin 
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  if v('REQUEST') = 'APROVA_ASSINATURA' then
                     vidcaracteristica := 38;
                  elsif v('REQUEST') = 'REPROVA_ASSINATURA' then
                     vidcaracteristica := 39;
                  end if;
                  --
                  pck_cadastros_rmc.prc_classificacoesnotasvendas(pidclassificacaonotavenda => vidclassificacaonotavenda,
                                                                  pidnotavenda => :P161_IDRECEBIDO,
                                                                  pidcaracteristicanotavenda => vidcaracteristica,
                                                                  pdataclassificado => vdataclassificado,
                                                                  pidusuario => vidusuario,
                                                                  pidvalorcaracteristica => vidvalorcaracteristica,
                                                                  pobservacao => vobservacao,
                                                                  poperacao_dml => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Processo realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 36053491802235010
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('APROVA_ASSINATURA','REPROVA_ASSINATURA')
        }
    )

)

