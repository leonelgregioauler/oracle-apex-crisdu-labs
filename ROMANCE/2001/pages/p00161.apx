    region notas-para-próximo-ciclo (
        name: Notas Para Próximo Ciclo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'N' abertura
                     , nv.idnotavenda
                     , nv.numeronota
                     , nv.datanota
                     , nv.semanadistribuicao
                     , nv.semanacobranca 
                     , pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) vendedora
                     , ( select pck_romance.fnc_nomecidade(p.idcidade) from pessoas p where p.idpessoa = vv.idpessoa ) cidade
                     , pck_romance.fnc_nomeregiaovenda(nv.idregiaovenda) regiao
                     , nv.valortotalnota
                     , ( select NROCONSULTASPC
                         from pessoas p
                         where p.idpessoa = vv.idpessoa ) "Nr Consulta SPC"
                     , case
                        when nvl(nv.promissoriarecuperada,'N') = 'N' then
                          '<a href=javascript:receberpromissoria('||nv.idnotavenda||');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                        else 
                          'Recebida!'
                       end confirmarrecebimento
                     , case
                        when exists ( select 1
                                      from notasvendas nnv
                                         , classificacoesnotasvendas cnv
                                      where cnv.idnotavenda = nnv.idnotavenda
                                        and nnv.idvendedora = nv.idvendedora 
                                        and cnv.idcaracteristicanotavenda = 24  ) then
                          '<b>Já existe uma confirmação de assinatura!</b>'
                        when not exists ( select 1
                                          from notasvendas nnv
                                             , classificacoesnotasvendas cnv
                                          where cnv.idnotavenda = nnv.idnotavenda
                                            and nnv.idvendedora = nv.idvendedora 
                                            and cnv.idcaracteristicanotavenda = 24 ) then
                          '<a href=javascript:confirmaassinatura('||nv.idnotavenda||');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                        else 
                          'Assinatura Confirmada!'
                       end confirmaassinatura
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' irparanota
                     , pck_util.fnc_idsemana(nv.semanacobranca) - pck_util.fnc_idsemana(nv.semanadistribuicao) intervalo
                     , pck_romance.fnc_cpfvendedora(nv.idvendedora) cpf
                     -- Maicon Aimi - 10002474 - 19/03/2025 -- Adicionado coluna APP (Indica se a vendedora usa ou não o App Vendas Plus).
                     , nvl( (select 'Sim'
                               from dual
                              where exists ( select 1
                                               from registrosloginminhasacola rr
                                              where rr.idvendedora = vv.idvendedora)),'Não') as "APP"
                     -- Maicon Aimi - 10276934 - 11/07/2025 - Adicionado a data reativação
                     , case 
                         when vv.datareativacaovendedora is not null then
                           to_char(trunc(vv.datareativacaovendedora), 'DD/MM/YYYY') || 
                           ' (' || (trunc(sysdate) - trunc(vv.datareativacaovendedora)) || ' dias)'
                         else
                           null
                       end as data_reativacao
                     , nv.idtablet idtablet
                     , nvl( ( select vw.descsituacao                                               
                              from vw_assinaturas_eletronicas vw
                              where vw.idnotavenda = nv.idnotavenda 
                                and vw.status = 'C' 
                                and vw.idassinaturaeletronica = ( select max(aa.idassinaturaeletronica)
                                                                  from assinaturaseletronicas aa
                                                                  where aa.idnotavenda = nv.idnotavenda
                                                                    and aa.status = 'C' ) ),'Assinatura Eletronica não localizada!' ) situacao_assinatura --t15134761
                from notasvendas    nv
                   , vendedoras     vv
                where nv.idvendedora     = vv.idvendedora
                  and nv.idsituacaonotavenda = 3
                  and nv.idfilial        = :P0_IDFILIAL
                  and nv.idrepresentante = :P161_IDREPRESENTANTE
                  and pck_util.fnc_idsemana(nv.semanacobranca) = pck_util.fnc_idsemana(:P161_SEMANA)+6
                  and pck_util.fnc_idsemana(nv.semanacobranca) - pck_util.fnc_idsemana(nv.semanadistribuicao) = 12
                ```
        }
        layout {
            sequence: 31
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent8
                t-Region--scrollBody
            ]
        }
