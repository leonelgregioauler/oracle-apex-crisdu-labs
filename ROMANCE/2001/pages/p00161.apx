page 161 (
    name: Lista de Notas de Venda
    title: Lista de Notas de Venda
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_popup_consulta()
            {
              window.open('f?p=&APP_ID.:156:&SESSION.::NO::','CONSULTAR', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=250,left=250,top=100','_blank'); void(0);
            }
            
            function fnc_popup()
            {
            window.open('f?p=&APP_ID.:147:&SESSION.::NO::','LIMPAR', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=180,left=250,top=100','_blank'); void(0);
            }
            function fnc_popup_vend()
            {
            window.open('f?p=&APP_ID.:152:&SESSION.::NO::','vendedora', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=900,height=600,left=250,top=100','_blank'); void(0);
            }
            
            function receberpromissoria(pid){ 
            
              document.getElementById('P161_IDRECEBIDO').value = pid;
                
              var answer = confirm("Confirma a Promissória Recebida ?")
              if (answer)
                {
                  apex.submit('PROMISSORIARECEBIDA');
                }
            }
            
            function confirmaassinatura(pid){ 
            
              document.getElementById('P161_IDRECEBIDO').value = pid;
                
              var answer = confirm("Confirma a Assinatura ?")
              if (answer)
                {
                  apex.submit('ASSINATURACONFIRMADA');
                }
            }
            
            function aprovaassinatura(pid){ 
            
              document.getElementById('P161_IDRECEBIDO').value = pid;
                
              var answer = confirm("Aprova a Assinatura Eletronica?")
              if (answer)
                {
                  apex.submit('APROVA_ASSINATURA');
                }
            }
            
            function reprovaassinatura(pid){ 
            
              document.getElementById('P161_IDRECEBIDO').value = pid;
                
              var answer = confirm("Reprova a Assinatura Eletronica?")
              if (answer)
                {
                  apex.submit('REPROVA_ASSINATURA');
                }
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region notas-novas-aberturas (
        name: Notas Novas Aberturas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'S' abertura
                     , nv.idnotavenda
                     , nv.numeronota
                     , nv.semanadistribuicao
                     , nv.semanacobranca 
                     , pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) vendedora
                     , nv.valortotalnota
                     , pck_util.fnc_idsemana(nv.semanacobranca) - pck_util.fnc_idsemana(nv.semanadistribuicao) intervalo
                     , ( select pck_romance.fnc_nomecidade(p.idcidade) from pessoas p where p.idpessoa = vv.idpessoa ) cidade
                     , nv.datanota
                     , pck_romance.fnc_nomeregiaovenda(nv.idregiaovenda) regiao
                     , ( select NROCONSULTASPC
                         from pessoas p
                         where p.idpessoa = vv.idpessoa ) "Nr Consulta SPC"
                     , pck_romance.fnc_retornatelefones(nv.idvendedora) telefones
                     , case
                        when nvl(nv.promissoriarecuperada,'N') = 'N' then
                          '<a href=javascript:receberpromissoria('||nv.idnotavenda||');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                        else 
                          'Recebida!'
                       end confirmarrecebimento
                     , case
                        when exists ( select 1
                                      from notasvendas nnv
                                         , classificacoesnotasvendas cnv
                                      where cnv.idnotavenda = nnv.idnotavenda
                                        and nnv.idvendedora = nv.idvendedora 
                                        and cnv.idcaracteristicanotavenda = 24  ) then
                          '<b>Já existe uma confirmação de assinatura!</b>'
                        when not exists ( select 1
                                          from notasvendas nnv
                                             , classificacoesnotasvendas cnv
                                          where cnv.idnotavenda = nnv.idnotavenda
                                            and nnv.idvendedora = nv.idvendedora 
                                            and cnv.idcaracteristicanotavenda = 24 ) then
                          '<a href=javascript:confirmaassinatura('||nv.idnotavenda||');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                        else 
                          'Assinatura Confirmada!'
                       end confirmaassinatura
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' irparanota
                     ,  nvl( ( select vw.link                                               
                              from vw_assinaturas_eletronicas vw
                              where vw.idnotavenda = nv.idnotavenda 
                                and vw.status = 'C' 
                                and vw.idassinaturaeletronica = ( select max(aa.idassinaturaeletronica)
                                                                  from assinaturaseletronicas aa
                                                                  where aa.idnotavenda = nv.idnotavenda
                                                                    and aa.status = 'C' ) ),'Assinatura Eletronica não localizada!' ) assinaturaeletronica
                     , nvl( ( select vw.descsituacao                                               
                              from vw_assinaturas_eletronicas vw
                              where vw.idnotavenda = nv.idnotavenda 
                                and vw.status = 'C' 
                                and vw.idassinaturaeletronica = ( select max(aa.idassinaturaeletronica)
                                                                  from assinaturaseletronicas aa
                                                                  where aa.idnotavenda = nv.idnotavenda
                                                                    and aa.status = 'C' ) ),'Assinatura Eletronica não localizada!' ) situacao_assinatura
                     , pck_romance.fnc_cpfvendedora(nv.idvendedora) cpf
                     -- Maicon Aimi - 10002474 - 19/03/2025 -- Adicionado coluna APP (Indica se a vendedora usa ou não o App Vendas Plus).
                     , nvl( (select 'Sim'
                               from dual
                              where exists ( select 1
                                               from registrosloginminhasacola rr
                                              where rr.idvendedora = vv.idvendedora)),'Não') as "APP"
                     -- Maicon Aimi - 10276934 - 11/07/2025 - Adicionado a data reativação
                     , case 
                         when vv.datareativacaovendedora is not null then
                           to_char(trunc(vv.datareativacaovendedora), 'DD/MM/YYYY') || 
                           ' (' || (trunc(sysdate) - trunc(vv.datareativacaovendedora)) || ' dias)'
                         else
                           null
                       end as data_reativacao
                     , nv.idtablet idtablet
                from notasvendas    nv
                   , vendedoras     vv
                where nv.idvendedora     = vv.idvendedora
                  and nv.idsituacaonotavenda = 3
                  and nv.idfilial        = :P0_IDFILIAL
                  and nv.idrepresentante = :P161_IDREPRESENTANTE
                  and nv.semanadistribuicao = :P161_SEMANA
                  and not exists ( select 1
                                   from notasvendas n
                                   where n.idvendedora = nv.idvendedora
                                     and n.idnotavenda < nv.idnotavenda
                                     and n.idsituacaonotavenda <> 5 )
                  and nv.idsemanacobranca <= pck_util.fnc_idsemana(:P161_SEMANA)+nvl(to_number(:P0_QTDSEMANAS),6)
                union
                select 'N' abertura
                     , nv.idnotavenda
                     , nv.numeronota
                     , nv.semanadistribuicao
                     , nv.semanacobranca 
                     , pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) vendedora
                     , nv.valortotalnota
                     , pck_util.fnc_idsemana(nv.semanacobranca) - pck_util.fnc_idsemana(nv.semanadistribuicao) intervalo
                     , ( select pck_romance.fnc_nomecidade(p.idcidade) from pessoas p where p.idpessoa = vv.idpessoa ) cidade
                     , nv.datanota
                     , pck_romance.fnc_nomeregiaovenda(nv.idregiaovenda) regiao
                     , ( select NROCONSULTASPC
                         from pessoas p
                         where p.idpessoa = vv.idpessoa ) "Nr Consulta SPC"
                     , pck_romance.fnc_retornatelefones(nv.idvendedora) telefones
                     , case
                        when nvl(nv.promissoriarecuperada,'N') = 'N' then
                          '<a href=javascript:receberpromissoria('||nv.idnotavenda||');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                        else 
                          'Recebida!'
                       end confirmarrecebimento
                     , case
                        when exists ( select 1
                                      from notasvendas nnv
                                         , classificacoesnotasvendas cnv
                                      where cnv.idnotavenda = nnv.idnotavenda
                                        and nnv.idvendedora = nv.idvendedora 
                                        and cnv.idcaracteristicanotavenda = 24  ) then
                          '<b>Já existe uma confirmação de assinatura!</b>'
                        when not exists ( select 1
                                          from notasvendas nnv
                                             , classificacoesnotasvendas cnv
                                          where cnv.idnotavenda = nnv.idnotavenda
                                            and nnv.idvendedora = nv.idvendedora 
                                            and cnv.idcaracteristicanotavenda = 24 ) then
                          '<a href=javascript:confirmaassinatura('||nv.idnotavenda||');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                        else 
                          'Assinatura Confirmada!'
                       end confirmaassinatura
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' irparanota
                     , nvl( ( select vw.link                                               
                              from vw_assinaturas_eletronicas vw
                              where vw.idnotavenda = nv.idnotavenda 
                                and vw.status = 'C' 
                                and vw.idassinaturaeletronica = ( select max(aa.idassinaturaeletronica)
                                                                  from assinaturaseletronicas aa
                                                                  where aa.idnotavenda = nv.idnotavenda
                                                                    and aa.status = 'C' ) ),'Assinatura não localizada!' ) assinaturaeletronica
                     , nvl( ( select vw.descsituacao                                               
                              from vw_assinaturas_eletronicas vw
                              where vw.idnotavenda = nv.idnotavenda 
                                and vw.status = 'C' 
                                and vw.idassinaturaeletronica = ( select max(aa.idassinaturaeletronica)
                                                                  from assinaturaseletronicas aa
                                                                  where aa.idnotavenda = nv.idnotavenda
                                                                    and aa.status = 'C' ) ),'Assinatura não localizada!' ) situacao_assinatura
                     , pck_romance.fnc_cpfvendedora(nv.idvendedora) cpf
                     -- Maicon Aimi - 10002474 - 19/03/2025 -- Adicionado coluna APP (Indica se a vendedora usa ou não o App Vendas Plus).
                     , nvl( (select 'Sim'
                               from dual
                              where exists ( select 1
                                               from registrosloginminhasacola rr
                                              where rr.idvendedora = vv.idvendedora)),'Não') as "APP"
                     -- Maicon Aimi - 10276934 - 11/07/2025 - Adicionado a data reativação
                     , case 
                         when vv.datareativacaovendedora is not null then
                           to_char(trunc(vv.datareativacaovendedora), 'DD/MM/YYYY') || 
                           ' (' || (trunc(sysdate) - trunc(vv.datareativacaovendedora)) || ' dias)'
                         else
                           null
                       end as data_reativacao
                     , nv.idtablet idtablet
                from notasvendas    nv
                   , vendedoras     vv
                where nv.idvendedora     = vv.idvendedora
                  and nv.idsituacaonotavenda = 3
                  and nv.idfilial        = :P0_IDFILIAL
                  and nv.idrepresentante = :P161_IDREPRESENTANTE
                  and nv.semanadistribuicao = :P161_SEMANA
                  and exists ( select 1
                               from notasvendas n
                               where n.idvendedora = nv.idvendedora
                                 and n.idsemanacobranca = (select max(idsemanacobranca)
                                                           from notasvendas nn
                                                           where nn.idvendedora = n.idvendedora
                                                             and nn.idsituacaonotavenda = 4)
                                 and n.idsemanacobranca != pck_util.fnc_idsemana(:P161_SEMANA) ) 
                  and nv.idsemanacobranca <= pck_util.fnc_idsemana(:P161_SEMANA)+nvl(to_number(:P0_QTDSEMANAS),6)
                ```
        }
        layout {
            sequence: 11
            slot: body-3
        }
