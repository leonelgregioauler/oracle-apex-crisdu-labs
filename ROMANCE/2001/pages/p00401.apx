page 401 (
    name: Notas Invalidadas pela Cobrança
    title: Notas Invalidadas pela Cobrança
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region notas-invalidadas (
        name: Notas Invalidadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||n.idnotavenda,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' link
                     , n.numeronota
                     , pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                     , n.datanota
                     , n.semanadistribuicao
                     , n.semanacobranca
                     , pck_romance.fnc_nomeregiaovenda(n.idregiaovenda) regiaovenda
                     , n.valortotalnota
                     , n.valortotalvendalqd
                     , n.valorpago
                     , n.saldo
                     , n.dataacerto
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                from notasvendas n
                where n.idfilial = :P0_IDFILIAL
                  and ( :P401_IDREPRESENTANTE is null or n.idrepresentante = :P401_IDREPRESENTANTE )
                  and ( n.idsituacaocobranca = 60
                     or n.idsituacaopromissoria not in ( 0,3 ) )
                order by 3
                ```
            pageItemsToSubmit: P401_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma nota encontrada!
        }
        advanced {
            savedReportMappingIdentifier: 1460056023531384034
        }

        column CLIENTE (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column DATAACERTO (
            type: plainText
            heading {
                heading: Data do Acerto
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: L
            }
        )

        column DATANOTA (
            type: plainText
            heading {
                heading: Data da Nota
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 130
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: M
            }
        )

        column LINK (
            type: plainText
            heading {
                heading: Ir P/ Nota
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NUMERONOTA (
            type: plainText
            heading {
                heading: Nr Nota
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column REGIAOVENDA (
            type: plainText
            heading {
                heading: Região de Venda
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column SALDO (
            type: plainText
            heading {
                heading: Saldo
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column SEMANACOBRANCA (
            type: plainText
            heading {
                heading: Cobrança
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column SEMANADISTRIBUICAO (
            type: plainText
            heading {
                heading: Distribuição
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column VALORPAGO (
            type: plainText
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column VALORTOTALNOTA (
            type: plainText
            heading {
                heading: Valor da Nota
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column VALORTOTALVENDALQD (
            type: plainText
            heading {
                heading: Valor Venda
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 14601300 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CLIENTE (
                sequence: 3
            )

            displayColumn DATAACERTO (
                sequence: 12
            )

            displayColumn DATANOTA (
                sequence: 4
            )

            displayColumn DISTRIBUIDOR (
                sequence: 13
            )

            displayColumn LINK (
                sequence: 1
            )

            displayColumn NUMERONOTA (
                sequence: 2
            )

            displayColumn REGIAOVENDA (
                sequence: 7
            )

            displayColumn SALDO (
                sequence: 11
            )

            displayColumn SEMANACOBRANCA (
                sequence: 6
            )

            displayColumn SEMANADISTRIBUICAO (
                sequence: 5
            )

            displayColumn VALORPAGO (
                sequence: 10
            )

            displayColumn VALORTOTALNOTA (
                sequence: 8
            )

            displayColumn VALORTOTALVENDALQD (
                sequence: 9
            )

            controlBreak (
                column: DISTRIBUIDOR
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P401_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' - '||r.idrepresentante||' ('||decode(r.ativo,'S','Ativo','N','Inativo')||') ' r
                     , idrepresentante d
                from representantes r
                where r.idgerente = (select idgerente
                                     from gerentes 
                                     where idfilial = :P0_IDFILIAL)
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P401_IDREPRESENTANTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @notas-invalidadas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

