    region assinaturas-reprovadas (
        name: Assinaturas Reprovadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.numeronota 
                     , pck_romance.fnc_nomevendedora(nv.idvendedora) consultora
                     , nv.datanota 
                     , a.datarealizada 
                     , a.dataavaliacao
                     , a.motivoreprovacao
                     , a.descorigem 
                     , nvl( ( select --cast( wm_concat(aa.descorigem||' - '||aa.descsituacao) as varchar2(4000) )
                                     listagg(aa.descorigem||' - '||aa.descsituacao,',') within group ( order by 1)
                              from vw_assinaturas_eletronicas aa
                              where aa.token_interno = a.token_interno
                                and aa.idassinatura_orig = a.idassinaturaeletronica
                                --and aa.idassinaturaeletronica != a.idassinaturaeletronica
                                --and aa.idassinaturaeletronica > a.idassinaturaeletronica
                                and aa.status = 'C' ),'Não') assinatura_refeita
                      , a.desctiponota tipo
                      -- Maicon Aimi - 10276934 - 11/07/2025 - Adicionado a data reativação
                      , case 
                          when vv.datareativacaovendedora is not null then
                            to_char(trunc(vv.datareativacaovendedora), 'DD/MM/YYYY') || 
                            ' (' || (trunc(sysdate) - trunc(vv.datareativacaovendedora)) || ' dias)'
                          else
                            null
                        end as data_reativacao
                    , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' irparanota
                from notasvendas nv
                   , vw_assinaturas_eletronicas a
                   , catal.vendedoras vv
                where nv.idrepresentante = :P626_IDREPRESENTANTE
                  and nv.semanadistribuicao = :P626_SEMANA
                  and a.idnotavenda = nv.idnotavenda
                  and vv.idvendedora = nv.idvendedora
                  and a.status = 'C'
                  and a.tiponota = 'N'
                  and a.situacao = 'R' 
                union all
                select nv.numeronota 
                     , pck_romance.fnc_nomevendedora(nv.idvendedora) consultora
                     , nv.datanota 
                     , a.datarealizada 
                     , a.dataavaliacao
                     , a.motivoreprovacao
                     , a.descorigem 
                     , nvl( ( select --cast( wm_concat(aa.descorigem||' - '||aa.descsituacao) as varchar2(4000) )
                                     listagg(aa.descorigem||' - '||aa.descsituacao,',') within group ( order by 1) 
                              from vw_assinaturas_eletronicas aa
                              where aa.token_interno = a.token_interno
                                and aa.idassinatura_orig = a.idassinaturaeletronica
                                --and aa.idassinaturaeletronica != a.idassinaturaeletronica
                                --and aa.idassinaturaeletronica > a.idassinaturaeletronica
                                and aa.status = 'C' ),'Não') assinatura_refeita
                      , a.desctiponota tipo
                      -- Maicon Aimi - 10276934 - 11/07/2025 - Adicionado a data reativação
                      , case 
                          when vv.datareativacaovendedora is not null then
                            to_char(trunc(vv.datareativacaovendedora), 'DD/MM/YYYY') || 
                            ' (' || (trunc(sysdate) - trunc(vv.datareativacaovendedora)) || ' dias)'
                          else
                            null
                        end as data_reativacao
                    , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':37:'||v('APP_SESSION')||'::NO::P37_IDNOTAVENDA:'||nv.idnotavenda ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' irparanota
                from notasvendas nv
                   , vw_assinaturas_eletronicas a
                   , notasadicionais na
                   , catal.vendedoras vv
                where nv.idrepresentante = :P626_IDREPRESENTANTE
                  and na.idnotavenda = nv.idnotavenda
                  and na.semana = :P626_SEMANA
                  and a.idnotavenda = nv.idnotavenda
                  and vv.idvendedora = nv.idvendedora
                  and a.status = 'C'
                  and a.tiponota = 'A'
                  and a.situacao = 'R' 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma assinatura reprovada.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 7596425267423225414
        }

