page 626 (
    name: Assinaturas Reprovadas da Semana
    title: Assinaturas Reprovadas da Semana
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region assinaturas-aprovadas-da-semana (
        name: Assinaturas Aprovadas da Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select aa.datarealizada
                     , aa.datanota
                     , aa.cpf
                     , aa.vendedora
                     , aa.numeronota
                     , aa.desctipoassinatura
                     , aa.idnotavenda
                from vw_assinaturas_eletronicas aa
                where aa.status = 'C' 
                  and aa.tiponota = 'N'
                  and aa.situacao = 'A'
                  and aa.idrepresentante = :P626_IDREPRESENTANTE
                  and aa.idsemana = pck_util.fnc_idsemana(:P626_SEMANA)
                  and :P626_TIPO = 2
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <font color="green"><b>Estas assinaturas estão contabilizadas como APROVADAS para o MOTIVOU LEVOU da determinada SEMANA!</b></font>
        }
        serverSideCondition {
            type: item=value
            item: P626_TIPO
            value: 2
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma assinatura reprovada.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 263094142879558119
        }

