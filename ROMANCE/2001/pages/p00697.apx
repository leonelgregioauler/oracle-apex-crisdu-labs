    region pagamentos-efetuados (
        name: Pagamentos Efetuados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pd.valorpago 
                     , pd.datapagamento
                     , pd.idpagamentodebitodiverso
                from roman.pagamentosdebitosdiversos pd
                where pd.iddebitodiverso = :P697_IDDEBITODIVERSO
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Nenhum pagamento efetuado.
        }
        componentAdvanced {
            stripHtml: true
        }

        column DATAPAGAMENTO (
            reportColumnQueryId: 2
            derivedColumn: N
