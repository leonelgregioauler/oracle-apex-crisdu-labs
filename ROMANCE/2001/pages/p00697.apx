        behavior {
            action: redirectThisApp
            target: {
                page: 695
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-valor-pago (
        name: Valida valor pago
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vvalorpago       NUMBER;
                  vvalorapagar     NUMBER;
                begin
                  --
                  select sum(pg.valorpago)
                  into vvalorpago
                  from roman.pagamentosdebitosdiversos pg
                  where pg.iddebitodiverso = :P697_IDDEBITODIVERSO
                    and pg.idpagamentodebitodiverso != nvl(:P697_IDPAGAMENTODEBITODIVERSO,-1);
                  --
                   vvalorpago := nvl(vvalorpago,0) + :P697_VALORPAGO;
                  --
                  select db.valortotal
                  into vvalorapagar
                  from roman.debitosdiversos db
                  where iddebitodiverso = :P697_IDDEBITODIVERSO;
                  --
                  if (vvalorpago > vvalorapagar) then
                     Return ('Valor pago maior que valor devido.');
                  end if;
                  --
                end;
                ```
        }
    )

    process fetch-row-from-pagamentosdebitosdiversos (
        name: Fetch Row from PAGAMENTOSDEBITOSDIVERSOS
        type: autoRowFetch
        source {
            tableName: PAGAMENTOSDEBITOSDIVERSOS
            pkColumn: IDPAGAMENTODEBITODIVERSO
            pkItem: P697_IDPAGAMENTODEBITODIVERSO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1506349271954152805
        }
    )

    process inserir-pagamento (
        name: Inserir pagamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                  voperacao_dml varchar2(1);
                  vdatapagamento  date;
                  vsituacao varchar2(1);
                  vmd5 varchar2(4000);
                  vidpagamentonegociacaoparc number;
                  vvalorpago number := :P697_VALORPAGO;
                  vidpagamentodebitodiverso number := :P697_IDPAGAMENTODEBITODIVERSO;
                  viddebitodiverso number := :P697_IDDEBITODIVERSO;
                
                begin
                
                  if v('REQUEST') = 'SALVAR' then 
                   voperacao_dml := 'U';
                  end if;
                  if v('REQUEST') = 'CREATE' then 
                   voperacao_dml := 'I';
                  end if;
                  if v('REQUEST') = 'DELETE' then 
                   voperacao_dml := 'D';
                  end if;
                  
                
                  
                roman.pck_gestaoderisco_rmc.PRC_PAGAMENTOSDEBITOSDIVERSOS(pidpagamentodebitodiverso => vidpagamentodebitodiverso,
                                                                          piddebitodiverso          => viddebitodiverso,
                                                                          pidpagamentonegociacaoparc => vidpagamentonegociacaoparc,
                                                                          pvalorpago                => vvalorpago,
                                                                          pdatapagamento            => vdatapagamento,
                                                                          psituacao                 => vsituacao,
                                                                          pmd5                      => vmd5,
                                                                          poperacao_dml             => voperacao_dml);
                                                                          
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1501059816417311046
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                  voperacao_dml varchar2(1) := 'S';
                  vdatapagamento  date;
                  vsituacao varchar2(1);
                  vmd5 varchar2(4000);
                  vidpagamentonegociacaoparc number;
                  vvalorpago number;
                  vidpagamentodebitodiverso number := :P697_IDPAGAMENTODEBITODIVERSO;
                  viddebitodiverso number;
                
                begin
                
                roman.pck_gestaoderisco_rmc.PRC_PAGAMENTOSDEBITOSDIVERSOS(pidpagamentodebitodiverso => vidpagamentodebitodiverso,
                                                                          piddebitodiverso          => viddebitodiverso,
                                                                          pidpagamentonegociacaoparc => vidpagamentonegociacaoparc,
                                                                          pvalorpago                => vvalorpago,
                                                                          pdatapagamento            => vdatapagamento,
                                                                          psituacao                 => vsituacao,
                                                                          pmd5                      => vmd5,
                                                                          poperacao_dml             => voperacao_dml);
                                                                          
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1505438516291371713
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        name: Go To Page 697
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 697
                items: {
