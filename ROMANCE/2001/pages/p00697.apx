        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 697
                items: {
                    P697_IDDEBITODIVERSO: &P697_IDDEBITODIVERSO.
                    P697_IDPAGAMENTODEBITODIVERSO:
                    P697_VALORPAGO:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
