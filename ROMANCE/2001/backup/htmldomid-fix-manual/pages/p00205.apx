            layout {
                sequence: 7
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Situação
                endUserAlias: G
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Usuário (
            type: plainText
