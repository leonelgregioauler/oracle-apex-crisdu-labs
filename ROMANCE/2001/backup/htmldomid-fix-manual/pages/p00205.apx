                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Motivo (
            type: plainText
            heading {
                heading: Motivo
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Motivo
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Nr Nota" (
            type: plainText
            heading {
                heading: Nr Nota
                alignment: center
