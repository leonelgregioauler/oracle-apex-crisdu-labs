        savedReport 3759191 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn CONSULTORA (
                sequence: 7
            )

            displayColumn "Data Correção" (
                sequence: 2
            )

            displayColumn "Motivo" (
                sequence: 4
            )

            displayColumn "Nr Nota" (
                sequence: 1
            )

            displayColumn "Representante" (
                sequence: 6
            )

            displayColumn "Situação" (
                sequence: 5
            )

            displayColumn "Usuário" (
                sequence: 3
            )

            sort (
                column: "Data Correção"
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            controlBreak (
                column: "Representante"
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P205_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante return_value
                  from representantes r
                 where r.idgerente = ( select idgerente 
                                         from gerentes g
                                        where g.idfilial = :P0_IDFILIAL )
                   and (   (:P205_ST_REPRESENTANTE = 'A') 
                        or (:P205_ST_REPRESENTANTE = 'N' and r.ativo = 'N') 
                        or (:P205_ST_REPRESENTANTE = 'S' and r.ativo = 'S') )
                 order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: [
                P0_IDFILIAL
                P205_ST_REPRESENTANTE
            ]
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P205_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semanacompleta as d
                     , semanacompleta as r
                from semana_dias
                where ano = extract(year from sysdate)
                and semana <= to_char(sysdate, 'WW')
                order by idsemana desc
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P205_ST_REPRESENTANTE (
        type: selectList
        label {
            label: Situação Distribuidor
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Ambos;A,Ativo;S,Inativo;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: A
        }
    )

    button btn-p205-filtrar (
        buttonName: BTN_P205_FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P205_IDREPRESENTANTE
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P205_IDREPRESENTANTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @relatório-de-anotações
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

