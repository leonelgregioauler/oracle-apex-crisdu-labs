page 205 (
    name: Relatório de Anotações
    title: Relatório de Anotações
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-de-anotações (
        name: Relatório de Anotações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idcorrecaonotavenda
                     , t.idnotavenda
                     , pck_romance.fnc_nomevendedora (n.idvendedora) consultora
                     , t.datacorrecao "Data Correção"
                     , t.usuario "Usuário"
                     , t.motivo  "Motivo"
                     , decode(t.situacao,'P','Pendente','R','Rejeitado','C','Corrigido') "Situação"
                     , pck_romance.fnc_nomerepresentante(t.idrepresentante) "Representante"
                     , ( select n.numeronota 
                         from notasvendas n 
                         where n.idnotavenda = t.idnotavenda ) "Nr Nota"
                from correcoesnotasvendas t
                   , notasvendas n
                where t.situacao = 'C'
                  and n.idfilial = :P0_IDFILIAL
                  and t.idrepresentante = :P205_IDREPRESENTANTE
                  and (:P205_SEMANA is null or n.semanadistribuicao = :P205_SEMANA)
                  and n.idnotavenda = t.idnotavenda(+)
                order by datacorrecao desc
                ```
            pageItemsToSubmit: P205_IDREPRESENTANTE
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 37
                items: {
                    P37_IDNOTAVENDA: #IDNOTAVENDA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt="" />
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 375917917330153806
        }

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 19
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column "Data Correção" (
