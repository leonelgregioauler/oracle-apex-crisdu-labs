    pageItem P191_TIPO_RELATORIO (
        type: radioGroup
        label {
            label: Relatório
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Detalhado'
                     , 'D'
                from dual
                union
                select 'Resumido'
                     , 'R'
                from dual
                union
                select 'Empresas'
                     , 'E'
                from dual
                where pck_romance.fnc_filialusuario(v('APP_USER')) != :P0_IDFILIAL
                   -- 11138525 - Maicon Aimi - 29/09/2025
                  and exists (  select 1
                                  from roman.usuariosgruposatendimento u
                                 where u.idgrupoatendimento = 10
                                   and u.usuario = v('APP_USER'))
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

    button p191-filtrar (
        buttonName: P191_FILTRAR
        label: Filtrar
        layout {
            sequence: 90
            region: @filtro
            slot: regionBody
        }
