    region débitos-de-cliente-sistema-antigo (
        name: Débitos de Cliente Sistema Antigo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*FIRST_ROWS(15)*/ b.idboleto
                     , numero
                     , empresa "Empresa"
                     , representante "Representante"
                     , consultora "Consultora"
                     , cpf "CPF"
                     , valortotal "Valor Total"
                     , b.datavencimento "Vencimento"
                     , diasatrasado "Dias Atrasado"
                     , situacao "Situação"
                     , Telefones "Telefones"
                     , Endereco "Endereço"
                     , RepresAtivo "Repres Ativo"
                     , b.valoratualizado "Valor Atualizado p/ Hoje"
                     , b.clienteativa "Cliente Ativa"
                     , b.spc "SPC"
                from vw_debitosvendedfavorita b
                where b.idfilial = :P0_IDFILIAL
                  and (:P191_REPRESENTANTE is null or :P191_REPRESENTANTE = b.idrepresentante)
                  and  trunc(datavencimento) between to_date(:P191_DATAINICIO) and to_date(:P191_DATAFIM) 
                  and ( :P191_SITUACAO_CONSULTORA is null or ( :P191_SITUACAO_CONSULTORA = 'A' or b.clienteativa = :P191_SITUACAO_CONSULTORA ) )
                ```
            pageItemsToSubmit: [
                P191_REPRESENTANTE
                P191_DATAFIM
                P191_DATAINICIO
                P191_SITUACAO_CONSULTORA
            ]
        }
        layout {
            sequence: 50
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P191_TIPO_RELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
