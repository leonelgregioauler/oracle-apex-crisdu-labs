    region débitos-clientes-sistema-novo (
        name: Débitos clientes Sistema Novo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select fv.idpedido numero
                     , trunc(fv.datavencimentomenor) datavencimento
                     , trunc(sysdate) - to_date(trunc(fv.datavencimentomenor),'dd/mm/rrrr') DiasAtrasado
                     , fv.situacaovencimento
                     , fv.vendedora
                     , nvl(fv.cpf,(select documentoestrangeiro
                                   from pessoas p
                                   where idpessoa = fv.idpessoa)) documento
                     , (select p.enderecoprincipal||'- n? '||p.numero||', Bairro: '||p.bairro||'- '||roman.pck_romance.fnc_nomecidade(p.idcidade)
                        from pessoas p
                        where idpessoa = (select idpessoa 
                                          from vendedoras v 
                                          where v.idvendedora = fv.idvendedora)) Endereco
                     , ( select decode(ativo,'S','Sim','Não') 
                         from catal.representantes r 
                         where r.idrepresentante = fv.idrepresentante) RepresAtivo
                     , fv.valortotal
                     , fv.valorapagar
                     , favorita.pck_util_fav.fnc_calculajurosporvencimento( pidpedido   => fv.idpedido,
                                                                            ppercmulta  => 2,
                                                                            ppercjuros  => 1) valoratualizado
                     , fv.idrepresentante
                     , fv.representante
                     , pck_romance.fnc_retornatelefones(fv.idvendedora) telefones
                     , fv.situacaocliente "Cliente Ativa"
                     , fv.situacaopagamento
                     , nvl(( select max(dataretorno)
                             from notasvendas nv
                             where nv.idvendedora = fv.idvendedora
                               and nv.idsituacaonotavenda = 3 ),( select max(nv.dataacerto)
                                                                  from notasvendas nv
                                                                  where nv.idvendedora = fv.idvendedora
                                                                    and nv.idsituacaonotavenda = 4 )) retorno
                     , nvl( ( select 'S'
                              from dual
                              where ( select count(1)
                                      from notasvendas nv
                                      where nv.datanota <= fv.dataemissao
                                        and nv.idvendedora = fv.idvendedora ) = 1 ),'N') abertura
                     , nvl( ( select 'S'
                              from dual
                              where ( select count(1)
                                      from notasvendas nv
                                      where nv.idvendedora = fv.idvendedora
                                        and nv.idsemanacobranca - nv.idsemanadistribuicao > 6 ) >= 1 ),'N') remarcada
                     , nvl( ( select 'S'
                              from favorita.classificacoespedidos cp
                              where cp.idpedido = fv.idpedido 
                                and cp.idcaracteristicapedido = 100 ),'N' ) impressao_errada
                from favorita.vw_pedidos_fav_new fv
                where trunc(fv.datavencimentomenor) between to_date(:P191_DATAINICIO) and to_date(:P191_DATAFIM) 
                  and fv.idfilialromance = :P0_IDFILIAL
                  and (:P191_REPRESENTANTE is null or :P191_REPRESENTANTE = fv.idrepresentante)
                  and ( :P191_SITUACAO_CONSULTORA is null or (:P191_SITUACAO_CONSULTORA = 'A' or exists ( select 1
                                                                    from vendedoras v
                                                                    where v.idvendedora = fv.idvendedora
                                                                      and v.ativo       = :P191_SITUACAO_CONSULTORA )  ) )
                  and ( :P191_SITUACAO_ROMANCE = 'A' 
                     or ( :P191_SITUACAO_ROMANCE = 'S' and exists ( select 1
                                                                    from notasvendas nv
                                                                    where nv.idvendedora         = fv.idvendedora
                                                                      and nv.idsituacaonotavenda = 3 ) )
                     or ( :P191_SITUACAO_ROMANCE = 'N' and not exists ( select 1
                                                                        from notasvendas nv
                                                                        where nv.idvendedora         = fv.idvendedora
                                                                          and nv.idsituacaonotavenda = 3 ) ) )
                  and exists ( select 1
                               from favorita.vencimentospedidos vp
                               where vp.situacaovencimento    = 'V'
                                 and vp.idpedido              = fv.idpedido
                                 and trunc(vp.datavencimento) < trunc(sysdate)
                                 and nvl(vp.valorpago,0)      < vp.valorpagar )    
                  and fv.datacancelamento is null
                  and not exists ( select 1
                                   from favorita.parcelamentospedidos pc
                                   where pc.idpedido              = fv.idpedido )
                  -- Maicon Aimi - 22/10/2025 - Projeto Melhorias Menu Favorita
                  and favorita.pck_pedidos_fav.fnc_situacaopagamentoped(fv.idpedido) not in ('Pago com Juros','Incobravel')
                ```
            pageItemsToSubmit: [
                P191_REPRESENTANTE
                P191_DATAINICIO
                P191_DATAFIM
            ]
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P191_TIPO_RELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 767009789744110202
        }

