    region débitos-clientes-sistema-novo-2 (
        name: Débitos clientes Sistema Novo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(fv.idrepresentante) representante
                     , count(distinct fv.idpedido) qtdpedidos
                     , sum(fv.valortotal) valortotal
                     , sum(fv.valorapagar) valorapagar
                     , sum((favorita.pck_util_fav.fnc_calculajurosporvencimento( pidpedido   => fv.idpedido,
                                                                            ppercmulta  => 2,
                                                                            ppercjuros  => 1) )) valoratualizado 
                from favorita.vw_pedidos_fav_new fv
                where trunc(fv.datavencimentomenor) between to_date(:P191_DATAINICIO) and to_date(:P191_DATAFIM)
                  and fv.idfilialromance = :P0_IDFILIAL
                  and ( :P191_REPRESENTANTE is null or :P191_REPRESENTANTE = fv.idrepresentante)
                  and ( :P191_SITUACAO_CONSULTORA is null or (:P191_SITUACAO_CONSULTORA = 'A' or exists ( select 1
                                                                    from vendedoras v
                                                                    where v.idvendedora = fv.idvendedora
                                                                      and v.ativo       = :P191_SITUACAO_CONSULTORA ) ))
                  and ( :P191_SITUACAO_ROMANCE = 'A' 
                     or ( :P191_SITUACAO_ROMANCE = 'S' and exists ( select 1
                                                                    from notasvendas nv
                                                                    where nv.idvendedora         = fv.idvendedora
                                                                      and nv.idsituacaonotavenda = 3 ) )
                     or ( :P191_SITUACAO_ROMANCE = 'N' and not exists ( select 1
                                                                        from notasvendas nv
                                                                        where nv.idvendedora         = fv.idvendedora
                                                                          and nv.idsituacaonotavenda = 3 ) ) )
                  and exists ( select 1
                               from favorita.vencimentospedidos vp
                               where vp.situacaovencimento    = 'V'
                                 and vp.idpedido              = fv.idpedido
                                 and trunc(vp.datavencimento) < trunc(sysdate)       
                                 and nvl(vp.valorpago,0)      < vp.valorpagar )    
                  and fv.datacancelamento is null
                  and not exists ( select 1
                                   from favorita.parcelamentospedidos pc
                                   where pc.idpedido              = fv.idpedido )
                  -- Maicon Aimi - 22/10/2025 - Projeto Melhorias Menu Favorita
                  and favorita.pck_pedidos_fav.fnc_situacaopagamentoped(fv.idpedido) not in ('Pago com Juros','Incobravel')
                group by idrepresentante
                ```
            pageItemsToSubmit: [
                P191_REPRESENTANTE
                P191_DATAINICIO
                P191_DATAFIM
            ]
        }
        layout {
            sequence: 30
            slot: body-3
        }
