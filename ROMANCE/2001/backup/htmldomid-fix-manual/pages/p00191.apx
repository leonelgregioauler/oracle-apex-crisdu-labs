            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: P191_FILTRAR
        }
    )

    branch (
        name: filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 191
                items: {
                    P191_REPRESENTANTE: &P191_REPRESENTANTE.
                    P191_DATAINICIO: &P191_DATAINICIO.
                    P191_DATAFIM: &P191_DATAFIM.
                    P191_TIPO_RELATORIO: &P191_TIPO_RELATORIO.
                    P191_SITUACAO_CONSULTORA: &P191_SITUACAO_CONSULTORA.
                    P191_SITUACAO_ROMANCE: &P191_SITUACAO_ROMANCE.
                }
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @p191-filtrar
        }
    )

)

