            regionDisplaySelector: true
        }
    )

    region manutenções-pagas (
        name: Manutenções Pagas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idmanutencao
                     , ( select e.numeroserie||' - '||e.nome
                         from equipamentos e
                         where e.idequipamento = m.idequipamento ) "Equipamento"
                     , s.descricao
                     , valorservico
                     , nvl(( select sum(p.valorpago)
                         from pagamentosmanutencoes p
                         where p.idmanutencao = m.idmanutencao ),0) "Valor Pago"
                     , valorservico
                     - nvl(( select sum(p.valorpago)
                         from pagamentosmanutencoes p
                         where p.idmanutencao = m.idmanutencao ),0) "Pendente"
                     , pck_romance.fnc_nomerepresentante(idrepresentante) "Representante"
                     , idchamado
                     , ( select c.dataatendido from chamados c where c.idchamado = m.idchamado ) data
                     , cobrar
                     , Motivo
                     , Cuidados
                from manutencoesrealizadas m
                   , servicosmanutencao s
                where s.idservicomanutencao = m.idservico
                  and nvl(m.cobrar,'S') = 'S'
                  and valorservico
                     - nvl(( select sum(p.valorpago)
                         from pagamentosmanutencoes p
                         where p.idmanutencao = m.idmanutencao ),0) = 0
                  and pck_romance.fnc_filialrepresentante(m.idrepresentante) = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P224_TIPO
            value: M
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma manutenção paga.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 100
        }
        advanced {
            savedReportMappingIdentifier: 39608137289460106
        }

