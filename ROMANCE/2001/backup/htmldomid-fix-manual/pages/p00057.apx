    process fetch-row-from-movimentosestoquevend (
        name: Fetch Row from MOVIMENTOSESTOQUEVEND
        type: autoRowFetch
        source {
            tableName: MOVIMENTOSESTOQUEVEND
            pkColumn: IDMOVTOESTVEND
            pkItem: P57_IDMOVTOESTVEND
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 21962887728420989
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vid            number;
                  videstrepres   number;
                  vidmovtorepres number;
                  vteste varchar2(300);
                  --
                  vparametro  varchar2(1);
                begin 
                  --
                  select pck_romance.fnc_retornaparametro ( parametro => 'ESTOQUEPORGRADE'
                                                          , pidfilial => :P0_IDFILIAL)
                  into vparametro
                  from dual;
                  --
                  select seq_idmovtoestoquevendedora.nextval
                  into vid
                  from dual;
                  --
                  begin
                    select e.idestoquevendedora
                    into :P57_IDESTOQUEVENDEDORA
                    from estoquevendedora e
                    where idvendedora   = :P57_IDVENDEDORA
                      and idestoquefil  = :P57_IDESTOQUEFIL;
                  exception
                    when no_data_found then
                      --
                      select seq_idestoquevendedora.nextval
                      into :P57_IDESTOQUEVENDEDORA
                      from dual;
                      --
                      insert into estoquevendedora ( idestoquevendedora    , idvendedora   , idestoquefil
                                                   , quantidade              
                                                   , qtd_pp            , qtd_p             , qtd_m   
                                                   , qtd_g             , qtd_gg            , qtd_egg 
                                                   , qtd_u  ) 
                      values ( :P57_IDESTOQUEVENDEDORA , :P57_IDVENDEDORA , :P57_IDESTOQUEFIL
                             , 0                       
                             , 0                       , 0                , 0
                             , 0                       , 0                , 0
                             , 0      );      
                      --
                  end;
                  --
                  select seq_idmovtoestoquevendedora.nextval
                  into vid
                  from dual;
                  --
                  select seq_idmovtoestoquerepres.nextval
                  into vidmovtorepres
                  from dual;
                  --
                  select e.idestoquerepresentante
                  into videstrepres
                  from estoquerepresentante e
                  where idrepresentante = :P57_IDREPRESENTANTE
                    and idestoquefil    = :P57_IDESTOQUEFIL;
                  --
                  if vparametro = 'S' then
                    --
                    insert into movimentosestoquerepres ( idmovtoestrepres   , idrepresentante  , idestoquefil
                                                        , iditnotavenda      , observacao
                                                        , usuario            , datamovimento    , idestoquerepresentante
                                                        , idtransfprodrepres  
                                                        , qtd_pp            , qtd_p             , qtd_m   
                                                        , qtd_g             , qtd_gg            , qtd_egg 
                                                        , qtd_u  ) 
                    values ( vidmovtorepres                 , :P57_IDREPRESENTANTE   , :P57_IDESTOQUEFIL
                           , NULL                           , :P57_OBSERVACAO
                           , v('APP_USER')                  , sysdate                , videstrepres
                           , null  
                          , TO_NUMBER(:P57_qtd_pp)*-1       , TO_NUMBER(:P57_qtd_p)*-1             , TO_NUMBER(:P57_qtd_m )*-1  
                          , TO_NUMBER(:P57_qtd_g)*-1        , TO_NUMBER(:P57_qtd_gg )*-1           , TO_NUMBER(:P57_qtd_egg )*-1
                          , TO_NUMBER(:P57_qtd_u)*-1  );  
                    --
                    insert into movimentosestoquevend ( idmovtoestvend  , idvendedora   , idestoquefil
                                                      , iditnotavenda , observacao
                                                      , usuario         , datamovimento , idestoquevendedora 
                                                        , qtd_pp            , qtd_p             , qtd_m   
                                                        , qtd_g             , qtd_gg            , qtd_egg 
                                                        , qtd_u  ) 
                    values ( vid                 , :P57_IDVENDEDORA  , :P57_IDESTOQUEFIL
                           , null                , :P57_OBSERVACAO
                           , v('APP_USER')       , sysdate           , :P57_IDESTOQUEVENDEDORA
                           , TO_NUMBER(:P57_QTD_PP)        , TO_NUMBER(:P57_QTD_P)             , TO_NUMBER(:P57_QTD_M )  
                           , TO_NUMBER(:P57_QTD_G)         , TO_NUMBER(:P57_QTD_GG )           , TO_NUMBER(:P57_QTD_EGG ) 
                           , TO_NUMBER(:P57_QTD_U)  );   
                    --
                  else
                    --
                    insert into movimentosestoquerepres ( idmovtoestrepres   , idrepresentante  , idestoquefil
                                                        , quantidade         , iditnotavenda    , observacao
                                                        , usuario            , datamovimento    , idestoquerepresentante
                                                        , idtransfprodrepres  ) 
                    values ( vidmovtorepres                    , :P57_IDREPRESENTANTE   , :P57_IDESTOQUEFIL
                           , TO_NUMBER(:P57_QUANTIDADE)*-1     , NULL                   , :P57_OBSERVACAO
                           , v('APP_USER')                     , sysdate                , videstrepres
                           , null );  
                    --
                    insert into movimentosestoquevend ( idmovtoestvend  , idvendedora   , idestoquefil
                                                      , quantidade      , iditnotavenda , observacao
                                                      , usuario         , datamovimento , idestoquevendedora )
                    values ( vid                 , :P57_IDVENDEDORA  , :P57_IDESTOQUEFIL
                           , :P57_QUANTIDADE     , null              , :P57_OBSERVACAO
                           , v('APP_USER')       , sysdate           , :P57_IDESTOQUEVENDEDORA);
                    
                    --
                  end if;
                  --
                exception
                  when others then
                    vteste := sqlerrm;
                    raise_application_error(-20101, vteste);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Estoque movimentado com sucesso!
        }
        error {
            errorMessage: Ocorreu um erro ao tentar movimentar estoque! Contate o Administrador!
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 21963064011420990
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

