page 97 (
    name: Vendas Romance x Favorita
    title: Vendas Romance x Favorita
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region vendas-romance-x-favorita (
        name: Vendas Romance x Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial( f.idfilial ) "Filial"
                     , f.semana
                     , substr(f.semana,4,4) "Ano"
                     , f.totalcobranca "Total Cobrança"
                     , ( select sum(p.vlrtotalsemcomissao) 
                         from pedidos p
                         where trim(to_char(p.dtemissao,'IW/RRRR')) = trim(f.semana)
                           and p.situacao != 'Z'
                           and p.tipo      = 'P' --pedidos
                           and p.idgerente = ( select idgerente
                                               from gerentes g
                                               where g.idfilial = f.idfilial ) )  "Total Venda Favorita"
                     , decode(nvl(f.totalcobranca, 0), 0,0, ( ( select sum(p.vlrtotalsemcomissao) 
                                                                from pedidos p
                                                                where trim(to_char(p.dtemissao,'IW/RRRR')) = trim(f.semana)
                                                                  and p.situacao != 'Z'
                                                                  and p.tipo      = 'P' --pedidos
                                                                  and p.idgerente = ( select idgerente
                                                                                      from gerentes g
                                                                                      where g.idfilial = f.idfilial ) ) *100 / f.totalcobranca)  ) "% Venda Favorita"
                from fechamentossemanais f
                where f.idfilial = :P0_IDFILIAL 
                order by 1, f.idfechamento
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
