        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Pendente de Recebimento' d
                     , 'A' r
                from dual 
                union
                select 'Parcialmente Recebida' d
                     , 'P'
                from dual
                where pck_romance.fnc_retornaparametro('RECEBIMENTOPARCIALCOMPRA',:P0_IDFILIAL) = 'S'
                union
                select 'Recebida' d
                     , 'R' r
                from dual
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
