    button busca-nota-ti (
        buttonName: BUSCA_NOTA_TI
        label: Busca Nota T.I
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
            startNewRow: false
            column: 4
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from roman.usuariosgruposatendimento u
                 where u.idgrupoatendimento = 0
                   and u.usuario = v('APP_USER');
                ```
        }
        comments {
            comments: Criado por Maicon Aimi em 20/05/2025
        }
    )

    button create (
        buttonName: CREATE
        label: Nova Nota Fiscal
        layout {
            sequence: 30
            region: @recebimento-de-compras
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 27
                clearCache: 27
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-busca (
        name: Tipo Busca
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P22_TIPONOTA
        }
        clientSideCondition {
            type: item=value
            item: P22_TIPONOTA
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P22_IDFORNECEDOR
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P22_IDFILIALEMITENTE
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P22_IDFORNECEDOR
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P22_IDFILIALEMITENTE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        name: Go To Page 25 (Busca Nota T.I)
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 25
                items: {
                    P25_IDNOTAFISCAL: &P22_IDNOTAFISCAL.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @busca-nota-ti
        }
    )

    branch (
        name: Go To Page 22
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 22
                items: {
                    P22_TIPODATA: &P22_TIPODATA.
                    P22_TIPONOTA: &P22_TIPONOTA.
                    P22_IDFORNECEDOR: &P22_IDFORNECEDOR.
                    P22_IDFILIALEMITENTE: &P22_IDFILIALEMITENTE.
                    P22_NUMERONF: &P22_NUMERONF.
                    P22_DATAINICIO: &P22_DATAINICIO.
                    P22_DATAFIM: &P22_DATAFIM.
                    P22_SITUACAO: &P22_SITUACAO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

