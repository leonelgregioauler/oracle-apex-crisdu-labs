    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color="blue"><h3>
                    *** Utilize o filtro de datas para buscar os recebimentos de compras, atente-se em verificar se é pela data de emissão ou recebimento da compra. ***
                    </h3></font>
                ```
        }
    )

    region parcialmente-recebido (
        name: Parcialmente Recebido
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select nf.semananota
                     , nf.idsemananota
                     , count(1) qtd
                from notasfiscais nf
                where nf.idfilialdestino = :P0_IDFILIAL
                  and nf.situacaofilial = 'P'
                group by semananota,idsemananota
                ORDER BY idsemananota
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_romance.fnc_retornaparametro('RECEBIMENTOPARCIALCOMPRA',:P0_IDFILIAL) = 'S'
                  and exists ( select 1
                               from notasfiscais n
                               where n.idfilialdestino = :P0_IDFILIAL 
                                 and n.situacaofilial = 'P' )
                ```
        }
        settings {
            labelColumn: SEMANANOTA
            valueColumn: QTD
        }
    )

    region recebimento-de-compras (
        name: Recebimento de Compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.IDNOTAFISCAL
                     , trim(to_char(nf.dtnf,'RRRR')) "Ano"
                     , trim(to_char(nf.dtnf,'IW')||'/'||to_char(nf.dtnf,'RRRR')) Semana
                     , nf.nrnf 
                     , decode( nf.tiponota, 'T', 'Transferência'
                                          , 'C', 'Compra'
                                          , 'I', 'Insumos') "Tipo NF"
                     , decode( nf.tiponota, 'T', ( select initcap(pe.nomepessoa)
                                                          from filiais         fe
                                                             , pessoas         pe
                                                          where fe.idpessoa  = pe.idpessoa 
                                                            and fe.idfilial  = nf.idfilialemitente  )
                                          , 'I', nvl(( select initcap(pe.nomepessoa)
                                                          from filiais         fe
                                                             , pessoas         pe
                                                          where fe.idpessoa  = pe.idpessoa 
                                                            and fe.idfilial  = nf.idfilialemitente  ),( select initcap(pe.nomepessoa)
                                                                                                        from Fornecedores         fe
                                                                                                           , pessoas         pe
                                                                                                        where fe.idpessoa  = pe.idpessoa 
                                                                                                          and fe.idfornecedor  = nf.idfornemitente  ))
                                          , 'C', ( select initcap(pe.nomepessoa)
                                                   from Fornecedores         fe
                                                      , pessoas         pe
                                                   where fe.idpessoa  = pe.idpessoa 
                                                     and fe.idfornecedor  = nf.idfornemitente  ) ) Emitente
                     , nvl(( select initcap(r.razaosocial)
                         from razoessociaisfiliais r
                         where r.idrazaosocialfilial = nf.idrazaosocialfildestino ),pck_romance.fnc_nomefilial(idfilialdestino)) "Filial Destino"
                     , ( select initcap(pt.apelido)
                         from transportadoras t
                            , pessoas         pt
                         where t.idpessoa         = pt.idpessoa
                           and nf.idtransportadora = t.idtransportadora )  "Transportadora"
                     , nf.dtnf 
                     , decode(NF.SITUACAO,'A','Ativa','C','Cancelada','Ativa') Situacao
                     , nf.documento 
                     , decode(nf.situacaofilial, 'R', 'Recebido', 'A','Pendente de Recebimento','P','Parcialmente Recebida') "Situação"
                     , nf.conhecimentotransporte "CTE"
                     , nf.datarecebimento "Data Recebimento"
                     , nf.dataconfirmacao "Data Confirmação"
                     , trunc(sysdate) - trunc(nf.dtnf) "Dias em Aberto"
                     , (select (select pck_romance.fnc_nomecidade(p.idcidade)
                                from pessoas p
                                where p.idpessoa = f.idpessoa)
                        from fornecedores f
                        where f.idfornecedor = nf.idfornemitente) "Cidade Fornecedor" 
                     , ( select n.usuarioalteracao
                         from logroman.log_notasfiscais n
                         where n.idnotafiscal = nf.idnotafiscal
                           and n.tipoalteracao = 'UPDATE'
                           and n.situacaofilial = 'R'
                           and n.emailrecebimento = 'S' 
                           and n.dataalteracao = n.dataconfirmacao
                           and rownum = 1 ) "Usuário Recebeu"
                      , nf.valortotal
                      , (select lg.usuarioalteracao from logroman.log_notasfiscais lg where lg.tipoalteracao='INSERT' and lg.idnotafiscal = nf.idnotafiscal and rownum=1) "usuarioCriacao"
                      , (select lg.dataalteracao from logroman.log_notasfiscais lg where lg.tipoalteracao='INSERT' and lg.idnotafiscal = nf.idnotafiscal and rownum=1) "dataCriacao"
                      , nf.volumes
                from notasfiscais nf
                where nf.idfilialdestino = :P0_IDFILIAL
                  and nf.situacao  != 'C'
                  and nf.situacaofilial is not null
                  and nf.tiponota in ('C','T','A')
                  and ( :P22_SITUACAO is null or nf.situacaofilial = :P22_SITUACAO )
                  and exists ( select 1
                               from itemnf i
                                  , produtos p
                               where i.idnotafiscal = nf.idnotafiscal
                                 and i.idproduto    = p.idproduto
                                 and p.venda        = 'S' 
                                 and p.idproduto   != 21359 )
                  and ( :P22_TIPODATA is null
                     or ( :P22_TIPODATA = 'E' and trunc(nf.datainclusao) between to_date(:P22_DATAINICIO) and to_date(:P22_DATAFIM) ) 
                     or ( :P22_TIPODATA = 'R' and trunc(nf.datarecebimento) between to_date(:P22_DATAINICIO) and to_date(:P22_DATAFIM) ) )
                  and ( :P22_TIPONOTA = 'Z' 
                     or ( :P22_TIPONOTA in ('C','I') and ( :P22_IDFORNECEDOR is null or nf.idfornemitente = :P22_IDFORNECEDOR ) and nf.tiponota = :P22_TIPONOTA ) 
                     or ( :P22_TIPONOTA in ( 'T','A') and ( :P22_IDFILIALEMITENTE is null or nf.idfilialemitente = :P22_IDFILIALEMITENTE ) and nf.tiponota = :P22_TIPONOTA ) )
                  and ( :P22_NUMERONF is null or nf.documento like '%'||:P22_NUMERONF||'%' )
                  and :P22_TIPODATA is not null
                order by 2, nf.dtnf desc
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 25
                items: {
                    P25_IDNOTAFISCAL: #IDNOTAFISCAL#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Não há notas recebidas ou há receber.
            whenMoreDataFound: This query returns more than 10,000 rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
