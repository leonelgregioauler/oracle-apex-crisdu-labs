    pageItem P22_IDFILIALEMITENTE (
        type: selectList
        label {
            label: Filial Emitente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(pe.nomepessoa) display_value
                     , fe.idfilial return_value
                from filiais         fe
                   , pessoas         pe
                where fe.idpessoa  = pe.idpessoa 
                  and fe.ativo = 'S'
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P22_IDFORNECEDOR (
        type: selectList
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(pe.nomepessoa) display_value
                     , fe.idfornecedor return_value
                from Fornecedores         fe
                   , pessoas         pe
                where fe.idpessoa  = pe.idpessoa 
                  and exists ( select 1
                               from notasfiscais nf
                               where nf.idfilialdestino = :P0_IDFILIAL
                                 and nf.idfornemitente  = fe.idfornecedor )
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

