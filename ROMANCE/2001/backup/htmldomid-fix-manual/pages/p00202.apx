    pageItem P202_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(s.semana,'00')||'/'||to_char(s.ano)) display_value
                     , s.idsemana return_value
                from semana_dias s
                where s.idsemana between 534 and 794
                order by s.idsemana desc
                ```
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

