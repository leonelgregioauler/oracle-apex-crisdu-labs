    region devoluções-detalhadas (
        name: Devoluções Detalhadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) as Representante
                     , pck_util.fnc_semanaid(d.idsemana) as Semana
                     , pck_romance.fnc_nomefilial(idfilial) as Filial
                     , decode(i.estoquedestino,'R','Reembalagem'
                                              ,'P','Posto avançado'
                                              ,'D','Distribuição'
                                              ,'F','Defeito', estoquedestino) as "Estoque destino"
                     , pck_romance.fnc_nomeproduto(i.idproduto) as Produto
                     , sum(nvl(i.qtd_pp,0)) qtdpp
                     , sum(nvl(i.qtd_p,0)) qtdp
                     , sum(nvl(i.qtd_m,0)) qtdm
                     , sum(nvl(i.qtd_g,0)) qtdg
                     , sum(nvl(i.qtd_gg,0)) qtdgg
                     , sum(nvl(i.qtd_egg,0)) qtdegg
                     , sum(nvl(i.qtd_exgg,0)) qtdexgg
                     , sum(nvl(i.qtd_u,0)) qtdu
                     , sum( nvl(i.qtd_pp,0)
                          + nvl(i.qtd_p,0)
                          + nvl(i.qtd_m,0)
                          + nvl(i.qtd_g,0)
                          + nvl(i.qtd_gg,0)
                          + nvl(i.qtd_egg,0)
                          + nvl(i.qtd_exgg,0)
                          + nvl(i.qtd_u,0) ) Quantidade                        
                from devolucoesrepresentantes d
                   , itensdevolucaorepres i
                where d.iddevolucaorepres = i.iddevolucaorepres
                  and d.IDREPRESENTANTE is not null
                  and d.IDFILIAL = :P0_IDFILIAL
                  and ( :P202_TIPOPESQUISA is null 
                     or ( :P202_TIPOPESQUISA = 'S' and d.idsemana = :P202_SEMANA )
                     or ( :P202_TIPOPESQUISA = 'I' and trunc(d.datainclusao) between to_date(:P202_DATAINICIO) and to_date(:P202_DATAFIM) )
                     or ( :P202_TIPOPESQUISA = 'C' and trunc(d.dataconclusao) between to_date(:P202_DATAINICIO) and to_date(:P202_DATAFIM) ) )
                  and ( :P202_DESTINO = 'D' and i.estoquedestino = 'D'
                     or ( :P202_DESTINO = 'R' and i.estoquedestino = 'R' )
                     or ( :P202_DESTINO = 'P' and i.estoquedestino = 'P' )
                     or ( :P202_DESTINO = 'F' and i.estoquedestino = 'F' ) )
                  and ( :P202_SEMANA is not null or :P202_DATAINICIO is not null or :P202_DATAFIM is not null )
                group by d.idrepresentante, d.idsemana ,d.idfilial, i.estoquedestino, i.idproduto
                order by 1 
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
