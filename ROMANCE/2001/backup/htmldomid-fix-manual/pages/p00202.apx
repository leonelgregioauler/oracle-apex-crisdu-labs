        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P202_TIPORELATORIO (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Detalhado;D,Resumido;R
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 80
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-data (
        name: Tipo Data
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P202_TIPOPESQUISA
        }
        clientSideCondition {
            type: item!=value
            item: P202_TIPOPESQUISA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P202_SEMANA
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P202_DATAINICIO
                    P202_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-semana (
        name: Tipo Semana
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P202_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P202_TIPOPESQUISA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P202_DATAINICIO
                    P202_DATAFIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P202_SEMANA
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 202
                items: {
                    P202_DESTINO: &P202_DESTINO.
                    P202_SEMANA: &P202_SEMANA.
                    P202_TIPORELATORIO: &P202_TIPORELATORIO.
                    P202_TIPOPESQUISA: &P202_TIPOPESQUISA.
                    P202_DATAINICIO: &P202_DATAINICIO.
                    P202_DATAFIM: &P202_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

