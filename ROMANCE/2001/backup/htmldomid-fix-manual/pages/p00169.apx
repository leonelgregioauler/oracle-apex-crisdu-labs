    region notas-para-atualizar (
        name: Notas para atualizar
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , to_number(nv.numeronota) "Nr Nota"
                     , pck_romance.fnc_nomerepresentante(pidrepresentante => nv.idrepresentante) "Representante"
                     , nv.semanadistribuicao/*||'  '||pck_romance.fnc_semanadias(psemana => nv.semanadistribuicao)*/ "Semana Distribuição"
                     , nv.semanacobranca/*||'  '||pck_romance.fnc_semanadias(psemana => nv.semanacobranca)*/ "Semana Cobrança"
                     , pck_romance.fnc_nomevendedora(pidvendedora => nv.idvendedora) "Vendedora"
                     , ( select rv.descricao from regioesvenda rv where rv.idregiaovenda = nv.idregiaovenda ) "Região de Venda"
                     , ( select sn.descricao from situacoesnotavenda sn where sn.idsituacaonotavenda = nv.idsituacaonotavenda ) "Situação"
                     , nv.dataretorno
                     , substr(nv.semanacobranca,1,2) semanacobranca
                     , substr(nv.semanacobranca,4,4) anocobranca
                     , pck_romance.fnc_nomecidade(pck_romance.fnc_idcidadevendedora(nv.idvendedora)) "Cidade Cliente"
                from notasvendas    nv
                where (:P169_TIPO in ('R','M') 
                       and semanacobranca  = trim(:P169_SEMANAATUAL)
                       and idregiaovenda   = :P169_IDREGIAOVENDA
                       and (idrepresentante = :P169_IDREPRESENTANTE 
                          or  idrepresentanteatende = :P169_IDREPRESENTANTE )
                       and idsituacaonotavenda != 4)
                   or (:P169_TIPO = 'D' and idregiaovenda   = :P169_IDREGIAOVENDA
                       and nv.idsituacaonotavenda = 4
                       and nv.saldo > 0 
                       and nv.idrepresentante = :P169_IDREPRESENTANTE)
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
