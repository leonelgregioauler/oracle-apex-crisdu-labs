    process altera (
        name: altera
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P169_TIPO = 'R' then
                    --
                    for i in ( select idnotavenda
                                    , idvendedora
                               from notasvendas 
                               where semanacobranca  = :P169_SEMANAATUAL
                                 and idregiaovenda   = :P169_IDREGIAOVENDA
                                 and (idrepresentante = :P169_IDREPRESENTANTE 
                                  or  idrepresentanteatende = :P169_IDREPRESENTANTE )
                                 and idsituacaonotavenda != 4 )
                    loop
                      --
                      update notasvendas
                      set semanacobranca = :P169_SEMANANOVA
                      where idnotavenda = i.idnotavenda;
                      --
                      insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao,idrepresentante)
                      values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Nota remarcada da semana: '||:P169_SEMANAATUAL||' para a semana: '||:P169_SEMANANOVA,i.idnotavenda,'C',:P169_IDREPRESENTANTE);
                    --
                    end loop;
                    --
                  elsif :P169_TIPO = 'M' then
                    --
                    for i in ( select idnotavenda
                                    , idvendedora
                               from notasvendas 
                               where semanacobranca  = :P169_SEMANAATUAL
                                 and idregiaovenda   = :P169_IDREGIAOVENDA
                                 and idrepresentante = :P169_IDREPRESENTANTE )
                    loop
                      --
                      update notasvendas
                      set idrepresentanteatende = :P169_IDREPRESENTANTEATENDE
                      where idnotavenda = i.idnotavenda;
                      --
                      update vendedoras 
                      set idrepresentante = nvl(:P169_IDREPRESENTANTEATENDE ,:P169_IDREPRESENTANTE)
                        , idregiaovenda   = :P169_IDREGIAOVENDA
                      where idvendedora = i.idvendedora;
                      --
                      insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao,idrepresentante)
                      values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Nota marcada para o distribuidor: '||pck_romance.fnc_nomerepresentante(nvl(:P169_IDREPRESENTANTEATENDE ,:P169_IDREPRESENTANTE))||' realizar o atendimento',i.idnotavenda,'C',:P169_IDREPRESENTANTE);
                      --
                    end loop;
                    --
                  else
                    --
                    for i in ( select idnotavenda
                                    , idvendedora
                               from notasvendas 
                               where idregiaovenda   = :P169_IDREGIAOVENDA
                                 and idrepresentante = :P169_IDREPRESENTANTE 
                                 and saldo > 0
                                 and idsituacaonotavenda = 4 )
                    loop 
                      --
                      update notasvendas
                      set idrepresentanteatende = :P169_IDREPRESENTANTEATENDE
                      where idnotavenda = i.idnotavenda;
                      --
                      update vendedoras 
                      set idrepresentante = nvl(:P169_IDREPRESENTANTEATENDE ,:P169_IDREPRESENTANTE)
                      where idvendedora   = i.idvendedora;
                      --
                      insert into correcoesnotasvendas(idcorrecaonotavenda,datacorrecao,usuario,motivo,idnotavenda,situacao,idrepresentante)
                      values (seq_idcorrecaonotavenda.nextval,sysdate,v('APP_USER'),'Débito marcado para o distribuidor: '||pck_romance.fnc_nomerepresentante(:P169_IDREPRESENTANTEATENDE)||' realizar o atendimento',i.idnotavenda,'C',:P169_IDREPRESENTANTE);
                      --
                    end loop;
                    --
                  end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Notas atualizadas.
        }
        advanced {
            executionMappingIdentifier: 768232758984906163
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 169
                items: {
                    P169_IDREGIAOVENDA: &P169_IDREGIAOVENDA.
                    P169_IDREPRESENTANTEDESTINO: &P169_IDREPRESENTANTEDESTINO.
                    P169_IDREPRESENTANTE: &P169_IDREPRESENTANTE.
                    P169_SEMANAATUAL: &P169_SEMANAATUAL.
                    P169_SEMANANOVA: &P169_SEMANANOVA.
                }
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
        comments {
            comments: Created 22-MAR-2013 17:57 by ROMAN
        }
    )

)

