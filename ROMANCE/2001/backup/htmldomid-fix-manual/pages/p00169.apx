        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante) display_value
                     , r.idrepresentante
                from representantes r
                where pck_romance.fnc_filialgerente(pidgerente => r.idgerente) = :P0_IDFILIAL
                  and r.ativo  = 'S'
                  and r.idrepresentante != :P169_IDREPRESENTANTE
                order by 1 
                ```
