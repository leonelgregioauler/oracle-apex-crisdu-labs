    pageItem P169_IDREGIAOVENDA (
        type: selectList
        label {
            label: Região de Venda
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeregiaovenda(r.idregiaovenda)||' - '||SEMANA display_value
                     , idregiaovenda return_value
                from regioesrepresentantes r
                where idrepresentante = :P169_IDREPRESENTANTE
                order by ordem
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P169_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            region: @remarcar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P169_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||r.idrepresentante||')' || decode(r.ativo,'S','','Inativo') display_value
                     , r.idrepresentante
                from representantes r
                where idgerente in ( select idgerente
                                     from gerentes
                                     where idfilial = :P0_IDFILIAL)
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o Distribudior -
        }
        layout {
            sequence: 10
            region: @remarcar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P169_IDREPRESENTANTEATENDE (
        type: selectList
