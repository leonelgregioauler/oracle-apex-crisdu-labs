    dynamicAction mostra-filtros-extras-vendedoras (
        name: Mostra filtros extras Vendedoras
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P7_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P7_TIPO
            value: V
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P7_IDREPRESENTANTE
                    P7_VENDEDORATIVA
                    P7_VENDEDORATEMDEBITO
                    P7_DEBITOFAVORITA
                    P7_NOTA_EM_ABERTO
                    P7_DATAULTINOTA_DE
                    P7_DATAULTINOTA_ATE
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P7_IDREPRESENTANTE
                    P7_VENDEDORATIVA
                    P7_VENDEDORATEMDEBITO
                    P7_DEBITOFAVORITA
                    P7_NOTA_EM_ABERTO
                    P7_DATAULTINOTA_DE
                    P7_DATAULTINOTA_ATE
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

