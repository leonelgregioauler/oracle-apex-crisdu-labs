        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            nullDisplayValue: Ambos
            nullReturnValue: T
        }
        layout {
            sequence: 200
            region: @pessoas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P7_REGIAOVENDA (
        type: selectList
        label {
            label: Região de Venda
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(r.descricao) display_value
                     , r.idregiaovenda return_value
                from regioesvenda r
                where exists ( select 1
                               from filiaisregioesvenda f
                               where f.idfilial = :P0_IDFILIAL
                                 and f.idestado = r.idestado )
                order by 1
                ```
            nullDisplayValue: - Todas Regiões -
            nullReturnValue: -1
        }
        layout {
            sequence: 210
            region: @pessoas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: static
            staticValue: -1
        }
        security {
            encryptSessionState: false
        }
    )

