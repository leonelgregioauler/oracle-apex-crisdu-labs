            displayColumn DOCUMENTOESTRANGEIRO (
                sequence: 4
            )

            displayColumn "Doc Recebidos" (
                sequence: 7
            )

            displayColumn "Hist. Pontos" (
                sequence: 5
            )

            displayColumn NOMECIDADE (
                sequence: 3
            )

            displayColumn NOMEPESSOA (
                sequence: 1
            )

            displayColumn RG (
                sequence: 6
            )

            displayColumn USUARIOS (
                sequence: 8
            )

            sort (
                column: NOMEPESSOA
                sort {
                    sequence: 1
                }
            )

            sort (
                column: FILIAL
                sort {
                    nulls: last
                    sequence: 2
                }
            )

            aggregate (
                function: count
                column: NOMEPESSOA
