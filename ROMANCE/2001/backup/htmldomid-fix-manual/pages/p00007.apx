    pageItem P7_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomecidade(idcidade)  display_value
                     , c.IDCIDADE return_value 
                from CIDADES c
                   , filiaisregioesvenda f
                   , estados e
                where f.idfilial = :P0_IDFILIAL
                  and f.idestado = e.idestado
                  and e.idestado = c.idestado
                order by 1
                ```
            nullDisplayValue: - Selecione a Cidade -
        }
        layout {
            sequence: 80
            region: @pessoas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P7_IDESTADO (
        type: popupLov
        label {
            label: Estado
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nome display_value
                     , e.idestado return_value 
                from filiaisregioesvenda f
                   , estados e
                where f.idfilial = :P0_IDFILIAL
                  and f.idestado = e.idestado
                order by 1
                ```
            nullDisplayValue: - Selecione o Estado -
        }
        layout {
            sequence: 90
            region: @pessoas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P7_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor que Atende
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(pr.nomepessoa||' ( '||nvl(p.apelido,p.nomepessoa)||' )'
                ||' ['||pr.codigosisdist||']') display_value
                     , r.idrepresentante  return_value
                from estados         e
                   , cidades         c
                   , pessoas         p
                   , filiais         f
                   , gerentes        g
                   , representantes  r
                   , pessoas         pr
                where c.idestado  = e.idestado
                  and p.idcidade  = c.idcidade
                  and r.idpessoa  = pr.idpessoa
                  and f.idpessoa  = p.idpessoa
                  and g.idfilial  = f.idfilial
                  and r.idgerente = g.idgerente
                  and g.idfilial  = :P0_IDFILIAL
                  and (:P7_ATIVO = 'A' and r.ativo in ('S','N') or :P7_ATIVO = 'S' and r.ativo = 'S' or :P7_ATIVO = 'N' and r.ativo = 'N')
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P7_ATIVO
        }
        layout {
            sequence: 140
            region: @pessoas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

