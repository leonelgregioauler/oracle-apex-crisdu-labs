    button integracao-em-lote (
        buttonName: INTEGRACAO_EM_LOTE
        label: Integração em Lote
        layout {
            sequence: 40
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 350
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2421,v('APP_USER')) = 'S'
                ```
        }
    )

    dynamicAction mostra-filtro-funcionario (
        name: Mostra filtro funcionario
        execution {
            sequence: 100
        }
        when {
            selectionType: items
            items: P7_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P7_TIPO
            value: F
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P7_CLIENTEFAVORITA
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P7_FUNCIONARIOATIVO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P7_FUNCIONARIOATIVO
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P7_CLIENTEFAVORITA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

