            whenMoreDataFound: Esta consulta retornou mais de 10 mil linhas, por favor, filtre para ter resultados mais precisos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
