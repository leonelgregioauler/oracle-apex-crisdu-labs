    region lista-de-distribuidores (
        name: Lista de Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*FIRST_ROWS(50)*/p.idpessoa
                     , nvl(( select distinct 'Sim' from filiais f where f.idpessoa = p.idpessoa) ,'Não') "Filial"--
                     , nvl(( select distinct 'Sim' from gerentes f where f.idpessoa = p.idpessoa) ,'Não') "Gerente"
                     , r.idrepresentante "Cód. Repres."
                     , nvl(( select distinct 'Sim' from vendedoras f where f.idpessoa = p.idpessoa ),'Não') "Vendedora"
                     , nvl(( select distinct 'Sim' from usuarios f where f.idpessoa = p.idpessoa ),'Não') "Usuário"
                     , nvl(( select distinct 'Sim' from funcionarios f where f.idpessoa = p.idpessoa ),'Não') "Funcionário"
                     , initcap(p.nomepessoa) nomepessoa
                     , initcap(p.apelido) "Nome Abreviado"
                     , cpf CPF
                --     , Decode(cnpj , NULL , NULL
                --                   , REPLACE(REPLACE(REPLACE(To_Char(LPad(REPLACE(cnpj,' ') ,14 ,'0') ,'00,000,000,0000,00') ,',','.') ,' '),'.'||Trim(To_Char(Trunc(Mod(LPad(cnpj,14,'0'),1000000)/100),'0000'))||'.','/'||Trim(To_Char(Trunc(Mod(LPad(cnpj,14,'0') ,1000000)/100) ,'0000'))||'-')) CNPJ
                     , CASE
                          WHEN cnpj IS NULL THEN NULL
                          WHEN LENGTH(REPLACE(REPLACE(REPLACE(cnpj,'.',''),'/',''),'-','')) = 14
                          THEN
                            SUBSTR(REPLACE(REPLACE(REPLACE(cnpj,'.',''),'/',''),'-',''), 1, 2) || '.' ||
                            SUBSTR(REPLACE(REPLACE(REPLACE(cnpj,'.',''),'/',''),'-',''), 3, 3) || '.' ||
                            SUBSTR(REPLACE(REPLACE(REPLACE(cnpj,'.',''),'/',''),'-',''), 6, 3) || '/' ||
                            SUBSTR(REPLACE(REPLACE(REPLACE(cnpj,'.',''),'/',''),'-',''), 9, 4) || '-' ||
                            SUBSTR(REPLACE(REPLACE(REPLACE(cnpj,'.',''),'/',''),'-',''),13, 2)
                          ELSE cnpj
                       END AS CNPJ
                     , cpf "CPF sem Formatação"
                     , p.rg
                     , initcap(p.enderecoprincipal) enderecoprincipal
                     , p.numero
                     , p.cep
                     , initcap(p.enderecosecundario) enderecosecundario
                     , pck_romance.fnc_nomecidade(p.idcidade) nomecidade
                     , lower(p.email) email
                     , datanascimento
                     , p.bairro
                     , nvl(pck_romance.fnc_nomegerente(pidgerente => r.idgerente),null) "Nome Gerente"
                     , ( select count(1) from regioesrepresentantes rr where rr.idrepresentante = r.idrepresentante ) "Qtd Regiões"
                     , decode(r.ativo,'S','Sim','N','Não') "Ativo"
                     , ( select m.cnpj from mei m where m.idpessoa = p.idpessoa and rownum <= 1 ) "CNPJ Mei"
                     , p.documentoestrangeiro
                     , null "Hist. Pontos"
                     , nvl(pck_romance.fnc_nomepostoavancado(r.idpostoavancado),null) postoavancado 
                     ,  pck_mobile.fnc_gerasenhadeacesso_idpes(pidpessoa => p.idpessoa) senha   
                     , ( select usuario from usuarios where idpessoa = p.idpessoa and rownum <= 1 ) usuario
                     , pck_util.fnc_retornatelefones(p.idpessoa) Telefones
                from pessoas p
                   , representantes r
                where r.idpessoa = p.idpessoa
                  and r.idgerente = ( select gg.idgerente
                                      from gerentes gg
                                      where gg.idfilial = :P0_IDFILIAL )
                  and ( :P7_NOME is null or lower(p.nomepessoa) like '%'||lower(replace(:P7_NOME,' ','%' ))||'%')
                  and ( :P7_CPF is null or p.cpf = :P7_CPF)
                  and ( :P7_DOCUMENTOESTRANGEIRO is null or p.documentoestrangeiro = :P7_DOCUMENTOESTRANGEIRO)
                  and ( :P7_ATIVO = 'A' or r.ativo = :P7_ATIVO )
                  and ( :P7_FILTROENDERECO = 'N' 
                     or ( :P7_FILTROENDERECO = 'R' and lower(p.enderecoprincipal) like '%'||lower(replace(:P7_RUA,' ','%' ))||'%' )
                     or ( :P7_FILTROENDERECO = 'B' and lower(p.bairro) like '%'||lower(replace(:P7_BAIRRO,' ','%' ))||'%' )
                     or ( :P7_FILTROENDERECO = 'C' and p.idcidade = :P7_IDCIDADE ) )
                  and ( :P7_REGIAOVENDA = -1 or exists ( select 1
                                                         from regioesrepresentantes rr
                                                         where rr.idrepresentante = r.idrepresentante
                                                           and rr.idregiaovenda   = :P7_REGIAOVENDA ) )
                  and ( :P7_TELEFONE is null or exists ( select 1
                                                         from catal.telefonespessoas t
                                                         where t.idpessoa = p.idpessoa               
                                                           and replace(replace(replace(replace(replace(t.telefone,'(',' '),')',''),'.',''),'-',''),' ')
                                                             = (replace(replace(replace(replace(replace(:P7_TELEFONE,'(',' '),')',''),'.',''),'-',''),' '))))                                   
                       
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P7_TIPO
            value: R
        }
        link {
            linkColumn: customTarget
            target: {
                page: 8
                items: {
                    P8_IDPESSOA: #IDPESSOA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Dados não econtrados. Verifique seu filtro.
            whenMoreDataFound: Esta consulta retornou mais de 10 mil linhas, por favor, filtre para ter resultados mais precisos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1414580379369377214
        }

