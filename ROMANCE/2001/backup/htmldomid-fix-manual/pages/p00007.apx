page 7 (
    name: Lista de Pessoas
    title: Lista de Pessoas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            
            
            function fnc_popup_pontosh(vidvend )
            {njan = window.open('f?p=&APP_ID.:179:&SESSION.::NO::P179_IDVENDEDORA:'+vidvend ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=400,left=250,top=100','_blank'); void(0);
            njan.focus();
            }
            
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 60
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region ações-especiais (
        name: Ações Especiais
        type: staticContent
        layout {
            sequence: 70
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.usuario = v('APP_USER')
                  and ug.idgrupoatendimento in ( 0,56 )
                  and 1 = 2
                ```
        }
    )

    region lista-de-consultoras (
        name: Lista de Consultoras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.*
                from ( select /*FIRST_ROWS(50)*/p.idpessoa
                             , initcap(p.nomepessoa) nomepessoa
                             , cpf CPF
                             --, Decode(cnpj , NULL , NULL
                             --              , REPLACE(REPLACE(REPLACE(To_Char(LPad(REPLACE(cnpj,' ') ,14 ,'0') ,'00,000,000,0000,00') ,',','.') ,' '),'.'||Trim(To_Char(Trunc(Mod(LPad(cnpj,14,'0'),1000000)/100),'0000'))||'.','/'||Trim(To_Char(Trunc(Mod(LPad(cnpj,14,'0') ,1000000)/100) ,'0000'))||'-')) CNPJ
                             , CASE
                                  WHEN cnpj IS NULL THEN NULL
                                  WHEN LENGTH(REPLACE(REPLACE(REPLACE(cnpj,'.',''),'/',''),'-','')) = 14
                                  THEN
                                    SUBSTR(REPLACE(REPLACE(REPLACE(cnpj,'.',''),'/',''),'-',''), 1, 2) || '.' ||
                                    SUBSTR(REPLACE(REPLACE(REPLACE(cnpj,'.',''),'/',''),'-',''), 3, 3) || '.' ||
                                    SUBSTR(REPLACE(REPLACE(REPLACE(cnpj,'.',''),'/',''),'-',''), 6, 3) || '/' ||
                                    SUBSTR(REPLACE(REPLACE(REPLACE(cnpj,'.',''),'/',''),'-',''), 9, 4) || '-' ||
                                    SUBSTR(REPLACE(REPLACE(REPLACE(cnpj,'.',''),'/',''),'-',''),13, 2)
                                  ELSE cnpj
                               END AS CNPJ
                             , p.rg
                             , initcap(p.enderecoprincipal) enderecoprincipal
                             , p.numero
                             , p.cep
                             , initcap(p.enderecosecundario) enderecosecundario
                             , pck_romance.fnc_nomecidade(p.idcidade) nomecidade
                             , lower(p.email) email
                             , datanascimento
                             , p.bairro
                             , nvl( pck_romance.fnc_nomerepresentante(pidrepresentante => v.idrepresentante) ,null) "Nome Representante"
                             , decode(v.ativo,'S','Sim','N','Não') "Vendedora Ativa"
                             , ( select initcap(descricao)
                                 from regioesvenda rv
                                 where rv.idregiaovenda = v.idregiaovenda ) "Região Vendedora"
                             , p.documentoestrangeiro
                             , null "Hist. Pontos"
                             , IDVENDEDORA
                             , nvl(( select 'Sim'
                                     from dual
                                     where exists ( select 1
                                                    from notasvendas n
                                                    where n.idvendedora = v.idvendedora
                                                      and n.idsituacaonotavenda = 4
                                                      and n.saldo > 0 ) ),'Não') "Possui Débito?"
                             , nvl(( select 'Sim'
                                     from dual
                                     where exists ( select 1
                                                    from notasvendas n
                                                    where n.idvendedora = v.idvendedora
                                                      and n.idsituacaonotavenda = 3 ) ),'Não') "Possui Nota?"
                             , nvl( ( select 'Sim'
                                      from dual
                                      where not exists ( select 1
                                                         from regioesrepresentantes rr
                                                         where rr.idrepresentante = v.idrepresentante
                                                           and rr.idregiaovenda   = v.idregiaovenda ) ) ,'Não') as "Problema de Região"         
                             , decode(p.documentosrecebidos,'S','Sim','Não') "Doc Recebidos"
                             , pck_romance.fnc_retornatelefones(idvendedora)  Telefones
                             , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':36:'||v('APP_SESSION')||'::NO::P36_IDVENDEDORA:'||v.idvendedora ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' "Ir para Notas"
                             , nvl(( select 'Sim'
                                     from dual
                                     where exists ( select 1
                                                    from fotosdocumentos ft
                                                    where ft.idpessoa = p.idpessoa )),'Não') possuifotos
                             , nvl(( select sum(nv.valorpago) / count(nv.idnotavenda)
                                     from notasvendas nv
                                     where nv.idvendedora = v.idvendedora
                                       and nv.idsituacaonotavenda = 4 ),0) ticketmedio
                             , to_number(to_char(v.datainativacaovendedora,'yyyy'))data_inativacao
                             , ( select max(nv.dataacerto)
                                   from roman.notasvendas nv
                                  where nv.idvendedora = v.idvendedora
                                    and nv.idsituacaonotavenda = 4) data_ultima_nota
                             , ( select decode(r.ativo,'S','Ativo','N','Inativo')
                                 from catal.representantes r
                                where r.idrepresentante = v.idrepresentante) sit_dist
                             , ( select min(nv.datanota)
                                   from roman.notasvendas nv
                                  where nv.idvendedora = v.idvendedora
                                    and nv.idsituacaonotavenda != 5 ) data_primeira_nota
                        from pessoas p
                           , vendedoras v
                        where v.idpessoa = p.idpessoa
                          and v.idfilial = :P0_IDFILIAL 
                          and ( :P7_NOME is null or lower(p.nomepessoa) like '%'||lower(replace(:P7_NOME,' ','%' ))||'%' )
                          and ( :P7_CPF is null or p.cpf = :P7_CPF )
                          and ( :P7_DOCUMENTOESTRANGEIRO is null or p.documentoestrangeiro = :P7_DOCUMENTOESTRANGEIRO )
                          and ( :P7_CONSULTASPC is null or p.nroconsultaspc = :P7_CONSULTASPC )
                          and ( :P7_VENDEDORATIVA = 'T' or v.ativo = :P7_VENDEDORATIVA )
                          and ( :P7_FILTROENDERECO = 'N' 
                             or ( :P7_FILTROENDERECO = 'R' and lower(p.enderecoprincipal) like '%'||lower(replace(:P7_RUA,' ','%' ))||'%' )
                             or ( :P7_FILTROENDERECO = 'B' and lower(p.bairro) like '%'||lower(replace(:P7_BAIRRO,' ','%' ))||'%' )
                             or ( :P7_FILTROENDERECO = 'C' and p.idcidade = :P7_IDCIDADE )
                             or ( :P7_FILTROENDERECO = 'E' and exists ( select 1
                                                                        from estados e
                                                                           , cidades c
                                                                        where c.idcidade = p.idcidade
                                                                          and c.idestado = e.idestado
                                                                          and e.idestado = :P7_IDESTADO ) ) )
                          and ( :P7_IDREPRESENTANTE is null or :P7_IDREPRESENTANTE = v.idrepresentante )
                          and ( :P7_CLIENTEFAVORITA = 'T' or ( :P7_CLIENTEFAVORITA = 'N' AND NOT EXISTS ( select 1
                                                                                                          from favorita.pedidos pf
                                                                                                          where pf.idvendedora = v.idvendedora
                                                                                                            and not exists ( select 1
                                                                                                                             from favorita.classificacoespedidos c 
                                                                                                                             where c.idpedido = pf.idpedido
                                                                                                                               and c.idcaracteristicapedido = 25 ) )
                                                                                         AND NOT EXISTS ( select 1
                                                                                                          from catal.pedidos pc
                                                                                                          where pc.idvendedora = v.idvendedora
                                                                                                            and pc.situacao != 'Z' ) )
                                                          or ( :P7_CLIENTEFAVORITA = 'S' and exists ( select 1
                                                                                                      from favorita.pedidos pf
                                                                                                      where pf.idvendedora = v.idvendedora
                                                                                                        and not exists ( select 1
                                                                                                                         from favorita.classificacoespedidos c 
                                                                                                                         where c.idpedido = pf.idpedido
                                                                                                                           and c.idcaracteristicapedido = 25 ) )
                                                                                          or exists ( select 1
                                                                                                      from catal.pedidos pc
                                                                                                      where pc.idvendedora = v.idvendedora
                                                                                                        and pc.situacao != 'Z' ) ) )
                          and ( :P7_ATIVO = 'A' or ( :P7_ATIVO = 'N' AND NOT EXISTS ( select 1
                                                                                       from catal.representantes r
                                                                                      where r.idrepresentante = v.idrepresentante
                                                                                        and r.ativo = 'S') )
                                                or  ( :P7_ATIVO = 'S' AND NOT EXISTS ( select 1
                                                                               from catal.representantes r
                                                                              where r.idrepresentante = v.idrepresentante
                                                                                and r.ativo = 'N') ))
                          and ( :P7_DEBITOFAVORITA = 'T' OR ( :P7_DEBITOFAVORITA = 'S' AND EXISTS ( select 1
                                                                                                    from favorita.vw_pedidos_fav pf
                                                                                                    where pf.idvendedora = v.idvendedora
                                                                                                      and pf.saldodevedor > 0.5 ) )
                                                         OR ( :P7_DEBITOFAVORITA = 'N' AND NOT EXISTS ( select 1
                                                                                                        from favorita.vw_pedidos_fav pf
                                                                                                        where pf.idvendedora = v.idvendedora
                                                                                                          and pf.saldodevedor > 0.5 )
                                                                                       AND NOT EXISTS ( select 1
                                                                                                        from favorita.vw_pedidos_old po
                                                                                                        where po.idvendedora = v.idvendedora
                                                                                                          and po.saldodevedor > 0.5 ) ) )
                          and ( :P7_NOTA_EM_ABERTO = 'T' or ( :P7_NOTA_EM_ABERTO = 'S' and exists ( select 1
                                                                                                    from notasvendas nv
                                                                                                    where nv.idvendedora = v.idvendedora
                                                                                                      and nv.idsituacaonotavenda = 3 ) )
                                                         or ( :P7_NOTA_EM_ABERTO = 'N' and not exists ( select 1
                                                                                                        from notasvendas nv
                                                                                                        where nv.idvendedora = v.idvendedora
                                                                                                          and nv.idsituacaonotavenda = 3 ) ) )
                          and ( :P7_VENDEDORATEMDEBITO = 'T' or ( :P7_VENDEDORATEMDEBITO = 'S' and exists ( select 1
                                                                                                            from notasvendas n
                                                                                                            where n.idsituacaonotavenda = 4
                                                                                                              and n.saldo > 0
                                                                                                              and n.idvendedora = v.idvendedora ) )
                                                             or ( :P7_VENDEDORATEMDEBITO = 'N' and not exists ( select 1
                                                                                                                from notasvendas n
                                                                                                                where n.idsituacaonotavenda = 4
                                                                                                                  and n.saldo > 0
                                                                                                                  and n.idvendedora = v.idvendedora ) ) )
                           and exists (select 1
                                      from catal.telefonespessoas t
                                       where t.idpessoa = p.idpessoa               
                                         and ( :P7_TELEFONE is null or (replace(replace(replace(replace(replace(t.telefone,'(',' '),')',''),'.',''),'-',''),' '))
                                                                      = (replace(replace(replace(replace(replace(:P7_TELEFONE,'(',' '),')',''),'.',''),'-',''),' '))))  ) x
                where (:P7_DATAULTINOTA_DE is null or x.data_ultima_nota between to_date(:P7_DATAULTINOTA_DE,'dd/mm/rrrr') and to_date(:P7_DATAULTINOTA_ATE,'dd/mm/rrrr'))
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P7_TIPO
            value: V
        }
        link {
            linkColumn: customTarget
            target: {
                page: 8
                items: {
                    P8_IDPESSOA: #IDPESSOA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 30000
        }
        messages {
            whenNoDataFound: Dados não econtrados. Verifique seu filtro.
            whenMoreDataFound: Esta consulta retornou mais de 10 mil linhas, por favor, filtre para ter resultados mais precisos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1416884796776336911
        }

