    branch (
        name: filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 7
                items: {
                    P7_CPF: &P7_CPF.
                    P7_TIPO: &P7_TIPO.
                    P7_NOME: &P7_NOME.
                    P7_BAIRRO: &P7_BAIRRO.
                    P7_CONSULTASPC: &P7_CONSULTASPC.
                    P7_VENDEDORATIVA: &P7_VENDEDORATIVA.
                    P7_VENDEDORATEMDEBITO: &P7_VENDEDORATEMDEBITO.
                    P7_ATIVO: &P7_ATIVO.
                    P7_REGIAOVENDA: &P7_REGIAOVENDA.
                    P7_DOCUMENTOESTRANGEIRO: &P7_DOCUMENTOESTRANGEIRO.
                    P7_DEBITOFAVORITA: &P7_DEBITOFAVORITA.
                    P7_TELEFONE: &P7_TELEFONE.
                    P7_CLIENTEFAVORITA: &P7_CLIENTEFAVORITA.
                    P7_NOTA_EM_ABERTO: &P7_NOTA_EM_ABERTO.
                }
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

