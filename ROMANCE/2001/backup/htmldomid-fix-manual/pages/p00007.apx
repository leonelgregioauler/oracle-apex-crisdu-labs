    button atualizar-vendedora (
        buttonName: ATUALIZAR_VENDEDORA
        label: Atualizar vendedora
        layout {
            sequence: 10
            region: @ações-especiais
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 636
                items: {
                    P636_CPF:
                    P636_IDPESSOA:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button buscavend (
        buttonName: BUSCAVEND
        label: Busca Vendedora
        layout {
            sequence: 30
            region: @ações
            slot: regionBody
