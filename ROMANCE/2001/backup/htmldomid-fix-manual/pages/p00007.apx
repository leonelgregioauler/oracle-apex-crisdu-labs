    region lista-de-funcionários (
        name: Lista de Funcionários
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*FIRST_ROWS(50)*/p.idpessoa
                     , initcap(p.nomepessoa) nomepessoa
                     , initcap(p.apelido) "Nome Abreviado"
                     , p.cpf CPF
                --     , Decode(p.cnpj , NULL , NULL
                --                   , REPLACE(REPLACE(REPLACE(To_Char(LPad(REPLACE(p.cnpj,' ') ,14 ,'0') ,'00,000,000,0000,00') ,',','.') ,' '),'.'||Trim(To_Char(Trunc(Mod(LPad(cnpj,14,'0'),1000000)/100),'0000'))||'.','/'||Trim(To_Char(Trunc(Mod(LPad(cnpj,14,'0') ,1000000)/100) ,'0000'))||'-')) CNPJ
                     , CASE
                          WHEN p.cnpj IS NULL THEN NULL
                          WHEN LENGTH(REPLACE(REPLACE(REPLACE(p.cnpj,'.',''),'/',''),'-','')) = 14
                          THEN
                            SUBSTR(REPLACE(REPLACE(REPLACE(p.cnpj,'.',''),'/',''),'-',''), 1, 2) || '.' ||
                            SUBSTR(REPLACE(REPLACE(REPLACE(p.cnpj,'.',''),'/',''),'-',''), 3, 3) || '.' ||
                            SUBSTR(REPLACE(REPLACE(REPLACE(p.cnpj,'.',''),'/',''),'-',''), 6, 3) || '/' ||
                            SUBSTR(REPLACE(REPLACE(REPLACE(p.cnpj,'.',''),'/',''),'-',''), 9, 4) || '-' ||
                            SUBSTR(REPLACE(REPLACE(REPLACE(p.cnpj,'.',''),'/',''),'-',''),13, 2)
                          ELSE p.cnpj
                       END AS CNPJ
                     , p.cpf "CPF sem Formatação"
                     , p.rg
                     , initcap(p.enderecoprincipal) enderecoprincipal
                     , p.numero
                     , p.cep
                     , initcap(p.enderecosecundario) enderecosecundario
                     , roman.pck_romance.fnc_nomecidade(p.idcidade) nomecidade
                     , lower(p.email) email
                     , p.datanascimento
                     , p.bairro
                     , nvl(( select roman.pck_romance.fnc_nomerepresentante(pidrepresentante => v.idrepresentante)
                             from catal.vendedoras v
                             where v.idpessoa   = p.idpessoa),null) "Nome Representante"
                     , (select decode(v.ativo,'S','Sim','N','Não') from catal.vendedoras v where v.idpessoa = p.idpessoa ) "Vendedora Ativa"
                     , ( select c.nome 
                         from roman.cargos c 
                         where c.idcargo = f.idcargo ) "Cargo Funcionario" --t14785589
                     , decode(f.ativo,'S','Sim','N','Não') FUNCIONARIOATIVO
                     , ( select rv.descricao from roman.regioesvenda rv where rv.idregiaovenda = ( select vv.idregiaovenda from catal.vendedoras vv where vv.idpessoa = p.idpessoa)) "Região Vendedora"
                     , ( select m.cnpj from roman.mei m where m.idpessoa = p.idpessoa ) "CNPJ Mei"
                     , p.documentoestrangeiro
                     , null "Hist. Pontos"
                     , ( select idvendedora from catal.vendedoras f where f.idpessoa = p.idpessoa ) IDVENDEDORA
                     , decode(p.documentosrecebidos,'S','Sim','Não') "Doc Recebidos"
                     , ( select usuario from catal.usuarios where idpessoa = p.idpessoa ) usuario
                     , roman.pck_util.fnc_retornatelefones(p.idpessoa) Telefones
                     , ( select roman.pck_romance.fnc_nomefilial(roman.pck_romance.fnc_filialusuario(u.usuario))
                         from usuarios u
                         where u.idpessoa = p.idpessoa) "Filial Romance"
                     , ( select favorita.pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) 
                         from usuarios u
                         where u.idpessoa = p.idpessoa) "Filial Favorita"
                from catal.pessoas p
                   , catal.funcionarios f
                where f.idpessoa = p.idpessoa
                  and ( :P7_NOME is null or lower(p.nomepessoa) like '%'||lower(replace(:P7_NOME,' ','%' ))||'%')
                  and ( :P7_CPF is null or p.cpf = :P7_CPF)
                  and ( :P7_DOCUMENTOESTRANGEIRO is null or p.documentoestrangeiro = :P7_DOCUMENTOESTRANGEIRO )
                  and ( :P7_CONSULTASPC is null or p.nroconsultaspc = :P7_CONSULTASPC)
                  and ( :P7_FILTROENDERECO = 'N' 
                     or ( :P7_FILTROENDERECO = 'R' and lower(p.enderecoprincipal) like '%'||lower(replace(:P7_RUA,' ','%' ))||'%' )
                     or ( :P7_FILTROENDERECO = 'B' and lower(p.bairro) like '%'||lower(replace(:P7_BAIRRO,' ','%' ))||'%' )
                     or ( :P7_FILTROENDERECO = 'C' and p.idcidade = :P7_IDCIDADE ) )
                  and ( :P7_FUNCIONARIOATIVO = 'T' or f.ativo = :P7_FUNCIONARIOATIVO )
                  and ( f.idgerente = ( select gg.idgerente
                                        from catal.gerentes gg
                                        where gg.idfilial =  :P0_IDFILIAL )    
                   or exists ( select 1 
                               from catal.USUARIOS u
                               where u.idpessoa = p.idpessoa
                                 and u.idgerente = ( select gg.idgerente
                                                     from catal.gerentes gg
                                                     where gg.idfilial =  :P0_IDFILIAL ) ) )
                   and ( :P7_TELEFONE is null or exists ( select 1
                                                          from telefonespessoas t
                                                           where t.idpessoa = p.idpessoa               
                                                             and (replace(replace(replace(replace(replace(t.telefone,'(',' '),')',''),'.',''),'-',''),' '))  
                                                               = (replace(replace(replace(replace(replace(:P7_TELEFONE,'(',' '),')',''),'.',''),'-',''),' '))))                                   
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
