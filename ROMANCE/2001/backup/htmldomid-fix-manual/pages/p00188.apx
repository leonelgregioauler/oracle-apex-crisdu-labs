    region fechamentos-efetuados-agrupado (
        name: Fechamentos Efetuados  Agrupado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with filiais_escopo as (
                  -- (Comercial Romance / regional / America Latina / todas / uma especifica).
                  select f.idfilial
                  from roman.vw_filiais_filtro f
                  where f.ref_filial =  :P0_IDFILIAL
                )
                select roman.pck_romance.fnc_nomefilial(pidfilial => x.idfilial) Filial
                     , sum(qtdnotasnovas) qtdnotasnovas
                     , sum(qtdnotaslevou) qtdnotaslevou
                     , sum(qtdnotasfechou) qtdnotasfechou
                     , sum(totalgeral)    totalgeral
                     , sum(totalcobranca) totalcobranca
                     , sum(nvl(Vlr_Comissao,0))  "Vlr Comissão"
                     , sum(Total_Resgate) "Total Resgate"
                     , sum(nvl(Debitos_Recebidos,0)) "Débitos Recebidos"
                     , sum(nvl(Debitos_Novos,0)) "Débitos Novos"
                     , Sum(nvl(Com_Paga_Fav,0)) "Com. Paga Fav."
                     , sum(Qtd_Pedidos) "Qtd Pedidos"
                     , sum(nvl(Pgto_Pedidos,0)) "Pgto Pedidos"
                     , sum(totaldebitosfavorita) "total debitos favorita"
                     , sum(ticket_medio) "ticket medio"
                     , sum(nvl(Total_Pedidos,0)) "Total Pedidos"
                     , sum(Qtd_Acertos) "Qtd Acertos"
                     , sum(Zerados) "Zerados"
                     , sum(percdebitosnovos) percdebitosnovos
                     , sum(debitosnovos_real) debitosnovos_real
                     , sum(Notas_fora_da_semana) Notas_fora_da_semana
                     , iniciou_na_empresa
                     , sum(consultoras_nao_renovadas) consultoras_nao_renovadas
                from (
                select fr.idfilial
                     , fr.idrepresentante
                     , sum(fr.qtdnotasnovas + nvl(fr.qtdnotasnovasoutrareg,0)) qtdnotasnovas
                     , sum(fr.qtdnotaslevou) qtdnotaslevou
                     , sum(fr.qtdnotasfechou) qtdnotasfechou
                     , sum(fr.totalgeral) totalgeral
                     , sum(fr.totalcobranca) totalcobranca
                     , sum(nvl(fr.vlrcomissao,0)) Vlr_Comissao
                     , sum((select sum(valor) from perdas pp where pp.idfechamentorepres = fr.idfechamentorepres)) Total_Resgate
                     , sum(nvl(fr.totalpepinosrecebidos,0)) Debitos_Recebidos
                     , sum(nvl(fr.totaldebitosnovos,0)) Debitos_Novos
                     , Sum(nvl(fr.TOTALCOMISSOESFAVORITAREPRES,0)) Com_Paga_Fav
                     , sum(( select count(1)
                             from favorita.pedidos pf
                             where pf.idrepresentante = fr.idrepresentante
                               and pf.idsituacaoentrega >= 20000
                               and pf.idsemanaemissao = pck_util.fnc_idsemana(fr.semana)
                               and pf.datacancelamento is null )) Qtd_Pedidos
                     , sum(nvl( ( select sum(pgd.valorpago)
                                  from vw_pagamentos_dist_rmc pgd
                                  where pgd.idrepresentante = fr.idrepresentante
                                    and pgd.semana          = fr.semana ),0 )) Pgto_Pedidos
                     , sum(fr.totaldebitosfavorita) totaldebitosfavorita
                     , case
                         when sum(fr.totalcobranca) > 0 and sum(fr.qtdnotaslevou) > 0 then
                           round(sum(fr.totalgeral)/sum(fr.qtdnotaslevou),2)
                         else
                           0
                       end ticket_medio
                     , sum( nvl(( select sum(pf.valorapagar)
                                  from favorita.pedidos pf
                                  where pf.idrepresentante = fr.idrepresentante
                                    and pf.idsituacaoentrega >= 20000
                                    and pf.idsemanaemissao = pck_util.fnc_idsemana(fr.semana)
                                    and pf.datacancelamento is null ),0)) Total_Pedidos
                      , count(fr.idfechamentorepres) Qtd_Acertos
                      , ( select count (f.idfechamentorepres)
                          from roman.fechamentorepresentantes f
                             , roman.fechamentossemanais ff
                          where f.idrepresentante = fr.idrepresentante
                            and f.idfechamento = ff.idfechamento
                            and ff.idsemana between to_number(:P188_IDFECHAMENTOINI) and to_number(:P188_IDFECHAMENTOFIM)
                            and f.totalgeral > 0) Zerados
                     , decode( sum(fr.totalgeral) ,0,0,(round((sum(fr.totaldebitosnovos)/sum(fr.totalgeral))*100,2))) percdebitosnovos
                     , sum(nvl(( select sum(nv.saldo)
                                   from notasvendas nv
                                  where nv.idsemanacobranca = nvl(( select ff.idsemana -- 16461316
                                                                      from fechamentossemanais ff
                                                                     where ff.idfechamento = fr.idfechamentopontuacao ), fs.idsemana)
                                    and nv.idsituacaonotavenda = 4
                                    and nv.idrepresentante = fr.idrepresentante
                                    and nv.saldo > 0 ),0)) debitosnovos_real
                     /*, sum(( select sum(nv.saldo)
                             from notasvendas nv
                             where nv.idsemanacobranca = fs.idsemana
                               and nv.idsituacaonotavenda = 4
                               and nv.idrepresentante = fr.idrepresentante
                               and nv.saldo > 0 )) debitosnovos_real*/
                     , sum(( select count(nv.idnotavenda)
                         from roman.notasvendas nv
                         where nv.idrepresentante =  fr.idrepresentante
                          and nv.idsemanacobranca = fs.idsemana
                          and nv.idsituacaonotavenda = 3
                          and nv.semanacobrancaorig < nv.semanacobranca) ) Notas_fora_da_semana
                     -- Maicon Aimi - 16/07/2025 - 10345369
                     , (select nvl(catal.pck_util.fnc_semanaid( min(nv.idsemanadistribuicao)), 'Sem Registro')
                          from roman.notasvendas nv
                         where nv.idrepresentante = fr.idrepresentante
                           and nv.idsituacaonotavenda in (4,3)) iniciou_na_empresa
                     , sum(qtdconsultorasnaorenovadas) consultoras_nao_renovadas
                from fechamentorepresentantes fr
                    , fechamentossemanais fs
                    , catal.representantes rr
                    , filiais_escopo fe
                where fr.idfilial = fe.idfilial
                  and fr.idfechamento = fs.idfechamento
                  and fr.idrepresentante = rr.idrepresentante
                  and (:P188_ATIVO is null
                      or (rr.ativo = 'S'     and :P188_ATIVO = 'S')
                      or (rr.ativo = 'N'     and :P188_ATIVO = 'N'))
                  and fs.idsemana between to_number(:P188_IDFECHAMENTOINI) and to_number(:P188_IDFECHAMENTOFIM)
                  and ( :P188_PESQUISARPOR is null
                       or ( :P188_PESQUISARPOR = 'D' and ( :P188_IDREPRESENTANTE is null or fr.idrepresentante = :P188_IDREPRESENTANTE ) )
                       or ( :P188_PESQUISARPOR = 'G' and exists ( select 1
                                                                  from filtrosrepresentantes fil
                                                                  where fil.usuario = v('APP_USER')
                                                                    and fil.idrepresentante = fr.idrepresentante ) ) )
                group by fr.idfilial , fr.idrepresentante) x
                group by x.idfilial,iniciou_na_empresa
                order by 1
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
