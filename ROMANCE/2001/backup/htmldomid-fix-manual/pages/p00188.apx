            }
            
            function liberar(pidrepres,pidsemana) 
            {
              document.getElementById('P74_IDREPRESENTANTE').value = pidrepres;
              document.getElementById('P74_SEMANALIBERAR').value   = pidsemana;
              apex.submit('LIBERAR');
            }
