    process inicializa-filtros (
        name: INICIALIZA_FILTROS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    
                    -- inicializa :P188_IDFECHAMENTOINI
                    if :P188_IDFECHAMENTOINI is null then
                        select s.idsemana - 1
                          into :P188_IDFECHAMENTOINI
                          from roman.semana_dias s
                         where sysdate between s.dt_ini and s.dt_fim;
                    end if;
                
                    -- inicializa :P188_IDFECHAMENTOFIM
                    if :P188_IDFECHAMENTOFIM is null then
                        select s.idsemana
                          into :P188_IDFECHAMENTOFIM
                          from roman.semana_dias s
                         where sysdate between s.dt_ini and s.dt_fim;
                    end if;
                
                    -- inicializa o tipo de relatório 
                    if :P188_TIPORELATORIO is null then
                        :P188_TIPORELATORIO := 'D';
                    end if;
                
                exception
                    when others then
                        null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 378507359060702940
        }
    )

    process libera-proxima-semana (
        name: libera proxima semana
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  insert into LIBERACOESSEMANAIS
                  values (seq_idliberacoessemanais.nextval , :P188_SEMANALIBERAR , 'S', v('APP_USER'), :P188_IDREPRESENTANTE  );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Próxima semana liberada.
        }
        error {
            errorMessage: A próxima semana já foi liberada para este representante.
        }
        advanced {
            executionMappingIdentifier: 81723163814732977
        }
        serverSideCondition {
            type: request=Value
            value: LIBERAR
        }
    )

    branch (
        name: Go To Page 188
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 188
                items: {
                    P188_IDFECHAMENTO: &P188_IDFECHAMENTO.
                    P188_IDFECHAMENTOINI: &P188_IDFECHAMENTOINI.
                    P188_IDFECHAMENTOFIM: &P188_IDFECHAMENTOFIM.
                    P188_IDREPRESENTANTE: &P188_IDREPRESENTANTE.
                    P188_TIPORELATORIO: &P188_TIPORELATORIO.
                    P188_PESQUISARPOR: &P188_PESQUISARPOR.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

