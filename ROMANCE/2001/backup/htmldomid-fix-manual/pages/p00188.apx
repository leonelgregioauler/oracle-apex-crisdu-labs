    pageItem P188_IDREPRESENTANTE (
        type: selectList
        label {
            label: <b>Distribuidor:</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                with filiais_escopo as (
                  -- Mesma regra de escopo de filial usada em query_estoquefilial_filtro_p0_idfilial.sql
                  -- (Comercial Romance / regional / America Latina / todas / uma especifica).
                  select f.idfilial
                  from roman.vw_filiais_filtro f
                  where f.ref_filial =  :P0_IDFILIAL
                )
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante)||' - '||decode(r.ativo,'S','Ativo','N','Inativo')||' - '|| (select min(nv.semanadistribuicao)
                                                                                                                                              from roman.notasvendas nv
                                                                                                                                              where nv.idrepresentante = r.idrepresentante)  display_value
                   , r.idrepresentante return_value
                from catal.representantes r
                   , catal.gerentes       g
                   , filiais_escopo       fe
                where r.idgerente = g.idgerente  -- regra de negocio: filial do representante e definida via gerente
                  and g.idfilial  = fe.idfilial
                  and (:P188_ATIVO is null or r.ativo = :P188_ATIVO)
                order by 1
                
                ```
            nullDisplayValue: "- Todos - "
        }
        cascadingLov {
            parentItems: P188_ATIVO
            itemsToSubmit: P188_IDREPRESENTANTE
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

