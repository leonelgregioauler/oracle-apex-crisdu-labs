    pageItem P188_IDFECHAMENTOFIM (
        type: selectList
        label {
            label: <b>Até:</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semanacompleta display_value
                     , idsemana return_value
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-3 and to_char(sysdate,'RRRR')
                order by s.idsemana desc
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
