        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semanacompleta display_value
                     , idsemana return_value
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-3 and to_char(sysdate,'RRRR')
                order by s.idsemana desc
                ```
