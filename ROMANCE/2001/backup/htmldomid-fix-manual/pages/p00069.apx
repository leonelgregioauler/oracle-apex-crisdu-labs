        name: Process Row of SAIDASDIVERSAS
        type: autoRowProcessing
        target {
            tableName: SAIDASDIVERSAS
            pkColumn: IDSAIDA
            pkItem: P69_IDSAIDA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela SAIDASDIVERSAS.
            displayLocation: onErrorPage
        }
        advanced {
