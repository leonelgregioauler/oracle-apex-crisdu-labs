    process fetch-row-from-saidasdiversas (
        name: Fetch Row from SAIDASDIVERSAS
        type: autoRowFetch
        source {
            tableName: SAIDASDIVERSAS
            pkColumn: IDSAIDA
            pkItem: P69_IDSAIDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 156428260464280422
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDSAIDASDIVERSAS.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P69_IDSAIDA := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 156428464700280422
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

