page 69 (
    name: Nova Saída
    title: Nova Saída
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region lista-de-saídas-diversas (
        name: Lista de Saídas Diversas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idsaida
                     , e.idfilial
                     , pck_romance.fnc_nomefilial(pidfilial => e.idfilialdest) "Filial Destino"
                     , e.semana
                     , e.data
                     , e.fechamentoorig
                     , e.valortotal
                     , e.descricao
                     , ( select ff.semana from fechamentossemanais ff where ff.idfechamento = e.idfechamento ) "Fechamento"
                     , decode(e.tipo, 'D', 'Dinheiro', 'O','Pagamento de Conta') "Tipo"
                from saidasdiversas e
                where e.idfilial     = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        link {
            linkColumn: customTarget
            target: {
                page: 69
                items: {
                    P69_IDSAIDA: #IDSAIDA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma saída incluída.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

