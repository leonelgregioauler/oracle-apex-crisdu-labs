    pageItem P69_IDFILIALDEST (
        type: selectList
        label {
            label: Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(f.idfilial) display_value
                     , f.idfilial return_value
                from filiais    f
                where f.ativo = 'S'
                  and f.idfilial not in( 240,260,261,262,1073,1074,220,1069,421)
                  and f.idfilial != :P0_IDFILIAL
                order by 1
                ```
            nullDisplayValue: - Destino -
        }
        layout {
            sequence: 50
            region: @nova-saída
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALDEST
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P69_IDFILIALDEST
        }
        security {
            encryptSessionState: false
        }
    )

