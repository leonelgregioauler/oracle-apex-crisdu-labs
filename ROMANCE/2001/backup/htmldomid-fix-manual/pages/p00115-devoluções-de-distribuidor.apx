    button delete (
        buttonName: DELETE
        label: Cancelar
        layout {
            sequence: 70
            region: @cancelamento
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:cancelar();
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P115_IDDEVOLUCAOREPRES is not null
                  and :P115_SITUACAO not in ( 0,3)
                  and :P0_ESTOQUECONGELADO = 'N'
                union
                select 1
                from dual
                where exists ( select 1
                               from correcaodevolucao c
                               where c.iddevolucaorepres = :P115_IDDEVOLUCAOREPRES
                                 and c.motivo = 'Devolução liberada para correção!'
                                 and c.usuario = 'OPTIMUS' )
                  and :P115_SITUACAO = 3
                ```
        }
    )

