    process atualiza (
        name: atualiza
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                update devolucoesrepresentantes d
                set d.valortotal = ( select SUM((( nvl(i.qtd_pp,0)
                                           + nvl(i.qtd_p,0)
                                           + nvl(i.qtd_m,0)
                                           + nvl(i.qtd_g,0)
                                           + nvl(i.qtd_gg,0)
                                           + nvl(i.qtd_egg,0)
                                           + nvl(i.qtd_u,0))*i.valorproduto) )
                                    from itensdevolucaorepres i
                                    where i.iddevolucaorepres = d.iddevolucaorepres )
                where d.iddevolucaorepres = :P115_IDDEVOLUCAOREPRES;
                END;
                ```
        }
        execution {
            sequence: 1
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1320200746566053284
        }
    )

    process cancelar (
        name: Cancelar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                 :P115_SITUACAO := 0;
                    delete itensdevolucaorepres i
                    where i.iddevolucaorepres = :p115_iddevolucaorepres;
                end;
                ```
        }
        execution {
            sequence: 1
        }
        successMessage {
            successMessage: Devolução cancelada!
        }
        advanced {
            executionMappingIdentifier: 1320201567015053284
        }
        serverSideCondition {
            type: request=Value
            value: APPLY
        }
    )

    process confirma-classificação-de-supervisor (
        name: Confirma Classificação de Supervisor
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  -- Local variables here
                  i integer;
                  vidcaracteristica number;
                  vidusuario number;
                begin
                  -- 
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = :P0_USUARIO;
                  --
                  update devolucoesrepresentantes d
                  set d.idsupervisor = :P115_IDSUPERVISOR
                  where d.iddevolucaorepres = :P115_IDDEVOLUCAOREPRES;
                  --
                  if :P115_TIPOATENDIMENTO = 'C' then
                    --
                    vidcaracteristica := 1;
                    --
                  elsif :P115_TIPOATENDIMENTO = 'D' then
                    --
                    vidcaracteristica := 2;
                    --
                  end if;
                  --
                  insert into classificacoesdevolucoesrepres ( idcaracteristicadevolucao
                                                             , iddevolucaorepres
                                                             , idusuario
                                                             , idvalorcaracteristica
                                                             , observacao )
                  values ( vidcaracteristica
                         , :P115_IDDEVOLUCAOREPRES
                         , vidusuario
                         , null
                         , null );
                  --
                end;
                ```
        }
        execution {
            sequence: 75
        }
        successMessage {
            successMessage: Supervisor Identificado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1320203999509053285
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR_SUPERVISOR
        }
    )

