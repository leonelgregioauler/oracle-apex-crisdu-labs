    validation valida-inclusão-de-devolução-se-ja-tem-em-aberto (
        name: Valida Inclusão de Devolução se ja tem em aberto
        execution {
            sequence: 200
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from devolucoesrepresentantes d
                where d.idrepresentante = :P115_IDREPRESENTANTE
                  and ( d.idsemana < pck_util.fnc_idsemana(:P115_SEMANA)
                     or d.idsemana > pck_util.fnc_idsemana(:P115_SEMANA) )
                  and d.situacao in (1,2)
                  and rownum >= 1
                ```
        }
        error {
            errorMessage: Não é possível incluir uma nova devolução para este distribuidor pois já existe uma em aberto em outra semana. Em caso de dúvida, entre em contato com o Suporte do Estoque.
        }
        serverSideCondition {
            type: never
        }
    )

    validation valida-semana-na-inclusão (
        name: Valida Semana na Inclusão
        execution {
            sequence: 180
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_idsemana(:P115_SEMANA) > pck_util.fnc_idsemanadata(sysdate)+1
                ```
        }
        error {
            errorMessage: Não é possível inserir uma Devolução com a semana maior que a atual.
        }
        serverSideCondition {
            type: request=Value
            value: CREATE
        }
    )

