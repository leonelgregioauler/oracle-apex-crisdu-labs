page 115 (
    name: Devoluções de Distribuidor
    alias: DEVOLUÇÕES-DE-DISTRIBUIDOR
    title: Devoluções de Distribuidor
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function formatar_mascara(src,mascara,evt){
              var tecla;  
              if(evt.which)
                {
                  tecla = evt.which
                }
              else 
                if(evt.keyCode)
                  { 
                    tecla = evt.keyCode;
                  }
              if ( tecla != 8 && tecla!=13 && tecla!=47 && tecla!=59) 
                {
                  var campo = src.value.length;
                  var saida = mascara.substring(0,1);
                  var texto = mascara.substring(campo);
                  if(texto.substring(0,1) != saida) 
                    { 
                      src.value+=texto.substring(0,1);
                    }
                }
              
            }
            
            function fnc_popup_produto()
            {
              viddevol = document.getElementById('P115_IDDEVOLUCAOREPRES').value;
              window.open( 'f?p=&APP_ID.:119:&SESSION.::NO::P119_IDDEVOLUCAOREPRES,P119_IDITEMDEVOLUCAOREPRES,P119_OPCAO:'+viddevol +',,C', 'CADITEMDEVOL', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=500,left=250,top=100','_blank'); void(0);
            }
            
            
            function fnc_imprime()
            {
              vidrep = document.getElementById('P115_IDREPRESENTANTE').value;
              vsemana = document.getElementById('P115_SEMANA').value;
              window.open( 'f?p=&APP_ID.:175:&SESSION.::NO::P175_IDREPRESENTANTE,P175_SEMANA:'+vidrep+','+vsemana , 'IMPRIME', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=500,left=250,top=100','_blank'); void(0);
            }
            
            function fnc_imprimedefeito_f()
            {
              vidrep = document.getElementById('P115_IDREPRESENTANTE').value;
              vsemana = document.getElementById('P115_SEMANA').value;
              vtipo = 'F';
              window.open( 'f?p=&APP_ID.:251:&SESSION.::NO::P251_IDREPRESENTANTE,P251_SEMANA,P251_TIPO:'+vidrep+','+vsemana+','+vtipo , 'IMPRIME DEFEITO', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=500,left=250,top=100','_blank'); void(0);
            }
            
            function fnc_imprimedefeito_d()
            {
              vidrep = document.getElementById('P115_IDREPRESENTANTE').value;
              vsemana = document.getElementById('P115_SEMANA').value;
              vtipo = 'D';
              window.open( 'f?p=&APP_ID.:251:&SESSION.::NO::P251_IDREPRESENTANTE,P251_SEMANA,P251_TIPO:'+vidrep+','+vsemana+','+vtipo , 'IMPRIME DEFEITO', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=500,left=250,top=100','_blank'); void(0);
            }
            
            function fnc_imprime_comp()
            {
              vidrep = document.getElementById('P115_IDREPRESENTANTE').value;
              vsemana = document.getElementById('P115_SEMANA').value;
              viddevolucao = document.getElementById('P115_IDDEVOLUCAOREPRES').value;
              window.open( 'f?p=&APP_ID.:270:&SESSION.::NO::P270_IDREPRESENTANTE,P270_IDDEVOLUCAOREPRES,P270_SEMANA:'+vidrep+','+viddevolucao+','+vsemana , 'IMPRIME COMPLETO', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=500,left=250,top=100','_blank'); void(0);
            }
            
            
            function fnc_popup_carga()
            {
              vidrepresentante = document.getElementById('P115_IDREPRESENTANTE').value;
              vsemana = document.getElementById('P115_SEMANA').value;
              window.open('f?p=&APP_ID.:175:&SESSION.::NO::P175_IDREPRESENTANTE,P175_SEMANA:'+vidrepresentante+','+vsemana,'DEVOL', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=700,height=800,left=600,top=100','_blank'); void(0);
            }
            
            function fnc_popup_devolucao()
            {
              vidrepresentante = document.getElementById('P115_IDREPRESENTANTE').value;
              vsemana = document.getElementById('P115_SEMANA').value;
              window.open('f?p=&APP_ID.:244:&SESSION.::NO::P244_IDREPRESENTANTE,P244_SEMANA:'+vidrepresentante+','+vsemana,'DEVOL', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=700,height=800,left=600,top=100','_blank'); void(0);
            }
            
            function fnc_popup_edita_produto(piditdevol)
            {window.open('f?p=&APP_ID.:119:&SESSION.::NO::P119_IDITEMDEVOLUCAOREPRES,P119_OPCAO:'+piditdevol+',P','EDITAITEMDEVOL', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=700,height=500,left=250,top=100','_blank'); void(0);
            }
            
            function  confirmadevol(event)
            { var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            if (tecla==13) 
            { var answer = confirm("Confirma inclusão da devolução?")
              if (answer)
              {apex.submit('CREATE');}}}
            
            
            function  cancelar(event)
            { 
              var answer = confirm("Deseja realmente cancelar a devolução?")
              if (answer)
                {
                  apex.submit('APPLY');
                }
            }
            
            function fnc_excluir(pid)
            {
              document.getElementById('P115_IDEXCLUIR').value = pid;
              apex.submit('EXCLUIR');
            }
            ```
