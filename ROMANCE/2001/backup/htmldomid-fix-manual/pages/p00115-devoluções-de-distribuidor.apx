    pageItem P115_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||r.idrepresentante||') - '||decode(ativo,'S','Ativo','N','Inativo') display_value
                     , r.idrepresentante
                from representantes r
                where idgerente in ( select idgerente
                                     from gerentes
                                     where idfilial = :P0_IDFILIAL)
                  and :P115_IDDEVOLUCAOREPRES is null
                  and ativo = 'S'
                union
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||r.idrepresentante||') - '||decode(ativo,'S','Ativo','N','Inativo') display_value
                     , r.idrepresentante
                from representantes r
                where idgerente in ( select idgerente
                                     from gerentes
                                     where idfilial = :P0_IDFILIAL)
                  and :P115_IDDEVOLUCAOREPRES is not null
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o Representante -
        }
        layout {
            sequence: 40
            region: @devoluções-de-distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P115_IDDEVOLUCAOREPRES
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P115_IDSUPERVISOR (
        type: selectOne
        label {
            label: Supervisor
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) pessoa
                     , s.idsupervisor
                from supervisores s
                   , pessoas p
                where p.idpessoa = s.idpessoa
                  and s.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @identificar-supervisor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

