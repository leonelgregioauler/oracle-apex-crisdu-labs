    process libera-correcao (
        name: Libera Correcao
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  IF :P115_NUMEROEVENTO IS NULL THEN
                    APEX_ERROR.ADD_ERROR( p_message => 'Obrigatório informar numero do evento para liberar correção!',
                                          p_display_location => apex_error.c_inline_in_notification);
                  ELSE  
                    update devolucoesrepresentantes
                    set dataconclusao = sysdate
                    where iddevolucaorepres = :P115_IDDEVOLUCAOREPRES;
                    --
                    insert into correcaodevolucao(idcorrecaodevolucao,datacorrecao,usuario,motivo,iddevolucaorepres,idrepresentante)
                    values (seq_idcorrecaodevolucao.nextval,sysdate,'OPTIMUS','Devolução liberada para correção. Evento '||:P115_NUMEROEVENTO,:P115_IDDEVOLUCAOREPRES,:P115_IDREPRESENTANTE);
                    --
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 15
        }
        successMessage {
            successMessage:
                ```
                Correção Liberada!
                
                ```
        }
        error {
            errorMessage: Entre em contato com o Administrador do Sistema!
        }
        advanced {
            executionMappingIdentifier: 1320203551360053285
        }
        serverSideCondition {
            whenButtonPressed: @confirmacorrecao
        }
    )

