        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P115_SITUACAO in (1,2) and not exists ( select 1
                                                         from correcaodevolucao c
                                                         where c.iddevolucaorepres = :P115_IDDEVOLUCAOREPRES ) and :P115_IDDEVOLUCAOREPRES is not null
                ```
