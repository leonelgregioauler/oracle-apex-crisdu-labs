    region cancelamento (
        name: Cancelamento
        type: staticContent
        layout {
            sequence: 80
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P115_IDDEVOLUCAOREPRES is not null
                  and :P115_SITUACAO not in ( 0,3)
                  and :P0_ESTOQUECONGELADO = 'N'
                union
                select 1
                from dual
                where exists ( select 1
                               from correcaodevolucao c
                               where c.iddevolucaorepres = :P115_IDDEVOLUCAOREPRES
                                 and c.motivo = 'Devolução liberada para correção!'
                                 and c.usuario = 'OPTIMUS' )
                  and :P115_SITUACAO = 3
                ```
        }
    )

    region classificações-da-devolução (
        name: Classificações da Devolução
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idclassificacaodevolucao,
                       w.idcaracteristicadevolucao,
                       w.caracteristica,
                       w.iddevolucaorepres,
                       w.data,
                       w.idusuario,
                       w.usuario,
                       w.idvalorcaracteristica,
                       w.observacao,
                       case 
                         when exists ( select 1 
                                       from usuarios u
                                       where u.usuario = v('APP_USER') 
                                         and u.idgerente in (143,199) ) then
                           '<a href="javascript: fnc_excluir('||idclassificacaodevolucao||')" ><img src="/i/menu/pencil16x16.gif"  border="0"></a>'
                         else
                           '-'
                       end remover
                from vw_classificacoesdevolucoes w
                where w.iddevolucaorepres = :P115_IDDEVOLUCAOREPRES
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
