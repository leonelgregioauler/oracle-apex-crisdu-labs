    validation valida-cancelamento-de-devolução (
        name: Valida Cancelamento de Devolução
        execution {
            sequence: 190
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from itensdevolucaorepres i
                where idfechamentoreprespago is not null
                  and iddevolucaorepres = :P115_IDDEVOLUCAOREPRES
                ```
        }
        error {
