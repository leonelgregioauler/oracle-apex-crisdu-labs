    dynamicAction concluir-devolução (
        name: Concluir Devolução
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @save
        }
        serverSideCondition {
            type: item=value
            item: P115_SITUACAO
            value: 1
        }

        action native-confirm (
            action: confirm
            settings {
                title: Atenção
                message: Você realmente deseja concluir?
                style: warning
                confirmLabel: Sim
                cancelLabel: Não
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vusuario varchar2(100) := v('APP_USER');
                    begin
                      --
                      update devolucoesrepresentantes
                      set situacao = 3
                      where iddevolucaorepres = :P115_IDDEVOLUCAOREPRES;
                      --
                      commit;
                      --
                      commit;
                      --
                      pck_estoque_v2.prc_concluidevolucao(piddevolucaorepres => :P115_IDDEVOLUCAOREPRES,
                                                          pusuario => vusuario);
                      --
                    end;
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: "location.reload(); "
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

