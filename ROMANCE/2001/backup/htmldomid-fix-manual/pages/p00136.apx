    pageItem P136_IDREGIAOVENDA (
        type: selectList
        label {
            label: Região
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.descricao || nvl2(rr.semana, ' - ' || rr.semana, null)  display_value
                     , r.idregiaovenda                return_value
                from regioesvenda r
                   , regioesrepresentantes rr
                where rr.idregiaovenda   = r.idregiaovenda
                  and rr.idrepresentante = :P136_IDREPRESENTANTE
                  and r.ativo = 'S'
                  and r.idestado in ( select f.idestado
                                      from filiaisregioesvenda f
                                      where f.idfilial = :P0_IDFILIAL )
                order by rr.idsemana
                
                
                /*select descricao      display_value
                     , idregiaovenda  return_value
                from regioesvenda r
                where r.ativo = 'S'
                  and r.idestado in ( select f.idestado
                                      from filiaisregioesvenda f
                                      where f.idfilial = :P0_IDFILIAL )
                  and exists ( select 1
                               from regioesrepresentantes rr
                               where rr.idregiaovenda = r.idregiaovenda
                                 and rr.idrepresentante   = :P136_IDREPRESENTANTE)
                order by 1*/
                ```
            nullDisplayValue: - Selecione a Região -
        }
        cascadingLov {
            parentItems: P136_IDREPRESENTANTE
        }
        layout {
            sequence: 50
            region: @cadastro-de-vendedoras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREGIAOVENDA
            used: always
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P136_IDVENDEDORA is not null
                  and pck_romance.fnc_filialvendedora(:P136_IDVENDEDORA) != pck_romance.fnc_filialusuario(v('APP_USER')) 
                  and pck_romance.fnc_filialusuario(v('APP_USER')) not in (340,200,1205,360)
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P136_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(pr.nomepessoa||' ['||pr.apelido||'] ( '||nvl(p.apelido,p.nomepessoa)||' )'
                ||' ['||pr.codigosisdist||']') display_value
                     , r.idrepresentante  return_value
                from estados         e
                   , cidades         c
                   , pessoas         p
                   , filiais         f
                   , gerentes        g
                   , representantes  r
                   , pessoas         pr
                where c.idestado  = e.idestado
                  and p.idcidade  = c.idcidade
                  and r.idpessoa  = pr.idpessoa
                  and f.idpessoa  = p.idpessoa
                  and g.idfilial  = f.idfilial
                  and r.idgerente = g.idgerente
                  and r.ativo     = 'S'
                  and g.idfilial  = :P0_IDFILIAL
                order by 1
                ```
            nullDisplayValue: - Selecione o Representante -
        }
        layout {
            sequence: 20
            region: @cadastro-de-vendedoras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P136_IDVENDEDORA is not null
                  and pck_romance.fnc_filialvendedora(:P136_IDVENDEDORA) != pck_romance.fnc_filialusuario(v('APP_USER')) 
                  and (pck_romance.fnc_filialusuario(v('APP_USER')) not in (340,200,1205) and pck_util.fnc_verificaacesso(3544,v('APP_USER')) = 'N')
                
                
                ```
        }
        security {
            encryptSessionState: false
        }
    )

