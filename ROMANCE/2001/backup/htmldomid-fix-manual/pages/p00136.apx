    region notas (
        name: Notas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nv.idnotavenda
                     , pck_romance.fnc_nomefilial(idfilial) "Filial"
                     , to_number(nv.numeronota) numeronota
                     , pck_romance.fnc_nomerepresentante(pidrepresentante => nv.idrepresentante) "Representante"
                     , nv.datanota
                     , nv.semanadistribuicao/*||'  '||pck_romance.fnc_semanadias(psemana => nv.semanadistribuicao)*/ "Semana Distribuição"
                     , nv.semanacobranca/*||'  '||pck_romance.fnc_semanadias(psemana => nv.semanacobranca)*/ "Semana Cobrança"
                     , nv.valortotalnota
                     , nv.valortotaldevolucao
                     , nv.valortotalvenda
                     , nv.valorpago /*+ nvl(  (select SUM(p.valor)
                                              from pepinosrepresentantes p
                                              where p.idnotavenda = nv.idnotavenda
                                                and p.situacao    = 'P') ,0) */valorpago
                     , nv.saldo
                from notasvendas    nv
                where nv.idvendedora  = :P136_IDVENDEDORA
                ```
        }
        layout {
            sequence: 20
            parentRegion: @cadastro-de-vendedoras
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Não há pepinos.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
