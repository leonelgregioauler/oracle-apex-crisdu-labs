            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P136_IDVENDEDORA is not null
                  and pck_romance.fnc_filialvendedora(:P136_IDVENDEDORA) != pck_romance.fnc_filialusuario(v('APP_USER')) 
                  and pck_romance.fnc_filialusuario(v('APP_USER')) not in (340,200,1205,360)
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

