    pageItem P136_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 80
            region: @cadastro-de-vendedoras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 400
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from usuarios u
                               where u.usuario = v('APP_USER')
                                 and idgerente = 143 )
                union
                select 1
                from dual
                where ( pck_romance.fnc_filialvendedora(:P136_IDVENDEDORA) != pck_romance.fnc_filialusuario(v('APP_USER')) 
                  and exists ( select 1
                               from usuarios u
                               where u.usuario = v('APP_USER')
                                 and idgerente != 143 )
                   or exists ( select 1
                               from funcionarios f
                               where f.idpessoa = :P136_IDPESSOA
                                 and f.idgerente = ( select idgerente 
                                                     from usuarios u 
                                                     where u.usuario = v('APP_USER') ) ) )
                   or :P136_IDVENDEDORA is null
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

