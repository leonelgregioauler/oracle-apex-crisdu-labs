    process fetch-row-from-vendedoras (
        name: Fetch Row from VENDEDORAS
        type: autoRowFetch
        source {
            tableOwner: CATAL
            tableName: VENDEDORAS
            pkColumn: IDVENDEDORA
            pkItem: P136_IDVENDEDORA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 11245757092710471
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDVENDEDORA.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P136_IDVENDEDORA := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 11245981531710471
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

