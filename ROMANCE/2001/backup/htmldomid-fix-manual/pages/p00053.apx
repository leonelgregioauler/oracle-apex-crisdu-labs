page 53 (
    name: Devolução de Produto para Filial
    title: Devolução de Produto para Filial
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function confirmaitem(event)
            { var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            if (tecla==13) 
            { var answer = confirm("Confirma inclusão do item no estoque?")
              if (answer)
              {apex.submit('CREATE');}}}
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region devolução-de-produto-para-filial (
        name: Devolução de Produto para Filial
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region movimentos-do-dia (
        name: Movimentos do Dia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select initcap( nvl(p.apelido,p.nomepessoa ) ) 
                         from filiais f
                            , pessoas p
                         where f.idpessoa = p.idpessoa
                           and f.idfilial = e.idfilial ) "Filial"
                     , ( select initcap( nvl(pr.apelido,pr.nomepessoa ) ) 
                         from representantes  rr
                            , pessoas         pr
                         where rr.idpessoa        = pr.idpessoa
                           and rr.idrepresentante = er.idrepresentante ) "Representante"
                     , ( select ca.nome
                         from categorias ca
                         where ca.idcategoria = ( select pr.idcategoria 
                                                 from produtos    pr
                                                 where pr.idproduto = e.idproduto ) ) "Categoria"
                     , ( select codigosisdist 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Código"   
                     , ( select initcap( pr.nomeproduto ) 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Produto"         
                     , ( select c.descricao 
                         from cores c
                         where c.idcor = e.idcor ) "Cor"
                     , e.idestoquefilial
                     , e.idfilial
                     , e.idproduto
                     , e.idcor
                     , me.quantidade    "Quantidade"
                     , me.observacao    "Observação"
                     , me.usuario       "Usuário"
                     , me.datamovimento "Data Movimento"
                     , me.qtd_pp "Qtd PP"
                     , me.qtd_p "Qtd P"
                     , me.qtd_m "Qtd M"
                     , me.qtd_g "Qtd G"
                     , me.qtd_gg "Qtd GG"
                     , me.qtd_egg "Qtd EGG"
                     , me.qtd_u "Qtd U"
                from estoquefilial           e
                   , estoquerepresentante    er
                   , movimentosestoquerepres me
                where e.idestoquefilial  = er.idestoquefil
                  and e.idestoquefilial  = me.idestoquefil
                  and er.idrepresentante = me.idrepresentante
                  and e.idfilial         = :P0_IDFILIAL   
                  and trunc(me.datamovimento) = trunc(sysdate)
                  and (
                        ( pck_romance.fnc_retornaparametro ( parametro => 'ESTOQUEPORGRADE' , pidfilial => :P0_IDFILIAL) = 'S' 
                             and ( nvl(me.qtd_pp,0) < 0 or nvl(me.qtd_p,0) < 0  or nvl(me.qtd_m,0) < 0 or nvl(me.qtd_g,0) < 0
                                or nvl( me.qtd_gg,0) < 0 or nvl(me.qtd_egg,0) < 0 or nvl(me.qtd_u,0) < 0 ))
                      or ( pck_romance.fnc_retornaparametro ( parametro => 'ESTOQUEPORGRADE' , pidfilial => :P0_IDFILIAL) = 'N' 
                            and nvl(me.quantidade,0) < 0 )
                      )
                order by me.datamovimento desc
                ```
        }
        layout {
            sequence: 20
            parentRegion: @devolução-de-produto-para-filial
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhum movimento efetuado hoje.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

