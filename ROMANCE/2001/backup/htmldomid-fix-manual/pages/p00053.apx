    pageItem P53_IDESTOQUEFIL (
        type: selectList
        label {
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap( pr.nomeproduto ) || decode(c.descricao, null, '', ' ('||c.descricao||')' ) display_value
                     , e.idestoquefilial   return_value
                from estoquefilial         e
                   , produtos              pr
                   , cores                 c
                where e.idproduto      = pr.idproduto
                  and e.idcor          = c.idcor (+)
                  and e.idfilial       = :P0_IDFILIAL
                  and pr.codigosisdist = :P53_CODIGO
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P53_CODIGO
        }
        layout {
            sequence: 40
            region: @devolução-de-produto-para-filial
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDESTOQUEFIL
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

