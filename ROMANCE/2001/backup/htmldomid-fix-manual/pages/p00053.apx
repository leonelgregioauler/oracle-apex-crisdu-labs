    pageItem P53_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap( nvl(p.apelido,p.nomepessoa ) ) display_value
                     , r.idrepresentante  return_value
                from representantes r
                   , pessoas        p
                   , gerentes       g
                where r.idpessoa  = p.idpessoa
                  and r.idgerente = g.idgerente
                  and r.ativo     = 'S'
                  and g.idfilial  = :P0_IDFILIAL
                ORDER BY 1
                ```
            nullDisplayValue: - Selecione o Representante -
        }
        layout {
            sequence: 20
            region: @devolução-de-produto-para-filial
            slot: regionBody
            alignment: left
            columnSpan: 10
        }
