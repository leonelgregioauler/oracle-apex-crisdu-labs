        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vid                    number;
                  vidfil                 number;
                  vidfilial              number;
                  videstfil              number;
                  vparametrofil          varchar2(1);
                  vparametrorep          varchar2(1);
                  vusaestoquereemb       varchar2(1);
                  vestoquereembgrade     varchar2(1);
                  videstoquereembalagem  number;
                  --
                begin 
                  --
                  select pck_romance.fnc_retornaparametro ( parametro => 'ESTOQUEPORGRADE'    , pidfilial => :P0_IDFILIAL)
                       , pck_romance.fnc_retornaparametro ( parametro => 'ESTOQUEREPPORGRADE' , pidfilial => :P0_IDFILIAL)
                       , pck_romance.fnc_retornaparametro ( parametro => 'USAESTOQUEREEMB'    , pidfilial => :P0_IDFILIAL)
                       , pck_romance.fnc_retornaparametro ( parametro => 'ESTOQUEEMBPORGRADE' , pidfilial => :P0_IDFILIAL)
                  into vparametrofil
                     , vparametrorep
                     , vusaestoquereemb
                     , vestoquereembgrade
                  from dual;
                  --
                  select seq_idmovtoestoquerepres.nextval
                  into vid
                  from dual;
                  --
                  begin
                    select idestoquerepresentante
                    into :P53_IDESTOQUEREPRESENTANTE
                    from estoquerepresentante
                    where idrepresentante = :P53_IDREPRESENTANTE
                      and idestoquefil    = :P53_IDESTOQUEFIL;
                  exception
                    when no_data_found then
                      select seq_idestoquerepres.nextval
                      into :P53_IDESTOQUEREPRESENTANTE
                      from dual;
                      --
                      insert into estoquerepresentante ( idestoquerepresentante , idrepresentante , idestoquefil 
                                                       , quantidade             , qtd_pp          , qtd_p   
                                                       , qtd_m                  , qtd_g           , qtd_gg  
                                                       , qtd_egg                , qtd_u  )
                      values ( :P53_IDESTOQUEREPRESENTANTE  , :P53_IDREPRESENTANTE   , :P53_IDESTOQUEFIL
                             , 0                            , 0                      , 0    
                             , 0                            , 0                      , 0  
                             , 0                            , 0 );
                    
                  end;
                  --
                  if vparametrorep = 'S'  then
                    --
                    insert into movimentosestoquerepres ( idmovtoestrepres  , idrepresentante   , idestoquefil
                                                        , quantidade        , iditnotavenda     , observacao
                                                        , usuario           , datamovimento     , idestoquerepresentante
                                                        , qtd_pp            , qtd_p             , qtd_m   
                                                        , qtd_g             , qtd_gg            , qtd_egg 
                                                        , qtd_u  )
                    values ( vid              , :P53_IDREPRESENTANTE      , :P53_IDESTOQUEFIL
                           , 0                , NULL                      , :P53_OBSERVACAO
                           , v('APP_USER')    , sysdate                   , :P53_IDESTOQUEREPRESENTANTE
                           , to_number(:P53_QTD_PP)*-1       , to_number(:P53_QTD_P )*-1               , to_number(:P53_QTD_M   )*-1
                           , to_number(:P53_QTD_G )*-1       , to_number(:P53_QTD_GG)*-1               , to_number(:P53_QTD_EGG )*-1
                           , to_number(:P53_QTD_U )*-1 );
                    --
                  else
                    --
                    :P53_QTD_U := nvl(to_number(:P53_QTD_PP ),0) + nvl(to_number(:P53_QTD_P ),0)   + nvl(to_number(:P53_QTD_M ),0) + nvl(to_number(:P53_QTD_G ),0)
                                     + nvl(to_number(:P53_QTD_GG),0)  + nvl(to_number(:P53_QTD_EGG ),0) + nvl(to_number(:P53_QTD_U ),0);
                    --                      
                    insert into movimentosestoquerepres ( idmovtoestrepres  , idrepresentante   , idestoquefil
                                                        , quantidade        , iditnotavenda     , observacao
                                                        , usuario           , datamovimento     , idestoquerepresentante )
                    values ( vid                            , :P53_IDREPRESENTANTE      , :P53_IDESTOQUEFIL
                           , TO_NUMBER(:P53_QTD_U     )*-1  , NULL                      , :P53_OBSERVACAO
                           , v('APP_USER')                  , sysdate                   , :P53_IDESTOQUEREPRESENTANTE );
                    --
                  end if;
                  --
                  select seq_idmovtoestoquefilial.nextval
                  into vidfil
                  from dual;
                  --
                  select g.idfilial
                  into vidfilial
                  from gerentes g
                     , representantes r
                  where g.idgerente       = r.idgerente
                    and r.idrepresentante = :P53_IDREPRESENTANTE;
                  --
                  if vusaestoquereemb = 'N' then
                    --
                    if vparametrofil = 'S' then
                      --
                      insert into movimentosestoquefilial ( idmovtoestoquefilial  , idestoquefil     , idfilial
                                                          , quantidade            , observacao       , usuario
                                                          , datamovimento          , qtd_pp          , qtd_p   
                                                          , qtd_m                  , qtd_g           , qtd_gg  
                                                          , qtd_egg                , qtd_u  )
                      values ( vidfil                          , :P53_IDESTOQUEFIL    , vidfilial
                             , 0                               , :P53_OBSERVACAO      , v('APP_USER')
                             , sysdate 
                             , to_number(:P53_QTD_PP)      , to_number(:P53_QTD_P )   , to_number(:P53_QTD_M   )
                             , to_number(:P53_QTD_G )      , to_number(:P53_QTD_GG)   , to_number(:P53_QTD_EGG )
                             , to_number(:P53_QTD_U ));
                      --
                    else
                      --
                      :P53_QTD_U := nvl(to_number(:P53_QTD_PP ),0) + nvl(to_number(:P53_QTD_P ),0)   + nvl(to_number(:P53_QTD_M ),0) + nvl(to_number(:P53_QTD_G ),0)
                                       + nvl(to_number(:P53_QTD_GG),0)  + nvl(to_number(:P53_QTD_EGG ),0) + nvl(to_number(:P53_QTD_U ),0);
                      --                      
                      insert into movimentosestoquefilial ( idmovtoestoquefilial  , idestoquefil  , idfilial
                                                          , quantidade            , observacao    , usuario
                                                          , datamovimento )
                      values ( vidfil                       , :P53_IDESTOQUEFIL    , vidfilial
                             , to_number(:P53_QTD_U)   , :P53_OBSERVACAO      , v('APP_USER')
                             , sysdate );
                      --
                    end if;
                    --
                  else
                    --  
                    begin
                      select ee.idestoquereembalagem
                      into videstoquereembalagem
                      from estoquereembalagem ee
                      where ee.idestoquefil = :P53_IDESTOQUEFIL
                        and ee.idfilial     = :P0_IDFILIAL ;
                    exception
                      when others then
                        select seq_idestoquereemb.nextval
                        into videstoquereembalagem
                        from dual;
                        --
                        insert into estoquereembalagem ( idestoquereembalagem   , idestoquefil   , quantidade
                                                       , idfilial               , qtd_pp         , qtd_p
                                                       , qtd_m                  , qtd_g          , qtd_gg
                                                       , qtd_egg                , qtd_u )
                        values ( videstoquereembalagem    , :P53_IDESTOQUEFIL     , 0
                               , :P0_IDFILIAL             , 0                     , 0
                               , 0                        , 0                     , 0
                               , 0                        , 0 );
                        --
                    end;
                    --
                    if vestoquereembgrade = 'S' then
                      --
                      insert into movimentosestoquereemb ( idmovtoestreemb   , idestoquefil         , quantidade
                                                         , iditprodembal     , observacao           , usuario
                                                         , datamovimento     , idestoquereembalagem , idfilial
                                                         , qtd_pp            , qtd_p                , qtd_m
                                                         , qtd_g             , qtd_gg               , qtd_egg
                                                         , qtd_u             )
                      values ( seq_idmovtoestreemb.nextval   , :P53_IDESTOQUEFIL         , null
                             , null                          , 'Devolução de mercadoria' , v('APP_USER')
                             , sysdate                       , videstoquereembalagem     , :P0_IDFILIAL             
                             , to_number(:P53_QTD_PP)        , to_number(:P53_QTD_P )   , to_number(:P53_QTD_M   )
                             , to_number(:P53_QTD_G )        , to_number(:P53_QTD_GG)   , to_number(:P53_QTD_EGG )
                             , to_number(:P53_QTD_U )); 
                      --
                    else              
                      --
                      :P53_QUANTIDADE := nvl(to_number(:P53_QTD_PP ),0) + nvl(to_number(:P53_QTD_P ),0)   + nvl(to_number(:P53_QTD_M ),0) + nvl(to_number(:P53_QTD_G ),0)
                                       + nvl(to_number(:P53_QTD_GG),0)  + nvl(to_number(:P53_QTD_EGG ),0) + nvl(to_number(:P53_QTD_U ),0);
                      --                      
                      insert into movimentosestoquereemb ( idmovtoestreemb   , idestoquefil         , quantidade
                                                         , iditprodembal     , observacao           , usuario
                                                         , datamovimento     , idestoquereembalagem , idfilial )
                      values ( seq_idmovtoestreemb.nextval    , :P53_IDESTOQUEFIL         , :P53_QUANTIDADE
                             , null                   , 'Devolução de mercadoria' , v('APP_USER')
                             , sysdate                , videstoquereembalagem     , :P0_IDFILIAL  );
                      --
                    end if;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Estoque movimentado com sucesso!
        }
        error {
            errorMessage: Houve um erro ao movimentar estoque, contate o administrador!
        }
        advanced {
            executionMappingIdentifier: 20585956623189154
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        clear {
            type: pages
            pages: 43
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 20586376730189154
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 53
            }
        }
    )

)

