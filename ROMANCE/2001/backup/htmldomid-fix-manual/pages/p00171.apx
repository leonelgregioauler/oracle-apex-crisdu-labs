    region acompanhamento-das-situações (
        name: Acompanhamento das Situações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select initcap(s.descricao)
                         from situacoessac s
                         where s.idsituacao = c.situacao ) "Situação"
                     , count(1) "Quantidade"
                from controlecontatossite c
                where idfilial = :P0_IDFILIAL
                  and ( :P171_DATAINICIO is null or c.dataliberadofilial between to_date(:P171_DATAINICIO) and to_date(:P171_DATAFIM) )
                group by c.situacao
                order by 1 
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent9
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P171_TIPORELATORIO
            value: S
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2263925455828349244
        }

