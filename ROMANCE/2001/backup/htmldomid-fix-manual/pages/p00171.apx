    region acompanhamento-de-distribuidores (
        name: Acompanhamento de Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) "Representante"
                     , ( select initcap(s.descricao)
                         from situacoessac s
                         where s.idsituacao = c.situacao ) "Situação"
                     , count(1) "Quantidade"
                from controlecontatossite c
                where idfilial = :P0_IDFILIAL
                  and ( :P171_IDREPRESENTANTE is null or c.idrepresentante = :P171_IDREPRESENTANTE )
                  and c.idrepresentante is not null
                  and ( :P171_DATAINICIO is null or c.dataliberadofilial between to_date(:P171_DATAINICIO) and to_date(:P171_DATAFIM) )
                group by c.idrepresentante , c.situacao
                order by 1 
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent12
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P171_TIPORELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2263924970437349239
        }

