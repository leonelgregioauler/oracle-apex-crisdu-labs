    dynamicAction cpf (
        name: CPF
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P171_CPFDOCESTRANGEIRO
        }
        clientSideCondition {
            type: item=value
            item: P171_CPFDOCESTRANGEIRO
            value: CPF
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P171_CPF
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P171_CPF
            }
            execution {
                sequence: 10
            }
        )

    )

