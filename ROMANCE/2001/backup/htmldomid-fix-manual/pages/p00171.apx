    region placar-das-indicações (
        name: Placar das Indicações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select entrou.qtd "Recebidos"
                     , encaminhado.qtd "Aguardando Cadastro"
                     , aguardando.qtd "Aguardando Encaminhar"
                     , cadastrado.qtd "Cadastrados"
                     , rejeitado.qtd "Rejeitados"
                from ( select count(1) qtd
                       from controlecontatossite c
                       where c.idfilial = :P0_IDFILIAL
                         and c.situacao in ('E','B','C','U','Z','F')
                         and c.dataliberadofilial between to_date(:P171_DATAINICIO) and to_date(:P171_DATAFIM) ) entrou
                   , ( select count(1) qtd
                       from controlecontatossite c
                       where c.situacao in ('E','B','C')
                         and c.idrepresentante is null
                         and c.idfilial = :P0_IDFILIAL
                         and c.dataliberadofilial between to_date(:P171_DATAINICIO) and to_date(:P171_DATAFIM) ) aguardando
                   , ( select count(1) qtd
                       from controlecontatossite c
                       where c.situacao = 'E'
                         and c.idrepresentante is not null
                         and c.idfilial = :P0_IDFILIAL
                         and c.dataliberadofilial between to_date(:P171_DATAINICIO) and to_date(:P171_DATAFIM) ) encaminhado
                   , ( select count(1) qtd
                       from controlecontatossite c
                       where c.situacao = 'U'
                         and c.idrepresentante is not null
                         and c.idfilial = :P0_IDFILIAL
                         and c.datacadastro between to_date(:P171_DATAINICIO) and to_date(:P171_DATAFIM) ) cadastrado
                   , ( select count(1)  qtd
                       from controlecontatossite c
                       where c.situacao in ('Z','F')
                         and c.idfilial = :P0_IDFILIAL
                         and c.dataliberadofilial between to_date(:P171_DATAINICIO) and to_date(:P171_DATAFIM) ) rejeitado
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hiddenOverflow
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <h3>
                    O Placar sempre será baseado nas datas que estão disponíveis para serem filtradas!
                </h3>
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1473569097995175737
        }

