    region protocolos (
        name: Protocolos
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Protocolos Urgentes' tipo
                     , count(1)  qtd
                from roman.controlecontatossite ec
                where idfilial = :P0_IDFILIAL
                  and ec.situacao in ('P','E') 
                  and ec.tipo = 3
                  and ec.datacadastro > '01/01/2024'
                  and not exists ( select 1
                                     from roman.historicosfranquiasetor e
                                    where e.idcontrolecontatossite = ec.idcontrolecontatossite)
                union
                select 'Protocolos Expirados' tipo
                     , count(1)  qtd
                from roman.controlecontatossite ec
                where idfilial = :P0_IDFILIAL
                  and ec.situacao in ('Q') 
                  and ec.tipo = 3
                  and not exists ( select 1
                                     from roman.historicosfranquiasetor e
                                    where e.idcontrolecontatossite = ec.idcontrolecontatossite)
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.controlecontatossite ec
                where idfilial = :P0_IDFILIAL
                  and ec.situacao in ('P','E') 
                  and ec.tipo = 3
                ```
        }
        settings {
            labelColumn: TIPO
            valueColumn: QTD
            linkTarget: {
                page: 724
                action: resetPagination
            }
            color: yes
        }
    )

