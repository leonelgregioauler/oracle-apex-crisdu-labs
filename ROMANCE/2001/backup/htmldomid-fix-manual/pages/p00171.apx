        }
        behavior {
            target: {
                page: 171
                items: {
                    P171_TIPO: &P171_TIPO.
                    P171_IDREPRESENTANTE: &P171_IDREPRESENTANTE.
                    P171_CPF: &P171_CPF.
                    P171_TIPORELATORIO: &P171_TIPORELATORIO.
                    P171_NRPROTOCOLO: &P171_NRPROTOCOLO.
                    P171_DATAINICIO: &P171_DATAINICIO.
                    P171_DATAFIM: &P171_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

