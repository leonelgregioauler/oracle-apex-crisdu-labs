    region indicações (
        name: Indicações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idcontrolecontatossite
                     , nomecompleto
                     , cpf
                     , documentoestrangeiro
                     , datanascimento
                     , rua
                     , nr
                     , complemento
                     , bairro
                     , pck_romance.fnc_nomecidade(idcidade) "Cidade"
                     , cep
                     , email
                     , msn
                     , mensagem
                     , observacao
                     , ec.datacadastro
                     , ec.fone
                     , ec.fone2
                     , pck_romance.fnc_nomefilial(idfilial) "Filial"
                     , pck_romance.fnc_nomerepresentante(idrepresentante) "Representante"
                     , dataliberadofilial "Dt Liberado Filial"
                     , datapassadorepres  "Dt Liberado Repres"
                      , pck_romance.fnc_nomefilial(idfilialorig) "Filial Orig"
                     , pck_romance.fnc_nomerepresentante(idrepresentanteorig) "Representante Orig"
                     , ( select initcap(tp.descricao) from tipossolicitacoessac tp where tp.idtipocontrolesac = ec.tipo) tipo
                     , decode(ec.cadastrado, 'S', 'Sim'
                                           , 'N', 'Não') cadastrado
                     , ( select initcap(tt.descricaointerna) from situacoessac tt where tt.idsituacao = ec.SITUACAO ) "Situação"
                     , usuariocadastrou "Cadastrou"
                     , nvl(( select 'Sim'
                             from pessoas p 
                             where p.cpf = replace(replace(ec.cpf,'.',''),'-','')),'Não') cadastronosistema 
                     , ( select o.origem
                         from origemsac o
                         where o.idorigemsac = ec.origem ) origem
                     , observacaorepresentante
                     , USUARIOLIBEROUREPRES
                     , DATAULTIMAATUALIZACAO
                     , horarioatendimento
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':172:'||v('APP_SESSION')||'::NO::P172_IDCONTROLECONTATOSSITE:'||idcontrolecontatossite,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' url
                from controlecontatossite ec
                where idfilial = :P0_IDFILIAL
                  and ( (:P171_TIPO = 'P' and ec.situacao in ('E','C','B') 
                                          and ec.idrepresentante is null
                                          and ec.origem != 'LN' )
                      or ( :P171_TIPO = 'P' and ec.situacao in ('E','C','B','P') 
                                            and ec.origem = 'LN' )
                      or ( :P171_TIPO = 'E' and ec.situacao = 'E'
                                            and ec.idrepresentante is not null 
                                            and ( :P171_IDREPRESENTANTE is null or ec.idrepresentante = :P171_IDREPRESENTANTE )
                                            and ( :P171_NRPROTOCOLO is null or ec.idcontrolecontatossite = :P171_NRPROTOCOLO ) )
                      or ( :P171_TIPO = 'Z' and ec.situacao in ('Z','F')
                                            and ( :P171_IDREPRESENTANTE is null or ec.idrepresentante = :P171_IDREPRESENTANTE )
                                            and ( :P171_NRPROTOCOLO is null or ec.idcontrolecontatossite = :P171_NRPROTOCOLO ) )
                      or ( :P171_TIPO = 'U' and ec.situacao = 'U'
                                            and ec.idrepresentante is not null
                                            and ( :P171_IDREPRESENTANTE is null or ec.idrepresentante = :P171_IDREPRESENTANTE ) 
                                            and ( :P171_NRPROTOCOLO is null or ec.idcontrolecontatossite = :P171_NRPROTOCOLO ) )
                      or ( :P171_TIPO = 'R' and ec.situacao = 'R'
                                            and ( :P171_IDREPRESENTANTE is null or ec.idrepresentante = :P171_IDREPRESENTANTE )
                                            and ( :P171_NRPROTOCOLO is null or ec.idcontrolecontatossite = :P171_NRPROTOCOLO ) )
                      or ( :P171_TIPO = 'X' and ( :P171_IDREPRESENTANTE is null or ec.idrepresentante = :P171_IDREPRESENTANTE )
                                            and ec.situacao in ('E','C')
                                            and ( :P171_NRPROTOCOLO is null or ec.idcontrolecontatossite = :P171_NRPROTOCOLO )
                                            and exists ( select 1
                                                         from controleexpiracaoindicacoes cii
                                                         where cii.idcontrolecontatossite = ec.idcontrolecontatossite 
                                                           and cii.expirado               = 'S'))
                      or ( :P171_TIPO = 'T' and ( :P171_IDREPRESENTANTE is null or ec.idrepresentante = :P171_IDREPRESENTANTE )
                                            and ( :P171_NRPROTOCOLO is null or ec.idcontrolecontatossite = :P171_NRPROTOCOLO ) ) )
                  and ( :P171_CPF is null or replace(replace(replace(ec.cpf,'.',''),'-',''),' ','') = replace(replace(:P171_CPF,'.',''),'-','') )
                  and ( :P171_DOCUMENTOESTRANGEIRO is null or ec.documentoestrangeiro = :P171_DOCUMENTOESTRANGEIRO )
                  and ( :P171_NRPROTOCOLO is null or ec.idcontrolecontatossite = :P171_NRPROTOCOLO )
                  and ( :P171_DATAINICIO is null or trunc(ec.dataliberadofilial) between to_date(:P171_DATAINICIO) and to_date(:P171_DATAFIM) )
                  and ec.tipo != 2
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color="GREEN"> - Pendente ? Cadastros Aprovados pelo SAC que faltam encaminhar para um(a) Distribuidor(a).</font>
                <font color="RED"><br> - Rejeitado ? Cadastros Rejeitados pelo Distribuidor(a) ou pela Empresa.</font>
                <font color="BLUE"><br>- Encaminhado ? Cadastros Encaminhados para algum(a) Distribuidor(a).</font>
                <font color="GREEN"><br>- Expirado ? Cadastros que já estão a mais de 14 dias com o(a) Distribuidor(a).</font>
                <font color="RED"><br>- Utilizado ? Cadastros que Distribuidor(a) utilizou no tablet e gerou um novo cadastro.</font>
                <font color="BLUE"><br>- Respondido ? Cadastros que tiveram alguma ação da Empresa ou do(a) Distribuidor(a).</font>
                ```
        }
        serverSideCondition {
            type: item=value
            item: P171_TIPORELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Não há consultoras pendentes.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
                excel
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

