page 166 (
    name: Integração para Netbooks
    title: Integração para Netbooks
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region integração-para-netbooks (
        name: Integração para Netbooks
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idexportrepres
                     , pck_romance.fnc_nomerepresentante(e.idrepresentante) "Representante"
                     , e.semanacobranca "Semana Cobrança"
                from exportrepresentantes e
                where pck_romance.fnc_filialrepresentante(idrepresentante) = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        link {
            linkColumn: customTarget
            target: {
                page: 167
                items: {
                    P167_IDEXPORTREPRES: #IDEXPORTREPRES#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt="" />
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column IDEXPORTREPRES (
            type: plainText
            heading {
                heading: Idexportrepres
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDEXPORTREPRES
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Representante (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Representante
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Semana Cobrança" (
            type: plainText
            heading {
                heading: Semana Cobrança
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Semana Cobrança
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 5348290 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn "Representante" (
                sequence: 1
            )

            displayColumn "Semana Cobrança" (
                sequence: 2
            )

        )

    )

)

