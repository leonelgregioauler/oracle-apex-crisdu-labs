page 116 (
    name: Movimentos da Reembalagem
    title: Movimentos da Reembalagem
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region movimentos-da-reembalagem (
        name: Movimentos da Reembalagem
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select initcap( nvl(p.apelido,p.nomepessoa ) ) 
                         from filiais f
                            , pessoas p
                         where f.idpessoa = p.idpessoa
                           and f.idfilial = e.idfilial ) "Filial"
                     , ( select ca.nome
                         from categorias ca
                         where ca.idcategoria = ( select pr.idcategoria 
                                                 from produtos    pr
                                                 where pr.idproduto = e.idproduto ) ) "Categoria"
                     , ( select codigosisdist 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Código"   
                     , ( select initcap( pr.nomeproduto ) 
                         from produtos    pr
                         where pr.idproduto = e.idproduto ) "Produto"         
                     , ( select c.descricao 
                         from cores c
                         where c.idcor = e.idcor ) "Cor"
                     , e.idestoquefilial
                     , e.idfilial
                     , e.idproduto
                     , e.idcor
                     , me.qtd_pp   
                     , me.qtd_p    
                     , me.qtd_m    
                     , me.qtd_g    
                     , me.qtd_gg   
                     , me.qtd_egg  
                     , me.qtd_exgg
                     , me.qtd_u    
                     , me.observacao    "Observação"
                     , me.usuario       "Usuário"
                     , me.datamovimento "Data Movimento"
                     , me.idmovtoestreemb
                     ,pck_util.fnc_semanaid(pck_util.fnc_idsemanadata(trunc(me.datamovimento))) semana
                from estoquefilial           e
                   , estoquereembalagem    er
                   , movimentosestoquereemb me
                where e.idestoquefilial  = er.idestoquefil
                  and e.idestoquefilial  = me.idestoquefil
                  and trunc(me.datamovimento) between to_date(:P116_DATAINICIO) and to_date(:P116_DATAFIM)
                  and e.idfilial = :P0_IDFILIAL
                order by me.datamovimento desc
                ```
        }
        layout {
            sequence: 20
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Estoque sem movimentação.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
