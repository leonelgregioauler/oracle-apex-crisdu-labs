page 217 (
    name: Relatório de Venda Direta
    title: Relatório de Venda Direta
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region pesquisa-de-venda-direta (
        name: Pesquisa de Venda Direta
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-de-venda-direta-favorita (
        name: Relatório de Venda Direta Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idvendadireta 
                     , idfilial
                     , pck_romance.fnc_nomerepresentante(idrepresentante) representante
                     , pck_romance.fnc_nomevendedora(idvendedora) vendedora
                     , cpfvendedora
                     , solicitante
                     , datasolicitacao
                     , datavencimento
                     , dataentrega
                     , atendente
                     , ( select b.numero
                         from boletos b
                         where b.idboleto = v.IDBOLETO ) boleto
                     , decode(situacao,'A','Aberto', 'R','Rejeitado','C','Concluido', 'Incompleto') Situacao
                     , observacaofavorita "Obs Favorita"
                     , observacao
                     , ( select b.valorcobrado
                         from boletos b
                         where b.idboleto = v.IDBOLETO ) valor
                from vendadiretafavorita  v
                where idfilial = :P0_IDFILIAL
                  and ( :P217_DATAINI is null or ( :P217_DATA = 'S' and trunc(v.DATASOLICITACAO ) between :P217_DATAINI and :P217_DATAFIM )
                                              or ( :P217_DATA = 'V' and trunc(v.DATAVENCIMENTO )  between :P217_DATAINI and :P217_DATAFIM )
                                              or ( :P217_DATA = 'E' and trunc(v.DATAENTREGA )     between :P217_DATAINI and :P217_DATAFIM ) )
                order by 1 desc
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 220
                items: {
                    P220_IDVENDADIRETA: #IDVENDADIRETA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Não há protocolos inseridos.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
