    dynamicAction tipo-pagamento (
        name: tipo pagamento
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P219_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P219_TIPO
            value: Q
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P219_NUMEROCOMPROVANTE
                    P219_VALORDEPOSITADO
                    P219_DATAPAGAMENTO
                    P219_CONTAPAGAMENTO
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P219_NUMEROCOMPROVANTE
                    P219_VALORDEPOSITADO
                    P219_DATAPAGAMENTO
                    P219_CONTAPAGAMENTO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-prorrogação (
        name: tipo prorrogação
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P219_TIPO
        }
