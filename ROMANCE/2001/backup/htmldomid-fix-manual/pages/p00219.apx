            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            
            
            function fnc_imprimepedido() {
            window.open('f?p=&APP_ID.:228:&SESSION.::NO::P228_IDPEDIDO:'+document.getElementById('P219_IDPEDIDO').value ,'pedido','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0); 
            }
            
            function imprimeboleto() {
                    window.open('http://boletos.romancemoda.com.br:7777/boleto/boleto_bb_multi.php?idpedido='+document.getElementById('P219_IDPEDIDO').value,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); void(0);  
            }
            
            ```
