    region resumo-de-notas (
        name: Resumo de Notas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT N.NUMERONOTA "Nota"
                , N.SEMANADISTRIBUICAO "Distribuição"
                , N.SEMANACOBRANCA "Cobrança"
                , N.VALORTOTALNOTA "Total Nota"
                , N.SALDO "Valor Devido"
                , PCK_ROMANCE.FNC_NOMEREPRESENTANTE(N.IDREPRESENTANTE) "REPRESENTANTE"
                FROM NOTASVENDAS N
                WHERE IDVENDEDORA = ( SELECT IDVENDEDORA
                                      FROM VENDEDORAS
                                      WHERE IDPESSOA = ( SELECT IDPESSOA
                                                         FROM PESSOAS
                                                         WHERE CPF = :P219_CPF))
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            includeSearchBar: false
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 446474924859473251
        }

