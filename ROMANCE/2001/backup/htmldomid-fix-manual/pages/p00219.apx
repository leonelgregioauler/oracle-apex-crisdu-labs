        behavior {
            action: redirectUrl
            targetUrl: javascript: imprimeboleto()
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select idpedido
                from pedidos
                where nrpedido like '%'||TRIM(:P219_NUMEROPEDIDO)
                  and idvendedora = ( select idvendedora
                                      from vendedoras v
                                      where v.idpessoa = ( select idpessoa
                                                           from pessoas p
                                                           where cpf = replace(replace( :P219_CPF,'.',''),'-','') ) ) 
                  and :P219_SITUACAO = 'C'
                ```
        }
    )

