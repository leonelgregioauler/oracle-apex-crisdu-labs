    validation valida-cpf-com-pedido (
        name: Valida CPF com pedido
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select v.idvendedora
                from pessoas p
                   , vendedoras v
                where v.idpessoa = p.idpessoa
                  and p.cpf = :P219_CPF
                ```
        }
        error {
            errorMessage: CPF não cadastrado!
        }
    )

    validation valida-numero-pedido (
        name: Valida numero pedido
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from pedidos p
                where nrpedido like '%'||:P219_NUMEROPEDIDO
                  and exists (select 1
                              from vendedoras v
                              where v.idvendedora = p.idvendedora
                                and v.idpessoa = ( select idpessoa
                                                   from pessoas 
                                                   where cpf = replace(:P219_CPF,' ','')))
                ```
        }
        error {
            errorMessage: Pedido informado não existe!
        }
    )

    process atualiza-pedido (
        name: atualiza pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidpedido number;
                begin
                  --
                  select p.idpedido
                  into vidpedido
                  from catal.pedidos p
                  where ( p.nrpedido = '2846474'||lpad(:P219_NUMEROPEDIDO,10,'0')
                       or p.nrpedido like '%'||:P219_NUMEROPEDIDO||'%' )
                    and p.idvendedora = ( select idvendedora
                                          from vendedoras v
                                          where idpessoa = ( select idpessoa
                                                             from pessoas 
                                                             where cpf = :P219_CPF ) );
                  --
                  update catal.pedidos p
                  set p.nrprotocolo = :P219_IDPROTOCOLO
                  where p.idpedido = vidpedido;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 270441637169652240
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

