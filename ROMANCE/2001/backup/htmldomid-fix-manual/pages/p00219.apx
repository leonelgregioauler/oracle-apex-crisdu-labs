        }
        layout {
            sequence: 200
            region: @protocolo-de-cancelamento-prorrogação-pagamento
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select idpedido
                from pedidos
                where nrpedido like '%'||TRIM(:P219_NUMEROPEDIDO)
                  and idvendedora = ( select idvendedora
                                      from vendedoras v
                                      where v.idpessoa = ( select idpessoa
                                                           from pessoas p
                                                           where cpf = replace(replace( :P219_CPF,'.',''),'-','') ) )
                ```
            used: always
        }
