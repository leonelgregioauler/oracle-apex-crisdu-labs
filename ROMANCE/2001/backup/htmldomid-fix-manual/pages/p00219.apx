                ```sql
                select initcap(p.nomepessoa)||' ('||pck_romance.fnc_nomerepresentante(v.idrepresentante)||')'
                     , p.idpessoa
                from pessoas p
                   , vendedoras v
                where v.idpessoa = p.idpessoa
                  and p.cpf = :P219_CPF
                ```
            displayExtraValues: false
            displayNullValue: false
