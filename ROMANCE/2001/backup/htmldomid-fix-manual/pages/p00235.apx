page 235 (
    name: Regiões de Distribuidores
    title: Regiões Que Distribuidores Atendem
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region regiões-de-distribuidor (
        name: Regiões de Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rr.semana "Semana"
                     , pck_romance.fnc_nomeregiaovenda(rr.idregiaovenda) "Região de Venda"
                     , pck_romance.fnc_nomerepresentante(r.idrepresentante) "Representante"
                     , rr.idregiaovenda "Cód. Região"
                     , nvl(rr.valoragregado,0) "Valor Agregado"
                from representantes r
                   , regioesrepresentantes rr
                where r.idrepresentante = rr.idrepresentante
                  and r.ativo = 'S'
                  and r.idgerente = (select idgerente 
                                     from gerentes 
                                     where idfilial = :P0_IDFILIAL )
                  and ( (:P235_TIPO = 'R' and rr.idrepresentante = :P235_IDREPRESENTANTE )
                     or (:P235_TIPO = 'S' and rr.semana = :P235_SEMANA )
                     or (:P235_TIPO = 'C' and rr.idregiaovenda = :P235_IDREGIAOVENDA ) 
                     or (:P235_TIPO = 'T' ) )
                order by rr.semana
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum representante atende esta região!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 571996404204615481
        }

        column "Cód. Região" (
            type: plainText
            heading {
                heading: Cód. região
                alignment: center
            }
            layout {
                sequence: 23
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column "Região de Venda" (
            type: plainText
            heading {
                heading: Região De Venda
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Região de Venda
                endUserAlias: B
            }
        )

        column Representante (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Representante
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Semana (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 13
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column "Valor Agregado" (
            type: plainText
            heading {
                heading: Valor Agregado
                alignment: center
            }
            layout {
                sequence: 33
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        savedReport 5719976 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn "Cód. Região" (
                sequence: 5
            )

            displayColumn "Região de Venda" (
                sequence: 1
            )

            displayColumn "Representante" (
                sequence: 2
            )

            displayColumn "Semana" (
                sequence: 3
            )

            displayColumn "Valor Agregado" (
                sequence: 4
            )

            sort (
                column: "Semana"
                sort {
                    sequence: 1
                }
            )

            sort (
                column: "Representante"
                sort {
                    sequence: 2
                }
            )

            controlBreak (
                column: "Representante"
                layout {
                    sequence: 1
                }
            )

        )

    )

    region regiões-de-distribuidor-2 (
        name: Regiões de Distribuidor
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
    )

    pageItem P235_IDREGIAOVENDA (
        type: popupLov
        label {
            label: Região de Venda
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.descricao
                 , r.idregiaovenda
                from regioesvenda r
                where r.idestado in ( select f.idestado
                                      from filiaisregioesvenda f
                                      where f.idfilial = :P0_IDFILIAL )
                order by 1 
                ```
        }
        layout {
            sequence: 20
            region: @regiões-de-distribuidor-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P235_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||r.idrepresentante||') ' || decode(r.ativo,'S','','Inativo') display_value
                     , r.idrepresentante
                from representantes r
                where idgerente in ( select idgerente
                                     from gerentes
                                     where idfilial = :P0_IDFILIAL)
                  and r.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @regiões-de-distribuidor-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P235_SEMANA (
        type: textField
        label {
            label: Semana
            alignment: left
        }
        layout {
            sequence: 30
            region: @regiões-de-distribuidor-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P235_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: staticValues
            staticValues: STATICS:Semana;S,Distribuidor;R,Região;C,Todos;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @regiões-de-distribuidor-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button p235-filtrar (
        buttonName: P235_FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @regiões-de-distribuidor-2
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: P235_FILTRAR
        }
    )

    dynamicAction tipo (
        name: tipo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P235_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P235_TIPO
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P235_IDREGIAOVENDA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P235_SEMANA
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P235_IDREGIAOVENDA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P235_SEMANA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction tipo-2 (
        name: tipo 2
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P235_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P235_TIPO
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P235_IDREPRESENTANTE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P235_IDREGIAOVENDA
                    P235_SEMANA
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P235_IDREPRESENTANTE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-3 (
        name: tipo 3
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P235_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P235_TIPO
            value: T
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P235_IDREGIAOVENDA
                    P235_SEMANA
                    P235_IDREPRESENTANTE
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 235
                items: {
                    P235_IDREGIAOVENDA: &P235_IDREGIAOVENDA.
                }
                successMessage: false
            }
        }
    )

)

