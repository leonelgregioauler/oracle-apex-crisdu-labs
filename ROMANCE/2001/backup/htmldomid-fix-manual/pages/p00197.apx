        savedReport 2915996 (
            visibility: primaryDefault
            view {
                rowsPerPage: 25
            }

            displayColumn "Consultora" (
                sequence: 2
            )

            displayColumn NUMERO (
                sequence: 4
            )

            displayColumn "Promis. Recebida" (
