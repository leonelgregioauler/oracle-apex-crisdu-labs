page 197 (
    name: Envio de Promissórias
    title: Envio de Promissórias
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region distribuidor (
        name: Distribuidor
        type: staticContent
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region promissórias-recebidas-na-cobrança (
        name: Promissórias recebidas na cobrança
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ FIRST_ROWS(25) */ b.idboleto
                     , 'B'||b.numero numero
                     , pck_romance.fnc_nomerepresentante(b.idrepresentante ) "Representante"
                     , pck_romance.fnc_nomevendedora( b.idvendedora ) "Consultora"
                     , b.valorcobrado "Valor Total"
                     , decode(b.promissoriarecebida,'S','Sim','Não') "Promis. Recebida"
                     , ( select descricao 
                        from catal.situacoespromissorias s
                        where s.idsituacaopromis = b.idsituacaopromissoria ) "Sit. Promissória"
                     , ( select descricao
                         from catal.situacoes ss
                         where ss.idsituacao = b.situacao) "Sit. Boleto"
                     , vencimentooriginal
                from boletos b
                where b.idfilial = :P0_IDFILIAL
                  and b.situacao in ( 'E','K','N','G','P','S','V')
                  and ( :P197_IDREPRESENTANTE is null or b.idrepresentante = :P197_IDREPRESENTANTE )
                order by 3,4 desc
                ```
            pageItemsToSubmit: P197_IDREPRESENTANTE
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 291598231840072067
        }

        column Consultora (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Consultora
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDBOLETO (
            type: hidden
