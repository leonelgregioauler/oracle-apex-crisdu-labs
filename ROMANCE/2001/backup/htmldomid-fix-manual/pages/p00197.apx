            advanced {
                htmlDomId: Representante
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Sit. Boleto" (
            type: plainText
            heading {
                heading: Sit. Boleto
                alignment: center
