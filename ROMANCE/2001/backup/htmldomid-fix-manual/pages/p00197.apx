                }
            )

        )

    )

    pageItem P197_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||r.idrepresentante||')' || decode(r.ativo,'S','','Inativo') display_value
                     , r.idrepresentante
                from representantes r
                where idgerente in ( select idgerente
                                     from gerentes
                                     where idfilial = :P0_IDFILIAL)
                order by 1
                ```
            nullDisplayValue: << Todos Distribuidores >>
        }
        layout {
            sequence: 10
            region: @distribuidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P197_IDREPRESENTANTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @promissórias-recebidas-na-cobrança
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

