page 174 (
    name: Favorita
    title: Favorita
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region favorita (
        name: Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  /*+ FIRST_ROWS(15) */b.idboleto
                     , 'B'||b.numero numero
                     , ( select pp.nrpedido from pedidos pp where pp.idpedido = b.idpedido ) nrpedido
                     , pck_romance.fnc_nomefilial( b.idfilial)  "Filial"
                     , pck_romance.fnc_nomerepresentante(b.idrepresentante ) "Representante"
                     , pck_romance.fnc_nomevendedora( b.idvendedora ) "Vendedora"
                     , trunc(dataemissao)  "Data Emissão"
                     , b.datavencimento "Data Vencimento"
                     , ( select pp.datacancelado from pedidos pp where pp.idpedido = b.idpedido )  "Data Cancelamento"
                     , b.valorcobrado "Valor Total"
                     , catal.pck_favorita.prc_descrsituacao(b.situacao) "Situação"
                    , trunc(b.databaixa) databaixa
                    , b.observacao
                    , ( select p.vlrtotalsemcomissao
                        from pedidos p
                        where p.idpedido = b.idpedido ) vlrpedido
                    , ( select :Var1
                        from pedidos p
                        where p.idpedido = b.idpedido ) "Situação Pedido"
                    , decode(b.NEGOCIACAO, 'S','Sim','Não') Negociacao
                     , ( select pp.resticaospc from pedidos pp where pp.idpedido = b.idpedido )  "Restrição SPC"
                     , ( select decode(pp.liberacaopromotor,'S','Sim','Não') from pedidos pp where pp.idpedido = b.idpedido )  "Promotor Liberou"
                    , ( select b1.numero from boletos b1 where b1.idboleto = b.idboletonegociacao) "Boleto Original"
                    , ( select count(1) from boletos b2 where b2.idboletonegociacao = b.idboleto) "Qtd Boletos Negociados"
                    , DECODE(negociacaovencida,'S','Sim','Não') "Negociação Vencida"
                    , decode(RECUPERARASSINATURA,null,'-','X') "Recuperar Assinatura"
                    , decode(aguardandoretornoassinatura,null,'-','X') "Enviado para Recuperar Ass."
                    , decode(b.QUITADOVIADEPOSITO,'S','Sim','Não') "Quitado Via Depósito"
                    , (select initcap(bb.nomebanco)||' - '||agencia||'/'||conta 
                        from contasbancarias c 
                           , bancos bb
                        where bb.idbanco = c.idbanco
                          and :Var2 = b.idcontabancaria ) Conta
                    , NUMEROCOMPROVANTE "Nro Comprovante"
                    , QUITADOSEMCOMPROVANTEDEP "Quitado s/ Comp. de Dep."
                    , b.responsavelcobranca
                    , pck_romance.fnc_retornatelefones(b.idvendedora) "Telefones"
                from boletos b
                where b.idvendedora=  :P174_IDVENDEDORA
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: -
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 83276041878904930
        }

