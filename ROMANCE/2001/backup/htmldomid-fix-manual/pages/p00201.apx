            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Rejeitar
                endUserAlias: K
            }
            enableUsersTo {
                pivot: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column Representante (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Representante
                endUserAlias: G
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Situação (
            type: plainText
            heading {
                heading: Situação
                alignment: center
            }
            layout {
                sequence: 6
            }
            source {
