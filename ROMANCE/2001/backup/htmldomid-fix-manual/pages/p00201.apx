            }
            advanced {
                htmlDomId: Usuário
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 3255796 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn "Confirmar" (
                sequence: 6
            )

            displayColumn "Data Correção" (
                sequence: 2
            )

            displayColumn "Motivo" (
                sequence: 3
            )

            displayColumn "Nr Nota" (
                sequence: 5
            )

            displayColumn "Rejeitar" (
                sequence: 7
            )

            displayColumn "Representante" (
                sequence: 1
            )

            displayColumn "Situação" (
                sequence: 4
            )

            sort (
                column: "Data Correção"
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            sort (
                column: "Representante"
                sort {
                    sequence: 2
                }
            )

            filter ir-condition (
                column: "Situação"
                value: Pendente
            )

            controlBreak (
                column: "Representante"
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P201_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @pendências-de-anotações
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P201_IDCORRECAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @pendências-de-anotações
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P201_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select '- Ver todos -' display_value
                     , -1 return_value
                from dual
                union
                select PCK_ROMANCE.fnc_nomepessoa(idpessoa) display_value
                    , r.idrepresentante return_value
                from representantes r
                where pck_romance.fnc_filialgerente(idgerente) = :P0_IDFILIAL
                and (:P0_IDPOSTOAVANCADO is null or  r.idpostoavancado = :P0_IDPOSTOAVANCADO )
                and r.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: "- Selecione um Distribuidor - "
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button irparaacerto (
        buttonName: IRPARAACERTO
        label: Ir Para Acertos Pendentes
        layout {
            sequence: 10
            region: @filtro
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 183
                items: {
                    P183_IDREPRESENTANTEFILTRO: &P201_IDREPRESENTANTE.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh (
        name: refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P201_IDREPRESENTANTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @pendências-de-anotações
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action submit (
            name: SUBMIT
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process confirma-anotação (
        name: Confirma Anotação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update correcoesnotasvendas
                  set situacao = 'C'
                  where idcorrecaonotavenda = :P201_IDCORRECAO;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Correção confirmada!
        }
        advanced {
            executionMappingIdentifier: 335039477831580719
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR
        }
    )

    process rejeita-anotação (
        name: Rejeita Anotação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update correcoesnotasvendas
                  set situacao = 'R'
                  where idcorrecaonotavenda = :P201_IDCORRECAO;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Confirmação rejeitada!
        }
        advanced {
            executionMappingIdentifier: 335039881987581938
        }
        serverSideCondition {
            type: request=Value
            value: REJEITAR
        }
    )

    branch (
        name: Go To Page 201
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 201
                items: {
                    P201_IDREPRESENTANTE: &P201_IDREPRESENTANTE.
                    P201_FILTRAR: S
                }
            }
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

)

