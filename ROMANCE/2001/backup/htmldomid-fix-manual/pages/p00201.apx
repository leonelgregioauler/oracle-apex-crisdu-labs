page 201 (
    name: Relatório de Pendências de Anotações
    title: Relatório de Pendências de Anotações
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            
            
            function fnc_confirma(pid)
            {
              document.getElementById('P201_IDCORRECAO').value = pid;
              apex.submit('CONFIRMAR');
            }
            
            function fnc_rejeita(pid)
            {
              document.getElementById('P201_IDCORRECAO').value = pid;
              apex.submit('REJEITAR');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pendências-de-anotações (
        name: Pendências de Anotações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idcorrecaonotavenda
                     , t.idnotavenda
                     , t.datacorrecao "Data Correção"
                     , t.usuario "Usuário"
                     , t.motivo  "Motivo"
                     , decode(t.situacao,'P','Pendente','R','Rejeitado','C','Corrigido') "Situação"
                     , pck_romance.fnc_nomerepresentante(t.idrepresentante) "Representante"
                     , ( select n.numeronota 
                         from notasvendas n 
                         where n.idnotavenda = t.idnotavenda ) "Nr Nota"
                     , decode( nvl(t.situacao,'P'),'P','<a href="javascript: fnc_confirma('||t.idcorrecaonotavenda||')" ><img src="/i/menu/pencil16x16.gif"  border="0"></a>'
                                         ,'-') "Confirmar"
                     , decode( nvl(t.situacao,'P'),'P','<a href="javascript: fnc_rejeita('||t.idcorrecaonotavenda||')" ><img src="/i/menu/pencil16x16.gif"  border="0"></a>'
                                         ,'-') "Rejeitar"
                from correcoesnotasvendas t
                where t.idfilial = :P0_IDFILIAL
                  and ( :P201_IDREPRESENTANTE = -1 or t.idrepresentante = :P201_IDREPRESENTANTE )
                  and :P201_FILTRAR = 'S'
                order by 1
                ```
            pageItemsToSubmit: P201_IDREPRESENTANTE
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 37
                items: {
                    P37_IDNOTAVENDA: #IDNOTAVENDA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt="" />
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma correção pendente.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 325578626358546230
        }

        column Confirmar (
            type: plainText
            heading {
                heading: Confirmar
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Confirmar
                endUserAlias: J
            }
            enableUsersTo {
                pivot: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column "Data Correção" (
            type: plainText
            heading {
                heading: Data Correção
                alignment: center
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: Data Correção
                endUserAlias: B
            }
        )

        column IDCORRECAONOTAVENDA (
            type: hidden
            heading {
                heading: Idcorrecaonotavenda
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDCORRECAONOTAVENDA
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDNOTAVENDA (
            type: plainText
            heading {
                heading: Idnotavenda
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDNOTAVENDA
                endUserAlias: H
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Motivo (
            type: plainText
            heading {
                heading: Motivo
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Motivo
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Nr Nota" (
            type: plainText
            heading {
                heading: Nr Nota
                alignment: center
