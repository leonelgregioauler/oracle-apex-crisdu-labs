    region semana-atual-da-favorita (
        name: Semana Atual da Favorita
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(sysdate,'IW/RRRR') ) "Semana"
                     , nvl( round( ( select sum(p.valorcobrado)
                                     from boletos p
                                     where p.idfilial = :P0_IDFILIAL
                                       and p.situacao != 'Z'
                                       and p.semanabaixa =  trim(to_char(sysdate,'IW/RRRR') ) )) ,0)
                     + nvl(( select sum(pp.vlrtotalsemcomissao)
                             from pedidos pp
                             where pp.idfilial = :P0_IDFILIAL
                               and pp.semanaemissao = trim(to_char(sysdate,'IW/RRRR') )
                               and pp.situacao        = 'O'),0)
                     + nvl(( select sum(pf.valorapagar)
                             from favorita.pedidos pf
                             where pf.idfilialromance = :P0_IDFILIAL
                               and pf.idsituacaoentrega = 30000
                               and to_char(pf.dataemissao,'IW/RRRR') = trim(to_char(sysdate,'IW/RRRR') )),0)
                     + nvl( round( ( select sum(pg.valorpago)
                                     from favorita.pagamentospedidos pg
                                     where pg.idsemanapago = pck_util.fnc_idsemana(trim(to_char(sysdate,'IW/RRRR')))
                                       and pg.valorpago    > 0
                                       and exists ( select 1
                                                    from favorita.vencimentospedidos v
                                                    where v.idvencimentopedido = pg.idvencimentopedido
                                                      and v.situacaovencimento = 'V'
                                                      and exists ( select 1
                                                                   from favorita.pedidos pf
                                                                   where pf.idpedido = v.idpedido
                                                                     and pf.idfilialromance = :P0_IDFILIAL ) ) ) ) ,0) "Total Venda Favorita"
                from dual
                ```
        }
        layout {
            sequence: 10
            parentRegion: @venda-favorita
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: dados não encontrados
        }

        column Semana (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column "Total Venda Favorita" (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Total Venda Favorita
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

    )

