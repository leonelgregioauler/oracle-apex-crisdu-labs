page 91 (
    name: Fechamento Semanal
    title: Fechamento Semanal
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @acesso-fechamentos
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region anual-favorita (
        name: Anual Favorita
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(sysdate,'RRRR') ) "Ano"
                     , nvl( round( ( select sum(p.valorcobrado)
                                     from boletos p
                                     where p.idfilial = :P0_IDFILIAL
                                       and p.situacao != 'Z'
                                       and extract ( year from p.databaixa ) = trim(to_char(sysdate,'RRRR')) )) ,0)
                     + nvl(( select sum(pp.vlrtotalsemcomissao)
                             from pedidos pp
                             where pp.idfilial = :P0_IDFILIAL
                               and extract ( year from pp.dtemissao ) = trim(to_char(sysdate,'RRRR'))
                               and pp.situacao        = 'O'),0)
                     + nvl(( select sum(pf.valorapagar)
                             from favorita.pedidos pf
                             where pf.idfilialromance = :P0_IDFILIAL
                               and pf.idsituacaoentrega = 30000
                               and extract ( year from pf.dataemissao ) = trim(to_char(sysdate,'RRRR')) ),0)
                     + nvl( round( ( select sum(pg.valorpago)
                                     from favorita.pagamentospedidos pg
                                     where extract ( year from pg.datapagamento ) = trim(to_char(sysdate,'RRRR') )
                                       and pg.valorpago    > 0
                                       and exists ( select 1
                                                    from favorita.vencimentospedidos v
                                                    where v.idvencimentopedido = pg.idvencimentopedido
                                                      and v.situacaovencimento = 'V'
                                                      and exists ( select 1
                                                                   from favorita.pedidos pf
                                                                   where pf.idpedido = v.idpedido
                                                                     and pf.idfilialromance = :P0_IDFILIAL ) ) ) ) ,0) "Total Venda Favorita"
                from dual
                ```
        }
        layout {
            sequence: 20
            parentRegion: @venda-favorita
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column Ano (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Ano
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column "Total Venda Favorita" (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Total Venda Favorita
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

    )

    region fechamento-semanal (
        name: Fechamento Semanal
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.idfechamento
                     , substr(f.semana,4,4) "Ano"
                     , f.semana
                     , pck_romance.fnc_nomefilial(f.idfilial) Filial
                     , f.saldoanteriorgaveta
                     , f.totalcobranca
                     , f.totalentradasdiversas
                     , f.totalvendasdiretas
                     , f.totalchqsemfundorecebidos
                     , f.totalboletosfavorita
                     , f.totaldespesas
                     , nvl(f.totalcomissoesrepresentantes,0) + nvl( totalcomissaogerente,0)  comissoesromance
                     , nvl( f.totalcomissoesfavoritarepres,0)     + nvl( totalcomissoesfavoritagerente,0) comissoesfavorita
                     , nvl( f.totalcomissoesfavoritarepres,0) comissoesfavoritarepres
                     , nvl( f.totalcomissoesfavoritagerente,0) comissoesfavoritagerente
                     , f.totaldepositosespecie
                     , f.totaldepsitoscheques
                     , f.saldofinalespecie
                     , f.saldofinalcheque
                     , f.subtotalgaveta
                     , f.totalsaidasdiversas
                     , f.totalgaveta
                     , decode(f.concluido,'S','Sim','Não') concluido
                     , decode(nvl(f.totalcobranca,0), 0, 0, ( ( f.totalcomissoesrepresentantes + f.totalcomissaogerente + (f.totaldespesas+totaldespesacusto)) / f.totalcobranca * 100 )) percdespesa
                     , ( select sum(nvl(fr.qtdnotasnovas,0))+sum(nvl(fr.qtdnotasnovasoutrareg,0))
                         from fechamentorepresentantes fr
                         where fr.idfechamento = f.idfechamento ) "Notas novas"
                     , ( select count(1)
                         from fechamentorepresentantes fr
                         where fr.idfechamento = f.idfechamento ) "Nro de Acertos"
                     , f.fatorconversao "Fator Conversor"
                     ,  nvl( f.totalcomissaogerente,0) "Vlr Gerente"
                     , NVL(( select sum(t.valorpago)
                          from pagamentosmanutencoes t
                          where t.idfechamentorepres in ( select ff.idfechamentorepres 
                                                          from fechamentorepresentantes fF
                                                          where ff.idfechamento = f.IDFECHAMENTO ) ),0) "Vlr Manutenções"
                     , f.totaldebitosemaberto 
                     , decode(f.totalcobranca,0,0,(round(( nvl(f.totaldebitosemaberto,1)/nvl(f.totalcobranca,1)*100 ),2))) percdebitosemaberto
                     , f.idsemana
                     , f.totalresgate
                     , nvl( ( select sum(c.valor)
                              from cheques2 c
                              where c.idfilial = f.idfilial
                                and c.idsemanadtinclusao = f.idsemana
                                and c.semfundo = 'S' ),0 ) chequesemfundo
                     , nvl(f.totalcomissaocobrakirepres,0) comissaocobraki
                     , nvl(f.totalcomissaoacordoakirepres,0) comissaoacordoaki
                     , nvl(f.TOTALCOMISSAOBALANCO,0) comissaobalancogestor
                     , ( nvl(totalcobranca,0) + nvl(totaldebitosemaberto,0) ) total_venda
                     , case
                         when f.totaldebitosemaberto > 0 then
                           round( ( f.totaldebitosemaberto / ( nvl(f.totalcobranca,0) + nvl(f.totaldebitosemaberto,0) ) ) * 100,2 )
                         else
                           0
                       end perc_inad
                from fechamentossemanais f
                where f.idfilial = :P0_IDFILIAL  --(:P0_IDFILIAL = -1 or f.idfilial = :P0_IDFILIAL )
                   and ( :P0_IDFECHAMENTO = 999999999999 or f.idfechamento = :P0_IDFECHAMENTO)
                order by 1 desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <font color="blue"><b> Cálculo de % de Despesa: <br> Comissões Distribuidores + Gerente + Total Despesas <br> / Total da Cobrança <br> Multiplicado por 100 para trazer o valor percentual. </b></font>
        }
        link {
            linkColumn: customTarget
            target: {
                page: 92
                items: {
                    P92_IDFECHAMENTO: #IDFECHAMENTO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum fechamento feito.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

