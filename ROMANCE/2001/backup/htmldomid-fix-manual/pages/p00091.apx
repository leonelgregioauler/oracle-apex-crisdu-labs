        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select * 
                from fechamentossemanais f
                where nvl(f.concluido,'N') = 'N'
                AND F.idfilial = :P0_IDFILIAL
                ```
        }
    )

    process atualiza (
        name: atualiza
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  vidsemana number := pck_util.fnc_idsemanadata(sysdate)-52;
                begin
                  --
                  for i in (select idfechamento
                             from fechamentossemanais 
                             where idfilial = :P0_IDFILIAL       
                               and idsemana > vidsemana
                             ORDER BY 1)
                  LOOP
                    --
                    pck_acertosfechamento.prc_atualiza_fechamento(i.idfechamento);
                    --
                  END LOOP;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 302905463574998887
        }
    )

)

