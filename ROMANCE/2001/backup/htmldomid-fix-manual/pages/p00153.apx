    region relatório-para-alvo-2 (
        name: Relatório para Alvo
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_imprime.prc_imprimerelparaalvo(pidfilial => :P0_IDFILIAL,
                                                     psemana => :P153_SEMANACOBRANCA,
                                                     ptipo => :P153_POSTOAVANCADO);
                end;
                
                ```
