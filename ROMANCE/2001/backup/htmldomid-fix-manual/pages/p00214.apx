    pageItem P214_IDPEDIDOCOMPRA (
        type: popupLov
        label {
            label: Pedido de Compra
            alignment: left
        }
        settings {
            displayAs: modalDialog
            initialFetch: autoCurrentValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(pf.apelido, pf.nomepessoa)) 
                     ||', '|| p.nrdocumento
                     ||' - '|| decode(p.situacao, 'I','Incluído'
                                        , 'P','Programado'
                                        , 'Q','Parcial'
                                        , 'R','Recebido'
                                        ,'-') 
                     ||' - '|| p.semana display_value
                     , p.idpedidocompra return_value
                from pedidoscompras  p
                   , fornecedores    f
                   , pessoas         pf
                where p.idfornecedor = f.idfornecedor
                  and f.idpessoa     = pf.idpessoa
                  and f.fornecevarejo = 'S'
                  and p.varejo = 'S'
                  and p.situacao  != 'R'
                  and exists ( select 1 from notasfiscais where idnotafiscal = :P214_IDNOTAFISCAL and idfornemitente = 1195)
                union
                select nrdocumento||' - '||P.Datapedido  display_value
                     , idpedidocompra return_value
                from pedidoscompras P
                where idfornecedor = ( select idfornemitente from notasfiscais where idnotafiscal = :P214_IDNOTAFISCAL and idfornemitente != 1195)
                ```
            nullDisplayValue: - Sem Pedido -
        }
        layout {
            sequence: 270
            region: @compras
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 35
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: IDPEDIDOCOMPRA
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

