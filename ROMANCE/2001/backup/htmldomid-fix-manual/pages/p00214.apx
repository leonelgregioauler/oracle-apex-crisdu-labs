page 214 (
    name: Transferência
    title: Transferência
    appearance {
        pageTemplate: @/marquee
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region compras (
        name: Compras
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent3
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <script language="Javascript">
                function fnc_popup_correcao()
                {vidnotafiscal = document.getElementById("P214_IDNOTAFISCAL").value;
                window.open('f?p=&APP_ID.:233:&SESSION.::NO::P233_IDNOTAFISCAL,P233_IDCORRECAONOTAFISCAL:'+vidnotafiscal+',','CORRECAO', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=500,height=250,left=250,top=100','_blank'); void(0);
                }
                </script>
                ```
        }
    )

    region correções-transferências (
        name: Correções Transferências
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select t.usuario
                , t.datacorrecao
                , t.motivo
                from CORRECOESNOTASFISCAIS t
                where t.idnotafiscal = :P214_IDNOTAFISCAL
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                Select 1
                from correcoesnotasfiscais
                where idnotafiscal = :P214_IDNOTAFISCAL
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }
        componentAdvanced {
            stripHtml: true
        }

