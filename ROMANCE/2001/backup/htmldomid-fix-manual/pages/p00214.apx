    region produtos-da-nf (
        name: Produtos da NF
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '' link
                , codigosisdist||' - '|| initcap(p.nomeproduto) "Produto"
                     , i.iditnf
                     , i.qtd_pp "Qtd PP"
                     , i.qtd_p "Qtd P"
                     , i.qtd_m "Qtd M"
                     , i.qtd_g "Qtd G"
                     , i.qtd_gg "Qtd GG"
                     , i.qtd_egg "Qtd EGG"
                     , i.qtd_exgg "Qtd EXGG"
                     , i.qtd_u "Qtd U"
                     , i.qtd_total "Qtd TOTAL"
                     , i.qtd_pp_chegou "Qtd PP Receb."
                     , i.qtd_p_chegou "Qtd P Receb."
                     , i.qtd_m_chegou "Qtd M Receb."
                     , i.qtd_g_chegou "Qtd G Receb."
                     , i.qtd_gg_chegou "Qtd GG Receb."
                     , i.qtd_egg_chegou "Qtd EGG Receb."
                     , i.qtd_exgg_chegou "Qtd EXGG Receb."
                     , i.qtd_u_chegou "Qtd U Receb."
                     , i.qtd_total_chegou "Qtd Total Receb."
                     , (i.qtd_total_chegou * i.custound) "Total Item Receb."
                     , '|' separador
                     , i.observacao
                     , i.qtd_total - i.qtd_total_chegou "Diferença"
                from itemnf i
                   , produtos p
                where i.idproduto = P.idproduto
                  and i.idnotafiscal = :P214_IDNOTAFISCAL
                order by pck_romance.fnc_nomeproduto(i.idproduto)
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from itemnf i
                where i.idnotafiscal = :P214_IDNOTAFISCAL
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
