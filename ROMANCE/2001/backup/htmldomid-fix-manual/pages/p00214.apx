            type: rowsReturned
            sqlQuery:
                ```sql
                -- Libera time T.I Labs
                select 1
                  from roman.usuariosgruposatendimento g
                 where g.usuario = v('APP_USER')
                   and g.idgrupoatendimento = 0
                
                union
                
                -- Verifica controle de acesso para liberar a visualização do botão.
                select 1
                  from dual
                 where roman.pck_util.fnc_verificaacesso(pidaplicacao => 2434,pusuario => v('APP_USER')) = 'S';
                ```
        }
    )

