    pageItem P214_IDFILIALDESTINO (
        type: selectList
        label {
            label: Filial Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(idfilial) display_value
                     , f.idfilial return_value 
                from filiais f
                where f.idfilial   != :P0_IDFILIAL
                  and f.tipofilial  = 'D'
                  and f.ativo       = 'S'
                union all
                -- solicitação de Débora, André e Fernando (reunião por Zoom - dia 13/01/2026)
                select pck_romance.fnc_nomefilial(idfilial) display_value
                     , f.idfilial return_value 
                from filiais f
                where f.idfilial = 1150
                union all
                /*select pck_romance.fnc_nomefilial(idfilial) display_value
                     , f.idfilial return_value 
                from filiais f
                where f.idfilial = 1067*/ --Solicitação feita pelo financeiro Ticket: 11905813 e 10117204
                --union all
                select pck_romance.fnc_nomefilial(idfilial) display_value
                     , f.idfilial return_value 
                from filiais f
                where f.idfilial in (1217,/*1088*/1145,1117,1251, 1175)  --comentada a 1088 a pedido do financeiro Ticket: 11905813 e 10117204
                --- Evento 11936924
                --- Loja Romance Brasilia (Taguatinga) / Transportadora Crisdu / Loja Romance Mossoro / Loja Romance Natal / Loja Romance Natal Zona Norte
                --- Loja Romance Joao Pessoa (1175) adicionado no ticket 16031868 (Fernando Palma)
                order by 1
                ```
            nullDisplayValue: " "
        }
        layout {
            sequence: 100
            region: @compras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALDESTINO
            used: always
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P214_IDNOTAFISCAL is not null
                  and not exists ( select 1
                                   from usuariosgruposatendimento ug
                                   where ug.idgrupoatendimento in (0,1)
                                     and ug.usuario = v('APP_USER') )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

