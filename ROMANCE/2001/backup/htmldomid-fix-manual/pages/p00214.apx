    process liberareceb (
        name: LiberaReceb
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P214_OBSERVLIBERARECEB is not null then
                    --
                    update notasfiscais
                       set liberarecebimento    = 'S',
                           dataliberareceb      = sysdate,
                           idusuarioliberareceb = :P0_IDUSUARIO,
                           observliberareceb    = :P214_OBSERVLIBERARECEB
                     where idnotafiscal = :P214_IDNOTAFISCAL;
                    --
                  else
                    --
                    update notasfiscais
                       set liberarecebimento    = NULL,
                           dataliberareceb      = NULL,
                           idusuarioliberareceb = NULL,
                           observliberareceb    = NULL
                     where idnotafiscal = :P214_IDNOTAFISCAL;
                    --
                  end if;
                end;
                ```
        }
        execution {
            sequence: 100
        }
        advanced {
            executionMappingIdentifier: 1073860257530947728
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

