    process cria-notavenda (
        name: cria notavenda
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 31/07/2013 by SONY 
                declare 
                  -- Local variables here
                  i integer;
                begin
                  -- Test statements here
                  declare 
                  -- 
                  i integer;
                  vnotacompra number := :P214_IDNOTAFISCAL;
                  vnotavenda  number;
                begin
                  --
                  select Seq_Idnotafiscal.Nextval 
                  into vnotavenda
                  from dual;
                  --
                  :P214_NOTAVENDA := vnotavenda;
                  --
                  insert into notasfiscais ( idnotafiscal     , idfornemitente   , tipoemitente
                                         , idtransportadora , dtnf               , usuario
                                         , situacao         , documento          , tiponota
                                         , datainclusao     , idnotafiscalcompra )
                  select vnotavenda        , 2111         , 'FOR'
                       , idtransportadora  , dtnf         , usuario
                       , situacao          , documento    , 'V'
                       , datainclusao      , vnotacompra
                  from notasfiscais
                  where idnotafiscal = vnotacompra;
                  --
                  insert into itemnf
                  select seq_idtemnf.nextval
                       , vnotavenda
                       , idproduto
                       , qtd_p
                       , ( select f.precocusto
                           from fornecedoresprodutos f
                           where f.idfornecedor = 2111
                             and f.idproduto = i.idproduto ) custound
                       , valortotal
                       , qtd_gg
                       , qtd_g
                       , qtd_m
                       , qtd_total
                       , qtd_u
                       , observacao
                       , idprodutodetalhado
                       , qtd_pp
                       , qtd_egg
                       , qtd_pp_chegou
                       , qtd_p_chegou
                       , qtd_m_chegou
                       , qtd_g_chegou
                       , qtd_gg_chegou
                       , qtd_egg_chegou
                       , qtd_u_chegou
                       , qtd_total_chegou
                       , observacaofilial
                       , idprodutorecebido
                       , qtd_exgg 
                       , qtd_exgg_chegou 
                  from itemnf i
                  where i.idnotafiscal = vnotacompra;
                  --
                end;
                end;
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Nota de venda criada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 422541267865496372
        }
        serverSideCondition {
            type: never
        }
    )

