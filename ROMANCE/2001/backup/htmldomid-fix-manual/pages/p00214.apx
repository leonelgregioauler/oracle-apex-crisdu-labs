    pageItem P214_IDFORNEMITENTE (
        type: selectList
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa||' ('||c.nomecidade)||'-'||e.sigla||')' display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                   , cidades c
                   , estados e
                where f.idpessoa = p.idpessoa
                  and p.idcidade = c.idcidade
                  and c.idestado = e.idestado
                  and :p214_idfilialemitente is null 
                  and :p214_idfornemitente is null
                  and exists ( select 1 from fornecedoresprodutos p
                               where p.idfornecedor = f.idfornecedor)
                UNION
                select initcap(p.nomepessoa||' ('||c.nomecidade)||'-'||e.sigla||')' display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                   , cidades c
                   , estados e
                where f.idpessoa = p.idpessoa
                  and p.idcidade = c.idcidade
                  and c.idestado = e.idestado
                  and exists ( select 1 from fornecedoresprodutos p
                               where p.idfornecedor = f.idfornecedor)
                  and (:P214_IDFORNEMITENTE is not null and f.idfornecedor = :P214_IDFORNEMITENTE)
                ```
            nullDisplayValue: " - Selecione o Fornecedor -"
        }
        layout {
            sequence: 90
            region: @compras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFORNEMITENTE
            used: always
        }
        readOnly {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                 /*where :P214_IDNOTAFISCAL is not null
                 and not exists ( select 1
                                   from usuariosgruposatendimento ug
                                   where ug.idgrupoatendimento in (0,1)
                                     and ug.usuario = v('APP_USER') )*/
                ```
        }
        security {
            encryptSessionState: false
        }
    )

