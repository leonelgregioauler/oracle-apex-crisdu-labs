    pageItem P214_MENSAGEM (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
            sendOnPageSubmit: false
        }
        layout {
            sequence: 320
            region: @compras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 
                case
                  when sum(n.valorliquido) - nvl( (select sum(v.valor)  
                                                from vencimentos  v 
                                                where v.idnotafiscal  = n.idnotafiscal ),0) > 0 then
                     chr(60)||'b'||chr(62)||chr(60)||'font color=red> Divergência no Total da NF: </b>'||to_char(sum(n.valorliquido),'FML999G999G990D00') ||' <b>com Total de vencimentos: </b>'||to_char(nvl( (select sum(v.valor)  
                                                from vencimentos  v 
                                                where v.idnotafiscal  = n.idnotafiscal ),0),'FML999G999G990D00')||'</font>'
                  when sum(n.valorliquido) - nvl(( select sum(v.valor)  
                                                 from vencimentos  v 
                                                 where v.idnotafiscal  = n.idnotafiscal),0) < 0 then
                    chr(60)||'b'||chr(62)||chr(60)||'font color=red> Divergência no Total da NF: </b>'||to_char(sum(n.valorliquido),'FML999G999G990D00') ||' <b>com Total de vencimentos: </b>'||to_char(nvl( (select sum(v.valor)  
                                                from vencimentos  v 
                                                where v.idnotafiscal  = n.idnotafiscal ),0),'FML999G999G990D00')||'</font>'
                end
                from notasfiscais n
                where n.idnotafiscal = :P214_IDNOTAFISCAL
                group by n.idnotafiscal
                ```
            used: always
        }
        serverSideCondition {
            type: item=value
            item: P214_TIPONOTA
            value: C
        }
        security {
            encryptSessionState: false
        }
    )

