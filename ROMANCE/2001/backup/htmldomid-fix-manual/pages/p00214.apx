    process salvar-liberacao-recebimento (
        name: SALVAR_LIBERACAO_RECEBIMENTO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    if :P214_OBSERVLIBERARECEB is not null then
                        update roman.notasfiscais n
                           set n.liberarecebimento    = 'S'
                             , n.idusuarioliberareceb = :P0_IDUSUARIO
                             , n.dataliberareceb      = sysdate
                             , n.observliberareceb    = :P214_OBSERVLIBERARECEB
                         where n.idnotafiscal = :P214_IDNOTAFISCAL;
                    else
                        update roman.notasfiscais n
                           set n.liberarecebimento    = 'N'
                             , n.idusuarioliberareceb = null
                             , n.dataliberareceb      = null
                             , n.observliberareceb    = null
                         where n.idnotafiscal = :P214_IDNOTAFISCAL;
                    end if;
                
                    commit;
                end;
                ```
        }
        execution {
            sequence: 110
        }
        successMessage {
            successMessage: Liberação de recebimento da nota realizada com sucesso
        }
        advanced {
            executionMappingIdentifier: 1793549708123217925
        }
        serverSideCondition {
            whenButtonPressed: @salvar-liberacao-recebimento
        }
    )

