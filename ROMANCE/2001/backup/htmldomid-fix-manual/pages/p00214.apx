    region qtd-recebida (
        name: Qtd Recebida
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto) "Produto"
                     , trim(to_char(i.custound, '999G990D00')) custo
                     , i.qtd_pp_chegou "Qtd PP"
                     , i.qtd_p_chegou "Qtd P"
                     , i.qtd_m_chegou "Qtd M"
                     , i.qtd_g_chegou "Qtd G"
                     , i.qtd_gg_chegou "Qtd GG"
                     , i.qtd_egg_chegou "Qtd EGG"
                     , i.qtd_exgg_chegou "Qtd EXGG"
                     , i.qtd_u_chegou "Qtd U"
                     , i.qtd_total_chegou "Qtd Total"
                     , (i.qtd_total_chegou * i.custound) "Total Item"
                     , i.observacao
                from itemnf i
                   , produtos p
                where i.idproduto = P.idproduto
                  and i.idnotafiscal = :P214_IDNOTAFISCAL
                order by pck_romance.fnc_nomeproduto(i.idproduto)
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: dados não encontrados
        }
        componentAdvanced {
            stripHtml: true
        }

        column CUSTO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 13
            derivedColumn: N
            type: hidden
            layout {
                sequence: 13
            }
        )

        column Produto (
            reportColumnQueryId: 1
