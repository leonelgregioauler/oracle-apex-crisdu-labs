    region relatório-para-alvo (
        name: Relatório para Alvo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pck_romance.fnc_nomerepresentante(pidrepresentante => rr.idrepresentante) "Representante"
                     , rr.idrepresentante
                     , r.semana "Semana Cobrança"
                     , ( select rv.descricao 
                         from regioesvenda rv 
                         where rv.idregiaovenda = r.idregiaovenda ) "Região de Venda"
                     , ( select  count(1)/*||'/'||count( distinct nv2.idvendedora)*/
                         from notasvendas nv2
                         where nv2.semanacobranca       = r.semana
                           and nv2.idrepresentante      = rr.idrepresentante
                           and nv2.idregiaovenda        = r.idregiaovenda
                           and nv2.idsituacaonotavenda != 5
                           and nv2.idsituacaonotavenda > 1 ) "Notas da Região"
                     , ( select  count(1)/*||'/'||count( distinct nv2.idvendedora)*/
                         from notasvendas nv2
                         where nv2.semanacobranca       = r.semana
                           and nv2.idrepresentante      = rr.idrepresentante
                           and nv2.idregiaovenda       != r.idregiaovenda
                           and nv2.idsituacaonotavenda != 5
                           and nv2.idsituacaonotavenda > 1 ) "Notas em Aberto"
                     ,  pck_acertosfechamento.fnc_retornaalvo_daniel(pidrepresentante => rr.idrepresentante,
                                                                   pidsemana => pck_util.fnc_idsemana( r.semana) ,
                                                                   pidregiaovenda => r.idregiaovenda)
                      /*(( select sum(n.valortotalnota)
                           from notasvendas n
                           where n.idrepresentante        = rr.idrepresentante 
                             and n.idsituacaonotavenda   != 5
                             and trim(n.semanacobranca)   = r.semana
                             and n.idregiaovenda          = r.idregiaovenda 
                             and n.idsituacaonotavenda    > 1 )
                                     - ( ( select sum(n.valortotalnota)
                                           from notasvendas n
                                           where n.idrepresentante      = rr.idrepresentante 
                                             and n.idsituacaonotavenda != 5
                                             and trim(n.semanacobranca) = r.semana 
                                             and n.idregiaovenda        = r.idregiaovenda
                                             and n.idsituacaonotavenda > 1  )
                                        * 0.325))
                                        / 2*/  "Alvo da Região"
                     /*, nvl((( select sum(n.valortotalnota)
                           from notasvendas n
                           where n.idrepresentante        = rr.idrepresentante 
                             and n.idsituacaonotavenda   != 5
                             and trim(n.semanacobranca)   = r.semana
                             and n.idregiaovenda         != r.idregiaovenda
                             and n.idsituacaonotavenda    > 1 ) * 0.325) ,0)*/
                     ,  pck_acertosfechamento.fnc_retornaalvo_emaberdaniel(pidrepresentante => rr.idrepresentante,
                                                                   pidsemana => pck_util.fnc_idsemana( r.semana) ,
                                                                   pidregiaovenda => r.idregiaovenda) "Alvo em Aberto"
                     , rr.idrepresentante "Cod Representante"
                from representantes rr
                   , regioesrepresentantes r
                where pck_romance.fnc_filialrepresentante(r.idrepresentante) = :P0_IDFILIAL
                  and rr.idrepresentante  = r.idrepresentante
                  and r.semana            = trim(:P246_SEMANACOBRANCA) 
                  and rr.ativo            = 'S'
                order by 1  
                ```
        }
