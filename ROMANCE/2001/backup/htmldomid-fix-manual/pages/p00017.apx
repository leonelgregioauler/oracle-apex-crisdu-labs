            customAttributes: style="text-align: right;"
        }
        source {
            used: always
        }
        serverSideCondition {
            type: itemIsNull
            item: P17_IDTRANSFPRODREPRES
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P17_DATAMOVTO (
        type: datePickerJquery
