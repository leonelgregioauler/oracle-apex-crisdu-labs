    button delete (
        buttonName: DELETE
        label: Cancelar Transferência
        layout {
            sequence: 20
            region: @efetuar-transferência
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
                t-Button--iconRight
            ]
