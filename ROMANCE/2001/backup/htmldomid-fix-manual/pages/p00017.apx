            type: expression
            plsqlExpression: sysdate
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P17_DISPLAYPRODUTO (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pr.codigosisdist ||' - '||initcap( pr.nomeproduto ) || decode(c.descricao, null, '', ' ('||c.descricao||')' ) display_value
                     , e.idestoquefilial   return_value
                from estoquefilial         e
                   , produtos              pr
                   , cores                 c
                where e.idproduto        = pr.idproduto
                  and e.idcor            = c.idcor (+)
                  and e.idestoquefilial = ( select idestoquefilial filial from transfprodrepres where idtransfprodrepres = :P17_IDTRANSFPRODREPRES)
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 55
            region: @efetuar-transferência
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P17_IDTRANSFPRODREPRES
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P17_IDESTOQUEFILIAL (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap( pr.nomeproduto ) display_value
                     , e.idestoquefilial   return_value
                from estoquefilial         e
                   , produtos              pr
                where e.idproduto        = pr.idproduto
                  and e.idfilial         = :P0_IDFILIAL
                  and pr.codigosisdist   = :P17_CODIGOSISDIST
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P17_CODIGOSISDIST
        }
        layout {
            sequence: 50
            region: @efetuar-transferência
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDESTOQUEFILIAL
            used: always
        }
        serverSideCondition {
            type: itemIsNull
            item: P17_IDTRANSFPRODREPRES
        }
        security {
            encryptSessionState: false
        }
    )

