page 17 (
    name: Efetuar Transferência
    title: Efetuar Transferência
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function confirmaitem(event)
            { var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            if (tecla==13) 
            { var answer = confirm("Confirma tranferência?")
              if (answer)
              {apex.submit('CREATE');}}}
            
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region efetuar-transferência (
        name: Efetuar Transferência
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region relatório-de-transferências (
        name: Relatório de Transferências
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => t.idrepresentanteorig) "Repres. Origem"
                     , pck_romance.fnc_nomerepresentante(pidrepresentante => t.idrepresentantedest) "Repres. Destino"
                     , t.datamovto "Data Movimento"
                     , t.quantidade
                     , pck_romance.fnc_nomeproduto(pidproduto => e.idproduto) "Produto"
                from transfprodrepres t
                   , estoquefilial    e
                where trunc(t.datamovto) = trunc(sysdate)
                  and t.idestoquefilial = e.idestoquefilial
                order by t.datamovto
                ```
        }
        layout {
            sequence: 20
            parentRegion: @efetuar-transferência
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhuma transferência feita hoje!
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column "Data Movimento" (
            type: plainText
            heading {
                heading: Data Movimento
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: Data Movimento
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Produto (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Produto
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: QUANTIDADE
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Repres. Destino" (
            type: plainText
            heading {
                heading: Distribuidor Destino
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Repres. Destino
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Repres. Origem" (
            type: plainText
            heading {
                heading: Distribuidor Origem
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Repres. Origem
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 2994984 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn "Data Movimento" (
                sequence: 3
            )

            displayColumn "Produto" (
                sequence: 4
            )

            displayColumn QUANTIDADE (
                sequence: 5
            )

            displayColumn "Repres. Destino" (
                sequence: 2
            )

            displayColumn "Repres. Origem" (
                sequence: 1
            )

            sort (
                column: "Data Movimento"
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    pageItem P17_CODIGOSISDIST (
        type: textField
        label {
            label: Produto
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 45
            region: @efetuar-transferência
            slot: regionBody
            alignment: left
