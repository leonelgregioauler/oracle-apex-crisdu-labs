        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente cancelar esta transferência?','DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P17_IDTRANSFPRODREPRES
        }
    )

