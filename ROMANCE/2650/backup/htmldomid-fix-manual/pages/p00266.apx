page 266 (
    name: Valores Recebidos
    title: Valores Recebidos
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region valores-recebidos (
        name: Valores Recebidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.semanad semana
                     , w.idfechamento
                     --, decode( w.identrada, null, '', '<a href="f?p=&APP_ID.:64:&SESSION.::&DEBUG.::P64_IDENTRADA:'||w.identrada||'"><img src="#IMAGE_PREFIX#menu/pencil2_16x16.gif" alt=""></a>') identrada
                     , idfilial
                     , semana "Semana"
                     , ano "Ano"
                     , anopgto "Ano Pgto"
                     , Filial
                     , Filialorig--"Filial Origem"
                     , Filialdestino
                     , mes "Mês"
                     , fechamentoorig
                     , conta
                     , subconta
                     , valortotal
                     , descricao
                     , Tipo
                     , descricaoorigem "Descrição da Origem"
                     , data "Data"
                     , nota "Nota"
                     , w.tipoentrada "Tipo Entrada"
                     , w.idfilialorig 
                from vw_entradasdiversas w
                where w.idfechamento = :P266_IDFECHAMENTO
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
