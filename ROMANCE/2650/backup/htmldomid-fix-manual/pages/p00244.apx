    pageItem P244_MEDIAGERAL_DESPESA1 (
        type: displayOnly
        label {
            label: " "
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 
                                 '% Despesa: '||      TRIM(to_char( totaldespesas      * 100 /  totalcobranca , '999G990D00' ) ) 
                          || '<br> % Despesa Setores: '|| TRIM(to_char( ( select sum(totaldespesas) 
                                                                          from fechamentossemanais f
                                                                          where f.idsemana = :P244_SEMANAINI
                                                                            and pck_romance.fnc_tipofilial(f.idfilial) != 'D' ) * 100 / totalcobranca , '999G990D00' ) )     
                      --    ||' <br><br> % Debitos em Aberto: '|| TRIM(to_char( round( ( totaldebitosemaberto / ( nvl(totalcobranca,0) + nvl(totaldebitosemaberto,0) ) ) * 100,2 )  , '999G990D00' ) ) 
                        --                                        ||' ( Deb. Em aberto: '||TRIM(to_char( totaldebitosemaberto, '999G999G999G999G990D00' ))||'/ Cobrança: '||TRIM(to_char( totalcobranca, '999G999G999G999G990D00' ))||')'
                
                
                          ||' <br><br>% Compra sobre Cobrança: '||     TRIM(to_char(   ( totalmercadorias * 100 / totalcobranca ) , '999G990D00' ) )  
                                                                ||' ( Compra: '||TRIM(to_char( totalmercadorias, '999G999G999G999G990D00' ))||'/ Cobrança: '||TRIM(to_char( totalcobranca, '999G999G999G999G990D00' ))||')'
                                                                          
                          ||' <br><br>% Venda RMC: '||     
                                                        TRIM(to_char(    ( select decode(nvl(sum(fr.vlralvo),0), 0, 0, ((sum(fr.totalgeral)/(sum(fr.vlralvo)*2))*100) )
                                                                            from fechamentorepresentantes fr
                                                                               , fechamentossemanais ff
                                                                            where fr.idfechamento = ff.idfechamento
                                                                              and ff.idsemana  = :P244_SEMANAINI) , '999G990D00' ) )           
                          
                          
                          ||' <br><br>% Favorita: '||     TRIM(to_char( totalvendafavorita * 100 /  totalcobranca , '999G990D00' ) )  
                          ||' <br><br>Ticket Médio Distribuidores: '|| trim(to_char( decode( NrodeAcertosreal , 0  , 0
                                                                                                               , totalcobranca / NrodeAcertosreal )  ,'999G990D00') ) 
                          ||' <br> Ticket Médio Consultora: '|| TRIM(to_char( totalcobrancaconsult / qtdnotasacertadas  , '999G990D00' ) )      
                              perc   
                
                from (
                        select sum(totalvendasdiretas + totalcobranca) totalcobranca  
                             , sum(totalcobranca) totalcobrancaconsult
                             , sum( (totalvendasdiretas + totalcobranca) * f.fatorconversao ) totalcobrancaconvertido
                             ,  ( sum(totaldespesas)  + sum(F.totalcomissoes) ) totaldespesas   
                             , sum(totalvendafavorita) totalvendafavorita
                             , sum(NrodeAcertosreal)  NrodeAcertosreal
                             , sum ( ( select count(1)
                                        from notasvendas nv
                                        where nv.idfilial             = f.idfilial
                                          and nv.idsemanacobranca     = f.idsemana
                                          and nv.idsituacaonotavenda  = 4 ) ) qtdnotasacertadas
                            , sum(f.totalmercadorias    ) totalmercadorias
                            , sum(totaldebitosemaberto) totaldebitosemaberto     
                        from vw_fechamentosdistribuidoras f
                        where f.idsemana = :P244_SEMANAINI
                          and ( :P244_GRUPO = 0 --todos
                            or ( :P244_GRUPO = 1 and idfilial in (401, 100, 140, 1071, 230, 123, 121, 222, 120, 221) ) --'Top BR'
                            or ( :P244_GRUPO = 2 and idfilial in (122, 124, 290, 320, 1070, 1072, 1082, 1083, 1084, 1089, 1090, 1106, 1122) ) --'Demais BR'
                            or ( :P244_GRUPO = 3 and idfilial in (1041,1081,1085,1095,1108,1109,1111,1121,1129) )  ) -- 'Exterior'
                    )
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P244_MEDIAGERAL_DESPESA2 (
        type: displayOnly
        label {
            label: " "
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @new-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '% Despesa: '||TRIM(to_char( ( sum(totaldespesas) 
                                + sum(F.totalcomissoes) ) * 100 /  sum(totalcobranca),'999G990D00')) 
                     ||'<br> % Favorita: '||TRIM(to_char( ( sum( totalvendafavorita ) * 100 /  sum(totalcobranca)) ,'999G990D00')) perc
                from vw_fechamentosdistribuidoras f
                where F.idsemana between to_number(:P244_SEMANAINI) and to_number(:P244_SEMANAFIM)
                  and ( :P244_GRUPO = 0 --todos
                    or ( :P244_GRUPO = 1 and idfilial in (401, 100, 140, 1071, 230, 123, 121, 222, 120, 221) ) --'Top BR'
                    or ( :P244_GRUPO = 2 and idfilial in (122, 124, 290, 320, 1070, 1072, 1082, 1083, 1084, 1089, 1090, 1106, 1122) ) --'Demais BR'
                    or ( :P244_GRUPO = 3 and idfilial in (1041,1081,1085,1095,1108,1109,1111,1121,1129) )  ) -- 'Exterior'
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P244_SEMANAFIM (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00')||'/'||ano) display_value
                     , idsemana return_value
                from semana_dias
                where (ano = to_number(to_char(sysdate,'RRRR'))
                  and semana <= to_number(to_char(sysdate,'IW')))
                  or ano between to_number(to_char(sysdate,'RRRR'))-1 and to_number(to_char(sysdate,'RRRR'))
                order by idsemana desc
                ```
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

