    region fechamento-distriubidoras (
        name: Fechamento Distriubidoras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfechamento
                     , f.COBRANCA
                     , anocobranca "Ano"
                     , semanacobranca semana
                     , pck_romance.fnc_nomefilial(f.idfilial) Filial
                     , saldoanteriorgaveta
                     , ( totalcobranca + nvl(totalvendasdiretas,0) ) totalcobranca
                   --  , f.totalentradasdiversas
                     --, totalvendasdiretas
                     , totalchqsemfundorecebidos
                     , totalboletosfavorita
                     , totaldespesas
                     , F.totalcomissoes comissoes
                     , totaldepositosespecie
                     , totaldepsitoscheques
                     , saldofinalespecie
                     , saldofinalcheque
                     , subtotalgaveta
                     , totalsaidasdiversas
                     , totalgaveta
                     , decode(concluido,'S','Sim','Não') concluido
                     , percdespesa
                     , notasnovas "Notas novas"
                     , NrodeAcertosreal "Nro de Acertos"
                     , totalvendafavorita  "Total Venda Favorita"
                     , percvendafavorita "% Venda Favorita"
                     , f.fatorconversao
                     , decode(f.NrodeAcertosreal, 0,0, f.totalcobranca/NrodeAcertosreal) ticketmedio
                     , mediavendedoras
                     , qtdnotasacertadas
                     , saldoacumulado
                     , ( select decode(nvl(sum(fr.vlralvo),0), 0, 0, ((sum(fr.totalgeral)/(sum(fr.vlralvo)*2))*100) ) "Perc Venda"
                                            from fechamentorepresentantes fr
                                            where fr.idfechamento = f.idfechamento ) percvenda
                from vw_fechamentosdistribuidoras f
                where f.idsemana = :P244_SEMANAINI 
                  and f.idsemana > 719
                  and ( :P244_GRUPO = 0 --todos
                    or ( :P244_GRUPO = 1 and idfilial in (401, 100, 140, 1071, 230, 123, 121, 222, 120, 221) ) --'Top BR'
                    or ( :P244_GRUPO = 2 and idfilial in (122, 124, 290, 320, 1070, 1072, 1082, 1083, 1084, 1089, 1090, 1106, 1122) ) --'Demais BR'
                    or ( :P244_GRUPO = 3 and idfilial in (1041,1081,1085,1095,1108,1109,1111,1121,1129) )  ) -- 'Exterior'
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: 1
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
