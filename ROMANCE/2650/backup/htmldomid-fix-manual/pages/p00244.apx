    region fechamento-setores (
        name: Fechamento Setores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfechamento
                     , semana
                     , pck_romance.fnc_nomefilial(f.idfilial) Filial
                     , saldoanteriorgaveta
                     , totalcobranca
                     , f.totalentradasdiversas
                     , totalvendasdiretas
                     , totalchqsemfundorecebidos
                     , totalboletosfavorita
                     , totaldespesas * nvl(fatorconversao,1) totaldespesas
                     , totalcomissoesrepresentantes
                     , totalcomissaogerente
                     , totaldepositosespecie
                     , totaldepsitoscheques
                     , totalcomissoesfavoritarepres
                     , totalcomissoesfavoritagerente
                     , saldofinalespecie
                     , saldofinalcheque
                     , subtotalgaveta
                     , totalsaidasdiversas* nvl(fatorconversao,1) totalsaidasdiversas
                     , totalgaveta
                     , decode(concluido,'S','Sim','Não') concluido
                     , to_number(substr(f.semana,4,4)) "Ano"
                     , f.observacao
                from fechamentossemanais f
                where f.idsemana = :P244_SEMANAINI 
                  and pck_romance.fnc_tipofilial(f.idfilial) != 'D'
                ```
        }
        layout {
            sequence: 20
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: 2
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum fechamento feito.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 22915900236432913
        }

