    region agrupado-distribuidoras (
        name: Agrupado Distribuidoras
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(f.idfilial) Filial
                     , count(f.idfechamento) qtdsemanas
                     , sum(totalcobranca) totalcobranca
                     , decode( count(f.idfechamento),0,0,sum(totalcobranca) / count(f.idfechamento) ) mediacobrancafil
                     , sum(nrodeacertos) "Nro de Acertos"
                     , decode( sum(f.NrodeAcertos),0,0,sum(totalcobranca) / sum(f.NrodeAcertos) )mediacobrancarepres 
                     , sum(totaldespesas) totaldespesas
                     , decode(count(f.idfechamento),0,0,sum(totaldespesas) / count(f.idfechamento)) mediadespesas
                     , sum(totalcomissoes) comissoes
                     , decode(sum(totalcobranca) ,0,0,(sum(totaldespesas)+sum(f.comisromanrepres)+sum(f.comissromanger) ) *100 /sum(totalcobranca) ) percdespesa
                     , sum(notasnovas) "Notas novas"
                     , sum(totalvendafavorita)  "Total Venda Favorita"
                     , decode(sum(totalcobranca),0,0,sum(totalvendafavorita)*100/sum(totalcobranca)) "% Venda Favorita"
                     , sum(resultadodasemana) "Resultado da Semana"
                     , '|' separar
                     , sum(f.comissfavrepres) "Comissão Fav. Repres"
                     , sum(f.comissfavgerente) "Comissão Fav. Gerentes"
                     , sum(f.comisromanrepres) "Comissão Rom. Repres"
                     , sum(f.comissromanger) "Comissão Rom. Gerente"
                     , sum(qtdnotasacertadas) "Qtd Notas Acertadas"
                     , decode(sum(qtdnotasacertadas),0,0, sum(totalcobranca) /sum(qtdnotasacertadas) ) "Med. Consultora"
                from vw_fechamentosdistribuidoras f
                where F.idsemana between to_number(:P244_SEMANAINI) and to_number(:P244_SEMANAFIM)
                  and f.idsemana >719
                  and ( :P244_GRUPO = 0 --todos
                    or ( :P244_GRUPO = 1 and idfilial in (401, 100, 140, 1071, 230, 123, 121, 222, 120, 221) ) --'Top BR'
                    or ( :P244_GRUPO = 2 and idfilial in (122, 124, 290, 320, 1070, 1072, 1082, 1083, 1084, 1089, 1090, 1106, 1122) ) --'Demais BR'
                    or ( :P244_GRUPO = 3 and idfilial in (1041,1081,1085,1095,1108,1109,1111,1121,1129) )  ) -- 'Exterior'
                group by f.idfilial
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: 3
        }
        serverSideCondition {
            type: item=value
            item: P244_TIPO
            value: 2
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: -
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
            csvSeparator: ;
            linkText: Baixar para Excel
            filename: cobrançasagrupadas
        }

