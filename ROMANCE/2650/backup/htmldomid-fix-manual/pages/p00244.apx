    region agrupado-setores (
        name: Agrupado Setores
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(fv.idfilial) Filial
                     , sum(totalvendasdiretas)  totalvendasdiretas
                     , sum(totaldespesas)       totaldespesas
                     , sum(totalsaidasdiversas) totalsaidasdiversas
                from fechamentossemanais fv
                where Fv.idsemana between to_number(:P244_SEMANAINI) and to_number(:P244_SEMANAFIM)
                  and pck_romance.fnc_tipofilial(fv.idfilial) != 'D'
                group by fv.idfilial
                order by 1
                ```
        }
        layout {
            sequence: 40
            slot: body-3
