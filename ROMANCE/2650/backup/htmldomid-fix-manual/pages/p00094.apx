        column IDREPRESENTANTE (
            reportColumnQueryId: 4
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Representante
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nvl(p.apelido,p.nomepessoa)||' ('|| nvl(pf.apelido,pf.nomepessoa) ||')') display_value
                         , r.idrepresentante return_value 
                      from representantes r
                         , gerentes       g
                         , pessoas        p
                         , filiais        ff
                         , pessoas        pf
                      where r.idpessoa = p.idpessoa
                        and r.idgerente = g.idgerente
                        and g.idfilial = ff.idfilial
                        and ff.idpessoa = pf.idpessoa
                    ```
            }
            layout {
                sequence: 4
            }
        )

