    region pagamentos (
        name: Pagamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pagforn.dtvencimento
                     , pagforn.idpgtoforn
                     , to_char(sd.dt_ini,'YYYY') ano
                     , to_char(sd.semana,'00') 
                            ||' ('  || to_char(sd.dt_ini,'DD/MM/YYYY')
                            ||' a ' || to_char(sd.dt_fim,'DD/MM/YYYY') ||')' Semana
                     , initcap(pes.apelido) Fornecedor
                     , forn.IDFORNECEDOR
                     , pagforn.idcheque
                     , decode(pagforn.tipo, 'DD','Depósito'
                                          , 'CR','Cheque Resgate'
                                          , 'CD','Cheque Cobrir') Tipo
                     , chq.agencia  "Agência (Cheque)"
                     , chq.conta    "Conta (Cheque"
                     , chq.nrcheque "Nr Cheque"
                     , chq.datainclusao "Data inclusão"
                     , sum(pagforn.valorpagar) ValorPagar
                     , sum(pagforn.valorpago) ValorPago
                     , sum(pagforn.valorpago) - sum(pagforn.valorpagar) Saldo
                     , ( select cb.beneficiario||' - '||b.nomebanco
                              ||' - '|| cb.agencia ||' - '||
                              cb.conta
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco         = b.idbanco 
                           and cb.idcontabanc = pagforn.idcontabanc)  conta
                from semana_dias   sd
                   , pagamentosfornecedores pagforn
                   , pessoas         pes
                   , fornecedores      forn
                   , cheques2          chq
                   , bancos            b
                   , contasbancarias   cb
                where sd.semana           = to_number(to_char(pagforn.dtvencimento,'IW'))
                  and sd.ano              = to_number(to_char(pagforn.dtvencimento,'YYYY'))
                  and forn.idpessoa       = pes.idpessoa
                  and chq.idfornecedor    = forn.idfornecedor  
                  and pagforn.idcontabanc = cb.idcontabanc
                  and cb.idbanco          = b.idbanco
                  and pagforn.idcheque    = chq.idcheque
                  and pagforn.idpgtoforn  = :P94_IDPGTOFORN
                group by to_char(sd.dt_ini,'YYYY')
                       , sd.semana
                       , sd.dt_ini
                       , sd.dt_fim
                       , pagforn.dtvencimento
                       , pagforn.idpgtoforn
                       , to_char(pagforn.dtvencimento,'IW') 
                       , pes.apelido 
                       , forn.IDFORNECEDOR
                       , pagforn.idcheque
                       , pagforn.idcontabanc
                       , chq.agencia
                       , chq.conta
                       , chq.nrcheque
                       , chq.datainclusao
                       , decode(pagforn.tipo, 'DD','Depósito'
                                          , 'CR','Cheque Resgate'
                                          , 'CD','Cheque Cobrir') 
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
