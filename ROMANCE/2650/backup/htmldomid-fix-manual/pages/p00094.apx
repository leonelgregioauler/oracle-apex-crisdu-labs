    region depóstos-efetuados (
        name: Depóstos Efetuados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                "IDDEPOSITODIARIOS",
                "IDDEPOSITODIARIOS" IDDEPOSITODIARIOS_DISPLAY,
                "DATA",
                "IDREPRESENTANTE",
                "IDCONTABANC",
                "IDPGTOFORN",
                "VALORDEPOSITO",
                decode(COMPROVADO,'S','Sem Comprovante'
                                     ,'C','Cópia'
                                     ,'M','Em Mãos') "COMPROVADO",
                 "NROCOMPROVANTE",
                "OBSERVACAO",
                decode(TIPO,'DD','Dinheiro'
                                     ,'CC','Cheque'
                                     ,'CD','Cheque Pré Depósito'
                                     ,'CR','Cheque Pré Resgate'
                                     ,'M','Em Mãos') "TIPO",
                "IDCHEQUE",
                "IDPGTOFORN_ORIG",
                "IDDEPOSITODIARIOS_ORIG"
                , referentea
                , valororiginal
                , destinosaldo
                from "#OWNER#"."DEPOSITOSDIARIOS"
                where IDPGTOFORN = :p94_IDPGTOFORN
                ```
        }
        layout {
            sequence: 25
            parentRegion: @pagamentos
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 80
        }
        componentAppearance {
            template: @/search-results
            templateOptions: #DEFAULT#
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum depósito efetuado.
        }
        componentAdvanced {
            stripHtml: true
        }

