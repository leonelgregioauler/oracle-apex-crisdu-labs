    validation valida-transportadora (
        name: Valida Transportadora
        execution {
            sequence: 180
        }
        validation {
            type: itemIsNotNull
            item: P396_IDTRANSPORTADORA
        }
        error {
            errorMessage: Informe a transportadora!
            associatedItem: @P396_IDTRANSPORTADORA
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P396_IDFILIALDESTINO IS NOT NULL
                  and :P396_TIPONOTA != 'D'
                  and exists ( select 1
                               from filiais f
                               where f.idfilial = :P396_IDFILIALDESTINO
                                 and f.tipofilial = 'D' )
                ```
        }
    )

