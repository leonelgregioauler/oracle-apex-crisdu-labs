        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P396_IDNOTAFISCAL is not null
                  and :P396_TIPONOTA = 'C'
                  and nvl(( select sum(i.qtd_total)
                            from notasfiscais n
                               , itemnf       i
                            where n.idnotafiscal = i.idnotafiscal 
                              and n.idnotafiscalcompra = :P396_IDNOTAFISCAL ),0) < ( select sum(qtd_total)
                                                                                    from itemnf i
                                                                                    where i.idnotafiscal = :P396_IDNOTAFISCAL )
                union
                select 1
                from dual
                where :P396_IDNOTAFISCAL is not null
                  and :P396_TIPONOTA = 'D'
                ```
        }
    )

