            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: openModal('LIBERARECEB');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from roman.parametros
                 where /*idfilial = (select idfilial
                                     from filiais 
                                    where idfilial = ( select idfilial
                                                         from gerentes
                                                        where idgerente = ( select idgerente
                                                                              from usuarios u
                                                                             where u.usuario = v('APP_USER')) ) )  
                   and*/ nome = 'CONTABILIZAEMPRESA'
                   and valor = 'S'
                   and exists (select 1 
                                 from acessos
                                where usuario = v('APP_USER')
                                  and idaplicacao = 3264
                                  and ativo = 'S' )
                   and not exists (select 1
                                     from notasfiscais
                                    where idnotafiscal = :P396_IDNOTAFISCAL
                                      and nvl(bloqueadoedicao,'N') = 'T')
                ```
        }
