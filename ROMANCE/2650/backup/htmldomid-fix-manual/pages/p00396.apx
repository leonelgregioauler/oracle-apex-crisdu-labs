            postText: "  (Mei não necessita CNPJ)"
        }
        source {
            type: databaseColumn
            databaseColumn: MEI
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from roman.parametros
                 where /*idfilial = (select idfilial
                                     from filiais 
                                    where idfilial = ( select idfilial
                                                         from gerentes
                                                        where idgerente = ( select idgerente
                                                                              from usuarios u
                                                                             where u.usuario = v('APP_USER')) ) )  
                   and */nome = 'CONTABILIZAEMPRESA'
                   and valor = 'S'
                
                   
                ```
        }
    )

    pageItem P396_MENSAGEM (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
            sendOnPageSubmit: false
        }
        layout {
            sequence: 420
            region: @transfêrencias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 
                case
                  when sum(n.valorliquido) - nvl( ( select sum(v.valor-nvl(v.desconto,0)+nvl(v.acrescimo,0))  
                                                    from vencimentos  v 
                                                    where v.idnotafiscal  = n.idnotafiscal ),0) > 0 then
                     chr(60)||'b'||chr(62)||chr(60)||'font color=red> Divergência no Total da NF: </b>'||to_char(sum(n.valorliquido),'FML999G999G990D00') ||' <b>com Total de vencimentos: </b>'||to_char(nvl( (select sum(v.valor-nvl(v.desconto,0)+nvl(v.acrescimo,0))  
                                                from vencimentos  v 
                                                where v.idnotafiscal  = n.idnotafiscal ),0),'FML999G999G990D00')||'</font>'
                  when sum(n.valorliquido) - nvl(( select sum(v.valor-nvl(v.desconto,0)+nvl(v.acrescimo,0))   
                                                   from vencimentos  v 
                                                   where v.idnotafiscal  = n.idnotafiscal),0) < 0 then
                    chr(60)||'b'||chr(62)||chr(60)||'font color=red> Divergência no Total da NF: </b>'||to_char(sum(n.valorliquido),'FML999G999G990D00') ||' <b>com Total de vencimentos: </b>'||to_char(nvl( (select sum(v.valor-nvl(v.desconto,0)+nvl(v.acrescimo,0)) 
                                                from vencimentos  v 
                                                where v.idnotafiscal  = n.idnotafiscal ),0),'FML999G999G990D00')||'</font>'
                end divergencia
                from notasfiscais n
                where n.idnotafiscal = :P396_IDNOTAFISCAL
                group by n.idnotafiscal
                ```
            used: always
        }
        serverSideCondition {
            type: item=value
            item: P396_TIPONOTA
            value: C
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P396_MENSAGEM_DESTINO_ROMANCE (
