    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDNOTAFISCAL.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P396_IDNOTAFISCAL := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 5056446518501518660
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process liberareceb (
        name: LiberaReceb
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P396_OBSERVLIBERARECEB is not null then
                    --
                    update notasfiscais
                       set liberarecebimento    = 'S',
                           dataliberareceb      = sysdate,
                           idusuarioliberareceb = :P0_IDUSUARIO,
                           observliberareceb    = :P396_OBSERVLIBERARECEB
                     where idnotafiscal = :P396_IDNOTAFISCAL;
                    --
                  else
                    --
                    update notasfiscais
                       set liberarecebimento    = NULL,
                           dataliberareceb      = NULL,
                           idusuarioliberareceb = NULL,
                           observliberareceb    = NULL
                     where idnotafiscal = :P396_IDNOTAFISCAL;
                    --
                  end if;
                end;
                ```
        }
        execution {
            sequence: 120
        }
        advanced {
            executionMappingIdentifier: 1074775584575853726
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

