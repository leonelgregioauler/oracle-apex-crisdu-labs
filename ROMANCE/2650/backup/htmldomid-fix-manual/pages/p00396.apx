    dynamicAction mei-nao (
        name: Mei_Nao
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P396_MEI
        }
        clientSideCondition {
            type: item=value
            item: P396_MEI
            value: N
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                     v_ret varchar2(1);
                    begin
                      --
                      if  (:P396_IDRAZAOSOCIALFILEMIT is not null and
                           :P396_IDFILIALDESTINO       is not null and
                           :P396_NRNF                  is not null and
                           :P396_IDRAZAOSOCIALFILDESTINO  is not null ) then
                        --
                        v_ret := 'S';
                        --
                      else
                        --
                        v_ret := 'N';
                        --
                      end if;
                      --
                      RETURN v_ret;
                      --
                    end;
                    ```
                itemsToSubmit: P396_MEI
            }
            affectedElements {
                selectionType: items
                items: P396_LIBERARECEBIMENTO
            }
            execution {
                sequence: 10
            }
        )

    )

