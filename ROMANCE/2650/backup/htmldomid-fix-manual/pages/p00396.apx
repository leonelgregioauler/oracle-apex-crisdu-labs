    region produtos-da-nf (
        name: Produtos da NF
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null link
                     , i.iditnf
                     , p.codigosisdist referencia
                     , nvl(initcap(p.nomeproduto),i.nomeprodutosemcad) "Produto"
                     , trim(to_char(i.custound, '999G990D00')) custo
                     , i.qtd_pp "Qtd PP"
                     , i.qtd_p "Qtd P"
                     , i.qtd_m "Qtd M"
                     , i.qtd_g "Qtd G"
                     , i.qtd_gg "Qtd GG"
                     , i.qtd_egg "Qtd EGG"
                     , i.qtd_exgg "Qtd EXGG"
                     , i.qtd_u "Qtd U"
                     , i.qtd_total "Qtd TOTAL"
                     , (i.qtd_total * i.custound) "TOTAL ITEM"
                     , i.observacao
                     , case 
                         when i.qtd_pp != i.qtd_pp_chegou then 'S'
                         when i.qtd_p != i.qtd_p_chegou then 'S'
                         when i.qtd_m != i.qtd_m_chegou then 'S'
                         when i.qtd_g != i.qtd_g_chegou then 'S'
                         when i.qtd_gg != i.qtd_gg_chegou then 'S'
                         when i.qtd_egg != i.qtd_egg_chegou then 'S'
                         when i.qtd_exgg != i.qtd_exgg_chegou then 'S'
                         when i.qtd_u != i.qtd_u_chegou then 'S'
                       else 'N'
                       end "P Dif."
                     , decode(p.venda,'S','Sim','Não') venda
                     , nomeprodutosemcad  PRODUTODNAOCADASTRADO
                from itemnf i
                   , produtos p
                where i.idproduto = P.idproduto (+)
                  and i.idnotafiscal = :P396_IDNOTAFISCAL
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from itemnf i
                where i.idnotafiscal = :P396_IDNOTAFISCAL
                ```
        }
