    dynamicAction new (
        name: New
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @fecharinline
        }

        action native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @liberareceb
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                      NULL; -- criado dessa forma somente para dar submit nos itens dessa regiao e assim atualizar o estado de sessão
                      /*if :P396_OBSERVLIBERARECEB is not null then
                        update notasfiscais
                           set dataliberareceb = SYSDATE
                             , idusuarioliberareceb = :P0_IDUSUARIO
                             , observliberareceb = :P396_OBSERVLIBERARECEB
                             , liberarecebimento = 'S'
                         where idnotafiscal = :P396_IDNOTAFISCAL;
                      else
                        update notasfiscais
                           set dataliberareceb = NULL
                             , idusuarioliberareceb = NULL
                             , observliberareceb = :P396_OBSERVLIBERARECEB
                             , liberarecebimento = 'N'
                         where idnotafiscal = :P396_IDNOTAFISCAL;
                    
                      end if;*/
                      --
                    END;
                    ```
                itemsToSubmit: [
                    P396_OBSERVLIBERARECEB
                    P396_DATALIBERARECEB
                    P396_IDUSUARIOLIBERARECEB
                    P396_LIBERARECEBIMENTO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select case when :P396_OBSERVLIBERARECEB is not null 
                                then :P0_IDUSUARIO 
                                else null
                            end 
                         , case when :P396_OBSERVLIBERARECEB is null 
                                then null
                                else to_char(sysdate,'dd/mm/rrrr')
                            end
                         , case when :P396_OBSERVLIBERARECEB is not null 
                                then 'S'
                                else null
                            end
                      from dual ;
                    
                    
                    ```
                itemsToSubmit: P396_OBSERVLIBERARECEB
            }
            affectedElements {
                selectionType: items
                items: [
                    P396_IDUSUARIOLIBERARECEB
                    P396_DATALIBERARECEB
                    P396_LIBERARECEBIMENTO
                ]
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
