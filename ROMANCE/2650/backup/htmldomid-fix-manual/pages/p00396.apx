        column IDPRODUTO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Produto
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select p.codigosisdist||' - '||initcap(p.nomeproduto)||' ( R$  '||TRIM(to_char(f.precocusto,'999G999G990D00'))||')' display_value
                    , p.idproduto return_value
                    from produtos p
                       , fornecedoresprodutos f
                    where p.idproduto = f.idproduto 
                      and f.idfornecedor = ( select idfornemitente from notasfiscais where idnotafiscal = :P396_IDNOTAFISCAL )
                      and exists ( select 1 from notasfiscais where idnotafiscal = :P396_IDNOTAFISCAL  and tiponota in ( 'C','R'))
                      and p.ativo = 'S'
                    union
                    select p.codigosisdist||' - '||initcap(p.nomeproduto) display_value
                    , p.idproduto return_value
                    from produtos p
                    where exists ( select 1 from notasfiscais where idnotafiscal = :P396_IDNOTAFISCAL  and tiponota = 'T')
                      and p.ativo = 'S'
                    ```
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 50
            }
        )

