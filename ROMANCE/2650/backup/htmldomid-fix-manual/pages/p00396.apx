    region qtd-recebida (
        name: Qtd Recebida
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto) "Produto"
                     , trim(to_char(i.custound, '999G990D00')) custo
                     , i.qtd_pp_chegou "Qtd PP"
                     , i.qtd_p_chegou "Qtd P"
                     , i.qtd_m_chegou "Qtd M"
                     , i.qtd_g_chegou "Qtd G"
                     , i.qtd_gg_chegou "Qtd GG"
                     , i.qtd_egg_chegou "Qtd EGG"
                     , i.qtd_exgg_chegou "Qtd EXGG"
                     , i.qtd_u_chegou "Qtd U"
                     , i.qtd_total_chegou "Qtd Total"
                     , (i.qtd_total_chegou * i.custound) "Total Item"
                     , i.observacao
                from itemnf i
                   , produtos p
                where i.idproduto = P.idproduto
                  and i.idnotafiscal = :P396_IDNOTAFISCAL
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P396_SITUACAOFILIAL
            value: R
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: dados não encontrados
        }
        componentAdvanced {
            stripHtml: true
        }

