    process altera-documento-compra-e-venda (
        name: Altera Documento Compra e Venda
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update notasfiscais nf
                  set nf.documento = :P396_DOCUMENTO
                  where nf.idnotafiscal = :P396_IDNOTAFISCAL;
                  --
                  update notasfiscais nf
                  set nf.documento = :P396_DOCUMENTO
                  where nf.idnotafiscalcompra = :P396_IDNOTAFISCAL;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 110
        }
        successMessage {
            successMessage: Documento alterado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5056449313861518661
