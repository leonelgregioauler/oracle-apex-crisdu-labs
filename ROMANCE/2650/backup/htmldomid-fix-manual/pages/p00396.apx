    pageItem P396_IDFORNEMITENTE (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                where f.idpessoa = p.idpessoa
                  AND :P396_IDFILIALEMITENTE IS NULL 
                  AND :P396_IDFORNEMITENTE IS NULL
                  and f.ativo = 'S'
                  and exists ( select 1 from fornecedoresprodutos p
                               where p.idfornecedor = f.idfornecedor )
                UNION
                select initcap(p.nomepessoa) display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                where f.idpessoa = p.idpessoa
                  and exists ( select 1 from fornecedoresprodutos p
                               where p.idfornecedor = f.idfornecedor )
                  and (:P396_IDFORNEMITENTE is not null and f.idfornecedor = :P396_IDFORNEMITENTE)
                  and f.ativo = 'S'
                UNION
                select initcap(p.nomepessoa) display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                   , filiais ff
                where f.idpessoa = p.idpessoa
                  and p.idpessoa = ff.idpessoa
                  and f.ativo = 'S'
                  and not exists ( select 1 from fornecedoresprodutos p
                               where p.idfornecedor = f.idfornecedor)
                  and (:P396_IDFORNEMITENTE is not null and f.idfornecedor = :P396_IDFORNEMITENTE)
                UNION
                select initcap(p.nomepessoa) display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                where f.idpessoa = p.idpessoa
                  and f.ativo    = 'S'
                  and exists ( select 1
                               from matrizregrasdespesas m
                               where m.idfornecedor = f.idfornecedor )
                order by 1
                ```
            nullDisplayValue: " - Selecione o Fornecedor -"
        }
        layout {
            sequence: 120
            region: @transfêrencias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: IDFORNEMITENTE
            used: always
        }
        serverSideCondition {
            type: never
        }
        readOnly {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from vencimentos v
                         where v.idnotafiscal = :P396_IDNOTAFISCAL )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

