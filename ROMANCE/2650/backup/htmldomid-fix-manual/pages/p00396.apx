    pageItem P396_IDFILIALDESTINO (
        type: selectList
        label {
            label: Filial Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(f.idfilial) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.ativo       = 'S'
                  and :P396_TIPONOTA = 'T'
                  and f.idfilial not in (1088,1067) -- Transportadora Crisdu
                --
                union
                --
                select pck_romance.fnc_nomefilial(f.idfilial) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.ativo       = 'S'
                  and :P396_TIPONOTA = 'T'
                  --< T9350304
                  and f.idfilial in (1088,1067)-- Transportadora Crisdu
                  and v('APP_USER') in ('DEBORAC', 'ANDREPESSOA')
                  -- T9350304 />
                order by 1
                ```
            nullDisplayValue: " "
        }
        cascadingLov {
            parentItems: P396_TIPONOTA
        }
        layout {
            sequence: 140
            region: @transfêrencias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALDESTINO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

