            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText: <font color=red><h3>Este fornecedor possui antecipação lançada!</h3></font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from notasfiscais nf
                where nf.idnotafiscal < :P396_IDNOTAFISCAL
                  and nf.antecipacao = 'S'
                  and nf.idfornemitente = :P396_IDFORNEMITENTE
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P396_AVISO_LANCAMENTO_DUPLO (
        type: displayOnly
