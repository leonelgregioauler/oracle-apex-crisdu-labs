            sequence: 10
            region: @transfêrencias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText: <font color=red><h3>Lançamento com o mesmo documento encontrado no sistema!</h3></font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from notasfiscais nf
                where nf.idnotafiscal != :P396_IDNOTAFISCAL
                  and nf.idfornemitente = :P396_IDFORNEMITENTE
                  and nf.documento = :P396_DOCUMENTO
                  and nf.tiponota != :P396_TIPONOTA  
                  and nf.tiponota != 'V'
                  and nf.idfilialdestino = :P396_IDFILIALDESTINO
                  and nf.situacao != 'C'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

