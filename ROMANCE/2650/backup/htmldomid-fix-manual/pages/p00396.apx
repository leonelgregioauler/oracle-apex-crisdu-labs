page 396 (
    name: Transferência de Mercadorias
    title: Transferência de Mercadorias
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function abrevencto() 
              {
                vnota = document.getElementById('P396_IDNOTAFISCAL').value;
                window.open('f?p=&APP_ID.:39:&SESSION.::NO::P39_IDNOTAFISCALP,P39_IDVENCIMENTO:'+vnota+',' ,'vencto','toolbar=no,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width=1200,height=300,left=100,top=200','_blank'); void(0);
              }
            
            
            function fnc_popup()
            {vid = document.getElementById("P396_IDNOTAFISCAL").value;
            window.open('f?p=&APP_ID.:190:&SESSION.::NO::P190_IDNOTAFISCAL,P190_IDITNF:'+vid+',','insprod', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=300,left=250,top=100','_blank'); void(0);
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region incluir-itens-na-nf (
        name: Incluir Itens na NF
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDITNF",
                "IDITNF" IDITNF_DISPLAY,
                "IDNOTAFISCAL",
                "IDPRODUTO",
                "CUSTOUND",
                "VALORTOTAL",
                "QTD_PP",
                "QTD_P",
                "QTD_M",
                "QTD_G",
                "QTD_GG",
                "QTD_EGG",
                "QTD_EXGG",
                "QTD_TOTAL",
                "QTD_U",
                "OBSERVACAO"
                from "#OWNER#"."ITEMNF"
                where 1 = 2
                ```
        }
        layout {
            sequence: 40
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P396_IDNOTAFISCAL is not null
                  and :P396_TIPONOTA = 'T'
                ```
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

