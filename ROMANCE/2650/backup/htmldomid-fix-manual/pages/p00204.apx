            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: VALORPAGO
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 394744 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn DATA (
                sequence: 3
            )

            displayColumn "Em Mãos" (
                sequence: 7
            )

            displayColumn "Fechamento" (
                sequence: 6
            )

