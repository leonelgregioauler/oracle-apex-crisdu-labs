        column IDPAGAMENTO (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            link {
                target: {
                    page: 22
                    items: {
                        P22_IDPAGAMENTO: #IDPAGAMENTO#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
