            label: Data
            alignment: left
        }
        layout {
            sequence: 40
            region: @controle-de-empréstimos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        validation {
            maxLength: 10
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P204_IDEMPRESTIMO (
        type: hidden
        layout {
            sequence: 20
            region: @controle-de-empréstimos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDEMPRESTIMO
            used: always
        }
        security {
