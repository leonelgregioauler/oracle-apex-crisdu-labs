    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @controle-de-empréstimos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 167
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @controle-de-empréstimos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: never
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @controle-de-empréstimos
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button efetuar-pagamento (
        buttonName: EFETUAR_PAGAMENTO
        label: Efetuar Pagamento
        layout {
            sequence: 50
            region: @lista-de-pagamentos
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 22
                items: {
                    P22_IDEMPRESTIMO: &P204_IDEMPRESTIMO.
                    P22_IDPAGAMENTO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                from emprestimos e
                where nvl(( select sum(p.valorpago)
                        from pagamentosemprestimos p
                        where p.idemprestimo = e.idemprestimo ),0) < e.valor
                  and e.idemprestimo = :P204_IDEMPRESTIMO
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 30
            region: @controle-de-empréstimos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: never
        }
    )

    validation p204-nome (
        name: P204_NOME
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P204_NOME
        }
        error {
            errorMessage: Informe o nome!
            associatedItem: @P204_NOME
        }
    )

    validation p204-valor (
        name: P204_VALOR
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P204_VALOR
        }
        error {
            errorMessage: Informe o valor do empréstimo!
            associatedItem: @P204_VALOR
        }
    )

    process fetch-row-from-emprestimos (
        name: Fetch Row from EMPRESTIMOS
        type: autoRowFetch
        source {
            tableName: EMPRESTIMOS
            pkColumn: IDEMPRESTIMO
            pkItem: P204_IDEMPRESTIMO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 186632526182517196
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P204_IDEMPRESTIMO is null then
                        select "SEQ_IDEMPRESTIMO".nextval
                          into :P204_IDEMPRESTIMO
                          from dual;
                    end if;
                
                 /* catal.pck_util.prc_enviaemail(  ppara => 'edunog@terra.com.br'
                                             , pcopia => 'tatianaromance@gmail.com'
                                             , passunto => 'Empréstimo Efetuado'
                                             , ptexto => 'Olá!'||chr(10)||chr(10)||
                                                      'O usuário '||pck_romance.fnc_nomeusuario(v('APP_USER'))||' efetuou um empréstimo de R$ '||trim(TO_CHAR(TO_NUMBER(:P204_VALOR),'999G999G990D00'))||' para '||:P204_NOME||'.'||chr(10)||chr(10)||
                                                      'Observação do usuário: '||:P204_OBSERVACAO||chr(10)||chr(10)|| 
                                                      'Mensagem enviada automaticamente.' );*/
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 186632945593517197
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-emprestimos (
        name: Process Row of EMPRESTIMOS
        type: autoRowProcessing
        target {
            tableName: EMPRESTIMOS
            pkColumn: IDEMPRESTIMO
            pkItem: P204_IDEMPRESTIMO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 186633390105517197
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 186633750018517198
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: Go To Page 167
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 204
            }
        }
    )

)

