        }
    )

    pageItem P204_IDFECHAMENTO (
        type: selectList
        label {
            label: Fechamento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana display_value
                     , idfechamento return_value
                from fechamentossemanais
                where idfilial = :P0_IDFILIALCAIXA
                  and concluido = 'N'
                  and :P204_IDEMPRESTIMO IS NULL
                UNION
                select semana display_value
                     , idfechamento return_value
                from fechamentossemanais
                where idfilial = :P204_IDFILIAL
                  and concluido = 'N'
                  and :P204_IDEMPRESTIMO IS not NULL
                order by 2 desc
                ```
        }
        layout {
            sequence: 10
            region: @controle-de-empréstimos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P204_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @controle-de-empréstimos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return :P0_IDFILIALCAIXA;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

