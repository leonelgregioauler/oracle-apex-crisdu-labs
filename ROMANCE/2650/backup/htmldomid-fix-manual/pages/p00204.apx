page 204 (
    name: Controle de Empréstimos
    title: Controle de Empréstimos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='Deseja realmente excluir este empréstimo?';
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region controle-de-empréstimos (
        name: Controle de Empréstimos
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            column: 1
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
    )

    region lista-de-pagamentos (
        name: Lista de Pagamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idpagamento   
                     , data
                     , valorpago
                     , observacao
                     , ( select semana
                         from fechamentossemanais
                         where idfechamento = t.idfechamento) "Fechamento"
                     , identificacao
                     , decode(emmaos,'S','Sim','N','Não') "Em Mãos"
                from pagamentosemprestimos t
                where idemprestimo = :P204_IDEMPRESTIMO
                ```
        }
        layout {
            sequence: 20
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P204_IDEMPRESTIMO
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhum pagamento efetuado.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 39471464503771050
        }

        column DATA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 20
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DATA
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Em Mãos" (
