page 166 (
    name: Lucratividade
    title: Lucratividade
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region lucratividade (
        name: Lucratividade
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select p.nomepessoa
                         from pessoas p
                            , filiais ff
                         where p.idpessoa = ff.idpessoa
                           and ff.idfilial = f.idfilial ) "Filial"
                     , f.semana
                     , to_number(substr(f.semana,4,4)) "Ano"
                     , nvl(( select sum(b.valorcobrado)
                             from boletos b
                             where to_char(b.databaixa ,'IW/RRRR') = f.semana ) ,0) "Total Recebido"
                     , nvl(( select sum(e.valortotal)
                             from entradasdiversas e
                             where e.idfechamento = f.idfechamento ) ,0) "Total Entrada"
                     , nvl(( select sum(p.valorpago)
                              from pagamentocomissoes p
                              where to_char(p.datapagamento,'IW/RRRR') = f.semana ) ,0) "Total Comissões"
                     , nvl(( select sum(d.valor)
                              from despesas d
                              where d.idfechamento = f.idfechamento
                                and d.pago         = 'S' ) ,0) "Total Despesas"
                     , nvl(( select sum(s.valortotal)
                              from saidasdiversas s
                              where s.idfechamento = f.idfechamento ) ,0) "Total Saídas Diversas"
                          
                     , nvl(( select sum(b.valorcobrado)
                             from boletos b
                             where to_char(b.databaixa ,'IW/RRRR') = f.semana ) ,0)
                     +  nvl(( select sum(e.valortotal)
                              from entradasdiversas e
                              where e.idfechamento = f.idfechamento ) ,0)
                     -  nvl(( select sum(p.valorpago)
                              from pagamentocomissoes p
                              where to_char(p.datapagamento,'IW/RRRR') = f.semana ) ,0)
                     -  nvl(( select sum(d.valor)
                              from despesas d
                              where d.idfechamento = f.idfechamento
                                and d.pago         = 'S' ) ,0)
                     -  nvl(( select sum(s.valortotal)
                              from saidasdiversas s
                              where s.idfechamento = f.idfechamento ) ,0) "Total Líquido"
                              
                     , nvl( ( select sum(dd.valordeposito)
                              from depositosdiarios_orig dd
                              where dd.idpgtoforn in ( select pp.idpgtoforn
                                                       from pagamentosfornecedores pp
                                                       where pp.idfilial in (200,260,262) 
                                                         and to_char(pp.dtvencimento,'IW/RRRR') = f.semana ) ) ,0) "Total Faturas Pagas"
                          
                     , (   nvl(( select sum(b.valorcobrado)
                                 from boletos b
                                 where to_char(b.databaixa ,'IW/RRRR') = f.semana ) ,0)
                         +  nvl(( select sum(e.valortotal)
                                  from entradasdiversas e
                                  where e.idfechamento = f.idfechamento ) ,0)
                         -  nvl(( select sum(p.valorpago)
                                  from pagamentocomissoes p
                                  where to_char(p.datapagamento,'IW/RRRR') = f.semana ) ,0)
                         -  nvl(( select sum(d.valor)
                                  from despesas d
                                  where d.idfechamento = f.idfechamento
                                    and d.pago         = 'S' ) ,0)
                         -  nvl(( select sum(s.valortotal)
                                  from saidasdiversas s
                                  where s.idfechamento = f.idfechamento ) ,0) )
                     - nvl( ( select sum(dd.valordeposito)
                              from depositosdiarios_orig dd
                              where dd.idpgtoforn in ( select pp.idpgtoforn
                                                       from pagamentosfornecedores pp
                                                       where pp.idfilial in (200,260,262) 
                                                         and to_char(pp.dtvencimento,'IW/RRRR') = f.semana ) ) ,0) "Lucratividade"
                     , f.idfechamento
                from fechamentossemanais f
                where f.idfilial = 200
                union
                select ( select p.nomepessoa
                         from pessoas p
                            , filiais ff
                         where p.idpessoa = ff.idpessoa
                           and ff.idfilial = f.idfilial ) "Filial"
                     , f.semana
                     , to_number(substr(f.semana,4,4)) "Ano"
                     , nvl( ( select sum(dd.valordeposito)
                              from depositosdiarios_orig dd
                              where dd.idpgtoforn in ( select pp.idpgtoforn
                                                       from pagamentosfornecedores pp
                                                       where pp.idfornecedor = 781 -- Fábrica Sim Moda
                                                         and to_char(pp.dtvencimento,'IW/RRRR') = f.semana ) ) ,0) "Total Recebido"
                     , nvl(( select sum(e.valortotal)
                             from entradasdiversas e
                             where e.idfechamento = f.idfechamento ) ,0) "Total Entrada"
                     , nvl(( select sum(p.valorpago)
                              from pagamentocomissoes p
                              where to_char(p.datapagamento,'IW/RRRR') = f.semana ) ,0) "Total Comissões"
                     , nvl(( select sum(d.valor)
                              from despesas d
                              where d.idfechamento = f.idfechamento
                                and d.pago         = 'S' ) ,0) "Total Despesas"
                     , nvl(( select sum(s.valortotal)
                              from saidasdiversas s
                              where s.idfechamento = f.idfechamento ) ,0) "Total Saídas Diversas"
                          
                          
                     , nvl(( select sum(b.valorcobrado)
                             from boletos b
                             where to_char(b.databaixa ,'IW/RRRR') = f.semana ) ,0)
                     +  nvl(( select sum(e.valortotal)
                              from entradasdiversas e
                              where e.idfechamento = f.idfechamento ) ,0)
                     -  nvl(( select sum(p.valorpago)
                              from pagamentocomissoes p
                              where to_char(p.datapagamento,'IW/RRRR') = f.semana ) ,0)
                     -  nvl(( select sum(d.valor)
                              from despesas d
                              where d.idfechamento = f.idfechamento
                                and d.pago         = 'S' ) ,0)
                     -  nvl(( select sum(s.valortotal)
                              from saidasdiversas s
                              where s.idfechamento = f.idfechamento ) ,0) "Total Líquido"
                              
                     , nvl( ( select sum(dd.valordeposito)
                              from depositosdiarios_orig dd
                              where dd.idpgtoforn in ( select pp.idpgtoforn
                                                       from pagamentosfornecedores pp
                                                       where pp.idfilial = f.idfilial
                                                         and to_char(pp.dtvencimento,'IW/RRRR') = f.semana ) ) ,0) "Total Faturas Pagas"
                          
                     , (   nvl(( select sum(b.valorcobrado)
                                 from boletos b
                                 where to_char(b.databaixa ,'IW/RRRR') = f.semana ) ,0)
                         +  nvl(( select sum(e.valortotal)
                                  from entradasdiversas e
                                  where e.idfechamento = f.idfechamento ) ,0)
                         -  nvl(( select sum(p.valorpago)
                                  from pagamentocomissoes p
                                  where to_char(p.datapagamento,'IW/RRRR') = f.semana ) ,0)
                         -  nvl(( select sum(d.valor)
                                  from despesas d
                                  where d.idfechamento = f.idfechamento
                                    and d.pago         = 'S' ) ,0)
                         -  nvl(( select sum(s.valortotal)
                                  from saidasdiversas s
                                  where s.idfechamento = f.idfechamento ) ,0) )
                     - nvl( ( select sum(dd.valordeposito)
                              from depositosdiarios_orig dd
                              where dd.idpgtoforn in ( select pp.idpgtoforn
                                                       from pagamentosfornecedores pp
                                                       where pp.idfilial = f.idfilial
                                                         and to_char(pp.dtvencimento,'IW/RRRR') = f.semana ) ) ,0) "Lucratividade"
                     , f.idfechamento
                from fechamentossemanais f
                where f.idfilial = 220
                order by 12
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
