    pageItem P384_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomefornecedor display_value
                     , idfornecedor   return_value
                from vw_fornecedores_rmc
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 10
            region: @produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction filtra (
        name: Filtra
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P384_IDFORNECEDOR
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 384
                items: {
                    P384_IDFORNECEDOR: &P384_IDFORNECEDOR.
                }
                action: resetPagination
            }
        }
    )

)

