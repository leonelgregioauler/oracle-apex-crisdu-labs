page 384 (
    name: Listagem de Produtos
    title: Listagem de Produtos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .img_produto {
                position: relative;
                max-width: 210px;
                width: 70%;
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region produtos (
        name: Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select initcap(cc.nome) 
                         from categorias cc
                         where cc.idcategoria = p.idcategoria) Categoria
                     , p.idproduto
                     , initcap(p.nomeproduto) nomeproduto
                     , initcap(p.descrproduto) descrproduto
                     , p.codigosisdist "Referência"
                     , decode(p.ativo,'S','Sim','Não') "Ativo"
                     , decode(p.venda,'S','Sim','Não') "Venda"
                     , decode(p.comissao,'S','Sim','Não') "Comissão"
                     , decode(p.idprodutovarejo, null,'Não','Sim') "Produto do Varejo"
                     , ( select count(1)
                         from estoquefilial e
                         where e.idproduto = p.idproduto 
                           and ativo = 'S') utilizado
                     , initcap(usuariocadastrou) as "Usuário Cadastrou"
                     , p.dtinclusao datacadastro
                     , ( select listagg('<a href="'||url||'" target="_blank"> <img src="'||urlreduzida||'" class="img_produto"><a><br>') within group ( order by 1 desc )
                         from fotosprodutos  f
                         where f.idproduto = p.idproduto ) fotos
                from produtos p
                where :P384_IDFORNECEDOR is null 
                   or exists ( select 1 from fornecedoresprodutos f where f.idproduto = p.idproduto and f.idfornecedor = :P384_IDFORNECEDOR)
                order by 1,4
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than 10,000 rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 256668448975812383
        }

