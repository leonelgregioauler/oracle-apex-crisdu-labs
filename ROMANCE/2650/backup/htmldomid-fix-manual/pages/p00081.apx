    region detalhes-de-despesas-da-unidade (
        name: Detalhes de Despesas da Unidade
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddetalhedespesa
                     , d.idfilial
                     , d.data
                     , d.usuario
                     , d.detalhe
                from detalhesdespesasfiliais d
                where d.idfilial = :P0_IDFILIALCAIXA
                order by d.data
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (2)
                  and ug.usuario = v('APP_USER')
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Incluído em
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column DETALHE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Detalhe
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column IDDETALHEDESPESA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Ver/Editar
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            link {
                target: {
                    page: 437
                    items: {
                        P437_IDDETALHEDESPESA: #IDDETALHEDESPESA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            sorting {
                sortable: false
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Incluído Por
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P81_AVISO_LANCAMENTO_SEM_ANEXO (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 10
            region: @atenção
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText:
                ```html
                <div style="font-family: Arial, sans-serif; font-size: 20px; color: red; text-align: center; padding: 20px; border: 1px solid red; background-color: #f8d7da;">
                  <strong>Aviso Importante:</strong><br>
                  Existem lançamentos de despesas sem anexo. Por favor, regularize antes do encerramento da semana!
                </div>
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button confirmardespesas (
        buttonName: CONFIRMARDESPESAS
