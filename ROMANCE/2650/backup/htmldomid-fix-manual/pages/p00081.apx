    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function abreconta ( pid )
             {
               window.open('f?p=&APP_ID.:159:&SESSION.::&DEBUG.::P159_IDPGTOFORN:'+pid, 'telaconta', 'status = 1, height = 400, width = 1000, resizable = 0');
               void(0);
             }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region atenção (
        name: Atenção!
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent9
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from (select case 
                                 when d.idmovimentotogeral is not null then
                                   ( select count(1)
                                       from saidasdiversas s
                                          , movimentosgeral m
                                          , anexossaidas a
                                       where m.idmovimentogeral = d.idmovimentotogeral 
                                         and s.idsaida          = m.idsaidadiversa
                                         and a.idsaida          = s.idsaida )
                                 else
                                   qtdanexos
                               end qtdanexos
                          from vw_despesascaixas d
                         where (    (:P0_IDFECHAMENTO = 999999999999  and  d.idfilial = :P0_IDFILIALCAIXA)
                                 or ( :P0_IDFECHAMENTO != 999999999999 and idfechamento = :P0_IDFECHAMENTO ) )
                           and pck_util.fnc_verificaacesso(2732,v('APP_USER')) = 'S') aux1
                 where aux1.qtdanexos = 0
                union
                select 1
                  from (select case 
                                 when d.idmovimentotogeral is not null then
                                   ( select count(1)
                                       from saidasdiversas s
                                          , movimentosgeral m
                                          , anexossaidas a
                                       where m.idmovimentogeral = d.idmovimentotogeral 
                                         and s.idsaida          = m.idsaidadiversa
                                         and a.idsaida          = s.idsaida )
                                 else
                                   qtdanexos
                               end qtdanexos
                          from vw_despesascaixas d
                         where (   (:P0_IDFECHAMENTO = 999999999999  and  d.idfilial = :P0_IDFILIALCAIXA)
                                or (idfechamento = :P0_IDFECHAMENTO) )
                           and d.idmovimentotogeral is null
                           and ano >= 2019
                           and d.iddespesa is not null
                           and pck_util.fnc_verificaacesso(2732,v('APP_USER')) = 'N') aux2
                 where aux2.qtdanexos = 0
                ```
        }
    )

    region despesas (
        name: Despesas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.idfechamento 
                     , filial
                     , ano "Ano"
                     , semana "Semana"
                     , Conta
                     ,  subConta
                     , d.observacao
                     , d.valor
                     , d.iddespesa
                     , d.iddespesa idcontrole
                     , trunc(d.datavencimento) datavencimento
                     , mes "Mês"
                     , d.descricaoorigem "Descrição de Origem"
                     , NULL Nota
                     , d.idmovimentotogeral
                     , case 
                         when d.idmovimentotogeral is not null then
                           ( select count(1)
                             from saidasdiversas s
                                , movimentosgeral m
                                , anexossaidas a
                             where m.idmovimentogeral = d.idmovimentotogeral 
                               and s.idsaida          = m.idsaidadiversa
                               and a.idsaida          = s.idsaida )
                         else
                           qtdanexos
                       end qtdanexos
                     , ( select md.classificacaodespesa
                         from matrizclassificacoesdespesas md
                         where md.idmatrizclassificacao = d.idmatrizclassificacao ) matriz
                     , placacarro
                     , datalancamento
                     , (select dd.observacaocontrole
                        from roman.despesas dd
                        where dd.iddespesa = d.iddespesa) obsrevisao
                     , (select distinct c.nome
                          from roman.matrizclassificacoesdespesas mc
                             , roman.centrodecustos c
                         where d.idmatrizclassificacao  = mc.idmatrizclassificacao
                           and mc.idcentrodecusto       = c.idcentrodecusto) "Centro de Custo"
                     , d.idfuncionario
                     , d.funcionario
                from vw_despesascaixas d
                where ( (:P0_IDFECHAMENTO = 999999999999  and  d.idfilial = :P0_IDFILIALCAIXA)
                        or ( :P0_IDFECHAMENTO != 999999999999 and idfechamento = :P0_IDFECHAMENTO ) )
                ```
        }
        layout {
            sequence: 30
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: pck_util.fnc_verificaacesso(2732,v('APP_USER')) = 'S'
        }
        link {
            linkColumn: customTarget
            target: {
                page: 82
                items: {
                    P82_IDDESPESA: #IDDESPESA#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma despesa incluida.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
