                page: 104
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button criar-detalhe (
        buttonName: CRIAR_DETALHE
        label: Criar Detalhe
        layout {
            sequence: 10
            region: @detalhes-de-despesas-da-unidade
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 437
                items: {
                    P437_DETALHE:
                    P437_IDDETALHEDESPESA:
                    P437_IDFILIAL: &P437_IDFILIAL.
                    P437_MD5:
                    P437_USUARIO: &P0_IDUSUARIO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button nova-despesa (
        buttonName: NOVA_DESPESA
        label: Nova Despesa
        layout {
            sequence: 30
            region: @despesas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 82
                items: {
                    P82_IDDESPESA:
                    P82_IDFECHAMENTO: &P0_IDFECHAMENTO.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P0_IDFECHAMENTO IS NOT NULL
                  AND :P0_IDFECHAMENTO != 999999999999
                  and exists ( select 1
                               from fechamentossemanais
                               where idfechamento = :P0_IDFECHAMENTO
                                 and concluido = 'N')
                ```
        }
    )

