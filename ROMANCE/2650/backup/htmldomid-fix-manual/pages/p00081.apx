    region despesas-2 (
        name: Despesas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.idfechamento 
                     , filial
                     , ano "Ano"
                     , semana "Semana"
                     , Conta
                     ,  subConta
                     , d.observacao
                     , d.valor
                     , d.iddespesa
                     , d.iddespesa idcontrole
                     , trunc(d.datavencimento) datavencimento
                     , mes "Mês"
                     , d.descricaoorigem "Descrição de Origem"
                     , NULL Nota
                     , d.idmovimentotogeral
                     , case 
                         when d.idmovimentotogeral is not null then
                           ( select count(1)
                             from saidasdiversas s
                                , movimentosgeral m
                                , anexossaidas a
                             where m.idmovimentogeral = d.idmovimentotogeral 
                               and s.idsaida          = m.idsaidadiversa
                               and a.idsaida          = s.idsaida )
                         else
                           qtdanexos
                       end qtdanexos
                     , placacarro
                     , datalancamento
                     , (select distinct c.nome
                          from roman.despesas d
                             , roman.matrizclassificacoesdespesas mc
                             , roman.centrodecustos c
                         where d.idmatrizclassificacao  = mc.idmatrizclassificacao
                           and mc.idcentrodecusto       = c.idcentrodecusto
                           and mc.idmatrizclassificacao = d.idmatrizclassificacao
                           and rownum = 1) "Centro de Custo"
                     , d.idfuncionario
                     , d.funcionario
                from vw_despesascaixas d
                where ((:P0_IDFECHAMENTO = 999999999999  and  d.idfilial = :P0_IDFILIALCAIXA)
                        or idfechamento = :P0_IDFECHAMENTO )
                  and d.idmovimentotogeral is null
                  and ano >= 2019
                  and d.iddespesa is not null
                ```
        }
