    region incluir-itens-na-nf (
        name: Incluir Itens na NF
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDITNF",
                "IDITNF" IDITNF_DISPLAY,
                "IDNOTAFISCAL",
                "IDPRODUTO",
                "CUSTOUND",
                "VALORTOTAL",
                "QTD_PP",
                "QTD_P",
                "QTD_M",
                "QTD_G",
                "QTD_GG",
                "QTD_EGG",
                "QTD_EXGG",
                "QTD_TOTAL",
                "QTD_U",
                "OBSERVACAO"
                from "#OWNER#"."ITEMNF"
                where 1 = 2
                ```
        }
        layout {
            sequence: 25
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P282_IDNOTAFISCAL is not null
                 /* and :P282_TIPONOTA = 'C'*/
                  and :P282_SITUACAO = 'E'
                ```
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

