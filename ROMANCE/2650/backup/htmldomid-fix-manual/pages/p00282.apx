    pageItem P282_IDFILIALDESTINO (
        type: selectList
        label {
            label: Filial Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(NVL(P.apelido,p.nomepessoa)||' ('||c.nomecidade)||'-'||e.sigla||')' display_value
                     , f.idfilial return_value 
                from filiais f
                   , pessoas p
                   , cidades c
                   , estados e
                where f.idpessoa    = p.idpessoa
                  and p.idcidade    = c.idcidade
                  and c.idestado    = e.idestado 
                  and f.ativo       = 'S'
                order by 1
                ```
            nullDisplayValue: " "
        }
        layout {
            sequence: 90
            region: @compras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALDESTINO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P282_IDFILIALEMITENTE (
        type: selectList
        label {
            label: Filial Emitente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa||' ('||c.nomecidade)||'-'||e.sigla||')' display_value
                     , f.idfilial return_value 
                from filiais f
                   , pessoas p
                   , cidades c
                   , estados e
                where f.idpessoa = p.idpessoa
                  and p.idcidade = c.idcidade
                  and c.idestado = e.idestado
                order by 1
                ```
            displayExtraValues: false
