    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDNOTAFISCAL.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P282_IDNOTAFISCAL := get_pk; 
                  :P282_DOCUMENTO    := :P282_IDNOTAFISCAL; 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 602649315460499484
        }
        serverSideCondition {
            type: never
        }
    )

