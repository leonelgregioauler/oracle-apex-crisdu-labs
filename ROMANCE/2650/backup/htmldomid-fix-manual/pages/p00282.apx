page 282 (
    name: Solicitações de Pagamentos
    title: Solicitações de Pagamentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function abrevencto() 
              {
                vnota = document.getElementById('P282_IDNOTAFISCAL').value;
                window.open('f?p=&APP_ID.:285:&SESSION.::NO::P285_IDNOTAFISCALP,P285_IDVENCIMENTO:'+vnota+',' ,'vencto','toolbar=no,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width=1000,height=300,left=200,top=300','_blank'); void(0);
              }
            
            
            function fnc_popup()
            {vid = document.getElementById("P282_IDNOTAFISCAL").value;
            window.open('f?p=&APP_ID.:190:&SESSION.::NO::P190_IDNOTAFISCAL,P190_IDITNF:'+vid+',','insprod', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=300,left=250,top=100','_blank'); void(0);
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region compras (
