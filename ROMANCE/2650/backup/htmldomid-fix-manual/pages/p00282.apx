    process cria-notavenda (
        name: cria notavenda
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 31/07/2013 by SONY 
                declare 
                  -- Local variables here
                  i integer;
                begin
                  -- Test statements here
                  declare 
                  -- 
                  i integer;
                  vnotacompra number := :P282_IDNOTAFISCAL;
                  vnotavenda  number;
                begin
                  --
                  select Seq_Idnotafiscal.Nextval 
                  into vnotavenda
                  from dual;
                  --
                  :P282_NOTAVENDA := vnotavenda;
                  --
                  insert into notasfiscais ( idnotafiscal     , idfornemitente   , tipoemitente
                                         , idtransportadora , dtnf               , usuario
                                         , situacao         , documento          , tiponota
                                         , datainclusao     , idnotafiscalcompra )
                  select vnotavenda        , 2111         , 'FOR'
                       , idtransportadora  , dtnf         , usuario
                       , situacao          , documento    , 'V'
                       , datainclusao      , vnotacompra
                  from notasfiscais
                  where idnotafiscal = vnotacompra;
                  --
                  insert into itemnf
                  select seq_idtemnf.nextval
                       , vnotavenda
                       , idproduto
                       , qtd_p
                       , ( select f.precocusto
                           from fornecedoresprodutos f
                           where f.idfornecedor = 2111
                             and f.idproduto = i.idproduto ) custound
                       , valortotal
                       , qtd_gg
                       , qtd_g
                       , qtd_m
                       , qtd_total
                       , qtd_u
                       , observacao
                       , idprodutodetalhado
                       , qtd_pp
                       , qtd_egg
                       , qtd_pp_chegou
                       , qtd_p_chegou
                       , qtd_m_chegou
                       , qtd_g_chegou
                       , qtd_gg_chegou
                       , qtd_egg_chegou
                       , qtd_u_chegou
                       , qtd_total_chegou
                       , observacaofilial
                       , idprodutorecebido
                       , qtd_exgg 
                       , qtd_exgg_chegou 
                  from itemnf i
                  where i.idnotafiscal = vnotacompra;
                  --
                end;
                end;
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Nota de venda criada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 602650118035499485
        }
        serverSideCondition {
            whenButtonPressed: @incluir-venda
        }
    )

    process enviar-para-aprovacao (
        name: ENVIAR PARA APROVACAO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vtexto varchar2(2000);
                begin
                  --
                  update notasfiscais
                  set situacao = 'P'
                  where idnotafiscal = :P282_IDNOTAFISCAL;
                  --
                  for a in ( select *
                             from vencimentos b
                             where idnotafiscal = :P282_IDNOTAFISCAL 
                             order by b.datavencimento)
                  loop
                    --
                    vtexto := vtexto||to_char(a.datavencimento,'DD/MM/RRRR')||' - '||trim(to_char(a.valor,'FML999G999G990D00'))||' <br>';
                    --
                  end loop;
                  --
                  declare
                    vemail varchar2(100);
                  begin
                    --
                    catal.pck_util.prc_enviaemail(ppara => 'tatiana@romancemoda.com.br'
                                                 , pcopia => 'michele.zimpel@crisdu.com.br'
                                                 -- , pcopia => 'adriana@romancemoda.com.br'
                                                 ,pcopiaoculta => 'bruna@romancemoda.com.br',
                                                  passunto => '[Aviso automático] Conta pendente de aprovação',
                                                  ptexto => 'Olá,<br>'||
                                                            'O usuário '||initcap(v('APP_USER'))||' acabou de enviar uma compra para aprovação.<br><br>'||
                                                            vtexto||'<br>'||
                                                            'Atenciosamente,<br>'||      
                                                            'Tecnologia da Informação<br>'||       
                                                            'Romance Moda<br>'||       
                                                            'Fone: 51 8281 0011<br>'||      
                                                            'www.romancemoda.com.br<br>'||     
                                                            'www.atacadofavorita.com.br'  );
                  end;
                  --
                end;
                ```
        }
        execution {
            sequence: 90
        }
        successMessage {
            successMessage: Enviado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 602837212591122832
        }
        serverSideCondition {
            whenButtonPressed: @enviar-para-aprovacao
        }
    )

