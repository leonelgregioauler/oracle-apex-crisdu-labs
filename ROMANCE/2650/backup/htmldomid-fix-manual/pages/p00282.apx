    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @incluir-itens-na-nf
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button vencimentos (
        buttonName: VENCIMENTOS
        label: Vencimentos
        layout {
            sequence: 50
            region: @compras
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 285
                items: {
                    P285_IDNOTAFISCAL: &P282_IDNOTAFISCAL.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P282_VALORTOTAL is not null
                  and :P282_TIPONOTA = 'C'
                  and :P282_SITUACAO = 'E'
                ```
        }
    )

    dynamicAction tiponf (
        name: tiponf
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P282_TIPONOTA
        }
        clientSideCondition {
            type: item=value
            item: P282_TIPONOTA
            value: C, R
        }
        serverSideCondition {
            type: never
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P282_IDFORNEMITENTE
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P282_IDFILIALEMITENTE
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P282_IDFORNEMITENTE
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P282_IDFILIALEMITENTE
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

    )

