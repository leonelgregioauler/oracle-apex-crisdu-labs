    region produtos-da-nf (
        name: Produtos da NF
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.iditnf link
                     , initcap(p.nomeproduto) "Produto"
                     , trim(to_char(i.custound, '999G990D00')) custo
                     , i.qtd_pp "Qtd PP"
                     , i.qtd_p "Qtd P"
                     , i.qtd_m "Qtd M"
                     , i.qtd_g "Qtd G"
                     , i.qtd_gg "Qtd GG"
                     , i.qtd_egg "Qtd EGG"
                     , i.qtd_exgg "Qtd EXGG"
                     , i.qtd_u "Qtd U"
                     , i.qtd_total "Qtd TOTAL"
                     , (i.qtd_total * i.custound) "TOTAL ITEM"
                     , i.observacao
                from itemnf i
                   , produtos p
                where i.idproduto = P.idproduto
                  and i.idnotafiscal = :P282_IDNOTAFISCAL
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from itemnf i
                where i.idnotafiscal = :P282_IDNOTAFISCAL
                ```
        }
