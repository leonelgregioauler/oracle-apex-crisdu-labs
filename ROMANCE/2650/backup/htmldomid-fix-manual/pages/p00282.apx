    pageItem P282_IDFORNEMITENTE (
        type: selectList
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa||' ('||c.nomecidade)||'-'||e.sigla||')' display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                   , cidades c
                   , estados e
                where f.idpessoa = p.idpessoa
                  and p.idcidade = c.idcidade
                  and c.idestado = e.idestado
                  and :p282_idfilialemitente is null 
                  and :p282_idfornemitente is null
                  and exists ( select 1 from fornecedoresprodutos p
                               where p.idfornecedor = f.idfornecedor)
                UNION
                select initcap(p.nomepessoa||' ('||c.nomecidade)||'-'||e.sigla||')' display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                   , cidades c
                   , estados e
                where f.idpessoa = p.idpessoa
                  and p.idcidade = c.idcidade
                  and c.idestado = e.idestado
                  and exists ( select 1 from fornecedoresprodutos p
                               where p.idfornecedor = f.idfornecedor)
                  and (:P282_IDFORNEMITENTE is not null and f.idfornecedor = :P282_IDFORNEMITENTE)
                ```
            nullDisplayValue: " - Selecione o Fornecedor -"
        }
        layout {
            sequence: 80
            region: @compras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFORNEMITENTE
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P282_IDNOTAFISCAL
        }
        security {
            encryptSessionState: false
        }
    )

