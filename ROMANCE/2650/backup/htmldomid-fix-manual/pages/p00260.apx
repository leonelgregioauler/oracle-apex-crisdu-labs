                heading: Data Vencimento
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 10
            }
        )

        column IDCONTACONTABIL (
            reportColumnQueryId: 3
            derivedColumn: N
            type: selectList
            heading {
                heading: Conta
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(c.nomeconta) display_value
                         , c.idcontafinan
                    from contasfinanceiras c
                    WHERE IDcontafinan = :P260_CONTACONTABIL
                    order by 1
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 3
            }
        )

        column IDDESPESA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDDESPESAS
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 8
            }
            default {
                type: item
                item: P260_IDFILIAL
            }
            sorting {
                sortable: false
            }
        )

        column IDSUBCONTACONTABIL (
            reportColumnQueryId: 6
            derivedColumn: N
            type: selectList
            heading {
                heading: Sub Conta
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(c.nomeconta) display_value
                         , c.idsubcontafinan
                    from subcontasfinanceiras c
                    where c.idcontafinan = :P260_CONTACONTABIL
                      AND ATIVO = 'S'
                    order by 1
                    ```
                nullDisplayValue: - Selecione a Subconta
            }
            layout {
                sequence: 4
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 4
            derivedColumn: N
