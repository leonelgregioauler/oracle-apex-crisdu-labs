page 260 (
    name: Programar Despesas
    title: Programar Despesas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region despesas-programadas-não-vinculadas (
        name: Despesas Programadas não Vinculadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iddespesa
                     , semana
                     , ( select initcap(nvl(pf.apelido,pf.nomepessoa))
                         from filiais f
                            , pessoas pf
                         where f.idfilial = d.idfilial
                           and f.idpessoa = pf.idpessoa )  Filial
                     , ( select initcap(nvl(p.apelido,p.nomepessoa))
                         from representantes r
                            , pessoas        p
                         where r.idrepresentante = d.idrepresentante
                           and r.idpessoa = p.idpessoa ) Representante
                     , initcap(c.nomeconta) contafinanceira
                     , ( select initcap(nomeconta)
                         from subcontasfinanceiras s
                         where s.idsubcontafinan = d.idsubcontacontabil ) Subconta
                     , d.observacao
                     , d.valor
                     , d.datavencimento
                     , ( select ff.semana from fechamentossemanais ff where ff.idfechamento = d.idfechamento ) "Fechamento"
                     , DESCRICAOORIGEM "Descrição da Origem"
                from despesas           d
                   , contasfinanceiras  c
                where d.idcontacontabil = c.idcontafinan
                  --and d.idfechamento is null
                  and ( (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S')
                       or (d.idfilial    = ( select  f.idfilial 
                                        from filiais    f
                                           , usuarios   u
                                           , gerentes   g
                                        where g.idfilial  = f.idfilial
                                          and u.idgerente = g.idgerente
                                          and u.usuario   = v('APP_USER'))))
                ```
        }
        layout {
            sequence: 25
            slot: body-3
        }
        link {
            linkColumn: customTarget
            target: {
                page: 107
                items: {
                    P107_IDDESPESA: #IDDESPESA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt="" />
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Não há despesas programadas sem vínculo com algum fechamento.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 313050013865820479
        }

