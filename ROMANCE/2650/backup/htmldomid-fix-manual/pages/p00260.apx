    pageItem P260_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @programar-despesas
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select  f.idfilial 
                from filiais    f
                   , usuarios   u
                   , gerentes   g
                where g.idfilial  = f.idfilial
                  and u.idgerente = g.idgerente
                  and u.usuario   = v('APP_USER')
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

