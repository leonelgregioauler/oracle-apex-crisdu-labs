    process add-row (
        name: add row
        type: tabformAddRows
        editableRegion: @programar-despesas-2
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 486881125430388483
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P260_CONTACONTABIL
            executeCondition: once
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @programar-despesas-2
        target {
            tableName: DESPESAS
            pkColumn: IDDESPESA
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Linha(s) #MRD_COUNT# deletadas.
        }
        error {
            errorMessage: Não é possível processar a deleção.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 486880920418388483
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @programar-despesas-2
        target {
            tableName: DESPESAS
            pkColumn: IDDESPESA
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Linha(s) #MRU_COUNT# atualizada(s); linha(s) #MRI_COUNT# inserida(s).
        }
        error {
            errorMessage: Não foi possível processar a atualização.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 486880713891388482
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 260
            }
            saveStateBeforeBranching: true
        }
    )

)

