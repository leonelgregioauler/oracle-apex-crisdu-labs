    pageItem P260_CONTACONTABIL (
        type: selectList
        label {
            label: Conta
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idcontafinan
                from contasfinanceiras c
                order by 1
                ```
            nullDisplayValue: - Selecione a Conta -
        }
        layout {
            sequence: 20
            region: @programar-despesas
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
