    region programar-despesas (
        name: Programar Despesas
        type: staticContent
        layout {
            sequence: 5
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region programar-despesas-2 (
        name: Programar Despesas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDDESPESA",
                "IDCONTACONTABIL",
                "OBSERVACAO",
                "VALOR",
                "IDSUBCONTACONTABIL",
                "DATAVENCIMENTO",
                "IDFILIAL"
                from "#OWNER#"."DESPESAS"
                where 1= 2
                ```
        }
        layout {
            sequence: 15
            parentRegion: @programar-despesas
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P260_CONTACONTABIL
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (nulo)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Dados não encontrados.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 1
