page 255 (
    name: Posição Atual com Fornecedor
    title: Posição Atual com Fornecedor
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region posição-atual-com-fornecedor (
        name: Posição Atual com Fornecedor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfornecedor ID
                     , pck_romance.fnc_nomefornecedor(idfornecedor) "Fornecedor"
                     , '|' div
                     , nvl(( select sum(p.valorpagar)
                             from pagamentosfornecedores p
                             where idfornecedor = fo.idfornecedor 
                               and ( :P255_ANO is null or to_char(p.dtvencimento,'RRRR') = :P255_ANO) ),0) "Valor Pagar"
                     , nvl(( select sum(d.valordeposito)
                             from depositosdiarios_orig d
                             where nvl(d.tipo,'XX') != 'AB' 
                               and d.idpgtoforn in ( select p.idpgtoforn
                                                     from pagamentosfornecedores p
                                                     where idfornecedor = fo.idfornecedor 
                                                       and ( :P255_ANO is null or to_char(p.dtvencimento,'RRRR') = :P255_ANO) )),0) "Depósito"
                     , '+' mais
                     , nvl(( select sum(d.valordeposito)
                             from depositosdiarios_orig d
                             where d.tipo = 'AB'
                               and d.idpgtoforn in ( select p.idpgtoforn
                                                     from pagamentosfornecedores p
                                                     where idfornecedor = fo.idfornecedor
                                                       and ( :P255_ANO is null or to_char(p.dtvencimento,'RRRR') = :P255_ANO)  )),0)  "Abatimento"
                     , '=' igual
                     , '|' div2
                     , decode(fo.ativo,'S','Sim','Não') "Ativo"
                from fornecedores fo
                /*where exists ( select 1 
                               from fornecedoresprodutos f
                                  , produtos             p
                               where f.idfornecedor = fo.idfornecedor
                                 and f.idproduto    = p.idproduto
                                 and p.venda        = 'S')*/
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
