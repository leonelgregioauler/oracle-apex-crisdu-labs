        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct ano display_value
                     , ano return_value
                from semana_dias
                order by 1 desc
                ```
            nullDisplayValue: - Geral -
        }
        layout {
            sequence: 10
            region: @posição-atual-com-fornecedor
            slot: regionBody
        }
        appearance {
