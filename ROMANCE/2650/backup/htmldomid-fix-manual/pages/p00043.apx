    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 43
                items: {
                    P43_TIPO_DATA: &P43_TIPO_DATA.
                    P43_IDFILIAL: &P43_IDFILIAL.
                    P43_IDREPRESENTANTE: &P43_IDREPRESENTANTE.
                    P43_TIPO_CHEQUE: &P43_TIPO_CHEQUE.
                    P43_PAGO: &P43_PAGO.
                    P43_DATAINICIO: &P43_DATAINICIO.
                    P43_DATAFIM: &P43_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

