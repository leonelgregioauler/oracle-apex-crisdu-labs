page 43 (
    name: Lista de Cheques
    title: Lista de Cheques
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region lista-de-cheques (
        name: Lista de Cheques
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDCHEQUE
                     , initcap(bb.nomebanco) Banco
                     , AGENCIA
                     , CONTA
                     , NRCHEQUE
                     , DATAINCLUSAO
                     , pck_romance.fnc_nomefilial(c.idfilial) "Filial"
                     , pck_romance.fnc_nomerepresentante(c.idrepresentante) Representante
                     , pck_romance.fnc_nomerepresentante(c.idpessoa) Pessoa
                     , pck_romance.fnc_nomecidade(c.idcidade) cidade
                     , VALOR
                     , PREDATADO
                     , pck_romance.fnc_nomefornecedor(c.idfornecedor) Fornecedor
                     , c.OBSERVACAO
                     , c.DESTINO
                     , decode(c.semfundo, 'S','Sim', 'Não') Semfundo
                     , decode(c.pago, 'S','Sim', 'Não') Pago
                     , decode(c.emprestimo, 'S','Sim', 'Não') Emprestimo
                     , decode(c.perda, 'S','Sim', 'Não') Perda
                     , nvl(( select sum(cp.valor) from cheques2pgto cp where cp.idcheque = c.idcheque),0) "Valor Pago"
                     , VALOR - nvl(( select sum(cp.valor) from cheques2pgto cp where cp.idcheque = c.idcheque),0) "Saldo"
                     , ( select decode(ativo ,'S','Sim','Não')
                         from representantes r
                         where r.idrepresentante = c.idrepresentante ) Ativo
                     , NUMEROCONSULTA "Nro Consulta"
                     , null veranexos
                     , decode(c.chequepredatado,'S','Sim','Não') chequepredatado
                     , ( select i.descricao
                         from identificacaocheques i
                         where i.ididentificacaocheque = c.identificacao ) identificacao
                     , juros
                     , taxas
                from CHEQUES2 c
                   , bancos   bb
                where c.idbanco = bb.idbanco   (+)
                  and ( :P43_TIPO_DATA = 'T'
                     or ( :P43_TIPO_DATA = 'I' and c.datainclusao between to_date(:P43_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P43_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                     or ( :P43_TIPO_DATA = 'P' and c.predatado between to_date(:P43_DATAINICIO) and to_date(:P43_DATAFIM) ) )
                  and ( :P43_IDFILIAL is null or c.idfilial = :P43_IDFILIAL )
                  and ( :P43_IDREPRESENTANTE is null or c.idrepresentante = :P43_IDREPRESENTANTE )
                  and ( :P43_TIPO_CHEQUE = 'T'
                     or ( :P43_TIPO_CHEQUE = 'E' and c.emprestimo = 'S' )
                     or ( :P43_TIPO_CHEQUE = 'P' and c.chequepredatado = 'S' )
                     or ( :P43_TIPO_CHEQUE = 'S' and c.semfundo = 'S' ) )
                  and ( :P43_PAGO is null or c.pago = 'S' )
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 44
                items: {
                    P44_IDCHEQUE: #IDCHEQUE#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

