page 267 (
    name: Venda para Rmc
    title: Venda para Rmc
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region venda-para-rmc (
        name: Venda para Rmc
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pagforn.dtvencimento
                     , pagforn.idpgtoforn
                     , to_char(pagforn.dtvencimento, 'MONTH') "Mês"
                     , ( select pck_romance.fnc_nomefilial( nf.idfilialdestino ) 
                         from notasfiscais    nf
                         where nf.idnotafiscal  = pagforn.idnotafiscal ) "Filial Destino"
                     , pck_romance.fnc_nomefornecedor(pidforn => pagforn.idfornecedor) Fornecedor
                     , ( select nf.documento
                         from notasfiscais    nf
                         where nf.idnotafiscal  =pagforn.idnotafiscal ) nrnf
                     , pagforn.valorpagar ValorPagar
                     , pagforn.valorpago ValorPago
                     , pagforn.valorpago - pagforn.valorpagar Saldo
                from pagamentosfornecedores pagforn
                where pagforn.idcheque is null
                  and pagforn.idfornecedor = pck_romance.fnc_fornecedorfilial(:P267_IDFILIAL)
                  and pagforn.semanavencimento = :P267_SEMANA
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 346517918543942483
        }

