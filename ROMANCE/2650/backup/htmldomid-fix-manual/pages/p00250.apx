page 250 (
    name: Empréstimos Fechamento
    title: Empréstimos Fechamento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region empréstimos (
        name: Empréstimos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(idfilial) "Empresa"
                     , ( select semana
                         from fechamentossemanais
                         where idfechamento = e.idfechamento) "Fechamento"
                     , e.idemprestimo
                     , e.nome
                     , e.data dataemprestimo
                     , e.observacao
                     , e.valor
                     , e.valorjuros
                     , ( select sum(valorpago) from pagamentosemprestimos ee where ee.idemprestimo = e.idemprestimo ) - (e.valor + e.valorjuros) saldo
                     , t.data datapagamento
                     , t.valorpago
                     , t.observacao obspgto
                     , ( select semana
                         from fechamentossemanais
                         where idfechamento = t.idfechamento) "Fechamento Pago"
                     , t.identificacao
                     , decode(t.emmaos,'S','Sim','Não') "Em Mãos" 
                from emprestimos e
                   , pagamentosemprestimos t
                where e.idemprestimo = t.idemprestimo
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
