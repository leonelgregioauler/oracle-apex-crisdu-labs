    region débitos-de-representantes-favorita (
        name: Débitos de Representantes (Favorita)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.idboleto
                     , numero
                     , empresa "Empresa"
                     , representante "Representante"
                     , valortotal "Valor Total"
                     , b.datavencimento "Vencimento"
                     , diasatrasado "Dias em atraso"
                     , situacao "Situação"
                from vw_debitosrepresfavorita b
                order by 4
                ```
