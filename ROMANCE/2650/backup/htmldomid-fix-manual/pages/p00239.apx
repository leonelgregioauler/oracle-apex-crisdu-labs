            sort (
                column: DATA_DEPOSITO
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            aggregate (
                column: VALOR_DEPOSITADO
            )

            filter ir-condition (
                column: COMPROVADO
                operator: !=
                value: Em Mãos
                advanced {
                    enabled: false
                }
            )

            filter ir-condition-2 (
                column: DATA_DEPOSITO
                operator: between
                from: 20140804000000
                to: 20140809000000
            )

            filter ir-condition-3 (
                column: "Filial Destino"
                operator: contains
                value: Sim Ind. ADM
            )

            groupByColumn (
                column: DEPOSITADO_PARA
                layout {
                    sequence: 1
                }
            )

            groupByColumn (
                column: DATA_DEPOSITO
                layout {
                    sequence: 2
                }
            )

            groupByAggregate (
                heading: Valor Depósito
                aggregate {
                    column: VALOR_DEPOSITADO
                    displaySum: true
                }
                appearance {
                    formatMask: FML999G999G999G999G990D00
                }
                layout {
                    sequence: 1
                }
            )

        )

