    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 20
            slot: body-1
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent5
                t-Region--scrollBody
                t-Form--slimPadding
            ]
            renderComponents: belowContent
        }
    )

    pageItem P239_DATA (
        type: datePickerJquery
        label {
            label: Data
            alignment: left
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P239_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P239_IDCONTABANC (
        type: popupLov
        label {
            label: Conta
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomepessoa(c.idpessoa)|| ' --- '||  c.beneficiario||' - '|| agencia||'/'||conta||' - '||  b.nomebanco display_value
                     , c.idcontabanc return_value
                from contasbancarias c
                   , bancos b
                where c.idbanco = b.idbanco
                  and c.ativo = 'S'
                  and (:P239_IDFORNECEDOR is null or exists ( select 1
                                                             from fornecedores f
                                                             where f.idpessoa  = c.idpessoa
                                                               and f.idfornecedor = :P239_IDFORNECEDOR ) )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: P239_IDFORNECEDOR
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 90
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P239_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome     display_value
                     , idfilial return_value
                from vw_filiais
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P239_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(pe.apelido) display_value
                     , fe.idfornecedor return_value
                from fornecedores fe
                    , pessoas     pe
                where fe.idpessoa = pe.idpessoa 
                  and exists ( select 1
                               from pagamentosfornecedores pp
                                  , depositosdiarios       dd
                               where pp.idpgtoforn = dd.idpgtoforn   
                                 and pp.idfornecedor = fe.idfornecedor )
                order by 1
                ```
            nullDisplayValue: " - Todos -"
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 90
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P239_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomepessoa(r.idpessoa) ||' - '||pck_romance.fnc_nomefilial(g.idfilial)     display_value
                     , r.idrepresentante     return_value
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente
                  and r.ativo = 'S'
                  and (:P239_IDFILIAL  is null or g.idfilial = :P239_IDFILIAL  )
                order by 1  
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P239_IDFILIAL
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P239_VALORDEPOSITO (
        type: hidden
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 10
            region: @filtro
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction filtrar (
        name: filtrar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 239
                items: {
                    P239_IDFORNECEDOR: &P239_IDFORNECEDOR.
                    P239_IDFILIAL: &P239_IDFILIAL.
                    P239_IDREPRESENTANTE: &P239_IDREPRESENTANTE.
                    P239_DATA: &P239_DATA.
                    P239_VALORDEPOSITO: &P239_VALORDEPOSITO.
                    P239_FILTRAR: S
                }
                action: resetPagination
            }
        }
    )

)

