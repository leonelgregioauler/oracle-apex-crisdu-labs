    region depositos-efetuados (
        name: Depositos Efetuados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                  from VWFA_APP2650_P239_REL001 
                 where :P239_FILTRAR ='S'
                ```
            pageItemsToSubmit: P239_FILTRAR
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
