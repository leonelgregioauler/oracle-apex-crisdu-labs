    region lucratividade-por-semana (
        name: Lucratividade por Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTRIBUICAO "Distribuição"
                     , COBRANCA "Cobrança"
                     , SUM(TOTALMERCADORIAS)*-1 "Total Mercadorias" 
                     , SUM(TOTALCOBRANCA) "Total Cobrança"
                     , SUM(TOTALDESPESAS)*-1 "Total de Despesas"
                     , SUM(totalcomissoes)*-1 "Comissões"
                     , SUM(valorliquido) "Valor Liquido"
                --     , SUM(TOTALVENDAFAVORITA) "Total Venda Favorita"
                --     , SUM(PERCVENDAFAVORITA) "% Venda Favorita"
                     , sum(RESULTADO)  "Resultado da Semana"
                     , case
                         when ( sum(totalcobranca) + nvl( sum(totalvendasdiretas),0)) > 0 then 
                               (
                                ( nvl(sum(totalcomissoes),0)
                                + nvl( sum(f.totaldespesas),0) )
                               / ( sum(totalcobranca) + nvl( sum(totalvendasdiretas),0)))* 100 
                         else 
                           0
                           end  "% Despesa"
                     , case
                         when ( sum(totalcobranca) + nvl( sum(totalvendasdiretas),0)) > 0 then 
                               (
                                ( nvl( sum(f.totaldespesas),0) )
                               / ( sum(totalcobranca) + nvl( sum(totalvendasdiretas),0)))* 100 
                         else 
                           0
                           end  "% Despesa Sem Comissão"
                     , sum(totaltransferencias) "Transferência"
                     , case
                         when SUM(TOTALCOBRANCA) > 0 then
                            sum(RESULTADO) /  SUM(TOTALCOBRANCA) * 100 
                         else
                           0
                         end "% Lucro"
                     , ANO
                     , SEMANA
                     , SEMANA2
                     , idsemana
                FROM (  select   DISTRIBUICAO
                             ,  COBRANCA
                             ,  TOTALMERCADORIAS
                             , TOTALCOBRANCA
                             , TOTALDESPESAS
                             , f.percdespesa
                             , f.totalcomissoes
                             , f.valorliquido
                             , f.ResultadodaSemana RESULTADO 
                             , f.AnoCobranca ano
                             , f.SemanaCobranca semana       
                             , semana SEMANA2
                             , totaltransferencias
                             , f.totalvendasdiretas
                             , idsemana
                             , percdespesasemcomissao
                        from vw_fechamentosdistribuidoras  f
                        where f.idsemana > 719
                          and exists ( select 1
                                      from usuariosfiliais u
                                      where u.idfilial = f.idfilial
                                        and u.usuario  = v('APP_USER') )  ) F
                GROUP BY DISTRIBUICAO
                       , COBRANCA
                      -- , PEPINO
                       , ANO
                       , SEMANA
                       , SEMANA2
                       , idsemana
                ```
        }
