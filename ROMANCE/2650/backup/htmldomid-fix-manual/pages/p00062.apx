    pageItem P62_INFORMACOES (
        type: displayOnly
        label {
            label: Informações
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 20
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select   '% de Venda: '||TRIM(to_char(    ( select decode(nvl(sum(fr.vlralvo),0), 0, 0, ((sum(fr.totalgeral)/(sum(fr.vlralvo)*2))*100) ) "Perc Venda"
                                            from fechamentorepresentantes fr
                                            where fr.idfechamento = :P62_IDFECHAMENTO ) , '999G990D00' ) )  
                        ||  '<br> <br> % Despesa: '||      TRIM(to_char( totaldespesas      * 100 /  totalcobranca , '999G990D00' ) ) 
                      --    ||' <br><br> % Debitos em Aberto: '|| TRIM(to_char( round( ( totaldebitosemaberto / ( nvl(totalcobranca,0) + nvl(totaldebitosemaberto,0) ) ) * 100,2 )  , '999G990D00' ) ) 
                        --                                        ||' ( Deb. Em aberto: '||TRIM(to_char( totaldebitosemaberto, '999G999G999G999G990D00' ))||'/ Cobrança: '||TRIM(to_char( totalcobranca, '999G999G999G999G990D00' ))||')'
                
                 ||CASE WHEN totalcobranca > 0 THEN 
                          ' <br><br>% Compra sobre Cobrança: '||     TRIM(to_char(   ( totalmercadorias * 100 / totalcobranca ) , '999G990D00' ) )  
                                                                ||' ( Compra: '||TRIM(to_char( totalmercadorias, '999G999G999G999G990D00' ))||'/ Cobrança: '||TRIM(to_char( totalcobranca, '999G999G999G999G990D00' ))||')'
                                                                          
                          ||' <br><br>% Favorita: '||   TRIM(to_char( totalvendafavorita * 100 /  totalcobranca , '999G990D00' ) )  END
                          
                          ||' <br><br>Ticket Médio Distribuidores: '|| trim(to_char( decode( NrodeAcertosreal , 0  , 0
                                                                                                               , totalcobranca / NrodeAcertosreal )  ,'999G990D00') ) 
                          ||' <br> Ticket Médio Consultora: '|| TRIM(to_char(decode( qtdnotasacertadas , 0  , 0
                                                                                                           , totalcobrancaconsult / qtdnotasacertadas)  , '999G990D00' ) )      
                           
                           
                           perc   
                
                from (
                        select sum(totalvendasdiretas + totalcobranca) totalcobranca  
                             , sum(totalcobranca) totalcobrancaconsult
                             , sum( (totalvendasdiretas + totalcobranca) * f.fatorconversao ) totalcobrancaconvertido
                             ,  ( sum(totaldespesas)  + sum(F.totalcomissoes) ) totaldespesas   
                             , sum(totalvendafavorita) totalvendafavorita
                             , sum(NrodeAcertosreal)  NrodeAcertosreal
                             , sum ( ( select count(1)
                                        from notasvendas nv
                                        where nv.idfilial             = f.idfilial
                                          and nv.idsemanacobranca     = f.idsemana
                                          and nv.idsituacaonotavenda  = 4 ) ) qtdnotasacertadas
                            , sum(f.totalmercadorias    ) totalmercadorias
                            , sum(totaldebitosemaberto) totaldebitosemaberto     
                        from vw_fechamentosdistribuidoras f
                        where f.idfechamento = :P62_IDFECHAMENTO
                    )  A
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P62_VENDADIRETA (
        type: displayOnly
        label {
            label: Venda Direta
            alignment: left
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select sum(pg.valorpago)/*( select pck_romance.fnc_nomepessoa(idpessoa)
                         from funcionarios f
                         where f.idfuncionario = v.idfuncionario ) funcionario
                     , v.semana
                     , pg.valorpago
                     , pg.datapagamento
                     , pg.semanacobranca
                     , pg.usuario*/
                from pagamentosvendasdiretas pg
                   , vendasdiretas v
                where v.idvendadireta = pg.idvendadireta
                  and pg.idfechamento = :P62_IDFECHAMENTO
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

