    }
    help {
        helpText: No help is available for this page.
    }

    region acertos-efetuados (
        name: Acertos Efetuados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select fr.idfechamentorepres
                     , pck_romance.fnc_nomerepresentante(pidrepresentante => fr.idrepresentante) Representante
                     , pck_romance.fnc_nomefilial(pidfilial => fr.idfilial) Filial
                     , fr.setor
                     , pck_romance.fnc_nomeregiaovenda(idregiaovenda) "Região"
                     , fr.semana
                     , fr.qtdnotasnovas
                     , fr.qtdnotaslevou
                     , fr.qtdnotasfechou
                     , fr.vlralvo
                     , fr.totalgeral totalcobranca
                     , fr.totalgeral
                     , fr.vlrespecie
                     , fr.vlrcheque
                     , fr.idcomissao
                     , nvl(fr.vlrcomissao,0) "Vlr Comissão"
                     , fr.observacao
                     , ( select semana from fechamentossemanais ff where ff.idfechamento = fr.idfechamentopontuacao ) "Referente a"
                     , decode(nvl(fr.vlralvo,0), 0, 0, ((fr.totalgeral/(fr.vlralvo*2))*100) ) "Perc Venda"
                     , (select sum(valor) from perdas pp where pp.idfechamentorepres = fr.idfechamentorepres) "Total Resgate"
                     , fr.totalgeral
                     - nvl(fr.vlrespecie,0)
                     - nvl(fr.vlrcheque,0)
                     - ( select NVL(sum(d.valordeposito),0) valor
                         from depositosdiarios_orig d
                         where d.tipo            = 'DD' 
                           and d.idfechamentorepres = fr.idfechamentorepres) 
                     - ( select NVL(sum(d.valordeposito),0) valor
                         from depositosdiarios_orig d
                         where d.tipo            = 'CC' 
                           and d.idfechamentorepres = fr.idfechamentorepres) 
                     - ( select nvl(sum(r.valor),0) valor
                         from despesas r
                         where r.idfechamentorepres = fr.idfechamentorepres )
                     - nvl(fr.vlrcomissao,0)
                     - nvl(fr.totalcomissoesfavoritarepres,0)    
                     - nvl( (select sum(valorpago)
                            from pagamentocomissoes p
                            where p.fechamento = fr.semana
                              and p.idgerente = ( select idgerente
                                                  from gerentes
                                                  where idpessoa = ( select idpessoa
                                                                     from representantes u
                                                                     where u.idrepresentante = fr.idrepresentante ) )  ),0) Saldoapagar
                     , nvl(fr.totalpepinosrecebidos,0) "Débitos Recebidos"
                     , nvl(( select sum(r.valor)
                         from pepinosrepresentantes r
                         where r.idfechamentorepres = fr.idfechamentorepres 
                           and r.idfechamentoreprespago is null),0) "Débitos Novos"
                     , ( select sum(ppp.vlrtotalsemcomissao)
                        from pedidos    ppp
                        where nvl(ppp.pedidorepresentante,'N') = 'N'
                          and ppp.idsemanaemissao = ( select f.idsemana
                                                       from fechamentossemanais f
                                                       where f.idfechamento = fr.idfechamentopontuacao) 
                          and ppp.situacao != 'Z'
                          and ppp.idrepresentante = fr.idrepresentante ) pedidosfeitosfavorita
                     , nvl( ( ( select sum(p.valorcobrado)
                                 from boletos p
                                 where p.idfilial = ( select f.idfilial
                                                     from fechamentossemanais f
                                                     where f.idfechamento = fr.idfechamento) 
                                   and p.situacao != 'Z'
                                   and p.idrepresentante = fr.idrepresentante
                                   and p.idsemanabaixa =   ( select f.idsemana
                                                             from fechamentossemanais f
                                                             where f.idfechamento = fr.idfechamentopontuacao)  )) ,0)  boletosquitados
                from fechamentorepresentantes fr
                where fr.idfechamento = :P62_IDFECHAMENTO
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum acerto efetuado.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 32680855286063032
        }

