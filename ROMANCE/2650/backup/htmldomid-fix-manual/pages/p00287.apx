    dynamicAction tipo-boleto (
        name: tipo boleto
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P287_TIPOPAGAMENTO
        }
        clientSideCondition {
            type: itemIsInList
            item: P287_TIPOPAGAMENTO
            list: [
                B
                M
            ]
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P287_IDCONTABANC
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P287_IDCONTABANC
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

    validation p287-datavencimento (
        name: P287_DATAVENCIMENTO
