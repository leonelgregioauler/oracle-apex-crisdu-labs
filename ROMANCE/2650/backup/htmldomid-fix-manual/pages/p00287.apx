    pageItem P287_IDCONTABANC (
        type: selectList
        label {
            label: Conta para Depósito
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                   , notasfiscais nf
                where cb.idbanco      = b.idbanco
                  and cb.idfornecedor = f.idfornecedor
                  and f.idpessoa      = p.idpessoa
                  and cb.idfornecedor = nf.idfornemitente
                  and cb.ativo        = 'S'
                  and nf.idnotafiscal = :P287_IDNOTAFISCAL
                union
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                   , notasfiscais nf
                where cb.idbanco      = b.idbanco
                  and cb.idfornecedor = f.idfornecedor
                  and f.idpessoa      = p.idpessoa
                  and cb.idfornecedor = nf.idfornecedordestino
                  and cb.ativo        = 'S'
                  and nf.idnotafiscal = :P287_IDNOTAFISCAL
                order by 1
                ```
        }
        layout {
            sequence: 90
            region: @vencimentos-da-nf
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTABANC
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

