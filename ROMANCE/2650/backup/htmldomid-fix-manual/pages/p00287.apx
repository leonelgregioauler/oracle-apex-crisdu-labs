        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 604747407620714121
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P287_IDVENCIMENTO
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidfilial     number := pck_romance.fnc_filialusuario(v('APP_USER'));
                  vidnota      number; 
                  --
                begin
                  --
                  select seq_idnotafiscal.nextval
                  into vidnota
                  from dual;
                  --
                  insert into notasfiscais ( IDNOTAFISCAL     , IDFORNEMITENTE          , TIPOEMITENTE
                                           , IDFILIALDESTINO  , IDTRANSPORTADORA        , DTNF
                                           , USUARIO          , VALORTOTAL              , NRNF
                                           , IDFILIALEMITENTE , VOLUMES                 , SITUACAO
                                           , DOCUMENTO        , IDCONTABANCARIA         , VLRDESCONTO
                                           , VALORLIQUIDO     , VALORFRETE              , TIPONOTA
                                           , SITUACAOFILIAL   , DATALIBERADO            , DATARECEBIMENTO
                                           , EMAILRECEBIMENTO , CONHECIMENTOTRANSPORTE  , OBSERVACAO
                                           , IDPEDIDOCOMPRA   , DATAINCLUSAO            , NFE
                                           , VALORCONTABIL    , IDNOTAFISCALCOMPRA      , IDFORNECEDORDESTINO
                                           , ABATIMENTOCONFIRMADO  , SEMANANOTA    , VALORRECEBER
                                           , PERCJUROS )
                  values ( vidnota           , null    , 'FIL'
                         , vidfilial         , 44      , sysdate
                         , v('APP_USER')     , null    , null
                         , 240               , ''      , 'P'
                         , vidnota           , null    , null
                         , null              , null    , 'C'
                         , 'A'               , null    , null
                         , ''                , ''      , :P287_OBSERVACAO
                         , null              , sysdate , ''
                         , null              , null    , null
                         , ''                , sysdate , null
                         , null);
                  --
                  insert into itemnf ( IDITNF              , IDNOTAFISCAL     , IDPRODUTO
                                     , CUSTOUND            , QTD_U            , OBSERVACAO)
                  values ( seq_iditemnfroman.nextval   , vidnota          , 5634
                         , 1                           , to_number(:P287_VALOR) ,'automatico' );
                  --
                  select SEQ_IDVENCIMENTOS.nextval 
                  into :P287_IDVENCIMENTO 
                  from dual; 
                  --
                  :P287_IDNOTAFISCAL := vidnota;
                  --
                  declare
                    vemail varchar2(100);
                  begin
                    --
                    catal.pck_util.prc_enviaemail(ppara =>  'tatiana@romancemoda.com.br'
                                                 ,pcopia =>  'michele.zimpel@crisdu.com.br'
                                                 --  ,pcopia =>  'adriana@romancemoda.com.br'
                                                 , pcopiaoculta => 'bruna@romancemoda.com.br',
                                                  passunto => '[Aviso automático] Reserva pendente de aprovação',
                                                  ptexto => 'Olá,<br>'||
                                                            'O usuário '||initcap(v('APP_USER'))||' acabou de enviar uma reserva para aprovação.<br><br>'||
                                                            :P287_DATAVENCIMENTO||' - R$ '||:P287_VALOR||' <br>'||
                                                            :P287_OBSERVACAO||'<br>'||'<br>'||
                                                            'Atenciosamente,<br>'||      
                                                            'Tecnologia da Informação<br>'||       
                                                            'Romance Moda<br>'||       
                                                            'Fone: 51 8281 0011<br>'||      
                                                            'www.romancemoda.com.br<br>'||     
                                                            'www.atacadofavorita.com.br'  );
                  end;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 604747607684714134
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-vencimentos (
        name: Process Row of VENCIMENTOS
