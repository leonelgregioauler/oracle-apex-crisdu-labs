    region lista-de-vencimentos (
        name: Lista de Vencimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.dias
                     , v.datavencimento
                     , v.valor 
                     , initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' conta
                     , v.idvencimento
                     , decode(v.tipopagamento, 'D','Depósito','B','Boleto','E','Empréstimo','M','Em mãos','Não informado') "Tipo Pagamento"
                     , v.observacao "Observação"
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                   , notasfiscais nf
                   , vencimentos  v
                where v.idnotafiscal  = nf.idnotafiscal
                  and cb.idbanco      = b.idbanco
                  and cb.idfornecedor = f.idfornecedor
                  and f.idpessoa      = p.idpessoa
                  and cb.idfornecedor = nf.idfornemitente
                  and v.idcontabanc   = cb.idcontabanc
                  and nf.idnotafiscal = :P287_IDNOTAFISCALP
                union
                select v.dias
                     , v.datavencimento
                     , v.valor 
                     , initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' conta
                     , v.idvencimento
                     , decode(v.tipopagamento, 'D','Depósito','B','Boleto','E','Empréstimo','M','Em mãos','Não informado') "Tipo Pagamento"
                     , v.observacao "Observação"
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                   , notasfiscais nf
                   , vencimentos  v
                where v.idnotafiscal  = nf.idnotafiscal
                  and cb.idbanco      = b.idbanco
                  and cb.idfornecedor = f.idfornecedor
                  and f.idpessoa      = p.idpessoa
                  and cb.idfornecedor = nf.idfornecedordestino
                  and v.idcontabanc   = cb.idcontabanc
                  and nf.idnotafiscal = :P287_IDNOTAFISCALP
                union
                select v.dias
                     , v.datavencimento
                     , v.valor 
                     , null conta
                     , v.idvencimento
                     , decode(v.tipopagamento, 'D','Depósito','B','Boleto','E','Empréstimo','M','Em mãos','Não informado') "Tipo Pagamento"
                     , v.observacao "Observação"
                from notasfiscais nf
                   , vencimentos  v
                where v.idnotafiscal  = nf.idnotafiscal
                  and v.idcontabanc  is null
                  and nf.idnotafiscal = :P287_IDNOTAFISCALP
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
