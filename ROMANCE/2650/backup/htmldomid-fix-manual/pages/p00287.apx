    validation p287-dias (
        name: P287_DIAS
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P287_DIAS is not null or :P287_DATAVENCIMENTO is not null
                ```
        }
        error {
            errorMessage: Deve ser informado o número de dias ou a data do vencto
            displayLocation: inlineInNotification
            associatedItem: @P287_DIAS
        }
    )

    validation p287-idcontabanc (
        name: P287_IDCONTABANC
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P287_IDCONTABANC
        }
        error {
            errorMessage: #LABEL# deve ser informada!
            displayLocation: inlineInNotification
            associatedItem: @P287_IDCONTABANC
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P287_TIPOPAGAMENTO not in ( 'B','M')
                ```
        }
    )

    validation p287-valor (
