page 56 (
    name: Lista de Acertos Efetuados
    title: Lista de Acertos Efetuados
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region lista-de-fechamentos-efetuados (
        name: Lista de Fechamentos Efetuados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select fr.idfechamentorepres
                     , pck_romance.fnc_nomerepresentante(fr.idrepresentante) Representante
                     , pck_romance.fnc_nomefilial(fr.idfilial) Filial
                     , fr.setor
                     , ( select rv.descricao from regioesvenda rv where idregiaovenda = fr.idregiaovenda ) "Região"
                     , fr.semana
                     , fr.qtdnotasnovas
                     , fr.qtdnotaslevou
                     , fr.qtdnotasfechou
                     , fr.vlralvo
                     , fr.totalcobranca
                     , fr.totalgeral
                     , fr.vlrespecie
                     , fr.vlrcheque
                     , fr.idcomissao
                     , ( select semana from fechamentossemanais ff where ff.idfechamento = fr.idfechamentopontuacao ) "Referente a"
                     , ((fr.totalgeral/(decode(nvl(fr.vlralvo,0) ,0 ,1 ,fr.vlralvo) *2))*100) "Perc Venda"
                     --, ( select l.vlracumulado from lucratividade l where l.idfechamentorepres = fr.idfechamentorepres ) "Lucratividade (Acumulado)"
                     , (select sum(valor) from perdas pp where pp.idfechamentorepres = fr.idfechamentorepres) "Total Resgate"
                     , fr.totalgeral
                     - nvl(fr.vlrespecie,0)
                     - nvl(fr.vlrcheque,0)
                     - ( select NVL(sum(d.valordeposito),0) valor
                         from depositosdiarios_orig d
                         where d.tipo            = 'DD' 
                           and d.idfechamentorepres = fr.idfechamentorepres) 
                     - ( select NVL(sum(d.valordeposito),0) valor
                         from depositosdiarios_orig d
                         where d.tipo            = 'CC' 
                           and d.idfechamentorepres = fr.idfechamentorepres) 
                     - ( select nvl(sum(r.valor),0) valor
                         from despesas r
                         where r.idfechamentorepres = fr.idfechamentorepres )
                     - nvl(fr.vlrcomissao,0)
                     - nvl(fr.totalcomissoesfavoritarepres,0) Saldoapagar
                     , fr.saldo "Saldo Atual"
                from fechamentorepresentantes fr
                where fr.idfechamento = :P56_IDFECHAMENTO
                  and exists ( select 1
                               from dual 
                               where pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S' )
                   or pck_romance.fnc_filialusuario( v('APP_USER') ) = fr.idfilial
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        link {
            linkColumn: customTarget
            target: {
                page: 57
                items: {
                    P57_IDFECHAMENTOREPRES: #IDFECHAMENTOREPRES#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum acerto efetuado.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column FILIAL (
            type: plainText
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 16
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: FILIAL
                endUserAlias: P
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDCOMISSAO (
            type: hidden
            heading {
                heading: Comissão
            }
            layout {
                sequence: 14
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDCOMISSAO
                endUserAlias: N
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from dual 
                    where pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S'
                      or exists ( select 1 
                                  from gerentes g
                                  where g.idpessoa = ( select u.idpessoa 
                                                       from usuarios u
                                                       where u.usuario = v('APP_USER') ) ) 
                    ```
            }
            security {
                escapeSpecialChars: false
            }
        )

