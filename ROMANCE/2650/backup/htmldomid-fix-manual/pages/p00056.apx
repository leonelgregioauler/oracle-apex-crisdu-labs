    pageItem P56_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @lista-de-fechamentos-efetuados
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P56_SEMANA (
        type: hidden
        layout {
            sequence: 10
            region: @lista-de-fechamentos-efetuados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Novo Acerto
        layout {
            sequence: 30
            region: @lista-de-fechamentos-efetuados
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 57
                items: {
                    P57_SEMANA: &P56_SEMANA.
                    P57_IDFECHAMENTO: &P56_IDFECHAMENTO.
                }
                clearCache: 57
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where  ( (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S')
                       or (nvl(f.concluido,'N') = 'N'
                  and f.idfechamento = :P56_IDFECHAMENTO))
                ```
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 5
            region: @lista-de-fechamentos-efetuados
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 73
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

