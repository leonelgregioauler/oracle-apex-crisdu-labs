        savedReport 15500 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn FILIAL (
                sequence: 1
            )

            displayColumn "Perc Venda" (
                sequence: 6
            )

            displayColumn QTDNOTASNOVAS (
                sequence: 7
            )

            displayColumn REPRESENTANTE (
                sequence: 2
            )

            displayColumn "Referente a" (
                sequence: 4
            )

            displayColumn "Região" (
                sequence: 5
            )

            displayColumn SALDOAPAGAR (
                sequence: 9
            )

            displayColumn SEMANA (
                sequence: 3
            )

            displayColumn "Saldo Atual" (
                sequence: 10
            )

            displayColumn TOTALGERAL (
                sequence: 8
            )

            sort (
                column: REPRESENTANTE
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: TOTALGERAL
            )

            controlBreak (
                column: FILIAL
                layout {
                    sequence: 1
                }
            )

            highlight ir-condition (
                name: % Baixa
                condition {
                    column: "Perc Venda"
                    operator: <
                    value: 35
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #FC0000
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-2 (
                name: % Boa
                condition {
                    column: "Perc Venda"
                    operator: >=
                    value: 35
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #006300
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-3 (
                name: Notas Baixas
                condition {
                    column: QTDNOTASNOVAS
                    operator: <
                    value: 30
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #FC0000
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-4 (
                name: Notas Boas
                condition {
                    column: QTDNOTASNOVAS
                    operator: >=
                    value: 30
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #006300
                }
                execution {
                    sequence: 10
                }
            )

        )

