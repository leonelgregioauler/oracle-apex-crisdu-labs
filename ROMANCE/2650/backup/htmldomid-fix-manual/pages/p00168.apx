page 168 (
    name: Relatório para Pagamentos Clientes
    title: Relatório para Pagamentos Clientes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region relatório-para-pagamentos-clientes (
        name: Relatório para Pagamentos Clientes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select razaosocial 
                ||', '|| endereco
                ||', '|| bairro
                ||' - '||cep
                ||' - '||( select nomecidade||' - '||sigla from cidades c, estados e where c.idestado = e.idestado and c.idcidade = m.idcidade) 
                ||' ['|| m.cnpj||'] ' "MEI"
                , m.idmei 
                , nvl(( select sum(pp.valorpago) from pagamentosmei pp where pp.idmei = m.idmei and to_char(pp.datapagamento,'RRRR') = to_char(sysdate,'RRRR') ),0) "Valor Pago"
                , 50000 - nvl(( select sum(pp.valorpago) from pagamentosmei pp where pp.idmei = m.idmei and to_char(pp.datapagamento,'RRRR') = to_char(sysdate,'RRRR') ),0) "Saldo para utilizar"
                from mei m
                where 50000 - nvl(( select sum(pp.valorpago) from pagamentosmei pp where pp.idmei = m.idmei and to_char(pp.datapagamento,'RRRR') = to_char(sysdate,'RRRR') ),0) > 0
                  and exists ( select 1
                               from pessoas p
                               where p.idpessoa = m.idpessoa
                                 and p.ativo = 'S')
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        link {
            linkColumn: customTarget
            target: {
                page: 173
                items: {
                    P173_IDMEI: #IDMEI#
                    P173_IDPAGAMENTOMEI:
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column IDMEI (
            type: plainText
            heading {
                heading: Idmei
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDMEI
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column MEI (
            type: plainText
            heading {
                heading: Mei
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: MEI
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Saldo para utilizar" (
            type: plainText
            heading {
                heading: Saldo Para Utilizar
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: Saldo para utilizar
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Valor Pago" (
            type: plainText
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: Valor Pago
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 1310382 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn MEI (
                sequence: 1
            )

            displayColumn "Saldo para utilizar" (
                sequence: 3
            )

            displayColumn "Valor Pago" (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 30
            region: @relatório-para-pagamentos-clientes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 170
                clearCache: 170
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

)

