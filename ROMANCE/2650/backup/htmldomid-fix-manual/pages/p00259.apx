    region lista-de-saídas-diversas (
        name: Lista de Saídas Diversas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idsaida
                     , e.idfilial
                     , initcap(nvl(p.apelido,p.nomepessoa)) "Filial Destino"
                     , e.semana
                     , e.data
                     , e.fechamentoorig
                     , e.valortotal
                     , e.descricao
                     , ( select ff.semana from fechamentossemanais ff where ff.idfechamento = e.idfechamento ) "Fechamento"
                     , decode(e.tipo, 'D', 'Dinheiro', 'O','Pagamento de Conta') "Tipo"
                from saidasdiversas e
                   , filiais          f
                   , pessoas          p
                where e.idfilialdest = f.idfilial(+)
                  and f.idpessoa     = p.idpessoa
                 -- and e.idfechamento is null
                  and e.idfilial     = (select f.idfilial 
                                        from filiais    f
                                           , pessoas    p
                                           , usuarios   u
                                           , gerentes   g
                                        where f.idpessoa  = p.idpessoa
                                          and g.idfilial  = f.idfilial
                                          and u.idgerente = g.idgerente
                                          and u.usuario   = V('APP_USER'))
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        link {
            linkColumn: customTarget
            target: {
                page: 102
                items: {
                    P102_IDSAIDA: #IDSAIDA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
