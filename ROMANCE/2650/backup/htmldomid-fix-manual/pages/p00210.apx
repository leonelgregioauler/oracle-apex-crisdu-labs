    region abatimentos-v (
        name: Abatimentos v1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null editar
                     , ( select pck_romance.fnc_nomefornecedor(nc.idfornemitente)
                         from notasfiscais nc
                         where nc.idnotafiscal = nv.idnotafiscalcompra ) "Fornecedor"
                     , pck_romance.fnc_nomefornecedor(nv.idfornecedordestino) "Cliente"
                     , nv.idfornecedordestino idfornecedorcliente
                     , nv.documento
                     , vr.datavencimento
                     , vr.valor
                     , ( select documento 
                         from notasfiscais nc2 
                         where nc2.idnotafiscal = pf.idnotafiscal ) "Nota Abatida"
                     , pf.dtvencimento "Vencto Nota Abatida"
                     , pck_romance.fnc_nomefornecedor(pf.idfornecedor) "Depositar para"
                     , nv.idnotafiscal
                     , pf.idpgtoforn
                     , to_char(dd.data,'IW/RRRR') semana
                     , trunc(dd.data) data
                     , decode(vr.abatimentoconfirmado,'S','Sim','Não') abatimentoconfirmado
                     , vr.idvencimento
                     , dd.idfilialfornecedor
                     , nv.idfornecedordestino cliente
                     , to_char(dd.data, 'Month') "Mês Pgto"
                     , to_char(vr.datavencimento, 'Month') "Mês Vcto"
                     , to_char(vr.datavencimento, 'RRRR') "Ano Vcto"
                     , nv.observacao
                from notasfiscais nv 
                   , vencimentosreceber vr
                   , depositosdiarios dd
                   , pagamentosfornecedores pf
                where nv.tiponota = 'V'
                  and nv.idnotafiscal     = vr.idnotafiscal
                  and vr.idvencimento     = dd.idvencimentoabatimento(+) 
                  and dd.idpgtoforn       = pf.idpgtoforn(+)
                  and not exists ( select 1
                                   from depositosdiarios_orig   d                      
                                      , extratoscontasbancarias e
                                   where d.iddepositodiarios      = e.iddepositodiario_orig
                                     and d.idvencimentoabatimento = vr.idvencimento )
                  and (( pck_romance.fnc_filialusuario(v('APP_USER')) = 1061 
                         and exists ( select 1
                                       from notasfiscais nc
                                       where nc.idnotafiscal = nv.idnotafiscalcompra 
                                         and nc.idfornemitente = PCK_ROMANCE.fnc_fornecedorfilial(pck_romance.fnc_filialusuario(v('APP_USER'))))) 
                    or (NVL(pck_romance.fnc_filialusuario(v('APP_USER')),1) != 1061))
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
