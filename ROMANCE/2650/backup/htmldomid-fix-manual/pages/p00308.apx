    pageItem P308_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(idfornecedor) display_value
                     , fe.idpessoa return_value
                from fornecedores fe
                where fe.ativo = 'S'
                  and exists ( select 1
                                from notasfiscais nv 
                                   , vencimentosreceber vr
                                   , depositosdiarios_orig dd
                                where nv.tiponota = 'V'
                                  and nv.idnotafiscal     = vr.idnotafiscal
                                  and vr.idvencimento     = dd.idvencimentoabatimento(+)  
                                  and nv.idfornecedordestino = fe.idfornecedor
                                  and not exists ( select 1
                                                   from depositosdiarios d
                                                   where d.idvencimentoabatimento = vr.idvencimento ) )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todos -"
        }
        layout {
            sequence: 10
            region: @abatimentos-v
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        security {
            encryptSessionState: false
        }
    )

    button processar-abatimentos (
        buttonName: PROCESSAR_ABATIMENTOS
        label: Processar Abatimentos
        layout {
            sequence: 10
            region: @abatimentos-v
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction confirma (
        name: Confirma
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @processar-abatimentos
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma o abatimento deste fornecedor?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: PROCESSAR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction onchange (
        name: onChange
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P308_IDFORNECEDOR
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process rodar-abatimentos (
        name: Rodar Abatimentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_financeiro_rmc.prc_abate_clientefornecedor(:P308_IDFORNECEDOR);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo concluído!
        }
        advanced {
            executionMappingIdentifier: 3459781468765865112
        }
        serverSideCondition {
            type: request=Value
            value: PROCESSAR
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 308
                items: {
                    P308_IDFORNECEDOR: &P308_IDFORNECEDOR.
                }
                action: resetPagination
            }
        }
    )

)

