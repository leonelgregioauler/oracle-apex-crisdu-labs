    region abatimentos-v (
        name: Abatimentos v2
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                --Adicionado ligação com matrizregrasreceitas para apontar conta e subconta atendendo ticket 9437810 da Débora. 
                select null editar
                     , ( select pck_romance.fnc_nomefornecedor(nc.idfornemitente)
                         from notasfiscais nc
                         where nc.idnotafiscal = nv.idnotafiscalcompra ) "Fornecedor"
                     , roman.pck_romance.fnc_nomefornecedor(nv.idfornecedordestino) "Cliente"
                     , nv.idfornecedordestino idfornecedorcliente
                    -- , roman.pck_romance.fnc_nomecontafinan(m.idcontafinan) ||' / '|| roman.pck_romance.fnc_nomesubcontafinan(m.idsubcontafinan) contasub
                     , roman.pck_romance.fnc_nomecontafinan(m.idcontafinan) conta
                     , roman.pck_romance.fnc_nomesubcontafinan(m.idsubcontafinan) sub
                     , nv.documento documento
                     , vr.datavencimento
                     , vr.valor
                     , pck_cadastros_rmc.fnc_retornacontabancaria(dd.idcontabanc) contabancaria
                     , pck_romance.fnc_nomefornecedor(nv.idfornemitente) "Depositar para"
                     , nv.idnotafiscal
                     , to_char(dd.data,'IW/RRRR') semana
                     , trunc(dd.data) data
                     , decode(vr.abatimentoconfirmado,'S','Sim','Não') abatimentoconfirmado
                     , vr.idvencimento
                     , nv.idfornecedordestino cliente
                     , to_char(dd.data, 'Month') "Mês Pgto"
                     , to_char(vr.datavencimento, 'Month') "Mês Vcto"
                     , to_char(vr.datavencimento, 'RRRR') "Ano Vcto"
                     , nv.observacao
                     , nv.dtnf  emissao
                     , dd.dataprocessado
                from roman.notasfiscais nv 
                   , roman.vencimentosreceber vr
                   , roman.depositosdiarios_orig dd
                   , roman.matrizregrasreceitas m
                where nv.tiponota = 'V'
                  and nv.idnotafiscal = vr.idnotafiscal
                  and vr.idvencimento = dd.idvencimentoabatimento(+)    
                  and m.idfornecedorcliente = nv.idfornecedordestino
                  and m.idmatrizregrareceita = vr.idmatrizregrareceita
                  and nv.transferenciaentrefiliaisrom = 'N'
                  and nv.idcompratransferencia is null
                  and not exists ( select 1
                                   from depositosdiarios d
                                   where d.idvencimentoabatimento = vr.idvencimento )
                  and ( :P308_IDFORNECEDOR is null or exists ( select 1
                                                               from contasbancarias c
                                                                  , fornecedores f
                                                               where c.idpessoa    = f.idpessoa
                                                                 and f.idfornecedor = nv.idfornecedordestino
                                                                 and c.idpessoa    = :P308_IDFORNECEDOR))
                ```
        }
