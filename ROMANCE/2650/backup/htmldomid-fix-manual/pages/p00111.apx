page 111 (
    name: Pedido de Compra
    title: Pedido de Compra
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region pedido-de-compra (
        name: Pedido de Compra
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedidocompra
                     , p.idfornecedor
                     , pck_romance.fnc_nomefornecedor(idfornecedor) Fornecedor
                     , p.idpedidocompra nrdocumento
                     , p.datapedido
                     , p.volumes
                     , decode(p.situacao, 'I','Incluído'
                                        , 'P','Parcial'
                                        , 'C','Cancelado'
                                        ,'-') situacao
                     , p.vlrdesconto
                     , p.valorliquido
                     , p.valorfrete
                     , p.valortotal
                     , decode(p.tipofrete,'CIF','Emitente','FOB','Destinatário') "Tipo Frete"
                     , p.observacao "Observação"
                     , pck_util.fnc_semanaid(p.idsemana) "Semana Disp."
                     , usuario "Usuário"
                from pedidoscompras  p
                 
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 112
                items: {
                    P112_IDPEDIDOCOMPRA: #IDPEDIDOCOMPRA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

