    )

    button create (
        buttonName: CREATE
        label: Novo Pedido
        layout {
            sequence: 30
            region: @pedido-de-compra
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 112
                clearCache: 112
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

