    dynamicAction cnpj (
        name: CNPJ
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P7_TIPOCONSULTA
        }
        clientSideCondition {
            type: item=value
            item: P7_TIPOCONSULTA
            value: J
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P7_CNPJBUSCA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P7_CNPJBUSCA
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction cpf (
        name: CPF
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P7_TIPOCONSULTA
        }
        clientSideCondition {
            type: item=value
            item: P7_TIPOCONSULTA
            value: F
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P7_CPF
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P7_CPF
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction onchange (
        name: OnChange
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P7_CNPJ
                P7_FILTRO
            ]
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-cpf (
        name: Valida CPF
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( 
                                select idpessoa
                                from pessoas
                                where replace(replace(cpf,'.',''),'-','') = replace(replace(:P7_CPF,'.',''),'-','') )
                ```
        }
        error {
            errorMessage: Cadastro não localizado!
            associatedItem: @P7_CPF
        }
        serverSideCondition {
            whenButtonPressed: @buscar
            type: never
        }
    )

    process busca-id (
        name: Busca ID
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  select idpessoa
                  into :P7_IDPESSOA
                  from pessoas p
                  where  nvl(p.cpf,p.cnpj) = replace(replace(replace(nvl(:P7_CPF,:P7_CNPJBUSCA),'.',''),'-',''),'/','');
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 4996187273104106610
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

    process todos (
        name: Todos
        type: executeCode
        source {
            plsqlCode: :P7_FILTRO := NVL(:P7_FILTRO,'Z')
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1438907237004427005
        }
    )

    branch (
        name: redireciona
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 7
                items: {
                    P7_CNPJ: &P7_CNPJ.
                    P7_FILTRO: &P7_FILTRO.
                }
                action: resetPagination
            }
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 8
                items: {
                    P8_IDPESSOA: &P7_IDPESSOA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

