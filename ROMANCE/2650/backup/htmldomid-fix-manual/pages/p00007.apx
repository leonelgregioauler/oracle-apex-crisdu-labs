        savedReport 13798 (
            visibility: primaryDefault
            view {
                rowsPerPage: 1
            }

            displayColumn CAIXAATIVO (
                sequence: 9
            )

            displayColumn CHAVEPIX (
                sequence: 10
            )

            displayColumn CNPJ (
                sequence: 4
            )

            displayColumn CODIGOVIRTUALAGE (
                sequence: 11
            )

            displayColumn EMAIL (
                sequence: 3
            )

            displayColumn NOMECIDADE (
                sequence: 6
            )

            displayColumn NOMEPESSOA (
                sequence: 2
            )

            displayColumn "Nome Abreviado" (
                sequence: 1
            )

            displayColumn TIPO_FORNECEDOR (
                sequence: 5
            )

            displayColumn "Tipo Filial" (
                sequence: 8
            )

            displayColumn UNIDADEDENEGOCIO (
                sequence: 7
            )

            sort (
                column: "Nome Abreviado"
                sort {
                    sequence: 1
                }
            )

            sort (
                column: FILIAL
                sort {
                    nulls: last
                    sequence: 2
                }
            )

        )

        savedReport 5879127 (
            visibility: alternativeDefault
            name: Filiais
            view {
                rowsPerPage: 200
            }

            displayColumn CAIXAATIVO (
                sequence: 5
            )

            displayColumn EMAIL (
                sequence: 3
            )

            displayColumn NOMEPESSOA (
                sequence: 2
            )

            displayColumn "Nome Abreviado" (
                sequence: 1
            )

            displayColumn UNIDADEDENEGOCIO (
                sequence: 4
            )

            sort (
                column: "Nome Abreviado"
                sort {
                    sequence: 1
                }
            )

            sort (
                column: FILIAL
                sort {
                    nulls: last
                    sequence: 2
                }
            )

            filter ir-condition (
                column: "Filial"
                value: Sim
            )

        )

        savedReport 5879137 (
            visibility: alternativeDefault
            name: Fornecedores
            view {
                rowsPerPage: 200
            }

            displayColumn CAIXAATIVO (
