            )

            displayColumn EMAIL (
                sequence: 3
            )

            displayColumn "Filial" (
                sequence: 4
            )

            displayColumn "Fornecedor" (
                sequence: 5
            )

            displayColumn NOMEPESSOA (
                sequence: 2
            )

            displayColumn "Nome Abreviado" (
                sequence: 1
            )

            displayColumn "Transportadora" (
                sequence: 6
            )

            displayColumn UNIDADEDENEGOCIO (
                sequence: 7
            )

            sort (
                column: "Nome Abreviado"
                sort {
                    sequence: 1
                }
            )

            sort (
                column: FILIAL
                sort {
                    nulls: last
                    sequence: 2
                }
            )

            filter ir-condition (
                column: "Fornecedor"
                value: Sim
            )

        )

    )

