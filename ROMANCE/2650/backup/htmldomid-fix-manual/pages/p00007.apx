page 7 (
    name: Lista de Pessoas
    title: Lista de Pessoas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region buscar-cadastro (
        name: Buscar Cadastro
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size480x320
            ]
        }
        advanced {
            htmlDomId: BUSCAR
            regionDisplaySelector: true
        }
    )

    region lista-de-pessoas (
        name: Lista de Pessoas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ FIRST_ROWS(50) */ distinct(p.idpessoa)
                     , decode(p.ativo, 'S','Sim','Não') "Pessoa Ativa"
                     , nvl(( select distinct 'Sim' from representantes f where f.idpessoa = p.idpessoa and f.ativo = 'S') ,'Não') "Representante Ativo"
                     , nvl(( select distinct 'Sim' from filiais f where f.idpessoa = p.idpessoa) ,'Não') "Filial"
                     , nvl(( select distinct 'Sim' from gerentes f where f.idpessoa = p.idpessoa) ,'Não') "Gerente"
                     , nvl(( select distinct 'Sim' from representantes f where f.idpessoa = p.idpessoa) ,'Não') "Representante"
                     , nvl(( select distinct 'Sim' from vendedoras f where f.idpessoa = p.idpessoa ),'Não') "Vendedora"
                     , nvl(( select distinct 'Sim' from secretarias f where f.idpessoa = p.idpessoa) ,'Não') "Secretária"
                     , nvl(( select distinct 'Sim' from fornecedores f where f.idpessoa = p.idpessoa ),'Não') "Fornecedor"
                     , nvl(( select distinct 'Sim' from transportadoras f where f.idpessoa = p.idpessoa) ,'Não') "Transportadora"
                     , nvl(( select distinct 'Sim' from usuarios f where f.idpessoa = p.idpessoa ),'Não') "Usuário"
                     , nvl(( select distinct 'Sim' from mei m where m.idpessoa = p.idpessoa ),'Não') "MEI"
                     , initcap(p.nomepessoa) nomepessoa
                     , initcap(p.apelido) "Nome Abreviado"
                     , p.cpf CPF
                     , p.cnpj CNPJ
                  --   , p.telefoneprinc
                  --   , p.telefonesecund
                     , initcap(p.enderecoprincipal) enderecoprincipal    
                     , initcap(p.enderecosecundario) enderecosecundario
                     , pck_romance.fnc_nomecidade(p.idcidade) nomecidade
                     , lower(p.email) email
                     , datanascimento
                     , ( select decode(f.tipofilial, 'C','Catalogo','D','Distribuidora','F','Fábrica','O','Outro','P','Parceira Favorita') 
                         from filiais f 
                         where f.idpessoa = p.idpessoa) "Tipo Filial"/*
                     , nvl(( select initcap(pg.nomepessoa)
                             from pessoas pg
                                , gerentes g
                                , representantes  r
                             where pg.idpessoa = g.idpessoa
                               and g.idgerente = r.idgerente 
                               and r.idpessoa   = p.idpessoa),null) gerente*/
                     , ( select initcap(nvl(pf.apelido,pf.nomepessoa))
                         from pessoas pf
                         where pf.idpessoa = ( select f.idpessoa
                                               from filiais f
                                               where f.idfilial = ( select g.idfilial       
                                                                    from gerentes  g
                                                                    where g.idgerente = ( select r.idgerente
                                                                                          from representantes r
                                                                                          where r.idpessoa    = p.idpessoa)))) filial
                     , ( select u.nome
                         from unidadesdenegocios u
                            , filiais ff
                         where u.idunidadedenegocio = ff.idunidadedenegocio
                           and ff.idpessoa          = p.idpessoa ) unidadedenegocio
                     , case
                         when :P7_FILTRO = 'F' then
                           nvl( ( select 'Sim'
                                  from dual
                                  where exists ( select 1
                                                 from fechamentossemanais fs
                                                    , filiais ff
                                                 where ff.idpessoa = p.idpessoa
                                                   and ff.idfilial = fs.idfilial
                                                   and fs.concluido = 'N' ) ),'Não')
                         else
                           'Não'
                       end caixaativo
                     , nvl( ( select 'Sim'
                              from dual
                              where exists ( select 1
                                             from chavespix c
                                             where c.idpessoa = p.idpessoa ) ),'Não' ) chavepix
                    , rf.codigovirtualage
                    --, decode(fo.tipo_fornecedor,'INT','Interno','EXT','Externo') tipo_fornecedor 
                    , (select descricao from table(catal.pck_util.fnc_siglasistema('TIPO_FORNECEDOR',fo.tipo_fornecedor))) tipo_fornecedor
                from pessoas p
                   , catal.fornecedores fo
                   , roman.razoessociaisfornec rf
                where fo.idpessoa = p.idpessoa
                  and fo.idfornecedor = rf.idfornecedor(+)
                  and ( (:P7_FILTRO = 'F' and exists ( select 1 from filiais f where p.idpessoa = f.idpessoa))
                     or (:P7_FILTRO = 'O' and exists ( select 1 from fornecedores f where p.idpessoa = f.idpessoa))
                     or (:P7_FILTRO = 'C' and exists ( select 1 from representantes f where p.idpessoa = f.idpessoa))
                     or (:P7_FILTRO = 'T' and exists ( select 1 from transportadoras t where p.idpessoa = t.idpessoa))
                     or :P7_FILTRO = 'Z' )
                  and ( :P7_CNPJ is null or ( exists ( select 1
                                                       from razoessociaisfiliais rc
                                                          , filiais              ff
                                                       where rc.idfilial = ff.idfilial
                                                         and ff.idpessoa = p.idpessoa 
                                                         and rc.cnpj     = :P7_CNPJ )
                                           or p.cnpj  = :P7_CNPJ
                                           or exists ( select 1
                                                       from razoessociaisfornec rc
                                                          , fornecedores        fc
                                                       where fc.idfornecedor  = rc.idfornecedor
                                                         and fc.idpessoa = p.idpessoa 
                                                         and REGEXP_REPLACE(rc.cnpj,'[./-]','') = REGEXP_REPLACE(:P7_CNPJ,'[./-]','') ) ) )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 8
                items: {
                    P8_IDPESSOA: #IDPESSOA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than 10,000 rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

