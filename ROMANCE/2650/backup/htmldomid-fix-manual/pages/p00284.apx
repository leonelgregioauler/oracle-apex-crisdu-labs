    pageItem P284_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: right
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome display_value
                     , idfilial return_value
                from vw_filiais
                where tipofilial = 'D'
                  and ativo = 'S'
                order by 1
                ```
            nullDisplayValue: - Selecione a Filial -
        }
        layout {
            sequence: 10
            slot: legacyOrphanComponents
        }
