    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function abreconta ( pid )
             {
               window.open('f?p=&APP_ID.:159:&SESSION.::&DEBUG.::P159_IDPGTOFORN:'+pid, 'telaconta', 'status = 1, height = 400, width = 1000, resizable = 0');
               void(0);
             }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region demonstrativo-semanal-de-despesas (
        name: Demonstrativo Semanal de Despesas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(d.idfilial )  Filial
                     , ( select f.semana from fechamentossemanais f where f.idfechamento = d.idfechamento ) Semana
                  --   , decode( d.iddespesa, null, '', '<a href="f?p=&APP_ID.:82:&SESSION.::&DEBUG.::P82_IDFECHAMENTO,P82_SEMANA,P82_IDDESPESA:'||d.idfechamento||','||
                  --                 ( select f.semana
                  --                   from fechamentossemanais f 
                  --                   where f.idfechamento = d.idfechamento )||','||d.iddespesa||'"><img src="#IMAGE_PREFIX#menu/pencil2_16x16.gif" alt="Editar Despesa"></a>') idfechamento
                     , ( select initcap(nomeconta)
                         from contasfinanceiras c
                         where c.idcontafinan = d.idcontacontabil ) Conta
                     , ( select initcap(nomeconta)
                         from subcontasfinanceiras cc
                         where cc.idsubcontafinan = d.idsubcontacontabil ) subConta
                     , d.observacao
                     , d.valor
                     , d.iddespesa
                     , trunc(d.datavencimento) datavencimento
                     , to_char(d.datavencimento,'MONTH') "Mês"
                     , decode(d.pago,'S','Sim','Não') Pago
                     , d.descricaoorigem "Descrição de Origem"
                     , ( select to_number(substr(f.semana,4,4)) from fechamentossemanais f where f.idfechamento = d.idfechamento ) "Ano"
                     , ( select to_number(substr(f.semana,1,2)) from fechamentossemanais f where f.idfechamento = d.idfechamento ) "Semana"
                     , '' Nota
                from despesas            d
                where d.idfilial != 240 -- romance
                  and exists ( select 1 
                               from filiais f 
                               where f.tipofilial = 'D' 
                                 and f.idfilial = d.idfilial)
                  and  (:P284_IDFILIAL is null or d.idfilial = :P284_IDFILIAL )
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
