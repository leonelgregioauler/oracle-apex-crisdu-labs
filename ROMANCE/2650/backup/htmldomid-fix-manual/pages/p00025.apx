page 25 (
    name: Depositos Efetuados
    title: Depositos Efetuados
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region depositos-efetuados (
        name: Depositos Efetuados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*FIRST_ROWS(100)*/depdia.idpgtoforn
                     , depdia.iddepositodiarios
                     , depdia.iddepositodiarios IDDEPOSITO
                     , pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(idrepresentante) ) Filial
                     , pck_romance.fnc_nomerepresentante(idrepresentante) Representante
                     , trunc(depdia.data)  Data_deposito
                     , to_char(depdia.data,'rrrr')  ano
                     , to_char(depdia.data,'MONTH')  MES
                     , to_char(depdia.data,'IW/RRRR')  SEMANA
                     , to_char(pgf.dtvencimento,'DD/MM/RRRR') Data_vencimento
                     , nvl( ( select pck_romance.fnc_nomefornecedor(f.idfornecedor)
                              from fornecedores f
                              where f.idpessoa = contbanc.idpessoa ),pck_romance.fnc_nomefornecedor(contbanc.idfornecedor)) Depositado_para--nvl(contbanc.apelidofornecedor, contbanc.Fornecedor) Depositado_para
                     , contbanc.idfornecedor
                     , ( select b.nomebanco from bancos b where b.idbanco = contbanc.idbanco) Banco
                     , contbanc.agencia ||', '||contbanc.conta agencia_conta
                     , initcap(contbanc.beneficiario) beneficiario
                     , depdia.valordeposito Valor_depositado
                     , ( select descricao 
                         from tipospagamentos t
                         where t.codigo = depdia.tipo ) tipo
                     , decode(depdia.comprovado,'S','Sem Comprovante'
                                               ,'C','Cópia'
                                               ,'M','Em Mãos'
                                               ,'G','Com Gerente') Comprovado
                     , depdia.nrocomprovante
                     , depdia.observacao
                     , depdia.observacaogerente "Obs. Gerente"
                     , 'Nota Fiscal nº '||nvl(notafiscal.documento,notafiscal.nrnf) referente_a_doc
                     , to_char(notafiscal.dtnf,'DD/MM/RRRR') data_doc
                     , notafiscal.valortotal valor_doc
                     , depdia.nroenvelope "Nro Envelope"
                     , ( select f.semana from fechamentorepresentantes f where f.idfechamentorepres = depdia.idfechamentorepres ) Fechamento
                     , decode(depdia.tipopagamento,'D','Depósito','B','Boleto','AB','Abatimento','T','Transferência', 'Não Informado')  "Tipo Pagamento"
                     , ( select p.nomepessoa from pessoas p, filiais f where p.idpessoa = f.idpessoa and f.idfilial = pgf.idfilial ) "Filial Destino"
                     , abatimento.documento "Nota Abatida"
                     , abatimento.valor    "Valor Nota Abatida"
                     , abatimento.datavencimento "Vencto Nota Abatida"
                     , abatimento.emitente "Emitente Nota Abatida"
                     , ( select cb.beneficiario||' - '||b.nomebanco
                              ||' - '|| cb.agencia ||' - '||
                              cb.conta
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco         = b.idbanco 
                           and cb.idcontabanc = ( select idcontabancraiz
                                                  from contasbancarias
                                                  where idcontabanc =  depdia.idcontabanc))  "Conta Raíz"
                     , decode(depdia.pendencia,'MA', 'Valor Maior'
                                       ,'ME', 'Valor Menor'
                                       ,'NL', 'Não Localizado' ) pendencia
                     , depdia.valorlocalizado
                     , depdia.dataresolvido
                     , depdia.idrepresentante
                     , decode(depdia.transferencia,'S','Sim','Não') transferencia
                     , decode(pgf.identificado,'S','Sim','Não') identificado
                     , notafiscal.crisdu
                     , ( select identificacao
                         from identificacaodepositos i
                         where i.ididentificacao = depdia.identificacao ) identificacao
                     , ( select count(1)||' - '||listagg(trim(to_char(dd.valor_digitado,'999G999G999G999G990D00'))||'  '||dd.nroidentificacao_digitado||' - ') within group (order by 1)
                         from depositosdiarios_leituraocr dd
                         where dd.iddepositodiario = depdia.IDDEPOSITODIARIOS ) fotos             
                     , decode(pgf.automatizar,'S','Sim','N','Não') automatizado
                from depositosdiarios_orig depdia
                   , pagamentosfornecedores pgf
                   , contasbancarias contbanc
                  /* , ( select cb.idcontabanc
                            , cb.idfornecedor\* initcap(pf.apelido) ApelidoFornecedor
                            , initcap(pf.nomepessoa) Fornecedor*\
                            , initcap(bb.nomebanco) nomebanco
                            , cb.agencia ||', '||cb.conta Agencia_Conta
                            , initcap(cb.beneficiario) beneficiario
                       from contasbancarias cb
                          , fornecedores    ff
                          , pessoas         pf
                          , bancos          bb
                       where cb.idfornecedor = ff.idfornecedor
                         and ff.idpessoa     = pf.idpessoa
                         and cb.idbanco      = bb.idbanco ) contbanc*/
                  , ( select pagforn.idpgtoforn
                           , nf.nrnf
                           , nf.dtnf
                           , sum(v.valor) valortotal
                           , pagforn.dtvencimento
                           , nf.documento
                           ,  case
                                  when ( select r.cnpj
                                         from razoessociaisfornec r
                                            , notasfiscais        n
                                         where r.idrazaosocialforn = n.idrazaosocialfornemit
                                           and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  when ( select r.cnpj
                                         from razoessociaisfornec r
                                            , notasfiscais        n
                                         where r.idrazaosocialforn = n.idrazaosocialforndest 
                                           and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  when ( select cnpj
                                         from razoessociaisfiliais re
                                            , notasfiscais        n
                                         where re.idrazaosocialfilial = n.idrazaosocialfilemit 
                                           and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  when ( select  cnpj
                                         from razoessociaisfiliais re
                                            , notasfiscais        n
                                         where re.idrazaosocialfilial = n.idrazaosocialfildestino 
                                           and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  else 
                                    'Não'
                                 end crisdu
                      from pagamentosfornecedores pagforn
                         , notasfiscais           nf
                         , vencimentos            v
                      where pagforn.idnotafiscal = nf.idnotafiscal
                        and nf.idnotafiscal      = v.idnotafiscal
                        group by pagforn.idpgtoforn
                               , nf.nrnf
                               , nf.dtnf
                               , pagforn.dtvencimento 
                               , pagforn.idnotafiscal
                               , nf.documento ) notafiscal          
                  ,  ( select nv.documento 
                            , v.valor
                            , v.datavencimento
                            , v.idvencimento
                            , pck_romance.fnc_nomefornecedor(nc.idfornemitente) emitente
                         from vencimentosreceber v
                            , notasfiscais nv 
                            , notasfiscais nc
                         where v.idnotafiscal = nv.idnotafiscal 
                           and nv.idnotafiscalcompra = nc.idnotafiscal) abatimento
                where pgf.idcontabanc  = contbanc.idcontabanc (+)
                  and depdia.idpgtoforn      = notafiscal.idpgtoforn(+)
                  and depdia.idpgtoforn      = pgf.idpgtoforn
                  and depdia.idvencimentoabatimento = abatimento.idvencimento (+)
                  and (:P25_IDFORNECEDOR    is null or pgf.idfornecedor       = :P25_IDFORNECEDOR    )
                  and (:P25_IDREPRESENTANTE is null or depdia.idrepresentante = :P25_IDREPRESENTANTE )
                  and (:P25_IDFILIAL        is null or exists ( select 1
                                                                from representantes r
                                                                   , gerentes g
                                                                where r.idrepresentante = depdia.idrepresentante
                                                                  and g.idgerente       = r.idgerente
                                                                  and g.idfilial        = :P25_IDFILIAL ) )
                  and ( :P25_DATA is null or trunc(depdia.data) = to_date(:P25_DATA,'DD/MM/RRRR' ) )
                  and ( :P25_VALORDEPOSITO is null or depdia.valordeposito = to_number(:P25_VALORDEPOSITO ))
                  and ( :P25_IDCONTABANC is null or depdia.idcontabanc = :P25_IDCONTABANC)
                  AND :P25_FILTRAR IS NOT NULL
                ```
            pageItemsToSubmit: [
                P25_IDFORNECEDOR
                P25_IDFILIAL
                P25_IDREPRESENTANTE
                P25_DATA
                P25_VALORDEPOSITO
                P25_FILTRAR
            ]
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than 10,000 rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

