    validation vaida-valor-rateio-x-nota (
        name: "Vaida Valor Rateio  X Nota "
        execution {
            sequence: 310
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                /*select 1
                from ( select ( select round(sum(r.valor),2)
                                from roman.rateiosnotasfiscais r 
                                where r.idnotafiscal = :P27_IDNOTAFISCAL) - ( select round(nf.valortotal,2)
                                                                              from roman.notasfiscais nf  
                                                                              where nf.idnotafiscal = :P27_IDNOTAFISCAL) teste
                       from dual )
                where teste != 0;*/
                --Ajuste ticket 15644398 - Osiel 
                select 1
                from ( select ( select sum(valor)
                                from ( select r.datavencimento
                                            , round(sum(r.valor),2) valor
                                       from roman.rateiosnotasfiscais r 
                                       where r.idnotafiscal = :P27_IDNOTAFISCAL
                                group by r.datavencimento)) - ( select round(nf.valorliquido,2) --Ticket 16557025
                                                                from roman.notasfiscais nf  
                                                                where nf.idnotafiscal = :P27_IDNOTAFISCAL) teste
                       from dual )
                where teste != 0;
                ```
        }
        error {
            errorMessage: Atenção! Divergência Entre Valor da Nota e Rateio.
        }
        serverSideCondition {
            whenButtonPressed: @fechar-ajuste
        }
        comments {
            comments: "Valida divergência entre valores de rateios e capa da nota.  "
        }
    )

    validation valida-abastecimento (
        name: Valida Abastecimento
        execution {
            sequence: 260
        }
        validation {
            type: itemIsNotNull
            item: P27_IDFILIALDESTINO_A
        }
        error {
            errorMessage: Informe o destino
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: GERAR_ABASTECIMENTO
        }
    )

    validation valida-matriz-de-despesas (
        name: Valida Matriz de Despesas
        execution {
            sequence: 210
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from vencimentos v 
                where v.idnotafiscal = :P27_IDNOTAFISCAL 
                  and v.idmatrizregradespesa is null
                  and extract ( year from v.datavencimento ) >= 2020
                  and not exists ( select 1
                                   from lancamentosdiversos lc
                                   where lc.idnotafiscalgerada = v.idnotafiscal )
                  and exists ( select 1
                               from matrizregrasdespesas md
                               where md.idfornecedor = :P27_IDFORNEMITENTE
                                 and md.idfilial     = :P27_IDFILIALDESTINO )
                  and not exists ( select 1 
                                   from roman.requisicoespagamentos r
                                      , roman.notasfiscais n
                                   where r.idnotafiscal = n.idnotafiscal
                                     and r.idgrupo is null
                                     and n.tiponota = 'R' )
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Por favor, verifique os vencimentos, existe lançamento sem matriz!
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('SAVE','Salvar')
        }
    )

    validation valida-matriz-no-parcelamento (
        name: Valida Matriz no Parcelamento
        execution {
            sequence: 220
        }
        validation {
            type: itemIsNotNull
            item: P27_IDMATRIZREGRA
            alwaysExecute: true
        }
        error {
            errorMessage: Por favor, identifique a Matriz para gerar o Parcelamento.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'GERAR_PARCELAMENTO' and :P27_TIPOPAGAMENTO != 'P' and :P27_TIPONOTA != 'R'
        }
    )

    validation valida-matriz-no-parcelamento-tipo-r (
        name: Valida Matriz no Parcelamento Tipo R
        execution {
            sequence: 230
        }
        validation {
            type: itemIsNotNull
            item: P27_IDMATRIZREGRA
            alwaysExecute: true
        }
        error {
            errorMessage: Por favor, identifique a Matriz para gerar o Parcelamento.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                
                v('REQUEST') = 'GERAR_PARCELAMENTO' and :P27_TIPOPAGAMENTO != 'P' and :P27_TIPONOTA = 'R'
                and not exists ( select 1 
                                 from roman.rateiosnotasfiscais rt 
                                 where rt.idnotafiscal = :P27_IDNOTAFISCAL)
                ```
        }
    )

    validation valida-mudança-de-destino (
        name: Valida Mudança de Destino
        execution {
            sequence: 250
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from notasfiscais nf
                where nf.idnotafiscal = :P27_IDNOTAFISCAL
                  and nf.idfilialdestino != :P27_IDFILIALDESTINO
                  and exists ( select 1
                               from vencimentos v
                               where v.idnotafiscal = nf.idnotafiscal
                                 and v.idmatrizregradespesa is not null )
                ```
        }
        error {
            errorMessage: Não é possível alterar o Destino, existe vencimento com Matriz vinculada!
            associatedItem: @P27_IDFILIALDESTINO
        }
    )

    validation valida-rateio-por-vencimento (
        name: Valida Rateio por Vencimento
        execution {
            sequence: 320
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare 
                  -- 
                  vvalor number := 0;
                  vteste number := 0;
                  --
                begin
                  -- 
                  
                  for i in ( select v.datavencimento datavencimento
                                  , sum(v.valor - nvl(v.desconto,0) + nvl(v.acrescimo,0)) valor --sum(v.valor) valor --Ticket 16557025
                             from roman.vencimentos v 
                             where v.idnotafiscal = :P27_IDNOTAFISCAL
                             group by v.datavencimento )
                  --
                  loop 
                    --
                    begin 
                      --
                      select ROUND(nvl(sum(rt.valor),0),2)
                        into vvalor
                      from roman.rateiosnotasfiscais rt 
                      where rt.idnotafiscal = :P27_IDNOTAFISCAL 
                        and rt.datavencimento = i.datavencimento;
                      --
                    end;
                    -- 
                    if vvalor != i.valor then
                      --
                      vteste := 1;
                      --
                    end if;
                    --
                    vvalor := 0;
                    --
                  end loop;
                  --
                  if vteste = 1 then
                    --
                    return false;
                    --
                  else
                    -- 
                    return true;
                    --
                  end if;
                
                end;
                ```
        }
        error {
            errorMessage: "Atenção! Existe divergência de valores entre rateios e vencimentos. "
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('FECHAR_AJUSTE')
                  and :P27_TIPONOTA = 'R'
                  and exists ( select 1 
                                   from roman.rateiosnotasfiscais rn
                                   where rn.idnotafiscal = :P27_IDNOTAFISCAL)
                ```
        }
        comments {
            comments: Em notas que possuem rateio valida valores de rateios x vencimentos.
        }
    )

    validation valida-rateio-x-valor-nota (
        name: Valida rateio x valor nota
        execution {
            sequence: 290
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select case
                         when
                            ( select sum(r.valor) from roman.rateiosnotasfiscais r where r.idnotafiscal = :P27_IDNOTAFISCAL) 
                          - ( select nf.valortotal from roman.notasfiscais nf  where nf.idnotafiscal = :P27_IDNOTAFISCAL) != 0 then
                        'Divergência no Total da NF:'
                        else
                        'x'
                        end consiste
                from dual
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Divergência Entre Valor Total da Nota X Rateio  !
            associatedItem: @P27_VALORLIQUIDO
        }
        serverSideCondition {
            whenButtonPressed: @save
            type: never
        }
    )

