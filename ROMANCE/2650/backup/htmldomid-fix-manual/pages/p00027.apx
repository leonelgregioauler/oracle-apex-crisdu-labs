    pageItem P27_SALDOPARAVENDA (
        type: textField
        label {
            label: Saldo p/ Venda
            alignment: left
        }
        layout {
            sequence: 410
            region: @compras-e-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 11
        }
        advanced {
            customAttributes: style="text-align:right;" readonly
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select CASE 
                          WHEN :P27_TIPONOTA = 'C' THEN
                           ( select sum(qtd_total)
                             from itemnf i
                             where idproduto is not null
                               and i.idnotafiscal = :P27_IDNOTAFISCAL )- nvl(( select sum(i.qtd_total)
                                                                                from notasfiscais n
                                                                                   , itemnf       i
                                                                                where n.idnotafiscal = i.idnotafiscal 
                                                                                  and n.idnotafiscalcompra = :P27_IDNOTAFISCAL
                                                                                  and idproduto is not null),0)  
                         ELSE
                           ( select sum(qtd_total)
                             from itemnf i
                             where idproduto is not null
                               and i.idnotafiscal = :P27_IDNOTAFISCALCOMPRA )- nvl(( select sum(i.qtd_total)
                                                                                from notasfiscais n
                                                                                   , itemnf       i
                                                                                where n.idnotafiscal = i.idnotafiscal 
                                                                                  and n.idnotafiscalcompra = :P27_IDNOTAFISCALCOMPRA 
                                                                                  and idproduto is not null ),0)  
                         END VALOR
                from dual
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

