    pageItem P27_IDFILIALDESTINO (
        type: selectList
        label {
            label: Filial Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(f.idfilial)||'  - Unid. Neg.: '||( select un.nome
                                                                                from unidadesdenegocios un
                                                                                where un.idunidadedenegocio = f.idunidadedenegocio ) display_value 
                     , f.idfilial return_value 
                from filiais f
                where exists ( select 1
                               from matrizregrasdespesas m
                               where m.idfornecedor = :P27_IDFORNEMITENTE
                                 and m.ativo = 'S'
                                 and m.idfilial     = f.idfilial )
                  and :P27_TIPONOTA in ('D','C','R')
                union
                select pck_romance.fnc_nomefilial(f.idfilial) 
                     , f.idfilial
                from filiais f
                where exists ( select 1
                               from lancamentosdiversos l
                               where l.idfilialdestino = f.idfilial
                                 and l.idnotafiscalgerada = :P27_IDNOTAFISCAL )
                union
                select pck_romance.fnc_nomefilial(f.idfilial) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.ativo       = 'S'
                  and :P27_TIPONOTA = 'C'
                  and f.tipofilial in ( select idtipofilial
                                        from acessostiposfiliais
                                        where usuario = v('APP_USER') )
                union
                select pck_romance.fnc_nomefilial(f.idfilial) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.ativo       = 'S'
                  and :P27_TIPONOTA in ('T','A')
                  and f.tipofilial in ( select idtipofilial
                                        from acessostiposfiliais
                                        where usuario = v('APP_USER') )
                union 
                select roman.pck_romance.fnc_nomefilial(f.idfilial) 
                     , f.idfilial
                from filiais f
                where exists ( select 1
                               from roman.requisicoespagamentos r
                               where r.idgrupo = f.idfilial
                                 and r.idnotafiscal = :P27_IDNOTAFISCAL ) --Incluido este union para atender solicitação da Débora no evento 7816784
                order by 1
                ```
            nullDisplayValue: " "
        }
        cascadingLov {
            parentItems: [
                P27_TIPONOTA
                P27_IDFORNEMITENTE
            ]
        }
        layout {
            sequence: 190
            region: @compras-e-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALDESTINO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

