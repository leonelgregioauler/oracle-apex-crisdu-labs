                    --
                    update roman.notasfiscais nf 
                    set nf.situacao = 'U'
                    where nf.idnotafiscal = :P27_IDNOTAFISCAL;
                    --
                  elsif v('REQUEST') = 'FECHAR_AJUSTE' then
                    --
                    update roman.notasfiscais nf 
                    set nf.situacao = 'A'
                    where nf.idnotafiscal = :P27_IDNOTAFISCAL;
