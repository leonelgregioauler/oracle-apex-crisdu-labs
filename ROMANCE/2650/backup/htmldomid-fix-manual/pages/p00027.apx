    button adicionar-rateio (
        buttonName: ADICIONAR_RATEIO
        label: Adicionar Rateio
        layout {
            sequence: 10
            region: @rateios-faturas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 394
                items: {
                    P394_IDNOTAFISCAL: &P27_IDNOTAFISCAL.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button adicionar-rateio-req (
        buttonName: ADICIONAR_RATEIO_REQ
        label: Adicionar Rateio
        layout {
            sequence: 20
            region: @rateios-faturas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 499
                items: {
                    P499_IDNOTAFISCAL: &P27_IDNOTAFISCAL.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.notasfiscais nf 
                where nf.idnotafiscal = :P27_IDNOTAFISCAL
                  and nf.tiponota = 'R'
                  and nf.situacao = 'U'
                  --and not exists ( select 1
