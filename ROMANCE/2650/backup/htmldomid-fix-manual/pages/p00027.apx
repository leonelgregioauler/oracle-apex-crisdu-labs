    region rateios-faturas (
        name: Rateios Faturas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                --Incluído union para atender situação de lançamentos diversos antigos e assim não validando data de vencimento e vencimento.
                --Acordado em reunião com Leticia e Paloma que desta forma não tera validação nas notas de tipo D podendo haver divergencia. 
                select *
                from (
                select roman.pck_romance.fnc_nomefilial(r.idfilialdestino) idfilialdestino
                     , r.valor
                     --, v.valor vlrvenc
                     , ( select sum(v.valor)
                         from roman.vencimentos v 
                         where v.idnotafiscal = r.idnotafiscal
                           and v.datavencimento = r.datavencimento ) vlrvenc
                     , ( select sum(rt.valor) soma
                         from roman.rateiosnotasfiscais rt 
                         where rt.idnotafiscal = r.idnotafiscal
                           and rt.datavencimento = r.datavencimento ) Soma_rateio_x_Vencimento
                     , md.centrodecusto centrodecusto
                     , md.contafinanceira conta
                     , md.subcontafinanceira subconta
                     , md.desctiporegra regra
                     , decode(md.ativo,'S','Ativa','N','Inativa') situacao
                     , r.data datacriacao
                     , r.datavencimento
                     , r.idrateionotafiscal
                     , r.observacao
                     , ( select distinct('S')
                         from roman.vencimentos v 
                            , roman.pagamentosfornecedores pf
                         where pf.idvencimento = v.idvencimento
                           and v.idnotafiscal = r.idnotafiscal
                           and v.datavencimento = r.datavencimento
                           and pf.databaixa is not null ) baixa
                from roman.rateiosnotasfiscais r
                   , roman.vw_matrizregrasdespesas md
                   --, roman.vencimentos v 
                   , roman.notasfiscais nf
                where r.idnotafiscal    = :P27_IDNOTAFISCAL
                  and r.idmatrizdespesa = md.idmatrizregra(+)
                 -- and v.idnotafiscal    = r.idnotafiscal 
                 -- and v.datavencimento  = r.datavencimento
                  and nf.idnotafiscal = r.idnotafiscal
                  and nf.tiponota = 'R'
                union 
                select roman.pck_romance.fnc_nomefilial(r.idfilialdestino) idfilialdestino
                     , r.valor
                     , null
                     , null
                    -- , v.valor vlrvenc
                     , md.centrodecusto centrodecusto
                     , md.contafinanceira conta
                     , md.subcontafinanceira subconta
                     , md.desctiporegra regra
                     , decode(md.ativo,'S','Ativa','N','Inativa') situacao
                     , r.data datacriacao
                     , r.datavencimento
                     , r.idrateionotafiscal
                     , r.observacao
                     , null
                from roman.rateiosnotasfiscais r
                   , roman.vw_matrizregrasdespesas md
                   , roman.notasfiscais nf
                   --, roman.vencimentos v 
                where r.idnotafiscal    = :P27_IDNOTAFISCAL
                  and r.idmatrizdespesa = md.idmatrizregra(+)
                  and nf.idnotafiscal = r.idnotafiscal
                  and nf.tiponota = 'D'
                  --and v.idnotafiscal    = r.idnotafiscal 
                  --and v.datavencimento  = r.datavencimento
                )
                order by 11
                ```
        }
        layout {
            sequence: 20
            slot: body
            columnCssClasses: emp
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from rateiosnotasfiscais r
                where r.idnotafiscal = :P27_IDNOTAFISCAL
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4984644994960827923
        }

