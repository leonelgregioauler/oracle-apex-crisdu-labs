    process venda-ratiada (
        name: Venda Ratiada
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P27_TIPONOTA = 'C' then
                    --
                    :P27_NOTAVENDA := pck_romance.prc_geranf_venda(:P27_IDNOTAFISCAL,'R');
                    --
                  else
                    --
