    pageItem P27_MENSFECHTO (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 460
            region: @rateios-faturas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                margin-left-none
            ]
        }
        advanced {
            customAttributes: style="font-weight:bold;color:red"
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                vMens varchar2(100);
                begin
                  begin 
                      select distinct 'Movimento ja fechado para esta data!'
                        into vMens
                        from fechamentomovimentacoes fm
                       , pagamentosfornecedores  pf
                    where fm.datafechamento  = pf.databaixa
                      and fm.idcontabancaria = pf.idcontapagamento
                      and pf.idnotafiscal = :P27_IDNOTAFISCAL;
                  exception
                    when no_data_found then
                      vMens := ' ';
                  end;
                  
                  return vMens;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

