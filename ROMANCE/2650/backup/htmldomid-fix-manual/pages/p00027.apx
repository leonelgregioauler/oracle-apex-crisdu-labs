    pageItem P27_TIPONOTA (
        type: radioGroup
        label {
            label: Tipo Nota
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC:Compra/Ordem de Pgto;C,Despesa;D,Requisição Pgto;R
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 120
            region: @compras-e-despesas
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: TIPONOTA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vtipo varchar2(1);
                begin
                  --
                  if v('APP_USER') in ('BRUNA','GERRI','BRUNASAUERESSING','GUILHERME','DEBORAC','CRISTINAR','PATRICKGROSS') then
                    --
                    vtipo := 'D';
                    --
                  else
                    --
                    vtipo := 'C';
                    --
                  end if;
                  --
                  return vtipo;
                  --
                end;
                ```
        }
        readOnly {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from vencimentos v
                         where v.idnotafiscal = :P27_IDNOTAFISCAL ) and :P27_IDNOTAFISCAL is not null
                ```
        }
        security {
            encryptSessionState: false
        }
    )

