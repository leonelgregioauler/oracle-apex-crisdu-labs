    process gera-parcelamento-do-v (
        name: Gera Parcelamento do V1
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                   vvalorparcela number;             
                  --
                begin
                  --
                  if :P27_IDMOEDA is null then
                    --
                    apex_error.add_error (
                        p_message          => 'Este campo é obrigatório.',
                        p_display_location => 'INLINE_IN_FIELD',
                        p_page_item_name   => 'P27_VALORPARCELA'
                    );
                    --
                  end if;
                  --
                  vvalorparcela := to_number(:P27_VALORPARCELA ,'999G999G999G990D00'); 
                  -- Call the procedure
                  pck_financeiro_rmc.prc_geraparcelamento_v1(pidnotafiscal => :P27_IDNOTAFISCAL,
                                                             ptipopagamento => :P27_TIPOPAGAMENTO,
                                                             pidmatrizregra => :P27_IDMATRIZREGRA,
                                                             pqtdparcelas => :P27_QUANTIDADE_PARCELAS,
                                                             pdatavencimento => :P27_DATAVENCIMENTO_PARCELA,
                                                             pvalorparcela => vvalorparcela, --:P27_VALORPARCELA,
                                                             pidcontabancaria => :P27_IDCONTABANCARIA,
                                                             pidentificado => :P27_IDENTIFICADO,
                                                             pidmoeda => :P27_IDMOEDA);
                  --
                  :P27_TIPOPAGAMENTO := null;
                  :P27_IDMATRIZREGRA := null;
                  :P27_QUANTIDADE_PARCELAS := null;
                  :P27_DATAVENCIMENTO_PARCELA := null;
                  :P27_VALORPARCELA := null;
                  :P27_IDCONTABANCARIA := null;
                  :P27_IDENTIFICADO := null;
                  :P27_IDMOEDA := NULL;
                  --
                end;
                ```
        }
