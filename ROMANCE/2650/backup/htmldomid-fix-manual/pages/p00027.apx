page 27 (
    name: Compra
    title: Compra
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function abrevencto() 
              {
                vnota = document.getElementById('P27_IDNOTAFISCAL').value;
                window.open('f?p=&APP_ID.:39:&SESSION.::NO::P39_IDNOTAFISCALP,P39_IDVENCIMENTO:'+vnota+',' ,'vencto','toolbar=no,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width=1200,height=300,left=100,top=200','_blank'); void(0);
              }
            
            
            function fnc_popup()
            {vid = document.getElementById("P27_IDNOTAFISCAL").value;
            window.open('f?p=&APP_ID.:190:&SESSION.::NO::P190_IDNOTAFISCAL,P190_IDITNF:'+vid+',','insprod', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=300,left=250,top=100','_blank'); void(0);
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
             $(".emp td[headers=baixa]").each(function(){
            		celldata= $(this).text();
            		if (celldata == 'S') {
            		    $(this).parent().children().css('background-color','LightGreen');
                    }
                    
            	});
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

