    validation valida-transportadora (
        name: Valida Transportadora
        execution {
            sequence: 180
        }
        validation {
            type: itemIsNotNull
            item: P27_IDTRANSPORTADORA
        }
        error {
            errorMessage: Informe a transportadora!
            associatedItem: @P27_IDTRANSPORTADORA
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P27_IDFILIALDESTINO IS NOT NULL
                  and :P27_TIPONOTA != 'D'
                  and exists ( select 1
                               from filiais f
                               where f.idfilial = :P27_IDFILIALDESTINO
