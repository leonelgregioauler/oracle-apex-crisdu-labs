    dynamicAction confirma (
        name: Confirma
        execution {
            sequence: 90
        }
        when {
            event: click
            selectionType: button
            button: @cancela-lancamento
        }

        action native-confirm (
            action: confirm
            settings {
                message: Deseja realmente cancelar o lançamento ?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CANCELA_LANCAMENTO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction confirma-ajuste (
        name: Confirma Ajuste
        execution {
            sequence: 120
        }
        when {
            event: click
            selectionType: button
            button: @ajusta-requisicao
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: AJUSTA_REQUISICAO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action volta (
            name: volta
            action: confirm
            settings {
                message: Deseja realmente excluir a nota e alterar a requisição?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction duplicar-lançamento (
        name: Duplicar Lançamento
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @duplicar-lancamento
        }

        action native-confirm (
            action: confirm
            settings {
                message: Deseja realmente duplicar este lançamento?
            }
            execution {
                sequence: 10
                fireOnInit: false
