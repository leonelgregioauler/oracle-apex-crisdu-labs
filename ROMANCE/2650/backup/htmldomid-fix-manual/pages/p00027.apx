    validation valida-valor-rateio-x-vencimento (
        name: Valida Valor Rateio x Vencimento
        execution {
            sequence: 300
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from ( select ( select sum(r.valor)
                                from roman.rateiosnotasfiscais r 
                                where r.idnotafiscal = :P27_IDNOTAFISCAL) - ( select sum(v.valor) 
                                                                              from roman.vencimentos v 
                                                                              where v.idnotafiscal = :P27_IDNOTAFISCAL) teste
                       from dual )
                where teste != 0;
                ```
        }
        error {
            errorMessage: Atenção!! Divergência Entre Vencimentos e Rateio.
        }
        serverSideCondition {
            whenButtonPressed: @fechar-ajuste
            type: never
        }
    )

    validation valida-vencimento-x-nota-sem-rateio (
        name: Valida vencimento x nota sem rateio
        execution {
            sequence: 330
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from ( select ( select sum(v.valor)
                                from roman.vencimentos v
                                where v.idnotafiscal = :P27_IDNOTAFISCAL ) - ( select nf.valortotal
                                                                              from roman.notasfiscais nf  
                                                                              where nf.idnotafiscal = :P27_IDNOTAFISCAL) teste
                       from dual )
                where teste != 0;
                ```
        }
        error {
            errorMessage: Atenção! Divergência Entre Valor da Nota e os vencimentos.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('FECHAR_AJUSTE')
                  and :P27_TIPONOTA = 'R'
                  and not exists ( select 1 
                                   from roman.rateiosnotasfiscais rn
                                   where rn.idnotafiscal = :P27_IDNOTAFISCAL)
                ```
        }
        comments {
            comments: Valida valores de vencimentos e nota para notas de requisição sem rateio.
        }
    )

