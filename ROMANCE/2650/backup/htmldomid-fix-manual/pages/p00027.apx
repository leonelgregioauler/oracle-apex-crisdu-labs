    pageItem P27_IDFORNEMITENTE (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                where f.idpessoa = p.idpessoa
                  AND :P27_IDFILIALEMITENTE IS NULL 
                  AND :P27_IDFORNEMITENTE IS NULL
                  and f.ativo = 'S'
                  and exists ( select 1 from fornecedoresprodutos p
                               where p.idfornecedor = f.idfornecedor )
                UNION
                select initcap(p.nomepessoa) display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                where f.idpessoa = p.idpessoa
                  and exists ( select 1 from fornecedoresprodutos p
                               where p.idfornecedor = f.idfornecedor )
                  and (:P27_IDFORNEMITENTE is not null and f.idfornecedor = :P27_IDFORNEMITENTE)
                  and f.ativo = 'S'
                UNION
                select initcap(p.nomepessoa) display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                   , filiais ff
                where f.idpessoa = p.idpessoa
                  and p.idpessoa = ff.idpessoa
                  and f.ativo = 'S'
                  and not exists ( select 1 from fornecedoresprodutos p
                               where p.idfornecedor = f.idfornecedor)
                  and (:P27_IDFORNEMITENTE is not null and f.idfornecedor = :P27_IDFORNEMITENTE)
                UNION
                select initcap(p.nomepessoa) display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                where f.idpessoa = p.idpessoa
                  and f.ativo    = 'S'
                  and exists ( select 1
                               from matrizregrasdespesas m
                               where m.idfornecedor = f.idfornecedor
                                 and m.ativo = 'S' )
                order by 1
                ```
            nullDisplayValue: " - Selecione o Fornecedor -"
        }
        layout {
            sequence: 170
            region: @compras-e-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: IDFORNEMITENTE
            used: always
        }
        readOnly {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from vencimentos v
                         where v.idnotafiscal = :P27_IDNOTAFISCAL ) or :P27_TIPONOTA = 'A'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

