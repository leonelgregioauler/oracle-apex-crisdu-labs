    pageItem P27_AVISO_SEM_MATRIZ (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
            sendOnPageSubmit: false
        }
        layout {
            sequence: 70
            region: @compras-e-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color=red><h3>Esta Fatura não possui uma matriz entre Fornecedor e Filial Destino - '||pck_romance.fnc_nomefilial(:P27_IDFILIALDESTINO)||'</h3></font>' texto
                from dual
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where not exists ( select 1
                                   from matrizregrasdespesas m
                                   where m.idfornecedor = :P27_IDFORNEMITENTE 
                                     and m.ativo = 'S'
                                     and m.idfilial = :P27_IDFILIALDESTINO )
                  and :P27_TIPONOTA in ('C','D','R')
                ```
        }
        security {
            encryptSessionState: false
        }
    )

