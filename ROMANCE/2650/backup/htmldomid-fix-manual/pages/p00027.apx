    region gerar-abastecimento (
        name: Gerar Abastecimento
        type: staticContent
        layout {
            sequence: 30
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                O Abastecimento é gerado apenas para que o a empresa destino consiga dar entrada das mercadorias.
                Os vencimentos devem ser lançado na nota acima.
                ```
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P27_TIPONOTA = 'C' 
                and :P27_IDFILIALDESTINO in ( 1214 ,1236)
                and not exists ( select 1
                                 from notasfiscais nf
                                 where nf.idnotafiscalabastecimento = :P27_IDNOTAFISCAL )
                ```
        }
    )

    region incluir-itens-na-nf (
        name: Incluir Itens na NF
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDITNF",
                "IDITNF" IDITNF_DISPLAY,
                "IDNOTAFISCAL",
                "IDPRODUTO",
                "CUSTOUND",
                "VALORTOTAL",
                "QTD_PP",
                "QTD_P",
                "QTD_M",
                "QTD_G",
                "QTD_GG",
                "QTD_EGG",
                "QTD_EXGG",
                "QTD_TOTAL",
                "QTD_U",
                "OBSERVACAO"
                from "#OWNER#"."ITEMNF"
                where 1 = 2
                ```
        }
        layout {
            sequence: 40
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P27_IDNOTAFISCAL is not null
                  and :P27_TIPONOTA in ( 'C','R')
                ```
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

