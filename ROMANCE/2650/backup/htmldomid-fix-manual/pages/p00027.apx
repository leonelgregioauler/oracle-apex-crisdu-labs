            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from notasfiscais nf
                where nf.idnotafiscal != :P27_IDNOTAFISCAL
                  and nf.idfornemitente = :P27_IDFORNEMITENTE
                  and nf.documento = :P27_DOCUMENTO
                  and nf.tiponota != :P27_TIPONOTA  
                  and nf.tiponota != 'V'
                  and nf.idfilialdestino = :P27_IDFILIALDESTINO
