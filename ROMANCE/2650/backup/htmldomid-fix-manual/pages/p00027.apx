    button efetuar-venda-unica (
        buttonName: EFETUAR_VENDA_UNICA
        label: Venda Única
        layout {
            sequence: 90
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P27_IDNOTAFISCAL is not null
                  and :P27_TIPONOTA = 'C'
                  and nvl(( select sum(i.qtd_total)
                            from notasfiscais n
                               , itemnf       i
                            where n.idnotafiscal = i.idnotafiscal 
                              and n.idnotafiscalcompra = :P27_IDNOTAFISCAL ),0) < ( select sum(qtd_total)
                                                                                    from itemnf i
                                                                                    where i.idnotafiscal = :P27_IDNOTAFISCAL )
                union
                select 1
                from dual
                where :P27_IDNOTAFISCAL is not null
                  and :P27_TIPONOTA in ('D','R')
                ```
        }
    )

