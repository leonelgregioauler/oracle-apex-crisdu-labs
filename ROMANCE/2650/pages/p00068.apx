    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @conferir-despesas
        target {
            tableName: DESPESAS
            pkColumn: IDDESPESA
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# row(s) deleted.
        }
        advanced {
            executionMappingIdentifier: 209430950506762110
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
