    region despesas-pendentes (
        name: Despesas Pendentes
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(f.idfilial) empresa
                     , count(D.IDDESPESA) qtd
                     , f.idfilial
                from roman.despesas d
                   , roman.fechamentossemanais f
                where NVL(d.EMMAOS,'N') = 'N'
                  and d.idfechamento     = f.idfechamento 
                  and f.idsemana >= 909
                  and exists ( select 1
                               from catal.filiais ff
                               where ff.idfilial   = f.idfilial 
                                and ff.tipofilial in ('O','G','F') )
                                /* and ff.idfilial in ('1205','360','1135','1086','1104','1087','1075',
                                                                '1191','1065','1098','1137','1131','200','1021',
                                                                '1176','1062','1076','1120','1204','1172','1146',
                                                                '1152','1147','340','1061','1088') )*/
                having count(1) > 0                 
                group by f.idfilial
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: QTD
            linkTarget: {
                page: 68
                items: {
                    P0_IDFILIAL: &IDFILIAL
                    P0_IDFECHAMENTO:
                }
                action: resetPagination
            }
            layout: 5Columns
            color: yes
        }
    )

