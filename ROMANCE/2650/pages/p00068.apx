page 68 (
    name: Revisar Despesas
    title: Revisar Despesas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: https://cdn.jsdelivr.net/npm/colresizable@1.6.0/colResizable-1.6.min.js
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
        executeWhenPageLoads:
            ```javascript-browser
            $('#conferir-despesas-form table').colResizable({
              liveDrag: true,
              minWidth: 60,
              resizeMode: 'flex'
            });
            ```
    }
    css {
        inline:
            ```css
            #conferir-despesas-form table input[type="text"],
            #conferir-despesas-form table textarea,
            #conferir-despesas-form table select {
              width: 100% !important;
              box-sizing: border-box !important;
              min-width: 0 !important;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region conferir-despesas (
        name: Conferir Despesas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select IDDESPESA
                     , IDDESPESA IDDESPESA_DISPLAY
                     , pck_romance.fnc_nomerepresentante(idrepresentante) IDREPRESENTANTE
                     , IDFECHAMENTOREPRES
                     , IDCONTACONTABIL
                     , OBSERVACAO
                     , VALOR * nvl(d.fatorconversao,1) as VALOR -- Maicon Aimi - 06/06/2024 - Ticket 9109360 - Adicionado o fator de conversão na coluna VALOR
                     , EMMAOS
                     , IDSUBCONTACONTABIL
                     , DATAVENCIMENTO
                     , DESCRICAOORIGEM
                     , OBSERVACAOCONTROLE
                     , null questionamento
                     , null anexos
                     , ( select count(1)
                         from anexosdespesas dd
                         where dd.iddespesa = d.iddespesa ) qtdanexos
                     , IDMATRIZCLASSIFICACAO
                     , PLACACARRO
                     , replace(replace(replace(OBSERVACAO||' - '||VALOR,',','.') ,'+',''),'-','.')  questionar 
                     , (select distinct c.nome
                          from roman.matrizclassificacoesdespesas mc
                             , roman.centrodecustos c
                         where d.idmatrizclassificacao  = mc.idmatrizclassificacao
                           and mc.idcentrodecusto       = c.idcentrodecusto) "Centro de Custo"
                from DESPESAS D
                where idfechamento = :P0_IDFECHAMENTO
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: conferir-despesas-form
        }
        reportLayout {
            numberOfRows: 40
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column ANEXOS (
            reportColumnQueryId: 14
