page 261 (
    name: Abre Foto Comprovante
    title: Abre Foto Comprovante
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            img {
                          max-width: 500px;
                          width: 100%;
                          }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P261_ARQUIVO (
        type: textField
        label {
            label: Arquivo
            alignment: left
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    process abre-arquivo (
        name: aBRE ARQUIVO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_financeiro_rmc.prc_abreafotocomprovante_web(pnomearquivo => :P261_ARQUIVO);
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 901075972527350087
        }
    )

)

