page 185 (
    name: Lista de Campanhas
    title: Lista de Campanhas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region lista-de-campanhas (
        name: Lista de Campanhas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "IDCAMPANHA", 
                "DESCRICAO",
                "SEMANAINI",
                "SEMANAFIM"
                from "#OWNER#"."CAMPANHAS" 
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 186
                items: {
                    P186_IDCAMPANHA: #IDCAMPANHA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhuma campanha cadastrada.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: DESCRICAO
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDCAMPANHA (
            type: plainText
            heading {
                heading: Idcampanha
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDCAMPANHA
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column SEMANAFIM (
            type: plainText
            heading {
                heading: Semana Fim
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: SEMANAFIM
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column SEMANAINI (
            type: plainText
            heading {
                heading: Semana Início
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: SEMANAINI
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 3308809 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn DESCRICAO (
                sequence: 1
            )

            displayColumn SEMANAFIM (
                sequence: 3
            )

            displayColumn SEMANAINI (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Nova Campanha
        layout {
            sequence: 30
            region: @lista-de-campanhas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 186
                clearCache: 186
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

