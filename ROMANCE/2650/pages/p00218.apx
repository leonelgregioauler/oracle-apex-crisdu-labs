page 218 (
    name: Despesas Lojas
    title: Despesas Lojas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region despesas-lojas (
        name: Despesas Lojas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialfavorita( f.idfilialfavorita ) loja
                     , sum(d.valor*f.fatorconversao) total
                from fechamentossemanais f
                   , despesas            d
                where f.idfilialfavorita is not null
                  and f.idfechamento = d.idfechamento
                  and f.idsemana     = ( select f.idsemana 
                                         from fechamentossemanais f 
                                         where f.idfechamento = :P218_IDFECHAMENTO )
                group by f.idfilialfavorita 
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2551507282263104304
        }

        column LOJA (
            type: plainText
            heading {
                heading: Loja
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column TOTAL (
            type: plainText
            heading {
                heading: Total
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 25515169 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn LOJA (
                sequence: 1
            )

            displayColumn TOTAL (
                sequence: 2
            )

        )

    )

    region detalhado (
        name: Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialfavorita( f.idfilialfavorita ) loja
                     , d.datavencimento
                     , d.observacao
                     , d.valor*f.fatorconversao valor
                from fechamentossemanais f
                   , despesas            d
                where f.idfilialfavorita is not null
                  and f.idfechamento = d.idfechamento
                  and f.idsemana     = ( select f.idsemana 
                                         from fechamentossemanais f 
                                         where f.idfechamento = :P218_IDFECHAMENTO )
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 2457304124268048543
        }

        column DATAVENCIMENTO (
            type: plainText
            heading {
                heading: Data
            }
            layout {
                sequence: 20
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column LOJA (
            type: plainText
            heading {
                heading: Loja
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observacao
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 25514991 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAVENCIMENTO (
                sequence: 2
            )

            displayColumn LOJA (
                sequence: 1
            )

            displayColumn OBSERVACAO (
                sequence: 4
            )

            displayColumn VALOR (
                sequence: 3
            )

        )

    )

    pageItem P218_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @despesas-lojas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P218_IDFECHAMENTO_1 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @detalhado
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

