    validation conta-caracteres (
        name: Conta Caracteres
        execution {
            sequence: 120
        }
        validation {
            editableRegion: @razão-social
            type: plsqlError
            plsqlCodeRaisingError:
                ```plsql
                DECLARE
                V_TESTE NUMBER;
                BEGIN
                SELECT LENGTH(:CNPJ)
                INTO V_TESTE
                FROM DUAL;
                --
                IF V_TESTE > 14 THEN
                  --
                  RAISE_APPLICATION_ERROR(-20001,'TESTE');
                  --
                END IF;
                --
                END;
                ```
        }
        error {
            errorMessage: Máximo 14 dígitos no campo CNPJ
            associatedColumn: CNPJ
        }
    )

    validation idcidade-must-be-numeric (
        name: IDCIDADE must be numeric
        execution {
            sequence: 90
        }
        validation {
            editableRegion: @razão-social
            type: columnIsNumeric
            column: IDCIDADE
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDCIDADE
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idfilial-must-be-numeric (
        name: IDFILIAL must be numeric
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @razão-social
            type: columnIsNumeric
            column: IDFILIAL
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDFILIAL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation p133-tipofilial (
        name: P133_TIPOFILIAL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P133_TIPOFILIAL
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P133_TIPOFILIAL
        }
    )

    validation valida-numeros (
        name: Valida Numeros
        execution {
            sequence: 110
        }
        validation {
            editableRegion: @razão-social
            type: plsqlError
            plsqlCodeRaisingError:
                ```plsql
                DECLARE
                V_TESTE NUMBER;
                BEGIN
                SELECT LENGTH(TRIM(TRANSLATE(:CNPJ, '0123456789', ' ')))
                INTO V_TESTE
                FROM DUAL;
                --
                IF V_TESTE > 0 THEN
                  --
                  RAISE_APPLICATION_ERROR(-20001,'TESTE');
                  --
                END IF;
                --
                END;
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Apenas números são permitidos no campo CNPJ
            associatedColumn: CNPJ
        }
        serverSideCondition {
            type: never
        }
    )

    validation valida-unidade-de-negocio (
        name: Valida Unidade de Negocio
        execution {
            sequence: 100
        }
        validation {
            type: itemIsNotNull
            item: P133_IDUNIDADEDENEGOCIO
        }
        error {
            errorMessage: Por favor, informe a Unidade de Negócio para finalizar o cadastro!
        }
        serverSideCondition {
            type: request=Value
            value: CREATE
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @razão-social
        target {
            tableName: RAZOESSOCIAISFILIAIS
            pkColumn: IDRAZAOSOCIALFILIAL
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# linha(s) atualizadas, #MRI_COUNT# linha(s) inserida(s).
        }
        advanced {
            executionMappingIdentifier: 761720828502121831
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process fetch-row-from-filiais (
        name: Fetch Row from FILIAIS
        type: autoRowFetch
        source {
            tableOwner: CATAL
            tableName: FILIAIS
            pkColumn: IDFILIAL
            pkItem: P133_IDFILIAL
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 184631727222455382
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDFILIAL.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P133_IDFILIAL := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184631929809455385
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-filiais (
        name: Process Row of FILIAIS
        type: autoRowProcessing
        target {
            tableOwner: CATAL
            tableName: FILIAIS
            pkColumn: IDFILIAL
            pkItem: P133_IDFILIAL
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela FILIAIS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184632122473455385
        }
    )

    process reset-page (
