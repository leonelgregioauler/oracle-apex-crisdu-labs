page 133 (
    name: Cadastro de Filial
    title: Cadastro de Filial
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 70%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-filial (
        name: Cadastro de Filial
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region razão-social (
        name: Razão Social
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDRAZAOSOCIALFILIAL",
                "IDRAZAOSOCIALFILIAL" IDRAZAOSOCIALFILIAL_DISPLAY,
                "IDFILIAL",
                "CNPJ",
                "RAZAOSOCIAL",
                "ENDERECO",
                "NUMERO",
                "BAIRRO",
                "IDCIDADE",
                "INSCRICAOESTADUAL",
                "ATIVO",
                "PRINCIPAL",
                "GRUPOCRISDU",
                "IDGRUPOFINANCEIRO",
                "CODIGOCONTABIL"
                from "#OWNER#"."RAZOESSOCIAISFILIAIS"
                where idfilial = :P133_IDFILIAL
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P133_IDFILIAL
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Não há cadastro.
        }
        componentAdvanced {
            stripHtml: true
        }

        column ATIVO (
            reportColumnQueryId: 11
            derivedColumn: N
            type: radioGroup
            heading {
                heading: Ativo
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Ativo;S,Inativo;N
            }
            layout {
                sequence: 11
            }
            element {
                numberOfColumns: 1
            }
        )

        column BAIRRO (
            reportColumnQueryId: 8
            derivedColumn: N
            type: textField
            heading {
                heading: Bairro
            }
            layout {
                sequence: 8
            }
            appearance {
                width: 16
            }
        )

        column CNPJ (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textField
            heading {
                heading: CNPJ
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 14
            }
        )

        column CODIGOCONTABIL (
            reportColumnQueryId: 15
            derivedColumn: N
            type: textField
            heading {
                heading: Código Contabil
                alignment: end
            }
            layout {
                sequence: 23
                columnAlignment: end
            }
        )

        column ENDERECO (
            reportColumnQueryId: 6
            derivedColumn: N
            type: textField
            heading {
                heading: Endereço
            }
            layout {
                sequence: 6
            }
            appearance {
                width: 20
            }
        )

        column GRUPOCRISDU (
            reportColumnQueryId: 13
            derivedColumn: N
            type: radioGroup
            heading {
                heading: Grupo Crisdu
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Sim;S,Não;N
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 13
            }
            element {
                numberOfColumns: 1
            }
        )

        column IDCIDADE (
            reportColumnQueryId: 9
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Cidade
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomecidade||' - '||e.sigla display_value
                         , idcidade return_value
                    from cidades c
                       , estados e
                    where c.idestado = e.idestado
                    order by nomecidade
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 9
            }
            appearance {
                width: 16
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: item
                item: P133_IDFILIAL
            }
        )

        column IDGRUPOFINANCEIRO (
            reportColumnQueryId: 14
            derivedColumn: N
            type: selectList
            heading {
                heading: Grupo Financeiro
                alignment: end
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select grupo
                         , idgrupofinanceiro
                    from gruposfinanceiros 
                    order by 2
                    ```
            }
            layout {
                sequence: 21
                columnAlignment: end
            }
        )

        column IDRAZAOSOCIALFILIAL (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 1
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDRAZAOSOCIALFIL
            }
        )

        column IDRAZAOSOCIALFILIAL_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column INSCRICAOESTADUAL (
            reportColumnQueryId: 10
            derivedColumn: N
            type: textField
            heading {
                heading: I.E.
                alignment: center
            }
            layout {
                sequence: 10
            }
            appearance {
                width: 16
            }
        )

        column NUMERO (
            reportColumnQueryId: 7
            derivedColumn: N
            type: textField
            heading {
                heading: Número
            }
            layout {
                sequence: 7
            }
            appearance {
                width: 5
            }
        )

        column PRINCIPAL (
            reportColumnQueryId: 12
            derivedColumn: N
            type: radioGroup
            heading {
                heading: Principal
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Sim;S,Não;N
            }
            layout {
                sequence: 12
            }
            element {
                numberOfColumns: 1
            }
        )

        column RAZAOSOCIAL (
            reportColumnQueryId: 5
            derivedColumn: N
            type: textField
            heading {
                heading: Razão Social
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 30
            }
        )

