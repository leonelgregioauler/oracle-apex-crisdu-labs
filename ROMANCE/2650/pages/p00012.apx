page 12 (
    name: Anexar Arquivo
    title: Anexar Arquivo
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 60%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region anexar-arquivo (
        name: Anexar Arquivo
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <font color="green">Você pode anexar mais de um arquivo.</font>
            footerText: <font color="red" size="5"> ===========>>> Após selecionar o arquivo, clique em anexar.</font>
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDANEXOEVENTO,
                       IDCHAMADO,
                       ATTACH_DATA,
                       ATTACH_MIMETYPE,
                       ATTACH_FILENAME,
                       ATTACH_LAST_UPDATE,
                       ATTACH_CHARSET
                  from ANEXOSEVENTOS
                WHERE IDCHAMADO = :P12_IDCHAMADO
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1 
                FROM ANEXOSEVENTOS
                WHERE IDCHAMADO = :P12_IDCHAMADO
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }
        componentAdvanced {
            stripHtml: true
        }

        column ATTACH_CHARSET (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 7
            }
        )

        column ATTACH_DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column ATTACH_FILENAME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Arquivo
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column ATTACH_LAST_UPDATE (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 6
            }
        )

        column ATTACH_MIMETYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column IDANEXOEVENTO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column IDCHAMADO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Idchamado
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

    )

    region botões (
        name: Botões
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region registrar-evento (
        name: Registrar Evento
        type: list
        source {
            list: @registrar-evento
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    pageItem P12_ATTACH_CHARSET (
        type: hidden
        layout {
            sequence: 70
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACH_CHARSET
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P12_ATTACH_DATA (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            mimeTypeColumn: ATTACH_MIMETYPE
            filenameColumn: ATTACH_FILENAME
            charSetColumn: ATTACH_CHARSET
            bobLastUpdatedColumn: ATTACH_LAST_UPDATE
        }
        layout {
            sequence: 30
            region: @anexar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACH_DATA
            used: always
        }
    )

    pageItem P12_ATTACH_FILENAME (
        type: hidden
        layout {
            sequence: 50
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACH_FILENAME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P12_ATTACH_LAST_UPDATE (
        type: hidden
        layout {
            sequence: 60
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACH_LAST_UPDATE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P12_ATTACH_MIMETYPE (
        type: hidden
        layout {
            sequence: 40
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACH_MIMETYPE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P12_IDANEXOEVENTO (
        type: hidden
        layout {
            sequence: 10
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXOEVENTO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P12_IDCHAMADO (
        type: hidden
        layout {
            sequence: 20
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCHAMADO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar o arquivo que selecionei
        layout {
            sequence: 10
            region: @anexar-arquivo
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P12_IDANEXOEVENTO
        }
    )

    button save (
        buttonName: SAVE
        label: Finalizar
        layout {
            sequence: 10
            region: @botões
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 24
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process fetch-row-from-anexoseventos (
        name: Fetch Row from ANEXOSEVENTOS
        type: autoRowFetch
        source {
            tableName: ANEXOSEVENTOS
            pkColumn: IDANEXOEVENTO
            pkItem: P12_IDANEXOEVENTO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 223582673048140683
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P12_IDANEXOEVENTO is null then
                        select "#OWNER#"."SEQ_IDANEXOEVENTO".nextval
                          into :P12_IDANEXOEVENTO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 223583078219140684
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexoseventos (
        name: Process Row of ANEXOSEVENTOS
        type: autoRowProcessing
        target {
            tableName: ANEXOSEVENTOS
            pkColumn: IDANEXOEVENTO
            pkItem: P12_IDANEXOEVENTO
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 223583467737140684
        }
    )

    branch (
        name: limpa k
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 12
                items: {
                    P12_IDCHAMADO: &P12_IDCHAMADO.
                    P12_IDANEXOEVENTO:
                }
                action: resetPagination
                successMessage: false
            }
        }
    )

)

