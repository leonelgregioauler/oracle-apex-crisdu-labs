page 85 (
    name: Nova Venda
    title: Nova Venda
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region nova-venda (
        name: Nova Venda
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P85_DATA (
        type: hidden
        layout {
            sequence: 30
            region: @nova-venda
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                RETURN SYSDATE;
                END;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P85_DESCRICAO (
        type: textarea
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @nova-venda
            slot: regionBody
            alignment: left
            columnSpan: 1
            labelColumnSpan: 0
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
            height: 3
        }
        validation {
            maxLength: 200
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P85_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @nova-venda
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P85_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiaiscatal    f
                   , pessoascatal    p
                where f.idpessoa  = p.idpessoa
                  and f.idfilial = pck_romance.fnc_filialusuario(v('APP_USER') )
                ```
            displayNullValue: false
        }
        layout {
            sequence: 5
            region: @nova-venda
            slot: regionBody
            alignment: left
            columnSpan: 1
            labelColumnSpan: 0
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P85_IDFUNCIONARIO (
        type: hidden
        layout {
            sequence: 40
            region: @nova-venda
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFUNCIONARIO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P85_IDVENDADIRETA (
        type: hidden
        layout {
            sequence: 1
            region: @nova-venda
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDVENDADIRETA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P85_SEMANA (
        type: selectList
        label {
            label: Fechamento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana display_value
                , semana return_value
                from fechamentossemanais
                where idfechamento = :P85_IDFECHAMENTO
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @nova-venda
            slot: regionBody
            alignment: left
            columnSpan: 1
            labelColumnSpan: 0
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: databaseColumn
            databaseColumn: SEMANA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P85_USUARIO (
        type: hidden
        layout {
            sequence: 80
            region: @nova-venda
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
    )

    pageItem P85_VALORTOTAL (
        type: numberField
        label {
            label: Valor Total
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @nova-venda
            slot: regionBody
            alignment: left
            columnSpan: 1
            labelColumnSpan: 0
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 12
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: style="text-align: right;"
        }
        source {
            type: databaseColumn
            databaseColumn: VALORTOTAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @nova-venda
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 84
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @nova-venda
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P85_IDVENDADIRETA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @nova-venda
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P85_IDVENDADIRETA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @nova-venda
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P85_IDVENDADIRETA
        }
    )

    validation p85-descricao (
        name: P85_DESCRICAO
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P85_DESCRICAO
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P85_DESCRICAO
        }
    )

    validation p85-valortotal (
        name: P85_VALORTOTAL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P85_VALORTOTAL
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P85_VALORTOTAL
        }
    )

    process fetch-row-from-vendasdiretas (
        name: Fetch Row from VENDASDIRETAS
        type: autoRowFetch
        source {
            tableName: VENDASDIRETAS
            pkColumn: IDVENDADIRETA
            pkItem: P85_IDVENDADIRETA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 180560226794167387
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDVENDADIRETA.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P85_IDVENDADIRETA := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 180560434074167388
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-vendasdiretas (
        name: Process Row of VENDASDIRETAS
        type: autoRowProcessing
        target {
            tableName: VENDASDIRETAS
            pkColumn: IDVENDADIRETA
            pkItem: P85_IDVENDADIRETA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table VENDASDIRETAS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 180560614632167388
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        clear {
            type: pages
            pages: 62
        }
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 180560817565167388
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process set-usuario (
        name: Set Usuario
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  :P85_USUARIO := v('APP_USER');
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 1131437457835478637
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 85
            }
            saveStateBeforeBranching: true
        }
    )

)

