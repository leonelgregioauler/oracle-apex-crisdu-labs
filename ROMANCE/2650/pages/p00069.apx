    process update (
        name: update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  for i in ( select idfechamento
                             from fechamentossemanais 
                             where idfilial =( SELECT IDFILIAL FROM FECHAMENTOSSEMANAIS WHERE IDFECHAMENTO = :P69_IDFECHAMENTO )
                             ORDER BY 1 )
                  LOOP
                    --
                    pck_romance.prc_atualiza_fechamento(i.idfechamento, v('APP_USER'));
                    --
                  END LOOP;
                end;
                ```
        }
        execution {
            sequence: 5
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 179043814869975836
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P69_IDFECHAMENTO
        }
    )

