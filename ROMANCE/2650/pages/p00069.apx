    process atualzia-saldo-gaveta (
        name: atualzia saldo gaveta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update fechamentossemanais f
                  set f.saldoanteriorgaveta = ( select s.totalgaveta
                                                from fechamentossemanais s
                                                where s.idfilial = f.idfilial
                                                  and s.semana   = to_char(to_number(substr(f.semana,1,2))-1)||'/'||substr(f.semana,4,4) )
                  where f.idfechamento = :P69_IDFECHAMENTO;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Gaveta atualizada com sucesso!
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 179045425634873453
        }
        serverSideCondition {
            whenButtonPressed: @atualizar-saldo-gaveta
        }
    )

    process confirma-fechamento (
        name: confirma fechamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'N') then
                    --
                    if upper(TRIM(:P69_ASSINATURA)) = v('APP_USER') then
                      :P69_CONCLUIDO := 'S';
                    else
                      :P69_CONCLUIDO := 'N';
                    end if;
                    --
                  end if;
                end;
                ```
        }
        execution {
            sequence: 1
        }
        successMessage {
            successMessage: Fechamento concluído!
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 179937714784960196
        }
    )

