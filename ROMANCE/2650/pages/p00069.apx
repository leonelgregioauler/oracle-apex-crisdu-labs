    pageItem P69_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                where f.idpessoa  = p.idpessoa
                  and f.idfilial  = pck_romance.fnc_filialusuario(V('APP_USER'))
                  and :P69_IDFILIAL is null
                union
                select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                where f.idpessoa  = p.idpessoa
                  and :P69_IDFILIAL is not null 
                  and f.idfilial  = :P69_IDFILIAL
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @fechamento-semanal
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                vfilial number;
                begin
                select f.idfilial 
                into vfilial
                from filiais    f
                   , pessoas    p
                   , usuarios   u
                   , gerentes   g
                where f.idpessoa  = p.idpessoa
                  and g.idfilial  = f.idfilial
                  and u.idgerente = g.idgerente
                  and u.usuario   = V('APP_USER');
                return vfilial;
                EXCEPTION
                WHEN OTHERS THEN 
                NULL;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

