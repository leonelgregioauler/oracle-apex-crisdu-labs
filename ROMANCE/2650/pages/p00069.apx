page 69 (
    name: Fechamento Semanal
    title: Fechamento Semanal
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function enviaemail()
            {
              vsemana     = P69_SEMANA.options[P69_SEMANA.selectedIndex].value; 
              vcobranca   = document.getElementById('P69_TOTALCOBRANCA').value
              vgaveta     = document.getElementById('P69_TOTALGAVETA').value;
              vfechamento = document.getElementById('P69_IDFECHAMENTO').value
              vusuario    = document.getElementById('P69_USUARIO').value
              
               javascript:window.open("http://www.atacadofavorita.com.br/romance/sendmailfech.php?gerente="+vusuario+
                                                                                                 "&semana="+vsemana+
                                                                                                 "&cobranca="+vcobranca+
                                                                                                 "&gaveta="+vgaveta
             ,'MAIL','toolbar=no,location=no,status=no,menubar=yes,scrollbars=no,resizable=no,width=2,height=2,left=400,top=400','_blank'); void(0);  		
               
            }
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region aviso (
        name: Aviso
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  ventradas  varchar2(500);
                  vconte     number;
                  vdespesas  varchar2(500);
                  vcontd     number;
                  vsaidas    varchar2(500);
                  vconts     number;
                begin
                  --
                  select ent.obs
                       , ent.cont
                       , des.obs
                       , des.cont
                       , sai.obs
                       , sai.cont
                  into ventradas  
                     , vconte     
                     , vdespesas       
                     , vcontd     
                     , vsaidas    
                     , vconts     
                  from ( select '   -> '||count(1)||' entrada(s)' obs
                              , count(1) cont
                         from entradasdiversas
                         where idfechamento is null
                           and idfilial = ( select  f.idfilial 
                                            from filiais    f
                                               , usuarios   u
                                               , gerentes   g
                                            where g.idfilial  = f.idfilial
                                              and u.idgerente = g.idgerente
                                              and u.usuario   = v('APP_USER') ) ) ent
                                                   
                     , ( select '   -> '||count(1)||' despesa(s)' obs
                              , count(1) cont
                         from despesas
                         where idfechamento is null
                           and idfilial = ( select  f.idfilial 
                                            from filiais    f
                                               , usuarios   u
                                               , gerentes   g
                                            where g.idfilial  = f.idfilial
                                              and u.idgerente = g.idgerente
                                              and u.usuario   = v('APP_USER') ) ) des
                     , ( select '   -> '||count(1)||' saida(s) diversa(s) ' obs
                              , count(1) cont
                         from saidasdiversas
                         where idfechamento is null
                           and idfilial = ( select  f.idfilial 
                                            from filiais    f
                                               , usuarios   u
                                               , gerentes   g
                                            where g.idfilial  = f.idfilial
                                              and u.idgerente = g.idgerente
                                              and u.usuario   = v('APP_USER') ) ) sai;
                  --
                  if vconte != 0 or vcontd != 0 or vconts != 0 then
                    --
                    htp.p('<b>');
                    htp.p('Você tem:');
                    htp.br;
                    htp.br;
                    htp.p(ventradas);
                    htp.br;
                    htp.p(vdespesas);
                    htp.br;
                    htp.p(vsaidas);
                    htp.br;
                    htp.br;
                    htp.p(' pendente(s) de confirmação.');
                    htp.br;
                    htp.br;
                    htp.p('</b>');
                    --
                  end if;
                  --
                end;
                
                ```
        }
        layout {
            sequence: 5
            slot: body-3
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        serverSideCondition {
            type: never
        }
    )

