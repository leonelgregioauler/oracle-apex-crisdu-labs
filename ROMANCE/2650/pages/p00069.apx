    pageItem P69_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(s.semana,'00')||'/'||to_char(s.ano)) ||' ('||dt_ini||' a '||dt_fim||')'
                     , trim(to_char(s.semana,'00')||'/'||to_char(s.ano))
                from semana_dias s
                where trim(to_char(s.semana,'00')||'/'||to_char(s.ano)) = pck_romance.fnc_retornasemanafechamento(psemanatela => null,   pusuario => v('APP_USER')) ;
                ```
            displayNullValue: false
        }
        layout {
