            type: databaseColumn
            databaseColumn: TOTALCOMISSAOGERENTE
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vvalor    number(15,2);
                  vcomissao number(15,2);
                  --
                begin
                  --
                  select g.perccomissao
                  into vcomissao
                  from gerentes g
                  where g.idfilial = :P69_IDFILIAL;
                  ---
                  select sum(totalgeral)*vcomissao/100
                  into vvalor
                  from fechamentorepresentantes f
                  where f.semana = :P69_SEMANA
                    and f.idfilial = :P69_IDFILIAL;
                  --
                  return to_char(nvl(vvalor,0),'999G999G999G990D00') ;
                  --
                end;
                ```
