    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDFECHAMENTOSEMANAL.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P69_IDFECHAMENTO := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 179003910515883602
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process insere-novo (
        name: insere novo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vsemana     varchar2(50);
                  verro       varchar2(500);
                  vidfilial   number := :P69_IDFILIAL;
                  vusuario    varchar2(20) :=  v('APP_USER');
                  --
                begin
                  --
                  if vidfilial = pck_romance.fnc_filialusuario(v('APP_USER')) then
                    --
                    begin
                      select TRIM(pck_romance.fnc_retornasemanafechamento(psemanatela => null,  pusuario => trim(vusuario)))
                      into vsemana
                      from dual
                      where not exists ( select 1 
                                         from fechamentossemanais f
                                         where f.semana = TRIM(pck_romance.fnc_retornasemanafechamento(psemanatela => null,  pusuario => trim(vusuario)))
                                           and f.idfilial = vidfilial);
                    exception
                      when others then
                        verro := sqlerrm;
                        vsemana := null;
                    end;
                    --
                    if vsemana is not null and length(vsemana) > 5 then
                      insert into fechamentossemanais ( idfechamento , idfilial , semana )
                      values ( seq_idfechamentosemanal.nextval, vidfilial, vsemana);
                    end if;
                    --
                  end if;
                end;
                ```
        }
        execution {
            sequence: 60
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 314275816648821908
        }
    )

