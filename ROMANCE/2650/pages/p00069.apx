    region pagamentos-manutenções (
        name: Pagamentos Manutenções
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idpgtomanutencao
                     , idmanutencao
                     , ( select pck_romance.fnc_nomerepresentante(idrepresentante)
                         from manutencoesrealizadas m
                         where m.idmanutencao = p.idmanutencao ) representante
                     , datapagamento
                     , valorpago
                     , emmaos
                from pagamentosmanutencoes p
                where p.idfechamentorepres in ( select f.idfechamentorepres 
                                                from fechamentorepresentantes F
                                                where idfechamento = :P69_IDFECHAMENTO )
                ```
        }
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
