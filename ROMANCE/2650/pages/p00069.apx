    pageItem P69_TOTALCHQSEMFUNDORECEBIDOS (
        type: numberField
        label {
            label: Cheques Sem Fundo Recebidos
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 230
            region: @fechamento-semanal
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 15
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: TOTALCHQSEMFUNDORECEBIDOS
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vvalor number(15,2);
                  --
                begin
                  --
                    select SUM(cp.valor)
                    into vvalor 
                    from cheques2pgto cp
                       , cheques2     c
                       , representantes r
                       , gerentes g
                    where cp.idcheque = c.idcheque
                      and c.semfundo  = 'S'
                      and c.Idrepresentante = r.idrepresentante
                      and r.idgerente       = g.idgerente
                      and g.idfilial        = :P69_IDFILIAL
                      and to_char(cp.datapgto,'IW/RRRR') = :P69_SEMANA;
                  --
                  return replace(to_char(NVL(vvalor,0),'999G999G999G990D00'),' ','') ;
                  --
                exception
                  when others then
                    return replace(to_char(0,'999G999G999G990D00'),' ','') ;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

