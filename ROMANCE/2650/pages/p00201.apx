                column: SEMANA
                sort {
                    sequence: 1
                }
            )

            sort (
                column: DOCUMENTO
                sort {
                    sequence: 2
                }
            )

            filter ir-condition (
                column: ANO
                value: 2012
            )

            filter ir-condition-2 (
                column: EMITENTE
                value: Sim Indústria
            )

            filter ir-condition-3 (
                column: SITUACAO
                value: Ativa
            )

            filter ir-condition-4 (
                type: rowExpression
                rowExpression: AA != AB
                identification {
                    name: Venctos Fábr. != Itens Fábr.
                }
                advanced {
                    enabled: false
                }
            )

            filter ir-condition-5 (
                type: rowExpression
                rowExpression: AA != Y
                identification {
                    name: Venctos Fábr. != Venctos Roman.
                }
                advanced {
                    enabled: false
                }
            )

            filter ir-condition-6 (
                type: rowExpression
                rowExpression: AB != Z
                identification {
                    name: Itens Fábr. != Itens Roman.
                }
                advanced {
                    enabled: false
                }
            )

            filter ir-condition-7 (
                type: rowExpression
                rowExpression: Y != Z
                identification {
                    name: Vencimentos != Itens
                }
                advanced {
                    enabled: false
                }
            )

            controlBreak (
                column: SEMANA
                layout {
                    sequence: 1
                }
                advanced {
                    enabled: false
                }
            )

        )

    )

