    region lista-de-notas-fiscais (
        name: Lista de Notas Fiscais
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.IDNOTAFISCAL
                     , to_char(nf.dtnf,'IW')||'/'||to_char(nf.dtnf,'RRRR') Semana
                     , to_char(nf.dtnf,'RRRR') ANO
                     , nf.nrnf 
                     , decode( nf.tiponota, 'T', 'Transferência'
                                          , 'C', 'Compra'
                                          , 'V', 'Venda' ) "Tipo NF"
                     , decode( nf.tiponota, 'T', pck_romance.fnc_nomefilial(pidfilial => nf.idfilialemitente  )
                                          , 'C', pck_romance.fnc_nomefornecedor(pidforn =>  nf.idfornemitente  )
                                          , 'V', pck_romance.fnc_nomefornecedor(nf.idfornemitente)  ) Emitente
                     , pck_romance.fnc_nomefornecedor(nf.idfornecedordestino)  "Fornecedor Destino"
                     , pck_romance.fnc_nometransportadora(pidtransp => nf.idtransportadora )  "Transportadora"
                     , nf.dtnf 
                     , ( select sum(valor) from vencimentosreceber v where v.idnotafiscal = nf.idnotafiscal ) totalvencimentos
                     , ( select sum((nvl(qtd_pp,0) + nvl(qtd_p,0) + nvl(qtd_m,0) + nvl(qtd_g,0) + nvl(qtd_gg,0) + nvl(qtd_egg,0) + nvl(qtd_u,0)) * inf.custound)
                         from itemnf inf
                         where inf.idnotafiscal = nf.idnotafiscal
                           and inf.idproduto    is not null) totalitens
                     , ( select sum(valor) + ( sum(valor) *0.1)   from vencimentos v where v.idnotafiscal = nf.idnotafiscal ) valortotalfilial
                     , decode(NF.SITUACAO,'A','Ativa','C','Cancelada','Ativa') Situacao
                     , decode(NF.SITUACAOFILIAL,'A','Aguardando Recebimento','R','Recebida') "Situação Recebimento"
                     , nf.documento 
                     , initcap(nf.USUARIO) "Usuário"
                     , nf.conhecimentotransporte "CTE"
                     , nf.observacao "Observação"
                 /*    , ( select sum(valor) 
                         from fabri.vencimentosnotavenda v 
                         where v.idnotavenda = ( select idnotavenda
                                                    from fabri.notasvendas nv
                                                    where nv.nrodocumento = nf.documento ) ) totalvencimentosfabrica
                     , ( select sum((nvl(qtd_pp,0) + nvl(qtd_p,0) + nvl(qtd_m,0) + nvl(qtd_g,0) + nvl(qtd_gg,0) + nvl(qtd_egg,0) + nvl(qtd_u,0)) * inv.valorvenda)
                         from fabri.itensnotavenda inv
                         where inv.idnotavenda = ( select idnotavenda
                                                    from fabri.notasvendas nv
                                                    where nv.nrodocumento = nf.documento ) ) totalitensfabrica*/
                     , ( select pc.idpedidocompra from pedidoscompras pc where pc.idpedidocompra = nf.idpedidocompra ) "Pedido de Compra"
                     , nfc.documento  "Doc Compra"
                     , nf.DATARECEBIMENTO "Data Recebimento"
                     , pck_romance.fnc_nomefilial(nfc.idfilialdestino) "Filial Destino Compra"
                     , pck_romance.fnc_nomefilial(nfc.idfilialemitente) "Filial Origem Compra"
                     , pck_romance.fnc_nomefornecedor(nfc.idfornemitente) "Fornecedor Compra"
                from notasfiscais nf
                   , notasfiscais nfc
                where nf.tiponota = 'V'
                  and nfc.idnotafiscal = nf.idnotafiscalcompra(+)
                  order by 2, 9 desc
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
