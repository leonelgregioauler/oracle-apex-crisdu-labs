        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 67
                items: {
                    P67_IDFECHAMENTOREPRES: &P67_IDFECHAMENTOREPRES.
                    P67_IDREPRESENTANTE: &P67_IDREPRESENTANTE.
                    P67_IDBOLETO:
                }
