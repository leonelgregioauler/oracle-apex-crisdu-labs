    pageItem P67_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: above
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.dt_ini,'IW')||'/'||to_char(s.dt_ini,'rrrr') display_value
                     , to_char(s.dt_ini,'IW')||'/'||to_char(s.dt_ini,'rrrr') return_value
                from semana_dias s
                where ano    = to_char(sysdate,'rrrr')
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @boletos-favorita
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: databaseColumn
            databaseColumn: SEMANA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_char(sysdate,'IW/RRRR');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

