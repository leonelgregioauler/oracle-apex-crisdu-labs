page 67 (
    name: Boletos Favorita
    title: Boletos Favorita
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region boletos-favorita (
        name: Boletos Favorita
        type: staticContent
        source {
            htmlCode:
                ```html
                <script language="javascript">
                function  confirmaboleto(event)
                { 
                var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
                
                if (tecla==13) {
                var answer = confirm("Confirma inclusão de boleto?")
                	if (answer){            
                		apex.submit('CREATE');
                	}
                }
                }
                </script>
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region lista-de-boletos-incluidos (
        name: Lista de Boletos incluidos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idboleto
                     , idrepresentante
                     , idfechamentorepres
                     , ano
                     , semana
                     , numeroboleto
                     , observacao
                     , valor
                from boletosfavorita
                where idfechamentorepres = :P67_IDFECHAMENTOREPRES
                ```
        }
        layout {
            sequence: 20
            parentRegion: @boletos-favorita
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/search-results
            templateOptions: #DEFAULT#
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum boleto incluido.
        }
        componentAdvanced {
            stripHtml: true
        }

        column ANO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column IDBOLETO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            link {
                target: {
                    page: 67
                    items: {
                        P67_IDBOLETO: #IDBOLETO#
                    }
                }
                linkText: <img src="#IMAGE_PREFIX#menu/pencil2_16x16.gif" alt="">
            }
        )

        column IDFECHAMENTOREPRES (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column IDREPRESENTANTE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column NUMEROBOLETO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Número Boleto
                alignment: center
            }
            layout {
                sequence: 6
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 7
            }
        )

        column SEMANA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column VALOR (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Valor
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
        )

    )

