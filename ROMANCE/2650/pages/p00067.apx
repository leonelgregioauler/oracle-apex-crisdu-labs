    pageItem P67_IDFILIAL (
        type: hidden
        layout {
            sequence: 50
            region: @boletos-favorita
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                vidfilial number;
                begin
                select f.idfilial return_value
                into vidfilial
                from filiais    f
                   , pessoas    p
                   , usuarios   u
                   , gerentes   g
                where f.idpessoa  = p.idpessoa
                  and g.idfilial  = f.idfilial
                  and u.idgerente = g.idgerente
                  and u.usuario   = v('APP_USER');
                return vidfilial;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

