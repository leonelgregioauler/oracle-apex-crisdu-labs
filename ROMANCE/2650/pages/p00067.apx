    validation p67-numeroboleto (
        name: P67_NUMEROBOLETO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P67_NUMEROBOLETO
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P67_NUMEROBOLETO
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation p67-valor (
        name: P67_VALOR
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where nvl(:P67_VALOR,0)>0
                ```
        }
        error {
            errorMessage: #LABEL# deve ser maior que zero.
            associatedItem: @P67_VALOR
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process fetch-row-from-boletosfavorita (
        name: Fetch Row from BOLETOSFAVORITA
        type: autoRowFetch
        source {
            tableName: BOLETOSFAVORITA
            pkColumn: IDBOLETO
            pkItem: P67_IDBOLETO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 178986824494771428
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDBOLETOFAVORITA.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P67_IDBOLETO := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 178987024053771428
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-boletosfavorita (
        name: Process Row of BOLETOSFAVORITA
        type: autoRowProcessing
        target {
            tableName: BOLETOSFAVORITA
            pkColumn: IDBOLETO
            pkItem: P67_IDBOLETO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table BOLETOSFAVORITA.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 178987238356771428
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 178987432343771429
        }
        serverSideCondition {
