page 6 (
    name: Novo Evento
    title: Novo Evento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region botoões (
        name: Botoões
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region novo-evento (
        name: Novo Evento
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region registrar-evento (
        name: Registrar Evento
        type: list
        source {
            list: @registrar-evento
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    pageItem P6_DATAABERTURA (
        type: hidden
        layout {
            sequence: 20
            region: @novo-evento
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATAABERTURA
            used: always
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P6_DESCRICAO (
        type: textarea
        label {
            label: Descrição
            alignment: left
        }
        layout {
            sequence: 70
            region: @novo-evento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 80
            height: 14
            valuePlaceholder: Informe a sua solicitação, se possível com um exemplo.
        }
        validation {
            maxLength: 3000
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P6_DESTINO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @novo-evento
            slot: regionBody
        }
        default {
            type: static
            staticValue: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P6_IDACESSOREMOTO (
        type: textField
        label {
            label: Acesso Remoto
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 80
            region: @novo-evento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            type: databaseColumn
            databaseColumn: IDACESSOREMOTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P6_IDCHAMADO (
        type: hidden
        layout {
            sequence: 10
            region: @novo-evento
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCHAMADO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P6_IDGRUPOATENDIMENTO (
        type: selectList
        label {
            label: Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.descricao  display_value
                     , g.idgrupoatendimento return_value
                from roman.gruposatendimento g
                where g.ativo = 'S'
                  and g.idsistema = 2500
                  and g.idgrupoatendimento not in (116) --Ajuste ticket 16938684
                order by 1
                ```
        }
        layout {
            sequence: 50
            region: @novo-evento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDGRUPOATENDIMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P6_MENSAGEM (
        type: displayOnly
        label {
            label: Mensagem
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 40
            region: @novo-evento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<h2 align="middle">'||mensagem||'</h2>' mensagem
                from mensagensaviso
                where diadasemana = TO_CHAR(SYSDATE,'D')
                  and TO_CHAR(SYSDATE,'HH24:MI:SS') between horarioini and horariofim
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P6_MENSAGEMORCAMENTO (
        type: displayOnly
        label {
            label: ->
            alignment: left
        }
        layout {
            sequence: 60
            region: @novo-evento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: Lembre-se de realizar dois orçamentos para solicitação de compras.
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P6_TELEFONECONTATO (
        type: textField
        label {
            label: Telefone
            alignment: left
        }
        layout {
            sequence: 110
            region: @novo-evento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 15
        }
        source {
            type: databaseColumn
            databaseColumn: TELEFONECONTATO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P6_TIPOEVENTO (
        type: hidden
        layout {
            sequence: 90
            region: @novo-evento
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: TIPOEVENTO
            used: always
        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P6_USUARIO (
        type: hidden
        layout {
            sequence: 30
            region: @novo-evento
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: expression
            plsqlExpression: v('APP_USER')
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @botoões
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 4
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Próximo Passo
        layout {
            sequence: 20
            region: @botoões
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P6_IDCHAMADO is null
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction escolha-o-destino (
        name: Escolha o Destino
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P6_IDGRUPOATENDIMENTO
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ESCOLHA_DESTINO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P6_IDGRUPOATENDIMENTO
        }
        clientSideCondition {
            type: item=value
            item: P6_IDGRUPOATENDIMENTO
            value: 2
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P6_MENSAGEMORCAMENTO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P6_MENSAGEMORCAMENTO
            }
            execution {
                sequence: 10
            }
        )

    )

    validation valida-descrição (
        name: Valida Descrição
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P6_DESCRICAO
        }
        error {
            errorMessage: Por favor, informe alguma descrição para nós.
        }
        serverSideCondition {
            type: request!=Value
            value: ESCOLHA_DESTINO
        }
    )

    validation valida-telefone (
        name: Valida telefone
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P6_TELEFONECONTATO
        }
        error {
            errorMessage: Por favor, informe seu telefone.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P6_IDGRUPOATENDIMENTO in ('0','116', '2')  AND :REQUEST != 'ESCOLHA_DESTINO'
        }
    )

    process fetch-row-from-chamados (
        name: Fetch Row from CHAMADOS
        type: autoRowFetch
        source {
            tableName: CHAMADOS
            pkColumn: IDCHAMADO
            pkItem: P6_IDCHAMADO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 215885612822100878
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P6_IDCHAMADO is null then
                        select "#OWNER#"."SEQ_IDCHAMADO".nextval
                          into :P6_IDCHAMADO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 215886054144100879
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-chamados (
        name: Process Row of CHAMADOS
        type: autoRowProcessing
        target {
            tableName: CHAMADOS
            pkColumn: IDCHAMADO
            pkItem: P6_IDCHAMADO
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 215886481580100879
        }
    )

    branch (
        name: Go To Page 6
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 6
                items: {
                    P6_IDGRUPOATENDIMENTO: &P6_IDGRUPOATENDIMENTO.
                    P6_DESTINO: &P6_IDGRUPOATENDIMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: ESCOLHA_DESTINO
        }
    )

    branch (
        name: redireciona
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 12
                items: {
                    P12_IDCHAMADO: &P6_IDCHAMADO.
                    P12_IDANEXOEVENTO:
                }
                action: resetPagination
                successMessage: false
            }
        }
        serverSideCondition {
            type: request!=Value
            value: ESCOLHA_DESTINO
        }
    )

)

