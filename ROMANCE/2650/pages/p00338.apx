    region últimos-7-dias-quantidade (
        name: Últimos 7 dias (Quantidade)
        type: chart
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        performance {
            lazyLoading: true
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series dados (
            name: Dados
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(tt.data,'dd/Mon (Dy)') data, pck_romance.fnc_nomefilial(tt.idfilial) dado , nvl(dr.qtd,0) qtde
                    from vw_depositosrecebidosfiliais dr
                       , ( select distinct d.idfilial 
                                , u7.data data
                           from vw_depositosrecebidosfiliais d
                              , beeweb.vw_ultimos_7_dias u7
                           where u7.data >= trunc(sysdate-8)) tt
                    where dr.idfilial(+)    = tt.idfilial
                      and dr.datarevisao(+) = tt.data 
                    order by tt.data
                    ```
            }
            columnMapping {
                seriesName: DADO
                label: DATA
                value: QTDE
            }
        )

        axis x (
            name: x
            title: Data
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Quantidade
            value {
                format: decimal
            }
            appearance {
                position: bottom
            }
            majorTicks {
                show: auto
            }
            minorTicks {
                show: true
            }
        )

    )

    region últimos-7-dias-revisados (
        name: Últimos 7 dias Revisados
        type: chart
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        performance {
            lazyLoading: true
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series dados (
            name: Dados
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(tt.data,'dd/Mon (Dy)') data, tt.usuariorevisao dado , nvl(dr.qtd,0) qtde
                    from vw_depositosrevisados_rmc dr
                       , ( select distinct d.usuariorevisao 
                                , u7.data data
                           from vw_depositosrevisados_rmc d
                              , beeweb.vw_ultimos_7_dias u7
                           where u7.data >= trunc(sysdate-8)  ) tt
                    where dr.usuariorevisao(+) = tt.usuariorevisao
                      and dr.datarevisao(+)    = tt.data 
                      and dr.qtd               > 0
                    order by tt.data
                    ```
            }
            columnMapping {
                seriesName: DADO
                label: DATA
                value: QTDE
            }
        )

        axis x (
            name: x
            title: Data
            minorTicks {
                show: false
            }
            tickLabel {
                position: inside
