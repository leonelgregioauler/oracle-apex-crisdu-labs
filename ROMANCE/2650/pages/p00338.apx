            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select usuariorevisao
                         , count(1) qtd
                    from depositosdiarios_leituraocr d
                    where extract ( month from d.dataleitura ) = to_char(sysdate,'MM')
                      and extract ( year from d.dataleitura ) = to_char(sysdate,'RRRR')  
                    group by d.usuariorevisao
                    ```
            }
            columnMapping {
                label: USUARIOREVISAO
                value: QTD
