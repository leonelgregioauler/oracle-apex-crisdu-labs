    region revisões-por-responsável (
        name: Revisões por Responsável
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(x.idfilial) empresa
                     , x.qtddep
                     , y.qtdrev
                     , y.valor
                     , y.revisado_por
                from ( select count(distinct(d.idleituraocr_deposito)) qtddep 
                            , d.idfilial
                       from roman.depositosdiarios_leituraocr d
                       where d.dataleitura between to_date(:P338_DATAINICIO ||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P338_DATAFIM ||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                       group by d.idfilial ) x
                   , ( select count(distinct(dp.idleituraocr_deposito)) qtdrev
                            , dp.usuariorevisao revisado_por
                            , dp.idfilial
                            , sum( nvl(dp.valor_digitado ,0) ) valor
                       from roman.depositosdiarios_leituraocr dp
                       where dp.dataleitura between to_date(:P338_DATAINICIO ||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P338_DATAFIM ||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                         and dp.datarevisao is not null
                       group by dp.idfilial, dp.usuariorevisao) y
                where x.idfilial = y.idfilial
                
                
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
