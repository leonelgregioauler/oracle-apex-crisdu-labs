    region fotos-pendentes (
        name: Fotos Pendentes
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select count(1) pendentes
                     , 'Pendentes de Conferência' d
                from depositosdiarios_leituraocr d
                where trunc(d.dataleitura) = trunc(sysdate)
                  and d.iddepositodiario is null
                ```
        }
        layout {
            sequence: 20
            parentRegion: @placar-do-dia
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: D
            valueColumn: PENDENTES
            color: yes
        }
    )

    region fotos-recebidas (
        name: Fotos Recebidas
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select count(1) quantidade
                     , 'Recebidas no dia de Hoje' d
                from depositosdiarios_leituraocr d
                where trunc(d.dataleitura) = trunc(sysdate)
                ```
        }
        layout {
            sequence: 10
            parentRegion: @placar-do-dia
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: D
            valueColumn: QUANTIDADE
            color: yes
        }
    )

    region fotos-recebidas-ultimos-7-dias (
        name: Fotos Recebidas Ultimos 7 Dias
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select to_char(u7.data,'dd/Mon (Dy)') data
                     , count(dl.iddepositodiario) qtd
                from beeweb.vw_ultimos_7_dias u7
                   , depositosdiarios_leituraocr dl
                where trunc(dl.dataleitura) = u7.data
                group by u7.data 
                order by u7.data desc
                ```
        }
        layout {
            sequence: 80
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DATA
            valueColumn: QTD
            colorScheme: modern2
            maximumRows: 7
        }
    )

    region fotos-revisadas (
        name: Fotos Revisadas
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select count(1) revisadas
                     , 'Revisadas no dia de Hoje' d
                from depositosdiarios_leituraocr d
                where trunc(d.dataleitura) = trunc(sysdate)
                  and d.iddepositodiario is not null
                  and d.usuariorevisao is not null
                ```
        }
        layout {
            sequence: 30
            parentRegion: @placar-do-dia
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: D
            valueColumn: REVISADAS
            color: yes
        }
    )

