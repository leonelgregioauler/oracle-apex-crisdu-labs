    region quantidade-de-revisados (
        name: Quantidade de Revisados
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null            link   
                     , m.mes           mes
                     , o.quantidade    "2022"
                from roman.meses m
                   , (  select 'Total' nome
                             , to_number(to_char(d.dataleitura,'MM')) mes
                             , count(1) quantidade
                        from depositosdiarios_leituraocr d
                        where extract (year from d.dataleitura) = 2022
                        group by to_number(to_char(d.dataleitura,'MM'))  ) o
                where m.numero  = o.mes(+)
                order by m.numero 
                ```
        }
        layout {
            sequence: 130
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            escapeSpecialChars: false
        }
