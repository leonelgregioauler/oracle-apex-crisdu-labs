        series dados (
            name: Dados
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(tt.data,'dd/Mon (Dy)') data, tt.usuariorevisao dado , nvl(dr.qtd,0) qtde
                    from vw_depositosrevisados_rmc dr
                       , ( select distinct d.usuariorevisao 
                                , d.datarevisao data
                           from vw_depositosrevisados_rmc d
                           where d.datarevisao between :P338_DATAINICIO and :P338_DATAFIM
                             and to_char(d.datarevisao,'d') <> '1' ) tt
                    where dr.usuariorevisao(+) = tt.usuariorevisao
                      and dr.datarevisao(+)    = tt.data 
                      and dr.qtd               > 0
                    order by tt.data
                    ```
            }
            columnMapping {
                seriesName: DADO
                label: DATA
                value: QTDE
            }
        )

        axis x (
