    region últimos-7-dias-valor (
        name: Últimos 7 dias (Valor)
        type: chart
        layout {
            sequence: 120
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        performance {
            lazyLoading: true
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series dados (
            name: Dados
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(tt.data,'dd/Mon (Dy)') data, pck_romance.fnc_nomefilial(tt.idfilial) dado , nvl(dr.valor,0) valor
                    from vw_depositosrecebidosfiliais dr
                       , ( select distinct d.idfilial 
                                , u7.data data
                           from vw_depositosrecebidosfiliais d
                              , beeweb.vw_ultimos_7_dias u7
                           where u7.data >= trunc(sysdate-8)
                             and to_char(u7.data,'d') <> '1' ) tt
                    where dr.idfilial(+)    = tt.idfilial
                      and dr.datarevisao(+) = tt.data 
                    order by tt.data
                    ```
            }
            columnMapping {
                seriesName: DADO
                label: DATA
                value: VALOR
            }
        )

        axis x (
            name: x
            title: Data
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Quantidade
            value {
                format: decimal
            }
            appearance {
                position: bottom
            }
            majorTicks {
                show: auto
            }
            minorTicks {
                show: true
            }
        )

    )

    pageItem P338_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P338_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process popula-data (
        name: Popula Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  select trunc(sysdate)
                       , trunc(sysdate)
                  into :P338_DATAINICIO
                     , :P338_DATAFIM
                  from dual;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 6138019039399544015
        }
        serverSideCondition {
            type: itemIsNull
            item: P338_DATAINICIO
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 338
                items: {
                    P338_DATAINICIO: &P338_DATAINICIO.
                    P338_DATAFIM: &P338_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

