        series por-empresa (
            name: Por Empresa
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomefilial(d.idfilial) empresa
                         , count(distinct(d.iddepositodiario)) qtd
                    from depositosdiarios_leituraocr d
                    where d.dataleitura between to_date(:P338_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P338_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                    group by d.idfilial
                    order by 2 desc
                    ```
            }
            columnMapping {
                label: EMPRESA
                value: QTD
            }
            appearance {
                color: #000000
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

        axis y-1 (
            name: y2
            minorTicks {
                show: false
            }
        )

    )

    region por-empresa-no-período (
        name: Por Empresa no Período
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(x.idfilial) empresa
                     , y.qtddep
                     , x.qtdrev
                     , y.valor
                from ( select count(distinct(d.idleituraocr_deposito)) qtdrev
                            , d.idfilial
                       from roman.depositosdiarios_leituraocr d
                       where d.dataleitura between to_date(:P338_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P338_DATAFIM ||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                         and d.datarevisao is not null 
                        -- and d.usuariorevisao is not null 
                       group by d.idfilial ) x  --Traz todos os depósitos revisados. 
                   , ( select count(distinct(dp.idleituraocr_deposito)) qtddep
                            , sum( nvl(dp.valor_digitado ,0) )valor
                            , dp.idfilial
                       from roman.depositosdiarios_leituraocr dp
                       where dp.dataleitura between to_date(:P338_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P338_DATAFIM ||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                       group by dp.idfilial ) y --Traz todos os depositos realizados.
                where x.idfilial = y.idfilial
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
