page 338 (
    name: "Depósitos "
    title: "Depósitos "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function doLoad()
            {
               setTimeout( "refresh()", 8000000 );
            }
            
            function refresh()
            {
            window.location.href = window.location;
            }
            ```
        executeWhenPageLoads: doLoad();
    }
    security {
        pageAccessProtection: unrestricted
    }

    region depósitos-sem-fotos (
        name: Depósitos sem fotos
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select count(1) semfoto
                     , 'Depósitos sem Foto' d
                from depositosdiarios_orig dd
                where dd.idpgtoforn is null
                  and dd.idvencimentoabatimento is null
                  and idrepresentante != 387
                  and not exists ( select 1
                                   from depositosdiarios_leituraocr d
                                   where d.iddepositodiario = dd.iddepositodiarios )
                ```
        }
        layout {
            sequence: 40
            parentRegion: @placar-do-dia
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: D
            valueColumn: SEMFOTO
            color: yes
        }
    )

