    dynamicAction muda-data-fim (
        name: Muda Data Fim
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P340_DATAFIM
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P340_DATAFIM
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ATUALIZAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction muda-data-inicio (
        name: Muda Data Inicio
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P340_DATAINICIO
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P340_DATAINICIO
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ATUALIZAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 340
                items: {
                    P340_TIPO_PESQUISA: &P340_TIPO_PESQUISA.
                    P340_DATAINICIO: &P340_DATAINICIO.
                    P340_DATAFIM: &P340_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR
        }
    )

)

