    region fornecedores-divergências (
        name: Fornecedores + Divergências
        type: plugin/d3PieChart
        source {
            sqlQuery:
                ```sql
                select t.fornecedor
                     , t.notas
                from (
                select pck_romance.fnc_nomefornecedor(f.idfornecedor) fornecedor
                     , nvl(notas.qtd,0) notas
                from fornecedores f
                   , (
                       select nf.idfornemitente idfornecedor
                            , count(nf.idnotafiscal) qtd
                       from notasfiscais nf
                       where nf.idfornemitente is not null
                         and nf.situacaofilial = 'R'
                         and trunc(nf.datarecebimento) between to_date(:P340_DATAINICIO) and to_date(:P340_DATAFIM)
                         and exists ( select 1
                                      from itemnf i
                                      where i.idnotafiscal = nf.idnotafiscal
                                        and ( nvl(i.qtd_pp,0)   != nvl(i.qtd_pp_chegou,0) 
                                           or nvl(i.qtd_p,0)    != nvl(i.qtd_p_chegou,0)
                                           or nvl(i.qtd_m,0)    != nvl(i.qtd_m_chegou,0)
                                           or nvl(i.qtd_g,0)    != nvl(i.qtd_g_chegou,0)
                                           or nvl(i.qtd_gg,0)   != nvl(i.qtd_gg_chegou,0)
                                           or nvl(i.qtd_egg,0)  != nvl(i.qtd_egg_chegou,0)
                                           or nvl(i.qtd_exgg,0) != nvl(i.qtd_exgg_chegou,0)
                                           or nvl(i.qtd_u,0)    != nvl(i.qtd_u_chegou,0) ) )
                       group by nf.idfornemitente ) notas
                where exists ( select 1                              
                               from notasfiscais nf
                               where nf.idfornemitente = f.idfornecedor
                                 and nf.situacaofilial = 'R' )
                  and f.idfornecedor = notas.idfornecedor(+)
                order by 2 desc ) t
                where rownum <= 10
                ```
            pageItemsToSubmit: [
                P340_TIPO_PESQUISA
                P340_DATAINICIO
                P340_DATAFIM
            ]
        }
        layout {
            sequence: 20
            parentRegion: @controle-de-recebimento-por-fornecedores-2
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent6
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: FORNECEDOR
            valueColumn: NOTAS
            width: 500
            displayOptions: [
                tooltip
                labels
                percentages
            ]
        }
    )

