    region total-divergências (
        name: Total Divergências
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select f.nome "Empresa"
                     , nvl(div.qtd,0) "Divergencias"
                from vw_filiais f
                   , ( 
                       select nf.idfilialdestino idfilial
                            , count(nf.idnotafiscal) qtd
                       from notasfiscais nf
                       where nf.situacaofilial  = 'R'
                         and trunc(nf.datarecebimento) between to_date(:P340_DATAINICIO) and to_date(:P340_DATAFIM)
                         and exists ( select 1
                                      from itemnf i
                                      where i.idnotafiscal = nf.idnotafiscal
                                        and ( nvl(i.qtd_pp,0)   != nvl(i.qtd_pp_chegou,0) 
                                           or nvl(i.qtd_p,0)    != nvl(i.qtd_p_chegou,0)
                                           or nvl(i.qtd_m,0)    != nvl(i.qtd_m_chegou,0)
                                           or nvl(i.qtd_g,0)    != nvl(i.qtd_g_chegou,0)
                                           or nvl(i.qtd_gg,0)   != nvl(i.qtd_gg_chegou,0)
                                           or nvl(i.qtd_egg,0)  != nvl(i.qtd_egg_chegou,0)
                                           or nvl(i.qtd_exgg,0) != nvl(i.qtd_exgg_chegou,0)
                                           or nvl(i.qtd_u,0)    != nvl(i.qtd_u_chegou,0) ) )
                       group by nf.idfilialdestino ) div
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and exists ( select 1
                               from notasfiscais nf
                               where nf.idfilialdestino = f.idfilial )
                  and f.idfilial = div.idfilial(+)
                order by 2 desc
                ```
            pageItemsToSubmit: [
                P340_TIPO_PESQUISA
                P340_DATAINICIO
                P340_DATAFIM
            ]
        }
        layout {
            sequence: 30
            parentRegion: @controle-de-recebimento-por-empresas
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: "Empresa"
            valueColumn: "Divergencias"
            maximumRows: 40
        }
    )

    region total-nf (
        name: Total NF
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select f.nome "Empresa"
                     , nvl(notas.qtd,0) "Recebidas"
                from vw_filiais f
                   , (
                       select nf.idfilialdestino idfilial
                            , count(nf.idnotafiscal) qtd
                       from notasfiscais nf
                       where nf.situacaofilial  = 'R'
                         and trunc(nf.datarecebimento) between to_date(:P340_DATAINICIO) and to_date(:P340_DATAFIM)
                       group by nf.idfilialdestino ) notas
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and exists ( select 1
                               from notasfiscais nf
                               where nf.idfilialdestino = f.idfilial )
                  and f.idfilial = notas.idfilial(+)
                order by 2 desc
                ```
            pageItemsToSubmit: [
                P340_TIPO_PESQUISA
                P340_DATAINICIO
                P340_DATAFIM
            ]
        }
        layout {
            sequence: 20
            parentRegion: @controle-de-recebimento-por-empresas
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: "Empresa"
            valueColumn: "Recebidas"
            maximumRows: 40
        }
    )

