    region controle-de-recebimento-por-fornecedores (
        name: Controle de Recebimento por Fornecedores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(f.idfornecedor) "Fornecedor"
                     , nvl(notas.qtd,0) "Notas"
                     , nvl(div.qtd,0) "Divergências"
                     , nvl(round((div.qtd/notas.qtd * 100),2),0) "% Divergência"
                     , nvl(resumo.qtdenviado,0) "Qtd Enviado"
                     , nvl(resumo.totalenviado,0) "R$ Enviado"
                     , nvl(resumo.qtdrecebido,0) "Qtd Recebido"
                     , nvl(resumo.totalrecebido,0) "R$ Recebido"
                from fornecedores f
                   , (
                       select nf.idfornemitente idfornecedor
                            , count(nf.idnotafiscal) qtd
                       from notasfiscais nf
                       where nf.idfornemitente is not null
                         and nf.situacaofilial = 'R'
                         and trunc(nf.datarecebimento) between to_date(:P340_DATAINICIO) and to_date(:P340_DATAFIM)
                       group by nf.idfornemitente ) notas
                   , (
                       select nf.idfornemitente idfornecedor
                            , count(nf.idnotafiscal) qtd
                       from notasfiscais nf
                       where nf.idfornemitente is not null
                         and nf.situacaofilial = 'R'
                         and trunc(nf.datarecebimento) between to_date(:P340_DATAINICIO) and to_date(:P340_DATAFIM)
                         and exists ( select 1
                                      from itemnf i
                                      where i.idnotafiscal = nf.idnotafiscal
                                        and ( nvl(i.qtd_pp,0)   != nvl(i.qtd_pp_chegou,0) 
                                           or nvl(i.qtd_p,0)    != nvl(i.qtd_p_chegou,0)
                                           or nvl(i.qtd_m,0)    != nvl(i.qtd_m_chegou,0)
                                           or nvl(i.qtd_g,0)    != nvl(i.qtd_g_chegou,0)
                                           or nvl(i.qtd_gg,0)   != nvl(i.qtd_gg_chegou,0)
                                           or nvl(i.qtd_egg,0)  != nvl(i.qtd_egg_chegou,0)
                                           or nvl(i.qtd_exgg,0) != nvl(i.qtd_exgg_chegou,0)
                                           or nvl(i.qtd_u,0)    != nvl(i.qtd_u_chegou,0) ) )
                       group by nf.idfornemitente ) div
                   , ( select nf.idfornemitente idfornecedor
                            , sum(nvl(i.qtd_pp,0)  
                                 +nvl(i.qtd_p,0)   
                                 +nvl(i.qtd_m,0)   
                                 +nvl(i.qtd_g,0)   
                                 +nvl(i.qtd_gg,0)  
                                 +nvl(i.qtd_egg,0) 
                                 +nvl(i.qtd_exgg,0)
                                 +nvl(i.qtd_u,0)) qtdenviado
                            , sum(nvl(i.qtd_pp_chegou,0) 
                                 +nvl(i.qtd_p_chegou,0)
                                 +nvl(i.qtd_m_chegou,0)
                                 +nvl(i.qtd_g_chegou,0)
                                 +nvl(i.qtd_gg_chegou,0)
                                 +nvl(i.qtd_egg_chegou,0)
                                 +nvl(i.qtd_exgg_chegou,0)
                                 +nvl(i.qtd_u_chegou,0)) qtdrecebido    
                            , sum(nvl(i.qtd_pp,0)  
                                 +nvl(i.qtd_p,0)   
                                 +nvl(i.qtd_m,0)   
                                 +nvl(i.qtd_g,0)   
                                 +nvl(i.qtd_gg,0)  
                                 +nvl(i.qtd_egg,0) 
                                 +nvl(i.qtd_exgg,0)
                                 +nvl(i.qtd_u,0)*i.custound) totalenviado
                            , sum(nvl(i.qtd_pp_chegou,0) 
                                 +nvl(i.qtd_p_chegou,0)
                                 +nvl(i.qtd_m_chegou,0)
                                 +nvl(i.qtd_g_chegou,0)
                                 +nvl(i.qtd_gg_chegou,0)
                                 +nvl(i.qtd_egg_chegou,0)
                                 +nvl(i.qtd_exgg_chegou,0)
                                 +nvl(i.qtd_u_chegou,0)*i.custound) totalrecebido    
                       from notasfiscais nf
                          , itemnf i
                       where i.idnotafiscal = nf.idnotafiscal
                         and nf.idfornemitente is not null
                         and trunc(nf.datarecebimento) between to_date(:P340_DATAINICIO) and to_date(:P340_DATAFIM)
                         and nf.situacaofilial = 'R'
                       group by nf.idfornemitente ) resumo
                where exists ( select 1                              
                               from notasfiscais nf
                               where nf.idfornemitente = f.idfornecedor
                                 and nf.situacaofilial = 'R' )
                  and f.idfornecedor = notas.idfornecedor(+)
                  and f.idfornecedor = div.idfornecedor(+)
                  and f.idfornecedor = resumo.idfornecedor(+)
                order by 2 desc
                ```
            pageItemsToSubmit: [
                P340_TIPO_PESQUISA
                P340_DATAINICIO
                P340_DATAFIM
            ]
        }
        layout {
            sequence: 30
            parentRegion: @controle-de-recebimento-por-fornecedores-2
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
