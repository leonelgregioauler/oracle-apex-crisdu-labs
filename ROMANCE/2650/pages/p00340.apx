    region resumo (
        name: Resumo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome "Empresa"
                     , nvl(notas.qtd,0) "Recebidas"
                     , nvl(div.qtd,0) "Divergencias"
                     , nvl(round((div.qtd/notas.qtd * 100),2),0) "% Divergência"
                     , nvl(resumo.qtdenviado,0) "Qtd Enviado"
                     , nvl(resumo.totalenviado,0) "R$ Enviado"
                     , nvl(resumo.qtdrecebido,0) "Qtd Recebido"
                     , nvl(resumo.totalrecebido,0) "R$ Recebido"
                from vw_filiais f
                   , (
                       select nf.idfilialdestino idfilial
                            , count(nf.idnotafiscal) qtd
                       from notasfiscais nf
                       where nf.situacaofilial  = 'R'
                         and trunc(nf.datarecebimento) between to_date(:P340_DATAINICIO) and to_date(:P340_DATAFIM)
                       group by nf.idfilialdestino ) notas
                   , ( 
                       select nf.idfilialdestino idfilial
                            , count(nf.idnotafiscal) qtd
                       from notasfiscais nf
                       where nf.situacaofilial  = 'R'
                         and trunc(nf.datarecebimento) between to_date(:P340_DATAINICIO) and to_date(:P340_DATAFIM)
                         and exists ( select 1
                                      from itemnf i
                                      where i.idnotafiscal = nf.idnotafiscal
                                        and ( nvl(i.qtd_pp,0)   != nvl(i.qtd_pp_chegou,0) 
                                           or nvl(i.qtd_p,0)    != nvl(i.qtd_p_chegou,0)
                                           or nvl(i.qtd_m,0)    != nvl(i.qtd_m_chegou,0)
                                           or nvl(i.qtd_g,0)    != nvl(i.qtd_g_chegou,0)
                                           or nvl(i.qtd_gg,0)   != nvl(i.qtd_gg_chegou,0)
                                           or nvl(i.qtd_egg,0)  != nvl(i.qtd_egg_chegou,0)
                                           or nvl(i.qtd_exgg,0) != nvl(i.qtd_exgg_chegou,0)
                                           or nvl(i.qtd_u,0)    != nvl(i.qtd_u_chegou,0) ) )
                       group by nf.idfilialdestino ) div
                   , ( select nf.idfilialdestino idfilial
                            , sum(nvl(i.qtd_pp,0)  
                                 +nvl(i.qtd_p,0)   
                                 +nvl(i.qtd_m,0)   
                                 +nvl(i.qtd_g,0)   
                                 +nvl(i.qtd_gg,0)  
                                 +nvl(i.qtd_egg,0) 
                                 +nvl(i.qtd_exgg,0)
                                 +nvl(i.qtd_u,0)) qtdenviado
                            , sum(nvl(i.qtd_pp_chegou,0) 
                                 +nvl(i.qtd_p_chegou,0)
                                 +nvl(i.qtd_m_chegou,0)
                                 +nvl(i.qtd_g_chegou,0)
                                 +nvl(i.qtd_gg_chegou,0)
                                 +nvl(i.qtd_egg_chegou,0)
                                 +nvl(i.qtd_exgg_chegou,0)
                                 +nvl(i.qtd_u_chegou,0)) qtdrecebido    
                            , sum(nvl(i.qtd_pp,0)  
                                 +nvl(i.qtd_p,0)   
                                 +nvl(i.qtd_m,0)   
                                 +nvl(i.qtd_g,0)   
                                 +nvl(i.qtd_gg,0)  
                                 +nvl(i.qtd_egg,0) 
                                 +nvl(i.qtd_exgg,0)
                                 +nvl(i.qtd_u,0)*i.custound) totalenviado
                            , sum(nvl(i.qtd_pp_chegou,0) 
                                 +nvl(i.qtd_p_chegou,0)
                                 +nvl(i.qtd_m_chegou,0)
                                 +nvl(i.qtd_g_chegou,0)
                                 +nvl(i.qtd_gg_chegou,0)
                                 +nvl(i.qtd_egg_chegou,0)
                                 +nvl(i.qtd_exgg_chegou,0)
                                 +nvl(i.qtd_u_chegou,0)*i.custound) totalrecebido    
                       from notasfiscais nf
                          , itemnf i
                       where i.idnotafiscal = nf.idnotafiscal
                         and trunc(nf.datarecebimento) between to_date(:P340_DATAINICIO) and to_date(:P340_DATAFIM)
                         and nf.situacaofilial = 'R'
                       group by nf.idfilialdestino ) resumo
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and exists ( select 1
                               from notasfiscais nf
                               where nf.idfilialdestino = f.idfilial )
                  and f.idfilial = notas.idfilial(+)
                  and f.idfilial = div.idfilial(+)
                  and f.idfilial = resumo.idfilial(+)
                ```
            pageItemsToSubmit: [
                P340_TIPO_PESQUISA
                P340_DATAINICIO
                P340_DATAFIM
            ]
        }
        layout {
            sequence: 10
            parentRegion: @controle-de-recebimento-por-empresas
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent13
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
