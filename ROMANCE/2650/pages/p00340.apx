                select pck_romance.fnc_nomefornecedor(f.idfornecedor) fornecedor
                     , nvl(notas.qtd,0) notas
                from fornecedores f
                   , (
                       select nf.idfornemitente idfornecedor
                            , count(nf.idnotafiscal) qtd
                       from notasfiscais nf
                       where nf.idfornemitente is not null
