page 293 (
    name: Saidas
    title: Saidas
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region saídas (
        name: Saídas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idsaida
                     , pck_romance.fnc_nomefilial(idfilialdest) destino
                     , semana
                     , data
                     , valortotal valor
                     , s.descricao 
                from saidasdiversas s
                where to_number(to_char( s.data,'MMRRRR')) = :P293_MESANO 
                  and s.idfilial = :P293_IDFILIAL
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 300
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: setPaginationSelectList
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: No data found.
        }
        breakFormatting {
            breakColumns: col1
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
        }

        column DATA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                defaultSequence: 1
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 6
            }
        )

        column DESTINO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Destino
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column IDSAIDA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column SEMANA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column VALOR (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

    )

    pageItem P293_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @saídas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P293_MESANO (
        type: textField
        label {
            label: Semana
            alignment: left
        }
        layout {
            sequence: 10
            region: @saídas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 8
        }
        advanced {
            customAttributes: readonly
        }
        security {
            encryptSessionState: false
        }
    )

)

