page 57 (
    name: "Cadastro de Histórico "
    title: "Cadastro de Histórico "
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
        executeWhenPageLoads:
            ```javascript-browser
            self.focus();
            opener.location.reload();
            self.focus();
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region histórico (
        name: Histórico
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P57_DATAFIM (
        type: datePickerJquery
        label {
            label: Data Término
            alignment: left
        }
        layout {
            sequence: 40
            region: @histórico
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr hh24:mi:ss
            width: 15
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: DATAFIM
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P57_DATAHISTORICO (
        type: datePickerJquery
        label {
            label: Data Início
            alignment: left
        }
        layout {
            sequence: 30
            region: @histórico
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr hh24:mi:ss
            width: 15
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: DATAHISTORICO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return to_char(sysdate, 'dd/mm/rrrr hh24:mi:ss');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P57_DESCRICAO (
        type: textarea
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @histórico
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 10
        }
        validation {
            maxLength: 2000
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P57_EMAIL (
        type: hidden
        layout {
            sequence: 70
            region: @histórico
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: EMAIL
            used: always
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P57_IDCHAMADO (
        type: numberField
        label {
            label: Nº de Chamado
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @histórico
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: readonly
        }
        source {
            type: databaseColumn
            databaseColumn: IDCHAMADO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                RETURN :P5_IDCHAMADO;
                END
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P57_IDHISTORICOCHAMADO (
        type: hidden
        layout {
            sequence: 1
            region: @histórico
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDHISTORICOCHAMADO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P57_USUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @histórico
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return v('APP_USER');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @histórico
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 47
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Salvar e Reabrir Ticket
        layout {
            sequence: 40
            region: @histórico
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P57_IDHISTORICOCHAMADO
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @histórico
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P57_IDHISTORICOCHAMADO
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @histórico
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P57_IDHISTORICOCHAMADO
        }
    )

    validation p57-datahistorico (
        name: P57_DATAHISTORICO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P57_DATAHISTORICO
        }
        error {
            errorMessage: #LABEL# deve ser informado.
            associatedItem: @P57_DATAHISTORICO
        }
    )

    validation p57-descricao (
        name: P57_DESCRICAO
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P57_DESCRICAO
        }
        error {
            errorMessage: #LABEL# deve ser preenchido.
            displayLocation: inlineWithField
            associatedItem: @P57_DESCRICAO
        }
    )

    process close-window (
        name: Close Window
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 232647317031499669
        }
        serverSideCondition {
            type: never
        }
    )

    process fetch-row-from-historicochamados (
        name: Fetch Row from HISTORICOCHAMADOS
        type: autoRowFetch
        source {
            tableName: HISTORICOCHAMADOS
            pkColumn: IDHISTORICOCHAMADO
            pkItem: P57_IDHISTORICOCHAMADO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 232647723410499669
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P57_IDHISTORICOCHAMADO
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDHISTORICOCHAMADO.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P57_IDHISTORICOCHAMADO := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 232646595742499668
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-historicochamados (
        name: Process Row of HISTORICOCHAMADOS
        type: autoRowProcessing
        target {
            tableName: HISTORICOCHAMADOS
            pkColumn: IDHISTORICOCHAMADO
            pkItem: P57_IDHISTORICOCHAMADO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela HISTORICOCHAMADOS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 232646173510499668
        }
    )

    process reabre-chamado (
        name: Reabre Chamado
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update chamados c
                  set c.idsituacao = 0
                    , DATAATENDIDO = null
                    , PERCCONCLUIDO = 0
                    , idsituacaokanban = 600
                  where c.idchamado = :P57_IDCHAMADO;
                  --
                  :P57_DESCRICAO := :P57_DESCRICAO||'. Evento reaberto.';
                  --
                 /* catal.pck_util.prc_enviaemail(ppara => 'ti@romancemoda.com.br',
                                                passunto => '[Informativo] Evento '||:P134_IDCHAMADO ||' reaberto.',
                                                ptexto => 'Olá!'||chr(10)||chr(10)||
                                                          'O evento nrº '||:P134_IDCHAMADO||' foi reaberto!'||chr(10)||chr(10)||
                                                          :P134_DESCRICAO||chr(10)||chr(10)||
                                                          'Atenciosamente,'||chr(10)||        
                                                          'TI - Romance Moda' );*/
                
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 493878600079236109
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from chamados c
                where c.idchamado = :P57_IDCHAMADO
                  and c.idsituacao in (40,2)
                ```
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 232646929021499668
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        name: Go To Page 57
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 57
                successMessage: false
            }
            saveStateBeforeBranching: true
        }
        comments {
            comments: Created 04-AGO-2011 10:22 by ROMAN
        }
    )

)

