            type: sqlQuery
            sqlQuery:
                ```sql
                select substr(sc.beneficiario,1,40) d, sc.idcontabanc r
                  from santander_contas sc
                 where sc.ativo = 'S'
                 order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todas -"
        }
