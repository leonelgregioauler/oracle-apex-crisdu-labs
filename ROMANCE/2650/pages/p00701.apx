page 701 (
    name: Pix Santander - Autorização
    title: Pix Santander - Autorizacao
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // Soma os pagamentos marcados e confirma exibindo o total antes de autorizar.
            function fnc_autorizar() {
              var total = 0, qtd = 0;
            
              $("input[name='f01']:checked").each(function () {
                qtd++;
                // valor exibido na coluna VALOR (ex.: "R$ 1.296,00"); a linha de
                // total geral nao tem checkbox e fica de fora
                var txt = $(this).closest("tr").find("td[headers='VALOR']").text().trim();
                txt = txt.replace(/[^0-9.,-]/g, "").replace(/\./g, "").replace(",", ".");
                var v = parseFloat(txt);
                if (!isNaN(v)) { total += v; }
              });
            
              if (qtd === 0) {
                apex.message.alert("Selecione ao menos um pagamento para autorizar.");
                return;
              }
            
              var fmt = total.toLocaleString("pt-BR", { minimumFractionDigits: 2,
                                                        maximumFractionDigits: 2 });
            
              var msg = "Voc\u00EA est\u00E1 autorizando " + qtd + (qtd === 1 ? " pagamento" : " pagamentos") +
                        " no total de R$ " + fmt + ".\n\n" +
                        "O dinheiro sai da conta imediatamente. Pix n\u00E3o tem estorno.\n\n" +
                        "Confirma?";
            
              apex.message.confirm(msg, function (ok) {
                if (ok) { apex.submit("AUTORIZAR"); }
              });
            }
            
            // Marca todos os pagamentos listados; se todos ja estiverem marcados, limpa.
            function fnc_selecionar_todos() {
              var cb = $("input[name='f01']");
              if (cb.length === 0) { return; }
              var marcar = cb.filter(":checked").length < cb.length;
              cb.prop("checked", marcar);
              tot701();
              $("#BTN_SEL_TODOS .t-Button-label").text(marcar ? "Limpar sele\u00E7\u00E3o" : "Selecionar todos");
            }
            
            // Contador do topo: quantos aguardam autorizacao e quantos estao marcados.
            function tot701() {
              var brl = function (v) { return v.toLocaleString("pt-BR", { style: "currency", currency: "BRL" }); };
              var valor = function (cb) {
                var t = $(cb).closest("tr").find("td[headers=VALOR]").text().trim();
                t = t.replace(/[^0-9.,-]/g, "").replace(/\./g, "").replace(",", ".");
                var v = parseFloat(t); return isNaN(v) ? 0 : v;
              };
              var cbs = $("input[name=f01]");
              var tq = cbs.length ? (+cbs.first().data("tqtd") || cbs.length) : 0;
              var tv = 0, sq = 0, sv = 0;
              cbs.each(function () { tv += valor(this); });
              cbs.filter(":checked").each(function () { sq++; sv += valor(this); });
              var html = "<b>" + tq + "</b> pagamento(s) aguardando autoriza\u00E7\u00E3o - <b>" + brl(tv) + "</b>" +
                         " \u00a0 | \u00a0 Selecionados: <b>" + sq + "</b> - <b>" + brl(sv) + "</b>";
              if (tq > cbs.length) {
                html += " \u00a0 <span class=\"u-danger-text\">(a lista mostra s\u00F3 " + cbs.length +
                        " - use os filtros para ver os demais)</span>";
              }
              $("#tot701").html(html);
            }
            $(function () {
              tot701();
              $(document).on("change", "input[name=f01]", tot701);
              $(document).on("apexafterrefresh", tot701);
            });
            ```
    }
    security {
        authorizationScheme: @autoriza-pix-santander
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent5
                t-Region--scrollBody
                t-Form--slimPadding
            ]
            renderComponents: belowContent
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            outputAs: text
        }
    )

    region pagamentos-aguardando-autorização (
        name: Pagamentos aguardando autorização
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(pf.idfornecedor) fornecedor
                       -- total da lista para o contador do topo (vale mesmo se passar de 1000)
                     , apex_item.checkbox2( p_idx        => 1
                                          , p_value      => px.idpix
                                          , p_attributes => 'data-tqtd="' || count(*) over () || '"' ) sel
                     , px.idpix
                     , px.idpgtoforn
                     , (select nf.documento from notasfiscais nf
                         where nf.idnotafiscal = pf.idnotafiscal) nrnf
                     , pf.dtvencimento
                       -- Tipo oficial do ERP (formaspagamentos), origem no vencimento. Subconsulta
                       -- no select (e nao left join): left join com subconsulta no ON junto do
                       -- outer apply da "Conta do grupo" da ORA-01799.
                     , nvl( ( select fp.descricao from formaspagamentos fp
                               where fp.idformapagamento = nvl( pf.tipopagamento
                                                              , (select v.tipopagamento from vencimentos v
                                                                  where v.idvencimento = pf.idvencimento) ) )
                          , '(' || px.forma || ')') tipo
                     , px.valor
                     , case px.forma
                         when 'DICT'   then 'Pix - Chave ' || px.dict_code_type || ': ' || px.dict_code
                         when 'BOLETO' then 'Boleto: ' || px.benef_nome || ' (' || substr(px.dict_code,1,20) || '...)'
                         when 'GUIA'   then 'Guia: ' || px.benef_nome || ' (' || substr(px.dict_code,1,20) || '...)'
                         else 'Pix - ' || px.benef_nome || ' - ' || px.benef_agencia || '/' || px.benef_conta
                       end destino
                     , nvl(px.benef_documento, px.dict_code) documento
                     , to_char(px.dt_post,'DD/MM/RRRR HH24:MI') enviado_em
                     , px.usuario_post enviado_por
                     , (select substr(cbp.beneficiario,1,30) from contasbancarias cbp
                         where cbp.idcontabanc = px.idcontapagamento) conta_pagadora
                       -- Conferencia do favorecido (fase 1: so informa). O banco devolve o
                       -- titular da chave no envio; compara com o cadastro da conta bancaria.
                     , case when px.forma = 'DICT' then
                         json_value(px.json_post_resp, '$.beneficiary.name') || ' - ' ||
                         json_value(px.json_post_resp, '$.beneficiary.documentNumber') end favorecido_banco
                     , case when px.forma not in ('BOLETO','GUIA') then
                         cbf.beneficiario || ' - ' || nvl(cbf.documento, 'sem CPF/CNPJ') end cadastro_conta
                     , case roman.pck_santander_pix.fnc_confere_favorecido(px.idpix)
                         when 'OK'            then '<span class="fa fa-check-circle u-success-text"></span> Confere'
                         when 'NOME'          then '<span class="fa fa-exclamation-triangle u-warning-text"></span> CPF/CNPJ confere, nome diferente'
                         when 'DOC_DIFERENTE' then '<span class="fa fa-times-circle u-danger-text"></span> <b>CPF/CNPJ diferente do cadastro</b>'
                           -- detalhe: mesmo nome? chave de CPF x cadastro de CNPJ (ou o contrario)?
                           || '<br><span style="font-size:11px">'
                           -- nome sem acento e so letras; mesmo comeco (12 letras) = mesmo nome
                           || case when length(regexp_replace(translate(upper(json_value(px.json_post_resp, '$.beneficiary.name')), unistr('\00C1\00C0\00C2\00C3\00C9\00CA\00CD\00D3\00D4\00D5\00DA\00DC\00C7'), 'AAAAEEIOOOUUC'), '[^A-Z]')) >= 6
                                    and substr(regexp_replace(translate(upper(json_value(px.json_post_resp, '$.beneficiary.name')), unistr('\00C1\00C0\00C2\00C3\00C9\00CA\00CD\00D3\00D4\00D5\00DA\00DC\00C7'), 'AAAAEEIOOOUUC'), '[^A-Z]'), 1, 12)
                                      = substr(regexp_replace(translate(upper(cbf.beneficiario), unistr('\00C1\00C0\00C2\00C3\00C9\00CA\00CD\00D3\00D4\00D5\00DA\00DC\00C7'), 'AAAAEEIOOOUUC'), '[^A-Z]'), 1, 12)
                                   then 'Mesmo nome, mas a' else 'A' end
                           || case when length(regexp_replace(json_value(px.json_post_resp, '$.beneficiary.documentNumber'), '[^0-9*]')) = 11
                                    and length(regexp_replace(cbf.documento, '[^0-9]')) = 14
                                   then ' chave é de CPF (conta pessoal) e o cadastro tem CNPJ (empresa)'
                                   when length(regexp_replace(json_value(px.json_post_resp, '$.beneficiary.documentNumber'), '[^0-9*]')) = 14
                                    and length(regexp_replace(cbf.documento, '[^0-9]')) = 11
                                   then ' chave é de CNPJ (empresa) e o cadastro tem CPF (pessoa)'
                                   else ' chave é de outro CPF/CNPJ, não o do cadastro'
                              end || '</span>'
                         when 'SEM_DOC'       then '<span class="fa fa-times-circle u-danger-text"></span> <b>Conta sem CPF/CNPJ no cadastro</b>'
                         when 'SEM_RETORNO'   then '<span class="fa fa-question-circle u-warning-text"></span> Banco não informou o favorecido'
                         else case when px.forma = 'BENEFICIARIO' then
                                -- ag/conta: o banco so repete os nossos dados; o que da para
                                -- conferir e se o destino e uma conta do proprio grupo
                                case when grp.nome is not null
                                     then '<span class="fa fa-check-circle u-success-text"></span> Conta do grupo - ' || apex_escape.html(grp.nome)
                                     else '<span class="fa fa-info-circle"></span> Ag/conta - titular não confirmado pelo banco' end
                              end
                       end conferencia
                  from pix_pagamentos px
                       join pagamentosfornecedores pf on pf.idpgtoforn = px.idpgtoforn
                       left join contasbancarias cbf on cbf.idcontabanc = px.idcontabanc
                       -- conta de destino e uma das contas do grupo integradas ao hub?
                       outer apply ( select max(sc.beneficiario) nome
                                       from santander_contas sc
                                       join contasbancarias cbg on cbg.idcontabanc = sc.idcontabanc
                                      where px.forma = 'BENEFICIARIO'
                                        and case when length(regexp_replace(cbg.agencia,'[^0-9]')) > 4
                                                 then substr(regexp_replace(cbg.agencia,'[^0-9]'),1,4)
                                                 else lpad(regexp_replace(cbg.agencia,'[^0-9]'),4,'0') end
                                            = lpad(regexp_replace(px.benef_agencia,'[^0-9]'),4,'0')
                                        and regexp_replace(cbg.conta,'[^0-9]') = regexp_replace(px.benef_conta,'[^0-9]') ) grp
                 where px.status = 'READY_TO_PAY'
                       -- o periodo se aplica ao vencimento (V) ou a data de envio (E)
                   and ( :P701_DATA_DE is null
                         or trunc( case when :P701_TIPO_DATA = 'E' then px.dt_post
                                        else pf.dtvencimento end )
                            >= to_date(:P701_DATA_DE,'DD/MM/RRRR') )
                   and ( :P701_DATA_ATE is null
                         or trunc( case when :P701_TIPO_DATA = 'E' then px.dt_post
                                        else pf.dtvencimento end )
                            <= to_date(:P701_DATA_ATE,'DD/MM/RRRR') )
                   and ( :P701_CONTA is null or px.idcontapagamento = :P701_CONTA )
                   and ( :P701_TIPO is null or :P701_TIPO = 'TODOS'
                         or nvl( pf.tipopagamento
                               , (select v.tipopagamento from vencimentos v
                                   where v.idvencimento = pf.idvencimento) ) = :P701_TIPO )
                 order by case when :P701_TIPO_DATA = 'E' then px.dt_post
                               else pf.dtvencimento end
                        , fornecedor, px.idpix
                ```
        }
