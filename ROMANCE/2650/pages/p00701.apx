    button sel-todos (
        buttonName: SEL_TODOS
        label: Selecionar todos
        layout {
            sequence: 5
            region: @pagamentos-aguardando-autorização
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:fnc_selecionar_todos();
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: BTN_SEL_TODOS
        }
    )

    process autoriza-pagamentos-pix (
        name: Autoriza Pagamentos Pix
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if apex_application.g_f01.count = 0 then
                    apex_error.add_error(
                      p_message          => 'Selecione ao menos um pagamento.',
                      p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  -- Em segundo plano: a resposta do banco pode levar minutos (retentativas
                  -- em instabilidade) e o proxy web corta a requisicao em 60 s (504).
                  roman.pck_santander_pix.prc_autorizar_lote_async(
                    pids     => apex_util.table_to_string(apex_application.g_f01, ':'),
                    pusuario => :APP_USER );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Autorização enviada em segundo plano. Os pagamentos aparecem na página 702 como Autorizando e mudam para Pago/Pendente/Rejeitado conforme o banco responde (1 a 5 minutos).
        }
        advanced {
            executionMappingIdentifier: 971000000000701060
        }
        serverSideCondition {
            whenButtonPressed: @autorizar
        }
    )

    branch (
        name: Go To Page 701
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 701
                action: resetPagination
            }
        }
    )

)

