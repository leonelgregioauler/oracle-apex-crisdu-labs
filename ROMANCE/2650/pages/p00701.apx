    pageItem P701_TIPO (
        type: selectList
        label {
            label: Tipo de movimentação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct nvl(fp.descricao, '(' || px.forma || ')') d
                     , nvl( pf.tipopagamento
                          , (select v.tipopagamento from vencimentos v
                              where v.idvencimento = pf.idvencimento) ) r
                  from pix_pagamentos px
                       join pagamentosfornecedores pf on pf.idpgtoforn = px.idpgtoforn
                       left join formaspagamentos fp
                              on fp.idformapagamento = nvl( pf.tipopagamento
                                                          , (select v.tipopagamento from vencimentos v
                                                              where v.idvencimento = pf.idvencimento) )
                 where px.status = 'READY_TO_PAY'
                 order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: Todos
        }
