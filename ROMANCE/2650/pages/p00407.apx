                select oc.idorcamentosolicitacao
                     , oc.idsolicitacaocompra
                     , oc.data
                     , oc.valor
                     , oc.site
                from orcamentossolicitacoescompras oc
                where oc.idsolicitacaocompra = :P407_IDSOLICITACAOCOMPRA
