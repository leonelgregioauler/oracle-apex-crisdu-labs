    process processo-dml-em-solicitações-de-compras (
        name: Processo DML em Solicitações de Compras
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml     varchar2(1);
                  vvalorinicial     number;
                  vvalorfechado     number;
                  vvaloreconomizado number;
                  vcashback         number;
                  vvalorcashback    number;
                  vfrete            number;
                  --
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  :P407_USUARIO := v('APP_USER');
                  --
                  vvalorinicial     := to_number(:P407_VALORINICIAL,'999G999G999G999G999G990D00'); 
                  vvalorfechado     := to_number(:P407_VALORFECHADO,'999G999G999G999G999G990D00'); 
                  vvaloreconomizado := to_number(:P407_VALORECONOMIZADO,'999G999G999G999G999G990D00'); 
                  vcashback         := to_number(:P407_CASHBACK,'990D00'); 
                  vvalorcashback    := to_number(:P407_VALORCASHBACK,'999G999G999G999G999G990D00'); 
                  vfrete            := to_number(:P407_FRETE,'999G999G999G999G999G990D00'); 
                  --
                  PCK_CADASTROS_RMC.PRC_SOLICITACOESCOMPRAS( PIDSOLICITACAOCOMPRA => :P407_IDSOLICITACAOCOMPRA,
                                                             PIDCHAMADO => :P407_IDCHAMADO,
                                                             PIDFILIAL => :P407_IDFILIAL,
                                                             PIDPESSOASOLICITOU => :P407_IDPESSOASOLICITOU,
                                                             PDATASOLICITACAO => :P407_DATASOLICITACAO,
                                                             PDATAFECHADO => :P407_DATAFECHADO,
                                                             PUSUARIO => :P407_USUARIO,
                                                             PPRODUTOS => :P407_PRODUTOS,
                                                             PVALORINICIAL => vvalorinicial,
                                                             PVALORFECHADO => vvalorfechado,
                                                             PVALORECONOMIZADO => vvaloreconomizado,
                                                             PCASHBACK => vcashback,
                                                             PVALORCASHBACK => vvalorcashback,
                                                             POBSERVACAO => :P407_OBSERVACAO,
                                                             PFRETE => :P407_FRETE,
                                                             PMD5 => :P407_MD5,
                                                             POPERACAO_DML => voperacao_dml);
                  --
                  :P407_VALORECONOMIZADO := to_char(vvaloreconomizado,'999G999G999G999G999G990D00'); 
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5394894313465328063
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('CRIAR','SALVAR','DELETAR')
        }
    )

    branch (
        name: Go To Page 407
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 407
                items: {
                    P407_IDSOLICITACAOCOMPRA: &P407_IDSOLICITACAOCOMPRA.
                }
                action: resetPagination
            }
        }
    )

)

