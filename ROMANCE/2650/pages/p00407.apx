    pageItem P407_IDPESSOASOLICITOU (
        type: popupLov
        label {
            label: Solicitado Por
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' - '||u.usuario display_value
                     , p.idpessoa return_value
                from pessoas p
                   , usuarios u
                where u.idpessoa = p.idpessoa
                  and u.ativo    = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @cadastro-de-solicitação-de-compra
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vidpessoa number;
                begin
                  --
                  select p.idpessoa 
                  into vidpessoa
                  from pessoas p
                     , usuarios u
                  where u.idpessoa = p.idpessoa
                    and u.ativo    = 'S'
                    and u.usuario  = ( select c.usuario
                                       from chamados c
                                       where c.idchamado = :P407_IDCHAMADO );
                  --
                  return vidpessoa;
                  --
                exception
                  when others then
                    null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

