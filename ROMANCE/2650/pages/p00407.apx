    process consulta-dml-em-solicitações-de-compras (
        name: Consulta DML Em Solicitações de Compras
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalorinicial     number;
                  vvalorfechado     number;
                  vvaloreconomizado number;
                  vcashback         number;
                  vvalorcashback    number;
                  vfrete            number;
                  --
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_SOLICITACOESCOMPRAS( PIDSOLICITACAOCOMPRA => :P407_IDSOLICITACAOCOMPRA,
                                                             PIDCHAMADO => :P407_IDCHAMADO,
                                                             PIDFILIAL => :P407_IDFILIAL,
                                                             PIDPESSOASOLICITOU => :P407_IDPESSOASOLICITOU,
                                                             PDATASOLICITACAO => :P407_DATASOLICITACAO,
                                                             PDATAFECHADO => :P407_DATAFECHADO,
                                                             PUSUARIO => :P407_USUARIO,
                                                             PPRODUTOS => :P407_PRODUTOS,
                                                             PVALORINICIAL => vvalorinicial,
                                                             PVALORFECHADO => vvalorfechado,
                                                             PVALORECONOMIZADO => vvaloreconomizado,
                                                             PCASHBACK => vcashback,
                                                             PVALORCASHBACK => vvalorcashback,
                                                             POBSERVACAO => :P407_OBSERVACAO,
                                                             PFRETE => vfrete,
                                                             PMD5 => :P407_MD5,
                                                             POPERACAO_DML => 'S');
                  --
                  :P407_VALORINICIAL     := trim(to_char(vvalorinicial,'999G999G999G999G999G990D00')); 
                  :P407_VALORFECHADO     := trim(to_char(vvalorfechado,'999G999G999G999G999G990D00')); 
                  :P407_VALORECONOMIZADO := trim(to_char(vvaloreconomizado,'999G999G999G999G999G990D00')); 
                  :P407_CASHBACK         := trim(to_char(vcashback,'990D00')); 
                  :P407_VALORCASHBACK    := trim(to_char(vvalorcashback,'999G999G999G999G999G990D00'));  
                  :P407_FRETE            := trim(to_char(vfrete,'999G999G999G999G999G990D00')); 
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5394893144927328062
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P407_IDSOLICITACAOCOMPRA
        }
    )

