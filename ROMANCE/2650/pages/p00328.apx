            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P328_IDANEXODESPESA
        }
    )

    button novadespesa (
        buttonName: NovaDespesa
        label: Nova Despesa
