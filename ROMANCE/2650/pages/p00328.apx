    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_despesas(piddespesa => :P328_IDDESPESA
                                                  ,pidanexo => :P328_IDANEXODESPESA);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 478418734525565836
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P328_ARQUIVOTEMP
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_anexos.prc_apagaanexo(pidanexodespesa => :P328_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 545027257743384705
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process delete-anexo-bucket (
        name: DELETE_ANEXO_BUCKET
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  delete from roman.anexosdespesas
                   where idanexodespesa = to_number(apex_application.g_x01);
                
                  htp.p('OK');
                exception
                  when others then
                    htp.p('ERRO: ' || sqlerrm);
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 512254934476613302
        }
    )

    process fetch-row-from-anexosdespesas (
        name: Fetch Row from ANEXOSDESPESAS
        type: autoRowFetch
        source {
            tableName: ANEXOSDESPESAS
            pkColumn: IDANEXODESPESA
            pkItem: P328_IDANEXODESPESA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 478419178191565838
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P328_IDANEXODESPESA is null then
                        select "#OWNER#"."SEQ_IDANEXODESPESA".nextval
                          into :P328_IDANEXODESPESA
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 478419552760565838
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: itemIsNotNull
            item: P328_ARQUIVOTEMP
        }
    )

    process process-row-of-anexosdespesas (
        name: Process Row of ANEXOSDESPESAS
        type: autoRowProcessing
        target {
            tableName: ANEXOSDESPESAS
            pkColumn: IDANEXODESPESA
            pkItem: P328_IDANEXODESPESA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 478419973086565838
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P328_ARQUIVOTEMP
        }
    )

    branch (
        name: Anexar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 328
                items: {
                    P328_IDANEXODESPESA:
                    P328_IDDESPESA: &P328_IDDESPESA.
                }
                action: resetPagination
                successMessage: false
            }
        }
    )

)

