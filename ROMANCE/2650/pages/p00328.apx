page 328 (
    name: Anexos Despesas
    title: Anexos Despesas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 65%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P328_IDANEXODELETAR":pidanexo}
              });
            }
            
            function fnc_removeanexobucket(pidanexo) {
              apex.message.confirm(
                "Deseja realmente remover o anexo?",
                function(okPressed) {
                  if (!okPressed) {
                    return;
                  }
            
                  apex.server.process(
                    "DELETE_ANEXO_BUCKET",
                    {
                      x01: pidanexo
                    },
                    {
                      dataType: "text",
                      success: function(pData) {
                        if (pData && pData.indexOf("ERRO:") === 0) {
                          apex.message.clearErrors();
                          apex.message.showErrors([
                            {
                              type: "error",
                              location: ["page"],
                              message: pData,
                              unsafe: false
                            }
                          ]);
                          return;
                        }
            
                        apex.region("anexos_despesa").refresh();
                      },
                      error: function(jqXHR, textStatus, errorThrown) {
                        apex.message.clearErrors();
                        apex.message.showErrors([
                          {
                            type: "error",
                            location: ["page"],
                            message: "Erro ao excluir anexo: " + errorThrown,
                            unsafe: false
                          }
                        ]);
                      }
                    }
                  );
                }
              );
            }
            ```
    }

    region anexos-despesas (
        name: Anexos Despesas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            footerText: <font color="green"> Você pode anexar mais de um arquivo.</font>
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     , iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) ID
                     --, '<a href="javascript: fnc_verimg('''||iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' link
                     , dataanexo data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario
                    -- , '<a href="javascript: fnc_removeanexo('||idanexodespesa||','''||t.nomearquivo||''');">Remover</a>' remover
                     --, '<a href="javascript:void(0);" onclick="fnc_removeanexobucket('||t.idanexodespesa||'); return false;">Remover</a>' remover
                     , '<a href="javascript:void(0);" onclick="fnc_removeanexobucket('||t.idanexodespesa||'); return false;"><i class="fa fa-trash"></i></a>' remover
                      --###
                     , case 
                        when lower(url_bucket) like '%.png'
                          or lower(url_bucket) like '%.jpg'
                          or lower(url_bucket) like '%.jpeg'
                        then
                          '<a href="javascript:void(0);" onclick="abrirFoto('''||trim(url_bucket)||''')">
                             <img src="'||trim(url_bucket)||'"
                                  style="width:120px;height:80px;object-fit:cover;border-radius:8px;" />
                           </a>'
                        else
                          '<a href="javascript:void(0);" onclick="abrirArquivo('''||trim(url_bucket)||''')"
                              style="text-decoration:none;">
                              Abrir arquivo
                           </a>'
                      end  preview
                     --###
                from anexosdespesas t
                where iddespesa = :P328_IDDESPESA
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: anexos_despesa
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column PREVIEW (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Anexo
                alignment: center
            }
            layout {
                sequence: 14
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column REMOVER (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 24
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P328_ARQUIVOTEMP (
