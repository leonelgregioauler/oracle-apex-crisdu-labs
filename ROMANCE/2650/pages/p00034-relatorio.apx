page 34 (
    name: Relatorio de depositos por NF
    alias: RELATORIO
    title: Relatorio de depositos por NF
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region relatorio (
        name: Relatorio
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                pck_romance.prc_depositos_nf;
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
    )

    process gera-excel (
        name: Gera Excel
        type: executeCode
        source {
            plsqlCode: OWA_UTIL.mime_header (ccontent_type => 'application/vnd.ms-excel');
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 181196943199973551
        }
    )

)

