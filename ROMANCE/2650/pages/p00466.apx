page 466 (
    name: CapCar Fornecedores
    title: CapCar Fornecedores
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region capcar (
        name: CapCar
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select fornecedor
                     , nvl(apagar_v1,0) apagar_v1
                     , case 
                         when nvl(apagar_v2,0) < 0 then 
                           apagar_v2 * -1
                         when nvl(apagar_v2,0) > 0 then 
                           apagar_v2 * -1
                         else
                           nvl(apagar_v2,0)
                       end apagar_v2
                     , nvl(receber_v1,0) receber_v1
                     , nvl(receber_v2,0) receber_v2
                from (
                      select initcap(p.nomepessoa) fornecedor
                           , ( select sum(vc.valor)-nvl(sum(vc.desconto),0)
                               from vencimentos vc
                                  , notasfiscais nf
                               where nf.idnotafiscal = vc.idnotafiscal
                                 and nf.idfornemitente = f.idfornecedor
                                 and trunc(vc.datavencimento) <= to_date(:P466_DATAFIM,'DD/MM/RRRR')
                                 and extract(year from vc.datavencimento) >= 2022
                                 and exists ( select 1
                                              from pagamentosfornecedores pf
                                              where pf.idfornecedor = f.idfornecedor
                                                and pf.idvencimento = vc.idvencimento
                                                and ( pf.valorpago + nvl(pf.desconto,0) - pf.valorpagar ) < 0 
                                                /*and ( pf.valorpago + nvl(pf.desconto,0) - nvl(pf.acrescimo,0) ) < pf.valorpagar )*/ ) ) apagar_v1
                           , ( select sum(e.valormovimento)
                               from extratoscontasbancarias e
                                  , contasbancarias c
                               where e.idcontabancaria  = c.idcontabanc
                                 and c.idpessoa         = f.idpessoa 
                                 and e.contabilizar     = 'S'
                                 and e.tipopagamento    in ('D','T','P')
                                 and trunc(e.datamovimento) <= to_date(:P466_DATAFIM,'DD/MM/RRRR') ) apagar_v2
                           , ( select sum(w.a_receber)
                               from resultado_fornecedores w
                               where w.idfornecedor = f.idfornecedor
                                 and w.vencimento <= to_date(:P466_DATAFIM,'DD/MM/RRRR')) receber_v1
                           , ( select sum(vr.valor) 
                               from notasfiscais nv 
                                   , vencimentosreceber vr
                                where nv.tiponota = 'V'
                                  and nv.idnotafiscal     = vr.idnotafiscal
                                  and nv.transferenciaentrefiliaisrom = 'N'
                                  and nv.idfornecedordestino = f.idfornecedor
                                  and nv.idcompratransferencia is null
                                  and not exists ( select 1
                                                   from depositosdiarios d
                                                   where d.idvencimentoabatimento = vr.idvencimento )
                                 and trunc(vr.datavencimento) <= to_date(:P466_DATAFIM,'DD/MM/RRRR')
                                 and not exists ( select 1
                                                  from depositosdiarios_orig dd
                                                  where dd.idvencimentoabatimento = vr.idvencimento )
                                 and trunc(vr.datavencimento) >= to_date('01/01/2023','DD/MM/RRRR') ) receber_v2
                      from fornecedores f
                         , pessoas p
                      where f.idpessoa = p.idpessoa
                        and exists (select 1
                                      from extratoscontasbancarias ex
                                         , contasbancarias c
                                     where ex.idcontabancaria = c.idcontabanc
                                       and c.idpessoa         = p.idpessoa
                                       and extract(year from ex.datamovimento) >= 2022
                                       and ex.contabilizar = 'S' ) 
                        and (:P466_FORNECEDOR is null or f.idfornecedor = :P466_FORNECEDOR)
                        and (:P466_TIPOFORNECEDORES is null or f.tipo_fornecedor in ( select regexp_substr(:P466_TIPOFORNECEDORES, '[^/]+', 1, level) 
                                                                                           from dual
                                                                                connect by level <= regexp_count(:P466_TIPOFORNECEDORES, '/') + 1 ) ) ) t
                where (  ( nvl(apagar_v1,0) + nvl(apagar_v2,0) ) != 0 
                      or ( nvl(receber_v1,0) + nvl(receber_v2,0) ) != 0 )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado. Verifique os filtros.
        }
        actionsMenu {
            savePublicReport: true
        }
