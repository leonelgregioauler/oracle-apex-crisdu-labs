    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P466_DATAFIM (
        type: datePickerJquery
        label {
            label: Data Vencimento Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P466_FORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefornecedor(idfornecedor) display_value
                     , fe.idfornecedor return_value
                from catal.fornecedores fe
                where fe.ativo = 'S'
                  /*and exists ( select 1
                                from roman.notasfiscais nv 
                                   , roman.vencimentosreceber vr
                                   , roman.depositosdiarios_orig dd
                                where nv.tiponota = 'V'
                                  and nv.idnotafiscal     = vr.idnotafiscal
                                  and vr.idvencimento     = dd.idvencimentoabatimento(+)  
                                  and nv.idfornecedordestino = fe.idfornecedor
                                  and not exists ( select 1
                                                   from roman.depositosdiarios d
                                                   where d.idvencimentoabatimento = vr.idvencimento ) )*/
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: Todos
        }
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P466_TIPOFORNECEDORES (
        type: selectMany
        label {
            label: Tipo de Fornecedores
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.descricao, v.sigla
                        from roman.siglasistema s
                           , roman.valorsiglasistema v
                       where s.idsiglasistema = v.idsiglasistema
                         and s.nomesigla      = 'TIPO_FORNECEDOR';
                ```
        }
        multipleValues {
            separator: /
        }
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P466_ULTIMAIMPORTACAO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="blue"><h3>Última importação realizada: '||to_char(c.dataprocessado,'DD/MM/RRRR HH24:MI:SS')||'</h3></font>' texto
                from contasarecebervirtualage c
                where c.idcontasarecebervirutalage = ( select max(cr.idcontasarecebervirutalage)
                                                       from contasarecebervirtualage cr
                                                       where cr.processado = 'S'
                                                         and cr.dataprocessado is not null )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

