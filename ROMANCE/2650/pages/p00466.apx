                sequence: 10
                fireOnInit: false
            }
        )

    )

    process popula-datas (
        name: Popula Datas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  select trunc(sysdate)
                  into :P466_DATAFIM
                  from dual;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1506752574790674387
        }
        serverSideCondition {
            type: itemIsNull
            item: P466_DATAFIM
        }
    )

    branch (
        name: Go To Page 466
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 466
                items: {
                    P466_DATAFIM: &P466_DATAFIM.
                    P466_FORNECEDOR: &P466_FORNECEDOR.
                    P466_TIPOFORNECEDORES: &P466_TIPOFORNECEDORES.
                }
            }
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

)

