page 465 (
    name: Log de Lançamentos
    alias: LOG-DE-LANÇAMENTOS
    title: Log de Lançamentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 900
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: dialogHeader
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region log-de-lançamentos (
        name: Log de lançamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.datahora                                                            "Data"
                     , decode(l.tipoevento,
                       'CONFERENCIA',              'Conferência',
                       'CANCEL_CONFERENCIA',       'Cancelamento de Conferência',
                       'AGENDAMENTO',              'Agendamento',
                       'CANCEL_AGENDAMENTO',       'Cancelamento de Agendamento',
                       'AUTORIZACAO_BANCO',        'Autorização Banco',
                       'CANCEL_AUTORIZACAO_BANCO', 'Cancelamento de Autorização Banco',
                       'LIQUIDACAO',               'Liquidação',
                       l.tipoevento)                                                         "Evento"
                     , l.usuario                                                             "Usuário"
                     , nvl(pck_romance.fnc_nomefornecedor(pidforn => pf.idfornecedor), '-')  "Fornecedor"
                     , nf.idnotafiscal                                                       "Nota Fiscal"
                     , pf.dtvencimento                                                       "Vencimento"
                     , pf.valorpagar                                                         "Valor"
                  from roman.log_pagamentosfornecedores l
                     , roman.pagamentosfornecedores pf
                     , roman.notasfiscais nf
                 where l.idpgtoforn    = pf.idpgtoforn (+)
                   and pf.idnotafiscal = nf.idnotafiscal (+)
                   and l.idpgtoforn    = :P465_IDPGTOFORN
                 order by l.datahora desc
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 36293227065351139
        }

        column Data (
            type: plainText
            heading {
                heading: Data
            }
            layout {
                sequence: 10
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: AD
            }
        )

        column Evento (
            type: plainText
            heading {
                heading: Evento
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AE
            }
        )

        column Fornecedor (
            type: plainText
            heading {
                heading: Fornecedor
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AG
            }
        )

        column "Nota Fiscal" (
            type: plainText
            heading {
                heading: Nota Fiscal
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: AH
            }
        )

        column Usuário (
            type: plainText
            heading {
                heading: Usuário
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AF
            }
        )

        column Valor (
            type: plainText
            heading {
                heading: Valor
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: AJ
            }
        )

        column Vencimento (
            type: plainText
            heading {
                heading: Vencimento
            }
            layout {
                sequence: 60
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: AI
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 12179900 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Data" (
                sequence: 1
            )

            displayColumn "Evento" (
                sequence: 2
            )

            displayColumn "Fornecedor" (
                sequence: 3
            )

            displayColumn "Nota Fiscal" (
                sequence: 4
            )

            displayColumn "Usuário" (
                sequence: 5
            )

            displayColumn "Valor" (
                sequence: 6
            )

            displayColumn "Vencimento" (
                sequence: 7
            )

        )

    )

    pageItem P465_IDPGTOFORN (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

)

