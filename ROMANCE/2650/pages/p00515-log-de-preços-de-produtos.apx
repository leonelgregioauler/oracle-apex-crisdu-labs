page 515 (
    name: Log de Preços de Produtos
    alias: LOG-DE-PREÇOS-DE-PRODUTOS
    title: Log de Preços de Produtos
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutStart
            js-dialog-class-t-Drawer--lg
        ]
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }

    region logs-de-alterações (
        name: Logs de Alterações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select le.usuarioalteracao 
                     , le.dataalteracao
                     , decode(le.tipoalteracao,'INSERT','Inclusão'
                                              ,'UPDATE','Alteração'
                                              ,'DELETE','Exclusão') tipoalteracao
                     , le.vlrvenda
                     , decode(le.ativo,'S','Ativo','N','Inativo') situacao
                from logroman.log_estoquefilial le
                where le.idfilial = :P515_IDFILIAL
                  and le.idproduto = :P515_IDPRODUTO
                order by le.dataalteracao 
                ```
            pageItemsToSubmit: P515_IDFILIAL
        }
        layout {
            sequence: 10
            parentRegion: @logs-de-preços
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma informação localizada! Verifique a Franquia informada!
        }
        advanced {
            savedReportMappingIdentifier: 374701351435261635
        }

        column DATAALTERACAO (
            type: plainText
            heading {
                heading: Data Alteração
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column SITUACAO (
            type: plainText
            heading {
                heading: Situação
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column TIPOALTERACAO (
            type: plainText
            heading {
                heading: Tipo de Alteração
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column USUARIOALTERACAO (
            type: plainText
            heading {
                heading: Alterado Por
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column VLRVENDA (
            type: plainText
            heading {
                heading: Valor de Venda
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 7556505 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAALTERACAO (
                sequence: 2
            )

            displayColumn SITUACAO (
                sequence: 5
            )

            displayColumn TIPOALTERACAO (
                sequence: 3
            )

            displayColumn USUARIOALTERACAO (
                sequence: 1
            )

            displayColumn VLRVENDA (
                sequence: 4
            )

        )

    )

    region logs-de-preços (
        name: Logs de Preços
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P515_IDFILIAL (
        type: selectOne
        label {
            label: Franquia
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo is not null
                ```
        }
        layout {
            sequence: 20
            region: @logs-de-preços
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P515_IDPRODUTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @logs-de-preços
            slot: regionBody
        }
    )

    dynamicAction atualiza-franquia (
        name: Atualiza Franquia
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P515_IDFILIAL
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @logs-de-alterações
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

