page 107 (
    name: Alteração de despesas
    title: Alteração de despesas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region alteração-de-despesas (
        name: Alteração de despesas
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P107_DATAVENCIMENTO (
        type: datePickerJquery
        label {
            label: Data vencimento
            alignment: right
        }
        layout {
            sequence: 40
            region: @alteração-de-despesas
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: DATAVENCIMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P107_IDCONTACONTABIL (
        type: selectList
        label {
            label: Conta Contábil
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idcontafinan
                from contasfinanceiras c
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione a Conta  -
        }
        layout {
            sequence: 20
            region: @alteração-de-despesas
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTACONTABIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P107_IDDESPESA (
        type: hidden
        layout {
            sequence: 10
            region: @alteração-de-despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDDESPESA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P107_IDSUBCONTACONTABIL (
        type: selectList
        label {
            label: Sub Conta Contábil
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idsubcontafinan
                from subcontasfinanceiras c
                where c.idcontafinan = :P107_IDCONTACONTABIL
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione a Sub Conta  -
        }
        cascadingLov {
            parentItems: P107_IDCONTACONTABIL
        }
        layout {
            sequence: 30
            region: @alteração-de-despesas
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDSUBCONTACONTABIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P107_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @alteração-de-despesas
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P107_VALOR (
        type: numberField
        label {
            label: Valor
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @alteração-de-despesas
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G990D00
            width: 12
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: VALOR
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @alteração-de-despesas
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 98
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @alteração-de-despesas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P107_IDDESPESA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @alteração-de-despesas
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P107_IDDESPESA
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 30
            region: @alteração-de-despesas
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P107_IDDESPESA
        }
    )

    process fetch-row-from-despesas (
        name: Fetch Row from DESPESAS
        type: autoRowFetch
        source {
            tableName: DESPESAS
            pkColumn: IDDESPESA
            pkItem: P107_IDDESPESA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 182032126577266396
        }
    )

    process process-row-of-despesas (
        name: Process Row of DESPESAS
        type: autoRowProcessing
        target {
            tableName: DESPESAS
            pkColumn: IDDESPESA
            pkItem: P107_IDDESPESA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela DESPESAS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 182032323699266404
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 182032535400266404
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 107
            }
            saveStateBeforeBranching: true
        }
    )

)

