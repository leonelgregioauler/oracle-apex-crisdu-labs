page 53 (
    name: Encerrar Evento/Solicitação
    title: Encerrar Evento/Solicitação
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            if (document.getElementById('P53_IDCHAMADO').value == '')
            {
            window.opener.location.reload();
            window.close();
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region encerrar-evento-solicitação (
        name: Encerrar Evento/Solicitação
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P53_AVALCORDIALIDADE (
        type: radioGroup
        label {
            label: Com que nota você avalia a cordialidade, paciência e atenção do analista que o atendeu?
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Excelente;E,Bom;B,Regular;R,Ruim;Z
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @encerrar-evento-solicitação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: AVALCORDIALIDADE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P53_AVALIACAOATENDIMENTO (
        type: radioGroup
        label {
            label: Como você avalia a solução dada neste atendimento?
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Excelente;E,Bom;B,Regular;R,Ruim;Z
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @encerrar-evento-solicitação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: AVALIACAOATENDIMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P53_AVALIACAOTEMPO (
        type: radioGroup
        label {
            label: Como foi o tempo de espera para ser atendido?
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Excelente;E,Bom;B,Regular;R,Ruim;Z
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @encerrar-evento-solicitação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: AVALIACAOTEMPO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P53_IDCHAMADO (
        type: hidden
        layout {
            sequence: 10
            region: @encerrar-evento-solicitação
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCHAMADO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P53_IDSITUACAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @encerrar-evento-solicitação
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDSITUACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P53_OBSERVACAOATENDIMENTO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        settings {
            charCounter: true
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @encerrar-evento-solicitação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 60
            height: 8
        }
        validation {
            maxLength: 2000
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAOATENDIMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @encerrar-evento-solicitação
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: window.close();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Encerrar
        layout {
            sequence: 30
            region: @encerrar-evento-solicitação
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P53_IDCHAMADO
        }
    )

    validation p53-avalcordialidade (
        name: P53_AVALCORDIALIDADE
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P53_AVALCORDIALIDADE
        }
        error {
            errorMessage: Por favor, avalie o atendimento.
            associatedItem: @P53_AVALCORDIALIDADE
        }
    )

    validation p53-avaliacaoatendimento (
        name: P53_AVALIACAOATENDIMENTO
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P53_AVALIACAOATENDIMENTO
        }
        error {
            errorMessage: Por favor, avalie o atendimento.
            associatedItem: @P53_AVALIACAOATENDIMENTO
        }
    )

    validation p53-avaliacaotempo (
        name: P53_AVALIACAOTEMPO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P53_AVALIACAOTEMPO
        }
        error {
            errorMessage: Por favor, avalie o atendimento.
            associatedItem: @P53_AVALIACAOTEMPO
        }
    )

    process encerra (
        name: encerra
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  :P53_IDSITUACAO := 2;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 193916564783832119
        }
    )

    process fetch-row-from-chamados (
        name: Fetch Row from CHAMADOS
        type: autoRowFetch
        source {
            tableName: CHAMADOS
            pkColumn: IDCHAMADO
            pkItem: P53_IDCHAMADO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 193916106652832118
        }
    )

    process process-row-of-chamados (
        name: Process Row of CHAMADOS
        type: autoRowProcessing
        target {
            tableName: CHAMADOS
            pkColumn: IDCHAMADO
            pkItem: P53_IDCHAMADO
            supportedOperations: update
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 193916972277832119
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 193917354726832119
        }
    )

    branch (
        name: Go To Page 53
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 47
                successMessage: false
            }
        }
    )

)

