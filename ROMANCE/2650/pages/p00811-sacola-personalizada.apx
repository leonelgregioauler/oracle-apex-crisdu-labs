page 811 (
    name: Sacola Personalizada
    alias: SACOLA-PERSONALIZADA
    title: Sacola Personalizada
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region combinação-produtos-sacolas (
        name: Combinação Produtos Sacolas
        title: Combinação Produtos Sacolas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with base as (
                             select
                                pck_romance.fnc_nomefilial(r.idfilial) franquia,
                                pck_romance.fnc_nomerepresentante(r.idrepresentante) distribuidor,
                                pck_romance.fnc_nomevendedora(s.idvendedora) consultora,
                                pck_romance.fnc_cpfvendedora(s.idvendedora) cpf,
                                pck_util.fnc_semanaid(s.idsemana) semana,
                                nv.numeronota,
                                nv.idnotavenda,
                                nv.semanadistribuicao,
                                /* Itens solicitados */
                                (
                                  select SUM((  ii.qtd_pp
                                              + ii.qtd_p
                                              + ii.qtd_m
                                              + ii.qtd_g
                                              + ii.qtd_gg
                                              + ii.qtd_egg
                                              + ii.qtd_exgg
                                              + ii.qtd_u ))
                                  from itenssugestoessacolas ii
                                  where ii.idsugestaosacola = s.idsugestaosacola
                                    and ( ii.qtd_pp
                                        + ii.qtd_p
                                        + ii.qtd_m
                                        + ii.qtd_g
                                        + ii.qtd_gg
                                        + ii.qtd_egg
                                        + ii.qtd_exgg
                                        + ii.qtd_u ) > 0
                                ) qtd_itens_pedidos,
                         
                                /* Itens na nota */
                                (
                                  select SUM(it.quantidade)
                                  from itensnotavenda it
                                  where it.idnotavenda = s.idnotavenda
                                  group by it.idnotavenda
                                ) qtd_na_sacola,
                         
                                /*sugerido x entregue */
                                (
                                  select SUM(it.quantidade)--COUNT(distinct ii.iditemsugestaosacola)
                                  from itensnotavenda it
                                  join itenssugestoessacolas ii on it.idestoquefil = ii.idestoquefil
                                  where ii.idsugestaosacola = s.idsugestaosacola
                                    and it.idnotavenda      = s.idnotavenda
                                    and ( ii.qtd_pp
                                        + ii.qtd_p
                                        + ii.qtd_m
                                        + ii.qtd_g
                                        + ii.qtd_gg
                                        + ii.qtd_egg
                                        + ii.qtd_exgg
                                        + ii.qtd_u ) > 0
                                  group by it.idnotavenda
                                ) qtd_itens_similares,
                                
                                --vendido
                                (
                                  select SUM(it.quantidade - it.qtddevolvida)--COUNT(distinct ii.iditemsugestaosacola)
                                  from itensnotavenda it
                                  join itenssugestoessacolas ii on it.idestoquefil = ii.idestoquefil
                                  where ii.idsugestaosacola = s.idsugestaosacola
                                    and it.idnotavenda      = s.idnotavenda
                                    and ( ii.qtd_pp
                                        + ii.qtd_p
                                        + ii.qtd_m
                                        + ii.qtd_g
                                        + ii.qtd_gg
                                        + ii.qtd_egg
                                        + ii.qtd_exgg
                                        + ii.qtd_u ) > 0
                                  group by it.idnotavenda
                                ) qtd_itens_vendidos,
                                nv.idsituacaonotavenda
                                
                          from representantes r
                             , sugestoessacolas s
                             , notasvendas nv
                          where r.ativo = 'S'
                            and s.dataenviado is not null
                            and r.idrepresentante = s.idrepresentante
                            and nv.idnotavenda = s.idnotavenda
                            and s.idnotavenda is not null
                  
                          -- FILTROS TELA
                          and (r.idfilial = :P811_FILIAL OR :P811_FILIAL IS NULL)
                          and (nv.semanadistribuicao = :P811_SEMANANOTA OR :P811_SEMANANOTA is null)
                          and (nv.numeronota = :P811_NUMERONOTA
                               OR nv.idnotavenda = :P811_NUMERONOTA
                               OR :P811_NUMERONOTA is null)
                          and (r.idrepresentante = :P811_DISTRIBUIDOR OR :P811_DISTRIBUIDOR is null)
                          and (s.idvendedora = :P811_CONSULTORA OR :P811_CONSULTORA is null)
                          and :P811_FILTRAR = 'S')
                select
                    t.franquia                                                               "Franquia",
                    t.distribuidor                                                           "Distribuidor",
                    t.consultora                                                             "Consultora",
                    t.cpf                                                                    "CPF",
                    t.semana                                                                 "Semana Sacola",
                    t.idnotavenda                                                            "Id Nota Venda",
                    t.numeronota                                                             "Nr Nota",
                    t.semanadistribuicao                                                     "Semana Nota",
                    nvl(t.qtd_itens_pedidos ,0)                                              "Produtos Solicitados",
                    t.qtd_na_sacola                                                          "Produtos Entregues",
                    nvl(t.qtd_itens_similares,0)                                             "Produtos que Combinam",
                    nvl(round(t.qtd_itens_similares / t.qtd_itens_pedidos * 100,2),0) || '%' "% Combinação",
                    nvl(t.qtd_itens_vendidos, 0)                                             "Itens Vendidos",
                    /* Aproveitamento*/
                    case
                      when t.idsituacaonotavenda <> 4 then
                        'Aguard. Acerto'
                      when t.qtd_itens_similares = 0 then
                        '0'
                      else
                        NVL(round((t.qtd_itens_vendidos / t.qtd_itens_similares) * 100, 2),0) || '%'
                    end "% Aproveitamento"
                from base t
                --somente sacolas que tiveram solicitacoes > 0
                where t.qtd_itens_pedidos is not null
                ```
        }
        layout {
            sequence: 10
            slot: regionBody
        }
        appearance {
