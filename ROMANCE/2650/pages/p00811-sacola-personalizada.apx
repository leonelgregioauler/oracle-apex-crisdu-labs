    region solicitações-produtos-sacolas (
        name: Solicitações Produtos Sacolas
        title: Solicitações Produtos Sacolas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(s.idfilial) franquia
                     , p.codigosisdist referencia
                     , p.nomeproduto produto
                     , sum(it.qtd_pp)   as qtd_pp
                     , sum(it.qtd_p)    as qtd_p
                     , sum(it.qtd_m)    as qtd_m
                     , sum(it.qtd_g)    as qtd_g
                     , sum(it.qtd_gg)   as qtd_gg
                     , sum(it.qtd_egg)  as qtd_egg
                     , sum(it.qtd_exgg) as qtd_exgg
                     , sum(it.qtd_u)    as qtd_u
                     , (sum(it.qtd_pp) 
                        + sum(it.qtd_p) 
                        + sum(it.qtd_m) 
                        + sum(it.qtd_g) 
                        + sum(it.qtd_gg) 
                        + sum(it.qtd_egg) 
                        + sum(it.qtd_exgg) 
                        + sum(it.qtd_u)) as total_geral
                from sugestoessacolas s
                   , itenssugestoessacolas it
                   , produtos p
                where s.situacao = 'R'
                  and it.idsugestaosacola = s.idsugestaosacola
                  and p.idproduto = it.idproduto
                  and ( it.qtd_pp   > 0 
                     or it.qtd_p    > 0
                     or it.qtd_m    > 0
                     or it.qtd_g    > 0
                     or it.qtd_gg   > 0
                     or it.qtd_egg  > 0
                     or it.qtd_exgg > 0
                     or it.qtd_u    > 0 )
                  and :P811_FILTRAR = 'S'
                  and (s.idfilial = :P811_FILIAL OR :P811_FILIAL is null )
                  and (p.idproduto = :P811_PRODUTO OR :P811_PRODUTO is null)
                group by s.idfilial
                       , p.codigosisdist
                       , p.nomeproduto
                order by 1 asc, 12 desc
                ```
        }
        layout {
            sequence: 30
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P811_TIPO
            value: 1
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Dados não encontrados, revisar filtros.
        }
        advanced {
            savedReportMappingIdentifier: 1806059418424807904
