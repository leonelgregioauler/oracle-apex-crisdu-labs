    dynamicAction controlafiltros (
        name: ControlaFiltros1
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P811_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P811_TIPO
            value: 1
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P811_SEMANANOTA
                    P811_DISTRIBUIDOR
                    P811_CONSULTORA
                    P811_NUMERONOTA
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P811_PRODUTO
            }
            execution {
                sequence: 10
            }
        )

    )

