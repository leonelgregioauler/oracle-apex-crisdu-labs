    region sacolas (
        name: % Sacolas
        title: % Sacolas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    pck_romance.fnc_nomefilial(t.idfilial) franquia,
                    pck_romance.fnc_nomerepresentante(t.idrepresentante) distribuidor,
                    pck_romance.fnc_nomevendedora(t.idvendedora) consultora,
                    pck_romance.fnc_cpfvendedora(t.idvendedora) cpf,
                
                    /* média percentual ANTES da sugestão (mantida apenas como métrica histórica) */
                    (
                      select round(
                               avg((nv.valortotalvenda / nullif(nv.valortotalnota, 0)) * 100),
                               2
                             )
                      from notasvendas nv
                      where nv.idvendedora = t.idvendedora
                        and nv.idsituacaonotavenda = 4
                        and nv.idnotavenda < t.idnota_sugestao
                    ) || '%' perc_antes_sacola,
                
                    /* média percentual DEPOIS da sugestão */
                    (
                      select round(
                               avg((nv.valortotalvenda / nullif(nv.valortotalnota, 0)) * 100),
                               2
                             )
                      from notasvendas nv
                      where nv.idvendedora = t.idvendedora
                        and nv.idsituacaonotavenda = 4
                        and nv.idnotavenda >= t.idnota_sugestao
                    ) || '%' perc_pos_sacola,
                
                    /* diferença */
                    (
                      select round(
                               avg((nv.valortotalvenda / nullif(nv.valortotalnota, 0)) * 100),
                               2
                             )
                      from notasvendas nv
                      where nv.idvendedora = t.idvendedora
                        and nv.idsituacaonotavenda = 4
                        and nv.idnotavenda >= t.idnota_sugestao
                    )
                    -
                    (
                      select round(
                               avg((nv.valortotalvenda / nullif(nv.valortotalnota, 0)) * 100),
                               2
                             )
                      from notasvendas nv
                      where nv.idvendedora = t.idvendedora
                        and nv.idsituacaonotavenda = 4
                        and nv.idnotavenda < t.idnota_sugestao
                    )|| '%' diferenca,
                
                    /* quantidade de notas ANTES */
                    (
                      select count(*)
                      from notasvendas nv
                      where nv.idvendedora = t.idvendedora
                        and nv.idsituacaonotavenda = 4
                        and nv.idnotavenda < t.idnota_sugestao
                    ) qtde_notas_antes,
                
                    /* quantidade de notas DEPOIS */
                    (
                      select count(*)
                      from notasvendas nv
                      where nv.idvendedora = t.idvendedora
                        and nv.idsituacaonotavenda = 4
                        and nv.idnotavenda >= t.idnota_sugestao
                    ) qtde_notas_depois,
                    (
                      select sum(
                                   case
                                     when exists (
                                       select 1
                                       from sugestoessacolas ss
                                          , itenssugestoessacolas ii
                                          , itensnotavenda it
                                       where ss.idnotavenda      = nv.idnotavenda
                                         and ii.idsugestaosacola = ss.idsugestaosacola
                                         and it.idnotavenda      = nv.idnotavenda
                                         and it.idestoquefil     = ii.idestoquefil
                                     )
                                     then 1
                                     else 0
                                   end
                                 )
                
                      from notasvendas nv
                      where nv.idvendedora = t.idvendedora
                        and nv.idsituacaonotavenda = 4
                        and nv.idnotavenda >= t.idnota_sugestao
                    ) qtde_recorrencia,
                
                    /* INDICADOR DE RECORRÊNCIA */
                    (
                      select round(
                               ( sum(
                                   case
                                     when exists (
                                       select 1
                                       from sugestoessacolas ss
                                          , itenssugestoessacolas ii
                                          , itensnotavenda it
                                       where ss.idnotavenda      = nv.idnotavenda
                                         and ii.idsugestaosacola = ss.idsugestaosacola
                                         and it.idnotavenda      = nv.idnotavenda
                                         and it.idestoquefil     = ii.idestoquefil
                                     )
                                     then 1
                                     else 0
                                   end
                                 )
                                 / nullif(count(*), 0)
                               ) * 100,
                               2
                             )
                      from notasvendas nv
                      where nv.idvendedora = t.idvendedora
                        and nv.idsituacaonotavenda = 4
                        and nv.idnotavenda >= t.idnota_sugestao
                    ) || '%' indicador_recorrencia,
                
                    (select nv.numeronota from notasvendas nv where nv.idnotavenda = t.idnota_sugestao) notaSacola,
                
                    t.idnota_sugestao idNotaSacola,
                    t.idvendedora,
                    t.idnota_sugestao
                from (
                    select
                        v.idrepresentante,
                        v.idfilial,
                        v.idvendedora,
                        s.idnotavenda idnota_sugestao
                    from vendedoras v
                       , sugestoessacolas s
                    where s.dataenviado is not null
                      and s.idnotavenda is not null
                      and v.idvendedora = s.idvendedora
                      and v.ativo = 'S'
                      and s.idsugestaosacola = (
                            select min(ss.idsugestaosacola)
                            from sugestoessacolas ss
                            where ss.dataenviado is not null
                              and ss.idvendedora = v.idvendedora
                        )
                      and exists (
                            select 1
                            from notasvendas nv
                            where nv.idsituacaonotavenda = 4
                              and nv.idvendedora = v.idvendedora
                              and nv.idnotavenda >= s.idnotavenda
                        )
                      and :P811_FILTRAR = 'S'
                      and (v.idfilial = :P811_FILIAL OR :P811_FILIAL is null)
                      and (v.idrepresentante = :P811_DISTRIBUIDOR OR :P811_DISTRIBUIDOR is null)
                      and (v.idvendedora = :P811_CONSULTORA OR :P811_CONSULTORA is null)
                ) t
                order by 1, 2, 3;
                
                ```
        }
