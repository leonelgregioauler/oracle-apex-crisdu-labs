    pageItem P811_CONSULTORA (
        type: selectList
        label {
            label: <b>Consultora</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido, p.nomepessoa)) || ' (ID: '||v.idvendedora||')' display_value
                             , v.idvendedora                     return_value
                        from pessoas p
                           , vendedoras v
                        where p.idpessoa                    = v.idpessoa
                          and v.idrepresentante             = :P811_DISTRIBUIDOR
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: Todas
        }
        cascadingLov {
            parentItems: P811_DISTRIBUIDOR
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
    )

    pageItem P811_DISTRIBUIDOR (
        type: selectList
        label {
            label: <b>Distribuidor</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                 select pck_romance.fnc_nomepessoa(r.idpessoa)||' - '||idrepresentante display_value
                             , r.idrepresentante                     return_value
                        from representantes r
                        where r.idgerente                   = ( select idgerente
                                                                from gerentes u
                                                                where u.idfilial = :P811_FILIAL )
                  order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: Todos
        }
        cascadingLov {
            parentItems: P811_FILIAL
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
    )

    pageItem P811_FILIAL (
        type: selectList
        label {
            label: <b>Filial</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.ididioma = (select ididioma 
                                      from vw_filiais
                                     where idfilial = :P0_IDFILIAL)
                  
                
                ```
            displayExtraValues: false
            nullDisplayValue: Todas
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
    )

