        type: selectList
        label {
            label: <b>Semana Nota</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                    semanacompleta as display_value
                  , semanacompleta as return_value
                from roman.semana_dias
                where ano between to_char(sysdate-730,'YYYY') and to_char(sysdate,'YYYY')
                order by ano desc, semana desc
                ```
            displayExtraValues: false
