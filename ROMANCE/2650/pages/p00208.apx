    pageItem P208_IDMATRIZRECEITA (
        type: selectList
        label {
            label: Matriz de Receita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ' - Sem Matriz -' d
                     , null r
                from dual
                union
                select m.fornemitente||' - Cliente: '||m.forcliente||' / Conta= '||m.conta||' SubConta= '||m.subconta d
                     , m.idmatrizregrareceita r
                from vw_matrizreceitas m
                where m.idfornecedoremitente = :P208_IDFORNEMITENTE
                  and m.idfornecedorcliente  = :P208_IDFORNDESTINO
                  --and m.ativo = 'S'
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P208_IDFORNEMITENTE
                P208_IDFORNDESTINO
            ]
        }
        layout {
            sequence: 40
            region: @vencimentos-da-nf
            slot: regionBody
            alignment: left
        }
        appearance {
