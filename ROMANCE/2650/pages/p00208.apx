    region lista-de-vencimentos (
        name: Lista de Vencimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.dias
                     , v.datavencimento
                     , v.valor
                     , initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' conta
                     , v.idvencimento
                     , decode(v.tipopagamento, 'D','Depósito','B','Boleto','A','Abatimento','Não informado') "Tipo Pagamento"
                     , ( select cf.nomeconta
                         from contasfinanceiras cf
                         where cf.idcontafinan = v.idcontafinan ) "Conta Financeira"
                     , ( select sb.nomeconta
                         from subcontasfinanceiras sb
                         where sb.idsubcontafinan = v.idsubcontafinan ) "Sub Conta Finan."
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                   , notasfiscais nf
                   , VENCIMENTOSRECEBER v
                where v.idnotafiscal  = nf.idnotafiscal
                  and cb.idbanco      = b.idbanco
                  and cb.idfornecedor = f.idfornecedor
                  and f.idpessoa      = p.idpessoa
                  and cb.idfornecedor = nf.idfornemitente
                  and v.idcontabanc   = cb.idcontabanc
                  and cb.idpessoa     = f.idpessoa
                  and nf.idnotafiscal = :P208_IDNOTAFISCAL
                union
                select v.dias
                     , v.datavencimento
                     , v.valor
                     , initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' conta
                     , v.idvencimento
                     , decode(v.tipopagamento, 'D','Depósito','B','Boleto','A','Abatimento','Não informado') "Tipo Pagamento"
                     , ( select cf.nomeconta
                         from contasfinanceiras cf
                         where cf.idcontafinan = v.idcontafinan ) "Conta Financeira"
                     , ( select sb.nomeconta
                         from subcontasfinanceiras sb
                         where sb.idsubcontafinan = v.idsubcontafinan ) "Sub Conta Finan."
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                   , notasfiscais nf
                   , VENCIMENTOSRECEBER v
                where v.idnotafiscal  = nf.idnotafiscal
                  and cb.idbanco      = b.idbanco
                  and cb.idpessoa     = f.idpessoa
                  and f.idpessoa      = p.idpessoa
                  and cb.idfornecedor = nf.idfornecedordestino
                  and v.idcontabanc   = cb.idcontabanc
                  and cb.idpessoa     = f.idpessoa
                  and nf.idnotafiscal = :P208_IDNOTAFISCAL
                union
                select v.dias
                     , v.datavencimento
                     , v.valor
                     , null conta
                     , v.idvencimento
                     , decode(v.tipopagamento, 'D','Depósito','B','Boleto','A','Abatimento','Não informado') "Tipo Pagamento"
                     , ( select cf.nomeconta
                         from contasfinanceiras cf
                         where cf.idcontafinan = v.idcontafinan ) "Conta Financeira"
                     , ( select sb.nomeconta
                         from subcontasfinanceiras sb
                         where sb.idsubcontafinan = v.idsubcontafinan ) "Sub Conta Finan."
                from notasfiscais nf
                   , VENCIMENTOSRECEBER  v
                where v.idnotafiscal  = nf.idnotafiscal
                  and v.idcontabanc  is null
                  and nf.idnotafiscal = :P208_IDNOTAFISCAL
                union
                select v.dias
                     , v.datavencimento
                     , v.valor
                     , initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' conta
                     , v.idvencimento
                     , decode(v.tipopagamento, 'D','Depósito','B','Boleto','A','Abatimento','Não informado') "Tipo Pagamento"
                     , ( select cf.nomeconta
                         from contasfinanceiras cf
                         where cf.idcontafinan = v.idcontafinan ) "Conta Financeira"
                     , ( select sb.nomeconta
                         from subcontasfinanceiras sb
                         where sb.idsubcontafinan = v.idsubcontafinan ) "Sub Conta Finan."
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                   , notasfiscais nf
                   , VENCIMENTOSRECEBER v
                where v.idnotafiscal  = nf.idnotafiscal
                  and cb.idbanco      = b.idbanco
                  and f.idpessoa      = p.idpessoa
                  and v.idcontabanc   = cb.idcontabanc
                  and cb.idpessoa     = f.idpessoa
                  and nf.idnotafiscal = :P208_IDNOTAFISCAL
                order by 1;
                ```
        }
