    pageItem P208_IDCONTABANC (
        type: selectList
        label {
            label: Conta para Depósito
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                   , notasfiscais nf
                where cb.idbanco      = b.idbanco
                  and cb.idpessoa     = f.idpessoa
                  and f.idpessoa      = p.idpessoa
                  and f.idfornecedor  = nf.idfornemitente
                  and cb.ativo        = 'S'
                  and nf.idnotafiscal = :P208_IDNOTAFISCAL
                union
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                   , notasfiscais nf
                where cb.idbanco      = b.idbanco
                  and cb.idfornecedor = f.idfornecedor
                  and f.idpessoa      = p.idpessoa
                  and cb.idfornecedor = nf.idfornecedordestino
                  and cb.ativo        = 'S'
                  and cb.contaraiz    = 'S'
                  and nf.idnotafiscal = :P208_IDNOTAFISCAL
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 130
            region: @vencimentos-da-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTABANC
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P208_IDCONTAFINAN (
        type: selectList
        label {
            label: Conta Financeira
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomeconta
                     , c.idcontafinan
                from contasfinanceiras c
                where c.ativo = 'S'
                  and exists ( select 1
                               from matrizregrasreceitas mr
                               where mr.idmatrizregrareceita = :P208_IDMATRIZRECEITA
                                 and mr.idcontafinan         = c.idcontafinan )
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P208_IDMATRIZRECEITA
        }
        layout {
            sequence: 60
            region: @vencimentos-da-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTAFINAN
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

