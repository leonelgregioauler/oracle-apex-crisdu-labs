            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDMATRIZREGRARECEITA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  --
                  return :P208_IDMATRIZ;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

