    process busca-matriz-de-receita (
        name: Busca Matriz de Receita
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidfornecedor     number := :P208_IDFORNEMITENTE; 
                  vidfornecedordest number := :P208_IDFORNDESTINO;
                  vidmatrizreceita  number;
                  vidcentrodecusto  number;
                  vidcontafinan     number;
                  vidsubcontafinan  number;
                  vfixavariavel     varchar2(1);
                  vtiporegra        varchar2(1);
                  --
                begin
                  --
                  begin
                    --
                    select m.idmatrizregrareceita
                         , m.idcontafinan
                         , m.idsubcontafinan
                    into vidmatrizreceita
                       , vidcontafinan
                       , vidsubcontafinan
                    from matrizregrasreceitas m
                    where m.idfornecedoremitente = vidfornecedor
                      and m.idfornecedorcliente  = vidfornecedordest
                      and rownum = 1;
                    --
                  exception
                    when others then
                      :P208_IDMATRIZ := null;
                      :P208_IDCONTAFINAN := NULL;
                      :P208_IDSUBCONTAFINAN := NULL;
                  end;
                  --
                  :P208_IDMATRIZ := VIDMATRIZRECEITA;
                  :P208_IDCONTAFINAN := VIDCONTAFINAN;
                  :P208_IDSUBCONTAFINAN := VIDSUBCONTAFINAN;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 12565915090097848
        }
    )

