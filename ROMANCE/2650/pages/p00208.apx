    process remove-deposito-e-extrato (
        name: Remove deposito e extrato
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 20/06/2024 by OSIEL.FERREIRA 
                -- Processo criado para atender evento 9155862.
                declare 
                  -- 
                  vidvencimento number := :P208_IDVENCIMENTO;
                  viddeposito number;
                  vqtddeposito number;
                  --
                begin
                  -- 
                   begin
                    --
                    select count (dp.iddepositodiarios)
                         , dp.iddepositodiarios
                      into vqtddeposito
                         , viddeposito
                    from roman.depositosdiarios_orig dp 
                    where dp.idvencimentoabatimento = vidvencimento
                    group by dp.iddepositodiarios;
                    --
                    exception 
                      when others then 
                        vqtddeposito := 0;
                   end;
                  --
                  if viddeposito > 0 then 
                    --
                    delete roman.extratoscontasbancarias e
                    where e.iddepositodiario_orig = viddeposito;
                    --
                    delete roman.depositosdiarios_orig dp 
                    where dp.idvencimentoabatimento = vidvencimento;
                    --
                    delete roman.vencimentosreceber v 
                    where v.idvencimento = vidvencimento;
                    --
                  else 
                    --
                   delete roman.vencimentosreceber v 
                   where v.idvencimento = vidvencimento;
                    --
                  end if;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 889128206900684804
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

