    validation p208-dias (
        name: P208_DIAS
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P208_DIAS is not null or :P208_DATAVENCIMENTO is not null
                ```
        }
        error {
            errorMessage: Deve ser informado o número de dias ou a data do vencto
            displayLocation: inlineInNotification
            associatedItem: @P208_DIAS
