page 439 (
    name: Arquivos Anexados em Entradas
    title: Arquivos Anexados em Entradas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region arquivos-anexados-em-entradas (
        name: "Arquivos Anexados em Entradas "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.nomearquivo
                     , a.identrada||a.idanexoentrada||substr(a.nomearquivo,instr(a.nomearquivo,'.',-1),10) link
                     , a.dataanexo
                     , ( select roman.pck_romance.fnc_nomeusuario(usuario)
                         from catal.usuarios u
                         where u.idusuario = a.idusuario ) usuario 
                from roman.anexosentradas a
                where a.identrada = :P439_IDENTRADA
                order by a.dataanexo
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 31639985056779519
        }

        column DATAANEXO (
            type: plainText
            heading {
                heading: Dataanexo
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column LINK (
            type: link
            heading {
                heading: Link
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    page: 162
                    items: {
                        P162_ARQUIVO: #LINK#
                    }
                    action: resetPagination
                }
                linkText: Ver Arquivo
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEARQUIVO (
            type: plainText
            heading {
                heading: Nomearquivo
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuario
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 317192 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAANEXO (
                sequence: 3
            )

            displayColumn LINK (
                sequence: 2
            )

            displayColumn NOMEARQUIVO (
                sequence: 1
            )

            displayColumn USUARIO (
                sequence: 4
            )

        )

    )

    pageItem P439_IDENTRADA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @arquivos-anexados-em-entradas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

