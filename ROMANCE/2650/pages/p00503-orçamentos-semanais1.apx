page 503 (
    name: Orçamentos Semanais
    alias: ORÇAMENTOS-SEMANAIS1
    title: Orçamentos Semanais
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1000
        height: 400
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // Função para formatar o número como moeda (com separador de milhar e vírgula para decimal)
            function formatarNumero(valor) {
                // Remove qualquer caractere não numérico, mas mantém apenas os números
                valor = valor.replace(/\D/g, '');
            
                // Se o valor estiver vazio após a limpeza, retorna "0,00"
                if (valor === '') {
                    return '0,00';
                }
            
                // Converte o valor em número, dividindo por 100 para tratar como centavos
                var numeroFormatado = (parseInt(valor) / 100).toFixed(2).replace('.', ',');
            
                // Aplica a formatação de separação de milhar
                numeroFormatado = numeroFormatado.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
            
                // Retorna o valor formatado como moeda
                return numeroFormatado;
            }
            
            // Aplicar a máscara enquanto digita
            $('#P503_VALORORCAMENTO').on('input', function() {
                var valorDigitado = $(this).val(); // Obtém o valor digitado
                var valorFormatado = formatarNumero(valorDigitado); // Formata o valor
                $(this).val(valorFormatado); // Aplica o valor formatado ao campo
            });
            
            ```
    }

    region orçamentos-semanais (
        name: Orçamentos Semanais
        type: form
        source {
            location: localDatabase
            tableName: ORCAMENTOSPEDIDOSCOMPRAS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P503_IDFORNECEDOR (
        type: selectOne
        label {
            label: <strong>Fornecedor:</strong>
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select upper(p.nomepessoa) d
                     , f.idfornecedor r
                  from fornecedores f
                     , pessoas p
                 where f.idpessoa = p.idpessoa
                   and f.ativo = 'S'
                ```
        }
        layout {
            sequence: 30
            region: @orçamentos-semanais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        source {
            formRegion: @orçamentos-semanais
            column: IDFORNECEDOR
            dataType: number
        }
    )

    pageItem P503_IDORCAMENTOPEDIDOCOMPRA (
        type: hidden
        layout {
            sequence: 10
            region: @orçamentos-semanais
            slot: regionBody
        }
        source {
            formRegion: @orçamentos-semanais
            column: IDORCAMENTOPEDIDOCOMPRA
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P503_IDPROMOCAOCOMPRA (
        type: selectList
        label {
            label: <strong>Promoção:</strong>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomepromocao d
                     , idpromocaocompra 
                  from promocoescompras
                 where trunc(sysdate) between validadeinicial and validadefinal
                 order by 1
                ```
        }
        layout {
            sequence: 40
            region: @orçamentos-semanais
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        source {
            formRegion: @orçamentos-semanais
            column: IDPROMOCAOCOMPRA
            dataType: number
        }
    )

    pageItem P503_IDSEMANA (
        type: selectOne
        label {
            label: <strong>Semana de Início:</strong>
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semanacompleta || ' - ' || s.dt_ini || ' a ' || s.dt_fim d
                     , idsemana r
                  from semana_dias s
                 where idsemana > (select idsemana
                                     from semana_dias
                                    where sysdate between dt_ini and dt_fim) - 12 
                        /*idsemana in (select distinct idsemana 
                                       from orcamentoscomprasfinanceiro)*/
                                      
                  order by idsemana
                ```
        }
        layout {
            sequence: 60
            region: @orçamentos-semanais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        source {
            formRegion: @orçamentos-semanais
            column: IDSEMANA
            dataType: number
        }
    )

    pageItem P503_SALDO (
        type: numberField
        label {
            label: <strong>Saldo disponível para a semana:</strong>
            alignment: left
        }
        layout {
            sequence: 70
            region: @orçamentos-semanais
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            formatMask: 999G999G999G999G990D00
            width: 30
        }
    )

    pageItem P503_VALORORCAMENTO (
        type: numberField
        label {
            label: <strong>Valor Orçamento:</strong>
            alignment: left
        }
        layout {
            sequence: 80
            region: @orçamentos-semanais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            formatMask: 999G999G999G999G990D00
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @orçamentos-semanais
            column: VALORORCAMENTO
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @orçamentos-semanais
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 502
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir Orçamento
        layout {
            sequence: 40
            region: @orçamentos-semanais
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P503_IDORCAMENTOPEDIDOCOMPRA
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @orçamentos-semanais
            slot: delete
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-scissors
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P503_IDORCAMENTOPEDIDOCOMPRA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @orçamentos-semanais
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P503_IDORCAMENTOPEDIDOCOMPRA
        }
    )

    dynamicAction infoma-orçamento-disponivel (
        name: Infoma orçamento disponivel
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P503_IDSEMANA
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P503_SALDO
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select max(o.valordisponivelsemana) - nvl(sum(p.valororcamento),0)
                      from ORCAMENTOSCOMPRASFINANCEIRO o
                         , ORCAMENTOSPEDIDOSCOMPRAS p
                     where o.idsemana = p.idsemana(+)
                       and o.idsemana = :P503_IDSEMANA
                    ```
                itemsToSubmit: P503_IDSEMANA
            }
            affectedElements {
                selectionType: items
                items: P503_SALDO
            }
            execution {
                sequence: 20
            }
        )

    )

    process initialize-form-orçamentos-semanais (
        name: Initialize form Orçamentos Semanais
        type: formInitialization
        formRegion: @orçamentos-semanais
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 48922256640879769
        }
    )

    process process-form-orçamentos-semanais (
        name: Process form Orçamentos Semanais
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vmd5 varchar2(4000);
                  voperacao varchar2(1);
                  vid number;
                  vvalor number;
                  vsaldo number;
                  vexistente number;
                  vsemanaatual number;
                  vtemorcamentosemanal number;
                  vqtdsemanas number;
                  vpromocao number;
                  --:P503_IDPROMOCAOCOMPRA
                 
                begin
                  -- Captura valores
                  vid := :P503_IDORCAMENTOPEDIDOCOMPRA;
                  vvalor := to_number(:P503_VALORORCAMENTO,'999G999G999G999G990D00');
                 
                  -- Define operação
                  if v('REQUEST') = 'CREATE' then
                    voperacao := 'I';
                  elsif v('REQUEST') = 'SAVE' then
                    voperacao := 'U';
                  elsif v('REQUEST') = 'DELETE' then
                    voperacao := 'D';
                  else
                    voperacao := 'S';
                  end if;
                 
                  -- Verificar semana atual
                  select idsemana
                    into vsemanaatual
                    from semana_dias
                   where trunc(sysdate) between dt_ini and dt_fim;
                 
                  -- 1. Verificar se já existe orçamento para o mesmo fornecedor e semana
                  if voperacao = 'I' then
                    select count(1)
                      into vexistente
                      from orcamentospedidoscompras
                     where idfornecedor = :P503_IDFORNECEDOR
                       and idsemana = :P503_IDSEMANA;
                 
                    -- Se já existir e a semana informada for menor ou igual à atual, bloquear
                    if vexistente > 0 and :P503_IDSEMANA <= vsemanaatual then
                      APEX_ERROR.ADD_ERROR(
                        p_message => 'Já existe orçamento para este fornecedor nesta semana. Só é permitido criar para semanas futuras.',
                        p_display_location => APEX_ERROR.c_inline_in_notification
                      );
                 
                    elsif vexistente = 0 and :P503_IDSEMANA < vsemanaatual then
                      APEX_ERROR.ADD_ERROR(
                        p_message => 'Só é permitido criar para semanas futuras.',
                        p_display_location => APEX_ERROR.c_inline_in_notification
                      );
                 
                    elsif vexistente > 0 then
                      -- Se já existir e for futura, apenas alerta de duplicidade
                      APEX_ERROR.ADD_ERROR(
                        p_message => 'Já existe orçamento para este fornecedor nesta semana.',
                        p_display_location => APEX_ERROR.c_inline_in_notification
                      );
                    end if;
                  end if;
                 
                  -- 2. Verificar se existe orçamento financeiro para a semana
                  select count(1)
                    into vtemorcamentosemanal
                    from orcamentoscomprasfinanceiro
                   where idsemana = :P503_IDSEMANA;
                 
                  if vtemorcamentosemanal = 0 then
                    APEX_ERROR.ADD_ERROR(
                      p_message => 'Não há orçamento financeiro definido para esta semana.',
                      p_display_location => APEX_ERROR.c_inline_in_notification
                    );
                  end if;
                 
                  -- 3. Verificar se a semana é anterior à semana atual
                /* if :P503_IDSEMANA < vsemanaatual then
                    APEX_ERROR.ADD_ERROR(
                      p_message => 'Não é permitido criar orçamento para semana anterior à atual.',
                      p_display_location => APEX_ERROR.c_inline_in_notification
                    );
                  end if;*/
                 
                  -- 4. Validação de saldo disponível
                  begin
                    select max(o.valordisponivelsemana) - sum(p.valororcamento)
                      into vsaldo
                      from orcamentoscomprasfinanceiro o,
                           orcamentospedidoscompras p
                     where o.idsemana = p.idsemana
                       and o.idsemana = :P503_IDSEMANA;
                  exception
                    when others then
                      vsaldo := null;
                  end;
                 
                  if vsaldo is not null and vsaldo < vvalor and voperacao not in ('D') then
                    APEX_ERROR.ADD_ERROR(
                      p_message => 'Saldo insuficiente para este valor de orçamento.',
                      p_display_location => APEX_ERROR.c_inline_in_notification
                    );
                  end if;
                 
                  -- Chamada da procedure principal
                  pck_compras_romance.prc_orcamentospedidoscompras(
                    pidorcamentopedidocom   => vid,
                    pidpromocaocompra       => vpromocao,--:P503_IDPROMOCAOCOMPRA,
                    pidfornecedor           => :P503_IDFORNECEDOR,
                    pidsemana               => :P503_IDSEMANA,
                    pvalororcamento         => vvalor,
                    pquantidadesemanas      => vqtdsemanas,
                    pmd5                    => vmd5,
                    poperacao_dml           => voperacao
                  );
                 
                  :P503_IDORCAMENTOPEDIDOCOMPRA := vid;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Sucesso!
        }
        advanced {
            executionMappingIdentifier: 48922683692879769
        }
    )

    branch (
        name: Go To Page 503
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 503
                items: {
                    P503_IDORCAMENTOPEDIDOCOMPRA: &P503_IDORCAMENTOPEDIDOCOMPRA.
                }
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,CREATE
        }
    )

    branch (
        name: Go To Page 502
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 502
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CANCEL,DELETE
        }
    )

)

