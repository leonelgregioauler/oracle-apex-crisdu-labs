page 302 (
    name: Cadastro de Sub Categorias
    title: Cadastro de Sub Categorias
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-caracteristicascategorias (
        name: Form on CARACTERISTICASCATEGORIAS
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P302_IDCARACTERISTICACATEG (
        type: hidden
        layout {
            sequence: 10
            region: @form-on-caracteristicascategorias
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCARACTERISTICACATEG
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P302_IDCATEGORIA (
        type: selectList
        label {
            label: Categoria
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nome) d
                     , idcategoria r
                from categorias c
                order by 1
                ```
            nullDisplayValue: - Selecione a Categoria -
        }
        layout {
            sequence: 30
            region: @form-on-caracteristicascategorias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDCATEGORIA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P302_NOME (
        type: textField
        label {
            label: Nome
            alignment: left
        }
        layout {
            sequence: 20
            region: @form-on-caracteristicascategorias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: NOME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P302_TIPO (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Material;M,Caracteristica;C,Outros;D
            nullDisplayValue: - Selecione o Tipo -
        }
        layout {
            sequence: 40
            region: @form-on-caracteristicascategorias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: TIPO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 20
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 301
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Cadastrar
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P302_IDCARACTERISTICACATEG
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 30
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P302_IDCARACTERISTICACATEG
        }
    )

    button novo (
        buttonName: NOVO
        label: Nova
        layout {
            sequence: 10
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P302_IDCARACTERISTICACATEG
        }
    )

    process fetch-row-from-caracteristicascategorias (
        name: Fetch Row from CARACTERISTICASCATEGORIAS
        type: autoRowFetch
        source {
            tableName: CARACTERISTICASCATEGORIAS
            pkColumn: IDCARACTERISTICACATEG
            pkItem: P302_IDCARACTERISTICACATEG
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1467001979587614930
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P302_IDCARACTERISTICACATEG IS NULL THEN
                    --
                    SELECT SEQ_IDCARACTERISTICACATEG.NEXTVAL
                    INTO :P302_IDCARACTERISTICACATEG
                    FROM DUAL;
                    --
                  END IF;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1466983956165960908
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process limpar-campos (
        name: Limpar Campos
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 1466984392880960912
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process process-row-of-caracteristicascategorias (
        name: Process Row of CARACTERISTICASCATEGORIAS
        type: autoRowProcessing
        target {
            tableName: CARACTERISTICASCATEGORIAS
            pkColumn: IDCARACTERISTICACATEG
            pkItem: P302_IDCARACTERISTICACATEG
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Ação processada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1467002344096614931
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 301
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)

