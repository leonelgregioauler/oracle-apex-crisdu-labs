    validation p127-email (
        name: P127_EMAIL
        execution {
            sequence: 10
        }
        validation {
            type: itemContainsAtLeastOneOfCharsInValue
            item: P127_EMAIL
            value: @
        }
        error {
            errorMessage: Não é valído.
            associatedItem: @P127_EMAIL
        }
    )

