    process fetch-row-from-pessoas (
        name: Fetch Row from PESSOAS
        type: autoRowFetch
        source {
            tableName: PESSOAS
            pkColumn: IDPESSOA
            pkItem: P127_IDPESSOA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 187200935938754748
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_PESSOAS.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P127_IDPESSOA := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 187201120512754750
        }
