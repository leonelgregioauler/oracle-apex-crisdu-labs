page 127 (
    name: Cadastro de Pessoas
    title: Cadastro de Pessoas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
        executeWhenPageLoads:
            ```javascript-browser
            self.focus();
            opener.location.reload();
            self.focus();
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region cadastro-de-pessoas (
        name: Cadastro de Pessoas
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <script language="Javascript">
                function fnc_popup_filial()
                {
                  vidfilial = document.getElementById("P9_IDFILIAL").value;
                  vidpessoafilial = document.getElementById("P9_IDPESSOA").value;
                  window.open('f?p=&APP_ID.:10:&SESSION.::NO::P10_IDFILIAL,P10_IDPESSOA:'+vidfilial +','+ vidpessoafilial ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=200,left=250,top=100','_blank'); void(0);
                }
                
                function fnc_popup_gerente()
                {
                  vidgerente = document.getElementById("P9_IDGERENTE").value;
                  vidpessoagerente = document.getElementById("P9_IDPESSOA").value;
                  window.open('f?p=&APP_ID.:11:&SESSION.::NO::P11_IDGERENTE,P11_IDPESSOA:'+vidgerente +','+ vidpessoagerente ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=200,left=250,top=100','_blank'); void(0);
                }
                
                function fnc_popup_representante()
                {
                  vidrepresentante = document.getElementById("P9_IDREPRESENTANTE").value;
                  vidpessoarepresentante = document.getElementById("P9_IDPESSOA").value;
                  window.open('f?p=&APP_ID.:12:&SESSION.::NO::P12_IDREPRESENTANTE,P12_IDPESSOA:'+vidrepresentante +','+ vidpessoarepresentante ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=150,left=250,top=100','_blank'); void(0);
                }
                
                function fnc_popup_vendedora()
                {
                  vidvendedora = document.getElementById("P9_IDVENDEDORA").value;
                  vidpessoavendedora = document.getElementById("P9_IDPESSOA").value;
                  window.open('f?p=&APP_ID.:13:&SESSION.::NO::P13_IDVENDEDORA,P13_IDPESSOA:'+vidvendedora +','+ vidpessoavendedora ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=200,left=250,top=100','_blank'); void(0);
                }
                
                function fnc_popup_fornecedor()
                {
                  vidfornecedor = document.getElementById("P9_IDFORNECEDOR").value;
                  vidpessoafornecedor = document.getElementById("P9_IDPESSOA").value;
                  window.open('f?p=&APP_ID.:14:&SESSION.::NO::P14_IDFORNECEDOR,P14_IDPESSOA:'+vidfornecedor +','+ vidpessoafornecedor ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=200,left=250,top=100','_blank'); void(0);
                }
                
                function fnc_popup_funcionario()
                {
                  vidfuncionario = document.getElementById("P9_IDFUNCIONARIO").value;
                  vidpessoafuncionario = document.getElementById("P9_IDPESSOA").value;
                  window.open('f?p=&APP_ID.:18:&SESSION.::NO::P18_IDFUNCIONARIO,P18_IDPESSOA:'+vidfuncionario +','+ vidpessoafuncionario ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=100,left=250,top=100','_blank'); void(0);
                }
                
                function fnc_formatacep(campo, teclapres)
                {
                  var tecla = teclapres.keyCode;
                  var vr = new String(campo.value);
                  vr = vr.replace("-", "");
                  tam = vr.length + 1;
                  if (tecla != 8)
                  {
                    if (tam == 6)
                    campo.value = vr.substr(0, 5) + '-' + vr.substr(5, 5);
                  }
                }
                
                function fnc_telefone(objeto)
                { 
                   if(objeto.value.length == 0)
                     objeto.value = '(' + objeto.value;
                
                   if(objeto.value.length == 3)
                      objeto.value = objeto.value + ')';
                
                 if(objeto.value.length == 8)
                     objeto.value = objeto.value + '-';
                }
                
                </script>
                ```
        }
    )

