    pageItem P127_IDCIDADE (
        type: selectList
        label {
            label: Cidade
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nome||' - '||e.sigla display_value
                     , c.idcidade return_value 
                from cidades c 
                   , estados e 
                where c.idestado = e.idestado
                order by 1
                ```
            nullDisplayValue: - Selecione Cidade -
        }
        layout {
            sequence: 70
            region: @cadastro-de-pessoas
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDCIDADE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

