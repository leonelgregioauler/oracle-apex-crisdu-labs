    region pagamentos-semanais-de-fornecedores (
        name: Pagamentos Semanais de Fornecedores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT favorita.pck_util_fav.fnc_nomefornecedor(p.idfornecedor) fornecedor
                     , p.idsemanaoriginal idsemanainicio
                     , COUNT(i.idproduto)    qtdsku
                     , SUM(i.qtdnegociada)   qtdpecassemana
                     , SUM(i.valortotal)     valorgasto
                     , p.idorcamentopedidocompra editar
                     , p.idpedidocompraroman verpedido
                     , p.pagamento
                     , p.observacao
                     , p.justificativaentrega
                     , ( SELECT st.descricao
                         FROM situacoesentregascomp st
                         WHERE st.idsituacaoentregacomp = p.situacaoentrega ) situacaoentrega
                     , ( select oc.valororcamento
                         from roman.orcamentospedidoscompras oc
                         where oc.idsemana = p.idsemanaentrega
                           and oc.idfornecedor = p.idfornecedor ) valororcamento
                FROM roman.pedidoscomprasroman      p
                   , roman.itenspedidocompraroman   i
                WHERE i.idpedidocompraroman = p.idpedidocompraroman 
                  AND p.idsemanaentrega = :P506_IDSEMANA
                GROUP BY p.idfornecedor
                       , p.idorcamentopedidocompra
                       , p.idsemanaoriginal
                       , p.idsemanaentrega
                       , p.idpedidocompraroman
                       , p.pagamento
                       , p.observacao
                       , p.justificativaentrega
                       , p.situacaoentrega
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1334188671392710403
        }

