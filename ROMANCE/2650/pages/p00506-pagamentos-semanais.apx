    region pagamentos-semanais-de-fornecedores-2 (
        name: Pagamentos Semanais de Fornecedores
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P506_IDSEMANA (
        type: selectList
        label {
            label: <strong>Semana:</strong>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semanacompleta || ' - ' || s.dt_ini || ' a ' || s.dt_fim d
                     , idsemana r
                  from semana_dias s
                 where exists (select 1
                                 from orcamentoscomprasfinanceiro
                                where idsemana = s.idsemana)
                  order by idsemana
                ```
        }
        layout {
            sequence: 10
            region: @pagamentos-semanais-de-fornecedores-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--xlarge
            ]
            height: 1
        }
    )

