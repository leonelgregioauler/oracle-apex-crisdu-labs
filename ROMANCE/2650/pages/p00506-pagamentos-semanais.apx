    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P506_IDSEMANA
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @pagamentos-semanais-de-fornecedores
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(nvl(valordisponivelsemana,0),'999g999g999g999g990d00')
                         , to_char(nvl((select sum(valororcamento) 
                                          from orcamentospedidoscompras
                                         where idsemana = o.idsemana ),0),'999g999g999g999g990d00') valorutilizado
                         , to_char(valordisponivelsemana - nvl((select sum(valororcamento) 
                                                                  from orcamentospedidoscompras
                                                                 where idsemana = o.idsemana ),0),'999g999g999g999g990d00') Saldo
                      from orcamentoscomprasfinanceiro o
                     where o.idsemana = :P506_IDSEMANA
                       and :P506_IDSEMANA is not null;
                    ```
                itemsToSubmit: P506_IDSEMANA
            }
            affectedElements {
                selectionType: items
                items: [
                    P506_VALORORCADO
                    P506_UTILIZADO
                    P506_SALDO
                ]
            }
            execution {
                sequence: 20
            }
        )

    )

    process process-form-orçamentos-semanais (
        name: Process form Orçamentos Semanais
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vmd5 varchar2(4000);
                  voperacao varchar2(1);
                  vid number;
                  vvalor number;
                begin
                  --
                  vid := :P506_IDORCAMENTOPEDIDOCOMPRA;
                  vvalor := to_number(:P506_VALORORCAMENTO,'999g999g999g999g999d00');
                  --
                  --raise_application_error(-20001,'teste '||v('REQUEST') );
                  if v('REQUEST')  = 'CREATE' then
                      voperacao := 'I';
                  elsif v('REQUEST')  = 'SAVE' then
                      voperacao := 'U';
                  elsif v('REQUEST')  = 'DELETE' then
                      voperacao := 'D';
                  else
                      voperacao := 'S';
                  end if;
                  --
                  --
                  -- raise_application_error(-20001,'Numero '||vvalor);
                  pck_compras_romance.prc_orcamentospedidoscompras(pidorcamentopedidocom => vid,
                                                                   pidpromocaocompra     => :P506_IDPROMOCAOCOMPRA,
                                                                   pidfornecedor         => :P506_IDFORNECEDOR,
                                                                   pidsemana             => :P506_IDSEMANA,
                                                                   pvalororcamento       => vvalor,
                                                                   pquantidadesemanas    => :P506_QUANTIDADESEMANAS,
                                                                   pmd5                  => vmd5,
                                                                   poperacao_dml         => voperacao);
                  
                  commit;
                  --
                  :P506_IDORCAMENTOPEDIDOCOMPRA := vid;
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 49213345386812887
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 506
            }
        }
    )

)

