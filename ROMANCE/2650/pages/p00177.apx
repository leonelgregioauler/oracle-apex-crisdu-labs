page 177 (
    name: Vendas Romance x Favorita
    title: Vendas Romance x Favorita
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region vendas-romance-x-favorita (
        name: Vendas Romance x Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select filial "Filial" 
                     , semana
                     , ano "Ano"
                     , totalcobranca "Total Cobrança"
                     , totalfavorita  "Total Venda Favorita"
                     ,  decode(nvl(totalcobranca, 0), 0,0, ( totalfavorita * 100 / totalcobranca )  )  "% Fav"
                from (
                      select pck_romance.fnc_nomefilial(pidfilial =>  f.idfilial ) filial
                           , f.semana
                           , substr(f.semana,4,4) ano
                           , f.totalcobranca totalcobranca
                           , nvl(( select sum(pck_romance.fnc_pontuacaofavorita( psemanaini => f.semana, psemanafim => f.semana, pidrepresentante => r.idrepresentante))
                               from representantes r
                               where exists ( select 1
                                              from gerentes g
                                              where g.idgerente = r.idgerente
                                                and g.idfilial = f.idfilial ) ),1) totalfavorita
                      from fechamentossemanais f
                      where f.idsemana > ( select idsemana
                                           from semana_dias s
                                           where s.ano    = 2015
                                             and s.semana = 01 )
                      order by 1, f.idfechamento )
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
