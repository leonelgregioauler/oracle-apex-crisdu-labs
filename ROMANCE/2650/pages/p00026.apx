    dynamicAction atualizar-relatório (
        name: atualizar relatório
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P26_TIPOFORNECEDOR
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @compras
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction mostra-datas (
        name: Mostra Datas
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P26_FILTRAR_DATA
        }
        clientSideCondition {
            type: item=value
            item: P26_FILTRAR_DATA
            value: I
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P26_DATAINICIO
                    P26_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P26_DATAINICIO
                    P26_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 563 - Analítico de Vencimentos
        execution {
            sequence: 5
        }
        behavior {
            target: {
                page: 563
                action: resetPagination
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @analitico-vencimentos
        }
    )

    branch (
        name: Go To Page 26
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 26
                items: {
                    P26_IDFORNECEDOR: &P26_IDFORNECEDOR.
                    P26_TIPOFILIALDESTINO: &P26_TIPOFILIALDESTINO.
                    P26_DOCUMENTO: &P26_DOCUMENTO.
                    P26_ANO: &P26_ANO.
                    P26_SEMANA: &P26_SEMANA.
                    P26_SITUACAORECEBIMENTO: &P26_SITUACAORECEBIMENTO.
                }
                action: resetPagination
            }
        }
    )

)

