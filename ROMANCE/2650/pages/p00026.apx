    dynamicAction atualiza-relatório (
        name: atualiza relatório
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P26_IDFORNECEDOR
                P26_TIPOFILIALDESTINO
                P26_TIPOPRODUTO
                P26_DOCUMENTO
                P26_ANO
                P26_SEMANA
                P26_IDFILIALEMITENTE
                P26_SITUACAORECEBIMENTO
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @compras
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

