    pageItem P26_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(semana,'00')||'/'||ano display_value
                     , idsemana return_value
                from semana_dias s
                where s.dt_fim < trunc(sysdate)
                  and ( :P26_ANO is null or ano = :P26_ANO)
                order by idsemana desc
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 80
            region: @filtro-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P26_SITUACAORECEBIMENTO (
        type: radioGroup
        label {
            label: Situação
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Todas;T,Aguardando Recebimento;A,Parcialmente Recebida;P,Recebida;R
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P26_TIPOFILIALDESTINO (
        type: radioGroup
        label {
            label: Tipo Empresa Destino
            alignment: left
        }
        settings {
            noOfCols: 3
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao display_value
                     , idtipofilial return_value
                from tiposfiliais
                order by descricao
                
                ```
            displayExtraValues: false
            nullDisplayValue: - Todas -
            nullReturnValue: X
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: X
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P26_TIPOFORNECEDOR (
        type: selectMany
        label {
            label: Tipo Fornecedor
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.descricao d, v.sigla r
                      from roman.siglasistema s
                         , roman.valorsiglasistema v
                     where s.idsiglasistema = v.idsiglasistema
                       and s.nomesigla = 'TIPO_FORNECEDOR'
                ```
        }
        multipleValues {
            separator: /
        }
        layout {
            sequence: 100
            region: @filtro-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P26_TIPOPRODUTO (
        type: radioGroup
        label {
            label: Tipo de Produto
            alignment: left
        }
        settings {
            noOfCols: 3
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: staticValues
            staticValues: STATIC:Todos;T,Venda Romance;V,Impostos e Afins;I
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: T
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    button analitico-vencimentos (
        buttonName: ANALITICO_VENCIMENTOS
        label: Analítico de Vencimentos
        layout {
            sequence: 60
            region: @compras
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-table
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Nova Compra
        layout {
            sequence: 30
            region: @compras
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 27
                clearCache: 27
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: pck_util.fnc_verificaacesso(2652,v('APP_USER')) = 'S' -- --NOTA_FISCAL_NOVA_COMPRA (T9892351)
        }
    )

    button entradas-virtualage (
        buttonName: ENTRADAS_VIRTUALAGE
        label: Entradas Virtual Age
        layout {
            sequence: 50
            region: @compras
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 427
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                pck_util.fnc_verificaacesso(2744,v('APP_USER')) = 'S'
                or v('APP_USER') = 'DIEGOPIECHO'
                ```
        }
    )

    button lancamento-diverso (
        buttonName: LANCAMENTO_DIVERSO
        label: Lançamentos Diversos
        layout {
            sequence: 40
            region: @compras
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 374
                items: {
                    P374_DOCUMENTO:
                    P374_FORMAPAGAMENTO:
                    P374_IDFORNECEDOR:
                    P374_INICIAR: N
                    P374_VENCIMENTO:
                    P374_IDNOTAFISCAL:
                    P374_IDFILIALDESTINO:
                    P374_IDRAZAOSOCIALDESTINO:
                    P374_IDRAZAOSOCIALFORN:
                    P374_IDLANCAMENTODIVERSO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button lucratividadegeral (
        buttonName: LUCRATIVIDADEGERAL
        label: Ir p/ Lucrat. Geral
        layout {
            sequence: 10
            region: @filtro-2
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 193
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2665,v('APP_USER')) = 'S'
                ```
        }
    )

    dynamicAction atualiza-rel-data-fim (
        name: Atualiza Rel Data fim
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P26_DATAFIM
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @compras
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction atualiza-rel-data-inicio (
        name: Atualiza Rel Data Inicio
        execution {
            sequence: 40
        }
