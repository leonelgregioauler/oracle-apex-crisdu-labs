        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function abrejanela(pid)
            {
              window.open('f?p=&APP_ID.:187:&SESSION.::NO:187:P187_IDNOTAVENDA:'+pid ,'analisar','toolbar=no,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width=1000,height=800,screenX=100,screenY =200'); 
