    }
    help {
        helpText: No help is available for this page.
    }

    region compras (
        name: Compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ FIRST_ROWS(50) */ nf.IDNOTAFISCAL
                     , to_char(nf.dtnf,'RRRR') ANO
                     , to_char(nf.dtnf,'MONTH') mes
                     , nf.nrnf 
                     , decode( nf.tiponota, 'T', 'Transferência'
                                          , 'C', 'Compra'
                                          , 'A', 'Abastecimento'
                                          , 'R', 'Requisição Pgto'
                                          , 'D', 'Despesa') "Tipo NF"
                     , decode( nf.tiponota, 'T', pck_romance.fnc_nomefilial(pidfilial => nf.idfilialemitente  )
                                               , nvl( pck_romance.fnc_nomefornecedor(pidforn =>  nf.idfornemitente  ) , pck_romance.fnc_nomefilial(pidfilial => nf.idfilialemitente  ) )  )Emitente
                     , (select r.cnpj
                          from roman.razoessociaisfornec r
                         where r.idrazaosocialforn = nf.idrazaosocialfornemit) "CNPJ Emitente"
                     , pck_romance.fnc_nomefilial(pidfilial => nf.idfilialdestino ) "Filial Destino"
                     , pck_romance.fnc_nometransportadora(pidtransp => nf.idtransportadora )  "Transportadora"
                     , nf.dtnf 
                     , ( select sum(valor + nvl(acrescimo,0)) from vencimentos v where v.idnotafiscal = nf.idnotafiscal ) totalvencimentos -- Acrescimo T9955953
                     , ( select sum(rt.valor) from roman.rateiosnotasfiscais rt where rt.idnotafiscal = nf.idnotafiscal ) totalrateios
                     , ( select v.descricao
                           from fornecedores f
                              , roman.siglasistema s
                              , roman.valorsiglasistema v
                          where f.idfornecedor    = nf.idfornemitente
                            and s.idsiglasistema  = v.idsiglasistema
                            and s.nomesigla       = 'TIPO_FORNECEDOR'
                            and v.sigla           = f.tipo_fornecedor ) "Tipo Fornecedor"
                     , ( select sum((nvl(qtd_pp,0) + nvl(qtd_p,0) + nvl(qtd_m,0) + nvl(qtd_g,0) + nvl(qtd_gg,0) + nvl(qtd_egg,0)+ nvl(qtd_exgg,0) + nvl(qtd_u,0)) * inf.custound)
                         from itemnf inf
                         where inf.idnotafiscal = nf.idnotafiscal ) totalitens
                     , ( select sum(valor) + ( sum(valor) *0.1)   from vencimentos v where v.idnotafiscal = nf.idnotafiscal ) valortotalfilial
                     , decode(NF.SITUACAO,'A','Ativa/Aprovado'
                                         ,'C','Cancelada'
                                         ,'P','Aguardando Aprovação'
                                         ,'E','Aguardando Envio para Aprovação'
                                         ,'U','Ajuste'
                                         ,'Ativa') Situacao
                     , decode(NF.SITUACAOFILIAL,'A','Aguardando Recebimento','R','Recebida','P','Parcialmente Recebida') "Situação Recebimento"
                     , nf.documento 
                     , initcap(nf.USUARIO) "Usuário"
                     , nf.conhecimentotransporte "CTE"
                     , nf.observacao "Observação"
                  /*   , ( select sum(valor) 
                         from fabri.vencimentosnotavenda v 
                         where v.idnotavenda = ( select idnotavenda
                                                    from fabri.notasvendas nv
                                                    where nv.nrodocumento = nf.documento ) ) totalvencimentosfabrica
                     , ( select sum((nvl(qtd_pp,0) + nvl(qtd_p,0) + nvl(qtd_m,0) + nvl(qtd_g,0) + nvl(qtd_gg,0) + nvl(qtd_egg,0) + nvl(qtd_u,0)) * inv.valorvenda)
                         from fabri.itensnotavenda inv
                         where inv.idnotavenda = ( select idnotavenda
                                                    from fabri.notasvendas nv
                                                    where nv.nrodocumento = nf.documento ) ) totalitensfabrica*/
                     , ( select pc.idpedidocompra from pedidoscompras pc where pc.idpedidocompra = nf.idpedidocompra ) "Pedido de Compra"
                     , DATARECEBIMENTO "Data Recebimento"
                     , nf.idsemananota 
                     , pck_util.fnc_semanaid(nf.idsemananota ) semana
                     --,(select count(1) from anexosnotasfiscais a where a.idnotafiscal = nf.idnotafiscal) "Qtd Anexos"
                     , ( select sum(conta)
                         from ( select count(1) conta
                                from roman.anexosrequisicoes an
                                   , roman.requisicoespagamentos r
                                where r.idrequisicaopgto = an.idrequisicaopgto
                                  and r.idnotafiscal =  nf.idnotafiscal
                         union
                         select count(1) conta
                         from anexosnotasfiscais a 
                         where a.idnotafiscal = nf.idnotafiscal) )"Qtd Anexos"
                     , pck_estoque.fnc_verifidivergconfnota(nf.idnotafiscal) "Possui divergência"
                     , volumes 
                     , DATAINCLUSAO
                     , decode(nf.antecipacao,'S','Sim','Não') antecipacao
                     , decode(nf.provisao,'S','Sim','Não') provisao
                     , nvl( ( select 'CNPJ: '||rr.cnpj
                              from razoessociaisfiliais rr
                              where rr.idrazaosocialfilial = nf.idrazaosocialfildestino ) , ( select 'CNPJ: '||cnpj
                                                                                              from razoessociaisfornec e
                                                                                              where e.idrazaosocialforn = nf.idrazaosocialforndest ) ) identificacaodestino
                     , ( select t.descricao
                         from tiposlancamentos t
                         where t.idtipolancamento = nf.idtipolancamento ) tipolancamento
                     , ( select rp.usuarioinclusao
                           from roman.requisicoespagamentos rp
                              , roman.notasfiscais n
                          where rp.idnotafiscal     = n.idnotafiscal
                            and n.idnotafiscal      = nf.idnotafiscal) "Usuário Inclusão Requisição"
                     , nf.IDNOTAFISCAL link_akp27
                     , ( select sum(vc.valor)
                         from vencimentos vc
                         where vc.idnotafiscal = nf.idnotafiscal
                           and exists ( select 1
                                        from pagamentosfornecedores pf
                                        where pf.idvencimento = vc.idvencimento
                                          and pf.idnotafiscal = nf.idnotafiscal ) ) valores_v1
                     , ( select sum(vv.valor)
                         from vencimentos vv
                         where vv.idnotafiscal = nf.idnotafiscal
                           and exists ( select 1
                                        from extratoscontasbancarias e
                                        where e.idvencimento = vv.idvencimento ) ) valores_v2
                     -- 23/10/2026 - Valores efetivamente pagos (as tabelas de pagamento sao geradas junto com a fatura)
                     --   V1: pagamento com DATABAIXA preenchida (valor pago, ja com desconto/acrescimo)
                     --   V2: movimento no extrato com data ate hoje
                     , ( select sum(pg.valorpago)
                         from vencimentos vc
                            , pagamentosfornecedores pg
                         where vc.idnotafiscal = nf.idnotafiscal
                           and pg.idvencimento = vc.idvencimento
                           and pg.databaixa is not null
                           and not exists ( select 1
                                            from extratoscontasbancarias e
                                            where e.idvencimento = vc.idvencimento ) ) pago_v1
                     , ( select sum(vv.valor - nvl(vv.desconto,0) + nvl(vv.acrescimo,0))
                         from vencimentos vv
                         where vv.idnotafiscal = nf.idnotafiscal
                           and exists ( select 1
                                        from extratoscontasbancarias e
                                        where e.idvencimento = vv.idvencimento
                                          and e.datamovimento < trunc(sysdate) + 1 ) ) pago_v2
                     , ( select sum(vv.valor)
                        from vencimentos vv
                        where vv.idnotafiscal = nf.idnotafiscal
                          and vv.identificado = 'S'
                          and exists ( select 1 from extratoscontasbancarias e where e.idvencimento = vv.idvencimento )
                      ) identificado_v2_sim
                     , ( select sum(vv.valor)
                        from vencimentos vv
                        where vv.idnotafiscal = nf.idnotafiscal
                          and vv.identificado = 'N'
                          and exists ( select 1 from extratoscontasbancarias e where e.idvencimento = vv.idvencimento )
                      ) identificado_v2_nao
                    , ( select case 
                               when x.regra is not null and x.tipo is not null then x.regra||' - '||x.tipo
                               when x.regra is not null then x.regra
                               when x.tipo  is not null then x.tipo
                             end
                        from ( select decode(md.tiporegra,'D','Despesa','C','Custo','I','Investimento') regra
                                    , decode(md.tipo,'F','Fixa','V','Variável','X','Imposto','N','Não Operacional') tipo
                               from roman.matrizregrasdespesas md
                                  , roman.requisicoespagamentos rp
                               where md.idmatrizregra = rp.idmatrizdespesa
                                 and rp.idnotafiscal  = nf.idnotafiscal
                             ) x ) tiporegra
                from notasfiscais nf
                where tiponota in ( 'C', 'R', 'D', 'A')
                  and situacao != 'E'
                  and (:P26_IDFORNECEDOR      is null or nf.idfornemitente = :P26_IDFORNECEDOR )
                  and (:P26_TIPOFORNECEDOR is null
                        or exists ( select 1
                                      from fornecedores f
                                     where f.idfornecedor = nf.idfornemitente
                                       and f.tipo_fornecedor in ( select regexp_substr(:P26_TIPOFORNECEDOR, '[^/]+', 1, level)
                                                                    from dual
                                                                 connect by level <= regexp_count(:P26_TIPOFORNECEDOR, '/') + 1 ) ) )
                  and (:P26_IDFILIALEMITENTE  is null or nf.idfilialemitente = :P26_IDFILIALEMITENTE   )
                  and (:P26_DOCUMENTO         is null or trim(nf.documento) = trim(:P26_DOCUMENTO) )
                  and (:P26_SEMANA            is null or nf.idsemananota  = :P26_SEMANA)
                  and (:P26_ANO               = 0 or extract(year from nf.dtnf) = :P26_ANO )
                  and (:P26_ORIGEM_VENCIMENTO = 9
                    or (:P26_ORIGEM_VENCIMENTO = 1 and exists ( select 1
                                                                from vencimentos v
                                                                where v.idnotafiscal = nf.idnotafiscal )
                                                   and not exists ( select 1
                                                                    from extratoscontasbancarias ex
                                                                    where ex.idnotafiscal = nf.idnotafiscal ) )
                    or (:P26_ORIGEM_VENCIMENTO = 2 and exists ( select 1
                                                                from extratoscontasbancarias ex
                                                                where ex.idnotafiscal = nf.idnotafiscal ) ) )
                  and (:P26_FILTRAR_DATA      = 'N' or trunc(nf.DATAINCLUSAO) between to_date(:P26_DATAINICIO) and to_date(:P26_DATAFIM) )
                  and (:P26_TIPOFILIALDESTINO = 'X' or pck_romance.fnc_tipofilial(nf.idfilialdestino) = :P26_TIPOFILIALDESTINO )
                  and (:P26_SITUACAORECEBIMENTO = 'T'
                       or nf.situacaofilial = :P26_SITUACAORECEBIMENTO )
                  and (:P26_TIPOPRODUTO       = 'T' 
                       or ( :P26_TIPOPRODUTO       = 'V' and exists ( select 1
                                                                      from itemnf it
                                                                         , produtos p
                                                                      where it.idnotafiscal = nf.idnotafiscal
                                                                        and it.idproduto    = p.idproduto
                                                                        and p.venda         = 'S' ) )
                       or ( :P26_TIPOPRODUTO       = 'I' and exists ( select 1
                                                                      from itemnf it
                                                                         , produtos p
                                                                      where it.idnotafiscal = nf.idnotafiscal
                                                                        and it.idproduto    = p.idproduto
                                                                        and p.venda         = 'N' ) ) )
                  /*and nf.idfilialdestino in ( select idfilial
                                              from filiais f
                                              where f.tipofilial in ( select idtipofilial
                                                                      from acessostiposfiliais
                                                                      where usuario = v('APP_USER')) ) */
                ```
            pageItemsToSubmit: [
                P26_TIPOFILIALDESTINO
                P26_IDFORNECEDOR
                P26_TIPOPRODUTO
                P26_DOCUMENTO
                P26_ANO
                P26_SEMANA
                P26_IDFILIALEMITENTE
                P26_SITUACAORECEBIMENTO
                P26_FILTRAR_DATA
                P26_DATAINICIO
                P26_DATAFIM
                P26_ORIGEM_VENCIMENTO
                P26_TIPOFORNECEDOR
            ]
        }
