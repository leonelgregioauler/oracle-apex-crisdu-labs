    pageItem P26_ANO (
        type: selectList
        label {
            label: Ano
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct to_char(dtvencimento, 'RRRR') display_value
                     , to_char(f.dtvencimento, 'RRRR')  return_value
                from pagamentosfornecedores f
                --where  to_number(to_char(dtvencimento, 'RRRR')) >=2014
                order by 1 desc
                ```
            nullDisplayValue: "- Todos - "
            nullReturnValue: 0
        }
        layout {
            sequence: 70
            region: @filtro-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return to_char(sysdate, 'RRRR');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

