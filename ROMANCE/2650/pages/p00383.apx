page 383 (
    name: Filtro de Razões Sociais
    title: Filtro de Razões Sociais
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtro-razões-sociais (
        name: Filtro Razões Sociais
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "CNPJ",
                "USUARIO"
                from "#OWNER#"."FILTROSRAZOESSOCIAIS"
                where usuario = v('APP_USER')
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum fornecedor selecionado
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 4
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column CNPJ (
            reportColumnQueryId: 2
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: CNPJ
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select distinct r.cnpj display 
                         , r.cnpj
                    from razoessociaisfiliais r
                    where r.cnpj is not null
                      and r.ativo = 'S'
                    order by 1
                    ```
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 50
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: textField
            heading {
                heading: Usuario
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                width: 15
            }
            default {
                type: plsqlExpression
                plsqlExpression: v('APP_USER')
            }
            advanced {
                customAttributes: readonly
            }
        )

    )

    button add (
        buttonName: ADD
        label: Add +
        layout {
            sequence: 40
            region: @filtro-razões-sociais
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 20
            region: @filtro-razões-sociais
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente deletar?','DELETAR');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Criar
        layout {
            sequence: 30
            region: @filtro-razões-sociais
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @filtro-razões-sociais
        target {
            tableName: FILTROSRAZOESSOCIAIS
            pkColumn: ROWID
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# linha(s) deletada.
        }
        advanced {
            executionMappingIdentifier: 73671927646421964
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @filtro-razões-sociais
        target {
            tableName: FILTROSRAZOESSOCIAIS
            pkColumn: ROWID
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# linha(s) atualizada, #MRI_COUNT# linha(s) inserida.
        }
        advanced {
            executionMappingIdentifier: 73671520462421951
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Go To Page 383
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 383
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

