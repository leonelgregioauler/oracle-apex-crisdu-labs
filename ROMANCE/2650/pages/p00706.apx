page 706 (
    name: Central de Comprovantes
    title: Central de Comprovantes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // Selecao da lista de comprovantes: quantidade e valor marcados.
            function c706brl(v) {
              return v.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
            }
            function c706tot() {
              var q = 0, t = 0;
              $("input[name=f01]:checked").each(function () {
                q++;
                t += parseFloat($(this).attr("data-v")) || 0;
              });
              t = Math.round(t * 100) / 100;
              $("#sel706").html(q ? "<b>" + q + "</b> comprovante(s) marcado(s) - <b>" + c706brl(t) + "</b>"
                                  : "Nenhum comprovante marcado. Marque na lista ou escolha enviar todo o filtro.");
            }
            function c706Todos(chk) {
              $("input[name=f01]").prop("checked", chk.checked);
              c706tot();
            }
            function c706Filtra(sit) {
              apex.page.submit({ request: "BUSCAR", set: { "P706_SITUACAO": sit }, showWait: true });
            }
            function c706Vincular(id) {
              apex.item("P706_COMPROV").setValue(id);
              apex.region("cand706").refresh();
              apex.theme.openRegion("cand706");
            }
            function c706Escolher(idpgtoforn) {
              apex.message.confirm("Ligar o comprovante a esta fatura e anexar o PDF?", function (ok) {
                if (ok) {
                  apex.page.submit({ request: "VINCULAR",
                                     set: { "P706_COMPROV": $v("P706_COMPROV"), "P706_FATURA": idpgtoforn },
                                     showWait: true });
                }
              });
            }
            function c706Desvincular(id) {
              apex.message.confirm("Desvincular este comprovante? O anexo sai da fatura e o comprovante volta para pagos fora da API.", function (ok) {
                if (ok) {
                  apex.page.submit({ request: "DESVINCULAR", set: { "P706_COMPROV": id }, showWait: true });
                }
              });
            }
            function c706Reenviar(lote) {
              apex.message.confirm("Reenviar o lote " + lote + "?", function (ok) {
                if (ok) {
                  apex.page.submit({ request: "REENVIAR", set: { "P706_LOTE": lote }, showWait: true });
                }
              });
            }
            $(function () {
              c706tot();
              $(document).on("change", "input[name=f01]", c706tot);
              $(document).on("apexafterrefresh", c706tot);
            });
            ```
    }
    css {
        inline:
            ```css
            .c706-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;padding:12px}
            .c706-card{background:#f7f7f7;border-radius:8px;padding:14px 16px;border-left:4px solid #c8c8c8}
            .c706-card .t{font-size:13px;color:#707070}
            .c706-card .v{font-size:24px;font-weight:500;margin-top:2px}
            .c706-card .s{font-size:11px;color:#909090;margin-top:2px}
            .c706-bar{height:6px;background:#e6e6e6;border-radius:3px;margin-top:6px}
            .c706-bar div{height:6px;border-radius:3px;background:#2e7d32}
            .c706-pend{display:flex;flex-wrap:wrap;gap:24px;padding:0 12px 12px;font-size:13px}
            .c706-b{display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600;white-space:nowrap}
            .c706-ok{background:#e3f4e6;color:#2e7d32}
            .c706-pe{background:#fff1dc;color:#b26a00}
            .c706-er{background:#fde7e7;color:#c62828}
            .c706-sf{background:#ececec;color:#606060}
            .c706-en{background:#e3eefb;color:#1565c0}
            #sel706{font-size:14px;padding:6px 0}
            ```
    }
    security {
        authorizationScheme: @autoriza-pix-operador
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region comprovantes (
        name: Comprovantes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case when v.situacao = 'ANEXADO' then
                         apex_item.checkbox2( p_idx        => 1
                                            , p_value      => v.idcomprovante
                                            , p_attributes => 'data-v="' || to_char(v.valor, 'FM999999999990D00', 'NLS_NUMERIC_CHARACTERS=''.,''') || '"' )
                       end sel
                     , v.dt_pagamento pago
                     , v.dt_vencimento vencimento
                     , apex_escape.html(v.fornecedor)
                       || case when v.vinculo in ('AUTO_IB', 'MANUAL', 'DESFEITO') or v.situacao = 'SEM_FATURA' then
                            '<br><span style="font-size:11px;color:#707070">No banco: ' || apex_escape.html(v.favorecido_banco) || '</span>'
                          end fornecedor
                     , nvl2(v.documento, 'NF ' || v.documento, null) documento
                     , decode(v.forma, 'BOLETO', 'Boleto', 'DICT', 'Pix chave', 'BENEFICIARIO', 'Pix ag/conta'
                             , 'GUIA', 'Guia', 'PIX', 'Pix', initcap(v.forma)) forma
                     , ( select substr(sc.beneficiario, 1, 25) from santander_contas sc
                          where sc.idcontabanc = v.idcontabanc ) conta
                     , v.valor
                     , case v.situacao
                         when 'ANEXADO'    then '<span class="c706-b c706-ok">Anexado</span>'
                         when 'ERRO'       then '<span class="c706-b c706-er" title="' || apex_escape.html_attribute(v.erro) || '">Erro</span>'
                         when 'SEM_FATURA' then '<span class="c706-b c706-sf">Fora da API</span>'
                         else                   '<span class="c706-b c706-pe">Pendente</span>'
                       end situacao
                     , case when v.url_pdf is not null then
                         '<a href="' || apex_escape.html_attribute(v.url_pdf) || '" target="_blank" title="Abrir comprovante">'
                         || '<span class="fa fa-file-pdf-o" aria-hidden="true"></span></a>'
                       end pdf
                     , case when v.dt_ultimo_envio is not null then
                         '<span class="c706-b c706-en">' || to_char(v.dt_ultimo_envio, 'DD/MM HH24:MI') || '</span>'
                       end enviado
                     , case
                         when v.situacao = 'SEM_FATURA' then
                           '<a href="javascript:c706Vincular(' || v.idcomprovante || ')">Vincular</a>'
                         when v.vinculo = 'AUTO_IB' then
                           '<span class="c706-b c706-sf" title="Pago no Internet Banking; ligado pela conta, valor e data">Auto IB</span> '
                           || '<a href="javascript:c706Desvincular(' || v.idcomprovante || ')">Desvincular</a>'
                         when v.vinculo = 'MANUAL' then
                           '<span class="c706-b c706-sf">Manual</span> '
                           || '<a href="javascript:c706Desvincular(' || v.idcomprovante || ')">Desvincular</a>'
                         else '<span class="c706-b c706-en">API</span>'
                       end vinculo
                  from vw_santander_comprovantes v
                
                   where trunc(case :P706_TIPO_DATA when 'V' then v.dt_vencimento
                                                    when 'E' then v.dt_emissao
                                                    else v.dt_pagamento end)
                         between nvl(to_date(:P706_DE, 'DD/MM/RRRR'), trunc(sysdate) - 7)
                             and nvl(to_date(:P706_ATE, 'DD/MM/RRRR'), trunc(sysdate))
                     and ( :P706_CONTA is null or v.idcontabanc = :P706_CONTA )
                     and ( :P706_FORMA is null or v.forma = :P706_FORMA )
                     and ( :P706_FORNECEDOR is null
                           or upper(v.fornecedor || ' ' || v.documento) like '%' || upper(:P706_FORNECEDOR) || '%' )
                   and ( :P706_SITUACAO is null or v.situacao = :P706_SITUACAO )
                 order by v.dt_pagamento desc, v.valor desc
                ```
        }
