        }
        advanced {
            executionMappingIdentifier: 971000000000706074
        }
        serverSideCondition {
            type: request=Value
            value: DESVINCULAR
        }
    )

    process enviar-lote (
        name: Enviar lote
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vids    varchar2(32767);
                  vqtd    pls_integer := 0;
                  vlote   number;
                  vfiltro varchar2(1000);
                  vconta  varchar2(100);
                begin
                  -- nome da conta para o texto do filtro (subconsulta nao vale em expressao PL/SQL)
                  if :P706_CONTA is not null then
                    select max(substr(sc.beneficiario, 1, 30)) into vconta
                      from santander_contas sc where sc.idcontabanc = :P706_CONTA;
                  end if;
                
                  if nvl(:P706_ENVIAR, 'S') = 'F' then
                    -- Todo o filtro da tela: so o que ja tem o PDF anexado. Le 1 a mais que o
                    -- limite para o fnc_criar_lote avisar quando passar.
                    for r in ( select v.idcomprovante
                                 from vw_santander_comprovantes v
                
                                where trunc(case :P706_TIPO_DATA when 'V' then v.dt_vencimento
                                                                 when 'E' then v.dt_emissao
                                                                 else v.dt_pagamento end)
                                      between nvl(to_date(:P706_DE, 'DD/MM/RRRR'), trunc(sysdate) - 7)
                                          and nvl(to_date(:P706_ATE, 'DD/MM/RRRR'), trunc(sysdate))
                                  and ( :P706_CONTA is null or v.idcontabanc = :P706_CONTA )
                                  and ( :P706_FORMA is null or v.forma = :P706_FORMA )
                                  and ( :P706_FORNECEDOR is null
                                        or upper(v.fornecedor || ' ' || v.documento) like '%' || upper(:P706_FORNECEDOR) || '%' )
                                  and v.situacao = 'ANEXADO'
                                order by v.dt_pagamento
                                fetch first 301 rows only )
                    loop
                      vids := vids || case when vids is not null then ':' end || r.idcomprovante;
                      vqtd := vqtd + 1;
                    end loop;
                  else
                    for i in 1 .. apex_application.g_f01.count loop
                      vids := vids || case when vids is not null then ':' end || apex_application.g_f01(i);
                      vqtd := vqtd + 1;
                    end loop;
                  end if;
                
                  if vqtd = 0 then
                    apex_error.add_error(
                      p_message          => 'Nenhum comprovante anexado para enviar. Marque na lista ou ajuste o filtro.',
                      p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  vfiltro := substr(
                       case :P706_TIPO_DATA when 'V' then 'Vencimento' when 'E' then unistr('Emiss\00E3o da fatura') else 'Pagamento' end
                    || ' de ' || :P706_DE || unistr(' at\00E9 ') || :P706_ATE
                    || case when vconta is not null then '; conta ' || vconta end
                    || case when :P706_FORMA is not null then '; forma ' || :P706_FORMA end
                    || case when :P706_FORNECEDOR is not null then '; fornecedor/NF ' || :P706_FORNECEDOR end
                    , 1, 1000);
                
                  vlote := roman.pck_santander_comprovantes.fnc_criar_lote(
                             pids     => vids
                           , pemails  => :P706_EMAILS
                           , pfiltro  => vfiltro
                           , pusuario => :APP_USER );
                
                  apex_application.g_print_success_message :=
                    'Lote ' || vlote || ' na fila de envio. O e-mail com o ZIP sai em alguns segundos; '
                    || unistr('acompanhe no hist\00F3rico de lotes.');
                exception
                  when others then
                    apex_error.add_error(
                      p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: ', ''),
                      p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 971000000000706071
        }
        serverSideCondition {
            whenButtonPressed: @enviar
        }
    )

