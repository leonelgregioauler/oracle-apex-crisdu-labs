    region histórico-de-lotes (
        name: Histórico de lotes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.lote
                     , l.dt_solicitacao solicitado
                     , l.usuario_apex usuario
                     , l.emails destino
                     , l.qtd
                     , l.valor
                     , case l.status
                         when 'ENVIADO'     then '<span class="c706-b c706-ok">Enviado</span>'
                         when 'ERRO'        then '<span class="c706-b c706-er" title="' || apex_escape.html_attribute(l.obs) || '">Erro</span>'
                         when 'PROCESSANDO' then '<span class="c706-b c706-en">Processando</span>'
                         else                    '<span class="c706-b c706-pe">Na fila</span>'
                       end status
                     , l.dt_processado processado
                     , case when l.status = 'ERRO' then
                         '<a href="javascript:c706Reenviar(' || l.lote || ')">Reenviar</a>'
                       end acao
                  from fila_envio_comprovantes_lote l
                 order by l.lote desc
                 fetch first 30 rows only
                ```
