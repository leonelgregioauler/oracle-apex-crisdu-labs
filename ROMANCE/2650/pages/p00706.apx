        }
        successMessage {
            successMessage: Comprovante ligado à fatura. O PDF é anexado em alguns segundos; clique em Filtrar para ver.
        }
        advanced {
            executionMappingIdentifier: 971000000000706073
        }
        serverSideCondition {
            type: request=Value
            value: VINCULAR
        }
    )

