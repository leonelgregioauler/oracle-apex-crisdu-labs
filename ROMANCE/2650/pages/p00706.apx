    region painel (
        name: Painel
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  vde    date := nvl(to_date(:P706_DE,  'DD/MM/RRRR'), trunc(sysdate) - 7);
                  vate   date := nvl(to_date(:P706_ATE, 'DD/MM/RRRR'), trunc(sysdate));
                  vqt    number; vvt number;      -- todos os pagamentos do filtro
                  vqapi  number;                  -- pagos pela API
                  vqa    number; vva number;      -- anexados
                  vqp    number; vvp number;      -- pendentes (inclui erro)
                  vqe    number;                  -- erro
                  vqs    number; vvs number;      -- pagos fora da API
                  vlotes number; vqenv number;    -- lotes enviados no periodo
                  vpct   number;
                
                  function brl ( p in number ) return varchar2 is
                  begin
                    return 'R$ ' || to_char(nvl(p, 0), 'FM999G999G999G990D00');
                  end brl;
                
                  procedure cartao ( ptit in varchar2, pval in varchar2, psub in varchar2, pcor in varchar2 ) is
                  begin
                    htp.p('<div class="c706-card" style="border-left-color:' || pcor || '">'
                       || '<div class="t">' || ptit || '</div><div class="v">' || pval || '</div>'
                       || '<div class="s">' || psub || '</div></div>');
                  end cartao;
                begin
                  select count(*), sum(v.valor)
                       , count(case when v.situacao <> 'SEM_FATURA' then 1 end)
                       , count(case when v.situacao = 'ANEXADO' then 1 end)
                       , sum(case when v.situacao = 'ANEXADO' then v.valor end)
                       , count(case when v.situacao in ('PENDENTE', 'ERRO') then 1 end)
                       , sum(case when v.situacao in ('PENDENTE', 'ERRO') then v.valor end)
                       , count(case when v.situacao = 'ERRO' then 1 end)
                       , count(case when v.situacao = 'SEM_FATURA' then 1 end)
                       , sum(case when v.situacao = 'SEM_FATURA' then v.valor end)
                    into vqt, vvt, vqapi, vqa, vva, vqp, vvp, vqe, vqs, vvs
                    from vw_santander_comprovantes v
                   where trunc(case :P706_TIPO_DATA when 'V' then v.dt_vencimento
                                                    when 'E' then v.dt_emissao
                                                    else v.dt_pagamento end) between vde and vate
                     and ( :P706_CONTA is null or v.idcontabanc = :P706_CONTA )
                     and ( :P706_FORMA is null or v.forma = :P706_FORMA )
                     and ( :P706_FORNECEDOR is null
                           or upper(v.fornecedor || ' ' || v.documento) like '%' || upper(:P706_FORNECEDOR) || '%' );
                
                  select count(*), nvl(sum(l.qtd), 0) into vlotes, vqenv
                    from fila_envio_comprovantes_lote l
                   where l.status = 'ENVIADO'
                     and trunc(l.dt_processado) between vde and vate;
                
                  vpct := case when vqapi > 0 then round(100 * vqa / vqapi) end;
                
                  htp.p('<div class="c706-cards">');
                  cartao(unistr('Pagamentos no per\00EDodo'), vqt, brl(vvt), '#1565c0');
                  htp.p('<div class="c706-card" style="border-left-color:#2e7d32">'
                     || '<div class="t">Cobertura de comprovante</div>'
                     || '<div class="v">' || nvl(to_char(vpct) || '%', '-') || '</div>'
                     || '<div class="c706-bar"><div style="width:' || nvl(vpct, 0) || '%"></div></div>'
                     || '<div class="s">' || vqa || ' de ' || vqapi || ' pagos pela API</div></div>');
                  cartao('Pagos sem comprovante', vqp, brl(vvp), case when vqp > 0 then '#b26a00' else '#c8c8c8' end);
                  cartao('Pagos fora da API', vqs, brl(vvs) || ' (Internet Banking)', '#909090');
                  cartao('Enviados no período', vlotes || ' lote(s)', vqenv || ' comprovante(s)', '#1565c0');
                  htp.p('</div>');
                
                  htp.p('<div class="c706-pend">');
                  htp.p('<span><span class="c706-b c706-pe">' || vqp || '</span> pago sem comprovante: '
                     || '<a href="javascript:c706Filtra(''PENDENTE'')">ver</a> ou use "Buscar comprovantes no banco"</span>');
                  htp.p('<span><span class="c706-b c706-sf">' || vqs || '</span> pago fora da API: '
                     || '<a href="javascript:c706Filtra(''SEM_FATURA'')">ver</a></span>');
                  htp.p('<span><span class="c706-b c706-er">' || vqe || '</span> erro ao anexar: '
                     || '<a href="javascript:c706Filtra(''ERRO'')">ver</a></span>');
                  htp.p('</div>');
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region vincular-comprovante-a-uma-fatura (
        name: Vincular comprovante a uma fatura
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pf.idpgtoforn
                     , pck_romance.fnc_nomefornecedor(pf.idfornecedor) fornecedor
                     , nf.documento
                     , pf.dtvencimento vencimento
                     , pf.databaixa baixa
                     , nvl(pf.valorpago, pf.valorpagar - nvl(pf.desconto, 0) + nvl(pf.acrescimo, 0)) valor
                     , ( select substr(cb.beneficiario, 1, 25) from contasbancarias cb
                          where cb.idcontabanc = pf.idcontapagamento ) conta
                     , '<a href="javascript:c706Escolher(' || pf.idpgtoforn || ')">Vincular</a>' acao
                  from santander_comprovantes c
                  join pagamentosfornecedores pf
                    on pf.idcheque is null
                   and abs(nvl(pf.valorpago, pf.valorpagar - nvl(pf.desconto, 0) + nvl(pf.acrescimo, 0)) - c.valor)
                       <= greatest(1, c.valor * 0.02)
                   and ( pf.databaixa between trunc(c.dt_pagamento) - 15 and trunc(c.dt_pagamento) + 16
                         or pf.dtvencimento between trunc(c.dt_pagamento) - 15 and trunc(c.dt_pagamento) + 15 )
                  left join notasfiscais nf on nf.idnotafiscal = pf.idnotafiscal
                 where c.idcomprovante = :P706_COMPROV
                   and not exists ( select 1 from pix_pagamentos px
                                     where px.idpgtoforn = pf.idpgtoforn and px.status = 'PAYED' )
                   and not exists ( select 1 from santander_comprovantes o
                                     where o.idpgtoforn = pf.idpgtoforn )
                 order by abs(nvl(pf.valorpago, pf.valorpagar - nvl(pf.desconto, 0) + nvl(pf.acrescimo, 0)) - c.valor)
                        , abs(nvl(pf.databaixa, pf.dtvencimento) - c.dt_pagamento)
                 fetch first 30 rows only
                ```
            pageItemsToSubmit: P706_COMPROV
        }
