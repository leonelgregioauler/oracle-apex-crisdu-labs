    process buscar-comprovantes-no-banco (
        name: Buscar comprovantes no banco
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  roman.pck_santander_comprovantes.prc_buscar_async(
                    pdias => trunc(sysdate) - nvl(to_date(:P706_DE, 'DD/MM/RRRR'), trunc(sysdate) - 1) );
                exception
                  when others then
                    apex_error.add_error(
                      p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: ', ''),
                      p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Busca de comprovantes iniciada em segundo plano (todas as contas, do início do período até hoje). Em alguns minutos clique em Filtrar.
        }
        advanced {
            executionMappingIdentifier: 971000000000706070
        }
        serverSideCondition {
            whenButtonPressed: @buscar-banco
        }
    )

