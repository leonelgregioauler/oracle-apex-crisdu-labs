page 419 (
    name: Anexo de Negociações
    title: Anexo de Negociações
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 60%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P419_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos (
        name: Anexos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region anexos-despesas (
        name: Anexos Despesas
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @anexos
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            footerText: <font color="green"> Você pode anexar mais de um arquivo.</font>
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     , roman.pck_bucket.sp_abre_anexo(url_bucket) preview
                     --, idnegociacao||t.idanexonegociacaofinan||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) ID
                     --, '<a href="javascript: fnc_verimg('''||iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' link
                     , dataanexo data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario
                     , '<a href="javascript: fnc_removeanexo('||idanexonegociacaofinan||','''||t.nomearquivo||''');">Remover</a>' remover
                from anexosnegociacoesfinan t
                where idnegociacao = :P419_IDNEGOCIACAO
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            parentRegion: @anexos
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                sortable: false
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column PREVIEW (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Anexo
                alignment: center
            }
            layout {
                sequence: 12
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column REMOVER (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 32
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 22
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P419_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            filenameColumn: NOMEARQUIVO
        }
        layout {
            sequence: 50
            region: @anexos-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P419_DATAANEXO (
        type: hidden
        layout {
            sequence: 80
            region: @anexos-despesas
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATAANEXO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P419_IDANEXODELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @anexos-despesas
            slot: regionBody
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P419_IDANEXONEGOCIACAOFINAN (
        type: hidden
        layout {
            sequence: 20
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXONEGOCIACAOFINAN
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P419_IDNEGOCIACAO (
        type: hidden
        layout {
            sequence: 30
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDNEGOCIACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P419_IDPAGAMENTONEGOCIACAO (
        type: hidden
        layout {
            sequence: 100
            region: @anexos-despesas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P419_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                BEGIN
                  select idusuario
                  into vidusuario
                  from usuarios 
                  where usuario = v('APP_USER');
                  return vidusuario;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P419_NOMEARQUIVO (
        type: hidden
        layout {
            sequence: 40
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P419_TELA_ORIGEM (
        type: hidden
        layout {
            sequence: 10
            region: @anexos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 60
            region: @anexos-despesas
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P419_IDANEXONEGOCIACAOFINAN
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @anexos-despesas
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P419_IDANEXONEGOCIACAOFINAN
        }
    )

    button voltar (
        buttonName: Voltar
        label: Voltar
        layout {
            sequence: 10
            region: @anexos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P419_TELA_ORIGEM
            value: 440
        }
    )

    button voltar-2 (
        buttonName: Voltar_405
        label: Voltar
        layout {
            sequence: 20
            region: @anexos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P419_TELA_ORIGEM
            value: 405
        }
    )

    validation selecione-o-arquivo (
        name: Selecione o Arquivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P419_ARQUIVOTEMP
        }
        error {
            errorMessage: Selecione o arquivo para anexar!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_negociacoes_f(pidnegociacao => :P419_IDNEGOCIACAO
                                                       ,pidanexo => :P419_IDANEXONEGOCIACAOFINAN);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 230404269601069473
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P419_ARQUIVOTEMP
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_anexos.prc_apagaanexo_negociacoes_f(pidanexonegociacaofinan => :P419_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 230405796113069476
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexosnegociacoesfinan (
        name: Fetch Row from ANEXOSNEGOCIACOESFINAN
        type: autoRowFetch
        source {
            tableName: ANEXOSNEGOCIACOESFINAN
            pkColumn: IDANEXONEGOCIACAOFINAN
            pkItem: P419_IDANEXONEGOCIACAOFINAN
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 230404614939069475
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P419_IDANEXONEGOCIACAOFINAN is null then
                        select "#OWNER#"."SEQ_IDANEXONEGOCIACAOFINAN".nextval
                          into :P419_IDANEXONEGOCIACAOFINAN
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 230404920974069475
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: itemIsNotNull
            item: P419_ARQUIVOTEMP
        }
    )

    process process-row-of-anexosnegociacoesfinan (
        name: Process Row of ANEXOSNEGOCIACOESFINAN
        type: autoRowProcessing
        target {
            tableName: ANEXOSNEGOCIACOESFINAN
            pkColumn: IDANEXONEGOCIACAOFINAN
            pkItem: P419_IDANEXONEGOCIACAOFINAN
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 230405387153069475
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P419_ARQUIVOTEMP
        }
    )

    branch (
        name: Anexar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 419
                items: {
                    P419_IDANEXONEGOCIACAOFINAN:
                    P419_IDNEGOCIACAO: &P419_IDNEGOCIACAO.
                }
                action: resetPagination
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch (
        name: Go To Page 440
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 440
                items: {
                    P440_IDPAGAMENTONEGOCIACAO: &P419_IDPAGAMENTONEGOCIACAO.
                    P440_IDNEGOCIACAO: &P419_IDNEGOCIACAO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
        }
    )

    branch (
        name: Go To Page 405
        execution {
            sequence: 40
        }
        behavior {
            target: {
                page: 405
                items: {
                    P440_IDNEGOCIACAO: &P419_IDNEGOCIACAO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar-2
        }
    )

)

