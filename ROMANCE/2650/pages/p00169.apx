    process atualiza-extratos-vencimentos-pagos (
        name: Atualiza Extratos/Vencimentos pagos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_financeiro_rmc.prc_atualizafaturaspagas( pidpessoa => :P169_IDFORNECEDOR
                                                             , pidcontabancaria => :P169_IDCONTABANCARIA);
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 3971287505712249977
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P169_IDFORNECEDOR
        }
    )

