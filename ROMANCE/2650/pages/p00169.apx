    region extrato-completo (
        name: Extrato Completo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select pck_romance.fnc_nomepessoa( c.idpessoa)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(e.idcontabancaria) conta   
                     , e.datamovimento
                     , e.valormovimento
                     , e.descricao motivo                    
                     , ( select nn.documento
                         from notasfiscais nn
                            , vencimentos  vv
                         where nn.idnotafiscal = vv.idnotafiscal
                           and ( vv.idvencimento = e.idvencimento
                              or vv.idvencimento = e.idvencimento_orig ) )  detalhe   
                     , ( select pck_romance.fnc_nomefilial(nf.idfilialdestino) empresadestino
                         from vencimentos v
                            , notasfiscais nf
                         where ( v.idvencimento = e.idvencimento
                              or v.idvencimento = e.idvencimento_orig )
                           and nf.idnotafiscal = v.idnotafiscal ) empresadestino
                from extratoscontasbancarias e       
                where e.datamovimento   <= :P265_DATABASEDEPOSITOS
                  and e.contabilizar     = 'S'
                  and e.idcontabancaria = :P169_IDCONTABANCARIA
                  and e.identificado    = :P169_IDENTIFICADO 
                  and ( :P169_FILTRO = 'C'
                        or (:P169_FILTRO = 'F' and e.valormovimento < 0)
                        or (:P169_FILTRO = 'D' and e.valormovimento >0 ) )
                order by e.idextratocontabancaria desc
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1507507251634266505
        }

