    region contas-para-depositar (
        name: Contas para Depositar
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select pck_romance.fnc_nomepessoa( c.idpessoa)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(e.idcontabancaria) conta
                     , ( select max(ee.datamovimento)
                         from extratoscontasbancarias ee
                         where ee.idcontabancaria = e.idcontabancaria 
                           and ee.idvencimento    is not null
                           and ee.datamovimento   < sysdate ) ultimovencimento
                     , sum(e.valormovimento) saldo                                        
                     , e.idcontabancaria
                from extratoscontasbancarias e       
                where e.datamovimento   <= :P265_DATABASEDEPOSITOS
                  and e.contabilizar     = 'S'
                  and e.idcontabancaria = :P169_IDCONTABANCARIA
                  and e.identificado    = :P169_IDENTIFICADO 
                --having sum(e.valormovimento) < 0
                group by e.idcontabancaria  
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 4521835442511806184
        }

