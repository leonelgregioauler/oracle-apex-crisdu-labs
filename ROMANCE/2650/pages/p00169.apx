    region extrato-de-faturas (
        name: Extrato de Faturas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  idextratocontabancaria
                     , ( select pck_romance.fnc_nomepessoa( c.idpessoa)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(e.idcontabancaria) conta   
                     , e.datamovimento datamovimento
                     , 'Fatura '||nn.documento motivo  
                     , pck_romance.fnc_nomefilial(nn.idfilialdestino) empresadestino
                     , e.valormovimento valorpagar
                     , nvl(vv.valorpago,0) valorpago  
                     , extract(month from e.datamovimento) mes
                     , e.idcontabancaria
                from extratoscontasbancarias e 
                   , notasfiscais nn
                   , vencimentos  vv      
                where nn.idnotafiscal = vv.idnotafiscal
                  and e.contabilizar  = 'S'
                  and ( vv.idvencimento = e.idvencimento
                     or vv.idvencimento = e.idvencimento_orig )
                  and e.valormovimento < 0                                                
                  and exists ( select 1
                               from contasbancarias c
                               where c.idcontabanc = e.idcontabancaria
                                 and ( :P169_IDFORNECEDOR is null or c.idpessoa = :P169_IDFORNECEDOR ) 
                                 and ( :P169_IDCONTABANCARIA is null or c.idcontabanc = :P169_IDCONTABANCARIA) )
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            footerText: <font color="blue"> Este relatório mostra valores gerais, sem levar em conta o filtro de data da tela anterior.</font>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
