page 82 (
    name: Inserir Despesa
    title: Inserir/Atualizar Despesa
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        width: 40%
        height: 60%
        chained: false
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='Deseja realmente deletar esta despesa?';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexobucket(pidanexo) {
              apex.message.confirm(
                "Deseja realmente remover o anexo?",
                function(okPressed) {
                  if (!okPressed) {
                    return;
                  }
            
                  apex.server.process(
                    "DELETE_ANEXO_BUCKET",
                    {
                      x01: pidanexo
                    },
                    {
                      dataType: "text",
                      success: function(pData) {
                        if (pData && pData.indexOf("ERRO:") === 0) {
                          apex.message.clearErrors();
                          apex.message.showErrors([
                            {
                              type: "error",
                              location: ["page"],
                              message: pData,
                              unsafe: false
                            }
                          ]);
                          return;
                        }
            
                        apex.region("anexos_despesa").refresh();
                      },
                      error: function(jqXHR, textStatus, errorThrown) {
                        apex.message.clearErrors();
                        apex.message.showErrors([
                          {
                            type: "error",
                            location: ["page"],
                            message: "Erro ao excluir anexo: " + errorThrown,
                            unsafe: false
                          }
                        ]);
                      }
                    }
                  );
                }
              );
            }
            
            function fnc_removeanexobucketsaida(pidanexo) {
              apex.message.confirm(
                "Deseja realmente remover o anexo?",
                function(okPressed) {
                  if (!okPressed) {
                    return;
                  }
            
                  apex.server.process(
                    "DELETE_ANEXO_BUCKET_SAIDA",
                    {
                      x01: pidanexo
                    },
                    {
                      dataType: "text",
                      success: function(pData) {
                        if (pData && pData.indexOf("ERRO:") === 0) {
                          apex.message.clearErrors();
                          apex.message.showErrors([
                            {
                              type: "error",
                              location: ["page"],
                              message: pData,
                              unsafe: false
                            }
                          ]);
                          return;
                        }
            
                        apex.region("anexos_despesa_saida").refresh();
                      },
                      error: function(jqXHR, textStatus, errorThrown) {
                        apex.message.clearErrors();
                        apex.message.showErrors([
                          {
                            type: "error",
                            location: ["page"],
                            message: "Erro ao excluir anexo: " + errorThrown,
                            unsafe: false
                          }
                        ]);
                      }
                    }
                  );
                }
              );
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region arquivos-anexados (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     , dataanexo data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario
                     , '<a href="javascript:void(0);" onclick="fnc_removeanexobucket('||t.idanexodespesa||'); return false;"><i class="fa fa-trash"></i></a>' remover
                     , roman.pck_bucket.sp_abre_anexo(url_bucket) preview
                from anexosdespesas t
                where iddespesa = :P82_IDDESPESA
                order by t.dataanexo
                
                
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: anexos_despesa
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from anexosdespesas a
                where a.iddespesa = :P82_IDDESPESA
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Nenhum anexo encontrado
        }

        column DATA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 1
