                ```sql
                select cc.nome display_values
                    , cc.idcentrodecusto return_values
                from roman.matrizclassificacoesdespesas m
                   , roman.centrodecustos cc 
                where cc.idcentrodecusto = m.idcentrodecusto
                  and m.idmatrizclassificacao = :P82_IDMATRIZCLASSIFICACAO 
