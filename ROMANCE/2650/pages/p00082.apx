                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column PREVIEW (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Anexo
                alignment: center
            }
            layout {
                sequence: 44
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column REMOVER (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 54
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

    )

    region arquivos-anexados-com-saídas (
        name: Arquivos Anexados (Com Saídas)
        title: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     , dataanexo data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario) usuario
                     , '<a href="javascript:void(0);" onclick="fnc_removeanexobucketsaida('||t.idanexosaida||'); return false;"><i class="fa fa-trash"></i></a>' remover
                     , roman.pck_bucket.sp_abre_anexo(url_bucket) preview
                from anexossaidas t
                where idsaida = ( select s.idsaida
                                  from saidasdiversas s
                                     , movimentosgeral m
                                     , despesas d
                                  where d.iddespesa        = :P82_IDDESPESA
                                    and m.idmovimentogeral = d.idmovimentotogeral 
                                    and s.idsaida          = m.idsaidadiversa )
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: anexos_despesa_saida
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from anexossaidas t
                where idsaida = ( select s.idsaida
                                  from saidasdiversas s
                                     , movimentosgeral m
                                     , despesas d
                                  where d.iddespesa        = :P82_IDDESPESA
                                    and m.idmovimentogeral = d.idmovimentotogeral 
                                    and s.idsaida          = m.idsaidadiversa )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
