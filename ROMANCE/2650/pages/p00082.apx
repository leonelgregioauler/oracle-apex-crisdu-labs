    pageItem P82_IDFUNCIONARIO (
        type: selectOne
        label {
            label: Motorista
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT INITCAP(P.NOMEPESSOA) NOMEPESSOA
                     , F.IDFUNCIONARIO
                  FROM CATAL.FUNCIONARIOS F
                     , CATAL.PESSOAS P
                 WHERE F.IDPESSOA = P.IDPESSOA
                   AND F.IDCARGO = 13 -- MOTORISTA
                   AND NVL(F.ATIVO,'N') = 'S'
                ORDER BY 1
                ```
        }
        layout {
            sequence: 150
            region: @inserir-nova-despesa
            slot: regionBody
            alignment: left
