    dynamicAction pega-fechamento (
        name: pega fechamento
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: itemIsNull
            item: P82_IDFECHAMENTO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select s.idfechamento
                    from fechamentossemanais s
                    where s.idfilial  = ( select f.idfilial 
                                          from usuarios u
                                             , gerentes  f
                                          where u.idgerente = f.idgerente
                                            and u.usuario =  v('APP_USER'))
                    and s.concluido = 'N'
                    and rownum      = 1
                    order by 1
                    ```
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P82_IDFECHAMENTO
            }
            execution {
                sequence: 10
            }
        )

    )

