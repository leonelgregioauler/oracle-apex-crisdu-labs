page 309 (
    name: Bancos para Solicitar conta
    title: Bancos para Solicitar conta
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region bancos-para-solicitar-conta (
        name: Bancos para Solicitar conta
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDBANCODEPOSITAR",
                "IDBANCO",
                "IDFILIAL"
                from "#OWNER#"."BANCOSDEPOSITAR"
                where idfilial = :P309_IDFILIAL
                ```
        }
        layout {
            sequence: 15
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum cadastro encontrado.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 4
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDBANCO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Banco
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomebanco
                         , idbanco
                    from bancos
                    order by 1
                    ```
            }
            layout {
                sequence: 3
            }
        )

        column IDBANCODEPOSITAR (
            reportColumnQueryId: 1
            derivedColumn: N
            type: plainTextSavesState
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDBANCODEPOSITAR
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
            default {
                type: item
                item: P309_IDFILIAL
            }
        )

    )

    pageItem P309_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @bancos-para-solicitar-conta
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P309_IDPESSOA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @bancos-para-solicitar-conta
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar +
        layout {
            sequence: 40
            region: @bancos-para-solicitar-conta
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @bancos-para-solicitar-conta
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente deletar?','MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Cadastrar
        layout {
            sequence: 30
            region: @bancos-para-solicitar-conta
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @bancos-para-solicitar-conta
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 8
                items: {
                    P8_IDPESSOA: &P309_IDPESSOA.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @bancos-para-solicitar-conta
        target {
            tableName: BANCOSDEPOSITAR
            pkColumn: IDBANCODEPOSITAR
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# linha(s) deletada.
        }
        advanced {
            executionMappingIdentifier: 1572918911881300296
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @bancos-para-solicitar-conta
        target {
            tableName: BANCOSDEPOSITAR
            pkColumn: IDBANCODEPOSITAR
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# linha(s) atualizada, #MRI_COUNT# linha(s) inserida.
        }
        advanced {
            executionMappingIdentifier: 1572918583571300296
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 309
                items: {
                    P309_IDPESSOA: &P309_IDPESSOA.
                    P309_IDFILIAL: &P309_IDFILIAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
        }
    )

    branch (
        name: Go To Page 309
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 309
                items: {
                    P309_IDPESSOA: &P309_IDPESSOA.
                    P309_IDFILIAL: &P309_IDFILIAL.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

