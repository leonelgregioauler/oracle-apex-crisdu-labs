page 194 (
    name: Report 1
    title: Report 1
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select identrada
                , pck_romance.fnc_nomefilial(idfilial) filial
                , pck_romance.fnc_nomefilial(idfilialorig) filialorig
                , valortotal
                , descricao
                , data
                from entradasdiversas
                where idfechamento is null
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        link {
            linkColumn: singleRowView
        }
        singleRowView {
            excludeNullValues: true
            onlyDisplayedColumns: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column DATA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DATA
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descricao
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: DESCRICAO
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column FILIAL (
            type: plainText
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: FILIAL
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column FILIALORIG (
            type: plainText
            heading {
                heading: Filialorig
                alignment: center
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: FILIALORIG
                endUserAlias: F
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDENTRADA (
            type: plainText
            heading {
                heading: Identrada
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDENTRADA
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column VALORTOTAL (
            type: plainText
            heading {
                heading: Valortotal
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: VALORTOTAL
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 3599323 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn DATA (
                sequence: 4
            )

            displayColumn DESCRICAO (
                sequence: 3
            )

            displayColumn FILIAL (
                sequence: 1
            )

            displayColumn FILIALORIG (
                sequence: 6
            )

            displayColumn IDENTRADA (
                sequence: 5
            )

            displayColumn VALORTOTAL (
                sequence: 2
            )

        )

    )

)

