    region mudar-destinos-de-lançamentos (
        name: Mudar Destinos de Lançamentos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.idnotafiscal
                     , nf.documento
                     , nf.datainclusao
                     , nf.valortotal
                     , nf.idfornemitente idfornecedor
                     , ( select pck_romance.fnc_nomefornecedor(f.idfornecedor) 
                         from fornecedores f 
                         where f.idfornecedor = nf.idfornemitente ) fornecedor
                     , nf.idfilialdestino
                     , nf.idrazaosocialfildestino
                     , ( select min(v.idmatrizregradespesa)
                         from vencimentos v
                         where v.idnotafiscal = nf.idnotafiscal ) idmatrizregradespesa
                     , ( select case when x.mn is not null then pck_romance.fnc_nomecontafinan(x.mn) end
                         from ( select min(v.idcontafinanceira) mn
                                from vencimentos v
                                where v.idnotafiscal = nf.idnotafiscal ) x ) conta
                     , ( select case when x.mn is not null then pck_romance.fnc_nomesubcontafinan(x.mn) end
                         from ( select min(v.idsubcontafinanceira) mn
                                from vencimentos v
                                where v.idnotafiscal = nf.idnotafiscal ) x ) subconta
                     , ( select count(distinct nvl(v.idmatrizregradespesa,-1)||'-'||nvl(v.idcontafinanceira,-1)||'-'||nvl(v.idsubcontafinanceira,-1))
                         from vencimentos v
                         where v.idnotafiscal = nf.idnotafiscal ) qtd_combinacoes
                from notasfiscais nf
                where ( :P364_TIPO_DATA = 'T' 
                   or ( :P364_TIPO_DATA = 'L' and trunc(nf.datainclusao) between to_date(:P364_DATAINICIO) and to_date(:P364_DATAFIM) )
                   or ( :P364_TIPO_DATA = 'V' and exists ( select 1
                                                           from vencimentos v
                                                           where v.idnotafiscal = nf.idnotafiscal
                                                             and trunc(v.datavencimento) between to_date(:P364_DATAINICIO) and to_date(:P364_DATAFIM) ) ) )
                  and ( :P364_TIPONOTA = 'A' and nf.tiponota in ('D','C','R') or nf.tiponota = :P364_TIPONOTA )
                  and ( :P364_TIPOPESQUISA = 'A'
                     or ( :P364_TIPOPESQUISA = 'C' and exists( select 1
                                                               from vencimentos v
                                                               where v.idnotafiscal = nf.idnotafiscal
                                                                 and v.idcentrodecusto is not null ) )
                     or ( :P364_TIPOPESQUISA = 'S' and exists( select 1
                                                               from vencimentos v
                                                               where v.idnotafiscal = nf.idnotafiscal
                                                                 and v.idcentrodecusto is null ) ) )
                  and ( :P364_IDFORNECEDOR is null or nf.idfornemitente = :P364_IDFORNECEDOR )
                  and ( :P364_USUARIO is null or nf.usuario = :P364_USUARIO )
                  and ( :P364_DATAINICIO is not null
                     or :P364_DATAFIM is not null ) 
                  and not exists ( select 1    
                                   from rateiosnotasfiscais rn
                                   where rn.idnotafiscal = nf.idnotafiscal )
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P364_TIPO = 'D' and :P364_TIPONOTA != 'V'
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 4105043888750656246
        }

