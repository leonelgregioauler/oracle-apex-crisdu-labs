    region lançamentos-realizados (
        name: Lançamentos Realizados
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.idvencimento
                     , ( select nf.documento
                         from notasfiscais nf
                         where nf.idnotafiscal = v.idnotafiscal ) documento
                     , ( select nf.datainclusao
                         from notasfiscais nf
                         where nf.idnotafiscal = v.idnotafiscal ) datainclusao
                     , ( select nf.idfornemitente
                         from notasfiscais nf
                         where nf.idnotafiscal = v.idnotafiscal ) idfornecedor
                     , ( select pck_romance.fnc_nomefornecedor(nf.idfornemitente) 
                         from notasfiscais nf
                         where nf.idnotafiscal = v.idnotafiscal ) fornecedor
                     , ( select case
                                  when nf.idfornecedordestino is null then
                                    pck_romance.fnc_nomefilial(nf.idfilialdestino)
                                  else
                                    --pck_romance.fnc_nomefornecedor(idfornecedordestino)
                                    pck_romance.fnc_nomefilial(nf.idfilialdestino) -- Maicon Aimi - 9329761 - 20/08/2024
                                end
                         from notasfiscais nf
                         where nf.idnotafiscal = v.idnotafiscal ) empresa
                     , v.datavencimento
                     , v.valor
                     , v.idcontafinanceira
                     , ( select nomeconta
                         from contasfinanceiras c
                         where c.idcontafinan = v.idcontafinanceira ) conta
                     , v.idsubcontafinanceira
                     , ( select nomeconta
                         from subcontasfinanceiras s
                         where s.idsubcontafinan = v.idsubcontafinanceira ) subconta
                     , ( select idfilialdestino
                         from notasfiscais nf
                         where nf.idnotafiscal = v.idnotafiscal ) idfilialdestino
                     , v.idmatrizregradespesa
                from vencimentos v
                where exists ( select 1
                               from notasfiscais nf
                               where nf.idnotafiscal = v.idnotafiscal
                                 and ( :P364_IDFORNECEDOR is null or nf.idfornemitente = :P364_IDFORNECEDOR )
                                 and ( :P364_TIPONOTA = 'A' and nf.tiponota in ('D','C','R') or nf.tiponota = :P364_TIPONOTA )
                                 and ( :P364_USUARIO is null or nf.usuario = :P364_USUARIO )
                                 and ( :P364_TIPO_DATA = 'T' 
                                    or ( :P364_TIPO_DATA = 'L' and trunc(nf.datainclusao) between to_date(:P364_DATAINICIO) and to_date(:P364_DATAFIM) )
                                    or ( :P364_TIPO_DATA = 'V' and trunc(v.datavencimento) between to_date(:P364_DATAINICIO) and to_date(:P364_DATAFIM) ) ) )
                  and ( :P364_TIPOPESQUISA = 'A'
                     or ( :P364_TIPOPESQUISA = 'C' and v.idmatrizregradespesa is not null )
                     or ( :P364_TIPOPESQUISA = 'S' and v.idmatrizregradespesa is null )
                     or ( :P364_TIPOPESQUISA = 'I' and exists ( select 1
                                                                from matrizregrasdespesas md
                                                                where md.idmatrizregra = v.idmatrizregradespesa
                                                                  and md.ativo         = 'N' ) ) )
                  and ( :P364_DATAINICIO is not null
                     or :P364_DATAFIM is not null )
                  and not exists ( select 1
                                   from rateiosnotasfiscais rn
                                   where rn.idnotafiscal = v.idnotafiscal )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P364_TIPO = 'M' and :P364_TIPONOTA != 'V'
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
            csvSeparator: ;
        }
        advanced {
            savedReportMappingIdentifier: 4105039713218656205
        }

