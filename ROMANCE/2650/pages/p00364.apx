        column IDMATRIZREGRARECEITA (
            type: selectList
            heading {
                heading: Matriz de Receita
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ' - Sem Matriz -' d
                         , null r
                    from dual
                    union
                    select 'Conta: '||( select nomeconta
                                        from contasfinanceiras cf
                                        where cf.idcontafinan = m.idcontafinan )||' / SubConta: '||( select nomeconta
                                                                                                     from subcontasfinanceiras s
                                                                                                     where s.idsubcontafinan = m.idsubcontafinan ) display_value                                                                                                                                                  
                         , m.idmatrizregrareceita
                    from matrizregrasreceitas m
                    where m.idfornecedoremitente = :IDFORNEMITENTE
                      and m.idfornecedorcliente  = :IDFORNECEDORDESTINO
                    order by 1
                    ```
            }
            cascadingLov {
                parentColumns: [
                    IDFORNEMITENTE
                    IDFORNECEDORDESTINO
                ]
            }
            layout {
                sequence: 200
            }
            source {
                databaseColumn: IDMATRIZREGRARECEITA
                dataType: number
            }
        )

