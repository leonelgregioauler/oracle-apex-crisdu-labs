                    select ' - Sem Matriz -' d
                         , null r
                    from dual
                    union
                    select 'Centro de Custo: '||( select c.nome
                                                  from centrodecustos c
                                                  where c.idcentrodecusto = m.idcentrodecusto )||' - Conta: '||( select nomeconta
