    process lançamentos-de-rateios-save-interactive-grid-data (
        name: Lançamentos de Rateios - Save Interactive Grid Data
        type: executeCode
        editableRegion: @lançamentos-de-rateios
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  cursor c1 is
                    select *
                    from rateiosnotasfiscais r
                    where r.idrateionotafiscal = :idrateionotafiscal;
                  --
                  r1 c1%rowtype;
                  --
                  cursor cmat is
                    select *
                    from matrizregrasdespesas mr
                    where mr.idmatrizregra = :idmatrizdespesa;
                  --
                  rmat cmat%rowtype;
                  --
                  vmd5 varchar2(4000);
                  --
                begin
                  --
                  if :idmatrizdespesa is not null then
                    --
                    case :APEX$ROW_STATUS  
                      when 'U' then
                        --
                        open c1;
                        fetch c1 into r1;
                        close c1;
                        --
                        open cmat;
                        fetch cmat into rmat;
                        close cmat;
                        --
                        pck_notasfiscais_rmc.prc_rateiosnotasfiscais( pidrateionotafiscal      => :idrateionotafiscal,
                                                                      pdocumento               => r1.documento,
                                                                      pidfornecedor            => :idfornecedor,
                                                                      pidrazaosocialfornecedor => r1.idrazaosocialfornecedor,
                                                                      pidfilialdestino         => :idfilialdestino,
                                                                      pidrazaosocialdestino    => r1.idrazaosocialdestino,
                                                                      pformapagamento          => r1.formapagamento,
                                                                      pidcontapagamento        => r1.idcontapagamento,
                                                                      pdatavencimento          => r1.datavencimento,
                                                                      pvalor                   => r1.valor,
                                                                      pidmatrizdespesa         => :idmatrizdespesa,
                                                                      pidcentrodecusto         => rmat.idcentrodecusto,
                                                                      pidcontafinan            => rmat.idcontafinan,
                                                                      pidsubcontafinan         => rmat.idsubcontafinan,
                                                                      ptiporegra               => rmat.tiporegra,
                                                                      ptipo                    => rmat.tipo,
                                                                      pobservacao              => :OBSERVACAO,
                                                                      pdata                    => r1.data,
                                                                      pusuario                 => r1.usuario,
                                                                      pidlancamentodiverso     => r1.idlancamentodiverso,
                                                                      pidnotafiscal            => r1.idnotafiscal,
                                                                      pidrateiorequisicao      => r1.idrateiorequisicao,
                                                                      pmd5                     => vmd5,
                                                                      poperacao_dml            => 'U');
                        --
                        -- Mensagem incluida pois foi criado o campo de idrequisicao pagamento dentro do rateiosnotasfiscais e por isso anteriores não estão populados e não irá ocorrer alteração.
                        --
                        case 
                           when r1.idrateiorequisicao is null then 
                           --
                           apex_application.g_print_success_message := '<span style= style="color : white >Atenção !! Dados não alterados na requisição de pagamento, necessário solicitar alteração manual.</span>' ;  
                           --
                        else
                           apex_application.g_print_success_message := '<span style= style="color : white >Alterado com sucesso !</span>' ;  
                        end case;
                        --
                    end case;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 119896869465546726
        }
    )

